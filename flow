# Build and run Vulkan triangle demo (macOS + MoltenVK).
run_vulkan_demo() {
    local demo_dir="$SCRIPT_DIR/demos/vulkan_triangle"

    if [ ! -d "$demo_dir" ]; then
        print_error "Vulkan demo not found: $demo_dir"
        exit 1
    fi

    if ! command -v make &> /dev/null; then
        print_error "make is required to build the Vulkan demo"
        exit 1
    fi

    if ! command -v pkg-config &> /dev/null; then
        print_error "pkg-config is required to build the Vulkan demo"
        print_info "Install: brew install pkg-config"
        exit 1
    fi

    if ! command -v glslangValidator &> /dev/null; then
        print_error "glslangValidator is required to compile shaders"
        print_info "Install: brew install vulkan-tools"
        exit 1
    fi

    if ! pkg-config --exists vulkan; then
        print_error "Vulkan loader/headers not found (pkg-config vulkan)"
        print_info "Install: brew install vulkan-loader vulkan-headers molten-vk"
        exit 1
    fi

    if ! pkg-config --exists glfw3; then
        print_error "GLFW not found (pkg-config glfw3)"
        print_info "Install: brew install glfw"
        exit 1
    fi

    print_info "Building Vulkan triangle demo..."
    if make -C "$demo_dir" -q 2>/dev/null; then
        print_info "Build up to date (skipping rebuild)."
    elif ! make -C "$demo_dir"; then
        print_error "Vulkan demo build failed"
        exit 1
    fi

    print_info "Running Vulkan triangle demo..."
    "$demo_dir/run.sh"
}

