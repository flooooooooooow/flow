#!/usr/bin/env bash
# Public Flow command dispatcher.
#
# Keep project testing small and first-class without growing the historical
# monolithic shell driver further. The complete legacy/current command driver
# lives beside this file as `flow-driver`; every command except project-level
# `flow test` delegates to it unchanged.

set -euo pipefail

# Resolve the launcher itself before locating sibling files. Homebrew and
# source installs commonly expose `flow` through a symlink in ~/.local/bin.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$SOURCE_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
DRIVER="$SCRIPT_DIR/flow-driver"
export PYTHONPATH="$SCRIPT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"

if [ ! -x "$DRIVER" ]; then
    echo "flow: internal driver not found or not executable: $DRIVER" >&2
    exit 2
fi

if [ "${1:-}" = "test" ]; then
    shift

    # Compiler maintainers keep the historical repository-wide tier sweep.
    # `--project` opts into the new project runner even from the Flow repo root.
    project_mode=1
    if [ "${1:-}" = "--compiler" ]; then
        shift
        exec "$DRIVER" test "$@"
    fi
    if [ "${1:-}" = "--project" ]; then
        shift
    elif [ -f "$SCRIPT_DIR/flow.toml" ] && [ "$(pwd -P)" = "$SCRIPT_DIR" ]; then
        project_mode=0
    fi

    if [ "$project_mode" -eq 0 ]; then
        exec "$DRIVER" test "$@"
    fi

    export FLOW_TEST_DRIVER="$DRIVER"
    export FLOW_TEST_BUILD_DIR="$SCRIPT_DIR/build"
    exec python3 -m flow.project_test_runner "$@"
fi

exec "$DRIVER" "$@"
