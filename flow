import sys

script_dir = sys.argv[1]
program = sys.argv[2]
sys.path.insert(0, f"{script_dir}/src")

from flow.mlir_generator import flow_to_mlir
from flow.mlir_jit import MLIRJIT
from flow.module_resolver import ModuleResolver

# Resolve modules
resolver = ModuleResolver(program)
try:
    declarations = resolver.resolve()
except Exception as e:
    print(f"Error: {e}")
    sys.exit(1)

# Generate MLIR
mlir_code = flow_to_mlir(declarations, source_file=program)

# JIT compile and run
jit = MLIRJIT()
try:
    result = jit.jit_compile_and_run(mlir_code, "main")
    print(f"Result: {result}")
finally:
    jit.cleanup()
PY
