#!/bin/bash
# FLOW Programming Language Runner
# The main entry point for running FLOW programs

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FLOWC_MODULE="flow.transpiler"
export PYTHONPATH="$SCRIPT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
LLVM_PATH="/opt/homebrew/opt/llvm/bin"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Print colored output
print_info() {
    echo -e "${BLUE}ℹ️  $1${NC}"
}

print_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

print_error() {
    echo -e "${RED}❌ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

# Show help
show_help() {
    echo "FLOW Programming Language v0.1"
    echo ""
    echo "Usage: flow [OPTIONS] <program.flow>"
    echo ""
    echo "Options:"
    echo "  run <program>     Compile and run program"
    echo "  compile <program>  Compile program only"
    echo "  mlir <program>     Generate MLIR only"
    echo "  mlir-run <program> Compile via MLIR and run"
    echo "  jit <program>      JIT compile and run (fastest)"
    echo "  gpu <program>      Generate Metal/CUDA shaders"
    echo "  transpile <program> [args...]  Run the FLOW transpiler (advanced flags)"
    echo "  fmt <files...>    Format FLOW source files"
    echo "  test              Run all FLOW tests"
    echo "  test-python       Run Python unit tests"
    echo "  test-all          Run FLOW and Python tests"
    echo "  wasm <program>    Compile to WebAssembly"
    echo "  install           Install dependencies"
    echo "  repl              Start interactive REPL"
    echo "  init [name]       Initialize a new project"
    echo "  add <package>     Add a dependency"
    echo "  build             Build the project"
    echo "  clean             Clean build artifacts"
    echo "  examples          List example programs"
    echo "  help              Show this help"
    echo ""
    echo "Examples:"
    echo "  flow run examples/fibonacci.flow"
    echo "  flow compile examples/loops.flow"
    echo "  flow mlir examples/hello_world.flow"
    echo "  flow transpile tests/test_optimization.flow --mlir --optimize --opt-level O2 --opt-report"
}

# Check dependencies
check_deps() {
    if ! command -v python3 &> /dev/null; then
        print_error "Python 3 is required"
        exit 1
    fi

    if ! command -v clang &> /dev/null; then
        print_error "clang is required"
        exit 1
    fi
    
    # Module import check
    python3 -c "import $FLOWC_MODULE" 2>/dev/null || {
        print_error "FLOW compiler module not found ($FLOWC_MODULE). Check PYTHONPATH/src layout."
        exit 1
    }
}

check_mlir_deps() {
    if ! command -v "$LLVM_PATH/mlir-opt" &> /dev/null; then
        print_error "MLIR tools not found. Run './flow install' (or brew install llvm)"
        exit 1
    fi
    if ! command -v "$LLVM_PATH/mlir-translate" &> /dev/null; then
        print_error "mlir-translate not found. Run './flow install' (or brew install llvm)"
        exit 1
    fi
}

# Compile FLOW to executable
compile_program() {
    local program="$1"
    local basename=$(basename "$program" .flow)
    local build_dir="$SCRIPT_DIR/build"
    
    if [ ! -f "$program" ]; then
        print_error "Program not found: $program"
        exit 1
    fi
    
    print_info "Compiling $program..."
    
    # Create build directory
    mkdir -p "$build_dir"
    
    # FLOW to C (use --lenient for now until type checker is fully stable)
    if ! python3 -m "$FLOWC_MODULE" "$program" --c --lenient -o "$build_dir/$basename.c" 2>/dev/null; then
        print_error "FLOW compilation failed"
        exit 1
    fi
    print_success "FLOW → C: $basename.c"

    # C to executable
    if ! clang "$build_dir/$basename.c" -o "$build_dir/$basename" 2>/dev/null; then
        print_error "C compilation/linking failed"
        exit 1
    fi
    print_success "C → Executable: $basename"
    
    print_success "🚀 Ready to run: $build_dir/$basename"
}

# Run program
run_program() {
    local program="$1"
    local basename=$(basename "$program" .flow)
    local executable="$SCRIPT_DIR/build/$basename"
    
    compile_program "$program"
    
    print_info "Running $basename..."
    echo "----------------------------------------"
    "$executable"
    status=$?
    echo "----------------------------------------"
    print_success "Program finished"
    echo "Exit code: $status"
    return $status
}

# Generate MLIR only
generate_mlir() {
    local program="$1"
    shift
    local basename=$(basename "$program" .flow)
    local build_dir="$SCRIPT_DIR/build"
    
    if [ ! -f "$program" ]; then
        print_error "Program not found: $program"
        exit 1
    fi
    
    mkdir -p "$build_dir"

    check_mlir_deps

    if python3 -m "$FLOWC_MODULE" "$program" --mlir "$@" -o "$build_dir/$basename.mlir"; then
        print_success "Generated MLIR: $build_dir/$basename.mlir"
        echo "----------------------------------------"
        cat "$build_dir/$basename.mlir"
        echo "----------------------------------------"
    else
        print_error "MLIR generation failed"
        exit 1
    fi
}

# Run the underlying transpiler directly (advanced flags)
run_transpiler() {
    check_deps
    python3 -m "$FLOWC_MODULE" "$@"
}

# Run tests (use --lenient by default for backwards compatibility)
run_tests() {
    local strict_mode=""
    if [ "$1" = "--strict" ]; then
        strict_mode="--strict"
        print_info "Running FLOW tests (STRICT MODE)..."
    else
        strict_mode="--lenient"
        print_info "Running FLOW tests..."
    fi

    local failed=0
    local total=0

    for suite in "tests" "examples"; do
        local dir="$SCRIPT_DIR/$suite"
        while read program; do
            if [ -z "$program" ]; then continue; fi
            total=$((total + 1))
            local rel_path=${program#$SCRIPT_DIR/}
            print_info "Testing $rel_path..."
            
            if python3 -m "$FLOWC_MODULE" "$program" --c $strict_mode -o "/tmp/${rel_path//\//-}.c" 2>/dev/null; then
                print_success "✓ $rel_path"
            else
                print_error "✗ $rel_path"
                failed=$((failed + 1))
            fi
        done < <(find "$dir" -name "*.flow" -not -path "*/wip/*")
    done
    
    echo "----------------------------------------"
    if [ $failed -eq 0 ]; then
        print_success "All $total tests passed!"
    else
        print_error "$failed/$total tests failed"
        exit 1
    fi
}

# List examples
list_examples() {
    print_info "Available FLOW programs:"
    echo ""
    
    local examples_dir="$SCRIPT_DIR/examples"
    local tests_dir="$SCRIPT_DIR/tests"
    
    echo "📚 Examples (standard programs):"
    find "$examples_dir" -name "*.flow" | while read program; do
        local rel_path=${program#$SCRIPT_DIR/}
        echo "  📄 $rel_path"
        # Show first line as description
        local desc=$(head -n 1 "$program" | sed 's/^# *//')
        echo "     $desc"
        echo ""
    done
    
    echo "🧪 Tests (compiler/language demos):"
    find "$tests_dir" -name "*.flow" | while read program; do
        local rel_path=${program#$SCRIPT_DIR/}
        echo "  📄 $rel_path"
        # Show first line as description
        local desc=$(head -n 1 "$program" | sed 's/^# *//')
        echo "     $desc"
        echo ""
    done
}

# Run Python unit tests
run_python_tests() {
    if command -v pytest &> /dev/null; then
        print_info "Running Python unit tests..."
        cd "$SCRIPT_DIR"
        PYTHONPATH="$SCRIPT_DIR/src" pytest tests/unit/ tests/integration/ -v --tb=short
        local status=$?
        if [ $status -eq 0 ]; then
            print_success "✅ All Python tests passed!"
        else
            print_error "❌ Python tests failed"
            exit 1
        fi
    else
        print_warning "pytest not found. Install test dependencies with:"
        print_info "  pip install -e .[test]"
        print_info "  or: pip install pytest pytest-cov pytest-mock"
        exit 1
    fi
}

# Run all tests (FLOW + Python)
run_all_tests() {
    print_info "Running all tests..."
    
    print_info "Phase 1: FLOW language tests..."
    run_tests
    local flow_status=$?
    
    echo ""
    print_info "Phase 2: Python unit tests..."
    run_python_tests
    local python_status=$?
    
    echo ""
    print_info "Test Summary:"
    if [ $flow_status -eq 0 ] && [ $python_status -eq 0 ]; then
        print_success "🎉 All tests passed!"
    else
        print_error "❌ Some tests failed"
        if [ $flow_status -ne 0 ]; then
            print_error "  - FLOW tests failed"
        fi
        if [ $python_status -ne 0 ]; then
            print_error "  - Python tests failed"
        fi
        exit 1
    fi
}

# Install dependencies
install_deps() {
    print_info "Installing FLOW dependencies..."
    
    # Install LLVM
    if ! command -v "$LLVM_PATH/mlir-opt" &> /dev/null; then
        print_info "Installing LLVM..."
        if command -v brew &> /dev/null; then
            brew install llvm
        else
            print_error "Please install LLVM manually"
            exit 1
        fi
    fi
    
    # Optionally install test dependencies
    if command -v pip3 &> /dev/null; then
        print_info "Installing test dependencies (optional)..."
        pip3 install -e .[test] 2>/dev/null || {
            print_warning "Failed to install test dependencies. Install manually with:"
            print_info "  pip install pytest pytest-cov pytest-mock"
        }
    fi
    
    print_success "Dependencies installed!"
}

# Main command dispatcher
case "${1:-help}" in
    "run")
        check_deps
        run_program "$2"
        ;;
    "compile")
        check_deps
        compile_program "$2"
        ;;
    "mlir")
        shift
        generate_mlir "$@"
        ;;
    "mlir-run")
        shift
        if [ -z "$1" ]; then
            print_error "Usage: flow mlir-run <program.flow>"
            exit 1
        fi
        generate_mlir "$1"
        if [ $? -ne 0 ]; then
            print_error "MLIR generation failed"
            exit 1
        fi
        
        PROGRAM_NAME=$(basename "$1" .flow)
        BUILD_DIR="$SCRIPT_DIR/build"
        MLIR_FILE="$BUILD_DIR/${PROGRAM_NAME}.mlir"
        OBJ_FILE="$BUILD_DIR/${PROGRAM_NAME}_mlir.o"
        EXE_FILE="$BUILD_DIR/${PROGRAM_NAME}_mlir"
        
        print_info "Lowering MLIR to LLVM IR..."
        if ! $LLVM_PATH/mlir-opt "$MLIR_FILE" \
            --convert-cf-to-llvm \
            --convert-func-to-llvm \
            --convert-arith-to-llvm \
            --reconcile-unrealized-casts | \
            $LLVM_PATH/mlir-translate --mlir-to-llvmir | \
            $LLVM_PATH/llc -filetype=obj -o "$OBJ_FILE" 2>/dev/null; then
            print_error "MLIR to LLVM lowering failed"
            exit 1
        fi
        print_success "MLIR → LLVM IR → Object"
        
        print_info "Linking executable..."
        if ! clang "$OBJ_FILE" -o "$EXE_FILE" 2>/dev/null; then
            print_error "Linking failed"
            exit 1
        fi
        print_success "Linked: $EXE_FILE"
        
        print_info "Running..."
        echo "----------------------------------------"
        "$EXE_FILE"
        EXIT_CODE=$?
        echo "----------------------------------------"
        print_success "Program finished with exit code: $EXIT_CODE"
        ;;
    "gpu")
        shift
        if [ -z "$1" ]; then
            print_error "Usage: flow gpu <program.flow>"
            exit 1
        fi
        check_deps
        print_info "Generating GPU shaders from $1..."
        python3 -c "
import sys
sys.path.insert(0, '$SCRIPT_DIR/src')

from flow.module_resolver import ModuleResolver
from flow.metal_codegen import generate_metal_shaders, extract_gpu_functions

# Resolve modules
resolver = ModuleResolver('$1')
try:
    declarations = resolver.resolve()
except Exception as e:
    print(f'Error: {e}')
    sys.exit(1)

# Check for @gpu functions
gpu_funcs = extract_gpu_functions(declarations)
if not gpu_funcs:
    print('No @gpu functions found in the program.')
    print('Mark GPU functions with @gpu decorator:')
    print()
    print('@gpu')
    print('function vector_add(a: array<f32>, b: array<f32>, out: array<f32>, n: i32) {')
    print('    let i = gpu_thread_id()')
    print('    if i < n {')
    print('        out[i] = a[i] + b[i]')
    print('    }')
    print('}')
    sys.exit(0)

# Generate Metal shaders
results = generate_metal_shaders(declarations, '$SCRIPT_DIR/build/gpu')
print(f'Generated {len(results)} GPU shader(s)')
"
        ;;
    "jit")
        shift
        if [ -z "$1" ]; then
            print_error "Usage: flow jit <program.flow>"
            exit 1
        fi
        check_deps
        print_info "JIT compiling $1..."
        python3 -c "
import sys
sys.path.insert(0, '$SCRIPT_DIR/src')

from flow.mlir_generator import flow_to_mlir
from flow.mlir_jit import MLIRJIT
from flow.module_resolver import ModuleResolver

# Resolve modules
resolver = ModuleResolver('$1')
try:
    declarations = resolver.resolve()
except Exception as e:
    print(f'Error: {e}')
    sys.exit(1)

# Generate MLIR
mlir_code = flow_to_mlir(declarations, source_file='$1')

# JIT compile and run
jit = MLIRJIT()
try:
    result = jit.jit_compile_and_run(mlir_code, 'main')
    print(f'Result: {result}')
finally:
    jit.cleanup()
"
        ;;
    "transpile")
        shift
        run_transpiler "$@"
        ;;
    "fmt")
        shift
        check_deps
        python3 -c "
import sys
sys.path.insert(0, '$SCRIPT_DIR/src')
from flow.formatter import format_file
for f in sys.argv[1:]:
    format_file(f)
" "$@"
        ;;
    "test")
        shift
        run_tests "$@"
        ;;
    "test-strict")
        run_tests --strict
        ;;
    "test-python")
        run_python_tests
        ;;
    "test-all")
        run_all_tests
        ;;
    "wasm")
        shift
        if [ -z "$1" ]; then
            print_error "Usage: flow wasm <program.flow>"
            exit 1
        fi
        python3 "$SCRIPT_DIR/wasm/flow_to_wasm.py" "$1"
        ;;
    "install")
        install_deps
        ;;
    "repl")
        check_deps
        python3 -c "
import sys
sys.path.insert(0, '$SCRIPT_DIR/src')
from flow.repl import main
main()
"
        ;;
    "init")
        shift
        python3 -c "
import sys
sys.path.insert(0, '$SCRIPT_DIR/src')
from flow.package import FlowPackageManager
pm = FlowPackageManager()
pm.init('$1' if '$1' else None)
"
        ;;
    "add")
        shift
        if [ -z "$1" ]; then
            print_error "Usage: flow add <package>"
            exit 1
        fi
        python3 -c "
import sys
sys.path.insert(0, '$SCRIPT_DIR/src')
from flow.package import FlowPackageManager
pm = FlowPackageManager()
pm.add('$1')
"
        ;;
    "build")
        python3 -c "
import sys
sys.path.insert(0, '$SCRIPT_DIR/src')
from flow.package import FlowPackageManager
pm = FlowPackageManager()
pm.build()
"
        ;;
    "clean")
        python3 -c "
import sys
sys.path.insert(0, '$SCRIPT_DIR/src')
from flow.package import FlowPackageManager
pm = FlowPackageManager()
pm.clean()
"
        ;;
    "examples")
        list_examples
        ;;
    "help"|*)
        show_help
        ;;
esac
