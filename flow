# Check dependencies
check_deps() {
    if ! command -v python3 &> /dev/null; then
        print_error "Python 3 is required"
        exit 1
    fi

    if ! command -v clang &> /dev/null; then
        print_error "clang is required"
        exit 1
    fi
    
    # Module import check
    python3 -c "import $FLOWC_MODULE" 2>/dev/null || {
        print_error "FLOW compiler module not found ($FLOWC_MODULE). Check PYTHONPATH/src layout."
        exit 1
    }
}

check_mlir_deps() {
    if ! command -v "$LLVM_PATH/mlir-opt" &> /dev/null; then
        print_error "MLIR tools not found. Run './flow install' (or brew install llvm)"
        exit 1
    fi
    if ! command -v "$LLVM_PATH/mlir-translate" &> /dev/null; then
        print_error "mlir-translate not found. Run './flow install' (or brew install llvm)"
        exit 1
    fi
}

# Compile FLOW to executable
compile_program() {
    local program="$1"
    local basename=$(basename "$program" .flow)
    local build_dir="$SCRIPT_DIR/build"
    
    if [ ! -f "$program" ]; then
        print_error "Program not found: $program"
        exit 1
    fi
    
    print_info "Compiling $program..."
    
    # Create build directory
    mkdir -p "$build_dir"
    
    # FLOW to C (use --lenient for now until type checker is fully stable)
    if ! python3 -m "$FLOWC_MODULE" "$program" --c --lenient -o "$build_dir/$basename.c" 2>/dev/null; then
        print_error "FLOW compilation failed"
        exit 1
    fi
    print_success "FLOW → C: $basename.c"

    # C to executable
    if ! clang "$build_dir/$basename.c" -o "$build_dir/$basename" 2>/dev/null; then
        print_error "C compilation/linking failed"
        exit 1
    fi
    print_success "C → Executable: $basename"
    
    print_success "🚀 Ready to run: $build_dir/$basename"
}

# Compile with debug symbols and open a debugger (LLDB preferred).
debug_program() {
    local program="$1"
    local basename=$(basename "$program" .flow)
    local build_dir="$SCRIPT_DIR/build"
    local c_file="$build_dir/$basename.debug.c"
    local exe_file="$build_dir/$basename.debug"
    
    if [ ! -f "$program" ]; then
        print_error "Program not found: $program"
        exit 1
    fi
    
    check_deps
    mkdir -p "$build_dir"
    
    print_info "Compiling $program (debug)..."
    
    # FLOW to C with coarse source mappings (#line) enabled
    if ! python3 -m "$FLOWC_MODULE" "$program" --c --debug-info --lenient -o "$c_file"; then
        print_error "FLOW compilation failed"
        exit 1
    fi
    print_success "FLOW → C (debug): $(basename "$c_file")"
    
    # C to debug executable
    if ! clang -g -O0 -fno-omit-frame-pointer "$c_file" -o "$exe_file" -lm; then
        print_error "C compilation/linking failed"
        exit 1
    fi
    print_success "Built debug binary: $exe_file"
    
    # Launch debugger
    if command -v lldb &> /dev/null; then
        print_info "Launching LLDB..."
        print_info "Tip: (lldb) b main ; run ; bt"
        lldb "$exe_file"
    elif command -v gdb &> /dev/null; then
        print_info "Launching GDB..."
        print_info "Tip: (gdb) break main ; run ; bt"
        gdb "$exe_file"
    else
        print_warning "No debugger found (lldb/gdb). Install one and run:"
        print_info "  lldb \"$exe_file\""
    fi
}

# Run program
run_program() {
    local program="$1"
    local basename=$(basename "$program" .flow)
    local executable="$SCRIPT_DIR/build/$basename"
    
    compile_program "$program"
    
    print_info "Running $basename..."
    echo "----------------------------------------"
    "$executable"
    status=$?
    echo "----------------------------------------"
    print_success "Program finished"
    echo "Exit code: $status"
    return $status
}

# Run program in an SDL2 window (requires SDL2 installed, via pkg-config).
run_window_program() {
    local program="$1"
    local basename=$(basename "$program" .flow)
    local build_dir="$SCRIPT_DIR/build"
    
    if [ ! -f "$program" ]; then
        print_error "Program not found: $program"
        exit 1
    fi
    
    check_deps
    
    if ! command -v pkg-config &> /dev/null; then
        print_error "pkg-config is required for SDL2 linking"
        print_info "Install: brew install pkg-config"
        exit 1
    fi
    if ! pkg-config --exists sdl2; then
        print_error "SDL2 not found (pkg-config sdl2)"
        print_info "Install: brew install sdl2"
        exit 1
    fi
    
    mkdir -p "$build_dir"
    local c_file="$build_dir/$basename.window.c"
    local exe_file="$build_dir/$basename.window"
    
    print_info "Compiling $program (SDL2 window)..."
    if ! python3 -m "$FLOWC_MODULE" "$program" --c --lenient -o "$c_file"; then
        print_error "FLOW compilation failed"
        exit 1
    fi
    print_success "FLOW → C: $(basename "$c_file")"
    
    local sdl_cflags
    local sdl_libs
    sdl_cflags=$(pkg-config --cflags sdl2)
    sdl_libs=$(pkg-config --libs sdl2)
    
    if ! clang -O2 -fno-omit-frame-pointer $sdl_cflags "$c_file" -o "$exe_file" $sdl_libs -lm 2>/dev/null; then
        print_error "C compilation/linking failed (SDL2)"
        exit 1
    fi
    print_success "Built: $exe_file"
    
    print_info "Running..."
    "$exe_file"
}
# Generate MLIR only
generate_mlir() {
    local program="$1"
    shift
    local basename=$(basename "$program" .flow)
    local build_dir="$SCRIPT_DIR/build"
    
    if [ ! -f "$program" ]; then
        print_error "Program not found: $program"
        exit 1
    fi
    
    mkdir -p "$build_dir"

    check_mlir_deps

    if python3 -m "$FLOWC_MODULE" "$program" --mlir "$@" -o "$build_dir/$basename.mlir"; then
        print_success "Generated MLIR: $build_dir/$basename.mlir"
        echo "----------------------------------------"
        cat "$build_dir/$basename.mlir"
        echo "----------------------------------------"
    else
        print_error "MLIR generation failed"
        exit 1
    fi
}

run_gfx_program() {
    local program="$1"
    local basename=$(basename "$program" .flow)
    local build_dir="$SCRIPT_DIR/build"
    
    if [ ! -f "$program" ]; then
        print_error "Program not found: $program"
        exit 1
    fi
    
    check_deps
    mkdir -p "$build_dir"
    
    local c_file="$build_dir/$basename.gfx.c"
    local exe_file="$build_dir/$basename.gfx"
    
    print_info "Compiling $program (native gfx)..."
    if ! python3 -m "$FLOWC_MODULE" "$program" --c --lenient -o "$c_file"; then
        print_error "FLOW compilation failed"
        exit 1
    fi
    print_success "FLOW → C: $(basename "$c_file")"
    
    if ! clang -O2 -fno-omit-frame-pointer "$c_file" "$SCRIPT_DIR/runtime/gfx_macos.m" \
        -framework Cocoa -framework CoreGraphics -framework QuartzCore \
        -o "$exe_file" -lm 2>/dev/null; then
        print_error "Native gfx build failed (clang/frameworks)"
        exit 1
    fi
    print_success "Built: $exe_file"
    
    print_info "Running..."
    "$exe_file"
}

# Build and run Vulkan triangle demo (macOS + MoltenVK).
run_vulkan_demo() {
    local demo_dir="$SCRIPT_DIR/demos/vulkan_triangle"

    if [ ! -d "$demo_dir" ]; then
        print_error "Vulkan demo not found: $demo_dir"
        exit 1
    fi

    if ! command -v make &> /dev/null; then
        print_error "make is required to build the Vulkan demo"
        exit 1
    fi

    if ! command -v pkg-config &> /dev/null; then
        print_error "pkg-config is required to build the Vulkan demo"
        print_info "Install: brew install pkg-config"
        exit 1
    fi

    if ! command -v glslangValidator &> /dev/null; then
        print_error "glslangValidator is required to compile shaders"
        print_info "Install: brew install vulkan-tools"
        exit 1
    fi

    if ! pkg-config --exists vulkan; then
        print_error "Vulkan loader/headers not found (pkg-config vulkan)"
        print_info "Install: brew install vulkan-loader vulkan-headers molten-vk"
        exit 1
    fi

    if ! pkg-config --exists glfw3; then
        print_error "GLFW not found (pkg-config glfw3)"
        print_info "Install: brew install glfw"
        exit 1
    fi

    print_info "Building Vulkan triangle demo..."
    if make -C "$demo_dir" -q 2>/dev/null; then
        print_info "Build up to date (skipping rebuild)."
    elif ! make -C "$demo_dir"; then
        print_error "Vulkan demo build failed"
        exit 1
    fi

    print_info "Running Vulkan triangle demo..."
    "$demo_dir/run.sh"
}

