# Run tests with tiered validation
# Tier 1: Transpile FLOW to C (catches parser/typechecker/codegen crashes)
# Tier 2: Compile generated C with clang (catches invalid C backend output)
# Tier 3: Run selected programs (catches semantic bugs) - see test-runtime
run_tests() {
    local strict_mode="--lenient"
    local tier=2  # Default: transpile + clang compile
    local verbose=0
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --strict)
                strict_mode="--strict"
                shift
                ;;
            --lenient)
                strict_mode="--lenient"
                shift
                ;;
            --tier1)
                tier=1
                shift
                ;;
            --tier2)
                tier=2
                shift
                ;;
            --tier)
                if [[ -n "${2:-}" ]]; then
                    tier="$2"
                    shift 2
                else
                    tier=2
                    shift
                fi
                ;;
            --verbose|-v)
                verbose=1
                shift
                ;;
            --sanitize=*)
                FLOW_SANITIZE="${1#*=}"
                export FLOW_SANITIZE
                shift
                ;;
            --sanitize)
                if [ -z "${2:-}" ]; then
                    print_error "--sanitize requires ub,asan,tsan (comma-separated)"
                    exit 1
                fi
                FLOW_SANITIZE="$2"
                export FLOW_SANITIZE
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done
    
    if [ "$strict_mode" = "--strict" ]; then
        print_info "Running FLOW tests (STRICT MODE, Tier $tier)..."
    else
        print_info "Running FLOW tests (Tier $tier)..."
    fi

    echo "DEBUG: Starting tests, tier=$tier, strict=$strict_mode"
    echo "DEBUG: SCRIPT_DIR=$SCRIPT_DIR"
    echo "DEBUG: Looking for tests in tests/ and examples/"

    local transpile_failed=0
    local clang_failed=0
    local total=0
    local failed_files=""
    
    # Create temp directory for test outputs
    local test_build_dir
    test_build_dir="$(mktemp -d 2>/dev/null || mktemp -d -t flow_test)"
    echo "DEBUG: Created temp dir: $test_build_dir"
    mkdir -p "$test_build_dir"

    # Only run git-tracked .flow files so local WIP verify corpora do not break tier tests.
    # examples/ecosystem/ and examples/demos/ are package projects (registry deps,
    # cross-directory imports) that cannot transpile standalone; their own tooling
    # verifies them.
    _list_suite_flow_files() {
        local suite="$1"
        if command -v git >/dev/null 2>&1 && git -C "$SCRIPT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            git -C "$SCRIPT_DIR" ls-files "$suite" 2>/dev/null \
                | grep '\.flow$' \
                | grep -v '/wip/' \
                | grep -v '^examples/verify/' \
                | grep -v '^tests/fuzz/crashes/' \
                | grep -v '^examples/ecosystem/' \
                | grep -v '^examples/demos/' \
                | while read -r rel; do
                    echo "$SCRIPT_DIR/$rel"
                done
        else
            find "$SCRIPT_DIR/$suite" -name "*.flow" -not -path "*/wip/*" -not -path "*/fuzz/crashes/*" -not -path "*/examples/ecosystem/*" -not -path "*/examples/demos/*" 2>/dev/null
        fi
    }

    echo "DEBUG: About to loop through test suites..."
    for suite in "tests" "examples"; do
        echo "DEBUG: Processing suite: $suite"
        local dir="$SCRIPT_DIR/$suite"
        if [ ! -d "$dir" ]; then
            echo "DEBUG: Directory $dir does not exist, skipping"
            continue
        fi

        echo "DEBUG: Finding .flow files in $dir..."
        local file_count=$(_list_suite_flow_files "$suite" | wc -l | tr -d ' ')
        echo "DEBUG: Found $file_count tracked .flow files in $suite"

        while read program || [ -n "$program" ]; do
            if [ -z "$program" ]; then
                echo "DEBUG: Empty program entry, skipping"
                continue
            fi
            echo "DEBUG: Processing file: $program"
            total=$((total + 1))
            local rel_path=${program#$SCRIPT_DIR/}
            local safe_name="${rel_path//\//-}"
            local c_file="$test_build_dir/${safe_name}.c"
            local exe_file="$test_build_dir/${safe_name}"
            
            # Per-file strictness: files carrying a "flow:lenient" pragma in
            # their first lines are intentionally checked leniently even when
            # the suite runs with --strict (checker gaps documented in-file).
            local file_mode="$strict_mode"
            if [ "$strict_mode" = "--strict" ] && head -n 3 "$program" | grep -q "flow:lenient"; then
                file_mode="--lenient"
                print_warning "~ $rel_path (marked flow:lenient)"
            fi

            # Tier 1: Transpile FLOW to C
            local transpile_output
            set +e  # Temporarily disable exit on error to capture failures
            transpile_output=$(python3 -m "$FLOWC_MODULE" "$program" --c $file_mode -o "$c_file" 2>&1)
            local transpile_status=$?
            set -e  # Re-enable exit on error
            
            if [ $transpile_status -ne 0 ]; then
                print_error "✗ $rel_path (transpile failed)"
                # Always show errors in CI, not just verbose mode
                echo "    Error output:"
                echo "$transpile_output" | head -10
                transpile_failed=$((transpile_failed + 1))
                failed_files="$failed_files\n  - $rel_path (transpile)"
                continue
            fi
            
            # Tier 2: Compile C with clang (if enabled).
            # Examples often need platform libs/graphics; clang-check tests/ only.
            if [ "$tier" -ge 2 ] && [ "$suite" = "tests" ]; then
                # MISRA #269: use -std=c11 -Wall instead of -Wno-everything.
                # Warnings do not fail the syntax check (no -Werror here).
                local clang_output
                clang_output=$(clang -fsyntax-only -std=c11 -D_DEFAULT_SOURCE -Wall -Wextra -Wno-unused-function -Wno-unused-variable -Wno-unused-parameter -Wno-error=implicit-function-declaration -Wno-error=int-conversion "$c_file" 2>&1)
                local clang_status=$?
                
                if [ $clang_status -ne 0 ]; then
                    print_error "✗ $rel_path (clang failed)"
                    if [ $verbose -eq 1 ]; then
                        echo "    $clang_output" | head -5
                    fi
                    clang_failed=$((clang_failed + 1))
                    failed_files="$failed_files\n  - $rel_path (clang)"
                    continue
                fi
            fi
            
            print_success "✓ $rel_path"
            
        done < <(_list_suite_flow_files "$suite")
    done
    
    # Cleanup
    rm -rf "$test_build_dir"

    echo "----------------------------------------"
    echo "DEBUG: Total tests found: $total"
    echo "DEBUG: Transpile failures: $transpile_failed"
    echo "DEBUG: Clang failures: $clang_failed"
    local total_failed=$((transpile_failed + clang_failed))

    if [ $total_failed -eq 0 ]; then
        print_success "All $total tests passed! (Tier $tier)"
        return 0
    else
        echo ""
        print_error "Test failures: $total_failed/$total"
        if [ $transpile_failed -gt 0 ]; then
            print_error "  Transpile failures: $transpile_failed"
        fi
        if [ $clang_failed -gt 0 ]; then
            print_error "  Clang compile failures: $clang_failed"
        fi
        if [ -n "$failed_files" ]; then
            echo -e "\nFailed files:$failed_files"
        fi
        exit 1
    fi
}

