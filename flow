# Run matmul optimization demo + MLIR + assembly dump
run_matmul_tests() {
    local program="$SCRIPT_DIR/examples/bench/matmul_optimizations.flow"
    local mlir_program="$SCRIPT_DIR/examples/bench/matmul_mlir.flow"
    local build_dir="$SCRIPT_DIR/build"
    local c_file="$build_dir/matmul_optimizations.asm.c"
    local s_file="$build_dir/matmul_optimizations.s"
    local mlir_file="$build_dir/matmul_mlir.mlir"
    local print_asm=1
    local print_mlir=1

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-asm)
                print_asm=0
                shift
                ;;
            --no-mlir)
                print_mlir=0
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    print_info "Running matmul optimizations..."
    run_program "$program"

    print_info "Generating MLIR..."
    python3 -m "$FLOWC_MODULE" "$mlir_program" --mlir -o "$mlir_file" >/dev/null 2>&1 || {
        print_warning "MLIR generation failed"
    }

    print_info "Generating assembly..."
    python3 -m "$FLOWC_MODULE" "$program" --c --lenient -o "$c_file" >/dev/null 2>&1 || {
        print_error "C generation failed"
        exit 1
    }
    if ! clang -O2 -S "$c_file" -o "$s_file" 2>/dev/null; then
        print_error "Assembly generation failed"
        exit 1
    fi

    if [ $print_asm -eq 1 ]; then
        echo "----------------------------------------"
        echo "Assembly: $s_file"
        echo "----------------------------------------"
        head -n 200 "$s_file"
        echo "----------------------------------------"
    fi

    if [ $print_mlir -eq 1 ] && [ -f "$mlir_file" ]; then
        echo "MLIR: $mlir_file"
        echo "----------------------------------------"
        head -n 120 "$mlir_file"
        echo "----------------------------------------"
    fi
}

