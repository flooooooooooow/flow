# Check dependencies
check_deps() {
    if ! command -v python3 &> /dev/null; then
        print_error "Python 3 is required"
        exit 1
    fi

    if ! command -v clang &> /dev/null; then
        print_error "clang is required"
        exit 1
    fi
    
    # Module import check
    python3 -c "import $FLOWC_MODULE" 2>/dev/null || {
        print_error "FLOW compiler module not found ($FLOWC_MODULE). Check PYTHONPATH/src layout."
        exit 1
    }
}

check_mlir_deps() {
    resolve_llvm_path
    if [ ! -x "$LLVM_PATH/mlir-opt" ]; then
        print_error "MLIR tools not found. Run './flow install' (or brew install llvm)"
        exit 1
    fi
    if [ ! -x ""$LLVM_PATH"/mlir-translate" ]; then
        print_error "mlir-translate not found. Run './flow install' (or brew install llvm)"
        exit 1
    fi
}

# Compile FLOW to executable
compile_program() {
    local program="$1"
    require_flow_file "$program"
    local basename
    basename=$(basename "$program" .flow)
    local build_dir="$SCRIPT_DIR/build"
    local py_framework_dir="/Applications/Xcode.app/Contents/Developer/Library/Frameworks"
    local py_header_dir="$py_framework_dir/Python3.framework/Headers"
    local py_cflags=()
    local py_ldflags=()
    
    print_info "Compiling $program..."
    
    # Create build directory
    mkdir -p "$build_dir"
    
    # FLOW to C (use --lenient for now until type checker is fully stable)
    if ! python3 -m "$FLOWC_MODULE" "$program" --c --lenient -o "$build_dir/$basename.c" 2>/dev/null; then
        print_error "FLOW compilation failed"
        exit 1
    fi
    print_success "FLOW → C: $basename.c"

    # C to executable
    if [ -d "$py_header_dir" ]; then
        py_cflags+=("-I$py_header_dir" "-DFLOW_PY_EMBED")
        py_ldflags+=("-F$py_framework_dir" "-framework" "Python3" "-Wl,-rpath,$py_framework_dir")
    fi
    if ! clang "${py_cflags[@]}" "$build_dir/$basename.c" \
        "$SCRIPT_DIR/runtime/flow_sys_info.c" \
        "$SCRIPT_DIR/runtime/flow_python_embed.c" \
        "$SCRIPT_DIR/runtime/flow_time.c" \
        "$SCRIPT_DIR/runtime/live_plugin.c" \
        "$SCRIPT_DIR/runtime/live_host.c" \
        "$SCRIPT_DIR/runtime/audio_simd.c" \
        "${py_ldflags[@]}" -o "$build_dir/$basename" 2>/dev/null; then
        print_error "C compilation/linking failed"
        exit 1
    fi
    print_success "C → Executable: $basename"
    
    print_success "🚀 Ready to run: $build_dir/$basename"
}

# Compile with debug symbols and open a debugger (LLDB preferred).
debug_program() {
    local program="$1"
    require_flow_file "$program"
    local basename
    basename=$(basename "$program" .flow)
    local build_dir="$SCRIPT_DIR/build"
    local c_file="$build_dir/$basename.debug.c"
    local exe_file="$build_dir/$basename.debug"
    local py_framework_dir="/Applications/Xcode.app/Contents/Developer/Library/Frameworks"
    local py_header_dir="$py_framework_dir/Python3.framework/Headers"
    local py_cflags=()
    local py_ldflags=()
    
    check_deps
    mkdir -p "$build_dir"
    
    print_info "Compiling $program (debug)..."
    
    # FLOW to C with coarse source mappings (#line) enabled
    if ! python3 -m "$FLOWC_MODULE" "$program" --c --debug-info --lenient -o "$c_file"; then
        print_error "FLOW compilation failed"
        exit 1
    fi
    print_success "FLOW → C (debug): $(basename "$c_file")"
    
    # C to debug executable
    if [ -d "$py_header_dir" ]; then
        py_cflags+=("-I$py_header_dir" "-DFLOW_PY_EMBED")
        py_ldflags+=("-F$py_framework_dir" "-framework" "Python3" "-Wl,-rpath,$py_framework_dir")
    fi
    if ! clang -g -O0 -fno-omit-frame-pointer "${py_cflags[@]}" "$c_file" \
        "$SCRIPT_DIR/runtime/flow_sys_info.c" \
        "$SCRIPT_DIR/runtime/flow_python_embed.c" \
        "$SCRIPT_DIR/runtime/flow_time.c" \
        "$SCRIPT_DIR/runtime/audio_simd.c" \
        "${py_ldflags[@]}" -o "$exe_file" -lm; then
        print_error "C compilation/linking failed"
        exit 1
    fi
    print_success "Built debug binary: $exe_file"
    
    # Launch debugger
    if command -v lldb &> /dev/null; then
        print_info "Launching LLDB..."
        print_info "Tip: (lldb) b main ; run ; bt"
        lldb "$exe_file"
    elif command -v gdb &> /dev/null; then
        print_info "Launching GDB..."
        print_info "Tip: (gdb) break main ; run ; bt"
        gdb "$exe_file"
    else
        print_warning "No debugger found (lldb/gdb). Install one and run:"
        print_info "  lldb \"$exe_file\""
    fi
}

# Run program
run_program() {
    local program="$1"
    require_flow_file "$program"
    local basename
    basename=$(basename "$program" .flow)
    local executable="$SCRIPT_DIR/build/$basename"
    
    compile_program "$program"
    
    print_info "Running $basename..."
    echo "----------------------------------------"
    "$executable"
    status=$?
    echo "----------------------------------------"
    print_success "Program finished"
    echo "Exit code: $status"
    return $status
}

# Compile with audio backend (real-time I/O)
compile_audio_program() {
    local program="$1"
    local backend="${2:-}"
    require_flow_file "$program"
    local basename
    basename=$(basename "$program" .flow)
    local build_dir="$SCRIPT_DIR/build"
    local py_framework_dir="/Applications/Xcode.app/Contents/Developer/Library/Frameworks"
    local py_header_dir="$py_framework_dir/Python3.framework/Headers"
    local py_cflags=()
    local py_ldflags=()
    local audio_cflags=()
    local audio_ldflags=()
    local audio_sources=("$SCRIPT_DIR/runtime/audio_miniaudio.c" "$SCRIPT_DIR/runtime/audio_simd.c" "$SCRIPT_DIR/runtime/live_plugin.c" "$SCRIPT_DIR/runtime/live_host.c")
    
    local use_mlir=0
    if [ "$backend" = "--mlir" ] || [ "${FLOW_AUDIO_BACKEND:-}" = "mlir" ]; then
        use_mlir=1
    fi

    print_info "Compiling $program (audio backend)..."
    
    mkdir -p "$build_dir"
    
    if [ $use_mlir -eq 1 ]; then
        if ! python3 -m "$FLOWC_MODULE" "$program" --mlir --llvm --lenient -o "$build_dir/$basename.ll" 2>/dev/null; then
            print_error "FLOW MLIR/LLVM compilation failed"
            exit 1
        fi
        print_success "FLOW → MLIR → LLVM: $basename.ll"
    else
        if ! python3 -m "$FLOWC_MODULE" "$program" --c --lenient -o "$build_dir/$basename.c" 2>/dev/null; then
            print_error "FLOW compilation failed"
            exit 1
        fi
        print_success "FLOW → C: $basename.c"
    fi

    if [ -f "$SCRIPT_DIR/third_party/miniaudio.h" ]; then
        audio_cflags+=("-I$SCRIPT_DIR/third_party" "-DFLOW_AUDIO_BACKEND_MINIAUDIO")
    else
        print_warning "miniaudio.h not found; building with stub backend (no real-time audio)"
    fi

    case "$(uname -s)" in
        Darwin)
            audio_sources+=("$SCRIPT_DIR/runtime/audio_gpu_metal.m")
            audio_ldflags+=("-framework" "CoreAudio" "-framework" "AudioToolbox" "-framework" "AudioUnit" "-framework" "Metal" "-framework" "Foundation")
            ;;
        Linux)
            audio_ldflags+=("-ldl" "-pthread" "-lm")
            ;;
    esac

    if [ -d "$py_header_dir" ]; then
        py_cflags+=("-I$py_header_dir" "-DFLOW_PY_EMBED")
        py_ldflags+=("-F$py_framework_dir" "-framework" "Python3" "-Wl,-rpath,$py_framework_dir")
    fi
    local flow_input="$build_dir/$basename.c"
    if [ $use_mlir -eq 1 ]; then
        flow_input="$build_dir/$basename.ll"
    fi

    if ! clang -O2 -fno-omit-frame-pointer "${audio_cflags[@]}" "${py_cflags[@]}" "$flow_input" \
        "$SCRIPT_DIR/runtime/flow_sys_info.c" \
        "$SCRIPT_DIR/runtime/flow_python_embed.c" \
        "$SCRIPT_DIR/runtime/flow_time.c" \
        "${audio_sources[@]}" \
        "${py_ldflags[@]}" "${audio_ldflags[@]}" -o "$build_dir/$basename" 2>/dev/null; then
        print_error "C compilation/linking failed"
        exit 1
    fi
    print_success "C → Executable: $basename"
    
    print_success "🎧 Ready to run (audio): $build_dir/$basename"
}

# Run program with audio backend
run_audio_program() {
    local program="$1"
    require_flow_file "$program"
    local basename
    basename=$(basename "$program" .flow)
    local executable="$SCRIPT_DIR/build/$basename"
    
    compile_audio_program "$program" "${2:-}"
    
    print_info "Running $basename (audio)..."
    echo "----------------------------------------"
    "$executable"
    status=$?
    echo "----------------------------------------"
    print_success "Program finished"
    echo "Exit code: $status"
    return $status
}

# Run program in an SDL2 window (requires SDL2 installed, via pkg-config).
run_window_program() {
    local program="$1"
    require_flow_file "$program"
    local basename
    basename=$(basename "$program" .flow)
    local build_dir="$SCRIPT_DIR/build"
    local py_framework_dir="/Applications/Xcode.app/Contents/Developer/Library/Frameworks"
    local py_header_dir="$py_framework_dir/Python3.framework/Headers"
    local py_cflags=()
    local py_ldflags=()
    
    check_deps
    
    if ! command -v pkg-config &> /dev/null; then
        print_error "pkg-config is required for SDL2 linking"
        print_info "Install: brew install pkg-config"
        exit 1
    fi
    if ! pkg-config --exists sdl2; then
        print_error "SDL2 not found (pkg-config sdl2)"
        print_info "Install: brew install sdl2"
        exit 1
    fi
    
    mkdir -p "$build_dir"
    local c_file="$build_dir/$basename.window.c"
    local exe_file="$build_dir/$basename.window"
    
    print_info "Compiling $program (SDL2 window)..."
    if ! python3 -m "$FLOWC_MODULE" "$program" --c --lenient -o "$c_file"; then
        print_error "FLOW compilation failed"
        exit 1
    fi
    print_success "FLOW → C: $(basename "$c_file")"
    
    local sdl_cflags
    local sdl_libs
    sdl_cflags=$(pkg-config --cflags sdl2)
    sdl_libs=$(pkg-config --libs sdl2)
    
    if [ -d "$py_header_dir" ]; then
        py_cflags+=("-I$py_header_dir" "-DFLOW_PY_EMBED")
        py_ldflags+=("-F$py_framework_dir" "-framework" "Python3" "-Wl,-rpath,$py_framework_dir")
    fi
    # shellcheck disable=SC2086
    if ! clang -O2 -fno-omit-frame-pointer $sdl_cflags "${py_cflags[@]}" "$c_file" \
        "$SCRIPT_DIR/runtime/flow_sys_info.c" \
        "$SCRIPT_DIR/runtime/flow_python_embed.c" \
        "$SCRIPT_DIR/runtime/flow_time.c" \
        # shellcheck disable=SC2086
        "${py_ldflags[@]}" -o "$exe_file" $sdl_libs -lm 2>/dev/null; then
        print_error "C compilation/linking failed (SDL2)"
        exit 1
    fi
    print_success "Built: $exe_file"
    
    print_info "Running..."
    "$exe_file"
}
# Generate MLIR only
generate_mlir() {
    local program=""
    local flags=()
    # Accept flags before or after the program path
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -*)
                flags+=("$1")
                # Flags that take a value
                case "$1" in
                    --spirv-out|--output|-o|--opt-level)
                        shift
                        if [ $# -gt 0 ]; then
                            flags+=("$1")
                        fi
                        ;;
                esac
                ;;
            *)
                if [ -z "$program" ]; then
                    program="$1"
                else
                    flags+=("$1")
                fi
                ;;
        esac
        shift
    done
    local basename
    basename=$(basename "$program" .flow)
    local build_dir="$SCRIPT_DIR/build"
    
    if [ -z "$program" ] || [ ! -f "$program" ]; then
        print_error "Program not found: $program"
        exit 1
    fi
    
    mkdir -p "$build_dir"

    check_mlir_deps

    if python3 -m "$FLOWC_MODULE" "$program" --mlir "${flags[@]}" -o "$build_dir/$basename.mlir"; then
        print_success "Generated MLIR: $build_dir/$basename.mlir"
        echo "----------------------------------------"
        cat "$build_dir/$basename.mlir"
        echo "----------------------------------------"
    else
        print_error "MLIR generation failed"
        exit 1
    fi
}

