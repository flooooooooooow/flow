        shift
        if [ -z "${1:-}" ]; then
            print_error "Usage: flow python <program.flow> [--name NAME] [--version VER] [--source]"
            exit 1
        fi
        program="${1:-}"
        require_flow_file "$program"
        shift
        
        # Parse python-specific options
        py_name=""
        py_version="0.1.0"
        py_source_only=0
        
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --name)
                    py_name="$2"
                    shift 2
                    ;;
                --version)
                    py_version="$2"
                    shift 2
                    ;;
                --source)
                    py_source_only=1
                    shift
                    ;;
                *)
                    shift
                    ;;
            esac
        done
        
        print_info "Generating Python package from $program..."
        
        py_args=(--python --python-version "$py_version")
        if [ "$py_source_only" -eq 1 ]; then
            py_args+=(--python-source-only)
        fi
        if [ -n "$py_name" ]; then
            py_args+=(--python-name "$py_name")
        fi

        python3 -m "$FLOWC_MODULE" "$program" "${py_args[@]}"
        ;;
