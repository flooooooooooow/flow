    echo "  vulkan-demo-basic  Alias for vulkan-demo"
    echo "  vulkan-demo-advanced  Build and run Vulkan scene demo"
    echo "  demo vulkan [basic|advanced]  Alias for Vulkan demos"
    echo "  demo vulkan-flow [basic|advanced]  Run Flow Vulkan demos"
    echo "  mlir <program>     Generate MLIR only"
    echo "  mlir-run <program> Compile via MLIR and run"
    echo "  jit <program>      JIT compile and run (fastest)"
    echo "  gpu <program>      Generate Metal/CUDA shaders"
    echo "  transpile <program> [args...]  Run the FLOW transpiler (advanced flags)"
    echo "  fmt <files...>    Format FLOW source files"
    echo ""
    echo "Testing:"
    echo "  test [flags]      Run FLOW tests (transpile + clang validate)"
    echo "                    --strict    Fail on type errors"
    echo "                    --lenient   Warnings only (default)"
    echo "                    --tier1     Transpile only (fast)"
    echo "                    --tier2     Transpile + clang (default)"
    echo "                    --verbose   Show error details"
    echo "  test-strict       Shortcut for: test --strict"
    echo "  test-runtime      Run runtime tests (compile + execute)"
    echo "  test-mlir         Run MLIR verification (requires LLVM)"
