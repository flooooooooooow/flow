                exit 1
            fi
            print_info "Flow → C → threaded WASM (see docs/language/wasm-crossings.md)"
            if ! python3 "$SCRIPT_DIR/wasm/flow_wasm_threads.py" "$1" --workers "$wasm_workers"; then
                print_error "Threaded WASM build failed"
                exit 1
            fi
            exit 0
        fi
        if [ "$wasm_backend" = "mlir" ]; then
            print_info "Flow → MLIR → LLVM → WASM (see docs/language/wasm.md)"
        else
            print_info "Flow → C → WASM (see docs/language/wasm.md)"
        fi
        if ! python3 "$SCRIPT_DIR/scripts/wasm_build.py" "$@" \
                ${wasm_preload[@]+"${wasm_preload[@]}"} \
                ${wasm_link[@]+"${wasm_link[@]}"}; then
            print_error "WASM build failed"
            exit 1
        fi
        ;;
    "playground")
        # Runnable playground: loopback Flow→C API + pointer to the UI.
        pg_port="${2:-8765}"
        print_info "Starting playground compile server on 127.0.0.1:${pg_port}"
        print_info "UI: docs/playground/index.html  (or wiki /flow/ playground)"
        print_info "Click: Run (native local)"
        print_info "Docs: docs/language/debugging.md · docs/language/wasm.md"
        if command -v open >/dev/null 2>&1; then
            open "$SCRIPT_DIR/docs/playground/index.html" 2>/dev/null || true
        fi
        python3 "$SCRIPT_DIR/scripts/playground_compile_server.py" --port "$pg_port"
        ;;
    "setup"|"install-tools")
        install_deps
        ;;
    "install")
        # Install project deps when flow.toml present; else tooling.
        if [ -f "flow.toml" ] || [ "${2:-}" = "--deps" ]; then
            python3 -c "
import sys
sys.path.insert(0, '$SCRIPT_DIR/src')
from flow.package import FlowPackageManager
raise SystemExit(0 if FlowPackageManager().install() else 1)
"
        elif [ "${2:-}" = "--tools" ]; then
            install_deps
        else
            print_info "No flow.toml here — installing compiler tools (LLVM)."
            print_info "For package deps: cd <project> && ./flow install   or  ./flow pkg install"
            install_deps
        fi
        ;;
    "pkg")
        shift
        if [ -z "${1:-}" ]; then
            print_error "Usage: flow pkg <install|add|search|info|publish|init|…>"
            exit 1
        fi
        python3 -m flow.package "$@"
        ;;
    "search")
        shift
        python3 -m flow.package search "$@"
        ;;
    "info")
        shift
        if [ -z "${1:-}" ]; then
            print_error "Usage: flow info <package>"
            exit 1
        fi
        python3 -m flow.package info "$@"
        ;;
    "publish")
        shift
        python3 -m flow.package publish "$@"
        ;;
    "repl")
        check_deps
        python3 -c "
import sys
sys.path.insert(0, '$SCRIPT_DIR/src')
from flow.repl import main
main()
"
        ;;
    "init")
        shift
        python3 -m flow.package init "$@"
        ;;
    "add")
        shift
        if [ $# -eq 0 ]; then
            print_error "Usage: flow add <package[@version]> | <git-url> | --git URL [--name NAME] [--subdir DIR] | --path DIR --name NAME"
            exit 1
        fi
        python3 -m flow.package add "$@"
        ;;
    "build")
        python3 -m flow.package build
        ;;
    "build-native")
        shift
        python3 - "$SCRIPT_DIR" "${1-}" <<'PY'
import sys

script_dir = sys.argv[1]
arg = sys.argv[2] if len(sys.argv) > 2 and sys.argv[2] != "" else None
sys.path.insert(0, f"{script_dir}/src")

from flow.package import FlowPackageManager

pm = FlowPackageManager()
pm.build_native(arg)
PY
        ;;
    "run-native")
        shift
        python3 - "$SCRIPT_DIR" "${1-}" <<'PY'
import sys

script_dir = sys.argv[1]
arg = sys.argv[2] if len(sys.argv) > 2 and sys.argv[2] != "" else None
sys.path.insert(0, f"{script_dir}/src")

from flow.package import FlowPackageManager

pm = FlowPackageManager()
pm.run_native(arg)
PY
        ;;
    "clean")
        python3 -c "
import sys
sys.path.insert(0, '$SCRIPT_DIR/src')
from flow.package import FlowPackageManager
pm = FlowPackageManager()
pm.clean()
"
        ;;
    "examples")
        list_examples
        ;;
    know)
        shift
        python3 "$SCRIPT_DIR/tools/flow_know.py" "$@"
        ;;
    "doc")
        shift
        sub="${1:-}"
        shift || true
        case "$sub" in
            proof)
                if [ -z "${1:-}" ]; then
                    print_error "Usage: flow doc proof <file.flow|directory> [-r]"
                    exit 1
                fi
                python3 "$SCRIPT_DIR/tools/flow_doc.py" proof "$@"
                ;;
            bundle)
                python3 "$SCRIPT_DIR/tools/flow_doc.py" bundle "$@"
                ;;
            kernel)
                if [ -z "${1:-}" ]; then
                    print_error "Usage: flow doc kernel <file.flow> [--param n=0] [--plot out.dot]"
                    exit 1
                fi
                python3 "$SCRIPT_DIR/tools/flow_doc.py" kernel "$@"
                ;;
            *)
                print_error "Usage: flow doc proof <file|dir> [-r]  |  flow doc bundle  |  flow doc kernel <file.flow> [--param n=0] [--plot out.png]"
                exit 1
                ;;
        esac
        ;;
    "help"|*)
        show_help
        ;;
esac
