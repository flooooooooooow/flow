# toml — minimal TOML key = value parser (pure Flow)
# Supports: bare keys, string/integer/bool values, [section] headers.
# Lookup form: "key" or "section.key"

extern {
    function strlen(s: string) -> i64
}

const TOML_OK: i32 = 1
const TOML_ERR: i32 = 0
const TOML_MISSING: i32 = -1

function _is_ws(c: i32) -> i32 {
    if c == 32 or c == 9 {
        return 1
    }
    return 0
}

function _is_key_char(c: i32) -> i32 {
    if (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95 or c == 45 {
        return 1
    }
    return 0
}

function _skip_ws(data: ptr<u8>, i: i32, len: i32) -> i32 {
    let mut p: i32 = i
    while p < len and _is_ws(data[p]) == 1 {
        p = p + 1
    }
    return p
}

function _skip_line(data: ptr<u8>, i: i32, len: i32) -> i32 {
    let mut p: i32 = i
    while p < len and data[p] != 10 {
        p = p + 1
    }
    if p < len and data[p] == 10 {
        p = p + 1
    }
    return p
}

function _bytes_eq(data: ptr<u8>, start: i32, n: i32, s: string) -> i32 {
    let k: ptr<u8> = s
    let klen: i32 = strlen(s) as i32
    if n != klen {
        return 0
    }
    let mut i: i32 = 0
    while i < n {
        if data[start + i] != k[i] {
            return 0
        }
        i = i + 1
    }
    return 1
}

function _copy_bytes(dst: ptr<u8>, src: ptr<u8>, src_off: i32, n: i32) -> void {
    let mut i: i32 = 0
    while i < n {
        dst[i] = src[src_off + i]
        i = i + 1
    }
}

function _parse_i32_at(data: ptr<u8>, i: i32, len: i32) -> i32 {
    let mut p: i32 = _skip_ws(data, i, len)
    let mut sign: i32 = 1
    let mut value: i32 = 0
    if p < len and data[p] == 45 {
        sign = 0 - 1
        p = p + 1
    }
    while p < len and data[p] >= 48 and data[p] <= 57 {
        value = value * 10 + (data[p] - 48)
        p = p + 1
    }
    return value * sign
}

function _key_matches(sec: ptr<u8>, sec_len: i32, data: ptr<u8>, key_start: i32, key_len: i32, want: string) -> i32 {
    let want_len: i32 = strlen(want) as i32
    let w: ptr<u8> = want
    if sec_len == 0 {
        return _bytes_eq(data, key_start, key_len, want)
    }
    if sec_len + 1 + key_len != want_len {
        return 0
    }
    let mut i: i32 = 0
    while i < sec_len {
        if sec[i] != w[i] {
            return 0
        }
        i = i + 1
    }
    if w[sec_len] != 46 {
        return 0
    }
    i = 0
    while i < key_len {
        if data[key_start + i] != w[sec_len + 1 + i] {
            return 0
        }
        i = i + 1
    }
    return 1
}

function _find_value(src: string, want: string) -> i32 {
    let data: ptr<u8> = src
    let len: i32 = strlen(src) as i32
    let mut p: i32 = 0
    let mut sec: array<u8, 64> = []
    let mut sec_len: i32 = 0

    while p < len {
        p = _skip_ws(data, p, len)
        if p >= len {
            break
        }
        if data[p] == 10 {
            p = p + 1
        } else {
            if data[p] == 13 {
                p = p + 1
            } else {
                if data[p] == 35 {
                    p = _skip_line(data, p, len)
                } else {
                    if data[p] == 91 {
                        p = p + 1
                        let start: i32 = p
                        while p < len and data[p] != 93 and data[p] != 10 {
                            p = p + 1
                        }
                        sec_len = p - start
                        if sec_len > 63 {
                            sec_len = 63
                        }
                        let mut i: i32 = 0
                        while i < sec_len {
                            sec[i] = data[start + i]
                            i = i + 1
                        }
                        if p < len and data[p] == 93 {
                            p = p + 1
                        }
                        p = _skip_line(data, p, len)
                    } else {
                        let key_start: i32 = p
                        while p < len and _is_key_char(data[p]) == 1 {
                            p = p + 1
                        }
                        let key_len: i32 = p - key_start
                        p = _skip_ws(data, p, len)
                        if p >= len or data[p] != 61 {
                            p = _skip_line(data, p, len)
                        } else {
                            p = p + 1
                            p = _skip_ws(data, p, len)
                            let sec_ptr: ptr<u8> = sec
                            if _key_matches(sec_ptr, sec_len, data, key_start, key_len, want) == 1 {
                                return p
                            }
                            p = _skip_line(data, p, len)
                        }
                    }
                }
            }
        }
    }
    return 0 - 1
}

export function toml_has_key(src: string, key: string) -> i32 {
    if _find_value(src, key) >= 0 {
        return TOML_OK
    }
    return TOML_ERR
}

export function toml_get_i32(src: string, key: string) -> i32 {
    let data: ptr<u8> = src
    let at: i32 = _find_value(src, key)
    if at < 0 {
        return 0
    }
    return _parse_i32_at(data, at, strlen(src) as i32)
}

export function toml_get_bool(src: string, key: string) -> i32 {
    let data: ptr<u8> = src
    let at: i32 = _find_value(src, key)
    if at < 0 {
        return TOML_MISSING
    }
    let slen: i32 = strlen(src) as i32
    let p: i32 = _skip_ws(data, at, slen)
    if p + 3 < slen and data[p] == 116 and data[p + 1] == 114 and data[p + 2] == 117 and data[p + 3] == 101 {
        return 1
    }
    if p + 4 < slen and data[p] == 102 and data[p + 1] == 97 and data[p + 2] == 108 and data[p + 3] == 115 and data[p + 4] == 101 {
        return 0
    }
    return TOML_MISSING
}

export function toml_get_string(src: string, key: string, out: ptr<u8>, out_cap: i32) -> i32 {
    let data: ptr<u8> = src
    let len: i32 = strlen(src) as i32
    let at: i32 = _find_value(src, key)
    if at < 0 {
        return 0 - 1
    }
    let mut p: i32 = _skip_ws(data, at, len)
    if p >= len or data[p] != 34 {
        return 0 - 1
    }
    p = p + 1
    let start: i32 = p
    while p < len and data[p] != 34 and data[p] != 10 {
        p = p + 1
    }
    if p >= len or data[p] != 34 {
        return 0 - 1
    }
    let n: i32 = p - start
    if n + 1 > out_cap {
        return 0 - 1
    }
    _copy_bytes(out, data, start, n)
    out[n] = 0
    return n
}
