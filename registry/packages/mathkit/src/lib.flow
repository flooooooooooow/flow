# mathkit — small numeric helpers (registry sample package)

export function clamp_i32(x: i32, lo: i32, hi: i32) -> i32 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

export function abs_i32(x: i32) -> i32 {
    if x < 0 {
        return 0 - x
    }
    return x
}

export function max_i32(a: i32, b: i32) -> i32 {
    if a > b {
        return a
    }
    return b
}

export function min_i32(a: i32, b: i32) -> i32 {
    if a < b {
        return a
    }
    return b
}

export function lerp_f32(a: f32, b: f32, t: f32) -> f32 {
    return a + (b - a) * t
}
