# Flow-native language test: Flow functions named like libc functions.
# A Flow `sqrt(v: Vec2)` takes a struct, so it is not libc's sqrt, and a
# Flow `malloc(size: i32) -> i32` returns no pointer, so it is not libc's
# allocator. Calls reach the Flow definitions, as the Python host's
# overload mangling makes them do; flowc used to call libc instead.
# Exit 0 on success; a nonzero exit identifies the failing check.

struct Vec2 {
    x: f64,
    y: f64
}

function sqrt(v: Vec2) -> f64 {
    return v.x * v.x + v.y * v.y
}

function malloc(size: i32) -> i32 {
    return size + 1000
}

function free(block: i32) -> i32 {
    return block - 1000
}

function main() -> i32 {
    let v: Vec2 = Vec2 { x: 3.0, y: 4.0 }
    if sqrt(v) != 25.0 {
        return 1
    }
    let h: i32 = malloc(24)
    if h != 1024 {
        return 2
    }
    if free(h) != 24 {
        return 3
    }
    return 0
}
