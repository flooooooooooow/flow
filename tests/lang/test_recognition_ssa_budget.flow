import "compiler/src/semantic_facts.flow"
import "compiler/src/recognition_ssa.flow"
import "compiler/src/recognition_ssa_budget.flow"

function empty_cert() -> FlowcRefinementCertificate {
    return FlowcRefinementCertificate {
        discrete_refinement: 1,
        witnesses: [
            FlowcRecognitionWitness { domain: 0, distance: 0.0, epsilon: 0.0 },
            FlowcRecognitionWitness { domain: 0, distance: 0.0, epsilon: 0.0 },
            FlowcRecognitionWitness { domain: 0, distance: 0.0, epsilon: 0.0 },
            FlowcRecognitionWitness { domain: 0, distance: 0.0, epsilon: 0.0 },
            FlowcRecognitionWitness { domain: 0, distance: 0.0, epsilon: 0.0 }
        ],
        witness_count: 0
    }
}

function main() -> i32 {
    let contracts: array<FlowcRecognitionContract, 1> = [
        flowc_rssa_contract(FLOWC_RECOGNITION_NUMERICAL, 0.10)
    ]
    let mut budget: FlowcRecognitionBudget
    if flowc_rssa_budget_new(&contracts[0], 1, &budget) != FLOWC_RSSA_OK {
        return 1
    }

    let mut first: FlowcRefinementCertificate = empty_cert()
    first.witness_count = 1
    first.witnesses[0] = FlowcRecognitionWitness {
        domain: FLOWC_RECOGNITION_NUMERICAL,
        distance: 0.06,
        epsilon: 0.10
    }
    if flowc_rssa_budget_consume(&budget, first) != FLOWC_RSSA_OK {
        return 2
    }
    if flowc_rssa_budget_preserved(budget) == 0 {
        return 3
    }

    # Both passes are individually within epsilon, but together spend 0.12.
    let mut second: FlowcRefinementCertificate = empty_cert()
    second.witness_count = 1
    second.witnesses[0] = FlowcRecognitionWitness {
        domain: FLOWC_RECOGNITION_NUMERICAL,
        distance: 0.06,
        epsilon: 0.10
    }
    if flowc_rssa_budget_consume(&budget, second) != FLOWC_RSSA_OK {
        return 4
    }
    if flowc_rssa_budget_preserved(budget) != 0 {
        return 5
    }
    if flowc_rssa_budget_violations(budget) != FLOWC_RECOGNITION_NUMERICAL {
        return 6
    }

    # Discrete refinement remains mandatory across the whole pipeline.
    let mut budget2: FlowcRecognitionBudget
    flowc_rssa_budget_new(&contracts[0], 1, &budget2)
    let mut bad_discrete: FlowcRefinementCertificate = first
    bad_discrete.discrete_refinement = 0
    if flowc_rssa_budget_consume(&budget2, bad_discrete) != FLOWC_RSSA_OK {
        return 7
    }
    if flowc_rssa_budget_preserved(budget2) != 0 {
        return 8
    }

    # A pass may not omit a protected witness.
    let missing: FlowcRefinementCertificate = empty_cert()
    if flowc_rssa_budget_consume(&budget2, missing) != FLOWC_RSSA_BUDGET_MISSING_WITNESS {
        return 9
    }
    return 0
}
