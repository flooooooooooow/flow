# Flow-native language test: `if` as an expression.
#
# `if c { a } else { b }` yields a value. Both a taken and an untaken
# condition are checked, then the original sum the Python test asserted.
#
# Supersedes (behavioral parts of):
#   tests/unit/test_if_expression.py::test_if_expression_runs
# Exit 0 on success; a nonzero exit identifies the failing check.

function main() -> i32 {
    let a: i32 = if 2 > 1 { 7 } else { 9 }
    let b: i32 = if 0 != 0 { 1 } else { 2 }
    if a != 7 {
        return 1
    }
    if b != 2 {
        return 2
    }
    if a + b != 9 {
        return 3
    }
    return 0
}
