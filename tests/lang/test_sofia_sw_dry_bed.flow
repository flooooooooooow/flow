# Dry-bed preservation test for Flow's native shallow-water kernel.
import "stdlib/science/sofia_shallow_water.flow"

function main() -> i32 {
    let nx: i32 = 8
    let ny: i32 = 8
    let num_cells: i32 = 64

    let h: array<f64, 64> = [0.0, 0.0, 0.0, 0.0]
    let mx: array<f64, 64> = [0.0, 0.0, 0.0, 0.0]
    let my: array<f64, 64> = [0.0, 0.0, 0.0, 0.0]
    let z: array<f64, 64> = [0.0, 0.0, 0.0, 0.0]

    let hn: array<f64, 64> = [0.0, 0.0, 0.0, 0.0]
    let mxn: array<f64, 64> = [0.0, 0.0, 0.0, 0.0]
    let myn: array<f64, 64> = [0.0, 0.0, 0.0, 0.0]

    # Dry bed with some water on the left
    for y in 0 to ny {
        for x in 0 to nx {
            let i: i32 = y * nx + x
            z[i] = 0.0

            if x < 2 {
                h[i] = 1.0
            } else {
                h[i] = 0.0  # Actually dry!
            }
            mx[i] = 0.0
            my[i] = 0.0
        }
    }

    let mass0: f64 = sofia_sw_mass(h, 64, 1.0, 1.0)

    # Run a few steps (water should advance but mass should be conserved, depths positive)
    for step in 0 to 10 {
        sofia_sw_step_with_bed(h, mx, my, z, hn, mxn, myn,
                               nx, ny, 1.0, 1.0, 0.05, 9.81, 0.02)
        for i in 0 to 64 {
            h[i] = hn[i]
            mx[i] = mxn[i]
            my[i] = myn[i]
            if h[i] < 0.0 or h[i] != h[i] { return 1 }
        }
    }

    let mass1: f64 = sofia_sw_mass(h, 64, 1.0, 1.0)
    if sofia_sw_abs(mass1 - mass0) > 1e-8 { return 2 }

    # Check that initially dry areas are either still dry or properly wet (positive depth)
    for i in 0 to 64 {
        if h[i] < 0.0 { return 3 }
    }

    return 0
}
