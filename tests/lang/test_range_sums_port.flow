# Tests for compiler/src/range_sums.flow.
# Run with: FLOW_HOST=python ./flow run tests/lang/test_range_sums_port.flow

import "compiler/src/range_sums.flow"

extern {
    function puts(s: string) -> i32
}

function main() -> i32 {
    let unit: FlowcProgression = flowc_range_normalize(0, 10, 1)
    if unit.valid != 1 {
        puts("FAIL: unit range should be valid")
        return 1
    }
    if unit.first != 0 || unit.count != 10 || unit.step != 1 {
        puts("FAIL: unit range normalization")
        return 2
    }
    if flowc_progression_sum(unit) != 45 {
        puts("FAIL: sum 0..10")
        return 3
    }

    if flowc_sum_range(0, 10, 3) != 18 {
        puts("FAIL: sum 0..10 step 3")
        return 4
    }

    let descending: FlowcProgression = flowc_range_normalize(10, 0, 0 - 3)
    if descending.valid != 1 {
        puts("FAIL: descending range should be valid")
        return 5
    }
    if descending.first != 1 || descending.count != 4 || descending.step != 3 {
        puts("FAIL: descending normalization")
        return 6
    }
    if flowc_progression_sum(descending) != 22 {
        puts("FAIL: descending range sum")
        return 7
    }

    let empty: FlowcProgression = flowc_range_normalize(5, 5, 1)
    if empty.valid != 1 || empty.count != 0 {
        puts("FAIL: empty range normalization")
        return 8
    }

    let invalid: FlowcProgression = flowc_range_normalize(0, 10, 0)
    if invalid.valid != 0 {
        puts("FAIL: zero stride should be invalid")
        return 9
    }

    if flowc_range_gcd(12, 18) != 6 {
        puts("FAIL: gcd")
        return 10
    }
    if flowc_range_modinv(3, 5) != 2 {
        puts("FAIL: modular inverse")
        return 11
    }

    let evens: FlowcProgression = flowc_range_normalize(0, 10, 2)
    let every_three: FlowcProgression = flowc_range_normalize(1, 10, 3)
    let both: FlowcProgression = flowc_progression_intersect(evens, every_three)
    if both.valid != 1 || both.first != 4 || both.count != 1 {
        puts("FAIL: CRT intersection")
        return 12
    }
    if flowc_progression_sum(both) != 4 {
        puts("FAIL: intersection sum")
        return 13
    }

    if flowc_sum_range_intersection(0, 10, 2, 1, 10, 3) != 4 {
        puts("FAIL: intersection helper")
        return 14
    }
    if flowc_sum_range_union(0, 10, 2, 1, 10, 3) != 28 {
        puts("FAIL: union helper")
        return 15
    }

    let disjoint_a: FlowcProgression = flowc_range_normalize(0, 8, 4)
    let disjoint_b: FlowcProgression = flowc_range_normalize(1, 8, 4)
    let disjoint: FlowcProgression = flowc_progression_intersect(disjoint_a, disjoint_b)
    if disjoint.count != 0 {
        puts("FAIL: disjoint progressions")
        return 16
    }

    puts("All range_sums Flow port tests passed")
    return 0
}
