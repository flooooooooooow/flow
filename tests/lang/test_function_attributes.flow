# Flow-native language test: inline / noinline / always_inline / target.
#
# The attributes are optimization hints, so they must not change what the
# program computes. This test pins that: the same arithmetic, spread across
# functions carrying each attribute, still produces the expected values.
#
# `@target("crypto")` is a real feature on arm64 and an unknown one
# elsewhere; clang warns on unknown features rather than failing, so it
# compiles and runs on every host.
#
# This file restores the coverage that tests/lang/test_attributes.flow held
# before #438 reused that name for the attributes.flow port test.
#
# Supersedes (behavioral parts of):
#   tests/unit/test_attributes.py::test_inline_compiles_and_runs
#   tests/unit/test_attributes.py::test_exported_inline_compiles_and_runs
#   tests/unit/test_attributes.py::test_noinline_compiles_and_runs
#   tests/unit/test_attributes.py::test_always_inline_compiles_and_runs
#   tests/unit/test_attributes.py::test_target_compiles_and_runs
#   tests/unit/test_attributes.py::test_combined_attributes_compile_and_run
#
# Not superseded: test_noinline_survives_optimization (-O2) and
# test_always_inline_is_accepted_at_O0 (-O0 -Werror) need their own clang
# flags, which test-lang does not take per file.
# Exit 0 on success; a nonzero exit identifies the failing check.

@inline
function add(a: i32, b: i32) -> i32 {
    return a + b
}

@noinline
function sub(a: i32, b: i32) -> i32 {
    return a - b
}

@always_inline
function mul(a: i32, b: i32) -> i32 {
    return a * b
}

# Recursion under @noinline: the body must survive as a real call.
@noinline
function fact(n: i32) -> i32 {
    if n <= 1 {
        return 1
    }
    return n * fact(n - 1)
}

# An @inline function calling an @noinline one, and the reverse.
@inline
function mixed(a: i32) -> i32 {
    return sub(mul(a, 3), 1)
}

@noinline
function mixed_back(a: i32) -> i32 {
    return add(mul(a, 2), 4)
}

# Attributes on an exported function keep external linkage, so the
# generated C uses `extern inline` rather than `static inline`.
@inline
export function exported_add(a: i32, b: i32) -> i32 {
    return a + b
}

@target("crypto")
function bump(a: i32) -> i32 {
    return a + 1
}

# Two attributes on one function, and an always_inline caller feeding it.
@noinline
@target("crypto")
function scale(a: i32) -> i32 {
    return a * 2
}

@always_inline
function offset(a: i32) -> i32 {
    return a + 2
}

function main() -> i32 {
    if add(20, 22) != 42 {
        return 1
    }
    if sub(44, 2) != 42 {
        return 2
    }
    if mul(6, 7) != 42 {
        return 3
    }
    if fact(5) != 120 {
        return 4
    }
    if mixed(5) != 14 {
        return 5
    }
    if mixed_back(19) != 42 {
        return 6
    }
    if exported_add(40, 2) != 42 {
        return 7
    }

    # Attributes are hints: applying them in a loop must not change the sum.
    let mut total: i32 = 0
    let mut i: i32 = 0
    while i < 10 {
        total = add(total, mul(i, 2))
        i = add(i, 1)
    }
    if total != 90 {
        return 8
    }

    if bump(41) != 42 {
        return 9
    }
    if scale(offset(19)) != 42 {
        return 10
    }
    return 0
}
