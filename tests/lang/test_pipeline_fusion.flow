# Test for pipeline_fusion.flow port of pipeline_fusion.py.
# Run with: ./flow run tests/lang/test_pipeline_fusion.flow
# Exit 0 on success.

import "compiler/src/pipeline_fusion.flow"
import "compiler/src/ast.flow"

extern {
    function printf(fmt: string, ...) -> i32
    function puts(s: string) -> i32
}

function main() -> i32 {
    let mut arena = flowc_ast_new(100)

    # buf
    let id_buf: i32 = flowc_ast_alloc(&arena, 12, 0, 0)
    # n
    let id_n1: i32 = flowc_ast_alloc(&arena, 12, 0, 0)
    # 2.0
    let id_2: i32 = flowc_ast_alloc(&arena, 34, 0, 0)
    
    # inner scale call: scale_f32(buf, n, 2.0)
    let inner_call: i32 = flowc_ast_alloc(&arena, 11, 0, 0)
    arena.nodes[inner_call].name_start = 0
    arena.nodes[inner_call].name_end = 9
    arena.nodes[inner_call].a = id_buf
    arena.nodes[id_buf].next = id_n1
    arena.nodes[id_n1].next = id_2
    arena.nodes[id_2].next = -1

    # n
    let id_n2: i32 = flowc_ast_alloc(&arena, 12, 0, 0)
    # 3.0
    let id_3: i32 = flowc_ast_alloc(&arena, 34, 0, 0)

    # outer scale call: scale_f32(inner, n, 3.0)
    let outer_call: i32 = flowc_ast_alloc(&arena, 11, 0, 0)
    arena.nodes[outer_call].name_start = 0
    arena.nodes[outer_call].name_end = 9
    arena.nodes[outer_call].a = inner_call
    arena.nodes[inner_call].next = id_n2
    arena.nodes[id_n2].next = id_3
    arena.nodes[id_3].next = -1

    # A third stage checks that the pass reaches a fixed point.
    let id_n3: i32 = flowc_ast_alloc(&arena, 12, 0, 0)
    let id_4: i32 = flowc_ast_alloc(&arena, 34, 0, 0)
    let outer2_call: i32 = flowc_ast_alloc(&arena, 11, 0, 0)
    arena.nodes[outer2_call].name_start = 0
    arena.nodes[outer2_call].name_end = 9
    arena.nodes[outer2_call].a = outer_call
    arena.nodes[outer_call].next = id_n3
    arena.nodes[id_n3].next = id_4
    arena.nodes[id_4].next = -1

    # A different nine-character function name must remain untouched.
    let bad_buf: i32 = flowc_ast_alloc(&arena, 12, 0, 0)
    let bad_n1: i32 = flowc_ast_alloc(&arena, 12, 0, 0)
    let bad_v1: i32 = flowc_ast_alloc(&arena, 34, 0, 0)
    let bad_inner: i32 = flowc_ast_alloc(&arena, 11, 0, 0)
    arena.nodes[bad_inner].name_start = 9
    arena.nodes[bad_inner].name_end = 18
    arena.nodes[bad_inner].a = bad_buf
    arena.nodes[bad_buf].next = bad_n1
    arena.nodes[bad_n1].next = bad_v1
    let bad_n2: i32 = flowc_ast_alloc(&arena, 12, 0, 0)
    let bad_v2: i32 = flowc_ast_alloc(&arena, 34, 0, 0)
    let bad_outer: i32 = flowc_ast_alloc(&arena, 11, 0, 0)
    arena.nodes[bad_outer].name_start = 9
    arena.nodes[bad_outer].name_end = 18
    arena.nodes[bad_outer].a = bad_inner
    arena.nodes[bad_inner].next = bad_n2
    arena.nodes[bad_n2].next = bad_v2

    # A f64 outer stage must not fuse with an f32 inner stage.
    let f64_buf: i32 = flowc_ast_alloc(&arena, 12, 0, 0)
    let f64_n1: i32 = flowc_ast_alloc(&arena, 12, 0, 0)
    let f64_v1: i32 = flowc_ast_alloc(&arena, 34, 0, 0)
    let f64_inner: i32 = flowc_ast_alloc(&arena, 11, 0, 0)
    arena.nodes[f64_inner].name_start = 0
    arena.nodes[f64_inner].name_end = 9
    arena.nodes[f64_inner].a = f64_buf
    arena.nodes[f64_buf].next = f64_n1
    arena.nodes[f64_n1].next = f64_v1
    let f64_n2: i32 = flowc_ast_alloc(&arena, 12, 0, 0)
    let f64_v2: i32 = flowc_ast_alloc(&arena, 34, 0, 0)
    let f64_outer: i32 = flowc_ast_alloc(&arena, 11, 0, 0)
    arena.nodes[f64_outer].name_start = 18
    arena.nodes[f64_outer].name_end = 27
    arena.nodes[f64_outer].a = f64_inner
    arena.nodes[f64_inner].next = f64_n2
    arena.nodes[f64_n2].next = f64_v2

    let src: string = "scale_f32other_funscale_f64"

    # fuse
    flowc_fuse_pipelines(&arena, src as ptr<u8>)

    # verify
    if arena.nodes[outer2_call].a != id_buf {
        puts("FAIL: outer_call.a should be buf")
        return 1
    }
    let n_node: i32 = arena.nodes[id_buf].next
    if n_node != id_n1 {
        puts("FAIL: first arg next should be n1")
        return 2
    }
    let binop_node: i32 = arena.nodes[n_node].next
    if arena.nodes[binop_node].kind != 9 {
        puts("FAIL: third arg should be BINOP")
        return 3
    }
    let first_binop: i32 = arena.nodes[binop_node].a
    if arena.nodes[first_binop].kind != 9 or arena.nodes[first_binop].a != id_2 {
        puts("FAIL: first fused operation should start with 2.0")
        return 4
    }
    if arena.nodes[first_binop].b != id_3 or arena.nodes[binop_node].b != id_4 {
        puts("FAIL: fused operations should retain 3.0 and 4.0")
        return 5
    }
    if arena.nodes[bad_outer].a != bad_inner {
        puts("FAIL: unrelated nine-character function was fused")
        return 6
    }
    if arena.nodes[f64_outer].a != f64_inner {
        puts("FAIL: f32 and f64 stages were fused")
        return 7
    }

    flowc_ast_free(arena)
    puts("All pipeline_fusion tests passed")
    return 0
}
