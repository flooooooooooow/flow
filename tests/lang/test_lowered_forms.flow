# Forms flowc used to parse but refuse, now lowered (#996): match
# or-patterns, guards and nested patterns, pipeline fork and choose blocks,
# the `_` pipe placeholder, declarative sort, [T; N], expr?, module blocks
# and unit declarations. main() returns 0, or the number of the failed check.

unit Meter

struct Inner {
    x: i32
}

struct Outer {
    inner: Inner,
    tag: i32
}

struct Stats {
    doubled: i32,
    squared: i32
}

struct Row {
    score: i32,
    id: i32
}

struct Result_i32_string {
    is_ok: bool,
    value: i32,
    error: string
}

enum Mode {
    Double,
    Triple
}

module helpers {
    function twice(x: i32) -> i32 {
        return x * 2
    }
}

function square(x: i32) -> i32 {
    return x * x
}

function triple(x: i32) -> i32 {
    return x * 3
}

function sub(a: i32, b: i32) -> i32 {
    return a - b
}

function classify(v: i32) -> i32 {
    match v {
        1 | 2 => {
            return 10
        }
        n if n > 100 => {
            return 30
        }
        _ => {
            return 20
        }
    }
    return 0
}

function nested(o: Outer) -> i32 {
    match o {
        Outer(Inner(0), t) => {
            return 100 + t
        }
        Outer(Inner(x), t) if x > t => {
            return x - t
        }
        Outer(Inner(x), t) => {
            return x + t
        }
    }
    return 0
}

function pick(m: Mode, x: i32) -> i32 {
    return x |> choose m.tag {
        Mode_Double => twice,
        Mode_Triple => triple,
    }
}

function ok(v: i32) -> Result_i32_string {
    return Result_i32_string { is_ok: true, value: v, error: "" }
}

function fail() -> Result_i32_string {
    return Result_i32_string { is_ok: false, value: 0, error: "no" }
}

function add_one(r: Result_i32_string) -> Result_i32_string {
    let v: i32 = r?
    return ok(v + 1)
}

function main() -> i32 {
    if classify(2) != 10 or classify(7) != 20 or classify(500) != 30 {
        return 1
    }
    let o1: Outer = Outer { inner: Inner { x: 0 }, tag: 4 }
    let o2: Outer = Outer { inner: Inner { x: 9 }, tag: 4 }
    let o3: Outer = Outer { inner: Inner { x: 1 }, tag: 4 }
    if nested(o1) != 104 or nested(o2) != 5 or nested(o3) != 5 {
        return 2
    }
    let s: Stats = 6 |> Stats { doubled = twice, squared = square }
    if s.doubled != 12 or s.squared != 36 {
        return 3
    }
    let d: Mode = Mode { tag: Mode_Double }
    let t: Mode = Mode { tag: Mode_Triple }
    if pick(d, 5) != 10 or pick(t, 5) != 15 {
        return 4
    }
    if (10 |> sub(3, _)) != 0 - 7 {
        return 5
    }
    let mut rows: array<Row, 4> = [
        Row { score: 10, id: 2 },
        Row { score: 30, id: 1 },
        Row { score: 10, id: 1 },
        Row { score: 20, id: 3 }
    ]
    rows |> sort by [desc .score, asc .id]
    if rows[0].score != 30 or rows[2].id != 1 or rows[3].id != 2 {
        return 6
    }
    let mut xs: [i32; 4] = [4, 1, 3, 2]
    xs |> sort
    if xs[0] != 1 or xs[3] != 4 {
        return 7
    }
    if add_one(ok(1)).value != 2 or add_one(fail()).is_ok {
        return 8
    }
    let m: Meter = 2.5 as Meter
    if (m as f64) < 2.0 {
        return 9
    }
    return 0
}
