# The proof layer has no runtime behaviour: theorems are dropped, and
# `assume` / `therefore` inside an ordinary function are erased, the way
# the Python host treated them (#996).
# Exit 0 on success.

# @means  Doubling a number is the same as adding it to itself.
# @tier   derived
theorem «Int» «addition» «doubling adds a number to itself» (n: i32) {
    let d = n + n
    therefore d == 2 * n by smt
}

theorem Nat/+.zero-right(n) {
    assume Nat/+.zero-left(n)
    therefore n + 0 == n
}

export «Int» «addition» «doubling adds a number to itself»

function double(n: i32) -> i32 {
    assume «Int» «addition» «doubling adds a number to itself»(n)
    let d: i32 = n + n
    therefore d == 2 * n
    return d
}

function main() -> i32 {
    if double(21) != 42 {
        return 1
    }
    if double(0) != 0 {
        return 2
    }
    return 0
}
