# Experimental rewrite legality and extraction regression gate (#1668).
# Execute: ./flow test-lang tests/lang/test_compiler_research_contracts.flow

import "tools/compiler_research/contracts.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>)
}

function main() -> i32 {
    let nodes: ptr<OptNode> = malloc(14 * sizeof<OptNode>()) as ptr<OptNode>
    let proposals: ptr<OptProposal> = malloc(6 * sizeof<OptProposal>()) as ptr<OptProposal>

    # 2: x + 0, 4: (x + 0) * 1, 5: 0 + x
    nodes[0] = opt_node(OPT_VAR, OPT_I32, -1, -1, 0, 0)
    nodes[1] = opt_node(OPT_CONST, OPT_I32, -1, -1, 0, 0)
    nodes[2] = opt_node(OPT_ADD, OPT_I32, 0, 1, 0, 0)
    nodes[3] = opt_node(OPT_CONST, OPT_I32, -1, -1, 1, 0)
    nodes[4] = opt_node(OPT_MUL, OPT_I32, 2, 3, 0, 0)
    nodes[5] = opt_node(OPT_ADD, OPT_I32, 1, 0, 0, 0)
    nodes[6] = opt_node(OPT_EFFECT, OPT_I32, -1, -1, 0, 8)
    nodes[7] = opt_node(OPT_ADD, OPT_I32, 6, 3, 0, 0)
    nodes[8] = opt_node(OPT_ADD, OPT_I32, 3, 6, 0, 0)
    nodes[9] = opt_node(OPT_VAR, OPT_F64, -1, -1, 0, 0)
    nodes[10] = opt_node(OPT_CONST, OPT_F64, -1, -1, 0, 0)
    nodes[11] = opt_node(OPT_ADD, OPT_F64, 9, 10, 0, 0)
    nodes[12] = opt_node(OPT_ADD, OPT_I32, 0, 3, 0, 0)
    nodes[13] = opt_node(OPT_ADD, OPT_I32, 3, 0, 0, 0)

    if opt_check_rule(nodes, 14, opt_proposal(1, 2, 0, OPT_ADD_ZERO, 1, 1, 0)) != OPT_OK { return 1 }
    if opt_check_rule(nodes, 14, opt_proposal(2, 4, 2, OPT_MUL_ONE, 2, 1, 0)) != OPT_OK { return 2 }
    if opt_check_rule(nodes, 14, opt_proposal(3, 5, 0, OPT_ADD_ZERO, 1, 1, 0)) != OPT_OK { return 3 }
    if opt_check_rule(nodes, 14, opt_proposal(4, 12, 13, OPT_COMMUTE_ADD, 2, 1, 0)) != OPT_OK { return 4 }

    # A claimed shortcut x+1 -> x is not a valid neutral-element rewrite.
    if opt_check_rule(nodes, 14, opt_proposal(5, 12, 0, OPT_ADD_ZERO, 0, 1, 0)) != OPT_BAD_SHAPE { return 5 }
    # A seductive reorder of an effectful call is not allowed.
    if opt_check_rule(nodes, 14, opt_proposal(6, 7, 8, OPT_COMMUTE_ADD, 0, 1, 0)) != OPT_EFFECT_BARRIER { return 6 }
    # f64 x+0 can change signed-zero semantics; never treat it as i32.
    if opt_check_rule(nodes, 14, opt_proposal(7, 11, 9, OPT_ADD_ZERO, 0, 1, 0)) != OPT_NUMERIC_MODEL { return 7 }
    # Reassociation is not an approved local rule.
    if opt_check_rule(nodes, 14, opt_proposal(8, 2, 0, 99, 0, 1, 0)) != OPT_UNSUPPORTED { return 8 }
    if opt_check_rule(nodes, 14, opt_proposal(9, 100, 0, OPT_ADD_ZERO, 0, 1, 0)) != OPT_BAD_INDEX { return 9 }
    if opt_effects(nodes, 14, 7, 15) == 0 { return 10 }
    # An unannotated effect operation must still fail closed.
    nodes[6] = opt_node(OPT_EFFECT, OPT_I32, -1, -1, 0, 0)
    if opt_effects(nodes, 14, 7, 15) == 0 { return 17 }
    nodes[6] = opt_node(OPT_EFFECT, OPT_I32, -1, -1, 0, 8)
    if opt_effects(nodes, 14, 100, 15) != OPT_UNKNOWN_EFFECT { return 11 }

    proposals[0] = opt_proposal(30, 4, 2, OPT_MUL_ONE, 4, 3, 0)
    proposals[1] = opt_proposal(10, 4, 0, OPT_MUL_ONE, 0, 3, 0)
    proposals[2] = opt_proposal(40, 4, 4, OPT_KEEP, 8, 3, 0)
    let result: OptSelection = opt_extract(nodes, 14, 4, proposals, 3, 10, 1, 256)
    if result.selected_id != 30 or result.selected_root != 2 { return 12 }
    if result.accepted != 2 or result.rejected != 1 { return 13 }

    # Costs cannot override a preservation contract or resource budget.
    proposals[0] = opt_proposal(30, 4, 2, OPT_MUL_ONE, 1, 1, 8192)
    let fallback: OptSelection = opt_extract(nodes, 14, 4, proposals, 1, 10, 3, 4096)
    if fallback.selected_id != -1 or fallback.selected_root != 4 or fallback.rejected != 1 { return 14 }

    # Tie-breaking is by stable candidate id, not traversal order.
    proposals[0] = opt_proposal(20, 2, 0, OPT_ADD_ZERO, 2, 1, 0)
    proposals[1] = opt_proposal(10, 2, 0, OPT_ADD_ZERO, 2, 1, 0)
    let tied: OptSelection = opt_extract(nodes, 14, 2, proposals, 2, 5, 1, 0)
    if tied.selected_id != 10 or tied.selected_root != 0 { return 15 }

    # Wrong-source proposals are rejected without touching the graph.
    let original: OptSelection = opt_extract(nodes, 14, 12, proposals, 2, 5, 0, -1)
    if original.selected_id != -1 or original.selected_root != 12 { return 16 }

    free(proposals as ptr<void>)
    free(nodes as ptr<void>)
    return 0
}
