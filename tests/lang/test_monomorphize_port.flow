# Tests for compiler/src/monomorphize.flow.

import "compiler/src/monomorphize.flow"

extern {
    function strcmp(a: ptr<u8>, b: ptr<u8>) -> i32
    function puts(s: string) -> i32
}

function main() -> i32 {
    let buf: array<u8, 256>

    if flowc_mono_mangle_one("identity" as string, "i32" as string, &buf[0], 256) < 0 {
        puts("FAIL: one-arg mangle")
        return 1
    }
    if strcmp(&buf[0], "identity_i32" as ptr<u8>) != 0 {
        puts("FAIL: one-arg spelling")
        return 2
    }

    if flowc_mono_mangle_two("Pair" as string, "i32" as string, "f32" as string, &buf[0], 256) < 0 {
        puts("FAIL: two-arg mangle")
        return 3
    }
    if strcmp(&buf[0], "Pair_i32_f32" as ptr<u8>) != 0 {
        puts("FAIL: two-arg spelling")
        return 4
    }

    if flowc_mono_mangle_one("identity" as string, "i32" as string, &buf[0], 8) != -1 {
        puts("FAIL: mangle capacity guard")
        return 5
    }

    if flowc_mono_encode_compound(
        "i32" as string,
        1, 0, 0,
        0, 0,
        0, "" as string,
        0, "" as string,
        &buf[0], 256
    ) < 0 {
        puts("FAIL: pointer compound encode")
        return 6
    }
    if strcmp(&buf[0], "P__N3_i32" as ptr<u8>) != 0 {
        puts("FAIL: pointer compound spelling")
        return 7
    }

    if flowc_mono_encode_compound(
        "Handler" as string,
        0, 1, 1,
        0, 0,
        0, "" as string,
        0, "" as string,
        &buf[0], 256
    ) < 0 {
        puts("FAIL: ref/cap compound encode")
        return 8
    }
    if strcmp(&buf[0], "R__C__N7_Handler" as ptr<u8>) != 0 {
        puts("FAIL: ref/cap compound spelling")
        return 9
    }

    if flowc_mono_encode_compound(
        "array" as string,
        0, 0, 0,
        1, 4,
        1, "i32" as string,
        0, "" as string,
        &buf[0], 256
    ) < 0 {
        puts("FAIL: sized element encode")
        return 10
    }
    if strcmp(&buf[0], "N5_array__S4__Ei32" as ptr<u8>) != 0 {
        puts("FAIL: sized element spelling")
        return 11
    }

    if flowc_mono_encode_compound(
        "Result" as string,
        0, 0, 0,
        0, 0,
        0, "" as string,
        2, "i32_f64" as string,
        &buf[0], 256
    ) < 0 {
        puts("FAIL: generic args encode")
        return 12
    }
    if strcmp(&buf[0], "N6_Result__T2_i32_f64" as ptr<u8>) != 0 {
        puts("FAIL: generic args spelling")
        return 13
    }

    if flowc_mono_encode_compound(
        "VeryLongTypeName" as string,
        0, 0, 0,
        1, 12345,
        0, "" as string,
        0, "" as string,
        &buf[0], 256
    ) < 0 {
        puts("FAIL: decimal length/size encode")
        return 14
    }
    if strcmp(&buf[0], "N16_VeryLongTypeName__S12345" as ptr<u8>) != 0 {
        puts("FAIL: decimal length/size spelling")
        return 15
    }

    if flowc_mono_depth_allowed(0) != 1 {
        puts("FAIL: depth zero")
        return 16
    }
    if flowc_mono_depth_allowed(63) != 1 {
        puts("FAIL: depth 63")
        return 17
    }
    if flowc_mono_depth_allowed(64) != 0 {
        puts("FAIL: depth limit")
        return 18
    }
    if flowc_mono_depth_allowed(-1) != 0 {
        puts("FAIL: negative depth")
        return 19
    }

    if flowc_mono_should_generate(0, 0, 0) != 1 {
        puts("FAIL: fresh specialization")
        return 20
    }
    if flowc_mono_should_generate(1, 0, 0) != 0 {
        puts("FAIL: already generated")
        return 21
    }
    if flowc_mono_should_generate(0, 1, 0) != 0 {
        puts("FAIL: concrete collision")
        return 22
    }
    if flowc_mono_should_generate(0, 0, 64) != 0 {
        puts("FAIL: depth blocks generation")
        return 23
    }

    puts("All monomorphization Flow port tests passed")
    return 0
}
