# sum(A | B) and sum(A & B) over two stepped ranges agree with a brute-force
# loop over the same elements, and each bound is evaluated once (#949).
# Supersedes tests/integration/test_range_algebra.py
# ::test_compiled_algebra_matches_a_brute_force_loop and
# ::test_each_bound_is_evaluated_exactly_once.

extern {
    function calloc(count: i64, size: i64) -> ptr<i32>
}

function in_range(x: i32, lo: i32, hi: i32, stride: i32) -> i32 {
    let mut z: i32 = lo
    while (stride > 0 and z < hi) or (stride < 0 and z > hi) {
        if z == x {
            return 1
        }
        z = z + stride
    }
    return 0
}

function brute_union(sa: i32, ea: i32, pa: i32, sb: i32, eb: i32, pb: i32) -> i32 {
    let mut total: i32 = 0
    let mut x: i32 = sa
    while (pa > 0 and x < ea) or (pa < 0 and x > ea) {
        total = total + x
        x = x + pa
    }
    let mut y: i32 = sb
    while (pb > 0 and y < eb) or (pb < 0 and y > eb) {
        if in_range(y, sa, ea, pa) == 0 {
            total = total + y
        }
        y = y + pb
    }
    return total
}

function brute_isect(sa: i32, ea: i32, pa: i32, sb: i32, eb: i32, pb: i32) -> i32 {
    let mut total: i32 = 0
    let mut y: i32 = sb
    while (pb > 0 and y < eb) or (pb < 0 and y > eb) {
        if in_range(y, sa, ea, pa) == 1 {
            total = total + y
        }
        y = y + pb
    }
    return total
}

function bound(calls: ptr<i32>, value: i32) -> i32 {
    calls[0] = calls[0] + 1
    return value
}

function main() -> i32 {
    let mut bad: i32 = 0
    let mut i: i32 = 0
    while i < 500 {
        let sa: i32 = (i * 7) % 23 - 11
        let sb: i32 = (i * 13) % 19 - 9
        let pa: i32 = ((i * 5) % 13) - 6
        let pb: i32 = ((i * 3) % 11) - 5
        if pa != 0 and pb != 0 {
            let ea: i32 = sa + (i % 31) - 15
            let eb: i32 = sb + (i % 27) - 13
            if sum(sa..ea step pa | sb..eb step pb) != brute_union(sa, ea, pa, sb, eb, pb) {
                bad = bad + 1
            }
            if sum(sa..ea step pa & sb..eb step pb) != brute_isect(sa, ea, pa, sb, eb, pb) {
                bad = bad + 1
            }
        }
        i = i + 1
    }
    if bad != 0 {
        return 1
    }
    let calls: ptr<i32> = calloc(1, 4)
    let total: i32 = sum(
        bound(calls, 0)..bound(calls, 1000) step bound(calls, 3) | bound(calls, 0)..bound(calls, 1000) step bound(calls, 5)
    )
    if total != 233168 {
        return 2
    }
    if calls[0] != 6 {
        return 3
    }
    return 0
}
