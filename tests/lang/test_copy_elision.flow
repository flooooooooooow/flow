# Value semantics for in-place record-update lowering (#732).
#
# The C backend may construct `Name { ..base, f: v }` into a let, an
# assignment target, or a last-use return. The base must stay unchanged
# whenever the destination is a distinct object, and a dest==base update
# whose values read the dest must still see the old fields (a swap).
# Exit 0 on success; a nonzero exit identifies the failing check.

struct Point {
    x: i32,
    y: i32,
    z: i32
}

struct Samples {
    n: i32,
    v: array<i32, 3>
}

function let_keeps_base(p: Point) -> i32 {
    let q: Point = Point { ..p, x: 9 }
    if p.x != 1 or p.y != 2 or p.z != 3 {
        return 1
    }
    if q.x != 9 or q.y != 2 or q.z != 3 {
        return 2
    }
    return 0
}

function assign_keeps_base(p: Point) -> i32 {
    let mut q: Point = Point { x: 0, y: 0, z: 0 }
    q = Point { ..p, x: 8 }
    if p.x != 1 or q.x != 8 or q.y != 2 or q.z != 3 {
        return 3
    }
    return 0
}

function assign_same_field(p: Point) -> i32 {
    let mut q: Point = p
    q = Point { ..q, x: 7 }
    if q.x != 7 or q.y != 2 or q.z != 3 {
        return 4
    }
    if p.x != 1 {
        return 5
    }
    return 0
}

function assign_same_swap(p: Point) -> i32 {
    let mut q: Point = p
    q = Point { ..q, x: q.y, y: q.x }
    if q.x != 2 or q.y != 1 or q.z != 3 {
        return 6
    }
    return 0
}

function move_return(p: Point) -> Point {
    return Point { ..p, x: 6 }
}

function copy_return_reads_base(p: Point) -> Point {
    return Point { ..p, x: p.y, y: p.x }
}

function array_field(a: Samples) -> i32 {
    let fresh: array<i32, 3> = [7, 8, 9]
    let b: Samples = Samples { ..a, v: fresh }
    if a.v[0] != 1 or a.v[2] != 3 or a.n != 4 {
        return 7
    }
    if b.v[0] != 7 or b.v[2] != 9 or b.n != 4 {
        return 8
    }
    return 0
}

function main() -> i32 {
    let p: Point = Point { x: 1, y: 2, z: 3 }
    let e1: i32 = let_keeps_base(p)
    if e1 != 0 { return e1 }
    let e2: i32 = assign_keeps_base(p)
    if e2 != 0 { return e2 }
    let e3: i32 = assign_same_field(p)
    if e3 != 0 { return e3 }
    let e4: i32 = assign_same_swap(p)
    if e4 != 0 { return e4 }
    let m: Point = move_return(p)
    if m.x != 6 or m.y != 2 or m.z != 3 { return 9 }
    if p.x != 1 { return 10 }
    let s: Point = copy_return_reads_base(p)
    if s.x != 2 or s.y != 1 or s.z != 3 { return 11 }
    if p.x != 1 or p.y != 2 { return 12 }
    let a: Samples = Samples { n: 4, v: [1, 2, 3] }
    let e5: i32 = array_field(a)
    if e5 != 0 { return e5 }
    return 0
}
