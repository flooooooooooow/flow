# std.bytebuf: the growable byte buffer the compiler's source expanders and
# the standard library share (issue #985).
# Exit 0 on success; a nonzero exit names the failing check.

import std.bytebuf {
    ByteBuf, bb_new, bb_free, bb_putc, bb_puts, bb_put_span, bb_put_bytes,
    bb_put_i32, bb_put_i64, bb_len, bb_at, bb_cstr, bb_str, bb_truncate,
    bb_clear, bb_reserve, bb_is_space, bb_is_digit, bb_is_word, bb_is_alpha,
    bb_span_eq
}

extern {
    function strcmp(a: string, b: string) -> i32
}

function main() -> i32 {
    # Starts small and grows past its first capacity.
    let b: ptr<ByteBuf> = bb_new(1)
    let mut i: i32 = 0
    while i < 1000 {
        bb_putc(b, (97 + (i % 26)) as u8)
        i = i + 1
    }
    if bb_len(b) != 1000 { return 1 }
    if bb_at(b, 0) != 97 or bb_at(b, 25) != 122 or bb_at(b, 26) != 97 { return 2 }
    if bb_at(b, 1000) != 0 - 1 or bb_at(b, 0 - 1) != 0 - 1 { return 3 }
    if b.err != 0 { return 4 }

    bb_clear(b)
    if bb_len(b) != 0 or strcmp(bb_cstr(b), "") != 0 { return 5 }

    bb_puts(b, "n = ")
    bb_put_i32(b, 0 - 42)
    bb_putc(b, 32)
    bb_put_i64(b, 9223372036854775807)
    bb_putc(b, 32)
    bb_put_i64(b, 0 - 9223372036854775807 - 1)
    if strcmp(bb_cstr(b), "n = -42 9223372036854775807 -9223372036854775808") != 0 { return 6 }

    let src: string = "hello, world"
    bb_clear(b)
    bb_put_span(b, src as ptr<u8>, 7, 12)
    bb_put_span(b, src as ptr<u8>, 3, 3)
    bb_put_bytes(b, src as ptr<u8>, 5)
    if strcmp(bb_cstr(b), "worldhello") != 0 { return 7 }

    # bb_str copies; the view follows later writes.
    let copy: string = bb_str(b)
    bb_truncate(b, 5)
    if strcmp(copy, "worldhello") != 0 { return 8 }
    if strcmp(bb_cstr(b), "world") != 0 { return 9 }
    if bb_reserve(b, 100000) == false or b.cap < 100005 { return 10 }
    bb_free(b)

    # Python str.isspace() over ASCII.
    if bb_is_space(32) == false or bb_is_space(9) == false or bb_is_space(13) == false { return 11 }
    if bb_is_space(28) == false or bb_is_space(31) == false { return 12 }
    if bb_is_space(8) or bb_is_space(14) or bb_is_space(65) { return 13 }
    if bb_is_digit(48) == false or bb_is_digit(57) == false or bb_is_digit(47) { return 14 }
    if bb_is_word(95) == false or bb_is_word(90) == false or bb_is_word(45) { return 15 }
    if bb_is_alpha(95) or bb_is_alpha(97) == false { return 16 }
    if bb_span_eq(src as ptr<u8>, 0, 5, "help" as ptr<u8>, 0, 4) { return 17 }
    if bb_span_eq(src as ptr<u8>, 0, 3, "help" as ptr<u8>, 0, 3) == false { return 18 }
    return 0
}
