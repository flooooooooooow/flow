import "stdlib/science/sofia_lattice_boltzmann.flow"
import "stdlib/math.flow"

extern {
    function printf(fmt: string, val: f64) -> i32
}

function lbm_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

function compute_kinetic_energy(f: ptr<f64>, nx: i32, ny: i32, nz: i32) -> f64 {
    let mut ke: f64 = 0.0
    for z in 0 to nz {
        for y in 0 to ny {
            for x in 0 to nx {
                let cell: i32 = sofia_lbm_index(x, y, z, nx, ny)
                let mut rho: f64 = 0.0
                let mut jx: f64 = 0.0
                let mut jy: f64 = 0.0
                let mut jz: f64 = 0.0
                for q in 0 to 19 {
                    let fq: f64 = f[cell * 19 + q]
                    rho = rho + fq
                    jx = jx + fq * (sofia_lbm_cx(q) as f64)
                    jy = jy + fq * (sofia_lbm_cy(q) as f64)
                    jz = jz + fq * (sofia_lbm_cz(q) as f64)
                }
                let ux: f64 = jx / rho
                let uy: f64 = jy / rho
                let uz: f64 = jz / rho
                ke = ke + 0.5 * rho * (ux * ux + uy * uy + uz * uz)
            }
        }
    }
    return ke
}

function main() -> i32 {
    let nx: i32 = 32
    let ny: i32 = 32
    let nz: i32 = 8
    let n: i32 = nx * ny * nz
    let n_dist: i32 = n * 19

    let f: array<f64, 155648> = [0.0, 0.0, 0.0, 0.0]
    let next: array<f64, 155648> = [0.0, 0.0, 0.0, 0.0]
    let masks: array<i32, 8192> = [0, 0, 0, 0]

    for i in 0 to n {
        masks[i] = 0
    }

    let rho0: f64 = 1.0
    let u0: f64 = 0.001
    let omega: f64 = 1.0
    let nu: f64 = (1.0 / omega - 0.5) / 3.0

    let kx: f64 = 2.0 * PI as f64 / (nx as f64)
    let ky: f64 = 2.0 * PI as f64 / (ny as f64)

    for z in 0 to nz {
        for y in 0 to ny {
            for x in 0 to nx {
                let cell: i32 = sofia_lbm_index(x, y, z, nx, ny)
                let xx: f64 = (x as f64) + 0.5
                let yy: f64 = (y as f64) + 0.5

                let ux: f64 = -u0 * cos(kx * xx) * sin(ky * yy)
                let uy: f64 = u0 * sin(kx * xx) * cos(ky * yy)
                let uz: f64 = 0.0

                let p: f64 = rho0 / 3.0 - rho0 * u0 * u0 / 4.0 * (cos(2.0 * kx * xx) + cos(2.0 * ky * yy))
                let rho: f64 = p * 3.0

                for q in 0 to 19 {
                    f[cell * 19 + q] = sofia_lbm_equilibrium(q, rho, ux, uy, uz)
                }
            }
        }
    }

    let ke_initial: f64 = compute_kinetic_energy(f, nx, ny, nz)

    let steps: i32 = 10
    for t in 0 to steps {
        sofia_lbm_d3q19_les_step(f, next, masks, nx, ny, nz, omega, 0.0, 0.0, 0.0, 0.0)
        for i in 0 to n_dist {
            f[i] = next[i]
        }
    }

    let ke_final: f64 = compute_kinetic_energy(f, nx, ny, nz)

    let k2: f64 = kx * kx + ky * ky
    let decay_rate: f64 = 2.0 * nu * k2
    let expected_ke: f64 = ke_initial * exp(-decay_rate * (steps as f64))

    let ke_error: f64 = lbm_abs(ke_final - expected_ke) / expected_ke

    if ke_error > 0.005 {
        print("Taylor-Green vortex error exceeded tolerance\n")
        print("Initial KE : ")
        printf("%.12f\n", ke_initial)
        print("Final KE   : ")
        printf("%.12f\n", ke_final)
        print("Expected KE: ")
        printf("%.12f\n", expected_ke)
        print("KE Error   : ")
        printf("%.12f\n", ke_error)
        return 1
    }

    return 0
}
