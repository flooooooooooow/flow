# Flow-native language test: lambdas and named functions passed to a
# function-typed parameter of a function from another module (#1043). They
# must arrive as closures, as in a call within one module. flowc passed a
# bare function pointer, which the C compiler rejected. This module names
# no function type itself.
# Exit 0 on success; a nonzero exit identifies the failing check.

import "tests/fixtures/closure_import/mathlib.flow"

function twice(v: f32) -> f32 {
    return v * 2.0
}

function add(acc: i32, i: i32) -> i32 {
    return acc + i
}

function main() -> i32 {
    if apply(|v: f32| -> f32 { return v * 2.0 }, 3.0) != 6.0 {
        return 1
    }
    let k: f32 = 10.0
    if apply(|v: f32| -> f32 { return v + k }, 3.0) != 13.0 {
        return 2
    }
    if apply(twice, 4.0) != 8.0 {
        return 3
    }
    let half = |v: f32| -> f32 { return v / 2.0 }
    if apply(half, 9.0) != 4.5 {
        return 4
    }
    if fold(5, 0, add) != 10 {
        return 5
    }
    let m: i32 = 3
    if fold(4, 1, |acc: i32, i: i32| -> i32 { return acc * m + i }) != 99 {
        return 6
    }
    return 0
}
