# A stepped loop that counts down stops before its end, as `to` does when it
# counts up (#1035). `n to 0 step -1` over a buffer must never touch a[-1].

function fill_down(a: ptr<i32>, n: i32) -> i32 {
    let mut count: i32 = 0
    for i in n to 0 step -1 {
        a[i - 1] = i
        count = count + 1
    }
    return count
}

function main() -> i32 {
    let mut guard: [i32; 5] = [7, 0, 0, 0, 0]
    let count: i32 = fill_down(&guard[1], 4)
    if count != 4 {
        return 1
    }
    if guard[0] != 7 {
        return 2
    }
    if guard[1] != 1 or guard[4] != 4 {
        return 3
    }
    let mut seen: i32 = 0
    for j in 10 to 0 step -3 {
        seen = seen * 100 + j
    }
    # 10, 7, 4, 1
    if seen != 10070401 {
        return 4
    }
    return 0
}
