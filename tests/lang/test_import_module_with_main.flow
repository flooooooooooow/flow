# Importing a module that has its own main() keeps this file's main as the
# program's, as on the Python host. flowc renamed the entry's main instead
# and ran the library's (corpus parity: examples/gpu/gpu_mul_backward).

import tests.fixtures.modules.testlib.with_main { answer }

function main() -> i32 {
    if answer() != 42 {
        return 1
    }
    return 0
}
