# Parser contract for the Python-grammar forms flowc accepts, which of them
# stay parse-only nodes, and parse error positions. See compiler/scripts/parse_coverage.sh.

import "compiler/src/ast.flow"
import "compiler/src/parser.flow"

extern {
    function strlen(s: ptr<u8>) -> i32
    function puts(s: string) -> i32
}

# Parse `src`; return the kind of the first top-level item, -1 on a parse
# error, or -2 when the program is empty.
function first_kind(text: string) -> i32 {
    let src: ptr<u8> = text
    let mut p: Parser = flowc_parser_new(src, strlen(src), 4096)
    let root: i32 = flowc_parse_program(&p)
    let mut k: i32 = 0 - 1
    if p.err == 0 and root != AST_NONE {
        let item: i32 = p.arena.nodes[root].a
        k = 0 - 2
        if item != AST_NONE {
            k = p.arena.nodes[item].kind
        }
    }
    flowc_parser_free(p)
    return k
}

# Parse `src`; return the kind of the first parse-only node, 0 when there is
# none, or -1 on a parse error.
function unsupported_kind(text: string) -> i32 {
    let src: ptr<u8> = text
    let mut p: Parser = flowc_parser_new(src, strlen(src), 4096)
    let root: i32 = flowc_parse_program(&p)
    let mut k: i32 = 0 - 1
    if p.err == 0 and root != AST_NONE {
        k = 0
        let bad: i32 = flowc_ast_first_unsupported(p.arena)
        if bad != AST_NONE {
            k = p.arena.nodes[bad].kind
        }
    }
    flowc_parser_free(p)
    return k
}

# Parse `src`; 1 when some node of the program has kind `kind`.
function has_kind(text: string, kind: i32) -> i32 {
    let src: ptr<u8> = text
    let mut p: Parser = flowc_parser_new(src, strlen(src), 4096)
    let root: i32 = flowc_parse_program(&p)
    let mut found: i32 = 0
    if p.err == 0 and root != AST_NONE {
        let mut i: i32 = 0
        while i < p.arena.len {
            if p.arena.nodes[i].kind == kind {
                found = 1
            }
            i = i + 1
        }
    }
    flowc_parser_free(p)
    return found
}

function main() -> i32 {
    # Claim coordinates, assume and therefore.
    let theorem_src: string = "theorem «Nat» «plus» «zero left» (m: Nat) {\n    assume «Nat» «plus» «commutes»(m, 0)\n    therefore m + 0 == m by ring\n}\n"
    if first_kind(theorem_src) != AST_THEOREM {
        puts("FAIL: theorem")
        return 1
    }
    # Claim paths in export lists and Domain/op import paths.
    if unsupported_kind("export Nat/+.zero-left, helper\n") != AST_CLAIM_REF {
        puts("FAIL: claim path export")
        return 2
    }
    if unsupported_kind("import verify.Nat/+ { zero-left }\n") != AST_CLAIM_REF {
        puts("FAIL: claim import")
        return 3
    }
    # Hyphenated relative imports resolve like file names: not parse-only.
    if unsupported_kind("import .Nat-plus-commutes { commutes }\n") != 0 {
        puts("FAIL: dashed import")
        return 4
    }
    let flow_src: string = "flow Ball {\n    state y : f64 = 1.0\n    param g : f64 = 9.8\n    y evolves as 0.0 - g\n    when y reaches 0.0 { y becomes 0.0 }\n    solver { dt 1 ms method rk4 }\n}\n"
    if first_kind(flow_src) != AST_FLOW_DECL {
        puts("FAIL: flow block")
        return 5
    }
    # Parsed to AST_HANDLE and lowered by Stage-A (#996, #675).
    if has_kind("function f() -> i32 {\n    handle Log with ConsoleLog {\n        return 1\n    }\n    return 0\n}\n", AST_HANDLE) == 0 or unsupported_kind("function f() -> i32 {\n    handle Log with ConsoleLog {\n        return 1\n    }\n    return 0\n}\n") != 0 {
        puts("FAIL: handle")
        return 6
    }
    # Parsed to AST_MATCH_ARM_EXT and lowered by Stage-A (#996, #675).
    if has_kind("function f(v: i32) -> i32 {\n    match v {\n        1 | 2 => { return 0 }\n        _ => { return 1 }\n    }\n    return 0\n}\n", AST_MATCH_ARM_EXT) == 0 or unsupported_kind("function f(v: i32) -> i32 {\n    match v {\n        1 | 2 => { return 0 }\n        _ => { return 1 }\n    }\n    return 0\n}\n") != 0 {
        puts("FAIL: or-pattern")
        return 7
    }
    # Parsed to AST_EFFECT_ROW and lowered by Stage-A (#996, #675).
    if has_kind("function f() -> void with Log {\n}\n", AST_EFFECT_ROW) == 0 or unsupported_kind("function f() -> void with Log {\n}\n") != 0 {
        puts("FAIL: effect row")
        return 8
    }
    # Parsed to AST_PIPE_BLOCK and lowered by Stage-A (#996, #675).
    if has_kind("function f(x: i32) -> i32 {\n    return x |> { a = g }\n}\n", AST_PIPE_BLOCK) == 0 or unsupported_kind("function f(x: i32) -> i32 {\n    return x |> { a = g }\n}\n") != 0 {
        puts("FAIL: fork block")
        return 9
    }
    # Forms Stage-A lowers stay free of parse-only nodes: a let without an
    # initializer, unit and shader as names, and a sort followed by a call.
    let plain_src: string = "function f(unit: i32, shader: i32) -> i32 {\n    let x: i32\n    x = unit\n    let mut xs: array<i32, 2> = [2, 1]\n    xs |> sort\n    g(x)\n    return x\n}\n"
    if unsupported_kind(plain_src) != 0 {
        puts("FAIL: plain forms")
        return 10
    }
    # Errors point at the first offending token.
    let bad_src: string = "function f() {\n    let = 3\n}\n"
    let bad: ptr<u8> = bad_src
    let mut p: Parser = flowc_parser_new(bad, strlen(bad), 256)
    let root: i32 = flowc_parse_program(&p)
    if p.err == 0 {
        puts("FAIL: bad source parsed")
        return 11
    }
    if p.err_tok.line != 2 or p.err_tok.col != 9 {
        puts("FAIL: error position")
        return 12
    }
    flowc_parser_free(p)
    return 0
}
