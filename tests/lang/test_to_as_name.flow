# Flow-native language test: `to` is a keyword only inside a `for` range,
# so it can name a parameter or a local (#1068), and `from` is an ordinary
# name.
# Exit 0 on success; a nonzero exit identifies the failing check.

function distance(from: i32, to: i32) -> i32 {
    return to - from
}

function main() -> i32 {
    if distance(2, 7) != 5 {
        return 1
    }
    let to: i32 = 4
    let mut total: i32 = 0
    for i in 0 to to {
        total = total + i
    }
    if total != 6 {
        return 2
    }
    return 0
}
