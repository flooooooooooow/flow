# Flow-native language test: returning a struct literal whose fields are
# calls, binary operations, nested struct values or plain literals (#409),
# and a multi-line typed struct literal bound with `let x: T =` (#810).
#
# Supersedes: tests/unit/test_struct_literal_return.py
# Exit 0 on success; a nonzero exit identifies the failing check.

struct Foo { x: i32, y: i32 }
struct Matrix { data: ptr<f32>, rows: i32, cols: i32 }
struct Wrap { m: Matrix, n: i32 }
struct Three { a: i32, b: i32, c: i32 }
struct PrepareConfig { rate: i32, max_block_size: i32, event_capacity: i32 }

function inc(n: i32) -> i32 { return n + 1 }
function dbl(n: i32) -> i32 { return n * 2 }
function ident(x: i32) -> i32 { return x }

function make_ops(a: i32, b: i32) -> Foo {
    return Foo { x: a + 1, y: b * 2 }
}

function make_calls(a: i32, b: i32) -> Foo {
    return Foo { x: inc(a), y: dbl(b) }
}

function make_matrix(r: i32, c: i32) -> Matrix {
    return Matrix { data: null, rows: r, cols: c }
}

function make_wrap(r: i32, c: i32) -> Wrap {
    return Wrap { m: make_matrix(r, c), n: r * c }
}

function make_three() -> Three {
    return Three { a: ident(1), b: 2, c: ident(3) }
}

function host_prepare(cfg: PrepareConfig) -> i32 {
    return cfg.max_block_size
}

function main() -> i32 {
    let f: Foo = make_ops(1, 2)
    if f.x != 2 || f.y != 4 { return 1 }
    let g: Foo = make_calls(4, 5)
    if g.x != 5 || g.y != 10 { return 2 }
    let w: Wrap = make_wrap(3, 4)
    if w.m.rows != 3 || w.m.cols != 4 || w.n != 12 { return 3 }
    let t: Three = make_three()
    if t.a != 1 || t.b != 2 || t.c != 3 { return 4 }
    let rate: i32 = 48000
    let config: PrepareConfig = PrepareConfig {
        rate: rate,
        max_block_size: 64,
        event_capacity: 256
    }
    if config.rate != 48000 { return 5 }
    if host_prepare(config) != 64 { return 6 }
    return 0
}
