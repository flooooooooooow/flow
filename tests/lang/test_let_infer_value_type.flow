# Flow-native language test: an unannotated `let` takes the type of its
# initialiser when that is a name, a field read, an index or arithmetic on
# them. flowc declared every such local `int32_t`, so
# `let v = p.x * 4.0` with `x: f64` cut 5.2 down to 5. An annotation
# (`let v: f64 = ...`) was the only way to keep the value.
# Exit 0 on success; a nonzero exit identifies the failing check.

struct P {
    x: f64,
    f: f32,
    n: i64
}

function scale(p: P) -> f64 {
    let v = p.x * 4.0
    return v
}

function main() -> i32 {
    let p = P { x: 1.3, f: 1.25, n: 5000000000 }
    # Field read times a float literal (the reported case).
    if scale(p) < 5.19 or scale(p) > 5.21 {
        return 1
    }
    # A literal on the left.
    let a = 4.0 * p.x
    if a < 5.19 or a > 5.21 {
        return 2
    }
    # A plain field read.
    let b = p.x
    if b < 1.29 or b > 1.31 {
        return 3
    }
    # A local declared f64.
    let d: f64 = 0.5
    let c = d
    if c != 0.5 {
        return 4
    }
    # Arithmetic on two typed operands, and on an unannotated local.
    let e = d * d
    if e != 0.25 {
        return 5
    }
    let g = b + e
    if g < 1.54 or g > 1.56 {
        return 6
    }
    # Negation keeps the type.
    let h = -p.x
    if h > -1.29 or h < -1.31 {
        return 7
    }
    # An f32 field stays a float.
    let k = p.f * 2.0
    if k != 2.5 {
        return 8
    }
    # A 64-bit field times an integer literal keeps all 64 bits.
    let m = p.n * 2
    if m != 10000000000 {
        return 9
    }
    # A parenthesised mix.
    let q = (p.x + 1.0) / 2.0
    if q < 1.14 or q > 1.16 {
        return 10
    }
    return 0
}
