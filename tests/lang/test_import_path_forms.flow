# Import path forms the Python resolver accepts and flowc once did not
# (corpus parity, `flowc bundle tc: gather failed`):
#   import "stdlib/vec"                      no .flow suffix
#   import tests.fixtures.modules.testlib.greeter.greet
#                                            a trailing symbol after the module

import "stdlib/vec"
import tests.fixtures.modules.testlib.greeter.greet

function main() -> i32 {
    let v: Vec2 = vec2_add(vec2(1.0, 2.0), vec2(3.0, 4.0))
    if v.x != 4.0 or v.y != 6.0 {
        return 1
    }
    if greet() != 42 {
        return 2
    }
    return 0
}
