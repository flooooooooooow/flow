# Flow-native language test: `impl Trait for Type` methods.
# Each method of `impl Trait for Type { ... }` is the top-level function
# `Type_Trait_method`, and a bare `self` parameter has the implementing
# type, as on the Python host. Braces inside strings and comments in a
# method body do not end the impl block.
# Exit 0 on success; a nonzero exit identifies the failing check.

extern {
    function strlen(s: string) -> i64
}

trait Shape {
    function area(self) -> i32
    function scaled(self, k: i32) -> i32
}

trait Named {
    function name(self: Square) -> string
}

struct Square {
    side: i32
}

struct Rect {
    w: i32,
    h: i32
}

impl Shape for Square {
    function area(self) -> i32 {
        return self.side * self.side
    }

    # A comment with a } brace.
    function scaled(self, k: i32) -> i32 {
        let label: string = "}{"
        if strlen(label) != 2 {
            return 0
        }
        return self.side * self.side * k
    }
}

impl Shape for Rect {
    function area(self) -> i32 {
        return self.w * self.h
    }

    function scaled(self, k: i32) -> i32 {
        return self.w * self.h * k
    }
}

impl Named for Square {
    function name(self: Square) -> string {
        return "square"
    }
}

function main() -> i32 {
    let s: Square = Square { side: 3 }
    let r: Rect = Rect { w: 2, h: 5 }
    if Square_Shape_area(s) != 9 {
        return 1
    }
    if Rect_Shape_area(r) != 10 {
        return 2
    }
    if Square_Shape_scaled(s, 2) != 18 {
        return 3
    }
    if Rect_Shape_scaled(r, 3) != 30 {
        return 4
    }
    if strlen(Square_Named_name(s)) != 6 {
        return 5
    }
    return 0
}
