# Flow-native language test: locals declared inside a block lambda (#1040).
# A `let` or `for` variable in the lambda body is the lambda's own local;
# only names from the enclosing function are captured.
# Exit 0 on success; a nonzero exit identifies the failing check.

function apply(f: (i32) -> i32, x: i32) -> i32 {
    return f(x)
}

function check_hof() -> i32 {
    let base: i32 = 100
    let h: (i32) -> i32 = |x: i32| -> i32 {
        let doubled: i32 = x * 2
        return doubled + base
    }
    return apply(h, 4)
}

function main() -> i32 {
    let k: i32 = 3
    let g = |x: i32| -> i32 {
        let y: i32 = x * 2
        let mut z: i32 = y + k
        z = z + 1
        return z
    }
    if g(5) != 14 {
        return 1
    }

    # A loop variable and a local declared inside the loop body.
    let step: i32 = 10
    let sum_to = |n: i32| -> i32 {
        let mut acc: i32 = 0
        for i in 0..n {
            let term: i32 = i + step
            acc = acc + term
        }
        return acc
    }
    # (0+10) + (1+10) + (2+10) = 33
    if sum_to(3) != 33 {
        return 2
    }

    if check_hof() != 108 {
        return 3
    }
    return 0
}
