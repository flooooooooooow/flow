# Flow-native language test: `defer` ordering (#594).
#
# Defers run in reverse order of declaration, after the body, exactly once.
# The printed order is pinned by test_defer_ordering.expected.
#
# Supersedes (behavioral parts of):
#   tests/integration/test_defer_ordering.py::test_falling_off_the_end_still_runs_defers_once
#
# Not superseded: the three other tests in that file. The Stage-A compiler
# emits a deferred call before the return value is read, and skips defers on
# a return inside a nested block, so those stay host-side until it is fixed.
# Exit 0 on success; a nonzero exit identifies the failing check.

extern {
    function printf(fmt: string, val: i32) -> i32
}

function main() -> i32 {
    defer printf("a\n", 0)
    defer printf("b\n", 0)
    printf("body\n", 0)
    return 0
}
