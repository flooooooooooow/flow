# An array passed to a `&[T]` parameter of a function in another module is
# wrapped in a span, as it is for a function of the same module. flowc only
# knew the parameter types of its own module and passed the bare array
# (corpus parity: examples/threed, whose matrices go to stdlib/render3d).

import tests.fixtures.modules.testlib.spans { span_total, span_count }

function main() -> i32 {
    let xs: array<f32, 4> = [1.0, 2.0, 3.0, 4.0]
    if span_count(xs) != 4 {
        return 1
    }
    if span_total(xs) != 10.0 {
        return 2
    }
    return 0
}
