# A for step that is not a literal takes its direction from its sign at run
# time, as on the Python host (#1053). A negative variable step counts down
# and, like `to` everywhere, stops before the end.

function count(a: i32, b: i32, s: i32) -> i32 {
    let mut n: i32 = 0
    for i in a to b step s {
        n = n + 1
    }
    return n
}

function trace(a: i32, b: i32, s: i32) -> i32 {
    let mut seen: i32 = 0
    for i in a to b step s {
        seen = seen * 100 + i
    }
    return seen
}

function negated(a: i32, b: i32, s: i32) -> i32 {
    let mut n: i32 = 0
    for i in a to b step -s {
        n = n + 1
    }
    return n
}

function main() -> i32 {
    if count(0, 10, 3) != 4 {
        return 1
    }
    if count(10, 0, 0 - 3) != 4 {
        return 2
    }
    if trace(10, 0, 0 - 3) != 10070401 {
        return 3
    }
    # The wrong direction runs no iterations.
    if count(0, 10, 0 - 1) != 0 {
        return 4
    }
    if count(10, 0, 2) != 0 {
        return 5
    }
    # `step -s` with a negative s counts up.
    if negated(0, 6, 0 - 2) != 3 {
        return 6
    }
    return 0
}
