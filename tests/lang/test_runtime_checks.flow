# Flow-native language test: runtime checks stay out of the way of valid code.
# `flow compile` checks integer `/` and `%` for a zero divisor, every shift
# for its amount and sign, and reads of sized arrays and spans for bounds
# (the Python host's checks; flowc emits them under FLOWC_CHECKS=1). This
# test drives each checked form with in-range values, including the lvalue
# forms (assignment targets, `&a[i]`) that must stay plain C lvalues.
# Exit 0 on success; a nonzero exit identifies the failing check.

struct Pair {
    vals: array<i32, 4>,
    n: i32
}

function at(a: array<i32, 4>, i: i32) -> i32 {
    return a[i]
}

function span_at(xs: &[i32], i: i32) -> i32 {
    return xs[i]
}

function main() -> i32 {
    let mut a: array<i32, 4> = [10, 20, 30, 40]
    let idx: array<i32, 3> = [3, 2, 1]
    let i: i32 = 2
    # Checked read, checked write target, nested index.
    a[i] = a[i] + 1
    if a[2] != 31 {
        return 1
    }
    a[idx[0]] = a[idx[2]] + 5
    if a[3] != 25 {
        return 2
    }
    # Address of an element.
    let p: ptr<i32> = &a[1]
    if p[0] != 20 {
        return 3
    }
    # Parameters and spans.
    if at(a, 0) != 10 {
        return 4
    }
    if span_at(a, 3) != 25 {
        return 5
    }
    # Struct field arrays are left unchecked, and still work.
    let mut pr: Pair = Pair { vals: [1, 2, 3, 4], n: 4 }
    pr.vals[i] = 9
    if pr.vals[2] != 9 {
        return 6
    }
    # Division, remainder and shifts.
    if a[0] / i != 5 {
        return 7
    }
    if 17 % 5 != 2 {
        return 8
    }
    let s: i32 = 1 << 4
    if s != 16 {
        return 9
    }
    if (s >> 2) != 4 {
        return 10
    }
    let u: u32 = 3 as u32
    if (u << 30) != 3221225472 as u32 {
        return 11
    }
    let f: f64 = 1.0 / 4.0
    if f != 0.25 {
        return 12
    }
    # A 2D read.
    let m: array<array<i32, 2>, 2> = [[1, 2], [3, 4]]
    if m[1][i - 1] != 4 {
        return 13
    }
    return 0
}
