# Dual operator sugar (#161): + - * / and unary minus on a Dual call the
# add/sub/mul/div/neg overloads, as on the Python host. flowc emitted C
# operators on the struct (corpus parity: examples/ml/autodiff). The
# overloads are declared here, the way stdlib/autodiff.flow declares them.

struct Dual {
    val: f32,
    grad: f32
}

function add(a: Dual, b: Dual) -> Dual { return Dual { val: a.val + b.val, grad: a.grad + b.grad } }
function add(a: Dual, b: f32) -> Dual { return Dual { val: a.val + b, grad: a.grad } }
function add(a: f32, b: Dual) -> Dual { return Dual { val: a + b.val, grad: b.grad } }
function sub(a: Dual, b: Dual) -> Dual { return Dual { val: a.val - b.val, grad: a.grad - b.grad } }
function mul(a: Dual, b: Dual) -> Dual { return Dual { val: a.val * b.val, grad: a.grad * b.val + a.val * b.grad } }
function mul(a: f32, b: Dual) -> Dual { return Dual { val: a * b.val, grad: a * b.grad } }
function div(a: Dual, b: f32) -> Dual { return Dual { val: a.val / b, grad: a.grad / b } }
function neg(a: Dual) -> Dual { return Dual { val: 0.0 - a.val, grad: 0.0 - a.grad } }

function f(x: Dual) -> Dual {
    return x * x + 3.0 * x + 1.0
}

function main() -> i32 {
    let x: Dual = Dual { val: 2.0, grad: 1.0 }
    let y: Dual = f(x)
    if y.val != 11.0 or y.grad != 7.0 {
        return 1
    }
    let z: Dual = -x + y / 2.0
    if z.val != 3.5 {
        return 2
    }
    let w: Dual = y - x
    if w.val != 9.0 or w.grad != 6.0 {
        return 3
    }
    return 0
}
