# Flow-native language test: `while true` loops with a counted exit (#473).
#
# These are the shapes the counted-loop rotation rewrites. Each one runs to a
# known accumulator value, so a wrong rewrite in any backend shows up as a
# wrong number rather than only as disagreement between two builds.
#
# Supersedes (behavioral parts of):
#   tests/integration/test_counted_loop_rotation.py::test_expected_iteration_counts
# The rotated-versus-original comparisons call the rewrite directly and stay
# host-side.
# Exit 0 on success; a nonzero exit identifies the failing check.

function countdown() -> i32 {
    let mut count: i32 = 5
    let mut acc: i32 = 0
    while true {
        acc = acc + 1
        if count == 0 {
            break
        }
        count = count - 1
    }
    return acc
}

function zero_trip() -> i32 {
    let mut count: i32 = 0
    let mut acc: i32 = 0
    while true {
        acc = acc + 7
        if count == 0 {
            break
        }
        count = count - 1
    }
    return acc
}

function break_first() -> i32 {
    let mut count: i32 = 9
    let mut acc: i32 = 0
    while true {
        if count == 0 {
            break
        }
        acc = acc + 2
        count = count - 1
    }
    return acc
}

function suffix_after_decrement() -> i32 {
    let mut count: i32 = 4
    let mut acc: i32 = 0
    while true {
        acc = acc + 1
        if count == 0 {
            break
        }
        count = count - 1
        acc = acc + 10
    }
    return acc
}

function nested_if_in_prefix() -> i32 {
    let mut count: i32 = 6
    let mut acc: i32 = 0
    while true {
        if count > 3 {
            acc = acc + 1
        } else {
            acc = acc + 100
        }
        if count == 0 {
            break
        }
        count = count - 1
    }
    return acc
}

function step_two() -> i32 {
    let mut count: i32 = 8
    let mut acc: i32 = 0
    while true {
        acc = acc + 3
        if count == 0 {
            break
        }
        count = count - 2
    }
    return acc
}

function main() -> i32 {
    if countdown() != 6 {
        return 1
    }
    if zero_trip() != 7 {
        return 2
    }
    if break_first() != 18 {
        return 3
    }
    if suffix_after_decrement() != 45 {
        return 4
    }
    if nested_if_in_prefix() != 403 {
        return 5
    }
    if step_two() != 15 {
        return 6
    }
    return 0
}
