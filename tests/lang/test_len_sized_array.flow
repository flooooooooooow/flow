# len() of a sized array is its element count, as on the Python host.
# flowc emitted `(arr).len`, a member access on a C array (corpus parity:
# tests/core/test_arrays_len).

function main() -> i32 {
    let arr: array<i32, 5> = [1, 2, 3, 4, 5]
    if len(arr) != 5 {
        return 1
    }
    let mut total: i32 = 0
    for i in 0 to len(arr) {
        total = total + arr[i]
    }
    if total != 15 {
        return 2
    }
    return 0
}
