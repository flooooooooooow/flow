function compute_sensor(in_val: i32) -> i32 {
    let mut accum: i32 = 0
    let mut step: i32 = 0
    @max_iterations(64)
    while step < 16 {
        accum = accum + in_val * step
        step = step + 1
    }
    return accum
}

export function main() -> i32 {
    let res: i32 = compute_sensor(3)
    if res != 360 {
        return 1
    }
    return 0
}
