# `memref_f32`, the MLIR-era name for a buffer parameter, is a pointer to
# the element on the Python host. flowc emitted it as an unknown C type name
# (corpus parity: examples/gpu, tests/arrays).

function dot(x: memref_f32, y: memref_f32, n: i32) -> f32 {
    let mut acc: f32 = 0.0
    let mut i: i32 = 0
    while i < n {
        acc = acc + x[i] * y[i]
        i = i + 1
    }
    return acc
}

function main() -> i32 {
    let a: array<f32, 3> = [1.0, 2.0, 3.0]
    let b: array<f32, 3> = [4.0, 5.0, 6.0]
    if dot(a, b, 3) != 32.0 {
        return 1
    }
    return 0
}
