# Recognition-indexed SSA refinement (compiler/src/recognition_ssa.flow).
# Exit 0 on success; a nonzero code names the failing check.

import "compiler/src/ast.flow"
import "compiler/src/parser.flow"
import "compiler/src/semantic_facts.flow"
import "compiler/src/recognition.flow"
import "compiler/src/recognition_ssa.flow"

extern {
    function strlen(s: string) -> i64
}

function main() -> i32 {
    let none: array<FlowcRecognitionContract, 1> = [flowc_rssa_contract(0, 0.0)]
    let empty: array<FlowcAttractorSignature, 1> = [flowc_rssa_empty_signature()]
    let mut cert: FlowcRefinementCertificate = FlowcRefinementCertificate {
        discrete_refinement: 0,
        witnesses: [
            FlowcRecognitionWitness { domain: 0, distance: 0.0, epsilon: 0.0 },
            FlowcRecognitionWitness { domain: 0, distance: 0.0, epsilon: 0.0 },
            FlowcRecognitionWitness { domain: 0, distance: 0.0, epsilon: 0.0 },
            FlowcRecognitionWitness { domain: 0, distance: 0.0, epsilon: 0.0 },
            FlowcRecognitionWitness { domain: 0, distance: 0.0, epsilon: 0.0 }
        ],
        witness_count: 0
    }

    # 1. No contracts: legality is exactly the discrete judgement.
    if flowc_rssa_check(1, &none[0], 0, &empty[0], &empty[0], &cert) != FLOWC_RSSA_OK {
        return 1
    }
    if flowc_rssa_preserved(cert) != 1 or cert.witness_count != 0 {
        return 2
    }

    # 2. Discrete refinement stays mandatory.
    flowc_rssa_check(0, &none[0], 0, &empty[0], &empty[0], &cert)
    if flowc_rssa_preserved(cert) != 0 {
        return 3
    }

    # 3. Continuous drift within epsilon is accepted.
    let mut fp_a: array<f64, 1> = [0.0]
    let mut st_a: array<f64, 1> = [-1.0]
    let mut inv_a: array<f64, 1> = [2.0]
    let mut fp_b: array<f64, 1> = [0.01]
    let mut st_b: array<f64, 1> = [-0.99]
    let mut inv_b: array<f64, 1> = [2.0]
    let mut sig_a: FlowcAttractorSignature = flowc_rssa_empty_signature()
    sig_a.fixed_points = &fp_a[0]
    sig_a.point_count = 1
    sig_a.point_dim = 1
    sig_a.stability = &st_a[0]
    sig_a.stability_count = 1
    sig_a.invariants = &inv_a[0]
    sig_a.invariant_count = 1
    let mut sig_b: FlowcAttractorSignature = sig_a
    sig_b.fixed_points = &fp_b[0]
    sig_b.stability = &st_b[0]
    sig_b.invariants = &inv_b[0]
    let numerical: array<FlowcRecognitionContract, 1> = [
        flowc_rssa_contract(FLOWC_RECOGNITION_NUMERICAL, 0.02)
    ]
    let before_n: array<FlowcAttractorSignature, 1> = [sig_a]
    let after_n: array<FlowcAttractorSignature, 1> = [sig_b]
    if flowc_rssa_check(1, &numerical[0], 1, &before_n[0], &after_n[0], &cert) != FLOWC_RSSA_OK {
        return 4
    }
    if flowc_rssa_preserved(cert) != 1 {
        return 5
    }
    # ...and rejected once the budget is tighter than the drift.
    let tight: array<FlowcRecognitionContract, 1> = [
        flowc_rssa_contract(FLOWC_RECOGNITION_NUMERICAL, 0.001)
    ]
    flowc_rssa_check(1, &tight[0], 1, &before_n[0], &after_n[0], &cert)
    if flowc_rssa_preserved(cert) != 0 {
        return 6
    }
    if flowc_rssa_violations(cert) != FLOWC_RECOGNITION_NUMERICAL {
        return 7
    }

    # 4. A basin topology change is rejected whatever the budget.
    let mut basins_a: array<i32, 2> = [0, 1]
    let mut basins_b: array<i32, 2> = [0, 0]
    let mut bs_a: FlowcAttractorSignature = flowc_rssa_empty_signature()
    bs_a.basin_labels = &basins_a[0]
    bs_a.basin_count = 2
    let mut bs_b: FlowcAttractorSignature = bs_a
    bs_b.basin_labels = &basins_b[0]
    let safety: array<FlowcRecognitionContract, 1> = [
        flowc_rssa_contract(FLOWC_RECOGNITION_SAFETY, 100.0)
    ]
    let before_s: array<FlowcAttractorSignature, 1> = [bs_a]
    let after_s: array<FlowcAttractorSignature, 1> = [bs_b]
    flowc_rssa_check(1, &safety[0], 1, &before_s[0], &after_s[0], &cert)
    if flowc_rssa_preserved(cert) != 0 {
        return 8
    }
    if flowc_rssa_violations(cert) != FLOWC_RECOGNITION_SAFETY {
        return 9
    }

    # 5. Malformed contracts are refused.
    let bad: array<FlowcRecognitionContract, 1> = [
        flowc_rssa_contract(FLOWC_RECOGNITION_NUMERICAL, -1.0)
    ]
    if flowc_rssa_check(1, &bad[0], 1, &before_n[0], &after_n[0], &cert) != FLOWC_RSSA_BAD_EPSILON {
        return 10
    }

    # 6. A `recognize` declaration lowers to contracts, with per-domain budgets.
    let source_text: string =
        "flow Demo { " +
        "state x : f64 = 0.0 " +
        "x evolves as 0.0 - x " +
        "recognize { numerical safety } " +
        "}"
    let source: ptr<u8> = source_text
    let mut parser: Parser = flowc_parser_new(source, strlen(source_text) as i32, 4096)
    let root: i32 = flowc_parse_program(&parser)
    if root == AST_NONE or parser.err != 0 {
        return 11
    }
    let flow_id: i32 = parser.arena.nodes[root].a
    let mut eps: array<f64, 5> = [0.01, 0.0, 0.0, 0.0, 0.0]
    let mut out: array<FlowcRecognitionContract, 5> = [
        flowc_rssa_contract(0, 0.0), flowc_rssa_contract(0, 0.0),
        flowc_rssa_contract(0, 0.0), flowc_rssa_contract(0, 0.0),
        flowc_rssa_contract(0, 0.0)
    ]
    let mut n: i32 = 0
    if flowc_rssa_contracts_from_flow(
        parser.arena, flow_id, source, 0.0,
        FLOWC_RECOGNITION_NUMERICAL, &eps[0], &out[0], &n
    ) != FLOWC_RSSA_OK {
        return 12
    }
    if n != 2 {
        return 13
    }
    if out[0].domain != FLOWC_RECOGNITION_NUMERICAL or out[0].epsilon != 0.01 {
        return 14
    }
    if out[1].domain != FLOWC_RECOGNITION_SAFETY or out[1].epsilon != 0.0 {
        return 15
    }
    # A budget for an undeclared domain is an error.
    if flowc_rssa_contracts_from_flow(
        parser.arena, flow_id, source, 0.0,
        FLOWC_RECOGNITION_MEMORY, &eps[0], &out[0], &n
    ) != FLOWC_RSSA_UNDECLARED_DOMAIN {
        return 16
    }
    return 0
}
