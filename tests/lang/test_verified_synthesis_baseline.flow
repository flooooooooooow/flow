# VS-00: finite reference cases for future independent verification.
# This is an executable oracle corpus, not an SMT solver or proof checker.
# All integer operations below are defined on the explicitly bounded domains.

function vs_square_reference(x: i32) -> i32 {
    let mut magnitude: i32 = x
    if magnitude < 0 {
        magnitude = -magnitude
    }
    let mut sum: i32 = 0
    let mut i: i32 = 0
    while i < magnitude {
        sum = sum + magnitude
        i = i + 1
    }
    return sum
}

function vs_square_candidate(x: i32) -> i32 {
    return x * x
}

function vs_square_mutant(x: i32) -> i32 {
    return x * x + 1
}

function vs_stage_a(x: i32) -> i32 {
    return x + 1
}

function vs_stage_b(y: i32) -> i32 {
    return 2 * y
}

function vs_public_only(public_value: i32, secret: i32) -> i32 {
    return public_value
}

function vs_implicit_leak(public_value: i32, secret: i32) -> i32 {
    if secret == 0 {
        return public_value
    }
    return public_value + 1
}

function vs_check_specifications() -> i32 {
    let mut x: i32 = -8
    let mut strong_rejects: i32 = 0
    let mut weak_rejects: i32 = 0
    let mut impossible_assumption_witnesses: i32 = 0
    while x <= 8 {
        let expected: i32 = vs_square_reference(x)
        if vs_square_candidate(x) != expected {
            return 1
        }
        let mutant: i32 = vs_square_mutant(x)
        if mutant != expected {
            strong_rejects = strong_rejects + 1
        }
        if mutant < 0 {
            weak_rejects = weak_rejects + 1
        }
        if x > 8 and x < -8 {
            impossible_assumption_witnesses = impossible_assumption_witnesses + 1
        }
        x = x + 1
    }
    if strong_rejects != 17 { return 2 }
    if weak_rejects != 0 { return 3 }
    if impossible_assumption_witnesses != 0 { return 4 }
    return 0
}

function vs_check_composition() -> i32 {
    let mut x: i32 = -8
    let mut mismatches: i32 = 0
    while x <= 8 {
        let y: i32 = vs_stage_a(x)
        if y < -7 or y > 9 { return 5 }
        if y < -8 or y > 8 {
            if x != 8 or y != 9 { return 6 }
            mismatches = mismatches + 1
        } else {
            if vs_stage_b(y) != y + y { return 7 }
        }
        x = x + 1
    }
    if mismatches != 1 { return 8 }

    # Stage B independently satisfies its local contract on its own domain.
    let mut y: i32 = -8
    while y <= 8 {
        if vs_stage_b(y) != y + y { return 9 }
        y = y + 1
    }
    return 0
}

function vs_check_relational_outputs() -> i32 {
    let mut public_value: i32 = 0
    let mut leak_witnesses: i32 = 0
    while public_value <= 3 {
        let mut a: i32 = 0
        while a <= 1 {
            let mut b: i32 = 0
            while b <= 1 {
                if vs_public_only(public_value, a) != vs_public_only(public_value, b) {
                    return 10
                }
                if vs_implicit_leak(public_value, a) != vs_implicit_leak(public_value, b) {
                    if a == b { return 11 }
                    leak_witnesses = leak_witnesses + 1
                }
                b = b + 1
            }
            a = a + 1
        }
        public_value = public_value + 1
    }
    if leak_witnesses != 8 { return 12 }
    return 0
}

function vs_check_discrete_invariant() -> i32 {
    let mut state: i32 = 0
    let mut mutant_violations: i32 = 0
    while state <= 8 {
        let good: i32 = state / 2
        let mutant: i32 = state + 1
        if good < 0 or good > 8 { return 13 }
        if mutant < 0 or mutant > 8 {
            if state != 8 { return 14 }
            mutant_violations = mutant_violations + 1
        }
        state = state + 1
    }
    if mutant_violations != 1 { return 15 }
    return 0
}

function main() -> i32 {
    let spec_result: i32 = vs_check_specifications()
    if spec_result != 0 { return spec_result }
    let composition_result: i32 = vs_check_composition()
    if composition_result != 0 { return composition_result }
    let privacy_result: i32 = vs_check_relational_outputs()
    if privacy_result != 0 { return privacy_result }
    return vs_check_discrete_invariant()
}
