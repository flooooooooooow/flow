# Test for audio/notation.flow note parsing
import "stdlib/audio/notation.flow"

extern {
    function puts(s: string) -> i32
}

function main() -> i32 {
    let mut errs: i32 = 0
    
    # Valid notes
    if parse_note_name("C4") != 60 { puts("FAIL: C4"); errs = errs + 1 }
    if parse_note_name("C#4") != 61 { puts("FAIL: C#4"); errs = errs + 1 }
    if parse_note_name("Db4") != 61 { puts("FAIL: Db4"); errs = errs + 1 }
    if parse_note_name("A0") != 21 { puts("FAIL: A0"); errs = errs + 1 }
    
    # Rests
    if parse_note_name("R") != -1 { puts("FAIL: R"); errs = errs + 1 }
    
    # Invalid letters
    if parse_note_name("X4") != -1 { puts("FAIL: X4"); errs = errs + 1 }
    if parse_note_name("H4") != -1 { puts("FAIL: H4"); errs = errs + 1 }
    
    # Trailing junk
    if parse_note_name("C44") != -1 { puts("FAIL: C44"); errs = errs + 1 }
    if parse_note_name("C4x") != -1 { puts("FAIL: C4x"); errs = errs + 1 }
    if parse_note_name("R4") != -1 { puts("FAIL: R4"); errs = errs + 1 }
    
    # Missing octave
    if parse_note_name("C") != -1 { puts("FAIL: C"); errs = errs + 1 }
    if parse_note_name("C#") != -1 { puts("FAIL: C#"); errs = errs + 1 }
    
    # Empty string
    if parse_note_name("") != -1 { puts("FAIL: empty string"); errs = errs + 1 }
    
    if errs > 0 {
        return 1
    }
    return 0
}
