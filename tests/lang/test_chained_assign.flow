# Flow-native language test: chained assignment (#1036).
# `a = b = v` is right-associative: every target receives v.
# Exit 0 on success; a nonzero exit identifies the failing check.

struct Pair {
    x: i32,
    y: i32
}

function main() -> i32 {
    let mut a: i32 = 0
    let mut b: i32 = 0
    a = b = 7
    if a != 7 {
        return 1
    }
    if b != 7 {
        return 2
    }

    # Three targets, and a right side that reads one of them.
    let mut c: i32 = 1
    a = b = c = c + 10
    if a != 11 or b != 11 or c != 11 {
        return 3
    }

    # Fields and array elements are targets too.
    let mut p: Pair = Pair { x: 0, y: 0 }
    let mut xs: array<i32, 3> = [0, 0, 0]
    p.x = xs[1] = p.y = 5
    if p.x != 5 or p.y != 5 or xs[1] != 5 {
        return 4
    }
    if xs[0] != 0 or xs[2] != 0 {
        return 5
    }
    return 0
}
