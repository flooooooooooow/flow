# User functions named like POSIX functions the C preamble's headers
# declare are renamed for the unit (#1045). `wait` clashed with
# <sys/wait.h>, which <stdlib.h> includes.

struct Tapper {
    n: i32
}

function wait(t: ptr<Tapper>, frames: i32) -> i32 {
    t.n = t.n + frames
    return frames
}

function chmod(depth: i32) -> i32 {
    return depth * 2
}

function main() -> i32 {
    let mut t: Tapper = Tapper { n: 0 }
    if wait(&t, 3) != 3 { return 1 }
    if t.n != 3 { return 2 }
    if chmod(4) != 8 { return 3 }
    return 0
}
