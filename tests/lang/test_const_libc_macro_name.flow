# A const may take the name of a macro from the libc headers flowc's C
# preamble includes (<time.h>). flowc emitted
# `static const double CLOCKS_PER_SEC = ...`, which the macro turned into a
# syntax error (corpus parity: every benchmark that timed itself).

const CLOCKS_PER_SEC: f64 = 1000.0

function main() -> i32 {
    if CLOCKS_PER_SEC != 1000.0 {
        return 1
    }
    return 0
}
