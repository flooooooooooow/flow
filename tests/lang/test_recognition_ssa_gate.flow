import "compiler/src/semantic_facts.flow"
import "compiler/src/fir_opts.flow"
import "compiler/src/recognition_ssa.flow"
import "compiler/src/recognition_ssa_budget.flow"
import "compiler/src/recognition_ssa_gate.flow"

function candidate() -> FlowcOptCandidate {
    return FlowcOptCandidate {
        kind: 0,
        target_id: 7,
        score: 12.0,
        caller_id: 0 - 1,
        callee_ops: 2,
        call_sites: 0,
        is_pure: 1
    }
}

function signature(value: ptr<f64>) -> FlowcAttractorSignature {
    return FlowcAttractorSignature {
        fixed_points: value,
        point_count: 1,
        point_dim: 1,
        basin_labels: null,
        basin_count: 0,
        stability: null,
        stability_count: 0,
        invariants: null,
        invariant_count: 0
    }
}

function main() -> i32 {
    let contracts: array<FlowcRecognitionContract, 1> = [
        flowc_rssa_contract(FLOWC_RECOGNITION_NUMERICAL, 0.10)
    ]
    let mut budget: FlowcRecognitionBudget
    if flowc_rssa_budget_new(&contracts[0], 1, &budget) != FLOWC_RSSA_OK {
        return 1
    }

    let before_value: array<f64, 1> = [0.0]
    let safe_value: array<f64, 1> = [0.04]
    let unsafe_value: array<f64, 1> = [0.20]
    let before: array<FlowcAttractorSignature, 1> = [signature(&before_value[0])]
    let safe: array<FlowcAttractorSignature, 1> = [signature(&safe_value[0])]
    let unsafe: array<FlowcAttractorSignature, 1> = [signature(&unsafe_value[0])]

    let mut accepted: FlowcRssaGateResult
    if flowc_rssa_gate_candidate(candidate(), 1, &contracts[0], 1, &before[0], &safe[0], &accepted) != FLOWC_RSSA_OK {
        return 2
    }
    if accepted.allowed != 1 {
        return 3
    }
    if flowc_rssa_gate_commit(&budget, accepted) != FLOWC_RSSA_OK {
        return 4
    }
    if budget.spent[0] != 0.04 {
        return 5
    }

    let mut rejected: FlowcRssaGateResult
    if flowc_rssa_gate_candidate(candidate(), 1, &contracts[0], 1, &before[0], &unsafe[0], &rejected) != FLOWC_RSSA_GATE_REJECTED {
        return 6
    }
    if rejected.allowed != 0 {
        return 7
    }
    # Rejection must not consume the pipeline budget.
    if budget.spent[0] != 0.04 {
        return 8
    }

    let mut discrete_bad: FlowcRssaGateResult
    if flowc_rssa_gate_candidate(candidate(), 0, &contracts[0], 1, &before[0], &before[0], &discrete_bad) != FLOWC_RSSA_GATE_REJECTED {
        return 9
    }

    return 0
}
