# #1691: array initializers of span fields borrow data and retain length.
struct View {
    data: span<mut f64>,
    counts: span<i32>,
    n: i32
}

struct Storage {
    values: array<f64, 2>
}

function main() -> i32 {
    let mut buf: array<f64, 2> = [1.0, 3.0]
    let counts: array<i32, 2> = [2, 4]
    let v: View = View { data: buf, counts: counts, n: 2 }
    if v.data.len != 2 or v.counts.len != 2 { return 1 }
    if v.data[1] != 3.0 or v.counts[1] != 4 { return 2 }
    v.data[0] = 9.0
    if buf[0] != 9.0 { return 3 }
    buf[1] = 7.0
    if v.data[1] != 7.0 { return 4 }

    let mut storage: Storage = Storage { values: [5.0, 6.0] }
    let w: View = View { data: storage.values, counts: counts, n: 2 }
    if w.data.len != 2 or w.data[1] != 6.0 { return 5 }
    w.data[0] = 11.0
    if storage.values[0] != 11.0 { return 6 }

    let updated: View = View { ..v, data: storage.values }
    if updated.data.len != 2 or updated.data[0] != 11.0 { return 7 }
    if v.data[0] != 9.0 { return 8 }
    return 0
}
