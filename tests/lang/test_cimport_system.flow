# Flow-native language test: @cImport of system headers.
# @cImport("h") emits `#include <h>`, as on the Python host. flowc used to
# also re-declare every prototype it found in the preprocessed header,
# which broke on macOS: signal.h declares sigaddset as a function-like
# macro, and unistd.h splits deprecation messages across lines.
# Exit 0 on success; a nonzero exit identifies the failing check.

@cImport("unistd.h")
@cImport("signal.h")

function main() -> i32 {
    let pid: i32 = getpid() as i32
    if pid <= 0 {
        return 1
    }
    # Signal 0 checks that the process exists without sending anything.
    if kill(pid, 0) != 0 {
        return 2
    }
    return 0
}
