# Flow-native language test: Tensor operator sugar (#161).
# `+ - * /` between two Tensors lower to tensor_add/sub/mul/div, `t * s`
# and `s * t` to tensor_scale(t, s), and `t + s` and `s + t` to
# tensor_add_scalar(t, s), on both hosts. A sugared operand may itself be a
# sugared expression.
# Exit 0 on success; a nonzero exit identifies the failing check.

import "stdlib/tensor.flow"

extern {
    function fabsf(x: f32) -> f32
}

function near(x: f32, want: f32) -> bool {
    return fabsf(x - want) < 0.001
}

function main() -> i32 {
    let a: Tensor = tensor_fill(1, 2, 1, 1, 2.0)
    let b: Tensor = tensor_fill(1, 2, 1, 1, 3.0)
    let s: Tensor = a + b
    if !near(s.data[1], 5.0) { return 1 }
    let d: Tensor = b - a
    if !near(d.data[0], 1.0) { return 2 }
    let p: Tensor = a * b
    if !near(p.data[0], 6.0) { return 3 }
    let q: Tensor = b / a
    if !near(q.data[0], 1.5) { return 4 }
    let k: f32 = 4.0
    let left: Tensor = a * k
    if !near(left.data[0], 8.0) { return 5 }
    let right: Tensor = k * a
    if !near(right.data[1], 8.0) { return 6 }
    let up: Tensor = 1.5 + b
    if !near(up.data[0], 4.5) { return 7 }
    # (a + b) * 2 nests one sugared operation in another.
    let nested: Tensor = (a + b) * 2.0
    if !near(nested.data[0], 10.0) { return 8 }
    return 0
}
