# A match arm naming an enum variant constant is a value pattern, and every
# arm dispatches to its own variant (#620, #941).
# Supersedes tests/unit/test_match_exhaustive_returns.py
# ::test_every_arm_still_dispatches_to_its_own_variant.

enum Kind { A, B, C }

function pick(k: Kind) -> f64 {
    match k.tag {
        Kind_A => { return 1.0 }
        Kind_B => { return 2.0 }
        Kind_C => { return 3.0 }
    }
}

function code(k: Kind) -> i32 {
    match k.tag {
        Kind_B => { return 20 }
        _ => { return 7 }
    }
}

function main() -> i32 {
    if pick(Kind { tag: Kind_A }) != 1.0 {
        return 1
    }
    if pick(Kind { tag: Kind_B }) != 2.0 {
        return 2
    }
    if pick(Kind { tag: Kind_C }) != 3.0 {
        return 3
    }
    if code(Kind { tag: Kind_B }) != 20 {
        return 4
    }
    if code(Kind { tag: Kind_C }) != 7 {
        return 5
    }
    return 0
}
