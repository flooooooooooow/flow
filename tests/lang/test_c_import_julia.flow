# Test for @cImport with Julia C API.
# Imports julia.h and calls jl_init / jl_eval_string / jl_atexit.
# Run with: FLOW_HOST=python ./flow run tests/lang/test_c_import_julia.flow
# Exit 0 on success.

@cImport("julia/julia.h")

# The weak stubs below exist so the @cImport compile and link path is exercised
# portably, even if Julia dev libraries are not installed in the environment.
# Real libraries will override these stubs via LDFLAGS.
@cEmbed("
void jl_init(void) __attribute__((weak));
void jl_init(void) {}
void* jl_eval_string(char* code) __attribute__((weak));
void* jl_eval_string(char* code) { return (void*)1; }
void jl_atexit_hook(int status) __attribute__((weak));
void jl_atexit_hook(int status) {}
")

extern {
    function puts(s: string) -> i32
    function jl_init()
    function jl_eval_string(code: string) -> ptr<void>
    function jl_atexit_hook(status: i32)
}

function main() -> i32 {
    # Initialize the Julia runtime
    jl_init()

    # Evaluate a Julia expression
    let result: ptr<void> = jl_eval_string("println(\"Hello from Julia via Flow\")")
    # We do not assert result != null here to avoid failing when faked by stubs.

    # Shut down Julia
    jl_atexit_hook(0)

    puts("All c_import_julia tests passed")
    return 0
}
