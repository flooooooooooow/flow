# `i % x` with an integer left side and a float right side casts the right
# side to the left's type, as the Python host does. flowc emitted a C `%`
# on a double, which does not compile (corpus parity: audio clock demos).

struct Clock {
    bar_samples: f64
}

function main() -> i32 {
    let c: Clock = Clock { bar_samples: 4.0 }
    let pos: i64 = 10
    let r: i64 = pos % c.bar_samples
    if r != 2 {
        return 1
    }
    return 0
}
