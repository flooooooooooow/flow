# Typed PDE IR: Dirichlet linear steady state, invalid units, invalid methods.
import "stdlib/science/sofia_ir.flow"

function irb_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

function main() -> i32 {
    let nodes: array<SofiaIrNode, 16> = [
        SofiaIrNode {
            kind: 0, a: -1, b: -1, value: 0.0,
            length_dim: 0, time_dim: 0, quantity_dim: 0
        }
    ]
    let mut p: SofiaIrProgram = sofia_ir_new(nodes, 16)
    let u: i32 = sofia_ir_field(&p, 0, 0, 1)
    let lap: i32 = sofia_ir_laplacian_x(&p, u)
    let alpha: i32 = sofia_ir_constant(&p, 0.01, 2, -1, 0)
    let rhs: i32 = sofia_ir_mul(&p, alpha, lap)
    if sofia_ir_set_rhs(&p, rhs) != 0 { return 1 }

    let state: array<f64, 32> = [0.0, 0.0, 0.0, 0.0]
    let next: array<f64, 32> = [0.0, 0.0, 0.0, 0.0]
    let k1: array<f64, 32> = [0.0, 0.0, 0.0, 0.0]
    let k2: array<f64, 32> = [0.0, 0.0, 0.0, 0.0]
    let k3: array<f64, 32> = [0.0, 0.0, 0.0, 0.0]
    let k4: array<f64, 32> = [0.0, 0.0, 0.0, 0.0]
    let tmp: array<f64, 32> = [0.0, 0.0, 0.0, 0.0]
    for i in 0 to 32 { state[i] = (i as f64) / 31.0 }
    for step in 0 to 10 {
        let rc: i32 = sofia_ir_step_1d(&p, state, next,
            k1, k2, k3, k4, tmp, 32, 1.0 / 31.0, 0.01,
            SOFIA_BC_DIRICHLET, 0.0, 1.0, SOFIA_RK_CLASSIC_4)
        if rc != 0 { return 2 }
        for i in 0 to 32 {
            if irb_abs(next[i] - (i as f64) / 31.0) > 1e-8 { return 3 }
            state[i] = next[i]
        }
    }

    if sofia_ir_step_1d(&p, state, next, k1, k2, k3, k4, tmp,
        32, 1.0, 0.0, SOFIA_BC_DIRICHLET, 0.0, 1.0,
        SOFIA_RK_EULER) == 0 { return 4 }
    if sofia_ir_step_1d(&p, state, next, k1, k2, k3, k4, tmp,
        32, 1.0, 0.01, SOFIA_BC_DIRICHLET, 0.0, 1.0,
        99) == 0 { return 5 }
    if sofia_ir_rhs_1d(&p, state, k1, 32, 1.0, 999, 0.0, 1.0) == 0 {
        return 6
    }

    # The caller owns the DAG buffer: validate must detect corrupted
    # intermediate dimensions even when the final RHS dimensions still match.
    nodes[lap].length_dim = -3
    if sofia_ir_validate(&p) != 20 { return 15 }
    nodes[lap].length_dim = -2
    nodes[alpha].length_dim = 3
    if sofia_ir_validate(&p) != 20 { return 16 }
    nodes[alpha].length_dim = 2
    if sofia_ir_validate(&p) != 0 { return 17 }

    let mut bad: SofiaIrProgram = sofia_ir_new(nodes, 16)
    let b_field: i32 = sofia_ir_field(&bad, 0, 0, 1)
    let wrong: i32 = sofia_ir_constant(&bad, 1.0, 0, -1, 0)
    if sofia_ir_set_rhs(&bad, wrong) == 0 { return 7 }
    if sofia_ir_validate(&bad) == 0 { return 8 }

    let mut bad2: SofiaIrProgram = sofia_ir_new(nodes, 16)
    let f2: i32 = sofia_ir_field(&bad2, 0, 0, 1)
    let wrong2: i32 = sofia_ir_constant(&bad2, 1.0, 2, -1, 0)
    if sofia_ir_add(&bad2, f2, wrong2) >= 0 { return 9 }
    if sofia_ir_validate(&bad2) == 0 { return 10 }

    # Even unused scratch buffers are part of the public no-aliasing contract.
    # Duplicate stage buffers used to pass validation and could corrupt RK4.
    if sofia_ir_step_1d(&p, state, next, k1, k1, k3, k4, tmp,
        32, 1.0 / 31.0, 0.01, SOFIA_BC_DIRICHLET, 0.0, 1.0,
        SOFIA_RK_CLASSIC_4) != 18 { return 11 }
    if sofia_ir_step_1d(&p, state, next, k1, k2, k3, next, tmp,
        32, 1.0 / 31.0, 0.01, SOFIA_BC_DIRICHLET, 0.0, 1.0,
        SOFIA_RK_CLASSIC_4) != 18 { return 12 }
    if sofia_ir_step_1d(&p, state, next, k1, k2, k3, k4, k4,
        32, 1.0 / 31.0, 0.01, SOFIA_BC_DIRICHLET, 0.0, 1.0,
        SOFIA_RK_CLASSIC_4) != 18 { return 13 }
    if sofia_ir_step_1d(&p, state, next, k1, k2, k3, k3, tmp,
        32, 1.0 / 31.0, 0.01, SOFIA_BC_DIRICHLET, 0.0, 1.0,
        SOFIA_RK_CLASSIC_4) != 18 { return 14 }
    return 0
}
