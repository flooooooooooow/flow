# Flow-native language test: importing stdlib/math.flow declares what it calls (#590).
#
# `sin(x)` after `import "stdlib/math.flow"` used to emit a call to an
# undeclared `sin_f32`, so the program failed in clang.
#
# Supersedes (behavioral parts of):
#   tests/integration/test_stdlib_c_declarations.py::test_the_math_example_runs_and_is_correct
# Exit 0 on success; a nonzero exit identifies the failing check.

import "stdlib/math.flow"

function main() -> i32 {
    let x: f64 = sin(3.14159 / 2.0)
    if x < 0.999999 or x > 1.000001 {
        return 1
    }
    return 0
}
