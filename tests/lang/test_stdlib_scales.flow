# Every function in stdlib/audio/scales.flow returns a sized array, and the
# caller reads the real notes back (#573, #943).
# Supersedes tests/integration/test_array_return.py
# ::test_a_stdlib_scale_returns_its_actual_notes and
# ::test_a_stdlib_progression_returns_real_chords.

import "stdlib/audio/scales.flow"

function main() -> i32 {
    let s: array<i32, 7> = scale_major(48)
    if s[0] != 48 or s[1] != 50 or s[2] != 52 or s[3] != 53 {
        return 1
    }
    if s[4] != 55 or s[5] != 57 or s[6] != 59 {
        return 2
    }
    let c: array<i32, 3> = chord_major(48)
    if c[0] != 48 or c[1] != 52 or c[2] != 55 {
        return 3
    }
    let p: array<array<i32, 3>, 4> = progression_pop(note_C(4))
    if p[0][0] != 48 or p[0][1] != 52 or p[0][2] != 55 {
        return 4
    }
    return 0
}
