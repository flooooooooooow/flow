# std.regex against recorded Python `re` results (issue #962).
#
# Each expectation is what CPython 3.12 returns for the same call, written
# down from Python's documented rules; no Python runs here. A match is
# shown as "start,end|group1|group2..." in code points, with "~" for a
# group that did not take part (Python's None), and "None" for no match.
# Exit 0 on success; a nonzero exit is the number of the failing case.

import std.regex {
    Regex, RxMatch, RxStrs, rx_compile, rx_ok, rx_error, rx_test, rx_search,
    rx_search_from, rx_match, rx_fullmatch, rx_next, rx_findall, rx_sub,
    rx_split, rx_escape, rx_m_group, rx_m_named, rx_m_start, rx_m_end,
    rx_m_matched, rx_m_groups, rx_m_byte_start, rx_m_byte_end, rx_m_expand,
    rx_strs_len, rx_strs_get, rx_strs_width, rx_group_count, rx_group_index,
    RX_IGNORECASE, RX_MULTILINE, RX_DOTALL, RX_ASCII
}

extern {
    function strcmp(a: string, b: string) -> i32
    function printf(fmt: string, ...) -> i32
    function snprintf(buf: ptr<u8>, n: i64, fmt: string, v: i32) -> i32
    function malloc(size: i64) -> ptr<void>
}

function itoa(v: i32) -> string {
    let buf: ptr<u8> = malloc(16) as ptr<u8>
    let _n: i32 = snprintf(buf, 16, "%d", v)
    return buf as string
}

function show(m: ptr<RxMatch>) -> string {
    if m == null {
        return "None"
    }
    let mut s: string = itoa(rx_m_start(m, 0)) + "," + itoa(rx_m_end(m, 0))
    let mut g: i32 = 1
    while g <= rx_m_groups(m) {
        if rx_m_matched(m, g) {
            s = s + "|" + rx_m_group(m, g)
        } else {
            s = s + "|~"
        }
        g = g + 1
    }
    return s
}

function join(l: ptr<RxStrs>) -> string {
    let mut s: string = ""
    let mut i: i32 = 0
    while i < rx_strs_len(l) {
        if i > 0 {
            s = s + ","
        }
        s = s + "'" + rx_strs_get(l, i) + "'"
        i = i + 1
    }
    return "[" + s + "]"
}

function check(id: i32, got: string, want: string) -> i32 {
    if strcmp(got, want) != 0 {
        printf("case %d: got %s, want %s\n", id, got, want)
        return id
    }
    return 0
}

function search(p: string, flags: i32, t: string) -> string {
    return show(rx_search(rx_compile(p, flags), t))
}

function match_(p: string, flags: i32, t: string) -> string {
    return show(rx_match(rx_compile(p, flags), t))
}

function full(p: string, flags: i32, t: string) -> string {
    return show(rx_fullmatch(rx_compile(p, flags), t))
}

function findall(p: string, flags: i32, t: string) -> string {
    return join(rx_findall(rx_compile(p, flags), t))
}

function sub(p: string, repl: string, t: string, count: i32) -> string {
    return rx_sub(rx_compile(p, 0), repl, t, count)
}

function split(p: string, t: string, maxsplit: i32) -> string {
    return join(rx_split(rx_compile(p, 0), t, maxsplit))
}

function compile_error(p: string) -> string {
    return rx_error(rx_compile(p, 0))
}

function run() -> i32 {
    let mut f: i32 = 0
    # Groups, named groups, spans.
    f = check(1, search("(\\w+)@(?P<host>[\\w.]+)", 0, "mail bob@example.org today"), "5,20|bob|example.org")
    if f != 0 { return f }
    f = check(2, match_("a+", 0, "baaa"), "None")
    if f != 0 { return f }
    f = check(3, match_("b(a+)", 0, "baaa"), "0,4|aaa")
    if f != 0 { return f }
    # fullmatch backtracks into the second alternative.
    f = check(4, full("a|ab", 0, "ab"), "0,2")
    if f != 0 { return f }
    f = check(5, search("a|ab", 0, "ab"), "0,1")
    if f != 0 { return f }
    # Lazy and greedy.
    f = check(6, search("<.+?>", 0, "<a><b>"), "0,3")
    if f != 0 { return f }
    f = check(7, search("<.+>", 0, "<a><b>"), "0,6")
    if f != 0 { return f }
    # A repeated group keeps its last iteration.
    f = check(8, search("(a|b)*c", 0, "abac"), "0,4|a")
    if f != 0 { return f }
    f = check(9, search("(a)|b", 0, "b"), "0,1|~")
    if f != 0 { return f }
    # Backreferences.
    f = check(10, search("(\\w)\\1", 0, "abccd"), "2,4|c")
    if f != 0 { return f }
    f = check(11, search("(?P<q>[\"']).*?(?P=q)", 0, "say \"hi\" now"), "4,8|\"")
    if f != 0 { return f }
    # Lookaround.
    f = check(12, search("\\w+(?=!)", 0, "hey you!"), "4,7")
    if f != 0 { return f }
    f = check(13, search("\\b(?!un)\\w+", 0, "undo redo"), "5,9")
    if f != 0 { return f }
    f = check(14, search("(?<=\\$)\\d+", 0, "cost $42"), "6,8")
    if f != 0 { return f }
    f = check(15, search("(?<!\\$)\\b\\d+", 0, "$4 and 57"), "7,9")
    if f != 0 { return f }
    # Flags.
    f = check(16, search("HeLLo", RX_IGNORECASE, "say hello"), "4,9")
    if f != 0 { return f }
    f = check(17, search("[a-c]+", RX_IGNORECASE, "xBCAy"), "1,4")
    if f != 0 { return f }
    f = check(18, findall("^\\w+", RX_MULTILINE, "one two\nthree four"), "['one','three']")
    if f != 0 { return f }
    f = check(19, search("a.b", 0, "a\nb"), "None")
    if f != 0 { return f }
    f = check(20, search("a.b", RX_DOTALL, "a\nb"), "0,3")
    if f != 0 { return f }
    f = check(21, search("x$", 0, "x\n"), "0,1")
    if f != 0 { return f }
    f = check(22, search("x\\Z", 0, "x\n"), "None")
    if f != 0 { return f }
    f = check(23, search("(?i)abc", 0, "xABC"), "1,4")
    if f != 0 { return f }
    f = check(24, search("(?s)a.b", 0, "a\nb"), "0,3")
    if f != 0 { return f }
    f = check(25, search("\\w+", RX_ASCII, "éa"), "1,2")
    if f != 0 { return f }
    f = check(26, search("\\w+", 0, "éa"), "0,2")
    if f != 0 { return f }
    # Code points, and byte offsets into the UTF-8 string.
    let m27: ptr<RxMatch> = rx_search(rx_compile(".(.)", 0), "héllo")
    f = check(27, show(m27), "0,2|é")
    if f != 0 { return f }
    if rx_m_byte_start(m27, 1) != 1 or rx_m_byte_end(m27, 1) != 3 { return 28 }
    # Repeats.
    f = check(29, full("\\d{2,3}", 0, "1234"), "None")
    if f != 0 { return f }
    f = check(30, full("\\d{2,3}", 0, "123"), "0,3")
    if f != 0 { return f }
    f = check(31, full("a{,2}", 0, "aa"), "0,2")
    if f != 0 { return f }
    f = check(32, search("a{x", 0, "ba{x"), "1,4")
    if f != 0 { return f }
    f = check(33, search("a{2,4}?", 0, "aaaa"), "0,2")
    if f != 0 { return f }
    f = check(34, full("(a|ab)(c|bcd)(d*)", 0, "abcd"), "0,4|a|bcd|")
    if f != 0 { return f }
    f = check(35, full("(?:(\\d)\\s?)+", 0, "1 2 3"), "0,5|3")
    if f != 0 { return f }
    f = check(36, search("(a)?b", 0, "b"), "0,1|~")
    if f != 0 { return f }
    f = check(37, full("a(|b)c", 0, "ac"), "0,2|")
    if f != 0 { return f }
    f = check(38, full("(a*)*", 0, "aa"), "0,2|")
    if f != 0 { return f }
    # Escapes and classes.
    f = check(39, search("\\s", 0, "a b"), "1,2")
    if f != 0 { return f }
    f = check(40, search("\\x41\\u00e9", 0, "zAé"), "1,3")
    if f != 0 { return f }
    f = check(41, findall("[\\d\\-]+", 0, "a1-2b"), "['1-2']")
    if f != 0 { return f }
    f = check(42, search("[^a]+", 0, "aa\nb"), "2,4")
    if f != 0 { return f }
    f = check(43, findall("\\b\\w+\\b", 0, "héllo wörld"), "['héllo','wörld']")
    if f != 0 { return f }
    f = check(44, search("a(?#note)b", 0, "ab"), "0,2")
    if f != 0 { return f }
    # findall.
    f = check(45, findall("(\\d+)-", 0, "1-22-333"), "['1','22']")
    if f != 0 { return f }
    let l46: ptr<RxStrs> = rx_findall(rx_compile("(\\w)=(\\d)", 0), "a=1 b=2")
    f = check(46, join(l46), "['a','1','b','2']")
    if f != 0 { return f }
    if rx_strs_width(l46) != 2 { return 47 }
    f = check(48, findall("x*", 0, "abxd"), "['','','x','','']")
    if f != 0 { return f }
    f = check(49, findall("\\w+$", RX_MULTILINE, "a b\nc d"), "['b','d']")
    if f != 0 { return f }
    # sub.
    f = check(50, sub("(\\w+) (\\w+)", "\\2 \\1", "hello world", 0), "world hello")
    if f != 0 { return f }
    f = check(51, sub("a", "b", "aaa", 2), "bba")
    if f != 0 { return f }
    f = check(52, sub("x*", "-", "abxd", 0), "-a-b--d-")
    if f != 0 { return f }
    f = check(53, sub("(?P<w>\\w+)", "[\\g<w>]", "a bc", 0), "[a] [bc]")
    if f != 0 { return f }
    f = check(54, sub("\\d", "<\\g<0>>", "a1b2", 0), "a<1>b<2>")
    if f != 0 { return f }
    f = check(55, sub("(a)|b", "[\\1]", "ab", 0), "[a][]")
    if f != 0 { return f }
    f = check(56, sub(",", "\\n", "a,b", 0), "a\nb")
    if f != 0 { return f }
    # split.
    f = check(57, split("\\s*,\\s*", "a , b,c", 0), "['a','b','c']")
    if f != 0 { return f }
    f = check(58, split("(-)", "a-b-c", 0), "['a','-','b','-','c']")
    if f != 0 { return f }
    f = check(59, split(",", "a,b,c", 1), "['a','b,c']")
    if f != 0 { return f }
    f = check(60, split("\\b", "a b", 0), "['','a',' ','b','']")
    if f != 0 { return f }
    # escape.
    f = check(61, rx_escape("a.b*c d"), "a\\.b\\*c\\ d")
    if f != 0 { return f }
    let lit: ptr<Regex> = rx_compile(rx_escape("1+1=(2)"), 0)
    f = check(62, show(rx_search(lit, "so 1+1=(2)")), "3,10")
    if f != 0 { return f }
    # finditer.
    let r63: ptr<Regex> = rx_compile("\\d+", 0)
    let m63: ptr<RxMatch> = rx_search(r63, "a1b22")
    f = check(63, show(m63), "1,2")
    if f != 0 { return f }
    let m64: ptr<RxMatch> = rx_next(m63)
    f = check(64, show(m64), "3,5")
    if f != 0 { return f }
    if rx_next(m64) != null { return 65 }
    # search from a position: ^ still means the start of the text.
    f = check(66, show(rx_search_from(rx_compile("a", 0), "abcabc", 2)), "3,4")
    if f != 0 { return f }
    f = check(67, show(rx_search_from(rx_compile("^a", 0), "abcabc", 2)), "None")
    if f != 0 { return f }
    # Match objects.
    let r68: ptr<Regex> = rx_compile("(?P<k>\\w+)=(?P<v>\\w*)", 0)
    if rx_group_count(r68) != 2 or rx_group_index(r68, "v") != 2 or rx_group_index(r68, "x") != 0 - 1 { return 68 }
    let m69: ptr<RxMatch> = rx_search(r68, " key=val ")
    f = check(69, rx_m_named(m69, "k") + "/" + rx_m_named(m69, "v"), "key/val")
    if f != 0 { return f }
    f = check(70, rx_m_expand(m69, "\\g<v>:\\1\\t"), "val:key\t")
    if f != 0 { return f }
    if rx_m_start(m69, 2) != 5 or rx_m_end(m69, 2) != 8 or rx_m_start(m69, 3) != 0 - 1 { return 71 }
    # rx_test is re.search as a bool.
    if rx_test(rx_compile("b+", 0), "abbc") == false { return 72 }
    if rx_test(rx_compile("^b", 0), "abbc") { return 73 }
    # Compile errors carry Python's messages.
    f = check(74, compile_error("(a"), "missing ), unterminated subpattern")
    if f != 0 { return f }
    f = check(75, compile_error("a**"), "multiple repeat")
    if f != 0 { return f }
    f = check(76, compile_error("(?<=a+)b"), "look-behind requires fixed-width pattern")
    if f != 0 { return f }
    f = check(77, compile_error("\\1(a)"), "invalid group reference")
    if f != 0 { return f }
    f = check(78, compile_error("[z-a]"), "bad character range")
    if f != 0 { return f }
    f = check(79, compile_error("*a"), "nothing to repeat")
    if f != 0 { return f }
    f = check(80, compile_error("a)"), "unbalanced parenthesis")
    if f != 0 { return f }
    let bad: ptr<Regex> = rx_compile("(", 0)
    if rx_ok(bad) or rx_test(bad, "(") or rx_search(bad, "(") != null { return 81 }
    if rx_ok(rx_compile("a(b)c", 0)) == false { return 82 }
    return 0
}

function main() -> i32 {
    return run()
}
