# Flow-native language test: the hashmap, bigint and checked-arith smokes.
#
# Strict copies of examples/basics/hashmap_i64_smoke.flow,
# bigint_smoke.flow and checked_arith_smoke.flow. The examples returned their
# answer as the exit code (30, 7, 0); here each answer is compared in main.
#
# Supersedes (behavioral parts of):
#   tests/unit/test_misra_euler_batch.py::test_hashmap_i64_i64_runs
#   tests/unit/test_misra_euler_batch.py::test_bigint_mod_u32_runs
#   tests/unit/test_misra_phase2.py::test_checked_arith_smoke_runs
# Exit 0 on success; a nonzero exit identifies the failing check.

extern {
    function calloc(n: i64, s: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

# ---- HashMap_i64_i64 (#252) -------------------------------------------------

struct HashMap_i64_i64 {
    keys: ptr<i64>,
    values: ptr<i64>,
    occupied: ptr<i32>,
    size: i32,
    capacity: i32
}

function hash_i64(k: i64) -> i32 {
    let mut h: i64 = k
    if h < 0 {
        h = 0 - h
    }
    return (h % 2147483647) as i32
}

function hashmap_new(cap: i32) -> HashMap_i64_i64 {
    let mut c: i32 = cap
    if c < 8 {
        c = 8
    }
    return HashMap_i64_i64 {
        keys: calloc(c as i64, 8) as ptr<i64>,
        values: calloc(c as i64, 8) as ptr<i64>,
        occupied: calloc(c as i64, 4) as ptr<i32>,
        size: 0,
        capacity: c
    }
}

function hashmap_insert(map: HashMap_i64_i64, key: i64, value: i64) -> HashMap_i64_i64 {
    let mut m: HashMap_i64_i64 = map
    let mut i: i32 = hash_i64(key) % m.capacity
    for probe in 0 to m.capacity {
        if m.occupied[i] == 0 {
            m.keys[i] = key
            m.values[i] = value
            m.occupied[i] = 1
            m.size = m.size + 1
            return m
        }
        if m.keys[i] == key {
            m.values[i] = value
            return m
        }
        i = i + 1
        if i >= m.capacity {
            i = 0
        }
    }
    return m
}

function hashmap_get(m: HashMap_i64_i64, key: i64, default_value: i64) -> i64 {
    let mut i: i32 = hash_i64(key) % m.capacity
    for probe in 0 to m.capacity {
        if m.occupied[i] == 0 {
            return default_value
        }
        if m.keys[i] == key {
            return m.values[i]
        }
        i = i + 1
        if i >= m.capacity {
            i = 0
        }
    }
    return default_value
}

# ---- BigInt (#252) ----------------------------------------------------------

const BIGINT_LIMB_BASE: i64 = 4294967296
const BIGINT_LIMB_MASK: i64 = 4294967295

struct BigInt {
    limbs: ptr<u32>,
    len: i32,
    cap: i32,
    sign: i32
}

function bigint_from_i64(v: i64) -> BigInt {
    let limbs: ptr<u32> = calloc(4, 4) as ptr<u32>
    let mut a: BigInt = BigInt { limbs: limbs, len: 0, cap: 4, sign: 0 }
    if v == 0 {
        return a
    }
    let mut x: i64 = v
    let mut s: i32 = 1
    if x < 0 {
        s = 0 - 1
        x = 0 - x
    }
    a.sign = s
    let mut n: i32 = 0
    while x > 0 {
        a.limbs[n] = (x & BIGINT_LIMB_MASK) as u32
        x = x / BIGINT_LIMB_BASE
        n = n + 1
    }
    a.len = n
    return a
}

function bigint_mod_u32(a: BigInt, d: u32) -> u32 {
    if a.sign == 0 or d == 0 {
        return 0
    }
    let mut rem: i64 = 0
    let mut i: i32 = a.len - 1
    while i >= 0 {
        rem = (rem * BIGINT_LIMB_BASE + (a.limbs[i] as i64)) % (d as i64)
        i = i - 1
    }
    return rem as u32
}

# ---- checked / saturating / wrapping arith (#275) ---------------------------

function wrapping_add_i32(a: i32, b: i32) -> i32 {
    return ((a as i64) + (b as i64)) as i32
}

function saturating_add_i32(a: i32, b: i32) -> i32 {
    let s: i64 = (a as i64) + (b as i64)
    if s > 2147483647 {
        return 2147483647
    }
    if s < (0 - 2147483648) {
        return 0 - 2147483648
    }
    return s as i32
}

function main() -> i32 {
    let mut m: HashMap_i64_i64 = hashmap_new(16)
    m = hashmap_insert(m, 1, 10)
    m = hashmap_insert(m, 2, 20)
    if hashmap_get(m, 1, 0) + hashmap_get(m, 2, 0) != 30 {
        return 1
    }
    if hashmap_get(m, 3, 99) != 99 {
        return 2
    }
    m = hashmap_insert(m, 1, 11)
    if hashmap_get(m, 1, 0) != 11 or m.size != 2 {
        return 3
    }

    let a: BigInt = bigint_from_i64(1000000007)
    let r: u32 = bigint_mod_u32(a, 1000)
    free(a.limbs as ptr<void>)
    if r != 7 {
        return 4
    }

    if saturating_add_i32(2147483647, 1) != 2147483647 {
        return 5
    }
    if wrapping_add_i32(2147483647, 1) != (0 - 2147483648) {
        return 6
    }
    return 0
}
