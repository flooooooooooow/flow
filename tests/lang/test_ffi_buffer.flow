# Structural test for the zero-copy FFI buffer ABI (#737).
# A supported handoff must keep the caller's pointer (no payload copy).
# An incompatible layout must fail closed without copying.
# Run with: ./flow test-lang tests/lang/test_ffi_buffer.flow

import "registry/packages/ffi/src/buffer_handoff.flow"
import "registry/packages/ffi/src/lib.flow"

@cInclude("ffi_buffer_abi_helper.h")

@cEmbed("
#include <stdint.h>
int64_t flow_ffi_sizeof_ptr(void) { return sizeof(void*); }
")

extern {
    function flow_ffi_test_borrow_addr(data: ptr<void>, len: i64, item_size: i64, item_align: i32) -> i64
    function flow_ffi_test_borrow_status(data: ptr<void>, len: i64, have_size: i64, have_stride: i64, have_align: i32, want_size: i64, want_stride: i64, want_align: i32) -> i32
}

function test_instrumentation() -> i32 {
    let mut inst: FFIInstrumentation = ffi_instrumentation_new()
    let p_inst: ptr<FFIInstrumentation> = &inst

    ffi_record_copy(p_inst, 1024)
    ffi_record_zero_copy(p_inst, 2048)

    if inst.total_copies != 1 { return 1 }
    if inst.total_bytes_copied != 1024 { return 2 }
    if inst.total_zero_copy != 1 { return 3 }
    if inst.total_bytes_zero_copy != 2048 { return 4 }

    return 0
}

function test_borrowed() -> i32 {
    let mut v: i32 = 42
    let p: ptr<i32> = &v

    let buf: FFIBuffer = ffi_buffer_borrowed(p as ptr<void>, 1, 4)
    if buf.ownership != FFI_OWN_BORROWED { return 1 }
    if buf.len != 1 { return 2 }
    if buf.item_size != 4 { return 3 }
    if ffi_buffer_addr(buf) != (p as i64) { return 4 }

    return 0
}

function test_owned() -> i32 {
    let p: ptr<i8> = ffi_alloc(4)
    let buf: FFIBuffer = ffi_buffer_owned(p as ptr<void>, 1, 4, 12345 as ptr<void>)

    if buf.ownership != FFI_OWN_OWNED { return 1 }
    if buf.len != 1 { return 2 }
    if buf.item_size != 4 { return 3 }
    if (buf.dealloc as i64) != 12345 { return 4 }
    if ffi_buffer_addr(buf) != (p as i64) { return 5 }

    ffi_free(p)
    return 0
}

# Supported contiguous i32 handoff: same pointer, mutation is visible, 0 copy bytes.
function test_zero_copy_pointer_identity() -> i32 {
    let mut cells: i32 = 8
    let raw: ptr<i8> = ffi_alloc((cells as i64) * 4)
    if (raw as i64) == 0 { return 1 }
    let p: ptr<i32> = raw as ptr<i32>
    let mut i: i32 = 0
    while i < cells {
        p[i] = 100 + i
        i = i + 1
    }

    let have: FFILayout = ffi_layout_contiguous(4, 4)
    let want: FFILayout = ffi_layout_contiguous(4, 4)
    let handoff: FFIHandoff = ffi_buffer_try_borrow(raw as ptr<void>, cells as i64, have, want)
    if handoff.status != FFI_OK { ffi_free(raw); return 2 }
    if ffi_buffer_addr(handoff.buf) != (raw as i64) { ffi_free(raw); return 3 }
    if handoff.buf.ownership != FFI_OWN_BORROWED { ffi_free(raw); return 4 }
    if ffi_buffer_nbytes(handoff.buf) != 32 { ffi_free(raw); return 5 }

    let view: ptr<i32> = handoff.buf.data as ptr<i32>
    view[0] = 7
    if p[0] != 7 { ffi_free(raw); return 6 }

    let c_addr: i64 = flow_ffi_test_borrow_addr(raw as ptr<void>, cells as i64, 4, 4)
    if c_addr != (raw as i64) { ffi_free(raw); return 7 }

    let mut inst: FFIInstrumentation = ffi_instrumentation_new()
    ffi_record_zero_copy(&inst, ffi_buffer_nbytes(handoff.buf))
    if inst.total_bytes_copied != 0 { ffi_free(raw); return 8 }
    if inst.total_zero_copy != 1 { ffi_free(raw); return 9 }

    ffi_free(raw)
    return 0
}

function test_incompatible_layout_no_copy() -> i32 {
    let raw: ptr<i8> = ffi_alloc(16)
    if (raw as i64) == 0 { return 1 }
    raw[0] = 9

    # Non-contiguous stride must not become a silent packed copy.
    let have_stride: FFILayout = FFILayout { item_size: 4, stride: 8, item_align: 4, reserved: 0 }
    let want: FFILayout = ffi_layout_contiguous(4, 4)
    let bad_stride: FFIHandoff = ffi_buffer_try_borrow(raw as ptr<void>, 2, have_stride, want)
    if bad_stride.status != FFI_ERR_STRIDE { ffi_free(raw); return 2 }
    if ffi_buffer_addr(bad_stride.buf) != 0 { ffi_free(raw); return 3 }

    let c_stride: i32 = flow_ffi_test_borrow_status(raw as ptr<void>, 2, 4, 8, 4, 4, 4, 4)
    if c_stride != FFI_ERR_STRIDE { ffi_free(raw); return 4 }

    # Item-size mismatch (i32 vs i64) is incompatible, not a widening copy.
    let have_i32: FFILayout = ffi_layout_contiguous(4, 4)
    let want_i64: FFILayout = ffi_layout_contiguous(8, 8)
    let bad_size: FFIHandoff = ffi_buffer_try_borrow(raw as ptr<void>, 2, have_i32, want_i64)
    if bad_size.status != FFI_ERR_INCOMPATIBLE { ffi_free(raw); return 5 }
    if ffi_buffer_addr(bad_size.buf) != 0 { ffi_free(raw); return 6 }

    # Under-aligned pointer for an 8-byte want.
    let odd: ptr<void> = ((raw as i64) + 1) as ptr<void>
    let have_u8: FFILayout = ffi_layout_contiguous(1, 1)
    let want_align: FFILayout = ffi_layout_contiguous(1, 8)
    let bad_align: FFIHandoff = ffi_buffer_try_borrow(odd, 4, have_u8, want_align)
    if bad_align.status != FFI_ERR_BAD_ALIGN { ffi_free(raw); return 7 }
    if ffi_buffer_addr(bad_align.buf) != 0 { ffi_free(raw); return 8 }

    if raw[0] != 9 { ffi_free(raw); return 9 }

    let mut inst: FFIInstrumentation = ffi_instrumentation_new()
    if inst.total_bytes_copied != 0 { ffi_free(raw); return 10 }

    ffi_free(raw)
    return 0
}

function test_explicit_copy_is_opt_in() -> i32 {
    let src: ptr<i8> = ffi_alloc(4)
    let dst: ptr<i8> = ffi_alloc(4)
    if (src as i64) == 0 or (dst as i64) == 0 {
        return 1
    }
    src[0] = 1
    src[1] = 2
    src[2] = 3
    src[3] = 4
    dst[0] = 0
    dst[1] = 0
    dst[2] = 0
    dst[3] = 0

    let st: i32 = ffi_buffer_copy_explicit(dst as ptr<void>, src as ptr<void>, 4)
    if st != FFI_OK { ffi_free(src); ffi_free(dst); return 2 }
    if dst[0] != 1 or dst[3] != 4 { ffi_free(src); ffi_free(dst); return 3 }

    let mut inst: FFIInstrumentation = ffi_instrumentation_new()
    ffi_record_copy(&inst, 4)
    if inst.total_bytes_copied != 4 { ffi_free(src); ffi_free(dst); return 4 }

    ffi_free(src)
    ffi_free(dst)
    return 0
}

function main() -> i32 {
    let r1: i32 = test_instrumentation()
    if r1 != 0 { return r1 }

    let r2: i32 = test_borrowed()
    if r2 != 0 { return r2 + 10 }

    let r3: i32 = test_owned()
    if r3 != 0 { return r3 + 20 }

    let r4: i32 = test_zero_copy_pointer_identity()
    if r4 != 0 { return r4 + 30 }

    let r5: i32 = test_incompatible_layout_no_copy()
    if r5 != 0 { return r5 + 40 }

    let r6: i32 = test_explicit_copy_is_opt_in()
    if r6 != 0 { return r6 + 50 }

    return 0
}
