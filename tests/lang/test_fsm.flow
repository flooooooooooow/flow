import "stdlib/fsm.flow"

const STATE_IDLE: i32 = 0
const STATE_ARMED: i32 = 1
const STATE_ACTIVE: i32 = 2
const STATE_FAULT: i32 = 3

const EVENT_ARM: i32 = 10
const EVENT_START: i32 = 20
const EVENT_STOP: i32 = 30
const EVENT_ERROR: i32 = 40

function main() -> i32 {
    let mut fsm: StateMachine = fsm_new(STATE_IDLE)

    # Setup transitions
    fsm_add_transition(&fsm, STATE_IDLE, EVENT_ARM, STATE_ARMED)
    fsm_add_transition(&fsm, STATE_ARMED, EVENT_START, STATE_ACTIVE)
    fsm_add_transition(&fsm, STATE_ACTIVE, EVENT_STOP, STATE_IDLE)
    fsm_add_transition(&fsm, STATE_ARMED, EVENT_ERROR, STATE_FAULT)
    fsm_add_transition(&fsm, STATE_ACTIVE, EVENT_ERROR, STATE_FAULT)

    # Initial state
    if fsm_current_state(&fsm) != STATE_IDLE {
        fsm_free(&fsm)
        return 1
    }

    # Cannot trigger START while IDLE
    if fsm_can_trigger(&fsm, EVENT_START) {
        fsm_free(&fsm)
        return 2
    }
    if fsm_trigger(&fsm, EVENT_START) {
        fsm_free(&fsm)
        return 3
    }

    # Trigger ARM -> ARMED
    if not fsm_can_trigger(&fsm, EVENT_ARM) {
        fsm_free(&fsm)
        return 4
    }
    if not fsm_trigger(&fsm, EVENT_ARM) {
        fsm_free(&fsm)
        return 5
    }
    if fsm_current_state(&fsm) != STATE_ARMED {
        fsm_free(&fsm)
        return 6
    }
    if fsm_previous_state(&fsm) != STATE_IDLE {
        fsm_free(&fsm)
        return 7
    }

    # Trigger START -> ACTIVE
    if not fsm_trigger(&fsm, EVENT_START) {
        fsm_free(&fsm)
        return 8
    }
    if fsm_current_state(&fsm) != STATE_ACTIVE {
        fsm_free(&fsm)
        return 9
    }

    # Trigger ERROR -> FAULT
    if not fsm_trigger(&fsm, EVENT_ERROR) {
        fsm_free(&fsm)
        return 10
    }
    if fsm_current_state(&fsm) != STATE_FAULT {
        fsm_free(&fsm)
        return 11
    }

    # Reset -> IDLE
    fsm_reset(&fsm)
    if fsm_current_state(&fsm) != STATE_IDLE {
        fsm_free(&fsm)
        return 12
    }

    fsm_free(&fsm)
    return 0
}
