# Flow-native language test: `find` and `bsearch` defined in another module
# are the calls' targets (#1045). flowc routed `find` to its builtin and
# emitted `bsearch` under the libc name.
# Exit 0 on success; a nonzero exit identifies the failing check.

import "tests/fixtures/user_named_builtins/search.flow"

function main() -> i32 {
    let xs: [i32; 7] = [1, 3, 4, 7, 9, 12, 15]
    if find(xs, 7, 9) != 4 {
        return 1
    }
    if find(xs, 7, 2) != -1 {
        return 2
    }
    if bsearch(xs, 7, 12) != 5 {
        return 3
    }
    if bsearch(xs, 7, 5) != -1 {
        return 4
    }
    return 0
}
