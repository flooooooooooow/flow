# A bundle can call the plain (non-exported) functions and consts of the
# modules it imports, as on the Python host (#988). The dynamics stdlib
# relies on this: core.flow calls linalg.flow helpers that are not exported.

import "tests/fixtures/module_private/core.flow"

function main() -> i32 {
    # core_step(20) = scale2(20) + 1 = 41
    return core_step(20) - 41
}
