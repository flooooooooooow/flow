# sizeof<T>() is the byte size of T as an i64 (#952). The strict checker
# reported "Undefined function 'sizeof_i64'".

struct Pair {
    a: i64
    b: i32
}

function main() -> i32 {
    if sizeof<i64>() != 8 { return 1 }
    if sizeof<u8>() != 1 { return 2 }
    let n: i64 = sizeof<Pair>()
    if n != 16 { return 3 }
    let p: ptr<Pair> = malloc(sizeof<Pair>() * 2) as ptr<Pair>
    p[1] = Pair { a: 5, b: 6 }
    if p[1].b != 6 { return 4 }
    free(p)
    return 0
}
