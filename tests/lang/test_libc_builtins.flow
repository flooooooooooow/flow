# Flow-native language test: C library functions need no extern block.
#
# The Python checker knows printf, strlen, sqrt and the rest of its
# BUILTIN_FUNCTIONS table without a declaration, and the generated C
# includes the headers that declare them. flowc's typecheck used to reject
# the same calls with `flowc tc: unbound call` (#1006).
# Exit 0 on success; a nonzero exit identifies the failing check.

function main() -> i32 {
    printf("libc builtins: %d\n", 1)
    let n: i64 = strlen("hello") as i64
    if n != 5 {
        return 1
    }
    if strcmp("abc", "abc") != 0 {
        return 2
    }
    let r: f64 = sqrt(16.0)
    if r < 3.99 or r > 4.01 {
        return 3
    }
    let m: f64 = fmax(2.0, 7.5)
    if m < 7.49 or m > 7.51 {
        return 4
    }
    let buf: ptr<u8> = malloc(8) as ptr<u8>
    if buf == null {
        return 5
    }
    memset(buf, 0, 8)
    if buf[3] != 0 {
        return 6
    }
    free(buf)
    return 0
}
