# Flow-native language test: one closure representation for function types.
# A value of type `(A) -> R` is the same fat closure wherever it lives: a
# parameter, a local, a return value. Capturing lambdas, non-capturing
# lambdas and named functions all convert to it, and a closure can be
# forwarded from one function-typed parameter to another.
# Exit 0 on success; a nonzero exit identifies the failing check.

extern {
    function printf(fmt: string, ...) -> i32
}

function dbl(x: i32) -> i32 {
    return x * 2
}

function apply(f: (i32) -> i32, x: i32) -> i32 {
    return f(x)
}

# Forwards its closure parameter to another function-typed parameter.
function apply_twice(f: (i32) -> i32, x: i32) -> i32 {
    return apply(f, apply(f, x))
}

function scale(f: (f64) -> f64, x: f64) -> f64 {
    return f(x)
}

function make_adder(n: i32) -> (i32) -> i32 {
    return |x: i32| -> i32 { return x + n }
}

function pick(k: i32) -> (i32) -> i32 {
    if k == 0 {
        return dbl
    }
    return make_adder(k)
}

function main() -> i32 {
    # Named function to a function-typed parameter.
    if apply(dbl, 21) != 42 {
        return 1
    }
    # Capturing closure to a function-typed parameter, then forwarded.
    let n: i32 = 10
    let add_n: (i32) -> i32 = |x: i32| -> i32 { return x + n }
    if apply(add_n, 32) != 42 {
        return 2
    }
    if apply_twice(add_n, 22) != 42 {
        return 3
    }
    # Unannotated capturing lambda local passed as a closure.
    let m: i32 = 40
    let add_m = |x: i32| -> i32 { return x + m }
    if apply(add_m, 2) != 42 {
        return 4
    }
    # Non-capturing lambda literal as an argument.
    if apply(|x: i32| -> i32 { return x - 1 }, 43) != 42 {
        return 5
    }
    # Returned closures, called through an unannotated local.
    let add5 = make_adder(5)
    if add5(37) != 42 {
        return 6
    }
    if apply(pick(0), 21) != 42 {
        return 7
    }
    if apply(pick(2), 40) != 42 {
        return 8
    }
    # A named function in a function-typed local.
    let g: (i32) -> i32 = dbl
    if g(21) != 42 {
        return 9
    }
    # f64 closures.
    let k: f64 = 2.5
    let times_k: (f64) -> f64 = |x: f64| -> f64 { return x * k }
    if scale(times_k, 4.0) != 10.0 {
        return 10
    }
    printf("closure abi ok\n")
    return 0
}
