# Regression: adjacent map_f32 stages compose their simple lambdas.

import std.dsp { map_f32 }

extern {
    function free(p: ptr<void>) -> void
}

function main() -> i32 {
    let xs: [f32; 2] = [3.0, 4.0]
    let out: ptr<f32> = map_f32(map_f32(xs as ptr<f32>, 2, |x: f32| -> f32 { return x * 2.0 }), 2, |y: f32| -> f32 { return y + 1.0 })
    if out[0] != 7.0 or out[1] != 9.0 {
        free(out as ptr<void>)
        return 1
    }
    free(out as ptr<void>)
    return 0
}
