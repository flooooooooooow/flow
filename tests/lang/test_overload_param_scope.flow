# Overload selection types an argument by the declaration in scope. flowc
# took the first parameter of that name anywhere in the program, so in
# `addc(a: f32, b: Pair)` the `a` looked like the Pair `a` of an earlier
# function and the wrong overload was called (corpus parity: autodiff Dual).

struct Pair {
    lo: f32,
    hi: f32
}

function add(a: Pair, b: Pair) -> Pair {
    return Pair { lo: a.lo + b.lo, hi: a.hi + b.hi }
}

function add(a: f32, b: Pair) -> Pair {
    return Pair { lo: a + b.lo, hi: a + b.hi }
}

function addc(a: f32, b: Pair) -> Pair {
    return add(a, b)
}

function main() -> i32 {
    let p: Pair = Pair { lo: 1.0, hi: 2.0 }
    let q: Pair = addc(10.0, p)
    if q.lo != 11.0 or q.hi != 12.0 {
        return 1
    }
    let r: Pair = add(p, p)
    if r.hi != 4.0 {
        return 2
    }
    return 0
}
