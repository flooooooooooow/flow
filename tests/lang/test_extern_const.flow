# extern const: C constants, struct layouts and errno from the headers, and
# signal handlers through std.os (issue #1075).
#
# `const NAME: T` in an extern block names a C macro or constant; its value
# comes from the platform's headers when the C output is compiled.
# `const NAME: T = "C expression"` binds NAME to an expression the C compiler
# evaluates, which is how a program reads sizeof and offsetof.
# Exit 0 on success; a nonzero exit names the failing check.

@cEmbed("#include <stddef.h>
#include <sys/stat.h>
#include <netinet/in.h>
#include <fcntl.h>
")

import std.os {
    os_errno, os_set_errno, os_strerror, os_signal_watch, os_signal_take,
    os_signal_pending, os_signal_handle, os_signal_ignore, os_signal_default,
    os_raise, SIGINT, SIGTERM, SIGUSR1, SIGUSR2, SIGCHLD, SIGKILL, ENOENT,
    EINTR, EAGAIN
}

extern {
    function strlen(s: string) -> i64
    function access(path: string, mode: i32) -> i32

    # Macros from the headers above, each with its platform's value.
    const O_CREAT: i32
    const O_WRONLY: i32
    const INT32_MAX: i32

    # Layouts: evaluated by the C compiler.
    const SOCKADDR_IN_SIZE: i64 = "(int64_t)sizeof(struct sockaddr_in)"
    const SIN_PORT_OFFSET: i64 = "(int64_t)offsetof(struct sockaddr_in, sin_port)"
    const TIMESPEC_NSEC_OFFSET: i64 = "(int64_t)offsetof(struct timespec, tv_nsec)"
    const STAT_SIZE: i64 = "(int64_t)sizeof(struct stat)"
}

# A top-level declaration works too.
extern const SIGHUP_FROM_HEADER: i32 = "SIGHUP"

let mut usr2_seen: i32 = 0

function on_usr2(sig: i32) {
    usr2_seen = sig
}

function main() -> i32 {
    # Values that differ between macOS and Linux come out right on both.
    if SIGCHLD != 20 and SIGCHLD != 17 { return 1 }
    if O_CREAT != 512 and O_CREAT != 64 { return 2 }
    if O_WRONLY != 1 { return 3 }
    if INT32_MAX != 2147483647 { return 4 }
    if SIGINT != 2 or SIGTERM != 15 or SIGKILL != 9 { return 5 }
    if SIGHUP_FROM_HEADER != 1 { return 6 }

    # struct sockaddr_in is 16 bytes with the port at offset 2 everywhere.
    if SOCKADDR_IN_SIZE != 16 or SIN_PORT_OFFSET != 2 { return 7 }
    if TIMESPEC_NSEC_OFFSET != 8 { return 8 }
    if STAT_SIZE < 64 { return 9 }

    # errno.
    os_set_errno(0)
    if access("/flow-no-such-path-1075", 0) == 0 { return 10 }
    if os_errno() != ENOENT { return 11 }
    if strlen(os_strerror(ENOENT)) == 0 { return 12 }
    if EINTR == EAGAIN { return 13 }

    # A watched signal is counted and taken, not fatal.
    if os_signal_watch(SIGUSR1) == false { return 14 }
    let _r1: i32 = os_raise(SIGUSR1)
    let _r2: i32 = os_raise(SIGUSR1)
    if os_signal_pending(SIGUSR1) != 2 { return 15 }
    if os_signal_take(SIGUSR1) != 2 { return 16 }
    if os_signal_take(SIGUSR1) != 0 { return 17 }
    # SIGINT can be watched the same way (Ctrl-C handling).
    if os_signal_watch(SIGINT) == false { return 18 }
    let _r3: i32 = os_raise(SIGINT)
    if os_signal_take(SIGINT) != 1 { return 19 }
    if os_signal_default(SIGINT) == false { return 20 }
    # SIGKILL cannot be caught.
    if os_signal_watch(SIGKILL) { return 21 }

    # A Flow function as the handler.
    if os_signal_handle(SIGUSR2, on_usr2 as ptr<void>) == false { return 22 }
    let _r4: i32 = os_raise(SIGUSR2)
    if usr2_seen != SIGUSR2 { return 23 }

    # An ignored signal does nothing.
    if os_signal_ignore(SIGUSR2) == false { return 24 }
    let _r5: i32 = os_raise(SIGUSR2)
    return 0
}
