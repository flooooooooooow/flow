# sum(a..b step s) sums a, a+s, ... short of b in closed form (#949).
# Supersedes the run tests in tests/integration/test_range_sum.py:
# test_sum_range_compiles_to_closed_form_and_preserves_results (values),
# test_runtime_sum_does_not_overflow_where_a_loop_does_not,
# test_each_bound_is_evaluated_exactly_once.

function sum_default() -> i32 {
    return sum(0..10)
}

function sum_step() -> i32 {
    return sum(0..10 step 3)
}

function sum_offset() -> i32 {
    return sum(5..10 step 2)
}

function sum_descending() -> i32 {
    return sum(10..0 step -3)
}

function sum_empty_direction() -> i32 {
    return sum(0..10 step -1)
}

function sum_runtime(lo: i32, hi: i32, stride: i32) -> i32 {
    return sum(lo..hi step stride)
}

function loop_sum(limit: i32, stride: i32) -> i32 {
    let mut total: i32 = 0
    let mut n: i32 = 0
    while n < limit {
        total = total + n
        n = n + stride
    }
    return total
}

# Each bound is evaluated once: count calls through a shared counter array.
function counted(calls: ptr<i32>, slot: i32, v: i32) -> i32 {
    calls[slot] = calls[slot] + 1
    return v
}

extern {
    function calloc(count: i64, size: i64) -> ptr<i32>
}

function main() -> i32 {
    if sum_default() != 45 {
        return 1
    }
    if sum_step() != 18 {
        return 2
    }
    if sum_offset() != 21 {
        return 3
    }
    if sum_descending() != 22 {
        return 4
    }
    if sum_empty_direction() != 0 {
        return 5
    }
    if sum_runtime(0, 1000, 3) != 166833 {
        return 6
    }
    if sum_runtime(5, 10, 2) != 21 or sum_runtime(10, 0, 0 - 3) != 22 {
        return 7
    }
    if sum_runtime(0, 10, 0 - 1) != 0 or sum_runtime(10, 0, 1) != 0 {
        return 8
    }
    if sum_runtime(0, 10, 0) != 0 {
        return 9
    }
    # 1500013378 fits in i32; twice it does not.
    if sum_runtime(0, 54773, 1) != loop_sum(54773, 1) {
        return 10
    }
    if sum_runtime(0, 54773, 1) != 1500013378 {
        return 11
    }
    let calls: ptr<i32> = calloc(3, 4)
    let total: i32 = sum(counted(calls, 0, 0)..counted(calls, 1, 1000) step counted(calls, 2, 3))
    if total != 166833 {
        return 12
    }
    if calls[0] != 1 or calls[1] != 1 or calls[2] != 1 {
        return 13
    }
    return 0
}
