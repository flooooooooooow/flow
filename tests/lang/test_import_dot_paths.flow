# One module reached through two string-path spellings is bundled once
# (#1073). Here x/c.flow is imported directly and as m/../x/c.flow from
# m/a.flow; the bundle used to emit it twice (redefinition of c_val).

import "../fixtures/modules/dotpath/x/c.flow"
import "../fixtures/modules/dotpath/m/a.flow"

function main() -> i32 {
    return a_val() + c_val() - 14
}
