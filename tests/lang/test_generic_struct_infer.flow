# Flow-native language test: generic struct literals written without type
# arguments (#1042, #954). The type arguments come from the `let`
# annotation or from the field values, and an unannotated `let` takes the
# specialized type. flowc emitted `(Box){ ... }` with no Box type at all,
# and declared `let c = Box<f64> { ... }` as the undeclared `Box c`. The
# Python host typed every bare literal Box<i32>.
# Exit 0 on success; a nonzero exit identifies the failing check.

struct Box<T> {
    value: T
}

struct Pair<A, B> {
    first: A,
    second: B
}

struct Point {
    x: i32,
    y: i32
}

function identity<T>(x: T) -> T {
    return x
}

function wrap(x: f64) -> Box<f64> {
    return Box { value: x }
}

function make<T>(v: T) -> Box<T> {
    return Box { value: v }
}

function main() -> i32 {
    # From the annotation (#954).
    let a: Box<i32> = Box { value: 42 }
    if a.value != 42 {
        return 1
    }
    # From a float literal: f64, so 0.1 keeps its double value.
    let b = Box { value: 0.1 }
    if b.value != 0.1 {
        return 2
    }
    # Two parameters from two fields.
    let p = Pair { first: 7, second: 2.5 }
    if p.first != 7 or p.second != 2.5 {
        return 3
    }
    # From a declared name: i64 holds more than an i32.
    let big: i64 = 5000000000
    let c = Box { value: big }
    if c.value != 5000000000 {
        return 4
    }
    # From a parameter, and from a type parameter inside a generic function.
    if wrap(1.25).value != 1.25 {
        return 5
    }
    let m: Box<i32> = make<i32>(9)
    if m.value != 9 {
        return 6
    }
    # A struct literal of a plain struct as the field value.
    let q = Box { value: Point { x: 3, y: 4 } }
    if q.value.x + q.value.y != 7 {
        return 7
    }
    # An unannotated let of an explicit literal and of a generic call.
    let d = Box<f64> { value: 2.5 }
    if d.value != 2.5 {
        return 8
    }
    let e = identity<f64>(3.75)
    if e != 3.75 {
        return 9
    }
    let s = Box { value: "hi" }
    if s.value != "hi" {
        return 10
    }
    return 0
}
