# Flow-native language test: parser / codegen torture.
#
# Deep nesting and wide bodies, run rather than merely parsed: a struct nest
# four deep with a matching literal and access chain, sixty-four locals summed
# in one expression, thirty-two functions called from one expression, and
# sixteen levels of nested if.
# Supersedes (behavioral parts of):
#   tests/unit/test_torture_nesting.py::test_nested_struct_runs
#   tests/unit/test_torture_nesting.py::test_many_locals_runs_exit_zero
#   tests/unit/test_torture_nesting.py::test_many_functions_runs
# Exit 0 on success; a nonzero exit identifies the failing check.

struct S0 {
    v: i32
}

struct S1 {
    inner: S0
}

struct S2 {
    inner: S1
}

struct S3 {
    inner: S2
}

struct S4 {
    inner: S3
}

function f0(x: i32) -> i32 {
    return x + 0
}

function f1(x: i32) -> i32 {
    return x + 1
}

function f2(x: i32) -> i32 {
    return x + 2
}

function f3(x: i32) -> i32 {
    return x + 3
}

function f4(x: i32) -> i32 {
    return x + 4
}

function f5(x: i32) -> i32 {
    return x + 5
}

function f6(x: i32) -> i32 {
    return x + 6
}

function f7(x: i32) -> i32 {
    return x + 7
}

function f8(x: i32) -> i32 {
    return x + 8
}

function f9(x: i32) -> i32 {
    return x + 9
}

function f10(x: i32) -> i32 {
    return x + 10
}

function f11(x: i32) -> i32 {
    return x + 11
}

function f12(x: i32) -> i32 {
    return x + 12
}

function f13(x: i32) -> i32 {
    return x + 13
}

function f14(x: i32) -> i32 {
    return x + 14
}

function f15(x: i32) -> i32 {
    return x + 15
}

function f16(x: i32) -> i32 {
    return x + 16
}

function f17(x: i32) -> i32 {
    return x + 17
}

function f18(x: i32) -> i32 {
    return x + 18
}

function f19(x: i32) -> i32 {
    return x + 19
}

function f20(x: i32) -> i32 {
    return x + 20
}

function f21(x: i32) -> i32 {
    return x + 21
}

function f22(x: i32) -> i32 {
    return x + 22
}

function f23(x: i32) -> i32 {
    return x + 23
}

function f24(x: i32) -> i32 {
    return x + 24
}

function f25(x: i32) -> i32 {
    return x + 25
}

function f26(x: i32) -> i32 {
    return x + 26
}

function f27(x: i32) -> i32 {
    return x + 27
}

function f28(x: i32) -> i32 {
    return x + 28
}

function f29(x: i32) -> i32 {
    return x + 29
}

function f30(x: i32) -> i32 {
    return x + 30
}

function f31(x: i32) -> i32 {
    return x + 31
}

# Sixteen levels of nested if / else, all taking the true branch.
function deep_if() -> i32 {
    if 15 == 15 {
        if 14 == 14 {
            if 13 == 13 {
                if 12 == 12 {
                    if 11 == 11 {
                        if 10 == 10 {
                            if 9 == 9 {
                                if 8 == 8 {
                                    if 7 == 7 {
                                        if 6 == 6 {
                                            if 5 == 5 {
                                                if 4 == 4 {
                                                    if 3 == 3 {
                                                        if 2 == 2 {
                                                            if 1 == 1 {
                                                                if 0 == 0 {
                                                                    return 0
                                                                } else {
                                                                    return 1
                                                                }
                                                            } else {
                                                                return 1
                                                            }
                                                        } else {
                                                            return 1
                                                        }
                                                    } else {
                                                        return 1
                                                    }
                                                } else {
                                                    return 1
                                                }
                                            } else {
                                                return 1
                                            }
                                        } else {
                                            return 1
                                        }
                                    } else {
                                        return 1
                                    }
                                } else {
                                    return 1
                                }
                            } else {
                                return 1
                            }
                        } else {
                            return 1
                        }
                    } else {
                        return 1
                    }
                } else {
                    return 1
                }
            } else {
                return 1
            }
        } else {
            return 1
        }
    } else {
        return 1
    }
}

function main() -> i32 {
    # A struct nested four deep, built and read back in one chain.
    let nest: S4 = S4 { inner: S3 { inner: S2 { inner: S1 { inner: S0 { v: 7 } } } } }
    if nest.inner.inner.inner.inner.v != 7 {
        return 1
    }

    # Sixty-four locals summed in a single expression: 0+1+...+63.
    let v0: i32 = 0
    let v1: i32 = 1
    let v2: i32 = 2
    let v3: i32 = 3
    let v4: i32 = 4
    let v5: i32 = 5
    let v6: i32 = 6
    let v7: i32 = 7
    let v8: i32 = 8
    let v9: i32 = 9
    let v10: i32 = 10
    let v11: i32 = 11
    let v12: i32 = 12
    let v13: i32 = 13
    let v14: i32 = 14
    let v15: i32 = 15
    let v16: i32 = 16
    let v17: i32 = 17
    let v18: i32 = 18
    let v19: i32 = 19
    let v20: i32 = 20
    let v21: i32 = 21
    let v22: i32 = 22
    let v23: i32 = 23
    let v24: i32 = 24
    let v25: i32 = 25
    let v26: i32 = 26
    let v27: i32 = 27
    let v28: i32 = 28
    let v29: i32 = 29
    let v30: i32 = 30
    let v31: i32 = 31
    let v32: i32 = 32
    let v33: i32 = 33
    let v34: i32 = 34
    let v35: i32 = 35
    let v36: i32 = 36
    let v37: i32 = 37
    let v38: i32 = 38
    let v39: i32 = 39
    let v40: i32 = 40
    let v41: i32 = 41
    let v42: i32 = 42
    let v43: i32 = 43
    let v44: i32 = 44
    let v45: i32 = 45
    let v46: i32 = 46
    let v47: i32 = 47
    let v48: i32 = 48
    let v49: i32 = 49
    let v50: i32 = 50
    let v51: i32 = 51
    let v52: i32 = 52
    let v53: i32 = 53
    let v54: i32 = 54
    let v55: i32 = 55
    let v56: i32 = 56
    let v57: i32 = 57
    let v58: i32 = 58
    let v59: i32 = 59
    let v60: i32 = 60
    let v61: i32 = 61
    let v62: i32 = 62
    let v63: i32 = 63
    let locals_sum: i32 = v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12 + v13 + v14 + v15 + v16 + v17 + v18 + v19 + v20 + v21 + v22 + v23 + v24 + v25 + v26 + v27 + v28 + v29 + v30 + v31 + v32 + v33 + v34 + v35 + v36 + v37 + v38 + v39 + v40 + v41 + v42 + v43 + v44 + v45 + v46 + v47 + v48 + v49 + v50 + v51 + v52 + v53 + v54 + v55 + v56 + v57 + v58 + v59 + v60 + v61 + v62 + v63
    if locals_sum != 2016 {
        return 2
    }

    # Thirty-two functions called from one expression:
    # sum over i of (1 + i) for i in 0..31 = 32 + 496 = 528.
    let calls_sum: i32 = f0(1) + f1(1) + f2(1) + f3(1) + f4(1) + f5(1) + f6(1) + f7(1) + f8(1) + f9(1) + f10(1) + f11(1) + f12(1) + f13(1) + f14(1) + f15(1) + f16(1) + f17(1) + f18(1) + f19(1) + f20(1) + f21(1) + f22(1) + f23(1) + f24(1) + f25(1) + f26(1) + f27(1) + f28(1) + f29(1) + f30(1) + f31(1)
    if calls_sum != 528 {
        return 3
    }

    if deep_if() != 0 {
        return 4
    }

    return 0
}
