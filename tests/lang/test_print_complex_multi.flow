# print/println of a complex value writes `(re + im j)`, and several
# arguments print separated by spaces, as on the Python host. flowc printed
# a complex as an integer and handed extra arguments to one printf (corpus
# parity: examples/rf).

function main() -> i32 {
    let z: c64 = c64(1.5, 0.0)
    println(z)
    let n: i32 = 3
    let x: f64 = 2.5
    println(n, x)
    return 0
}
