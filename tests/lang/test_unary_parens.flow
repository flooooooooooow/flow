# Flow-native language test: a unary operator applies to its whole operand.
# `!(x < 0)` once compiled to `(!x < 0)` in C (#1017). Every unary operator
# (`!`, `not`, `-`, `~`) is applied here to a parenthesised use of every
# binary operator, and to nested unary and cast operands, and the result is
# compared with a value computed another way.
# Exit 0 on success; a nonzero exit identifies the failing check.

function main() -> i32 {
    let a: i32 = 6
    let b: i32 = 3
    let z: i32 = 0 - 4
    let t: bool = true
    let f: bool = false

    # `-` and `~` over the arithmetic and bitwise operators (~v == -v - 1).
    let add: i32 = a + b
    if -(a + b) != 0 - add { return 1 }
    if ~(a + b) != 0 - add - 1 { return 2 }
    let sub: i32 = a - b
    if -(a - b) != 0 - sub { return 3 }
    if ~(a - b) != 0 - sub - 1 { return 4 }
    let mul: i32 = a * b
    if -(a * b) != 0 - mul { return 5 }
    if ~(a * b) != 0 - mul - 1 { return 6 }
    let div: i32 = a / b
    if -(a / b) != 0 - div { return 7 }
    if ~(a / b) != 0 - div - 1 { return 8 }
    let rem: i32 = a % 4
    if -(a % 4) != 0 - rem { return 9 }
    if ~(a % 4) != 0 - rem - 1 { return 10 }
    let band: i32 = a & b
    if -(a & b) != 0 - band { return 11 }
    if ~(a & b) != 0 - band - 1 { return 12 }
    let bor: i32 = a | b
    if -(a | b) != 0 - bor { return 13 }
    if ~(a | b) != 0 - bor - 1 { return 14 }
    let bxor: i32 = a ^ b
    if -(a ^ b) != 0 - bxor { return 15 }
    if ~(a ^ b) != 0 - bxor - 1 { return 16 }
    let shl: i32 = a << 2
    if -(a << 2) != 0 - shl { return 17 }
    if ~(a << 2) != 0 - shl - 1 { return 18 }
    let shr: i32 = a >> 1
    if -(a >> 1) != 0 - shr { return 19 }
    if ~(a >> 1) != 0 - shr - 1 { return 20 }

    # `!` and `not` over the comparison and logical operators.
    if !(z < 0) { return 21 }
    if not (z < 0) { return 22 }
    if !(a <= b) != true { return 23 }
    if !(a > b) { return 24 }
    if !(a >= b) { return 25 }
    if !(a == 6) { return 26 }
    if !(a != b) { return 27 }
    if !(t and t) { return 28 }
    if !(t or f) { return 29 }
    if !(f and t) != true { return 30 }
    if not (f or f) != true { return 31 }

    # A negated comparison inside a larger expression.
    let ok: bool = !(z < 0) or a > b
    if !ok { return 32 }
    if !(z < 0) == true { return 33 }
    let mut hits: i32 = 0
    while !(hits >= 3) {
        hits = hits + 1
    }
    if hits != 3 { return 34 }

    # Nested unary operators and casts as operands.
    if -(-a) != a { return 35 }
    if ~(~a) != a { return 36 }
    if !(!t) != t { return 37 }
    if -(a as i64) != (0 - 6) as i64 { return 38 }
    if -(-(a - b)) != sub { return 39 }
    if -a * -b != 18 { return 40 }
    return 0
}
