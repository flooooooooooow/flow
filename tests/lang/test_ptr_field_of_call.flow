# Flow-native language test: a field read on a pointer that a call or a
# cast returns reads through the pointer (#1065). flowc used to emit `.`
# where C needs `->`.
# Exit 0 on success; a nonzero exit identifies the failing check.

extern {
    function malloc(size: i64) -> ptr<void>
}

struct Pair {
    a: i32,
    b: i32
}

function make_pair(a: i32, b: i32) -> ptr<Pair> {
    let p: ptr<Pair> = malloc(8) as ptr<Pair>
    p.a = a
    p.b = b
    return p
}

function main() -> i32 {
    if make_pair(3, 4).a != 3 {
        return 1
    }
    if make_pair(3, 4).b != 4 {
        return 2
    }
    let raw: ptr<void> = make_pair(5, 6) as ptr<void>
    if (raw as ptr<Pair>).b != 6 {
        return 3
    }
    return 0
}
