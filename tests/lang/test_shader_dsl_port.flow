# Test for compiler/src/shader_dsl.flow, the FSL port (#683).
# Byte parity with the retired Python lives in
# compiler/scripts/parity_shader_dsl.sh; this checks the Flow API.
# Run with: ./flow run tests/lang/test_shader_dsl_port.flow

import "compiler/src/shader_dsl.flow"

extern {
    function puts(s: string) -> i32
    function strlen(s: string) -> i64
}

# 1 when `needle` occurs in w[0..len).
function has(w: ptr<ShBuf>, needle: string) -> i32 {
    let np: ptr<u8> = needle
    let n: i32 = strlen(needle) as i32
    let mut i: i32 = 0
    while i + n <= w[0].len {
        let mut k: i32 = 0
        while k < n and w[0].buf[i + k] == np[k] {
            k = k + 1
        }
        if k == n {
            return 1
        }
        i = i + 1
    }
    return 0
}

function same(w: ptr<ShBuf>, want: string) -> i32 {
    if strlen(want) as i32 != w[0].len {
        return 0
    }
    return has(w, want)
}

function ctx_for(src: string) -> ptr<ShCtx> {
    let c: ptr<ShCtx> = flowc_shader_ctx_new(src as ptr<u8>, strlen(src) as i32)
    flowc_shader_extract(c)
    return c
}

function main() -> i32 {
    let good: string = "fn half(x: f32) -> f32 {\n    return x * 0.5\n}\nshader fill a {\n    color = vec4(half(uv.x))\n}\n"
    let bad: string = "shader fill b {\n    let u = uv.x\n}\n"
    let quoted: string = "let s: string = \"shader fill q { }\"\n"

    if flowc_shader_is_module(good as ptr<u8>, strlen(good) as i32) != 1 {
        puts("FAIL: fill head not detected")
        return 1
    }
    if flowc_shader_is_module(quoted as ptr<u8>, strlen(quoted) as i32) != 0 {
        puts("FAIL: a head inside a string counted")
        return 2
    }

    let c: ptr<ShCtx> = ctx_for(good)
    if flowc_shader_ctx_err(c) != 0 or flowc_shader_fill_count(c) != 1 {
        puts("FAIL: extract")
        return 3
    }
    let m: ptr<ShBuf> = flowc_shader_buf_new(64)
    if flowc_shader_gen(c, m, SH_METAL, null, 0 - 1, 0 - 1) != 0 {
        puts("FAIL: metal gen")
        return 4
    }
    if has(m, "static inline float half(float x) {\n    return (x * 0.5);\n}\n") == 0 {
        puts("FAIL: metal helper")
        return 5
    }
    if has(m, "fragment float4 a_frag(") == 0 or has(m, "    color = float4(half(uv.x));\n") == 0 {
        puts("FAIL: metal fill")
        return 6
    }
    let w: ptr<ShBuf> = flowc_shader_buf_new(64)
    if flowc_shader_gen(c, w, SH_WGSL, null, 0 - 1, 0 - 1) != 0 {
        puts("FAIL: wgsl gen")
        return 7
    }
    if has(w, "fn half(x: f32) -> f32 {") == 0 or has(w, "    color = vec4<f32>(half(uv.x));\n") == 0 {
        puts("FAIL: wgsl output")
        return 8
    }

    let e: ptr<ShCtx> = ctx_for(bad)
    let o: ptr<ShBuf> = flowc_shader_buf_new(64)
    if flowc_shader_gen(e, o, SH_WGSL, null, 0 - 1, 0 - 1) == 0 {
        puts("FAIL: missing color accepted")
        return 9
    }
    if same(flowc_shader_ctx_msg(e), "shader fill 'b' must assign `color = ...`") == 0 {
        puts("FAIL: missing color message")
        return 10
    }

    let buf: ptr<ShBuf> = flowc_shader_buf_new(256)
    let gp: ptr<u8> = good
    let gn: i32 = strlen(good) as i32
    let mut i: i32 = 0
    while i < gn {
        flowc_shader_putc(buf, gp[i])
        i = i + 1
    }
    let n: i32 = flowc_shader_expand_in_place(buf[0].buf, buf[0].len, buf[0].cap)
    buf[0].len = n
    if same(buf, "function main() -> i32 {\n    return 0\n}\n") == 0 {
        puts("FAIL: host stub")
        return 11
    }

    flowc_shader_ctx_free(c)
    flowc_shader_ctx_free(e)
    flowc_shader_buf_free(m)
    flowc_shader_buf_free(w)
    flowc_shader_buf_free(o)
    flowc_shader_buf_free(buf)
    puts("All shader_dsl port tests passed")
    return 0
}
