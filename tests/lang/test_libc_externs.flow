# libc functions declared in `extern` compile against the C headers
# (#958, #969). Stage-A used to drop time()'s prototype with no header to
# supply it, and to emit clashing prototypes for atol, labs and friends.

extern {
    function time(t: ptr<i64>) -> i64
    function atol(s: string) -> i64
    function labs(v: i64) -> i64
}

function main() -> i32 {
    let now: i64 = time(null)
    if now <= 0 {
        return 1
    }
    if atol("42") != 42 or labs(0 - 7) != 7 {
        return 2
    }
    if atol("-3") != 0 - 3 {
        return 3
    }
    return 0
}
