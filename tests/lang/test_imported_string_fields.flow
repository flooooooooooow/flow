# Regression: string fields from an imported pointer result concatenate as strings.

import std.process { ProcResult, proc_run, proc_sh }

function main() -> i32 {
    let r: ptr<ProcResult> = proc_run(proc_sh("printf hi"))
    let both: string = r.stdout + r.stderr
    if both == "hi" {
        return 0
    }
    return 1
}
