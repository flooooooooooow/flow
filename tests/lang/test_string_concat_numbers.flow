# String `+` with a numeric or bool operand formats the number (#946), and
# println picks its conversion from the argument's type (#948).
# Supersedes tests/integration/test_cast_in_string_concat.py
# ::test_numeric_casts_still_format_as_numbers and
# ::test_concatenating_a_wide_numeric_type_is_still_a_string.
# The printed lines are checked by test_string_concat_numbers.expected.

extern {
    function strcmp(a: string, b: string) -> i32
}

function name() -> string {
    return "flow"
}

function main() -> i32 {
    let v: i64 = 42
    let f: f64 = 1.5
    let u: u32 = 7
    let x: f64 = 3.75
    let n: i32 = 42
    if strcmp("i64=" + v, "i64=42") != 0 {
        return 1
    }
    if strcmp("f64=" + f, "f64=1.500000") != 0 {
        return 2
    }
    if strcmp("u32=" + u, "u32=7") != 0 {
        return 3
    }
    if strcmp("int=" + (n as i64), "int=42") != 0 {
        return 4
    }
    if strcmp("trunc=" + (x as i32), "trunc=3") != 0 {
        return 5
    }
    if strcmp(v + "=v", "42=v") != 0 {
        return 6
    }
    if strcmp("big=" + (n > 3), "big=true") != 0 {
        return 7
    }
    let s: string = "hello " + name()
    if strcmp(s, "hello flow") != 0 {
        return 8
    }
    println(s)
    println("a " + name())
    println("i64=" + v)
    println("u32=" + u)
    println(v)
    println(n)
    return 0
}
