# Flow-native language test: tail-resumptive effect handlers (#564).
#
# A capability method is an ordinary call. Returning from it resumes the
# operation site exactly once. This program pins that:
#
#   - two Probe.mark calls in one handle block both run
#   - each return value is the call-site result
#   - a status-code "abort" still returns to the caller (no jump)
#   - retry is a loop in the caller plus a policy effect
#
# Exit 0 on success; a nonzero exit identifies the failing check.

effect Probe {
    mark(x: i32) -> i32,
}

effect Gate {
    allow(n: i32) -> i32,
}

effect Retry {
    should_retry(attempt: i32, max_attempts: i32) -> i32,
}

let mut hits: i32 = 0

capability PlusOne {
    effect Probe,
    function mark(x: i32) -> i32 {
        hits = hits + 1
        return x + 1
    },
}

capability Closed {
    effect Gate,
    function allow(n: i32) -> i32 {
        return 0 - 1
    },
}

capability LinearRetry {
    effect Retry,
    function should_retry(attempt: i32, max_attempts: i32) -> i32 {
        if attempt < max_attempts {
            return 1
        }
        return 0
    },
}

function main() -> i32 {
    let mut n: i32 = 0
    handle Probe with PlusOne {
        n = Probe.mark(n)
        n = Probe.mark(n)
    }
    if n != 2 {
        return 1
    }
    if hits != 2 {
        return 2
    }

    let mut after_gate: i32 = 0
    handle Gate with Closed {
        let code: i32 = Gate.allow(1)
        if code >= 0 {
            return 3
        }
        after_gate = 1
    }
    if after_gate != 1 {
        return 4
    }

    let mut attempt: i32 = 0
    let mut last: i32 = 0
    handle Retry with LinearRetry {
        while attempt < 3 {
            last = attempt
            if Retry.should_retry(attempt, 2) == 0 {
                attempt = 99
            } else {
                attempt = attempt + 1
            }
        }
    }
    if last != 2 {
        return 5
    }
    return 0
}
