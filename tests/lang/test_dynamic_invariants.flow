# Flow-native tests for compiler/src/dynamic_invariants.flow.
# Exit 0 on success; nonzero identifies the failing check.

import "compiler/src/dynamic_invariants.flow"

extern {
    function puts(s: string) -> i32
}

function main() -> i32 {
    let mut stride: FlowcDynScalar = flowc_dyn_scalar_new(1)
    flowc_dyn_scalar_observe(&stride, 16)
    flowc_dyn_scalar_observe(&stride, 20)
    flowc_dyn_scalar_observe(&stride, 24)
    flowc_dyn_scalar_observe(&stride, 28)

    if stride.samples != 4 {
        return 1
    }
    if stride.min_value != 16 or stride.max_value != 28 {
        return 2
    }
    if flowc_dyn_scalar_is_constant(stride, 4) != 0 {
        return 3
    }
    if flowc_dyn_scalar_is_nonzero(stride, 4) != 1 {
        return 4
    }
    if flowc_dyn_scalar_is_positive(stride, 4) != 1 {
        return 5
    }
    if flowc_dyn_scalar_congruence_mod(stride, 4) != 4 {
        return 6
    }
    if flowc_dyn_scalar_alignment(stride, 4) != 4 {
        return 7
    }

    # Minimum support matters: observations are not promoted too early.
    if flowc_dyn_scalar_is_positive(stride, 5) != 0 {
        return 8
    }

    let mut constant: FlowcDynScalar = flowc_dyn_scalar_new(2)
    flowc_dyn_scalar_observe(&constant, 7)
    flowc_dyn_scalar_observe(&constant, 7)
    flowc_dyn_scalar_observe(&constant, 7)
    if flowc_dyn_scalar_is_constant(constant, 3) != 1 {
        return 9
    }
    if flowc_dyn_scalar_congruence_mod(constant, 3) != 0 {
        return 10
    }

    let mut signed_values: FlowcDynScalar = flowc_dyn_scalar_new(3)
    flowc_dyn_scalar_observe(&signed_values, -8)
    flowc_dyn_scalar_observe(&signed_values, -4)
    flowc_dyn_scalar_observe(&signed_values, 0)
    if flowc_dyn_scalar_is_nonpositive(signed_values, 3) != 1 {
        return 11
    }
    if flowc_dyn_scalar_is_nonzero(signed_values, 3) != 0 {
        return 12
    }
    if flowc_dyn_scalar_alignment(signed_values, 3) != 4 {
        return 13
    }

    let mut ordered: FlowcDynPair = flowc_dyn_pair_new(10, 11)
    flowc_dyn_pair_observe(&ordered, 1, 2)
    flowc_dyn_pair_observe(&ordered, 3, 4)
    flowc_dyn_pair_observe(&ordered, 5, 6)
    if flowc_dyn_pair_is_less(ordered, 3) != 1 {
        return 14
    }
    if flowc_dyn_pair_is_less_equal(ordered, 3) != 1 {
        return 15
    }
    if flowc_dyn_pair_is_equal(ordered, 3) != 0 {
        return 16
    }

    let mut same: FlowcDynPair = flowc_dyn_pair_new(20, 21)
    flowc_dyn_pair_observe(&same, -2, -2)
    flowc_dyn_pair_observe(&same, 0, 0)
    flowc_dyn_pair_observe(&same, 9, 9)
    if flowc_dyn_pair_is_equal(same, 3) != 1 {
        return 17
    }
    if flowc_dyn_pair_is_not_equal(same, 3) != 0 {
        return 18
    }

    # Empirical candidates cannot silently become compiler facts.
    if flowc_dyn_optimization_mode(1, 0, 0) != FLOWC_DYN_USE_NONE {
        return 19
    }
    if flowc_dyn_optimization_mode(1, 0, 1) != FLOWC_DYN_USE_GUARDED {
        return 20
    }
    if flowc_dyn_optimization_mode(1, 1, 0) != FLOWC_DYN_USE_PROVEN {
        return 21
    }
    if flowc_dyn_optimization_mode(0, 1, 1) != FLOWC_DYN_USE_NONE {
        return 22
    }

    # Full signed range magnitude/distance must not overflow signed i64.
    if flowc_dyn_i64_magnitude(-9223372036854775807 - 1) != 9223372036854775808 {
        return 23
    }
    if flowc_dyn_i64_distance(-9223372036854775807 - 1, 9223372036854775807) != 18446744073709551615 {
        return 24
    }

    puts("dynamic invariant discovery tests passed")
    return 0
}
