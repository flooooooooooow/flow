# Two imported modules each define a private function `_same`; both keep
# their own definition (#950).
# Supersedes tests/integration/test_private_function_module_collision.py.

import "tests/fixtures/module_collision/module_a.flow"
import "tests/fixtures/module_collision/module_b.flow"

function main() -> i32 {
    return module_a_value() + module_b_value() - 42
}
