# The complex constructors and <complex.h> functions are known builtins
# (#942). Supersedes tests/unit/test_complex_types.py::test_complex_compile_and_run.

function main() -> i32 {
    let z: c64 = c64(3.0, 4.0)
    let w: c64 = c64(1.0, 2.0)
    let s: c64 = z + w
    let mag: f64 = cabs(z)
    if mag < 4.9 or mag > 5.1 {
        return 1
    }
    if creal(s) < 3.9 or creal(s) > 4.1 {
        return 2
    }
    if cimag(s) < 5.9 or cimag(s) > 6.1 {
        return 3
    }
    let d: c128 = c128(0.0, 2.0)
    if cabs(d) < 1.9 or cabs(d) > 2.1 {
        return 4
    }
    return 0
}
