# Flow-native language test: a span borrow evaluates its source once.
#
# Narrowing `span<mut T>` to `span<T>` reads the source span's pointer and its
# length. The initializer expression was inlined into both reads, so a side
# effect in it happened twice (#623). The mut-to-mut case was always correct
# and is checked alongside, as is a reassignment of a narrowed span.
#
# Supersedes (behavioral parts of):
#   tests/unit/test_span_narrowing_evaluates_once.py::test_each_borrow_calls_its_initializer_once
# Exit 0 on success; a nonzero exit identifies the failing check.

extern {
    function malloc(size: i64) -> ptr<void>
}

function make_mut(n: i32, calls: ptr<i32>) -> span<mut f64> {
    calls[0] = calls[0] + 1
    let raw: ptr<f64> = malloc(n as i64 * 8)
    return raw[0..n]
}

function main() -> i32 {
    let c: ptr<i32> = malloc(4)
    c[0] = 0
    let a: span<mut f64> = make_mut(3, c)
    if c[0] != 1 {
        return 1
    }
    c[0] = 0
    let d: span<f64> = make_mut(3, c)
    if c[0] != 1 {
        return 2
    }
    c[0] = 0
    let mut e: span<f64> = make_mut(3, c)
    e = make_mut(3, c)
    if c[0] != 2 {
        return 3
    }
    if a.len != 3 or d.len != 3 or e.len != 3 {
        return 4
    }
    return 0
}
