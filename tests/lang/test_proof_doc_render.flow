# Proof documents on flowc (compiler/src/proof_doc.flow): parse a theorem
# file and render its English and LaTeX documents.
# Exit 0 on success, or the number of the first failed check.

import "compiler/src/proof_doc.flow"

extern {
    function strstr(hay: string, needle: string) -> string
    function strcmp(a: string, b: string) -> i32
    function printf(fmt: string, ...) -> i32
}

function has(text: string, needle: string) -> i32 {
    if strstr(text, needle) == null {
        printf("missing: %s\n", needle)
        return 0
    }
    return 1
}

function main() -> i32 {
    let src: string = "# @means  Squaring any integer gives zero or a positive number.\n# @tier   derived\n\ntheorem «Int» «multiplication» «squaring never yields a negative» (n: i32) {\n    let sq = n * n\n    therefore sq >= 0 by smt\n}\n"
    let mut d: PdgDoc = flowc_proof_parse_text(src)
    if d.nthm != 1 { return 1 }
    if strcmp(d.thms[0].claim_expr, "sq >= 0") != 0 { return 2 }
    if strcmp(d.thms[0].params, "n: i32") != 0 { return 3 }
    d.thms[0].number = 1
    let mut tiers: PdgMap = flowc_pdg_map_new(8)
    let md: string = flowc_proof_render_md(&d, "square", &tiers)
    if has(md, "# square\n") == 0 { return 4 }
    if has(md, "## Derived fact 1: Squaring any integer gives zero or a positive number") == 0 { return 5 }
    if has(md, "**Coordinate.** the integers · multiplication · squaring never yields a negative · **Derived fact**") == 0 { return 6 }
    if has(md, "> $$\\forall n \\in \\mathbb{Z}\\quad sq \\ge 0$$") == 0 { return 7 }
    if has(md, "| ② | Let sq = n * n. |  |  |") == 0 { return 8 }
    if has(md, "| ③ | From step 2, this implies sq is at least 0. Hence proven. | ③ | $sq \\ge 0$ |") == 0 { return 9 }
    let tex: string = flowc_proof_render_tex(&d, "square", &tiers)
    if has(tex, "\\title{Flow Proof Artifact: square}") == 0 { return 10 }
    if has(tex, "\\label{thm:Int-multiplication-squaring_never_yields_a_negative}") == 0 { return 11 }
    return 0
}
