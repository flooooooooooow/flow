# Flow-native language test: method calls on a by-value struct across modules.
# `c.bump(2)` where `bump(c: ptr<Counter>, by: i32)` lives in another module
# passes `&c`, as the Python host's method-call lowering does, so the call
# updates the caller's struct.
# Exit 0 on success; a nonzero exit identifies the failing check.

import "tests/fixtures/method_recv/counter.flow"

function main() -> i32 {
    let mut c: Counter = counter_new()
    if c.bump(2) != 2 {
        return 1
    }
    if c.bump(3) != 5 {
        return 2
    }
    if c.value() != 5 {
        return 3
    }
    if c.n != 5 {
        return 4
    }
    return 0
}
