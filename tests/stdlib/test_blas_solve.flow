import "stdlib/blas.flow"

function main() -> i32 {
    let A: Mat = mat_new(3, 3)
    mat_set(A, 0, 0, 2.0)
    mat_set(A, 0, 1, -1.0)
    mat_set(A, 0, 2, 0.0)
    mat_set(A, 1, 0, -1.0)
    mat_set(A, 1, 1, 2.0)
    mat_set(A, 1, 2, -1.0)
    mat_set(A, 2, 0, 0.0)
    mat_set(A, 2, 1, -1.0)
    mat_set(A, 2, 2, 2.0)
    
    let b: Mat = mat_new(3, 1)
    mat_set(b, 0, 0, 1.0)
    mat_set(b, 1, 0, 0.0)
    mat_set(b, 2, 0, 1.0)
    
    let x: Mat = mat_new(3, 1)
    let info: i32 = solve(A, b.data, x.data)
    
    if info != 0 {
        return 1
    }
    
    let diff0: f64 = mat_get(x, 0, 0) - 1.0
    let diff1: f64 = mat_get(x, 1, 0) - 1.0
    let diff2: f64 = mat_get(x, 2, 0) - 1.0
    
    if diff0 < 0.0001 {
        if diff0 > -0.0001 {
            if diff1 < 0.0001 {
                if diff1 > -0.0001 {
                    if diff2 < 0.0001 {
                        if diff2 > -0.0001 {
                            return 0
                        }
                    }
                }
            }
        }
    }
    return 1
}
