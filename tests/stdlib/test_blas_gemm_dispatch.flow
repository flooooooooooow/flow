import "stdlib/blas.flow"

extern {
    function printf(fmt: string, val: f64) -> i32
}

function main() -> i32 {
    let A: Mat = mat_new(2, 2)
    mat_set(A, 0, 0, 1.0)
    mat_set(A, 0, 1, 2.0)
    mat_set(A, 1, 0, 3.0)
    mat_set(A, 1, 1, 4.0)

    let B: Mat = mat_new(2, 1)
    mat_set(B, 0, 0, 1.0)
    mat_set(B, 1, 0, 2.0)

    let C: Mat = mat_new(2, 1)
    gemm(A, B, C)

    if mat_get(C, 0, 0) == 5.0 {
        if mat_get(C, 1, 0) == 11.0 {
            return 0
        }
    }
    return 1
}
