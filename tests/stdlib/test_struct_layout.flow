# Test proper struct memory layout and field access

struct Point {
    x: f32
    y: f32
}

struct Rectangle {
    top_left: Point
    width: i32
    height: i32
}

function create_point(x: f32, y: f32) -> Point {
    return Point { x: x, y: y }
}

function create_rectangle(x: f32, y: f32, w: i32, h: i32) -> Rectangle {
    let p: Point = create_point(x, y)
    return Rectangle { top_left: p, width: w, height: h }
}

function main() -> i32 {
    # Create a rectangle
    let rect: Rectangle = create_rectangle(10.5, 20.5, 100, 200)
    
    # Access fields
    let w: i32 = rect.width
    let h: i32 = rect.height
    
    # Access nested fields
    let x: f32 = rect.top_left.x
    let y: f32 = rect.top_left.y
    
    # Print values to verify
    printf("Rectangle: (%.1f, %.1f) %dx%d\n", x, y, w, h)
    
    # Return area
    return w * h
}
