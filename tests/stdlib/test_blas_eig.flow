import "stdlib/blas.flow"
import "stdlib/posix.flow"

function main() -> i32 {
    let A: Mat = mat_new(3, 3)
    # A = [1 2 3; 0 4 5; 0 0 6] -> transposed [1 0 0; 2 4 0; 3 5 6]
    A.data[0] = 1.0
    A.data[1] = 0.0
    A.data[2] = 0.0
    A.data[3] = 2.0
    A.data[4] = 4.0
    A.data[5] = 0.0
    A.data[6] = 3.0
    A.data[7] = 5.0
    A.data[8] = 6.0

    let wr: ptr<f64> = malloc(24) as ptr<f64>
    let wi: ptr<f64> = malloc(24) as ptr<f64>

    let info: i32 = geev(A, wr, wi, null)

    if info != 0 {
        return 1
    }

    let diff_wr0: f64 = wr[0] - 1.0
    if diff_wr0 > 0.0001 { return 1 }
    if diff_wr0 < -0.0001 { return 1 }

    let diff_wr1: f64 = wr[1] - 4.0
    if diff_wr1 > 0.0001 { return 1 }
    if diff_wr1 < -0.0001 { return 1 }

    let diff_wr2: f64 = wr[2] - 6.0
    if diff_wr2 > 0.0001 { return 1 }
    if diff_wr2 < -0.0001 { return 1 }

    free(wr as ptr<void>)
    free(wi as ptr<void>)
    mat_free(A)
    return 0
}
