# Audio Graph Scheduler Test

import "stdlib/audio.flow"
import "stdlib/audio/graph_scheduler.flow"

function test_gain_node() -> bool {
    let rate: SampleRate = sample_rate_48000()
    let buf: AudioBufferF32 = audio_buffer_alloc_f32(4, 2, layout_interleaved())
    let mut i: i32 = 0
    while i < 4 {
        audio_buffer_set_f32(buf, i, 0, 1.0)
        audio_buffer_set_f32(buf, i, 1, 1.0)
        i = i + 1
    }

    let nodes: array<AudioNode, 32> = [
        audio_node_default(), audio_node_default(), audio_node_default(), audio_node_default(),
        audio_node_default(), audio_node_default(), audio_node_default(), audio_node_default(),
        audio_node_default(), audio_node_default(), audio_node_default(), audio_node_default(),
        audio_node_default(), audio_node_default(), audio_node_default(), audio_node_default(),
        audio_node_default(), audio_node_default(), audio_node_default(), audio_node_default(),
        audio_node_default(), audio_node_default(), audio_node_default(), audio_node_default(),
        audio_node_default(), audio_node_default(), audio_node_default(), audio_node_default(),
        audio_node_default(), audio_node_default(), audio_node_default(), audio_node_default()
    ]
    let g: AudioGraph = audio_graph_init(rate, nodes)
    let g1: AudioGraph = audio_graph_add_gain(g, -6.0)
    let g2: AudioGraph = audio_graph_process_interleaved(g1, buf, 4)

    let v: f32 = audio_buffer_get_f32(buf, 0, 0)
    audio_buffer_free_f32(buf)
    if v < 0.45 { return false }
    if v > 0.6 { return false }
    return g2.count == 1
}

function main() -> i32 {
    let mut passed: i32 = 0
    let mut failed: i32 = 0
    printf("=== Audio Graph Scheduler Tests ===\n\n")

    if test_gain_node() { printf("✓ gain_node\n"); passed = passed + 1 }
    else { printf("✗ gain_node\n"); failed = failed + 1 }

    printf("\nPassed: %d\n", passed)
    printf("Failed: %d\n", failed)
    if failed > 0 { return 1 }
    return 0
}
