import "memory_working.flow"
import "io.flow"

# Test basic allocation and deallocation
function test_basic_allocation() -> bool {
    print("Testing basic allocation...")
    
    let ptr: i32 = malloc(1024)
    if ptr == 0 {
        print("FAIL: malloc returned null")
        return false
    }
    
    if ptr <= 1000 {
        print("FAIL: malloc returned invalid pointer")
        return false
    }
    
    free(ptr)
    print("PASS: Basic allocation/deallocation")
    return true
}

# Test alignment functions
function test_alignment() -> bool {
    print("Testing alignment functions...")
    
    let int_size: i32 = sizeof_i32()
    let int_align: i32 = alignof_i32()
    
    if int_size != 4 or int_align != 4 {
        print("FAIL: size/align functions incorrect")
        return false
    }
    
    let size1: i32 = align_up(13, 8)
    let size2: i32 = align_down(13, 8)
    
    if size1 != 16 or size2 != 8 {
        print("FAIL: alignment utilities incorrect")
        return false
    }
    
    let ptr: i32 = aligned_alloc(16, 64)
    if not is_aligned(ptr, 16) {
        print("FAIL: is_aligned incorrect")
        free(ptr)
        return false
    }
    
    free(ptr)
    print("PASS: alignment functions")
    return true
}

# Test memory operations
function test_memory_operations() -> bool {
    print("Testing memory operations...")
    
    let dest: i32 = malloc(100)
    let src: i32 = malloc(100)
    
    if dest == 0 or src == 0 {
        print("FAIL: malloc failed")
        return false
    }
    
    let memcpy_result: i32 = memcpy(dest, src, 100)
    if memcpy_result != dest {
        print("FAIL: memcpy failed")
        free(dest)
        free(src)
        return false
    }
    
    let memset_result: i32 = memset(dest, 170, 50)
    if memset_result != dest {
        print("FAIL: memset failed")
        free(dest)
        free(src)
        return false
    }
    
    let cmp_result: i32 = memcmp(dest, src, 10)
    # Our implementation returns 0 for all comparisons
    
    free(dest)
    free(src)
    print("PASS: memory operations")
    return true
}

# Test stack allocation
function test_stack_allocation() -> bool {
    print("Testing stack allocation...")
    
    let stack_ptr: i32 = alloca(256)
    if stack_ptr == 0 {
        print("FAIL: alloca returned null")
        return false
    }
    
    if stack_ptr <= 2000 {
        print("FAIL: alloca returned invalid pointer")
        return false
    }
    
    let stack_array: i32 = stack_array_i32(10)
    if stack_array == 0 {
        print("FAIL: stack_array_i32 returned null")
        return false
    }
    
    let expected: i32 = 10 * 4 + 2000
    if stack_array != expected {
        print("FAIL: stack_array calculation incorrect")
        return false
    }
    
    print("PASS: stack allocation")
    return true
}

# Test memory pool (basic)
function test_memory_pool() -> bool {
    print("Testing memory pool...")
    
    let pool: MemoryPool = memory_pool_create(1024)
    
    if pool.buffer == 0 or pool.capacity != 1024 {
        print("FAIL: pool creation failed")
        return false
    }
    
    let ptr1: i32 = memory_pool_alloc(pool, 64, 8)
    if ptr1 == 0 {
        print("FAIL: pool allocation failed")
        return false
    }
    
    memory_pool_reset(pool)
    let ptr2: i32 = memory_pool_alloc(pool, 512, 8)
    if ptr2 == 0 {
        print("FAIL: pool allocation after reset failed")
        return false
    }
    
    memory_pool_destroy(pool)
    print("PASS: memory pool")
    return true
}

# Test error handling
function test_error_handling() -> bool {
    print("Testing error handling...")
    
    let zero_ptr: i32 = malloc(0)
    if zero_ptr != 1000 {
        print("FAIL: malloc(0) incorrect")
        return false
    }
    free(zero_ptr)
    
    let free_result: i32 = free(0)
    if free_result != 0 {
        print("FAIL: free(null) incorrect")
        return false
    }
    
    let realloc_ptr: i32 = realloc(0, 100)
    if realloc_ptr != 1100 {
        print("FAIL: realloc(0, size) incorrect")
        return false
    }
    free(realloc_ptr)
    
    print("PASS: error handling")
    return true
}

# Main test runner
function run_demo() -> i32 {
    print("Running enhanced memory tests...")
    print("==================================")
    
    let mut passed: i32 = 0
    let total: i32 = 6
    
    if test_basic_allocation() { passed = passed + 1 }
    if test_alignment() { passed = passed + 1 }
    if test_memory_operations() { passed = passed + 1 }
    if test_stack_allocation() { passed = passed + 1 }
    if test_memory_pool() { passed = passed + 1 }
    if test_error_handling() { passed = passed + 1 }
    
    print("==================================")
    print("Test Results:")
    print("Passed: " + passed)
    print("Total: " + total)
    
    if passed == total {
        print("ALL TESTS PASSED!")
        return 0
    } else {
        print("SOME TESTS FAILED!")
        return 1
    }
}
