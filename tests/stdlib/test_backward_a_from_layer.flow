# backward_a via layer.weights like dense2d_backward
import "stdlib/ml_nn.flow"

function main() -> i32 {
    let layer: Dense2D = dense2d_create(2, 2, 11)
    let input: Tensor = tensor_fill(1, 2, 1, 1, 1.0)
    let grad_out: Tensor = tensor_ones(1, 2, 1, 1)
    let grad_input: Tensor = tensor_matmul_backward_a(input, layer.weights, grad_out)
    if grad_input.dim0 != 1 { return 10 }
    if grad_input.dim1 != 2 { return 11 }
    return 0
}