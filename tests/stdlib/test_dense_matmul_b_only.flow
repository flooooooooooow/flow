import "stdlib/tensor.flow"
import "stdlib/ml_nn.flow"

function main() -> i32 {
    let layer: Dense2D = dense2d_create(2, 2, 11)
    let input: Tensor = tensor_fill(1, 2, 1, 1, 1.0)
    let grad_out: Tensor = tensor_ones(1, 2, 1, 1)
    let gw: Tensor = tensor_matmul_backward_b(input, layer.weights, grad_out)
    tensor_free(gw)
    tensor_free(input)
    tensor_free(grad_out)
    dense2d_free(layer)
    return 0
}