import "stdlib/ml_nn.flow"

function main() -> i32 {
    let layer: Dense2D = dense2d_create(2, 2, 11)
    let grad_out: Tensor = tensor_ones(1, 2, 1, 1)
    let grad_bias: Tensor = tensor_zeros(1, grad_out.dim1, 1, 1)
    for b in 0 to grad_out.dim0 {
        for j in 0 to grad_out.dim1 {
            let g: f32 = grad_out.data[b * grad_out.dim1 + j]
            let cur: f32 = grad_bias.data[j]
            grad_bias.data[j] = cur + g
        }
    }
    tensor_free(grad_bias)
    tensor_free(grad_out)
    dense2d_free(layer)
    return 0
}