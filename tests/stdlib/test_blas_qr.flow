import "stdlib/blas.flow"
import "stdlib/posix.flow"

function main() -> i32 {
    let A: Mat = mat_new(3, 3)
    # Define A in column-major for LAPACK
    # A = [1 2 3; 0 4 5; 0 0 6] -> transposed [1 0 0; 2 4 0; 3 5 6]
    A.data[0] = 12.0
    A.data[1] = 6.0
    A.data[2] = -4.0
    A.data[3] = -51.0
    A.data[4] = 167.0
    A.data[5] = 24.0
    A.data[6] = 4.0
    A.data[7] = -68.0
    A.data[8] = -41.0

    let tau: ptr<f64> = malloc(24) as ptr<f64>
    let info: i32 = geqrf(A, tau)

    if info != 0 {
        return 1
    }

    # Check elements of R (on and above diagonal in Fortran / col-major A)
    # In row-major A, the diagonals are A[0], A[4], A[8]
    # We should just check the first element of tau and some elements of A to verify it ran.
    let diff_tau0: f64 = tau[0] - 1.857143
    if diff_tau0 > 0.0001 { return 1 }
    if diff_tau0 < -0.0001 { return 1 }

    let diff_tau1: f64 = tau[1] - 1.993846
    if diff_tau1 > 0.0001 { return 1 }
    if diff_tau1 < -0.0001 { return 1 }

    let diff_A0: f64 = A.data[0] + 14.0
    if diff_A0 > 0.0001 { return 1 }
    if diff_A0 < -0.0001 { return 1 }

    let diff_A3: f64 = A.data[3] + 21.0
    if diff_A3 > 0.0001 { return 1 }
    if diff_A3 < -0.0001 { return 1 }

    free(tau as ptr<void>)
    mat_free(A)
    return 0
}
