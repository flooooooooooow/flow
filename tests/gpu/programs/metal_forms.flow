# Every statement and expression form the Metal emitter meets.
extern {
    function sqrtf(x: f32) -> f32
}

struct Pair {
    a: f32,
    b: f32
}

@gpu
function control(a: ptr<f32>, out: ptr<f32>, n: i32, flag: bool) -> void {
    let i: i32 = gpu_thread_id()
    let j = gpu_thread_id_x
    let mut acc: f32 = 0.0
    let mut k: i32 = 0
    let h: i32 = 0xff
    if i < n and flag {
        acc = acc + a[i]
    } elif i == n or not flag {
        acc = 1.5e3
    } elif !flag {
        acc = -acc
    } else {
        acc = 2.0
    }
    if i >= n {
        return
    }
    while k < 4 {
        k += 1
        acc *= 2.0
        continue
    }
    for s in 0 to n step 2 {
        acc = acc - 0.25
        break
    }
    for t in 1..10 {
        out[t] = out[t] / 3.0
    }
    out[i] = acc % 7.0
    gpu_barrier()
    gpu_sync()
    let lx: i32 = gpu_local_id_x
    let bx: i32 = gpu_block_id_y
    let g: i32 = gpu_grid_size
    let bs: i32 = gpu_block_size
    let z: i32 = gpu_thread_id_z
    let bi = gpu_block_id
    let li = gpu_local_id
}

@gpu
function exprs(p: array<i32>, q: array<f32, 4>, r: span<f32>, v: vec4<f32>, u: u32, big: i64, d: f64, w: u64, s: Pair) -> i32 {
    let x: i32 = p[0] << 2
    let y: i32 = (p[1] >> 1) & 3 | 4 ^ 5
    let c: f32 = q[0] as f32
    let pr: Pair = Pair { a: 1.0, b: 2.0 }
    let arr: array<i32, 3> = [1, 2, 3]
    let m: f32 = sqrtf(s.a)
    let e: i32 = ~x
    let t: bool = true
    let f: bool = false
    let neg: i32 = -(x + y)
    let uninit: f32
    let buf: ptr<f32>
    s.b = 3.0
    p[x] = p[y] + 1
    p[1] -= 1
    let ok: bool = x != y and x <= y or x > 1
    return x
}

@gpu
function empty_kernel() -> void {
}

@gpu
function calls(out: ptr<f32>, output: ptr<i32>, result_x: ptr<f32>, n: i32) -> void {
    let a: f32 = sin(1.0) + cos(2.0) + max(1.0, 2.0) + pow(2.0, 3.0)
    out[0] = a
    output[0] = helper(n, 2)
    result_x[0] = dbg a
}

function helper(a: i32, b: i32) -> i32 {
    return a + b
}

function main() -> i32 {
    return 0
}
