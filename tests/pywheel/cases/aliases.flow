# Type aliases resolve for the ABI check; constants are public or private.

type Meters = f64

const SCALE: f64 = 2.5
const _PRIVATE: i32 = 3

function scale(m: Meters) -> Meters {
    return m * SCALE
}

function plain(x: f64) -> f64 {
    return x * SCALE
}

function main() -> i32 {
    return 0
}
