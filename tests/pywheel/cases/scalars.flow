# Every scalar the Python ABI map knows, as parameters and results.

function add_i64(a: i64, b: i64) -> i64 {
    return a + b
}

function add_u32(a: u32, b: u32) -> u32 {
    return a + b
}

function add_u64(a: u64, b: u64) -> u64 {
    return a + b
}

function half(x: f32) -> f32 {
    return x / 2.0
}

function negate(b: bool) -> bool {
    return not b
}

function greet(name: string) -> string {
    return name
}

function mixed(a: i32, b: f64, c: bool, d: string) -> f64 {
    if c {
        return b
    }
    return b + (a as f64)
}

function nothing() -> void {
}

function main() -> i32 {
    return 0
}
