# Imported modules: their declarations join the program before export
# inference, as in the Python generator.

import "lib/helper.flow"
import "stdlib/checked_arith.flow"

function use_helper(x: i32) -> i32 {
    return helper_twice(x) + wrapping_add_i32(x, 1)
}

function main() -> i32 {
    return use_helper(1)
}
