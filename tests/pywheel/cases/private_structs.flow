# Private structs, empty structs and the records of anonymous fork blocks
# do not stop generation.

struct _Hidden {
    v: i32
}

struct Marker {
}

function twice(x: i32) -> i32 { return x * 2 }
function square(x: i32) -> i32 { return x * x }

function forked(n: i32) -> i32 {
    let s = n |> {
        doubled = twice,
        squared = square,
    }
    let t = n |> {
        doubled = twice,
        squared = square,
    }
    let u = n |> {
        only = square,
    }
    return s.doubled + t.squared + u.only
}

function main() -> i32 {
    return forked(2)
}
