# Pointers cross as opaque objects; arrays of scalars as objects; an
# array of an unknown element type and an unknown type are excluded.

function first(p: ptr<i32>) -> i32 {
    return p[0]
}

function opaque(p: ptr<void>) -> ptr<void> {
    return p
}

function sum4(xs: array<i32, 4>) -> i32 {
    return xs[0] + xs[1] + xs[2] + xs[3]
}

function firsts(ps: array<ptr<i32>, 2>) -> i32 {
    return ps[0][0]
}

function main() -> i32 {
    return 0
}
