# A public struct with fields stops generation with exit status 1. The
# Python generator stopped on it too ("cannot unpack non-iterable
# Parameter object"); the Flow tool names the struct instead.

struct Vec2 {
    x: f64,
    y: f64
}

function vec2_length(v: Vec2) -> f64 {
    return sqrt(v.x * v.x + v.y * v.y)
}

function main() -> i32 {
    return 0
}
