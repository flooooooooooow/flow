# Parity gate for `flow python` (tools/pywheel, the Flow port of the retired
# src/flow/python_generator.py).
#
# Each line of tests/pywheel/cases.txt is `ID PROGRAM [ARGS...]`. The gate
# copies tests/pywheel/cases/ to a scratch directory, runs
# `./flow python PROGRAM ARGS` there and compares with tests/pywheel/expected/ID/:
#
#   stdout.txt  stdout, byte for byte
#   stderr.txt  stderr, with the scratch directory written as @WORK@
#   rc.txt      the exit status
#   dist/       every file written under dist/, byte for byte; a missing
#               dist/ means nothing may be written. In a generated
#               MODULE_ext.c the line @FLOWC_C@ stands for the program's C,
#               which the gate takes from compiler/scripts/flowc_emit.sh, so a
#               change in flowc's output does not touch these goldens.
#
# The goldens were captured from the Python generator before it was deleted
# (see expected/README). python and python3 are stubs on PATH that log their
# arguments and fail. A --source run must not call them. The one wheel-mode
# case must call `python3 -m pip wheel` once (the setuptools build, the only
# step that uses Python) and then fall back to the source file, as the Python
# generator did when the wheel build failed.
#
# expected/package/ holds the setup.py (as setup.py.expect, so the Python
# ratchet does not count a golden as source) and pyproject.toml the tool
# writes for the wheel build.
#
# FLOW_PYWHEEL_SMOKE=1 also builds a real wheel with the system python3 and
# setuptools, installs it into the scratch directory and calls it.
#
# Usage: ./flow tool tests/pywheel/run.flow            check
#        ./flow tool tests/pywheel/run.flow --update   rewrite expected/ from the Flow tool

import "tools/flow_cli/sys.flow"
import "scripts/tools/lib/testrun.flow"
import std.process { ProcCmd, ProcStrs, proc_arg }

const MARK: string = "@FLOWC_C@"

# The program's C, as the tool embeds it.
function flowc_c(prog: string, c_out: string) -> i32 {
    let c: ptr<ProcCmd> = cmd(sl_of3("compiler/scripts/flowc_emit.sh", "--strict", prog))
    proc_arg(c, c_out)
    cmd_quiet(c)
    return run(c)
}

# Byte offset of the line that is exactly @FLOWC_C@, or -1.
function mark_at(t: string) -> i32 {
    if s_starts(t, MARK + "\n") or s_eq(t, MARK) {
        return 0
    }
    let mut from: i32 = 0
    while true {
        let at: i32 = s_find(t, "\n" + MARK, from)
        if at < 0 {
            return 0 - 1
        }
        let end: i32 = at + 1 + s_len(MARK)
        if end == s_len(t) or s_byte(t, end) == 10 {
            return at + 1
        }
        from = at + 1
    }
    return 0 - 1
}

# The template `tpl` with its @FLOWC_C@ line replaced by the C in `c`.
function expand_template(tpl: string, c: string) -> string {
    let t: string = read_text(tpl)
    let at: i32 = mark_at(t)
    if at < 0 {
        return t
    }
    let mut after: string = ""
    let rest: i32 = at + s_len(MARK) + 1
    if rest < s_len(t) {
        after = s_from(t, rest)
    }
    let mut body: string = s_slice(t, 0, at) + read_text(c) + after
    # The shell version trimmed one byte when the template has no final
    # newline; with nothing after the marker that byte came from the C.
    if s_len(after) == 0 and not s_ends(t, "\n") and s_len(body) > 0 {
        body = s_slice(body, 0, s_len(body) - 1)
    }
    return body
}

# The generated file `gen` with the program's C (`c`) replaced by @FLOWC_C@,
# for --update.
function make_template(gen: string, c: string) -> string {
    let g: string = read_text(gen)
    let n_c: i32 = s_len(read_text(c))
    let at: i32 = s_find(g, "/* ===== Flow compiled code ===== */", 0)
    let mut pre: i32 = s_find_byte(g, 10, at)
    if pre < 0 {
        pre = s_len(g)
    } else {
        pre = pre + 1
    }
    let mut tail_n: i32 = s_len(g) - pre - n_c
    if tail_n < 0 {
        tail_n = 0
    }
    return s_slice(g, 0, pre) + MARK + "\n" + s_from(g, s_len(g) - tail_n)
}

# `cd DIR && ls | sort | tr '\n' ' '`
function listing(dir: string) -> string {
    let l: ptr<ProcStrs> = list_dir(dir)
    sl_sort(l, false)
    let mut s: string = ""
    let mut i: i32 = 0
    while i < sl_len(l) {
        if not s_starts(sl_get(l, i), ".") {
            s = s + sl_get(l, i) + " "
        }
        i = i + 1
    }
    return s
}

function main() -> i32 {
    let root: string = tr_enter_root()
    let args0: ptr<ProcStrs> = tr_args()
    let update: bool = sl_len(args0) > 0 and s_eq(sl_get(args0, 0), "--update")
    let real_python: string = which("python3")
    let work: string = tr_workdir("flow-pywheel-gate")
    let stub_dir: string = work + "/bin"
    let log: string = work + "/python-calls.log"
    let _d: bool = mkdir_p(stub_dir)
    let _l: bool = write_text(log, "")
    tr_stub(stub_dir, "python", "echo \"python $*\" >> \"" + log + "\"\necho \"stub-python: no Python here\" >&2\nexit 1\n")
    tr_stub(stub_dir, "python3", "echo \"python3 $*\" >> \"" + log + "\"\necho \"stub-python: no Python here\" >&2\nexit 1\n")
    tr_path_prepend(stub_dir)
    env_unset("FLOW_PYTHON")
    let exp_root: string = "tests/pywheel/expected"

    let mut pass: i32 = 0
    let mut fail: i32 = 0
    let lines: ptr<ProcStrs> = s_lines(read_text("tests/pywheel/cases.txt"))
    let mut li: i32 = 0
    while li < sl_len(lines) {
        let line: string = sl_get(lines, li)
        li = li + 1
        if s_len(line) == 0 or s_starts(line, "#") {
            continue
        }
        let words: ptr<ProcStrs> = s_words(line)
        let id: string = sl_get(words, 0)
        let prog: string = sl_get(words, 1)
        let args: ptr<ProcStrs> = sl_tail(words, 2)
        let d: string = work + "/cases/" + id
        let _m: bool = mkdir_p(d)
        let _c: bool = tr_copy_tree("tests/pywheel/cases", d)
        let _t: bool = write_text(log, "")
        let pv: ptr<ProcStrs> = sl_of3(root + "/flow", "python", prog)
        sl_extend(pv, args)
        let rc: i32 = tr_run_files(pv, d, d + "/.stdout", d + "/.stderr")
        let errn: string = s_replace(s_replace(read_text(d + "/.stderr"), d, "@WORK@"), root, "@ROOT@")
        let _en: bool = write_text(d + "/.stderr.n", errn)
        let e: string = exp_root + "/" + id
        if update {
            rm_rf(e)
            let _me: bool = mkdir_p(e)
            let _a: bool = copy_file(d + "/.stdout", e + "/stdout.txt")
            let _b: bool = copy_file(d + "/.stderr.n", e + "/stderr.txt")
            let _r: bool = write_text(e + "/rc.txt", s_itoa(rc) + "\n")
            if is_dir(d + "/dist") {
                let _md: bool = mkdir_p(e + "/dist")
                let names: ptr<ProcStrs> = list_dir(d + "/dist")
                sl_sort(names, false)
                let mut k: i32 = 0
                while k < sl_len(names) {
                    let b: string = sl_get(names, k)
                    k = k + 1
                    if s_ends(b, "_ext.c") {
                        let _f: i32 = flowc_c(d + "/" + prog, work + "/" + id + ".c")
                        let _w: bool = write_text(e + "/dist/" + b, make_template(d + "/dist/" + b, work + "/" + id + ".c"))
                    } else {
                        let _cp: bool = copy_file(d + "/dist/" + b, e + "/dist/" + b)
                    }
                }
            }
            outln("UPDATED " + id)
            continue
        }
        let bad: ptr<ProcStrs> = sl_new()
        if not tr_same(d + "/.stdout", e + "/stdout.txt") {
            sl_push(bad, "stdout")
        }
        if not tr_same(d + "/.stderr.n", e + "/stderr.txt") {
            sl_push(bad, "stderr")
        }
        let want_rc: string = s_chomp_all(read_text(e + "/rc.txt"))
        if not s_eq(s_itoa(rc), want_rc) {
            sl_push(bad, "exit " + s_itoa(rc) + ", want " + want_rc)
        }
        if is_dir(e + "/dist") {
            if not is_dir(d + "/dist") {
                sl_push(bad, "no dist/")
            } else {
                let want: string = listing(e + "/dist")
                let have: string = listing(d + "/dist")
                if not s_eq(want, have) {
                    sl_push(bad, "dist files: " + have + ", want " + want)
                }
                let names: ptr<ProcStrs> = list_dir(e + "/dist")
                sl_sort(names, false)
                let mut k: i32 = 0
                while k < sl_len(names) {
                    let b: string = sl_get(names, k)
                    k = k + 1
                    if not is_file(d + "/dist/" + b) {
                        continue
                    }
                    let _f: i32 = flowc_c(d + "/" + prog, work + "/" + id + ".c")
                    let _w: bool = write_text(work + "/" + id + ".want", expand_template(e + "/dist/" + b, work + "/" + id + ".c"))
                    if not tr_same(work + "/" + id + ".want", d + "/dist/" + b) {
                        sl_push(bad, "dist/" + b)
                    }
                }
            }
        } elif is_dir(d + "/dist") {
            sl_push(bad, "wrote dist/")
        }
        let calls_text: string = read_text(log)
        let calls: i32 = tr_count_lines(calls_text)
        if sl_has(args, "--source") or rc != 0 {
            if calls != 0 {
                sl_push(bad, "called Python: " + tr_last_line(tr_head(calls_text, 1)))
            }
        } else {
            let mut wheel: bool = false
            let cl: ptr<ProcStrs> = s_lines(calls_text)
            let mut q: i32 = 0
            while q < sl_len(cl) {
                if s_starts(sl_get(cl, q), "python3 -m pip wheel . -w /") {
                    wheel = true
                }
                q = q + 1
            }
            if not wheel {
                sl_push(bad, "no pip wheel call")
            }
            if calls != 1 {
                sl_push(bad, s_itoa(calls) + " Python calls")
            }
        }
        if sl_len(bad) == 0 {
            pass = pass + 1
            outln("PASS " + id)
        } else {
            fail = fail + 1
            outln("FAIL " + id + ": " + sl_join(bad, " "))
            if sl_has(bad, "stdout") {
                out(tr_head(tr_diff("", e + "/stdout.txt", d + "/.stdout"), 20))
            }
            if sl_has(bad, "stderr") {
                out(tr_head(tr_diff("", e + "/stderr.txt", d + "/.stderr.n"), 20))
            }
        }
    }

    # setup.py and pyproject.toml for the wheel build.
    let pk: string = work + "/pkgwork"
    let _mp: bool = mkdir_p(pk)
    # The cases above built the tool (flow_native_tool).
    let mut tool: string = root + "/build/tools/flow-pywheel"
    if not is_exec(tool) {
        tool = env_or("XDG_CACHE_HOME", env("HOME") + "/.cache") + "/flow/tools/flow-pywheel"
    }
    let tv: ptr<ProcStrs> = sl_of3(tool, "mathlib.flow", "my_math")
    sl_extend(tv, s_words("2.0.0 package dist"))
    sl_push2(tv, pk, root)
    let tcmd: ptr<ProcCmd> = cmd(tv)
    tr_cmd_cd(tcmd, root + "/tests/pywheel/cases")
    cmd_quiet(tcmd)
    let _tr: i32 = run(tcmd)
    if update {
        let _mk: bool = mkdir_p(exp_root + "/package")
        let _s1: bool = copy_file(pk + "/pkg/setup.py", exp_root + "/package/setup.py.expect")
        let _s2: bool = copy_file(pk + "/pkg/pyproject.toml", exp_root + "/package/pyproject.toml")
    } else {
        let pbad: ptr<ProcStrs> = sl_new()
        if not tr_same(pk + "/pkg/setup.py", exp_root + "/package/setup.py.expect") {
            sl_push(pbad, "setup.py")
        }
        if not tr_same(pk + "/pkg/pyproject.toml", exp_root + "/package/pyproject.toml") {
            sl_push(pbad, "pyproject.toml")
        }
        if sl_len(pbad) == 0 {
            pass = pass + 1
            outln("PASS package files")
        } else {
            fail = fail + 1
            outln("FAIL package files: " + sl_join(pbad, " "))
        }
    }

    if s_eq(env("FLOW_PYWHEEL_SMOKE"), "1") and not update {
        let s: string = work + "/smoke"
        let _ms: bool = mkdir_p(s)
        let _cs: bool = copy_file("tests/pywheel/cases/mathlib.flow", s + "/mathlib.flow")
        let mut ok: bool = false
        let mut got: string = ""
        let bv: ptr<ProcStrs> = sl_of3(root + "/flow", "python", "mathlib.flow")
        sl_push2(bv, "--version", "1.2.3")
        let bc: ptr<ProcCmd> = cmd(bv)
        tr_cmd_cd(bc, s)
        cmd_env(bc, "FLOW_PYTHON", real_python)
        if run_to_file(bc, s + "/out", true) == 0 {
            let dist: ptr<ProcStrs> = glob_suffix(s + "/dist", ".whl")
            let mut whl: string = ""
            let mut w: i32 = 0
            while w < sl_len(dist) and s_len(whl) == 0 {
                if s_starts(path_basename(sl_get(dist, w)), "mathlib-1.2.3-") {
                    whl = sl_get(dist, w)
                }
                w = w + 1
            }
            if s_len(whl) > 0 {
                let iv: ptr<ProcStrs> = sl_of3(real_python, "-m", "pip")
                sl_extend(iv, s_words("install --quiet --no-deps --target"))
                sl_push2(iv, s + "/site", whl)
                if run_argv(iv) == 0 {
                    let pc: ptr<ProcCmd> = cmd(sl_of3(real_python, "-c", "import mathlib; print(mathlib.square(5.0), mathlib.factorial(5))"))
                    cmd_env(pc, "PYTHONPATH", s + "/site")
                    got = capture(pc)
                    ok = last_status() == 0 and s_eq(got, "25.0 120")
                }
            }
        }
        if ok {
            pass = pass + 1
            outln("PASS wheel smoke (" + got + ")")
        } else {
            fail = fail + 1
            outln("FAIL wheel smoke")
            out(read_text(s + "/out"))
        }
    }

    if update {
        outln("pywheel: goldens updated")
        cli_exit(0)
    }
    outln("pywheel: " + s_itoa(pass) + " passed, " + s_itoa(fail) + " failed")
    tr_exit(fail)
    return 0
}
