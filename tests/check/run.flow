# Golden check for `flow check` (tools/check/main.flow).
#
# The goldens in tests/check/expect were recorded from the retired Python
# implementation (src/flow/check.py, conventions.py, idioms.py): stdout,
# stderr and the exit status of each case below. Each case runs in a fresh
# copy of a fixture project under $TMPDIR, where the *.flow.in sources become
# *.flow (they stay out of the repository's .flow corpus that way). The copy
# also gets the things git cannot hold: a build/ and a .freebuff/ file (both
# skipped), a directory named dir.flow, a symlink to a source file and a
# symlink to a directory (not descended). The temporary path is written as
# ROOT in the goldens.
#
# Cases without file arguments list the files in Path.rglob order, which is
# the directory order of the file system (os.scandir), so those cases compare
# sorted lines. Cases with file arguments compare exactly.
#
# Runs with python and python3 stubbed out.
#
# Usage:
#   ./flow tool tests/check/run.flow
#   FLOW_CHECK_REF='<command>' ./flow tool tests/check/run.flow --record
#                                               # rewrite goldens

import "tools/flow_cli/sys.flow"
import "scripts/tools/lib/testrun.flow"
import std.process { ProcCmd, ProcStrs, proc_arg }

let mut HERE: string = ""
let mut EXPECT: string = ""
let mut WORK: string = ""
let mut RECORD: bool = false
let mut CMD: ptr<ProcStrs> = null
let mut PASS: i32 = 0
let mut FAIL: i32 = 0

# A fresh copy of fixture `fx` at WORK/run/fx; its physical path.
function setup(fx: string) -> string {
    rm_rf(WORK + "/run")
    let _m: bool = mkdir_p(WORK + "/run")
    let d: string = WORK + "/run/" + fx
    let _c: bool = tr_copy_tree(HERE + "/fixtures/" + fx, d)
    tr_strip_in(d, ".flow")
    if s_eq(fx, "proj") {
        let _b: bool = mkdir_p(d + "/build")
        let _f: bool = mkdir_p(d + "/.freebuff")
        let _df: bool = mkdir_p(d + "/dir.flow")
        let _w: bool = write_text(d + "/build/skipped.flow", "function b() -> i32 {\n    let mut hidden: i32 = 1\n    return hidden\n}\n")
        let _cp: bool = copy_file(d + "/build/skipped.flow", d + "/.freebuff/skipped.flow")
        let _l1: bool = tr_symlink("src/idioms_basic.flow", d + "/link.flow")
        let _l2: bool = tr_symlink("src/nested", d + "/linkdir")
    }
    return abs_dir_physical(d)
}

function run_case(name: string, fx: string, sub: string, mode: string, args: ptr<ProcStrs>) {
    let d: string = setup(fx)
    let argv: ptr<ProcStrs> = sl_copy(CMD)
    sl_extend(argv, args)
    let rc: i32 = tr_run_files(argv, d + "/" + sub, WORK + "/out", WORK + "/err")
    let streams: ptr<ProcStrs> = sl_of2("out", "err")
    let mut k: i32 = 0
    while k < 2 {
        let o: string = sl_get(streams, k)
        k = k + 1
        let mut t: string = s_replace(read_text(WORK + "/" + o), d, "ROOT")
        if s_eq(mode, "sorted") {
            t = tr_sort_lines(t)
        }
        let _w: bool = write_text(WORK + "/" + o + ".n", t)
    }
    let _r: bool = write_text(WORK + "/rc.n", s_itoa(rc) + "\n")
    if RECORD {
        let _a: bool = copy_file(WORK + "/out.n", EXPECT + "/" + name + ".stdout")
        let _b: bool = copy_file(WORK + "/err.n", EXPECT + "/" + name + ".err")
        let _c: bool = copy_file(WORK + "/rc.n", EXPECT + "/" + name + ".rc")
        outln("recorded " + name + " (exit " + s_itoa(rc) + ")")
        return
    }
    let e: string = EXPECT + "/" + name
    if tr_same(WORK + "/out.n", e + ".stdout") and tr_same(WORK + "/err.n", e + ".err") and tr_same(WORK + "/rc.n", e + ".rc") {
        PASS = PASS + 1
    } else {
        FAIL = FAIL + 1
        outln("FAIL " + name)
        out(tr_head(tr_diff("", e + ".stdout", WORK + "/out.n"), 10))
        out(tr_head(tr_diff("", e + ".err", WORK + "/err.n"), 10))
        out(tr_diff("", e + ".rc", WORK + "/rc.n"))
    }
}

function main() -> i32 {
    let root: string = tr_enter_root()
    HERE = root + "/tests/check"
    EXPECT = HERE + "/expect"
    let args: ptr<ProcStrs> = tr_args()
    RECORD = sl_len(args) > 0 and s_eq(sl_get(args, 0), "--record")
    WORK = tr_workdir("flow-check")

    if RECORD {
        let ref: string = env("FLOW_CHECK_REF")
        if s_len(ref) == 0 {
            errln("FLOW_CHECK_REF: set FLOW_CHECK_REF to the reference command")
            cli_exit(1)
        }
        CMD = s_words(ref)
        let _m: bool = mkdir_p(EXPECT)
    } else {
        let tool: string = capture(cmd(sl_of3(root + "/flow", "check", "--build")))
        if last_status() != 0 {
            cli_exit(last_status())
        }
        CMD = sl_of1(tool)
        tr_stub_python_loud(WORK + "/bin")
    }

    let files: ptr<ProcStrs> = s_words("src/idioms_basic.flow src/flowblock.flow src/crlf.flow src/idioms_if.flow src/nested/idioms_match.flow src/nested/parse_error.flow src/bad_utf8.flow dir.flow link.flow ./src//idioms_basic.flow missing.flow")

    run_case("avoid_rglob", "proj", ".", "sorted", sl_new())
    run_case("idioms_rglob", "proj", ".", "sorted", sl_of1("--idioms"))
    run_case("idioms_json_rglob", "proj", ".", "sorted", sl_of2("--idioms", "--format=json"))
    run_case("avoid_json", "proj", ".", "sorted", sl_of1("--format=json"))
    let a5: ptr<ProcStrs> = sl_of2("-v", "--idioms")
    sl_extend(a5, files)
    run_case("idioms_text_files", "proj", ".", "exact", a5)
    let a6: ptr<ProcStrs> = sl_of2("--idioms", "--format=json")
    sl_extend(a6, files)
    run_case("idioms_json_files", "proj", ".", "exact", a6)
    let a7: ptr<ProcStrs> = sl_of3("--idioms", "--format=xml", "src/idioms_basic.flow")
    sl_push(a7, "src/idioms_if.flow")
    run_case("idioms_xml_files", "proj", ".", "exact", a7)
    run_case("format_space", "proj", ".", "exact", sl_of2("--format", "json"))
    run_case("avoid_files", "proj", ".", "exact", sl_of3("src/idioms_basic.flow", "src/nested/idioms_match.flow", "missing.flow"))
    run_case("nested_cwd", "proj", "src/nested", "sorted", sl_new())
    run_case("clean_files", "proj", ".", "exact", sl_of1("src/crlf.flow"))
    run_case("clean_idioms", "proj", ".", "exact", sl_of2("--idioms", "src/idioms_if.flow"))
    run_case("inline_rglob", "inline", ".", "sorted", sl_new())
    run_case("noconv", "noconv", ".", "exact", sl_new())
    run_case("noconv_idioms", "noconv", ".", "sorted", sl_of1("--idioms"))
    run_case("badtoml", "badtoml", ".", "exact", sl_new())
    run_case("badtoml_idioms", "badtoml", ".", "exact", sl_of2("--idioms", "a.flow"))
    run_case("no_flow_files", "empty", ".", "exact", sl_new())

    if RECORD {
        cli_exit(0)
    }
    outln("flow check: pass=" + s_itoa(PASS) + " fail=" + s_itoa(FAIL))
    tr_exit(FAIL)
    return 0
}
