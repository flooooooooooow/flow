# Compiler-suite runtime: i32 match + default

function classify(n: i32) -> i32 {
    match n {
        0 => { return 10 }
        1 => { return 20 }
        default { return 30 }
    }
}

function main() -> i32 {
    if classify(0) != 10 { return 1 }
    if classify(1) != 20 { return 2 }
    if classify(9) != 30 { return 3 }
    printf("match_i32 ok\n")
    return 0
}
