# Runtime test: parallel for fills correctly (OpenMP or serial)
function main() -> i32 {
    let mut arr: array<i32, 64> = []
    let n: i32 = 64
    parallel for i in 0 to n {
        arr[i] = i * 2
    }
    let mut i: i32 = 0
    while i < n {
        if arr[i] != i * 2 {
            return 1
        }
        i = i + 1
    }
    return 0
}
