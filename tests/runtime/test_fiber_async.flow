import "stdlib/async.flow"

function main() -> i32 {
    let mut total: i32 = 0
    handle Async with FiberAsync {
        async_spawn(0)
        async_spawn(1)
        async_spawn(2)
        total = async_join(0) + async_join(1) + async_join(2)
    }
    if total != 30 {
        return 1
    }
    return 0
}
