# Compiler-suite runtime: integer arithmetic / compares
# Returns 0 on success.

function check(cond: bool, code: i32) -> i32 {
    if cond {
        return 0
    }
    return code
}

function main() -> i32 {
    let a: i32 = 10
    let b: i32 = 3
    if check(a + b == 13, 1) != 0 { return 1 }
    if check(a - b == 7, 2) != 0 { return 2 }
    if check(a * b == 30, 3) != 0 { return 3 }
    if check(a / b == 3, 4) != 0 { return 4 }
    if check(a % b == 1, 5) != 0 { return 5 }
    if check(a > b, 6) != 0 { return 6 }
    if check(b < a, 7) != 0 { return 7 }
    if check(a != b, 8) != 0 { return 8 }
    if check(0 - b == 0 - 3, 9) != 0 { return 9 }
    return 0
}
