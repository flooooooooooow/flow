# Runtime test: Comparison operations
# Returns 0 if all tests pass, non-zero otherwise

function test_equal() -> bool {
    return 5 == 5
}

function test_not_equal() -> bool {
    return 5 != 6
}

function test_less_than() -> bool {
    return 3 < 5
}

function test_less_equal() -> bool {
    return 5 <= 5 && 4 <= 5
}

function test_greater_than() -> bool {
    return 7 > 4
}

function test_greater_equal() -> bool {
    return 5 >= 5 && 6 >= 5
}

function test_boolean_and() -> bool {
    return true && true
}

function test_boolean_or() -> bool {
    return true || false
}

function test_boolean_not() -> bool {
    return !false
}

function test_complex_condition() -> bool {
    let x: i32 = 10
    let y: i32 = 20
    return x < y && y > 15 && x >= 5
}

function main() -> i32 {
    if !test_equal() {
        printf("FAIL: equal\n")
        return 1
    }
    if !test_not_equal() {
        printf("FAIL: not_equal\n")
        return 2
    }
    if !test_less_than() {
        printf("FAIL: less_than\n")
        return 3
    }
    if !test_less_equal() {
        printf("FAIL: less_equal\n")
        return 4
    }
    if !test_greater_than() {
        printf("FAIL: greater_than\n")
        return 5
    }
    if !test_greater_equal() {
        printf("FAIL: greater_equal\n")
        return 6
    }
    if !test_boolean_and() {
        printf("FAIL: boolean_and\n")
        return 7
    }
    if !test_boolean_or() {
        printf("FAIL: boolean_or\n")
        return 8
    }
    if !test_boolean_not() {
        printf("FAIL: boolean_not\n")
        return 9
    }
    if !test_complex_condition() {
        printf("FAIL: complex_condition\n")
        return 10
    }
    
    printf("All comparison tests passed\n")
    return 0
}
