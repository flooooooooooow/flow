# GPU simulator must reject invalid launch/configuration before arithmetic or memcpy.
import "stdlib/gpu_sim.flow"

function main() -> i32 {
    let good1: LaunchConfig = grid_1d(10, 4)
    if good1.grid.x != 3 or good1.total_threads != 12 { return 1 }
    if grid_1d(10, 0).total_threads != 0 { return 2 }
    if grid_1d(10, -1).total_threads != 0 { return 3 }
    if grid_1d(10, 1025).total_threads != 0 { return 4 }
    if grid_1d(2147483647, 4).total_threads != 0 { return 5 }

    let good2: LaunchConfig = grid_2d(10, 5, 4, 2)
    if good2.grid.x != 3 or good2.grid.y != 3 or good2.total_threads != 72 { return 6 }
    if grid_2d(10, 10, 1024, 2).total_threads != 0 { return 7 }
    if grid_2d(2147483647, 2147483647, 4, 4).total_threads != 0 { return 8 }

    let good3: LaunchConfig = grid_3d(4, 4, 4, 2, 2, 2)
    if good3.total_threads != 64 { return 9 }
    if grid_3d(4, 4, 4, 0, 2, 2).total_threads != 0 { return 10 }
    if grid_3d(4, 4, 4, 16, 16, 16).total_threads != 0 { return 11 }
    if grid_3d(2147483647, 2, 2, 2, 2, 2).total_threads != 0 { return 12 }

    if layout_1d(-1).size != 0 { return 13 }
    if layout_2d(2147483647, 2).rows != 0 { return 14 }
    if layout_3d(2, 2147483647, 2).depth != 0 { return 15 }
    if host_alloc_f32(536870912).data != null { return 16 }
    if device_alloc_f32(-2).data != null { return 17 }

    let src: array<f32, 2> = [7.0, 9.0]
    let mut dst: array<f32, 1> = [3.0]
    let host2: HostBufferF32 = host_buffer_f32(src, 2)
    let device1: DeviceBufferF32 = DeviceBufferF32 { data: dst, len: 1 }
    copy_host_to_device(host2, device1)
    if dst[0] != 3.0 { return 18 }
    let device2: DeviceBufferF32 = DeviceBufferF32 { data: src, len: 2 }
    let host1: HostBufferF32 = host_buffer_f32(dst, 1)
    copy_device_to_host(device2, host1)
    if dst[0] != 3.0 { return 19 }
    return 0
}
