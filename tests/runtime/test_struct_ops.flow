# Compiler-suite runtime: struct literals, fields, nested structs

struct Point { x: i32, y: i32 }
struct Rect { lo: Point, hi: Point }

function main() -> i32 {
    let p: Point = Point { x: 3, y: 4 }
    if p.x != 3 { return 1 }
    if p.y != 4 { return 2 }

    let mut q: Point = Point { x: 0, y: 0 }
    q.x = 10
    q.y = 20
    if q.x + q.y != 30 { return 3 }

    let r: Rect = Rect {
        lo: Point { x: 1, y: 2 },
        hi: Point { x: 5, y: 6 }
    }
    if r.lo.x != 1 { return 4 }
    if r.hi.y != 6 { return 5 }
    if (r.hi.x - r.lo.x) * (r.hi.y - r.lo.y) != 16 { return 6 }
    return 0
}
