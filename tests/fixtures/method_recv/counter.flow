# Library module for tests/lang/test_method_recv_import.flow: functions
# whose first parameter is a pointer to the struct, called with method
# syntax from another module.

export struct Counter {
    n: i32
}

export function counter_new() -> Counter {
    return Counter { n: 0 }
}

export function bump(c: ptr<Counter>, by: i32) -> i32 {
    c[0].n = c[0].n + by
    return c[0].n
}

export function value(c: ptr<Counter>) -> i32 {
    return c[0].n
}
