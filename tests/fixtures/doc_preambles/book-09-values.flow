# Stand-ins for chapter 9, and only stand-ins.
#
# The chapter shows one form per block over bare names: `if n >= 0`, `while
# active`, `if should_skip()`. Those names stand for any value and any
# predicate, so writing them out above each block would bury the form the
# block exists to show. Anything a reader actually needs to see, such as the
# record a fork fills or the functions a pipeline runs through, is declared
# on the page instead.

import "stdlib/memory.flow"

let mut n: i32 = 3
let mut active: bool = true
let mut target: i32 = 2
let mut input: i32 = 6

function should_skip() -> bool { return false }
function process() -> void { return }
function should_stop() -> bool { return true }
function use_buffer(p: ptr<u8>) -> void { return }
