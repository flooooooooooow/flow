import "stdlib/gpu_sim.flow"

function main() -> i32 {
    let ctx: DeviceContext = device_context()
    if !ctx.has_gpu { return 1 }

    let n: i32 = 4
    let a: array<f32, 4> = [1.0,2.0,3.0,4.0]
    let b: array<f32, 4> = [10.0,20.0,30.0,40.0]
    let out: array<f32, 4> = [0.0,0.0,0.0,0.0]

    let host_a: HostBufferF32 = host_buffer_f32(a, n)
    let host_b: HostBufferF32 = host_buffer_f32(b, n)
    let host_out: HostBufferF32 = host_buffer_f32(out, n)

    let dev_a: DeviceBufferF32 = device_alloc_f32(n)
    let dev_b: DeviceBufferF32 = device_alloc_f32(n)
    let dev_out: DeviceBufferF32 = device_alloc_f32(n)

    copy_host_to_device(host_a, dev_a)
    copy_host_to_device(host_b, dev_b)

    let layout: Layout = layout_1d(n)
    let a_t: LayoutTensorF32 = tensor_from_device(dev_a, layout)
    let b_t: LayoutTensorF32 = tensor_from_device(dev_b, layout)
    let out_t: LayoutTensorF32 = tensor_from_device(dev_out, layout)

    let q0: CommandQueue = device_queue(ctx)
    let q1: CommandQueue = enqueue_queue(q0)
    kernel_vec_add(a_t, b_t, out_t)
    let q2: CommandQueue = synchronize(q1)

    copy_device_to_host(dev_out, host_out)

    if out[0] != 11.0 { return 2 }
    if out[1] != 22.0 { return 3 }
    if out[2] != 33.0 { return 4 }
    if out[3] != 44.0 { return 5 }
    if q2.pending != 0 { return 6 }

    device_free_f32(dev_a)
    device_free_f32(dev_b)
    device_free_f32(dev_out)
    return 0
}
