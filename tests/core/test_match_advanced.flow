# Match: guard clauses, `|` pattern alternation, and nested literal struct patterns.
# Returns 0 if all checks pass, non-zero (test id) otherwise.

extern {
    function printf(fmt: string, val: i32) -> i32
}

struct Point {
    x: i32,
    y: i32,
}

# --- Guard clauses -----------------------------------------------------

function classify(n: i32) -> i32 {
    match n {
        x if x > 100 => { return 1 }   # never taken for our inputs
        x if x > 0 => { return 2 }     # guard true, binding used
        x if x < 0 => { return 3 }
        _ => { return 4 }
    }
    return -1
}

function test_guard_fallthrough() -> bool {
    # First guard (x > 100) fails, falls through to the second (x > 0).
    return classify(5) == 2
}

function test_guard_negative() -> bool {
    return classify(-5) == 3
}

function test_guard_default() -> bool {
    return classify(0) == 4
}

# --- `|` pattern alternation --------------------------------------------

function is_weekend(day: i32) -> bool {
    match day {
        6 | 7 => { return true }
        _ => { return false }
    }
    return false
}

function test_or_pattern_match() -> bool {
    return is_weekend(6) && is_weekend(7)
}

function test_or_pattern_no_match() -> bool {
    return !is_weekend(3)
}

function or_pattern_with_guard(n: i32) -> i32 {
    match n {
        1 | 2 | 3 if n == 2 => { return 100 }
        1 | 2 | 3 => { return 200 }
        _ => { return 300 }
    }
    return -1
}

function test_or_pattern_with_guard_true() -> bool {
    return or_pattern_with_guard(2) == 100
}

function test_or_pattern_with_guard_false() -> bool {
    return or_pattern_with_guard(1) == 200
}

function test_or_pattern_no_alt() -> bool {
    return or_pattern_with_guard(9) == 300
}

# --- Nested literal patterns in struct destructuring ---------------------

function classify_point(p: Point) -> i32 {
    match p {
        Point(0, 0) => { return 1 }   # origin: both fields literal
        Point(0, y) => { return 2 }   # on y-axis: literal + binding
        Point(x, y) if x == y => { return 3 }  # diagonal, plain bindings + guard
        _ => { return 4 }
    }
    return -1
}

function test_nested_origin() -> bool {
    let p: Point = Point { x: 0, y: 0 }
    return classify_point(p) == 1
}

function test_nested_y_axis() -> bool {
    let p: Point = Point { x: 0, y: 7 }
    return classify_point(p) == 2
}

function test_nested_diagonal() -> bool {
    let p: Point = Point { x: 3, y: 3 }
    return classify_point(p) == 3
}

function test_nested_elsewhere() -> bool {
    let p: Point = Point { x: 3, y: 9 }
    return classify_point(p) == 4
}

function main() -> i32 {
    if !test_guard_fallthrough() {
        printf("FAIL: guard_fallthrough\n", 0)
        return 1
    }
    if !test_guard_negative() {
        printf("FAIL: guard_negative\n", 0)
        return 2
    }
    if !test_guard_default() {
        printf("FAIL: guard_default\n", 0)
        return 3
    }
    if !test_or_pattern_match() {
        printf("FAIL: or_pattern_match\n", 0)
        return 4
    }
    if !test_or_pattern_no_match() {
        printf("FAIL: or_pattern_no_match\n", 0)
        return 5
    }
    if !test_or_pattern_with_guard_true() {
        printf("FAIL: or_pattern_with_guard_true\n", 0)
        return 6
    }
    if !test_or_pattern_with_guard_false() {
        printf("FAIL: or_pattern_with_guard_false\n", 0)
        return 7
    }
    if !test_or_pattern_no_alt() {
        printf("FAIL: or_pattern_no_alt\n", 0)
        return 8
    }
    if !test_nested_origin() {
        printf("FAIL: nested_origin\n", 0)
        return 9
    }
    if !test_nested_y_axis() {
        printf("FAIL: nested_y_axis\n", 0)
        return 10
    }
    if !test_nested_diagonal() {
        printf("FAIL: nested_diagonal\n", 0)
        return 11
    }
    if !test_nested_elsewhere() {
        printf("FAIL: nested_elsewhere\n", 0)
        return 12
    }

    printf("All advanced match tests passed\n", 0)
    return 0
}
