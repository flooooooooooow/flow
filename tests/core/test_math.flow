# Math operations test
function multiply(a: i32, b: i32) -> i32 {
    return a * b
}

function factorial(n: i32) -> i32 {
    if n <= 1 {
        return 1
    } else {
        return n * factorial(n - 1)
    }
}

function main() -> i32 {
    let x: i32 = multiply(5, 6)
    let y: i32 = factorial(4)
    return x + y
}
