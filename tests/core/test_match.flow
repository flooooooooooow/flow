function run_demo() -> i32 {
    print("Testing Match Statement:")
    
    print("test_int_match(1):")
    test_int_match(1)
    
    print("test_int_match(2):")
    test_int_match(2)
    
    print("test_int_match(3):")
    test_int_match(3)
    
