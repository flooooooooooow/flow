# @module tests.mlir_commands.normalize
# @means  Normalize textual MLIR for comparison, as
#         compiler/scripts/mlir_normalize.awk does for parity_mlir.
#
# The Flow emitter and the Python generator number SSA values and blocks
# differently: Python allocates a number before it emits the op that defines
# it (a call result gets its number before the argument values do), and it
# indents region bodies unevenly. Neither changes the program. This filter
# makes the two comparable:
#
#   * leading and trailing blanks are dropped, and empty lines skipped;
#   * every %<digits> value is renamed %v<k> in order of first appearance
#     (%argN block arguments and named values such as %in are kept);
#   * every ^bb<digits> label is renamed ^b<k> the same way;
#   * the value names start over at each `gpu.func`, which the GPU
#     generator numbers from %1 on its own (the counter keeps going).
#
# Global string constants (`llvm.mlir.global ...`) are left as they are, so
# a format string such as "%5d" is never touched.

import "tools/flow_cli/sys.flow"
import std.process { ProcStrs }
import std.bytebuf { ByteBuf, bb_new, bb_puts, bb_putc, bb_put_span, bb_str, bb_free }

extern {
    function malloc(size: i64) -> ptr<void>
}

const NB: i32 = 4096

# A string-to-string map: NB buckets of key and value lists.
struct NameMap {
    keys: ptr<ptr<ProcStrs>>,
    vals: ptr<ptr<ProcStrs>>,
    count: i32
}

function nm_new() -> ptr<NameMap> {
    let m: ptr<NameMap> = malloc(24) as ptr<NameMap>
    m.keys = malloc((NB as i64) * 8) as ptr<ptr<ProcStrs>>
    m.vals = malloc((NB as i64) * 8) as ptr<ptr<ProcStrs>>
    let mut i: i32 = 0
    while i < NB {
        m.keys[i] = sl_new()
        m.vals[i] = sl_new()
        i = i + 1
    }
    m.count = 0
    return m
}

function nm_bucket(s: string) -> i32 {
    let p: ptr<u8> = s as ptr<u8>
    let mut h: i32 = 0
    let mut i: i32 = 0
    while p[i] != 0 {
        h = (h * 31 + (p[i] as i32)) % 1000003
        i = i + 1
    }
    return h % NB
}

# The name for `tok`, made from `prefix` and the next count when new.
function nm_name(m: ptr<NameMap>, counter: ptr<i32>, tok: string, prefix: string) -> string {
    let b: i32 = nm_bucket(tok)
    let ks: ptr<ProcStrs> = m.keys[b]
    let mut i: i32 = 0
    while i < sl_len(ks) {
        if s_eq(sl_get(ks, i), tok) {
            return sl_get(m.vals[b], i)
        }
        i = i + 1
    }
    counter[0] = counter[0] + 1
    let name: string = prefix + s_itoa(counter[0])
    sl_push(ks, tok)
    sl_push(m.vals[b], name)
    return name
}

function is_digit(c: i32) -> bool {
    return c >= 48 and c <= 57
}

function is_blank(c: i32) -> bool {
    return c == 32 or c == 9
}

export function mlir_normalize(text: string) -> string {
    let out_b: ptr<ByteBuf> = bb_new(s_len(text) + 64)
    let mut vals: ptr<NameMap> = nm_new()
    let labels: ptr<NameMap> = nm_new()
    let nv: ptr<i32> = malloc(4) as ptr<i32>
    let nl: ptr<i32> = malloc(4) as ptr<i32>
    nv[0] = 0
    nl[0] = 0
    let lines: ptr<ProcStrs> = s_lines(text)
    let mut li: i32 = 0
    while li < sl_len(lines) {
        let raw: string = sl_get(lines, li)
        li = li + 1
        let mut a: i32 = 0
        let mut z: i32 = s_len(raw)
        while a < z and is_blank(s_byte(raw, a)) {
            a = a + 1
        }
        while z > a and is_blank(s_byte(raw, z - 1)) {
            z = z - 1
        }
        if z == a {
            continue
        }
        let line: string = s_slice(raw, a, z)
        if s_starts(line, "llvm.mlir.global ") {
            bb_puts(out_b, line)
            bb_putc(out_b, 10)
            continue
        }
        if s_starts(line, "gpu.func ") {
            vals = nm_new()
        }
        let n: i32 = s_len(line)
        let p: ptr<u8> = line as ptr<u8>
        let mut i: i32 = 0
        let mut last: i32 = 0
        while i < n {
            if p[i] == 37 and i + 1 < n and is_digit(p[i + 1] as i32) {
                let mut j: i32 = i + 1
                while j < n and is_digit(p[j] as i32) {
                    j = j + 1
                }
                bb_put_span(out_b, p, last, i)
                bb_puts(out_b, nm_name(vals, nv, s_slice(line, i, j), "%v"))
                last = j
                i = j
            } elif p[i] == 94 and i + 3 < n and p[i + 1] == 98 and p[i + 2] == 98 and is_digit(p[i + 3] as i32) {
                let mut j: i32 = i + 3
                while j < n and is_digit(p[j] as i32) {
                    j = j + 1
                }
                bb_put_span(out_b, p, last, i)
                bb_puts(out_b, nm_name(labels, nl, s_slice(line, i, j), "^b"))
                last = j
                i = j
            } else {
                i = i + 1
            }
        }
        bb_put_span(out_b, p, last, n)
        bb_putc(out_b, 10)
    }
    let s: string = bb_str(out_b)
    bb_free(out_b)
    return s
}
