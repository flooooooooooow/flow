# MLIR command goldens: `flow mlir`, `mlir-run`, `jit`, `ml`, `test-mlir`,
# `test-matmul`, `compile-audio --mlir`, `--mlir-gpu`, `--emit-spirv` and the
# optimizer pass pipelines, checked against the goldens in
# tests/mlir_commands/expected/. They were recorded from the Python MLIR stack
# at bb23f19f; the cases whose MLIR the emitter fixes changed (the text, and
# jit_spans and audio_offline, which now print what the C backend prints)
# were re-recorded from flowc with --record.
#
#   ./flow tool tests/mlir_commands/run.flow                 check this checkout, python stubbed
#   ./flow tool tests/mlir_commands/run.flow --record ROOT [NAME...]
#                                              rewrite the goldens from the flow at ROOT
#   ./flow tool tests/mlir_commands/run.flow --only NAME...  check the named cases only
#
# Check mode puts python and python3 shims that log and exit 127 first on
# PATH, so a Python fallback fails the case instead of hiding. JIT cases run
# with FLOW_JIT_LINK_RUNTIME=0 as recorded (the runtime link was broken at
# bb23f19f: flow_async_worker undefined); jit_*_rt cases link the runtime and
# share the plain golden.
#
# MLIR files are normalized with gl_mlir_normalize from
# compiler/scripts/gate_lib.flow, the rules parity_mlir uses.
#
# Needs mlir-opt and mlir-translate (LLVM_PATH, or brew --prefix llvm).

import "tools/flow_cli/sys.flow"
import "scripts/tools/lib/testrun.flow"
import "compiler/scripts/gate_lib.flow"
import std.process { ProcCmd, ProcResult, ProcStrs, proc_arg, proc_timeout_ms }
import std.regex { Regex, rx_test }

const USAGE: string = "usage: ./flow tool tests/mlir_commands/run.flow [--record ROOT | --only NAME...]"

let mut ROOT: string = ""
let mut WORK: string = ""
let mut JIT_RT: string = "0"

let mut RX_ANSI: ptr<Regex> = null
let mut RX_RUNDIR: ptr<Regex> = null
let mut RX_MODULE: ptr<Regex> = null
let mut RX_DASHES_END: ptr<Regex> = null
let mut RX_NUMBER: ptr<Regex> = null
let mut RX_GF_TITLE: ptr<Regex> = null
let mut RX_DROP: ptr<ProcStrs> = null
let mut DROP: ptr<ptr<Regex>> = null

function compile_patterns() {
    RX_ANSI = tr_rx("\\x1b\\[[0-9;]*m")
    RX_RUNDIR = tr_rx("/build/run\\.[A-Za-z0-9]{6}/")
    RX_MODULE = tr_rx("^module( attributes.*)? \\{$")
    RX_DASHES_END = tr_rx("-{20,}$")
    RX_NUMBER = tr_rx("^[0-9.]+$")
    RX_GF_TITLE = tr_rx("^(Naive|Vectorized \\((unroll|auto)\\)|Parallelized|Tiled \\+ .*|Baseline \\(Flow naive GFLOP/s\\)):$")
    RX_DROP = sl_new()
    sl_push(RX_DROP, "^(ℹ️|🚀)")
    sl_push(RX_DROP, "^✅ (Generated|FLOW|MLIR|LLVM|Built|C →|🎧|🚀)")
    sl_push(RX_DROP, "^⚠️ +flowc MLIR emitter")
    sl_push(RX_DROP, "^(Resolving modules|Parsed [0-9]+ functions|Generated (MLIR|LLVM IR|SPIR-V)|Type warnings|  ⚠ |  \\.\\.\\. and |Input file:)")
    sl_push(RX_DROP, "^ensure_flowc: compiler/src has local edits; building flowc from them$")
    sl_push(RX_DROP, "^(real|user|sys) +[0-9.]+$")
    sl_push(RX_DROP, "^-{20,}$")
    sl_push(RX_DROP, "overriding the module target triple|^[0-9]+ warnings? generated\\.$")
    DROP = malloc((sl_len(RX_DROP) as i64) * 8) as ptr<ptr<Regex>>
    let mut i: i32 = 0
    while i < sl_len(RX_DROP) {
        DROP[i] = tr_rx(sl_get(RX_DROP, i))
        i = i + 1
    }
}

extern {
    function malloc(size: i64) -> ptr<void>
}

# Driver progress lines, Python host chatter, timings and the checkout path
# are not behaviour; the program output, results and failures are.
function filter(text: string) -> string {
    let a: string = tr_sed(text, RX_ANSI, "", 0)
    let b: string = s_replace(s_replace(a, ROOT, "<ROOT>"), WORK, "<WORK>")
    let c: string = tr_sed(b, RX_RUNDIR, "/build/run.X/", 0)
    let lines: ptr<ProcStrs> = s_lines(c)

    # The MLIR module a command echoes, up to the dashed line after it.
    let s1: ptr<ProcStrs> = sl_new()
    let mut skip: bool = false
    let mut i: i32 = 0
    while i < sl_len(lines) {
        let l: string = sl_get(lines, i)
        i = i + 1
        if rx_test(RX_MODULE, l) {
            skip = true
        }
        if skip and rx_test(RX_DASHES_END, l) {
            skip = false
            continue
        }
        if not skip {
            sl_push(s1, l)
        }
    }

    # GFLOP/s figures after their titles.
    let s2: ptr<ProcStrs> = sl_new()
    let mut gf: bool = false
    i = 0
    while i < sl_len(s1) {
        let l: string = sl_get(s1, i)
        i = i + 1
        if gf and rx_test(RX_NUMBER, l) {
            sl_push(s2, "<GFLOPS>")
            gf = false
            continue
        }
        gf = rx_test(RX_GF_TITLE, l)
        sl_push(s2, l)
    }

    # Assembly listings, up to the next "MLIR: " line.
    let s3: ptr<ProcStrs> = sl_new()
    let mut in_asm: bool = false
    i = 0
    while i < sl_len(s2) {
        let l: string = sl_get(s2, i)
        i = i + 1
        if s_starts(l, "MLIR: ") {
            in_asm = false
        }
        if in_asm {
            continue
        }
        if s_starts(l, "Assembly: ") {
            sl_push(s3, l)
            sl_push(s3, "<ASM>")
            in_asm = true
            continue
        }
        sl_push(s3, l)
    }

    let out_t: ptr<ProcStrs> = sl_new()
    i = 0
    while i < sl_len(s3) {
        let l: string = sl_get(s3, i)
        i = i + 1
        let mut drop: bool = false
        let mut k: i32 = 0
        while k < sl_len(RX_DROP) and not drop {
            drop = rx_test(DROP[k], l)
            k = k + 1
        }
        if not drop {
            sl_push(out_t, l)
        }
    }
    if sl_len(out_t) == 0 {
        return ""
    }
    return sl_join(out_t, "\n") + "\n"
}

function pipeline_cmd(root: string, args: ptr<ProcStrs>) -> ptr<ProcCmd> {
    let v: ptr<ProcStrs> = sl_of2(root + "/flow", "mlir-optimize")
    sl_push(v, "--print-pass-pipeline")
    sl_extend(v, args)
    return cmd(v)
}

# Run one case; it writes WORK/got/NAME.*.
function run_case(root: string, name: string, kind: string, raw_args: ptr<ProcStrs>) {
    let d: string = WORK + "/case/" + name
    let _m: bool = mkdir_p(d + "/build")
    let _g: bool = mkdir_p(WORK + "/got")
    let args: ptr<ProcStrs> = sl_new()
    let mut run_after: bool = false
    let mut i: i32 = 0
    while i < sl_len(raw_args) {
        let a: string = s_replace(sl_get(raw_args, i), "@WORK@", d)
        i = i + 1
        if s_eq(a, "@RUN@") {
            run_after = true
            continue
        }
        sl_push(args, a)
    }
    let g: string = WORK + "/got/" + name
    if s_eq(kind, "mlir") or s_eq(kind, "aosoa-pad") or s_eq(kind, "aosoa-swizzle") or s_eq(kind, "affine") or s_eq(kind, "tile") or s_eq(kind, "raw") or s_eq(kind, "spirv") {
        let prog: string = sl_get(args, 0)
        let base: string = path_stem(prog, ".flow")
        let v: ptr<ProcStrs> = sl_of2("./flow", "mlir")
        sl_extend(v, args)
        let c: ptr<ProcCmd> = cmd(v)
        tr_cmd_cd(c, root)
        cmd_env(c, "FLOW_BUILD_ROOT", d + "/build")
        if s_eq(kind, "aosoa-pad") {
            cmd_env(c, "FLOWC_MLIR_AOSOA_PAD", "1")
        }
        if s_eq(kind, "aosoa-swizzle") {
            cmd_env(c, "FLOWC_MLIR_AOSOA_SWIZZLE", "4")
        }
        if s_eq(kind, "affine") {
            cmd_env(c, "FLOWC_MLIR_AFFINE", "1")
        } elif s_eq(kind, "tile") {
            cmd_env(c, "FLOWC_MLIR_AFFINE", "1")
            cmd_env(c, "FLOWC_MLIR_TILE", "4")
        }
        let rc: i32 = run_to_file(c, d + "/log", true)
        let _r: bool = write_text(g + ".rc", s_itoa(rc) + "\n")
        let mlir: string = d + "/build/" + base + ".mlir"
        if s_eq(kind, "mlir") or s_eq(kind, "aosoa-pad") or s_eq(kind, "aosoa-swizzle") or s_eq(kind, "affine") or s_eq(kind, "tile") {
            if is_file(mlir) {
                let _w: bool = write_text(g + ".mlir", gl_mlir_normalize(read_text(mlir)))
            }
        } elif s_eq(kind, "raw") {
            if is_file(mlir) {
                let _w2: bool = write_text(g + ".txt", s_replace(read_text(mlir), root, "<ROOT>"))
            }
        } elif nonempty(d + "/k.spv") {
            let sc: ptr<ProcCmd> = cmd(sl_of3("shasum", "-a", "256"))
            proc_arg(sc, d + "/k.spv")
            let words: ptr<ProcStrs> = s_words(capture(sc))
            let _w3: bool = write_text(g + ".sha", sl_get(words, 0) + "\n")
        }
    } elif s_eq(kind, "pipeline") {
        let c: ptr<ProcCmd> = pipeline_cmd(root, args)
        tr_cmd_cd(c, root)
        let rc: i32 = tr_run_cmd_files(c, g + ".txt", d + "/log")
        let _r: bool = write_text(g + ".rc", s_itoa(rc) + "\n")
    } elif s_eq(kind, "out") {
        let mut rt: string = JIT_RT
        if s_ends(name, "_rt") {
            rt = "1"
        }
        let v: ptr<ProcStrs> = sl_of1("./flow")
        sl_extend(v, args)
        let c: ptr<ProcCmd> = cmd(v)
        tr_cmd_cd(c, root)
        cmd_env(c, "FLOW_JIT_LINK_RUNTIME", rt)
        if s_starts(name, "audio_") {
            cmd_env(c, "FLOW_TEST_FAST", "1")
        }
        if s_eq(name, "run_mlir_effects") {
            # This golden covers the legacy zero-default fallback. Stable
            # effect checking remains strict for every other command case.
            cmd_env(c, "FLOWC_PERMISSIVE_EFFECTS", "1")
        }
        cmd_no_stdin(c)
        proc_timeout_ms(c, 600000)
        cmd_capture_out(c)
        cmd_merge_err(c)
        let r: ptr<ProcResult> = run_result(c)
        let mut rc: i32 = r.exit_code
        if r.timed_out {
            # What timeout(1) reports.
            rc = 124
        }
        let _l: bool = write_text(d + "/log", r.stdout)
        if run_after {
            let base: string = path_stem(sl_get(args, 1), ".flow")
            let bin: string = root + "/build/" + base
            if is_exec(bin) {
                let _a: bool = append_text(d + "/log", "== run " + base + "\n")
                let pc: ptr<ProcCmd> = cmd(sl_of1(bin))
                tr_cmd_cd(pc, d)
                cmd_no_stdin(pc)
                proc_timeout_ms(pc, 60000)
                cmd_capture_out(pc)
                cmd_merge_err(pc)
                let pr: ptr<ProcResult> = run_result(pc)
                let _a2: bool = append_text(d + "/log", pr.stdout)
                let mut prc: i32 = pr.exit_code
                if pr.timed_out {
                    prc = 124
                }
                if prc != 0 {
                    let _a3: bool = append_text(d + "/log", "run exit=" + s_itoa(prc) + "\n")
                }
            }
        }
        let _o: bool = write_text(g + ".out", filter(read_text(d + "/log")))
        let _r: bool = write_text(g + ".rc", s_itoa(rc) + "\n")
    } else {
        errln("unknown kind " + kind)
    }
}

# The files of `dir` named PREFIX.EXT, sorted, as the shell glob PREFIX.*.
function with_prefix(dir: string, prefix: string) -> ptr<ProcStrs> {
    let names: ptr<ProcStrs> = list_dir(dir)
    sl_sort(names, false)
    let found: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(names) {
        if s_starts(sl_get(names, i), prefix + ".") {
            sl_push(found, dir + "/" + sl_get(names, i))
        }
        i = i + 1
    }
    return found
}

function main() -> i32 {
    let repo: string = tr_enter_root()
    let here: string = repo + "/tests/mlir_commands"
    let exp: string = here + "/expected"
    let args: ptr<ProcStrs> = tr_args()
    let mut record: bool = false
    let mut root: string = repo
    let mut only: ptr<ProcStrs> = sl_new()
    if sl_len(args) > 0 {
        let a: string = sl_get(args, 0)
        if s_eq(a, "--record") {
            if sl_len(args) < 2 or s_len(sl_get(args, 1)) == 0 {
                errln("usage: ./flow tool tests/mlir_commands/run.flow --record ROOT")
                cli_exit(1)
            }
            record = true
            root = abs_dir_physical(sl_get(args, 1))
            if s_len(root) == 0 {
                errln("cannot cd to " + sl_get(args, 1))
                cli_exit(1)
            }
            only = sl_tail(args, 2)
        } elif s_eq(a, "--only") {
            only = sl_tail(args, 1)
        } elif s_len(a) > 0 {
            errln(USAGE)
            cli_exit(2)
        }
    }
    ROOT = root

    if s_len(env("LLVM_PATH")) == 0 and have("brew") {
        let bc: ptr<ProcCmd> = cmd(sl_of3("brew", "--prefix", "llvm"))
        cmd_quiet_err(bc)
        let p: string = capture(bc)
        if s_len(p) > 0 and is_exec(p + "/bin/mlir-opt") {
            env_set("LLVM_PATH", p + "/bin")
        }
    }

    WORK = tr_workdir("flow-mlir-commands")
    if not record {
        let nopy: string = WORK + "/nopy"
        let _n: bool = mkdir_p(nopy)
        tr_stub(nopy, "python3", "echo \"python invoked: $0 $*\" >&2\nexit 127\n")
        tr_stub(nopy, "python", "echo \"python invoked: $0 $*\" >&2\nexit 127\n")
        tr_path_prepend(nopy)
    } else {
        let _e: bool = mkdir_p(exp)
    }
    JIT_RT = env_or("FLOW_JIT_LINK_RUNTIME_OVERRIDE", "0")
    env_set("FLOW_JIT_LINK_RUNTIME", JIT_RT)
    compile_patterns()

    let mut pass: i32 = 0
    let mut fail: i32 = 0
    let failed: ptr<ProcStrs> = sl_new()
    let lines: ptr<ProcStrs> = s_lines(read_text(here + "/cases.txt"))
    let mut li: i32 = 0
    while li < sl_len(lines) {
        let words: ptr<ProcStrs> = s_words(sl_get(lines, li))
        li = li + 1
        if sl_len(words) == 0 or s_starts(sl_get(words, 0), "#") {
            continue
        }
        let name: string = sl_get(words, 0)
        let mut kind: string = ""
        if sl_len(words) > 1 {
            kind = sl_get(words, 1)
        }
        if sl_len(only) > 0 and not sl_has(only, name) {
            continue
        }
        if record and s_ends(name, "_rt") {
            continue
        }
        run_case(root, name, kind, sl_tail(words, 2))
        let mut gold: string = name
        if s_ends(name, "_rt") {
            gold = s_slice(name, 0, s_len(name) - 3)
        }
        let got: ptr<ProcStrs> = with_prefix(WORK + "/got", name)
        if record {
            let old: ptr<ProcStrs> = with_prefix(exp, name)
            let mut k: i32 = 0
            while k < sl_len(old) {
                rm_f(sl_get(old, k))
                k = k + 1
            }
            k = 0
            while k < sl_len(got) {
                let _c: bool = copy_file(sl_get(got, k), exp + "/" + path_basename(sl_get(got, k)))
                k = k + 1
            }
            outln("recorded " + name + " (rc=" + s_chomp_all(read_text(WORK + "/got/" + name + ".rc")) + ")")
            continue
        }
        let mut ok: bool = true
        let want: ptr<ProcStrs> = with_prefix(exp, gold)
        if sl_len(want) == 0 {
            ok = false
        }
        let mut k: i32 = 0
        while k < sl_len(want) {
            let f: string = sl_get(want, k)
            k = k + 1
            let ext: string = path_ext(f)
            let have: string = WORK + "/got/" + name + "." + ext
            if not tr_same(f, have) {
                ok = false
                errln("FAIL " + name + ": " + ext + " differs")
                let dc: ptr<ProcCmd> = cmd(sl_of3("diff", f, have))
                cmd_merge_err(dc)
                errs(tr_head(capture_raw(dc), 15))
            }
        }
        k = 0
        while k < sl_len(got) {
            let ext: string = path_ext(sl_get(got, k))
            k = k + 1
            if not exists(exp + "/" + gold + "." + ext) {
                ok = false
                errln("FAIL " + name + ": unexpected " + ext + " output")
            }
        }
        if ok {
            pass = pass + 1
        } else {
            fail = fail + 1
            sl_push(failed, name)
            let logl: ptr<ProcStrs> = s_lines(read_text(WORK + "/case/" + name + "/log"))
            let mut shown: i32 = 0
            let mut q: i32 = 0
            while q < sl_len(logl) and shown < 3 {
                if s_contains(sl_get(logl, q), "python invoked") or s_contains(sl_get(logl, q), "flowc mlir") {
                    errln(sl_get(logl, q))
                    shown = shown + 1
                }
                q = q + 1
            }
        }
    }

    if record {
        cli_exit(0)
    }
    outln("mlir_commands: pass=" + s_itoa(pass) + " fail=" + s_itoa(fail))
    if fail != 0 {
        outln("failed: " + sl_join(failed, " "))
        cli_exit(1)
    }
    cli_exit(0)
    return 0
}
