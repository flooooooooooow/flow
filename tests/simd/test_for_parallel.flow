# Test for loops and parallel constructs

function test_for_loop(n: i32) -> i32 {
    for i in 0..n {
        let x: i32 = i * 2
    }
    return 0
}

function test_parallel_for(arr: array<f32>, n: i32) -> i32 {
    parallel for i in 0..n {
        arr[i] = arr[i] * 2.0
    }
    return 0
}

function main() -> i32 {
    print("For loop test")
    let result: i32 = test_for_loop(10)
    print(result)
    return 0
}
