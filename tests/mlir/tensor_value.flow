# Tensor values use a fresh tensor destination for elementwise operations.

extern {
    function tensor_add(a: tensor_f32, b: tensor_f32) -> tensor_f32
    function tensor_sub(a: tensor_f32, b: tensor_f32) -> tensor_f32
    function tensor_mul(a: tensor_f32, b: tensor_f32) -> tensor_f32
    function tensor_div(a: tensor_f32, b: tensor_f32) -> tensor_f32
}

function ops(a: tensor_f32, b: tensor_f32) -> tensor_f32 {
    let x: tensor_f32 = tensor_add(a, b)
    let y: tensor_f32 = tensor_sub(x, b)
    let z: tensor_f32 = tensor_mul(y, b)
    return tensor_div(z, b)
}
