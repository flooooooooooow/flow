Flow C compile flags (MISRA Phase 0):
  cflags:  -std=c11 -D_DEFAULT_SOURCE -Wall -Wextra -Wno-unused-function -Wno-unused-variable -Wno-unused-parameter -Wno-error=implicit-function-declaration -Wno-error=int-conversion -fsanitize=undefined -fno-sanitize-recover=all -g -fno-omit-frame-pointer -DX=1
  ldflags: -fsanitize=undefined
  profile: default
  opt:     -O3 (override with FLOW_OPT_LEVEL=0|1|2|3|s)
  sanitize: UBSAN=1 ASAN=0 TSAN=0 FLOW_SANITIZE=
