Flow C compile flags (MISRA Phase 0):
  cflags:  -std=c11 -D_DEFAULT_SOURCE -Wall -Wextra -Wno-unused-function -Wno-unused-variable -Wno-unused-parameter -Wno-error=implicit-function-declaration -Wno-error=int-conversion -Werror -Werror=implicit-function-declaration -Wno-strict-prototypes -Wno-c23-extensions -Wno-format -fsanitize=undefined -fno-sanitize-recover=all -g -fno-omit-frame-pointer -fsanitize=address -g -fno-omit-frame-pointer
  ldflags: -fsanitize=undefined -fsanitize=address
  profile: safety
  opt:     -O2 (override with FLOW_OPT_LEVEL=0|1|2|3|s)
  sanitize: UBSAN=1 ASAN=1 TSAN=0 FLOW_SANITIZE=ub,asan
