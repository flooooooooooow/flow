{"jsonrpc": "2.0", "id": 13, "result": [{"label": "generations", "kind": 14, "detail": "GA setting", "documentation": "GA generations (default 20, max 32)."}, {"label": "get_note_count", "kind": 3, "detail": "(reader: ptr<NotationReader>) -> i32", "documentation": "stdlib: lib/stdlib/audio/notation.flow"}, {"label": "get_note", "kind": 3, "detail": "(reader: ptr<NotationReader>, idx: i32) -> MusicNote", "documentation": "stdlib: lib/stdlib/audio/notation.flow"}, {"label": "gemm", "kind": 3, "detail": "(A: Mat, B: Mat, C: Mat) -> void", "documentation": "============================================================================\nBLAS WRAPPERS (ergonomic API)\n============================================================================\n\nMatrix product via BLAS dgemm: C = A @ B.\nShapes: A (m\u00d7k), B (k\u00d7n), C (m\u00d7n). Overwrites C.\n\nstdlib: lib/stdlib/blas.flow"}, {"label": "gemm_alpha_beta", "kind": 3, "detail": "(alpha: f64, A: Mat, B: Mat, beta: f64, C: Mat) -> void", "documentation": "Scaled GEMM: C = alpha * A @ B + beta * C (BLAS dgemm).\n\nstdlib: lib/stdlib/blas.flow"}, {"label": "gemv", "kind": 3, "detail": "(A: Mat, x: ptr<f64>, y: ptr<f64>) -> void", "documentation": "Matrix-vector product via BLAS dgemv: y = A @ x.\n\nstdlib: lib/stdlib/blas.flow"}, {"label": "getrf", "kind": 3, "detail": "(A: Mat, pivots: ptr<i32>) -> i32", "documentation": "In-place LU factorization via LAPACK dgetrf. Overwrites A with L/U factors.\npivots must point at at least min(A.rows, A.cols) i32 slots (max 1024 here).\nReturns LAPACK info (0 = success).\n\nstdlib: lib/stdlib/blas.flow"}, {"label": "get_time", "kind": 3, "detail": "() -> f64", "documentation": "stdlib: lib/stdlib/time.flow"}]}
