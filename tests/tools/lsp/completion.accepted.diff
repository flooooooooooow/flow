ions\n\nShort alias for dual_sigmoid.\n\nstdlib: lib/stdlib/autodiff.flow"}, {"label": "sinD", "kind": 3, "detail": "(x: Dual) -> Dual", "documentation": "Dual sine alias (avoids shadowing C sin).\n\nstdlib: lib/stdlib/autodiff.flow"}, {"label": "sq", "kind": 3, "detail": "(x: Dual) -> Dual", "documentation": "=============================================================================\nCOMBINED OPERATIONS - Common patterns in one call\n=============================================================================\n\nDual square x\u00b2.\n\nstdlib: lib/stdlib/autodiff.flow"}, {"label": "sq_diff", "kind": 3, "detail": "(x: Dual, c: f32) -> Dual", "documentation": "Squared residual (x \u2212 c)\u00b2 for constant c.\n\nstdlib: lib/stdlib/autodiff.flow"}, {"label": "sin_scaled", "kind": 3, "detail": "(x: Dual, a: f32) -> Dual", "documentation": "Dual sin(a*x) for constant scale a.\n\nstdlib: lib/stdlib/autodiff.flow"}, {"label": "sum3", "kind": 3, "detail": "(a: Dual, b: Dual, c: Dual) -> Dual", "documentation": "Sum of three Dual values (and their gradients).\n\nstdlib: lib/stdlib/autodiff.flow"}, {"label": "scal", "kind": 3, "detail": "(alpha: f64, x: ptr<ptr_f64>, n: i32) -> void", "documentation": "BLAS dscal: scale vector in place, x = alpha * x.\n\nstdlib: lib/stdlib/blas.flow"}, {"label": "solve", "kind": 3, "detail": "(A: Mat, b: ptr<ptr_f64>, x: ptr<ptr_f64>) -> i32", "documentation": "============================================================================\nLAPACK WRAPPERS\n============================================================================\n\nSolve A x = b via LAPACK (LU). Writes solution to x.\nReturns 0 on success; non-zero info on failure. A is not modified.\n\nstdlib: lib/stdlib/blas.flow"}, {"label": "scan_f32", "kind": 3, "detail": "(arr: ptr<ptr_f32>, n: i32, init: f32, f: fn_f32_f32__f32<f32, f32>) -> ptr<ptr_f32>", "documentation": "Prefix scan: out[0] = init, out[i] = f(out[i-1], arr[i]).\n\nstdlib: lib/stdlib/dsp.flow"}, {"label": "scale_f32", "kind": 3, "detail": "(arr: ptr<ptr_f32>, n: i32, gain: f32) -> ptr<ptr_f32>", "documentation": "Scale every element by a scalar gain.\n\nstdlib: lib/stdlib/dsp.flow"}, {"label": "sum_f32", "kind": 3, "detail": "(arr: ptr<ptr_f32>, n: i32) -> f32", "documentation": "Sum all elements.\n\nstdlib: lib/stdlib/dsp.flow"}, {"label": "scan_f64", "kind": 3, "detail": "(arr: ptr<ptr_f64>, n: i32, init: f64, f: fn_f64_f64__f64<f64, f64>) -> ptr<ptr_f64>", "documentation": "stdlib: lib/stdlib/dsp.flow"}, {"label": "scale_f64", "kind": 3, "detail": "(arr: ptr<ptr_f64>, n: i32, gain: f64) -> ptr<ptr_f64>", "documentation": "stdlib: lib/stdlib/dsp.flow"}, {"label": "sum_f64", "kind": 3, "detail": "(arr: ptr<ptr_f64>, n: i32) -> f64", "documentation": "stdlib: lib/stdlib/dsp.flow"}, {"label": "state_step", "kind": 3, "detail": "(sys: DynamicalSystem, x: ptr<ptr_f64>, u: ptr<ptr_f64>, x_next: ptr<ptr_f64>) -> void", "documentation": "One discrete step: x_next = A x + B u.\n\nstdlib: lib/stdlib/dynamics/state_space.flow"}, {"label": "subtract", "kind": 3, "detail": "(a: f32, b: f32) -> f32", "documentation": "Subtract two f32 values: a - b.\n\nstdlib: lib/stdlib/math.flow"}, {"label": "sizeof_i8", "kind": 3, "detail": "() -> i64", "documentation": "\u2500\u2500 Sizes \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nstdlib: lib/stdlib/memory.flow"}, {"label": "sizeof_i32", "kind": 3, "detail": "() -> i64", "documentation": "stdlib: lib/stdlib/memory.flow"}, {"label": "sizeof_i64", "kind": 3, "detail": "() -> i64", "documentation": "stdlib: lib/stdlib/memory.flow"}, {"label": "sizeof_f32", "kind": 3, "detail": "() -> i64", "documentation": "stdlib: lib/stdlib/memory.flow"}, {"label": "sizeof_f64", "kind": 3, "detail": "() -> i64", "documentation": "stdlib: lib/stdlib/memory.flow"}, {"label": "sizeof_ptr", "kind": 3, "detail": "() -> i64", "documentation": "stdlib: lib/stdlib/memory.flow"}, {"label": "stack_array_i32", "kind": 3, "detail": "(count: i32) -> i32", "documentation": "stdlib: lib/stdlib/memory_simple.flow"}, {"label": "stack_array_f32", "kind": 3, "detail": "(count: i32) -> i32", "documentation": "stdlib: lib/stdlib/memory_simple.flow"}, {"label": "str_eq", "kind": 3, "detail": "(a: string, b: string) -> bool", "documentation": "stdlib: lib/stdlib/process.flow"}, {"label": "signal_new", "kind": 3, "detail": "(length: i32, rate: u32) -> Signal_R<R>", "documentation": "Create a new signal with the given rate marker and runtime sample rate.\nThe rate parameter populates the runtime field; R provides compile-time safety.\n\nstdlib: lib/stdlib/rf.flow"}, {"label": "signal_free", "kind": 3, "detail": "(s: Signal_R<R>) -> void", "documentation": "stdlib: lib/stdlib/rf.flow"}, {"label": "signal_rate", "kind": 3, "detail": "(s: Signal_R<R>) -> u32", "documentation": "stdlib: lib/stdlib/rf.flow"}, {"label": "signal_length", "kind": 3, "detail": "(s: Signal_R<R>) -> i32", "documentation": "stdlib: lib/stdlib/rf.flow"}, {"label": "signal_set", "kind": 3, "detail": "(s: Signal_R<R>, index: i32, value: c64) -> void", "documentation": "=============================================================================\nSignal operations\n=============================================================================\n\nstdlib: lib/stdlib/rf.flow"}, {"label": "signal_get", "kind": 3, "detail": "(s: Signal_R<R>, index: i32) -> c64", "documentation": "stdlib: lib/stdlib/rf.flow"}, {"label": "signal_mix", "kind": 3, "detail": "(a: Signal_R<R>, b: Signal_R<R>) -> Signal_R<R>", "documentation": "Mix two signals: multiply sample-by-sample. Both signals must have\nthe same rate type R. This is enforced at compile time.\n\nstdlib: lib/stdlib/rf.flow"}, {"label": "signal_scale", "kind": 3, "detail": "(s: Signal_R<R>, gain: f32) -> void", "documentation": "Scale a signal by a real scalar (amplitude gain).\n\nstdlib: lib/stdlib/rf.flow"}, {"label": "signal_magnitude_spectrum", "kind": 3, "detail": "(s: Signal_R<R>, out: ptr<ptr_f64>) -> void", "documentation": "Compute the magnitude spectrum (|X[k]|) of a signal.\nUses a naive DFT: O(N^2). Fine for small N; use FFT for real work.\n\nstdlib: lib/stdlib/rf.flow"}, {"label": "sort_scratch", "kind": 3, "detail": "(n: i64) -> span_mut_i32", "documentation": "A mutable view of the first `n` elements of the merge scratch.\nReturns a zero-length span when `n` exceeds the documented capacity, which\nevery caller checks before relying on it.\n\nstdlib: lib/stdlib/sorting/core.flow"}, {"label": "sort_tags", "kind": 3, "detail": "(n: i64) -> span_mut_i32", "documentation": "A mutable view of the first `n` elements of the tag scratch.\n\nstdlib: lib/stdlib/sorting/core.flow"}, {"label": "sort_counts", "kind": 3, "detail": "(k: i64) -> span_mut_i32", "documentation": "A mutable view of the first `k` histogram slots, zeroed.\n\nstdlib: lib/stdlib/sorting/core.flow"}, {"label": "sort_swap", "kind": 3, "detail": "(xs: span_mut_i32, i: i64, j: i64) -> void", "documentation": "--------------------------------------------------------------------------\nElement moves\n--------------------------------------------------------------------------\n\nExchange two elements. `@inline` earns its place here: it is the innermost\noperation of nine algorithms, and at -O2 the call overhead would otherwise\ndominate bubble and selection sort. Measured: see docs/library/sorting.md.\n\nstdlib: lib/stdlib/sorting/core.flow"}, {"label": "sort_reverse", "kind": 3, "detail": "(xs: span_mut_i32) -> void", "documentation": "Reverse in place. Used by the descending wrappers and by the adversarial\ninput generators in the test harness.\n\nstdlib: lib/stdlib/sorting/core.flow"}, {"label": "sort_copy", "kind": 3, "detail": "(dst: span_mut_i32, src: span_const_i32) -> void", "documentation": "Copy `src` over `dst`, element for element. Both are spans, so the lengths\ntravel with the data and the shorter one bounds the copy.\n\nstdlib: lib/stdlib/sorting/core.flow"}, {"label": "spans_equal", "kind": 3, "detail": "(a: span_const_i32, b: span_const_i32) -> bool", "documentation": "Do two spans hold the same elements in the same order?\n\nstdlib: lib/stdlib/sorting/core.flow"}, {"label": "span_min", "kind": 3, "detail": "(xs: span_const_i32) -> i32", "documentation": "Smallest and largest element. Returns 0 for an empty span; callers that care\ncheck `.len` first.\n\nstdlib: lib/stdlib/sorting/core.flow"}, {"label": "span_max", "kind": 3, "detail": "(xs: span_const_i32) -> i32", "documentation": "stdlib: lib/stdlib/sorting/core.flow"}, {"label": "shuffle", "kind": 3, "detail": "(xs: span_mut_i32) -> void", "documentation": "Fisher-Yates over a span, drawing from the LCG above.\n\nstdlib: lib/stdlib/sorting/core.flow"}, {"label": "shell_sort", "kind": 3, "detail": "(xs: span_mut_i32) -> void", "documentation": "stdlib: lib/stdlib/sorting/gapped.flow"}, {"label": "selection_sort", "kind": 3, "detail": "(xs: span_mut_i32) -> void", "documentation": "---------------------------------------------------------------------------\nselection_sort\n  NOT stable (the long-range swap jumps an equal element over its peers)\n  best O(n^2)   average O(n^2)   worst O(n^2)   extra space O(1)\n  moves: exactly n - 1 swaps, which is its one virtue.\n  Pick it when: a write is enormously more expensive than a read, e.g.\n  sorting records in flash memory with a limited erase budget. Otherwise\n  never; insertion sort beats it on every input shape measured here.\n  For a stable version, see stable_selection_sort in stable.flow.\n---------------------------------------------------------------------------\n\nstdlib: lib/stdlib/sorting/quadratic.flow"}, {"label": "spice_node", "kind": 3, "detail": "(name: string) -> i32", "documentation": "Look up a node by name from outside the parser.\n\nstdlib: lib/stdlib/spice.flow"}, {"label": "spice_node_count", "kind": 3, "detail": "() -> i32", "documentation": "stdlib: lib/stdlib/spice.flow"}, {"label": "spice_source", "kind": 3, "detail": "(name: string) -> i32", "documentation": "Element index of a named source, or -1.\n\nstdlib: lib/stdlib/spice.flow"}, {"label": "spice_load", "kind": 3, "detail": "(path: string) -> bool", "documentation": "Read a deck from disk. Returns false if the file is missing or larger than\nSPICE_MAX_TEXT.\n\nstdlib: lib/stdlib/spice.flow"}, {"label": "spice_parse", "kind": 3, "detail": "() -> bool", "documentation": "---------------------------------------------------------------------------\nThe deck\n---------------------------------------------------------------------------\n\nParse the loaded deck into stdlib/circuit.flow, then finalize it. The first\nnon-blank line is the title, as SPICE requires.\n\nstdlib: lib/stdlib/spice.flow"}, {"label": "spice_error_line", "kind": 3, "detail": "() -> i32", "documentation": "stdlib: lib/stdlib/spice.flow"}, {"label": "spice_skipped", "kind": 3, "detail": "() -> i32", "documentation": "stdlib: lib/stdlib/spice.flow"}, {"label": "spice_has_tran", "kind": 3, "detail": "() -> bool", "documentation": "stdlib: lib/stdlib/spice.flow"}, {"label": "spice_tstep", "kind": 3, "detail": "() -> f64", "documentation": "stdlib: lib/stdlib/spice.flow"}, {"label": "spice_tstop", "kind": 3, "detail": "() -> f64", "documentation": "stdlib: lib/stdlib/spice.flow"}, {"label": "spice_uic", "kind": 3, "detail": "() -> bool", "documentation": "stdlib: lib/stdlib/spice.flow"}, {"label": "spice_has_dc", "kind": 3, "detail": "() -> bool", "documentation": "stdlib: lib/stdlib/spice.flow"}, {"label": "spice_dc_source", "kind": 3, "detail": "() -> i32", "documentation": "stdlib: lib/stdlib/spice.flow"}, {"label": "spice_dc_start", "kind": 3, "detail": "() -> f64", "documentation": "stdli