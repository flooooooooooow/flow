# The GIF encoder for recordings (scripts/tools/frames_to_gif, behind
# `flow record --gif`) on tiny generated frames.
#
# Writes 8x6 binary PPM frames (left half one colour, right half another),
# encodes them, and decodes the GIF with scripts/tools/gif_check: screen
# size, loop extension, frame count, and per frame the delay, the disposal
# and the composited colours of the first and last pixel. Also checks the
# summary line, the no-frames error and an argument error. No Python.
#
# Usage: ./flow tool tests/tools/frames_to_gif/run.flow

import "tools/flow_cli/sys.flow"
import "scripts/tools/lib/bgproc.flow"
import std.process { ProcCmd, ProcResult, ProcStrs, proc_cmd, proc_arg, proc_stdin, proc_stdout, proc_stderr, proc_run, proc_chdir, PROC_CAPTURE, PROC_NULL, PROC_INHERIT }

extern {
    function malloc(size: i64) -> ptr<void>
}

struct Ctx {
    root: string,
    work: string,
    gif_check: string,
    pass: i32,
    fail: i32
}

let mut CTX: ptr<Ctx> = null

function ok(name: string) {
    let c: ptr<Ctx> = CTX
    outln("PASS frames_to_gif/" + name)
    c.pass = c.pass + 1
}

function bad(name: string) {
    let c: ptr<Ctx> = CTX
    outln("FAIL frames_to_gif/" + name)
    c.fail = c.fail + 1
}

function status_of(r: ptr<ProcResult>) -> i32 {
    if s_len(r.error) > 0 {
        return 127
    }
    if r.exit_code < 0 {
        return 128 - r.exit_code
    }
    return r.exit_code
}

# The path of a tool binary built by `flow tool --path`; stops the run when
# the build fails.
function tool_path(name: string) -> string {
    let c: ptr<Ctx> = CTX
    let b: ptr<ProcCmd> = proc_cmd(c.root + "/flow")
    proc_arg(b, "tool")
    proc_arg(b, "--path")
    proc_arg(b, name)
    proc_stdout(b, PROC_CAPTURE)
    proc_stderr(b, PROC_INHERIT)
    let r: ptr<ProcResult> = proc_run(b)
    if status_of(r) != 0 {
        cli_exit(status_of(r))
    }
    return s_chomp_all(r.stdout)
}

# The encoder: `./flow tool frames_to_gif`.
function encoder() -> ptr<ProcCmd> {
    let c: ptr<Ctx> = CTX
    let e: ptr<ProcCmd> = proc_cmd(c.root + "/flow")
    proc_arg(e, "tool")
    proc_arg(e, "frames_to_gif")
    return e
}

# frame FILE r1 g1 b1 r2 g2 b2: 8x6, columns 0-3 colour 1, 4-7 colour 2.
function frame(path: string, rgb: ptr<i32>) {
    let head: string = "P6\n8 6\n255\n"
    let hn: i32 = s_len(head)
    let n: i32 = hn + 8 * 6 * 3
    let buf: ptr<u8> = malloc(n as i64) as ptr<u8>
    let mut i: i32 = 0
    while i < hn {
        buf[i] = s_byte(head, i) as u8
        i = i + 1
    }
    let mut y: i32 = 0
    while y < 6 {
        let mut x: i32 = 0
        while x < 8 {
            let mut base: i32 = 0
            if x >= 4 {
                base = 3
            }
            let at: i32 = hn + (y * 8 + x) * 3
            buf[at] = rgb[base] as u8
            buf[at + 1] = rgb[base + 1] as u8
            buf[at + 2] = rgb[base + 2] as u8
            x = x + 1
        }
        y = y + 1
    }
    let _w: bool = bg_write_file(path, buf, n as i64)
}

function frame_of(path: string, colours: string) {
    let w: ptr<ProcStrs> = s_words(colours)
    let rgb: ptr<i32> = malloc(24) as ptr<i32>
    let mut i: i32 = 0
    while i < 6 {
        rgb[i] = s_atoi(sl_get(w, i), 0)
        i = i + 1
    }
    frame(path, rgb)
}

# True for a gif_check report line the comparison keeps.
function report_line(l: string) -> bool {
    let keys: ptr<ProcStrs> = s_words("format= width= height= frame= frames= decoded= loop=")
    let mut i: i32 = 0
    while i < sl_len(keys) {
        if s_starts(l, sl_get(keys, i)) {
            return true
        }
        i = i + 1
    }
    return false
}

# check_gif FILE W H FRAMES DELAY_CS DISPOSAL PIXELS: gif_check's report
# against the expectation. PIXELS has one line per frame, six numbers: the
# RGB of the first pixel and of the last. Returns the text to show on
# failure, "" on success.
function check_gif(file: string, w: string, h: string, n: string, delay: string, disp: string, pixels: string) -> string {
    let c: ptr<Ctx> = CTX
    let gc: ptr<ProcCmd> = proc_cmd(c.gif_check)
    proc_arg(gc, file)
    proc_arg(gc, "0")
    proc_arg(gc, "0")
    proc_stdout(gc, PROC_CAPTURE)
    proc_stderr(gc, PROC_INHERIT)
    let r: ptr<ProcResult> = proc_run(gc)
    if status_of(r) != 0 {
        return "gif_check failed\n"
    }
    let mut want: string = "format=GIF\nwidth=" + w + "\nheight=" + h + "\n"
    let rows: ptr<ProcStrs> = s_lines(pixels)
    let mut i: i32 = 0
    while i < sl_len(rows) {
        let p: ptr<ProcStrs> = s_words(sl_get(rows, i))
        want = want + "frame=" + s_itoa(i) + " delay_cs=" + delay + " disposal=" + disp
        want = want + " first=" + sl_get(p, 0) + "," + sl_get(p, 1) + "," + sl_get(p, 2)
        want = want + " last=" + sl_get(p, 3) + "," + sl_get(p, 4) + "," + sl_get(p, 5) + "\n"
        i = i + 1
    }
    want = want + "frames=" + n + "\ndecoded=" + n + "\nloop=0\n"
    let mut got: string = ""
    let lines: ptr<ProcStrs> = s_lines(s_chomp_all(r.stdout))
    let mut j: i32 = 0
    while j < sl_len(lines) {
        if report_line(sl_get(lines, j)) {
            got = got + sl_get(lines, j) + "\n"
        }
        j = j + 1
    }
    if s_eq(want, got) {
        return ""
    }
    let _w1: bool = write_text(file + ".want", want)
    let _w2: bool = write_text(file + ".got", got)
    let d: ptr<ProcCmd> = proc_cmd("diff")
    proc_arg(d, "-u")
    proc_arg(d, file + ".want")
    proc_arg(d, file + ".got")
    proc_stdout(d, PROC_CAPTURE)
    let rd: ptr<ProcResult> = proc_run(d)
    return rd.stdout
}

# case NAME EXPECTED_STDOUT CHECK... -- ENCODER_ARGS...
function case_gif(name: string, want: string, check: ptr<ProcStrs>, args: ptr<ProcStrs>) {
    let c: ptr<Ctx> = CTX
    let e: ptr<ProcCmd> = encoder()
    let mut i: i32 = 0
    while i < sl_len(args) {
        proc_arg(e, sl_get(args, i))
        i = i + 1
    }
    proc_stdout(e, PROC_CAPTURE)
    proc_stderr(e, PROC_CAPTURE)
    let r: ptr<ProcResult> = proc_run(e)
    let rc: i32 = status_of(r)
    let got: string = s_chomp_all(r.stdout)
    if rc != 0 {
        bad(name)
        outln("  exit " + s_itoa(rc))
        out(r.stderr)
        return
    }
    if not s_eq(got, want) {
        bad(name)
        outln("  stdout: " + got)
        outln("  wanted: " + want)
        return
    }
    let report: string = check_gif(sl_get(check, 0), sl_get(check, 1), sl_get(check, 2), sl_get(check, 3), sl_get(check, 4), sl_get(check, 5), sl_get(check, 6))
    if s_len(report) == 0 {
        ok(name)
    } else {
        bad(name)
        out(report)
    }
}

function strs(text: string) -> ptr<ProcStrs> {
    return s_words(text)
}

function main() -> i32 {
    let c: ptr<Ctx> = malloc(48) as ptr<Ctx>
    CTX = c
    c.root = env_or("FLOW_REPO_ROOT", cwd_logical())
    let _cd: bool = proc_chdir(c.root)
    env_set("PWD", c.root)
    c.pass = 0
    c.fail = 0
    let raw: string = mktemp_dir(env_or("TMPDIR", "/tmp") + "/flow-frames-to-gif.XXXXXX")
    on_exit_remove(raw)
    # The tool prints the output path normalised; so must the expectations.
    let work: string = path_norm_abs(raw)
    c.work = work

    let _enc: string = tool_path("frames_to_gif")
    c.gif_check = tool_path("gif_check")

    let _m1: bool = mkdir_p(work + "/frames")
    let _m2: bool = mkdir_p(work + "/empty")
    frame_of(work + "/frames/frame_00000.ppm", "255 0 0 0 0 255")
    frame_of(work + "/frames/frame_00001.ppm", "0 255 0 255 255 0")
    frame_of(work + "/frames/frame_00002.ppm", "0 0 255 255 255 255")
    frame_of(work + "/frames/frame_00003.ppm", "40 80 120 200 100 50")
    # Not a frame: the glob is frame_*.ppm.
    frame_of(work + "/frames/other.ppm", "1 2 3 4 5 6")

    let all: string = "255 0 0 0 0 255\n0 255 0 255 255 0\n0 0 255 255 255 255\n40 80 120 200 100 50\n"
    let even: string = "255 0 0 0 0 255\n0 0 255 255 255 255\n"

    # Every frame, 10 fps: 100 ms is 10 cs.
    let a_check: ptr<ProcStrs> = strs(work + "/all.gif 8 6 4 10 2")
    sl_push(a_check, all)
    case_gif("all", work + "/all.gif: 4 frames, 8x6, 0 KB", a_check, strs(work + "/frames " + work + "/all.gif --fps 10 --stride 1"))

    # Every second frame at 50 fps: the delay floor is 20 ms.
    let s_check: ptr<ProcStrs> = strs(work + "/sub/even.gif 8 6 2 2 2")
    sl_push(s_check, even)
    case_gif("stride", work + "/sub/even.gif: 2 frames, 8x6, 0 KB", s_check, strs(work + "/frames " + work + "/sub/even.gif --fps=50 --stride 2"))

    # Downscale to 4 wide: height round(6 * 4 / 8) = 3, halves kept.
    let w_check: ptr<ProcStrs> = strs(work + "/small.gif 4 3 4 5 2")
    sl_push(w_check, all)
    case_gif("width", work + "/small.gif: 4 frames, 4x3, 0 KB", w_check, strs(work + "/frames " + work + "/small.gif --stride 1 --width 4"))

    # No frames: exit 1 and the message.
    let e1: ptr<ProcCmd> = encoder()
    proc_arg(e1, work + "/empty")
    proc_arg(e1, work + "/none.gif")
    proc_stdout(e1, PROC_NULL)
    proc_stderr(e1, PROC_CAPTURE)
    let r1: ptr<ProcResult> = proc_run(e1)
    let rc1: i32 = status_of(r1)
    if rc1 == 1 and s_eq(s_chomp_all(r1.stderr), "frames_to_gif: no frames in " + work + "/empty") and not exists(work + "/none.gif") {
        ok("empty")
    } else {
        bad("empty")
        outln("  exit " + s_itoa(rc1))
        out(r1.stderr)
    }

    # A bad option value: argparse's exit 2 and error line.
    let e2: ptr<ProcCmd> = encoder()
    proc_arg(e2, work + "/frames")
    proc_arg(e2, work + "/x.gif")
    proc_arg(e2, "--fps")
    proc_arg(e2, "abc")
    proc_stdout(e2, PROC_NULL)
    proc_stderr(e2, PROC_CAPTURE)
    let r2: ptr<ProcResult> = proc_run(e2)
    let rc2: i32 = status_of(r2)
    let lines: ptr<ProcStrs> = s_lines(r2.stderr)
    if rc2 == 2 and sl_has(lines, "flow tool frames_to_gif: error: argument --fps: invalid int value: 'abc'") {
        ok("bad-arg")
    } else {
        bad("bad-arg")
        outln("  exit " + s_itoa(rc2))
        out(r2.stderr)
    }

    outln("frames_to_gif: " + s_itoa(c.pass) + " passed, " + s_itoa(c.fail) + " failed")
    if c.fail > 0 {
        cli_exit(1)
    }
    cli_exit(0)
    return 0
}
