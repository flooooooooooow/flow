# Exchange tests for the two network tools written in Flow:
#
#   scripts/tools/playground_server  (./flow tool playground_server)
#   scripts/tools/ws_echo_relay      (./flow tool ws_echo_relay)
#
# Each server is started on a free high port, driven with real requests,
# and stopped by PID. Replies are compared with goldens in
# tests/tools/net/expected, recorded from the Python servers these tools
# replaced, by pointing the runner at them through NET_TEST_PLAYGROUND and
# NET_TEST_RELAY (a command line each, split on blanks; the runner adds
# --port and the rest) with --update, before the Python was deleted.
#
# Playground replies are compared as status line, headers and body. Before
# the comparison the Server and Date headers are dropped (they name the
# implementation and the time), Content-Length is checked against the body
# and dropped, the generated C in "c_preview" is replaced by a marker, and
# the per-request temp directory is normalised. curl sends the ordinary
# requests; raw ones (HTTP/0.9, bad request lines, header edge cases) go
# over a plain TCP connection.
#
# The relay is driven by tests/tools/net/ws_client.js, a raw-socket client
# (masked frames, every payload length form, ping, pong, close, split
# frames, two clients at once, plain TCP echo). It needs node; without node
# the relay half is skipped with a message.
#
# Usage:
#   ./flow tool tests/tools/net/run.flow            check
#   ./flow tool tests/tools/net/run.flow --update   rewrite the goldens

import "tools/flow_cli/sys.flow"
import "scripts/tools/lib/bgproc.flow"
import std.process { ProcCmd, ProcResult, ProcStrs, proc_cmd, proc_arg, proc_stdin, proc_stdout, proc_stderr, proc_run, proc_chdir, proc_sleep_ms, proc_now_ms, proc_pid, PROC_CAPTURE, PROC_NULL, PROC_INHERIT, PROC_MERGE }

extern {
    function malloc(size: i64) -> ptr<void>
}

struct Ctx {
    root: string,
    exp: string,
    work: string,
    update: bool,
    pass: i32,
    fail: i32,
    pids: ptr<ProcStrs>,
    port: i32,
    port2: i32,
    seed: i64
}

let mut CTX: ptr<Ctx> = null

function cleanup() {
    let c: ptr<Ctx> = CTX
    let mut i: i32 = 0
    while i < sl_len(c.pids) {
        let p: i32 = s_atoi(sl_get(c.pids, i), 0)
        let _k: bool = bg_kill(p, 15)
        let _w: i32 = bg_wait(p)
        i = i + 1
    }
}

function finish(code: i32) {
    cleanup()
    cli_exit(code)
}

function status_of(r: ptr<ProcResult>) -> i32 {
    if s_len(r.error) > 0 {
        return 127
    }
    if r.exit_code < 0 {
        return 128 - r.exit_code
    }
    return r.exit_code
}

# `diff -u a b | head -40 | cut -c1-300`
function show_diff(a: string, b: string) {
    let d: ptr<ProcCmd> = proc_cmd("diff")
    proc_arg(d, "-u")
    proc_arg(d, a)
    proc_arg(d, b)
    proc_stdout(d, PROC_CAPTURE)
    proc_stderr(d, PROC_INHERIT)
    let r: ptr<ProcResult> = proc_run(d)
    let lines: ptr<ProcStrs> = s_lines(r.stdout)
    let mut i: i32 = 0
    while i < sl_len(lines) and i < 40 {
        outln(s_slice(sl_get(lines, i), 0, 300))
        i = i + 1
    }
}

function check(name: string, expected: string, actual: string) {
    let c: ptr<Ctx> = CTX
    if c.update {
        let _c: bool = copy_file(actual, expected)
        outln("updated " + name)
        c.pass = c.pass + 1
    } elif same_bytes(expected, actual) {
        outln("PASS " + name)
        c.pass = c.pass + 1
    } else {
        outln("FAIL " + name)
        show_diff(expected, actual)
        c.fail = c.fail + 1
    }
}

# $RANDOM: 0..32767.
function random15() -> i32 {
    let c: ptr<Ctx> = CTX
    c.seed = (c.seed * 1103515245 + 12345) & 2147483647
    return ((c.seed >> 16) & 32767) as i32
}

# Start `argv` with a random free port substituted for PORT (and PORT2),
# and wait for its banner line containing `banner`. Sets port and port2.
function start_server(banner: string, log: string, argv: ptr<ProcStrs>) {
    let c: ptr<Ctx> = CTX
    let mut tries: i32 = 0
    while tries < 8 {
        tries = tries + 1
        c.port = 20000 + random15() % 40000
        c.port2 = c.port + 1
        let args: ptr<ProcStrs> = sl_new()
        let mut i: i32 = 0
        while i < sl_len(argv) {
            let a: string = s_replace(sl_get(argv, i), "PORT2", s_itoa(c.port2))
            sl_push(args, s_replace(a, "PORT", s_itoa(c.port)))
            i = i + 1
        }
        let p: BgProc = bg_start(args.items, "", false, log, log + ".err")
        let mut waited: i32 = 0
        while waited < 100 and p.pid > 0 {
            if s_contains(read_text(log), banner) {
                sl_push(c.pids, s_itoa(p.pid))
                return
            }
            if bg_poll(p.pid) != 0 - 1 {
                break
            }
            proc_sleep_ms(100)
            waited = waited + 1
        }
        if p.pid > 0 {
            let _k: bool = bg_kill(p.pid, 15)
            let _w: i32 = bg_wait(p.pid)
        }
    }
    errln("FAIL could not start: " + sl_join(argv, " "))
    errs(read_text(log + ".err"))
    finish(1)
}

# ---------------------------------------------------------------------------
# Reply normalisation
# ---------------------------------------------------------------------------

# [^/" \\] within one line.
function seg_char(ch: i32) -> bool {
    return ch != 47 and ch != 34 and ch != 32 and ch != 92 and ch != 10
}

function word_char(ch: i32) -> bool {
    return (ch >= 48 and ch <= 57) or (ch >= 65 and ch <= 90) or (ch >= 97 and ch <= 122) or ch == 95
}

# End of "/flow-playground-" plus eight [A-Za-z0-9_] at `i`, or -1.
function playground_dir_end(s: string, i: i32) -> i32 {
    let key: string = "/flow-playground-"
    if not s_eq(s_slice(s, i, i + s_len(key)), key) {
        return 0 - 1
    }
    let j: i32 = i + s_len(key)
    let mut k: i32 = j
    while k < j + 8 {
        if k >= s_len(s) or not word_char(s_byte(s, k)) {
            return 0 - 1
        }
        k = k + 1
    }
    return k
}

# s#(/[^/" \\]+)*/flow-playground-[A-Za-z0-9_]{8}#TMP/flow-playground-X#g,
# leftmost-longest as sed -E matches.
function norm_playground_dirs(s: string) -> string {
    let n: i32 = s_len(s)
    let mut out_s: string = ""
    let mut pos: i32 = 0
    let mut i: i32 = 0
    while i < n {
        if s_byte(s, i) != 47 {
            i = i + 1
            continue
        }
        # Follow the chain of segments from this slash; the match ends at
        # the last /flow-playground-XXXXXXXX boundary the chain reaches.
        let mut best: i32 = 0 - 1
        let mut b: i32 = i
        while b < n and s_byte(s, b) == 47 {
            let e: i32 = playground_dir_end(s, b)
            if e > best {
                best = e
            }
            let mut k: i32 = b + 1
            while k < n and seg_char(s_byte(s, k)) {
                k = k + 1
            }
            if k == b + 1 {
                break
            }
            b = k
        }
        if best >= 0 {
            out_s = out_s + s_slice(s, pos, i) + "TMP/flow-playground-X"
            pos = best
            i = best
        } else {
            i = i + 1
        }
    }
    return out_s + s_from(s, pos)
}

# s#"c_preview": "([^"\\]|\\.)*"#"c_preview": "<C>"# on one line.
function norm_c_preview(line: string) -> string {
    let key: string = "\"c_preview\": \""
    let n: i32 = s_len(line)
    let mut at: i32 = s_find(line, key, 0)
    while at >= 0 {
        let mut k: i32 = at + s_len(key)
        let mut end: i32 = 0 - 1
        while k < n and end < 0 {
            let ch: i32 = s_byte(line, k)
            if ch == 34 {
                end = k + 1
            } elif ch == 92 {
                if k + 1 >= n {
                    k = n
                } else {
                    k = k + 2
                }
            } else {
                k = k + 1
            }
        }
        if end >= 0 {
            return s_slice(line, 0, at) + "\"c_preview\": \"<C>\"" + s_from(line, end)
        }
        at = s_find(line, key, at + 1)
    }
    return line
}

function digits_from(s: string, i: i32) -> i32 {
    let mut k: i32 = i
    while k < s_len(s) and s_byte(s, k) >= 48 and s_byte(s, k) <= 57 {
        k = k + 1
    }
    return k
}

# s#(main\.flow:[0-9]+:[0-9]+: )[^"]*#\1<flowc message># on one line.
function norm_flowc_message(line: string) -> string {
    let key: string = "main.flow:"
    let n: i32 = s_len(line)
    let mut at: i32 = s_find(line, key, 0)
    while at >= 0 {
        let a: i32 = at + s_len(key)
        let b: i32 = digits_from(line, a)
        if b > a and b < n and s_byte(line, b) == 58 {
            let d: i32 = digits_from(line, b + 1)
            if d > b + 1 and s_eq(s_slice(line, d, d + 2), ": ") {
                let mut k: i32 = d + 2
                while k < n and s_byte(line, k) != 34 {
                    k = k + 1
                }
                return s_slice(line, 0, d + 2) + "<flowc message>" + s_from(line, k)
            }
        }
        at = s_find(line, key, at + 1)
    }
    return line
}

# One raw HTTP reply (headers and body), normalised.
function normalise(raw_in: string, served: string) -> string {
    let mut raw: string = raw_in
    let mut prefix: string = ""
    let sep: i32 = s_find(raw, "\r\n\r\n", 0)
    if sep >= 0 {
        let head: string = s_slice(raw, 0, sep)
        let body: string = s_from(raw, sep + 4)
        # Content-Length checked against the body when the reply has headers;
        # 204 and HEAD replies carry a length and no body.
        let hl: ptr<ProcStrs> = s_lines(head)
        let mut declared: string = ""
        let mut found: bool = false
        let mut i: i32 = 0
        while i < sl_len(hl) and not found {
            let l: string = sl_get(hl, i)
            if s_starts(l, "Content-Length: ") {
                let d: i32 = digits_from(l, 16)
                let mut k: i32 = d
                while k < s_len(l) and s_byte(l, k) == 13 {
                    k = k + 1
                }
                if k == s_len(l) {
                    declared = s_slice(l, 16, d)
                    found = true
                }
            }
            i = i + 1
        }
        if s_len(declared) > 0 and s_len(body) > 0 and s_atoi(declared, 0) != s_len(body) {
            prefix = "CONTENT-LENGTH MISMATCH declared=" + declared + " body=" + s_itoa(s_len(body)) + "\n"
        }
        # A served file is checked against the file, then replaced by its name.
        if s_len(served) > 0 {
            if s_eq(body, read_text(served)) {
                raw = head + "\r\n\r\n<" + served + ">"
            } else {
                raw = head + "\r\n\r\n<body differs from " + served + ">"
            }
        }
    }
    let mut out_s: string = ""
    let lines: ptr<ProcStrs> = s_lines(raw)
    let mut j: i32 = 0
    while j < sl_len(lines) {
        let l: string = sl_get(lines, j)
        j = j + 1
        if s_starts(l, "Server: ") or s_starts(l, "Date: ") or s_starts(l, "Content-Length: ") {
            continue
        }
        out_s = out_s + norm_flowc_message(norm_playground_dirs(norm_c_preview(l))) + "\n"
    }
    return prefix + out_s
}

# ---------------------------------------------------------------------------
# Requests
# ---------------------------------------------------------------------------

function url() -> string {
    let c: ptr<Ctx> = CTX
    return "http://127.0.0.1:" + s_itoa(c.port)
}

# curl ARGS (split on "|", $U the server's URL); the reply is normalised
# and checked. `served` names a file the body must equal.
function http_case(name: string, served: string, spec: string) {
    let c: ptr<Ctx> = CTX
    let raw: string = c.work + "/pg_" + name + ".raw"
    let txt: string = c.work + "/pg_" + name + ".txt"
    let cu: ptr<ProcCmd> = proc_cmd("curl")
    proc_arg(cu, "-s")
    proc_arg(cu, "-i")
    proc_arg(cu, "--max-time")
    proc_arg(cu, "120")
    let parts: ptr<ProcStrs> = s_split(spec, 124)
    let mut i: i32 = 0
    while i < sl_len(parts) {
        proc_arg(cu, s_replace(sl_get(parts, i), "$U", url()))
        i = i + 1
    }
    proc_stdin(cu, PROC_NULL)
    proc_stdout(cu, PROC_CAPTURE)
    proc_stderr(cu, PROC_INHERIT)
    let r: ptr<ProcResult> = proc_run(cu)
    let _w1: bool = write_text(raw, r.stdout)
    let _w2: bool = write_text(txt, normalise(r.stdout, served))
    check("playground/" + name, c.exp + "/playground_" + name + ".txt", txt)
}

# Send `req` over a plain TCP connection and keep the whole reply.
function raw_case(name: string, req: string) {
    let c: ptr<Ctx> = CTX
    let txt: string = c.work + "/pg_" + name + ".txt"
    let r: BgBytes = bg_tcp_exchange(c.port, req as ptr<u8>, s_len(req) as i64, 120000)
    let mut got: string = ""
    if r.len > 0 {
        got = r.data as string
    }
    let _w: bool = write_text(txt, normalise(got, ""))
    check("playground/" + name, c.exp + "/playground_" + name + ".txt", txt)
}

# A command line from an override variable (split on blanks), or the tool.
function server_cmd(var: string, tool: string) -> ptr<ProcStrs> {
    let c: ptr<Ctx> = CTX
    let v: string = env(var)
    if s_len(v) > 0 {
        return s_words(v)
    }
    let b: ptr<ProcCmd> = proc_cmd(c.root + "/flow")
    proc_arg(b, "tool")
    proc_arg(b, "--path")
    proc_arg(b, tool)
    proc_stdout(b, PROC_CAPTURE)
    proc_stderr(b, PROC_INHERIT)
    let r: ptr<ProcResult> = proc_run(b)
    if status_of(r) != 0 {
        finish(status_of(r))
    }
    return sl_of1(s_chomp_all(r.stdout))
}

function repeat_a(n: i32) -> string {
    let buf: ptr<u8> = malloc((n + 1) as i64) as ptr<u8>
    let mut i: i32 = 0
    while i < n {
        buf[i] = 97
        i = i + 1
    }
    buf[n] = 0
    return buf as string
}

function main() -> i32 {
    let c: ptr<Ctx> = malloc(80) as ptr<Ctx>
    CTX = c
    c.root = env_or("FLOW_REPO_ROOT", cwd_logical())
    let _cd: bool = proc_chdir(c.root)
    env_set("PWD", c.root)
    bg_ignore_sigpipe()
    c.exp = "tests/tools/net/expected"
    let args: ptr<ProcStrs> = proc_args()
    c.update = sl_len(args) > 0 and s_eq(sl_get(args, 0), "--update")
    c.pass = 0
    c.fail = 0
    c.pids = sl_new()
    c.seed = proc_now_ms() ^ (proc_pid() as i64)
    let work: string = mktemp_dir(env_or("TMPDIR", "/tmp") + "/flow-net-tests.XXXXXX")
    on_exit_remove(work)
    c.work = work

    let playground: ptr<ProcStrs> = server_cmd("NET_TEST_PLAYGROUND", "playground_server")
    let relay: ptr<ProcStrs> = server_cmd("NET_TEST_RELAY", "ws_echo_relay")
    env_set("FLOW_REPO_ROOT", c.root)

    # -----------------------------------------------------------------------
    # Playground compile server
    # -----------------------------------------------------------------------

    let pg: ptr<ProcStrs> = sl_copy(playground)
    sl_push2(pg, "--port", "PORT")
    sl_push2(pg, "--run-timeout", "1.5")
    sl_push(pg, "--transpile-timeout=60")
    start_server("compile API on", work + "/playground.log", pg)
    let _b1: bool = write_text(work + "/banner", "FLOW playground compile API on http://127.0.0.1:PORT/compile\n")
    let first: string = head_lines(work + "/playground.log", 1)
    let _b2: bool = write_text(work + "/banner.got", s_replace_first(first, ":" + s_itoa(c.port) + "/", ":PORT/"))
    check("playground/banner", work + "/banner", work + "/banner.got")

    let hello: string = "{\"source\":\"function main() -> i32 {\\n    println(\\\"hi é\\\")\\n    return 3\\n}\\n\"}"
    let loop: string = "{\"source\":\"function main() -> i32 {\\n    let mut i: i64 = 0\\n    while true {\\n        i = i + 1\\n    }\\n    return 0\\n}\\n\"}"

    http_case("health", "", "$U/health")
    http_case("root", "", "$U/?x=1")
    http_case("origin_local", "", "-H|Origin: http://localhost:4000|$U/health")
    http_case("origin_other", "", "-H|Origin: http://evil.com|$U/health")
    http_case("origin_null", "", "-H|Origin: null|$U/health")
    http_case("options", "", "-X|OPTIONS|$U/compile")
    http_case("get_404", "", "$U/nope")
    http_case("flow_src_dotdot", "", "--path-as-is|$U/flow-src/../x")
    http_case("flow_src_missing", "", "$U/flow-src/lexer.py")
    http_case("pyodide", "docs/playground/pyodide.html", "$U/pyodide")
    http_case("post_404", "", "-X|POST|-d|{}|$U/other")
    http_case("post_query", "", "-X|POST|-d|{\"source\":\"x\"}|$U/compile?x=1")
    http_case("post_empty", "", "-X|POST|-H|Content-Length: 0|$U/compile")
    http_case("post_bad_json", "", "-X|POST|-d|not json|$U/compile")
    http_case("post_no_source", "", "-X|POST|-d|{\"target\":\"c\"}|$U/compile")
    http_case("post_blank_source", "", "-X|POST|-d|{\"source\":\"   \\n\"}|$U/compile")
    http_case("post_target_c", "", "-X|POST|-d|{\"source\":\"function main() -> i32 {\\n    println(\\\"hi\\\")\\n    return 0\\n}\\n\",\"target\":\"c\"}|$U/compile/")
    http_case("post_native_exit3", "", "-X|POST|-d|" + hello + "|$U/compile")
    http_case("post_transpile_error", "", "-X|POST|-d|{\"source\":\"function main( {\"}|$U/compile")
    http_case("post_target_number", "", "-X|POST|-d|{\"source\":\"function main() -> i32 {\\n    return 0\\n}\\n\",\"target\":5}|$U/compile")
    http_case("post_crash", "", "-X|POST|-d|{\"source\":\"extern {\\n    function abort() -> void\\n}\\nfunction main() -> i32 {\\n    abort()\\n    return 0\\n}\\n\"}|$U/compile")
    http_case("post_not_object", "", "-X|POST|-d|[1,2]|$U/compile")
    http_case("post_bad_length", "", "-X|POST|-H|Content-Length: abc|-d|x|$U/compile")
    let _j: bool = write_text(work + "/big.json", "{\"source\":\"" + repeat_a(65600) + "\"}")
    let _s: bool = write_text(work + "/big.src", repeat_a(70000))
    http_case("post_body_too_large", "", "-X|POST|--data-binary|@" + work + "/big.src|$U/compile")
    http_case("post_source_too_large", "", "-X|POST|--data-binary|@" + work + "/big.json|$U/compile")
    http_case("put", "", "-X|PUT|-d|x|$U/compile")

    # A program that never ends is killed at --run-timeout, and /health answers
    # while it runs.
    let lc: ptr<ProcStrs> = sl_of3("curl", "-s", "-i")
    sl_push2(lc, "--max-time", "60")
    sl_push2(lc, "-X", "POST")
    sl_push2(lc, "-d", loop)
    sl_push(lc, url() + "/compile")
    let lp: BgProc = bg_start(lc.items, "", false, work + "/pg_run_timeout.raw", "/dev/null")
    proc_sleep_ms(500)
    let t0: i64 = proc_now_ms() / 1000
    http_case("health_during_run", "", "$U/health")
    if proc_now_ms() / 1000 - t0 > 1 {
        outln("FAIL playground/concurrent: /health waited for the running program")
        c.fail = c.fail + 1
    }
    if lp.pid > 0 {
        let _lw: i32 = bg_wait(lp.pid)
    }
    let _rt: bool = write_text(work + "/pg_run_timeout.txt", normalise(read_text(work + "/pg_run_timeout.raw"), ""))
    check("playground/run_timeout", c.exp + "/playground_run_timeout.txt", work + "/pg_run_timeout.txt")

    raw_case("garbage", "GARBAGE\r\n\r\n")
    raw_case("http09_get", "GET /health\r\n\r\n")
    raw_case("http09_post", "POST /compile\r\n\r\n")
    raw_case("bad_version", "GET / FOO/1.0\r\n\r\n")
    raw_case("bad_version_digits", "GET / HTTP/1.x\r\n\r\n")
    raw_case("http2", "GET / HTTP/2.0\r\n\r\n")
    raw_case("four_words", "GET / x HTTP/1.1\r\n\r\n")
    raw_case("head", "HEAD / HTTP/1.1\r\n\r\n")
    raw_case("lf_only", "GET /health HTTP/1.0\nOrigin: http://localhost:9\n\n")
    raw_case("slash_slash", "GET //health HTTP/1.0\r\n\r\n")
    raw_case("origin_spaces", "GET /health HTTP/1.0\r\norigin:   http://127.0.0.1:1234  \r\n\r\n")
    raw_case("origin_userinfo", "GET /health HTTP/1.0\r\nOrigin: http://evil.com@localhost:80\r\n\r\n")
    raw_case("origin_no_scheme", "GET /health HTTP/1.0\r\nOrigin: localhost:80\r\n\r\n")
    raw_case("origin_upper", "GET /health HTTP/1.0\r\nOrigin: HTTP://LOCALHOST:80\r\n\r\n")
    raw_case("post_negative_length", "POST /compile HTTP/1.0\r\nContent-Length: -5\r\n\r\n")
    raw_case("post_bad_utf8", "POST /compile HTTP/1.0\r\nContent-Length: 14\r\n\r\n{\"source\":\"\xff\"}")
    raw_case("get_fragment", "GET /health#x HTTP/1.0\r\n\r\n")

    # -----------------------------------------------------------------------
    # WebSocket echo relay
    # -----------------------------------------------------------------------

    if have("node") {
        let rl: ptr<ProcStrs> = sl_copy(relay)
        sl_push2(rl, "--port", "PORT")
        sl_push2(rl, "--tcp-port", "PORT2")
        start_server("WebSocket echo relay on", work + "/relay.log", rl)
        let _r1: bool = write_text(work + "/relay_banner", "TCP echo relay on 127.0.0.1:PORT2\nWebSocket echo relay on 127.0.0.1:PORT\n")
        let p1: string = ":" + s_itoa(c.port)
        let p2: string = ":" + s_itoa(c.port2)
        let ll: ptr<ProcStrs> = s_split(read_text(work + "/relay.log"), 10)
        let fixed: ptr<ProcStrs> = sl_new()
        let mut i: i32 = 0
        while i < sl_len(ll) {
            let mut l: string = sl_get(ll, i)
            if s_ends(l, p2) {
                l = s_slice(l, 0, s_len(l) - s_len(p2)) + ":PORT2"
            } elif s_ends(l, p1) {
                l = s_slice(l, 0, s_len(l) - s_len(p1)) + ":PORT"
            }
            sl_push(fixed, l)
            i = i + 1
        }
        let got: string = sl_join(fixed, "\n")
        let _r2: bool = write_text(work + "/relay_banner.got", got)
        check("relay/banner", work + "/relay_banner", work + "/relay_banner.got")
        let nd: ptr<ProcCmd> = proc_cmd("node")
        proc_arg(nd, "tests/tools/net/ws_client.js")
        proc_arg(nd, s_itoa(c.port))
        proc_arg(nd, s_itoa(c.port2))
        proc_stdin(nd, PROC_NULL)
        proc_stdout(nd, PROC_CAPTURE)
        proc_stderr(nd, PROC_MERGE)
        let rn: ptr<ProcResult> = proc_run(nd)
        let _r3: bool = write_text(work + "/relay.txt", rn.stdout)
        check("relay/transcript", c.exp + "/relay.txt", work + "/relay.txt")
    } else {
        outln("SKIP relay: node is not on PATH")
    }

    outln("net tools: " + s_itoa(c.pass) + " passed, " + s_itoa(c.fail) + " failed")
    if c.fail > 0 {
        finish(1)
    }
    finish(0)
    return 0
}

# s/old/new/ (the first occurrence).
function s_replace_first(s: string, old: string, new: string) -> string {
    let at: i32 = s_find(s, old, 0)
    if at < 0 {
        return s
    }
    return s_slice(s, 0, at) + new + s_from(s, at + s_len(old))
}
