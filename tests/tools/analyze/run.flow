# Parity test for `flow analyze` (tools/analyze/main.flow).
#
# Each line of tests/tools/analyze/cases.txt is a case name and the
# arguments to `flow analyze`. The goldens in tests/tools/analyze/expected
# were recorded from the Python commands this tool replaced,
# src/flow/wcet_analysis.py and src/flow/misra_scan.py, before they were
# deleted:
#
#   <case>.stdout stdout, exact bytes
#   <case>.rc    exit code
#   <case>.err   stderr, exact bytes, where Python printed a message
#                (argparse usage errors, "not found", BUDGET EXCEEDED).
#                Cases where Python died with a traceback (a parse error,
#                a directory, a missing C file) check the exit code only.
#
# One recording detail: the Python WCET analysis kept each function's
# callees in a set, so when two callees tied for the deepest chain the
# printed chain depended on the string hash seed. The goldens were recorded
# with the callees in first-call order, which is what the Flow tool does.
#
# The same comparison over every .flow file under examples/ and tests/lang
# (1685 files: 1514 analyzed, 171 rejected by both) matched byte for byte
# when the Python version was removed.
#
# python and python3 are stubbed out on PATH, so a pass also shows the
# command needs no Python.
#
# Usage:
#   ./flow tool tests/tools/analyze/run.flow            check
#   ./flow tool tests/tools/analyze/run.flow --update   rewrite the goldens from the Flow tool

import "tools/flow_cli/sys.flow"
import std.process { ProcCmd, ProcResult, ProcStrs, proc_cmd, proc_arg, proc_input, proc_stdin, proc_stdout, proc_stderr, proc_run, proc_chdir, PROC_CAPTURE, PROC_NULL, PROC_MERGE }

# `diff -u a b | head -N`
function show_diff(a: string, b: string, n: i32) {
    let d: ptr<ProcCmd> = proc_cmd("diff")
    proc_arg(d, "-u")
    proc_arg(d, a)
    proc_arg(d, b)
    proc_stdout(d, PROC_CAPTURE)
    let r: ptr<ProcResult> = proc_run(d)
    let lines: ptr<ProcStrs> = s_lines(r.stdout)
    let mut i: i32 = 0
    while i < sl_len(lines) and i < n {
        outln(sl_get(lines, i))
        i = i + 1
    }
}

function status_of(r: ptr<ProcResult>) -> i32 {
    if s_len(r.error) > 0 {
        return 127
    }
    if r.exit_code < 0 {
        return 128 - r.exit_code
    }
    return r.exit_code
}

function main() -> i32 {
    let root: string = env_or("FLOW_REPO_ROOT", cwd_logical())
    let _cd: bool = proc_chdir(root)
    env_set("PWD", root)
    let here: string = "tests/tools/analyze"
    let args: ptr<ProcStrs> = proc_args()
    let update: bool = sl_len(args) > 0 and s_eq(sl_get(args, 0), "--update")

    let work: string = mktemp_dir(env_or("TMPDIR", "/tmp") + "/flow-analyze-tests.XXXXXX")
    on_exit_remove(work)
    let _b: bool = mkdir_p(work + "/bin")
    let pys: ptr<ProcStrs> = s_words("python python3")
    let mut p: i32 = 0
    while p < sl_len(pys) {
        let name: string = sl_get(pys, p)
        let stub: string = work + "/bin/" + name
        let _w: bool = write_text(stub, "#!/bin/sh\necho \"" + name + " $*\" >> \"" + work + "/python-calls.log\"\nexit 127\n")
        let _m: bool = set_mode(stub, 493)
        p = p + 1
    }
    env_set("PATH", work + "/bin:" + env("PATH"))
    env_unset("COLUMNS")

    # Build the tool once so its build output stays out of the cases.
    let bc: ptr<ProcCmd> = proc_cmd("./flow")
    proc_arg(bc, "analyze")
    proc_arg(bc, "--help")
    proc_stdout(bc, PROC_CAPTURE)
    proc_stderr(bc, PROC_MERGE)
    let br: ptr<ProcResult> = proc_run(bc)
    if status_of(br) != 0 {
        out(br.stdout)
        errln("tests/tools/analyze: could not build flow analyze")
        cli_exit(1)
    }

    let mut pass: i32 = 0
    let mut fail: i32 = 0
    let lines: ptr<ProcStrs> = s_lines(read_text(here + "/cases.txt"))
    let mut li: i32 = 0
    while li < sl_len(lines) {
        let line: string = sl_get(lines, li)
        li = li + 1
        if s_len(line) == 0 or s_starts(line, "#") {
            continue
        }
        let words: ptr<ProcStrs> = s_words(line)
        let name: string = sl_get(words, 0)
        let c: ptr<ProcCmd> = proc_cmd("./flow")
        proc_arg(c, "analyze")
        let mut stdin: string = ""
        let mut i: i32 = 1
        while i < sl_len(words) {
            if s_eq(sl_get(words, i), "<") {
                stdin = sl_get(words, i + 1)
                i = i + 2
                continue
            }
            proc_arg(c, sl_get(words, i))
            i = i + 1
        }
        if s_len(stdin) > 0 {
            proc_input(c, read_text(stdin))
        } else {
            proc_stdin(c, PROC_NULL)
        }
        proc_stdout(c, PROC_CAPTURE)
        proc_stderr(c, PROC_CAPTURE)
        let r: ptr<ProcResult> = proc_run(c)
        let rc: i32 = status_of(r)
        let outp: string = work + "/" + name + ".out"
        let errp: string = work + "/" + name + ".err"
        let _o: bool = write_text(outp, r.stdout)
        let _e: bool = write_text(errp, r.stderr)
        let exp: string = here + "/expected/" + name
        if update {
            let _c1: bool = copy_file(outp, exp + ".stdout")
            let _c2: bool = write_text(exp + ".rc", s_itoa(rc) + "\n")
            if is_file(exp + ".err") {
                let _c3: bool = copy_file(errp, exp + ".err")
            }
            pass = pass + 1
            continue
        }
        let mut ok: bool = true
        if not same_bytes(exp + ".stdout", outp) {
            ok = false
            outln("FAIL " + name + ": stdout")
            show_diff(exp + ".stdout", outp, 40)
        }
        let want_rc: string = s_chomp_all(read_text(exp + ".rc"))
        if not s_eq(want_rc, s_itoa(rc)) {
            ok = false
            outln("FAIL " + name + ": exit " + s_itoa(rc) + ", expected " + want_rc)
        }
        if is_file(exp + ".err") and not same_bytes(exp + ".err", errp) {
            ok = false
            outln("FAIL " + name + ": stderr")
            show_diff(exp + ".err", errp, 20)
        }
        if ok {
            pass = pass + 1
        } else {
            fail = fail + 1
        }
    }

    let calls: string = work + "/python-calls.log"
    if nonempty(calls) {
        outln("FAIL: flow analyze ran Python:")
        out(read_text(calls))
        fail = fail + 1
    }

    outln("flow analyze: " + s_itoa(pass) + " passed, " + s_itoa(fail) + " failed")
    if fail > 0 {
        cli_exit(1)
    }
    cli_exit(0)
    return 0
}
