# Tests for the Flow welcome bot (tools/discord-welcome).
#
# Welcome logic (the cases of the old test_bot.py): template loading and
# its three errors, {user}/{guild} substitution, seeded determinism, and
# every shipped template formatting cleanly. Then the environment checks
# and their exit codes, and an offline gateway run: gateway.replay is fed
# to --replay and the gateway frames and REST requests it would send are
# compared with gateway.stdout.expected (log lines, timestamps removed,
# with gateway.log.expected). Last, when discord.com is reachable, one
# HTTPS GET of /api/v10/gateway proves TLS and HTTP against the real host.
#
# Usage: ./flow tool tests/tools/discord_welcome/run.flow

import "tools/flow_cli/sys.flow"
import std.process { ProcCmd, ProcResult, ProcStrs, proc_cmd, proc_arg, proc_env, proc_env_clear, proc_stdin, proc_stdout, proc_stderr, proc_run, proc_chdir, PROC_CAPTURE, PROC_NULL, PROC_MERGE, PROC_INHERIT }

extern {
    function malloc(size: i64) -> ptr<void>
}

struct Tally {
    pass: i32,
    fail: i32,
    work: string,
    bin: string
}

let mut T: ptr<Tally> = null

function ok(name: string) {
    let t: ptr<Tally> = T
    outln("PASS " + name)
    t.pass = t.pass + 1
}

function bad(name: string) {
    let t: ptr<Tally> = T
    outln("FAIL " + name)
    t.fail = t.fail + 1
}

function status_of(r: ptr<ProcResult>) -> i32 {
    if s_len(r.error) > 0 {
        return 127
    }
    if r.exit_code < 0 {
        return 128 - r.exit_code
    }
    return r.exit_code
}

# The bot with `args`, stdin from /dev/null.
function bot(args: ptr<ProcStrs>) -> ptr<ProcCmd> {
    let t: ptr<Tally> = T
    let c: ptr<ProcCmd> = proc_cmd(t.bin)
    let mut i: i32 = 0
    while i < sl_len(args) {
        proc_arg(c, sl_get(args, i))
        i = i + 1
    }
    proc_stdin(c, PROC_NULL)
    return c
}

# "$(bot ARGS)": stdout without trailing newlines, stderr passed through.
# A failure ends the run with its status, as `set -e` did.
function bot_capture(args: ptr<ProcStrs>) -> string {
    let c: ptr<ProcCmd> = bot(args)
    proc_stdout(c, PROC_CAPTURE)
    proc_stderr(c, PROC_INHERIT)
    let r: ptr<ProcResult> = proc_run(c)
    let rc: i32 = status_of(r)
    if rc != 0 {
        cli_exit(rc)
    }
    return s_chomp_all(r.stdout)
}

# `grep -v NEEDLE` finds a line: some line lacks `needle`.
function some_line_lacks(text: string, needle: string) -> bool {
    let lines: ptr<ProcStrs> = s_lines(text)
    let mut i: i32 = 0
    while i < sl_len(lines) {
        if not s_contains(sl_get(lines, i), needle) {
            return true
        }
        i = i + 1
    }
    return false
}

function count_newlines(text: string) -> i32 {
    let mut n: i32 = 0
    let mut i: i32 = 0
    while i < s_len(text) {
        if s_byte(text, i) == 10 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

# Missing file, empty list, bad JSON: each is an error with exit 1.
function expect_error(name: string, file: string, pattern: string) {
    let c: ptr<ProcCmd> = bot(sl_of2("--messages", file))
    proc_arg(c, "--render")
    proc_arg(c, "@a")
    proc_arg(c, "Flow")
    proc_stdout(c, PROC_CAPTURE)
    proc_stderr(c, PROC_CAPTURE)
    let r: ptr<ProcResult> = proc_run(c)
    let rc: i32 = status_of(r)
    if rc == 1 and s_contains(r.stderr, pattern) {
        ok(name)
    } else {
        bad(name + " (exit " + s_itoa(rc) + ")")
        out(r.stderr)
    }
}

# Environment: same messages and exit codes as bot.py. `envs` holds
# NAME=value pairs for `env -i PATH="$PATH" ...`.
function expect_env(name: string, pattern: string, envs: ptr<ProcStrs>) {
    let c: ptr<ProcCmd> = bot(sl_of2("--messages", "tools/discord-welcome/messages.json"))
    proc_arg(c, "--replay")
    proc_arg(c, "/dev/null")
    proc_env_clear(c)
    proc_env(c, "PATH", env("PATH"))
    let mut i: i32 = 0
    while i < sl_len(envs) {
        let kv: string = sl_get(envs, i)
        let eq: i32 = s_find_byte(kv, 61, 0)
        proc_env(c, s_slice(kv, 0, eq), s_from(kv, eq + 1))
        i = i + 1
    }
    proc_stdout(c, PROC_NULL)
    proc_stderr(c, PROC_CAPTURE)
    let r: ptr<ProcResult> = proc_run(c)
    let rc: i32 = status_of(r)
    if rc == 1 and s_contains(r.stderr, "ERROR discord-welcome: " + pattern) {
        ok(name)
    } else {
        bad(name + " (exit " + s_itoa(rc) + ")")
        out(r.stderr)
    }
}

# sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9:]{8},[0-9]{3} //'
function strip_timestamp(line: string) -> string {
    let shape: string = "dddd-dd-dd ::::::::,ddd "
    if s_len(line) < s_len(shape) {
        return line
    }
    let mut i: i32 = 0
    while i < s_len(shape) {
        let want: i32 = s_byte(shape, i)
        let c: i32 = s_byte(line, i)
        let digit: bool = c >= 48 and c <= 57
        if want == 100 and not digit {
            return line
        }
        if want == 58 and not (digit or c == 58) {
            return line
        }
        if want != 100 and want != 58 and c != want {
            return line
        }
        i = i + 1
    }
    return s_from(line, s_len(shape))
}

function strip_timestamps(text: string) -> string {
    let mut out_text: string = ""
    let mut start: i32 = 0
    let n: i32 = s_len(text)
    while start < n {
        let mut end: i32 = s_find_byte(text, 10, start)
        let mut nl: string = "\n"
        if end < 0 {
            end = n
            nl = ""
        }
        out_text = out_text + strip_timestamp(s_slice(text, start, end)) + nl
        start = end + 1
    }
    return out_text
}

function show_diff(a: string, b: string) {
    let d: ptr<ProcCmd> = proc_cmd("diff")
    proc_arg(d, "-u")
    proc_arg(d, a)
    proc_arg(d, b)
    proc_stdout(d, PROC_CAPTURE)
    let r: ptr<ProcResult> = proc_run(d)
    out(r.stdout)
}

function main() -> i32 {
    let root: string = env_or("FLOW_REPO_ROOT", cwd_logical())
    let _cd: bool = proc_chdir(root)
    env_set("PWD", root)
    let here: string = "tests/tools/discord_welcome"
    let t: ptr<Tally> = malloc(32) as ptr<Tally>
    T = t
    t.pass = 0
    t.fail = 0

    let bc: ptr<ProcCmd> = proc_cmd("./flow")
    proc_arg(bc, "tool")
    proc_arg(bc, "tools/discord-welcome/build.flow")
    proc_stdin(bc, PROC_NULL)
    proc_stdout(bc, PROC_CAPTURE)
    proc_stderr(bc, PROC_INHERIT)
    let br: ptr<ProcResult> = proc_run(bc)
    if status_of(br) != 0 {
        cli_exit(status_of(br))
    }
    t.bin = s_chomp_all(br.stdout)
    let msg: string = "tools/discord-welcome/messages.json"
    let work: string = mktemp_dir(env_or("TMPDIR", "/tmp") + "/flow-welcome-tests.XXXXXX")
    on_exit_remove(work)
    t.work = work

    # load_messages returns templates, each with {user}.
    let a1: ptr<ProcCmd> = bot(sl_of2("--messages", msg))
    proc_arg(a1, "--render-all")
    proc_arg(a1, "{user}")
    proc_arg(a1, "Flow")
    proc_stdout(a1, PROC_CAPTURE)
    proc_stderr(a1, PROC_MERGE)
    let r1: ptr<ProcResult> = proc_run(a1)
    if status_of(r1) == 0 and count_newlines(r1.stdout) >= 1 and not some_line_lacks(r1.stdout, "{user}") {
        ok("load_messages returns templates with {user}")
    } else {
        bad("load_messages returns templates with {user}")
    }

    expect_error("load_messages missing file", work + "/nope.json", "No such file or directory")
    let _e1: bool = write_text(work + "/empty.json", "{\"messages\": []}")
    expect_error("load_messages empty list", work + "/empty.json", "contains no 'messages' entries")
    let _e2: bool = write_text(work + "/bad.json", "{not json")
    expect_error("load_messages bad JSON", work + "/bad.json", "invalid JSON")

    # pick_welcome substitutes {user} and {guild}.
    let _e3: bool = write_text(work + "/one.json", "{\"messages\": [\"Hello {user}, welcome to the {guild} discord server!\"]}")
    let g: ptr<ProcStrs> = sl_of3("--messages", work + "/one.json", "--render")
    sl_push2(g, "@alice", "Flow")
    sl_push2(g, "--seed", "0")
    let got: string = bot_capture(g)
    if s_eq(got, "Hello @alice, welcome to the Flow discord server!") {
        ok("pick_welcome substitutes user and guild")
    } else {
        bad("pick_welcome substitution: " + got)
    }

    # Same seed, same pick.
    let three: string = "{\"messages\": [\"Hello {user}, welcome to the {guild} discord server!\",\n              \"Welcome {user} to the {guild} discord server.\",\n              \"{user} just joined the {guild} discord server.\"]}\n"
    let _e4: bool = write_text(work + "/three.json", three)
    let s3: ptr<ProcStrs> = sl_of3("--messages", work + "/three.json", "--render")
    sl_push2(s3, "@bob", "Flow")
    sl_push2(s3, "--seed", "42")
    let a: string = bot_capture(s3)
    let b: string = bot_capture(s3)
    if s_eq(a, b) and s_contains(a, "@bob") and s_contains(a, "Flow") {
        ok("pick_welcome is deterministic with a seed")
    } else {
        bad("seeded pick: '" + a + "' vs '" + b + "'")
    }

    # Every shipped template formats with both fields.
    let f1: ptr<ProcCmd> = bot(sl_of2("--messages", msg))
    proc_arg(f1, "--render-all")
    proc_arg(f1, "@tester")
    proc_arg(f1, "Flow")
    proc_stdout(f1, PROC_CAPTURE)
    proc_stderr(f1, PROC_MERGE)
    let rf: ptr<ProcResult> = proc_run(f1)
    if status_of(rf) == 0 and not some_line_lacks(rf.stdout, "@tester") and not some_line_lacks(rf.stdout, "Flow") {
        ok("every template formats cleanly")
    } else {
        bad("every template formats cleanly")
    }

    # Environment: same messages and exit codes as bot.py.
    expect_env("missing DISCORD_TOKEN", "Missing required env var DISCORD_TOKEN", sl_new())
    expect_env("blank DISCORD_TOKEN", "Missing required env var DISCORD_TOKEN", sl_of1("DISCORD_TOKEN=  "))
    expect_env("missing WELCOME_CHANNEL_ID", "Missing required env var WELCOME_CHANNEL_ID", sl_of1("DISCORD_TOKEN=x"))
    expect_env("non-integer WELCOME_CHANNEL_ID", "WELCOME_CHANNEL_ID must be an integer, got 'abc'", sl_of2("DISCORD_TOKEN=x", "WELCOME_CHANNEL_ID=abc"))

    # Offline gateway run.
    let gw: ptr<ProcCmd> = bot(sl_of2("--messages", msg))
    proc_arg(gw, "--replay")
    proc_arg(gw, here + "/gateway.replay")
    proc_arg(gw, "--seed")
    proc_arg(gw, "7")
    proc_env(gw, "DISCORD_TOKEN", "secret-token-value")
    proc_env(gw, "WELCOME_CHANNEL_ID", "555")
    proc_stdout(gw, PROC_CAPTURE)
    proc_stderr(gw, PROC_CAPTURE)
    let rg: ptr<ProcResult> = proc_run(gw)
    let grc: i32 = status_of(rg)
    let _w1: bool = write_text(work + "/stdout", rg.stdout)
    let _w2: bool = write_text(work + "/stderr", rg.stderr)
    let _w3: bool = write_text(work + "/log", strip_timestamps(rg.stderr))
    if grc == 0 and same_bytes(work + "/stdout", here + "/gateway.stdout.expected") {
        ok("replay: gateway frames and REST requests")
    } else {
        bad("replay stdout (exit " + s_itoa(grc) + ")")
        show_diff(here + "/gateway.stdout.expected", work + "/stdout")
    }
    if same_bytes(work + "/log", here + "/gateway.log.expected") {
        ok("replay: log lines")
    } else {
        bad("replay log")
        show_diff(here + "/gateway.log.expected", work + "/log")
    }
    if s_contains(rg.stdout, "secret-token-value") or s_contains(rg.stderr, "secret-token-value") {
        bad("token leaked into output")
    } else {
        ok("token never printed")
    }

    # TLS + HTTP against discord.com, when the network allows it.
    let tc: ptr<ProcCmd> = bot(sl_of1("--check-tls"))
    proc_stdout(tc, PROC_CAPTURE)
    proc_stderr(tc, PROC_MERGE)
    let rt: ptr<ProcResult> = proc_run(tc)
    let tls: string = rt.stdout
    if status_of(rt) == 0 {
        let lines: ptr<ProcStrs> = s_lines(tls)
        if sl_len(lines) > 0 and s_starts(sl_get(lines, 0), "HTTP 200") and s_contains(tls, "\"url\"") {
            ok("HTTPS GET discord.com/api/v10/gateway")
        } else {
            bad("HTTPS GET")
            out(tls)
        }
    } elif s_contains(tls, "getaddrinfo") or s_contains(tls, "could not connect") {
        outln("SKIP HTTPS GET discord.com (no network)")
    } else {
        bad("HTTPS GET discord.com")
        out(tls)
    }

    outln("discord-welcome checks: " + s_itoa(t.pass) + " passed, " + s_itoa(t.fail) + " failed")
    if t.fail > 0 {
        cli_exit(1)
    }
    cli_exit(0)
    return 0
}
