# stencil2d: one explicit step of the 2D heat equation on a 96 x 40 grid,
#
#   out = u + k * (left + right + up + down - 4 u)
#
# with the edge cells copied. Every local has its type written and the
# constant 4 is an f32 local: flowc's C backend types an unannotated
# `let v = p[i]` of a ptr<f32> as int32_t, and makes a float literal next
# to an f32 a C double, while the gpu dialect keeps both f32. One thread per cell: x from
# gpu_thread_id_x(), y from gpu_thread_id_y(), launched as 2 x 40
# workgroups of 64 x 1.
#
# main() is the CPU build of the same kernel: it runs it per (x, y) thread
# id and writes the launch spec, the inputs and the CPU result to
# $FLOW_GPU_LOWER_DATA for `flow gpu-lower --run`.

extern {
    function calloc(n: i64, s: i64) -> ptr<void>
    function fopen(path: string, mode: string) -> ptr<void>
    function fwrite(buf: ptr<void>, size: i64, count: i64, fp: ptr<void>) -> i64
    function fputs(s: string, fp: ptr<void>) -> i32
    function fclose(fp: ptr<void>) -> i32
    function getenv(name: string) -> string
}

let mut cpu_tid_x: i32 = 0
let mut cpu_tid_y: i32 = 0

function gpu_thread_id_x() -> i32 {
    return cpu_tid_x
}

function gpu_thread_id_y() -> i32 {
    return cpu_tid_y
}

@gpu
function heat_step(u: ptr<f32>, out: ptr<f32>, k: f32, w: i32, h: i32) {
    let x = gpu_thread_id_x()
    let y = gpu_thread_id_y()
    if x < w {
        if y < h {
            let c: i32 = y * w + x
            out[c] = u[c]
            if x > 0 {
                if x < w - 1 {
                    if y > 0 {
                        if y < h - 1 {
                            let four: f32 = 4.0
                            let lap: f32 = u[c - 1] + u[c + 1] + u[c - w] + u[c + w] - four * u[c]
                            out[c] = u[c] + k * lap
                        }
                    }
                }
            }
        }
    }
}

function dump(dir: string, name: string, p: ptr<void>, bytes: i64) {
    let fp: ptr<void> = fopen(dir + "/" + name, "wb")
    let _w: i64 = fwrite(p, 1, bytes, fp)
    let _c: i32 = fclose(fp)
}

function main() -> i32 {
    let dir: string = getenv("FLOW_GPU_LOWER_DATA")
    let w: i32 = 96
    let h: i32 = 40
    let n: i32 = w * h
    let u: ptr<f32> = calloc(n as i64, 4) as ptr<f32>
    let out: ptr<f32> = calloc(n as i64, 4) as ptr<f32>
    let kk: ptr<f32> = calloc(1, 4) as ptr<f32>
    let ww: ptr<i32> = calloc(1, 4) as ptr<i32>
    let hh: ptr<i32> = calloc(1, 4) as ptr<i32>
    kk[0] = 0.21
    ww[0] = w
    hh[0] = h
    let mut s: i32 = 777
    for i in 0 to n {
        s = (s * 1103 + 12345) % 65536
        u[i] = (s as f32) / 1000.0
    }
    dump(dir, "in_0.bin", u as ptr<void>, (n * 4) as i64)
    dump(dir, "in_1.bin", out as ptr<void>, (n * 4) as i64)
    dump(dir, "in_2.bin", kk as ptr<void>, 4)
    dump(dir, "in_3.bin", ww as ptr<void>, 4)
    dump(dir, "in_4.bin", hh as ptr<void>, 4)
    for y in 0 to h {
        for x in 0 to 128 {
            cpu_tid_x = x
            cpu_tid_y = y
            heat_step(u, out, kk[0], w, h)
        }
    }
    dump(dir, "out_1.bin", out as ptr<void>, (n * 4) as i64)
    let fp: ptr<void> = fopen(dir + "/launch.txt", "w")
    let _a: i32 = fputs("buffer 0 f32 3840 in\nbuffer 1 f32 3840 out\nbuffer 2 f32 1 scalar\nbuffer 3 i32 1 scalar\nbuffer 4 i32 1 scalar\ndispatch heat_step 2 40 1 0 1 2 3 4\n", fp)
    let _c: i32 = fclose(fp)
    return 0
}
