# Karplus-Strong short-delay voices for GPU lowering parity.
#
# One GPU thread owns one voice. Each voice keeps a 48-sample ring buffer in
# device memory, its own write index, and its own decay factor, so the
# delay-line read is a dynamic index into per-voice memory. Two 64-sample
# blocks run back to back; the second dispatch reads the delay buffer and
# write index the first one left behind, which is the state a resident voice
# bank would keep between audio blocks.
#
# The ring index wraps with compare-and-assign, so the kernel needs a local
# assigned inside an `if` inside a `for`. That construct used to emit invalid
# SSA (issue #1765); this case is the regression test for it and for gate 1 of
# #1748 (Karplus-Strong voice program).
#
# main() is the CPU reference: it runs the same kernels in dispatch order over
# zero-initialised device buffers. Before anything is dumped it replays voice
# 0 with an independent unsplit recurrence and checks the mid-block delay
# contents, the write index, every output sample, the block-1 continuation
# formula, voice independence and that the state actually changed.

extern {
    function calloc(n: i64, s: i64) -> ptr<void>
    function fopen(path: string, mode: string) -> ptr<void>
    function fwrite(buf: ptr<void>, size: i64, count: i64, fp: ptr<void>) -> i64
    function fputs(s: string, fp: ptr<void>) -> i32
    function fclose(fp: ptr<void>) -> i32
    function getenv(name: string) -> string
}

let mut cpu_tid_x: i32 = 0

function gpu_thread_id() -> i32 {
    return cpu_tid_x
}

# Karplus-Strong: one block of a plucked delay line per voice.
@gpu
function ks(
    exc: ptr<f32>, delay: ptr<f32>, widx: ptr<i32>, decay: ptr<f32>,
    y: ptr<f32>, voices: i32, frames: i32, dlen: i32
) {
    let voice: i32 = gpu_thread_id()
    if voice < voices {
        let base: i32 = voice * dlen
        let d: f32 = decay[voice]
        let mut w: i32 = widx[voice]
        for frame in 0 to frames {
            let mut p1: i32 = w - 1
            if p1 < 0 { p1 = p1 + dlen }
            let mut p2: i32 = w - 2
            if p2 < 0 { p2 = p2 + dlen }
            let avg: f32 = 0.5 * (delay[base + p1] + delay[base + p2])
            let s: f32 = d * avg + exc[voice * frames + frame]
            delay[base + w] = s
            y[frame * voices + voice] = s
            w = w + 1
            if w >= dlen { w = 0 }
        }
        widx[voice] = w
    }
}

# Copy the ring and index into the block-boundary buffers, so the case can
# check what the second dispatch started from.
@gpu
function snapshot(
    delay: ptr<f32>, widx: ptr<i32>, dmid: ptr<f32>, wmid: ptr<i32>,
    voices: i32, dlen: i32
) {
    let voice: i32 = gpu_thread_id()
    if voice < voices {
        let base: i32 = voice * dlen
        for j in 0 to dlen {
            dmid[base + j] = delay[base + j]
        }
        wmid[voice] = widx[voice]
    }
}

function dump(dir: string, name: string, p: ptr<void>, bytes: i64) {
    let fp: ptr<void> = fopen(dir + "/" + name, "wb")
    let _w: i64 = fwrite(p, 1, bytes, fp)
    let _c: i32 = fclose(fp)
}

function absf(x: f32) -> f32 {
    if x < 0.0 {
        return 0.0 - x
    }
    return x
}

function main() -> i32 {
    let dir: string = getenv("FLOW_GPU_LOWER_DATA")
    let voices: i32 = 64
    let frames: i32 = 64
    let dlen: i32 = 48
    let voice_bytes: i64 = (voices * 4) as i64
    let signal_bytes: i64 = (voices * frames * 4) as i64
    let delay_bytes: i64 = (voices * dlen * 4) as i64

    let exc0: ptr<f32> = calloc((voices * frames) as i64, 4) as ptr<f32>
    let exc1: ptr<f32> = calloc((voices * frames) as i64, 4) as ptr<f32>
    let decay: ptr<f32> = calloc(voices as i64, 4) as ptr<f32>
    let delay: ptr<f32> = calloc((voices * dlen) as i64, 4) as ptr<f32>
    let widx: ptr<i32> = calloc(voices as i64, 4) as ptr<i32>
    let y0: ptr<f32> = calloc((voices * frames) as i64, 4) as ptr<f32>
    let y1: ptr<f32> = calloc((voices * frames) as i64, 4) as ptr<f32>
    let dmid: ptr<f32> = calloc((voices * dlen) as i64, 4) as ptr<f32>
    let wmid: ptr<i32> = calloc(voices as i64, 4) as ptr<i32>
    let voice_arg: ptr<i32> = calloc(1, 4) as ptr<i32>
    let frame_arg: ptr<i32> = calloc(1, 4) as ptr<i32>
    let delay_arg: ptr<i32> = calloc(1, 4) as ptr<i32>
    voice_arg[0] = voices
    frame_arg[0] = frames
    delay_arg[0] = dlen

    # Ring buffers and write indices start silent, as a freshly allocated
    # voice bank would. Decay stays under 1 so every voice is stable.
    for voice in 0 to voices {
        decay[voice] = 0.9 + ((voice % 16) as f32) * 0.006
    }
    let mut seed: i32 = 7919
    for voice in 0 to voices {
        for i in 0 to frames {
            seed = (seed * 1103 + 12345) % 65536
            exc0[voice * frames + i] = (seed as f32) / 32768.0 - 1.0
            seed = (seed * 1103 + 12345) % 65536
            exc1[voice * frames + i] = (seed as f32) / 32768.0 - 1.0
        }
    }

    dump(dir, "in_0.bin", exc0 as ptr<void>, signal_bytes)
    dump(dir, "in_1.bin", exc1 as ptr<void>, signal_bytes)
    dump(dir, "in_2.bin", decay as ptr<void>, voice_bytes)
    dump(dir, "in_3.bin", delay as ptr<void>, delay_bytes)
    dump(dir, "in_4.bin", widx as ptr<void>, voice_bytes)
    dump(dir, "in_5.bin", y0 as ptr<void>, signal_bytes)
    dump(dir, "in_6.bin", y1 as ptr<void>, signal_bytes)
    dump(dir, "in_7.bin", dmid as ptr<void>, delay_bytes)
    dump(dir, "in_8.bin", wmid as ptr<void>, voice_bytes)
    dump(dir, "in_9.bin", voice_arg as ptr<void>, 4)
    dump(dir, "in_10.bin", frame_arg as ptr<void>, 4)
    dump(dir, "in_11.bin", delay_arg as ptr<void>, 4)

    for t in 0 to voices {
        cpu_tid_x = t
        ks(exc0, delay, widx, decay, y0, voices, frames, dlen)
    }
    for t in 0 to voices {
        cpu_tid_x = t
        snapshot(delay, widx, dmid, wmid, voices, dlen)
    }
    for t in 0 to voices {
        cpu_tid_x = t
        ks(exc1, delay, widx, decay, y1, voices, frames, dlen)
    }

    # Independent replay for voice 0: one recurrence across both blocks, over
    # its own ring, sharing nothing with the kernel above.
    let ref: ptr<f32> = calloc(dlen as i64, 4) as ptr<f32>
    let mut rw: i32 = 0
    let mut bad: i32 = 0
    for i in 0 to frames {
        let mut p1: i32 = rw - 1
        if p1 < 0 { p1 = p1 + dlen }
        let mut p2: i32 = rw - 2
        if p2 < 0 { p2 = p2 + dlen }
        let avg: f32 = 0.5 * (ref[p1] + ref[p2])
        let s: f32 = decay[0] * avg + exc0[i]
        ref[rw] = s
        if absf(y0[i * voices] - s) > 0.000001 { bad = 1 }
        rw = rw + 1
        if rw >= dlen { rw = 0 }
    }
    if bad == 1 { return 1 }
    if wmid[0] != rw { return 2 }
    for j in 0 to dlen {
        if absf(dmid[j] - ref[j]) > 0.000001 { return 3 }
    }

    # The second block must start from the state the first one left, including
    # wrap-around reads at index 0 and 1.
    let mut wp1: i32 = wmid[0] - 1
    if wp1 < 0 { wp1 = wp1 + dlen }
    let mut wp2: i32 = wmid[0] - 2
    if wp2 < 0 { wp2 = wp2 + dlen }
    let first: f32 = decay[0] * (0.5 * (dmid[wp1] + dmid[wp2])) + exc1[0]
    if absf(y1[0] - first) > 0.000001 { return 4 }

    for i in 0 to frames {
        let mut p1: i32 = rw - 1
        if p1 < 0 { p1 = p1 + dlen }
        let mut p2: i32 = rw - 2
        if p2 < 0 { p2 = p2 + dlen }
        let avg: f32 = 0.5 * (ref[p1] + ref[p2])
        let s: f32 = decay[0] * avg + exc1[i]
        ref[rw] = s
        if absf(y1[i * voices] - s) > 0.000001 { bad = 1 }
        rw = rw + 1
        if rw >= dlen { rw = 0 }
    }
    if bad == 1 { return 5 }
    if widx[0] != rw { return 6 }
    for j in 0 to dlen {
        if absf(delay[j] - ref[j]) > 0.000001 { return 7 }
    }

    # A reset between dispatches, a silent no-op, or shared state fail here.
    if dmid[0] == 0.0 { return 8 }
    if y0[0] == y1[0] { return 9 }
    if y0[0] == y0[voices] { return 10 }
    if widx[0] != (frames * 2) % dlen { return 11 }
    if delay[0] == dmid[0] { return 12 }

    dump(dir, "out_3.bin", delay as ptr<void>, delay_bytes)
    dump(dir, "out_4.bin", widx as ptr<void>, voice_bytes)
    dump(dir, "out_5.bin", y0 as ptr<void>, signal_bytes)
    dump(dir, "out_6.bin", y1 as ptr<void>, signal_bytes)
    dump(dir, "out_7.bin", dmid as ptr<void>, delay_bytes)
    dump(dir, "out_8.bin", wmid as ptr<void>, voice_bytes)

    let fp: ptr<void> = fopen(dir + "/launch.txt", "w")
    let _w: i32 = fputs(
        "buffer 0 f32 4096 in\n" +
        "buffer 1 f32 4096 in\n" +
        "buffer 2 f32 64 in\n" +
        "buffer 3 f32 3072 out\n" +
        "buffer 4 i32 64 out\n" +
        "buffer 5 f32 4096 out\n" +
        "buffer 6 f32 4096 out\n" +
        "buffer 7 f32 3072 out\n" +
        "buffer 8 i32 64 out\n" +
        "buffer 9 i32 1 scalar\n" +
        "buffer 10 i32 1 scalar\n" +
        "buffer 11 i32 1 scalar\n" +
        "dispatch ks 1 1 1 0 3 4 2 5 9 10 11\n" +
        "dispatch snapshot 1 1 1 3 4 7 8 9 11\n" +
        "dispatch ks 1 1 1 1 3 4 2 6 9 10 11\n",
        fp
    )
    let _c: i32 = fclose(fp)
    return 0
}
