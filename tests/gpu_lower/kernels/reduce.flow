# reduce: the sum of 4096 values in two dispatches.
#
# partial_sums gives each of 64 threads a run of 64 values to add in
# order; total adds the 64 partial sums on thread 0. Both passes add in a
# fixed order, so the GPU result can match the CPU bit for bit.
#
# main() is the CPU build of the same kernels: it runs each one per thread
# id and writes the launch spec, the inputs and the CPU result to
# $FLOW_GPU_LOWER_DATA for `flow gpu-lower --run`.

extern {
    function calloc(n: i64, s: i64) -> ptr<void>
    function fopen(path: string, mode: string) -> ptr<void>
    function fwrite(buf: ptr<void>, size: i64, count: i64, fp: ptr<void>) -> i64
    function fputs(s: string, fp: ptr<void>) -> i32
    function fclose(fp: ptr<void>) -> i32
    function getenv(name: string) -> string
}

let mut cpu_tid_x: i32 = 0

function gpu_thread_id() -> i32 {
    return cpu_tid_x
}

@gpu
function partial_sums(x: ptr<f32>, partial: ptr<f32>, chunk: i32, parts: i32) {
    let t = gpu_thread_id()
    if t < parts {
        let mut acc: f32 = 0.0
        for k in 0 to chunk {
            acc = acc + x[t * chunk + k]
        }
        partial[t] = acc
    }
}

@gpu
function total(partial: ptr<f32>, out: ptr<f32>, parts: i32) {
    let t = gpu_thread_id()
    if t == 0 {
        let mut acc: f32 = 0.0
        for k in 0 to parts {
            acc = acc + partial[k]
        }
        out[0] = acc
    }
}

function dump(dir: string, name: string, p: ptr<void>, bytes: i64) {
    let fp: ptr<void> = fopen(dir + "/" + name, "wb")
    let _w: i64 = fwrite(p, 1, bytes, fp)
    let _c: i32 = fclose(fp)
}

function main() -> i32 {
    let dir: string = getenv("FLOW_GPU_LOWER_DATA")
    let n: i32 = 4096
    let parts: i32 = 64
    let x: ptr<f32> = calloc(n as i64, 4) as ptr<f32>
    let partial: ptr<f32> = calloc(parts as i64, 4) as ptr<f32>
    let out: ptr<f32> = calloc(1, 4) as ptr<f32>
    let ichunk: ptr<i32> = calloc(1, 4) as ptr<i32>
    let iparts: ptr<i32> = calloc(1, 4) as ptr<i32>
    ichunk[0] = n / parts
    iparts[0] = parts
    let mut s: i32 = 4321
    for i in 0 to n {
        s = (s * 1103 + 12345) % 65536
        x[i] = (s as f32) / 3000.0 - 10.0
    }
    dump(dir, "in_0.bin", x as ptr<void>, (n * 4) as i64)
    dump(dir, "in_1.bin", partial as ptr<void>, (parts * 4) as i64)
    dump(dir, "in_2.bin", out as ptr<void>, 4)
    dump(dir, "in_3.bin", ichunk as ptr<void>, 4)
    dump(dir, "in_4.bin", iparts as ptr<void>, 4)
    for t in 0 to 64 {
        cpu_tid_x = t
        partial_sums(x, partial, ichunk[0], parts)
    }
    for t in 0 to 64 {
        cpu_tid_x = t
        total(partial, out, parts)
    }
    dump(dir, "out_1.bin", partial as ptr<void>, (parts * 4) as i64)
    dump(dir, "out_2.bin", out as ptr<void>, 4)
    let fp: ptr<void> = fopen(dir + "/launch.txt", "w")
    let _a: i32 = fputs("buffer 0 f32 4096 in\nbuffer 1 f32 64 out\nbuffer 2 f32 1 out\nbuffer 3 i32 1 scalar\nbuffer 4 i32 1 scalar\ndispatch partial_sums 1 1 1 0 1 3 4\ndispatch total 1 1 1 1 2 4\n", fp)
    let _c: i32 = fclose(fp)
    return 0
}
