# Goldens for the one-process runner (tools/run): `./flow run --json`,
# `--keep`, `--predict` and friends.
#
# Each line of tests/flow_run/cases.txt is `name|arguments`. The runner's
# stdout, stderr and exit status must equal tests/flow_run/expected/name.*
# after two normalisations: timing values read T, and the scratch directory
# reads TMP, the repository root reads ROOT, and a C compiler diagnostic in a
# "compile failed" error reads CC-DIAGNOSTICS (its text depends on the
# compiler). The goldens were recorded from the Python runner (python3 -m
# flow.run, and flow.cost_model for --predict) before it was deleted. A
# `--keep DIR` case also checks that DIR holds the C and the binary.
#
# python and python3 are stubbed out on PATH: the runner must not need them.
#
# Usage: ./flow tool tests/flow_run/run.flow [name...]

import "tools/flow_cli/sys.flow"
import "scripts/tools/lib/testrun.flow"
import std.process { ProcCmd, ProcStrs, proc_arg }
import std.regex { Regex }

let mut ROOT: string = ""
let mut RX_TIME: ptr<Regex> = null
let mut RX_TMP: ptr<Regex> = null
let mut RX_CC: ptr<Regex> = null

function normalise(text: string) -> string {
    let a: string = s_replace(text, ROOT + "/", "ROOT/")
    let b: string = tr_sed(a, RX_TIME, "\"\\1_s\": T", 1)
    let c: string = tr_sed(b, RX_TMP, "TMP/", 0)
    return tr_sed(c, RX_CC, "\"error\": \"compile failed: CC-DIAGNOSTICS\"", 1)
}

# Compare the normalised texts. When they differ, print "  NAME: WHAT
# differs" and the head of their `diff -u`, indented.
function differs(work: string, name: string, what: string, want: string, got: string) -> bool {
    let a: string = work + "/" + name + ".want"
    let b: string = work + "/" + name + ".got"
    let _a: bool = write_text(a, normalise(read_text(want)))
    let _b: bool = write_text(b, normalise(read_text(got)))
    if same_bytes(a, b) {
        return false
    }
    outln("  " + name + ": " + what + " differs")
    out(tr_head(tr_indent(tr_diff("-u", a, b), "    "), 20))
    return true
}

function main() -> i32 {
    ROOT = tr_enter_root()
    RX_TIME = tr_rx("\"(transpile|compile|run|total)_s\": [0-9.]+")
    RX_TMP = tr_rx("/[^ \"]*/flow_run_[A-Za-z0-9_]+/")
    RX_CC = tr_rx("\"error\": \"compile failed: .*\"$")
    let only: ptr<ProcStrs> = tr_args()

    let work: string = tr_workdir("flow-run-tests")
    on_exit_remove(ROOT + "/build/flow-run-tests")
    let log: string = work + "/python-calls.log"
    tr_stub_python_log(work + "/bin", log)
    env_unset("FLOW_RUN_PYTHON")
    env_unset("FLOW_RUN_DIRECT")

    let mut pass: i32 = 0
    let mut fail: i32 = 0
    let lines: ptr<ProcStrs> = s_lines(read_text("tests/flow_run/cases.txt"))
    let mut li: i32 = 0
    while li < sl_len(lines) {
        let line: string = sl_get(lines, li)
        li = li + 1
        let bar: i32 = s_find_byte(line, 124, 0)
        let mut name: string = line
        let mut args: string = ""
        if bar >= 0 {
            name = s_slice(line, 0, bar)
            args = s_from(line, bar + 1)
        }
        if s_len(name) == 0 or s_starts(name, "#") {
            continue
        }
        if sl_len(only) > 0 and not sl_has(only, name) {
            continue
        }
        let argv: ptr<ProcStrs> = s_words(args)
        # Without one of the runner's own flags `flow run` is the driver's
        # runner; FLOW_RUN_DIRECT=1 asks for this one.
        let padded: string = " " + args + " "
        let direct: bool = not (s_contains(padded, " --json ") or s_contains(padded, " --keep ") or s_contains(padded, " --predict ") or s_contains(padded, " --extra-cflags="))
        let full: ptr<ProcStrs> = sl_of2("./flow", "run")
        sl_extend(full, argv)
        let c: ptr<ProcCmd> = cmd(full)
        if direct {
            cmd_env(c, "FLOW_RUN_DIRECT", "1")
        }
        let got_out: string = work + "/" + name + ".out"
        let got_err: string = work + "/" + name + ".err"
        let rc: i32 = tr_run_cmd_files(c, got_out, got_err)
        let mut ok: bool = true
        let exp: string = "tests/flow_run/expected/" + name
        let want_rc: string = s_chomp_all(read_text(exp + ".rc"))
        if not s_eq(s_itoa(rc), want_rc) {
            outln("  " + name + ": exit " + s_itoa(rc) + ", expected " + want_rc)
            ok = false
        }
        if differs(work, name, "stdout", exp + ".out", got_out) {
            ok = false
        }
        if differs(work, name, "stderr", exp + ".err", got_err) {
            ok = false
        }
        # The last --keep DIR, as `sed -n 's/.*--keep \([^ ]*\).*/\1/p'`.
        let at: i32 = s_find(args, "--keep ", 0)
        if at >= 0 {
            let mut last: i32 = at
            while s_find(args, "--keep ", last + 1) >= 0 {
                last = s_find(args, "--keep ", last + 1)
            }
            let rest: string = s_from(args, last + 7)
            let sp: i32 = s_find_byte(rest, 32, 0)
            let mut keep: string = rest
            if sp >= 0 {
                keep = s_slice(rest, 0, sp)
            }
            let prog: string = path_stem(sl_get(argv, 0), ".flow")
            if s_len(keep) > 0 and rc == 0 and (not is_file(keep + "/" + prog + ".c") or not is_exec(keep + "/" + prog)) {
                outln("  " + name + ": " + keep + " lacks " + prog + ".c or " + prog)
                ok = false
            }
        }
        if ok {
            pass = pass + 1
        } else {
            outln("FAIL " + name)
            fail = fail + 1
        }
    }

    if tr_python_called(log, "FAIL python was called:") {
        fail = fail + 1
    }
    outln("flow_run: " + s_itoa(pass) + " passed, " + s_itoa(fail) + " failed")
    tr_exit(fail)
    return 0
}
