# N-Body Benchmark - Tests floating-point and struct performance
# Simulates gravitational interactions between bodies
# Based on the Computer Language Benchmarks Game

extern {
    function clock() -> i64
    function printf(fmt: string, val: f64) -> i32
    function sqrt(x: f64) -> f64
}

const CLOCKS_PER_SEC: f64 = 1000000.0
const PI: f64 = 3.141592653589793
const SOLAR_MASS: f64 = 39.47841760435743  # 4 * PI * PI
const DAYS_PER_YEAR: f64 = 365.24

struct Body {
    x: f64, y: f64, z: f64,
    vx: f64, vy: f64, vz: f64,
    mass: f64
}

function advance(bodies: ptr<Body>, n: i32, dt: f64) {
    for i in 0 to n {
        for j in i + 1 to n {
            let dx: f64 = bodies[i].x - bodies[j].x
            let dy: f64 = bodies[i].y - bodies[j].y
            let dz: f64 = bodies[i].z - bodies[j].z
            
            let d2: f64 = dx * dx + dy * dy + dz * dz
            let mag: f64 = dt / (d2 * sqrt(d2))
            
            let mm_i: f64 = bodies[i].mass * mag
            let mm_j: f64 = bodies[j].mass * mag
            
            bodies[i].vx = bodies[i].vx - dx * mm_j
            bodies[i].vy = bodies[i].vy - dy * mm_j
            bodies[i].vz = bodies[i].vz - dz * mm_j
            
            bodies[j].vx = bodies[j].vx + dx * mm_i
            bodies[j].vy = bodies[j].vy + dy * mm_i
            bodies[j].vz = bodies[j].vz + dz * mm_i
        }
    }
    
    for i in 0 to n {
        bodies[i].x = bodies[i].x + dt * bodies[i].vx
        bodies[i].y = bodies[i].y + dt * bodies[i].vy
        bodies[i].z = bodies[i].z + dt * bodies[i].vz
    }
}

function energy(bodies: ptr<Body>, n: i32) -> f64 {
    let mut e: f64 = 0.0
    
    for i in 0 to n {
        let v2: f64 = bodies[i].vx * bodies[i].vx + 
                      bodies[i].vy * bodies[i].vy + 
                      bodies[i].vz * bodies[i].vz
        e = e + 0.5 * bodies[i].mass * v2
        
        for j in i + 1 to n {
            let dx: f64 = bodies[i].x - bodies[j].x
            let dy: f64 = bodies[i].y - bodies[j].y
            let dz: f64 = bodies[i].z - bodies[j].z
            let d: f64 = sqrt(dx * dx + dy * dy + dz * dz)
            e = e - bodies[i].mass * bodies[j].mass / d
        }
    }
    
    return e
}

function offset_momentum(bodies: ptr<Body>, n: i32) {
    let mut px: f64 = 0.0
    let mut py: f64 = 0.0
    let mut pz: f64 = 0.0
    
    for i in 0 to n {
        px = px + bodies[i].vx * bodies[i].mass
        py = py + bodies[i].vy * bodies[i].mass
        pz = pz + bodies[i].vz * bodies[i].mass
    }
    
    bodies[0].vx = 0.0 - px / SOLAR_MASS
    bodies[0].vy = 0.0 - py / SOLAR_MASS
    bodies[0].vz = 0.0 - pz / SOLAR_MASS
}

function main() -> i32 {
    println("==============================================")
    println("  N-BODY BENCHMARK (Solar System)")
    println("==============================================")
    println("")
    
    # Solar system: Sun, Jupiter, Saturn, Uranus, Neptune
    let bodies: array<Body, 5> = [
        # Sun
        Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: SOLAR_MASS },
        # Jupiter
        Body { 
            x: 4.84143144246472090, y: -1.16032004402742839, z: -0.103622044471123109,
            vx: 0.00166007664274403694 * DAYS_PER_YEAR, 
            vy: 0.00769901118419740425 * DAYS_PER_YEAR, 
            vz: -0.0000690460016972063023 * DAYS_PER_YEAR,
            mass: 0.000954791938424326609 * SOLAR_MASS
        },
        # Saturn
        Body { 
            x: 8.34336671824457987, y: 4.12479856412430479, z: -0.403523417114321381,
            vx: -0.00276742510726862411 * DAYS_PER_YEAR, 
            vy: 0.00499852801234917238 * DAYS_PER_YEAR, 
            vz: 0.0000230417297573763929 * DAYS_PER_YEAR,
            mass: 0.000285885980666130812 * SOLAR_MASS
        },
        # Uranus
        Body { 
            x: 12.8943695621391310, y: -15.1111514016986312, z: -0.223307578892655734,
            vx: 0.00296460137564761618 * DAYS_PER_YEAR, 
            vy: 0.00237847173959480950 * DAYS_PER_YEAR, 
            vz: -0.0000296589568540237556 * DAYS_PER_YEAR,
            mass: 0.0000436624404335156298 * SOLAR_MASS
        },
        # Neptune
        Body { 
            x: 15.3796971148509165, y: -25.9193146099879641, z: 0.179258772950371181,
            vx: 0.00268067772490389322 * DAYS_PER_YEAR, 
            vy: 0.00162824170038242295 * DAYS_PER_YEAR, 
            vz: -0.0000951592254519715870 * DAYS_PER_YEAR,
            mass: 0.0000515138902046611451 * SOLAR_MASS
        }
    ]
    
    let bodies_ptr: ptr<Body> = bodies
    offset_momentum(bodies_ptr, 5)
    
    let e0: f64 = energy(bodies_ptr, 5)
    print("Initial energy: ")
    printf("%.9f", e0)
    println("")
    
    # Benchmark different iteration counts
    let iterations: array<i32, 3> = [1000000, 10000000, 50000000]
    
    for idx in 0 to 3 {
        let n: i32 = iterations[idx]
        
        # Reset bodies
        let bodies_reset: array<Body, 5> = [
            Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: SOLAR_MASS },
            Body { 
                x: 4.84143144246472090, y: -1.16032004402742839, z: -0.103622044471123109,
                vx: 0.00166007664274403694 * DAYS_PER_YEAR, 
                vy: 0.00769901118419740425 * DAYS_PER_YEAR, 
                vz: -0.0000690460016972063023 * DAYS_PER_YEAR,
                mass: 0.000954791938424326609 * SOLAR_MASS
            },
            Body { 
                x: 8.34336671824457987, y: 4.12479856412430479, z: -0.403523417114321381,
                vx: -0.00276742510726862411 * DAYS_PER_YEAR, 
                vy: 0.00499852801234917238 * DAYS_PER_YEAR, 
                vz: 0.0000230417297573763929 * DAYS_PER_YEAR,
                mass: 0.000285885980666130812 * SOLAR_MASS
            },
            Body { 
                x: 12.8943695621391310, y: -15.1111514016986312, z: -0.223307578892655734,
                vx: 0.00296460137564761618 * DAYS_PER_YEAR, 
                vy: 0.00237847173959480950 * DAYS_PER_YEAR, 
                vz: -0.0000296589568540237556 * DAYS_PER_YEAR,
                mass: 0.0000436624404335156298 * SOLAR_MASS
            },
            Body { 
                x: 15.3796971148509165, y: -25.9193146099879641, z: 0.179258772950371181,
                vx: 0.00268067772490389322 * DAYS_PER_YEAR, 
                vy: 0.00162824170038242295 * DAYS_PER_YEAR, 
                vz: -0.0000951592254519715870 * DAYS_PER_YEAR,
                mass: 0.0000515138902046611451 * SOLAR_MASS
            }
        ]
        let b_ptr: ptr<Body> = bodies_reset
        offset_momentum(b_ptr, 5)
        
        print("Running ")
        print(n)
        println(" iterations...")
        
        let start: i64 = clock()
        for i in 0 to n {
            advance(b_ptr, 5, 0.01)
        }
        let end: i64 = clock()
        
        let elapsed: f64 = (end - start) / CLOCKS_PER_SEC
        let e1: f64 = energy(b_ptr, 5)
        
        print("  Time: ")
        printf("%.3f", elapsed)
        print(" sec | Energy: ")
        printf("%.9f", e1)
        print(" | ")
        printf("%.2f", n / elapsed / 1000000.0)
        println(" M steps/sec")
    }
    
    println("")
    println("Benchmark complete.")
    return 0
}
