# An array literal used as a value gets the type of a compound literal
# (#1050). A bare `{ 1, 2, 3 }` is a C initializer list, which C accepts
# only after `=` in a declaration or nested in another list.
function main() -> i32 {
    if [10, 20, 30][1] != 20 {
        return 1
    }
    if [[1, 2], [3, 4]][1][0] != 3 {
        return 2
    }
    if len([1, 2, 3]) != 3 {
        return 3
    }
    let p: ptr<i32> = [7, 8, 9] as ptr<i32>
    if p[2] != 9 {
        return 4
    }
    let a = [1, 2, 3]
    if a[2] != 3 {
        return 5
    }
    if [1.5, 2.5][1] != 2.5 {
        return 6
    }
    return 0
}
