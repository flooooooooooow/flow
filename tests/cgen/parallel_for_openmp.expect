# The ascending branch carries the guarded OpenMP pragma (#1032).
+ #ifdef _OPENMP
+ #pragma omp parallel for
~ int32_t __flowc_pstep_[0-9]+ = 1;
~ if \(__flowc_pstep_[0-9]+ > 0\) \{
~ for \(int32_t i = 0; i < n; i \+= __flowc_pstep_[0-9]+\)
# A negative step takes the serial descending branch.
~ int32_t __flowc_pstep_[0-9]+ = \(-1\);
~ \} else if \(__flowc_pstep_[0-9]+ < 0\) \{
~ for \(int32_t j = n; j > 0; j \+= __flowc_pstep_[0-9]+\)
# A stepped parallel loop never also gets the vectorize hints.
- #pragma GCC ivdep
exit 0
