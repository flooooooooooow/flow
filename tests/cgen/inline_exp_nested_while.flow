function nested() -> f32 {
    let mut acc: f32 = 0.0
    let mut i: i32 = 0
    while i < 10 {
        let mut k: i32 = 0
        while k < 10 {
            let z: f32 = 0.0
            let p: f32 = 1.0 / (1.0 + exp((-z) as f64) as f32)
            acc = acc + p
            k = k + 1
        }
        i = i + 1
    }
    return acc
}

function main() -> i32 {
    let a: f32 = nested()
    if a > 49.9 && a < 50.1 {
        return 0
    }
    return 1
}
