# A stepless `for i in a to b` takes its direction once, outside the loop,
# so each emitted loop has a constant step (#1004).

function scale_for(x: ptr<f32>, y: ptr<f32>, a: f32, n: i32) -> void {
    for i in 0 to n {
        y[i] = y[i] + a * x[i]
    }
}

function count(lo: i32, hi: i32) -> i32 {
    let mut c: i32 = 0
    for k in lo to hi {
        c = c + 1
    }
    return c
}

function main() -> i32 {
    let x: [f32; 4] = [1.0, 2.0, 3.0, 4.0]
    let mut y: [f32; 4] = [0.0, 0.0, 0.0, 0.0]
    scale_for(x, y, 2.0, 4)
    if y[3] != 8.0 { return 1 }
    if count(2, 7) != 5 { return 2 }
    if count(7, 2) != 5 { return 3 }
    if count(3, 3) != 0 { return 4 }
    let mut down: i32 = 0
    for r in 5 to 0 {
        down = down * 10 + r
    }
    if down != 54321 { return 5 }
    let mut up: i32 = 0
    for r in 1 to 4 {
        up = up * 10 + r
    }
    if up != 123 { return 6 }
    return 0
}
