# Python host: flow_to_c(..., export_names=[...]), tests/unit/test_export_abi.py.
# A void alias calls without `return` (the Python host wrote `return greet();`).
flags --export add --export greet,answer --export pick --export nothere
+ /* Flow export aliases (#396) */
+ __attribute__((visibility("default"))) int32_t flow_export_add(int32_t a, int32_t b) { return add(a, b); }
+ __attribute__((visibility("default"))) void flow_export_greet(void) { greet(); }
+ __attribute__((visibility("default"))) int32_t flow_export_answer(void) { return answer(); }
+ __attribute__((visibility("default"))) int32_t flow_export_pick(int32_t a) { return pick_i32(a); }
+ /* --export nothere: not found in this TU */
- flow_export_main
- flow_export_nothere(
exit 0
stdout hello
