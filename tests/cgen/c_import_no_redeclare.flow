# @cImport must not re-declare anything the #include already provides.
# A duplicate typedef whose spelling differs from the header's is a C error
# on glibc. The fixture header is shaped like glibc's stdlib.h.
@cImport("c_import_no_redeclare/fixture.h")

extern {
    function puts(s: string) -> i32
}

function main() -> i32 {
    puts("ok")
    return 0
}
