# Elementwise and reduction loops get SIMD hints. Unproven pointer copies
# remain sequential: memmove changes loop semantics for shifted overlap.
+ #if defined(_OPENMP)
+ #pragma omp simd
+ #pragma omp simd reduction(+:
+ reduction(*:
+ reduction(-:
+ #pragma clang loop vectorize(enable) interleave(enable)
+ #pragma GCC ivdep
- memmove((void*)(&(
+ for (int32_t i = 0; i < (n); i = i + 1) {
exit 0
