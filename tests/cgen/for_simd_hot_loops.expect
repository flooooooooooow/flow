# Elementwise / reduction loops get portable SIMD hints; copies become memmove.
# Recognized f32 kernels also get GCC/clang vector_size loops (#739).
+ #if defined(_OPENMP)
+ #pragma omp simd
+ #pragma omp simd reduction(+:
+ reduction(*:
+ reduction(-:
+ #pragma clang loop vectorize(enable) interleave(enable)
+ #pragma GCC ivdep
+ memmove((void*)
+ FLOWC_HAS_V128
+ vector_size(16)
+ flowc_v4f32
+ for (int32_t i = 0; i < (n); i = i + 1) {
exit 0
