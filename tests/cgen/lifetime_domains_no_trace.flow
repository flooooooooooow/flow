# @lifetime annotations are checked and then leave no trace in the C.
extern {
    function printf(fmt: string, v: i32) -> i32
}

@lifetime(application)
let mut total: i32 = 0

@lifetime(callback)
function process(values: span<i32>) -> i32 {
    let mut acc: i32 = 0
    let mut i: i64 = 0
    while i < values.len {
        acc = acc + values[i]
        i = i + 1
    }
    return acc
}

@lifetime(session)
function run() -> i32 {
    let block: array<i32, 4> = [1, 2, 3, 4]
    total = process(block)
    return total
}

function main() -> i32 {
    let got: i32 = run()
    if got != 10 {
        return 1
    }
    return 0
}
