# Escaped quotes and backslashes in string literals reach C intact (#408).
function main() -> i32 {
    println("node [shape=box, style=\"filled\"];")
    let s: string = "a\"b\"c"
    println(s)
    let t: string = "hello\"world" + " test\"test"
    println(t)
    println("path\\to\\file")
    return 0
}
