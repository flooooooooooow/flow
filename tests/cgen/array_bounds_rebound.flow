# The literal bound is about the loop's own `i`. A body that shadows `i`
# indexes with a different value, so the check stays (#729).

function pick(xs: array<i32, 3>) -> i32 {
    let mut total: i32 = 0
    for i in 0 to 3 {
        let i: i32 = 2
        total = total + xs[i]
    }
    return total
}

function main() -> i32 {
    let values: array<i32, 3> = [4, 5, 6]
    return pick(values)
}
