# --export NAME appends a visible flow_export_NAME alias that forwards to the
# C symbol, the mangled one for an overload (#1030, #396). main calls one
# alias through an extern declaration, so the alias links and runs.
extern {
    function flow_export_add(a: i32, b: i32) -> i32
}

function add(a: i32, b: i32) -> i32 {
    return a + b
}

function greet() {
    println("hello")
}

function answer() -> i32 {
    return 42
}

function pick(a: i32) -> i32 {
    return a
}

function pick(a: f64) -> f64 {
    return a
}

function main() -> i32 {
    if flow_export_add(40, 2) != answer() {
        return 1
    }
    greet()
    return pick(0)
}
