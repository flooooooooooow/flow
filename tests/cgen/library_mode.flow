# --library emits a unit to link next to a program, as the Python host's
# --library did (#1030): no runtime checks or fault handler, plain C names
# with external linkage, and main is never moved onto a fiber.
import "stdlib/async.flow"

let mut calls: i32 = 0

function half(a: i32, b: i32) -> i32 {
    calls = calls + 1
    return (a / b) << 1
}

function main() -> i32 {
    let mut total: i32 = 0
    handle Async with FiberAsync {
        async_spawn(1)
        total = async_join(1)
    }
    return half(total, 2)
}
