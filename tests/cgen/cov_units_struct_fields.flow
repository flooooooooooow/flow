# Units of measure erase to double typedefs in C, and struct fields keep
# the unit typedef as their C type. Ported from
# tests/unit/test_coverage_units.py.
unit Meter
unit Second
unit Velocity = Meter / Second

struct Journey {
    distance: Meter,
    elapsed: Second,
}

function main() -> i32 {
    let j: Journey = Journey {
        distance: 100.0 as Meter,
        elapsed: 8.0 as Second
    }
    let v: Velocity = j.distance / j.elapsed
    if v != 12.5 as Velocity {
        return 1
    }
    return 0
}
