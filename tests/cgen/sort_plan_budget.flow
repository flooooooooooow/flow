# The merge plans keep their buffer on the C stack, capped at 256 KiB.
# 70000 i32 need 273.4 KiB, so both merges are rejected and insertion is
# the only plan left (#1054).
function main() -> i32 {
    let mut xs: array<i32, 70000> = [0]
    for i in 0 to 70000 {
        xs[i] = (i * 7919) % 97
    }
    xs |> sort
    for i in 1 to 70000 {
        if xs[i - 1] > xs[i] { return 1 }
    }
    return 0
}
