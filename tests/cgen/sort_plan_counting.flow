# A u8 or bool element type bounds the key range, so the stable counting
# plan applies with no analysis (#1054). A literal's range narrows it
# further: this i32 literal holds keys in [1, 9].
function main() -> i32 {
    let mut bytes: array<u8, 1024> = [0]
    for i in 0 to 1024 {
        bytes[i] = ((i * 91) % 251) as u8
    }
    bytes |> sort descending
    for i in 1 to 1024 {
        if bytes[i - 1] < bytes[i] { return 1 }
    }
    let mut flags: array<bool, 10> = [true, false, true, false, false, true, true, false, true, false]
    flags |> sort
    if flags[4] != false || flags[5] != true { return 2 }
    let mut lit: array<i32, 20> = [9, 1, 5, 5, 3, 8, 7, 2, 6, 4, 1, 9, 3, 3, 2, 8, 7, 6, 5, 4]
    lit |> sort
    if lit[0] != 1 || lit[1] != 1 || lit[19] != 9 { return 3 }
    return 0
}
