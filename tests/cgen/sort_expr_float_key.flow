# A float sort key uses IEEE 754 totalOrder, so a NaN key
# still leaves the finite keys ordered.
struct P { t: f64 }

function nan_of(z: f64) -> f64 {
    return z / z
}

function main() -> i32 {
    let zero: f64 = 0.0
    let nan: f64 = nan_of(zero)
    let mut ps: array<P, 5> = [
        P { t: 3.0 }, P { t: nan }, P { t: 1.0 }, P { t: -2.0 }, P { t: 2.0 }
    ]
    ps |> sortBy [asc .t]
    # 0.0 / 0.0 has a platform-dependent sign bit, so the NaN lands at
    # one end or the other. The finite keys sit in order either way.
    let mut o: i32 = 0
    if ps[0].t != ps[0].t { o = 1 }
    if ps[o].t != -2.0 { return 1 }
    if ps[o + 1].t != 1.0 { return 2 }
    if ps[o + 2].t != 2.0 { return 3 }
    if ps[o + 3].t != 3.0 { return 4 }
    let last: f64 = ps[4 - 4 * o].t
    if last == last { return 5 }

    return 0
}
