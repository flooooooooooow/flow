# Match lowering: guarded or-patterns, string literal patterns compared by
# content, string or-patterns, a string pattern with a guard, and a
# three-deep nested struct pattern. Ported from
# tests/unit/test_coverage_match.py.
struct Leaf { v: i32, }
struct Mid { leaf: Leaf, m: i32, }
struct Top { mid: Mid, t: i32, }

function guarded_or(n: i32) -> i32 {
    match n {
        1 | 2 | 3 if n == 2 => { return 100 }
        _ => { return 200 }
    }
    return -1
}

function classify(s: string) -> i32 {
    match s {
        "on" => { return 1 }
        "off" => { return 0 }
        _ => { return -1 }
    }
    return -1
}

function yes(s: string) -> i32 {
    match s {
        "yes" | "y" => { return 1 }
        _ => { return 0 }
    }
    return -1
}

function go(s: string, n: i32) -> i32 {
    match s {
        "go" if n > 0 => { return 1 }
        "go" => { return 2 }
        _ => { return 3 }
    }
    return -1
}

function deep(x: Top) -> i32 {
    match x {
        Top(Mid(Leaf(0), m), t) => { return 1 }
        Top(Mid(Leaf(v), 0), t) => { return 2 }
        Top(Mid(Leaf(v), m), t) if v > t => { return 3 }
        _ => { return 4 }
    }
    return -1
}

function main() -> i32 {
    if guarded_or(2) != 100 { return 1 }
    if guarded_or(3) != 200 { return 2 }
    if guarded_or(9) != 200 { return 3 }
    if classify("on") != 1 { return 4 }
    if classify("off") != 0 { return 5 }
    if classify("x") != -1 { return 6 }
    if yes("y") != 1 { return 7 }
    if yes("yes") != 1 { return 8 }
    if yes("no") != 0 { return 9 }
    if go("go", 5) != 1 { return 10 }
    if go("go", 0) != 2 { return 11 }
    if go("stop", 5) != 3 { return 12 }
    let a: Top = Top { mid: Mid { leaf: Leaf { v: 0 }, m: 1 }, t: 2 }
    let b: Top = Top { mid: Mid { leaf: Leaf { v: 5 }, m: 0 }, t: 2 }
    let c: Top = Top { mid: Mid { leaf: Leaf { v: 5 }, m: 1 }, t: 2 }
    let d: Top = Top { mid: Mid { leaf: Leaf { v: 1 }, m: 1 }, t: 2 }
    if deep(a) != 1 { return 13 }
    if deep(b) != 2 { return 14 }
    if deep(c) != 3 { return 15 }
    if deep(d) != 4 { return 16 }
    return 0
}
