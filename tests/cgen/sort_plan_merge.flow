# Larger sorts take a merge plan with the buffer on the stack (#1054).
# Python host: natural_merge for the plain and `adaptive` sites, and
# bottom_up_merge where `general` pins it.
function fill(xs: ptr<i32>, n: i32) -> i32 {
    for i in 0 to n {
        xs[i] = (i * 37) % 23
    }
    return 0
}

function ascending(xs: ptr<i32>, n: i32) -> i32 {
    for i in 1 to n {
        if xs[i - 1] > xs[i] {
            return 0
        }
    }
    return 1
}

function main() -> i32 {
    let mut a: array<i32, 600> = [0]
    fill(a, 600)
    a |> sort
    if ascending(a, 600) != 1 { return 1 }
    let mut b: array<i32, 600> = [0]
    fill(b, 600)
    b |> sort general
    if ascending(b, 600) != 1 { return 2 }
    let mut c: array<i32, 600> = [0]
    fill(c, 600)
    c |> sort descending adaptive
    for i in 1 to 600 {
        if c[i - 1] < c[i] { return 3 }
    }
    return 0
}
