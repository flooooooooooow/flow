# In a bundle each module aliases the --export names it defines: subtract
# comes from stdlib/math.flow, twice from this file (#1030).
import "stdlib/math.flow"

function twice(x: f32) -> f32 {
    return x * 2.0
}

function main() -> i32 {
    let d = subtract(twice(3.0), 1.0)
    if d != 5.0 {
        return 1
    }
    return 0
}
