# Hybrid events lowered by flowc: each `when` keeps its own guard memory,
# guards run in declaration order, and a reset may target a state other
# than the one the guard watches. Ported from
# tests/unit/test_coverage_hybrid_events.py. The run-time ordering checks
# live in tests/lang/test_hybrid_events.flow.
flow F {
    state t : f64 = 0.0
    state a : f64 = 1.0
    state b : f64 = 0.0
    t evolves as 1.0
    when t reaches 1.0 {
        a becomes a * 2.0
    }
    when t reaches 1.0 {
        b becomes a
    }
}

flow Counter {
    state t : f64 = 0.0
    state hits : f64 = 0.0
    t evolves as 1.0
    when t reaches 1.0 {
        hits becomes hits + 1.0
    }
}

function main() -> i32 {
    let mut f: F = F_new()
    let mut c: Counter = Counter_new()
    for i in 0 to 8 {
        F_step(&f, 0.25)
        Counter_step(&c, 0.25)
    }
    # The second event sees the first event's reset.
    if f.a != 2.0 {
        return 1
    }
    if f.b != 2.0 {
        return 2
    }
    if c.hits != 1.0 {
        return 3
    }
    return 0
}
