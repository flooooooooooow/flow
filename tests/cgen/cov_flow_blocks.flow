# Flow blocks lowered by flowc: two flows in one file keep separate APIs,
# derivs reads params and inputs through self, and `method rk4` runs four
# derivs stages. Ported from tests/unit/test_coverage_flow_blocks.py.
flow Decay {
    state x : f64 = 1.0
    param k : f64 = 0.5
    x evolves as -k * x
}

flow Ramp {
    state y : f64 = 0.0
    input drive : f64
    param gain : f64 = 2.0
    y evolves as gain * drive - y
}

flow Motor {
    state speed : f64 = 0.0
    input voltage : f64
    param damping : f64 = 0.25
    param gain : f64 = 2.0
    speed evolves as gain * voltage - damping * speed
}

flow Spring {
    state x : f64 = 1.0
    state v : f64 = 0.0
    solver { dt 1 ms  method rk4 }
    x evolves as v
    v evolves as 0.0 - x
}

function main() -> i32 {
    let mut d: Decay = Decay_new()
    let mut r: Ramp = Ramp_new()
    let mut s: Spring = Spring_new()
    r.drive = 1.0
    for i in 0 to 10 {
        Decay_step(&d, 0.1)
    }
    Ramp_step(&r, 0.5)
    Spring_step(&s, 0.001)
    if d.x >= 1.0 {
        return 1
    }
    if r.y != 1.0 {
        return 2
    }
    if s.x >= 1.0 {
        return 3
    }
    return 0
}
