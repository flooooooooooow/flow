# A small sort takes the stable in-place insertion plan: no merge buffer.
# Python host: insertion, 6.25 vs 17 for bottom_up_merge (#1054).
struct P { k: i32, tag: i32 }

function main() -> i32 {
    let mut xs: array<i32, 5> = [3, 1, 4, 1, 5]
    xs |> sort
    let mut ps: array<P, 4> = [P { k: 2, tag: 0 }, P { k: 1, tag: 1 }, P { k: 2, tag: 2 }, P { k: 1, tag: 3 }]
    ps |> sortBy [asc .k]
    if xs[0] != 1 || xs[1] != 1 || xs[4] != 5 { return 1 }
    if ps[0].tag != 1 || ps[1].tag != 3 || ps[2].tag != 0 || ps[3].tag != 2 { return 2 }
    return 0
}
