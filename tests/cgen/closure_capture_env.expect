# call site passes the env, token-safe substitution, bare pointer for a
# non-capturing lambda, creation-scope capture types, struct capture.
~ typedef struct \{ int32_t \(\*fn\)\(lambda_[0-9]+_env\*, int32_t\); lambda_[0-9]+_env env; \} lambda_[0-9]+_closure;
~ \.env = \{ \.a = a, \.b = b \}
+ return ((_env->a + _env->b) + u);
~ f\.fn\(&f\.env, 3\)
+ return (x_total + _env->x);
- _env->x_total
~ int32_t \(\*dbl\)\(int32_t\) = &__flowc_lambda_[0-9]+;
+ return dbl(21);
~ typedef struct \{ int32_t \(\*fn\)\(int32_t\); \} lambda_[0-9]+_closure;
+   double scale;
+   Point p;
+ return ((_env->p).x + z);
exit 0
