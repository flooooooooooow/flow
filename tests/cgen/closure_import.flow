# A lambda and a named function passed to an imported function-typed
# parameter are wrapped as closures.
import "tests/fixtures/closure_import/mathlib.flow"

function twice(v: f32) -> f32 {
    return v * 2.0
}

function main() -> i32 {
    let a: f32 = apply(|v: f32| -> f32 { return v + 1.0 }, 3.0)
    let b: f32 = apply(twice, 4.0)
    return (a + b) as i32 - 12
}
