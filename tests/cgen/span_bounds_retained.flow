# An index that is not the proven induction variable keeps the default
# span bounds check (#615, #729).

function pick(xs: span<i32>, k: i32) -> i32 {
    return xs[k]
}

function main() -> i32 {
    let values: [i32; 3] = [4, 5, 6]
    if pick(values, 1) != 5 {
        return 1
    }
    return 0
}
