# Flow-native language test: a store whose right side moves the target.
#
# In `a[i] = grow()`, grow() may realloc the storage `a` points to. C leaves
# the order of the two operands of `=` unspecified, so the emitted C must
# not read `a` before the call: gcc does, and the store then lands in the
# freed block. The same holds for a field reached through a pointer
# (`t.data[i] = g()`, `h.p.x = g()`) when g moves that pointer.
# Exit 0 on success; a nonzero exit identifies the failing check.

extern {
    function malloc(size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
}

struct Table {
    data: ptr<i32>,
    len: i32,
    cap: i32
}

struct Point {
    x: i32,
    y: i32
}

struct Holder {
    p: ptr<Point>
}

let mut arr: ptr<i32> = null
let mut arr_cap: i32 = 0

# Grow the global array to twice its size and return a value.
function grow() -> i32 {
    arr_cap = arr_cap * 2
    arr = realloc(arr as ptr<void>, (arr_cap as i64) * 4) as ptr<i32>
    return 42
}

# Append to the table: the data array moves once it is full.
function push(t: ptr<Table>, v: i32) -> i32 {
    if t.len == t.cap {
        t.cap = t.cap * 2
        t.data = realloc(t.data as ptr<void>, (t.cap as i64) * 4) as ptr<i32>
    }
    t.data[t.len] = v
    t.len = t.len + 1
    return t.len - 1
}

# Move the holder's point to a new block and return a value.
function move_point(h: ptr<Holder>) -> i32 {
    h.p = realloc(h.p as ptr<void>, 4096) as ptr<Point>
    return 9
}

function main() -> i32 {
    # a[i] = call() where the call reallocates a.
    arr_cap = 1
    arr = malloc(4) as ptr<i32>
    let mut i: i32 = 0
    while i < 12 {
        arr[0] = grow()
        if arr[0] != 42 {
            return 1
        }
        i = i + 1
    }

    # t.data[i] = call() where the call reallocates t.data.
    let t: ptr<Table> = malloc(16) as ptr<Table>
    t.len = 0
    t.cap = 1
    t.data = malloc(4) as ptr<i32>
    push(t, 0)
    i = 0
    while i < 12 {
        t.data[0] = push(t, i)
        if t.data[0] != t.len - 1 {
            return 2
        }
        i = i + 1
    }

    # h.p.x = call() where the call moves h.p.
    let h: ptr<Holder> = malloc(8) as ptr<Holder>
    h.p = malloc(8) as ptr<Point>
    h.p.x = 1
    h.p.y = 2
    i = 0
    while i < 4 {
        h.p.x = move_point(h)
        if h.p.x != 9 or h.p.y != 2 {
            return 3
        }
        i = i + 1
    }

    # A right side with no call is unchanged.
    arr[1] = 5
    h.p.y = arr[1] + 1
    if h.p.y != 6 {
        return 4
    }
    return 0
}
