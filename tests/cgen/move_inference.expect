# Then-branch last-use argument update may move; the other path reads p.
+ consume(({ p.x = 7; p; }));
# A loop that can iterate again must not move the outer binding.
~ __flowc_sl[0-9]+ = \(p\); __flowc_sl[0-9]+\.x = i;
