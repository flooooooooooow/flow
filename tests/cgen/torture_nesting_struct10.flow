# A struct nest ten deep, built by one nested literal and read back
# through a ten-step access chain.
struct S0 { v: i32 }
struct S1 { inner: S0 }
struct S2 { inner: S1 }
struct S3 { inner: S2 }
struct S4 { inner: S3 }
struct S5 { inner: S4 }
struct S6 { inner: S5 }
struct S7 { inner: S6 }
struct S8 { inner: S7 }
struct S9 { inner: S8 }
struct S10 { inner: S9 }

function main() -> i32 {
    let x: S10 = S10 { inner: S9 { inner: S8 { inner: S7 { inner: S6 { inner: S5 { inner: S4 { inner: S3 { inner: S2 { inner: S1 { inner: S0 { v: 7 } } } } } } } } } } }
    if x.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.v == 7 {
        return 0
    }
    return 1
}
