# sum(range) lowers to the closed-form helper, with no loop, for literal and
# runtime bounds alike. From tests/integration/test_range_sum.py.
# The values are checked in tests/lang/test_range_sum_step.flow.
function sum_step() -> i32 {
    return sum(0..10 step 3)
}

function sum_runtime(start: i32, end: i32, step: i32) -> i32 {
    return sum(start..end step step)
}

function main() -> i32 {
    if sum_step() != 18 {
        return 1
    }
    if sum_runtime(10, 0, -3) != 22 {
        return 2
    }
    return 0
}
