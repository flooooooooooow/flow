# The last arm of an exhaustive match is a plain `else`, so a function whose
# arms all return has no fall-through path (#620, #1034). Exhaustive means
# every variant of an enum (matching `e.tag` or `e`), or true and false on a
# bool. A match that misses a variant keeps its `else if`.

enum Kind { A, B, C }

function by_tag(k: Kind) -> i32 {
    match k.tag {
        Kind_A => { return 1 }
        Kind_B => { return 2 }
        Kind_C => { return 3 }
    }
}

function by_value(k: Kind) -> i32 {
    match k {
        Kind_C => { return 30 }
        Kind_A => { return 10 }
        Kind_B => { return 20 }
    }
}

function by_bool(b: bool) -> i32 {
    match b {
        true => { return 5 }
        false => { return 6 }
    }
}

function partial(k: Kind) -> i32 {
    match k.tag {
        Kind_A => { return 1 }
        Kind_B => { return 2 }
    }
    return 9
}

function main() -> i32 {
    if by_tag(Kind { tag: Kind_C }) != 3 {
        return 1
    }
    if by_value(Kind { tag: Kind_B }) != 20 {
        return 2
    }
    if by_bool(false) != 6 {
        return 3
    }
    if partial(Kind { tag: Kind_C }) != 9 {
        return 4
    }
    return 0
}
