# Function attributes lower to C declaration specifiers on both the
# prototype and the definition, as the Python host emitted them (#1028).
# @inline is `static inline` unless the symbol keeps external linkage
# (exported, @flow_api or main), where it is `extern inline`.
@inline
function add(a: i32, b: i32) -> i32 {
    return a + b
}

@noinline
function sub(a: i32, b: i32) -> i32 {
    return a - b
}

@always_inline
function mul(a: i32, b: i32) -> i32 {
    return a * b
}

@inline
export function exported_add(a: i32, b: i32) -> i32 {
    return a + b
}

@always_inline
@flow_api
function api_mul(a: i32, b: i32) -> i32 {
    return a * b
}

function main() -> i32 {
    return add(1, 2) + sub(3, 1) + mul(2, 2) + exported_add(0, 0) + api_mul(1, 1) - 10
}
