# A variadic extern keeps its `...` in the emitted prototype, as on the
# Python host (#1033). dprintf is not on flowc's libc allowlist, so flowc
# emits its prototype, and without the ellipsis it clashes with stdio.h.

extern { function dprintf(fd: i32, fmt: string, ...) -> i32 }

function main() -> i32 {
    let n: i32 = dprintf(1, "va %d %s\n", 42, "ok")
    if n != 9 {
        return 1
    }
    return 0
}
