# Counted whiles become for loops so SIMD hints apply (#739).
# Overlapping while-copies stay elementwise (memmove would change them).
+ for (; i < (n); i = i + 1)
+ #pragma clang loop vectorize(enable) interleave(enable)
# No OpenMP simd: `for (;` is not a canonical OpenMP loop, so clang
# -fopenmp rejects it (lib/runtime/audio_simd.flow), and simd would
# privatize the counter the code reads after the loop.
- #pragma omp simd
- while (i < n)
exit 0
