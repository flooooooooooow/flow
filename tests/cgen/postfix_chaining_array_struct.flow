# Field access on an indexed array-of-structs element.
struct Note {
    pitch: i32,
    duration: i32
}

function main() -> i32 {
    let melody: array<Note, 4> = [
        Note { pitch: 60, duration: 1 },
        Note { pitch: 62, duration: 2 },
        Note { pitch: 64, duration: 3 },
        Note { pitch: 65, duration: 4 }
    ]
    let mut total: i32 = 0
    for i in 0 to 4 {
        total = total + melody[i].duration
    }
    if total == 10 {
        print("PASS")
        return 0
    }
    print("FAIL")
    return 1
}
