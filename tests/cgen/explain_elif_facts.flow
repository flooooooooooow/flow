# An elif condition sees the ordering facts known before the if, as on
# the Python host (#1054): xs is a literal in ascending order, so both
# finds use binary search. The report is the Python host's --explain text.
function pick(k: i32) -> i32 {
    let xs: array<i32, 5> = [1, 2, 3, 4, 5]
    if k == 0 {
        return 0
    } elif (xs |> find(3)) == 2 {
        return 1
    } elif (xs |> find(4)) == 3 {
        return 2
    }
    return 3
}

function main() -> i32 {
    if pick(1) != 1 {
        return 1
    }
    return 0
}
