flags --strict
+ void Decay_step(Decay* self, double dt)
+ void Ramp_step(Ramp* self, double dt)
+ void Decay_derivs(Decay* self, double* d_x)
+ void Ramp_derivs(Ramp* self, double* d_y)
# derivs only reads params, inputs and states through self.
+ d_speed[0] = ((self->gain * self->voltage) - (self->damping * self->speed));
# rk4 evaluates derivs at four stages from a saved y0.
+ double y0_x = self->x;
+ Spring_derivs(self, (&k1_x), (&k1_v));
+ Spring_derivs(self, (&k2_x), (&k2_v));
+ Spring_derivs(self, (&k3_x), (&k3_v));
+ Spring_derivs(self, (&k4_x), (&k4_v));
exit 0
