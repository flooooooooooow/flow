# Nothing proves the pointer parameters of the two stepped elementwise
# loops are independent; they may be shifted aliases. The loops keep the
# clang vectorize request and get no OpenMP simd or GCC ivdep, which would
# override the C compiler's dependence check (#739).
+ #if defined(__clang__)
+ #pragma clang loop vectorize(enable) interleave(enable)
- #pragma omp simd
- #pragma GCC ivdep
+ for (int32_t i = 0; i < n; i = i + 1) {
+ for (int32_t k = 0; k < n; k = k + 1) {
exit 0
