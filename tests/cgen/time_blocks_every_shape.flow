# The C shape of `every` and `solver`: an i64 nanosecond accumulator per
# every block, zeroed at init, a firing loop with a catch-up cap, the
# every block run after integration and before events and outputs, and
# a default dt taken from the solver block (1 ms when there is none).
flow Counter {
    state t     : f64 = 0.0
    state ticks : f64 = 0.0

    solver { dt 1 ms  method euler }

    t evolves as 1.0

    every 10 ms {
        ticks becomes ticks + 1.0
    }
}

flow Mixed {
    state x : f64 = 0.0
    state n : f64 = 0.0
    x evolves as 1.0
    every 10 ms {
        n becomes n + 1.0
    }
    when x reaches 1.0 {
        x becomes 0.0
    }
}

flow Gauge {
    state level : f64 = 0.0
    output display : f64 = level * 100.0
    every 10 ms {
        level becomes level + 1.0
    }
}

flow Plain {
    state x : f64 = 0.0
    x evolves as 1.0
}

function main() -> i32 {
    let mut c: Counter = Counter_new()
    for k in 0 to 25 {
        Counter_step(&c, Counter_default_dt())
    }
    let mut m: Mixed = Mixed_new()
    Mixed_step(&m, 0.05)
    let mut g: Gauge = Gauge_new()
    Gauge_step(&g, 0.02)
    let mut p: Plain = Plain_new()
    Plain_step(&p, Plain_default_dt())
    return 0
}
