# A tail call to an extern shim whose name starts with the caller's name
# stays a real call (#517). Genuine self-recursion in tail position still
# runs in constant stack.
@cEmbed("static inline int32_t foo_get_c_c(int32_t i) { return i + 1; }")
extern {
    function foo_get_c_c(i: i32) -> i32
}

export function foo_get(i: i32) -> i32 {
    return foo_get_c_c(i)
}

export function countdown(n: i32) -> i32 {
    if n <= 0 {
        return 0
    } else {
        return countdown(n - 1)
    }
}

function main() -> i32 {
    let a: i32 = foo_get(41)
    let b: i32 = countdown(10000000)
    return a + b
}
