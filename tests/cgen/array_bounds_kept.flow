# A literal bound larger than the array proves nothing: the check stays (#729).

function sum(xs: array<i32, 3>) -> i32 {
    let mut total: i32 = 0
    for i in 0 to 4 {
        if i < 3 {
            total = total + xs[i]
        }
    }
    return total
}

function main() -> i32 {
    let values: array<i32, 3> = [4, 5, 6]
    return sum(values)
}
