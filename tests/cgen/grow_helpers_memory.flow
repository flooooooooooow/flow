# stdlib/memory growth helpers (#424): alloc_uninit is malloc, grow_uninit is
# realloc, and grow_zeroed zeros only the new region.
import "stdlib/memory.flow"

function main() -> i32 {
    let p: ptr<void> = alloc_uninit(1, 4)
    let b: ptr<i8> = p
    b[0] = 7
    b[1] = 7
    b[2] = 7
    b[3] = 7
    let q: ptr<void> = grow_zeroed(p, 4, 16)
    let c: ptr<i8> = q
    let mut sum: i32 = 0
    let mut i: i64 = 0
    while i < 16 {
        sum = sum + (c[i] as i32)
        i = i + 1
    }
    let r: ptr<void> = grow_uninit(q, 32)
    let d: ptr<i8> = r
    if d[0] != 7 {
        return 1
    }
    free(r)
    return sum
}
