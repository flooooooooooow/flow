# `acc = acc + acc * 2` reads the accumulator in both operands. It is an
# ordered recurrence, so it must not get an OpenMP reduction clause (#739).

function nonlinear(n: i32) -> i32 {
    let mut acc: i32 = 1
    for i in 0 to n {
        acc = acc + acc * 2
    }
    return acc
}

function main() -> i32 {
    if nonlinear(4) != 81 { return 1 }
    return 0
}
