# Loops the vectorize hints must not reach (#414, #1031, #739): a branch, a
# call outside the math set, a call statement, or a nested loop.
# for_vectorize_pragma and for_simd_hot_loops have the hinted forms.

function helper(x: i32) -> i32 {
    return x + 1
}

function touch(a: ptr<i32>) -> void {
    a[0] = a[0] + 1
}

function branch(a: ptr<i32>, n: i32) -> i32 {
    let mut s: i32 = 0
    for i in 0 to n step 2 {
        if a[i] > 0 {
            s = s + a[i]
        }
    }
    return s
}

function call_value(a: ptr<i32>, n: i32) -> void {
    for i in 0 to n step 1 {
        a[i] = helper(a[i])
    }
}

function call_stmt(a: ptr<i32>, n: i32) -> void {
    for i in 0 to n step 1 {
        touch(a)
    }
}

function nested(a: ptr<i32>, n: i32) -> void {
    for i in 0 to n step 1 {
        while a[i] > 100 {
            a[i] = a[i] - 100
        }
    }
}

function main() -> i32 {
    let mut buf: [i32; 4] = [1, 2, 3, 4]
    call_value(&buf[0], 4)
    call_stmt(&buf[0], 2)
    nested(&buf[0], 4)
    # buf = [4, 3, 4, 5]; the even indices sum to 8.
    return branch(&buf[0], 4)
}
