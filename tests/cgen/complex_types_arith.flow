# c64 lowers to C99 `float complex` from <complex.h>, and the constructor
# builds the value with the `I` macro. complex * real stays a C
# complex-by-real multiply, which C evaluates element-wise.
function main() -> i32 {
    let z: c64 = c64(3.0, 4.0)
    let w: c64 = c64(1.0, 2.0)
    let s: c64 = z + w
    if creal(s) != 4.0 {
        return 1
    }
    if cimag(s) != 6.0 {
        return 2
    }
    let k: f32 = 3.0
    let p: c64 = z * k
    if creal(p) != 9.0 {
        return 3
    }
    if cimag(p) != 12.0 {
        return 4
    }
    if cabs(z) != 5.0 {
        return 5
    }
    return 0
}
