# A fork source feeding several record fields is evaluated once.
# From tests/integration/test_pipeline_examples.py.
struct Pair { a: i32, b: i32 }

let mut calls: i32 = 0

function twice(x: i32) -> i32 { return x * 2 }
function square(x: i32) -> i32 { return x * x }

function frames(x: i32) -> i32 {
    calls = calls + 1
    return x + 1
}

function main() -> i32 {
    let p: Pair = frames(7) |> Pair { a = twice, b = square }
    if p.a != 16 {
        return 1
    }
    if p.b != 64 {
        return 2
    }
    if calls != 1 {
        return 3
    }
    return 0
}
