# `parallel for` lowers to the Python host's OpenMP form (#1032): an
# ascending loop under `#pragma omp parallel for` when the C compiler defines
# _OPENMP, and a serial descending loop for a negative step. Without OpenMP
# both are ordinary serial loops.

function fill(a: ptr<i32>, n: i32) -> void {
    parallel for i in 0 to n {
        a[i] = i * i
    }
}

function fill_down(a: ptr<i32>, n: i32) -> void {
    parallel for j in n to 0 step -1 {
        a[j - 1] = j
    }
}

function main() -> i32 {
    let mut buf: [i32; 8] = [0, 0, 0, 0, 0, 0, 0, 0]
    fill(&buf[0], 8)
    if buf[7] != 49 {
        return 1
    }
    fill_down(&buf[0], 8)
    if buf[0] != 1 or buf[7] != 8 {
        return 2
    }
    return 0
}
