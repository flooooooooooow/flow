# A call on the right of a store through a pointer runs before the store:
# gcc reads `arr` before grow() in `arr[0] = grow();` and writes the freed
# block. A right side with no call keeps the plain form.
~ \{ __typeof__\(arr\[0\]\) __flowc_st[0-9]+ = grow\(\); arr\[0\] = __flowc_st[0-9]+; \}
~ __typeof__\(t->data\[0\]\) __flowc_st[0-9]+ = push\(t, i\);
~ __typeof__\(h->p->x\) __flowc_st[0-9]+ = move_point\(h\);
- arr[0] = grow();
+ arr[1] = 5;
+ h->p->y = (arr[1] + 1);
+ t->len = (t->len + 1);
exit 0
