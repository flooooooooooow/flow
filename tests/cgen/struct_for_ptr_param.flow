# A struct value passed where a plain call wants ptr<T> is a type error
# (#1080). As a method receiver the address is taken, so `m.take()` is fine.

struct M {
    n: i32
}

function take(m: ptr<M>) -> i32 {
    return m.n
}

function main() -> i32 {
    let m: M = M { n: 1 }
    let a: i32 = m.take()
    return take(m) - a
}
