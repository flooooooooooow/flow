# A user `find` is called by name, not through the builtin, and a user
# `bsearch` with three parameters is renamed away from libc's (#1045).
function find(xs: ptr<i32>, n: i32, target: i32) -> i32 {
    for i in 0 to n {
        if xs[i] == target {
            return i
        }
    }
    return -1
}

function bsearch(xs: ptr<i32>, n: i32, target: i32) -> i32 {
    return find(xs, n, target)
}

function main() -> i32 {
    let xs: [i32; 5] = [4, 8, 15, 16, 23]
    return find(xs, 5, 15) + bsearch(xs, 5, 23) - 6
}
