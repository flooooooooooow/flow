# In a library unit every function keeps external linkage, so @inline is
# `extern inline` there, as the Python host's _can_use_static_linkage chose
# for --library (#1030, #1028).
@inline
function twice(a: i32) -> i32 {
    return a * 2
}

@always_inline
function thrice(a: i32) -> i32 {
    return a * 3
}
