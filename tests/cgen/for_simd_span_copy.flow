# Unit-stride span copies lower to memmove through `.data` (#739).

function copy_span(dst: span<mut i32>, src: span<i32>, n: i32) -> void {
    for i in 0 to n {
        dst[i] = src[i]
    }
}

function main() -> i32 {
    let mut a: [i32; 4] = [0, 0, 0, 0]
    let b: [i32; 4] = [9, 8, 7, 6]
    copy_span(a[0..4], b[0..4], 4)
    if a[0] != 9 {
        return 1
    }
    if a[3] != 6 {
        return 2
    }
    return 0
}
