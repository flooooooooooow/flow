# @target lowers to __attribute__((target("..."))) after validation, with
# the spec normalized (whitespace dropped), as the Python host did (#1028).
# No exit line: whether a feature exists depends on the host C compiler.
@target("avx2")
function bump(a: i32) -> i32 {
    return a + 1
}

@noinline
@target("arch=x86-64+avx2, tune=native")
function scale(a: i32) -> i32 {
    return a * 2
}

@inline
@target("+sse4.2")
function both(a: i32) -> i32 {
    return a
}

function main() -> i32 {
    return bump(0) + scale(1) + both(0) - 3
}
