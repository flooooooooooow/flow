# A float sum keeps the order written in the source: adding 1.0 to 1.0e8 in f32
# rounds the 1.0 away, so a reassociated or vector-width sum gives another answer.

function step(a: f32, b: f32) -> f32 {
    return a + b
}

function sum_f32(x: ptr<f32>, n: i32) -> f32 {
    let mut s: f32 = 0.0
    for i in 0 to n {
        s = s + x[i]
    }
    return s
}

function sum_f32_ordered(x: ptr<f32>, n: i32) -> f32 {
    let mut s: f32 = 0.0
    for i in 0 to n {
        s = step(s, x[i])
    }
    return s
}

function main() -> i32 {
    let mut x: [f32; 64] = [0.0; 64]
    for i in 0 to 64 {
        x[i] = 1.0
    }
    x[0] = 100000000.0
    x[63] = 0.0 - 100000000.0
    let got: f32 = sum_f32(&x[0], 64)
    let want: f32 = sum_f32_ordered(&x[0], 64)
    printf("sum %f ordered %f\n", got as f64, want as f64)
    if got != want { return 1 }
    return 0
}
