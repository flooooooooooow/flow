# An array literal in a value position carries its element type (#1050).
+ (int32_t[]){ 10, 20, 30 }[1]
+ (int32_t[][2]){ { 1, 2 }, { 3, 4 } }[1][0]
+ (int32_t*)((int32_t[]){ 7, 8, 9 })
+ (double[]){ 1.5, 2.5 }[1]
# len of a literal is its own count, not a read of a C object.
+ ((int32_t)3)
# An unannotated let takes its dimensions from the literal.
+ int32_t a[3] = { 1, 2, 3 };
exit 0
