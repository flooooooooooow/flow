# The f32 kernels stay when they compute what the scalar loop computes:
# a scale by an f32 name, or by a literal an f32 holds exactly (0.5),
# where one double product rounds to the same float (#729).

function scale_half(y: span<mut f32>) {
    for i in 0 to y.len {
        y[i] = y[i] * 0.5
    }
}

function scale_f32(y: span<mut f32>, a: f32) {
    for i in 0 to y.len {
        y[i] = y[i] * a
    }
}

function main() -> i32 {
    let mut vals: array<f32, 5>
    for i in 0 to 5 {
        vals[i] = 1.0
    }
    scale_half(vals)
    scale_f32(vals, 3.0)
    if vals[4] != 1.5 {
        return 1
    }
    return 0
}
