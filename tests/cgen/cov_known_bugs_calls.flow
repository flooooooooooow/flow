# Call lowering cases that were once bugs. Ported from
# tests/unit/test_coverage_known_bugs.py.
# - An extern call keeps its C name.
# - A bare null argument reaches a ptr<T> parameter as NULL.
# - Method sugar on a value finds a function taking ptr<T> and passes &value.
# - Inside a handle block, a call that omits a trailing effect parameter
#   gets a placeholder for it; the operation dispatches through the vtable.
extern {
    function abs(x: i32) -> i32
}

effect GPU {
    function allocate(size: i32) -> i32
}

capability CUDAGPU {
    effect GPU,
    function allocate(size: i32) -> i32 {
        return size * 2
    },
}

struct Reader {
    count: i32
}

function get_count(reader: ptr<Reader>) -> i32 {
    return reader.count
}

function is_null(src: ptr<u8>) -> i32 {
    if src == null {
        return 1
    }
    return 0
}

function helper(x: i32, gpu: GPU) -> i32 {
    return gpu.allocate(x)
}

function main() -> i32 {
    if abs(0 - 5) != 5 {
        return 1
    }
    if is_null(null) != 1 {
        return 2
    }
    let reader: Reader = Reader { count: 3 }
    if reader.get_count() != 3 {
        return 3
    }
    let mut got: i32 = 0
    handle GPU with CUDAGPU {
        got = helper(4)
    }
    if got != 8 {
        return 4
    }
    return 0
}
