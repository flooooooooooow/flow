import "stdlib/dynamics/pde.flow"
extern { function printf(fmt: string, val: f64) -> i32 }
function main() -> i32 {
    let u: array<f64, 4> = [1.0, 2.0, 4.0, 8.0]
    let next: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let row_ptrs: array<i32, 5> = [0, 1, 3, 5, 6]
    let col_indices: array<i32, 6> = [1, 0, 2, 1, 3, 2]

    heat_euler_step_csr(u, next, 4, 0.5, row_ptrs, col_indices, null)

    for i in 0 to 4 {
        printf("%f ", next[i])
    }
    printf("\n", 0.0)
    return 0
}
