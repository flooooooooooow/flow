# A stepped for loop with a straight-line body gets the vectorize hints the
# Python host emitted (#113, #414, #1031): lets, assignments and math calls
# such as sqrt. for_vectorize_pragma_skip has the loops that stay unhinted.

extern { function sqrt(x: f64) -> f64 }

function scale(a: ptr<i32>, n: i32) -> void {
    for i in 0 to n step 1 {
        a[i] = a[i] * 2 + 1
    }
}

function roots(a: ptr<f64>, n: i32) -> void {
    for k in 0 to n step 1 {
        let t: f64 = sqrt(a[k])
        a[k] = t
    }
}

function main() -> i32 {
    let mut buf: [i32; 4] = [1, 2, 3, 4]
    let mut fs: [f64; 2] = [4.0, 9.0]
    scale(&buf[0], 4)
    roots(&fs[0], 2)
    if fs[1] != 3.0 {
        return 1
    }
    if buf[3] != 9 {
        return 2
    }
    return 0
}
