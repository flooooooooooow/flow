# A loop-carried scalar that is not a reduction must not get OpenMP simd
# or GCC ivdep: those would promise independence (#739). Clang's hint
# still lets the vectorizer decide after dependence analysis.

function carried(n: i32) -> i32 {
    let mut a: i32 = 0
    for i in 0 to n {
        a = a * 10 + i
    }
    return a
}

function main() -> i32 {
    if carried(4) != 123 {
        return 1
    }
    return 0
}
