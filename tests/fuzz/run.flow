# Fuzz and crash-regression gate for flowc.
#
#   ./flow tool tests/fuzz/run.flow                         pins, deep nesting, 30s of mutation
#   ./flow tool tests/fuzz/run.flow --seconds 60 --seed 7   longer mutation run
#   ./flow tool tests/fuzz/run.flow --pins-only             crash pins and deep nesting only
#
# flowc must never crash. Each input goes through compiler/scripts/flowc_emit.flow
# (parse, resolve, type check, C emission). A crash is a signal (exit 128 and
# up) or no answer within 20 seconds; any other exit is flowc refusing the
# input. Pins and deep inputs must also say where: exit 0, or exit 1 with a
# `file:line:col:` diagnostic.
#
# Three kinds of input:
#
#   pins      tests/fuzz/crashes/*.flow, inputs that once crashed the retired
#             Python front end (known_crashes.json says how)
#   deep      nesting generated at 1000 and 20000 levels: parentheses,
#             unary minus, blocks, types and unclosed parentheses. flowc
#             stops at FLOWC_PARSE_MAX_DEPTH (compiler/src/parser.flow)
#             with a parse error; before that limit it overflowed its stack
#   mutation  tracked .flow files with lines deleted, duplicated or swapped,
#             cut at a byte, or given a stray token, seeded and repeatable
#
# The mutations come from a seeded generator of this program (MINSTD), so a
# seed names the same mutation on every machine. A crash leaves its input in
# the work directory and is printed with the command that reproduces it.

import "tools/flow_cli/sys.flow"
import "scripts/tools/lib/testrun.flow"
import std.process { ProcCmd, ProcResult, ProcStrs, proc_arg, proc_timeout_ms, proc_now_ms }
import std.regex { Regex }
import std.bytebuf { ByteBuf, bb_new, bb_puts, bb_putc, bb_str, bb_free }

const USAGE: string = "usage: ./flow tool tests/fuzz/run.flow [--seconds N] [--seed N] [--pins-only]"

let mut WORK: string = ""
let mut RUNS: i32 = 0
let mut CRASHES: i32 = 0
let mut KEEP: bool = false
let mut RX_LOC: ptr<Regex> = null

# Run flowc on `f` and classify the result; false (after printing) on a
# crash. `located`: exit 1 must carry a file:line:col: diagnostic.
function check_input(name: string, f: string, located: bool) -> bool {
    RUNS = RUNS + 1
    let c: ptr<ProcCmd> = cmd(sl_of3("./flow", "tool", "compiler/scripts/flowc_emit.flow"))
    proc_arg(c, f)
    proc_arg(c, WORK + "/out.c")
    proc_timeout_ms(c, 20000)
    cmd_capture_out(c)
    cmd_merge_err(c)
    let r: ptr<ProcResult> = run_result(c)
    let _w: bool = write_text(WORK + "/log", r.stdout)
    let mut rc: i32 = r.exit_code
    if r.timed_out {
        # What the shell reported for the alarm (SIGALRM, 128 + 14).
        rc = 142
    }
    if rc == 0 {
        return true
    }
    if rc < 128 and not located {
        return true
    }
    if rc == 1 and tr_grep(r.stdout, RX_LOC) {
        return true
    }
    CRASHES = CRASHES + 1
    KEEP = true
    let mut why: string = "exit " + s_itoa(rc)
    if rc == 142 {
        why = "no answer in 20s"
    }
    if rc > 128 and rc != 142 {
        why = "signal " + s_itoa(rc - 128)
    }
    if rc == 1 {
        why = "exit 1 with no located diagnostic"
    }
    outln("CRASH " + name + ": " + why)
    outln("  input: " + f)
    outln("  rerun: ./flow tool compiler/scripts/flowc_emit.flow " + f + " /tmp/out.c")
    out(tr_head(tr_indent(r.stdout, "  | "), 5))
    return false
}

# PRE + OPEN*n + CORE + CLOSE*n + POST + "\n" into WORK/NAME_n.flow.
function gen(name: string, n: i32, open: string, core: string, close: string, pre: string, post: string) {
    let b: ptr<ByteBuf> = bb_new(1024)
    bb_puts(b, pre)
    let mut i: i32 = 0
    while i < n {
        bb_puts(b, open)
        i = i + 1
    }
    bb_puts(b, core)
    i = 0
    while i < n {
        bb_puts(b, close)
        i = i + 1
    }
    bb_puts(b, post)
    bb_putc(b, 10)
    let _w: bool = write_text(WORK + "/" + name + "_" + s_itoa(n) + ".flow", bb_str(b))
    bb_free(b)
}

# MINSTD (Park and Miller): x' = 48271 x mod (2^31 - 1).
let mut RNG: i64 = 1

function rng_seed(seed: i64) {
    let m: i64 = 2147483647
    let mut x: i64 = seed % m
    if x < 0 {
        x = x + m
    }
    if x == 0 {
        x = 1
    }
    RNG = x
    # A few steps first, so neighbouring seeds start far apart.
    let _a: i32 = rng_below(2)
    let _b: i32 = rng_below(2)
    let _c: i32 = rng_below(2)
}

# A number in [0, k).
function rng_below(k: i32) -> i32 {
    RNG = (RNG * 48271) % 2147483647
    if k <= 0 {
        return 0
    }
    return (RNG % (k as i64)) as i32
}

const TOKENS: string = "( ) { } [ ] < > , ; : = . -> |> let fn function return if match"

# One mutation of `text` (a line deleted, duplicated or swapped, a line cut
# at a byte and the rest dropped, or a stray token), from the seed.
function mutate(text: string, seed: i64) -> string {
    rng_seed(seed)
    let lines: ptr<ProcStrs> = s_lines(text)
    let n: i32 = sl_len(lines)
    if n == 0 {
        return "(\n"
    }
    let toks: ptr<ProcStrs> = s_words(TOKENS)
    let op: i32 = rng_below(5)
    let a: i32 = rng_below(n)
    let b: i32 = rng_below(n)
    let out_b: ptr<ByteBuf> = bb_new(s_len(text) + 64)
    let mut k: i32 = 0
    while k < n {
        let line: string = sl_get(lines, k)
        if op == 0 and k == a {
            k = k + 1
            continue
        }
        if op == 1 and k == a {
            bb_puts(out_b, line)
            bb_putc(out_b, 10)
        }
        if op == 2 and k == a {
            bb_puts(out_b, sl_get(lines, b))
            bb_putc(out_b, 10)
            k = k + 1
            continue
        }
        if op == 2 and k == b {
            bb_puts(out_b, sl_get(lines, a))
            bb_putc(out_b, 10)
            k = k + 1
            continue
        }
        if op == 3 and k == a {
            bb_puts(out_b, s_slice(line, 0, rng_below(s_len(line) + 1)))
            bb_putc(out_b, 10)
            break
        }
        if op == 4 and k == a {
            let c: i32 = rng_below(s_len(line) + 1)
            bb_puts(out_b, s_slice(line, 0, c) + sl_get(toks, rng_below(sl_len(toks))) + s_from(line, c))
            bb_putc(out_b, 10)
            k = k + 1
            continue
        }
        bb_puts(out_b, line)
        bb_putc(out_b, 10)
        k = k + 1
    }
    let s: string = bb_str(out_b)
    bb_free(out_b)
    return s
}

function usage() {
    errln(USAGE)
    cli_exit(2)
}

function main() -> i32 {
    let root: string = tr_enter_root()
    let args: ptr<ProcStrs> = tr_args()
    let mut seconds: i32 = s_atoi(env_or("FLOW_FUZZ_SECONDS", "30"), 30)
    let mut seed: i32 = 1234
    let mut pins_only: bool = false
    let mut i: i32 = 0
    while i < sl_len(args) {
        let a: string = sl_get(args, i)
        if s_eq(a, "--seconds") and i + 1 < sl_len(args) {
            seconds = s_atoi(sl_get(args, i + 1), 0)
            i = i + 2
        } elif s_eq(a, "--seed") and i + 1 < sl_len(args) {
            seed = s_atoi(sl_get(args, i + 1), 0)
            i = i + 2
        } elif s_eq(a, "--pins-only") {
            pins_only = true
            i = i + 1
        } else {
            usage()
        }
    }

    if s_len(env("FLOWC_BIN")) == 0 {
        let f: string = capture(cmd(sl_of3("./flow", "tool", "compiler/scripts/ensure_flowc.flow")))
        if last_status() != 0 {
            cli_exit(1)
        }
        env_set("FLOWC_BIN", root + "/" + f)
    }
    let mut base: string = tmp_base()
    if s_ends(base, "/") {
        base = s_slice(base, 0, s_len(base) - 1)
    }
    WORK = mktemp_dir(base + "/flow-fuzz.XXXXXX")
    if s_len(WORK) == 0 {
        cli_exit(1)
    }
    RX_LOC = tr_rx("^[^:]+:[0-9]+:[0-9]+: ")

    # Pins.
    let pins: ptr<ProcStrs> = glob_suffix("tests/fuzz/crashes", ".flow")
    let mut p: i32 = 0
    while p < sl_len(pins) {
        let f: string = sl_get(pins, p)
        let _ok: bool = check_input("pin " + path_basename(f), f, true)
        p = p + 1
    }

    # Deep nesting.
    let let_pre: string = "function main() -> i32 {\n    let x: i32 = "
    let let_post: string = "\n    return 0\n}"
    let ns: ptr<ProcStrs> = sl_of2("1000", "20000")
    let mut ni: i32 = 0
    while ni < 2 {
        let n: i32 = s_atoi(sl_get(ns, ni), 0)
        ni = ni + 1
        gen("deep_paren", n, "(", "1", ")", let_pre, let_post)
        gen("deep_neg", n, "-", "1", "", let_pre, let_post)
        gen("deep_if", n, "if true {\n", "let y: i32 = 1\n", "}\n", "function main() -> i32 {\n", "return 0\n}")
        gen("deep_type", n, "ptr<", "i32", ">", "function f(p: ", ") {\n}\nfunction main() -> i32 {\n    return 0\n}")
        gen("deep_unclosed", n, "(", "1", "", let_pre, let_post)
    }
    let deep: ptr<ProcStrs> = glob_suffix(WORK, ".flow")
    let mut di: i32 = 0
    while di < sl_len(deep) {
        let f: string = sl_get(deep, di)
        di = di + 1
        if s_starts(path_basename(f), "deep_") {
            let _ok: bool = check_input("deep " + path_stem(f, ".flow"), f, true)
        }
    }

    if not pins_only {
        let g: ptr<ProcStrs> = sl_of3("git", "ls-files", "tests/lang/*.flow")
        sl_push2(g, "examples/*.flow", "lib/stdlib/*.flow")
        let corpus: ptr<ProcStrs> = s_lines(capture(cmd(g)))
        let ncorpus: i64 = sl_len(corpus) as i64
        let start: i64 = proc_now_ms()
        let mut k: i32 = 0
        while ncorpus > 0 and (proc_now_ms() - start) / 1000 < seconds as i64 {
            let s: i64 = (seed as i64) + (k as i64)
            let mut pick: i64 = (s * 2654435761) % ncorpus
            if pick < 0 {
                pick = pick + ncorpus
            }
            let src: string = sl_get(corpus, pick as i32)
            let outp: string = WORK + "/mut_" + s_itoa(s as i32) + ".flow"
            let _w: bool = write_text(outp, mutate(read_text(src), s))
            if check_input("mutation seed " + s_itoa(s as i32) + " of " + src, outp, false) {
                rm_f(outp)
            }
            k = k + 1
        }
    }

    outln("fuzz: runs=" + s_itoa(RUNS) + " crashes=" + s_itoa(CRASHES))
    if not KEEP {
        rm_rf(WORK)
    }
    tr_exit(CRASHES)
    return 0
}
