# Minimal Turing Complete Example

# Unbounded recursion
function fibonacci(n: i32) -> i32 {
    if n <= 1 {
        return n
    } else {
        return fibonacci(n - 1) + fibonacci(n - 2)
    }
}

# Unbounded while loop
function count_up(n: i32) -> i32 {
    let mut i: i32 = 0
    let mut sum: i32 = 0
    
    while i < n {
        sum = sum + i
        i = i + 1
    }
    
    return sum
}

# Conditional branching
function max(a: i32, b: i32) -> i32 {
    if a > b {
        return a
    } else {
        return b
    }
}

function main() -> i32 {
    let fib: i32 = fibonacci(5)
    let count: i32 = count_up(10)
    let maximum: i32 = max(7, 12)
    
    return fib + count + maximum
}
