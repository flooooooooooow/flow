# Basic Turing Complete Example

# Simple recursion
function factorial(n: i32) -> i32 {
    if n <= 1 {
        return 1
    } else {
        return n * factorial(n - 1)
    }
}

# Unbounded while loop
function count_up(limit: i32) -> i32 {
    let mut counter: i32 = 0
    let mut sum: i32 = 0
    
    while counter < limit {
        sum = sum + counter
        counter = counter + 1
    }
    
    return sum
}

# Conditional branching
function absolute_value(x: i32) -> i32 {
    if x < 0 {
        return x * -1
    } else {
        return x
    }
}

# State machine
function flip_flop(initial_state: i32, steps: i32) -> i32 {
    let mut state: i32 = initial_state
    let mut current_step: i32 = 0
    
    while current_step < steps {
        if state == 0 {
            state = 1
        } else {
            state = 0
        }
        current_step = current_step + 1
    }
    
    return state
}

function main() -> i32 {
    let fact_result: i32 = factorial(6)
    let count_result: i32 = count_up(100)
    let abs_result: i32 = absolute_value(-42)
    let flip_result: i32 = flip_flop(0, 5)
    
    return fact_result + count_result + abs_result + flip_result
}
