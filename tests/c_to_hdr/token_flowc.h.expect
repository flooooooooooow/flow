typedef struct Token {
  int32_t kind;
  int32_t kw;
  int32_t start;
  int32_t end;
  int32_t line;
  int32_t col;
} Token;

typedef struct Lexer {
  uint8_t* input;
  int32_t len;
  int32_t pos;
  int32_t line;
  int32_t col;
} Lexer;

