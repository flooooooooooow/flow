# Golden check for scripts/tools/c_to_hdr, the header derivation that
# compiler/scripts/roundtrip.flow runs on each Stage-A module.
#
# Each NAME.c here has NAME.h.expect, the header the retired
# compiler/scripts/flowc_c_to_hdr.py wrote for it. token_flowc.c and
# overload_table_flowc.c are real roundtrip emits; the others cover CRLF
# input, a missing final newline, an empty file, Unicode line breaks and the
# edge cases of the three patterns. Also checks the usage error (exit 2) and
# an unreadable input (exit 1). Runs with python and python3 stubbed out.
#
# Usage: ./flow tool tests/c_to_hdr/run.flow

import "tools/flow_cli/sys.flow"
import "scripts/tools/lib/testrun.flow"
import std.process { ProcCmd, ProcStrs, proc_arg }

function main() -> i32 {
    let root: string = tr_enter_root()
    let work: string = tr_workdir("c_to_hdr")
    tr_stub_python_loud(work + "/bin")

    let tc: ptr<ProcCmd> = cmd(sl_of3(root + "/flow", "tool", "--path"))
    proc_arg(tc, "c_to_hdr")
    let tool: string = capture(tc)
    if last_status() != 0 {
        cli_exit(last_status())
    }
    let mut pass: i32 = 0
    let mut fail: i32 = 0
    let srcs: ptr<ProcStrs> = glob_suffix("tests/c_to_hdr", ".c")
    let mut i: i32 = 0
    while i < sl_len(srcs) {
        let src: string = sl_get(srcs, i)
        i = i + 1
        let name: string = path_stem(src, ".c")
        let got: string = work + "/" + name + ".h"
        let want: string = "tests/c_to_hdr/" + name + ".h.expect"
        if run_argv(sl_of3(tool, src, got)) == 0 and tr_same(got, want) {
            pass = pass + 1
        } else {
            fail = fail + 1
            outln("FAIL " + name)
            out(tr_head(tr_diff("", want, got), 20))
        }
    }

    let u: ptr<ProcCmd> = cmd(sl_of2(tool, "only_one_arg"))
    cmd_quiet(u)
    let rc: i32 = run(u)
    if rc == 2 {
        pass = pass + 1
    } else {
        fail = fail + 1
        outln("FAIL usage exit " + s_itoa(rc) + " (want 2)")
    }

    let m: ptr<ProcCmd> = cmd(sl_of3(tool, work + "/missing.c", work + "/missing.h"))
    cmd_quiet(m)
    let rc2: i32 = run(m)
    if rc2 == 1 and not exists(work + "/missing.h") {
        pass = pass + 1
    } else {
        fail = fail + 1
        outln("FAIL missing input exit " + s_itoa(rc2) + " (want 1)")
    }

    outln("c_to_hdr: pass=" + s_itoa(pass) + " fail=" + s_itoa(fail))
    tr_exit(fail)
    return 0
}
