# Parity gate for `flow fir-g` (tools/fir), with no Python.
#
# Builds tools/fir/main.flow with `./flow tool` (the flowc of the checked-in
# bootstrap C), runs every case in tests/fir/cases.txt and compares stdout,
# the exit code, stderr (all of it, its last line, or not at all, as the
# case says) and, for --calibrate, the thresholds file written, against the
# goldens in tests/fir/golden. The goldens came from src/flow/fir_cli.py run
# with NumPy and MLX unavailable, which is the machine the Flow tool is:
# bulk analysis never runs, so everything compared is deterministic.
#
# Masked before comparing: the host tag in calibration output (uname), and
# the --bench timings. One deliberate change from the Python text: the
# calibration note reads "(bulk never beat CPU in sweep; auto stays on
# cpu)" where the Python text had a dash.
#
# python and python3 are stubs that fail and log; any call fails the gate.
# The last cases run through ./flow fir-g to check the launcher too.
#
#   ./flow tool tests/fir/run.flow

import "tools/flow_cli/sys.flow"
import "scripts/tools/lib/testrun.flow"
import std.process { ProcCmd, ProcStrs, proc_arg }
import std.regex { Regex }

let mut RX_HOST: ptr<Regex> = null
let mut RX_BENCH: ptr<Regex> = null
let mut RX_BENCH_MS: ptr<Regex> = null

# The sed -E mask: one substitution of each pattern per line.
function mask(text: string) -> string {
    let a: string = tr_sed(text, RX_HOST, "\"host\": \"HOST\"", 1)
    let b: string = tr_sed(a, RX_BENCH, "bench: cpu=T ms", 1)
    return tr_sed(b, RX_BENCH_MS, "\"bench_cpu_ms\": T", 1)
}

# The --thresholds value of an argument line (the last one, as the greedy
# sed did), or "".
function thresholds_arg(args: ptr<ProcStrs>) -> string {
    let mut w: string = ""
    let mut i: i32 = 0
    while i + 1 < sl_len(args) {
        if s_eq(sl_get(args, i), "--thresholds") {
            w = sl_get(args, i + 1)
        }
        i = i + 1
    }
    return w
}

function main() -> i32 {
    let root: string = tr_enter_root()
    RX_HOST = tr_rx("\"host\": \"[^\"]*\"")
    RX_BENCH = tr_rx("bench: cpu=[0-9.]+ ms")
    RX_BENCH_MS = tr_rx("\"bench_cpu_ms\": [-0-9.e]+")

    let outd: string = "build/fir-gate"
    rm_rf(outd)
    let log: string = outd + "/python-calls.log"
    tr_stub_python_log(root + "/" + outd + "/bin", root + "/" + log)
    let _l: bool = write_text(log, "")

    let tc: ptr<ProcCmd> = cmd(sl_of3("./flow", "tool", "--path"))
    proc_arg(tc, "fir")
    let tool: string = capture(tc)
    if last_status() != 0 {
        outln("fir gate: flowc could not build tools/fir/main.flow")
        cli_exit(1)
    }

    let mut pass: i32 = 0
    let mut fail: i32 = 0
    let lines: ptr<ProcStrs> = s_lines(read_text("tests/fir/cases.txt"))
    let mut li: i32 = 0
    while li < sl_len(lines) {
        let line: string = sl_get(lines, li)
        li = li + 1
        let f: ptr<ProcStrs> = s_split(line, 9)
        let name: string = sl_get(f, 0)
        if s_len(name) == 0 or s_starts(name, "#") {
            continue
        }
        let mut check: string = ""
        if sl_len(f) > 1 {
            check = sl_get(f, 1)
        }
        let mut argline: string = ""
        if sl_len(f) > 2 {
            argline = sl_join(sl_tail(f, 2), "\t")
        }
        let args: ptr<ProcStrs> = s_words(s_replace(argline, "\t", " "))
        let argv: ptr<ProcStrs> = sl_of1(tool)
        sl_extend(argv, args)
        let c: ptr<ProcCmd> = cmd(argv)
        cmd_env(c, "FLOW_ROOT", root)
        let out_path: string = outd + "/" + name + ".out"
        let err_path: string = outd + "/" + name + ".err"
        let rc: i32 = tr_run_cmd_files(c, out_path, err_path)
        let gold: string = "tests/fir/golden/" + name
        let mut ok: bool = true
        let mut why: string = ""
        let want_rc: string = s_chomp_all(read_text(gold + ".rc"))
        if not s_eq(s_itoa(rc), want_rc) {
            ok = false
            why = "exit " + s_itoa(rc) + ", want " + want_rc
        }
        let masked: string = outd + "/" + name + ".masked"
        let _m: bool = write_text(masked, mask(read_text(out_path)))
        if not tr_same(masked, gold + ".out") {
            ok = false
            why = why + " stdout"
        }
        if s_eq(check, "full") {
            if not tr_same(err_path, gold + ".err") {
                ok = false
                why = why + " stderr"
            }
        } elif s_eq(check, "last") {
            if not s_eq(tr_last_line(read_text(err_path)), s_chomp_all(read_text(gold + ".err"))) {
                ok = false
                why = why + " stderr"
            }
        }
        if is_file(gold + ".file") {
            let written: string = thresholds_arg(args)
            let wm: string = outd + "/" + name + ".file.masked"
            let _w: bool = write_text(wm, mask(read_text(written)))
            if not is_file(written) or not tr_same(wm, gold + ".file") {
                ok = false
                why = why + " thresholds-file"
            }
        }
        if ok {
            pass = pass + 1
        } else {
            fail = fail + 1
            outln("FAIL " + name + ":" + why)
            out(tr_head(tr_diff("", gold + ".out", masked), 10))
        }
    }

    # The launcher: ./flow fir-g builds and runs the same tool.
    let launch: ptr<ProcStrs> = sl_of2("basics_fib_opts", "forms_json")
    let mut k: i32 = 0
    while k < 2 {
        let name: string = sl_get(launch, k)
        k = k + 1
        let mut args: ptr<ProcStrs> = sl_new()
        let mut j: i32 = 0
        while j < sl_len(lines) {
            let f: ptr<ProcStrs> = s_split(sl_get(lines, j), 9)
            if s_eq(sl_get(f, 0), name) and sl_len(f) > 2 {
                args = s_words(sl_get(f, 2))
            }
            j = j + 1
        }
        let argv: ptr<ProcStrs> = sl_of2("./flow", "fir-g")
        sl_extend(argv, args)
        let got: string = outd + "/launcher.out"
        let _r: i32 = tr_run_files(argv, "", got, outd + "/launcher.err")
        if tr_same(got, "tests/fir/golden/" + name + ".out") {
            pass = pass + 1
        } else {
            fail = fail + 1
            outln("FAIL launcher " + name)
            out(read_text(outd + "/launcher.err"))
        }
    }

    if tr_python_called(log, "FAIL python was called:") {
        fail = fail + 1
    }

    outln("fir gate: " + s_itoa(pass) + " passed, " + s_itoa(fail) + " failed")
    tr_exit(fail)
    return 0
}
