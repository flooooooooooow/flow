# fir-g parity fixture: attributes, guards and the constructs the Python
# parser desugars (elif chains, interpolation, dbg, generic calls, forward
# declarations, method calls, return void).

extern {
    function puts(s: string) -> i32
    function malloc(n: i64) -> ptr<u8>
}

struct Pair { a: i32, b: i32 }

@only(jit)
function jit_only(x: i32) -> i32 {
    return x + 1
}

@only(compile, c)
function compiled(x: i32) -> i32 {
    return x * 2
}

@hot
function hot_path(x: i32) -> i32 {
    return x
}

@gpu
function kernel(x: i32) -> i32 {
    return x * x
}

function later(x: i32) -> i32

function identity<T>(v: T) -> T {
    return v
}

function first<A, B>(a: A, b: B) -> A {
    return a
}

function classify(v: i32) -> i32 {
    if v < 0 {
        return 0 - 1
    } elif v == 0 {
        return 0
    } elif v < 10 {
        puts("small")
        return 1
    } else {
        return 2
    }
}

function describe(p: Pair) -> void {
    let s = "pair ${p.a} and ${p.b}"
    puts(s)
    let n = dbg p.a
    return void
}

function later(x: i32) -> i32 {
    return compiled(x) + kernel(x)
}

function main() -> i32 {
    let p: Pair = Pair { a: 1, b: 2 }
    describe(p)
    let q = identity(3)
    let r = identity<f64>(2.5)
    let s = first(1, true)
    let mut total: i32 = classify(q)
    total += later(total)
    let m = malloc(16)
    let w = p.b.max(4)
    while total > 100 {
        total = total / 2
    }
    for i in 0..3 {
        total = total + i
    }
    return total
}
