# Gallery wiring for tcp_echo: the sockets card must be listed, built with
# the same link set as ./flow tool wasm_crossings sockets, and described
# honestly. --list does not need emcc.

import "tools/flow_cli/sys.flow"
import "tests/scripts/harness.flow"

extern {
    function malloc(size: i64) -> ptr<void>
}

function check_gallery_lists_tcp_echo() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "wasm_build")
    sl_push2(argv, "gallery", "--list")
    if t_run(cmd(argv)) != 0 {
        t_cat(t_err())
        return T_FAIL
    }
    if not a_file_contains(t_out(), "tcp_echo") {
        return T_FAIL
    }
    let out: string = read_text(t_out())
    if not a_true("tcp_echo is under systems", s_contains(out, "systems  tcp_echo")) {
        return T_FAIL
    }
    return T_PASS
}

function sockets_row(path: string) -> string {
    let lines: ptr<ProcStrs> = s_lines(read_text(path))
    let mut i: i32 = 0
    while i < sl_len(lines) {
        let line: string = sl_get(lines, i)
        if s_starts(line, "Sockets and HTTP") {
            return line
        }
        i = i + 1
    }
    return ""
}

function check_status_row_is_honest() -> i32 {
    let row: string = sockets_row(t_root() + "/scripts/tools/wasm_build/assets/status_rows.tsv")
    if not a_true("sockets row exists", s_len(row) > 0) {
        return T_FAIL
    }
    if not a_true("status is Runs today", s_contains(row, "Runs today")) {
        return T_FAIL
    }
    if not a_true("mentions tcp_echo", s_contains(row, "tcp_echo")) {
        return T_FAIL
    }
    if not a_true("mentions the local relay", s_contains(row, "ws_echo_relay")) {
        return T_FAIL
    }
    if not a_true("does not claim PROXY_POSIX_SOCKETS", not s_contains(row, "PROXY_POSIX_SOCKETS")) {
        return T_FAIL
    }
    if not a_true("does not say Not built here", not s_contains(row, "Not built here")) {
        return T_FAIL
    }
    return T_PASS
}

function check_docs_agree() -> i32 {
    let demos: string = read_text(t_root() + "/docs/demos/wasm.md")
    let lang: string = read_text(t_root() + "/docs/language/wasm.md")
    if not a_true("demos/wasm.md marks sockets Runs today", s_contains(demos, "Sockets and HTTP | **Runs today**")) {
        return T_FAIL
    }
    if not a_true("language/wasm.md marks sockets Runs today", s_contains(lang, "Sockets and HTTP | **Runs today**")) {
        return T_FAIL
    }
    if not a_true("demos/wasm.md names the relay", s_contains(demos, "ws_echo_relay")) {
        return T_FAIL
    }
    if not a_true("language/wasm.md names the relay", s_contains(lang, "ws_echo_relay")) {
        return T_FAIL
    }
    if not a_true("demos/wasm.md still lists 162 examples", s_contains(demos, "162 Flow examples")) {
        return T_FAIL
    }
    return T_PASS
}

function check_apply_extras_uses_crossings_link_set() -> i32 {
    let src: string = read_text(t_root() + "/scripts/tools/wasm_build/main.flow")
    # Narrow to the tcp_echo extras arm so a later unrelated mention cannot
    # satisfy the check.
    let key: string = "elif ft_eq(name, \"tcp_echo\")"
    let at: i32 = s_find(src, key, 0)
    if not a_true("apply_extras has a tcp_echo arm", at >= 0) {
        return T_FAIL
    }
    let mut arm: string = s_from(src, at)
    let mut end: i32 = s_find(arm, "return \"", 0)
    if end < 0 {
        end = s_len(arm)
    }
    arm = s_slice(arm, 0, end)
    if not a_true("links runtime/flow_tcp.c", s_contains(arm, "runtime/flow_tcp.c")) {
        return T_FAIL
    }
    if not a_true("links net_yield_shim.c", s_contains(arm, "wasm/crossing_assets/net_yield_shim.c")) {
        return T_FAIL
    }
    if not a_true("enables ASYNCIFY", s_contains(arm, "-sASYNCIFY=1")) {
        return T_FAIL
    }
    if not a_true("bakes FLOW_DEMO_PORT", s_contains(arm, "-DFLOW_DEMO_PORT=9505")) {
        return T_FAIL
    }
    return T_PASS
}

function main() -> i32 {
    t_begin("wasm_gallery_sockets")
    t_start()
    t_end("gallery_lists_tcp_echo", check_gallery_lists_tcp_echo())
    t_start()
    t_end("status_row_is_honest", check_status_row_is_honest())
    t_start()
    t_end("docs_agree", check_docs_agree())
    t_start()
    t_end("apply_extras_uses_crossings_link_set", check_apply_extras_uses_crossings_link_set())
    t_done()
    return 0
}
