function check_rejects_missing_option_values() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_tune/main.flow")
    sl_push(argv, "--target")
    if t_run(t_cmd(argv)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "--target requires a value") { return T_FAIL }

    let argv2: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_tune/main.flow")
    sl_push(argv2, "--strategy")
    if t_run(t_cmd(argv2)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "--strategy requires a value") { return T_FAIL }

    let argv3: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_tune/main.flow")
    sl_push(argv3, "--inner-tiles")
    if t_run(t_cmd(argv3)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "--inner-tiles requires a value") { return T_FAIL }
    return T_PASS
}

function check_benchmark_candidate_space() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "benchmarks/micro/transform_tuning_benchmark.flow")
    sl_push(argv, "--candidates=8,8,8;16,16,8")
    if t_run(t_cmd(argv)) != 0 { return T_FAIL }
    let output: string = read_text(t_out())
    if not a_contains(output, "Evaluated tile schedules: [8,8,8, 16,16,8]") { return T_FAIL }
    if not a_contains(output, "Successfully selected best tile schedule:") { return T_FAIL }
    if not a_contains(output, "Successfully selected best tile schedule: 8,8,8") and
       not a_contains(output, "Successfully selected best tile schedule: 16,16,8") { return T_FAIL }
    return T_PASS
}

function check_benchmark_repetitions() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "benchmarks/micro/transform_tuning_benchmark.flow")
    sl_push(argv, "--candidates=8,8,8")
    sl_push(argv, "--repetitions=2")
    if t_run(t_cmd(argv)) != 0 { return T_FAIL }
    let output: string = read_text(t_out())
    if not a_contains(output, "over 2 run(s)") and not a_contains(output, "pending toolchain") { return T_FAIL }
    return T_PASS
}

