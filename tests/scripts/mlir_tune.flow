    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "benchmarks/micro/transform_tuning_benchmark.flow")
    sl_push(argv, "--metric=cost-model")
    sl_push(argv, "--pmu-event=ipc")
    if t_run(t_cmd(argv)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "cannot be combined with --pmu-event") { return T_FAIL }
    return T_PASS
}

function check_benchmark_rejects_invalid_evals() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "benchmarks/micro/transform_tuning_benchmark.flow")
    sl_push(argv, "--evals=0")
    if t_run(t_cmd(argv)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "--evals expects an integer from one to sixty-four") { return T_FAIL }
    return T_PASS
}

function main() -> i32 {
    t_begin("mlir_tune")
    t_start()
    t_end("transform_schedule", check_transform_schedule())
    t_start()
    t_end("invalid_tiles", check_rejects_invalid_tiles())
    t_end("overflow_tiles", check_rejects_overflow_tiles())
    t_start()
    t_end("invalid_target", check_rejects_unknown_target())
    t_start()
    t_end("vector_schedule", check_vector_schedule())
    t_start()
    t_end("interchange_schedule", check_interchange_schedule())
    t_start()
    t_end("invalid_interchange", check_interchange_rejects_invalid_permutation())
    t_start()
    t_end("fusion_schedule", check_fusion_schedule())
    t_start()
    t_end("invalid_fusion", check_fusion_rejects_empty_producer())
    t_start()
    t_end("hierarchical_tile_schedule", check_hierarchical_tile_schedule())
    t_start()
    t_end("invalid_hierarchical_tile", check_hierarchical_tile_rejects_invalid_inner_schedule())
    t_end("hierarchical_vector_schedule", check_hierarchical_vector_schedule())
    t_start()
    t_end("invalid_strategy", check_rejects_unknown_strategy())
    t_end("missing_option_values", check_rejects_missing_option_values())
    t_start()
    t_end("benchmark_candidate_space", check_benchmark_candidate_space())
    t_end("benchmark_repetitions", check_benchmark_repetitions())
    t_end("benchmark_invalid_repetitions", check_benchmark_rejects_invalid_repetitions())
    t_end("benchmark_max_repetitions", check_benchmark_accepts_max_repetitions())
    t_end("benchmark_repetitions_above_max", check_benchmark_rejects_repetitions_above_max())
    t_start()
    t_end("benchmark_invalid_candidate_space", check_benchmark_rejects_invalid_candidate_space())
    t_end("benchmark_wrapped_candidate_space", check_benchmark_rejects_wrapped_candidate_space())
    t_end("benchmark_wrapped_repetitions", check_benchmark_rejects_wrapped_repetitions())
    t_end("benchmark_missing_values", check_benchmark_rejects_missing_values())
    t_end("benchmark_invalid_pmu_event", check_benchmark_rejects_invalid_pmu_event())
    t_end("benchmark_missing_pmu_event", check_benchmark_rejects_missing_pmu_event())
    t_start()
    t_end("unroll_schedule", check_unroll_schedule())
    t_end("invalid_unroll", check_unroll_rejects_invalid_factor())
    t_end("print_cost", check_print_cost_ranks_reuse())
    t_end("missing_extent", check_print_cost_rejects_missing_extent())
    t_start()
    t_end("benchmark_cost_model", check_benchmark_cost_model())
    t_end("benchmark_bayesian_search", check_benchmark_bayesian_search())
    t_end("benchmark_genetic_search", check_benchmark_genetic_search())
    t_end("benchmark_invalid_search", check_benchmark_rejects_invalid_search())
    t_end("benchmark_missing_search", check_benchmark_rejects_missing_search())
    t_end("benchmark_invalid_metric", check_benchmark_rejects_invalid_metric())
    t_end("benchmark_cost_model_pmu", check_benchmark_rejects_cost_model_with_pmu())
    t_end("benchmark_invalid_evals", check_benchmark_rejects_invalid_evals())
    t_done()
    return 0
}
