    if t_run(t_cmd(argv)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "permutation of 0,1,2") { return T_FAIL }
    return T_PASS
}

function check_fusion_schedule() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_tune/main.flow")
    sl_push(argv, "--strategy=fuse")
    sl_push(argv, "--op=linalg.matmul")
    sl_push(argv, "--fuse-with=linalg.generic")
    if t_run(t_cmd(argv)) != 0 { return T_FAIL }
    let output: string = read_text(t_out())
    if not a_contains(output, "flow.tune_strategy = \"fuse\"") { return T_FAIL }
    if not a_contains(output, "ops{[\"linalg.generic\"]}") { return T_FAIL }
    if not a_contains(output, "transform.structured.fuse_into_containing_op") { return T_FAIL }
    if not a_contains(output, "into %matmul") { return T_FAIL }
    if a_contains(output, "tile_using_for") { return T_FAIL }
    return T_PASS
}

function check_fusion_rejects_empty_producer() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_tune/main.flow")
    sl_push(argv, "--strategy=fuse")
    sl_push(argv, "--fuse-with=")
    if t_run(t_cmd(argv)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "--fuse-with must not be empty") { return T_FAIL }
    return T_PASS
}

function check_hierarchical_tile_schedule() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_tune/main.flow")
    sl_push(argv, "--strategy=hierarchical_tile")
    sl_push(argv, "--tiles=64,64,64")
    sl_push(argv, "--inner-tiles=8,8,4")
    if t_run(t_cmd(argv)) != 0 { return T_FAIL }
    let output: string = read_text(t_out())
    if not a_contains(output, "flow.tune_strategy = \"hierarchical_tile\"") { return T_FAIL }
    if not a_contains(output, "tile_sizes [64,64,64]") { return T_FAIL }
    if not a_contains(output, "tile_sizes [8,8,4]") { return T_FAIL }
    if not a_contains(output, "tile_using_for %outer") { return T_FAIL }
    return T_PASS
}

