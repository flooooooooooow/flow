# docs/library/stdlib-api.md is generated from lib/stdlib by
# `./flow tool gen_stdlib_docs`, and CI runs `gen_stdlib_docs --check` so the
# committed page cannot fall behind the library. These checks pin both
# halves: the committed page matches, and a page that differs is rejected.

import "tools/flow_cli/sys.flow"
import "tests/scripts/harness.flow"

function gen(args: ptr<ProcStrs>) -> i32 {
    let argv: ptr<ProcStrs> = sl_of3(t_root() + "/flow", "tool", "gen_stdlib_docs")
    sl_extend(argv, args)
    return t_run_argv(argv)
}

function check_committed_page_matches_the_generator() -> i32 {
    if gen(sl_of1("--check")) != 0 {
        t_cat(t_err())
        return T_FAIL
    }
    if not a_file_contains(t_out(), "is up to date") {
        return T_FAIL
    }
    return T_PASS
}

# A copy of the page with one extra row must fail the check.
function check_a_stale_page_fails() -> i32 {
    let page: string = t_tmp() + "/stdlib-api.md"
    let _w: bool = write_text(page, read_text("docs/library/stdlib-api.md") + "| `gone` | `() -> i32` | - |\n")
    if gen(sl_of2("--check", page)) != 1 {
        outln("gen_stdlib_docs --check accepted a page that differs")
        t_cat(t_out())
        t_cat(t_err())
        return T_FAIL
    }
    if not a_file_contains(t_err(), "differs from the generator output") {
        return T_FAIL
    }
    return T_PASS
}

# The page carries no date, so regenerating it on another day is not drift.
function check_the_page_has_no_date() -> i32 {
    let head: string = head_text(read_text("docs/library/stdlib-api.md"), 3)
    if s_contains(head, " on 20") {
        outln("the generated header names a date: " + head)
        return T_FAIL
    }
    return T_PASS
}

function main() -> i32 {
    t_begin("stdlib_api_drift")
    t_start()
    t_end("committed_page_matches_the_generator", check_committed_page_matches_the_generator())
    t_start()
    t_end("a_stale_page_fails", check_a_stale_page_fails())
    t_start()
    t_end("the_page_has_no_date", check_the_page_has_no_date())
    t_done()
    return 0
}
