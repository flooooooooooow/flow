# Contracts for the data-driven Wiki demo/gallery system.
#
# The generators are the Flow tools shader_gallery and demo_overview (run as
# `./flow tool NAME`). Their --check mode regenerates the page and compares
# it with the checked-in copy, so the checked-in pages stand for the
# generated output here.

import "tools/flow_cli/sys.flow"
import "tests/scripts/harness.flow"

function page_path() -> string {
    return t_root() + "/docs/demos/shaders.md"
}

function catalog_path() -> string {
    return t_root() + "/docs/demos/catalog.json"
}

function tool(name: string, args: ptr<ProcStrs>) -> ptr<ProcStrs> {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", name)
    sl_extend(argv, args)
    return argv
}

# [A-Za-z0-9_]
function is_word(c: i32) -> bool {
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
}

# The end of the run of word bytes starting at `i`.
function word_end(text: string, i: i32) -> i32 {
    let mut e: i32 = i
    while e < s_len(text) and is_word(s_byte(text, e)) {
        e = e + 1
    }
    return e
}

# Names NAME in every PREFIX + NAME + SUFFIX, NAME a non-empty run of
# word bytes after `lead` (part of PREFIX kept in the name).
function matches(text: string, prefix: string, lead: string, suffix: string) -> ptr<ProcStrs> {
    let found: ptr<ProcStrs> = sl_new()
    let mut at: i32 = s_find(text, prefix, 0)
    while at >= 0 {
        let start: i32 = at + s_len(prefix)
        let e: i32 = word_end(text, start)
        if e > start and s_eq(s_slice(text, e, e + s_len(suffix)), suffix) {
            sl_push(found, lead + s_slice(text, start, e))
            at = s_find(text, prefix, e + s_len(suffix))
        } else {
            at = s_find(text, prefix, at + 1)
        }
    }
    return found
}

# Text between the demo-feature-grid opening tag and the first "</div>"
# that ends a line followed by a blank line.
function featured_block() -> string {
    let tag: string = "<div class=\"demo-feature-grid\">"
    let lines: ptr<ProcStrs> = s_lines(read_text(page_path()))
    let mut out: string = ""
    let mut found: bool = false
    let mut have: bool = false
    let mut prev: string = ""
    let mut i: i32 = 0
    while i < sl_len(lines) {
        let mut line: string = sl_get(lines, i)
        i = i + 1
        if not found {
            let at: i32 = s_find(line, tag, 0)
            if at < 0 {
                continue
            }
            found = true
            line = s_from(line, at + s_len(tag))
        }
        if have {
            if s_len(line) == 0 and s_ends(prev, "</div>") {
                return out + s_slice(prev, 0, s_len(prev) - 6) + "\n"
            }
            out = out + prev + "\n"
        }
        prev = line
        have = true
    }
    return out
}

function unique_count(l: ptr<ProcStrs>) -> i32 {
    let seen: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(l) {
        if not sl_has(seen, sl_get(l, i)) {
            sl_push(seen, sl_get(l, i))
        }
        i = i + 1
    }
    return sl_len(seen)
}

function check_photoreal_gallery_generator_tracks_all_fsl_entries() -> i32 {
    let need: i32 = t_need_cc()
    if need != T_PASS {
        return need
    }
    if t_run_argv(tool("shader_gallery", sl_of1("--check"))) != 0 {
        t_cat(t_err())
        return T_FAIL
    }
    if not a_file_is(t_out(), "shader gallery page is current\n") {
        return T_FAIL
    }

    let page: string = read_text(page_path())
    let names: ptr<ProcStrs> = matches(page, "<img src=\"./shaders/photoreal_", "photoreal_", ".gif\"")
    if not a_eq(s_itoa(sl_len(names)), "64", "photoreal images") {
        return T_FAIL
    }
    if not a_eq(s_itoa(unique_count(names)), "64", "unique photoreal images") {
        return T_FAIL
    }
    let featured_names: ptr<ProcStrs> = matches(featured_block(), "--name photoreal_", "photoreal_", "")
    let mut featured: string = ""
    let mut i: i32 = 0
    while i < sl_len(featured_names) {
        featured = featured + sl_get(featured_names, i) + " "
        i = i + 1
    }
    if not a_eq(featured, "photoreal_studio photoreal_glass photoreal_marble photoreal_chrome ", "featured tiles") {
        return T_FAIL
    }
    if not a_true("photoreal_gold listed", sl_has(names, "photoreal_gold")) {
        return T_FAIL
    }
    if not a_true("photoreal_energy_crystal listed", sl_has(names, "photoreal_energy_crystal")) {
        return T_FAIL
    }
    if not a_true("photoreal_underwater listed", sl_has(names, "photoreal_underwater")) {
        return T_FAIL
    }
    if not a_eq(s_itoa(count_of(page, "<figure class=\"demo-tile")), "64", "demo tiles") {
        return T_FAIL
    }
    if not a_file_contains(page_path(), "record_shader_gallery.sh --group photoreal") {
        return T_FAIL
    }
    return T_PASS
}

function bool_text(b: bool) -> string {
    if b {
        return "true"
    }
    return "false"
}

function check_demo_catalog_is_unique_and_covers_expected_collections() -> i32 {
    let j: ptr<Json> = tj_load(catalog_path())
    let cols: i32 = tj_path(j, "collections")
    let ids: ptr<ProcStrs> = sl_new()
    let sections: ptr<ProcStrs> = sl_new()
    let mut pages_md: bool = true
    let mut previews_gif: bool = true
    let mut c: i32 = tj_first(j, cols)
    while c >= 0 {
        sl_push(ids, tj_raw(j, tj_get(j, c, "id")))
        let section: string = tj_raw(j, tj_get(j, c, "section"))
        if not sl_has(sections, section) {
            sl_push(sections, section)
        }
        if not s_ends(tj_raw(j, tj_get(j, c, "page")), ".md") {
            pages_md = false
        }
        if not s_ends(tj_raw(j, tj_get(j, c, "preview")), ".gif") {
            previews_gif = false
        }
        c = tj_next(j, c)
    }
    if not a_eq(bool_text(unique_count(ids) == sl_len(ids)), "true", "ids are unique") {
        return T_FAIL
    }
    if not a_eq(s_itoa(tj_len(j, cols)), "12", "collections") {
        return T_FAIL
    }
    let want: ptr<ProcStrs> = s_words("shaders games morphogenesis neuro threed planet wasm")
    let mut missing: i32 = 0
    let mut w: i32 = 0
    while w < sl_len(want) {
        if not sl_has(ids, sl_get(want, w)) {
            missing = missing + 1
        }
        w = w + 1
    }
    if not a_eq(s_itoa(missing), "0", "expected collections present") {
        return T_FAIL
    }
    sl_sort(sections, false)
    let quoted: ptr<ProcStrs> = sl_new()
    let mut q: i32 = 0
    while q < sl_len(sections) {
        sl_push(quoted, tj_quote(sl_get(sections, q)))
        q = q + 1
    }
    if not a_eq("[" + sl_join(quoted, ",") + "]", "[\"Interactive\",\"Numerics\",\"Rendering\",\"Systems through time\"]", "sections") {
        return T_FAIL
    }
    if not a_eq(bool_text(pages_md), "true", "pages end in .md") {
        return T_FAIL
    }
    if not a_eq(bool_text(previews_gif), "true", "previews end in .gif") {
        return T_FAIL
    }
    return T_PASS
}

function check_demo_overview_is_derived_from_catalog() -> i32 {
    let need: i32 = t_need_cc()
    if need != T_PASS {
        return need
    }
    if t_run_argv(tool("demo_overview", sl_of2("--check", "--check-previews"))) != 0 {
        t_cat(t_err())
        return T_FAIL
    }
    let page: string = t_root() + "/docs/demos/overview.md"
    if not a_file_contains(page, "# Demo Showcase") {
        return T_FAIL
    }
    let cards: i32 = count_of(read_text(page), "class=\"demo-collection-card")
    let j: ptr<Json> = tj_load(catalog_path())
    let collections: i32 = tj_len(j, tj_path(j, "collections"))
    if not a_true("cards (" + s_itoa(cards) + ") >= collections (" + s_itoa(collections) + ")", cards >= collections) {
        return T_FAIL
    }
    if not a_file_contains(page, "Photoreal FSL") {
        return T_FAIL
    }
    if not a_file_contains(page, "Systems through time") {
        return T_FAIL
    }
    if not a_file_contains(page, "Live WebAssembly") {
        return T_FAIL
    }
    return T_PASS
}

function check_demo_navigation_is_synced_with_catalog() -> i32 {
    let need: i32 = t_need_cc()
    if need != T_PASS {
        return need
    }
    if t_run_argv(tool("demo_nav", sl_of1("--check"))) != 0 {
        t_cat(t_err())
        return T_FAIL
    }
    if not a_file_is(t_out(), "demo navigation is current\n") {
        return T_FAIL
    }
    return T_PASS
}

function check_wiki_shell_loads_gallery_presentation_assets() -> i32 {
    if not a_file_contains("site/index.html", "href=\"assets/demo-gallery.css\"") {
        return T_FAIL
    }
    if not a_file_contains("site/index.html", "src=\"assets/gallery-enhance.js\"") {
        return T_FAIL
    }
    if not a_file_contains("docs/assets/gallery-enhance.js", "MutationObserver") {
        return T_FAIL
    }
    if not a_file_contains("docs/assets/gallery-enhance.js", "demo-tile-grid-enhanced") {
        return T_FAIL
    }
    return T_PASS
}

function main() -> i32 {
    t_begin("demo_gallery_docs")
    t_start()
    t_end("photoreal_gallery_generator_tracks_all_fsl_entries", check_photoreal_gallery_generator_tracks_all_fsl_entries())
    t_start()
    t_end("demo_catalog_is_unique_and_covers_expected_collections", check_demo_catalog_is_unique_and_covers_expected_collections())
    t_start()
    t_end("demo_overview_is_derived_from_catalog", check_demo_overview_is_derived_from_catalog())
    t_start()
    t_end("demo_navigation_is_synced_with_catalog", check_demo_navigation_is_synced_with_catalog())
    t_start()
    t_end("wiki_shell_loads_gallery_presentation_assets", check_wiki_shell_loads_gallery_presentation_assets())
    t_done()
    return 0
}
