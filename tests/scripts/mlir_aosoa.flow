import "scripts/tools/lib/testrun.flow"
import "tests/scripts/harness.flow"

function check_non_power_of_two_extent() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "flow-to-mlir", "--aosoa-swizzle")
    sl_push(argv, "compiler/fixtures/mlir_opt/aosoa_non_power.flow")
    sl_push(argv, t_tmp() + "/aosoa.mlir")
    let c: ptr<ProcCmd> = t_cmd(argv)
    cmd_env(c, "FLOWC_MLIR_AOSOA_SWIZZLE", "4")
    if t_run(c) != 0 {
        outln("flow-to-mlir exited with " + s_itoa(t_rc()))
        return T_FAIL
    }
    let output: string = read_text(t_tmp() + "/aosoa.mlir")
    if not a_contains(output, "memref<3xf32>") { return T_FAIL }
    if a_contains(output, "arith.xori") { return T_FAIL }
    return T_PASS
}

function main() -> i32 {
    t_begin("mlir_aosoa")
    t_start()
    t_end("non_power_of_two_extent", check_non_power_of_two_extent())
    t_done()
    return 0
}
