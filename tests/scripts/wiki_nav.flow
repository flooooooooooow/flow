# The wiki nav manifest and the checks that keep it honest.
#
# The checks live in the Flow program scripts/tools/wiki_nav, run here as
# `./flow tool wiki_nav`. The wiki build runs the same validation before it
# writes the sidebar.

import "tools/flow_cli/sys.flow"
import "tests/scripts/harness.flow"

function nav_path() -> string {
    return t_root() + "/docs/nav.json"
}

function nav_cmd(args: ptr<ProcStrs>) -> ptr<ProcStrs> {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "wiki_nav")
    sl_extend(argv, args)
    return argv
}

# Non-empty stdout lines of the checker.
function lines(args: ptr<ProcStrs>) -> ptr<ProcStrs> {
    let c: ptr<ProcCmd> = cmd(nav_cmd(args))
    let text: string = capture_raw(c)
    let all: ptr<ProcStrs> = s_lines(text)
    let keep: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(all) {
        if s_len(sl_get(all, i)) > 0 {
            sl_push(keep, sl_get(all, i))
        }
        i = i + 1
    }
    return keep
}

function write_lines(path: string, l: ptr<ProcStrs>) {
    let mut text: string = ""
    let mut i: i32 = 0
    while i < sl_len(l) {
        text = text + sl_get(l, i) + "\n"
        i = i + 1
    }
    let _w: bool = write_text(path, text)
}

# Sorted, without duplicates (sort -u).
function sort_unique(l: ptr<ProcStrs>) -> ptr<ProcStrs> {
    let s: ptr<ProcStrs> = sl_copy(l)
    sl_sort(s, false)
    let out: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(s) {
        if i == 0 or not s_eq(sl_get(s, i), sl_get(s, i - 1)) {
            sl_push(out, sl_get(s, i))
        }
        i = i + 1
    }
    return out
}

# The real manifest.

# This is the check that would have caught project/PROJECT_STRUCTURE.md, a
# sidebar entry pointing at a file that only exists under archive/.
function check_the_shipped_manifest_is_consistent_with_docs() -> i32 {
    if t_run_argv(nav_cmd(sl_of1("--problems"))) != 0 {
        t_cat(t_out())
        return T_FAIL
    }
    if not a_file_is(t_out(), "") {
        return T_FAIL
    }
    return T_PASS
}

function check_the_summary_reports_a_consistent_manifest() -> i32 {
    if t_run_argv(nav_cmd(sl_new())) != 0 {
        t_cat(t_out())
        return T_FAIL
    }
    let want: string = "\nnav is consistent with docs/\n"
    let got: string = read_text(t_out())
    let tail: string = s_from(got, s_len(got) - s_len(want))
    let _w: bool = write_text(t_tmp() + "/tail", tail)
    if not a_file_is(t_tmp() + "/tail", want) {
        return T_FAIL
    }
    return T_PASS
}

# Keys of the manifest's "unlisted" object.
function unlisted_keys() -> ptr<ProcStrs> {
    let j: ptr<Json> = tj_load(nav_path())
    let keys: ptr<ProcStrs> = sl_new()
    let mut c: i32 = tj_first(j, tj_path(j, "unlisted"))
    while c >= 0 {
        sl_push(keys, tj_key(j, c))
        c = tj_next(j, c)
    }
    return keys
}

# Pages under PREFIX that are neither listed in the sidebar nor unlisted
# with a reason. Asserts the prefix has pages at all.
function check_reachable(prefix: string) -> i32 {
    let listed: ptr<ProcStrs> = lines(sl_of1("--listed"))
    let pages_all: ptr<ProcStrs> = lines(sl_of1("--pages"))
    let under: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(pages_all) {
        if s_starts(sl_get(pages_all, i), prefix) {
            sl_push(under, sl_get(pages_all, i))
        }
        i = i + 1
    }
    let pages: ptr<ProcStrs> = sort_unique(under)
    if sl_len(pages) == 0 {
        outln("no pages under " + prefix)
        return T_FAIL
    }
    let reachable: ptr<ProcStrs> = sl_copy(listed)
    sl_extend(reachable, unlisted_keys())
    let stranded: ptr<ProcStrs> = sl_new()
    let mut k: i32 = 0
    while k < sl_len(pages) {
        if not sl_has(reachable, sl_get(pages, k)) {
            sl_push(stranded, sl_get(pages, k))
        }
        k = k + 1
    }
    if sl_len(stranded) > 0 {
        outln("pages under " + prefix + " missing from the sidebar:")
        out(sl_join(stranded, "\n") + "\n")
        return T_FAIL
    }
    return T_PASS
}

# A reference manual whose reference pages are not in the sidebar is a
# reference manual you cannot use.
function check_every_language_page_is_reachable_from_the_sidebar() -> i32 {
    return check_reachable("language/")
}

function check_every_library_page_is_reachable_from_the_sidebar() -> i32 {
    return check_reachable("library/")
}

function check_unlisted_pages_all_carry_a_reason() -> i32 {
    let j: ptr<Json> = tj_load(nav_path())
    let blank: ptr<ProcStrs> = sl_new()
    let mut c: i32 = tj_first(j, tj_path(j, "unlisted"))
    while c >= 0 {
        if s_len(s_trim(tj_raw(j, c))) == 0 {
            sl_push(blank, tj_key(j, c))
        }
        c = tj_next(j, c)
    }
    if sl_len(blank) > 0 {
        outln("unlisted with no reason: " + sl_join(blank, "\n"))
        return T_FAIL
    }
    return T_PASS
}

function check_sections_reference_declared_tabs() -> i32 {
    let j: ptr<Json> = tj_load(nav_path())
    let tabs: ptr<ProcStrs> = sl_new()
    let mut t: i32 = tj_first(j, tj_path(j, "tabs"))
    while t >= 0 {
        sl_push(tabs, tj_raw(j, tj_get(j, t, "id")))
        t = tj_next(j, t)
    }
    let mut all: bool = true
    let mut s: i32 = tj_first(j, tj_path(j, "sections"))
    while s >= 0 {
        if not sl_has(tabs, tj_raw(j, tj_get(j, s, "tab"))) {
            all = false
        }
        s = tj_next(j, s)
    }
    let mut got: string = "false"
    if all {
        got = "true"
    }
    if not a_eq(got, "true", "every section names a declared tab") {
        return T_FAIL
    }
    return T_PASS
}

# Validation catches the failures it exists for. Builds a docs tree and a
# manifest in the check's scratch directory from SECTIONS and UNLISTED
# (JSON) plus page names, and leaves the problem lines in <tmp>/problems.
function problems(sections: string, unlisted: string, pages: ptr<ProcStrs>) -> string {
    let tmp: string = t_tmp()
    let docs: string = tmp + "/docs"
    let _m: bool = mkdir_p(docs)
    let _h: bool = write_text(docs + "/home.md", "# home")
    let mut i: i32 = 0
    while i < sl_len(pages) {
        let _p: bool = write_text(docs + "/" + sl_get(pages, i), "# page")
        i = i + 1
    }
    let manifest: string = "{\"default\": \"home.md\", \"tabs\": [{\"id\": \"start\", \"label\": \"Start\"}], \"sections\": " + sections + ", \"unlisted\": " + unlisted + "}\n"
    let _n: bool = write_text(tmp + "/nav.json", manifest)
    let args: ptr<ProcStrs> = sl_of2("--manifest", tmp + "/nav.json")
    sl_push2(args, "--docs", docs)
    sl_push(args, "--problems")
    let path: string = tmp + "/problems"
    write_lines(path, lines(args))
    return path
}

const HOME_ONLY: string = "[{\"id\": \"s\", \"tab\": \"start\", \"title\": \"S\", \"items\": [{\"label\": \"Home\", \"path\": \"home.md\"}]}]"

function no_problems(path: string) -> i32 {
    let text: string = read_text(path)
    if s_len(text) > 0 {
        outln("expected no problems, got:")
        out(text)
        return T_FAIL
    }
    return T_PASS
}

function expect_problem(path: string, needle: string) -> i32 {
    if not a_file_contains(path, needle) {
        return T_FAIL
    }
    return T_PASS
}

function check_a_nav_entry_pointing_at_nothing_is_a_failure() -> i32 {
    let p: string = problems("[{\"id\": \"s\", \"tab\": \"start\", \"title\": \"S\", \"items\": [{\"label\": \"Home\", \"path\": \"home.md\"}, {\"label\": \"Ghost\", \"path\": \"does-not-exist.md\"}]}]", "{}", sl_new())
    return expect_problem(p, "does-not-exist.md")
}

function check_a_page_in_no_section_is_a_failure() -> i32 {
    let p: string = problems(HOME_ONLY, "{}", sl_of1("stranded.md"))
    return expect_problem(p, "stranded.md")
}

function check_an_unlisted_page_with_a_reason_is_accepted() -> i32 {
    let p: string = problems(HOME_ONLY, "{\"internal.md\": \"internal runbook, not reader documentation\"}", sl_of1("internal.md"))
    return no_problems(p)
}

function check_an_unlisted_page_with_a_blank_reason_is_a_failure() -> i32 {
    let p: string = problems(HOME_ONLY, "{\"internal.md\": \"   \"}", sl_of1("internal.md"))
    return expect_problem(p, "written reason")
}

function check_a_page_cannot_be_both_listed_and_unlisted() -> i32 {
    let p: string = problems(HOME_ONLY, "{\"home.md\": \"some reason\"}", sl_new())
    return expect_problem(p, "both in the nav")
}

function check_a_section_naming_an_unknown_tab_is_a_failure() -> i32 {
    let p: string = problems("[{\"id\": \"s\", \"tab\": \"nope\", \"title\": \"S\", \"items\": [{\"label\": \"Home\", \"path\": \"home.md\"}]}]", "{}", sl_new())
    return expect_problem(p, "does not exist")
}

# releases.md and friends are written into build/wiki from sources outside
# docs/, so requiring them here would fail every build.
function check_build_generated_pages_do_not_have_to_exist_on_disk() -> i32 {
    let p: string = problems("[{\"id\": \"s\", \"tab\": \"start\", \"title\": \"S\", \"items\": [{\"label\": \"Home\", \"path\": \"home.md\"}, {\"label\": \"Releases\", \"path\": \"releases.md\"}]}]", "{}", sl_new())
    return no_problems(p)
}

# Derived views.
function check_generated_sections_are_filled_in_at_build_time() -> i32 {
    let args: ptr<ProcStrs> = sl_of3("--sections", "--fill", "euclid")
    sl_push2(args, "Book I", "x.md")
    let _r: i32 = t_run_argv(nav_cmd(args))
    let j: ptr<Json> = tj_load(t_out())
    let mut euclid: i32 = -1
    if tj_ok(j) {
        let mut c: i32 = tj_first(j, 0)
        while c >= 0 {
            if s_eq(tj_raw(j, tj_get(j, c, "id")), "proofs-euclid") {
                euclid = c
            }
            c = tj_next(j, c)
        }
    }
    if euclid < 0 {
        outln("no proofs-euclid section")
        out(s_slice(read_text(t_out()), 0, 400))
        return T_FAIL
    }
    if not a_eq(tj_compact(j, tj_get(j, euclid, "items")), "[{\"label\":\"Book I\",\"path\":\"x.md\"}]", "euclid items") {
        return T_FAIL
    }
    let mut has: string = "false"
    if tj_get(j, euclid, "generated") >= 0 {
        has = "true"
    }
    if not a_eq(has, "false", "euclid still marked generated") {
        return T_FAIL
    }
    return T_PASS
}

function category(page: string) -> string {
    let text: string = capture_raw(cmd(nav_cmd(sl_of2("--category", page))))
    return s_strip_all_space(text)
}

function check_search_category_follows_the_tab_a_page_sits_under() -> i32 {
    if not a_eq(category("language/types.md"), "reference", "language/types.md") {
        return T_FAIL
    }
    if not a_eq(category("library/memory.md"), "reference", "library/memory.md") {
        return T_FAIL
    }
    if not a_eq(category("tutorials/beginner.md"), "tutorial", "tutorials/beginner.md") {
        return T_FAIL
    }
    if not a_eq(category("DEVELOPMENT.md"), "tooling", "DEVELOPMENT.md") {
        return T_FAIL
    }
    return T_PASS
}

function check_an_unknown_page_falls_back_to_guide() -> i32 {
    if not a_eq(category("no/such/page.md"), "guide", "no/such/page.md") {
        return T_FAIL
    }
    return T_PASS
}

function check_the_shipped_manifest_is_valid_json() -> i32 {
    let j: ptr<Json> = tj_load(nav_path())
    let mut got: string = "false"
    if tj_len(j, tj_path(j, "sections")) > 0 and tj_len(j, tj_path(j, "tabs")) > 0 {
        got = "true"
    }
    if not a_eq(got, "true", "sections and tabs are non-empty") {
        return T_FAIL
    }
    return T_PASS
}

function main() -> i32 {
    t_begin("wiki_nav")
    t_start()
    t_end("the_shipped_manifest_is_consistent_with_docs", check_the_shipped_manifest_is_consistent_with_docs())
    t_start()
    t_end("the_summary_reports_a_consistent_manifest", check_the_summary_reports_a_consistent_manifest())
    t_start()
    t_end("every_language_page_is_reachable_from_the_sidebar", check_every_language_page_is_reachable_from_the_sidebar())
    t_start()
    t_end("every_library_page_is_reachable_from_the_sidebar", check_every_library_page_is_reachable_from_the_sidebar())
    t_start()
    t_end("unlisted_pages_all_carry_a_reason", check_unlisted_pages_all_carry_a_reason())
    t_start()
    t_end("sections_reference_declared_tabs", check_sections_reference_declared_tabs())
    t_start()
    t_end("a_nav_entry_pointing_at_nothing_is_a_failure", check_a_nav_entry_pointing_at_nothing_is_a_failure())
    t_start()
    t_end("a_page_in_no_section_is_a_failure", check_a_page_in_no_section_is_a_failure())
    t_start()
    t_end("an_unlisted_page_with_a_reason_is_accepted", check_an_unlisted_page_with_a_reason_is_accepted())
    t_start()
    t_end("an_unlisted_page_with_a_blank_reason_is_a_failure", check_an_unlisted_page_with_a_blank_reason_is_a_failure())
    t_start()
    t_end("a_page_cannot_be_both_listed_and_unlisted", check_a_page_cannot_be_both_listed_and_unlisted())
    t_start()
    t_end("a_section_naming_an_unknown_tab_is_a_failure", check_a_section_naming_an_unknown_tab_is_a_failure())
    t_start()
    t_end("build_generated_pages_do_not_have_to_exist_on_disk", check_build_generated_pages_do_not_have_to_exist_on_disk())
    t_start()
    t_end("generated_sections_are_filled_in_at_build_time", check_generated_sections_are_filled_in_at_build_time())
    t_start()
    t_end("search_category_follows_the_tab_a_page_sits_under", check_search_category_follows_the_tab_a_page_sits_under())
    t_start()
    t_end("an_unknown_page_falls_back_to_guide", check_an_unknown_page_falls_back_to_guide())
    t_start()
    t_end("the_shipped_manifest_is_valid_json", check_the_shipped_manifest_is_valid_json())
    t_done()
    return 0
}
