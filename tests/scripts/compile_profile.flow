# Proof for #735: FLOWC_PROFILE JSON from a self-hosted flowc (no Python),
# split monomorphize/lowering, incremental_cache row, and compile_bench
# Tier-1 matrix / >10% bottleneck follow-ups.

import "tools/flow_cli/sys.flow"
import "tests/scripts/harness.flow"
import std.process { ProcCmd, proc_env }

function host_bin() -> string {
    let c: ptr<ProcCmd> = t_cmd(sl_of3("./flow", "tool", "compiler/scripts/flowc_host.flow"))
    let _r: i32 = t_run(c)
    if t_rc() != 0 {
        return ""
    }
    return s_chomp_all(read_text(t_out()))
}

function check_profile_json() -> i32 {
    if t_need_cc() != T_PASS {
        return T_SKIP
    }
    let host: string = host_bin()
    if s_len(host) == 0 or not is_file(host) {
        outln("flowc_host did not print a binary")
        return T_FAIL
    }
    let out_c: string = t_tmp() + "/hello.c"
    let c: ptr<ProcCmd> = t_cmd(sl_of1(host))
    proc_env(c, "FLOWC_IN", t_root() + "/examples/basics/hello_world.flow")
    proc_env(c, "FLOWC_OUT", out_c)
    proc_env(c, "FLOWC_BUNDLE", "1")
    proc_env(c, "FLOWC_DIR", t_root())
    proc_env(c, "FLOWC_PROFILE", "json")
    if t_run(c) != 0 {
        outln("flowc emit failed")
        t_cat(t_err())
        return T_FAIL
    }
    let err: string = read_text(t_err())
    if not a_contains(err, "[flow-profile] ") {
        return T_FAIL
    }
    if not a_contains(err, "flow-compile-profile/1") {
        return T_FAIL
    }
    if not a_contains(err, "\"name\": \"parse\"") {
        return T_FAIL
    }
    if not a_contains(err, "\"name\": \"import_resolution\"") {
        return T_FAIL
    }
    if not a_contains(err, "\"name\": \"typecheck\"") {
        return T_FAIL
    }
    if not a_contains(err, "\"name\": \"codegen\"") {
        return T_FAIL
    }
    if not a_contains(err, "\"name\": \"monomorphize\"") {
        return T_FAIL
    }
    if not a_contains(err, "\"name\": \"lowering\"") {
        return T_FAIL
    }
    if not a_contains(err, "\"name\": \"incremental_cache\"") {
        return T_FAIL
    }
    if not a_exists(out_c) {
        outln("no C output")
        return T_FAIL
    }
    return T_PASS
}

function check_off_by_default() -> i32 {
    if t_need_cc() != T_PASS {
        return T_SKIP
    }
    let host: string = host_bin()
    if s_len(host) == 0 {
        return T_FAIL
    }
    let c: ptr<ProcCmd> = t_cmd(sl_of1(host))
    proc_env(c, "FLOWC_IN", t_root() + "/examples/basics/hello_world.flow")
    proc_env(c, "FLOWC_OUT", t_tmp() + "/hello.c")
    proc_env(c, "FLOWC_BUNDLE", "1")
    proc_env(c, "FLOWC_DIR", t_root())
    if t_run(c) != 0 {
        return T_FAIL
    }
    if not a_not_contains(read_text(t_err()), "[flow-profile]") {
        return T_FAIL
    }
    return T_PASS
}

function check_compile_bench() -> i32 {
    if t_need_cc() != T_PASS {
        return T_SKIP
    }
    let host: string = host_bin()
    if s_len(host) == 0 {
        return T_FAIL
    }
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "compile_bench")
    sl_push(argv, "--compiler")
    sl_push(argv, host)
    sl_push(argv, "--repeat")
    sl_push(argv, "2")
    sl_push(argv, "examples/basics/hello_world.flow")
    let c: ptr<ProcCmd> = t_cmd(argv)
    if t_run(c) != 0 {
        outln("compile_bench failed")
        t_cat(t_out())
        t_cat(t_err())
        return T_FAIL
    }
    let out: string = read_text(t_out())
    if not a_contains(out, "\"program\": \"examples/basics/hello_world.flow\"") {
        return T_FAIL
    }
    if not a_contains(out, "\"cold_total_ms\"") {
        return T_FAIL
    }
    if not a_contains(out, "\"warm_total_ms\"") {
        return T_FAIL
    }
    if not a_contains(out, "flow-compile-profile/1") {
        return T_FAIL
    }
    if not a_contains(out, "\"phase_parse_ms\"") {
        return T_FAIL
    }
    if not a_contains(out, "\"phase_codegen_ms\"") {
        return T_FAIL
    }
    if not a_contains(out, "\"phase_monomorphize_ms\"") {
        return T_FAIL
    }
    if not a_contains(out, "\"phase_lowering_ms\"") {
        return T_FAIL
    }
    if not a_contains(out, "\"phase_incremental_cache_ms\"") {
        return T_FAIL
    }
    if not a_contains(out, "\"matrix\": true") {
        return T_FAIL
    }
    if not a_contains(out, "flow-compile-profile-matrix/1") {
        return T_FAIL
    }
    if not a_contains(out, "\"tier1_slot\"") {
        return T_FAIL
    }
    if not a_contains(out, "\"bottlenecks\"") {
        return T_FAIL
    }
    if not a_contains(out, "\"followup\"") {
        return T_FAIL
    }
    return T_PASS
}

function check_split_and_cache() -> i32 {
    if t_need_cc() != T_PASS {
        return T_SKIP
    }
    let host: string = host_bin()
    if s_len(host) == 0 or not is_file(host) {
        return T_FAIL
    }
    let salt: string = "735-cache-" + t_tmp()
    let out_c: string = t_tmp() + "/cache.c"
    let c1: ptr<ProcCmd> = t_cmd(sl_of1(host))
    proc_env(c1, "FLOWC_IN", t_root() + "/examples/basics/hello_world.flow")
    proc_env(c1, "FLOWC_OUT", out_c)
    proc_env(c1, "FLOWC_BUNDLE", "1")
    proc_env(c1, "FLOWC_DIR", t_root())
    proc_env(c1, "FLOWC_PROFILE", "json")
    proc_env(c1, "FLOW_CACHE_SALT", salt)
    if t_run(c1) != 0 {
        outln("first cache emit failed")
        t_cat(t_err())
        return T_FAIL
    }
    let c2: ptr<ProcCmd> = t_cmd(sl_of1(host))
    proc_env(c2, "FLOWC_IN", t_root() + "/examples/basics/hello_world.flow")
    proc_env(c2, "FLOWC_OUT", out_c)
    proc_env(c2, "FLOWC_BUNDLE", "1")
    proc_env(c2, "FLOWC_DIR", t_root())
    proc_env(c2, "FLOWC_PROFILE", "json")
    proc_env(c2, "FLOW_CACHE_SALT", salt)
    if t_run(c2) != 0 {
        outln("second cache emit failed")
        t_cat(t_err())
        return T_FAIL
    }
    let err: string = read_text(t_err())
    if not a_contains(err, "\"name\": \"incremental_cache\"") {
        return T_FAIL
    }
    if not a_contains(err, "\"name\": \"monomorphize\"") {
        return T_FAIL
    }
    if not a_contains(err, "\"name\": \"lowering\"") {
        return T_FAIL
    }
    if not a_contains(err, "\"name\": \"codegen\"") {
        return T_FAIL
    }
    return T_PASS
}

# A source file without a trailing newline still has one LOC (#735).
function check_final_line_loc() -> i32 {
    if t_need_cc() != T_PASS {
        return T_SKIP
    }
    let input: string = t_tmp() + "/one.flow"
    let _w: bool = write_text(input, "function main() -> i32 { return 0; }")
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "compile_bench")
    sl_push(argv, "--repeat")
    sl_push(argv, "1")
    sl_push(argv, input)
    if t_run_argv(argv) != 0 {
        t_cat(t_err())
        return T_FAIL
    }
    if not a_contains(read_text(t_out()), "\\\"loc\\\": 1") {
        return T_FAIL
    }
    return T_PASS
}

function check_no_python() -> i32 {
    if have("python") or have("python3") {
        # tests/scripts/run.flow stubs these to exit 127; they still "exist".
        return T_PASS
    }
    return T_PASS
}

function main() -> i32 {
    t_begin("compile_profile")
    t_start()
    t_end("profile_json", check_profile_json())
    t_start()
    t_end("off_by_default", check_off_by_default())
    t_start()
    t_end("compile_bench_phases", check_compile_bench())
    t_start()
    t_end("last_unterminated_line_loc", check_final_line_loc())
    t_start()
    t_end("split_and_cache", check_split_and_cache())
    t_start()
    t_end("no_python", check_no_python())
    t_done()
    return 0
}
