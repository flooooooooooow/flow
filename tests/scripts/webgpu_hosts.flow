# Runs every tests/webgpu/*.test.mjs (the mocked-device tests of the WebGPU
# host modules, #811 #812 #814) with `node --test`, which expands the glob. They check the JavaScript that site/wasm-crossings ships;
# a real adapter is not needed. Skipped when node is not installed.
import "tools/flow_cli/sys.flow"
import "tests/scripts/harness.flow"

function run_node_test(file: string) -> i32 {
    if not have("node") {
        return T_SKIP
    }
    let args: ptr<ProcStrs> = sl_of2("node", "--test")
    sl_push(args, file)
    if t_run_argv(args) != 0 {
        t_cat(t_out())
        t_cat(t_err())
        return T_FAIL
    }
    return T_PASS
}

function main() -> i32 {
    t_begin("webgpu_hosts")
    t_start()
    t_end("node_test", run_node_test("tests/webgpu/*.test.mjs"))
    t_done()
    return 0
}
