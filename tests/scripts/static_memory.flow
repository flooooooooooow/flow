import "compiler/src/static_memory.flow"
import "tests/scripts/harness.flow"

function check_plan() -> i32 {
    let mut items: array<StaticBuffer, 64> = []
    items[0] = StaticBuffer { size: 64, start: 0, end: 2, alignment: 16 }
    items[1] = StaticBuffer { size: 32, start: 3, end: 5, alignment: 16 }
    items[2] = StaticBuffer { size: 48, start: 1, end: 4, alignment: 16 }
    let plan: StaticMemoryPlan = flowc_static_memory_plan(items, 3, 16)
    if plan.offsets[0] != 0 { return T_FAIL }
    if plan.offsets[2] != 64 { return T_FAIL }
    if plan.offsets[1] != 0 { return T_FAIL }
    if plan.arena_size != 112 { return T_FAIL }
    return T_PASS
}

function check_reuses_non_overlapping_lifetimes() -> i32 {
    let mut items: array<StaticBuffer, 64> = []
    items[0] = StaticBuffer { size: 32, start: 0, end: 1, alignment: 16 }
    items[1] = StaticBuffer { size: 64, start: 2, end: 3, alignment: 16 }
    let plan: StaticMemoryPlan = flowc_static_memory_plan(items, 2, 16)
    if plan.offsets[0] != 0 { return T_FAIL }
    if plan.offsets[1] != 0 { return T_FAIL }
    if plan.arena_size != 64 { return T_FAIL }
    return T_PASS
}

function check_honors_buffer_alignment() -> i32 {
    let mut items: array<StaticBuffer, 64> = []
    items[0] = StaticBuffer { size: 8, start: 0, end: 3, alignment: 16 }
    items[1] = StaticBuffer { size: 8, start: 0, end: 3, alignment: 64 }
    let plan: StaticMemoryPlan = flowc_static_memory_plan(items, 2, 16)
    if plan.offsets[0] != 0 { return T_FAIL }
    if plan.offsets[1] != 64 { return T_FAIL }
    if plan.arena_size != 80 { return T_FAIL }
    return T_PASS
}

function check_clamps_buffer_count() -> i32 {
    let mut items: array<StaticBuffer, 64> = []
    let plan: StaticMemoryPlan = flowc_static_memory_plan(items, 65, 16)
    if plan.count != 64 { return T_FAIL }
    return T_PASS
}

function check_normalizes_invalid_alignment() -> i32 {
    let mut items: array<StaticBuffer, 64> = []
    items[0] = StaticBuffer { size: 8, start: 0, end: 2, alignment: 0 }
    items[1] = StaticBuffer { size: 8, start: 0, end: 2, alignment: -4 }
    let plan: StaticMemoryPlan = flowc_static_memory_plan(items, 2, 0)
    if plan.offsets[0] != 0 { return T_FAIL }
    if plan.offsets[1] != 8 { return T_FAIL }
    if plan.arena_size != 16 { return T_FAIL }
    return T_PASS
}

function main() -> i32 {
    t_begin("static_memory")
    t_start()
    t_end("plan_reuses_released_space", check_plan())
    t_end("reuses_non_overlapping_lifetimes", check_reuses_non_overlapping_lifetimes())
    t_end("honors_buffer_alignment", check_honors_buffer_alignment())
    t_end("clamps_buffer_count", check_clamps_buffer_count())
    t_end("normalizes_invalid_alignment", check_normalizes_invalid_alignment())
    t_done()
    return 0
}
