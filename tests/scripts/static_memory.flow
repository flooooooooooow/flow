import compiler.src.static_memory { MemoryPlanner, memory_planner_new, memory_planner_free, memory_planner_add_buffer, memory_planner_plan }

extern {
    function printf(fmt: string, ...) -> i32
    function exit(status: i32) -> void
}

function main() -> i32 {
    let mut mp: MemoryPlanner = memory_planner_new(10)
    let _a: i32 = memory_planner_add_buffer(&mp, 0, 10, 100)
    let _b: i32 = memory_planner_add_buffer(&mp, 5, 15, 50)
    let _c: i32 = memory_planner_add_buffer(&mp, 12, 20, 40)
    let sz: i32 = memory_planner_plan(&mp)
    if sz != 150 {
        printf("expected 150, got %d\n", sz)
        return 1
    }
    printf("PASS\n")
    memory_planner_free(&mp)
    return 0
}
