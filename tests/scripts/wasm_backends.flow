# Dual CPU backends on the WASM page builder (scripts/wasm_build.sh).
#
# The builder is the Flow program in scripts/tools/wasm_build. These tests
# drive it through its entry point, so they cover the argument handling, the
# emcc command line and the pages it writes. The fake-emcc check needs only
# a C compiler; the real builds skip unless emcc works.

import "tools/flow_cli/sys.flow"
import "tests/scripts/harness.flow"
import std.process { ProcResult, proc_run }

extern {
    function malloc(size: i64) -> ptr<void>
}

function shim() -> string {
    return t_root() + "/flow"
}

function hello() -> string {
    return t_root() + "/examples/wasm/hello_wasm.flow"
}

function snake() -> string {
    return t_root() + "/examples/games/snake_gfx.flow"
}

function builder(program: string, args: ptr<ProcStrs>) -> ptr<ProcCmd> {
    let argv: ptr<ProcStrs> = sl_of3(shim(), "tool", "wasm_build")
    sl_push2(argv, "build", program)
    sl_extend(argv, args)
    return cmd(argv)
}

# Homebrew's emscripten needs these three variables when they are not
# already set.
function emcc_env(c: ptr<ProcCmd>, name: string, path: string) {
    if s_len(env(name)) == 0 and exists(path) {
        cmd_env(c, name, path)
    }
}

# emcc on PATH and `emcc -v` exits 0.
struct Emcc {
    ok: bool
}

let mut EMCC: ptr<Emcc> = null

function probe_emcc() {
    let e: ptr<Emcc> = malloc(8) as ptr<Emcc>
    e.ok = false
    if have("emcc") {
        let c: ptr<ProcCmd> = cmd(sl_of2("emcc", "-v"))
        emcc_env(c, "EMSDK_PYTHON", "/opt/homebrew/bin/python3.14")
        emcc_env(c, "EM_LLVM_ROOT", "/opt/homebrew/opt/emscripten/libexec/llvm/bin")
        emcc_env(c, "EM_BINARYEN_ROOT", "/opt/homebrew/opt/emscripten/libexec/binaryen")
        cmd_quiet(c)
        let r: ptr<ProcResult> = proc_run(c)
        e.ok = r.exit_code == 0
    }
    EMCC = e
}

function need_emcc() -> i32 {
    let e: ptr<Emcc> = EMCC
    if not e.ok {
        return t_skip("emcc not usable")
    }
    return T_PASS
}

# The common preconditions of the real builds.
function need_build(program: string, missing: string) -> i32 {
    let need: i32 = t_need_cc()
    if need != T_PASS {
        return need
    }
    if not exists(program) {
        return t_skip(missing)
    }
    return need_emcc()
}

# `jq -r EXPR` on the builder's --json output.
function json_field(name: string) -> string {
    let j: ptr<Json> = tj_load(t_out())
    if not tj_ok(j) {
        return ""
    }
    return tj_raw(j, tj_get(j, 0, name))
}

function check_backend_from_environment_is_validated() -> i32 {
    let need: i32 = t_need_cc()
    if need != T_PASS {
        return need
    }
    let c: ptr<ProcCmd> = builder(hello(), sl_of2("--out", t_tmp()))
    cmd_env(c, "FLOW_CPU_BACKEND", "spirv")
    let _r: i32 = t_run(c)
    if not a_eq_int(t_rc(), 1, "exit status") {
        return T_FAIL
    }
    if not a_file_is(t_err(), "error: unknown backend 'spirv' (expected c|mlir)\n") {
        return T_FAIL
    }
    return T_PASS
}

function check_backend_choice_is_checked_by_the_parser() -> i32 {
    let need: i32 = t_need_cc()
    if need != T_PASS {
        return need
    }
    let _r: i32 = t_run(builder(hello(), sl_of2("--backend", "spirv")))
    if not a_eq_int(t_rc(), 2, "exit status") {
        return T_FAIL
    }
    if not a_file_contains(t_err(), "invalid choice: 'spirv' (choose from c, mlir)") {
        return T_FAIL
    }
    return T_PASS
}

# The line after the first "--preload-file" line, or "".
function after_preload(lines: ptr<ProcStrs>) -> string {
    let mut i: i32 = 1
    while i < sl_len(lines) {
        if s_eq(sl_get(lines, i - 1), "--preload-file") {
            return sl_get(lines, i)
        }
        i = i + 1
    }
    return ""
}

function any_ends_with(lines: ptr<ProcStrs>, suffix: string) -> bool {
    let mut i: i32 = 0
    while i < sl_len(lines) {
        if s_ends(sl_get(lines, i), suffix) {
            return true
        }
        i = i + 1
    }
    return false
}

# A fake emcc records the command line the builder hands it.
function check_emcc_command_preload_link_and_opt() -> i32 {
    let need: i32 = t_need_cc()
    if need != T_PASS {
        return need
    }
    if not exists(hello()) {
        return t_skip("hello_wasm.flow missing")
    }
    let bin: string = t_tmp() + "/bin"
    let _m: bool = mkdir_p(bin)
    let log: string = t_tmp() + "/argv.txt"
    let mut fake: string = "#!/bin/sh\n"
    fake = fake + "[ \"$1\" = \"-v\" ] && exit 0\n"
    fake = fake + "for a in \"$@\"; do printf \"%s\\n\" \"$a\"; done > \"" + log + "\"\n"
    fake = fake + "echo \"emcc: error: fake emcc\" >&2\n"
    fake = fake + "exit 1\n"
    let _w: bool = write_text(bin + "/emcc", fake)
    let _x: bool = set_mode(bin + "/emcc", 493)
    let support: string = t_root() + "/runtime/flow_rt_support.c"
    let args: ptr<ProcStrs> = sl_of3("--out", t_tmp() + "/out", "-O1")
    sl_push2(args, "--preload", "/tmp/data@/data")
    sl_push2(args, "--link", support)
    sl_push2(args, "--link", "runtime/gfx_macos.m")
    sl_push2(args, "--initial-memory", "64MB")
    let c: ptr<ProcCmd> = builder(hello(), args)
    cmd_env(c, "PATH", bin + ":" + env("PATH"))
    let _r: i32 = t_run(c)
    if not a_eq_int(t_rc(), 1, "exit status") {
        return T_FAIL
    }
    if not a_file_is(t_err(), "error: emcc: error: fake emcc\n") {
        return T_FAIL
    }
    let lines: ptr<ProcStrs> = s_lines(read_text(log))
    if not a_true("-sFORCE_FILESYSTEM=1 in argv", sl_has(lines, "-sFORCE_FILESYSTEM=1")) {
        return T_FAIL
    }
    if not a_eq(after_preload(lines), "/tmp/data@/data", "argument after --preload-file") {
        return T_FAIL
    }
    let resolved: string = abs_file_physical(support)
    if not a_true(resolved + " in argv", sl_has(lines, resolved)) {
        return T_FAIL
    }
    if not a_true("no .m file in argv", not any_ends_with(lines, ".m")) {
        return T_FAIL
    }
    if not a_true("-sINITIAL_MEMORY=64MB in argv", sl_has(lines, "-sINITIAL_MEMORY=64MB")) {
        return T_FAIL
    }
    if not a_true("-O1 in argv", sl_has(lines, "-O1")) {
        return T_FAIL
    }
    return T_PASS
}

function check_wasm_build_backend(backend: string) -> i32 {
    let need: i32 = need_build(hello(), "hello_wasm.flow missing")
    if need != T_PASS {
        return need
    }
    let outdir: string = t_tmp() + "/" + backend
    let args: ptr<ProcStrs> = sl_of3("--out", outdir, "--backend")
    sl_push2(args, backend, "-O1")
    sl_push(args, "--json")
    if t_run(builder(hello(), args)) != 0 {
        t_cat(t_err())
        return T_FAIL
    }
    if not a_eq(json_field("backend"), backend, "json backend") {
        return T_FAIL
    }
    if not a_exists(outdir + "/hello_wasm.wasm") {
        return T_FAIL
    }
    if not a_exists(outdir + "/hello_wasm.js") {
        return T_FAIL
    }
    if s_eq(backend, "mlir") {
        if not a_file_contains(outdir + "/index.html", "MLIR") {
            return T_FAIL
        }
    } elif not a_file_contains(outdir + "/index.html", "C &rarr; WebAssembly") {
        return T_FAIL
    }
    return T_PASS
}

function check_wasm_build_preload_emits_data(backend: string) -> i32 {
    let need: i32 = need_build(hello(), "hello_wasm.flow missing")
    if need != T_PASS {
        return need
    }
    let _m: bool = mkdir_p(t_tmp() + "/pack")
    let _w: bool = write_text(t_tmp() + "/pack/note.txt", "hello from preload\n")
    let outdir: string = t_tmp() + "/out-" + backend
    let args: ptr<ProcStrs> = sl_of3("--out", outdir, "--backend")
    sl_push2(args, backend, "-O1")
    sl_push2(args, "--preload", t_tmp() + "/pack@/data")
    sl_push2(args, "--link", t_root() + "/runtime/flow_rt_support.c")
    sl_push(args, "--json")
    if t_run(builder(hello(), args)) != 0 {
        t_cat(t_err())
        return T_FAIL
    }
    if not a_eq(json_field("backend"), backend, "json backend") {
        return T_FAIL
    }
    if not a_exists(outdir + "/hello_wasm.wasm") {
        return T_FAIL
    }
    if not a_exists(outdir + "/hello_wasm.data") {
        return T_FAIL
    }
    # (.data_bytes // 0) > 0
    let j: ptr<Json> = tj_load(t_out())
    let bytes: i32 = tj_get(j, 0, "data_bytes")
    let mut positive: string = "false"
    if bytes >= 0 and s_atoi(tj_raw(j, bytes), 0) > 0 {
        positive = "true"
    }
    if not a_eq(positive, "true", "data_bytes > 0") {
        return T_FAIL
    }
    return T_PASS
}

# Epic #221: MLIR backend builds a gfx+ASYNCIFY canvas page.
function check_wasm_mlir_gfx_snake() -> i32 {
    let need: i32 = need_build(snake(), "snake_gfx.flow missing")
    if need != T_PASS {
        return need
    }
    let outdir: string = t_tmp() + "/snake-mlir"
    let args: ptr<ProcStrs> = sl_of3("--out", outdir, "--backend")
    sl_push2(args, "mlir", "-O1")
    sl_push(args, "--json")
    if t_run(builder(snake(), args)) != 0 {
        t_cat(t_err())
        return T_FAIL
    }
    if not a_eq(json_field("backend"), "mlir", "json backend") {
        return T_FAIL
    }
    let j: ptr<Json> = tj_load(t_out())
    let mut gfx: string = "false"
    if tj_is_true(j, tj_get(j, 0, "gfx")) {
        gfx = "true"
    }
    if not a_eq(gfx, "true", "json gfx is true") {
        return T_FAIL
    }
    if not a_exists(outdir + "/snake_gfx.wasm") {
        return T_FAIL
    }
    if not a_file_contains(outdir + "/index.html", "MLIR") {
        return T_FAIL
    }
    let html: string = s_lower(read_text(outdir + "/index.html"))
    if not a_true("canvas in index.html", s_contains(html, "canvas")) {
        return T_FAIL
    }
    return T_PASS
}

function main() -> i32 {
    t_begin("wasm_backends")
    probe_emcc()
    t_start()
    t_end("backend_from_environment_is_validated", check_backend_from_environment_is_validated())
    t_start()
    t_end("backend_choice_is_checked_by_the_parser", check_backend_choice_is_checked_by_the_parser())
    t_start()
    t_end("emcc_command_preload_link_and_opt", check_emcc_command_preload_link_and_opt())
    t_start()
    t_end("wasm_build_both_backends[c]", check_wasm_build_backend("c"))
    t_start()
    t_end("wasm_build_both_backends[mlir]", check_wasm_build_backend("mlir"))
    t_start()
    t_end("wasm_build_preload_emits_data[c]", check_wasm_build_preload_emits_data("c"))
    t_start()
    t_end("wasm_build_preload_emits_data[mlir]", check_wasm_build_preload_emits_data("mlir"))
    t_start()
    t_end("wasm_mlir_gfx_snake", check_wasm_mlir_gfx_snake())
    t_done()
    return 0
}
