# Regression for #817: concurrent `flow run` of two projects that share a
# source basename (src/main.flow) must each execute their own program.
#
# Before the fix, `flow run` emitted every executable to build/<basename> in
# the repo-global build directory, so two projects both named main.flow raced
# through the same build/main artifact and one could launch the other's
# binary. The fix gives each run invocation an isolated build root.

import "tools/flow_cli/sys.flow"
import "tests/scripts/harness.flow"
import "scripts/tools/lib/bgproc.flow"

function make_project(root: string, tag: string) {
    let _m: bool = mkdir_p(root + "/src")
    let _w: bool = write_text(root + "/src/main.flow", "function main() -> i32 {\n    println(\"" + tag + "\")\n    return 0\n}\n")
}

# `FLOW_HOST=flowc ./flow run PROGRAM > OUT 2> ERR &`
function start_run(program: string, out_path: string, err_path: string) -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "run", program)
    let p: BgProc = bg_start(argv.items, "", false, out_path, err_path)
    return p.pid
}

function check_concurrent_run_does_not_cross_projects() -> i32 {
    let need: i32 = t_need("clang")
    if need != T_PASS {
        return need
    }
    let tmp: string = t_tmp()
    make_project(tmp + "/proj_a", "I_AM_PROJECT_A")
    make_project(tmp + "/proj_b", "I_AM_PROJECT_B")

    # Repeat a few times to exercise the compile/launch overlap window.
    let had_host: bool = env_isset("FLOW_HOST")
    let old_host: string = env("FLOW_HOST")
    env_set("FLOW_HOST", "flowc")
    let mut round: i32 = 1
    let mut rc: i32 = T_PASS
    while round <= 3 and rc == T_PASS {
        let r: string = s_itoa(round)
        let pid_a: i32 = start_run(tmp + "/proj_a/src/main.flow", tmp + "/a." + r + ".out", tmp + "/a." + r + ".err")
        let pid_b: i32 = start_run(tmp + "/proj_b/src/main.flow", tmp + "/b." + r + ".out", tmp + "/b." + r + ".err")
        # Only stdout is asserted, as before; the exit status is not.
        let _wa: i32 = bg_wait(pid_a)
        let _wb: i32 = bg_wait(pid_b)
        let out_a: string = s_chomp_all(read_text(tmp + "/a." + r + ".out"))
        let out_b: string = s_chomp_all(read_text(tmp + "/b." + r + ".out"))
        if not a_contains(out_a, "I_AM_PROJECT_A") or not a_not_contains(out_a, "I_AM_PROJECT_B") {
            rc = T_FAIL
        } elif not a_contains(out_b, "I_AM_PROJECT_B") or not a_not_contains(out_b, "I_AM_PROJECT_A") {
            rc = T_FAIL
        }
        round = round + 1
    }
    if had_host {
        env_set("FLOW_HOST", old_host)
    } else {
        env_unset("FLOW_HOST")
    }
    return rc
}

function main() -> i32 {
    t_begin("run_build_isolation")
    t_start()
    t_end("concurrent_run_does_not_cross_projects", check_concurrent_run_does_not_cross_projects())
    t_done()
    return 0
}
