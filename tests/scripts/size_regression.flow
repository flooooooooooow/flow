# The stripped hello_world binary stays small. It is around 80 KB; the limit
# is a generous 200 KB, loose enough to avoid flaky failures and tight enough
# to catch a large regression.

import "tools/flow_cli/sys.flow"
import "tests/scripts/harness.flow"

const MAX_SIZE: i32 = 204800

function check_hello_world_size_regression() -> i32 {
    let need: i32 = t_need("strip size")
    if need != T_PASS {
        return need
    }
    if t_sh(sl_of3("./flow", "compile", "examples/basics/hello_world.flow")) != 0 {
        return T_FAIL
    }
    if t_sh(sl_of2("strip", "build/hello_world")) != 0 {
        return T_FAIL
    }
    let b: Bytes = read_bytes("build/hello_world")
    let bytes: i32 = b.len as i32
    let what: string = "hello_world stripped binary size " + s_itoa(bytes) + " is under the " + s_itoa(MAX_SIZE) + " byte limit"
    if not a_true(what, bytes < MAX_SIZE) {
        return T_FAIL
    }
    return T_PASS
}

function main() -> i32 {
    t_begin("size_regression")
    t_start()
    t_end("hello_world_size_regression", check_hello_world_size_regression())
    t_done()
    return 0
}
