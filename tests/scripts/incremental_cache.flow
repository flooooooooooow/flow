# Proof for the #736 first slice: parsed-declaration cache keys include an
# explicit schema/compiler salt and parse-affecting config, and persistence
# is a non-executable record under the user cache. A checkout that ships
# crafted pickle (or any project-local cache) cannot run cache-controlled
# code. The FLOWC_PROFILE `cache` counts show a single-leaf edit re-parses
# only that leaf. Typecheck / monomorphize / codegen caches are remaining
# gaps.

import "tools/flow_cli/sys.flow"
import "tests/scripts/harness.flow"
import std.process { ProcCmd, ProcStrs, proc_env }

function host_bin() -> string {
    let c: ptr<ProcCmd> = t_cmd(sl_of3("./flow", "tool", "compiler/scripts/flowc_host.flow"))
    let _r: i32 = t_run(c)
    if t_rc() != 0 {
        return ""
    }
    return s_chomp_all(read_text(t_out()))
}

function ast_dir(xdg: string) -> string {
    return xdg + "/flow/ast"
}

function count_ast(xdg: string) -> i32 {
    return sl_len(glob_suffix(ast_dir(xdg), ".ast"))
}

function write_pair(dir: string, ret: i32) -> bool {
    let leaf: bool = write_text(dir + "/leaf.flow", "export function helper() -> i32 { return " + s_itoa(ret) + "; }\n")
    let app: bool = write_text(dir + "/app.flow", "import .leaf\nfunction main() -> i32 { return helper(); }\n")
    return leaf and app
}

function emit_bundle(host: string, src: string, out_c: string, salt: string, xdg: string, home: string) -> i32 {
    let c: ptr<ProcCmd> = t_cmd(sl_of1(host))
    proc_env(c, "FLOWC_IN", src)
    proc_env(c, "FLOWC_OUT", out_c)
    proc_env(c, "FLOWC_BUNDLE", "1")
    proc_env(c, "FLOW_CACHE_SALT", salt)
    proc_env(c, "XDG_CACHE_HOME", xdg)
    proc_env(c, "HOME", home)
    return t_run(c)
}

function link_c(c_out: string, bin: string) -> i32 {
    let cc: string = env_or("CC", "cc")
    let ccv: ptr<ProcStrs> = sl_of3(cc, "-std=c11", "-D_DEFAULT_SOURCE")
    sl_extend(ccv, s_words("-w -O0 -o"))
    sl_push2(ccv, bin, c_out)
    sl_push(ccv, "-lm")
    return t_run_argv(ccv)
}

function compile_run(host: string, dir: string, salt: string, xdg: string, home: string) -> i32 {
    let c_out: string = dir + "/app.c"
    let bin: string = dir + "/app"
    if emit_bundle(host, dir + "/app.flow", c_out, salt, xdg, home) != 0 {
        outln("flowc emit failed")
        t_cat(t_out())
        t_cat(t_err())
        return 0 - 1
    }
    if link_c(c_out, bin) != 0 {
        outln("cc failed")
        t_cat(t_out())
        t_cat(t_err())
        return 0 - 1
    }
    return t_run_argv(sl_of1(bin))
}

# Same source, different FLOW_CACHE_SALT must not reuse the old record.
function check_salt_mutation_invalidates() -> i32 {
    if t_need_cc() != T_PASS {
        return T_SKIP
    }
    let host: string = host_bin()
    if s_len(host) == 0 or not is_file(host) {
        outln("flowc_host did not print a binary")
        return T_FAIL
    }
    let dir: string = t_tmp() + "/proj"
    let xdg: string = t_tmp() + "/xdg"
    let home: string = t_tmp() + "/home"
    let _d: bool = mkdir_p(dir)
    if not write_pair(dir, 42) {
        outln("could not write fixtures")
        return T_FAIL
    }

    let r1: i32 = compile_run(host, dir, "frontend-v1", xdg, home)
    if r1 != 42 {
        outln("expected 42 from first compile, got " + s_itoa(r1))
        return T_FAIL
    }
    let n1: i32 = count_ast(xdg)
    if n1 <= 0 {
        outln("expected a user-cache AST record after the first compile")
        return T_FAIL
    }

    # Unchanged rebuild under the same salt: no new key.
    let r1b: i32 = compile_run(host, dir, "frontend-v1", xdg, home)
    if r1b != 42 {
        outln("expected 42 from same-salt rebuild, got " + s_itoa(r1b))
        return T_FAIL
    }
    let n1b: i32 = count_ast(xdg)
    if n1b != n1 {
        outln("same salt must reuse the existing key, files " + s_itoa(n1) + " -> " + s_itoa(n1b))
        return T_FAIL
    }

    # Byte-identical source under a new compiler/schema salt must miss.
    let r2: i32 = compile_run(host, dir, "frontend-v2", xdg, home)
    if r2 != 42 {
        outln("expected 42 from salt-mutated compile, got " + s_itoa(r2))
        return T_FAIL
    }
    let n2: i32 = count_ast(xdg)
    if n2 <= n1 {
        outln("salt mutation did not allocate a new cache key, files stayed " + s_itoa(n2))
        return T_FAIL
    }
    return T_PASS
}

# A source edit must not serve the previous parse.
function check_source_edit_invalidates() -> i32 {
    if t_need_cc() != T_PASS {
        return T_SKIP
    }
    let host: string = host_bin()
    if s_len(host) == 0 or not is_file(host) {
        outln("flowc_host did not print a binary")
        return T_FAIL
    }
    let dir: string = t_tmp() + "/proj"
    let xdg: string = t_tmp() + "/xdg"
    let home: string = t_tmp() + "/home"
    let _d: bool = mkdir_p(dir)
    if not write_pair(dir, 1) {
        return T_FAIL
    }
    let r1: i32 = compile_run(host, dir, "edit", xdg, home)
    if r1 != 1 {
        outln("expected 1, got " + s_itoa(r1))
        return T_FAIL
    }
    if not write_pair(dir, 2) {
        return T_FAIL
    }
    let r2: i32 = compile_run(host, dir, "edit", xdg, home)
    if r2 != 2 {
        outln("expected 2 after source edit, got " + s_itoa(r2))
        return T_FAIL
    }
    return T_PASS
}

# Opening an untrusted checkout must not execute project-local cache data.
# Protocol-0 pickle that would `touch` a sentinel if anyone ran pickle.load.
function check_untrusted_checkout_is_inert() -> i32 {
    if t_need_cc() != T_PASS {
        return T_SKIP
    }
    let host: string = host_bin()
    if s_len(host) == 0 or not is_file(host) {
        outln("flowc_host did not print a binary")
        return T_FAIL
    }
    let dir: string = t_tmp() + "/proj"
    let xdg: string = t_tmp() + "/xdg"
    let home: string = t_tmp() + "/home"
    let sentinel: string = t_tmp() + "/pwned"
    let _d: bool = mkdir_p(dir)
    let _c: bool = mkdir_p(dir + "/.flow_cache")
    if not write_pair(dir, 7) {
        return T_FAIL
    }
    let payload: string = "cos\nsystem\n(S'touch " + sentinel + "'\ntR.\n"
    let _p1: bool = write_text(dir + "/.flow_cache/attack.pkl", payload)
    let _p2: bool = write_text(dir + "/.flow_cache/0000000000000000.pkl", payload)
    let _p3: bool = write_text(dir + "/.flow_cache/deadbeef.ast", payload)

    let r: i32 = compile_run(host, dir, "trust", xdg, home)
    if r != 7 {
        outln("expected 7 from untrusted checkout, got " + s_itoa(r))
        return T_FAIL
    }
    if exists(sentinel) {
        outln("crafted project cache executed code and created " + sentinel)
        return T_FAIL
    }
    return T_PASS
}

# Records under the user cache are the non-executable FCAC format, not pickle.
function check_cache_format_is_not_pickle() -> i32 {
    if t_need_cc() != T_PASS {
        return T_SKIP
    }
    let host: string = host_bin()
    if s_len(host) == 0 or not is_file(host) {
        outln("flowc_host did not print a binary")
        return T_FAIL
    }
    let dir: string = t_tmp() + "/proj"
    let xdg: string = t_tmp() + "/xdg"
    let home: string = t_tmp() + "/home"
    let _d: bool = mkdir_p(dir)
    if not write_pair(dir, 3) {
        return T_FAIL
    }
    let r: i32 = compile_run(host, dir, "fmt", xdg, home)
    if r != 3 {
        outln("expected 3, got " + s_itoa(r))
        return T_FAIL
    }
    let files: ptr<ProcStrs> = glob_suffix(ast_dir(xdg), ".ast")
    if sl_len(files) <= 0 {
        outln("no AST cache records to inspect")
        return T_FAIL
    }
    let mut i: i32 = 0
    while i < sl_len(files) {
        let path: string = sl_get(files, i)
        let body: Bytes = read_bytes(path)
        if body.len < 20 {
            outln("cache record too small to be FCAC: " + path)
            return T_FAIL
        }
        if body.data[0] != 70 or body.data[1] != 67 or body.data[2] != 65 or body.data[3] != 67 {
            outln("cache record is not the FCAC format: " + path)
            return T_FAIL
        }
        i = i + 1
    }
    return T_PASS
}

# A cache root with no room left in the 512-byte key buffer for
# "/<16 hex>.ast" must compile uncached, and must not write a record
# through a path that ran past the buffer.
function check_long_cache_root_skips_cache() -> i32 {
    if t_need_cc() != T_PASS {
        return T_SKIP
    }
    let host: string = host_bin()
    if s_len(host) == 0 or not is_file(host) {
        outln("flowc_host did not print a binary")
        return T_FAIL
    }
    let dir: string = t_tmp() + "/proj"
    let home: string = t_tmp() + "/home"
    # Grow the root to 495 bytes in 40-byte components (NAME_MAX is 255).
    # With "/flow/ast" that is 504, so the 22-byte key suffix cannot fit.
    let mut xdg: string = t_tmp() + "/x"
    while s_len(xdg) + 41 <= 495 {
        xdg = xdg + "/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    }
    while s_len(xdg) < 495 {
        xdg = xdg + "b"
    }
    let _d: bool = mkdir_p(dir)
    if not mkdir_p(xdg) {
        outln("could not create the long cache root")
        return T_FAIL
    }
    if not write_pair(dir, 42) {
        return T_FAIL
    }
    let r: i32 = compile_run(host, dir, "long-root", xdg, home)
    if r != 42 {
        outln("expected 42 under an over-long cache root, got " + s_itoa(r))
        return T_FAIL
    }
    let n: i32 = count_ast(xdg)
    if n != 0 {
        outln("over-long cache root still wrote " + s_itoa(n) + " AST records")
        return T_FAIL
    }
    return T_PASS
}

# A record whose header names a root outside the stored arena must be
# treated as a miss and re-parsed, never returned as the parse result.
function check_out_of_range_root_is_a_miss() -> i32 {
    if t_need_cc() != T_PASS {
        return T_SKIP
    }
    let host: string = host_bin()
    if s_len(host) == 0 or not is_file(host) {
        outln("flowc_host did not print a binary")
        return T_FAIL
    }
    let dir: string = t_tmp() + "/proj"
    let xdg: string = t_tmp() + "/xdg"
    let home: string = t_tmp() + "/home"
    let _d: bool = mkdir_p(dir)
    if not write_pair(dir, 9) {
        return T_FAIL
    }
    let r1: i32 = compile_run(host, dir, "root", xdg, home)
    if r1 != 9 {
        outln("expected 9 from first compile, got " + s_itoa(r1))
        return T_FAIL
    }
    let files: ptr<ProcStrs> = glob_suffix(ast_dir(xdg), ".ast")
    if sl_len(files) <= 0 {
        outln("no AST cache records to corrupt")
        return T_FAIL
    }
    # FCAC header: magic, schema, node size, length, root (five i32).
    # Set root to 0x7fffffff in every record.
    let mut i: i32 = 0
    while i < sl_len(files) {
        let path: string = sl_get(files, i)
        let body: Bytes = read_bytes(path)
        if body.len < 20 {
            outln("cache record too small: " + path)
            return T_FAIL
        }
        body.data[16] = 255
        body.data[17] = 255
        body.data[18] = 255
        body.data[19] = 127
        if not write_bytes(path, body.data, body.len) {
            outln("could not rewrite " + path)
            return T_FAIL
        }
        i = i + 1
    }
    let r2: i32 = compile_run(host, dir, "root", xdg, home)
    if r2 != 9 {
        outln("expected 9 after corrupting the cached root, got " + s_itoa(r2))
        return T_FAIL
    }
    return T_PASS
}

# A record whose node payload no longer matches its checksum (a torn or
# corrupt write) must be a miss and re-parsed. The header stays valid.
function check_corrupt_payload_is_a_miss() -> i32 {
    if t_need_cc() != T_PASS {
        return T_SKIP
    }
    let host: string = host_bin()
    if s_len(host) == 0 or not is_file(host) {
        outln("flowc_host did not print a binary")
        return T_FAIL
    }
    let dir: string = t_tmp() + "/proj"
    let xdg: string = t_tmp() + "/xdg"
    let home: string = t_tmp() + "/home"
    let _d: bool = mkdir_p(dir)
    if not write_pair(dir, 11) {
        return T_FAIL
    }
    let r1: i32 = compile_run(host, dir, "payload", xdg, home)
    if r1 != 11 {
        outln("expected 11 from first compile, got " + s_itoa(r1))
        return T_FAIL
    }
    let files: ptr<ProcStrs> = glob_suffix(ast_dir(xdg), ".ast")
    if sl_len(files) <= 0 {
        outln("no AST cache records to corrupt")
        return T_FAIL
    }
    # Header (20 bytes) and checksum (8) stay; every payload byte becomes 0xff.
    let mut i: i32 = 0
    while i < sl_len(files) {
        let path: string = sl_get(files, i)
        let body: Bytes = read_bytes(path)
        if body.len <= 28 {
            outln("cache record has no payload: " + path)
            return T_FAIL
        }
        let mut k: i64 = 28
        while k < body.len {
            body.data[k] = 255
            k = k + 1
        }
        if not write_bytes(path, body.data, body.len) {
            outln("could not rewrite " + path)
            return T_FAIL
        }
        i = i + 1
    }
    let r2: i32 = compile_run(host, dir, "payload", xdg, home)
    if r2 != 11 {
        outln("expected 11 after corrupting the cached payload, got " + s_itoa(r2))
        return T_FAIL
    }
    return T_PASS
}

# One count from the profile's `"cache": {...}` object, or -1.
function cache_count(err: string, key: string) -> i32 {
    let at: i32 = s_find(err, "\"cache\": {", 0)
    if at < 0 {
        return 0 - 1
    }
    let k: i32 = s_find(err, "\"" + key + "\": ", at)
    if k < 0 {
        return 0 - 1
    }
    return s_atoi(s_from(err, k + s_len(key) + 4), 0 - 1)
}

# Emit with FLOWC_PROFILE=json; writes hits, misses, stores into out.
function emit_counts(host: string, src: string, out_c: string, xdg: string, home: string, out: ptr<i32>) -> bool {
    let c: ptr<ProcCmd> = t_cmd(sl_of1(host))
    proc_env(c, "FLOWC_IN", src)
    proc_env(c, "FLOWC_OUT", out_c)
    proc_env(c, "FLOWC_BUNDLE", "1")
    proc_env(c, "FLOWC_PROFILE", "json")
    proc_env(c, "FLOW_CACHE_SALT", "leaf-edit")
    proc_env(c, "XDG_CACHE_HOME", xdg)
    proc_env(c, "HOME", home)
    if t_run(c) != 0 {
        outln("flowc emit failed")
        t_cat(t_err())
        return false
    }
    let err: string = read_text(t_err())
    out[0] = cache_count(err, "hits")
    out[1] = cache_count(err, "misses")
    out[2] = cache_count(err, "stores")
    if out[0] < 0 or out[1] < 0 or out[2] < 0 {
        outln("no cache counts in the profile line")
        t_cat(t_err())
        return false
    }
    return true
}

# Hit/miss diagnostics, and a single-leaf edit re-parses only that leaf:
# cold build misses and stores every module, a no-op rebuild hits every
# module, and editing leaf.flow misses once and hits the rest.
function check_leaf_edit_reparses_only_leaf() -> i32 {
    let host: string = host_bin()
    if s_len(host) == 0 or not is_file(host) {
        outln("flowc_host did not print a binary")
        return T_FAIL
    }
    let dir: string = t_tmp() + "/proj"
    let xdg: string = t_tmp() + "/xdg"
    let home: string = t_tmp() + "/home"
    let _d: bool = mkdir_p(dir)
    let w1: bool = write_text(dir + "/leaf.flow", "export function helper() -> i32 { return 1; }\n")
    let w2: bool = write_text(dir + "/mid.flow", "export function other() -> i32 { return 2; }\n")
    let w3: bool = write_text(dir + "/app.flow", "import .leaf\nimport .mid\nfunction main() -> i32 { return helper() + other(); }\n")
    if not (w1 and w2 and w3) {
        return T_FAIL
    }
    let mut n: array<i32, 3> = [0, 0, 0]
    let src: string = dir + "/app.flow"
    let out_c: string = dir + "/app.c"

    # A bundle looks each module up more than once (the private-name scan,
    # then emit), so a cold build already hits on the second lookup. What
    # matters: one miss and one store per distinct module source.
    if not emit_counts(host, src, out_c, xdg, home, &n[0]) {
        return T_FAIL
    }
    let modules: i32 = n[1]
    let lookups: i32 = n[0] + n[1]
    if modules < 3 or n[2] != modules {
        outln("cold build: want one miss and one store per module (>= 3), got hits=" + s_itoa(n[0]) + " misses=" + s_itoa(n[1]) + " stores=" + s_itoa(n[2]))
        return T_FAIL
    }

    if not emit_counts(host, src, out_c, xdg, home, &n[0]) {
        return T_FAIL
    }
    if n[1] != 0 or n[2] != 0 or n[0] != lookups {
        outln("no-op rebuild: want " + s_itoa(lookups) + " hits and no misses, got hits=" + s_itoa(n[0]) + " misses=" + s_itoa(n[1]) + " stores=" + s_itoa(n[2]))
        return T_FAIL
    }

    let _e: bool = write_text(dir + "/leaf.flow", "export function helper() -> i32 { return 5; }\n")
    if not emit_counts(host, src, out_c, xdg, home, &n[0]) {
        return T_FAIL
    }
    if n[1] != 1 or n[2] != 1 or n[0] != lookups - 1 {
        outln("leaf edit: want 1 miss and " + s_itoa(lookups - 1) + " hits, got hits=" + s_itoa(n[0]) + " misses=" + s_itoa(n[1]) + " stores=" + s_itoa(n[2]))
        return T_FAIL
    }
    if not a_contains(read_text(out_c), "return 5") {
        outln("edited leaf did not reach the emitted C")
        return T_FAIL
    }
    return T_PASS
}

function main() -> i32 {
    t_begin("incremental_cache")
    t_start()
    t_end("leaf_edit", check_leaf_edit_reparses_only_leaf())
    t_start()
    t_end("salt_mutation", check_salt_mutation_invalidates())
    t_start()
    t_end("source_edit", check_source_edit_invalidates())
    t_start()
    t_end("untrusted_checkout", check_untrusted_checkout_is_inert())
    t_start()
    t_end("format_not_pickle", check_cache_format_is_not_pickle())
    t_start()
    t_end("long_cache_root", check_long_cache_root_skips_cache())
    t_start()
    t_end("out_of_range_root", check_out_of_range_root_is_a_miss())
    t_start()
    t_end("corrupt_payload", check_corrupt_payload_is_a_miss())
    t_done()
    return 0
}
