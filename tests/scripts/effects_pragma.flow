# `# effects-mode: permissive` in a test's first lines opts it out of strict
# effect handling (#1165). `./flow test` honoured the pragma; `test-lang` and
# `test-runtime` did not, so tests/lang/test_effects.flow failed to type check
# and tests/runtime/test_effects_showcase.flow aborted (exit 134). These
# checks run both runners on pragma files, and check that a copy without the
# pragma is still held to strict effects.

import "tools/flow_cli/sys.flow"
import "tests/scripts/harness.flow"

function flow_cmd(sub: string, file: string) -> i32 {
    return t_run_argv(sl_of3(t_root() + "/flow", sub, file))
}

function check_test_lang_honours_the_pragma() -> i32 {
    let need: i32 = t_need_cc()
    if need != T_PASS {
        return need
    }
    if flow_cmd("test-lang", "tests/lang/test_effects.flow") != 0 {
        t_cat(t_out())
        return T_FAIL
    }
    return T_PASS
}

function check_test_runtime_honours_the_pragma() -> i32 {
    let need: i32 = t_need_cc()
    if need != T_PASS {
        return need
    }
    if flow_cmd("test-runtime", "tests/runtime/test_effects_showcase.flow") != 0 {
        t_cat(t_out())
        return T_FAIL
    }
    return T_PASS
}

# The same program with the pragma line removed must fail under test-lang.
function check_no_pragma_stays_strict() -> i32 {
    let need: i32 = t_need_cc()
    if need != T_PASS {
        return need
    }
    let src: string = read_text("tests/lang/test_effects.flow")
    let body: string = s_replace(src, "# effects-mode: permissive\n", "")
    if s_eq(body, src) {
        outln("tests/lang/test_effects.flow has no effects-mode pragma line")
        return T_FAIL
    }
    let prog: string = t_tmp() + "/test_effects_strict.flow"
    let _w: bool = write_text(prog, body)
    if flow_cmd("test-lang", prog) == 0 {
        outln("test-lang accepted test_effects.flow without the pragma")
        return T_FAIL
    }
    if not a_file_contains(t_out(), "Unhandled effect") {
        t_cat(t_out())
        return T_FAIL
    }
    return T_PASS
}

function main() -> i32 {
    t_begin("effects_pragma")
    t_start()
    t_end("test_lang_honours_the_pragma", check_test_lang_honours_the_pragma())
    t_start()
    t_end("test_runtime_honours_the_pragma", check_test_runtime_honours_the_pragma())
    t_start()
    t_end("no_pragma_stays_strict", check_no_pragma_stays_strict())
    t_done()
    return 0
}
