import "scripts/tools/lib/testrun.flow"
import "tests/scripts/harness.flow"

function check_specialization() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/jit_specialize/main.flow")
    sl_push(argv, "--shapes=64,128")
    sl_push(argv, "--lanes=8")
    if t_run(t_cmd(argv)) != 0 { return T_FAIL }
    let output: string = read_text(t_out())
    if not a_contains(output, "flow.jit.masked_tails = true") { return T_FAIL }
    if not a_contains(output, "@flow_kernel_128") { return T_FAIL }
    if not a_contains(output, "scf.if %hit1 -> (index)") { return T_FAIL }
    if a_contains(output, "arith.select") { return T_FAIL }
    if not a_contains(output, "vector.maskedload") { return T_FAIL }
    return T_PASS
}

function check_rejects_non_positive_shape() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/jit_specialize/main.flow")
    sl_push(argv, "--shapes=64,0")
    sl_push(argv, "--lanes=8")
    if t_run(t_cmd(argv)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "shapes must be positive integers") { return T_FAIL }
    return T_PASS
}

function check_rejects_invalid_lanes() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/jit_specialize/main.flow")
    sl_push(argv, "--shapes=64")
    sl_push(argv, "--lanes=65")
    if t_run(t_cmd(argv)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "lanes in 1..64") { return T_FAIL }
    return T_PASS
}

function check_rejects_duplicate_shapes() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/jit_specialize/main.flow")
    sl_push(argv, "--shapes=64,64")
    sl_push(argv, "--lanes=8")
    if t_run(t_cmd(argv)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "shapes must be unique") { return T_FAIL }
    return T_PASS
}

function check_rejects_shape_overflow() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/jit_specialize/main.flow")
    sl_push(argv, "--shapes=1,2,3,4,5,6,7,8,9")
    sl_push(argv, "--lanes=8")
    if t_run(t_cmd(argv)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "at most 8 shapes") { return T_FAIL }
    return T_PASS
}

function main() -> i32 {
    t_begin("jit_specialize")
    t_start()
    t_end("shape_dispatch", check_specialization())
    t_start()
    t_end("reject_non_positive_shape", check_rejects_non_positive_shape())
    t_start()
    t_end("reject_invalid_lanes", check_rejects_invalid_lanes())
    t_start()
    t_end("reject_duplicate_shapes", check_rejects_duplicate_shapes())
    t_start()
    t_end("reject_shape_overflow", check_rejects_shape_overflow())
    t_done()
    return 0
}
