# Feature coverage: does every part of the language have a documented home?
#
# The checker is scripts/tools/doc_coverage (`./flow tool doc_coverage`). These
# tests drive it through that entry point, using its --inventory, --map,
# --mentions and --is-backend options.

import "tools/flow_cli/sys.flow"
import "tests/scripts/harness.flow"
import std.process { ProcCmd, ProcResult, proc_stdout, proc_stderr, PROC_CAPTURE }

extern {
    function malloc(size: i64) -> ptr<void>
}

function checker(args: ptr<ProcStrs>) -> ptr<ProcStrs> {
    let argv: ptr<ProcStrs> = sl_of3(t_root() + "/flow", "tool", "doc_coverage")
    sl_extend(argv, args)
    return argv
}

function map_path() -> string {
    return t_root() + "/docs/coverage.json"
}

# The inventory comes from the compiler, so it cannot go stale. Read it
# once; each line is category:name.
struct Inventory {
    lines: ptr<ProcStrs>,
    rc: i32,
    err: string
}

let mut INV: ptr<Inventory> = null

function read_inventory() {
    let inv: ptr<Inventory> = malloc(24) as ptr<Inventory>
    let c: ptr<ProcCmd> = cmd(checker(sl_of1("--inventory")))
    proc_stdout(c, PROC_CAPTURE)
    proc_stderr(c, PROC_CAPTURE)
    let r: ptr<ProcResult> = run_result(c)
    inv.lines = s_lines(r.stdout)
    inv.rc = r.exit_code
    inv.err = r.stderr
    INV = inv
}

function inventory_ok() -> bool {
    let inv: ptr<Inventory> = INV
    if inv.rc != 0 {
        out(inv.err)
        return false
    }
    return true
}

function inventory_has(entry: string) -> bool {
    let inv: ptr<Inventory> = INV
    return sl_has(inv.lines, entry)
}

# Assert that each space-separated NAME is in CATEGORY.
function in_inventory(category: string, names: string) -> bool {
    let l: ptr<ProcStrs> = s_words(names)
    let mut i: i32 = 0
    while i < sl_len(l) {
        let e: string = category + ":" + sl_get(l, i)
        if not a_true(e + " in the inventory", inventory_has(e)) {
            return false
        }
        i = i + 1
    }
    return true
}

function not_in_inventory(category: string, names: string) -> bool {
    let l: ptr<ProcStrs> = s_words(names)
    let mut i: i32 = 0
    while i < sl_len(l) {
        let e: string = category + ":" + sl_get(l, i)
        if inventory_has(e) {
            outln(e + " must not be in the inventory")
            return false
        }
        i = i + 1
    }
    return true
}

function check_keywords_come_from_the_lexer() -> i32 {
    if not inventory_ok() {
        return T_FAIL
    }
    # A sample of constructs the parser really reserves.
    if not in_inventory("keyword", "function effect capability distinct defer match") {
        return T_FAIL
    }
    return T_PASS
}

function check_attributes_come_from_the_attribute_module() -> i32 {
    if not inventory_ok() {
        return T_FAIL
    }
    if not in_inventory("attribute", "inline only gpu rt_safe libm") {
        return T_FAIL
    }
    let inv: ptr<Inventory> = INV
    let attrs: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(inv.lines) {
        let line: string = sl_get(inv.lines, i)
        if s_starts(line, "attribute:") and not sl_has(attrs, line) {
            sl_push(attrs, line)
        }
        i = i + 1
    }
    if not a_eq(s_itoa(sl_len(attrs)), "22", "attribute count") {
        return T_FAIL
    }
    return T_PASS
}

function check_cli_commands_come_from_the_dispatch_table() -> i32 {
    if not inventory_ok() {
        return T_FAIL
    }
    if not in_inventory("cli", "run compile test fmt repl wasm") {
        return T_FAIL
    }
    # Arch and profile `case` arms elsewhere in the driver must not leak in.
    if not not_in_inventory("cli", "x86_64 aarch64 auto safety flight") {
        return T_FAIL
    }
    return T_PASS
}

function check_stdlib_modules_are_discovered_including_subdirectories() -> i32 {
    if not inventory_ok() {
        return T_FAIL
    }
    if not in_inventory("stdlib", "array string gfx") {
        return T_FAIL
    }
    if not in_inventory("stdlib", "filters oscillators") {
        outln("audio/ subdirectory missing")
        return T_FAIL
    }
    if not in_inventory("stdlib", "lqr wfc") {
        outln("dynamics/ subdirectory missing")
        return T_FAIL
    }
    return T_PASS
}

function check_backends_are_discovered() -> i32 {
    if not inventory_ok() {
        return T_FAIL
    }
    if not in_inventory("backend", "cgen mlirgen bpf_target") {
        return T_FAIL
    }
    return T_PASS
}

function check_backend_discovery_covers_every_naming_convention(stem: string, expected: string) -> i32 {
    let _r: i32 = t_run_argv(checker(sl_of2("--is-backend", stem)))
    if not a_eq(s_strip_all_space(read_text(t_out())), expected, "--is-backend " + stem) {
        return T_FAIL
    }
    return T_PASS
}

# The shipped map.
function check_every_feature_has_a_home_or_a_written_reason() -> i32 {
    if t_run_argv(checker(sl_new())) != 0 {
        t_cat(t_out())
        t_cat(t_err())
        return T_FAIL
    }
    if not a_file_contains(t_out(), "every feature has a documented home") {
        return T_FAIL
    }
    return T_PASS
}

function check_every_exemption_carries_a_reason() -> i32 {
    let j: ptr<Json> = tj_load(map_path())
    let blank: ptr<ProcStrs> = sl_new()
    let mut c: i32 = tj_first(j, tj_path(j, "exempt"))
    while c >= 0 {
        if s_len(s_trim(tj_raw(j, c))) == 0 {
            sl_push(blank, tj_key(j, c))
        }
        c = tj_next(j, c)
    }
    if sl_len(blank) > 0 {
        outln("exempt with no reason: " + sl_join(blank, "\n"))
        return T_FAIL
    }
    return T_PASS
}

function check_the_map_is_valid_json_and_sorted() -> i32 {
    let j: ptr<Json> = tj_load(map_path())
    let mut got: string = "false"
    if tj_len(j, tj_path(j, "covered")) > 0 and tj_path(j, "exempt") >= 0 {
        got = "true"
    }
    if not a_eq(got, "true", "covered is non-empty and exempt exists") {
        return T_FAIL
    }
    return T_PASS
}

# The real map with covered[KEY] set to the JSON value `value`, or deleted
# when `value` is "", written to <tmp>/coverage.json.
function write_map_with(key: string, value: string) -> string {
    let j: ptr<Json> = tj_load(map_path())
    let mut text: string = "{"
    let mut first: bool = true
    let mut c: i32 = tj_first(j, 0)
    while c >= 0 {
        if not first {
            text = text + ","
        }
        first = false
        text = text + tj_quote(tj_key(j, c)) + ":"
        if s_eq(tj_key(j, c), "covered") {
            let mut inner: string = "{"
            let mut ifirst: bool = true
            let mut found: bool = false
            let mut m: i32 = tj_first(j, c)
            while m >= 0 {
                let mut member: string = tj_compact(j, m)
                let mut keep: bool = true
                if s_eq(tj_key(j, m), key) {
                    found = true
                    member = value
                    keep = s_len(value) > 0
                }
                if keep {
                    if not ifirst {
                        inner = inner + ","
                    }
                    ifirst = false
                    inner = inner + tj_quote(tj_key(j, m)) + ":" + member
                }
                m = tj_next(j, m)
            }
            if not found and s_len(value) > 0 {
                if not ifirst {
                    inner = inner + ","
                }
                inner = inner + tj_quote(key) + ":" + value
            }
            text = text + inner + "}"
        } else {
            text = text + tj_compact(j, c)
        }
        c = tj_next(j, c)
    }
    let path: string = t_tmp() + "/coverage.json"
    let _w: bool = write_text(path, text + "}\n")
    return path
}

# A mapping has to point at a page that exists and mentions the feature.
# Write the real map with one edit applied and run the checker against it.
function check_with_map(value: string) -> i32 {
    let path: string = write_map_with("keyword:defer", value)
    return t_run_argv(checker(sl_of2("--map", path)))
}

function check_a_feature_with_no_mapping_is_reported() -> i32 {
    let _r: i32 = check_with_map("")
    if not a_eq_int(t_rc(), 1, "exit status") {
        return T_FAIL
    }
    if not a_file_contains(t_out(), "keyword:defer has no documented home") {
        return T_FAIL
    }
    return T_PASS
}

function check_a_mapping_to_a_missing_page_fails() -> i32 {
    let _r: i32 = check_with_map("\"no/such/page.md\"")
    if not a_eq_int(t_rc(), 1, "exit status") {
        return T_FAIL
    }
    if not a_file_contains(t_out(), "does not exist") {
        return T_FAIL
    }
    return T_PASS
}

function check_a_page_that_does_not_mention_the_feature_fails() -> i32 {
    # An absolute page path is joined as-is, so the map can point outside docs/.
    let page: string = t_tmp() + "/empty.md"
    let _w: bool = write_text(page, "# A page about something else entirely\n")
    let _r: i32 = check_with_map(tj_quote(page))
    if not a_eq_int(t_rc(), 1, "exit status") {
        return T_FAIL
    }
    if not a_file_contains(t_out(), "keyword:defer maps to '" + page + "', which never mentions it") {
        return T_FAIL
    }

    let _w2: bool = write_text(page, "`defer` runs on scope exit\n")
    if t_run_argv(checker(sl_of2("--map", t_tmp() + "/coverage.json"))) != 0 {
        t_cat(t_out())
        return T_FAIL
    }
    return T_PASS
}

function check_mentions_is_specific_enough_to_be_worth_something(category: string, feature: string, text: string, expected: string) -> i32 {
    let page: string = t_tmp() + "/p.md"
    let _w: bool = write_text(page, text)
    let args: ptr<ProcStrs> = sl_of3("--mentions", category, feature)
    sl_push(args, page)
    let _r: i32 = t_run_argv(checker(args))
    if not a_eq(s_strip_all_space(read_text(t_out())), expected, "--mentions " + category + " " + feature) {
        return T_FAIL
    }
    return T_PASS
}

function backend_case(stem: string, expected: string) {
    t_start()
    t_end("backend_discovery_covers_every_naming_convention[" + stem + "]", check_backend_discovery_covers_every_naming_convention(stem, expected))
}

function mentions_case(id: string, category: string, feature: string, text: string, expected: string) {
    t_start()
    t_end("mentions[" + id + "]", check_mentions_is_specific_enough_to_be_worth_something(category, feature, text, expected))
}

function main() -> i32 {
    t_begin("doc_coverage")
    read_inventory()
    t_start()
    t_end("keywords_come_from_the_lexer", check_keywords_come_from_the_lexer())
    t_start()
    t_end("attributes_come_from_the_attribute_module", check_attributes_come_from_the_attribute_module())
    t_start()
    t_end("cli_commands_come_from_the_dispatch_table", check_cli_commands_come_from_the_dispatch_table())
    t_start()
    t_end("stdlib_modules_are_discovered_including_subdirectories", check_stdlib_modules_are_discovered_including_subdirectories())
    t_start()
    t_end("backends_are_discovered", check_backends_are_discovered())
    backend_case("x_generator", "True")
    backend_case("y_codegen", "True")
    backend_case("z_compiler", "True")
    # A BPF target on an unmerged branch was named bpf_target.py, which the
    # original three suffixes did not match, so a whole new compilation
    # target would have landed undocumented.
    backend_case("bpf_target", "True")
    backend_case("w_backend", "True")
    backend_case("mlirgen", "True")
    backend_case("parser", "False")
    t_start()
    t_end("every_feature_has_a_home_or_a_written_reason", check_every_feature_has_a_home_or_a_written_reason())
    t_start()
    t_end("every_exemption_carries_a_reason", check_every_exemption_carries_a_reason())
    t_start()
    t_end("the_map_is_valid_json_and_sorted", check_the_map_is_valid_json_and_sorted())
    t_start()
    t_end("a_feature_with_no_mapping_is_reported", check_a_feature_with_no_mapping_is_reported())
    t_start()
    t_end("a_mapping_to_a_missing_page_fails", check_a_mapping_to_a_missing_page_fails())
    t_start()
    t_end("a_page_that_does_not_mention_the_feature_fails", check_a_page_that_does_not_mention_the_feature_fails())
    mentions_case("attribute-gpu-attr", "attribute", "gpu", "use @gpu on a kernel", "True")
    # A bare word is not the attribute.
    mentions_case("attribute-gpu-word", "attribute", "gpu", "the gpu is fast", "False")
    mentions_case("cli-run-command", "cli", "run", "./flow run prog.flow", "True")
    mentions_case("cli-run-word", "cli", "run", "a long run of failures", "False")
    mentions_case("keyword-defer-code", "keyword", "defer", "`defer` runs on scope exit", "True")
    mentions_case("keyword-defer-prefix", "keyword", "defer", "deferred work", "False")
    t_done()
    return 0
}
