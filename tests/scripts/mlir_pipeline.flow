import "scripts/tools/lib/testrun.flow"
import "tests/scripts/harness.flow"

function check_affine_normalization() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
    sl_push(argv, "--opt-level=O2")
    sl_push(argv, "--enable-affine-normalization")
    if t_run(t_cmd(argv)) != 0 { return T_FAIL }
    let output: string = read_text(t_out())
    if not a_contains(output, "affine-loop-normalize") { return T_FAIL }
    return T_PASS
}

function check_normalization_stays_opt_in() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
    sl_push(argv, "--opt-level=O2")
    if t_run(t_cmd(argv)) != 0 { return T_FAIL }
    if a_contains(read_text(t_out()), "affine-loop-normalize") { return T_FAIL }
    return T_PASS
}

function check_affine_tiling() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
    sl_push(argv, "--opt-level=O2")
    sl_push(argv, "--enable-affine-tiling")
    sl_push(argv, "--affine-tile-size=32")
    if t_run(t_cmd(argv)) != 0 { return T_FAIL }
    if not a_contains(read_text(t_out()), "affine-loop-tile{tile-size=32}") { return T_FAIL }
    return T_PASS
}

function check_tiling_requires_size() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
    sl_push(argv, "--enable-affine-tiling")
    if t_run(t_cmd(argv)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "requires --affine-tile-size") { return T_FAIL }
    return T_PASS
}

function check_loop_fusion() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
    sl_push(argv, "--opt-level=O2")
    sl_push(argv, "--loop-fusion")
    if t_run(t_cmd(argv)) != 0 { return T_FAIL }
    let output: string = read_text(t_out())
    if not a_contains(output, "affine-loop-fusion") { return T_FAIL }
    if not a_contains(output, "linalg-fuse-elementwise-ops") { return T_FAIL }
    return T_PASS
}

function check_loop_fusion_o1_gate() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
    sl_push(argv, "--opt-level=O1")
    sl_push(argv, "--loop-fusion")
    if t_run(t_cmd(argv)) != 0 { return T_FAIL }
    if a_contains(read_text(t_out()), "affine-loop-fusion") { return T_FAIL }
    return T_PASS
}

function check_affine_unrolling() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
    sl_push(argv, "--opt-level=O2")
    sl_push(argv, "--enable-affine-unrolling")
    sl_push(argv, "--affine-unroll-factor=4")
    if t_run(t_cmd(argv)) != 0 { return T_FAIL }
    if not a_contains(read_text(t_out()), "affine-loop-unroll{unroll-factor=4}") { return T_FAIL }
    return T_PASS
}

function check_unrolling_requires_factor() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
    sl_push(argv, "--enable-affine-unrolling")
    if t_run(t_cmd(argv)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "requires --affine-unroll-factor") { return T_FAIL }
    return T_PASS
}

function main() -> i32 {
    t_begin("mlir_pipeline")
    t_start()
    t_end("affine_normalization", check_affine_normalization())
    t_start()
    t_end("normalization_opt_in", check_normalization_stays_opt_in())
    t_start()
    t_end("affine_tiling", check_affine_tiling())
    t_start()
    t_end("tiling_requires_size", check_tiling_requires_size())
    t_start()
    t_end("loop_fusion", check_loop_fusion())
    t_start()
    t_end("loop_fusion_o1_gate", check_loop_fusion_o1_gate())
    t_start()
    t_end("affine_unrolling", check_affine_unrolling())
    t_start()
    t_end("unrolling_requires_factor", check_unrolling_requires_factor())
    t_done()
    return 0
}
