function main() -> i32 {
    t_begin("mlir_pipeline")
    t_start()
    t_end("affine_normalization", check_affine_normalization())
    t_start()
    t_end("normalization_opt_in", check_normalization_stays_opt_in())
    t_start()
    t_end("affine_tiling", check_affine_tiling())
    t_start()
    t_end("tiling_requires_size", check_tiling_requires_size())
    t_start()
    t_end("tiling_rejects_malformed_size", check_tiling_rejects_malformed_size())
    t_end("tiling_rejects_overflow_size", check_tiling_rejects_overflow_size())
    t_end("tiling_rejects_wrapped_overflow_size", check_tiling_rejects_wrapped_overflow_size())
    t_end("affine_value_flags_reject_missing_values", check_affine_value_flags_reject_missing_values())
    t_end("opt_level_rejects_missing_value", check_opt_level_rejects_missing_value())
    t_start()
    t_end("hierarchical_tiling", check_hierarchical_tiling())
    t_start()
    t_end("hierarchical_tiling_invalid", check_hierarchical_tiling_rejects_malformed_sizes())
    t_start()
    t_end("loop_fusion", check_loop_fusion())
    t_start()
    t_end("loop_fusion_o1_gate", check_loop_fusion_o1_gate())
    t_start()
    t_end("loop_fusion_disabled", check_loop_fusion_can_be_disabled())
    t_start()
    t_end("multi_buffering_factor", check_multi_buffering_factor())
    t_start()
    t_end("multi_buffering_factor_range", check_multi_buffering_factor_rejects_out_of_range())
    t_start()
    t_end("multi_buffering_factor_value", check_multi_buffering_factor_requires_value())
    t_start()
    t_end("async_copy_staging_schedule", check_async_copy_supplies_staging_schedule())
    t_start()
    t_end("async_copy_explicit_schedule", check_async_copy_preserves_explicit_schedule())
    t_start()
    t_end("affine_unrolling", check_affine_unrolling())
    t_start()
    t_end("unrolling_requires_factor", check_unrolling_requires_factor())
    t_start()
    t_end("affine_unroll_jam", check_affine_unroll_jam())
    t_start()
    t_end("unroll_jam_requires_factor", check_unroll_jam_requires_factor())
    t_start()
    t_end("unroll_jam_malformed_factor", check_unroll_jam_rejects_malformed_factor())
    t_start()
    t_end("affine_coalescing", check_affine_coalescing())
    t_start()
    t_end("affine_parallelize", check_affine_parallelize())
    t_start()
    t_end("affine_interchange", check_affine_interchange())
    t_start()
    t_end("interchange_opt_in", check_interchange_stays_opt_in())
    t_start()
    t_end("interchange_o1_gate", check_interchange_o1_gate())
    t_start()
    t_end("affine_skewing", check_affine_skewing())
    t_end("skewing_requires_factor", check_skewing_requires_factor())
    t_end("skewing_malformed_factor", check_skewing_rejects_malformed_factor())
    t_done()
    return 0
}
