function check_async_copy_supplies_staging_schedule() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
    sl_push(argv, "--opt-level=O2")
    sl_push(argv, "--enable-async-copy")
    sl_push(argv, "--async-copy-target=gpu")
    if t_run(t_cmd(argv)) != 0 { return T_FAIL }
    let output: string = read_text(t_out())
    if not a_contains(output, "test-multi-buffering{multiplier=2}") { return T_FAIL }
    if not a_contains(output, "test-scf-pipelining") { return T_FAIL }
    if not a_contains(output, "gpu-async-region") { return T_FAIL }
    return T_PASS
}

function check_async_copy_preserves_explicit_schedule() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
    sl_push(argv, "--opt-level=O2")
    sl_push(argv, "--enable-async-copy")
    sl_push(argv, "--async-copy-target=nvptx")
    sl_push(argv, "--enable-multi-buffering")
    sl_push(argv, "--multi-buffering-factor=4")
    sl_push(argv, "--enable-loop-pipelining")
    if t_run(t_cmd(argv)) != 0 { return T_FAIL }
    let output: string = read_text(t_out())
    if not a_contains(output, "test-multi-buffering{multiplier=4}") { return T_FAIL }
    if not a_contains(output, "test-scf-pipelining") { return T_FAIL }
    if not a_contains(output, "gpu-async-region") { return T_FAIL }
    return T_PASS
}

