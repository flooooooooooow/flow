function check_tiling_rejects_wrapped_overflow_size() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
    sl_push(argv, "--enable-affine-tiling")
    sl_push(argv, "--affine-tile-size=4294967297")
    if t_run(t_cmd(argv)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "--affine-tile-size must be a positive integer") { return T_FAIL }
    return T_PASS
}

function check_affine_value_flags_reject_missing_values() -> i32 {
    let names: ptr<ProcStrs> = sl_of3("--affine-tile-size", "--affine-tile-sizes", "--affine-skew-factor")
    let mut i: i32 = 0
    while i < 3 {
        let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
        sl_push(argv, sl_get(names, i))
        if t_run(t_cmd(argv)) == 0 { return T_FAIL }
        if not a_contains(read_text(t_err()), "requires a value") { return T_FAIL }
        i = i + 1
    }
    let argv2: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
    sl_push(argv2, "--affine-unroll-factor")
    if t_run(t_cmd(argv2)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "requires a value") { return T_FAIL }
    let argv3: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
    sl_push(argv3, "--affine-unroll-jam-factor")
    if t_run(t_cmd(argv3)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "requires a value") { return T_FAIL }
    let argv4: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
    sl_push(argv4, "--async-copy-target")
    if t_run(t_cmd(argv4)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "requires a value") { return T_FAIL }
    return T_PASS
}

function check_opt_level_rejects_missing_value() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
    sl_push(argv, "--opt-level")
    if t_run(t_cmd(argv)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "--opt-level requires a value") { return T_FAIL }

    let argv2: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
    sl_push(argv2, "--opt-level=")
    if t_run(t_cmd(argv2)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "--opt-level requires a value") { return T_FAIL }
    return T_PASS
}

function check_hierarchical_tiling() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
    sl_push(argv, "--opt-level=O2")
    sl_push(argv, "--enable-affine-tiling")
    sl_push(argv, "--affine-tile-sizes=64,32,8")
    if t_run(t_cmd(argv)) != 0 { return T_FAIL }
    let output: string = read_text(t_out())
    if not a_contains(output, "affine-loop-tile{tile-size=64}") { return T_FAIL }
    if not a_contains(output, "affine-loop-tile{tile-size=32}") { return T_FAIL }
    if not a_contains(output, "affine-loop-tile{tile-size=8}") { return T_FAIL }
    return T_PASS
}

function check_hierarchical_tiling_rejects_malformed_sizes() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
    sl_push(argv, "--enable-affine-tiling")
    sl_push(argv, "--affine-tile-sizes=64,0,8")
    if t_run(t_cmd(argv)) == 0 { return T_FAIL }
    if not a_contains(read_text(t_err()), "two to four positive integers") { return T_FAIL }
    return T_PASS
}

function check_loop_fusion() -> i32 {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "scripts/tools/mlir_pipeline/main.flow")
