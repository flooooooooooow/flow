        run_matmul_tests
        ;;
    "test-all")
        run_all_tests
        ;;
    "python")
        shift
        if [ -z "${1:-}" ]; then
            print_error "Usage: flow python <program.flow> [--name NAME] [--version VER] [--source]"
            exit 1
        fi
        program="${1:-}"
        require_flow_file "$program"
        shift
        
        # Parse python-specific options
        py_name=""
        py_version="0.1.0"
        py_source_only=0
        
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --name)
                    py_name="$2"
                    shift 2
                    ;;
                --version)
                    py_version="$2"
                    shift 2
                    ;;
                --source)
                    py_source_only=1
                    shift
                    ;;
                *)
                    shift
                    ;;
            esac
        done
        
        print_info "Generating Python package from $program..."

        # The generator is the Flow tool tools/pywheel: export inference,
        # diagnostics and the CPython extension source, with the program's C
        # from flowc. Only the wheel build itself runs Python: `pip wheel`
        # on the generated package, which needs setuptools. That step builds
        # a Python artifact; it does not run Flow's compiler in Python.
        # --source never runs Python.
        if ! pywheel_bin="$(flow_native_tool pywheel)"; then
            exit 1
        fi
        py_out="dist"
        py_work="$(mktemp -d "${TMPDIR:-/tmp}/flow-pywheel.XXXXXX")"
        trap 'rm -rf "$py_work"' EXIT
        py_mode="package"
        if [ "$py_source_only" -eq 1 ]; then
            py_mode="source"
        fi
        "$pywheel_bin" "$program" "$py_name" "$py_version" "$py_mode" \
            "$py_out" "$py_work" "$SCRIPT_DIR" || exit $?
        if [ "$py_mode" = "source" ]; then
            exit 0
        fi
        py_ext="$(cd "$py_work/pkg" && ls -- *_ext.c)"
        py_module="${py_ext%_ext.c}"
        mkdir -p "$py_out"
        py_out_abs="$(cd "$py_out" && pwd)"
        py_wheel=""
        if (cd "$py_work/pkg" && "${FLOW_PYTHON:-python3}" -m pip wheel . -w "$py_out_abs" \
                >/dev/null 2>"$py_work/pip.log"); then
            py_wheel="$(ls -- "$py_out/$py_module"*.whl 2>/dev/null | head -1)"
            if [ -n "$py_wheel" ]; then
                echo "✅ Built wheel: $py_wheel"
                echo "   Install with: pip install $py_wheel"
                exit 0
            fi
            echo "⚠️  Wheel build failed: No wheel file produced"
        else
            echo "⚠️  Wheel build failed: Wheel build failed:"
            cat "$py_work/pip.log"
            echo
        fi
        echo "   Falling back to source-only output..."
        cp "$py_work/pkg/$py_ext" "$py_out/$py_ext"
        echo "   Generated: $py_out/$py_ext"
        ;;
    "bpf")
        # scripts/tools/llvm_target (Flow): Flow or LLVM IR to an eBPF object.
        shift
        exec "$SCRIPT_DIR/scripts/bpf_target.sh" "$@"
        ;;
    "wasm32")
        # scripts/tools/llvm_target (Flow): Flow or LLVM IR to a wasm32 module.
        shift
        exec "$SCRIPT_DIR/scripts/wasm32_target.sh" "$@"
        ;;
    "wasm")
        shift
        # Homebrew's emscripten ships a config pointing LLVM_ROOT at /usr/bin
        # (Xcode clang, no wasm backend) and a launcher that picks the system
        # python3, which is too old to parse its own sources. Point both at
        # emscripten's own copies unless the caller already has.
        if [ -z "${EMSDK_PYTHON:-}" ] && [ -x /opt/homebrew/bin/python3.14 ]; then
            export EMSDK_PYTHON=/opt/homebrew/bin/python3.14
        fi
        if [ -z "${EM_LLVM_ROOT:-}" ] && [ -d /opt/homebrew/opt/emscripten/libexec/llvm/bin ]; then
            export EM_LLVM_ROOT=/opt/homebrew/opt/emscripten/libexec/llvm/bin
        fi
        if [ -z "${EM_BINARYEN_ROOT:-}" ] && [ -d /opt/homebrew/opt/emscripten/libexec/binaryen ]; then
            export EM_BINARYEN_ROOT=/opt/homebrew/opt/emscripten/libexec/binaryen
        fi
        # --threads builds pthreads over Web Workers, --fs mounts MEMFS/IDBFS;
        # both are documented in docs/language/wasm-crossings.md. Everything
        # else goes to the standard page builder. --preload without --fs is
        # forwarded to scripts/wasm_build.sh (emcc --preload-file) for both backends.
        wasm_threads=0
        wasm_workers=8
        wasm_fs=""
        wasm_preload=()
        wasm_link=()
        wasm_backend=""
        wasm_args=()
        while [ $# -gt 0 ]; do
            case "$1" in
                --threads) wasm_threads=1 ;;
                --workers) shift; wasm_workers="${1:-8}" ;;
                --fs) shift; wasm_fs="${1:-memfs}" ;;
                --preload) shift; wasm_preload+=(--preload "${1:-}") ;;
                --link) shift; wasm_link+=(--link "${1:-}") ;;
                --backend=*) wasm_backend="${1#--backend=}"; wasm_args+=("$1") ;;
                --backend)
                    shift
                    wasm_backend="${1:-}"
                    wasm_args+=(--backend "$wasm_backend")
                    ;;
                *) wasm_args+=("$1") ;;
            esac
            shift
        done
        set -- ${wasm_args[@]+"${wasm_args[@]}"}
        if [ -z "$wasm_backend" ]; then
            wasm_backend="$(flow_cpu_backend)"
        fi
        if [ -z "${1:-}" ] || [ "${1:-}" = "--help" ]; then
            print_error "Usage: flow wasm <program.flow> [--out DIR] [--legacy]"
            print_info "                 [--backend=c|mlir] [--link PATH] [--preload DIR@/MOUNT]"
            print_info "                 [--threads [--workers N]] [--fs memfs|idbfs]"
            print_info "Writes .wasm + .js + a runnable index.html."
            print_info "gfx programs get a canvas page; others print into the page."
            print_info "Requires emcc (Emscripten). See docs/language/wasm.md"
            print_info "Whole gallery: scripts/build_wasm_gallery.sh"
            exit 1
        fi
        if [ "${1:-}" = "--legacy" ]; then
            shift
            require_flow_file "${1:-}"
            python3 "$SCRIPT_DIR/wasm/flow_to_wasm.py" "$@"
            exit $?
        fi
        require_flow_file "${1:-}"
        if ! command -v emcc >/dev/null 2>&1; then
            print_error "emcc not on PATH: install emsdk to emit .wasm"
            print_info "  docs: docs/language/wasm.md"
            exit 1
        fi
        if [ -n "$wasm_fs" ]; then
            if [ "$wasm_backend" = "mlir" ]; then
                print_error "--fs currently requires --backend=c (MEMFS/IDBFS crossings are C-only)"
                print_info "  For MLIR, use --preload HOST@/mount without --fs (FORCE_FILESYSTEM)"
                exit 1
            fi
            print_info "Flow → C → WASM with a $wasm_fs filesystem (see docs/language/wasm-crossings.md)"
            if ! "$SCRIPT_DIR/wasm/crossings.sh" fs "$1" --fs "$wasm_fs" \
                    ${wasm_preload[@]+"${wasm_preload[@]}"}; then
                print_error "Filesystem WASM build failed"
                exit 1
            fi
            exit 0
        fi
        if [ "$wasm_threads" -eq 1 ]; then
            if [ "$wasm_backend" = "mlir" ]; then
                print_error "--threads currently requires --backend=c"
                exit 1
            fi
            print_info "Flow → C → threaded WASM (see docs/language/wasm-crossings.md)"
            if ! "$SCRIPT_DIR/wasm/crossings.sh" threads "$1" --workers "$wasm_workers"; then
                print_error "Threaded WASM build failed"
                exit 1
            fi
            exit 0
        fi
        if [ "$wasm_backend" = "mlir" ]; then
            print_info "Flow → MLIR → LLVM → WASM (see docs/language/wasm.md)"
        else
            print_info "Flow → C → WASM (see docs/language/wasm.md)"
        fi
        if ! "$SCRIPT_DIR/scripts/wasm_build.sh" "$@" \
                ${wasm_preload[@]+"${wasm_preload[@]}"} \
                ${wasm_link[@]+"${wasm_link[@]}"}; then
            print_error "WASM build failed"
            exit 1
        fi
        ;;
    "playground")
