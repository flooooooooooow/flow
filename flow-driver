#!/bin/bash
# FLOW Programming Language Runner
# The main entry point for running FLOW programs

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Build root for compilation artifacts. Defaults to the repo-global build dir.
# `flow run` overrides this with a per-invocation directory so concurrent runs
# of two projects that share a source basename (e.g. src/main.flow) cannot
# clobber each other's executable or generated runtime C (#817).
: "${FLOW_BUILD_ROOT:=$SCRIPT_DIR/build}"
FLOWC_MODULE="flow.transpiler"
export PYTHONPATH="$SCRIPT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
LLVM_PATH="${LLVM_PATH:-}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Print colored output
print_info() {
    echo -e "${BLUE}ℹ️  $1${NC}"
}

print_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

print_error() {
    echo -e "${RED}❌ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

resolve_llvm_path() {
    if [ -n "$LLVM_PATH" ]; then
        return
    fi
    if command -v mlir-opt &> /dev/null; then
        LLVM_PATH="$(dirname "$(command -v mlir-opt)")"
        return
    fi
    if command -v brew &> /dev/null; then
        local brew_prefix
        brew_prefix="$(brew --prefix llvm 2>/dev/null || true)"
        if [ -n "$brew_prefix" ]; then
            LLVM_PATH="$brew_prefix/bin"
            return
        fi
    fi
    LLVM_PATH="/opt/homebrew/opt/llvm/bin"
}

# ---------------------------------------------------------------------------
# Compiler host. flowc (compiler/src, built from the checked-in bootstrap C)
# is the only C compiler. The Python C backend is retired: FLOW_HOST=python
# stops with a pointer to flowc. FLOW_HOST=auto is accepted as flowc.
# ---------------------------------------------------------------------------
flow_host_mode() {
    local mode="${FLOW_HOST:-flowc}"
    case "$mode" in
        flowc|auto) printf 'flowc\n' ;;
        python)
            print_error "FLOW_HOST=python is retired: the Python C backend was removed." >&2
            print_info "flowc compiles every program now. Unset FLOW_HOST (or set FLOW_HOST=flowc)." >&2
            print_info "C only: compiler/scripts/flowc_emit.sh <in.flow> <out.c>" >&2
            exit 1
            ;;
        *)
            print_error "Unknown FLOW_HOST='$mode' (expected flowc)" >&2
            exit 1
            ;;
    esac
}

# CPU backend selection (dual C / MLIR). Default remains C.
#   FLOW_CPU_BACKEND=c|mlir
#   ./flow run --backend=mlir <prog>
flow_cpu_backend() {
    local mode="${FLOW_CPU_BACKEND:-c}"
    case "$mode" in
        c|mlir) printf '%s\n' "$mode" ;;
        *)
            print_error "Unknown FLOW_CPU_BACKEND='$mode' (expected c|mlir)"
            exit 1
            ;;
    esac
}

# GPU memory objects + frameworks for native links (C and MLIR paths).
# Sets FLOW_GPU_SOURCES and FLOW_GPU_LDFLAGS (bash arrays).
flow_gpu_link_flags() {
    FLOW_GPU_SOURCES=()
    FLOW_GPU_LDFLAGS=()
    if [[ "$(uname -s)" == "Darwin" ]]; then
        FLOW_GPU_SOURCES+=("$SCRIPT_DIR/runtime/gpu_metal.m")
        FLOW_GPU_LDFLAGS+=("-framework" "Metal" "-framework" "Foundation")
    fi
}

flow_resolve_flowc() {
    local driver=""
    if [[ -n "${FLOWC_BIN:-}" && -x "${FLOWC_BIN}" ]]; then
        driver="$FLOWC_BIN"
    else
        driver="$(bash "$SCRIPT_DIR/compiler/scripts/ensure_flowc.sh")" || true
        # ensure_flowc prints a path relative to the repository root.
        if [[ -n "$driver" && "$driver" != /* ]]; then
            driver="$SCRIPT_DIR/$driver"
        fi
    fi
    if [[ -z "$driver" || ! -x "$driver" ]]; then
        print_error "No Stage-A flowc driver (set FLOWC_BIN or run compiler/scripts/bootstrap_from_c.sh)"
        return 1
    fi
    printf '%s\n' "$driver"
}

# Build a Flow tool with the Stage-A flowc driver and print the binary's path.
#   flow_build_flow_tool NAME ENTRY [SOURCE...]
# The binary lands in build/tools/NAME/NAME. It is rebuilt when the entry, any
# listed source or the driver is newer, and written under a temporary name so
# concurrent runs never execute a half-written binary. Entries with sibling
# imports are bundled from the repository root.
# The compiler is the one built from the checked-in bootstrap C (or FLOWC_BIN):
# `flow run` is part of the Python roundtrip that ensure_flowc may start, so a
# tool build must never start one itself.
flow_build_flow_tool() {
    local name="$1"
    local src="$SCRIPT_DIR/$2"
    shift 2
    local dir="$SCRIPT_DIR/build/tools/$name"
    local bin="$dir/$name"
    local driver
    if [[ -n "${FLOWC_BIN:-}" && -x "${FLOWC_BIN}" ]]; then
        driver="$FLOWC_BIN"
    else
        driver="$(bash "$SCRIPT_DIR/compiler/scripts/ensure_flowc.sh" --cc-only 2>/dev/null)" || return 1
        [[ "$driver" == /* ]] || driver="$SCRIPT_DIR/$driver"
    fi
    local stale=0
    if [[ ! -x "$bin" || "$src" -nt "$bin" || "$driver" -nt "$bin" ]]; then
        stale=1
    fi
    local dep
    for dep in "$@"; do
        if [[ "$SCRIPT_DIR/$dep" -nt "$bin" ]]; then
            stale=1
        fi
    done
    if [[ "$stale" = 0 ]]; then
        printf '%s\n' "$bin"
        return 0
    fi
    mkdir -p "$dir"
    local tmp="$dir/$name.tmp.$$"
    if ! (cd "$SCRIPT_DIR" && FLOWC_BUNDLE=1 FLOWC_DIR="$SCRIPT_DIR" FLOWC_TYPECHECK=1 \
            FLOWC_IN="$src" FLOWC_OUT="$tmp.c" "$driver") >/dev/null 2>&1 \
        || ! "${CC:-cc}" -std=c11 -D_DEFAULT_SOURCE -O2 -o "$tmp" "$tmp.c" >/dev/null 2>&1; then
        rm -f "$tmp" "$tmp.c"
        return 1
    fi
    rm -f "$tmp.c"
    mv -f "$tmp" "$bin"
    printf '%s\n' "$bin"
}

# The dependency-sync check (scripts/tools/pkg_sync), a Flow program.
flow_pkg_sync_tool() {
    flow_build_flow_tool pkg_sync scripts/tools/pkg_sync/main.flow
}

# The package manager (compiler/src/pkg_main.flow), a Flow program.
flow_pkg_tool() {
    flow_build_flow_tool flow_pkg compiler/src/pkg_main.flow \
        compiler/src/pkg.flow compiler/src/pkg_json.flow \
        compiler/src/semver.flow compiler/src/fileio.flow
}

# Run the Flow package manager: add, install, sync, search, info, init,
# publish, build, build-native, run, run-native, clean.
flow_pkg_native() {
    local tool
    if ! tool="$(flow_pkg_tool)"; then
        print_error "Could not build the package manager (compiler/src/pkg_main.flow)."
        return 1
    fi
    FLOW_REPO_ROOT="$SCRIPT_DIR" "$tool" "$@"
}

# Install the dependencies of the project containing a program, if it needs
# any. The small Flow check answers the common cases (no flow.toml, no
# dependencies, everything already installed and locked) without building the
# package manager. A project that must fetch something goes to the package
# manager, which installs what is missing and writes flow.lock.
flow_sync_program() {
    local program="$1"
    local abs_program
    abs_program="$(cd "$(dirname "$program")" && pwd -P)/$(basename "$program")"
    local tool rc=0
    if tool="$(flow_pkg_sync_tool)"; then
        "$tool" "$abs_program" || rc=$?
        case "$rc" in
            0) return 0 ;;
            3) ;;
            *) return "$rc" ;;
        esac
    fi
    flow_pkg_native sync --program "$abs_program"
}

# A main.flow flowc for the FLOWC_* modes the driver.flow binaries lack
# (FLOWC_SHADER): FLOWC_BIN, else the checked-in bootstrap C built with cc.
flow_flowc_main() {
    if [[ -n "${FLOWC_BIN:-}" && -x "${FLOWC_BIN}" ]]; then
        printf '%s\n' "$FLOWC_BIN"
        return 0
    fi
    local boot_c="$SCRIPT_DIR/compiler/bootstrap/flowc_stage_a.c"
    local bin="$SCRIPT_DIR/compiler/build/flowc_bootstrap"
    if [[ ! -x "$bin" || "$boot_c" -nt "$bin" ]]; then
        mkdir -p "$SCRIPT_DIR/compiler/build"
        if ! "${CC:-cc}" -O2 -o "$bin" "$boot_c" -lm 2>/dev/null; then
            print_error "Cannot build flowc from $boot_c"
            return 1
        fi
    fi
    printf '%s\n' "$bin"
}

flowc_emit_to_c() {
    local program="$1"
    local c_out="$2"
    local driver
    if ! driver="$(flow_resolve_flowc)"; then
        return 1
    fi
    print_info "flowc emit via $driver"
    # compiler/scripts/flowc_emit.sh bundles a program that imports modules,
    # or uses the Field or dynamics DSL, into one C unit from the repository
    # root; FLOWC_LENIENT / FLOWC_CHECKS default on, as for `flow compile`.
    FLOWC_BIN="$driver" "$SCRIPT_DIR/compiler/scripts/flowc_emit.sh" "$program" "$c_out"
}

# Emit one lib/runtime/*.flow module as its own C unit, the way
# flowc_runtime_archive builds the runtime objects: a library unit
# (FLOWC_LIBRARY=1, the old `--c --library --lenient`, #1030).
flowc_emit_runtime_module() {
    local module="$1"
    local c_out="$2"
    local driver
    driver="$(flow_resolve_flowc)" || return 1
    env -u FLOWC_BUNDLE -u FLOWC_EXPORT FLOWC_LIBRARY=1 FLOWC_LENIENT=1 \
        FLOWC_IN="$module" FLOWC_OUT="$c_out" "$driver"
}

# Host tools written in Flow (tools/<name>/main.flow: repl, lsp). Builds the
# tool with the Stage-A driver on first use and whenever a Flow source it can
# import is newer than the cached binary, then prints the binary path.
# The cache lives in build/tools, or in the user cache dir when the install
# tree is read-only (Homebrew).
flow_native_tool() {
    local name="$1"
    local src="tools/$name/main.flow"
    if [ ! -f "$SCRIPT_DIR/$src" ]; then
        print_error "native tool source missing: $src"
        return 1
    fi
    local cache="$SCRIPT_DIR/build/tools"
    if ! mkdir -p "$cache" 2>/dev/null || [ ! -w "$cache" ]; then
        cache="${XDG_CACHE_HOME:-$HOME/.cache}/flow/tools"
        mkdir -p "$cache" || return 1
    fi
    local bin="$cache/flow-$name"
    if [ -x "$bin" ] && [ -z "$(find "$SCRIPT_DIR/tools/$name" "$SCRIPT_DIR/tools/hostlib" "$SCRIPT_DIR/tools/lsp" "$SCRIPT_DIR/tools/fir" "$SCRIPT_DIR/scripts/tools/lib" \
            "$SCRIPT_DIR/compiler/src" -name '*.flow' -newer "$bin" -print -quit 2>/dev/null)" ]; then
        printf '%s\n' "$bin"
        return 0
    fi
    local driver
    if ! driver="$(flow_resolve_flowc)"; then
        return 1
    fi
    if ! (cd "$SCRIPT_DIR" && FLOWC_BUNDLE=1 FLOWC_DIR=. FLOWC_TYPECHECK=1 \
            FLOWC_IN="$src" FLOWC_OUT="$bin.c" "$driver" >&2); then
        print_error "flowc could not build $src" >&2
        return 1
    fi
    if ! "${CC:-cc}" -O2 -w -o "$bin.tmp.$$" "$bin.c" -lm >&2; then
        print_error "C compiler could not build flow-$name" >&2
        return 1
    fi
    mv -f "$bin.tmp.$$" "$bin"
    printf '%s\n' "$bin"
}

# Canonical version string (src/flow/version.py holds the single source).
flow_canonical_version() {
    sed -n 's/^__version__ = "\(.*\)"$/\1/p' "$SCRIPT_DIR/src/flow/version.py" 2>/dev/null
}

# ---------------------------------------------------------------------------
# MISRA Phase 0 (#269 / #270): C compiler flags + sanitizers
#   Default: -std=c11 -Wall -Wextra
#   FLOW_PROFILE=safety|flight → also -pedantic -Werror
#   FLOW_UBSAN=1 / FLOW_ASAN=1 / FLOW_TSAN=1 or FLOW_SANITIZE=ub,asan,tsan
#   CLI: --sanitize=ub,asan,tsan  --profile=safety  compile --show-flags
# ---------------------------------------------------------------------------
flow_profile_mode() {
    printf '%s\n' "${FLOW_PROFILE:-}"
}

flow_clang_warning_flags() {
    # Populate FLOW_CLANG_WARN_FLAGS (bash array).
    # -std=c11 with _DEFAULT_SOURCE: C11 dialect + POSIX/BSD decls the
    # runtime needs (usleep, posix_memalign). Bare -std=c11 hides them;
    # _POSIX_C_SOURCE=200809L also hides usleep on glibc.
    # -Wno-unused-{function,variable,parameter}: generated preamble stubs,
    # Flow `let _ = …` discard pattern, and stub ABI params: keeps -Werror
    # usable under --profile safety (#269).
    FLOW_CLANG_WARN_FLAGS=(
        "-std=c11"
        "-D_DEFAULT_SOURCE"
        "-Wall"
        "-Wextra"
        "-Wno-unused-function"
        "-Wno-unused-variable"
        "-Wno-unused-parameter"
        # C11 makes these constraint violations (errors) by default. The
        # codegen still has sites that call unmangled DSL-lowered names or
        # rely on implicit int conversions. Downgrade to warnings so the
        # default profile stays green until the codegen is fixed (#273).
        "-Wno-error=implicit-function-declaration"
        "-Wno-error=int-conversion"
    )
    case "$(flow_profile_mode)" in
        safety|flight)
            # -Werror is the MISRA ask (#269). Suppressions cover known
            # runtime/codegen noise until follow-ups land:
            #   strict-prototypes: hand-written runtime/*.c
            #   c23-extensions   : Flow emits `T x = { };` empty inits
            #   format           : int64_t vs long long on LP64
            # Full -pedantic without these Waivers is tracked with #273.
            # #283: promote implicit-function-declaration to hard error
            # under safety (override the default-profile downgrade above).
            FLOW_CLANG_WARN_FLAGS+=(
                "-Werror"
                "-Werror=implicit-function-declaration"
                "-Wno-strict-prototypes"
                "-Wno-c23-extensions"
                "-Wno-format"
            )
            ;;
    esac
}

flow_apply_sanitize_to_arrays() {
    # Append sanitizer flags to the named cflags/ldflags arrays.
    # Usage: flow_apply_sanitize_to_arrays cflags_var ldflags_var
    local _cflags_var=$1
    local _ldflags_var=$2
    local sanitize="${FLOW_SANITIZE:-}"
    local item
    local -a parts=()

    if [ -n "$sanitize" ]; then
        IFS=',' read -ra parts <<< "$sanitize"
        for item in "${parts[@]}"; do
            case "$item" in
                ub|undefined|ubsan) FLOW_UBSAN=1 ;;
                asan|address) FLOW_ASAN=1 ;;
                tsan|thread) FLOW_TSAN=1 ;;
                "" ) ;;
                *)
                    print_error "Unknown sanitizer '$item' (expected ub,asan,tsan)"
                    exit 1
                    ;;
            esac
        done
    fi

    if [ "${FLOW_UBSAN:-}" = "1" ]; then
        eval "${_cflags_var}+=(\"-fsanitize=undefined\" \"-fno-sanitize-recover=all\" \"-g\" \"-fno-omit-frame-pointer\")"
        eval "${_ldflags_var}+=(\"-fsanitize=undefined\")"
    fi
    if [ "${FLOW_ASAN:-}" = "1" ]; then
        eval "${_cflags_var}+=(\"-fsanitize=address\" \"-g\" \"-fno-omit-frame-pointer\")"
        eval "${_ldflags_var}+=(\"-fsanitize=address\")"
    fi
    if [ "${FLOW_TSAN:-}" = "1" ]; then
        eval "${_cflags_var}+=(\"-fsanitize=thread\" \"-g\" \"-fno-omit-frame-pointer\")"
        eval "${_ldflags_var}+=(\"-fsanitize=thread\")"
    fi
}

flow_collect_cflags() {
    # Build FLOW_COLLECTED_CFLAGS / FLOW_COLLECTED_LDFLAGS from env + profile.
    # Optional extra FLOW_CFLAGS tokens are appended last (user override).
    flow_clang_warning_flags
    FLOW_COLLECTED_CFLAGS=("${FLOW_CLANG_WARN_FLAGS[@]}")
    FLOW_COLLECTED_LDFLAGS=()
    flow_apply_sanitize_to_arrays FLOW_COLLECTED_CFLAGS FLOW_COLLECTED_LDFLAGS
    if [ -n "${FLOW_CFLAGS:-}" ]; then
        # shellcheck disable=SC2206
        local -a _extra=(${FLOW_CFLAGS})
        FLOW_COLLECTED_CFLAGS+=("${_extra[@]}")
    fi
    if [ -n "${FLOW_LDFLAGS:-}" ]; then
        # shellcheck disable=SC2206
        local -a _ld=(${FLOW_LDFLAGS})
        FLOW_COLLECTED_LDFLAGS+=("${_ld[@]}")
    fi
}

flow_show_clang_flags() {
    flow_collect_cflags
    echo "Flow C compile flags (MISRA Phase 0):"
    echo "  cflags:  ${FLOW_COLLECTED_CFLAGS[*]}"
    if [ ${#FLOW_COLLECTED_LDFLAGS[@]} -gt 0 ]; then
        echo "  ldflags: ${FLOW_COLLECTED_LDFLAGS[*]}"
    else
        echo "  ldflags: (none beyond defaults)"
    fi
    echo "  profile: ${FLOW_PROFILE:-default}"
    echo "  opt:     -O${FLOW_OPT_LEVEL:-2} (override with FLOW_OPT_LEVEL=0|1|2|3|s)"
    echo "  sanitize: UBSAN=${FLOW_UBSAN:-0} ASAN=${FLOW_ASAN:-0} TSAN=${FLOW_TSAN:-0} FLOW_SANITIZE=${FLOW_SANITIZE:-}"
}

# The runtime every program links on the Python host: runtime/*.c
# (concurrency, fibers, TLS, the dlopen Python bridge, Metal on Darwin) and
# the always-linked lib/runtime/*.flow modules, the latter emitted by flowc
# instead of Python. Built once per state of those sources, the flowc binary
# and the flags into build/flowc_runtime/<key>/libflowrt.a, so a program
# pulls in only the objects it uses. Sets FLOWC_RT_ARCHIVE; also leaves the
# FLOW_CONC_* and FLOW_GPU_* arrays set for the final link.
flowc_runtime_archive() {
    local driver="$1"
    local cc_bin="$2"
    flow_concurrency_flags
    flow_gpu_link_flags
    local -a c_srcs=("$SCRIPT_DIR/runtime/flow_python_embed.c" "${FLOW_CONC_SOURCES[@]}")
    if [ "${#FLOW_GPU_SOURCES[@]}" -gt 0 ]; then
        c_srcs+=("${FLOW_GPU_SOURCES[@]}")
    fi
    local -a flow_srcs=()
    local f base
    for f in "$SCRIPT_DIR"/lib/runtime/*.flow; do
        [ -f "$f" ] || continue
        base=$(basename "$f" .flow)
        # The same selection as flow_runtime_flow_sources.
        if [ "$base" = "gpu_memory_stub" ] && [ "$(uname -s)" = "Darwin" ]; then continue; fi
        if [ "$base" = "shader_host" ] || [ "$base" = "gfx_record" ]; then continue; fi
        if [ "$base" = "audio_device_stub" ] && [ "${FLOW_SKIP_AUDIO_STUB:-}" = "1" ]; then continue; fi
        flow_srcs+=("$f")
    done
    local key
    key="$( { printf '%s\n' library "$cc_bin" "${FLOW_COLLECTED_CFLAGS[@]}" "${FLOW_CONC_CFLAGS[@]}" "${c_srcs[@]}" "${flow_srcs[@]}"; \
        cat "${c_srcs[@]}" "${flow_srcs[@]}" "$driver"; } | cksum | awk '{print $1 "-" $2}')"
    local root="$SCRIPT_DIR/build/flowc_runtime"
    local dir="$root/$key"
    FLOWC_RT_ARCHIVE="$dir/libflowrt.a"
    if [ -f "$FLOWC_RT_ARCHIVE" ]; then
        return 0
    fi
    mkdir -p "$root"
    local tmp
    tmp="$(mktemp -d "$root/tmp.XXXXXX")" || return 1
    local -a objs=()
    for f in "${flow_srcs[@]}"; do
        base=$(basename "$f" .flow)
        # Library units (#1030): no runtime checks, plain external names.
        if ! env -u FLOWC_BUNDLE -u FLOWC_EXPORT FLOWC_LIBRARY=1 FLOWC_LENIENT=1 \
            FLOWC_IN="$f" FLOWC_OUT="$tmp/rt_$base.c" "$driver" > "$tmp/rt_$base.log" 2>&1; then
            print_error "flowc could not build runtime module $base.flow"
            cat "$tmp/rt_$base.log" >&2
            rm -rf "$tmp"
            return 1
        fi
        if ! "$cc_bin" "${FLOW_COLLECTED_CFLAGS[@]}" -w -O2 "${FLOW_CONC_CFLAGS[@]}" -I"$SCRIPT_DIR/runtime" \
            -c -o "$tmp/rt_$base.o" "$tmp/rt_$base.c"; then
            print_error "C compilation failed for runtime module $base.flow (flowc host)"
            rm -rf "$tmp"
            return 1
        fi
        objs+=("$tmp/rt_$base.o")
    done
    for f in "${c_srcs[@]}"; do
        base=$(basename "$f")
        base="${base%.*}"
        if ! "$cc_bin" "${FLOW_COLLECTED_CFLAGS[@]}" -w -O2 "${FLOW_CONC_CFLAGS[@]}" -I"$SCRIPT_DIR/runtime" \
            -c -o "$tmp/c_$base.o" "$f"; then
            print_error "C compilation failed for runtime source $f (flowc host)"
            rm -rf "$tmp"
            return 1
        fi
        objs+=("$tmp/c_$base.o")
    done
    rm -f "$tmp/libflowrt.a"
    if ! ar rcs "$tmp/libflowrt.a" "${objs[@]}"; then
        rm -rf "$tmp"
        return 1
    fi
    # Publish atomically; a concurrent build of the same key may have won.
    if ! mv "$tmp" "$dir" 2>/dev/null; then
        rm -rf "$tmp"
    fi
    [ -f "$FLOWC_RT_ARCHIVE" ]
}

flowc_link_c() {
    local c_file="$1"
    local exe_file="$2"
    local program="${3:-}"
    flow_collect_cflags
    local cc_bin=cc
    if command -v clang > /dev/null 2>&1; then
        cc_bin=clang
    fi
    local -a inc=()
    if [ -n "$program" ]; then
        inc+=("-I$(dirname "$program")")
    fi
    # FLOWC_NO_RUNTIME=1 links the program alone, as before the runtime
    # archive existed.
    if [ "${FLOWC_NO_RUNTIME:-}" = "1" ]; then
        # Show compiler diagnostics on failure (#252 / #269).
        if ! "$cc_bin" "${FLOW_COLLECTED_CFLAGS[@]}" "-O${FLOW_OPT_LEVEL:-2}" \
            "${inc[@]+"${inc[@]}"}" \
            "${FLOW_COLLECTED_LDFLAGS[@]+"${FLOW_COLLECTED_LDFLAGS[@]}"}" \
            -o "$exe_file" "$c_file" -lm; then
            print_error "C compilation/linking failed (flowc host)"
            return 1
        fi
        return 0
    fi
    local driver
    driver="$(flow_resolve_flowc)" || return 1
    if ! flowc_runtime_archive "$driver" "$cc_bin"; then
        print_error "C compilation/linking failed (flowc host): no runtime archive"
        return 1
    fi
    if ! "$cc_bin" "${FLOW_COLLECTED_CFLAGS[@]}" "-O${FLOW_OPT_LEVEL:-2}" \
        "${FLOW_CONC_CFLAGS[@]}" -I"$SCRIPT_DIR/runtime" "${inc[@]+"${inc[@]}"}" \
        -o "$exe_file" "$c_file" "$FLOWC_RT_ARCHIVE" \
        "${FLOW_GPU_LDFLAGS[@]+"${FLOW_GPU_LDFLAGS[@]}"}" "${FLOW_CONC_LDFLAGS[@]}" \
        "${FLOW_COLLECTED_LDFLAGS[@]+"${FLOW_COLLECTED_LDFLAGS[@]}"}" -lm; then
        print_error "C compilation/linking failed (flowc host)"
        return 1
    fi
    return 0
}

compile_program_flowc() {
    local program="$1"
    require_flow_file "$program"
    local basename
    basename=$(basename "$program" .flow)
    local build_dir="$FLOW_BUILD_ROOT"
    mkdir -p "$build_dir"
    print_info "Compiling $program (host=flowc)..."
    if ! flowc_emit_to_c "$program" "$build_dir/$basename.c"; then
        print_error "flowc could not compile $program"
        return 1
    fi
    print_success "FLOW → C: $basename.c"
    if ! flowc_link_c "$build_dir/$basename.c" "$build_dir/$basename" "$program"; then
        return 1
    fi
    print_success "C → Executable: $basename"
    print_success "🚀 Ready to run: $build_dir/$basename"
    return 0
}

# ---------------------------------------------------------------------------
# Proof tooling on flowc: flow doc proof|bundle|basic-bundle|geometry-bundle|
# kernel and flow know (compiler/src/proof_doc.flow). No Python.
# ---------------------------------------------------------------------------

# flow_proof_flowc VAR=VALUE...: run the flowc proof tools with these
# environment settings, rooted at the repository.
flow_proof_flowc() {
    local driver
    driver="$(flow_resolve_flowc)" || return 1
    env FLOWC_PROOF_DOC=1 FLOWC_PROOF_ROOT="$SCRIPT_DIR" "$@" "$driver"
}

# The .flow files under a directory in pathlib's sorted(rglob) order.
flow_proof_list_dir() {
    local dir="$1" recursive="$2"
    if [ "$recursive" = "1" ]; then
        find "$dir" -name '*.flow' -type f
    else
        find "$dir" -maxdepth 1 -name '*.flow' -type f
    fi | tr '/' '\001' | LC_ALL=C sort | tr '\001' '/'
}

flow_doc_proof() {
    local path="" recursive=0 out=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -r|--recursive) recursive=1 ;;
            -o|--output-dir) shift; out="${1:-}" ;;
            --output-dir=*) out="${1#--output-dir=}" ;;
            *) path="$1" ;;
        esac
        shift
    done
    if [ -z "$path" ]; then
        print_error "Usage: flow doc proof <file.flow|directory> [-r] [-o DIR]"
        return 1
    fi
    if [ ! -e "$path" ]; then
        echo "Error: path not found: $path" >&2
        return 1
    fi
    if [ -f "$path" ]; then
        flow_proof_flowc FLOWC_IN="$path" FLOWC_PROOF_OUT="$out"
        return $?
    fi
    while [ "${#path}" -gt 1 ] && [ "${path%/}" != "$path" ]; do
        path="${path%/}"
    done
    local list rc
    list="$(mktemp)"
    flow_proof_list_dir "$path" "$recursive" > "$list"
    flow_proof_flowc FLOWC_PROOF_LIST="$list" FLOWC_PROOF_TREE=1
    rc=$?
    rm -f "$list"
    return $rc
}

# A LaTeX engine by name, on PATH or in /Library/TeX/texbin.
flow_latex_engine() {
    local name="$1"
    if command -v "$name" >/dev/null 2>&1; then
        command -v "$name"
        return 0
    fi
    if [ -x "/Library/TeX/texbin/$name" ]; then
        echo "/Library/TeX/texbin/$name"
        return 0
    fi
    return 1
}

# flow doc bundle|basic-bundle|geometry-bundle [-o DIR]
flow_doc_bundle() {
    local which="$1"
    shift
    local out="$SCRIPT_DIR/build/proofs"
    while [ $# -gt 0 ]; do
        case "$1" in
            -o|--output-dir) shift; out="${1:-}" ;;
            --output-dir=*) out="${1#--output-dir=}" ;;
        esac
        shift
    done
    local stem
    case "$which" in
        book) stem="flow-proof-book" ;;
        basic) stem="basic-proofs-side-by-side" ;;
        geometry) stem="geometry-proofs-side-by-side" ;;
    esac
    flow_proof_flowc FLOWC_PROOF_BOOK="$which" FLOWC_PROOF_OUT="$out" || return 1
    # Try each engine in turn, as the Python tool did.
    local name engine abs
    abs="$(cd "$out" && pwd)"
    rm -f "$out/$stem.pdf"
    for name in pdflatex xelatex tectonic; do
        engine="$(flow_latex_engine "$name")" || continue
        if [ "$name" = "tectonic" ]; then
            (cd "$abs" && "$engine" --outdir "$abs" "$abs/$stem.tex") >/dev/null 2>&1
        else
            (cd "$abs" && "$engine" -interaction=nonstopmode "$stem.tex"; \
                "$engine" -interaction=nonstopmode "$stem.tex") >/dev/null 2>&1
        fi
        if [ -f "$out/$stem.pdf" ]; then
            echo "Wrote $out/$stem.pdf"
            return 0
        fi
    done
    echo "Could not compile PDF. Install pdflatex, xelatex, or tectonic." >&2
    return 1
}

# flow doc kernel <file.flow> [-p NAME=VALUE]... [--plot FILE] [-o FILE]
flow_doc_kernel() {
    local path="" out="" plot="" params=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -p|--param) shift; params="$params${1:-}"$'\n' ;;
            --param=*) params="$params${1#--param=}"$'\n' ;;
            --plot) shift; plot="${1:-}" ;;
            --plot=*) plot="${1#--plot=}" ;;
            -o|--output) shift; out="${1:-}" ;;
            --output=*) out="${1#--output=}" ;;
            *) path="$1" ;;
        esac
        shift
    done
    if [ -z "$path" ]; then
        print_error "Usage: flow doc kernel <file.flow> [--param n=0] [--plot out.dot]"
        return 1
    fi
    flow_proof_flowc FLOWC_PROOF_KERNEL=1 FLOWC_IN="$path" FLOWC_KERNEL_OUT="$out" \
        FLOWC_KERNEL_PARAMS="$params" FLOWC_KERNEL_PLOT="$plot" || return 1
    # The plot is Graphviz DOT; render the requested image when dot exists.
    case "$plot" in
        *.png|*.pdf|*.svg)
            if command -v dot >/dev/null 2>&1; then
                dot "-T${plot##*.}" -o "$plot" "${plot%.*}.dot" && echo "Wrote $plot"
            fi
            ;;
    esac
}

# flow know <claim> | flow know --lint-duplicates
flow_know() {
    local query="" lint=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --lint-duplicates) lint=1 ;;
            -h|--help) query="" ; lint=2 ;;
            *) query="$1" ;;
        esac
        shift
    done
    if [ "$lint" = "1" ]; then
        flow_proof_flowc FLOWC_KNOW_LINT=1
        return $?
    fi
    if [ -z "$query" ]; then
        echo "usage: flow know [-h] [--lint-duplicates] [path]"
        echo ""
        echo "Look up a Flow Claim Path, e.g. Nat/+.zero-right or verify.Nat/+.zero-right"
        return 1
    fi
    flow_proof_flowc FLOWC_KNOW="$query"
}

require_flow_file() {
    local program="${1:-}"
    if [ -z "$program" ]; then
        print_error "Usage: flow <command> <program.flow>"
        exit 1
    fi
    if [[ "$program" != *.flow ]]; then
        print_error "Expected a .flow file, got: $program"
        exit 1
    fi
    if [ ! -f "$program" ]; then
        print_error "Program not found: $program"
        exit 1
    fi
}

