                    OBJ_FILE="$BUILD_DIR/${PROGRAM_NAME}_mlir.o"
                    EXE_FILE="$BUILD_DIR/${PROGRAM_NAME}_mlir"
                    if ! mlir_lower_and_link "$MLIR_FILE" "$OBJ_FILE" "$EXE_FILE" 3; then
                        exit 1
                    fi
                    print_info "Running benchmark..."
                    /usr/bin/time -p "$EXE_FILE"
                else
                    run_flow_jit "$program"
                fi
                ;;
            test)
                check_deps
                print_info "Running ML tensor tests..."
                for t in "$SCRIPT_DIR/tests/stdlib/test_tensor.flow" \
                         "$SCRIPT_DIR/tests/stdlib/test_ml_autograd.flow" \
                         "$SCRIPT_DIR/tests/stdlib/test_matmul_backward.flow" \
                         "$SCRIPT_DIR/tests/stdlib/test_ml_nn.flow" \
                         "$SCRIPT_DIR/tests/stdlib/test_dense_backward.flow" \
                         "$SCRIPT_DIR/tests/stdlib/test_mlp2_backward.flow" \
                         "$SCRIPT_DIR/tests/stdlib/test_ml_opt.flow" \
                         "$SCRIPT_DIR/examples/ml/models/mlp_xor.flow" \
                         "$SCRIPT_DIR/examples/ml/models/mlp_xor_adam.flow"; do
                    if [ -f "$t" ]; then
                        print_info "  $t"
                        if ! flowc_emit_to_c "$t" "$SCRIPT_DIR/build/$(basename "$t" .flow).c" >/dev/null 2>"$SCRIPT_DIR/build/.flowc_err"; then
                            print_error "Failed: $t"
                            cat "$SCRIPT_DIR/build/.flowc_err" >&2
                            exit 1
                        fi
                        print_success "  ✓ $(basename "$t")"
                    fi
                done
                if command -v "$LLVM_PATH/mlir-opt" &>/dev/null || command -v mlir-opt &>/dev/null; then
                    check_mlir_deps
                    print_info "  MLIR JIT smoke: test_tensor"
                    run_flow_jit "$SCRIPT_DIR/tests/stdlib/test_tensor.flow"
                    print_info "  MLIR JIT smoke: test_ml_autograd"
                    run_flow_jit "$SCRIPT_DIR/tests/stdlib/test_ml_autograd.flow"
                    print_info "  MLIR JIT smoke: test_matmul_backward"
                    run_flow_jit "$SCRIPT_DIR/tests/stdlib/test_matmul_backward.flow"
                    print_info "  MLIR JIT smoke: test_dense_backward"
                    run_flow_jit "$SCRIPT_DIR/tests/stdlib/test_dense_backward.flow"
                    print_info "  MLIR JIT smoke: test_dense_create_only"
                    run_flow_jit "$SCRIPT_DIR/tests/stdlib/test_dense_create_only.flow"
                    print_info "  MLIR JIT smoke: test_backward_a_from_layer"
                    run_flow_jit "$SCRIPT_DIR/tests/stdlib/test_backward_a_from_layer.flow"
                    print_info "  MLIR JIT smoke: test_mlp2_backward"
                    run_flow_jit "$SCRIPT_DIR/tests/stdlib/test_mlp2_backward.flow"
                    print_info "  MLIR AOT smoke: mlir_tensor_bench"
                    generate_mlir "$SCRIPT_DIR/examples/ml/mlir_tensor_bench.flow" >/dev/null
                    BENCH_MLIR="$SCRIPT_DIR/build/mlir_tensor_bench.mlir"
                    BENCH_OBJ="$SCRIPT_DIR/build/mlir_tensor_bench_mlir.o"
                    BENCH_EXE="$SCRIPT_DIR/build/mlir_tensor_bench_mlir"
                    if ! mlir_lower_and_link "$BENCH_MLIR" "$BENCH_OBJ" "$BENCH_EXE" 3; then
                        exit 1
                    fi
                    print_info "  MLIR GPU smoke: gpu_kernels"
                    if ! python3 -m "$FLOWC_MODULE" "$SCRIPT_DIR/lib/stdlib/gpu_kernels.flow" \
                        --mlir --mlir-gpu -o "$SCRIPT_DIR/build/gpu_kernels.mlir" >/dev/null 2>&1; then
                        print_error "GPU MLIR generation failed"
                        exit 1
                    fi
                    print_info "  MLIR SPIR-V smoke: gpu_kernels (best-effort)"
                    if python3 -m "$FLOWC_MODULE" "$SCRIPT_DIR/lib/stdlib/gpu_kernels.flow" \
                        --mlir --mlir-gpu --emit-spirv -o "$SCRIPT_DIR/build/gpu_kernels.spv" >/dev/null 2>&1; then
                        print_success "  SPIR-V lowering ok"
                    else
                        print_warning "  SPIR-V lowering WIP (GPU MLIR codegen ok)"
                    fi
                else
                    print_warning "Skipping MLIR JIT (install llvm: brew install llvm)"
                fi
                print_success "ML tests passed"
                ;;
            *)
                print_error "Usage: flow ml [run|jit|bench|test] [program.flow]"
                exit 1
                ;;
        esac
        ;;
    "transpile")
        shift
        run_transpiler "$@"
        ;;
    "explain")
        shift
        program="${1:-}"
        require_flow_file "$program"
        shift
        # flowc's plan selector (compiler/src/sort_plans.flow) writes the
        # report to stderr under FLOWC_EXPLAIN=1; the C is a byproduct here.
        # Extra arguments are flowc_emit.sh flags (--strict, --no-checks).
        explain_flowc="$(flow_flowc_main)" || exit 1
        explain_dir="$(mktemp -d 2>/dev/null || mktemp -d -t flow_explain)"
        explain_rc=0
        FLOWC_BIN="$explain_flowc" FLOWC_EXPLAIN=1 FLOWC_EXPLAIN_SOURCE="$program" \
            "$SCRIPT_DIR/compiler/scripts/flowc_emit.sh" "$@" "$program" "$explain_dir/out.c" \
            2>"$explain_dir/report" >"$explain_dir/log" || explain_rc=$?
        cat "$explain_dir/report"
        if [[ "$explain_rc" -ne 0 ]]; then
            cat "$explain_dir/log" >&2
        fi
        rm -rf "$explain_dir"
        exit "$explain_rc"
        ;;
    "fmt")
        # flowc's formatter (compiler/src/fmt.flow). It only changes
        # whitespace; compiler/scripts/fmt_check.sh holds it to that.
        shift
        fmt_check=0
        if [ "${1:-}" = "--check" ]; then
            fmt_check=1
            shift
        fi
        if [ $# -eq 0 ]; then
            print_error "Usage: flow fmt [--check] <files...>"
            exit 1
        fi
        fmt_driver="$(flow_resolve_flowc)" || exit 1
        fmt_rc=0
        for fmt_file in "$@"; do
            if [ ! -f "$fmt_file" ]; then
                print_error "flow fmt: no such file: $fmt_file"
                fmt_rc=1
                continue
            fi
            fmt_tmp="$(mktemp "${TMPDIR:-/tmp}/flow_fmt.XXXXXX")"
            if ! FLOWC_BACKEND=fmt FLOWC_IN="$fmt_file" FLOWC_OUT="$fmt_tmp" "$fmt_driver" >&2; then
                print_error "flow fmt: $fmt_file does not parse; left unchanged"
                fmt_rc=1
            elif ! cmp -s "$fmt_file" "$fmt_tmp"; then
                if [ "$fmt_check" -eq 1 ]; then
                    echo "Would reformat $fmt_file"
                    fmt_rc=1
                else
                    # Rewrite in place so the file keeps its mode and links.
                    cat "$fmt_tmp" > "$fmt_file"
                fi
            fi
            rm -f "$fmt_tmp"
        done
        exit "$fmt_rc"
        ;;
    "test")
        shift
        run_tests "$@"
        ;;
    "test-strict")
        run_tests --strict
        ;;
    "test-runtime")
