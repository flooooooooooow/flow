# Run runtime tests (compile + execute programs and check exit codes/output)
run_runtime_tests() {
    print_info "Running FLOW runtime tests..."

    local runtime_dir="$SCRIPT_DIR/tests/runtime"
    local build_dir
    build_dir="$(mktemp -d 2>/dev/null || mktemp -d -t flow_runtime_test)"
    local verbose=0
    local targets=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --verbose|-v)
                verbose=1
                shift
                ;;
            *)
                targets+=("$1")
                shift
                ;;
        esac
    done
    mkdir -p "$build_dir"
    
    if [ ! -d "$runtime_dir" ]; then
        print_warning "No runtime tests directory found at $runtime_dir"
        print_info "Creating runtime tests directory..."
        mkdir -p "$runtime_dir"
        print_info "Add .flow files to tests/runtime/ to run runtime tests."
        return 0
    fi
    
    local total=0
    local passed=0
    local failed=0
    local failed_files=""
    
    # Bash 3.2 + set -u: empty "${arr[@]}" is an unbound-variable error.
    # Collect paths into a newline list, then iterate with while-read.
    local program_list_file
    program_list_file="$(mktemp 2>/dev/null || mktemp -t flow_rt_list)"
    if [ ${#targets[@]} -gt 0 ]; then
        for t in "${targets[@]}"; do
            if [ -f "$t" ]; then
                printf '%s\n' "$t" >> "$program_list_file"
            elif [ -d "$t" ]; then
                find "$t" -name "*.flow" ! -path "*/wip/*" 2>/dev/null >> "$program_list_file" || true
            fi
        done
    else
        find "$runtime_dir" -name "*.flow" ! -path "*/wip/*" 2>/dev/null >> "$program_list_file" || true
    fi

    if [ ! -s "$program_list_file" ]; then
        rm -f "$program_list_file"
        print_error "No runtime test programs found under $runtime_dir"
        exit 1
    fi

    while IFS= read -r program; do
        if [ -z "$program" ]; then continue; fi
        total=$((total + 1))
        local rel_path=${program#$SCRIPT_DIR/}
        local basename
        basename=$(basename "$program" .flow)
        local c_file="$build_dir/${basename}.c"
        local exe_file="$build_dir/${basename}"
        
        # Step 1: compile FLOW to C with flowc
        # || true / status vars: set -e must not abort before we record failures
        local transpile_output
        local transpile_status=0
        transpile_output=$(flowc_emit_to_c "$program" "$c_file" 2>&1) || transpile_status=$?
        if [ "$transpile_status" -ne 0 ] || [ ! -f "$c_file" ]; then
            print_error "✗ $rel_path (flowc failed)"
            if [ $verbose -eq 1 ] && [ -n "$transpile_output" ]; then
                echo "$transpile_output"
            fi
            failed=$((failed + 1))
            failed_files="$failed_files\n  - $rel_path (flowc)"
            continue
        fi

        # Step 2: Compile C to executable against the runtime archive
        local clang_output
        local clang_status=0
        clang_output=$(flowc_link_c "$c_file" "$exe_file" "$program" 2>&1) || clang_status=$?
        if [ "$clang_status" -ne 0 ]; then
            print_error "✗ $rel_path (clang compile failed)"
            if [ -n "$clang_output" ]; then
                if [ $verbose -eq 1 ]; then
                    echo "$clang_output"
                else
                    # Always show a short snippet so silent undefined-symbol
                    # failures are diagnosable without --verbose.
                    echo "$clang_output" | tail -n 12
                fi
            fi
            failed=$((failed + 1))
            failed_files="$failed_files\n  - $rel_path (clang)"
            continue
        fi

        # Step 3: Run the executable and check exit code
        local run_output
        local exit_code=0
        run_output=$("$exe_file" 2>&1) || exit_code=$?
        
        # Check for expected output file (optional)
        local expected_file="${program%.flow}.expected"
        if [ -f "$expected_file" ]; then
            local expected_output=$(cat "$expected_file")
            if [ "$run_output" != "$expected_output" ]; then
                print_error "✗ $rel_path (output mismatch)"
                failed=$((failed + 1))
                failed_files="$failed_files\n  - $rel_path (output)"
                continue
            fi
        fi
        
        # Exit code 0 = pass, non-zero = fail
        if [ $exit_code -eq 0 ]; then
            print_success "✓ $rel_path"
            if [ $verbose -eq 1 ] && [ -n "$run_output" ]; then
                echo "---- output: $rel_path ----"
                echo "$run_output"
                echo "---------------------------"
            fi
            passed=$((passed + 1))
        else
            print_error "✗ $rel_path (exit code $exit_code)"
            if [ $verbose -eq 1 ] && [ -n "$run_output" ]; then
                echo "---- output: $rel_path ----"
                echo "$run_output"
                echo "---------------------------"
            fi
            failed=$((failed + 1))
            failed_files="$failed_files\n  - $rel_path (exit=$exit_code)"
        fi
        
    done < "$program_list_file"
    
    # Cleanup
    rm -f "$program_list_file"
    rm -rf "$build_dir"
    
    echo "----------------------------------------"
    if [ $total -eq 0 ]; then
        print_warning "No runtime tests found in $runtime_dir"
        return 0
    fi
    
    if [ $failed -eq 0 ]; then
        print_success "All $total runtime tests passed!"
    else
        print_error "Runtime test failures: $failed/$total"
        if [ -n "$failed_files" ]; then
            echo -e "\nFailed files:$failed_files"
        fi
        exit 1
    fi
}

# Run Flow-native language tests (tests/lang/): strict transpile, clang
# compile, then execute. A test passes when it exits 0; a nonzero exit
# identifies the failing check inside the file. Mirrors run_runtime_tests
# but always transpiles with --strict (tests/lang/ is strict-only).
run_lang_tests() {
    print_info "Running FLOW language tests (tests/lang/, strict)..."

    local lang_dir="$SCRIPT_DIR/tests/lang"
    local build_dir
    build_dir="$(mktemp -d 2>/dev/null || mktemp -d -t flow_lang_test)"
    local verbose=0
    local targets=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --verbose|-v)
                verbose=1
                shift
                ;;
            *)
                targets+=("$1")
                shift
                ;;
        esac
    done
    mkdir -p "$build_dir"

    # flowc compiles the suite. Strict: FLOWC_LENIENT is left unset, so every
    # type error is fatal, as the Python host's --strict was.
    flow_host_mode >/dev/null
    local lang_flowc
    lang_flowc="$(flow_resolve_flowc)" || exit 1
    print_info "flowc: $lang_flowc"

    if [ ! -d "$lang_dir" ]; then
        print_error "No language tests directory found at $lang_dir"
        exit 1
    fi

    local total=0
    local passed=0
    local failed=0
    local failed_files=""

    # Bash 3.2 + set -u: empty "${arr[@]}" is an unbound-variable error.
    # Collect paths into a newline list, then iterate with while-read.
    local program_list_file
    program_list_file="$(mktemp 2>/dev/null || mktemp -t flow_lang_list)"
    if [ ${#targets[@]} -gt 0 ]; then
        for t in "${targets[@]}"; do
            if [ -f "$t" ]; then
                printf '%s\n' "$t" >> "$program_list_file"
            elif [ -d "$t" ]; then
                find "$t" -name "*.flow" ! -path "*/wip/*" 2>/dev/null >> "$program_list_file" || true
            fi
        done
    else
        find "$lang_dir" -name "*.flow" ! -path "*/wip/*" 2>/dev/null >> "$program_list_file" || true
    fi

    if [ ! -s "$program_list_file" ]; then
        rm -f "$program_list_file"
        print_error "No language test programs found under $lang_dir"
        exit 1
    fi

    while IFS= read -r program; do
        if [ -z "$program" ]; then continue; fi
        total=$((total + 1))
        local rel_path=${program#$SCRIPT_DIR/}
        local basename
        basename=$(basename "$program" .flow)
        local c_file="$build_dir/${basename}.c"
        local exe_file="$build_dir/${basename}"

        # Step 1: Transpile FLOW to C (strict; tests/lang/ must be strict-clean)
        # || true / status vars: set -e must not abort before we record failures
        local transpile_output
        local transpile_status=0
        # Bundle from the repository root, as flowc_emit_to_c does for
        # programs with imports; FLOWC_TYPECHECK is flowc's strict mode.
        local abs_lang_program
        abs_lang_program="$(cd "$(dirname "$program")" && pwd)/$(basename "$program")"
        transpile_output=$(cd "$SCRIPT_DIR" && env -u FLOWC_LENIENT FLOWC_BUNDLE=1 FLOWC_DIR="$SCRIPT_DIR" \
            FLOWC_TYPECHECK=1 FLOWC_CHECKS="${FLOWC_CHECKS:-1}" FLOWC_IN="$abs_lang_program" FLOWC_OUT="$c_file" \
            "$lang_flowc" 2>&1) || transpile_status=$?
        if [ "$transpile_status" -ne 0 ] || [ ! -f "$c_file" ]; then
            print_error "✗ $rel_path (strict transpile failed)"
            if [ -n "$transpile_output" ]; then
                echo "$transpile_output" | tail -n 12
            fi
            failed=$((failed + 1))
            failed_files="$failed_files\n  - $rel_path (transpile)"
            continue
        fi

        # Step 2: Compile C to executable. Tests that import the concurrency
        # stdlib call into runtime/flow_*.c (threads, channels, fibers), so
        # link those sources for them; plain tests stay a one-file clang.
        local clang_output
        local clang_status=0
        local lang_conc_sources=()
        local lang_conc_cflags=()
        local lang_conc_ldflags=()
        # `import concurrent` and `import std.concurrent` name the same
        # module as `import "stdlib/concurrent.flow"` (#1038).
        if grep -qE 'stdlib/concurrent\.flow|^import +(std\.|stdlib\.)?concurrent( |$)' "$program" 2>/dev/null; then
            flow_concurrency_flags
            flow_runtime_flow_sources
            lang_conc_sources=("${FLOW_CONC_SOURCES[@]}" "${FLOW_RUNTIME_FLOW_SOURCES[@]+"${FLOW_RUNTIME_FLOW_SOURCES[@]}"}")
            lang_conc_cflags=("${FLOW_CONC_CFLAGS[@]}")
            lang_conc_ldflags=("${FLOW_CONC_LDFLAGS[@]}")
        fi
        flow_collect_cflags
        clang_output=$(clang "${FLOW_COLLECTED_CFLAGS[@]}" "-I$lang_dir" "${lang_conc_cflags[@]+"${lang_conc_cflags[@]}"}" \
            "$c_file" "${lang_conc_sources[@]+"${lang_conc_sources[@]}"}" \
            "${lang_conc_ldflags[@]+"${lang_conc_ldflags[@]}"}" \
            "${FLOW_COLLECTED_LDFLAGS[@]+"${FLOW_COLLECTED_LDFLAGS[@]}"}" -o "$exe_file" -lm 2>&1) || clang_status=$?
        if [ "$clang_status" -ne 0 ]; then
            print_error "✗ $rel_path (clang compile failed)"
            if [ -n "$clang_output" ]; then
                if [ $verbose -eq 1 ]; then
                    echo "$clang_output"
                else
                    echo "$clang_output" | tail -n 12
                fi
            fi
            failed=$((failed + 1))
            failed_files="$failed_files\n  - $rel_path (clang)"
            continue
        fi

        # Step 3: Run the executable, keeping the two streams apart.
        local run_output
        local exit_code=0
        local stdout_file="$build_dir/${basename}.stdout"
        local stderr_file="$build_dir/${basename}.stderr"
        "$exe_file" > "$stdout_file" 2> "$stderr_file" || exit_code=$?
        run_output=$(cat "$stdout_file" "$stderr_file")

        # Step 3b: Some tests are about *failing*. `expect false` aborts, and
        # the abort is the behaviour under test, so a nonzero exit is the pass.
        # A sibling `.exitcode` file holding a single integer says which code
        # the program must exit with; without one the expected code is 0.
        local exitcode_file="${program%.flow}.exitcode"
        local want_exit=0
        if [ -f "$exitcode_file" ]; then
            want_exit=$(tr -d '[:space:]' < "$exitcode_file")
        fi

        # Step 4: Some behaviour is only visible on a stream: print ordering,
        # what a `defer` runs and when, which effect handler answered a call,
        # the diagnostic a failed `expect` writes. A test may put the exact
        # expected text in a sibling `.expected` (stdout) or `.expected-stderr`
        # file; a mismatch fails the test just like a wrong exit code.
        local stream_mismatch=0
        local expected_file="${program%.flow}.expected"
        if [ "$exit_code" -eq "$want_exit" ] && [ -f "$expected_file" ]; then
            if ! diff -u "$expected_file" "$stdout_file" > "$build_dir/${basename}.diff" 2>&1; then
                print_error "✗ $rel_path (stdout differs from ${expected_file#$SCRIPT_DIR/})"
                cat "$build_dir/${basename}.diff"
                stream_mismatch=1
                failed_files="$failed_files\n  - $rel_path (stdout)"
            fi
        fi

        local expected_err_file="${program%.flow}.expected-stderr"
        if [ $stream_mismatch -eq 0 ] && [ "$exit_code" -eq "$want_exit" ] && [ -f "$expected_err_file" ]; then
            if ! diff -u "$expected_err_file" "$stderr_file" > "$build_dir/${basename}.errdiff" 2>&1; then
                print_error "✗ $rel_path (stderr differs from ${expected_err_file#$SCRIPT_DIR/})"
                cat "$build_dir/${basename}.errdiff"
                stream_mismatch=1
                failed_files="$failed_files\n  - $rel_path (stderr)"
            fi
        fi

        if [ $stream_mismatch -eq 1 ]; then
            failed=$((failed + 1))
            continue
        fi

        if [ "$exit_code" -eq "$want_exit" ]; then
            print_success "✓ $rel_path"
            if [ $verbose -eq 1 ] && [ -n "$run_output" ]; then
                echo "---- output: $rel_path ----"
                echo "$run_output"
                echo "---------------------------"
            fi
            passed=$((passed + 1))
        else
            print_error "✗ $rel_path (exit code $exit_code, expected $want_exit)"
            if [ -n "$run_output" ]; then
                echo "---- output: $rel_path ----"
                echo "$run_output"
                echo "---------------------------"
            fi
            failed=$((failed + 1))
            failed_files="$failed_files\n  - $rel_path (exit=$exit_code want=$want_exit)"
        fi

    done < "$program_list_file"

    # Cleanup
    rm -f "$program_list_file"
    rm -rf "$build_dir"

    echo "----------------------------------------"
    if [ $failed -eq 0 ]; then
        print_success "All $total language tests passed!"
    else
        print_error "Language test failures: $failed/$total"
        if [ -n "$failed_files" ]; then
            echo -e "\nFailed files:$failed_files"
        fi
        exit 1
    fi
}

# Run MLIR verification tests (optional - requires MLIR toolchain)
run_mlir_tests() {
    print_info "Running MLIR verification tests..."
    resolve_llvm_path
    
    # Check if MLIR tools are available
    if ! command -v "$LLVM_PATH/mlir-opt" &> /dev/null; then
        print_warning "MLIR tools not found. Skipping MLIR verification tests."
        print_info "Install with: brew install llvm"
        return 0  # Skip, don't fail
    fi
    
    local mlir_test_dir="$SCRIPT_DIR/tests/mlir"
    local build_dir
    build_dir="$(mktemp -d 2>/dev/null || mktemp -d -t flow_mlir_test)"
    mkdir -p "$build_dir"
    
    # If no dedicated MLIR tests, use a subset of core tests
    local test_files=()
    if [ -d "$mlir_test_dir" ]; then
        while IFS= read -r -d '' file; do
            test_files+=("$file")
        done < <(find "$mlir_test_dir" -name "*.flow" -print0 2>/dev/null)
    fi
    
    # Also test a few core programs
    for core_test in "tests/core/hello_world.flow" "tests/core/fibonacci.flow" "tests/core/loops.flow"; do
        if [ -f "$SCRIPT_DIR/$core_test" ]; then
            test_files+=("$SCRIPT_DIR/$core_test")
        fi
    done
    
    if [ ${#test_files[@]} -eq 0 ]; then
        print_warning "No MLIR test files found."
        rm -rf "$build_dir"
        return 0
    fi
    
    local total=0
    local passed=0
    local failed=0
    local skipped=0
    
    for program in "${test_files[@]}"; do
        total=$((total + 1))
        local rel_path=${program#$SCRIPT_DIR/}
        local basename
        basename=$(basename "$program" .flow)
        local mlir_file="$build_dir/${basename}.mlir"
        
        # Step 1: Generate MLIR
        local gen_output
        gen_output=$(python3 -m "$FLOWC_MODULE" "$program" --mlir --lenient -o "$mlir_file" 2>&1)
        if [ $? -ne 0 ]; then
            print_error "✗ $rel_path (MLIR generation failed)"
            failed=$((failed + 1))
            continue
        fi
        
        # Step 2: Verify MLIR with mlir-opt
        local verify_output
        verify_output=$("$LLVM_PATH/mlir-opt" "$mlir_file" --verify-diagnostics 2>&1)
        local verify_status=$?
        
        # mlir-opt may fail for some dialects - check if it's a verification failure vs missing dialect
        if [ $verify_status -ne 0 ]; then
            if echo "$verify_output" | grep -q "unknown dialect\|unregistered operation"; then
                print_warning "⊘ $rel_path (skipped: dialect not available)"
                skipped=$((skipped + 1))
            else
                print_error "✗ $rel_path (MLIR verification failed)"
                failed=$((failed + 1))
            fi
            continue
        fi
        
        print_success "✓ $rel_path"
        passed=$((passed + 1))
    done
    
    # Cleanup
    rm -rf "$build_dir"
    
    echo "----------------------------------------"
    print_info "MLIR tests: $passed passed, $failed failed, $skipped skipped (of $total)"
    
    if [ $failed -gt 0 ]; then
        return 1
    fi
    return 0
}

# Run all tests (FLOW + Runtime + Python)
run_all_tests() {
    print_info "Running all tests..."
    local any_failed=0
    
    echo ""
    print_info "Phase 1: FLOW language tests (Tier 2: transpile + clang)..."
    run_tests --tier2
    local flow_status=$?
    [ $flow_status -ne 0 ] && any_failed=1
    
    echo ""
    print_info "Phase 2: FLOW runtime tests (compile + execute)..."
    run_runtime_tests
    local runtime_status=$?
    [ $runtime_status -ne 0 ] && any_failed=1
    
    echo ""
    print_info "Phase 3: Python unit tests..."
    run_python_tests
    local python_status=$?
    [ $python_status -ne 0 ] && any_failed=1
    
    echo ""
    echo "========================================"
    print_info "Test Summary:"
    if [ $any_failed -eq 0 ]; then
        print_success "All tests passed!"
    else
        print_error "Some tests failed:"
        [ $flow_status -ne 0 ] && print_error "  - FLOW language tests"
        [ $runtime_status -ne 0 ] && print_error "  - Runtime tests"
        [ $python_status -ne 0 ] && print_error "  - Python tests"
        exit 1
    fi
}

# Install dependencies
install_deps() {
    print_info "Installing FLOW dependencies..."
    resolve_llvm_path
    
    # Install LLVM
    if [ ! -x "$LLVM_PATH/mlir-opt" ]; then
        print_info "Installing LLVM..."
        if command -v brew &> /dev/null; then
            brew install llvm
            resolve_llvm_path
            export LLVM_PATH
            export PATH="$LLVM_PATH:$PATH"
        else
            print_error "Please install LLVM manually"
            exit 1
        fi
    fi
    
    # Optionally install test dependencies
    if command -v pip3 &> /dev/null; then
        print_info "Installing test dependencies (optional)..."
        pip3 install -e .[test] 2>/dev/null || {
            print_warning "Failed to install test dependencies. Install manually with:"
            print_info "  pip install pytest pytest-cov pytest-mock"
        }
    fi
    
    print_success "Dependencies installed!"
}

# Main command dispatcher
case "${1:-help}" in
    "version"|"--version"|"-V")
        echo "Flow 2.0.0"
        echo "host: $(flow_host_mode)"
        ;;
    "check")
        # Conventions and idiom lint (tools/check/main.flow, built on first
        # use). `--build` builds it and prints the binary's path.
        shift
        if ! check_bin="$(flow_native_tool check)"; then
            exit 1
        fi
        if [ "${1:-}" = "--build" ]; then
            printf '%s\n' "$check_bin"
            exit 0
        fi
        exec "$check_bin" "$@"
        ;;
    "run")
        check_deps
        shift
        # The one-process runner (tools/run, #400): --json, --keep,
        # --extra-cflags, --predict, or FLOW_RUN_DIRECT=1 (FLOW_RUN_PYTHON=1
        # is the old name for it).
        direct="${FLOW_RUN_DIRECT:-${FLOW_RUN_PYTHON:-0}}"
        for arg in "$@"; do
            case "$arg" in
                --json|--keep|--keep=*|--extra-cflags|--extra-cflags=*|--predict) direct=1 ;;
            esac
        done
        if [ "$direct" = "1" ]; then
            flow_sync_program "${1:-}" || exit $?
            run_bin="$(flow_native_tool run)" || exit 1
            FLOW_ROOT="$SCRIPT_DIR" exec "$run_bin" "$@"
        else
            run_program "$@"
        fi
        ;;
    "sync")
        shift
        flow_pkg_native sync "$@"
        ;;
    "patch")
        check_deps
        shift
        run_patch_smoke "$@"
        ;;
    "audio")
        check_deps
        run_audio_program "${2:-}" "${3:-}"
        ;;
    "compile")
        check_deps
        shift
        compile_program_cli "$@"
        ;;
    "show-flags")
        shift
        # Allow --profile= / --sanitize= before showing.
        while [ $# -gt 0 ]; do
            case "$1" in
                --sanitize=*) FLOW_SANITIZE="${1#*=}"; export FLOW_SANITIZE; shift ;;
                --sanitize) FLOW_SANITIZE="$2"; export FLOW_SANITIZE; shift 2 ;;
                --profile=*) FLOW_PROFILE="${1#*=}"; export FLOW_PROFILE; shift ;;
                --profile) FLOW_PROFILE="$2"; export FLOW_PROFILE; shift 2 ;;
                *) shift ;;
            esac
        done
        flow_show_clang_flags
        ;;
    "analyze")
        shift
        if [ -z "${1:-}" ]; then
            print_error "Usage: flow analyze <file.c|file.flow> [--standard=misra-c-2024|cert-c]"
            print_info "                  [--wcet] [--stack-depth] [--budget N] [--fail-on-violation]"
            exit 1
        fi
        # tools/analyze/main.flow, built on first use. .flow files (or the
        # --wcet / --stack-depth flags first) go to WCET and stack-depth
        # analysis, anything else to the MISRA/CERT scan over C.
        if ! analyze_bin="$(flow_native_tool analyze)"; then
            exit 1
        fi
        case "${1:-}" in
            *.flow|--wcet|--stack-depth)
                exec "$analyze_bin" wcet "$@"
                ;;
            *)
                exec "$analyze_bin" misra "$@"
                ;;
        esac
        ;;
    "compile-audio")
        check_deps
        compile_audio_program "${2:-}" "${3:-}"
        ;;
    "lsp")
        # Language server on stdio (tools/lsp/main.flow, built on first use;
        # the flow-lsp launcher runs the same binary). `--build` builds it
        # and prints the binary's path without starting it.
        shift
        if ! lsp_bin="$(flow_native_tool lsp)"; then
            exit 1
        fi
        if [ "${1:-}" = "--build" ]; then
            printf '%s\n' "$lsp_bin"
            exit 0
        fi
        FLOW_ROOT="$(cd "$SCRIPT_DIR" && pwd -P)" exec "$lsp_bin" "$@"
        ;;
    "__project-test")
        # `flow test` inside a project (the `flow` launcher routes here):
        # tools/project_test/main.flow, built on first use.
        shift
        if ! pt_bin="$(flow_native_tool project_test)"; then
            exit 2
        fi
        exec "$pt_bin" "$@"
        ;;
    "dap")
        shift
        if [ -z "${1:-}" ]; then
            print_error "Usage: flow dap <program.flow>"
            print_info "IDE: VS Code FLOW debugger type (lldb-dap). CLI opens ./flow debug."
            exit 1
        fi
        require_flow_file "${1:-}"
        # From a terminal: interactive LLDB. From an IDE (stdin is a pipe):
        # the DAP server in tools/dap/main.flow, built on first use.
        if [ -t 0 ]; then
            exec "$SCRIPT_DIR/flow" debug "$1"
        fi
        if ! dap_bin="$(flow_native_tool dap)"; then
            exit 1
        fi
        FLOW_ROOT="$(cd "$SCRIPT_DIR" && pwd -P)" exec "$dap_bin"
        ;;
    "debug")
        shift
        debug_program "$@"
        ;;
    "window")
        run_window_program "${2:-}"
        ;;
    "gfx")
        run_gfx_program "${2:-}"
        ;;
    "record")
        shift
        record_gfx_program "$@"
        ;;
    "vulkan-demo")
        run_vulkan_demo
        ;;
    "vulkan-demo-basic")
        run_vulkan_demo
        ;;
    "vulkan-demo-advanced")
        run_vulkan_demo_advanced
