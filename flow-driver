        ;;
    "mlir")
        shift
        if [ -z "${1:-}" ]; then
            print_error "Usage: flow mlir <program.flow>"
            exit 1
        fi
        require_flow_file "${1:-}"
        generate_mlir "$@"
        ;;
    "mlir-run")
        shift
        if [ -z "${1:-}" ]; then
            print_error "Usage: flow mlir-run <program.flow>"
            exit 1
        fi
        require_flow_file "${1:-}"
        check_mlir_deps
        generate_mlir "${1:-}"
        if [ $? -ne 0 ]; then
            print_error "MLIR generation failed"
            exit 1
        fi
        
        PROGRAM_NAME=$(basename "${1:-}" .flow)
        BUILD_DIR="$SCRIPT_DIR/build"
        MLIR_FILE="$BUILD_DIR/${PROGRAM_NAME}.mlir"
        OBJ_FILE="$BUILD_DIR/${PROGRAM_NAME}_mlir.o"
        EXE_FILE="$BUILD_DIR/${PROGRAM_NAME}_mlir"
        
        if ! mlir_lower_and_link "$MLIR_FILE" "$OBJ_FILE" "$EXE_FILE" 2; then
            exit 1
        fi
        
        print_info "Running..."
        echo "----------------------------------------"
        "$EXE_FILE"
        EXIT_CODE=$?
        echo "----------------------------------------"
        print_success "Program finished with exit code: $EXIT_CODE"
        ;;
    "fir-g"|"firg")
        shift
        # Allow `flow fir-g --calibrate` with no program; otherwise require .flow.
        if [ -z "${1:-}" ]; then
            print_error "Usage: flow fir-g <program.flow> [--json] [--device=…] [--bench] [--opts]"
            print_info "       flow fir-g --calibrate [--thresholds PATH] [--json]"
            print_info "Docs: docs/project/fir-g.md"
            exit 1
        fi
        if [[ "${1}" == *.flow ]]; then
            require_flow_file "${1}"
        elif [[ "${1}" != --* ]]; then
            print_error "Usage: flow fir-g <program.flow> […]  or  flow fir-g --calibrate"
            exit 1
        fi
        check_deps
        # tools/fir/main.flow, built on first use.
        if ! fir_bin="$(flow_native_tool fir)"; then
            exit 1
        fi
        FLOW_ROOT="$(cd "$SCRIPT_DIR" && pwd -P)" exec "$fir_bin" "$@"
        ;;
    "shader")
        shift
        if [ -z "${1:-}" ]; then
            print_error "Usage: flow shader <program.flow> [--grid|--cycle] [--name SHADER] [--frames N] [--size WxH] [--emit-only]"
            exit 1
        fi
        require_flow_file "${1:-}"
        check_deps
        run_fill_shader "$@"
        ;;
    "gpu")
        shift
        # --wgsl emits WebGPU shaders instead of Metal, from the same AST.
        # `--build` builds tools/gpu and prints the binary's path.
        if [ "${1:-}" = "--build" ]; then
            flow_native_tool gpu
            exit $?
        fi
        gpu_lang="metal"
        gpu_args=()
        while [ $# -gt 0 ]; do
            case "$1" in
                --wgsl) gpu_lang="wgsl" ;;
                --metal) gpu_lang="metal" ;;
                *) gpu_args+=("$1") ;;
            esac
            shift
        done
        set -- ${gpu_args[@]+"${gpu_args[@]}"}
        if [ -z "${1:-}" ]; then
            print_error "Usage: flow gpu <program.flow> [--wgsl]"
            exit 1
