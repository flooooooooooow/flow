# Generate MLIR only
generate_mlir() {
    local program=""
    local flags=()
    # Accept flags before or after the program path
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -*)
                flags+=("$1")
                # Flags that take a value
                case "$1" in
                    --spirv-out|--output|-o|--opt-level)
                        shift
                        if [ $# -gt 0 ]; then
                            flags+=("$1")
                        fi
                        ;;
                esac
                ;;
            *)
                if [ -z "$program" ]; then
                    program="$1"
                else
                    flags+=("$1")
                fi
                ;;
        esac
        shift
    done
    local basename
    basename=$(basename "$program" .flow)
    local build_dir="$FLOW_BUILD_ROOT"
    
    if [ -z "$program" ] || [ ! -f "$program" ]; then
        print_error "Program not found: $program"
        exit 1
    fi
    
    mkdir -p "$build_dir"

    check_mlir_deps

    local mlir_cmd=(python3 -m "$FLOWC_MODULE" "$program" --mlir)
    if [ ${#flags[@]} -gt 0 ]; then
        mlir_cmd+=("${flags[@]}")
    fi
    mlir_cmd+=(-o "$build_dir/$basename.mlir")
    if "${mlir_cmd[@]}"; then
        print_success "Generated MLIR: $build_dir/$basename.mlir"
        echo "----------------------------------------"
        cat "$build_dir/$basename.mlir"
        echo "----------------------------------------"
    else
        print_error "MLIR generation failed"
        exit 1
    fi
}

# JIT compile and run via MLIR (links Flow runtime when FLOW_JIT_LINK_RUNTIME=1).
run_flow_jit() {
    local program="$1"
    # Link Flow runtime into JIT executables by default (matches mlir-run / --backend=mlir).
    FLOW_JIT_LINK_RUNTIME="${FLOW_JIT_LINK_RUNTIME:-1}" \
    python3 -c "
from flow.jit_runner import FlowJITRunner
import sys
sys.exit(0 if FlowJITRunner(sys.argv[1]).run_once() else 1)
" "$program"
}

mlir_lower_and_link() {
    local mlir_file="$1"
    local obj_file="$2"
    local exe_file="$3"
    local opt_level="${4:-3}"

    print_info "Lowering MLIR to LLVM IR..."
    set -o pipefail
    if ! "$LLVM_PATH"/mlir-opt "$mlir_file" \
        --convert-vector-to-scf \
        --convert-scf-to-cf \
        --memref-expand \
        --convert-vector-to-llvm \
        --convert-arith-to-llvm \
        --convert-index-to-llvm \
        --convert-cf-to-llvm \
        --convert-func-to-llvm \
        --finalize-memref-to-llvm \
        --reconcile-unrealized-casts | \
        "$LLVM_PATH"/mlir-translate --mlir-to-llvmir | \
        "$LLVM_PATH"/llc "-O${opt_level}" -filetype=obj -o "$obj_file"; then
        print_error "MLIR to LLVM lowering failed"
        return 1
    fi
    set +o pipefail
    print_success "MLIR → LLVM IR → Object"

    print_info "Linking executable (Flow runtime)..."
    flow_concurrency_flags
    flow_runtime_flow_sources
    flow_gpu_link_flags
    if ! clang "-O${opt_level}" -fno-omit-frame-pointer "${FLOW_CONC_CFLAGS[@]}" \
        "$obj_file" \
        "$SCRIPT_DIR/runtime/flow_python_embed.c" \
        "${FLOW_CONC_SOURCES[@]}" \
        "${FLOW_RUNTIME_FLOW_SOURCES[@]+"${FLOW_RUNTIME_FLOW_SOURCES[@]}"}" \
        "${FLOW_GPU_SOURCES[@]+"${FLOW_GPU_SOURCES[@]}"}" \
        "${FLOW_GPU_LDFLAGS[@]+"${FLOW_GPU_LDFLAGS[@]}"}" "${FLOW_CONC_LDFLAGS[@]}" \
        -lm -o "$exe_file" 2>/dev/null; then
        print_error "Linking failed"
        return 1
    fi
    print_success "Built: $exe_file"
    return 0
}

run_gfx_program() {
    local program="$1"
    require_flow_file "$program"
    local basename
    basename=$(basename "$program" .flow)
    local build_dir="$FLOW_BUILD_ROOT"
    local py_framework_dir="/Applications/Xcode.app/Contents/Developer/Library/Frameworks"
    local py_header_dir="$py_framework_dir/Python3.framework/Headers"
    local py_cflags=()
    local py_ldflags=()
    local audio_cflags=()
    local audio_sources=("$SCRIPT_DIR/runtime/audio_miniaudio.c")
    
    check_deps
    mkdir -p "$build_dir"
    if [ -f "$SCRIPT_DIR/third_party/miniaudio.h" ]; then
        audio_cflags+=("-I$SCRIPT_DIR/third_party" "-DFLOW_AUDIO_BACKEND_MINIAUDIO")
        FLOW_SKIP_AUDIO_STUB=1
    fi
    
    local c_file="$build_dir/$basename.gfx.c"
    local exe_file="$build_dir/$basename.gfx"
    
    print_info "Compiling $program (native gfx)..."
    if ! flowc_emit_to_c "$program" "$c_file"; then
        print_error "FLOW compilation failed"
        exit 1
    fi
    print_success "FLOW → C: $(basename "$c_file")"
    
    if [ -d "$py_header_dir" ]; then
        py_cflags+=("-I$py_header_dir" "-DFLOW_PY_EMBED")
        py_ldflags+=("-F$py_framework_dir" "-framework" "Python3" "-Wl,-rpath,$py_framework_dir")
    fi
    # The Flow runtime pack (FLOW_RUNTIME_FLOW_SOURCES) references C symbols
    # spread across runtime/*.c: flow_rt_uname_machine in flow_rt_sysinfo.c,
    # the TLS entry points in flow_tls.c, and so on. Linking only
    # flow_rt_support.c left those undefined, so a gfx program that touched
    # get_time(), sysinfo or crypto failed to link. FLOW_CONC_SOURCES is the
    # canonical set `flow run` uses; use it here too so the windowed, recorded
    # and console builds all accept the same programs.
    flow_concurrency_flags
    flow_runtime_flow_sources
    local gfx_link_err="$build_dir/.gfx_link_err"
    local gfx_ok=0
    local host_kernel
    host_kernel="$(uname -s)"
    if [[ "$host_kernel" == "Darwin" ]]; then
        if clang -O2 -fno-omit-frame-pointer "${audio_cflags[@]}" "${py_cflags[@]}" "${FLOW_CONC_CFLAGS[@]}" "$c_file" "$SCRIPT_DIR/runtime/gfx_macos.m" \
            "${FLOW_CONC_SOURCES[@]}" \
            "${FLOW_RUNTIME_FLOW_SOURCES[@]+"${FLOW_RUNTIME_FLOW_SOURCES[@]}"}" \
            "${audio_sources[@]}" \
            -framework Cocoa -framework CoreGraphics -framework QuartzCore -framework CoreText \
            -framework CoreAudio -framework AudioToolbox -framework AudioUnit \
            "${py_ldflags[@]}" "${FLOW_CONC_LDFLAGS[@]}" \
            -o "$exe_file" -lm 2>"$gfx_link_err"; then
            gfx_ok=1
        fi
    elif [[ "$host_kernel" == MINGW* || "$host_kernel" == MSYS* || "$host_kernel" == CYGWIN* ]]; then
        # Windows (MSYS2/Git Bash/Cygwin shell running this script): shares
        # the exact same SDL2 implementation as Linux via
        # runtime/gfx_sdl_impl.inc, compiled through runtime/gfx_windows.c
        # (falls back to stub if headers missing: pass -DFLOW_GFX_STUB to
        # force stub). Native MSVC/clang-cl builds outside this script should
        # link runtime/gfx_windows.c directly: see its header comment for
        # exact commands.
        local sdl_cflags=()
        local sdl_libs=(-lSDL2)
        if command -v sdl2-config >/dev/null 2>&1; then
            # shellcheck disable=SC2207
            sdl_cflags=($(sdl2-config --cflags))
            # shellcheck disable=SC2207
            sdl_libs=($(sdl2-config --libs))
        elif command -v pkg-config >/dev/null 2>&1 && pkg-config --exists sdl2; then
            # shellcheck disable=SC2207
            sdl_cflags=($(pkg-config --cflags sdl2))
            # shellcheck disable=SC2207
            sdl_libs=($(pkg-config --libs sdl2))
        fi
        if clang -O2 -fno-omit-frame-pointer "${py_cflags[@]}" "$c_file" "$SCRIPT_DIR/runtime/gfx_windows.c" \
            "$SCRIPT_DIR/runtime/flow_rt_support.c" \
            "${FLOW_RUNTIME_FLOW_SOURCES[@]+"${FLOW_RUNTIME_FLOW_SOURCES[@]}"}" \
            "${sdl_cflags[@]}" "${sdl_libs[@]}" \
            "${py_ldflags[@]}" \
            -o "$exe_file" -lm 2>/dev/null; then
            gfx_ok=1
        fi
    else
        # Linux: SDL2 backend in runtime/gfx_linux.c (falls back to stub if
        # headers missing: pass -DFLOW_GFX_STUB to force stub).
        local sdl_cflags=()
        local sdl_libs=(-lSDL2)
        if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists sdl2; then
            # shellcheck disable=SC2207
            sdl_cflags=($(pkg-config --cflags sdl2))
            # shellcheck disable=SC2207
            sdl_libs=($(pkg-config --libs sdl2))
        fi
        if clang -O2 -fno-omit-frame-pointer "${py_cflags[@]}" "$c_file" "$SCRIPT_DIR/runtime/gfx_linux.c" \
            "$SCRIPT_DIR/runtime/flow_rt_support.c" \
            "${FLOW_RUNTIME_FLOW_SOURCES[@]+"${FLOW_RUNTIME_FLOW_SOURCES[@]}"}" \
            "${sdl_cflags[@]}" "${sdl_libs[@]}" \
            "${py_ldflags[@]}" \
            -o "$exe_file" -lm 2>/dev/null; then
            gfx_ok=1
        fi
    fi
    if [[ "$gfx_ok" -ne 1 ]]; then
        print_error "Native gfx build failed (clang / platform graphics libs)"
        # The link errors used to go to /dev/null, which turned a missing
        # symbol into an unexplained one-line failure. Show them.
        if [ -s "$gfx_link_err" ]; then
            sed 's/^/    /' "$gfx_link_err" >&2
        fi
        exit 1
    fi
    print_success "Built: $exe_file"
    
    print_info "Running..."
    "$exe_file"
}

# Build a gfx program against the headless recording backend and run it, so demo
# frames come from the real program instead of a mock-up. Configured through
# FLOW_GFX_RECORD_*: see runtime/gfx_record.c.
# flow record <program> [--frames N] [--skip N] [--out DIR] [--gif [PATH]]
#                       [--keys SPEC] [--mouse SPEC] [--fps N] [--stride N]
#                       [--width PX]
#
# --frames/--skip/--out/--keys/--mouse shape the capture; --fps/--stride/--width
# shape the GIF and are handed to scripts/frames_to_gif.py.
#
# --mouse drives a scripted pointer so mouse-driven demos still record. Its
# spec is ';'-separated segments of
#   first,last,x0,y0,x1,y1,buttons,wheel
# where the cursor lerps from (x0,y0) to (x1,y1) across the frame window,
# `buttons` is a mask held throughout (1 left, 2 right, 4 middle), and `wheel`
# is added once per frame. Integer interpolation, so it is bit-identical on
# every platform. Example: sweep while dragging, then right-click and hold:
#   --mouse '0,30,10,10,300,200,1,0;31,60,300,200,300,200,2,0'
#
# Flags win; the FLOW_GFX_RECORD_* environment variables remain as a fallback
# so existing scripts keep working.
record_gfx_program() {
    local program=""
    local rec_frames=""
    local rec_skip=""
    local rec_dir=""
    local rec_keys=""
    local rec_mouse=""
    local rec_gif=""
    local want_gif=0
    local gif_fps=""
    local gif_stride=""
    local gif_width=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --frames|-n)
                rec_frames="${2:-}"
                if [ -z "$rec_frames" ]; then
                    print_error "--frames needs a count, e.g. --frames 90"
                    exit 1
                fi
                shift 2
                ;;
            --frames=*) rec_frames="${1#*=}"; shift ;;
            --skip)
                rec_skip="${2:-}"
                if [ -z "$rec_skip" ]; then
                    print_error "--skip needs a count, e.g. --skip 2 (keep every 2nd frame)"
                    exit 1
                fi
                shift 2
                ;;
            --skip=*) rec_skip="${1#*=}"; shift ;;
            --out|-o)
                rec_dir="${2:-}"
                if [ -z "$rec_dir" ]; then
                    print_error "--out needs a directory, e.g. --out build/frames"
                    exit 1
                fi
                shift 2
                ;;
            --out=*) rec_dir="${1#*=}"; shift ;;
            --keys)
                rec_keys="${2:-}"
                shift 2
                ;;
            --keys=*) rec_keys="${1#*=}"; shift ;;
            --mouse)
                rec_mouse="${2:-}"
                shift 2
                ;;
            --mouse=*) rec_mouse="${1#*=}"; shift ;;
            --gif)
                want_gif=1
                case "${2:-}" in
                    ""|-*) ;;
                    *) rec_gif="$2"; shift ;;
                esac
                shift
                ;;
            --gif=*) want_gif=1; rec_gif="${1#*=}"; shift ;;
            --fps) gif_fps="${2:-}"; shift 2 ;;
            --fps=*) gif_fps="${1#*=}"; shift ;;
            --stride) gif_stride="${2:-}"; shift 2 ;;
            --stride=*) gif_stride="${1#*=}"; shift ;;
            --width) gif_width="${2:-}"; shift 2 ;;
            --width=*) gif_width="${1#*=}"; shift ;;
            -*)
                print_error "Unknown flag for 'flow record': $1"
                echo "  usage: flow record <program.flow> [--frames N] [--skip N] [--out DIR]"
                echo "                     [--gif [PATH]] [--keys SPEC] [--fps N] [--stride N] [--width PX]"
                exit 1
                ;;
            *)
                if [ -z "$program" ]; then program="$1"; fi
                shift
                ;;
        esac
    done

    require_flow_file "$program"
    local basename
    basename=$(basename "$program" .flow)
    local build_dir="$FLOW_BUILD_ROOT"

    # A GIF needs frames somewhere; default to a scratch dir under build/.
    if [ "$want_gif" = "1" ]; then
        if [ -z "$rec_gif" ]; then
            rec_gif="$build_dir/$basename.gif"
        fi
        if [ -z "$rec_dir" ]; then
            rec_dir="$build_dir/frames_$basename"
            rm -rf "$rec_dir"
        fi
        if [ -z "$rec_frames" ]; then
            rec_frames=120
        fi
    fi

    [ -n "$rec_frames" ] && export FLOW_GFX_RECORD_FRAMES="$rec_frames"
    [ -n "$rec_skip" ] && export FLOW_GFX_RECORD_SKIP="$rec_skip"
    [ -n "$rec_dir" ] && export FLOW_GFX_RECORD_DIR="$rec_dir"
    [ -n "$rec_keys" ] && export FLOW_GFX_RECORD_KEYS="$rec_keys"
    [ -n "$rec_mouse" ] && export FLOW_GFX_RECORD_MOUSE="$rec_mouse"

    check_deps
    mkdir -p "$build_dir"

    local c_file="$build_dir/$basename.record.c"
    local exe_file="$build_dir/$basename.record"

    print_info "Compiling $program (headless recorder)..."
    if ! flowc_emit_to_c "$program" "$c_file"; then
        print_error "FLOW compilation failed"
        exit 1
    fi
    print_success "FLOW → C: $(basename "$c_file")"

    # Recorder logic lives in lib/runtime/gfx_record.flow; compile just that
    # module. The runtime archive deliberately skips gfx_record, so the two
    # compose without a duplicate definition.
    local rec_logic_c="$build_dir/runtime_flow/gfx_record.c"
    mkdir -p "$build_dir/runtime_flow"
    if ! flowc_emit_runtime_module "$SCRIPT_DIR/lib/runtime/gfx_record.flow" \
        "$rec_logic_c" >/dev/null 2>&1; then
        print_error "Flow runtime module failed: gfx_record.flow"
        exit 1
    fi
    print_success "FLOW → C: runtime_flow/gfx_record.c"

    # The recorder used to link only the program plus gfx_record.c. Anything
    # backed by lib/runtime/: get_time, audio, crypto, threads, tcp: then
    # compiled fine and failed at link time with an undefined symbol, which is
    # the worst possible moment: the program works under `./flow gfx` and only
    # dies when you try to record its GIF. Link the same runtime pack the
    # windowed path uses so the two build modes accept the same programs.
    flow_concurrency_flags
    flow_runtime_flow_sources

    # flow_rt_support.c raises its fatal-error popup through
    # CFUserNotificationDisplayNotice on Darwin. The windowed build picks
    # CoreFoundation up transitively from Cocoa; the recorder links no
    # frameworks at all, so it has to ask for it explicitly.
    local rec_frameworks=()
    if [ "$(uname -s)" = "Darwin" ]; then
        rec_frameworks=(-framework CoreFoundation)
    fi

    if ! clang -O2 -fno-omit-frame-pointer \
        -Wno-error=implicit-function-declaration \
        "${FLOW_CONC_CFLAGS[@]}" \
        "$c_file" \
        "$rec_logic_c" \
        "$SCRIPT_DIR/runtime/gfx_record.c" \
        "${FLOW_CONC_SOURCES[@]}" \
        "${FLOW_RUNTIME_FLOW_SOURCES[@]+"${FLOW_RUNTIME_FLOW_SOURCES[@]}"}" \
        "${FLOW_CONC_LDFLAGS[@]}" \
        "${rec_frameworks[@]+"${rec_frameworks[@]}"}" \
        -o "$exe_file" -lm; then
        print_error "Recorder build failed"
        exit 1
    fi
    print_success "Built: $exe_file"

    print_info "Recording..."
    "$exe_file"

    if [ "$want_gif" = "1" ]; then
        print_info "Encoding $rec_gif ..."
        local gif_args=()
        [ -n "$gif_fps" ] && gif_args+=(--fps "$gif_fps")
        [ -n "$gif_stride" ] && gif_args+=(--stride "$gif_stride")
        [ -n "$gif_width" ] && gif_args+=(--width "$gif_width")
        if python3 "$SCRIPT_DIR/scripts/frames_to_gif.py" "${rec_dir:-frames}" "$rec_gif" \
            "${gif_args[@]+"${gif_args[@]}"}"; then
            print_success "GIF: $rec_gif"
        else
            print_error "GIF encoding failed"
            exit 1
        fi
    fi
}

# Build and run Vulkan triangle demo (macOS + MoltenVK).
run_vulkan_demo() {
    local demo_dir="$SCRIPT_DIR/demos/vulkan_triangle"

    if [ ! -d "$demo_dir" ]; then
        print_error "Vulkan demo not found: $demo_dir"
        exit 1
    fi

    if ! command -v make &> /dev/null; then
        print_error "make is required to build the Vulkan demo"
        exit 1
    fi

    if ! command -v pkg-config &> /dev/null; then
        print_error "pkg-config is required to build the Vulkan demo"
        print_info "Install: brew install pkg-config"
        exit 1
    fi

    if ! command -v glslangValidator &> /dev/null; then
        print_error "glslangValidator is required to compile shaders"
        print_info "Install: brew install vulkan-tools"
        exit 1
