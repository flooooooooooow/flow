# Check dependencies
check_deps() {
    local mode
    mode="$(flow_host_mode)" || exit 1

    if ! command -v clang &> /dev/null && ! command -v cc &> /dev/null; then
        print_error "clang or cc is required"
        exit 1
    fi

    # The C path is flowc and needs no Python.
    : "$mode"
}

check_mlir_deps() {
    resolve_llvm_path
    export LLVM_PATH
    if [ -d "$LLVM_PATH" ]; then
        case ":$PATH:" in
            *":$LLVM_PATH:"*) ;;
            *) export PATH="$LLVM_PATH:$PATH" ;;
        esac
    fi
    if [ ! -x "$LLVM_PATH/mlir-opt" ]; then
        print_error "MLIR tools not found. Run './flow install' (or brew install llvm)"
        exit 1
    fi
    if [ ! -x "$LLVM_PATH/mlir-translate" ]; then
        print_error "mlir-translate not found. Run './flow install' (or brew install llvm)"
        exit 1
    fi
}

# Concurrency runtime + optional OpenMP (parallel for). Sets:
#   FLOW_CONC_SOURCES, FLOW_CONC_CFLAGS, FLOW_CONC_LDFLAGS (bash arrays)
flow_concurrency_flags() {
    FLOW_CONC_SOURCES=(
        "$SCRIPT_DIR/runtime/flow_concurrency.c"
        "$SCRIPT_DIR/runtime/flow_fiber.c"
        "$SCRIPT_DIR/runtime/flow_fctx_init.c"
        "$SCRIPT_DIR/runtime/flow_netpoll.c"
        "$SCRIPT_DIR/runtime/flow_netpoll_fiber.c"
        "$SCRIPT_DIR/runtime/flow_http_bench.c"
        "$SCRIPT_DIR/runtime/flow_tcp.c"
        "$SCRIPT_DIR/runtime/flow_race.c"
        "$SCRIPT_DIR/runtime/flow_cont.c"
        "$SCRIPT_DIR/runtime/flow_rt_support.c"
        "$SCRIPT_DIR/runtime/flow_rt_task_store.c"
        "$SCRIPT_DIR/runtime/flow_rt_fiber_async.c"
        "$SCRIPT_DIR/runtime/flow_rt_parallel.c"
        "$SCRIPT_DIR/runtime/flow_rt_cchan.c"
        "$SCRIPT_DIR/runtime/flow_rt_sysinfo.c"
        "$SCRIPT_DIR/runtime/flow_rt_crypto.c"
        "$SCRIPT_DIR/runtime/flow_tls.c"
    )
    case "$(uname -m)" in
        arm64|aarch64)
            FLOW_CONC_SOURCES+=("$SCRIPT_DIR/runtime/flow_fctx_arm64.S")
            ;;
        x86_64|amd64)
            FLOW_CONC_SOURCES+=("$SCRIPT_DIR/runtime/flow_fctx_x86_64.S")
            ;;
    esac
    FLOW_CONC_CFLAGS=("-I$SCRIPT_DIR/runtime")
    FLOW_CONC_LDFLAGS=("-pthread")
    # flow_rt_support.c shows its fatal-error popup through CoreFoundation
    # on Darwin. Builds that link Cocoa get it anyway; the rest, such as
    # test-lang, must ask for it (#953).
    if [ "$(uname -s)" = "Darwin" ]; then
        FLOW_CONC_LDFLAGS+=("-framework" "CoreFoundation")
    fi
    # Probe OpenSSL once (HTTPS accept-loop / flow_tls.c).
    if [ -z "${FLOW_OPENSSL_PROBED:-}" ]; then
        FLOW_OPENSSL_PROBED=1
        FLOW_OPENSSL_CFLAGS=()
        FLOW_OPENSSL_LDFLAGS=()
        local ossl_prefix=""
        if command -v brew >/dev/null 2>&1; then
            ossl_prefix="$(brew --prefix openssl@3 2>/dev/null || brew --prefix openssl 2>/dev/null || true)"
        fi
        local probe="$SCRIPT_DIR/build/.ossl_probe.c"
        mkdir -p "$SCRIPT_DIR/build"
        printf '#include <openssl/ssl.h>\nint main(void){SSL_CTX_new(TLS_method());return 0;}\n' > "$probe"
        if [ -n "$ossl_prefix" ] && clang -I"$ossl_prefix/include" "$probe" -L"$ossl_prefix/lib" -lssl -lcrypto -o "$SCRIPT_DIR/build/.ossl_probe" 2>/dev/null; then
            FLOW_OPENSSL_CFLAGS=("-DFLOW_HAS_OPENSSL=1" "-I$ossl_prefix/include")
            FLOW_OPENSSL_LDFLAGS=("-L$ossl_prefix/lib" "-Wl,-rpath,$ossl_prefix/lib" "-lssl" "-lcrypto")
        elif pkg-config --exists openssl 2>/dev/null && clang $(pkg-config --cflags openssl) "$probe" $(pkg-config --libs openssl) -o "$SCRIPT_DIR/build/.ossl_probe" 2>/dev/null; then
            # shellcheck disable=SC2207
            FLOW_OPENSSL_CFLAGS=("-DFLOW_HAS_OPENSSL=1" $(pkg-config --cflags openssl))
            # shellcheck disable=SC2207
            FLOW_OPENSSL_LDFLAGS=($(pkg-config --libs openssl))
        else
            FLOW_OPENSSL_CFLAGS=("-DFLOW_HAS_OPENSSL=0")
        fi
        rm -f "$probe" "$SCRIPT_DIR/build/.ossl_probe"
    fi
    if [ "${#FLOW_OPENSSL_CFLAGS[@]}" -gt 0 ]; then
        FLOW_CONC_CFLAGS+=("${FLOW_OPENSSL_CFLAGS[@]}")
    fi
    if [ "${#FLOW_OPENSSL_LDFLAGS[@]}" -gt 0 ]; then
        FLOW_CONC_LDFLAGS+=("${FLOW_OPENSSL_LDFLAGS[@]}")
    fi
    # Probe OpenMP once per shell invocation (Apple clang needs libomp).
    if [ -z "${FLOW_OPENMP_PROBED:-}" ]; then
        FLOW_OPENMP_PROBED=1
        FLOW_OPENMP_FLAGS=()
        local probe="$SCRIPT_DIR/build/.omp_probe.c"
        mkdir -p "$SCRIPT_DIR/build"
        printf 'int main(void){return 0;}\n' > "$probe"
        if clang -fopenmp "$probe" -o "$SCRIPT_DIR/build/.omp_probe" -lomp 2>/dev/null; then
            FLOW_OPENMP_FLAGS=("-fopenmp" "-lomp")
        elif clang -fopenmp "$probe" -o "$SCRIPT_DIR/build/.omp_probe" 2>/dev/null; then
            FLOW_OPENMP_FLAGS=("-fopenmp")
        elif clang -Xpreprocessor -fopenmp "$probe" -o "$SCRIPT_DIR/build/.omp_probe" -lomp 2>/dev/null; then
            FLOW_OPENMP_FLAGS=("-Xpreprocessor" "-fopenmp" "-lomp")
        fi
        rm -f "$probe" "$SCRIPT_DIR/build/.omp_probe"
    fi
    if [ "${#FLOW_OPENMP_FLAGS[@]}" -gt 0 ]; then
        FLOW_CONC_CFLAGS+=("${FLOW_OPENMP_FLAGS[@]}")
        FLOW_CONC_LDFLAGS+=("${FLOW_OPENMP_FLAGS[@]}")
    fi
}

# Always-linked Flow runtime modules (lib/runtime/*.flow). flowc builds them,
# with runtime/*.c, into the runtime archive (flowc_runtime_archive), and
# FLOW_RUNTIME_FLOW_SOURCES holds that archive for the final link, so a
# program pulls in only the objects it uses. Honors FLOW_SKIP_AUDIO_STUB.
flow_runtime_flow_sources() {
    FLOW_RUNTIME_FLOW_SOURCES=()
    local driver cc_bin=cc
    if command -v clang > /dev/null 2>&1; then
        cc_bin=clang
    fi
    driver="$(flow_resolve_flowc)" || exit 1
    flow_collect_cflags
    if ! flowc_runtime_archive "$driver" "$cc_bin"; then
        print_error "flowc could not build the Flow runtime (lib/runtime/*.flow)"
        exit 1
    fi
    FLOW_RUNTIME_FLOW_SOURCES=("$FLOWC_RT_ARCHIVE")
}

# Compile FLOW to executable (flowc).
compile_program() {
    flow_host_mode >/dev/null
    compile_program_flowc "$1"
}

# MLIR CPU backend. With the default flowc host the Flow emitter
# (compiler/src/mlirgen.flow, FLOWC_EMIT=mlir) writes the MLIR and
# compiler/scripts/mlir_lower.sh lowers it, with no Python. A program outside
# the emitter's slice is refused with a reason and falls back to the Python
# MLIR generator.
compile_program_mlir() {
    local program="$1"
    require_flow_file "$program"
    flow_host_mode >/dev/null
    local rc=0
    compile_program_mlir_flowc "$program" || rc=$?
    if [ "$rc" -eq 0 ]; then
        return 0
    fi
    if [ "$rc" -ne 3 ]; then
        exit 1
    fi
    print_warning "flowc MLIR emitter does not cover this program yet (${FLOW_MLIR_REFUSAL:-refused}); using the Python MLIR generator"
    compile_program_mlir_python "$program"
}

# The MLIR emitter lives in the main.flow build of flowc (the checked-in
# bootstrap C), not in the driver.flow builds ensure_flowc may prefer.
# FLOWC_BIN overrides; otherwise compiler/build/flowc_bootstrap is built
# from compiler/bootstrap/flowc_stage_a.c with cc when missing or stale.
flow_resolve_flowc_mlir() {
    if [[ -n "${FLOWC_BIN:-}" && -x "${FLOWC_BIN}" ]]; then
        printf '%s\n' "$FLOWC_BIN"
        return 0
    fi
    local boot_c="$SCRIPT_DIR/compiler/bootstrap/flowc_stage_a.c"
    local boot="$SCRIPT_DIR/compiler/build/flowc_bootstrap"
    if [[ ! -x "$boot" || "$boot_c" -nt "$boot" ]]; then
        mkdir -p "$SCRIPT_DIR/compiler/build"
        "${CC:-cc}" -O2 -w -o "$boot.tmp.$$" "$boot_c" >/dev/null 2>&1 || return 1
        mv -f "$boot.tmp.$$" "$boot"
    fi
    printf '%s\n' "$boot"
}

# Flow MLIR emitter path. Returns 3 when flowc refuses the program (the
# reason is left in FLOW_MLIR_REFUSAL), 1 on a lowering or link failure.
compile_program_mlir_flowc() {
    local program="$1"
    check_mlir_deps
    local driver
    if ! driver="$(flow_resolve_flowc_mlir)"; then
        FLOW_MLIR_REFUSAL="no flowc built from compiler/bootstrap"
        return 3
    fi
    local basename
    basename=$(basename "$program" .flow)
    local build_dir="$FLOW_BUILD_ROOT"
    mkdir -p "$build_dir"
    print_info "Compiling $program (CPU backend=mlir, host=flowc)..."
    # FLOWC_ROOT: where imports find packages/ and the fallback lib/stdlib.
    if ! FLOWC_EMIT=mlir FLOWC_TYPECHECK="${FLOWC_TYPECHECK:-1}" \
        FLOWC_ROOT="$SCRIPT_DIR" \
        FLOWC_IN="$program" FLOWC_OUT="$build_dir/$basename.mlir" \
        "$driver" >"$build_dir/.flowc_mlir_log" 2>&1; then
        FLOW_MLIR_REFUSAL="$(grep -m1 'flowc' "$build_dir/.flowc_mlir_log" || true)"
        return 3
    fi
    if ! head -1 "$build_dir/$basename.mlir" | grep -q '^module'; then
        FLOW_MLIR_REFUSAL="$driver does not know FLOWC_EMIT=mlir"
        return 3
    fi
    print_success "FLOW → MLIR (flowc): $basename.mlir"
    if ! "$SCRIPT_DIR/compiler/scripts/mlir_lower.sh" "$build_dir/$basename.mlir" \
        "$build_dir/$basename.ll"; then
        print_error "MLIR lowering failed (mlir-opt / mlir-translate)"
        return 1
    fi
    print_success "MLIR → LLVM: $basename.ll"
    flow_collect_cflags
    if ! clang "${FLOW_COLLECTED_CFLAGS[@]}" -O2 -fno-omit-frame-pointer \
        "${FLOW_COLLECTED_LDFLAGS[@]+"${FLOW_COLLECTED_LDFLAGS[@]}"}" \
        -Wno-unused-command-line-argument -Wno-override-module \
        "$build_dir/$basename.ll" -lm -o "$build_dir/$basename"; then
        print_error "LLVM IR link failed (flowc MLIR path)"
        return 1
    fi
    print_success "LLVM → Executable: $basename"
    print_success "🚀 Ready to run (mlir): $build_dir/$basename"
    return 0
}

# Python MLIR generator path: FLOW → MLIR → LLVM IR → clang + Flow runtime.
compile_program_mlir_python() {
    local program="$1"
    require_flow_file "$program"
    check_mlir_deps
    local basename
    basename=$(basename "$program" .flow)
    local build_dir="$FLOW_BUILD_ROOT"
    local py_framework_dir="/Applications/Xcode.app/Contents/Developer/Library/Frameworks"
    local py_header_dir="$py_framework_dir/Python3.framework/Headers"
    local py_cflags=()
    local py_ldflags=()

    print_info "Compiling $program (CPU backend=mlir)..."
    mkdir -p "$build_dir"

    if ! python3 -m "$FLOWC_MODULE" "$program" --mlir --llvm --lenient -o "$build_dir/$basename.ll" 2>"$build_dir/.flowc_err"; then
        print_error "FLOW MLIR/LLVM compilation failed"
        cat "$build_dir/.flowc_err" >&2
        exit 1
    fi
    print_success "FLOW → MLIR → LLVM: $basename.ll"

    if [ -d "$py_header_dir" ]; then
        py_cflags+=("-I$py_header_dir" "-DFLOW_PY_EMBED")
        py_ldflags+=("-F$py_framework_dir" "-framework" "Python3" "-Wl,-rpath,$py_framework_dir")
    fi
    flow_gpu_link_flags
    flow_concurrency_flags
    flow_runtime_flow_sources

    flow_collect_cflags
    FLOW_CONC_LDFLAGS+=("${FLOW_COLLECTED_LDFLAGS[@]+"${FLOW_COLLECTED_LDFLAGS[@]}"}")

    if ! clang "${FLOW_COLLECTED_CFLAGS[@]}" -O2 -fno-omit-frame-pointer \
        "${py_cflags[@]}" "${FLOW_CONC_CFLAGS[@]}" -I"$SCRIPT_DIR/runtime" \
        "$build_dir/$basename.ll" \
        "$SCRIPT_DIR/runtime/flow_python_embed.c" \
        "${FLOW_CONC_SOURCES[@]}" \
        "${FLOW_RUNTIME_FLOW_SOURCES[@]+"${FLOW_RUNTIME_FLOW_SOURCES[@]}"}" \
        "${FLOW_GPU_SOURCES[@]+"${FLOW_GPU_SOURCES[@]}"}" \
        "${py_ldflags[@]}" "${FLOW_GPU_LDFLAGS[@]+"${FLOW_GPU_LDFLAGS[@]}"}" "${FLOW_CONC_LDFLAGS[@]}" \
        -lm -o "$build_dir/$basename"; then
        print_error "MLIR/LLVM compilation/linking failed"
        exit 1
    fi
    print_success "LLVM → Executable: $basename"
    print_success "🚀 Ready to run (mlir): $build_dir/$basename"
}

# Parse optional --backend=c|mlir / --sanitize= / --profile= / --show-flags
# from argv; sets FLOW_PARSE_PROGRAM and FLOW_PARSE_BACKEND.
flow_parse_program_backend() {
    FLOW_PARSE_PROGRAM=""
    FLOW_PARSE_BACKEND="$(flow_cpu_backend)"
    FLOW_PARSE_SHOW_FLAGS=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --backend=*)
                FLOW_PARSE_BACKEND="${1#*=}"
                shift
                ;;
            --backend)
                if [ -z "${2:-}" ]; then
                    print_error "--backend requires c or mlir"
                    exit 1
                fi
                FLOW_PARSE_BACKEND="$2"
                shift 2
                ;;
            --sanitize=*)
                FLOW_SANITIZE="${1#*=}"
                export FLOW_SANITIZE
                shift
                ;;
            --sanitize)
                if [ -z "${2:-}" ]; then
                    print_error "--sanitize requires ub,asan,tsan (comma-separated)"
                    exit 1
                fi
                FLOW_SANITIZE="$2"
                export FLOW_SANITIZE
                shift 2
                ;;
            --profile=*)
                FLOW_PROFILE="${1#*=}"
                export FLOW_PROFILE
                shift
                ;;
            --profile)
                if [ -z "${2:-}" ]; then
                    print_error "--profile requires safety|flight"
                    exit 1
                fi
                FLOW_PROFILE="$2"
                export FLOW_PROFILE
                shift 2
                ;;
            --show-flags)
                FLOW_PARSE_SHOW_FLAGS=1
                shift
                ;;
            -*)
                print_error "Unknown option: $1"
                exit 1
                ;;
            *)
                if [ -z "$FLOW_PARSE_PROGRAM" ]; then
                    FLOW_PARSE_PROGRAM="$1"
                else
                    print_error "Unexpected argument: $1"
                    exit 1
                fi
                shift
                ;;
        esac
    done
    case "$FLOW_PARSE_BACKEND" in
        c|mlir) ;;
        *)
            print_error "Unknown backend: $FLOW_PARSE_BACKEND (expected c|mlir)"
            exit 1
            ;;
    esac
    if [ "${FLOW_PARSE_SHOW_FLAGS}" = "1" ]; then
        flow_show_clang_flags
        if [ -z "$FLOW_PARSE_PROGRAM" ]; then
            exit 0
        fi
    fi
    export FLOW_CPU_BACKEND="$FLOW_PARSE_BACKEND"
}

# Compile with debug symbols and open a debugger (LLDB preferred).
# Usage: flow debug <program.flow> [--break N|--break main] [--no-launch]
debug_program() {
    local program=""
    local break_spec="main"
    local no_launch=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --break)
                break_spec="${2:-}"
                if [ -z "$break_spec" ]; then
                    print_error "--break requires a line number or 'main'"
                    exit 1
                fi
                shift 2
                ;;
            --no-launch|--keep)
                # --keep retained for compatibility; debug builds always live in build/
                no_launch=1
                shift
                ;;
            -h|--help)
                echo "Usage: flow debug <program.flow> [--break N|--break main] [--no-launch]"
                echo "  --break N     Break at Flow source line N (LLDB/GDB)"
                echo "  --break main  Break at main (default)"
                echo "  --no-launch   Build only; print paths and exit"
                exit 0
                ;;
            -*)
                print_error "Unknown debug option: $1"
                exit 1
                ;;
            *)
                if [ -z "$program" ]; then
                    program="$1"
                else
                    print_error "Unexpected argument: $1"
                    exit 1
                fi
                shift
                ;;
        esac
    done

    require_flow_file "$program"
    local basename
    basename=$(basename "$program" .flow)
    local build_dir="$FLOW_BUILD_ROOT"
    local c_file="$build_dir/$basename.debug.c"
    local exe_file="$build_dir/$basename.debug"

    check_deps
    mkdir -p "$build_dir"

    print_info "Compiling $program (debug)..."

    # FLOWC_DEBUG_INFO=1: flowc writes a #line directive before every
    # statement, so the debugger steps through the .flow source. The main
    # file is named by its absolute path so LLDB can open it.
    local abs_program
    abs_program="$(cd "$(dirname "$program")" && pwd)/$(basename "$program")"
    if ! FLOWC_DEBUG_INFO=1 FLOWC_CGEN_FILE="$abs_program" flowc_emit_to_c "$program" "$c_file"; then
        print_error "FLOW compilation failed"
        exit 1
    fi
    print_success "FLOW to C (debug): $(basename "$c_file")"

    # -g3 keeps macro info; -fno-omit-frame-pointer helps backtraces.
    if ! FLOW_OPT_LEVEL=0 FLOW_CFLAGS="${FLOW_CFLAGS:-} -g3 -fno-omit-frame-pointer" \
        flowc_link_c "$c_file" "$exe_file" "$program"; then
        print_error "C compilation/linking failed"
        exit 1
    fi
    print_success "Built debug binary: $exe_file"
    print_info "Source maps: #line → $abs_program (statement-level)"
    print_info "C mapping file: $c_file"

    if [ "$no_launch" -eq 1 ]; then
        print_info "Skipping debugger launch (--no-launch). Run manually:"
        print_info "  lldb \"$exe_file\""
        return 0
    fi
    
    # Launch debugger with Flow source path hint
    local break_cmd=""
    local gdb_break=""
    if [ "$break_spec" = "main" ]; then
        break_cmd="breakpoint set --name main"
        gdb_break="break main"
    elif [[ "$break_spec" =~ ^[0-9]+$ ]]; then
        break_cmd="breakpoint set --file \"$abs_program\" --line $break_spec"
        gdb_break="break $abs_program:$break_spec"
    else
        print_error "--break expects 'main' or a numeric Flow line"
        exit 1
    fi

    if command -v lldb &> /dev/null; then
        print_info "Launching LLDB ($break_spec)..."
        print_info "Tip: step with 'n'/'s'; 'frame variable'; 'source list'"
        lldb "$exe_file" -o "settings set target.source-map . \"$(dirname "$abs_program")\"" \
            -o "$break_cmd" -o "run"
    elif command -v gdb &> /dev/null; then
        print_info "Launching GDB ($break_spec)..."
        gdb -ex "$gdb_break" -ex "run" "$exe_file"
    else
        print_warning "No debugger found (lldb/gdb). Install one and run:"
        print_info "  lldb \"$exe_file\""
    fi
}

# Compile + show a `shader fill` demo (Metal window on macOS).
run_fill_shader() {
    local program="$1"
    shift
    local shader_name=""
    local max_frames=0
    local width=1280
    local height=720
    local emit_only=0
    local target=metal
    local layout="--grid"
    while [ $# -gt 0 ]; do
        case "$1" in
            --wgsl)
                target=wgsl
                emit_only=1
                shift
                ;;
            --name)
                shader_name="${2:-}"
                shift 2
                ;;
            --frames)
                max_frames="${2:-0}"
                shift 2
                ;;
            --size)
                local wh="${2:-1280x720}"
                width="${wh%x*}"
                height="${wh#*x}"
                shift 2
                ;;
            --grid)
                layout="--grid"
                shift
                ;;
            --cycle)
                layout="--cycle"
                shift
                ;;
            --emit-only)
                emit_only=1
                shift
                ;;
            *)
                print_error "Unknown shader option: $1"
                exit 1
                ;;
        esac
    done
    print_info "Compiling fill-shader from $program..."
    local shader_out="$SCRIPT_DIR/build/shaders"
    mkdir -p "$shader_out"
    local flowc
    flowc="$(flow_flowc_main)" || exit 1
    local metal_path
    if ! metal_path=$(FLOWC_SHADER="$target" FLOWC_IN="$program" FLOWC_OUT="$shader_out" \
            FLOWC_SHADER_NAME="$shader_name" "$flowc"); then
        printf '%s\n' "$metal_path" >&2
        print_error "Shader compilation failed"
        exit 1
    fi
    metal_path="$(printf '%s\n' "$metal_path" | tail -n 1)"
    if [ "$target" = wgsl ]; then
        print_success "FLOW → WGSL: $metal_path"
        return 0
    fi
    print_success "FLOW → Metal: $(basename "$metal_path")"
    local entries_path="${metal_path%.metal}.entries"
    if [ -f "$entries_path" ]; then
        print_info "Gallery entries: $(wc -l < "$entries_path" | tr -d ' ') shader(s)"
    fi
    if [ "$emit_only" -eq 1 ]; then
        print_info "Emit-only: $metal_path"
        return 0
    fi
    if [[ "$(uname -s)" != "Darwin" ]]; then
        print_error "flow shader viewer requires macOS (Metal). Use --emit-only to generate .metal."
        exit 1
    fi
    local shader_exe="$SCRIPT_DIR/build/flow_shader_host"
    local shader_flow_c="$SCRIPT_DIR/build/runtime_flow/shader_host.c"
    mkdir -p "$SCRIPT_DIR/build/runtime_flow"
    if ! FLOWC_IN="$SCRIPT_DIR/lib/runtime/shader_host.flow" FLOWC_OUT="$shader_flow_c" \
        "$flowc" >"$SCRIPT_DIR/build/.flowc_err" 2>&1; then
        print_error "Failed to transpile shader_host.flow"
        cat "$SCRIPT_DIR/build/.flowc_err" >&2
        exit 1
    fi
    if ! clang -O2 -fobjc-arc -I"$SCRIPT_DIR/runtime" \
        "$SCRIPT_DIR/runtime/shader_host.c" \
        "$shader_flow_c" \
        "$SCRIPT_DIR/runtime/shader_view_metal.m" \
        -framework Metal -framework Cocoa -framework QuartzCore \
        -o "$shader_exe"; then
        print_error "Failed to build shader host"
        exit 1
    fi
    if [ "$layout" = "--grid" ]; then
        print_info "Running shader GRID ${width}x${height} (all at once · click cell / G / Esc)..."
    else
        print_info "Running shader CYCLE ${width}x${height} (←/→ · G for grid · Esc)..."
    fi
    "$shader_exe" "$layout" "$metal_path" "$width" "$height" "$max_frames"
}

# Run program
run_program() {
    flow_parse_program_backend "$@"
    local program="$FLOW_PARSE_PROGRAM"
    local backend="$FLOW_PARSE_BACKEND"
    require_flow_file "$program"
    if ! grep -Eq 'function[[:space:]]+main' "$program"; then
        print_error "This Flow file does not define main() and cannot be run directly."
        print_info "If it is a library or patch, use: flow patch $program"
        return 2
    fi
    flow_sync_program "$program"
    local basename
    basename=$(basename "$program" .flow)

    # Isolate this invocation's build artifacts so two projects that share a
    # source basename (e.g. src/main.flow) cannot clobber each other's
    # executable or generated runtime C when run concurrently (#817). Every
    # compile/runtime path honors FLOW_BUILD_ROOT, so overriding it here threads
    # the isolation through the whole run.
    mkdir -p "$SCRIPT_DIR/build"
    local run_build_root
    run_build_root="$(mktemp -d "$SCRIPT_DIR/build/run.XXXXXX")" || {
        print_error "Could not create an isolated build directory for this run."
        return 1
    }
    # Bake the path into the trap now: run_build_root is function-local and
    # would be out of scope (empty) if expanded at EXIT time.
    trap "rm -rf -- '$run_build_root'" EXIT INT TERM
    export FLOW_BUILD_ROOT="$run_build_root"
    local executable="$run_build_root/$basename"

    if [ "$backend" = "mlir" ]; then
        compile_program_mlir "$program"
    else
        compile_program "$program"
    fi

    print_info "Running $basename..."
    echo "----------------------------------------"
    "$executable"
    status=$?
    echo "----------------------------------------"
    print_success "Program finished"
    echo "Exit code: $status"
    return $status
}

# Compile a patch-library file through a generated executable harness. Corpus
# patches intentionally expose DSP functions rather than defining main().
run_patch_smoke() {
    local patch="${1:-}"
    if [ -z "$patch" ] || [ ! -f "$patch" ]; then
        print_error "Usage: flow patch <patch.flow>"
        return 1
    fi
    local patch_dir
    patch_dir="$(cd "$(dirname "$patch")" && pwd)"
    local patch_name
    patch_name="$(basename "$patch" .flow)"
    local harness_dir="$patch_dir/build/patches"
    local harness="$harness_dir/${patch_name}_smoke.flow"
    mkdir -p "$harness_dir"
    cp "$patch" "$harness_dir/${patch_name}.flow"
    cat > "$harness" <<EOF
import "$(basename "$patch")"

function main() -> i32 {
    println("flow patch smoke: $patch_name compiled")
    return 0
}
EOF
    run_program "$harness"
}

