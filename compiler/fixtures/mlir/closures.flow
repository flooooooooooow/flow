# MLIR parity fixture: lambdas and closures as Python's fat {code, env}
# closure ABI lowers them (mlir_closure_parity.py). Lambdas with and
# without captures, a captured closure (nested capture), closure-typed
# parameters and locals, a named function passed where a closure is
# expected (the __flow_callback_ adapter), and `return void`.

extern {
    function printf(fmt: string, ...) -> i32
}

const BIAS: i32 = 1

function apply(f: (i32) -> i32, x: i32) -> i32 {
    return f(x)
}

function twice(f: (i32) -> i32, x: i32) -> i32 {
    let g: (i32) -> i32 = f
    return g(g(x))
}

function square(x: i32) -> i32 {
    return x * x
}

function fold(f: (f64, f64) -> f64, n: i32) -> f64 {
    let mut acc: f64 = 0.0
    for i in 0 to n {
        acc = f(acc, i as f64)
    }
    return acc
}

function note(x: i32) -> void {
    printf("note %d\n", x)
    return void
}

function main() -> i32 {
    let double: (i32) -> i32 = |x: i32| -> i32 { return x * 2 }
    let mut base: i32 = 10
    let add_base: (i32) -> i32 = |x: i32| -> i32 { return x + base + BIAS }
    base = 100
    let both: (i32) -> i32 = |x: i32| -> i32 {
        let y: i32 = double(x)
        return add_base(y)
    }
    let sum: (f64, f64) -> f64 = |a: f64, b: f64| -> f64 { return a + b * 0.5 }
    printf("%d\n", apply(double, 21))
    printf("%d\n", apply(add_base, 5))
    printf("%d\n", both(4))
    printf("%d\n", twice(double, 3))
    printf("%d\n", apply(square, 7))
    printf("%f\n", fold(sum, 5))
    note(3)
    return 0
}
