# MLIR parity fixture: struct literals, field reads and writes, nested
# structs, struct parameters and struct returns.

struct Vec2 {
    x: f64,
    y: f64
}

struct Body {
    pos: Vec2,
    vel: Vec2,
    mass: f64,
    id: i32
}

function vec2(x: f64, y: f64) -> Vec2 {
    return Vec2 { x: x, y: y }
}

function add(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x + b.x, y: a.y + b.y }
}

function dot(a: Vec2, b: Vec2) -> f64 {
    return a.x * b.x + a.y * b.y
}

function step(b: Body, dt: f64) -> Body {
    let mut next: Body = b
    next.pos.x = b.pos.x + b.vel.x * dt
    next.pos.y = b.pos.y + b.vel.y * dt
    return next
}

function main() -> i32 {
    let a: Vec2 = vec2(1.0, 2.0)
    let b: Vec2 = Vec2 { x: 0.5, y: 4.0 }
    let c: Vec2 = add(a, b)
    println(c.x)
    println(c.y)
    println(dot(a, b))

    let mut body: Body = Body { pos: a, vel: b, mass: 2.0, id: 7 }
    body = step(body, 0.5)
    println(body.pos.x)
    println(body.pos.y)
    println(body.id)
    body.id = body.id * 3
    body.mass = body.mass + 1.0
    println(body.id)
    println(body.mass)

    let partial: Body = Body { id: 1 }
    println(partial.mass)
    return 0
}
