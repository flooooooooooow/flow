# MLIR parity fixture: arrays of structs, array fields built from literals,
# uninitialized arrays (memref.alloca), memref indexing, and a pointer loop
# with a runtime bound (a literal bound would take Python's linalg.generic
# rewrite, whose unrealized_conversion_cast does not translate to LLVM IR).

extern {
    function malloc(n: i64) -> ptr<u8>
}

struct P {
    x: i32,
    y: f32
}

struct Box {
    vals: array<i32, 4>,
    n: i32
}

function sum(ps: array<P, 3>) -> i32 {
    let mut s: i32 = 0
    for i in 0 to 3 {
        s = s + ps[i].x
    }
    return s
}

function add4(out: ptr<f32>, a: ptr<f32>, b: ptr<f32>, n: i32) {
    for i in 0 to n {
        out[i] = a[i] + b[i]
    }
}

function main() -> i32 {
    let mut ps: array<P, 3> = [P { x: 1, y: 1.0 }, P { x: 2, y: 2.0 }, P { x: 3, y: 3.0 }]
    ps[1].x = 20
    let q: P = ps[2]
    let b: Box = Box { vals: [1, 2, 3, 4], n: 4 }
    println(sum(ps) + q.x + b.vals[3])
    let mut buf: array<i32, 8>
    for i in 0 to 8 {
        buf[i] = i * 2
    }
    let mut t: i32 = 0
    for j in 0 to 8 {
        t = t + buf[j]
    }
    println(t)
    let fa: ptr<f32> = malloc(16) as ptr<f32>
    let fb: ptr<f32> = malloc(16) as ptr<f32>
    let fc: ptr<f32> = malloc(16) as ptr<f32>
    for k in 0 to 4 {
        fb[k] = 1.5
        fc[k] = 2.0
    }
    add4(fa, fb, fc, 4)
    println(fa[3])
    return 0
}
