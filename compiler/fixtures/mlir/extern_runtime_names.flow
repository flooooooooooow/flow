# MLIR parity fixture: a program's externs for names the backend's own
# helpers declare or define. The #740 memory profiler declares getenv and
# defines flow_mem_note_arena (lib/stdlib/memory.flow declares it as an
# extern); each symbol must appear once.

extern {
    function getenv(name: string) -> string
    function malloc(size: i64) -> ptr<u8>
    function free(p: ptr<u8>) -> void
    function flow_mem_note_arena(n: i64) -> void
}

function main() -> i32 {
    let p: ptr<u8> = malloc(16)
    flow_mem_note_arena(16)
    p[0] = 7
    println(p[0] as i32)
    free(p)
    let v: string = getenv("FLOW_FIXTURE_SURELY_UNSET")
    let vp: ptr<u8> = v
    if vp == null {
        println(1)
    }
    return 0
}
