# MLIR parity fixture for the wasm32 ABI (FLOWC_MLIR_SIZE_T=32, Python
# --wasm32): libc size_t parameters and results narrow to i32, aggregates
# skip the alloca round trip, and closure environments size with i32. A
# wasm_* fixture is also checked in that mode (compiler/scripts/parity_mlir.flow).

extern {
    function malloc(size: i64) -> ptr<u8>
    function strlen(s: string) -> i64
    function memset(p: ptr<u8>, c: i32, n: i64) -> ptr<u8>
}

struct Point {
    x: i32,
    y: i32
}

function mid(a: Point, b: Point) -> Point {
    return Point { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 }
}

function apply(f: (i32) -> i32, v: i32) -> i32 {
    return f(v)
}

function main() -> i32 {
    let buf: ptr<u8> = malloc(16)
    let _z: ptr<u8> = memset(buf, 0, 16)
    let n: i64 = strlen("hello")
    let p: Point = mid(Point { x: 0, y: 0 }, Point { x: 4, y: 6 })
    let k: i32 = 5
    let r: i32 = apply(|v: i32| -> i32 { return v + k }, 2)
    return (n as i32) + p.x + p.y + r
}
