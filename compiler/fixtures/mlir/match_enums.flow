# MLIR parity fixture: match arms (literal, negative literal, bool, string,
# wildcard, binding, struct, enum variant, guarded or-patterns, default) and
# enums as tagged structs.

struct Pair {
    a: i32,
    b: i32
}

enum Shape {
    Circle(i32),
    Square,
    Line
}

function classify(n: i32) -> i32 {
    match n {
        0 => { return 10 }
        -1 => { return 11 }
        1 | 2 | 3 => { return 12 }
        x if x > 100 => { return 13 }
        default { return 14 }
    }
}

function truth(b: bool) -> i32 {
    match b {
        true => { return 1 }
        false => { return 0 }
    }
    return 7
}

function pair_sum(p: Pair) -> i32 {
    let mut r: i32 = 0
    match p {
        Pair(x, y) => { r = x + y }
    }
    return r
}

function shape_code(s: Shape) -> i32 {
    match s {
        Shape_Circle => { return 1 }
        Shape_Square => { return 2 }
        _ => { return 3 }
    }
}

function tag_of(t: i32) -> i32 {
    let mut out: i32 = 0
    match t {
        Shape_Line => { out = 30 }
        n => { out = n }
    }
    return out
}

function main() -> i32 {
    println(classify(0))
    println(classify(0 - 1))
    println(classify(2))
    println(classify(500))
    println(classify(50))
    println(truth(true) + truth(false))
    let p: Pair = Pair { a: 3, b: 4 }
    println(pair_sum(p))
    let c: Shape = Shape { tag: Shape_Circle, Circle_value: 5 }
    let q: Shape = Shape { tag: Shape_Square, Circle_value: 0 }
    println(shape_code(c) * 10 + shape_code(q))
    println(tag_of(Shape_Line) + tag_of(4))
    return 0
}
