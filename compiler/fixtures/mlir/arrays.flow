# MLIR parity fixture: fixed arrays (!llvm.array allocas), array
# parameters, element loads and stores, and pointer indexing.

function total(xs: array<i32, 5>) -> i32 {
    let mut s: i32 = 0
    let mut i: i32 = 0
    while i < 5 {
        s = s + xs[i]
        i = i + 1
    }
    return s
}

function scale(p: ptr<f64>, n: i32, k: f64) -> f64 {
    let mut acc: f64 = 0.0
    for i in 0 to n {
        acc = acc + p[i] * k
    }
    return acc
}

function main() -> i32 {
    let mut xs: array<i32, 5> = [3, 1, 4, 1, 5]
    println(total(xs))
    xs[2] = 40
    let j: i32 = 4
    xs[j] = xs[j] + 100
    println(total(xs))
    println(xs[2] + xs[4])

    let wide: array<i64, 3> = [1, 2, 3]
    let mut w: i64 = 0
    for k in 0 to 3 {
        w = w + wide[k] * 1000000
    }
    println(w)

    let fs: array<f64, 4> = [0.5, 1.5, 2.5, 3.5]
    println(scale(fs, 4, 2.0))

    let flags: array<bool, 2> = [true, false]
    if flags[0] {
        println("first")
    }
    return 0
}
