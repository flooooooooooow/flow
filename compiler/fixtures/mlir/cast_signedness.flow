# MLIR parity fixture: `a as u64` for an i64 a reads the same bits as
# unsigned without changing a. The emitter used to mark a's own value
# unsigned, so a later `a < 0` compared unsigned and was false
# (tests/lang/test_dynamic_invariants check 24).

extern {
    function printf(fmt: string, ...) -> i32
}

function magnitude(v: i64) -> u64 {
    if v >= 0 {
        return v as u64
    }
    return (0 as u64) - (v as u64)
}

function distance(a: i64, b: i64) -> u64 {
    if a >= 0 and b < 0 {
        return (a as u64) + magnitude(b)
    }
    if a < 0 and b >= 0 {
        return magnitude(a) + (b as u64)
    }
    if a >= b {
        return (a - b) as u64
    }
    return (b - a) as u64
}

function main() -> i32 {
    let mut x: i32 = -5
    let ux: u32 = x as u32
    let neg: bool = x < 0
    let d: u64 = distance(-3, 4)
    let e: u64 = distance(2, 9)
    printf("%d %u %llu %llu\n", if neg { 1 } else { 0 }, ux, d, e)
    if not neg or d != 7 or e != 7 {
        return 1
    }
    return 0
}
