# MLIR parity fixture: locals held as SSA values (no `mut`, no alloca) merged
# at joins: scf.if yields, cf block arguments on if/elif and loop exits,
# loop-carried block arguments, scf.for iter_args, break and continue.

function merges(n: i32) -> i32 {
    let mut acc: i32
    acc = 0
    let mut i: i32
    i = 0
    while i < n {
        if i > 3 {
            acc = acc + i
        } else {
            acc = acc - 1
        }
        i = i + 1
    }
    for j in 0 to n {
        acc = acc + j
    }
    for k in 0 to n {
        if k == 2 {
            continue
        }
        if k == 7 {
            break
        }
        acc = acc + 1
    }
    # The elif tests read `probe`, not `acc`: Python evaluates them with the
    # then-arm's bindings still in place.
    let probe: i32 = acc
    if probe > 100 {
        acc = 100
    } elif probe > 50 {
        acc = 50
    } else {
        acc = acc * 2
    }
    return acc
}

function pick(x: i32) -> i32 {
    let mut y: i32
    y = x
    if x > 2 {
        y = 5
    }
    return y
}

function params(a: i32, b: i32) -> i32 {
    a = a + b
    if a > 10 {
        b = 1
    }
    return a * 100 + b
}

function main() -> i32 {
    println(merges(10))
    println(merges(3))
    println(pick(3) + pick(1))
    println(params(4, 9))
    return 0
}
