# MLIR parity fixture: vector literals become vector.from_elements and
# convert to the declared vecN<T>, also as either operand of an operator.

extern {
    function printf(fmt: string, ...) -> i32
}

function lit_f32() -> vec4<f32> {
    return <1.0, 2.0, 3.0, 4.0>
}

function ops_f32() -> vec4<f32> {
    let a: vec4<f32> = <1.0, 2.0, 3.0, 4.0>
    let b: vec4<f32> = a * <0.5, 0.5, 0.5, 0.5>
    let c: vec4<f32> = <1.0, 1.0, 1.0, 1.0> + b
    return c - a
}

function ops_i64() -> vec2<i64> {
    let a: vec2<i64> = <1, 2>
    return a + <10, 20>
}

function main() -> i32 {
    let x: vec4<f32> = lit_f32()
    let y: vec4<f32> = ops_f32()
    let z: vec2<i64> = ops_i64()
    printf("vectors built\n")
    return 0
}
