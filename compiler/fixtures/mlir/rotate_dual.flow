# MLIR parity fixture: counted `while true` loops rotated as
# mlir_canonicalize does, a loop that stays unrotated, and arithmetic on a
# struct of floats (dual numbers), which Python types as the struct.

struct Dual {
    val: f32,
    grad: f32
}

function countdown(start: i32) -> i32 {
    let mut total: i32 = 0
    let mut n: i32 = start
    while true {
        total = total + n
        if n == 0 {
            break
        }
        n = n - 1
    }
    return total
}

function first_over(limit: i32) -> i32 {
    let mut i: i32 = 0
    while true {
        if i * i > limit {
            break
        }
        i = i + 1
    }
    return i
}

function scale(d: Dual, k: f32) -> Dual {
    return Dual { val: d.val * k, grad: d.grad * k }
}

function main() -> i32 {
    println(countdown(10))
    println(first_over(50))
    let d: Dual = Dual { val: 2.0, grad: 1.0 }
    let e: Dual = scale(d, 3.0)
    println(e.val)
    return 0
}
