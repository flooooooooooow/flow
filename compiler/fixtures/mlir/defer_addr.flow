# MLIR parity fixture: defer (block exit, break, return with its value
# computed first) and address-of on locals, fields and array elements.

struct Counter {
    hits: i32,
    last: i32
}

function note(tag: i32) {
    printf("defer %d\n", tag)
}

function bump(p: ptr<i32>) {
    p[0] = p[0] + 1
}

function deferred(n: i32) -> i32 {
    defer note(1)
    let mut i: i32 = 0
    while i < n {
        defer note(2)
        if i == 2 {
            break
        }
        i = i + 1
    }
    defer note(3)
    return i * 10
}

function main() -> i32 {
    println(deferred(5))
    let mut x: i32 = 41
    bump(&x)
    println(x)
    let mut c: Counter = Counter { hits: 0, last: 0 }
    bump(&c.hits)
    bump(&c.hits)
    println(c.hits)
    let mut xs: array<i32, 3> = [1, 2, 3]
    bump(&xs[1])
    println(xs[1])
    let y: i32 = 5
    let py: ptr<i32> = &y
    println(py[0])
    return 0
}
