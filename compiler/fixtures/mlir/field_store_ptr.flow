# MLIR parity fixture: a store to a field reached through a pointer field
# (`o.cfg.n = 9` with cfg: ptr<Inner>) writes where the pointer points, as
# C's o->cfg->n = 9. The emitter used to drop such a store.

extern {
    function printf(fmt: string, ...) -> i32
    function malloc(size: i64) -> ptr<void>
}

struct Inner {
    n: i32,
    m: i32
}

struct Outer {
    cfg: ptr<Inner>,
    k: i32
}

struct Top {
    mid: ptr<Outer>
}

function main() -> i32 {
    let i: ptr<Inner> = malloc(8) as ptr<Inner>
    i.n = 1
    i.m = 2
    let o: ptr<Outer> = malloc(16) as ptr<Outer>
    o.cfg = i
    o.k = 3
    let t: ptr<Top> = malloc(8) as ptr<Top>
    t.mid = o
    o.cfg.n = 9
    t.mid.cfg.m = t.mid.cfg.m + 40
    t.mid.k = 5
    printf("%d %d %d\n", i.n, i.m, o.k)
    if i.n != 9 or i.m != 42 or o.k != 5 {
        return 1
    }
    return 0
}
