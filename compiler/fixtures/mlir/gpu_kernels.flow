# MLIR parity fixture for the GPU dialect (FLOWC_MLIR_GPU=1, Python's
# --mlir-gpu): @gpu kernels leave the host module and form gpu.module
# @flow_kernels. Thread and block ids, memref loads and stores, if/else,
# a counted loop with a loop-carried sum, and a barrier. The gate compares
# text only for gpu_* fixtures.

@gpu
function saxpy(x: array<f32>, y: array<f32>, a: f32, n: i32) {
    let i = gpu_thread_id()
    if i < n {
        y[i] = a * x[i] + y[i]
    } else {
        return
    }
}

@gpu
function row_sum(m: array<f32>, out: array<f32>, cols: i32) {
    let r = gpu_block_id()
    let mut acc: f32 = 0.0
    for j in 0 to cols {
        acc = acc + m[r * cols + j]
    }
    gpu_barrier()
    out[r] = acc
}

@gpu
function tiles(buf: array<i32>) {
    let t = gpu_local_id()
    let b = gpu_block_size()
    buf[t] = b - 1
}

function main() -> i32 {
    println(3)
    return 0
}
