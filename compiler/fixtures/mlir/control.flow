# MLIR parity fixture: if/elif/else, while, break and continue.

function classify(x: i32) -> i32 {
    if x < 0 {
        return 0 - 1
    } elif x == 0 {
        return 0
    } elif x < 10 {
        return 1
    } else {
        return 2
    }
}

function first_multiple(n: i32, k: i32) -> i32 {
    let mut i: i32 = 1
    while i < n {
        if i % k == 0 {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

function collatz(start: i32) -> i32 {
    let mut n: i32 = start
    let mut steps: i32 = 0
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2
        } else {
            n = 3 * n + 1
        }
        steps = steps + 1
    }
    return steps
}

function main() -> i32 {
    println(classify(0 - 5))
    println(classify(0))
    println(classify(7))
    println(classify(70))
    println(first_multiple(50, 13))
    println(first_multiple(5, 13))
    println(collatz(27))

    let mut i: i32 = 0
    let mut odd_sum: i32 = 0
    while i < 20 {
        i = i + 1
        if i % 2 == 0 {
            continue
        }
        if i > 15 {
            break
        }
        odd_sum = odd_sum + i
    }
    println(odd_sum)

    let mut a: i32 = 0
    let mut total: i32 = 0
    while a < 4 {
        let mut b: i32 = 0
        while b < a {
            total = total + a * b
            b = b + 1
        }
        a = a + 1
    }
    println(total)

    let flag: bool = total > 10
    if flag {
        println("large")
    } else {
        println("small")
    }
    return 0
}
