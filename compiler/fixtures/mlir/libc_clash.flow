# MLIR parity fixture: a Flow definition named like a libc function the C
# backend renames for the whole unit (abs, random, index, ...) is the one
# every call reaches, as stdlib/math.flow's abs(x: f32) is under C. The
# emitter used to call libc's integer abs, so abs(-0.25) was 0.

extern {
    function printf(fmt: string, ...) -> i32
}

function abs(x: f32) -> f32 {
    if x < 0.0 {
        return -x
    }
    return x
}

function random() -> i32 {
    return 4
}

function main() -> i32 {
    let a: f32 = abs(-0.25)
    let b: f32 = abs(1.5)
    printf("%f %f %d\n", a as f64, b as f64, random())
    if a != 0.25 or random() != 4 {
        return 1
    }
    return 0
}
