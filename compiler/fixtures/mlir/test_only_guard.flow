# Flow-native language test: @only / @guard build-mode guards (#1029).
#
# A C build has the modes `compile` and `c` active. A function whose guard
# names none of them is not part of the build, so two definitions of the
# same function under different guards compile to one, as they did on the
# Python host (`_function_allowed` in its transpiler).
# Exit 0 on success; a nonzero exit identifies the failing check.

@only(jit)
function pick() -> i32 {
    return 1
}

@only(compile)
function pick() -> i32 {
    return 2
}

@guard(hot, interp)
function mode_name() -> i32 {
    return 10
}

@c
function mode_name() -> i32 {
    return 20
}

# A string argument names a mode too.
@only("mlir")
function shape() -> i32 {
    return 100
}

@only("jit", "c")
function shape() -> i32 {
    return 200
}

# A guard combines with other attributes and with `export`.
@guard(jit, c)
@inline
export function tag() -> i32 {
    return 3
}

# Only in a hot-reload build; never called here, so dropping it is the
# only way it can be absent without breaking the build.
@hot
function reload_hook() -> i32 {
    return undefined_in_c_builds()
}

function main() -> i32 {
    if pick() != 2 {
        return 1
    }
    if mode_name() != 20 {
        return 2
    }
    if shape() != 200 {
        return 3
    }
    if tag() != 3 {
        return 4
    }
    return 0
}
