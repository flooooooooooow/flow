# MLIR parity fixture: integer widths, unsigned ops, floats and casts.

function mix(a: i32, b: i64) -> i64 {
    return a as i64 * b + 7
}

function udiv(a: u32, b: u32) -> u32 {
    return a / b
}

function umod(a: u8, b: u8) -> u8 {
    return a % b
}

function shifts(x: i32) -> i32 {
    let left: i32 = x << 3
    let right: i32 = left >> 1
    return right ^ (x & 12) | 1
}

function ushift(x: u32) -> u32 {
    return x >> 4
}

function fmix(x: f64, y: f32) -> f64 {
    return x * 2.5 + y as f64 - 0.25
}

function main() -> i32 {
    let a: i32 = 40
    let b: i32 = -3
    println(a + b)
    println(a - b * 2)
    println(a / b)
    println(a % 7)
    println(mix(a, 100000))
    let big: u32 = 4000000000
    println(udiv(big, 3) as i64)
    let small: u8 = 250
    println(umod(small, 7) as i32)
    println(shifts(9))
    println(ushift(big) as i64)
    let h: i16 = 300
    let w: i64 = h as i64 * 1000
    println(w)
    let f: f64 = fmix(1.5, 0.5)
    println(f)
    let g: f32 = 3.0
    println(g * 2.0)
    let n: i32 = f as i32
    println(n)
    let neg: f64 = -f
    println(neg)
    let bits: i32 = ~a
    println(bits)
    if big > 3000000000 {
        println("unsigned compare")
    }
    return 0
}
