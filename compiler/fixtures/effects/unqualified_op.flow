# Effects parity fixture: an operation called without its effect name.

effect Log {
    info(msg: string) -> void,
}

capability Console {
    effect Log,
    function info(msg: string) -> void {
        printf("[console] %s\n", msg)
    },
}

function main() -> i32 {
    handle Log with Console {
        info("x")
    }
    return 0
}
