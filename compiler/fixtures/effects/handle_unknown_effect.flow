# Effects parity fixture: handle names an effect that does not exist.

effect Log {
    info(msg: string) -> void,
}

capability Console {
    effect Log,
    function info(msg: string) -> void {
        printf("[console] %s\n", msg)
    },
}

function main() -> i32 {
    handle Nope with Console {
        printf("inside\n")
    }
    return 0
}
