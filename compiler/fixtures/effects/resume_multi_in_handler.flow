# Effects parity fixture: reserved resume_multi form in a capability method (#564).

effect Probe {
    mark(x: i32) -> i32,
}

capability Multi {
    effect Probe,
    function mark(x: i32) -> i32 {
        resume_multi(x)
        return x
    },
}

function main() -> i32 {
    handle Probe with Multi {
        let n: i32 = Probe.mark(0)
    }
    return 0
}
