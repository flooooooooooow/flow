# Effects parity fixture: a capability method prints its own parameters with
# their declared types, the same as a plain function would.

effect Progress {
    on_start(idx: i32, total: i32, label: string) -> void,
    ratio(done: f64) -> f64,
}

capability ConsoleProgress {
    effect Progress,
    function on_start(idx: i32, total: i32, label: string) -> void {
        println(idx)
        println(total)
        println(label)
    },
    function ratio(done: f64) -> f64 {
        println(done)
        return done * 2.0
    },
}

function main() -> i32 {
    handle Progress with ConsoleProgress {
        Progress.on_start(1, 5, "hello")
        let r: f64 = Progress.ratio(0.25)
        println(r)
    }
    return 0
}
