
unit Meter
unit Second
unit Kilogram
unit Radian
unit Velocity = Meter / Second
unit Accel = Meter / Second^2

        function main() -> i32 {
            let d: Meter = 1.0 as Meter
            let t: Second = 2.0 as Second
            let a1: Accel = d / t / t
            let a2: Accel = d / (t * t)
            return 0
        }
        
