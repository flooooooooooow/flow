
unit Meter
unit Second
unit Velocity = Meter / Second
unit Accel = Meter / Second^2

        function ratio(a: Meter, b: Meter) -> f64 {
            return a / b
        }
        function main() -> i32 {
            let r: f64 = ratio(4.0 as Meter, 2.0 as Meter)
            let scaled: f64 = r * 3.0
            return 0
        }
        
