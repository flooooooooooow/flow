
unit Meter
unit Second
unit Velocity = Meter / Second
unit Accel = Meter / Second^2

        function speed(d: Meter, t: Second) -> Velocity {
            return d / t
        }
        function main() -> i32 {
            let v: Velocity = speed(100.0 as Meter, 8.0 as Second)
            return 0
        }
        
