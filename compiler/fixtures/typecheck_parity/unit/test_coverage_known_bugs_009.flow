
trait Averager {
    function average(self) -> f32
}

struct RunningStats {
    sum: f32,
    count: i32
}

impl Averager for RunningStats {
    function average(self) -> f32 {
        return self.sum / self.count
    }
}

        function main() -> f32 {
            let stats: RunningStats = RunningStats { sum: 9.0, count: 3 }
            return stats.average()
        }
        
