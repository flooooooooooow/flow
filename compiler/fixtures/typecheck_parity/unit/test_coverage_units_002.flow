
unit Meter
unit Second
unit Velocity = Meter / Second
unit Accel = Meter / Second^2

        function accel_of(d: Meter, t: Second) -> Accel {
            return d / t / t
        }
        function main() -> i32 {
            let a: Accel = accel_of(1.0 as Meter, 2.0 as Second)
            return 0
        }
        
