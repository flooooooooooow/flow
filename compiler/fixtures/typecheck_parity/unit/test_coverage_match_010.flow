
            struct Pair { a: i32, b: i32, }
            function f(p: Pair) -> i32 {
                match p {
                    Pair(0, b) => { return b }
                    Pair(a, 0) => { return a }
                    Pair(a, b) => { return a + b }
                }
                return -1
            }
            function main() -> i32 {
                let p: Pair = Pair { a: 0, b: 7 }
                return f(p) - 7
            }
            
