
        function is_even(n: i32) -> i32 {
            if n == 0 { return 1 }
            return is_odd(n - 1)
        }
        function is_odd(n: i32) -> i32 {
            if n == 0 { return 0 }
            return is_even(n - 1)
        }
        function main() -> i32 { return is_even(4) }
        
