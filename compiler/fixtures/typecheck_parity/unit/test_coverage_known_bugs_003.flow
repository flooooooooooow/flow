
effect Scale {
    apply(x: i32) -> i32,
}

capability Doubler {
    effect Scale,
    function apply(x: i32) -> i32 {
        return x * 2
    },
}

        effect Offset {
            shift(x: i32) -> i32,
        }

        function main() -> i32 {
            handle Scale with Doubler {
                let b: i32 = Offset.shift(1)
            }
            return 0
        }
        
