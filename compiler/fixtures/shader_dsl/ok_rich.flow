# Every statement and expression form, both targets.
fn pulse(t: f32, speed: f32) -> f32 {
    return 0.5 + 0.5 * sin(t * speed)
}

fn shade(p: vec2, k: i32) -> vec3 {
    var acc: vec3 = vec3(0.0)
    for i in 0 to k {
        acc = acc + palette(length(p) + f32(i) * .1)
    }
    if length(p) > 1. { return acc * 0.5 } else if length(p) > 0.5 { return acc } else { return -acc }
}

shader fill rich {
    let p: vec2 = uv * 2.0 - vec2(1.0)
    let q = p.yx; let r = p.x
    var col: vec3 = shade(p, 3) * pulse(time, 2.0)
    let n = noise(p * 4.0) + fbm(p) + hash(p) + hash(r)
    let m = mod(r, 0.25) + fmod(r, 0.5) + r % 0.3 + saturate(r) + rsqrt(2.0)
    let b = !(r < 0.0) && (r >= 0.1 || r != 0.2) && r == r && r <= 3
    let aspect = resolution.x / resolution.y
    if b {
        col = col + vec3(n, m, aspect)
    }
    for j in 0 to 2 { col = col * 0.9 }
    color = vec4(col, i32(1.0))
    color = vec4(color.rgb, bool(1))
}
