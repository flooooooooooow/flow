# An `always` clause traps once the state leaves its range: exit 1 and the
# clause text on stderr, on both hosts.

flow Guard {
    state x : f64 = 0.0
    x evolves as 1.0
    always {
        x < 0.5   # "half" \ limit
    }
    never { x < 0.0 }
}

function main() -> i32 {
    let mut g: Guard = Guard_new()
    for i in 0 to 1000 {
        Guard_step(&g, 0.01)
        println(i)
    }
    return 0
}
