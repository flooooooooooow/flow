flow Tick {
    state t : f64 = 0.0
    state n : f64 = 0.0
    state m : f64 = 0.0
    param p : f64 = 1.0
    t evolves as 1.0
    every 10 ms {
        n becomes n + 1.0
        m becomes n
    }
    every 1.5 s {
        m becomes 0.0
    }
    when t reaches p * 2.0 {
        n becomes 0.0
    }
    when t reaches 3.0 { m becomes -1.0 }
}
