# Runs on both hosts; the output is recorded from the Python host.
# Values print as scaled integers so both hosts format them the same.

extern {
    function fabs(x: f64) -> f64
    function sin(x: f64) -> f64
}

flow Osc {
    state x : f64 = 1.0
    state v : f64 = 0.0
    param k : f64 = 4.0
    output energy : f64 = 0.5 * v * v + 0.5 * k * x * x
    x evolves as v
    v evolves as -k * x
}

flow Osc4 {
    state x : f64 = 1.0
    state v : f64 = 0.0
    param k : f64 = 4.0
    solver { dt 1 ms method rk4 }
    x evolves as v
    v evolves as -k * x
}

flow Pend32 {
    state a : f32 = 0.5
    state w : f32 = 0.0
    solver { method rk4 dt 2 ms }
    a evolves as w
    w evolves as -9.81 * sin(a as f64) as f32
}

flow Bounce {
    state h : f64 = 1.0
    state v : f64 = 0.0
    state hits : f64 = 0.0
    param g : f64 = 9.81
    h evolves as v
    v evolves as -g
    when h reaches 0.0 {
        v becomes -v * 0.5
        hits becomes hits + 1.0
    }
}

flow Tick {
    state n : f64 = 0.0
    state m : f64 = 0.0
    every 10 ms {
        n becomes n + 1.0
    }
    every 25 ms { m becomes m + n }
}

flow Gain {
    input x : f64
    state s : f64 = 0.0
    param k : f64 = 2.0
    output y : f64 = k * x
}

flow Lag {
    input w : f64
    state z : f64 = 0.0
    output out : f64 = z
    z evolves as 10.0 * (w - z)
}

flow Chain {
    input signal : f64
    output result : f64 = signal |> Gain { k: 3.0 } |> Lag
}

flow Motor {
    input volts : f64
    state w : f64 = 0.0
    output speed : f64 = w
    w evolves as volts - w
}

flow Ctrl {
    input meas : f64
    state i : f64 = 0.0
    param target : f64 = 1.0
    output u : f64 = 2.0 * (target - meas) + i
    i evolves as target - meas
}

flow Loop {
    plant : Motor
    ctl : Ctrl
    connect {
        plant.speed -> ctl.meas
        ctl.u -> plant.volts
    }
}

flow Driven {
    input cmd : f64
    m : Motor
    connect {
        cmd -> m.volts
    }
}

function show(v: f64) {
    println((v * 1000000.0) as i32)
}

function main() -> i32 {
    let mut o: Osc = Osc_new()
    let mut o4: Osc4 = Osc4_new()
    let mut p: Pend32 = Pend32_new()
    let mut b: Bounce = Bounce_new()
    let mut t: Tick = Tick_new()
    let mut ch: Chain = Chain_new()
    let mut lp: Loop = Loop_new()
    let mut dr: Driven = Driven_new()
    for i in 0 to 1000 {
        Osc_step(&o, 0.001)
        Osc4_step(&o4, Osc4_default_dt())
        Pend32_step(&p, Pend32_default_dt())
        Bounce_step(&b, 0.001)
        Tick_step(&t, 0.001)
        ch.signal = 1.0
        Chain_step(&ch, 0.001)
        Loop_step(&lp, 0.001)
        dr.cmd = 2.0
        Driven_step(&dr, 0.001)
    }
    show(o.x)
    show(o.v)
    show(o.energy)
    show(o4.x)
    show(o4.v)
    show(p.a as f64)
    show(p.w as f64)
    show(b.h)
    show(b.hits)
    show(t.n)
    show(t.m)
    show(ch.result)
    show(lp.plant.w)
    show(lp.ctl.i)
    show(dr.m.w)
    show(Osc_default_dt())
    show(Tick_default_dt())
    return 0
}
