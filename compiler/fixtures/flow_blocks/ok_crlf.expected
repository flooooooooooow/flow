struct Osc { x: f64 }
@flow_api function Osc_new() -> Osc { let mut __self: Osc = Osc { x: 0.0 }; Osc_init(&__self); return __self; }
@flow_api function Osc_init(self: ptr<Osc>) -> void { self.x = 1.0; }
@flow_api function Osc_derivs(self: ptr<Osc>, d_x: ptr<f64>) -> void { d_x[0] = -self.x; } @flow_api function Osc_step(self: ptr<Osc>, dt: f64) -> void { let mut d_x: f64 = 0.0; Osc_derivs(self, &d_x); self.x = self.x + d_x * dt; } @flow_api function Osc_default_dt() -> f64 { return 0.001; }
