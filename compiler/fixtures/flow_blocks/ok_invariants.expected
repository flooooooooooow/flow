struct Guarded { x: f64 }
@flow_api function Guarded_new() -> Guarded { let mut __self: Guarded = Guarded { x: 0.0 }; Guarded_init(&__self); return __self; }
@flow_api function Guarded_init(self: ptr<Guarded>) -> void { self.x = 0.0; }
@flow_api function Guarded_derivs(self: ptr<Guarded>, d_x: ptr<f64>) -> void { d_x[0] = 1.0; }
@flow_api function Guarded_step(self: ptr<Guarded>, dt: f64) -> void { let mut d_x: f64 = 0.0; Guarded_derivs(self, &d_x); self.x = self.x + d_x * dt; let __viol: i32 = Guarded_check(self); if __viol == 1 { flow_panic("Guarded:5: invariant violated: x < 10.0   # \"quoted\" \\ backslash"); } if __viol == 2 { flow_panic("Guarded:6: invariant violated: x >= 0.0 and x == x"); } if __viol == 3 { flow_panic("Guarded:10: invariant violated: true"); } if __viol == 4 { flow_panic("Guarded:9: invariant violated: x > 100.0"); } }
@flow_api function Guarded_default_dt() -> f64 { return 0.001; }
@flow_api function Guarded_check(self: ptr<Guarded>) -> i32 { if !(self.x < 10.0) { return 1; } if !(self.x >= 0.0 and self.x == self.x) { return 2; } if !(true) { return 3; } if (self.x > 100.0) { return 4; } return 0; }




