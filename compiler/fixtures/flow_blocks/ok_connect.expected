struct Motor { w: f64, v: f64, speed: f64 }
@flow_api function Motor_new() -> Motor { let mut __self: Motor = Motor { w: 0.0, v: 0.0, speed: 0.0 }; Motor_init(&__self); return __self; }
@flow_api function Motor_init(self: ptr<Motor>) -> void { self.v = 0.0; self.w = 0.0; Motor_outputs(self); }
@flow_api function Motor_derivs(self: ptr<Motor>, d_w: ptr<f64>) -> void { d_w[0] = self.v - self.w; }
@flow_api function Motor_step(self: ptr<Motor>, dt: f64) -> void { let mut d_w: f64 = 0.0; Motor_derivs(self, &d_w); self.w = self.w + d_w * dt; Motor_outputs(self); }
@flow_api function Motor_default_dt() -> f64 { return 0.001; } @flow_api function Motor_outputs(self: ptr<Motor>) -> void { self.speed = self.w; }

struct Ctrl { i: f64, meas: f64, u: f64, target: f64 }
@flow_api function Ctrl_new() -> Ctrl { let mut __self: Ctrl = Ctrl { i: 0.0, meas: 0.0, u: 0.0, target: 0.0 }; Ctrl_init(&__self); return __self; }
@flow_api function Ctrl_init(self: ptr<Ctrl>) -> void { self.target = 1.0; self.meas = 0.0; self.i = 0.0; Ctrl_outputs(self); }
@flow_api function Ctrl_derivs(self: ptr<Ctrl>, d_i: ptr<f64>) -> void { d_i[0] = self.target - self.meas; }
@flow_api function Ctrl_step(self: ptr<Ctrl>, dt: f64) -> void { let mut d_i: f64 = 0.0; Ctrl_derivs(self, &d_i); self.i = self.i + d_i * dt; Ctrl_outputs(self); }
@flow_api function Ctrl_default_dt() -> f64 { return 0.001; }
@flow_api function Ctrl_outputs(self: ptr<Ctrl>) -> void { self.u = self.target - self.meas + self.i; }

struct Loop { plant: Motor, ctl: Ctrl, ref: f64 }
@flow_api function Loop_new() -> Loop { let mut __self: Loop = Loop { plant: Motor_new(), ctl: Ctrl_new(), ref: 0.0 }; Loop_init(&__self); return __self; }
@flow_api function Loop_init(self: ptr<Loop>) -> void { self.ref = 1.0; Motor_init(&self.plant); Ctrl_init(&self.ctl); }
@flow_api function Loop_derivs(self: ptr<Loop>) -> void { }
@flow_api function Loop_step(self: ptr<Loop>, dt: f64) -> void { self.ctl.meas = self.plant.speed; Ctrl_step(&self.ctl, dt); self.plant.v = self.ctl.u; Motor_step(&self.plant, dt); }
@flow_api function Loop_default_dt() -> f64 { return 0.001; }




struct Driven { m: Motor, cmd: f64 }
@flow_api function Driven_new() -> Driven { let mut __self: Driven = Driven { m: Motor_new(), cmd: 0.0 }; Driven_init(&__self); return __self; }
@flow_api function Driven_init(self: ptr<Driven>) -> void { self.cmd = 0.0; Motor_init(&self.m); }
@flow_api function Driven_derivs(self: ptr<Driven>) -> void { }
@flow_api function Driven_step(self: ptr<Driven>, dt: f64) -> void { self.m.v = self.cmd; Motor_step(&self.m, dt); }
@flow_api function Driven_default_dt() -> f64 { return 0.001; }

