struct Pair {
    a: f64,
    b: f64
}

struct Mid { x: f64 }
@flow_api function Mid_new() -> Mid { let mut __self: Mid = Mid { x: 0.0 }; Mid_init(&__self); return __self; }
@flow_api function Mid_init(self: ptr<Mid>) -> void { self.x = 0.0; }
@flow_api function Mid_derivs(self: ptr<Mid>, d_x: ptr<f64>) -> void { d_x[0] = 2.0; } @flow_api function Mid_step(self: ptr<Mid>, dt: f64) -> void { let mut d_x: f64 = 0.0; Mid_derivs(self, &d_x); self.x = self.x + d_x * dt; } @flow_api function Mid_default_dt() -> f64 { return 0.001; }

function after() -> f64 {
    return 1.0
}
