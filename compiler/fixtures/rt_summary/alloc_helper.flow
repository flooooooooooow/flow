# Imported helper whose body allocates. The caller's checker must consult
# the compact summary rather than treating the import as empty (#765).

extern {
    function malloc(size: i64) -> ptr<void>
}

export function heap_touch(n: i32) -> i32 {
    let p: ptr<void> = malloc(16)
    if p == null {
        return n
    }
    return n + 1
}
