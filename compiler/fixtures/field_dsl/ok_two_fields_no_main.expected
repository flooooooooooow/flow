import "stdlib/dynamics/pde.flow"
# Two fields, one without a boundary (defaults to 0.0), no main().
const K: i32 = 3

# generated from field A : f64[4] on Line
const A_field_n: i32 = 4

function A_field_step(
    u: ptr<f64>,
    next: ptr<f64>,
    r: f64
) -> void {
    heat_euler_step_1d(u, next, 4, r, 0.0, 0.0)
}

# generated from field B : f64[10] on Line
const B_field_n: i32 = 10

function B_field_step(
    u: ptr<f64>,
    next: ptr<f64>,
    r: f64
