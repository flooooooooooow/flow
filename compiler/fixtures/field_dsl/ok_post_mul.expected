import "stdlib/dynamics/pde.flow"
const alpha: f64 = 0.3


# generated from field V : f64[8] on Line
const V_field_n: i32 = 8

function V_field_step(
    u: ptr<f64>,
    next: ptr<f64>,
    r: f64
) -> void {
    heat_euler_step_1d(u, next, 8, r, 0.5, 1.5)
}

function main() -> i32 {
    return V_field_n
}