# Tensor-scalar broadcasts lower to linalg.generic with a zero-rank operand.

extern {
    function tensor_scale(a: tensor_f32, s: f32) -> tensor_f32
    function tensor_add_scalar(a: tensor_f32, s: f32) -> tensor_f32
}

function ops(a: tensor_f32, s: f32) -> tensor_f32 {
    let x: tensor_f32 = tensor_scale(a, s)
    return tensor_add_scalar(x, s)
}
