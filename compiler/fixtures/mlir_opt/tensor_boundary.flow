# Tensor results cross user-defined function boundaries as value semantics.

extern {
    function tensor_add(a: tensor_f32, b: tensor_f32) -> tensor_f32
}

function add_once(a: tensor_f32, b: tensor_f32) -> tensor_f32 {
    return tensor_add(a, b)
}

function pipeline(a: tensor_f32, b: tensor_f32) -> tensor_f32 {
    let x: tensor_f32 = add_once(a, b)
    return add_once(x, b)
}
