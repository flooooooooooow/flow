# A reserved word used as a parameter name. Stage-A must reject it with a
# file:line:col diagnostic that names the word (#970). `to` is a name
# outside a for range (#1068), so the fixture uses `while`.
function link(start: i32, while: i32) -> i32 {
    return start + while
}

function main() -> i32 {
    return link(1, 2)
}
