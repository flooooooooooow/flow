# expect: ok
# Every impl of the `@rt_safe` trait method process is RT-safe, so an
# `@rt_safe` caller may dispatch to it (#766). describe has no contract
# and may allocate.
extern { function malloc(size: i64) -> ptr<u8> }

trait Processor {
    @rt_safe
    function process(self, x: f32) -> f32
    function describe(self) -> i32
}

struct Gain {
    g: f32
}

struct Offset {
    d: f32
}

impl Processor for Gain {
    function process(self, x: f32) -> f32 {
        return x * self.g
    }
    function describe(self) -> i32 {
        let p: ptr<u8> = malloc(8)
        if p == null { return 0 }
        return 1
    }
}

impl Processor for Offset {
    function process(self, x: f32) -> f32 {
        return x + self.d
    }
    function describe(self) -> i32 {
        return 2
    }
}

@rt_safe
function run(g: Gain, o: Offset, x: f32) -> f32 {
    return o.process(g.process(x))
}

function main() -> i32 {
    let g: Gain = Gain { g: 2.0 }
    let o: Offset = Offset { d: 1.0 }
    if run(g, o, 1.5) != 4.0 {
        return 1
    }
    return 0
}
