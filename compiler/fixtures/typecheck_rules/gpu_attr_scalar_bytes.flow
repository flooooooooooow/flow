# expect: [GPU031] GpuVertexAttribute field 'scalar_bytes': attribute scalars are 2 or 4 bytes, got 3
import "stdlib/gpu_resource_types.flow"

function main() -> i32 {
    let a: GpuVertexAttribute = GpuVertexAttribute {
        location: 0, offset: 0, stride: 20,
        scalar_bytes: 3, components: 3
    }
    if gpu_vertex_attribute_valid(a) { return 1 }
    return 0
}
