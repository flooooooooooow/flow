# expect: ok
# A program's own struct named like a GPU descriptor is not checked by the
# GPU rules (#811): only the library's declarations are.
struct GpuTextureDesc {
    dimension: i32,
    format: i32,
    width: i32,
    height: i32,
    layers: i32,
    samples: i32,
    usage: i32
}

function main() -> i32 {
    let t: GpuTextureDesc = GpuTextureDesc {
        dimension: 99, format: 99, width: 0, height: 0,
        layers: 0, samples: 3, usage: 0
    }
    return t.width
}
