# expect: [GPU011] GpuSamplerDesc field 'address_v': unknown address mode 3 (expected GPU_ADDRESS_CLAMP or GPU_ADDRESS_REPEAT)
import "stdlib/gpu_resource_types.flow"

function main() -> i32 {
    let s: GpuSamplerDesc = GpuSamplerDesc {
        min_filter: GPU_FILTER_NEAREST, mag_filter: GPU_FILTER_LINEAR,
        address_u: GPU_ADDRESS_CLAMP, address_v: 3,
        address_w: GPU_ADDRESS_CLAMP
    }
    if gpu_sampler_valid(s) { return 1 }
    return 0
}
