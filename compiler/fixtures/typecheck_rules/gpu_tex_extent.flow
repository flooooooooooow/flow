# expect: [GPU007] GpuTextureDesc field 'width': texture width 0 is outside 1..16384
import "stdlib/gpu_resource_types.flow"

function main() -> i32 {
    let t: GpuTextureDesc = GpuTextureDesc {
        dimension: GPU_TEX_2D, format: GPU_FORMAT_RGBA8,
        width: 0, height: 8, layers: 1, samples: 1,
        usage: GPU_USE_SAMPLED
    }
    if gpu_texture_valid(t) { return 1 }
    return 0
}
