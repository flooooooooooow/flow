# expect: lifetime domain escape: `scratch` lives in the `callback` domain but is stored in `holder`, which lives in the `application` domain (a longer-lived domain may not hold a reference to a shorter-lived one) at line 13, column 5
struct Box {
    p: ptr<i32>
}

@lifetime(application)
let mut holder: Box = Box { p: null }

@lifetime(callback)
function tick() {
    let mut scratch: array<i32, 4> = [0; 4]
    holder.p = scratch
}

function main() -> i32 {
    return 0
}
