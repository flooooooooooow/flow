# expect: Unhandled effect 'Log.info' in 'work': wrap in `handle Log with ...`, declare `with Log` on the function, or omit --strict-effects to allow zero defaults
# env: FLOWC_STRICT_EFFECTS=1
effect Log {
    info(msg: string) -> void
}

function work() -> i32 {
    Log.info("hi")
    return 0
}

function main() -> i32 {
    return work()
}
