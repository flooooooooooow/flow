# expect: [GPU002] GpuTextureDesc field 'format': unknown texture format 9 (expected rgba8, rgba16f or depth32f)
import "stdlib/gpu_resource_types.flow"

function main() -> i32 {
    let t: GpuTextureDesc = GpuTextureDesc {
        dimension: GPU_TEX_2D, format: 9,
        width: 8, height: 8, layers: 1, samples: 1,
        usage: GPU_USE_SAMPLED
    }
    if gpu_texture_valid(t) { return 1 }
    return 0
}
