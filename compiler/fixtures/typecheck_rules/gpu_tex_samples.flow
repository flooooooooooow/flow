# expect: [GPU005] GpuTextureDesc field 'samples': sample count 3 is not 1, 2, 4 or 8
import "stdlib/gpu_resource_types.flow"

function main() -> i32 {
    let t: GpuTextureDesc = GpuTextureDesc {
        dimension: GPU_TEX_2D, format: GPU_FORMAT_RGBA8,
        width: 8, height: 8, layers: 1, samples: 3,
        usage: GPU_USE_COLOR_ATTACHMENT
    }
    if gpu_texture_valid(t) { return 1 }
    return 0
}
