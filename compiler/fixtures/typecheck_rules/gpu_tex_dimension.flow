# expect: [GPU001] GpuTextureDesc field 'dimension': unknown texture dimension 7 (expected GPU_TEX_2D or GPU_TEX_CUBE)
import "stdlib/gpu_resource_types.flow"

function main() -> i32 {
    let t: GpuTextureDesc = GpuTextureDesc {
        dimension: 7, format: GPU_FORMAT_RGBA8,
        width: 8, height: 8, layers: 1, samples: 1,
        usage: GPU_USE_SAMPLED
    }
    if gpu_texture_valid(t) { return 1 }
    return 0
}
