# expect: [GPU060] gpu_stage_links: fragment input at location 2 has no vertex output
import "stdlib/gpu_resource_types.flow"

function main() -> i32 {
    let uv: GpuVarying = GpuVarying { location: 0, scalar: GPU_SCALAR_F32, components: 2, interpolation: GPU_INTERPOLATE_PERSPECTIVE }
    let vs: array<GpuVarying, 2> = [
        uv,
        GpuVarying { location: 1, scalar: GPU_SCALAR_F32, components: 3, interpolation: GPU_INTERPOLATE_PERSPECTIVE }
    ]
    let fs: array<GpuVarying, 2> = [
        uv,
        GpuVarying { location: 2, scalar: GPU_SCALAR_F32, components: 3, interpolation: GPU_INTERPOLATE_PERSPECTIVE }
    ]
    if gpu_stage_links(&vs[0], 2, &fs[0], 2) { return 1 }
    return 0
}
