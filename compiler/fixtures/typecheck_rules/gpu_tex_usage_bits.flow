# expect: [GPU003] GpuTextureDesc field 'usage': usage 0 is not a nonempty set of GPU_USE_* bits
import "stdlib/gpu_resource_types.flow"

function main() -> i32 {
    let t: GpuTextureDesc = GpuTextureDesc {
        dimension: GPU_TEX_2D, format: GPU_FORMAT_RGBA8,
        width: 8, height: 8, layers: 1, samples: 1,
        usage: 0
    }
    if gpu_texture_valid(t) { return 1 }
    return 0
}
