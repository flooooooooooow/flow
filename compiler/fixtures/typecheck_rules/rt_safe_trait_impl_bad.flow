# expect: RT-safety violation: 'Leaky_Processor_process' implements the rt_safe trait method 'Processor.process' but calls 'malloc', which is forbidden on an RT-safe path (heap, device/file I/O, GPU, or blocking lock; see docs/library/rt-safety.md)
# A trait method declared `@rt_safe` is a contract on every impl (#766):
# Leaky's process allocates, so it breaks the contract. describe has no
# contract, so Gain's allocating describe is fine.
extern { function malloc(size: i64) -> ptr<u8> }

trait Processor {
    @rt_safe
    function process(self, x: f32) -> f32
    function describe(self) -> i32
}

struct Gain {
    g: f32
}

struct Leaky {
    g: f32
}

impl Processor for Gain {
    function process(self, x: f32) -> f32 {
        return x * self.g
    }
    function describe(self) -> i32 {
        let p: ptr<u8> = malloc(8)
        if p == null { return 0 }
        return 1
    }
}

impl Processor for Leaky {
    function process(self, x: f32) -> f32 {
        let p: ptr<u8> = malloc(16)
        if p == null { return x }
        return x * self.g
    }
    function describe(self) -> i32 {
        return 2
    }
}

function main() -> i32 {
    return 0
}
