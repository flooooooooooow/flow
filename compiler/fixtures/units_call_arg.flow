# Negative fixture (#1008): a Meter passed where a Velocity is declared.
unit Meter
unit Second
unit Velocity = Meter / Second

function travel(v: Velocity, t: Second) -> Meter {
    return v * t
}

function main() -> i32 {
    let d: Meter = 1.0 as Meter
    let t: Second = 2.0 as Second
    let x: Meter = travel(d, t)
    return 0
}
