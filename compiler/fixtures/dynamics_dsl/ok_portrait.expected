import "stdlib/gfx.flow"
import "stdlib/dynamics/portrait.flow"
flow Lorenz {
    state x : f64 = 1.0
    state z : f64 = 1.0
    x evolves as z
    z evolves as 0.0 - x
}


# generated from represent phase_portrait for Lorenz
const Lorenz_portrait_trail: i32 = 200
const Lorenz_portrait_win_w: i32 = 640
const Lorenz_portrait_win_h: i32 = 480

function Lorenz_portrait_frame(
    g: Gfx,
    xs: ptr<f64>,
    zs: ptr<f64>,
    head: ptr<i32>,
    count: ptr<i32>,
    x: f64,
    z: f64
) -> void {
    trail_push_2d(xs, zs, 200, head, count, x, z)
    let h: i32 = head[0]
    let c: i32 = count[0]
    gfx_clear(g, 8, 8, 16)
    for i in 0 to c {
        let idx: i32 = trail_index(h, c, 200, i)
        let px: i32 = project_axis(xs[idx], -25.0, 25.0, 640, 10)
        let py: i32 = project_axis(zs[idx], 1e-05, 0.0, 480, 30)
        let b: i32 = 25 + (230 * (i + 1)) / c
        let mut size: i32 = 2
        if i >= c - 12 { size = 3 }
        gfx_fill_rect(g, px, py, size, size, b, (b * 3) / 5, 30)
    }
    let hx: i32 = project_axis(x, -25.0, 25.0, 640, 10)
    let hz: i32 = project_axis(z, 1e-05, 0.0, 480, 30)
    gfx_fill_rect(g, hx - 1, hz - 1, 5, 5, 255, 240, 180)
}

function main() -> i32 {
    return 0
}