import "stdlib/gfx.flow"
import "stdlib/dynamics/portrait.flow"
flow Osc {
    state a : f64 = 1.0
    state b : f64 = 0.0
}

# generated from represent phase_portrait for Osc
const Osc_portrait_trail: i32 = 320
const Osc_portrait_win_w: i32 = 900
const Osc_portrait_win_h: i32 = 700

function Osc_portrait_frame(
    g: Gfx,
    xs: ptr<f64>,
    zs: ptr<f64>,
    head: ptr<i32>,
    count: ptr<i32>,
    a: f64,
    b: f64
) -> void {
    trail_push_2d(xs, zs, 320, head, count, a, b)
    let h: i32 = head[0]
    let c: i32 = count[0]
    gfx_clear(g, 8, 8, 16)
    for i in 0 to c {
        let idx: i32 = trail_index(h, c, 320, i)
        let px: i32 = project_axis(xs[idx], 0.3, 0.1, 900, 10)
        let py: i32 = project_axis(zs[idx], -2.0, 2e+20, 700, 30)
        let b: i32 = 25 + (230 * (i + 1)) / c
        let mut size: i32 = 2
        if i >= c - 12 { size = 3 }
        gfx_fill_rect(g, px, py, size, size, b, (b * 3) / 5, 30)
    }
    let hx: i32 = project_axis(a, 0.3, 0.1, 900, 10)
    let hz: i32 = project_axis(b, -2.0, 2e+20, 700, 30)
    gfx_fill_rect(g, hx - 1, hz - 1, 5, 5, 255, 240, 180)
}
