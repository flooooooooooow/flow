# Regression: the dynamics DSL history buffer must match the GA generation count.

dsys plant {
    discrete
    dt 0.1
    n 2 m 1 p 1
    A 1.0 0.1 0.0 1.0
    B 0.0 0.1
    C 1.0 0.0
}

horizon rollout finite 20

ga evolve on plant over rollout -> k1 k2 {
    population 8
    generations 40
    mutation 0.25
}
