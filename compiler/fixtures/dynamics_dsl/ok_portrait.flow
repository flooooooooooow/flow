flow Lorenz {
    state x : f64 = 1.0
    state z : f64 = 1.0
    x evolves as z
    z evolves as 0.0 - x
    represent phase_portrait(x, z) {
        trail 200
        window 640, 480
        map x in [-25.0, 25.0] -> col
        map z in [0, 1e-05] -> row
    }
}

function main() -> i32 {
    return 0
}
