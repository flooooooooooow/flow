flow Pendulum {
    state angle : f64 = 0.1
    state velocity : f64 = 0.0
    angle evolves as velocity
    velocity evolves as 0.0 - 9.81 * angle
    represent linear {
        at (angle: 0.0, velocity: 0.0)
        inputs (torque)
        outputs (angle)
        A 0.0 1.0 -9.81 0.0
        B 0.0 1.0
    }
    represent nonlinear {
        anything
    }
}
horizon rollout finite 40
sense on Pendulum_lin {
    spectral -> rho
}
function main() -> i32 {
    return 0
}
