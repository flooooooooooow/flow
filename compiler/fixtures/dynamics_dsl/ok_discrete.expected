import "stdlib/dynamics/ga_analysis.flow"




function main() -> i32 {
    # --- dsys DSL expansion (auto-generated) ---
    let h_rollout: Horizon = horizon_finite(50)
    let h_forever: Horizon = horizon_infinite(0.94999999999999996)
    let __dsys_plant_A: array<f64, 4> = [1.0, 0.10000000000000001, 0.0, 1.0]
    let __dsys_plant_B: array<f64, 2> = [0.0, 0.10000000000000001]
    let __dsys_plant_C: array<f64, 2> = [1.0, 0.0]
    let __dsys_plant: DynamicalSystem = dsys_discrete(2, 1, 1, 0.10000000000000001, Matrix { data: __dsys_plant_A, rows: 2, cols: 2 }, Matrix { data: __dsys_plant_B, rows: 2, cols: 1 }, Matrix { data: __dsys_plant_C, rows: 1, cols: 2 })
    let plant: DynamicalSystem = __dsys_plant
    let __dsys_b0: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let __dsys_b1: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let __dsys_b2: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let __dsys_b3: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let __dsys_b4: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let mut plant_ok: i32 = 0
    plant_ok = is_controllable(__dsys_plant, __dsys_b0, __dsys_b1, __dsys_b2, __dsys_b3, __dsys_b4)
    let mut rho_open: f64 = 0.0
    rho_open = matrix_spectral_radius_2x2(__dsys_plant.A)
    let __dsys_b5: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let __dsys_b6: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let __dsys_b7: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let __dsys_b8: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let mut W_fin: f64 = 0.0
    let __W_W_fin: Matrix = gramian_finite_horizon(__dsys_plant, h_rollout, __dsys_b5, __dsys_b6, __dsys_b7, __dsys_b8)
    W_fin = matrix_trace(__W_W_fin)
    let __dsys_b9: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let __dsys_b10: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let __dsys_b11: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let __dsys_b12: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let mut W_inf: f64 = 0.0
    let __W_W_inf: Matrix = gramian_infinite_horizon(__dsys_plant, h_forever, __dsys_b9, __dsys_b10, __dsys_b11, __dsys_b12)
    W_inf = matrix_trace(__W_W_inf)
    # --- end dsys DSL expansion ---

    println(plant_ok)
    return 0
}