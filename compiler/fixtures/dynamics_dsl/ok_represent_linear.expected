import "stdlib/dynamics/ga_analysis.flow"

flow Pendulum {
    state angle : f64 = 0.1
    state velocity : f64 = 0.0
    angle evolves as velocity
    velocity evolves as 0.0 - 9.81 * angle
}
function main() -> i32 {
    # --- dsys DSL expansion (auto-generated) ---
    let h_rollout: Horizon = horizon_finite(40)
    let __dsys_Pendulum_lin_A: array<f64, 4> = [0.0, 1.0, -9.8100000000000005, 0.0]
    let __dsys_Pendulum_lin_B: array<f64, 2> = [0.0, 1.0]
    let __dsys_Pendulum_lin_C: array<f64, 4> = [1.0, 0.0, 0.0, 1.0]
    let __dsys_Pendulum_lin_cont: DynamicalSystem = dsys_continuous(2, 1, 2, 0.001, Matrix { data: __dsys_Pendulum_lin_A, rows: 2, cols: 2 }, Matrix { data: __dsys_Pendulum_lin_B, rows: 2, cols: 1 }, Matrix { data: __dsys_Pendulum_lin_C, rows: 2, cols: 2 })
    let __dsys_b0: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let __dsys_b1: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let __dsys_b2: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let __dsys_b3: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let __dsys_b4: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let __dsys_Pendulum_lin: DynamicalSystem = dsys_euler_discretize(__dsys_Pendulum_lin_cont, __dsys_b0, __dsys_b1, __dsys_b2, __dsys_b3)
    let Pendulum_lin: DynamicalSystem = __dsys_Pendulum_lin
    let mut rho: f64 = 0.0
    rho = matrix_spectral_radius_2x2(__dsys_Pendulum_lin.A)
    # --- end dsys DSL expansion ---

    return 0
}