# Stage-A emit + cc smoke for the examples/basics programs that use the
# Stage-A subset.
#
# Reports PASS/FAIL per file (emit, cc, run). It does not stop at the first
# error: it prints a summary table and exits 1 if any case failed.
#
#   ./flow tool compiler/scripts/emit_basics.flow
#
# Env:
#   FLOWC_FORCE_HOST=1  emit with the flowc built from compiler/src
#   FLOWC_EMIT_ONLY=1   skip running the binaries (emit and cc only)

import "tools/flow_cli/sys.flow"
import "compiler/scripts/gate_lib.flow"
import std.process { ProcCmd, ProcResult, ProcStrs, proc_timeout_ms }

# Emit `src` to `c_out` with stdout and stderr discarded; the status.
function stage_a_emit(host: string, src: string, c_out: string) -> i32 {
    let mut argv: ptr<ProcStrs> = sl_new()
    let use_host: bool = is_file("compiler/src/main.flow")
    if s_eq(env("FLOWC_FORCE_HOST"), "1") and use_host {
        argv = sl_of1(host)
    } elif is_exec("compiler/build/stage_a_driver_flow") {
        argv = sl_of3("./compiler/build/stage_a_driver_flow", src, c_out)
    } elif is_exec("compiler/build/stage_a_driver") {
        argv = sl_of3("./compiler/build/stage_a_driver", src, c_out)
    } elif use_host {
        argv = sl_of1(host)
    } else {
        return 1
    }
    if sl_len(argv) == 1 {
        env_set("FLOWC_IN", src)
        env_set("FLOWC_OUT", c_out)
    }
    let c: ptr<ProcCmd> = cmd(argv)
    cmd_quiet(c)
    return run(c)
}

function main() -> i32 {
    let root: string = gate_enter()
    gate_mkdir("compiler/build/basics")
    let host: string = gate_flowc_host(root)

    # name|expected exit|path. fibonacci and hello_world are the user-facing
    # pair; the rest are other Stage-A-clean basics for wider C coverage.
    let cases: ptr<ProcStrs> = sl_new()
    sl_push(cases, "fibonacci|55|examples/basics/fibonacci.flow")
    sl_push(cases, "hello_world|0|examples/basics/hello_world.flow")
    sl_push(cases, "factorial|120|examples/basics/factorial.flow")
    sl_push(cases, "gcd|14|examples/basics/gcd.flow")
    sl_push(cases, "palindrome|1|examples/basics/palindrome.flow")
    sl_push(cases, "prime_numbers|10|examples/basics/prime_numbers.flow")
    sl_push(cases, "loops|50|examples/basics/loops.flow")
    sl_push(cases, "power|0|examples/basics/power.flow")
    sl_push(cases, "bubble_sort|2|examples/basics/bubble_sort.flow")
    sl_push(cases, "simple_search|5|examples/basics/simple_search.flow")

    let mut pass: i32 = 0
    let mut failed: i32 = 0
    let results: ptr<ProcStrs> = sl_new()

    outln("=== emit_basics (Stage-A) ===")
    outln("")

    let mut i: i32 = 0
    while i < sl_len(cases) {
        let f: ptr<ProcStrs> = s_split(sl_get(cases, i), 124)
        let name: string = sl_get(f, 0)
        let want_code: i32 = s_atoi(sl_get(f, 1), 0)
        let src: string = sl_get(f, 2)
        let c_out: string = "compiler/build/basics/" + name + ".c"
        let bin: string = "compiler/build/basics/" + name
        let mut status: string = "PASS"
        let mut detail: string = ""

        let emit_rc: i32 = stage_a_emit(host, src, c_out)
        if emit_rc != 0 or not is_file(c_out) {
            status = "FAIL"
            detail = "emit failed (rc=" + s_itoa(emit_rc) + ")"
        } else {
            let cc: ptr<ProcCmd> = cmd(sl_of3("cc", "-O0", "-o"))
            sl_push2(cc.argv, bin, c_out)
            cmd_quiet_err(cc)
            if run(cc) != 0 {
                status = "FAIL"
                detail = "cc failed"
            } elif s_eq(env("FLOWC_EMIT_ONLY"), "1") {
                detail = "emit+cc ok (run skipped)"
            } else {
                # A ten-second wall-clock limit per program.
                let rc: ptr<ProcCmd> = cmd(sl_of1(bin))
                proc_timeout_ms(rc, 10000)
                let r: ptr<ProcResult> = run_result(rc)
                if r.timed_out {
                    status = "FAIL"
                    detail = "run timed out"
                } elif r.exit_code != want_code {
                    status = "FAIL"
                    detail = "exit=" + s_itoa(r.exit_code) + " (want " + s_itoa(want_code) + ")"
                } else {
                    detail = "exit=" + s_itoa(r.exit_code)
                }
            }
        }

        if s_eq(status, "PASS") {
            pass = pass + 1
        } else {
            failed = failed + 1
        }
        sl_push(results, status + "|" + name + "|" + detail)
        outln(status + "  " + name + "  " + detail)
        i = i + 1
    }

    outln("")
    outln("---- emit_basics summary ----")
    outln(pad_right("STATUS", 6) + " " + pad_right("FILE", 16) + " DETAIL")
    outln(pad_right("------", 6) + " " + pad_right("----------------", 16) + " ------")
    let mut j: i32 = 0
    while j < sl_len(results) {
        let row: ptr<ProcStrs> = s_split(sl_get(results, j), 124)
        outln(pad_right(sl_get(row, 0), 6) + " " + pad_right(sl_get(row, 1), 16) + " " + sl_get(row, 2))
        j = j + 1
    }
    outln("pass=" + s_itoa(pass) + " fail=" + s_itoa(failed))
    outln("")

    if failed != 0 {
        outln("FAIL emit_basics")
        return 1
    }
    outln("PASS emit_basics")
    return 0
}
