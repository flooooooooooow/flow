# Parity gate for `flow bpf` and `flow wasm32` (scripts/tools/llvm_target).
#
# Runs every case in tests/targets/cases.txt through `./flow bpf` or
# `./flow wasm32` with stub `python` and `python3` first on PATH
# (each logs its arguments and exits 127), and compares the exit status,
# stderr and the SHA-256 of the written object with the goldens in
# tests/targets/expected. The goldens were captured from the Python modules
# this tool replaced (src/flow/bpf_target.py, src/flow/wasm_compiler.py).
#
# Normalisation, applied to the tool's stderr before comparing:
#   - exit status 2 (usage errors): only the "error:" line, without the
#     program name (argparse printed `bpf_target.py: error: ...`);
#   - the case's output directory reads @OUTDIR@;
#   - compare=first cases keep only the first line (the rest is compiler
#     diagnostics from the lowering, which name a different front end).
#
# Needs clang with the BPF and WebAssembly targets, wasm-ld, mlir-opt and
# mlir-translate (Homebrew llvm on macOS; LLVM_PATH or PATH elsewhere).
#
#   ./flow tool compiler/scripts/parity_targets.flow [bpf|wasm32] [--portable]
#
# A tool name runs only that tool's cases. --portable is for a toolchain
# other than the one the goldens came from (Homebrew LLVM 22 on macOS): it
# skips the object checksums and compares only the first line of stderr, so
# the exit statuses and messages are still checked but not the bytes clang
# writes or the text of its diagnostics.

import "tools/flow_cli/sys.flow"
import "compiler/scripts/gate_lib.flow"
import std.process { ProcCmd, ProcResult, ProcStrs, proc_cmd, proc_args, proc_run, proc_chdir, proc_stdin, proc_stdout, proc_stderr, PROC_NULL, PROC_INHERIT, PROC_CAPTURE }

extern {
    function malloc(size: i64) -> ptr<void>
}

const USAGE_NAME: string = "./flow tool compiler/scripts/parity_targets.flow"
const EXP: string = "tests/targets/expected"

# The command that runs one tool: `bpf` or `wasm32`.
function target_cmd(tool: string) -> ptr<ProcStrs> {
    return sl_of2("./flow", tool)
}

# The tools are built here once, outside the cases.
function build_target_tool() -> bool {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "tool", "--path")
    sl_push(argv, "llvm_target")
    let c: ptr<ProcCmd> = cmd(argv)
    cmd_quiet_out(c)
    return run(c) == 0
}

function hex_val(c: i32) -> i32 {
    if c >= 48 and c <= 57 {
        return c - 48
    }
    if c >= 97 and c <= 102 {
        return c - 87
    }
    if c >= 65 and c <= 70 {
        return c - 55
    }
    return 0 - 1
}

# printf '%b': backslash escapes in `s` (\\ \a \b \e \f \n \r \t \v, \0nnn
# octal, \xHH hex).
function printf_b(s: string) -> string {
    let p: ptr<u8> = s as ptr<u8>
    let n: i32 = s_len(s)
    let out: ptr<u8> = malloc((n + 1) as i64) as ptr<u8>
    let mut o: i32 = 0
    let mut i: i32 = 0
    while i < n {
        let c: i32 = p[i] as i32
        if c != 92 or i + 1 >= n {
            out[o] = p[i]
            o = o + 1
            i = i + 1
            continue
        }
        let e: i32 = p[i + 1] as i32
        i = i + 2
        let mut v: i32 = 0 - 1
        if e == 92 {
            v = 92
        } elif e == 97 {
            v = 7
        } elif e == 98 {
            v = 8
        } elif e == 101 {
            v = 27
        } elif e == 102 {
            v = 12
        } elif e == 110 {
            v = 10
        } elif e == 114 {
            v = 13
        } elif e == 116 {
            v = 9
        } elif e == 118 {
            v = 11
        } elif e == 48 {
            v = 0
            let mut k: i32 = 0
            while k < 3 and i < n and p[i] >= 48 and p[i] <= 55 {
                v = v * 8 + (p[i] as i32 - 48)
                i = i + 1
                k = k + 1
            }
        } elif e == 120 and i < n and hex_val(p[i] as i32) >= 0 {
            v = hex_val(p[i] as i32)
            i = i + 1
            if i < n and hex_val(p[i] as i32) >= 0 {
                v = v * 16 + hex_val(p[i] as i32)
                i = i + 1
            }
        }
        if v < 0 {
            out[o] = 92
            out[o + 1] = e as u8
            o = o + 2
        } else {
            out[o] = v as u8
            o = o + 1
        }
    }
    out[o] = 0
    return out as string
}

# Fields of a cases.txt line split on '|', as `IFS='|' read -r a b c d`
# does: the last takes the rest of the line.
function case_fields(line: string) -> ptr<ProcStrs> {
    let out: ptr<ProcStrs> = sl_new()
    let mut rest: string = line
    let mut k: i32 = 0
    while k < 3 {
        let at: i32 = s_find_byte(rest, 124, 0)
        if at < 0 {
            sl_push(out, rest)
            rest = ""
        } else {
            sl_push(out, s_slice(rest, 0, at))
            rest = s_from(rest, at + 1)
        }
        k = k + 1
    }
    sl_push(out, rest)
    return out
}

# The text of `path` without trailing newlines (`$(cat path)`).
function cat_value(path: string) -> string {
    return s_chomp_all(read_text(path))
}

function first_line_of(text: string) -> string {
    let at: i32 = s_find_byte(text, 10, 0)
    if at < 0 {
        return text
    }
    return s_slice(text, 0, at + 1)
}

function main() -> i32 {
    let root0: string = gl_enter_root()
    let args: ptr<ProcStrs> = proc_args()
    let mut only: string = ""
    let mut portable: bool = false
    let mut a: i32 = 0
    while a < sl_len(args) {
        let arg: string = sl_get(args, a)
        if s_eq(arg, "bpf") or s_eq(arg, "wasm32") {
            only = arg
        } elif s_eq(arg, "--portable") {
            portable = true
        } else {
            errln("usage: " + USAGE_NAME + " [bpf|wasm32] [--portable]")
            return 2
        }
        a = a + 1
    }
    let root: string = abs_dir_physical(root0)
    let _cd: bool = proc_chdir(root)

    if have("brew") {
        let bc: ptr<ProcCmd> = cmd(sl_of3("brew", "--prefix", "llvm"))
        cmd_quiet_err(bc)
        let prefix: string = capture(bc)
        if not s_empty(prefix) and is_exec(prefix + "/bin/clang") {
            env_set("PATH", prefix + "/bin:" + env("PATH"))
        }
    }
    let llvm_path: string = env("LLVM_PATH")
    if not s_empty(llvm_path) {
        env_set("PATH", llvm_path + ":" + env("PATH"))
    }

    let work: string = mktemp_dir(env_or("TMPDIR", "/tmp") + "/flow-targets.XXXXXX")
    on_exit_remove(work)
    let stub_dir: string = work + "/bin"
    let log: string = work + "/python-calls.log"
    mkdir_p_or_exit(stub_dir)
    mkdir_p_or_exit(work + "/out")
    let _l: bool = write_text(log, "")
    let stubs: ptr<ProcStrs> = sl_of2("python", "python3")
    let mut s: i32 = 0
    while s < 2 {
        let name: string = sl_get(stubs, s)
        let stub: string = stub_dir + "/" + name
        let _w: bool = write_text(stub, "#!/bin/sh\necho \"" + name + " $*\" >> \"" + log + "\"\nexit 127\n")
        let _m: bool = set_mode(stub, 493)
        s = s + 1
    }
    env_set("PATH", stub_dir + ":" + env("PATH"))

    # Build the tool once, outside the timed cases.
    if not build_target_tool() {
        errln("parity_targets: could not build scripts/tools/llvm_target")
        cli_exit(1)
    }

    let mut pass: i32 = 0
    let mut fail: i32 = 0
    let lines: ptr<ProcStrs> = gl_lines(read_text("tests/targets/cases.txt"))
    let mut li: i32 = 0
    while li < sl_len(lines) {
        let f: ptr<ProcStrs> = case_fields(sl_get(lines, li))
        li = li + 1
        let name: string = s_strip_all_space(sl_get(f, 0))
        let tool: string = s_strip_all_space(sl_get(f, 1))
        let mut cmp: string = s_strip_all_space(sl_get(f, 2))
        let case_args: string = sl_get(f, 3)
        if s_empty(name) or s_starts(name, "#") {
            continue
        }
        if not s_empty(only) and not s_eq(tool, only) {
            continue
        }
        if portable {
            cmp = "first"
        }
        let outp: string = work + "/out/" + name + ".out"
        let argv: ptr<ProcStrs> = target_cmd(tool)
        let words: ptr<ProcStrs> = s_words(case_args)
        let mut w: i32 = 0
        while w < sl_len(words) {
            let mut word: string = sl_get(words, w)
            word = s_replace(word, "@OUT@", outp)
            word = s_replace(word, "@SP@", " ")
            sl_push(argv, printf_b(word))
            w = w + 1
        }
        let c: ptr<ProcCmd> = cmd(argv)
        proc_stdin(c, PROC_NULL)
        proc_stderr(c, PROC_CAPTURE)
        let r: ptr<ProcResult> = proc_run(c)
        let rc: i32 = gl_status(r, false)
        let raw: string = r.stderr
        let _rw: bool = write_text(work + "/" + name + ".raw", raw)
        let mut err: string = raw
        if rc == 2 {
            let kept: ptr<ProcStrs> = sl_new()
            let rl: ptr<ProcStrs> = gl_lines(raw)
            let mut q: i32 = 0
            while q < sl_len(rl) {
                let l: string = sl_get(rl, q)
                if s_contains(l, ": error: ") {
                    let at: i32 = s_find(l, ": error: ", 0)
                    let colon: i32 = s_find_byte(l, 58, 0)
                    if colon == at {
                        sl_push(kept, "error: " + s_from(l, at + 9))
                    } else {
                        sl_push(kept, l)
                    }
                }
                q = q + 1
            }
            err = gl_join_lines(kept)
        }
        err = s_replace(err, work + "/out/", "@OUTDIR@/")
        let mut expected: string = read_text(EXP + "/" + name + ".err")
        if s_eq(cmp, "first") {
            err = first_line_of(err)
            expected = first_line_of(expected)
        }
        let _e1: bool = write_text(work + "/" + name + ".err", err)
        let _e2: bool = write_text(work + "/" + name + ".expected", expected)
        let mut sha: string = "none"
        if is_file(outp) {
            let ob: Bytes = read_bytes(outp)
            sha = gl_sha256(ob.data, ob.len)
        }
        let mut problems: string = ""
        let want_rc: string = cat_value(EXP + "/" + name + ".rc")
        if not s_eq(s_itoa(rc), want_rc) {
            problems = problems + " exit " + s_itoa(rc) + " (want " + want_rc + ")"
        }
        let want_sha: string = cat_value(EXP + "/" + name + ".sha")
        if portable {
            # Only whether an object was written.
            let mut got: string = "written"
            if s_eq(sha, "none") {
                got = "none"
            }
            let mut want: string = "written"
            if s_eq(want_sha, "none") {
                want = "none"
            }
            if not s_eq(got, want) {
                problems = problems + " output " + got + " (want " + want + ")"
            }
        } elif not s_eq(sha, want_sha) {
            problems = problems + " output sha differs"
        }
        if not s_eq(err, expected) {
            problems = problems + " stderr differs"
        }
        if s_empty(problems) {
            pass = pass + 1
        } else {
            fail = fail + 1
            outln("FAIL " + name + ":" + problems)
            let dl: ptr<ProcStrs> = gl_lines(gl_head(gl_diff(work + "/" + name + ".expected", work + "/" + name + ".err"), 20))
            let mut d: i32 = 0
            while d < sl_len(dl) {
                outln("    " + sl_get(dl, d))
                d = d + 1
            }
        }
    }

    if nonempty(log) {
        outln("FAIL python was called:")
        let pl: ptr<ProcStrs> = gl_file_lines(log)
        let mut p: i32 = 0
        while p < sl_len(pl) {
            outln("    " + sl_get(pl, p))
            p = p + 1
        }
        fail = fail + 1
    }
    outln("parity_targets: pass=" + s_itoa(pass) + " fail=" + s_itoa(fail))
    if fail == 0 {
        cli_exit(0)
    }
    cli_exit(1)
    return 1
}
