# Smoke: compile know_demo with flowc and check the fingerprint and know
# string constants in the generated C.
#
#   ./flow tool compiler/scripts/smoke_know.flow [OUT.c]

import "tools/flow_cli/sys.flow"
import "compiler/scripts/gate_lib.flow"
import std.process { ProcStrs }

function main() -> i32 {
    let need: ptr<ProcStrs> = sl_new()
    sl_push(need, "know+fingerprint: PASS")
    sl_push(need, "0+n=n")
    sl_push(need, "Nat/addition#0+n=n")
    sl_push(need, "Bool.disjunction.order_does_not_matter")
    sl_push(need, "coordinate:")
    return string_smoke("examples/compilers/know_demo.flow", "compiler/build/know_demo.c", need, "know/fingerprint")
}
