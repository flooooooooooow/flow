# Type checker parity between flowc and the retired Python checker
# (src/flow/type_checker.py).
#
# flowc's type check must reject every program the Python checker rejected,
# with the same diagnostic, so type_checker.py can go. The inputs are every
# tracked .flow file, every harness rung of every ```flow documentation block
# (tools/doc_examples `dump`), and the checker snippets that tests/unit fed
# the Python checker, kept as fixtures in compiler/fixtures/typecheck_parity/
# unit/. Each is checked twice: strict (Python `--strict`, the default; flowc
# `compiler/scripts/flowc_emit.flow --strict`) and lenient (Python `--lenient`,
# which rejects only its fatal errors; flowc_emit.flow --lenient, which is what
# `flow compile` runs).
#
#   ./flow tool compiler/scripts/parity_typecheck.flow [--check] [--list CLASS] [--only REGEX]
#       flowc live against the goldens in compiler/fixtures/typecheck_parity/
#       golden.txt. Needs no Python. Prints the five-way table per mode:
#
#         agree-accept       both accept
#         agree-same         both reject, same first diagnostic
#         agree-diff         both reject, different first diagnostic
#         py-only            Python rejects, flowc accepts (the dangerous one)
#         flowc-only         flowc rejects, Python accepts
#
#       An input whose front end failed on either side (parse or import
#       error, a Python crash) is counted as `frontend` and not compared.
#       An input whose text changed since the goldens were recorded is
#       `stale`. --check fails when py-only, agree-diff or flowc-only exceed
#       the ceilings in compiler/fixtures/typecheck_parity/ceiling.txt, kept
#       per OS (`uname -s`), since @cImport reads the OS's C headers; an OS
#       with no ceilings is reported and not checked.
#       --list CLASS prints the inputs of one class (py-only, agree-diff, ...)
#       with both diagnostics. --only REGEX and --keys FILE (one key per line)
#       restrict the inputs; --reuse compares the last run's flowc results
#       again without running flowc.
#
#       The checker's warnings (TypeCheckResult.warnings, #678) are compared
#       in strict mode against compiler/fixtures/typecheck_parity/
#       warnings.txt, on the inputs both sides type check with the same
#       verdict, as the sorted list of messages (flowc runs with
#       FLOWC_WARNINGS=all so library modules count too):
#
#         warn-same          both warn the same, or neither warns
#         warn-diff          both warn, with different messages
#         warn-py-only       Python warns, flowc does not
#         warn-flowc-only    flowc warns, Python does not
#
#       --check also holds warn-diff, warn-py-only and warn-flowc-only to
#       their ceilings.
#
#   ./flow tool compiler/scripts/parity_typecheck.flow --write-golden REV
#       rewrite the goldens from the Python checker at git revision REV
#       (src/flow from REV, run on the inputs of this tree). The last
#       revision recorded is named in golden.txt.
#
#   ./flow tool compiler/scripts/parity_typecheck.flow --write-warnings REV
#       rewrite warnings.txt the same way: the warnings of the strict Python
#       checker at REV on every input.
#
#   ./flow tool compiler/scripts/parity_typecheck.flow --extract-unit REV
#       rewrite compiler/fixtures/typecheck_parity/unit/ from the sources
#       REV's tests/unit handed to the Python checker.
#
# A diagnostic is compared as text. flowc prints `<file>:<line>:<col>:
# error: <message>`; the Python checker's message is the same text. The
# Python messages that spell a separator with a dash or an ellipsis are
# mapped to ": " and "..." first, as parity_effects.flow does.
#
# Env: FLOWC_BIN=<path> tests that binary; by default the checked-in
# bootstrap C is compiled to compiler/build/flowc_bootstrap. JOBS=N sets the
# parallelism (else FLOW_GATE_JOBS, else the CPU count).

import "tools/flow_cli/sys.flow"
import "compiler/scripts/gate_lib.flow"
import "compiler/scripts/corpus_lib.flow"
import std.process { ProcCmd, ProcResult, ProcStrs, proc_cmd, proc_arg, proc_args, proc_run, proc_stdin, proc_stdout, proc_stderr, proc_cwd, proc_input, PROC_NULL, PROC_CAPTURE, PROC_INHERIT, PROC_MERGE }

extern {
    function malloc(size: i64) -> ptr<void>
}

const DATA: string = "compiler/fixtures/typecheck_parity"
const GOLDEN: string = "compiler/fixtures/typecheck_parity/golden.txt"
const WARNINGS: string = "compiler/fixtures/typecheck_parity/warnings.txt"
const CEILING: string = "compiler/fixtures/typecheck_parity/ceiling.txt"

# The type check of one input: how flowc_emit.flow is run on it.
function emit_cmd(flag: string, path: string, out: string) -> ptr<ProcStrs> {
    let argv: ptr<ProcStrs> = sl_of3(gl_flowc_emit_bin(), flag, path)
    sl_push(argv, out)
    return argv
}

# ---------------------------------------------------------------------------
# The Python checker from REV, for --write-golden and --extract-unit.
# ---------------------------------------------------------------------------

function setup_python(work: string, rev: string) -> string {
    let refdir: string = work + "/pyref"
    mkdir_p_or_exit(refdir)
    let tar: string = work + "/pyref.tar"
    let ga: ptr<ProcStrs> = sl_of3("git", "archive", "-o")
    sl_push2(ga, tar, rev)
    sl_push2(ga, "src/flow", "tests")
    sl_push2(ga, "lib", "pyproject.toml")
    check(run_argv(ga))
    let tx: ptr<ProcStrs> = sl_of3("tar", "-x", "-f")
    sl_push(tx, tar)
    sl_push2(tx, "-C", refdir)
    check(run_argv(tx))
    rm_f(tar)
    return refdir
}

function py_lines(l: ptr<ProcStrs>) -> string {
    return gl_join_lines(l)
}

# Every source a test lexes and then type checks, captured from inside
# pytest. Snippets that import another file are left out: the file they
# import lived in a temporary directory.
function extract_program() -> string {
    let l: ptr<ProcStrs> = sl_new()
    sl_push(l, "import hashlib, os, sys")
    sl_push(l, "import pytest")
    sl_push(l, "out = sys.argv[1]")
    sl_push(l, "tests = sys.argv[2:]")
    sl_push(l, "import flow.parser as fp")
    sl_push(l, "import flow.type_checker as ftc")
    sl_push(l, "current = {\"test\": None, \"code\": None}")
    sl_push(l, "seen = {}")
    sl_push(l, "order = []")
    sl_push(l, "orig_lexer_init = fp.Lexer.__init__")
    sl_push(l, "def lexer_init(self, code, *a, **k):")
    sl_push(l, "    current[\"code\"] = code")
    sl_push(l, "    return orig_lexer_init(self, code, *a, **k)")
    sl_push(l, "fp.Lexer.__init__ = lexer_init")
    sl_push(l, "orig_check = ftc.TypeChecker.check")
    sl_push(l, "def check(self, declarations):")
    sl_push(l, "    code = current[\"code\"]")
    sl_push(l, "    if code is not None and \"import \" not in code and code not in seen:")
    sl_push(l, "        seen[code] = current[\"test\"]")
    sl_push(l, "        order.append(code)")
    sl_push(l, "    return orig_check(self, declarations)")
    sl_push(l, "ftc.TypeChecker.check = check")
    sl_push(l, "class Track:")
    sl_push(l, "    def pytest_runtest_setup(self, item):")
    sl_push(l, "        current[\"test\"] = os.path.basename(str(item.fspath))[:-3]")
    sl_push(l, "        current[\"code\"] = None")
    sl_push(l, "pytest.main([\"-q\", \"-p\", \"no:cacheprovider\", \"--continue-on-collection-errors\"] + tests, plugins=[Track()])")
    sl_push(l, "counts = {}")
    sl_push(l, "for code in order:")
    sl_push(l, "    test = seen[code] or \"unit\"")
    sl_push(l, "    counts[test] = counts.get(test, 0) + 1")
    sl_push(l, "    name = \"%s_%03d.flow\" % (test, counts[test])")
    sl_push(l, "    with open(os.path.join(out, name), \"w\") as f:")
    sl_push(l, "        f.write(code if code.endswith(\"\\n\") else code + \"\\n\")")
    sl_push(l, "print(\"extracted %d snippets\" % len(order), file=sys.stderr)")
    return py_lines(l)
}

# The Python checker, strict and lenient (or the strict warnings), on a
# chunk of inputs.
function write_program() -> string {
    let l: ptr<ProcStrs> = sl_new()
    sl_push(l, "import os, signal, sys, warnings")
    sl_push(l, "warnings.simplefilter(\"ignore\")")
    sl_push(l, "inputs, sha, what = sys.argv[1], sys.argv[2], sys.argv[3]")
    sl_push(l, "import flow.module_resolver as mr")
    sl_push(l, "# The resolver caches parses in .flow_cache/ next to the root file; keep")
    sl_push(l, "# the tree clean.")
    sl_push(l, "class _NoCache:")
    sl_push(l, "    @staticmethod")
    sl_push(l, "    def load(f): raise EOFError")
    sl_push(l, "    @staticmethod")
    sl_push(l, "    def dump(obj, f): raise OSError")
    sl_push(l, "mr.pickle = _NoCache")
    sl_push(l, "_real_makedirs = os.makedirs")
    sl_push(l, "def _makedirs(path, *a, **k):")
    sl_push(l, "    if str(path).endswith(\".flow_cache\"):")
    sl_push(l, "        return")
    sl_push(l, "    return _real_makedirs(path, *a, **k)")
    sl_push(l, "os.makedirs = _makedirs")
    sl_push(l, "from flow.type_checker import TypeChecker")
    sl_push(l, "from flow.c_header_parser import resolve_c_imports")
    sl_push(l, "from flow.transpiler import _filter_declarations")
    sl_push(l, "")
    sl_push(l, "MODES = {\"compile\", \"c\"}")
    sl_push(l, "class Timeout(Exception):")
    sl_push(l, "    pass")
    sl_push(l, "def on_alarm(sig, frame):")
    sl_push(l, "    raise Timeout()")
    sl_push(l, "signal.signal(signal.SIGALRM, on_alarm)")
    sl_push(l, "")
    sl_push(l, "def clean(msg):")
    sl_push(l, "    return str(msg).replace(\"\\u2014\", \":\").replace(\" : \", \": \").replace(\"\\u2026\", \"...\").replace(\"\\\\\", \"\\\\\\\\\").replace(\"\\n\", \"\\\\n\")")
    sl_push(l, "")
    sl_push(l, "def run(path, strict):")
    sl_push(l, "    signal.alarm(20)")
    sl_push(l, "    try:")
    sl_push(l, "        decls = mr.resolve_modules(path)")
    sl_push(l, "        decls = resolve_c_imports(decls, os.path.dirname(os.path.abspath(path)))")
    sl_push(l, "        decls = _filter_declarations(decls, MODES)")
    sl_push(l, "    except Timeout:")
    sl_push(l, "        return \"frontend\", [\"timeout in the front end\"], []")
    sl_push(l, "    except BaseException as e:")
    sl_push(l, "        signal.alarm(0)")
    sl_push(l, "        return \"frontend\", [\"%s: %s\" % (type(e).__name__, e)], []")
    sl_push(l, "    try:")
    sl_push(l, "        tc = TypeChecker()")
    sl_push(l, "        tc.strict = strict")
    sl_push(l, "        r = tc.check(decls)")
    sl_push(l, "    except Timeout:")
    sl_push(l, "        return \"frontend\", [\"timeout in the checker\"], []")
    sl_push(l, "    except BaseException as e:")
    sl_push(l, "        signal.alarm(0)")
    sl_push(l, "        return \"frontend\", [\"checker crashed: %s: %s\" % (type(e).__name__, e)], []")
    sl_push(l, "    signal.alarm(0)")
    sl_push(l, "    run.warnings = list(r.warnings)")
    sl_push(l, "    if strict:")
    sl_push(l, "        return (\"reject\" if r.errors else \"accept\"), list(r.errors), []")
    sl_push(l, "    fatal = list(getattr(r, \"fatal_errors\", []))")
    sl_push(l, "    warn = [e for e in r.errors if e not in fatal]")
    sl_push(l, "    return (\"reject\" if fatal else \"accept\"), fatal, warn")
    sl_push(l, "")
    sl_push(l, "with open(inputs) as f:")
    sl_push(l, "    for line in f:")
    sl_push(l, "        key, path, blob = line.rstrip(\"\\n\").split(\"\\t\")")
    sl_push(l, "        cwd = os.getcwd()")
    sl_push(l, "        print(\"@ %s\\t%s\" % (key, blob))")
    sl_push(l, "        if what == \"warnings\":")
    sl_push(l, "            run.warnings = []")
    sl_push(l, "            verdict, errs, _ = run(path, True)")
    sl_push(l, "            os.chdir(cwd)")
    sl_push(l, "            print(\"S %s\" % verdict)")
    sl_push(l, "            for w in sorted(clean(w) for w in run.warnings):")
    sl_push(l, "                print(\"W %s\" % w)")
    sl_push(l, "            sys.stdout.flush()")
    sl_push(l, "            continue")
    sl_push(l, "        for tag, strict in ((\"S\", True), (\"L\", False)):")
    sl_push(l, "            verdict, errs, warns = run(path, strict)")
    sl_push(l, "            os.chdir(cwd)")
    sl_push(l, "            print(\"%s %s\" % (tag, verdict))")
    sl_push(l, "            for e in errs[:8]:")
    sl_push(l, "                print(\"%s %s\" % (tag.lower(), clean(e)))")
    sl_push(l, "            for w in warns[:3]:")
    sl_push(l, "                print(\"w %s\" % clean(w))")
    sl_push(l, "        sys.stdout.flush()")
    return py_lines(l)
}

function mode_extract(root: string, work: string, rev: string) -> i32 {
    let refdir: string = setup_python(work, rev)
    let out: string = root + "/" + DATA + "/unit"
    rm_rf(out)
    mkdir_p_or_exit(out)
    let tests: ptr<ProcStrs> = sl_new()
    let cands: ptr<ProcStrs> = glob_suffix(refdir + "/tests/unit", ".py")
    let mut i: i32 = 0
    while i < sl_len(cands) {
        let p: string = sl_get(cands, i)
        let name: string = path_basename(p)
        let text: string = read_text(p)
        if s_starts(name, "test_") and (s_contains(text, "TypeChecker") or s_contains(text, "type_checker")) {
            sl_push(tests, "tests/unit/" + name)
        }
        i = i + 1
    }
    gl_sort_locale(tests)
    let argv: ptr<ProcStrs> = sl_of3("python3", "-", out)
    sl_extend(argv, tests)
    let c: ptr<ProcCmd> = gl_cmd(argv)
    proc_cwd(c, refdir)
    cmd_env(c, "PYTHONPATH", refdir + "/src")
    cmd_env(c, "PYTHONDONTWRITEBYTECODE", "1")
    proc_input(c, extract_program())
    proc_stderr(c, PROC_MERGE)
    let r: ptr<ProcResult> = proc_run(c)
    let log: string = work + "/extract.log"
    let _w: bool = write_text(log, r.stdout)
    if gl_status(r, false) != 0 {
        let lines: ptr<ProcStrs> = gl_lines(r.stdout)
        let mut from: i32 = sl_len(lines) - 20
        if from < 0 {
            from = 0
        }
        errs(gl_join_lines(sl_tail(lines, from)))
    }
    let lines2: ptr<ProcStrs> = gl_lines(r.stdout)
    let mut k: i32 = 0
    while k < sl_len(lines2) {
        if s_starts(sl_get(lines2, k), "extracted") {
            outln(sl_get(lines2, k))
        }
        k = k + 1
    }
    return 0
}

# ---------------------------------------------------------------------------
# Inputs: key TAB path TAB blob, one per line.
# ---------------------------------------------------------------------------

function build_inputs(root: string, work: string, only: string, keys: string) -> ptr<ProcStrs> {
    let files: ptr<ProcStrs> = gl_git_ls("*.flow")
    let units: ptr<ProcStrs> = glob_suffix(DATA + "/unit", ".flow")
    sl_extend(files, units)
    let uniq: ptr<ProcStrs> = gl_sort_unique(files)
    let rows: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(uniq) {
        sl_push(rows, sl_get(uniq, i) + "\t" + root + "/" + sl_get(uniq, i))
        i = i + 1
    }

    let dump: string = work + "/docdump"
    mkdir_p_or_exit(dump)
    let dargv: ptr<ProcStrs> = sl_of3("./flow", "tool", "doc_examples")
    sl_push(dargv, "dump")
    let dc: ptr<ProcCmd> = gl_cmd(dargv)
    cmd_env(dc, "FLOW_DOC_DUMP", dump)
    if gl_run_log(dc, work + "/docdump.log", 0) != 0 {
        errs(read_text(work + "/docdump.log"))
        errln("parity_typecheck: the doc block dump failed")
        cli_exit(1)
    }
    # One row per key: the first, in the order the shell's glob gave them.
    let names: ptr<ProcStrs> = list_dir(dump)
    gl_sort_locale(names)
    let docs: ptr<ProcStrs> = sl_new()
    let mut k: i32 = 0
    while k < sl_len(names) {
        let n: string = sl_get(names, k)
        if s_starts(n, "d") and s_ends(n, ".key") {
            let kp: string = dump + "/" + n
            let key: string = "doc:" + s_chomp_all(read_text(kp))
            sl_push(docs, key + "\t" + s_slice(kp, 0, s_len(kp) - 4) + ".flow")
        }
        k = k + 1
    }
    sl_extend(rows, unique_by_key(docs))

    let mut sel: ptr<ProcStrs> = rows
    if not s_empty(only) {
        sel = cl_grep(sel, only)
    }
    if not s_empty(keys) {
        let want: ptr<GlMap> = gl_set_of(gl_file_lines(keys))
        let kept: ptr<ProcStrs> = sl_new()
        let mut q: i32 = 0
        while q < sl_len(sel) {
            if gl_map_has(want, gl_field(sl_get(sel, q), 0)) {
                sl_push(kept, sl_get(sel, q))
            }
            q = q + 1
        }
        sel = kept
    }

    # Git blob hash of every input: a golden applies only to the text it
    # was recorded from.
    let path_list: ptr<ProcStrs> = sl_new()
    let mut h: i32 = 0
    while h < sl_len(sel) {
        sl_push(path_list, gl_field(sl_get(sel, h), 1))
        h = h + 1
    }
    let paths: string = gl_join_lines(path_list)
    let hc: ptr<ProcCmd> = proc_cmd("git")
    proc_arg(hc, "hash-object")
    proc_arg(hc, "--stdin-paths")
    proc_input(hc, paths)
    proc_stderr(hc, PROC_INHERIT)
    let hr: ptr<ProcResult> = proc_run(hc)
    let hashes: ptr<ProcStrs> = gl_lines(hr.stdout)
    let out: ptr<ProcStrs> = sl_new()
    let mut j: i32 = 0
    while j < sl_len(sel) {
        sl_push(out, sl_get(sel, j) + "\t" + sl_get(hashes, j))
        j = j + 1
    }
    let _w: bool = write_text(work + "/inputs.tsv", gl_join_lines(out))
    outln("=== parity_typecheck: " + s_itoa(sl_len(out)) + " inputs ===")
    return out
}

# `LC_ALL=C sort -u -t TAB -k1,1`: byte order of the first field, the
# first row of each key kept.
function unique_by_key(rows: ptr<ProcStrs>) -> ptr<ProcStrs> {
    let seen: ptr<GlMap> = gl_map_new()
    let firsts: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(rows) {
        let k: string = gl_field(sl_get(rows, i), 0)
        if not gl_map_has(seen, k) {
            gl_map_put(seen, k, sl_get(rows, i))
            sl_push(firsts, k)
        }
        i = i + 1
    }
    gl_sort(firsts)
    let out: ptr<ProcStrs> = sl_new()
    let mut j: i32 = 0
    while j < sl_len(firsts) {
        sl_push(out, gl_map_get(seen, sl_get(firsts, j)))
        j = j + 1
    }
    return out
}

# ---------------------------------------------------------------------------
# --write-golden / --write-warnings: the Python checker on every input.
# ---------------------------------------------------------------------------

function mode_write(root: string, work: string, rev: string, mode: string, jobs: i32, inputs: ptr<ProcStrs>) -> i32 {
    let refdir: string = setup_python(work, rev)
    let sc: ptr<ProcCmd> = gl_cmd(sl_of3("git", "rev-parse", "--short"))
    proc_arg(sc, rev)
    proc_stderr(sc, PROC_INHERIT)
    let sha: string = capture(sc)
    let prog: string = write_program()
    # One Python process per chunk of inputs, in parallel, joined in order.
    let total: i32 = sl_len(inputs)
    let chunks: ptr<ProcStrs> = sl_new()
    let mut c: i32 = 0
    while c < jobs {
        sl_push(chunks, "")
        c = c + 1
    }
    let mut i: i32 = 0
    while i < total {
        let k: i32 = ((i as i64) * (jobs as i64) / (total as i64)) as i32
        chunks.items[k] = chunks.items[k] + sl_get(inputs, i) + "\n"
        i = i + 1
    }
    env_set("PYTHONPATH", refdir + "/src")
    env_set("PYTHONDONTWRITEBYTECODE", "1")
    let names: ptr<ProcStrs> = sl_new()
    let pids: ptr<ProcStrs> = sl_new()
    let mut w: i32 = 0
    while w < jobs {
        if s_len(sl_get(chunks, w)) > 0 {
            let mut idx: string = s_itoa(w)
            while s_len(idx) < 3 {
                idx = "0" + idx
            }
            let path: string = work + "/chunk." + idx
            let _ok: bool = write_text(path, sl_get(chunks, w))
            let argv: ptr<ProcStrs> = sl_of3("python3", "-c", prog)
            sl_push(argv, path)
            sl_push2(argv, sha, mode)
            sl_push(names, path)
            sl_push(pids, s_itoa(gl_spawn_io(argv, path + ".out", path + ".log")))
        }
        w = w + 1
    }
    let mut p: i32 = 0
    while p < sl_len(pids) {
        let _s: i32 = gl_wait(s_atoi(sl_get(pids, p), 0 - 1))
        p = p + 1
    }
    let mut body: string = ""
    let mut n: i32 = 0
    while n < sl_len(names) {
        body = body + read_text(sl_get(names, n) + ".out")
        n = n + 1
    }
    if s_eq(mode, "warnings") {
        let _a: bool = write_text(root + "/" + WARNINGS, "# Python type checker warnings, strict (compiler/scripts/parity_typecheck.flow), rev " + sha + "\n" + body)
        let wl: ptr<ProcStrs> = gl_file_lines(WARNINGS)
        outln("wrote " + WARNINGS + " (" + s_itoa(count_prefix(wl, "@ ")) + " inputs, " + s_itoa(count_prefix(wl, "W ")) + " warnings, rev " + sha + ")")
        return 0
    }
    let _b: bool = write_text(root + "/" + GOLDEN, "# Python type checker goldens (compiler/scripts/parity_typecheck.flow), rev " + sha + "\n" + body)
    outln("wrote " + GOLDEN + " (" + s_itoa(count_prefix(gl_file_lines(GOLDEN), "@ ")) + " inputs, rev " + sha + ")")
    return 0
}

function count_prefix(l: ptr<ProcStrs>, prefix: string) -> i32 {
    let mut n: i32 = 0
    let mut i: i32 = 0
    while i < sl_len(l) {
        if s_starts(sl_get(l, i), prefix) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

# ---------------------------------------------------------------------------
# flowc on every input, strict and lenient.
# ---------------------------------------------------------------------------

# Lines of `log` that the pattern matches, in order.
function grep_lines(lines: ptr<ProcStrs>, pattern: string) -> ptr<ProcStrs> {
    let out: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(lines) {
        if cl_matches(sl_get(lines, i), pattern) {
            sl_push(out, sl_get(lines, i))
        }
        i = i + 1
    }
    return out
}

# The messages after `<file>:<line>:<col>: <kind>: ` (sed -n -E
# 's/^.*:[0-9]+:[0-9]+: kind: //p').
function diag_messages(lines: ptr<ProcStrs>, kind: string) -> ptr<ProcStrs> {
    let out: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    let pattern: string = "^.*:[0-9]+:[0-9]+: " + kind + ": "
    while i < sl_len(lines) {
        let l: string = sl_get(lines, i)
        if s_contains(l, ": " + kind + ": ") and cl_matches(l, pattern) {
            sl_push(out, cl_sub(l, pattern, "", 1))
        }
        i = i + 1
    }
    return out
}

# A log as text with its NUL bytes dropped: the script read logs with
# `grep -a` (binary as text) inside $(...), which drops NUL bytes.
function log_text(path: string) -> string {
    let b: Bytes = read_bytes(path)
    if b.len < 0 {
        return ""
    }
    let out: ptr<u8> = malloc(b.len + 1) as ptr<u8>
    let mut n: i64 = 0
    let mut i: i64 = 0
    while i < b.len {
        if b.data[i] != 0 {
            out[n] = b.data[i]
            n = n + 1
        }
        i = i + 1
    }
    out[n] = 0
    return out as string
}

# One record per input and mode: `key TAB S|L TAB verdict TAB first
# diagnostic`, then the strict warnings. The verdict is accept (the type
# check passed, whatever codegen made of it later), reject (the type check
# failed) or frontend.
function check_one(key: string, path: string, runs: string, bin: string) -> string {
    let d: string = runs + "/" + gl_cksum_text(key)
    mkdir_p_or_exit(d)
    let mut out: string = ""
    let modes: ptr<ProcStrs> = sl_of2("S", "L")
    let mut mi: i32 = 0
    while mi < 2 {
        let m: string = sl_get(modes, mi)
        mi = mi + 1
        let mut flag: string = "--strict"
        if s_eq(m, "L") {
            flag = "--lenient"
        }
        rm_f(d + "/o.c")
        let log: string = d + "/log." + m
        let rc: i32 = gl_run_cpu_limited(emit_cmd(flag, path, d + "/o.c"), log, 30)
        let text: string = log_text(log)
        let lines: ptr<ProcStrs> = gl_lines(text)
        let mut verdict: string = "frontend"
        if cl_matches(text, "parse error|flowc emit: parse failed|bundle tc: (gather|topo|read) failed|read FLOWC_IN failed|expansion overflowed|unsupported in Stage-A|cannot resolve|could not resolve|import not found") {
            verdict = "frontend"
        } elif s_contains(text, "typecheck failed") {
            verdict = "reject"
        } elif s_contains(text, "flowc: type check passed") or (rc == 0 and nonempty(d + "/o.c")) {
            verdict = "accept"
        } elif cl_matches(text, "emit failed|cgen|codegen") {
            verdict = "accept"
        }
        let mut msg: string = ""
        if s_eq(verdict, "reject") {
            let errs_: ptr<ProcStrs> = diag_messages(lines, "error")
            if sl_len(errs_) > 0 {
                msg = s_replace(sl_get(errs_, 0), "\\", "\\\\")
            }
            if s_empty(msg) {
                let cands: ptr<ProcStrs> = grep_lines(lines, "^flowc tc: |^flowc: |error")
                let mut c: i32 = 0
                while c < sl_len(cands) and s_empty(msg) {
                    if not cl_matches(sl_get(cands, c), "typecheck failed|tc_errs=|module check failed|module_errs=") {
                        msg = sl_get(cands, c)
                    }
                    c = c + 1
                }
            }
        } elif s_eq(verdict, "frontend") {
            let fe: ptr<ProcStrs> = grep_lines(lines, "error|failed|unsupported")
            msg = sl_get(fe, 0)
        }
        out = out + key + "\t" + m + "\t" + verdict + "\t" + msg + "\n"
    }
    # The checker's warnings in strict mode, sorted, joined with " || ".
    let warns: ptr<ProcStrs> = diag_messages(gl_lines(log_text(d + "/log.S")), "warning")
    let esc: ptr<ProcStrs> = sl_new()
    let mut w: i32 = 0
    while w < sl_len(warns) {
        sl_push(esc, s_replace(sl_get(warns, w), "\\", "\\\\"))
        w = w + 1
    }
    gl_sort(esc)
    return out + key + "\tW\twarn\t" + sl_join(esc, " || ") + "\n"
}

# --worker <runs> <bin> <results> <chunk>: one worker's inputs.
function worker_main(args: ptr<ProcStrs>) -> i32 {
    let runs: string = sl_get(args, 1)
    let bin: string = sl_get(args, 2)
    let results: string = sl_get(args, 3) + "." + s_itoa(pid())
    let rows: ptr<ProcStrs> = gl_file_lines(sl_get(args, 4))
    env_set("FLOWC_CHECK_ONLY", "1")
    env_set("FLOWC_WARNINGS", "all")
    env_set("FLOWC_BIN", bin)
    let mut i: i32 = 0
    while i < sl_len(rows) {
        let row: string = sl_get(rows, i)
        let _a: bool = append_text(results, check_one(gl_field(row, 0), gl_field(row, 1), runs, bin))
        i = i + 1
    }
    return 0
}

function run_flowc(root: string, work: string, jobs: i32, inputs: ptr<ProcStrs>) {
    let mut bin: string = env("FLOWC_BIN")
    if s_empty(bin) {
        bin = root + "/compiler/build/flowc_bootstrap"
        check(gl_build_flowc(bin, true, false))
    }
    if not is_abs(bin) {
        bin = root + "/" + bin
    }
    outln("=== flowc = " + bin + " ===")
    # Build the emitter once here; the workers find it in GATE_FLOWC_EMIT.
    let _emit: string = gl_flowc_emit_bin()
    mkdir_p_or_exit(work + "/runs")
    let pairs: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(inputs) {
        sl_push(pairs, gl_field(sl_get(inputs, i), 0) + "\t" + gl_field(sl_get(inputs, i), 1))
        i = i + 1
    }
    let wargs: ptr<ProcStrs> = sl_of3("--worker", work + "/runs", bin)
    sl_push(wargs, work + "/flowc.part")
    cl_run_workers(pairs, jobs, work, wargs)
    # The records in the order of the inputs, so --list is stable.
    let rows: ptr<ProcStrs> = cl_collect(work, "flowc.part.")
    let by_key: ptr<GlMap> = gl_map_new()
    let mut r: i32 = 0
    while r < sl_len(rows) {
        let key: string = gl_field(sl_get(rows, r), 0)
        gl_map_put(by_key, key, gl_map_get(by_key, key) + sl_get(rows, r) + "\n")
        r = r + 1
    }
    let ordered: ptr<ProcStrs> = sl_new()
    let mut k: i32 = 0
    while k < sl_len(pairs) {
        let key2: string = gl_field(sl_get(pairs, k), 0)
        let block: string = gl_map_get(by_key, key2)
        if not s_empty(block) {
            sl_push(ordered, s_chomp_all(block))
        }
        gl_map_put(by_key, key2, "")
        k = k + 1
    }
    let _w: bool = write_text(work + "/flowc.tsv", gl_join_lines(ordered))
}

# ---------------------------------------------------------------------------
# Compare.
# ---------------------------------------------------------------------------

# awk's norm(): a literal \n reads as a space.
function norm(s: string) -> string {
    return s_replace(s, "\\n", " ")
}

function count_key(m: string, cls: string) -> string {
    return m + "\t" + cls
}

function bump(counts: ptr<GlMap>, m: string, cls: string) {
    let k: string = count_key(m, cls)
    gl_map_put(counts, k, s_itoa(s_atoi(gl_map_get(counts, k), 0) + 1))
}

function get_count(counts: ptr<GlMap>, m: string, cls: string) -> i32 {
    return s_atoi(gl_map_get(counts, count_key(m, cls)), 0)
}

# The class table; prints --list matches on the way.
function compare(work: string, list: string) -> string {
    let blob: ptr<GlMap> = gl_map_new()
    let inputs: ptr<ProcStrs> = gl_file_lines(work + "/inputs.tsv")
    let mut i: i32 = 0
    while i < sl_len(inputs) {
        let row: string = sl_get(inputs, i)
        gl_map_put(blob, gl_field(row, 0), gl_field(row, 2))
        i = i + 1
    }
    # warnings.txt: "@ key TAB blob", "S verdict", "W message" (sorted).
    let wblob: ptr<GlMap> = gl_map_new()
    let pw: ptr<GlMap> = gl_map_new()
    let wl: ptr<ProcStrs> = gl_file_lines(WARNINGS)
    let mut wcur: string = ""
    let mut w: i32 = 0
    while w < sl_len(wl) {
        let line: string = sl_get(wl, w)
        w = w + 1
        if s_starts(line, "#") {
            continue
        }
        if s_starts(line, "@ ") {
            let rest: string = s_from(line, 2)
            wcur = gl_field(rest, 0)
            gl_map_put(wblob, wcur, gl_field(rest, 1))
            gl_map_put(pw, wcur, "")
            continue
        }
        if s_starts(line, "W ") {
            let prev: string = gl_map_get(pw, wcur)
            if s_empty(prev) {
                gl_map_put(pw, wcur, s_from(line, 2))
            } else {
                gl_map_put(pw, wcur, prev + " || " + s_from(line, 2))
            }
        }
    }
    # golden.txt
    let gblob: ptr<GlMap> = gl_map_new()
    let pv: ptr<GlMap> = gl_map_new()
    let pm: ptr<GlMap> = gl_map_new()
    let gl_: ptr<ProcStrs> = gl_file_lines(GOLDEN)
    let mut cur: string = ""
    let mut g: i32 = 0
    while g < sl_len(gl_) {
        let line: string = sl_get(gl_, g)
        g = g + 1
        if s_starts(line, "#") {
            continue
        }
        if s_starts(line, "@ ") {
            let rest: string = s_from(line, 2)
            cur = gl_field(rest, 0)
            gl_map_put(gblob, cur, gl_field(rest, 1))
            continue
        }
        let tag: string = s_slice(line, 0, 1)
        let rest2: string = s_from(line, 2)
        if s_eq(tag, "S") or s_eq(tag, "L") {
            gl_map_put(pv, cur + "\t" + tag, rest2)
        } elif s_eq(tag, "s") and not gl_map_has(pm, cur + "\tS") {
            gl_map_put(pm, cur + "\tS", rest2)
        } elif s_eq(tag, "l") and not gl_map_has(pm, cur + "\tL") {
            gl_map_put(pm, cur + "\tL", rest2)
        }
    }

    let counts: ptr<GlMap> = gl_map_new()
    let fw: ptr<GlMap> = gl_map_new()
    let wkeys: ptr<ProcStrs> = sl_new()
    let wseen: ptr<GlMap> = gl_map_new()
    let rows: ptr<ProcStrs> = gl_file_lines(work + "/flowc.tsv")
    let mut r: i32 = 0
    while r < sl_len(rows) {
        let row: string = sl_get(rows, r)
        r = r + 1
        let key: string = gl_field(row, 0)
        let m: string = gl_field(row, 1)
        if s_eq(m, "W") {
            gl_map_put(fw, key, gl_field(row, 3))
            continue
        }
        let fv: string = gl_field(row, 2)
        let fm: string = gl_field(row, 3)
        let mut cls: string = ""
        if not gl_map_has(gblob, key) {
            cls = "no-golden"
        } elif not s_eq(gl_map_get(gblob, key), gl_map_get(blob, key)) {
            cls = "stale"
        } else {
            let pvv: string = gl_map_get(pv, key + "\t" + m)
            if s_eq(pvv, "frontend") or s_eq(fv, "frontend") {
                cls = "frontend"
            } elif s_eq(pvv, "accept") and s_eq(fv, "accept") {
                cls = "agree-accept"
            } elif s_eq(pvv, "reject") and s_eq(fv, "accept") {
                cls = "py-only"
            } elif s_eq(pvv, "accept") and s_eq(fv, "reject") {
                cls = "flowc-only"
            } elif s_eq(norm(gl_map_get(pm, key + "\t" + m)), norm(fm)) {
                cls = "agree-same"
            } else {
                cls = "agree-diff"
            }
        }
        bump(counts, m, cls)
        if not s_empty(list) and s_eq(cls, list) {
            let mut mode_name: string = "lenient"
            if s_eq(m, "S") {
                mode_name = "strict"
            }
            outln(key + " [" + mode_name + "]\n    python: " + gl_map_get(pm, key + "\t" + m) + "\n    flowc:  " + fm)
        }
        # Warnings are compared where both sides type check the same way.
        if s_eq(m, "S") and (s_eq(cls, "agree-accept") or s_eq(cls, "agree-same") or s_eq(cls, "agree-diff")) and gl_map_has(wblob, key) and s_eq(gl_map_get(wblob, key), gl_map_get(blob, key)) {
            if not gl_map_has(wseen, key) {
                gl_map_put(wseen, key, "1")
                sl_push(wkeys, key)
            }
        }
    }
    let mut k: i32 = 0
    while k < sl_len(wkeys) {
        let key: string = sl_get(wkeys, k)
        k = k + 1
        let p: string = gl_map_get(pw, key)
        let f: string = gl_map_get(fw, key)
        let mut wc: string = ""
        if s_eq(p, f) {
            wc = "warn-same"
        } elif not s_empty(p) and not s_empty(f) {
            wc = "warn-diff"
        } elif not s_empty(p) {
            wc = "warn-py-only"
        } else {
            wc = "warn-flowc-only"
        }
        bump(counts, "S", wc)
        if not s_empty(list) and s_eq(wc, list) {
            outln(key + " [strict]\n    python: " + p + "\n    flowc:  " + f)
        }
    }
    let classes: ptr<ProcStrs> = s_words("agree-accept agree-same agree-diff py-only flowc-only frontend stale no-golden warn-same warn-diff warn-py-only warn-flowc-only")
    let mut report: string = pad_right("class", 16) + " " + pad_left("strict", 8) + " " + pad_left("lenient", 8) + "\n"
    let mut c: i32 = 0
    while c < sl_len(classes) {
        let cl: string = sl_get(classes, c)
        report = report + pad_right(cl, 16) + " " + gl_num(get_count(counts, "S", cl), 8) + " " + gl_num(get_count(counts, "L", cl), 8) + "\n"
        c = c + 1
    }
    let _w: bool = write_text(work + "/report.txt", report)
    return report
}

function check_ceilings(report: string) -> i32 {
    if not is_file(CEILING) {
        errln("parity_typecheck: no ceiling file " + CEILING)
        return 1
    }
    let os: string = uname_s()
    let lines: ptr<ProcStrs> = gl_file_lines(CEILING)
    let mut has_os: bool = false
    let mut i: i32 = 0
    while i < sl_len(lines) {
        if s_starts(sl_get(lines, i), os + " ") {
            has_os = true
        }
        i = i + 1
    }
    if not has_os {
        # The goldens read @cImport headers of the OS they were recorded
        # on; another OS can differ where a header declares something else.
        outln("NOTE parity_typecheck: no ceilings for " + os + " in " + CEILING + "; not checked")
        return 0
    }
    let rep: ptr<ProcStrs> = gl_lines(report)
    let mut fail: i32 = 0
    let mut j: i32 = 0
    while j < sl_len(lines) {
        let w: ptr<ProcStrs> = s_words(sl_get(lines, j))
        j = j + 1
        let cos: string = sl_get(w, 0)
        if s_empty(cos) or s_starts(cos, "#") or not s_eq(cos, os) {
            continue
        }
        let cls: string = sl_get(w, 1)
        let ms: i32 = s_atoi(sl_get(w, 2), 0)
        let ml: i32 = s_atoi(sl_get(w, 3), 0)
        let mut gs: string = ""
        let mut gl2: string = ""
        let mut found: bool = false
        let mut q: i32 = 0
        while q < sl_len(rep) and not found {
            let rw: ptr<ProcStrs> = s_words(sl_get(rep, q))
            if s_starts(sl_get(rep, q), cls + " ") {
                gs = sl_get(rw, 1)
                gl2 = sl_get(rw, 2)
                found = true
            }
            q = q + 1
        }
        if s_atoi(gs, 0) > ms or s_atoi(gl2, 0) > ml {
            outln("FAIL " + cls + ": strict " + gs + " (ceiling " + s_itoa(ms) + "), lenient " + gl2 + " (ceiling " + s_itoa(ml) + ")")
            fail = 1
        }
    }
    if fail == 0 {
        outln("PASS parity_typecheck within the ceilings")
    }
    return fail
}

function needs(args: ptr<ProcStrs>, i: i32, what: string) -> string {
    let v: string = sl_get(args, i + 1)
    if i + 1 >= sl_len(args) or s_empty(v) {
        errln("parity_typecheck: " + sl_get(args, i) + " needs " + what)
        cli_exit(1)
    }
    return v
}

function main() -> i32 {
    let root: string = gl_enter_root()
    let work: string = root + "/compiler/build/parity_typecheck"
    let args: ptr<ProcStrs> = proc_args()
    if s_eq(sl_get(args, 0), "--worker") {
        return worker_main(args)
    }
    let mut mode: string = "check"
    let mut rev: string = ""
    let mut do_check: bool = false
    let mut list: string = ""
    let mut only: string = ""
    let mut reuse: bool = false
    let mut keys: string = ""
    let mut i: i32 = 0
    while i < sl_len(args) {
        let a: string = sl_get(args, i)
        if s_eq(a, "--write-golden") {
            mode = "write"
            rev = needs(args, i, "a revision")
            i = i + 2
        } elif s_eq(a, "--write-warnings") {
            mode = "warnings"
            rev = needs(args, i, "a revision")
            i = i + 2
        } elif s_eq(a, "--extract-unit") {
            mode = "extract"
            rev = needs(args, i, "a revision")
            i = i + 2
        } elif s_eq(a, "--check") {
            do_check = true
            i = i + 1
        } elif s_eq(a, "--list") {
            list = needs(args, i, "a class")
            i = i + 2
        } elif s_eq(a, "--only") {
            only = needs(args, i, "a regex")
            i = i + 2
        } elif s_eq(a, "--reuse") {
            reuse = true
            i = i + 1
        } elif s_eq(a, "--keys") {
            keys = needs(args, i, "a file")
            i = i + 2
        } else {
            errln("parity_typecheck: unknown argument " + a)
            return 2
        }
    }

    # JOBS, then FLOW_GATE_JOBS (the worker cap shared by every gate), then
    # the CPU count.
    let mut jobs: i32 = s_atoi(env("JOBS"), 0)
    if jobs <= 0 {
        jobs = s_atoi(env("FLOW_GATE_JOBS"), 0)
    }
    if jobs <= 0 {
        jobs = gl_ncpu()
    }
    if not reuse {
        rm_rf(work)
    }
    mkdir_p_or_exit(work)

    if s_eq(mode, "extract") {
        return mode_extract(root, work, rev)
    }

    let mut inputs: ptr<ProcStrs> = sl_new()
    if not reuse {
        inputs = build_inputs(root, work, only, keys)
    } else {
        inputs = gl_file_lines(work + "/inputs.tsv")
    }

    if s_eq(mode, "write") or s_eq(mode, "warnings") {
        return mode_write(root, work, rev, mode, jobs, inputs)
    }

    if not reuse {
        run_flowc(root, work, jobs, inputs)
    }

    if not is_file(GOLDEN) {
        errln("parity_typecheck: no goldens (" + GOLDEN + "); run --write-golden REV")
        return 1
    }
    if not is_file(WARNINGS) {
        errln("parity_typecheck: no warning goldens (" + WARNINGS + "); run --write-warnings REV")
        return 1
    }
    let report: string = compare(work, list)
    outln("")
    out(report)

    if do_check {
        return check_ceilings(report)
    }
    return 0
}
