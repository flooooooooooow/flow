# Compile one Flow program to C with flowc, the way `flow compile` does.
#
#   ./flow tool compiler/scripts/flowc_emit.flow [--strict|--lenient]
#       [--no-checks] [--no-warnings|--Werror] [--library] [--export NAME]...
#       [--module-name NAME] IN.flow OUT.c
#
# This is the one C path for scripts and tools. Relative paths are taken
# from the caller's directory.
#
# Defaults match `flow compile`: the type checker runs, type errors are
# warnings except the ones that stay fatal (--lenient, FLOWC_LENIENT=1), and
# the runtime checks for division, shifts and array bounds are emitted
# (FLOWC_CHECKS=1). --strict makes every type error fatal. --no-checks
# leaves the runtime checks out.
#
# The type checker's warnings print as `FILE:LINE:COL: warning: ...`, except
# inside lib/stdlib and lib/runtime (FLOWC_WARNINGS=all shows those too).
# --no-warnings (FLOWC_WARNINGS=0) silences them; --Werror (FLOWC_WERROR=1)
# prints them as errors and fails the compile.
#
# --library (FLOWC_LIBRARY=1) emits a unit to link next to a program: no
# runtime checks, no fault handler, plain C names with external linkage,
# and no main needed. --export NAME (repeatable, or a comma list;
# FLOWC_EXPORT="a,b") appends a visible `flow_export_NAME` alias for each
# function (#1030). --module-name is accepted for old command lines and
# does not change the C.
#
# A program that imports modules, or uses the Field or dynamics DSL, is
# bundled into one C unit from the repository root, so `stdlib/...` imports
# resolve against lib/stdlib and path imports against the repository.
#
# The compiler is FLOWC_BIN when set, else compiler/scripts/ensure_flowc.flow.
# The logic is tools/flow_cli/flowc_build.flow; this program replaces itself
# with flowc, so the exit status is flowc's.

import "tools/flow_cli/sys.flow"
import "tools/flow_cli/flowc_build.flow"
import std.process { ProcStrs, proc_args, proc_chdir }

function main() -> i32 {
    let mut root: string = env("FLOW_REPO_ROOT")
    if s_len(root) == 0 {
        root = cwd_logical()
    }
    let p: ptr<EmitPlan> = flowc_emit_plan(root, cwd_logical(), proc_args())
    if p.rc != 0 {
        return p.rc
    }
    let mut i: i32 = 0
    while i < sl_len(p.unsets) {
        env_unset(sl_get(p.unsets, i))
        i = i + 1
    }
    let mut j: i32 = 0
    while j < sl_len(p.sets) {
        let kv: string = sl_get(p.sets, j)
        let eq: i32 = s_find_byte(kv, 61, 0)
        env_set(s_slice(kv, 0, eq), s_from(kv, eq + 1))
        j = j + 1
    }
    if not proc_chdir(p.cwd) {
        errln("flowc_emit: cannot enter " + p.cwd)
        return 1
    }
    return exec_argv(sl_of1(p.driver))
}
