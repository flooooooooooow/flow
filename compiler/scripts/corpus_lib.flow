# @module compiler.scripts.corpus_lib
# @means  What the two corpus gates share (compiler/scripts/corpus_parity.flow
#         and compiler/scripts/mlir_vs_c.flow): the corpus, the parallel
#         workers, the files the programs leave behind, failure causes and
#         the ranked tables of the report.

import "tools/flow_cli/sys.flow"
import "compiler/scripts/gate_lib.flow"
import std.regex { Regex, RxMatch, rx_compile, rx_search, rx_sub, rx_m_group }
import std.process { ProcCmd, ProcResult, ProcStrs, proc_cmd, proc_arg, proc_stdin, proc_stderr, proc_run, PROC_NULL, PROC_INHERIT }

extern {
    function malloc(size: i64) -> ptr<void>
}

# ---------------------------------------------------------------------------
# The corpus
# ---------------------------------------------------------------------------

# Tracked .flow files (minus those under `exclude`, a directory prefix,
# when it is not "") that define main(), byte-sorted, as `flow run`
# decides it: `git ls-files '*.flow' | xargs grep -l -E
# 'function[[:space:]]+main' | LC_ALL=C sort`.
export function cl_corpus(exclude: string) -> ptr<ProcStrs> {
    let tracked: ptr<ProcStrs> = gl_git_ls("*.flow")
    let out: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(tracked) {
        let f: string = sl_get(tracked, i)
        if (s_empty(exclude) or not s_starts(f, exclude)) and not cl_is_runner(f) and gl_has_main(f) {
            sl_push(out, f)
        }
        i = i + 1
    }
    gl_sort(out)
    return out
}

# The repository's own gate programs and test runners: everything under
# compiler/scripts/, tests/scripts/, and each tests/**/run.flow. Run with
# no arguments from the repository root they start the corpus, other gates
# or the test suites, so they are not corpus programs. The shell scripts
# they replaced were never in the corpus, and none has a recorded golden.
export function cl_is_runner(f: string) -> bool {
    if s_starts(f, "compiler/scripts/") or s_starts(f, "tests/scripts/") {
        return true
    }
    return s_starts(f, "tests/") and s_ends(f, "/run.flow")
}

# The elements matching the regular expression (`grep -E REGEX`).
export function cl_grep(l: ptr<ProcStrs>, pattern: string) -> ptr<ProcStrs> {
    let r: ptr<Regex> = rx_compile(pattern, 0)
    let out: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(l) {
        if rx_search(r, sl_get(l, i)) != null {
            sl_push(out, sl_get(l, i))
        }
        i = i + 1
    }
    return out
}

# Untracked paths, byte-sorted (`git status --porcelain
# --untracked-files=normal | sed -n 's/^?? //p' | LC_ALL=C sort`).
export function cl_untracked() -> ptr<ProcStrs> {
    let c: ptr<ProcCmd> = proc_cmd("git")
    proc_arg(c, "status")
    proc_arg(c, "--porcelain")
    proc_arg(c, "--untracked-files=normal")
    proc_stdin(c, PROC_NULL)
    proc_stderr(c, PROC_INHERIT)
    let r: ptr<ProcResult> = proc_run(c)
    let lines: ptr<ProcStrs> = gl_lines(r.stdout)
    let out: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(lines) {
        if s_starts(sl_get(lines, i), "?? ") {
            sl_push(out, s_from(sl_get(lines, i), 3))
        }
        i = i + 1
    }
    gl_sort(out)
    return out
}

# Name on stderr the untracked paths the programs left behind.
export function cl_report_left_behind(gate: string, before: ptr<ProcStrs>) {
    let after: ptr<ProcStrs> = cl_untracked()
    let left: ptr<ProcStrs> = gl_minus(after, before, false)
    if sl_len(left) > 0 {
        errln(gate + ": the programs left these untracked paths behind:")
        let mut i: i32 = 0
        while i < sl_len(left) {
            errln("  " + sl_get(left, i))
            i = i + 1
        }
    }
}

# FLOW_GATE_JOBS when it is set, else half the CPUs, at least one.
export function cl_default_jobs() -> i32 {
    let forced: i32 = s_atoi(env("FLOW_GATE_JOBS"), 0)
    if forced > 0 {
        return forced
    }
    let j: i32 = gl_ncpu() / 2
    if j < 1 {
        return 1
    }
    return j
}

# Deal the files round-robin to `jobs` chunk files in `work` and start
# one worker per chunk: this program with `worker_args` and the chunk's
# path. Waits for all of them.
export function cl_run_workers(files: ptr<ProcStrs>, jobs: i32, work: string, worker_args: ptr<ProcStrs>) {
    let mut n: i32 = jobs
    if n < 1 {
        n = 1
    }
    let chunks: ptr<ProcStrs> = sl_new()
    let mut c: i32 = 0
    while c < n {
        sl_push(chunks, "")
        c = c + 1
    }
    let mut i: i32 = 0
    while i < sl_len(files) {
        let k: i32 = i % n
        chunks.items[k] = chunks.items[k] + sl_get(files, i) + "\n"
        i = i + 1
    }
    let pids: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let mut started: i32 = 0
    let mut w: i32 = 0
    while w < n {
        if s_len(sl_get(chunks, w)) > 0 {
            let path: string = work + "/chunk." + s_itoa(w)
            let _ok: bool = write_text(path, sl_get(chunks, w))
            let argv: ptr<ProcStrs> = sl_of1(gl_self())
            sl_extend(argv, worker_args)
            sl_push(argv, path)
            pids[started] = gl_spawn(argv)
            started = started + 1
        }
        w = w + 1
    }
    let mut j: i32 = 0
    while j < started {
        let _s: i32 = gl_wait(pids[j])
        j = j + 1
    }
}

# The lines of every file in `work` whose name starts with `prefix`.
export function cl_collect(work: string, prefix: string) -> ptr<ProcStrs> {
    let names: ptr<ProcStrs> = list_dir(work)
    gl_sort(names)
    let out: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(names) {
        if s_starts(sl_get(names, i), prefix) {
            sl_extend(out, gl_file_lines(work + "/" + sl_get(names, i)))
        }
        i = i + 1
    }
    return out
}

# ---------------------------------------------------------------------------
# Failure causes
# ---------------------------------------------------------------------------

let mut RX_CACHE: ptr<GlMap> = null

# A compiled pattern, kept for the next call.
function rx_of(pattern: string) -> ptr<Regex> {
    if RX_CACHE == null {
        RX_CACHE = gl_map_new()
    }
    let m: ptr<GlMap> = RX_CACHE
    if gl_map_has(m, pattern) {
        return (gl_map_get(m, pattern) as ptr<u8>) as ptr<Regex>
    }
    let r: ptr<Regex> = rx_compile(pattern, 0)
    gl_map_put(m, pattern, (r as ptr<u8>) as string)
    return r
}

export function cl_sub(text: string, pattern: string, repl: string, count: i32) -> string {
    return rx_sub(rx_of(pattern), repl, text, count)
}

export function cl_matches(text: string, pattern: string) -> bool {
    return rx_search(rx_of(pattern), text) != null
}

# The lines of a build log with color codes removed and the CLI's own
# status lines (they start with an emoji) left out.
export function cl_plain_lines(log: string) -> ptr<ProcStrs> {
    let text: string = cl_sub(read_text(log), "\x1b\\[[0-9;]*m", "", 0)
    let lines: ptr<ProcStrs> = gl_lines(s_chomp_all(text))
    let out: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(lines) {
        let l: string = sl_get(lines, i)
        if not (s_starts(l, "ℹ️") or s_starts(l, "✅") or s_starts(l, "❌") or s_starts(l, "⚠️") or s_starts(l, "🚀")) {
            sl_push(out, l)
        }
        i = i + 1
    }
    if sl_len(out) == 0 {
        sl_push(out, "")
    }
    return out
}

# The first line matching `pattern`, or "".
export function cl_first_match(lines: ptr<ProcStrs>, pattern: string) -> string {
    let r: ptr<Regex> = rx_of(pattern)
    let mut i: i32 = 0
    while i < sl_len(lines) {
        if rx_search(r, sl_get(lines, i)) != null {
            return sl_get(lines, i)
        }
        i = i + 1
    }
    return ""
}

# The first line with a character that is not white space, or "".
export function cl_first_nonblank(lines: ptr<ProcStrs>) -> string {
    return cl_first_match(lines, "[^ \t\n\r\x0b\x0c]")
}

# The first undefined symbol a failed link names: Mach-O prints
# `  "_sym", referenced from:`, GNU ld `undefined reference to `sym'`.
export function cl_undefined_symbol(lines: ptr<ProcStrs>) -> string {
    let mach: ptr<Regex> = rx_of("^[ \t\n\r\x0b\x0c]*\"_?([^\"]+)\", referenced from:.*")
    let gnu: ptr<Regex> = rx_of(".*undefined reference to `([^']+)'.*")
    let mut i: i32 = 0
    while i < sl_len(lines) {
        let m: ptr<RxMatch> = rx_search(mach, sl_get(lines, i))
        if m != null {
            return rx_m_group(m, 1)
        }
        let g: ptr<RxMatch> = rx_search(gnu, sl_get(lines, i))
        if g != null {
            return rx_m_group(g, 1)
        }
        i = i + 1
    }
    return ""
}

# Drop trailing white space, cut to 160 characters and turn tabs into
# spaces: the end of the shell's cause normalization (`sed
# 's/[[:space:]]+$//' | cut -c1-160 | tr '\t' ' '`).
export function cl_cause_tail(s: string) -> string {
    let p: ptr<u8> = s as ptr<u8>
    let mut n: i32 = s_len(s)
    while n > 0 and (p[n - 1] == 32 or p[n - 1] == 9 or p[n - 1] == 10 or p[n - 1] == 13 or p[n - 1] == 11 or p[n - 1] == 12) {
        n = n - 1
    }
    # 160 characters: count UTF-8 lead bytes.
    let mut chars: i32 = 0
    let mut i: i32 = 0
    while i < n {
        if (p[i] & 192) != 128 {
            if chars == 160 {
                break
            }
            chars = chars + 1
        }
        i = i + 1
    }
    return s_replace(s_slice(s, 0, i), "\t", " ")
}

# ---------------------------------------------------------------------------
# Report tables
# ---------------------------------------------------------------------------

# `cut -f2 | sort | uniq -c | sort -rn | awk '{ printf "  %-15s %5d\n",
# $2, $1 }'` over the values given.
export function cl_status_table(values: ptr<ProcStrs>) -> string {
    let c: ptr<GlCounts> = gl_count_desc(values)
    let mut out: string = ""
    let mut i: i32 = 0
    while i < c.n {
        out = out + "  " + pad_right(cl_first_word(sl_get(c.vals, i)), 15) + " " + gl_num(c.counts[i], 5) + "\n"
        i = i + 1
    }
    return out
}

function cl_first_word(s: string) -> string {
    let w: ptr<ProcStrs> = s_words(s)
    return sl_get(w, 0)
}

# `sort | uniq -c | sort -rn | awk '{ c = $1; $1 = ""; sub(/^ /, "");
# split($0, a, "\t"); printf "  %5d  %-Ws %s\n", c, a[1], a[2] }' |
# head -60` over "status TAB cause" rows. Rebuilding $0 joins the fields
# with single spaces, so the tab is gone by the split: a[1] is the whole
# row with its blanks squeezed and a[2] is empty.
export function cl_cause_table(rows: ptr<ProcStrs>, width: i32) -> string {
    let c: ptr<GlCounts> = gl_count_desc(rows)
    let mut out: string = ""
    let mut i: i32 = 0
    while i < c.n and i < 60 {
        let joined: string = sl_join(s_words(sl_get(c.vals, i)), " ")
        out = out + "  " + gl_num(c.counts[i], 5) + "  " + pad_right(joined, width) + " \n"
        i = i + 1
    }
    return out
}
