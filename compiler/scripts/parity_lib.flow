    return k
}

export function pl_sha256_hex(src: ptr<u8>, n: i64) -> string {
    let kt: ptr<i64> = sha_k_table()
    # Padded message: data, 0x80, zeros, 64-bit big-endian bit length.
    let total: i64 = ((n + 9 + 63) / 64) * 64
    let msg: ptr<u8> = malloc(total) as ptr<u8>
    let mut i: i64 = 0
    while i < total {
        msg[i] = 0
        i = i + 1
    }
    i = 0
    while i < n {
        msg[i] = src[i]
        i = i + 1
    }
    msg[n] = 128
    let bits: i64 = n * 8
    let mut b: i64 = 0
    while b < 8 {
        msg[total - 1 - b] = ((bits >> (b * 8)) & 255) as u8
        b = b + 1
    }
    let h: ptr<i64> = malloc(8 * 8) as ptr<i64>
    h[0] = 1779033703
    h[1] = 3144134277
    h[2] = 1013904242
    h[3] = 2773480762
    h[4] = 1359893119
    h[5] = 2600822924
    h[6] = 528734635
    h[7] = 1541459225
    let w: ptr<i64> = malloc(64 * 8) as ptr<i64>
    let mut off: i64 = 0
    while off < total {
        let mut t: i32 = 0
        while t < 16 {
            let q: i64 = off + (t as i64) * 4
            w[t] = ((msg[q] as i64) << 24) | ((msg[q + 1] as i64) << 16) | ((msg[q + 2] as i64) << 8) | (msg[q + 3] as i64)
            t = t + 1
        }
        while t < 64 {
            let s0: i64 = sha_rotr(w[t - 15], 7) ^ sha_rotr(w[t - 15], 18) ^ (w[t - 15] >> 3)
            let s1: i64 = sha_rotr(w[t - 2], 17) ^ sha_rotr(w[t - 2], 19) ^ (w[t - 2] >> 10)
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & SHA_M32
            t = t + 1
        }
        let mut a: i64 = h[0]
        let mut bb: i64 = h[1]
        let mut c: i64 = h[2]
        let mut d: i64 = h[3]
        let mut e: i64 = h[4]
        let mut f: i64 = h[5]
        let mut g: i64 = h[6]
        let mut hh: i64 = h[7]
        t = 0
        while t < 64 {
            let S1: i64 = sha_rotr(e, 6) ^ sha_rotr(e, 11) ^ sha_rotr(e, 25)
            let ch: i64 = (e & f) ^ ((e ^ SHA_M32) & g)
            let temp1: i64 = (hh + S1 + ch + kt[t] + w[t]) & SHA_M32
            let S0: i64 = sha_rotr(a, 2) ^ sha_rotr(a, 13) ^ sha_rotr(a, 22)
            let maj: i64 = (a & bb) ^ (a & c) ^ (bb & c)
            let temp2: i64 = (S0 + maj) & SHA_M32
            hh = g
            g = f
            f = e
            e = (d + temp1) & SHA_M32
            d = c
            c = bb
            bb = a
            a = (temp1 + temp2) & SHA_M32
            t = t + 1
        }
        h[0] = (h[0] + a) & SHA_M32
        h[1] = (h[1] + bb) & SHA_M32
        h[2] = (h[2] + c) & SHA_M32
        h[3] = (h[3] + d) & SHA_M32
        h[4] = (h[4] + e) & SHA_M32
        h[5] = (h[5] + f) & SHA_M32
        h[6] = (h[6] + g) & SHA_M32
        h[7] = (h[7] + hh) & SHA_M32
        off = off + 64
    }
    let hex: ptr<u8> = "0123456789abcdef" as ptr<u8>
    let out: ptr<u8> = malloc(65) as ptr<u8>
    let mut j: i32 = 0
    while j < 8 {
        let mut k: i32 = 0
        while k < 8 {
            let nib: i64 = (h[j] >> ((7 - k) * 4) as i64) & 15
            out[j * 8 + k] = hex[nib as i32]
            k = k + 1
        }
        j = j + 1
    }
    out[64] = 0
    return out as string
}

# shasum -a 256 of a file, "" when it cannot be read.
export function pl_sha256_file(path: string) -> string {
    let b: Bytes = read_bytes(path)
    if b.len < 0 {
        return ""
    }
    return pl_sha256_hex(b.data, b.len)
}
