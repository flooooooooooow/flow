# Parity gate for algebraic effects on flowc (#675, #996).
#
# flowc lowers `effect`, `capability`, `handle E with C { }`, effect rows
# (`-> T with E`) and `capability E` parameters the way the Python host does
# (src/flow/parser.py, type_checker.py, c_generator.py). This gate holds it
# to the same results:
#
#   ./flow tool compiler/scripts/parity_effects.flow
#       flowc against the goldens in compiler/fixtures/effects/: the
#       diagnostics of each rejected fixture, or the run output and exit code
#       of each accepted one, plus the `log` registry package demo.
#
#   ./flow tool compiler/scripts/parity_effects.flow --python <rev>
#       also runs the Python host from git revision <rev> on the fixtures and
#       on every tracked .flow file that uses effects, and requires the same
#       result from flowc: accept or reject, the same diagnostics for the
#       fixtures, and the same output and exit code when both run.
#
#   ./flow tool compiler/scripts/parity_effects.flow --write-golden <rev>
#       rewrite the goldens from the Python host at <rev>.
#
# A result is one of
#   reject        followed by the effect diagnostics, one per line
#   reject-cc     the C did not compile
#   reject-link   the C compiled but did not link (a runtime the program
#                 needs is not linked here; the same holds on both hosts)
#   run exit=N    followed by what the program printed
#
# Fixtures use Stable strict checking by default. A fixture marked
# `# effects-mode: permissive` opts into legacy zero/no-op fallback, and
# `# effects-mode: runtime-strict` records stderr from the default fail-loud
# runtime path. Corpus files
# compile the way `flow run` does (Python --lenient, flowc FLOWC_TYPECHECK=1).
#
# Diagnostics are compared as text. Two Python messages spell a separator
# with an em dash and an ellipsis; flowc writes ": " and "...", and the gate
# maps the Python spelling before comparing.
#
# The last Python revision checked is 860b7dd7 (origin/main before the port).
#
# Env: FLOWC_BIN=<path> tests that binary instead of building
# compiler/build/flowc_bootstrap from the checked-in bootstrap C.

import "tools/flow_cli/sys.flow"
import "compiler/scripts/parity_lib.flow"
import std.process { ProcCmd, ProcStrs, proc_arg }
import std.regex { Regex, RxMatch, rx_search, rx_m_byte_end }

const USAGE: string = "usage: ./flow tool compiler/scripts/parity_effects.flow"
const FIX: string = "compiler/fixtures/effects"

# Strings the whole gate shares (module statics cannot be strings).
struct Gate {
    root: string,
    work: string,
    bin: string,
    log_demo: string,
    lib: string
}

let mut G: ptr<Gate> = null

# The C runtime `flow run` links (runtime/*.c), built once for both hosts.
const RT_SOURCES: string = "flow_concurrency flow_fiber flow_fctx_init flow_netpoll flow_netpoll_fiber flow_http_bench flow_tcp flow_race flow_cont flow_rt_support flow_rt_task_store flow_rt_fiber_async flow_rt_parallel flow_rt_cchan flow_rt_sysinfo flow_rt_crypto flow_tls"

# cc with the gate's CFLAGS.
function cc_c() -> ptr<ProcCmd> {
    let g: ptr<Gate> = G
    let c: ptr<ProcCmd> = cmd(sl_of3(pl_cc(), "-std=c11", "-D_DEFAULT_SOURCE"))
    proc_arg(c, "-w")
    proc_arg(c, "-O1")
    proc_arg(c, "-I" + g.root + "/runtime")
    return c
}

function build_runtime() {
    let g: ptr<Gate> = G
    let objs: ptr<ProcStrs> = sl_new()
    let names: ptr<ProcStrs> = s_words(RT_SOURCES)
    let mut i: i32 = 0
    while i < sl_len(names) {
        let f: string = sl_get(names, i)
        let c: ptr<ProcCmd> = cc_c()
        proc_arg(c, "-DFLOW_HAS_OPENSSL=0")
        proc_arg(c, "-c")
        proc_arg(c, "runtime/" + f + ".c")
        proc_arg(c, "-o")
        proc_arg(c, g.work + "/rt/" + f + ".o")
        check(run(c))
        sl_push(objs, g.work + "/rt/" + f + ".o")
        i = i + 1
    }
    let m: string = uname_m()
    let mut asm_src: string = ""
    if s_eq(m, "arm64") or s_eq(m, "aarch64") {
        asm_src = "runtime/flow_fctx_arm64.S"
    } elif s_eq(m, "x86_64") or s_eq(m, "amd64") {
        asm_src = "runtime/flow_fctx_x86_64.S"
    }
    if s_len(asm_src) > 0 {
        let a: ptr<ProcCmd> = cmd(sl_of3(pl_cc(), "-c", asm_src))
        proc_arg(a, "-o")
        proc_arg(a, g.work + "/rt/fctx.o")
        check(run(a))
        sl_push(objs, g.work + "/rt/fctx.o")
    }
    # An archive, so a program links only the runtime objects it uses (the
    # rest need the Flow-side runtime in lib/runtime, which `flow run`
    # compiles).
    g.lib = g.work + "/rt/libflowrt.a"
    rm_f(g.lib)
    let ar: ptr<ProcCmd> = cmd(sl_of3("ar", "rcs", g.lib))
    i = 0
    while i < sl_len(objs) {
        proc_arg(ar, sl_get(objs, i))
        i = i + 1
    }
    check(run(ar))
}

function fixture_mode(f: string) -> string {
    let lines: ptr<ProcStrs> = pl_read_lines(f)
    if sl_has(lines, "# effects-mode: permissive") {
        return "permissive"
    } elif sl_has(lines, "# effects-mode: strict") {
        return "strict"
    } elif sl_has(lines, "# effects-mode: runtime-strict") {
        return "runtime-strict"
    }
    return "plain"
}

# Compile, link and run `c`; the result goes to `res`.
function run_c(c: string, res: string, m: string) {
    let g: ptr<Gate> = G
    let stem: string = s_slice(c, 0, s_len(c) - 2)
    let exe: string = stem + ".exe"
    let cc: ptr<ProcCmd> = cc_c()
    proc_arg(cc, "-c")
    proc_arg(cc, c)
    proc_arg(cc, "-o")
    proc_arg(cc, stem + ".o")
    if pl_run(cc, "-", "-", 0) != 0 {
        let _w: bool = write_text(res, "reject-cc\n")
        return
    }
    let ln: ptr<ProcCmd> = cmd(sl_of3(pl_cc(), stem + ".o", g.lib))
    proc_arg(ln, "-lm")
    proc_arg(ln, "-pthread")
    if s_eq(uname_s(), "Darwin") {
        proc_arg(ln, "-framework")
        proc_arg(ln, "CoreFoundation")
    }
    proc_arg(ln, "-o")
    proc_arg(ln, exe)
    if pl_run(ln, "-", "-", 0) != 0 {
        let _w2: bool = write_text(res, "reject-link\n")
        return
    }
    let dir: string = path_dirname(c)
    let r: ptr<ProcCmd> = pl_cmd1(exe)
    let mut code: i32 = 0
    if s_eq(m, "permissive") {
        cmd_env(r, "FLOW_PERMISSIVE_EFFECTS", "1")
        code = pl_run(r, dir + "/run.txt", "-", 10)
    } elif s_eq(m, "runtime-strict") {
        cmd_env(r, "FLOW_STRICT_EFFECTS", "1")
        code = pl_run(r, dir + "/run.txt", "&", 10)
    } else {
        code = pl_run(r, dir + "/run.txt", "-", 10)
    }
    let _w3: bool = write_text(res, "run exit=" + s_itoa(code) + "\n" + read_text(dir + "/run.txt"))
}

# flowc's result for `f`.
function flowc_result(f: string, res: string, m: string) {
    let g: ptr<Gate> = G
    let d: string = path_dirname(res)
    let mut strict: string = "0"
    if s_eq(m, "strict") {
        strict = "1"
    }
    let c: ptr<ProcCmd> = pl_cmd1(g.bin)
    cmd_env(c, "FLOWC_STRICT_EFFECTS", strict)
    if s_eq(m, "permissive") {
        cmd_env(c, "FLOWC_PERMISSIVE_EFFECTS", "1")
    } elif s_eq(m, "runtime-strict") {
        # Compile permissively so the runtime failure path can be exercised.
        cmd_env(c, "FLOWC_PERMISSIVE_EFFECTS", "1")
    }
    cmd_env(c, "FLOWC_BUNDLE", "1")
    cmd_env(c, "FLOWC_DIR", g.root)
    cmd_env(c, "FLOWC_TYPECHECK", "1")
    cmd_env(c, "FLOWC_IN", f)
    cmd_env(c, "FLOWC_OUT", d + "/fc.c")
    let code: i32 = pl_run(c, d + "/fc.log", "&", 0)
    if code != 0 or not nonempty(d + "/fc.c") {
        # sed -n 's/^.*:[0-9]*:[0-9]*: error: //p'
        let rx: ptr<Regex> = pl_rx("^.*:[0-9]*:[0-9]*: error: ")
        let lines: ptr<ProcStrs> = pl_read_lines(d + "/fc.log")
        let mut text: string = "reject\n"
        let mut i: i32 = 0
        while i < sl_len(lines) {
            let l: string = sl_get(lines, i)
            let mt: ptr<RxMatch> = rx_search(rx, l)
            if mt != null {
                text = text + s_from(l, rx_m_byte_end(mt, 0)) + "\n"
            }
            i = i + 1
        }
        let _w: bool = write_text(res, text)
        return
    }
    run_c(d + "/fc.c", res, m)
}

# The Python host's result for `f` (the host from `rev` lives in `pyref`).
function python_result(pyref: string, f: string, res: string, m: string, lenient: bool) {
    let d: string = path_dirname(res)
    let c: ptr<ProcCmd> = cmd(sl_of3("python3", "-m", "flow.transpiler"))
    proc_arg(c, path_basename(f))
    proc_arg(c, "--c")
    if lenient {
        proc_arg(c, "--lenient")
    }
    if s_eq(m, "strict") {
        proc_arg(c, "--strict-effects")
    }
    proc_arg(c, "-o")
    proc_arg(c, d + "/py.c")
    cmd_cwd(c, path_dirname(f))
    cmd_env(c, "PYTHONPATH", pyref + "/src")
    let code: i32 = pl_run(c, d + "/py.log", "&", 0)
    if code != 0 or not nonempty(d + "/py.c") {
        let lines: ptr<ProcStrs> = pl_read_lines(d + "/py.log")
        let mut text: string = "reject\n"
        let mut i: i32 = 0
        while i < sl_len(lines) {
            let l: string = sl_get(lines, i)
            if s_starts(l, "  ✗ ") {
                let msg: string = s_replace(s_replace(s_from(l, s_len("  ✗ ")), " — ", ": "), "…", "...")
                if s_contains(msg, "effect") or s_contains(msg, "Effect") or s_contains(msg, "Capability") or s_contains(msg, "handle") {
                    text = text + msg + "\n"
                }
            }
            i = i + 1
        }
        let _w: bool = write_text(res, text)
        return
    }
    run_c(d + "/py.c", res, m)
}

# The `log` registry package demo (#991) with the package beside it, so
# both hosts resolve it without a package install.
function make_log_demo() -> string {
    let g: ptr<Gate> = G
    let d: string = g.work + "/log_demo"
    mkdir_p_or_exit(d)
    let _c: bool = copy_file("registry/packages/log/src/lib.flow", d + "/lib.flow")
    let src: ptr<ProcStrs> = pl_read_lines("examples/ecosystem/log_demo/src/main.flow")
    let mut text: string = ""
    let mut i: i32 = 0
    while i < sl_len(src) {
        let l: string = sl_get(src, i)
        if s_starts(l, "import log.lib {") {
            text = text + "import .lib {" + s_from(l, s_len("import log.lib {")) + "\n"
        } else {
            text = text + l + "\n"
        }
        i = i + 1
    }
    let _w: bool = write_text(d + "/main.flow", text)
    return d + "/main.flow"
}

function key_of(f: string) -> string {
    let g: ptr<Gate> = G
    let mut rel: string = f
    if s_starts(f, g.root + "/") {
        rel = s_from(f, s_len(g.root) + 1)
    }
    return pl_key(rel)
}

function rel_of(f: string) -> string {
    let g: ptr<Gate> = G
    if s_starts(f, g.root + "/") {
        return s_from(f, s_len(g.root) + 1)
    }
    return f
}

function golden_of(f: string) -> string {
    let g: ptr<Gate> = G
    if s_eq(f, g.log_demo) {
        return g.root + "/" + FIX + "/log_demo.expected"
    }
    return s_slice(f, 0, s_len(f) - 5) + ".expected"
}

function setup_python(rev: string) -> string {
    let g: ptr<Gate> = G
    let r: string = g.work + "/pyref"
    mkdir_p_or_exit(r)
    check(pl_git_archive(rev, sl_of2("src/flow", "lib"), r))
    return r
}

# The first line of a file ("$(head -1 F)").
function first_line(p: string) -> string {
    return s_chomp_all(pl_head(read_text(p), 1))
}

function main() -> i32 {
    G = malloc(40) as ptr<Gate>
    let g: ptr<Gate> = G
    g.root = pl_enter()
    g.work = g.root + "/compiler/build/parity_effects"
    let args: ptr<ProcStrs> = pl_args()
    let mode: string = sl_get(args, 0)
    let rev: string = sl_get(args, 1)
    pl_fresh(g.work, sl_of2("out", "rt"))
    g.bin = pl_flowc(g.root + "/", true, false)
    outln("=== parity_effects: flowc = " + g.bin + " ===")

    build_runtime()

    let fixtures: ptr<ProcStrs> = sl_new()
    let fx: ptr<ProcStrs> = glob_suffix(FIX, ".flow")
    let mut i: i32 = 0
    while i < sl_len(fx) {
        sl_push(fixtures, g.root + "/" + sl_get(fx, i))
        i = i + 1
    }
    g.log_demo = make_log_demo()
    let programs: ptr<ProcStrs> = sl_copy(fixtures)
    sl_push(programs, g.log_demo)

    if s_eq(mode, "--write-golden") {
        if s_len(rev) == 0 {
            errln(USAGE + " --write-golden <rev>")
            cli_exit(2)
        }
        let r: string = setup_python(rev)
        i = 0
        while i < sl_len(programs) {
            let f: string = sl_get(programs, i)
            let k: string = key_of(f)
            mkdir_p_or_exit(g.work + "/out/" + k)
            python_result(r, f, g.work + "/out/" + k + "/py.res", fixture_mode(f), false)
            let _c: bool = copy_file(g.work + "/out/" + k + "/py.res", golden_of(f))
            i = i + 1
        }
        outln("wrote goldens for " + s_itoa(sl_len(programs)) + " programs from " + rev)
        cli_exit(0)
    }

    let mut fail: i32 = 0

    # 1. Fixtures and the log demo against the goldens.
    let mut pass: i32 = 0
    i = 0
    while i < sl_len(programs) {
        let f: string = sl_get(programs, i)
        i = i + 1
        let k: string = key_of(f)
        mkdir_p_or_exit(g.work + "/out/" + k)
        let res: string = g.work + "/out/" + k + "/fc.res"
        flowc_result(f, res, fixture_mode(f))
        let gold: string = golden_of(f)
        if is_file(gold) and same_bytes(gold, res) {
            pass = pass + 1
        } else {
            fail = fail + 1
            errln("FAIL " + rel_of(f))
            errs(pl_diff_head(gold, res, 10, false))
        }
    }
    outln("fixtures: pass=" + s_itoa(pass) + " fail=" + s_itoa(sl_len(programs) - pass))

    # 2. Optional: live against the Python host at <rev>.
    if s_eq(mode, "--python") {
        if s_len(rev) == 0 {
            errln(USAGE + " --python <rev>")
            cli_exit(2)
        }
        let r: string = setup_python(rev)
        let mut live_pass: i32 = 0
        let mut live_fail: i32 = 0
        i = 0
        while i < sl_len(programs) {
            let f: string = sl_get(programs, i)
            i = i + 1
            let k: string = key_of(f)
            let o: string = g.work + "/out/" + k
            python_result(r, f, o + "/py.res", fixture_mode(f), false)
            if same_bytes(o + "/py.res", o + "/fc.res") {
                live_pass = live_pass + 1
            } else {
                live_fail = live_fail + 1
                errln("FAIL live " + rel_of(f))
                errs(pl_diff_head(o + "/py.res", o + "/fc.res", 10, false))
            }
        }
        outln("live fixtures python@" + rev + ": pass=" + s_itoa(live_pass) + " fail=" + s_itoa(live_fail))
        fail = fail + live_fail

        # Every tracked program that uses effects.
        let rx: ptr<Regex> = pl_rx("^\\s*(export\\s+)?(effect|capability)\\s+[A-Z]\\w*\\s*\\{|^\\s*handle\\s+\\w|\\)\\s*(->\\s*[^{]*)?\\bwith\\s+[A-Z]|capability\\s+[A-Z]\\w*\\s*[,)]")
        let tracked: ptr<ProcStrs> = pl_ls_files("*.flow")
        let corpus: ptr<ProcStrs> = sl_new()
        i = 0
        while i < sl_len(tracked) {
            let rel: string = sl_get(tracked, i)
            i = i + 1
            if not s_starts(rel, FIX + "/") and pl_grep_file(rx, rel) {
                sl_push(corpus, rel)
            }
        }
        let _w: bool = write_text(g.work + "/corpus.txt", pl_lines_text(corpus))
        let gaps: ptr<ProcStrs> = pl_read_lines(FIX + "/known_gaps.txt")
        let mut n: i32 = 0
        let mut same_run: i32 = 0
        let mut same_reject: i32 = 0
        let mut stage_diff: i32 = 0
        let mut diff_n: i32 = 0
        let mut known: i32 = 0
        i = 0
        while i < sl_len(corpus) {
            let rel: string = sl_get(corpus, i)
            i = i + 1
            let f: string = g.root + "/" + rel
            let k: string = key_of(f)
            let o: string = g.work + "/out/" + k
            mkdir_p_or_exit(o)
            n = n + 1
            python_result(r, f, o + "/py.res", "plain", true)
            flowc_result(f, o + "/fc.res", "plain")
            let pyh: string = first_line(o + "/py.res")
            let fch: string = first_line(o + "/fc.res")
            let mut gap: bool = false
            let mut j: i32 = 0
            while j < sl_len(gaps) {
                if s_starts(sl_get(gaps, j), rel + " ") {
                    gap = true
                }
                j = j + 1
            }
            if s_starts(pyh, "run") and same_bytes(o + "/py.res", o + "/fc.res") {
                same_run = same_run + 1
            } elif s_starts(pyh, "reject") and s_eq(pyh, fch) {
                same_reject = same_reject + 1
            } elif s_starts(pyh, "reject") and s_starts(fch, "reject") {
                # Rejected on both hosts, at different stages. Listed so a
                # flowc C error behind a Python link error stays visible.
                same_reject = same_reject + 1
                stage_diff = stage_diff + 1
                outln("both reject " + rel + ": python=" + pyh + " flowc=" + fch)
            } elif gap {
                known = known + 1
                outln("known gap " + rel + ": python=" + pyh + " flowc=" + fch)
            } else {
                diff_n = diff_n + 1
                errln("FAIL corpus " + rel + ": python=" + pyh + " flowc=" + fch)
            }
        }
        outln("corpus python@" + rev + ": files=" + s_itoa(n) + " same_run=" + s_itoa(same_run) + " same_reject=" + s_itoa(same_reject) + " (different stage: " + s_itoa(stage_diff) + ") known_gaps=" + s_itoa(known) + " fail=" + s_itoa(diff_n))
        fail = fail + diff_n
    }

    if fail != 0 {
        outln("parity_effects: FAIL (" + s_itoa(fail) + ")")
        cli_exit(1)
    }
    outln("parity_effects: PASS")
    cli_exit(0)
    return 0
}
