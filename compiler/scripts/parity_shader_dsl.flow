# Parity gate for the Shader DSL (FSL) port (compiler/src/shader_dsl.flow).
#
# The Flow port replaced src/flow/shader_dsl.py, shader_codegen.py and
# shader_codegen_wgsl.py. Their output was recorded as goldens beside each
# fixture in compiler/fixtures/shader_dsl/:
#
#   <name>.metal.expected / <name>.wgsl.expected   every file the build
#       wrote, concatenated in name order under `=== <file>` headers
#   <name>.metal.error / <name>.wgsl.error          the exception text
#   <name>.expand                                   host-stub outcome:
#       `stub`, `pass` (source unchanged) or `err: <message>`
#   <name>.name                                     optional fill name
#   examples__gpu__<stem>.<target>.sha256           digest of the bundle for
#       each shader example (the Metal galleries run to megabytes)
#
#   ./flow tool compiler/scripts/parity_shader_dsl.flow
#       flowc vs goldens, the host stub over every tracked .flow file, and
#       the examples built end to end with python and python3 stubbed out.
#
#   ./flow tool compiler/scripts/parity_shader_dsl.flow --python <rev>
#       also run the original Python from git revision <rev> over every
#       tracked .flow file, both targets, and require byte-identical output
#       (or the same error) from flowc. Needs python3 and git.
#
#   ./flow tool compiler/scripts/parity_shader_dsl.flow --write-golden <rev>
#       rewrite the goldens from the Python at <rev>.
#
# The last Python revision is 0b6d6ac4 (origin/main before the port).
#
# One deliberate difference: flowc stubs a module only when a fill head
# starts a line. The Python matched one anywhere, so it stubbed the two
# tests/lang programs that name the syntax in a string literal.
#
# Env: FLOWC_BIN=<path> tests that binary instead of building
# compiler/build/flowc_bootstrap from the checked-in bootstrap C.

import "tools/flow_cli/sys.flow"
import "compiler/scripts/parity_lib.flow"
import std.process { ProcCmd, ProcStrs, proc_arg }
import std.regex { Regex }
import std.bytebuf { ByteBuf, bb_new, bb_puts, bb_put_bytes, bb_cstr }

const USAGE: string = "usage: ./flow tool compiler/scripts/parity_shader_dsl.flow"
const FIX: string = "compiler/fixtures/shader_dsl"
const WORK: string = "compiler/build/parity_shader_dsl"
const DEVIATION: string = " tests/lang/test_dsl_detect.flow tests/lang/test_shader_dsl_port.flow "
const STUB: string = "function main() -> i32 {\n    return 0\n}"

let mut BIN_P: ptr<u8> = null

function bin() -> string {
    return BIN_P as string
}

# "${f//\//__}" without the .flow
function key_of(f: string) -> string {
    let k: string = pl_key(f)
    if s_ends(k, ".flow") {
        return s_slice(k, 0, s_len(k) - 5)
    }
    return k
}

# ${f%.flow}
function base_of(f: string) -> string {
    if s_ends(f, ".flow") {
        return s_slice(f, 0, s_len(f) - 5)
    }
    return f
}

# The optional fill name beside a fixture, newlines dropped.
function name_of(f: string) -> string {
    let side: string = base_of(f) + ".name"
    if is_file(side) {
        return s_replace(read_text(side), "\n", "")
    }
    return ""
}

# Every file in `d` in name order under a header, as the goldens hold it.
function bundle(d: string) -> string {
    let names: ptr<ProcStrs> = list_dir(d)
    let keep: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(names) {
        if not s_starts(sl_get(names, i), ".") {
            sl_push(keep, sl_get(names, i))
        }
        i = i + 1
    }
    sl_sort(keep, false)
    let b: ptr<ByteBuf> = bb_new(65536)
    i = 0
    while i < sl_len(keep) {
        let f: string = sl_get(keep, i)
        bb_puts(b, "=== " + f + "\n")
        let data: Bytes = read_bytes(d + "/" + f)
        if data.len > 0 {
            bb_put_bytes(b, data.data, data.len as i32)
        }
        bb_puts(b, "\n")
        i = i + 1
    }
    return bb_cstr(b)
}

# Build `input` for `target`: <pre>.out (the bundle) or <pre>.err (the
# message).
function flowc_build(input: string, target: string, name: string, pre: string) {
    let dir: string = pre + ".d"
    rm_rf(dir)
    rm_f(pre + ".out")
    rm_f(pre + ".err")
    mkdir_p_or_exit(dir)
    let c: ptr<ProcCmd> = pl_cmd1(bin())
    cmd_env(c, "FLOWC_SHADER", target)
    cmd_env(c, "FLOWC_IN", input)
    cmd_env(c, "FLOWC_OUT", dir)
    cmd_env(c, "FLOWC_SHADER_NAME", name)
    let log: string = pl_capture_merged(c)
    if last_status() != 0 {
        if s_starts(log, "flowc shader: ") {
            let _w: bool = write_text(pre + ".err", s_from(log, 14) + "\n")
        } else {
            let _w2: bool = write_text(pre + ".err", "flowc failed without a shader diagnostic: " + log + "\n")
        }
    } else {
        let _w3: bool = write_text(pre + ".out", bundle(dir))
    }
    rm_rf(dir)
}

# The host stub's outcome for `input` in `out`: stub, pass or err: <message>.
function flowc_expand(input: string, out: string) {
    let exp: string = WORK + "/expand.flow"
    let c: ptr<ProcCmd> = pl_cmd1(bin())
    cmd_env(c, "FLOWC_SHADER", "expand")
    cmd_env(c, "FLOWC_IN", input)
    cmd_env(c, "FLOWC_OUT", exp)
    let log: string = pl_capture_merged(c)
    if last_status() != 0 {
        let mut msg: string = log
        if s_starts(msg, "flowc shader: ") {
            msg = s_from(msg, 14)
        }
        let _w: bool = write_text(out, "err: " + msg + "\n")
    } elif same_bytes(input, exp) {
        let _w2: bool = write_text(out, "pass\n")
    } elif s_eq(pl_cat(exp), STUB) {
        let _w3: bool = write_text(out, "stub\n")
    } else {
        let _w4: bool = write_text(out, "other\n")
    }
}

# The Python at <rev> over the `path<TAB>name` rows in `list`; each gets
# <key>.<target>.out / .err and <key>.expand in `outdir`.
function python_ref(rev: string, list: string, outdir: string) {
    let pkg: string = WORK + "/pyref/fslref"
    mkdir_p_or_exit(pkg)
    let _i: bool = write_text(pkg + "/__init__.py", "")
    let mods: ptr<ProcStrs> = sl_of3("shader_dsl", "shader_codegen", "shader_codegen_wgsl")
    let mut i: i32 = 0
    while i < sl_len(mods) {
        check(pl_git_show(rev + ":src/flow/" + sl_get(mods, i) + ".py", pkg + "/" + sl_get(mods, i) + ".py"))
        i = i + 1
    }
    check(pl_python(py_shader_ref(), sl_of3(WORK + "/pyref", list, outdir)))
}

function list_rows(files: ptr<ProcStrs>) -> string {
    let mut out: string = ""
    let mut i: i32 = 0
    while i < sl_len(files) {
        out = out + sl_get(files, i) + "\t" + name_of(sl_get(files, i)) + "\n"
        i = i + 1
    }
    return out
}

# shasum -a 256 of a file.
function digest(path: string) -> string {
    return pl_sha256_file(path)
}

# Run a command for the end-to-end checks: python stubbed out on PATH,
# FLOWC_BIN set, output to e2e.log.
function e2e(c: ptr<ProcCmd>, nopy: string) -> bool {
    cmd_env(c, "PATH", nopy + ":" + env("PATH"))
    cmd_env(c, "FLOWC_BIN", bin())
    return pl_run(c, WORK + "/e2e.log", "&", 0) == 0
}

function e2e_tail() {
    errs(pl_tail(read_text(WORK + "/e2e.log"), 5))
}

function main() -> i32 {
    let root: string = pl_enter()
    let args: ptr<ProcStrs> = pl_args()
    let mode: string = sl_get(args, 0)
    let rev: string = sl_get(args, 1)
    pl_fresh(WORK, sl_of2("flowc", "python"))
    let mut b: string = pl_flowc("", false, true)
    if not s_starts(b, "/") {
        b = root + "/" + b
    }
    BIN_P = b as ptr<u8>
    outln("=== parity_shader_dsl: flowc = " + bin() + " ===")

    let corpus: ptr<ProcStrs> = pl_ls_files("*.flow")
    let _c: bool = write_text(WORK + "/corpus.txt", pl_lines_text(corpus))
    # Shader examples: a line that opens a fill block.
    let rx: ptr<Regex> = pl_rx("^[ \\t\\n\\r\\f\\v]*shader[ \\t\\n\\r\\f\\v]+fill[ \\t\\n\\r\\f\\v]+[A-Za-z_][A-Za-z0-9_]*[ \\t\\n\\r\\f\\v]*\\{")
    let examples: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(corpus) {
        let f: string = sl_get(corpus, i)
        if s_starts(f, "examples/") and pl_grep_file(rx, f) {
            sl_push(examples, f)
        }
        i = i + 1
    }
    sl_sort(examples, false)
    let fixtures: ptr<ProcStrs> = glob_suffix(FIX, ".flow")
    let targets: ptr<ProcStrs> = sl_of2("metal", "wgsl")

    if s_eq(mode, "--write-golden") {
        if s_len(rev) == 0 {
            errln(USAGE + " --write-golden <rev>")
            cli_exit(2)
        }
        let rows: ptr<ProcStrs> = sl_copy(fixtures)
        sl_extend(rows, examples)
        let _l: bool = write_text(WORK + "/list.txt", list_rows(rows))
        python_ref(rev, WORK + "/list.txt", WORK + "/python")
        let old: ptr<ProcStrs> = list_dir(FIX)
        i = 0
        while i < sl_len(old) {
            let n: string = sl_get(old, i)
            if not s_starts(n, ".") and (s_ends(n, ".expected") or s_ends(n, ".error") or s_ends(n, ".expand") or s_ends(n, ".sha256")) {
                rm_f(FIX + "/" + n)
            }
            i = i + 1
        }
        i = 0
        while i < sl_len(fixtures) {
            let f: string = sl_get(fixtures, i)
            i = i + 1
            let k: string = key_of(f)
            let base: string = base_of(f)
            let mut t: i32 = 0
            while t < 2 {
                let tg: string = sl_get(targets, t)
                t = t + 1
                if is_file(WORK + "/python/" + k + "." + tg + ".err") {
                    let _e: bool = copy_file(WORK + "/python/" + k + "." + tg + ".err", base + "." + tg + ".error")
                } else {
                    let _o: bool = copy_file(WORK + "/python/" + k + "." + tg + ".out", base + "." + tg + ".expected")
                }
            }
            let _x: bool = copy_file(WORK + "/python/" + k + ".expand", base + ".expand")
        }
        i = 0
        while i < sl_len(examples) {
            let k: string = key_of(sl_get(examples, i))
            i = i + 1
            let mut t: i32 = 0
            while t < 2 {
                let tg: string = sl_get(targets, t)
                t = t + 1
                let _s: bool = write_text(FIX + "/" + k + "." + tg + ".sha256", digest(WORK + "/python/" + k + "." + tg + ".out") + "\n")
            }
        }
        outln("wrote goldens for " + s_itoa(sl_len(fixtures)) + " fixtures and " + s_itoa(sl_len(examples)) + " examples from " + rev)
        cli_exit(0)
    }

    let mut fail: i32 = 0
    let mut pass: i32 = 0

    # 1. Fixtures and examples vs goldens.
    let checked: ptr<ProcStrs> = sl_copy(fixtures)
    sl_extend(checked, examples)
    i = 0
    while i < sl_len(checked) {
        let f: string = sl_get(checked, i)
        i = i + 1
        let k: string = key_of(f)
        let base: string = base_of(f)
        let mut t: i32 = 0
        while t < 2 {
            let tg: string = sl_get(targets, t)
            t = t + 1
            let got: string = WORK + "/flowc/" + k + "." + tg
            flowc_build(f, tg, name_of(f), got)
            let sha: string = FIX + "/" + k + "." + tg + ".sha256"
            if is_file(sha) {
                if is_file(got + ".out") and s_eq(digest(got + ".out"), pl_cat(sha)) {
                    pass = pass + 1
                } else {
                    fail = fail + 1
                    errln("FAIL " + f + " (" + tg + "): digest differs from " + sha)
                    if is_file(got + ".err") {
                        errln("     flowc error: " + pl_cat(got + ".err"))
                    }
                }
            } elif is_file(base + "." + tg + ".error") {
                if is_file(got + ".err") and same_bytes(base + "." + tg + ".error", got + ".err") {
                    pass = pass + 1
                } else {
                    fail = fail + 1
                    errln("FAIL " + f + " (" + tg + "): want error: " + pl_cat(base + "." + tg + ".error"))
                    if is_file(got + ".err") {
                        errln("     got error:  " + pl_cat(got + ".err"))
                    }
                }
            } elif is_file(base + "." + tg + ".expected") {
                if is_file(got + ".out") and same_bytes(base + "." + tg + ".expected", got + ".out") {
                    pass = pass + 1
                } else {
                    fail = fail + 1
                    errln("FAIL " + f + " (" + tg + "): output differs from " + base + "." + tg + ".expected")
                    if is_file(got + ".out") {
                        errs(pl_diff_head(base + "." + tg + ".expected", got + ".out", 20, false))
                    } else {
                        errln("     flowc error: " + pl_cat(got + ".err"))
                    }
                }
            } else {
                fail = fail + 1
                errln("FAIL " + f + " (" + tg + "): no golden")
            }
        }
        if is_file(base + ".expand") {
            flowc_expand(f, WORK + "/flowc/" + k + ".expand")
            if same_bytes(base + ".expand", WORK + "/flowc/" + k + ".expand") {
                pass = pass + 1
            } else {
                fail = fail + 1
                errln("FAIL " + f + ": host stub " + pl_cat(WORK + "/flowc/" + k + ".expand") + ", want " + pl_cat(base + ".expand"))
            }
        }
    }
    outln("fixtures: pass=" + s_itoa(pass) + " fail=" + s_itoa(fail))

    # 2. Host stub over every tracked .flow: the shader examples become the
    # stub, every other file passes through byte for byte.
    let mut corpus_n: i32 = 0
    let mut corpus_fail: i32 = 0
    i = 0
    while i < sl_len(corpus) {
        let f: string = sl_get(corpus, i)
        i = i + 1
        if s_starts(f, FIX + "/") {
            continue
        }
        let k: string = key_of(f)
        corpus_n = corpus_n + 1
        flowc_expand(f, WORK + "/flowc/" + k + ".expand")
        let mut want: string = "pass"
        if sl_has(examples, f) {
            want = "stub"
        }
        let got: string = pl_cat(WORK + "/flowc/" + k + ".expand")
        if not s_eq(got, want) {
            corpus_fail = corpus_fail + 1
            errln("FAIL host stub " + f + ": " + got + ", want " + want)
        }
    }
    outln("host stub: files=" + s_itoa(corpus_n) + " stubbed=" + s_itoa(sl_len(examples)) + " fail=" + s_itoa(corpus_fail))
    fail = fail + corpus_fail

    # 3. Optional: live diff against the Python at <rev>, every tracked file.
    if s_eq(mode, "--python") {
        if s_len(rev) == 0 {
            errln(USAGE + " --python <rev>")
            cli_exit(2)
        }
        let _l2: bool = write_text(WORK + "/list.txt", list_rows(corpus))
        python_ref(rev, WORK + "/list.txt", WORK + "/python")
        let mut live_n: i32 = 0
        let mut live_fail: i32 = 0
        i = 0
        while i < sl_len(corpus) {
            let f: string = sl_get(corpus, i)
            i = i + 1
            let k: string = key_of(f)
            let nm: string = name_of(f)
            let mut t: i32 = 0
            while t < 2 {
                let tg: string = sl_get(targets, t)
                t = t + 1
                live_n = live_n + 1
                let got: string = WORK + "/flowc/" + k + "." + tg
                if not is_file(got + ".out") and not is_file(got + ".err") {
                    flowc_build(f, tg, nm, got)
                }
                let py: string = WORK + "/python/" + k + "." + tg
                if is_file(py + ".err") {
                    if not same_bytes(py + ".err", got + ".err") {
                        live_fail = live_fail + 1
                        errln("FAIL live " + f + " (" + tg + "): python error differs")
                    }
                } elif not same_bytes(py + ".out", got + ".out") {
                    live_fail = live_fail + 1
                    errln("FAIL live " + f + " (" + tg + "): python output differs")
                }
            }
            live_n = live_n + 1
            if not is_file(WORK + "/flowc/" + k + ".expand") {
                flowc_expand(f, WORK + "/flowc/" + k + ".expand")
            }
            let pye: string = pl_cat(WORK + "/python/" + k + ".expand")
            let fce: string = pl_cat(WORK + "/flowc/" + k + ".expand")
            if s_contains(DEVIATION, " " + f + " ") {
                if not s_eq(pye, "stub") or not s_eq(fce, "pass") {
                    live_fail = live_fail + 1
                    errln("FAIL live " + f + ": expected the documented deviation (python stub, flowc pass)")
                }
            } elif not same_bytes(WORK + "/python/" + k + ".expand", WORK + "/flowc/" + k + ".expand") {
                live_fail = live_fail + 1
                errln("FAIL live " + f + ": host stub python=" + pye + " flowc=" + fce)
            }
        }
        outln("live python@" + rev + ": files=" + s_itoa(sl_len(corpus)) + " checks=" + s_itoa(live_n) + " fail=" + s_itoa(live_fail) + " (deviation:" + s_slice(DEVIATION, 0, s_len(DEVIATION) - 1) + ")")
        fail = fail + live_fail
    }

    # 4. End to end with python and python3 stubbed out: ./flow shader builds
    # the Metal gallery and WGSL, xcrun metal accepts the Metal when present,
    # and a shader example compiles to a host program that runs.
    let nopy: string = WORK + "/nopy"
    mkdir_p_or_exit(nopy)
    let pys: ptr<ProcStrs> = sl_of2("python", "python3")
    i = 0
    while i < 2 {
        let py: string = sl_get(pys, i)
        pl_write_exec(nopy + "/" + py, "#!/bin/sh\necho \"" + py + " $*\" >> \"" + nopy + "/calls.log\"\nexit 127\n")
        i = i + 1
    }
    let _cl: bool = write_text(nopy + "/calls.log", "")
    let mut e2e_fail: i32 = 0
    let s1: ptr<ProcCmd> = cmd(sl_of3("./flow", "shader", "examples/gpu/shader_showcase.flow"))
    proc_arg(s1, "--emit-only")
    if e2e(s1, nopy) {
        let gallery: string = "build/shaders/shader_showcase_gallery.metal"
        let entries: ptr<ProcStrs> = pl_read_lines("build/shaders/shader_showcase_gallery.entries")
        let mut n: i32 = 0
        let mut j: i32 = 0
        while j < sl_len(entries) {
            if s_len(sl_get(entries, j)) > 0 {
                n = n + 1
            }
            j = j + 1
        }
        outln("e2e: ./flow shader --emit-only wrote " + s_itoa(n) + " entries")
        let probe: ptr<ProcCmd> = cmd(sl_of3("xcrun", "-sdk", "macosx"))
        proc_arg(probe, "-f")
        proc_arg(probe, "metal")
        if pl_run(probe, "-", "-", 0) == 0 {
            let m: ptr<ProcCmd> = cmd(sl_of3("xcrun", "-sdk", "macosx"))
            proc_arg(m, "metal")
            proc_arg(m, "-c")
            proc_arg(m, gallery)
            proc_arg(m, "-o")
            proc_arg(m, WORK + "/showcase.air")
            if pl_run(m, "", WORK + "/metal.log", 0) == 0 {
                outln("e2e: xcrun metal compiled " + gallery)
            } else {
                e2e_fail = e2e_fail + 1
                errln("FAIL e2e: xcrun metal rejected " + gallery)
                errs(pl_head(read_text(WORK + "/metal.log"), 20))
            }
        }
    } else {
        e2e_fail = e2e_fail + 1
        errln("FAIL e2e: ./flow shader --emit-only")
        e2e_tail()
    }
    let s2: ptr<ProcCmd> = cmd(sl_of3("./flow", "shader", "examples/gpu/vgpu/gradient.flow"))
    proc_arg(s2, "--wgsl")
    proc_arg(s2, "--name")
    proc_arg(s2, "vgpu_gradient")
    if e2e(s2, nopy) and s_contains(read_text("build/shaders/vgpu_gradient_fill.wgsl"), "fn vgpu_gradient_frag") {
        outln("e2e: ./flow shader --wgsl wrote build/shaders/vgpu_gradient_fill.wgsl")
    } else {
        e2e_fail = e2e_fail + 1
        errln("FAIL e2e: ./flow shader --wgsl")
        e2e_tail()
    }
    let s3: ptr<ProcCmd> = cmd(sl_of3("./flow", "compile", "examples/gpu/shader_plasma.flow"))
    cmd_env(s3, "FLOW_BUILD_ROOT", root + "/" + WORK + "/fbuild")
    if e2e(s3, nopy) and e2e(pl_cmd1(WORK + "/fbuild/shader_plasma"), nopy) {
        outln("e2e: ./flow compile shader_plasma host stub exit 0")
    } else {
        e2e_fail = e2e_fail + 1
        errln("FAIL e2e: ./flow compile examples/gpu/shader_plasma.flow")
        e2e_tail()
    }
    if nonempty(nopy + "/calls.log") {
        e2e_fail = e2e_fail + 1
        errln("FAIL e2e: python was called:")
        errs(read_text(nopy + "/calls.log"))
    } else {
        outln("e2e: no python call logged")
    }
    fail = fail + e2e_fail

    if fail != 0 {
        outln("parity_shader_dsl: FAIL (" + s_itoa(fail) + ")")
        cli_exit(1)
    }
    outln("parity_shader_dsl: PASS")
    cli_exit(0)
    return 0
}

function py_shader_ref() -> string {
    return "import os, shutil, sys, tempfile\n" +
        "sys.path.insert(0, sys.argv[1])\n" +
        "from fslref import shader_dsl as dsl\n" +
        "from fslref.shader_codegen import compile_shader_file as metal\n" +
        "from fslref.shader_codegen_wgsl import compile_shader_file_wgsl as wgsl\n" +
        "\n" +
        "outdir = sys.argv[3]\n" +
        "\n" +
        "def bundle(d):\n" +
        "    parts = []\n" +
        "    for name in sorted(os.listdir(d)):\n" +
        "        with open(os.path.join(d, name), \"rb\") as f:\n" +
        "            parts.append(b\"=== \" + name.encode() + b\"\\n\" + f.read() + b\"\\n\")\n" +
        "    return b\"\".join(parts)\n" +
        "\n" +
        "for row in open(sys.argv[2], encoding=\"utf-8\").read().split(\"\\n\"):\n" +
        "    if not row:\n" +
        "        continue\n" +
        "    path, name = row.split(\"\\t\")\n" +
        "    key = path.replace(\"/\", \"__\")[: -len(\".flow\")]\n" +
        "    for target, build in ((\"metal\", metal), (\"wgsl\", wgsl)):\n" +
        "        tmp = tempfile.mkdtemp()\n" +
        "        try:\n" +
        "            build(path, tmp, shader_name=name or None)\n" +
        "            with open(os.path.join(outdir, f\"{key}.{target}.out\"), \"wb\") as f:\n" +
        "                f.write(bundle(tmp))\n" +
        "        except Exception as e:\n" +
        "            with open(os.path.join(outdir, f\"{key}.{target}.err\"), \"w\", encoding=\"utf-8\") as f:\n" +
        "                f.write(str(e) + \"\\n\")\n" +
        "        finally:\n" +
        "            shutil.rmtree(tmp)\n" +
        "    # module_resolver: an FSL module becomes a stub main.\n" +
        "    with open(path, encoding=\"utf-8\", errors=\"surrogateescape\") as f:\n" +
        "        text = f.read()\n" +
        "    try:\n" +
        "        if dsl.has_fill_shader_dsl(text):\n" +
        "            mod = dsl.extract_shader_module(text)\n" +
        "            res = \"stub\" if mod.fills else \"err: Fill-shader module has no `shader fill` blocks\"\n" +
        "        else:\n" +
        "            res = \"pass\"\n" +
        "    except SyntaxError as e:\n" +
        "        res = \"err: \" + str(e)\n" +
        "    with open(os.path.join(outdir, f\"{key}.expand\"), \"w\", encoding=\"utf-8\") as f:\n" +
        "        f.write(res + \"\\n\")\n"
}
