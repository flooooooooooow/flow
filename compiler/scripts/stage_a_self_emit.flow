# Mini self-host: the Stage-A driver emits the real frontend sources to C,
# compiles each to an object and links them, then emits driver.flow to
# self_driver.o and links stage_a_driver_flow_self (the Stage-A Flow driver
# with the self-emitted frontend). Uses stage_a_driver_flow (CLI) when
# present, else the C stage_a_driver. Needs one of those binaries (run
# roundtrip first).
#
#   ./flow tool compiler/scripts/stage_a_self_emit.flow
#
# Env: C_TO_HDR=<path> reuses a built header deriver (roundtrip sets it).

import "tools/flow_cli/sys.flow"
import "compiler/scripts/gate_lib.flow"
import std.process { ProcStrs }

function main() -> i32 {
    let root: string = gate_enter()
    let hdr: string = gate_c_to_hdr(root)
    gate_mkdir("compiler/build")

    let mut driver: string = ""
    if is_exec("compiler/build/stage_a_driver_flow") {
        driver = "compiler/build/stage_a_driver_flow"
    } elif is_exec("compiler/build/stage_a_driver") {
        driver = "compiler/build/stage_a_driver"
    } else {
        gate_fail("FAIL stage_a_self_emit: missing stage_a_driver_flow or stage_a_driver (run roundtrip.flow first)")
    }
    outln("stage_a_self_emit: using " + driver)

    # Order mirrors compile_module in roundtrip (token, ..., typecheck, resolve).
    run_self_emit_plan("./" + driver, "self_", "self_emit", hdr)

    # Relocatable link: proves driver-emitted frontend objects resolve together.
    link_frontend("compiler/build/flowc_frontend_self.o", "self_", "")
    check_frontend_symbols("compiler/build/flowc_frontend_self.o", "FAIL stage_a_self_emit: ", " missing from flowc_frontend_self.o")
    # The frontend must not define main (that belongs to the Flow driver TU).
    if nm_defines_main("compiler/build/flowc_frontend_self.o") {
        gate_fail("FAIL stage_a_self_emit: flowc_frontend_self.o must not define main")
    }
    outln("PASS stage_a_self_emit flowc_frontend_self.o")

    # Fully Stage-A-bootstrapped Flow driver: emit driver.flow to
    # self_driver.c, compile with the self_* headers, link against
    # flowc_frontend_self.o. Only libc and cc remain outside the Flow emit.
    outln("=== stage_a_driver_flow_self build ===")
    gate_hdr(hdr, "compiler/build/self_typecheck.c", "compiler/build/self_typecheck.h")
    gate_hdr(hdr, "compiler/build/self_resolve.c", "compiler/build/self_resolve.h")

    gate_run(sl_of3("./" + driver, "compiler/src/driver.flow", "compiler/build/self_driver.c"))
    if not has("compiler/build/self_driver.c", "int main(int argc, char **argv)") {
        gate_fail("FAIL stage_a_driver_flow_self: expected int main(int argc, char **argv) in self_driver.c")
    }
    # Imports skipped: parse/cgen bodies must not appear in the driver TU.
    if has_line_start("compiler/build/self_driver.c", "int32_t flowc_parse_program") {
        gate_fail("FAIL stage_a_driver_flow_self: parse symbols must come from frontend, not driver emit")
    }
    let args: ptr<ProcStrs> = sl_of2("-O0", "-c")
    let hs: ptr<ProcStrs> = driver_headers()
    let mut i: i32 = 0
    while i < sl_len(hs) {
        sl_push2(args, "-include", "compiler/build/self_" + sl_get(hs, i) + ".h")
        i = i + 1
    }
    sl_push(args, "compiler/build/self_driver.c")
    sl_push2(args, "-o", "compiler/build/self_driver.o")
    gate_cc(args)
    let link: ptr<ProcStrs> = sl_of3("-O0", "-o", "compiler/build/stage_a_driver_flow_self")
    sl_push2(link, "compiler/build/self_driver.o", "compiler/build/flowc_frontend_self.o")
    sl_push(link, "-lm")
    gate_cc(link)

    outln("=== stage_a_driver_flow_self smoke (stage_a_sum → exit 45) ===")
    sum_smoke("./compiler/build/stage_a_driver_flow_self", "compiler/build/driven_sum_flow_self.c", "./compiler/build/driven_sum_flow_self", "driven_sum_flow_self")
    outln("PASS stage_a_driver_flow_self")
    return 0
}
