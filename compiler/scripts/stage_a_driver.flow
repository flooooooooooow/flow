# Build and smoke the Stage-A C driver against flowc_frontend.o.
# Prefer running roundtrip.flow, which builds the object first; this
# program assumes compiler/build/flowc_frontend.o and the sibling
# *_flowc.c files already exist.
#
#   ./flow tool compiler/scripts/stage_a_driver.flow
#
# Env: C_TO_HDR=<path> reuses a built header deriver.

import "tools/flow_cli/sys.flow"
import "compiler/scripts/gate_lib.flow"
import std.process { ProcStrs }

function main() -> i32 {
    let root: string = gate_enter()
    let hdr: string = gate_c_to_hdr(root)
    gate_mkdir("compiler/build")

    if not is_file("compiler/build/flowc_frontend.o") {
        gate_fail("FAIL stage_a_driver: missing compiler/build/flowc_frontend.o (run roundtrip.flow first)")
    }

    # Make sure the generated headers exist (parser/cgen may not have been
    # derived yet).
    let mods: ptr<ProcStrs> = s_words("token ast lexer parser cgen typecheck resolve")
    let mut i: i32 = 0
    while i < sl_len(mods) {
        let base: string = "compiler/build/" + sl_get(mods, i) + "_flowc"
        if not is_file(base + ".h") {
            if not is_file(base + ".c") {
                gate_fail("FAIL stage_a_driver: missing " + base + ".c")
            }
            gate_hdr(hdr, base + ".c", base + ".h")
        }
        i = i + 1
    }

    outln("=== stage_a_driver build ===")
    gate_cc(s_words("-O0 -I compiler/build -I compiler/host -o compiler/build/stage_a_driver compiler/host/stage_a_driver.c compiler/build/flowc_frontend.o -lm"))

    outln("=== stage_a_driver smoke (stage_a_sum → exit 45) ===")
    sum_smoke("./compiler/build/stage_a_driver", "compiler/build/driven_sum.c", "./compiler/build/driven_sum", "driven_sum")
    outln("PASS stage_a_driver")
    return 0
}
