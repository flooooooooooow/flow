# Every module under compiler/src must bundle-emit C that the C compiler
# accepts with no errors. This is the Phase-B exit condition of
# docs/project/self-hosting.md turned into a gate: if a language gap
# reappears, it shows up here as a named module with a count of C
# diagnostics.
#
#   ./flow tool compiler/scripts/selfcompile_audit.flow
#   FLOWC_AUDIT_BIN=compiler/build/flowc_bootstrap ./flow tool compiler/scripts/selfcompile_audit.flow

import "tools/flow_cli/sys.flow"
import "compiler/scripts/gate_lib.flow"
import "tools/flow_cli/flowc_build.flow"
import std.process { ProcCmd, ProcStrs, proc_arg, proc_args }

# "file:12:3: message" -> "message" (sed -E 's/^[^:]+:[0-9]+:[0-9]+: //').
function strip_location(line: string) -> string {
    let c1: i32 = s_find_byte(line, 58, 0)
    if c1 <= 0 {
        return line
    }
    let c2: i32 = s_find_byte(line, 58, c1 + 1)
    if c2 < 0 or not s_is_digits(s_slice(line, c1 + 1, c2)) {
        return line
    }
    let c3: i32 = s_find_byte(line, 58, c2 + 1)
    if c3 < 0 or not s_is_digits(s_slice(line, c2 + 1, c3)) {
        return line
    }
    if s_byte(line, c3 + 1) != 32 {
        return line
    }
    return s_from(line, c3 + 2)
}

# `sort | uniq -c | sort -rn | head -5 | sed 's/^/    /'` over `lines`.
function top_errors(lines: ptr<ProcStrs>) -> string {
    sl_sort(lines, false)
    let uniq: ptr<ProcStrs> = sl_new()
    let counts: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(lines) {
        let n: i32 = sl_len(uniq)
        if n > 0 and s_eq(sl_get(uniq, n - 1), sl_get(lines, i)) {
            let last: ptr<ProcStrs> = counts
            last.items[n - 1] = s_itoa(s_atoi(sl_get(counts, n - 1), 0) + 1)
        } else {
            sl_push(uniq, sl_get(lines, i))
            sl_push(counts, "1")
        }
        i = i + 1
    }
    # uniq -c pads the count to 4 columns on BSD and 7 on GNU.
    let mut width: i32 = 7
    if s_eq(uname_s(), "Darwin") {
        width = 4
    }
    let rows: ptr<ProcStrs> = sl_new()
    let mut j: i32 = 0
    while j < sl_len(uniq) {
        sl_push(rows, pad_left(sl_get(counts, j), width) + " " + sl_get(uniq, j))
        j = j + 1
    }
    # sort -rn: count descending, ties by the whole line descending.
    let mut a: i32 = 1
    while a < sl_len(rows) {
        let mut b: i32 = a
        while b > 0 and row_before(sl_get(rows, b), sl_get(rows, b - 1)) {
            let t: string = sl_get(rows, b)
            rows.items[b] = sl_get(rows, b - 1)
            rows.items[b - 1] = t
            b = b - 1
        }
        a = a + 1
    }
    let mut out: string = ""
    let mut k: i32 = 0
    while k < sl_len(rows) and k < 5 {
        out = out + "    " + sl_get(rows, k) + "\n"
        k = k + 1
    }
    return out
}

# True when row `x` sorts before row `y` under `sort -rn`.
function row_before(x: string, y: string) -> bool {
    let cx: i32 = s_atoi(sl_get(s_words(x), 0), 0)
    let cy: i32 = s_atoi(sl_get(s_words(y), 0), 0)
    if cx != cy {
        return cx > cy
    }
    return strcmp(x, y) > 0
}

extern {
    function strcmp(a: string, b: string) -> i32
}

# Audit one module: emit it with `drv`, then check the C with cc. The lines
# to print for it; they start with "PASS " or "FAIL ".
function audit_one(drv: string, err_flag: string, src: string) -> string {
    let name: string = path_stem(src, ".flow")
    let c_out: string = "compiler/build/audit/" + name + ".c"
    let log: string = "compiler/build/audit/" + name + ".log"
    rm_f(c_out)
    # driver.flow binaries take argv; a binary built from main.flow
    # reads FLOWC_IN / FLOWC_OUT. Both are passed so either works.
    let em: ptr<ProcCmd> = cmd(sl_of3(drv, src, c_out))
    cmd_env(em, "FLOWC_BUNDLE", "1")
    cmd_env(em, "FLOWC_DIR", "compiler/src")
    cmd_env(em, "FLOWC_IN", src)
    cmd_env(em, "FLOWC_OUT", c_out)
    if run_to_file(em, log, true) != 0 {
        return "FAIL " + name + ": flowc could not emit\n" + tail_text(read_text(log), 5)
    }
    if not nonempty(c_out) {
        # A driver that exits 0 without writing anything used to surface
        # three steps later as "clang: no input files".
        return "FAIL " + name + ": flowc exited 0 but wrote no C to " + c_out + "\n" + tail_text(read_text(log), 5)
    }
    let sc: ptr<ProcCmd> = cmd(sl_of3("cc", "-fsyntax-only", err_flag))
    proc_arg(sc, c_out)
    let lines: ptr<ProcStrs> = s_lines(capture_merged(sc))
    let errs_found: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(lines) {
        if s_contains(sl_get(lines, i), "error:") {
            sl_push(errs_found, strip_location(sl_get(lines, i)))
        }
        i = i + 1
    }
    if sl_len(errs_found) != 0 {
        return "FAIL " + name + ": " + s_itoa(sl_len(errs_found)) + " C errors\n" + top_errors(errs_found)
    }
    let size: string = s_itoa(s_len(read_text(c_out)))
    return "PASS " + pad_right(name, 14) + " " + pad_left(size, 8) + " bytes of C, 0 diagnostics\n"
}

# Where a worker leaves the report for module `src`.
function result_path(src: string) -> string {
    return "compiler/build/audit/" + path_stem(src, ".flow") + ".result"
}

# Worker: `--worker DRV ERR_FLAG LIST` audits each module named in LIST and
# writes its report next to the C.
function worker(args: ptr<ProcStrs>) -> i32 {
    let drv: string = sl_get(args, 1)
    let err_flag: string = sl_get(args, 2)
    let srcs: ptr<ProcStrs> = gl_file_lines(sl_get(args, 3))
    let mut i: i32 = 0
    while i < sl_len(srcs) {
        let src: string = sl_get(srcs, i)
        let _w: bool = write_text(result_path(src), audit_one(drv, err_flag, src))
        i = i + 1
    }
    return 0
}

# Parallel audits: FLOW_GATE_JOBS, else half the CPUs, as the other gates.
function audit_jobs() -> i32 {
    let forced: i32 = s_atoi(env("FLOW_GATE_JOBS"), 0)
    if forced > 0 {
        return forced
    }
    let j: i32 = gl_ncpu() / 2
    if j < 1 {
        return 1
    }
    return j
}

# The report of every module in `srcs`, in order. With more than one job,
# the modules are dealt round-robin to worker processes (this program with
# --worker) and the reports are read back in the original order, so the
# output does not depend on the job count.
function audit_all(drv: string, err_flag: string, srcs: ptr<ProcStrs>, jobs: i32) -> ptr<ProcStrs> {
    let reports: ptr<ProcStrs> = sl_new()
    if jobs <= 1 or s_len(gl_self()) == 0 {
        let mut f: i32 = 0
        while f < sl_len(srcs) {
            sl_push(reports, audit_one(drv, err_flag, sl_get(srcs, f)))
            f = f + 1
        }
        return reports
    }
    let chunks: ptr<ProcStrs> = sl_new()
    let mut c: i32 = 0
    while c < jobs {
        sl_push(chunks, "")
        c = c + 1
    }
    let mut i: i32 = 0
    while i < sl_len(srcs) {
        rm_f(result_path(sl_get(srcs, i)))
        let k: i32 = i % jobs
        chunks.items[k] = chunks.items[k] + sl_get(srcs, i) + "\n"
        i = i + 1
    }
    let pids: ptr<ProcStrs> = sl_new()
    let mut w: i32 = 0
    while w < jobs {
        if s_len(sl_get(chunks, w)) > 0 {
            let list: string = "compiler/build/audit/chunk." + s_itoa(w)
            let _ok: bool = write_text(list, sl_get(chunks, w))
            let argv: ptr<ProcStrs> = sl_of3(gl_self(), "--worker", drv)
            sl_push2(argv, err_flag, list)
            sl_push(pids, s_itoa(gl_spawn(argv)))
        }
        w = w + 1
    }
    let mut p: i32 = 0
    while p < sl_len(pids) {
        let _s: i32 = gl_wait(s_atoi(sl_get(pids, p), -1))
        p = p + 1
    }
    let mut r: i32 = 0
    while r < sl_len(srcs) {
        let rp: string = result_path(sl_get(srcs, r))
        if is_file(rp) {
            sl_push(reports, read_text(rp))
        } else {
            sl_push(reports, "FAIL " + path_stem(sl_get(srcs, r), ".flow") + ": the audit worker wrote no report\n")
        }
        r = r + 1
    }
    return reports
}

function main() -> i32 {
    let args: ptr<ProcStrs> = proc_args()
    let _self: string = gl_enter_root()
    let _root: string = gate_enter()
    gate_mkdir("compiler/build/audit")
    if s_eq(sl_get(args, 0), "--worker") {
        return worker(args)
    }

    # GCC and clang spell "no cap on reported errors" differently. CI runs
    # on Ubuntu, where cc is GCC.
    let ver: ptr<ProcCmd> = cmd(sl_of2("cc", "--version"))
    cmd_quiet_err(ver)
    let mut err_flag: string = "-fmax-errors=0"
    if s_contains(s_lower(capture_raw(ver)), "clang") {
        err_flag = "-ferror-limit=0"
    }

    let mut drv: string = env("FLOWC_AUDIT_BIN")
    if s_len(drv) == 0 {
        let cands: ptr<ProcStrs> = s_words("compiler/build/stage_a_driver_flow_self compiler/build/stage_a_driver_flow_g2 compiler/build/stage_a_driver_flow compiler/build/flowc_bootstrap")
        let mut i: i32 = 0
        while i < sl_len(cands) and s_len(drv) == 0 {
            if is_exec(sl_get(cands, i)) {
                drv = sl_get(cands, i)
            }
            i = i + 1
        }
    }
    if s_len(drv) == 0 {
        gate_fail("selfcompile_audit: no flowc driver — run bootstrap_from_c.sh first")
    }
    outln("=== self-compile audit via " + drv + " ===")

    let files: ptr<ProcStrs> = glob_sorted("compiler/src", ".flow")
    let srcs: ptr<ProcStrs> = sl_new()
    let mut f: i32 = 0
    while f < sl_len(files) {
        sl_push(srcs, "compiler/src/" + path_basename(sl_get(files, f)))
        f = f + 1
    }
    let reports: ptr<ProcStrs> = audit_all(drv, err_flag, srcs, audit_jobs())
    let mut failed: bool = false
    let mut r: i32 = 0
    while r < sl_len(reports) {
        let rep: string = sl_get(reports, r)
        out(rep)
        if not s_starts(rep, "PASS ") {
            failed = true
        }
        r = r + 1
    }

    if failed {
        gate_fail("FAIL selfcompile_audit: compiler/src does not fully compile under flowc")
    }
    outln("ALL PASS selfcompile_audit (all of compiler/src compiles under flowc)")
    return 0
}
