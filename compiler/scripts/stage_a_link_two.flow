# First-slice import-aware Stage-A: emit two Flow files, link them, and
# expect exit 42.
#
#   - Emit math.flow and main.flow separately (main's `import .math` is
#     skipped)
#   - export function add becomes a non-static C symbol
#   - Link both objects; the binary returns add(40, 2) == 42
#
#   ./flow tool compiler/scripts/stage_a_link_two.flow
#
# Env:
#   FLOWC_RESOLVE_IMPORTS=1  also resolve `import .name` in main to a
#                            sibling path and print it
#   C_TO_HDR=<path>          reuse a built header deriver (roundtrip sets it)

import "tools/flow_cli/sys.flow"
import "compiler/scripts/gate_lib.flow"
import std.process { ProcCmd, ProcStrs }

const PKG: string = "compiler/fixtures/pkg_add"
const BUILD: string = "compiler/build/pkg_add"

# Prefer the Stage-A Flow driver when built, else the flowc built from
# compiler/src. Typecheck on: `import .math { add }` seeds the name.
function emit_one(host: string, src: string, c_out: string) {
    if is_exec("compiler/build/stage_a_driver_flow") {
        gate_run(sl_of3("./compiler/build/stage_a_driver_flow", src, c_out))
    } else {
        env_set("FLOWC_IN", src)
        env_set("FLOWC_OUT", c_out)
        gate_run(sl_of1(host))
    }
}

function is_ident_start(c: i32) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
}

function is_ident(c: i32) -> bool {
    return is_ident_start(c) or (c >= 48 and c <= 57)
}

# The NAME of the first `import .NAME` in `text` (the bash pattern
# import[[:space:]]+\.([A-Za-z_][A-Za-z0-9_]*)), or "".
function first_sibling_import(text: string) -> string {
    let mut from: i32 = 0
    while true {
        let at: i32 = s_find(text, "import", from)
        if at < 0 {
            return ""
        }
        let mut i: i32 = at + 6
        while s_is_space(s_byte(text, i)) {
            i = i + 1
        }
        if i > at + 6 and s_byte(text, i) == 46 and is_ident_start(s_byte(text, i + 1)) {
            let start: i32 = i + 1
            let mut j: i32 = start
            while is_ident(s_byte(text, j)) {
                j = j + 1
            }
            return s_slice(text, start, j)
        }
        from = at + 1
    }
    return ""
}

function main() -> i32 {
    let root: string = gate_enter()
    let hdr: string = gate_c_to_hdr(root)
    gate_mkdir(BUILD)
    let host: string = gate_flowc_host(root)

    outln("=== stage_a_link_two (pkg_add) ===")

    emit_one(host, PKG + "/math.flow", BUILD + "/math.c")
    emit_one(host, PKG + "/main.flow", BUILD + "/main.c")

    # export function must be a linkable (non-static) C symbol.
    if not has_line_start(BUILD + "/math.c", "int32_t add(") {
        gate_fail("FAIL stage_a_link_two: expected non-static int32_t add(...) in math.c")
    }
    if has_line_start(BUILD + "/math.c", "static int32_t add(") {
        gate_fail("FAIL stage_a_link_two: export add must not be static")
    }

    # Import skipped: main still calls add by free name.
    if not has(BUILD + "/main.c", "add(40, 2)") {
        gate_fail("FAIL stage_a_link_two: expected add(40, 2) call in main.c")
    }
    # No duplicate add body in the main TU.
    if has_line_start(BUILD + "/main.c", "int32_t add(") {
        gate_fail("FAIL stage_a_link_two: add must come from math.o, not main emit")
    }

    if s_eq(env("FLOWC_RESOLVE_IMPORTS"), "1") {
        # Resolve `import .sibling` from main to a same-dir sibling .flow
        # (a smoke for driver recursion). The fixture expects math.flow.
        let sib: string = first_sibling_import(s_chomp_all(read_text(PKG + "/main.flow")))
        if s_len(sib) > 0 {
            let sib_path: string = PKG + "/" + sib + ".flow"
            if not is_file(sib_path) {
                gate_fail("FAIL stage_a_link_two: FLOWC_RESOLVE_IMPORTS resolved missing " + sib_path)
            }
            outln("resolve_import ." + sib + " -> " + sib_path)
        } else {
            gate_fail("FAIL stage_a_link_two: FLOWC_RESOLVE_IMPORTS=1 but no import .sibling in main")
        }
    }

    gate_cc(s_words("-O0 -c compiler/build/pkg_add/math.c -o compiler/build/pkg_add/math.o"))
    # Prototype for the imported `add` (imports are skipped at emit, so a
    # sibling header supplies it).
    gate_hdr(hdr, BUILD + "/math.c", BUILD + "/math.h")
    gate_cc(s_words("-O0 -c -include compiler/build/pkg_add/math.h compiler/build/pkg_add/main.c -o compiler/build/pkg_add/main.o"))
    gate_cc(s_words("-O0 -o compiler/build/pkg_add/pkg_add compiler/build/pkg_add/main.o compiler/build/pkg_add/math.o"))

    gate_expect_exit("pkg_add", BUILD + "/pkg_add", 42)
    outln("PASS stage_a_link_two")
    return 0
}
