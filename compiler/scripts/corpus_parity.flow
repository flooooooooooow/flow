# Corpus parity between flowc and the retired Python host on the C backend.
#
# Every tracked .flow file that defines main() is built the way `flow run`
# builds it (`flow compile`, the dependency sync aside), once with flowc and
# once with the Python host (live from an old revision, or from the recorded
# goldens), and both executables run
# with a timeout from the repository root with stdin closed. A file is at
# parity when both hosts reject it, or when both build it and the runs agree
# on exit code and stdout.
# A file whose Python-generated C does not compile but whose flowc build
# succeeds is counted apart as "flowc better"; the floor gates on parity plus
# better, the files where flowc is not behind Python.
#
#   ./flow tool compiler/scripts/corpus_parity.flow
#       flowc live, Python from the recorded goldens in
#       compiler/corpus_parity/python_golden.tsv. Needs no Python.
#   ./flow tool compiler/scripts/corpus_parity.flow --python REV
#       also run the Python host live and compare flowc against it. The
#       Python C backend is retired, so REV names a revision that still has
#       it (flow, flow-driver, src, lib and runtime are taken from REV).
#   ./flow tool compiler/scripts/corpus_parity.flow --python REV --record
#       as --python, then rewrite the goldens from the live Python results.
#   --check          fail when fewer files are at parity than the floor
#   --update         write compiler/corpus_parity/report.txt and the floor
#   --failures       list every file not at parity with its cause
#   --jobs N         parallel builds (default: FLOW_GATE_JOBS, else half the CPUs)
#   --timeout S      seconds per program run (default 10, the timeout the
#                    goldens were recorded with)
#   --only REGEX     restrict the corpus to paths matching REGEX
#   --save PATH      also write the per-file table (path, status, Python
#                    build and exit, flowc build and exit, cause) to PATH
#
# The goldens hold, per file, the Python result: build (ok, reject, ccfail),
# exit code, a checksum of stdout, and whether stdout changed between two
# runs of the same Python-built binary (nondet). For nondet files stdout is
# not compared. For the files in compiler/corpus_parity/timing.txt, whose
# run depends on machine load, only the build is compared. The floor is
# kept per OS (`uname -s`), because some programs
# need a platform runtime; --check passes with a note when this OS has no
# floor yet.
#
# Failure causes are clustered by the first diagnostic line with the file
# name, positions, numbers and quoted names replaced, and ranked by count.
#
# Env: FLOWC_BIN=<path> tests that binary; by default the checked-in
# bootstrap C is compiled to compiler/build/flowc_bootstrap.

import "tools/flow_cli/sys.flow"
import "compiler/scripts/gate_lib.flow"
import "compiler/scripts/corpus_lib.flow"
import std.process { ProcCmd, ProcResult, ProcStrs, proc_args }

const DATA: string = "compiler/corpus_parity"
const GOLDEN: string = "compiler/corpus_parity/python_golden.tsv"
const FLOOR_FILE: string = "compiler/corpus_parity/floor.txt"
const REPORT: string = "compiler/corpus_parity/report.txt"

# First diagnostic line of a failed build, normalized for clustering.
function normalize_cause(line: string, root: string) -> string {
    let exts: string = "(flow|c|h)"
    let mut s: string = cl_sub(line, "\x1b\\[[0-9;]*m", "", 0)
    s = s_replace(s, root + "/", "")
    s = cl_sub(s, "^[^ :]*\\." + exts + ":[0-9]+:[0-9]+: ", "", 1)
    s = cl_sub(s, "^[^ :]*\\." + exts + ":[0-9]+: ", "", 1)
    s = cl_sub(s, "[^ ]*\\." + exts + "\\b", "<file>", 0)
    s = cl_sub(s, "\\(byte [0-9]+\\)", "", 1)
    s = cl_sub(s, "\\(unnamed (struct|union) at [^)]*\\)", "(unnamed \\1)", 0)
    s = cl_sub(s, "unexpected identifier '[^']*'", "unexpected identifier", 1)
    s = cl_sub(s, "'[A-Za-z_][A-Za-z0-9_.]*'", "'X'", 0)
    s = cl_sub(s, "\"[^\"]*\"", "\"S\"", 0)
    s = cl_sub(s, "\\b[0-9]+\\b", "N", 0)
    return cl_cause_tail(s)
}

# Pick the line that says why a build failed. The driver's own messages are
# colored and start with an emoji; generic flowc summaries come last.
function pick_cause(log: string, kind: string, root: string) -> string {
    let plain: ptr<ProcStrs> = cl_plain_lines(log)
    let mut line: string = ""
    if s_eq(kind, "ccfail") {
        # An error in the generated .c first: flowc's own C header import
        # can print preprocessor noise from system headers before it.
        line = cl_first_match(plain, "\\.c:[0-9]+:[0-9]+: (fatal )?error:")
        if s_empty(line) {
            # Link failure: name the first undefined symbol.
            let sym: string = cl_undefined_symbol(plain)
            if not s_empty(sym) {
                line = "link: undefined symbol " + sym
            }
        }
        if s_empty(line) {
            line = cl_first_match(plain, "ld: |linker command failed")
        }
        if s_empty(line) {
            line = cl_first_match(plain, "(^|: )(fatal )?error:")
        }
        if s_empty(line) {
            line = cl_first_match(plain, "Undefined symbols|undefined reference|ld: ")
        }
    } else {
        let keep: ptr<ProcStrs> = sl_new()
        let mut i: i32 = 0
        while i < sl_len(plain) {
            let l: string = sl_get(plain, i)
            if not cl_matches(l, "^(flowc emit|flowc gather|flowc bundle tc|stage_a_driver_flow|flowc): ") and not cl_matches(l, "^(Resolving modules|Parsed [0-9]+ functions|Generated C written|Traceback|  File |    )") {
                sl_push(keep, l)
            }
            i = i + 1
        }
        line = cl_first_nonblank(keep)
        if s_empty(line) {
            line = cl_first_nonblank(plain)
        }
    }
    if s_empty(line) {
        line = "no diagnostic"
    }
    return normalize_cause(line, root)
}

# Build and run one file with one host: one TSV record
#   build TAB exit TAB stdout-cksum TAB nondet TAB cause
function worker(host: string, file: string, secs: i32, work: string, root: string) -> string {
    let dir: string = mktemp_dir(work + "/job.XXXXXX")
    let base: string = path_stem(file, ".flow")
    let log: string = dir + "/build.log"
    env_set("FLOW_BUILD_ROOT", dir)
    env_set("FLOW_HOST", host)
    let mut argv: ptr<ProcStrs> = sl_of3("./flow", "compile", file)
    if s_eq(host, "python") {
        argv = sl_of3(env("CORPUS_PYREF") + "/flow", "compile", file)
    }
    let rc: i32 = gl_run_file(argv, log, GL_ERR_TO_OUT, 0)
    if rc != 0 or not is_exec(dir + "/" + base) {
        let mut build: string = "reject"
        if s_contains(read_text(log), "C compilation/linking failed") {
            build = "ccfail"
        }
        let rec: string = build + "\t-\t-\t-\t" + pick_cause(log, build, root)
        rm_rf(dir)
        return rec
    }
    let mut ec: i32 = gl_run_file(sl_of1(dir + "/" + base), dir + "/out1", GL_ERR_NULL, secs)
    let mut nondet: string = "-"
    if s_eq(host, "python") {
        let ec2: i32 = gl_run_file(sl_of1(dir + "/" + base), dir + "/out2", GL_ERR_NULL, secs)
        nondet = "det"
        if not same_bytes(dir + "/out1", dir + "/out2") or ec != ec2 {
            nondet = "nondet"
        }
    }
    let mut ecs: string = s_itoa(ec)
    if ec == 124 or ec == 137 {
        ecs = "timeout"
    }
    let rec2: string = "ok\t" + ecs + "\t" + gl_cksum_file(dir + "/out1") + "\t" + nondet + "\t-"
    rm_rf(dir)
    return rec2
}

# --worker <work> <secs> <hosts> <chunk>: one worker's files.
function worker_main(args: ptr<ProcStrs>, root: string) -> i32 {
    let work: string = sl_get(args, 1)
    let secs: i32 = s_atoi(sl_get(args, 2), 10)
    let hosts: ptr<ProcStrs> = s_words(sl_get(args, 3))
    let files: ptr<ProcStrs> = gl_file_lines(sl_get(args, 4))
    let mut i: i32 = 0
    while i < sl_len(files) {
        let f: string = sl_get(files, i)
        let mut h: i32 = 0
        while h < sl_len(hosts) {
            let host: string = sl_get(hosts, h)
            let rec: string = worker(host, f, secs, work, root)
            let _a: bool = append_text(work + "/results." + host + "." + s_itoa(pid()), host + "\t" + f + "\t" + rec + "\n")
            h = h + 1
        }
        i = i + 1
    }
    return 0
}

# The results of one host, without the host column, byte-sorted.
function host_results(work: string, host: string) -> ptr<ProcStrs> {
    let rows: ptr<ProcStrs> = cl_collect(work, "results." + host + ".")
    let out: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(rows) {
        sl_push(out, gl_fields_from(sl_get(rows, i), 1))
        i = i + 1
    }
    gl_sort(out)
    return out
}

# The recorded or live Python results joined with flowc's: one row per
# file, `path status py-build py-exit flowc-build flowc-exit why`.
function join_rows(nondet: ptr<GlMap>, timing: ptr<GlMap>, reference: ptr<ProcStrs>, flowc: ptr<ProcStrs>) -> ptr<ProcStrs> {
    let py: ptr<GlMap> = gl_map_new()
    let mut r: i32 = 0
    while r < sl_len(reference) {
        let row: string = sl_get(reference, r)
        let path: string = gl_field(row, 0)
        let mut nd: string = gl_field(row, 4)
        if gl_map_has(nondet, path) {
            nd = "nondet"
        }
        gl_map_put(py, path, gl_field(row, 1) + "\t" + gl_field(row, 2) + "\t" + gl_field(row, 3) + "\t" + nd + "\t" + gl_field(row, 5))
        r = r + 1
    }
    let out: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(flowc) {
        let row: string = sl_get(flowc, i)
        i = i + 1
        let path: string = gl_field(row, 0)
        if not gl_map_has(py, path) {
            sl_push(out, path + "\tnogolden\t-\t-\t-\t-\tno Python golden for this file")
            continue
        }
        let p: string = gl_map_get(py, path)
        let pb: string = gl_field(p, 0)
        let pe: string = gl_field(p, 1)
        let ps: string = gl_field(p, 2)
        let pn: string = gl_field(p, 3)
        let pc: string = gl_field(p, 4)
        let fb: string = gl_field(row, 1)
        let fe: string = gl_field(row, 2)
        let fs: string = gl_field(row, 3)
        let fc: string = gl_field(row, 5)
        let mut st: string = ""
        let mut why: string = ""
        if not s_eq(pb, "ok") and not s_eq(fb, "ok") {
            st = "match"
            why = "both reject"
        } elif s_eq(pb, "ccfail") and s_eq(fb, "ok") {
            st = "flowc-better"
            why = "Python C does not compile: " + pc
        } elif not s_eq(pb, "ok") and s_eq(fb, "ok") {
            st = "flowc-accepts"
            why = "Python " + pb + ": " + pc
        } elif s_eq(fb, "reject") {
            st = "flowc-reject"
            why = fc
        } elif s_eq(fb, "ccfail") {
            st = "flowc-ccfail"
            why = fc
        } elif gl_map_has(timing, path) {
            st = "match"
            why = "same build (run timing not compared)"
        } elif s_eq(fe, "timeout") and not s_eq(pe, "timeout") {
            st = "run-timeout"
            why = "flowc build times out (Python exit " + pe + ")"
        } elif not s_eq(fe, pe) {
            st = "run-exit"
            why = "exit code differs (Python " + pe + ", flowc " + fe + ")"
        } elif not s_eq(pn, "nondet") and not s_eq(fs, ps) {
            st = "run-stdout"
            why = "stdout differs"
        } else {
            st = "match"
            if s_eq(pb, "ok") {
                why = "same run"
            } else {
                why = "both reject"
            }
        }
        sl_push(out, path + "\t" + st + "\t" + pb + "\t" + pe + "\t" + fb + "\t" + fe + "\t" + why)
    }
    return out
}

# The report group of a path: the top directory, or two levels under
# examples, tests, compiler and benchmarks.
function group_of(path: string) -> string {
    let a: ptr<ProcStrs> = s_split(path, 47)
    let n: i32 = sl_len(a)
    let top: string = sl_get(a, 0)
    if n <= 2 {
        return top
    }
    if s_eq(top, "examples") or s_eq(top, "tests") or s_eq(top, "compiler") or s_eq(top, "benchmarks") {
        return top + "/" + sl_get(a, 1)
    }
    return top
}

function dir_table(rows: ptr<ProcStrs>) -> string {
    let totals: ptr<GlMap> = gl_map_new()
    let groups: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(rows) {
        let row: string = sl_get(rows, i)
        let g: string = group_of(gl_field(row, 0))
        let mut t: i32 = 0
        let mut p: i32 = 0
        if gl_map_has(totals, g) {
            let v: string = gl_map_get(totals, g)
            t = s_atoi(gl_field(v, 0), 0)
            p = s_atoi(gl_field(v, 1), 0)
        } else {
            sl_push(groups, g)
        }
        t = t + 1
        if s_eq(gl_field(row, 1), "match") {
            p = p + 1
        }
        gl_map_put(totals, g, s_itoa(t) + "\t" + s_itoa(p))
        i = i + 1
    }
    let lines: ptr<ProcStrs> = sl_new()
    let mut k: i32 = 0
    while k < sl_len(groups) {
        let g: string = sl_get(groups, k)
        let v: string = gl_map_get(totals, g)
        let t: i32 = s_atoi(gl_field(v, 0), 0)
        let p: i32 = s_atoi(gl_field(v, 1), 0)
        sl_push(lines, "  " + pad_right(g, 32) + " " + gl_num(p, 5) + " / " + gl_num(t, 5) + "  " + pad_left(gl_pct(p, t), 5) + "%")
        k = k + 1
    }
    gl_sort_locale(lines)
    return gl_join_lines(lines)
}

function count_rows(rows: ptr<ProcStrs>, st: string, py_build: string, not_match: bool) -> i32 {
    let mut n: i32 = 0
    let mut i: i32 = 0
    while i < sl_len(rows) {
        let row: string = sl_get(rows, i)
        let ok_st: bool = s_empty(st) or s_eq(gl_field(row, 1), st)
        let mut ok_py: bool = true
        if s_eq(py_build, "ok") {
            ok_py = s_eq(gl_field(row, 2), "ok")
        } elif s_eq(py_build, "!ok") {
            ok_py = not s_eq(gl_field(row, 2), "ok")
        }
        if ok_st and ok_py {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

function not_at_parity(rows: ptr<ProcStrs>) -> string {
    let mut out: string = ""
    let mut i: i32 = 0
    while i < sl_len(rows) {
        let row: string = sl_get(rows, i)
        if not s_eq(gl_field(row, 1), "match") {
            out = out + "  " + pad_right(gl_field(row, 1), 14) + " " + gl_field(row, 0) + "  (" + gl_field(row, 6) + ")\n"
        }
        i = i + 1
    }
    return out
}

function finish(code: i32) -> i32 {
    cli_exit(code)
    return code
}

function main() -> i32 {
    let root: string = gl_enter_root()
    let args: ptr<ProcStrs> = proc_args()
    if s_eq(sl_get(args, 0), "--worker") {
        return worker_main(args, root)
    }
    let mut live_python: bool = false
    let mut pyrev: string = ""
    let mut record: bool = false
    let mut do_check: bool = false
    let mut update: bool = false
    let mut failures: bool = false
    let mut only: string = ""
    let mut save: string = ""
    let mut secs: i32 = 10
    let mut jobs: i32 = cl_default_jobs()
    let mut i: i32 = 0
    while i < sl_len(args) {
        let a: string = sl_get(args, i)
        if s_eq(a, "--python") {
            live_python = true
            if i + 1 >= sl_len(args) {
                # The shell's `shift` past the end stopped it here.
                return 1
            }
            i = i + 1
            pyrev = sl_get(args, i)
        } elif s_eq(a, "--record") {
            record = true
        } elif s_eq(a, "--check") {
            do_check = true
        } elif s_eq(a, "--update") {
            update = true
        } elif s_eq(a, "--failures") {
            failures = true
        } elif s_eq(a, "--jobs") or s_eq(a, "--timeout") or s_eq(a, "--only") or s_eq(a, "--save") {
            if i + 1 >= sl_len(args) {
                errln("corpus_parity: " + a + " needs a value")
                return 1
            }
            i = i + 1
            let v: string = sl_get(args, i)
            if s_eq(a, "--jobs") {
                jobs = s_atoi(v, 1)
            } elif s_eq(a, "--timeout") {
                secs = s_atoi(v, 10)
            } elif s_eq(a, "--only") {
                only = v
            } else {
                save = v
            }
        } else {
            errln("corpus_parity: unknown argument " + a)
            return 2
        }
        i = i + 1
    }
    if record and not live_python {
        errln("corpus_parity: --record needs --python REV")
        return 2
    }
    if live_python and s_empty(pyrev) {
        errln("corpus_parity: --python needs a revision that still has the Python C host")
        return 2
    }
    if jobs < 1 {
        jobs = 1
    }

    let flowc: string = gl_flowc_cached("FLOWC_BIN", root)
    env_set("FLOWC_BIN", flowc)

    mkdir_p_or_exit(root + "/build")
    let work: string = mktemp_dir(root + "/build/corpus_parity.XXXXXX")
    on_exit_remove(work)
    if live_python {
        # The Python host as of the revision, run from its own tree.
        mkdir_p_or_exit(work + "/pyref")
        let ga: ptr<ProcStrs> = sl_of3("git", "archive", "-o")
        sl_push2(ga, work + "/pyref.tar", pyrev)
        sl_push2(ga, "flow", "flow-driver")
        sl_push2(ga, "src", "lib")
        sl_push2(ga, "runtime", "compiler/scripts")
        sl_push(ga, "compiler/bootstrap")
        let gs: i32 = run_argv(ga)
        if gs != 0 {
            return finish(gs)
        }
        let tx: ptr<ProcStrs> = sl_of3("tar", "-x", "-f")
        sl_push(tx, work + "/pyref.tar")
        sl_push2(tx, "-C", work + "/pyref")
        let ts: i32 = run_argv(tx)
        if ts != 0 {
            return finish(ts)
        }
        rm_f(work + "/pyref.tar")
        env_set("CORPUS_PYREF", work + "/pyref")
    }

    # The corpus: tracked files with main(), as `flow run` decides it.
    # tests/cgen holds flowc C goldens written after the Python host was
    # retired, so there is no Python result to compare them with.
    let mut files: ptr<ProcStrs> = cl_corpus("tests/cgen/")
    if not s_empty(only) {
        files = cl_grep(files, only)
    }
    let total: i32 = sl_len(files)
    # Programs run from the repository root and some write files there;
    # note what was untracked before, to name what the run left behind.
    let before: ptr<ProcStrs> = cl_untracked()

    let mut hosts: string = "flowc"
    if live_python {
        hosts = "flowc python"
    }
    errln("corpus_parity: " + s_itoa(total) + " files, hosts: " + hosts + ", jobs: " + s_itoa(jobs) + ", timeout: " + s_itoa(secs) + "s")

    let wargs: ptr<ProcStrs> = sl_of3("--worker", work, s_itoa(secs))
    sl_push(wargs, hosts)
    cl_run_workers(files, jobs, work, wargs)

    let flowc_rows: ptr<ProcStrs> = host_results(work, "flowc")
    cl_report_left_behind("corpus_parity", before)
    let mut reference: ptr<ProcStrs> = sl_new()
    if live_python {
        let python_rows: ptr<ProcStrs> = host_results(work, "python")
        if record {
            mkdir_p_or_exit(DATA)
            if not s_empty(only) and is_file(GOLDEN) {
                # Replace only the re-recorded rows.
                let redone: ptr<GlMap> = gl_map_new()
                let mut r: i32 = 0
                while r < sl_len(python_rows) {
                    gl_map_put(redone, gl_field(sl_get(python_rows, r), 0), "1")
                    r = r + 1
                }
                let kept: ptr<ProcStrs> = sl_new()
                let old: ptr<ProcStrs> = gl_file_lines(GOLDEN)
                let mut o: i32 = 0
                while o < sl_len(old) {
                    if not gl_map_has(redone, gl_field(sl_get(old, o), 0)) {
                        sl_push(kept, sl_get(old, o))
                    }
                    o = o + 1
                }
                sl_extend(kept, python_rows)
                gl_sort(kept)
                let _g: bool = write_text(GOLDEN, gl_join_lines(kept))
            } else {
                let _g2: bool = write_text(GOLDEN, gl_join_lines(python_rows))
            }
            errln("corpus_parity: recorded " + s_itoa(sl_len(python_rows)) + " Python results in " + GOLDEN)
        }
        reference = python_rows
    } else {
        if not is_file(GOLDEN) {
            errln("corpus_parity: no goldens at " + GOLDEN + "; run with --python --record")
            return finish(2)
        }
        reference = gl_file_lines(GOLDEN)
    }

    # nondet.txt lists files whose output changes with the clock or the
    # machine even when two back-to-back Python runs agree; their stdout is
    # not compared. timing.txt lists files whose run depends on how loaded
    # the machine is (a 10s limit with seven jobs at once): only their build
    # is compared.
    let nondet: ptr<GlMap> = gl_set_of(gl_list_file(DATA + "/nondet.txt"))
    let timing: ptr<GlMap> = gl_set_of(gl_list_file(DATA + "/timing.txt"))
    let joined: ptr<ProcStrs> = join_rows(nondet, timing, reference, flowc_rows)

    let pass: i32 = count_rows(joined, "match", "", false)
    let better: i32 = count_rows(joined, "flowc-better", "", false)
    # The gate counts files where flowc is not behind Python.
    let gate: i32 = pass + better
    let both_reject: i32 = count_rows(joined, "match", "!ok", false)
    let py_ok: i32 = count_rows(joined, "", "ok", false)
    let py_ok_match: i32 = count_rows(joined, "match", "ok", false)

    let statuses: ptr<ProcStrs> = sl_new()
    let causes: ptr<ProcStrs> = sl_new()
    let mut k: i32 = 0
    while k < sl_len(joined) {
        let row: string = sl_get(joined, k)
        sl_push(statuses, gl_field(row, 1))
        if not s_eq(gl_field(row, 1), "match") {
            sl_push(causes, gl_field(row, 1) + "\t" + gl_field(row, 6))
        }
        k = k + 1
    }

    let mut report: string = "flowc corpus parity with the Python host (C backend)\n\n"
    report = report + "files with main(): " + s_itoa(total) + "\n"
    report = report + "at parity:         " + s_itoa(pass) + " (" + gl_pct(pass, total) + "%)\n"
    report = report + "  same run:        " + s_itoa(py_ok_match) + " of " + s_itoa(py_ok) + " that Python builds (" + gl_pct(py_ok_match, py_ok) + "%)\n"
    report = report + "  both reject:     " + s_itoa(both_reject) + "\n"
    report = report + "flowc better:      " + s_itoa(better) + " (Python's C does not compile, flowc's does)\n\n"
    report = report + "by status:\n" + cl_status_table(statuses) + "\n"
    report = report + "by directory (parity / files):\n" + dir_table(joined) + "\n"
    report = report + "failure causes, ranked (count, status, first flowc diagnostic):\n" + cl_cause_table(causes, 14)
    out(report)

    if not s_empty(save) {
        let _s: bool = write_text(save, gl_join_lines(joined))
    }
    if failures {
        outln("")
        outln("files not at parity:")
        out(not_at_parity(joined))
    }

    let os: string = uname_s()
    let margin: i32 = s_atoi(env_or("FLOOR_MARGIN", "10"), 10)
    if update {
        mkdir_p_or_exit(DATA)
        let _r: bool = write_text(REPORT, report)
        let mut floor_text: string = "# Files at parity (or flowc better) per OS (uname -s). corpus_parity.flow\n"
        floor_text = floor_text + "# --check fails below it. --update sets it FLOOR_MARGIN (default 10) under\n"
        floor_text = floor_text + "# the run, because a few HTTP and timing programs are flaky in parallel.\n"
        let old_floor: ptr<ProcStrs> = gl_file_lines(FLOOR_FILE)
        let mut o2: i32 = 0
        while o2 < sl_len(old_floor) {
            let l: string = sl_get(old_floor, o2)
            if not (s_starts(l, "#") or s_starts(l, os + " ")) {
                floor_text = floor_text + l + "\n"
            }
            o2 = o2 + 1
        }
        floor_text = floor_text + os + " " + s_itoa(gate - margin) + "\n"
        let _f: bool = write_text(FLOOR_FILE, floor_text)
        outln("")
        outln("wrote " + REPORT + " and floor " + os + " " + s_itoa(gate - margin) + " (" + s_itoa(gate) + " at parity or better)")
    }

    if do_check {
        let mut floor: string = ""
        let fl: ptr<ProcStrs> = gl_file_lines(FLOOR_FILE)
        let mut q: i32 = 0
        while q < sl_len(fl) {
            let w: ptr<ProcStrs> = s_words(sl_get(fl, q))
            if s_eq(sl_get(w, 0), os) {
                if not s_empty(floor) {
                    floor = floor + "\n"
                }
                floor = floor + sl_get(w, 1)
            }
            q = q + 1
        }
        outln("")
        if not s_empty(only) {
            outln("corpus parity: --only runs part of the corpus; the floor is not checked")
        } elif s_empty(floor) {
            outln("corpus parity: no floor recorded for " + os + "; " + s_itoa(gate) + " at parity or better (not gated)")
        } elif gate < s_atoi(floor, 0) {
            errln("corpus parity regressed: " + s_itoa(gate) + " < floor " + floor + " on " + os)
            errs(not_at_parity(joined))
            return finish(1)
        } else {
            outln("corpus parity OK: " + s_itoa(gate) + " >= floor " + floor + " on " + os)
            if gate > s_atoi(floor, 0) {
                outln("(run ./flow tool compiler/scripts/corpus_parity.flow --update to raise the floor)")
            }
        }
    }
    return finish(0)
}
