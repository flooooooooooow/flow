# @module flowc.recognition_ssa_gate
# @means  Gate real FIR optimization candidates through RSSA certificates.
#
# Candidate profitability and semantic legality are deliberately separate.
# fir_opts decides whether a transformation is worth considering; this module
# requires the transformation's discrete refinement and recognition witnesses
# to preserve the active contract before it may be applied.

import .fir_opts { FlowcOptCandidate }
import .recognition_ssa {
    FLOWC_RSSA_OK,
    FlowcRecognitionContract,
    FlowcAttractorSignature,
    FlowcRefinementCertificate,
    flowc_rssa_check,
    flowc_rssa_preserved
}
import .recognition_ssa_budget {
    FlowcRecognitionBudget,
    flowc_rssa_budget_consume,
    flowc_rssa_budget_preserved
}

export const FLOWC_RSSA_GATE_REJECTED: i32 = 8

export struct FlowcRssaGateResult {
    candidate: FlowcOptCandidate,
    certificate: FlowcRefinementCertificate,
    allowed: i32
}

# Validate one concrete FIR optimization candidate. The caller supplies the
# ordinary refinement judgement and before/after observations produced by the
# transformation adapter. Profitability never bypasses semantic preservation.
export function flowc_rssa_gate_candidate(
    candidate: FlowcOptCandidate,
    discrete_refines: i32,
    contracts: ptr<FlowcRecognitionContract>,
    contract_count: i32,
    before: ptr<FlowcAttractorSignature>,
    after: ptr<FlowcAttractorSignature>,
    out: ptr<FlowcRssaGateResult>
) -> i32 {
    out[0].candidate = candidate
    out[0].allowed = 0
    let code: i32 = flowc_rssa_check(
        discrete_refines,
        contracts,
        contract_count,
        before,
        after,
        &out[0].certificate
    )
    if code != FLOWC_RSSA_OK {
        return code
    }
    if flowc_rssa_preserved(out[0].certificate) == 0 {
        return FLOWC_RSSA_GATE_REJECTED
    }
    out[0].allowed = 1
    return FLOWC_RSSA_OK
}

# Commit an already validated candidate certificate to the pipeline budget.
# This is intentionally separate from checking so a rejected candidate cannot
# consume approximation budget.
export function flowc_rssa_gate_commit(
    budget: ptr<FlowcRecognitionBudget>,
    result: FlowcRssaGateResult
) -> i32 {
    if result.allowed == 0 {
        return FLOWC_RSSA_GATE_REJECTED
    }
    let code: i32 = flowc_rssa_budget_consume(budget, result.certificate)
    if code != FLOWC_RSSA_OK {
        return code
    }
    if flowc_rssa_budget_preserved(budget[0]) == 0 {
        return FLOWC_RSSA_GATE_REJECTED
    }
    return FLOWC_RSSA_OK
}
