# @module flowc.recognition_ssa_budget
# @means  Conservative composition of RSSA approximation budgets across passes.
#
# Per-pass recognition distances accumulate by the triangle inequality. A
# pipeline is legal only when every protected domain remains within the
# original contract epsilon. This prevents individually legal passes from
# silently overspending a pipeline-level approximation budget.

import .recognition_ssa {
    FLOWC_RSSA_OK, FLOWC_RSSA_MAX_CONTRACTS,
    FlowcRecognitionContract, FlowcRefinementCertificate,
    flowc_rssa_contract_check
}

export const FLOWC_RSSA_BUDGET_DOMAIN_MISMATCH: i32 = 5
export const FLOWC_RSSA_BUDGET_MISSING_WITNESS: i32 = 6
export const FLOWC_RSSA_BUDGET_OVERFLOW: i32 = 7

export struct FlowcRecognitionBudget {
    domains: array<i32, 5>,
    epsilon: array<f64, 5>,
    spent: array<f64, 5>,
    count: i32,
    discrete_refinement: i32
}

export function flowc_rssa_budget_new(
    contracts: ptr<FlowcRecognitionContract>,
    contract_count: i32,
    out: ptr<FlowcRecognitionBudget>
) -> i32 {
    if contract_count > FLOWC_RSSA_MAX_CONTRACTS {
        return FLOWC_RSSA_BUDGET_OVERFLOW
    }
    out[0].count = contract_count
    out[0].discrete_refinement = 1
    let mut i: i32 = 0
    while i < contract_count {
        let code: i32 = flowc_rssa_contract_check(contracts[i])
        if code != FLOWC_RSSA_OK {
            return code
        }
        out[0].domains[i] = contracts[i].domain
        out[0].epsilon[i] = contracts[i].epsilon
        out[0].spent[i] = 0.0
        i = i + 1
    }
    return FLOWC_RSSA_OK
}

function flowc_rssa_budget_find(budget: FlowcRecognitionBudget, domain: i32) -> i32 {
    let mut i: i32 = 0
    while i < budget.count {
        if budget.domains[i] == domain {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

# Consume one optimization pass certificate. Every protected domain must have
# exactly one corresponding witness. Distances are conservatively accumulated.
export function flowc_rssa_budget_consume(
    budget: ptr<FlowcRecognitionBudget>,
    cert: FlowcRefinementCertificate
) -> i32 {
    if cert.discrete_refinement == 0 {
        budget[0].discrete_refinement = 0
    }
    if cert.witness_count != budget[0].count {
        return FLOWC_RSSA_BUDGET_MISSING_WITNESS
    }
    let mut seen: i32 = 0
    let mut i: i32 = 0
    while i < cert.witness_count {
        let slot: i32 = flowc_rssa_budget_find(budget[0], cert.witnesses[i].domain)
        if slot < 0 {
            return FLOWC_RSSA_BUDGET_DOMAIN_MISMATCH
        }
        let bit: i32 = 1 << slot
        if (seen & bit) != 0 {
            return FLOWC_RSSA_BUDGET_DOMAIN_MISMATCH
        }
        seen = seen | bit
        budget[0].spent[slot] = budget[0].spent[slot] + cert.witnesses[i].distance
        i = i + 1
    }
    return FLOWC_RSSA_OK
}

export function flowc_rssa_budget_preserved(budget: FlowcRecognitionBudget) -> i32 {
    if budget.discrete_refinement == 0 {
        return 0
    }
    let mut i: i32 = 0
    while i < budget.count {
        if budget.spent[i] > budget.epsilon[i] {
            return 0
        }
        i = i + 1
    }
    return 1
}

export function flowc_rssa_budget_violations(budget: FlowcRecognitionBudget) -> i32 {
    let mut mask: i32 = 0
    let mut i: i32 = 0
    while i < budget.count {
        if budget.spent[i] > budget.epsilon[i] {
            mask = mask | budget.domains[i]
        }
        i = i + 1
    }
    return mask
}
