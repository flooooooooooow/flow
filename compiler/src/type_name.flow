# @module flowc.type_name
# @means  Canonical Stage-A AST_TYPE -> production overload type-name spelling.

import .ast { AstArena, AST_NONE, AST_TYPE }

function type_name_span_is(src: ptr<u8>, start: i32, end: i32, lit: string) -> i32 {
    let p: ptr<u8> = lit
    let mut n: i32 = 0
    while p[n] != 0 {
        n = n + 1
    }
    if end - start != n {
        return 0
    }
    let mut i: i32 = 0
    while i < n {
        if src[start + i] != p[i] {
            return 0
        }
        i = i + 1
    }
    return 1
}

function type_name_append_byte(out: ptr<u8>, cap: i32, off: i32, value: i32) -> i32 {
    if off < 0 or off + 1 >= cap {
        return 0 - 1
    }
    out[off] = value
    out[off + 1] = 0
    return off + 1
}

function type_name_append_lit(out: ptr<u8>, cap: i32, off: i32, lit: string) -> i32 {
    let p: ptr<u8> = lit
    let mut n: i32 = 0
    while p[n] != 0 {
        n = n + 1
    }
    if off < 0 or off + n >= cap {
        return 0 - 1
    }
    let mut i: i32 = 0
    while i < n {
        out[off + i] = p[i]
        i = i + 1
    }
    out[off + n] = 0
    return off + n
}

function type_name_copy_span_at(
    src: ptr<u8>,
    start: i32,
    end: i32,
    out: ptr<u8>,
    cap: i32,
    off: i32
) -> i32 {
    if src == null or out == null {
        return 0 - 1
    }
    if start < 0 or end <= start {
        return 0 - 1
    }
    let n: i32 = end - start
    if off < 0 or off + n >= cap {
        return 0 - 1
    }
    let mut i: i32 = 0
    while i < n {
        out[off + i] = src[start + i]
        i = i + 1
    }
    out[off + n] = 0
    return off + n
}

function type_name_append_i32(out: ptr<u8>, cap: i32, off: i32, value: i32) -> i32 {
    if value < 0 {
        return 0 - 1
    }
    if value == 0 {
        return type_name_append_byte(out, cap, off, 48)
    }
    let digits: array<u8, 16>
    let mut n: i32 = 0
    let mut v: i32 = value
    while v > 0 {
        let q: i32 = v / 10
        let digit: i32 = v - q * 10
        digits[n] = 48 + digit
        n = n + 1
        v = q
    }
    if off < 0 or off + n >= cap {
        return 0 - 1
    }
    let mut i: i32 = 0
    while i < n {
        out[off + i] = digits[n - 1 - i]
        i = i + 1
    }
    out[off + n] = 0
    return off + n
}

export function flowc_type_name_into(
    arena: AstArena,
    src: ptr<u8>,
    ty: i32,
    out: ptr<u8>,
    cap: i32
) -> i32 {
    if ty == AST_NONE or ty < 0 or ty >= arena.len {
        return 0 - 1
    }
    if arena.nodes[ty].kind != AST_TYPE {
        return 0 - 1
    }
    if arena.nodes[ty].a != AST_NONE {
        return 0 - 1
    }
    if arena.nodes[ty].ival < 0 {
        return 0 - 1
    }
    return type_name_copy_span_at(
        src,
        arena.nodes[ty].name_start,
        arena.nodes[ty].name_end,
        out,
        cap,
        0
    )
}
