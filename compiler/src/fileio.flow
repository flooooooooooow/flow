# @module flowc.fileio
# @means  Read/write files from disk (CLI emit, fixture self-tests).
#
# libc FILE* APIs are declared here for typing; c_generator skips emitting
# conflicting prototypes (stdio.h already provides them).

extern {
    function fopen(path: string, mode: string) -> ptr<void>
    function fclose(fp: ptr<void>) -> i32
    function fread(buf: ptr<u8>, size: i32, n: i32, fp: ptr<void>) -> i32
    function fwrite(buf: ptr<u8>, size: i32, n: i32, fp: ptr<void>) -> i32
    function fseek(fp: ptr<void>, offset: i64, whence: i32) -> i32
    function ftell(fp: ptr<void>) -> i64
}

const FLOWC_IO_SEEK_SET: i32 = 0
const FLOWC_IO_SEEK_END: i32 = 2

export function flowc_io_fopen(path: string, mode: string) -> ptr<void> {
    return fopen(path, mode)
}

export function flowc_io_fclose(fp: ptr<void>) -> i32 {
    return fclose(fp)
}

export function flowc_io_fread(buf: ptr<u8>, size: i32, n: i32, fp: ptr<void>) -> i32 {
    return fread(buf, size, n, fp)
}

export function flowc_io_fwrite(buf: ptr<u8>, size: i32, n: i32, fp: ptr<void>) -> i32 {
    return fwrite(buf, size, n, fp)
}

export function flowc_io_fseek(fp: ptr<void>, offset: i64, whence: i32) -> i32 {
    return fseek(fp, offset, whence)
}

export function flowc_io_ftell(fp: ptr<void>) -> i64 {
    return ftell(fp)
}

# Read up to `cap` bytes into `buf`. Returns bytes read, or -1 on error.
# Does not NUL-terminate; caller may write buf[n] = 0 if n < cap.
export function flowc_read_file(path: string, buf: ptr<u8>, cap: i32) -> i32 {
    let fp: ptr<void> = flowc_io_fopen(path, "rb")
    if fp == null {
        return -1
    }
    if cap <= 0 {
        let _c0: i32 = flowc_io_fclose(fp)
        return 0
    }
    let n: i32 = flowc_io_fread(buf, 1, cap, fp)
    let _c: i32 = flowc_io_fclose(fp)
    if n < 0 {
        return -1
    }
    return n
}

# Write `n` bytes from `buf` to `path`. Returns 0 on success, -1 on failure.
export function flowc_write_file(path: string, buf: ptr<u8>, n: i32) -> i32 {
    let fp: ptr<void> = flowc_io_fopen(path, "wb")
    if fp == null {
        return -1
    }
    if n <= 0 {
        let _c0: i32 = flowc_io_fclose(fp)
        return 0
    }
    let wrote: i32 = flowc_io_fwrite(buf, 1, n, fp)
    let _c: i32 = flowc_io_fclose(fp)
    if wrote != n {
        return -1
    }
    return 0
}
