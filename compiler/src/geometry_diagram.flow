# @module flowc.geometry_diagram
# @means  Geometric figures for proof documents: the diagram model, the
#         built-in Euclidean templates, and the SVG and TikZ renderers.
#         Port of src/flow/geometry_diagram.py. Scripted figures (.geom)
#         are built by compiler/src/geometry_script.flow.

extern {
    function strcmp(a: string, b: string) -> i32
    function strlen(s: string) -> i64
    function malloc(size: i64) -> ptr<void>
    function memcpy(dst: ptr<void>, src: ptr<void>, n: i64) -> ptr<void>
    function sqrt(x: f64) -> f64
    function hypot(x: f64, y: f64) -> f64
    function atan2(y: f64, x: f64) -> f64
    function cos(x: f64) -> f64
    function sin(x: f64) -> f64
    function fmod(x: f64, y: f64) -> f64
    function snprintf(buf: ptr<u8>, n: i64, fmt: string, ...) -> i32
}

# ── String helpers ───────────────────────────────────────────────

function str_append(a: string, b: string) -> string {
    let la: i32 = strlen(a) as i32
    let lb: i32 = strlen(b) as i32
    let total: i32 = la + lb
    let buf: ptr<u8> = malloc((total + 1) as i64) as ptr<u8>
    if la > 0 {
        memcpy(buf, a, la as i64)
    }
    if lb > 0 {
        memcpy(buf + la, b, lb as i64)
    }
    buf[total] = 0
    return buf as string
}

# ── SVG escape ───────────────────────────────────────────────────

# Escape XML special characters for SVG output.
# & -> &amp;, < -> &lt;, > -> &gt;
export function flowc_svg_escape(text: string) -> string {
    let n: i32 = strlen(text) as i32
    let p: ptr<u8> = text
    let mut result: string = ""
    let mut i: i32 = 0
    while i < n {
        let c: i32 = p[i]
        if c == 38 {
            result = str_append(result, "&amp;")
        } else {
            if c == 60 {
                result = str_append(result, "&lt;")
            } else {
                if c == 62 {
                    result = str_append(result, "&gt;")
                } else {
                    let buf: array<u8, 2> = [0, 0]
                    buf[0] = c
                    result = str_append(result, buf as string)
                }
            }
        }
        i = i + 1
    }
    return result
}

# ── Vector math ──────────────────────────────────────────────────

# Normalize a 2D vector to unit length.
# Returns (vx/m, vy/m) where m = hypot(vx, vy), or (vx, vy) if m is 0.
export function flowc_vec2_unit_x(vx: f64, vy: f64) -> f64 {
    let m: f64 = sqrt(vx * vx + vy * vy)
    if m == 0.0 {
        return vx
    }
    return vx / m
}

export function flowc_vec2_unit_y(vx: f64, vy: f64) -> f64 {
    let m: f64 = sqrt(vx * vx + vy * vy)
    if m == 0.0 {
        return vy
    }
    return vy / m
}

# Vector length (hypot).
export function flowc_vec2_length(vx: f64, vy: f64) -> f64 {
    return sqrt(vx * vx + vy * vy)
}

# Dot product of two 2D vectors.
export function flowc_vec2_dot(ax: f64, ay: f64, bx: f64, by: f64) -> f64 {
    return ax * bx + ay * by
}

# Distance between two points.
export function flowc_point_distance(ax: f64, ay: f64, bx: f64, by: f64) -> f64 {
    let dx: f64 = bx - ax
    let dy: f64 = by - ay
    return sqrt(dx * dx + dy * dy)
}

# Linear interpolation between two values.
export function flowc_lerp(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t
}

# ═════════════════════════════════════════════════════════════════
# Diagram model (GeometryDiagram) and renderers
# ═════════════════════════════════════════════════════════════════

export struct FlowcGeomCurve {
    xs: ptr<f64>,
    ys: ptr<f64>,
    n: i32,
    stroke: string,
    width: f64,
    dashed: i32,
    label: string
}

export struct FlowcGeomFill {
    xs: ptr<f64>,
    ys: ptr<f64>,
    n: i32,
    fill: string,
    opacity: f64
}

export struct FlowcGeomLabel {
    x: f64,
    y: f64,
    text: string,
    size: i32
}

# ok: 1 for a figure, 0 for none, -1 when a script failed.
export struct FlowcGeomDiagram {
    ok: i32,
    title: string,
    caption: string,
    width: i32,
    height: i32,
    pt_name: ptr<string>,
    pt_x: ptr<f64>,
    pt_y: ptr<f64>,
    npt: i32,
    seg_a: ptr<string>,
    seg_b: ptr<string>,
    nseg: i32,
    ang_v: ptr<string>,
    ang_a1: ptr<string>,
    ang_a2: ptr<string>,
    ang_label: ptr<string>,
    nang: i32,
    right: ptr<string>,
    nright: i32,
    par_a: ptr<string>,
    par_b: ptr<string>,
    npar: i32,
    circ_c: ptr<string>,
    circ_r: ptr<f64>,
    ncirc: i32,
    curves: ptr<FlowcGeomCurve>,
    ncurve: i32,
    fills: ptr<FlowcGeomFill>,
    nfill: i32,
    labels: ptr<FlowcGeomLabel>,
    nlabel: i32,
    has_axes: i32,
    ax_ox: f64,
    ax_oy: f64,
    ax_scale: f64,
    ax_xmin: f64,
    ax_xmax: f64,
    ax_ymin: f64,
    ax_ymax: f64
}

# An indexed string as a plain value, so `+` sees a string operand.
function geom_sidx(s: string) -> string {
    return s
}

const GEOM_CAP: i32 = 32
const GEOM_CURVE_CAP: i32 = 512

export function flowc_geom_new(title: string) -> FlowcGeomDiagram {
    let c: i64 = GEOM_CAP as i64
    return FlowcGeomDiagram {
        ok: 1,
        title: title,
        caption: "",
        width: 480,
        height: 360,
        pt_name: malloc(c * 8) as ptr<string>,
        pt_x: malloc(c * 8) as ptr<f64>,
        pt_y: malloc(c * 8) as ptr<f64>,
        npt: 0,
        seg_a: malloc(c * 8) as ptr<string>,
        seg_b: malloc(c * 8) as ptr<string>,
        nseg: 0,
        ang_v: malloc(c * 8) as ptr<string>,
        ang_a1: malloc(c * 8) as ptr<string>,
        ang_a2: malloc(c * 8) as ptr<string>,
        ang_label: malloc(c * 8) as ptr<string>,
        nang: 0,
        right: malloc(c * 8) as ptr<string>,
        nright: 0,
        par_a: malloc(c * 8) as ptr<string>,
        par_b: malloc(c * 8) as ptr<string>,
        npar: 0,
        circ_c: malloc(c * 8) as ptr<string>,
        circ_r: malloc(c * 8) as ptr<f64>,
        ncirc: 0,
        curves: malloc((GEOM_CURVE_CAP as i64) * 64) as ptr<FlowcGeomCurve>,
        ncurve: 0,
        fills: malloc((GEOM_CURVE_CAP as i64) * 48) as ptr<FlowcGeomFill>,
        nfill: 0,
        labels: malloc((GEOM_CURVE_CAP as i64) * 32) as ptr<FlowcGeomLabel>,
        nlabel: 0,
        has_axes: 0,
        ax_ox: 0.0,
        ax_oy: 0.0,
        ax_scale: 0.0,
        ax_xmin: 0.0,
        ax_xmax: 0.0,
        ax_ymin: 0.0,
        ax_ymax: 0.0
    }
}

export function flowc_geom_none() -> FlowcGeomDiagram {
    let mut g: FlowcGeomDiagram = flowc_geom_new("")
    g.ok = 0
    return g
}

function geom_pt(g: ptr<FlowcGeomDiagram>, name: string, x: f64, y: f64) -> void {
    let k: i32 = g[0].npt
    g[0].pt_name[k] = name
    g[0].pt_x[k] = x
    g[0].pt_y[k] = y
    g[0].npt = k + 1
}

function geom_seg(g: ptr<FlowcGeomDiagram>, a: string, b: string) -> void {
    let k: i32 = g[0].nseg
    g[0].seg_a[k] = a
    g[0].seg_b[k] = b
    g[0].nseg = k + 1
}

function geom_ang(g: ptr<FlowcGeomDiagram>, v: string, a1: string, a2: string, label: string) -> void {
    let k: i32 = g[0].nang
    g[0].ang_v[k] = v
    g[0].ang_a1[k] = a1
    g[0].ang_a2[k] = a2
    g[0].ang_label[k] = label
    g[0].nang = k + 1
}

function geom_right(g: ptr<FlowcGeomDiagram>, v: string) -> void {
    g[0].right[g[0].nright] = v
    g[0].nright = g[0].nright + 1
}

function geom_circle(g: ptr<FlowcGeomDiagram>, c: string, r: f64) -> void {
    g[0].circ_c[g[0].ncirc] = c
    g[0].circ_r[g[0].ncirc] = r
    g[0].ncirc = g[0].ncirc + 1
}

# Index of point `name`, or -1.
function geom_find(g: ptr<FlowcGeomDiagram>, name: string) -> i32 {
    let mut i: i32 = 0
    while i < g[0].npt {
        if strcmp(g[0].pt_name[i], name) == 0 { return i }
        i = i + 1
    }
    return 0 - 1
}

# _templates()[key]; ok = 0 when the key is unknown.
export function flowc_geom_template(key: string) -> FlowcGeomDiagram {
    if strcmp(key, "triangle-angle-sum") == 0 {
        let mut g: FlowcGeomDiagram = flowc_geom_new("Triangle interior angles")
        geom_pt(&g, "A", 70.0, 290.0)
        geom_pt(&g, "B", 410.0, 290.0)
        geom_pt(&g, "C", 230.0, 70.0)
        geom_seg(&g, "A", "B")
        geom_seg(&g, "B", "C")
        geom_seg(&g, "C", "A")
        geom_ang(&g, "A", "C", "B", "α")
        geom_ang(&g, "B", "A", "C", "β")
        geom_ang(&g, "C", "B", "A", "γ")
        g.caption = "Triangle ABC: the three interior angles α, β, and γ sum to two right angles."
        return g
    }
    if strcmp(key, "isosceles-base-angles") == 0 {
        let mut g: FlowcGeomDiagram = flowc_geom_new("Isosceles triangle")
        geom_pt(&g, "A", 240.0, 60.0)
        geom_pt(&g, "B", 80.0, 300.0)
        geom_pt(&g, "C", 400.0, 300.0)
        geom_seg(&g, "A", "B")
        geom_seg(&g, "A", "C")
        geom_seg(&g, "B", "C")
        geom_ang(&g, "B", "A", "C", "θ")
        geom_ang(&g, "C", "A", "B", "θ")
        geom_ang(&g, "A", "B", "C", "φ")
        geom_ang(&g, "A", "C", "B", "ψ")
        g.caption = "Isosceles triangle with AB = AC: the base angles at B and C are equal."
        return g
    }
    if strcmp(key, "vertical-angles") == 0 {
        let mut g: FlowcGeomDiagram = flowc_geom_new("Vertical angles")
        geom_pt(&g, "O", 240.0, 180.0)
        geom_pt(&g, "A", 60.0, 80.0)
        geom_pt(&g, "B", 420.0, 280.0)
        geom_pt(&g, "C", 420.0, 80.0)
        geom_pt(&g, "D", 60.0, 280.0)
        geom_seg(&g, "A", "B")
        geom_seg(&g, "C", "D")
        geom_ang(&g, "O", "A", "C", "α")
        geom_ang(&g, "O", "C", "B", "β")
        geom_ang(&g, "O", "B", "D", "α′")
        geom_ang(&g, "O", "D", "A", "β′")
        g.caption = "Intersecting lines: vertical angles α and α′ are equal, as are β and β′."
        return g
    }
    if strcmp(key, "right-triangle-pythagoras") == 0 {
        let mut g: FlowcGeomDiagram = flowc_geom_new("Right triangle")
        geom_pt(&g, "A", 80.0, 300.0)
        geom_pt(&g, "B", 380.0, 300.0)
        geom_pt(&g, "C", 80.0, 80.0)
        geom_seg(&g, "A", "B")
        geom_seg(&g, "B", "C")
        geom_seg(&g, "C", "A")
        geom_right(&g, "A")
        geom_ang(&g, "B", "A", "C", "a")
        geom_ang(&g, "C", "B", "A", "b")
        g.caption = "Right triangle with legs a, b and hypotenuse c: c² = a² + b²."
        return g
    }
    if strcmp(key, "parallel-lines-alternate") == 0 {
        let mut g: FlowcGeomDiagram = flowc_geom_new("Parallel lines and a transversal")
        geom_pt(&g, "P", 60.0, 120.0)
        geom_pt(&g, "Q", 420.0, 120.0)
        geom_pt(&g, "R", 40.0, 260.0)
        geom_pt(&g, "S", 440.0, 260.0)
        geom_pt(&g, "T", 120.0, 40.0)
        geom_pt(&g, "U", 360.0, 320.0)
        geom_pt(&g, "X", 200.0, 120.0)
        geom_pt(&g, "Y", 260.0, 260.0)
        geom_seg(&g, "P", "Q")
        geom_seg(&g, "R", "S")
        geom_seg(&g, "T", "U")
        g.par_a[0] = "PQ"
        g.par_b[0] = "RS"
        g.npar = 1
        geom_ang(&g, "X", "T", "P", "α")
        geom_ang(&g, "Y", "R", "T", "α")
        geom_ang(&g, "X", "Q", "U", "β")
        geom_ang(&g, "Y", "S", "U", "β")
        g.caption = "Parallel lines cut by a transversal: alternate interior angles are equal."
        return g
    }
    if strcmp(key, "triangle-congruence-sas") == 0 {
        let mut g: FlowcGeomDiagram = flowc_geom_new("Side-angle-side congruence")
        geom_pt(&g, "A", 90.0, 280.0)
        geom_pt(&g, "B", 220.0, 280.0)
        geom_pt(&g, "C", 160.0, 100.0)
        geom_pt(&g, "D", 290.0, 280.0)
        geom_pt(&g, "E", 390.0, 280.0)
        geom_pt(&g, "F", 330.0, 100.0)
        geom_seg(&g, "A", "B")
        geom_seg(&g, "B", "C")
        geom_seg(&g, "C", "A")
        geom_seg(&g, "D", "E")
        geom_seg(&g, "E", "F")
        geom_seg(&g, "F", "D")
        geom_ang(&g, "A", "B", "C", "θ")
        geom_ang(&g, "D", "E", "F", "θ")
        g.caption = "Two triangles with two sides and the included angle equal: the triangles are congruent."
        return g
    }
    if strcmp(key, "thales-right-angle") == 0 {
        let mut g: FlowcGeomDiagram = flowc_geom_new("Thales' theorem")
        geom_pt(&g, "O", 240.0, 200.0)
        geom_pt(&g, "A", 100.0, 200.0)
        geom_pt(&g, "B", 380.0, 200.0)
        geom_pt(&g, "C", 240.0, 70.0)
        geom_circle(&g, "O", 130.0)
        geom_seg(&g, "A", "B")
        geom_seg(&g, "A", "C")
        geom_seg(&g, "B", "C")
        geom_right(&g, "C")
        geom_ang(&g, "C", "A", "B", "θ")
        g.caption = "Angle in a semicircle: when AB is a diameter, the inscribed angle at C is a right angle."
        return g
    }
    if strcmp(key, "circle-radii-equal") == 0 {
        let mut g: FlowcGeomDiagram = flowc_geom_new("Radii of a circle")
        geom_pt(&g, "O", 240.0, 180.0)
        geom_pt(&g, "A", 100.0, 220.0)
        geom_pt(&g, "B", 380.0, 140.0)
        geom_circle(&g, "O", 130.0)
        geom_seg(&g, "O", "A")
        geom_seg(&g, "O", "B")
        g.caption = "Circle with centre O: radii OA and OB are equal."
        return g
    }
    if strcmp(key, "inscribed-angle-half-central") == 0 {
        let mut g: FlowcGeomDiagram = flowc_geom_new("Inscribed and central angles")
        geom_pt(&g, "O", 240.0, 190.0)
        geom_pt(&g, "A", 110.0, 250.0)
        geom_pt(&g, "B", 370.0, 250.0)
        geom_pt(&g, "P", 240.0, 55.0)
        geom_circle(&g, "O", 135.0)
        geom_seg(&g, "O", "A")
        geom_seg(&g, "O", "B")
        geom_seg(&g, "P", "A")
        geom_seg(&g, "P", "B")
        geom_ang(&g, "O", "A", "B", "2θ")
        geom_ang(&g, "P", "A", "B", "θ")
        g.caption = "Inscribed angle θ at P equals half the central angle 2θ subtending arc AB."
        return g
    }
    return flowc_geom_none()
}

# ASCII lower-case copy.
function geom_lower(s: string) -> string {
    let n: i32 = strlen(s) as i32
    let p: ptr<u8> = s
    let buf: ptr<u8> = malloc((n + 1) as i64) as ptr<u8>
    let mut i: i32 = 0
    while i < n {
        let c: u8 = p[i]
        if c >= 65 and c <= 90 {
            buf[i] = c + 32
        } else {
            buf[i] = c
        }
        i = i + 1
    }
    buf[n] = 0
    return buf as string
}

function geom_contains(s: string, needle: string) -> i32 {
    let n: i32 = strlen(s) as i32
    let m: i32 = strlen(needle) as i32
    let p: ptr<u8> = s
    let q: ptr<u8> = needle
    let mut i: i32 = 0
    while i + m <= n {
        let mut j: i32 = 0
        while j < m and p[i + j] == q[j] { j = j + 1 }
        if j == m { return 1 }
        i = i + 1
    }
    return 0
}

# _infer_diagram_id, "" for None.
export function flowc_geom_infer_id(claim_path: string) -> string {
    let law: string = geom_lower(claim_path)
    if geom_contains(law, "interior angles") == 1 or geom_contains(law, "angle-sum") == 1 or geom_contains(law, "two right") == 1 {
        return "triangle-angle-sum"
    }
    if geom_contains(law, "isosceles") == 1 or geom_contains(law, "base angles") == 1 {
        return "isosceles-base-angles"
    }
    if geom_contains(law, "vertical") == 1 { return "vertical-angles" }
    if geom_contains(law, "pythagoras") == 1 or geom_contains(law, "hypotenuse") == 1 {
        return "right-triangle-pythagoras"
    }
    if geom_contains(law, "alternate") == 1 { return "parallel-lines-alternate" }
    if geom_contains(law, "side-angle-side") == 1 or geom_contains(law, "congruence") == 1 {
        return "triangle-congruence-sas"
    }
    if geom_contains(law, "thales") == 1 or geom_contains(law, "semicircle") == 1 {
        return "thales-right-angle"
    }
    if geom_contains(law, "inscribed") == 1 { return "inscribed-angle-half-central" }
    return ""
}

# ── Number formatting ────────────────────────────────────────────

function geom_fmt(fmt: string, v: f64) -> string {
    let buf: ptr<u8> = malloc(64) as ptr<u8>
    let _n: i32 = snprintf(buf, 64, fmt, v)
    return buf as string
}

function f1(v: f64) -> string {
    return geom_fmt("%.1f", v)
}

function geom_itoa(v: i32) -> string {
    let buf: ptr<u8> = malloc(32) as ptr<u8>
    let _n: i32 = snprintf(buf, 32, "%d", v)
    return buf as string
}

# Python's float % (the result takes the sign of the divisor).
function geom_pymod(x: f64, m: f64) -> f64 {
    let mut r: f64 = fmod(x, m)
    if r != 0.0 {
        if (m < 0.0) != (r < 0.0) {
            r = r + m
        }
    } else {
        r = 0.0
    }
    return r
}

function geom_unit_x(vx: f64, vy: f64) -> f64 {
    let mut m: f64 = hypot(vx, vy)
    if m == 0.0 { m = 1.0 }
    return vx / m
}

function geom_unit_y(vx: f64, vy: f64) -> f64 {
    let mut m: f64 = hypot(vx, vy)
    if m == 0.0 { m = 1.0 }
    return vy / m
}

# _angle_arc_path (radius 28)
function geom_arc_path(vx: f64, vy: f64, a1x: f64, a1y: f64, a2x: f64, a2y: f64) -> string {
    let radius: f64 = 28.0
    let pi: f64 = 3.141592653589793
    let mut a1: f64 = atan2(a1y - vy, a1x - vx)
    let mut a2: f64 = atan2(a2y - vy, a2x - vx)
    let mut da: f64 = geom_pymod(a2 - a1, 2.0 * pi)
    if da > pi {
        let tmp: f64 = a1
        a1 = a2
        a2 = tmp
        da = geom_pymod(a2 - a1, 2.0 * pi)
    }
    let sx: f64 = vx + radius * cos(a1)
    let sy: f64 = vy + radius * sin(a1)
    let ex: f64 = vx + radius * cos(a2)
    let ey: f64 = vy + radius * sin(a2)
    let mut large: string = "0"
    if da > pi { large = "1" }
    return "M " + f1(sx) + " " + f1(sy) + " A " + f1(radius) + " " + f1(radius) + " 0 " + large + " 1 " + f1(ex) + " " + f1(ey)
}

function geom_polyline(xs: ptr<f64>, ys: ptr<f64>, n: i32) -> string {
    let mut s: string = ""
    let mut i: i32 = 0
    while i < n {
        if i > 0 { s = s + " " }
        s = s + f1(xs[i]) + "," + f1(ys[i])
        i = i + 1
    }
    return s
}

# Arms of a right-angle vertex: segment ends from it, then segment starts
# into it.
function geom_arms(g: ptr<FlowcGeomDiagram>, vertex: string, out: ptr<string>) -> i32 {
    let mut n: i32 = 0
    let mut i: i32 = 0
    while i < g[0].nseg {
        if strcmp(g[0].seg_a[i], vertex) == 0 {
            out[n] = g[0].seg_b[i]
            n = n + 1
        }
        i = i + 1
    }
    i = 0
    while i < g[0].nseg {
        if strcmp(g[0].seg_b[i], vertex) == 0 {
            out[n] = g[0].seg_a[i]
            n = n + 1
        }
        i = i + 1
    }
    return n
}

function geom_char(s: string, i: i32) -> string {
    let buf: ptr<u8> = malloc(2) as ptr<u8>
    let p: ptr<u8> = s
    buf[0] = p[i]
    buf[1] = 0
    return buf as string
}

# render_svg
export function flowc_geom_render_svg(g: ptr<FlowcGeomDiagram>) -> string {
    let w: string = geom_itoa(g[0].width)
    let h: string = geom_itoa(g[0].height)
    let mut out: string = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
    out = out + "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 " + w + " " + h + "\" width=\"" + w + "\" height=\"" + h + "\">\n"
    out = out + "<style>text{font-family:Georgia,serif;font-size:15px;fill:#1a1a1a}</style>\n"
    out = out + "<rect width=\"100%\" height=\"100%\" fill=\"#faf9f6\"/>"
    if g[0].has_axes == 1 {
        let x0: f64 = g[0].ax_ox + g[0].ax_xmin * g[0].ax_scale
        let x1: f64 = g[0].ax_ox + g[0].ax_xmax * g[0].ax_scale
        let y0: f64 = g[0].ax_oy - g[0].ax_ymin * g[0].ax_scale
        let y1: f64 = g[0].ax_oy - g[0].ax_ymax * g[0].ax_scale
        let ox: f64 = g[0].ax_ox
        let oy: f64 = g[0].ax_oy
        out = out + "\n<line x1=\"" + f1(x0) + "\" y1=\"" + f1(oy) + "\" x2=\"" + f1(x1) + "\" y2=\"" + f1(oy) + "\" stroke=\"#bdc3c7\" stroke-width=\"1.2\"/>"
        out = out + "\n<line x1=\"" + f1(ox) + "\" y1=\"" + f1(y0) + "\" x2=\"" + f1(ox) + "\" y2=\"" + f1(y1) + "\" stroke=\"#bdc3c7\" stroke-width=\"1.2\"/>"
        out = out + "\n<text x=\"" + f1(x1 - 8.0) + "\" y=\"" + f1(oy + 16.0) + "\" font-size=\"12\" fill=\"#7f8c8d\">x</text>"
        out = out + "\n<text x=\"" + f1(ox + 6.0) + "\" y=\"" + f1(y1 + 4.0) + "\" font-size=\"12\" fill=\"#7f8c8d\">y</text>"
    }
    let mut i: i32 = 0
    while i < g[0].nfill {
        let f: FlowcGeomFill = g[0].fills[i]
        out = out + "\n<polygon points=\"" + geom_polyline(f.xs, f.ys, f.n) + "\" fill=\"" + f.fill + "\" fill-opacity=\"" + geom_fmt("%.2f", f.opacity) + "\" stroke=\"none\"/>"
        i = i + 1
    }
    i = 0
    while i < g[0].ncurve {
        let c: FlowcGeomCurve = g[0].curves[i]
        let mut dash: string = ""
        if c.dashed == 1 { dash = " stroke-dasharray=\"7 5\"" }
        out = out + "\n<polyline points=\"" + geom_polyline(c.xs, c.ys, c.n) + "\" fill=\"none\" stroke=\"" + c.stroke + "\" stroke-width=\"" + f1(c.width) + "\" stroke-linecap=\"round\"" + dash + "/>"
        if strlen(c.label) > 0 and c.n > 0 {
            let k: i32 = c.n / 3
            out = out + "\n<text x=\"" + f1(c.xs[k]) + "\" y=\"" + f1(c.ys[k] - 8.0) + "\" font-size=\"12\" fill=\"" + c.stroke + "\">" + flowc_svg_escape(c.label) + "</text>"
        }
        i = i + 1
    }
    i = 0
    while i < g[0].ncirc {
        let ci: i32 = geom_find(g, g[0].circ_c[i])
        out = out + "\n<circle cx=\"" + f1(g[0].pt_x[ci]) + "\" cy=\"" + f1(g[0].pt_y[ci]) + "\" r=\"" + f1(g[0].circ_r[i]) + "\" fill=\"none\" stroke=\"#95a5a6\" stroke-width=\"1.8\"/>"
        i = i + 1
    }
    i = 0
    while i < g[0].nseg {
        let a: i32 = geom_find(g, g[0].seg_a[i])
        let b: i32 = geom_find(g, g[0].seg_b[i])
        out = out + "\n<line x1=\"" + f1(g[0].pt_x[a]) + "\" y1=\"" + f1(g[0].pt_y[a]) + "\" x2=\"" + f1(g[0].pt_x[b]) + "\" y2=\"" + f1(g[0].pt_y[b]) + "\" stroke=\"#2c3e50\" stroke-width=\"2.2\" stroke-linecap=\"round\"/>"
        i = i + 1
    }
    i = 0
    while i < g[0].npar {
        let mut side: i32 = 0
        while side < 2 {
            let mut label: string = g[0].par_a[i]
            if side == 1 { label = g[0].par_b[i] }
            if strlen(label) >= 2 {
                let p1: i32 = geom_find(g, geom_char(label, 0))
                let p2: i32 = geom_find(g, geom_char(label, 1))
                let mx: f64 = (g[0].pt_x[p1] + g[0].pt_x[p2]) / 2.0
                let my: f64 = (g[0].pt_y[p1] + g[0].pt_y[p2]) / 2.0
                let ux: f64 = geom_unit_x(g[0].pt_x[p2] - g[0].pt_x[p1], g[0].pt_y[p2] - g[0].pt_y[p1])
                let uy: f64 = geom_unit_y(g[0].pt_x[p2] - g[0].pt_x[p1], g[0].pt_y[p2] - g[0].pt_y[p1])
                let px: f64 = 0.0 - uy
                let py: f64 = ux
                let mut o: i32 = 0
                while o < 2 {
                    let mut offset: f64 = 0.0 - 12.0
                    if o == 1 { offset = 12.0 }
                    let cx: f64 = mx + ux * offset
                    let cy: f64 = my + uy * offset
                    out = out + "\n<line x1=\"" + f1(cx + px * 6.0) + "\" y1=\"" + f1(cy + py * 6.0) + "\" x2=\"" + f1(cx - px * 6.0) + "\" y2=\"" + f1(cy - py * 6.0) + "\" stroke=\"#7f8c8d\" stroke-width=\"1.4\"/>"
                    o = o + 1
                }
            }
            side = side + 1
        }
        i = i + 1
    }
    i = 0
    while i < g[0].nang {
        let v: i32 = geom_find(g, g[0].ang_v[i])
        let a1: i32 = geom_find(g, g[0].ang_a1[i])
        let a2: i32 = geom_find(g, g[0].ang_a2[i])
        let vx: f64 = g[0].pt_x[v]
        let vy: f64 = g[0].pt_y[v]
        let path: string = geom_arc_path(vx, vy, g[0].pt_x[a1], g[0].pt_y[a1], g[0].pt_x[a2], g[0].pt_y[a2])
        out = out + "\n<path d=\"" + path + "\" fill=\"none\" stroke=\"#c0392b\" stroke-width=\"1.6\"/>"
        # _label_offset (dist 42)
        let u1x: f64 = geom_unit_x(g[0].pt_x[a1] - vx, g[0].pt_y[a1] - vy)
        let u1y: f64 = geom_unit_y(g[0].pt_x[a1] - vx, g[0].pt_y[a1] - vy)
        let u2x: f64 = geom_unit_x(g[0].pt_x[a2] - vx, g[0].pt_y[a2] - vy)
        let u2y: f64 = geom_unit_y(g[0].pt_x[a2] - vx, g[0].pt_y[a2] - vy)
        let bx: f64 = u1x + u2x
        let by: f64 = u1y + u2y
        let lx: f64 = vx + geom_unit_x(bx, by) * 42.0
        let ly: f64 = vy + geom_unit_y(bx, by) * 42.0
        out = out + "\n<text x=\"" + f1(lx) + "\" y=\"" + f1(ly) + "\" text-anchor=\"middle\">" + geom_sidx(g[0].ang_label[i]) + "</text>"
        i = i + 1
    }
    let arms: ptr<string> = malloc(((g[0].nseg * 2 + 2) as i64) * 8) as ptr<string>
    i = 0
    while i < g[0].nright {
        let v: i32 = geom_find(g, g[0].right[i])
        let na: i32 = geom_arms(g, g[0].right[i], arms)
        if na >= 2 {
            let a1: i32 = geom_find(g, arms[0])
            let a2: i32 = geom_find(g, arms[1])
            let vx: f64 = g[0].pt_x[v]
            let vy: f64 = g[0].pt_y[v]
            let size: f64 = 14.0
            let u1x: f64 = geom_unit_x(g[0].pt_x[a1] - vx, g[0].pt_y[a1] - vy)
            let u1y: f64 = geom_unit_y(g[0].pt_x[a1] - vx, g[0].pt_y[a1] - vy)
            let u2x: f64 = geom_unit_x(g[0].pt_x[a2] - vx, g[0].pt_y[a2] - vy)
            let u2y: f64 = geom_unit_y(g[0].pt_x[a2] - vx, g[0].pt_y[a2] - vy)
            let p1x: f64 = vx + u1x * size
            let p1y: f64 = vy + u1y * size
            let p2x: f64 = vx + u2x * size
            let p2y: f64 = vy + u2y * size
            let p3x: f64 = p1x + u2x * size
            let p3y: f64 = p1y + u2y * size
            out = out + "\n<path d=\"M " + f1(p1x) + " " + f1(p1y) + " L " + f1(p3x) + " " + f1(p3y) + " L " + f1(p2x) + " " + f1(p2y) + "\" fill=\"none\" stroke=\"#2c3e50\" stroke-width=\"1.5\"/>"
        }
        i = i + 1
    }
    i = 0
    while i < g[0].nlabel {
        let lab: FlowcGeomLabel = g[0].labels[i]
        out = out + "\n<text x=\"" + f1(lab.x) + "\" y=\"" + f1(lab.y) + "\" text-anchor=\"middle\" font-size=\"" + geom_itoa(lab.size) + "\" fill=\"#2c3e50\">" + flowc_svg_escape(lab.text) + "</text>"
        i = i + 1
    }
    i = 0
    while i < g[0].npt {
        let x: f64 = g[0].pt_x[i]
        let y: f64 = g[0].pt_y[i]
        out = out + "\n<circle cx=\"" + f1(x) + "\" cy=\"" + f1(y) + "\" r=\"4.5\" fill=\"#2c3e50\"/>"
        let mut oy: f64 = 0.0 - 14.0
        if y < 120.0 { oy = 20.0 }
        out = out + "\n<text x=\"" + f1(x) + "\" y=\"" + f1(y + oy) + "\" text-anchor=\"middle\" font-weight=\"bold\">" + geom_sidx(g[0].pt_name[i]) + "</text>"
        i = i + 1
    }
    if strlen(g[0].caption) > 0 {
        out = out + "\n<text x=\"" + geom_fmt("%.0f", (g[0].width as f64) / 2.0) + "\" y=\"" + geom_itoa(g[0].height - 16) + "\" text-anchor=\"middle\" font-size=\"13\" fill=\"#555\">" + flowc_svg_escape(g[0].caption) + "</text>"
    }
    return out + "\n</svg>"
}

# geometry_diagram._latex_escape: backslash, &, %, _ (one pass; none of the
# replacements contains a later needle).
function geom_latex_escape(text: string) -> string {
    let n: i32 = strlen(text) as i32
    let p: ptr<u8> = text
    let buf: ptr<u8> = malloc((n * 16 + 1) as i64) as ptr<u8>
    let mut o: i32 = 0
    let mut i: i32 = 0
    while i < n {
        let c: i32 = p[i]
        let mut rep: string = ""
        if c == 92 { rep = "\\textbackslash{}" }
        if c == 38 { rep = "\\&" }
        if c == 37 { rep = "\\%" }
        if c == 95 { rep = "\\_" }
        let rl: i32 = strlen(rep) as i32
        if rl > 0 {
            let rp: ptr<u8> = rep
            let mut k: i32 = 0
            while k < rl {
                buf[o] = rp[k]
                o = o + 1
                k = k + 1
            }
        } else {
            buf[o] = p[i]
            o = o + 1
        }
        i = i + 1
    }
    buf[o] = 0
    return buf as string
}

function geom_angle_label_tex(label: string) -> string {
    if strcmp(label, "α") == 0 { return "$\\alpha$" }
    if strcmp(label, "β") == 0 { return "$\\beta$" }
    if strcmp(label, "γ") == 0 { return "$\\gamma$" }
    if strcmp(label, "θ") == 0 { return "$\\theta$" }
    if strcmp(label, "φ") == 0 { return "$\\varphi$" }
    if strcmp(label, "ψ") == 0 { return "$\\psi$" }
    if strcmp(label, "α′") == 0 { return "$\\alpha'$" }
    if strcmp(label, "β′") == 0 { return "$\\beta'$" }
    if strcmp(label, "2θ") == 0 { return "$2\\theta$" }
    if strcmp(label, "a") == 0 { return "$a$" }
    if strcmp(label, "b") == 0 { return "$b$" }
    return geom_latex_escape(label)
}

# _collect_hex_colors: fills first, then curve strokes; "geomc<i>" names.
function geom_color_index(names: ptr<string>, n: i32, color: string) -> i32 {
    let mut i: i32 = 0
    while i < n {
        if strcmp(names[i], color) == 0 { return i }
        i = i + 1
    }
    return 0 - 1
}

function geom_tikz_color(names: ptr<string>, n: i32, color: string) -> string {
    let p: ptr<u8> = color
    if p[0] == 35 {
        return "geomc" + geom_itoa(geom_color_index(names, n, color))
    }
    return color
}

function geom_coords(g: ptr<FlowcGeomDiagram>, xs: ptr<f64>, ys: ptr<f64>, n: i32) -> string {
    let mut s: string = ""
    let h: f64 = g[0].height as f64
    let mut i: i32 = 0
    while i < n {
        if i > 0 { s = s + " " }
        s = s + "(" + f1(xs[i]) + "," + f1(h - ys[i]) + ")"
        i = i + 1
    }
    return s
}

# render_tikz
export function flowc_geom_render_tikz(g: ptr<FlowcGeomDiagram>) -> string {
    let names: ptr<string> = malloc(((g[0].nfill + g[0].ncurve + 2) as i64) * 8) as ptr<string>
    let mut nc: i32 = 0
    let mut i: i32 = 0
    while i < g[0].nfill {
        let f: string = g[0].fills[i].fill
        let fp: ptr<u8> = f
        if fp[0] == 35 and geom_color_index(names, nc, f) < 0 {
            names[nc] = f
            nc = nc + 1
        }
        i = i + 1
    }
    i = 0
    while i < g[0].ncurve {
        let c: string = g[0].curves[i].stroke
        let cp: ptr<u8> = c
        if cp[0] == 35 and geom_color_index(names, nc, c) < 0 {
            names[nc] = c
            nc = nc + 1
        }
        i = i + 1
    }
    let h: f64 = g[0].height as f64
    let mut out: string = "\\begin{center}\n\\begin{tikzpicture}[scale=0.035, line cap=round, line join=round]"
    i = 0
    while i < nc {
        let hex: string = names[i]
        let hp: ptr<u8> = hex
        let rest: string = (hp + 1) as string
        out = out + "\n  \\definecolor{geomc" + geom_itoa(i) + "}{HTML}{" + rest + "}"
        i = i + 1
    }
    out = out + "\n  \\fill[fill=gray!4] (-10,-10) rectangle (" + geom_itoa(g[0].width + 20) + "," + geom_itoa(g[0].height + 10) + ");"
    if g[0].has_axes == 1 {
        let x0: f64 = g[0].ax_ox + g[0].ax_xmin * g[0].ax_scale
        let x1: f64 = g[0].ax_ox + g[0].ax_xmax * g[0].ax_scale
        let y0: f64 = h - (g[0].ax_oy - g[0].ax_ymin * g[0].ax_scale)
        let y1: f64 = h - (g[0].ax_oy - g[0].ax_ymax * g[0].ax_scale)
        let oy: f64 = h - g[0].ax_oy
        out = out + "\n  \\draw[gray!60] (" + f1(x0) + "," + f1(oy) + ") -- (" + f1(x1) + "," + f1(oy) + ");"
        out = out + "\n  \\draw[gray!60] (" + f1(g[0].ax_ox) + "," + f1(y0) + ") -- (" + f1(g[0].ax_ox) + "," + f1(y1) + ");"
    }
    i = 0
    while i < g[0].nfill {
        let f: FlowcGeomFill = g[0].fills[i]
        out = out + "\n  \\fill[fill=" + geom_tikz_color(names, nc, f.fill) + ", opacity=" + geom_fmt("%.2f", f.opacity) + "] " + geom_coords(g, f.xs, f.ys, f.n) + " -- cycle;"
        i = i + 1
    }
    i = 0
    while i < g[0].npt {
        out = out + "\n  \\coordinate (" + geom_sidx(g[0].pt_name[i]) + ") at (" + f1(g[0].pt_x[i]) + "," + f1(h - g[0].pt_y[i]) + ");"
        i = i + 1
    }
    i = 0
    while i < g[0].ncirc {
        out = out + "\n  \\draw[gray] (" + geom_sidx(g[0].circ_c[i]) + ") circle (" + f1(g[0].circ_r[i]) + ");"
        i = i + 1
    }
    i = 0
    while i < g[0].nseg {
        out = out + "\n  \\draw[thick] (" + geom_sidx(g[0].seg_a[i]) + ") -- (" + geom_sidx(g[0].seg_b[i]) + ");"
        i = i + 1
    }
    i = 0
    while i < g[0].npar {
        let mut side: i32 = 0
        while side < 2 {
            let mut label: string = g[0].par_a[i]
            if side == 1 { label = g[0].par_b[i] }
            if strlen(label) >= 2 {
                let p1: i32 = geom_find(g, geom_char(label, 0))
                let p2: i32 = geom_find(g, geom_char(label, 1))
                let mx: f64 = (g[0].pt_x[p1] + g[0].pt_x[p2]) / 2.0
                let my: f64 = h - (g[0].pt_y[p1] + g[0].pt_y[p2]) / 2.0
                let ux: f64 = geom_unit_x(g[0].pt_x[p2] - g[0].pt_x[p1], g[0].pt_y[p2] - g[0].pt_y[p1])
                let uy: f64 = geom_unit_y(g[0].pt_x[p2] - g[0].pt_x[p1], g[0].pt_y[p2] - g[0].pt_y[p1])
                let px: f64 = 0.0 - uy
                let py: f64 = ux
                let mut o: i32 = 0
                while o < 2 {
                    let mut offset: f64 = 0.0 - 12.0
                    if o == 1 { offset = 12.0 }
                    let cx: f64 = mx + ux * offset
                    let cy: f64 = my + uy * offset
                    out = out + "\n  \\draw[gray] (" + f1(cx + px * 6.0) + "," + f1(cy + py * 6.0) + ") -- (" + f1(cx - px * 6.0) + "," + f1(cy - py * 6.0) + ");"
                    o = o + 1
                }
            }
            side = side + 1
        }
        i = i + 1
    }
    let arms: ptr<string> = malloc(((g[0].nseg * 2 + 2) as i64) * 8) as ptr<string>
    i = 0
    while i < g[0].nright {
        let na: i32 = geom_arms(g, g[0].right[i], arms)
        if na >= 2 {
            out = out + "\n  \\pic [draw, angle radius=3.5mm] {right angle = " + geom_sidx(arms[0]) + "--" + geom_sidx(g[0].right[i]) + "--" + geom_sidx(arms[1]) + "};"
        }
        i = i + 1
    }
    i = 0
    while i < g[0].nang {
        out = out + "\n  \\pic [draw, angle radius=5mm, \"" + geom_angle_label_tex(g[0].ang_label[i]) + "\"] {angle = " + geom_sidx(g[0].ang_a1[i]) + "--" + geom_sidx(g[0].ang_v[i]) + "--" + geom_sidx(g[0].ang_a2[i]) + "};"
        i = i + 1
    }
    i = 0
    while i < g[0].ncurve {
        let c: FlowcGeomCurve = g[0].curves[i]
        let mut style: string = "thick"
        if c.dashed == 1 { style = "dashed, thick" }
        let stroke: string = geom_tikz_color(names, nc, c.stroke)
        out = out + "\n  \\draw[" + style + ", draw=" + stroke + "] plot[smooth] coordinates {" + geom_coords(g, c.xs, c.ys, c.n) + "};"
        if strlen(c.label) > 0 and c.n > 0 {
            let k: i32 = c.n / 3
            out = out + "\n  \\node[font=\\scriptsize, text=" + stroke + "] at (" + f1(c.xs[k]) + "," + f1(h - c.ys[k]) + ") {" + geom_latex_escape(c.label) + "};"
        }
        i = i + 1
    }
    i = 0
    while i < g[0].nlabel {
        let lab: FlowcGeomLabel = g[0].labels[i]
        out = out + "\n  \\node[font=\\small] at (" + f1(lab.x) + "," + f1(h - lab.y) + ") {" + geom_latex_escape(lab.text) + "};"
        i = i + 1
    }
    i = 0
    while i < g[0].npt {
        let name: string = g[0].pt_name[i]
        out = out + "\n  \\fill (" + name + ") circle (6pt);"
        let mut oy: string = "-14"
        if g[0].pt_y[i] < 120.0 { oy = "20" }
        out = out + "\n  \\node[font=\\bfseries] at ($( " + name + " ) + (0," + oy + ")$) {" + name + "};"
        i = i + 1
    }
    if strlen(g[0].caption) > 0 {
        out = out + "\n  \\node[below, text width=14cm, align=center, font=\\small] at (240,20) {" + geom_latex_escape(g[0].caption) + "};"
    }
    return out + "\n\\end{tikzpicture}\n\\end{center}"
}
