# @module flowc.mlir_bundle
# @means  Programs with imports for the MLIR emitter, in Python's module order.
#
# The Python MLIR generator sees one flat declaration list built by
# src/flow/module_resolver.py: a depth-first walk from the entry file where
# each module's imports are loaded (in order) before its own declarations,
# a module already loaded is skipped, imports and `export a, b` lists are
# dropped, and an imported module's `main` is left out. This module rebuilds
# that order, resolving each import as the C bundle does
# (flowc_resolve_module_import in resolve.flow), joins the modules' expanded sources
# into one buffer in that order, parses it once and hands it to the emitter
# with the module table, so every lowering decision stays in mlirgen.flow.

import .ast { AstArena, AST_NONE, AST_IMPORT, AST_PROGRAM }
import .parser {
    flowc_parser_new, flowc_parser_free, flowc_parse_program, flowc_parser_print_error, Parser
}
import .fileio { flowc_read_file }
import .resolve {
    flowc_expand_for_mlir_in_place, flowc_resolve_project_root, flowc_resolve_dirname,
    flowc_resolve_module_import
}
import .typecheck {
    TcCtx,
    flowc_tc_init, flowc_tc_free, flowc_tc_reset_module,
    flowc_tc_set_path, flowc_tc_seed_export, flowc_tc_check_program
}
import .mlirgen { flowc_mlirgen_emit_modules }

extern {
    function malloc(size: i64) -> ptr<u8>
    function free(p: ptr<u8>) -> void
    function strlen(s: string) -> i64
    function puts(s: string) -> i32
    function printf(fmt: string, ...) -> i32
    function getenv(name: string) -> string
}

# 1 when the environment variable `name` is exactly `want`.
function mb_env_is(name: string, want: string) -> i32 {
    let v: string = getenv(name)
    let vp: ptr<u8> = v
    if vp == null {
        return 0
    }
    let wp: ptr<u8> = want
    let mut i: i32 = 0
    while wp[i] != 0 {
        if vp[i] != wp[i] {
            return 0
        }
        i = i + 1
    }
    if vp[i] != 0 {
        return 0
    }
    return 1
}

const MB_MAX_MODS: i32 = 256
const MB_PATH: i32 = 1024
const MB_SRC_CAP: i32 = 1048576
# The joined program, with room for the emitter's synthesized names.
const MB_ALL_CAP: i32 = 8388608
const MB_AST_CAP: i32 = 1048576

struct MlirBundle {
    # module paths (realpath), MB_PATH bytes each, in discovery order
    paths: ptr<u8>,
    n: i32,
    state: ptr<i32>,
    # 0 unseen, 1 on the walk's stack, 2 loaded
    all: ptr<u8>,
    all_len: i32,
    # emission order: module index and its start in `all`
    order: ptr<i32>,
    starts: ptr<i32>,
    norder: i32,
    # the C bundle's project root and search directory (FLOWC_DIR)
    project_root: ptr<u8>,
    search_dir: ptr<u8>,
    err: i32
}

function mb_alloc_i32(n: i32) -> ptr<i32> {
    let raw: ptr<u8> = malloc((n as i64) * 4)
    let p: ptr<i32> = raw
    let mut i: i32 = 0
    while i < n {
        p[i] = 0
        i = i + 1
    }
    return p
}

function mb_zero(p: ptr<u8>, n: i32) {
    let mut i: i32 = 0
    while i < n {
        p[i] = 0
        i = i + 1
    }
}

# Append n bytes of s to dst (NUL kept after). Returns the new length, or
# -1 when it does not fit.
function mb_put(dst: ptr<u8>, o: i32, cap: i32, s: ptr<u8>, n: i32) -> i32 {
    if o < 0 or o + n + 1 > cap {
        return 0 - 1
    }
    let mut i: i32 = 0
    while i < n {
        dst[o + i] = s[i]
        i = i + 1
    }
    dst[o + n] = 0
    return o + n
}

function mb_puts(dst: ptr<u8>, o: i32, cap: i32, s: string) -> i32 {
    let p: ptr<u8> = s
    return mb_put(dst, o, cap, p, strlen(s) as i32)
}

function mb_cstr_len(p: ptr<u8>) -> i32 {
    let s: string = p as string
    return strlen(s) as i32
}

function mb_cstr_eq(a: ptr<u8>, b: ptr<u8>) -> i32 {
    let mut i: i32 = 0
    while a[i] != 0 and a[i] == b[i] {
        i = i + 1
    }
    if a[i] == b[i] {
        return 1
    }
    return 0
}

# Index of the module at canonical path p, adding it when new.
function mb_module(b: ptr<MlirBundle>, p: ptr<u8>) -> i32 {
    let mut i: i32 = 0
    while i < b[0].n {
        if mb_cstr_eq(b[0].paths + i * MB_PATH, p) == 1 {
            return i
        }
        i = i + 1
    }
    if b[0].n >= MB_MAX_MODS {
        puts("flowc mlir: unsupported: more than 256 modules at line 0")
        b[0].err = 1
        return 0 - 1
    }
    let k: i32 = b[0].n
    mb_put(b[0].paths + k * MB_PATH, 0, MB_PATH, p, mb_cstr_len(p))
    b[0].n = k + 1
    return k
}

# Python os.path.abspath of p into out (MB_PATH bytes): the working
# directory in front of a relative path, then `.`, `..` and repeated
# slashes folded. 1 on success.
function mb_realpath(p: string, out: ptr<u8>) -> i32 {
    let raw: ptr<u8> = malloc((MB_PATH * 2) as i64)
    mb_zero(raw, MB_PATH * 2)
    let pp: ptr<u8> = p
    let mut o: i32 = 0
    if pp[0] != 47 {
        # The shell's working directory. getcwd() would pull unistd.h into
        # the C the Python host builds for flowc, whose `write` extern
        # (proof_doc.flow) then clashes with it.
        let cwd: string = getenv("PWD")
        let cp: ptr<u8> = cwd
        if cp == null or cp[0] != 47 {
            free(raw)
            return 0
        }
        o = mb_put(raw, 0, MB_PATH * 2, cp, mb_cstr_len(cp))
        o = mb_puts(raw, o, MB_PATH * 2, "/")
    }
    o = mb_put(raw, o, MB_PATH * 2, pp, mb_cstr_len(pp))
    if o < 0 {
        free(raw)
        return 0
    }
    # Fold segments into out.
    let mut w: i32 = 0
    let mut i: i32 = 0
    while i < o {
        while i < o and raw[i] == 47 {
            i = i + 1
        }
        let s: i32 = i
        while i < o and raw[i] != 47 {
            i = i + 1
        }
        let mut n: i32 = i - s
        if n == 1 and raw[s] == 46 {
            n = 0
        }
        if n == 2 and raw[s] == 46 and raw[s + 1] == 46 {
            while w > 0 and out[w - 1] != 47 {
                w = w - 1
            }
            if w > 0 {
                w = w - 1
            }
        } else {
            if n > 0 {
                if w + n + 2 >= MB_PATH {
                    free(raw)
                    return 0
                }
                out[w] = 47
                w = w + 1
                let mut q: i32 = 0
                while q < n {
                    out[w] = raw[s + q]
                    w = w + 1
                    q = q + 1
                }
            }
        }
    }
    if w == 0 {
        out[0] = 47
        w = 1
    }
    out[w] = 0
    free(raw)
    return 1
}

# The import node imp of the module at mpath (directory mod_dir), resolved
# as the C bundle resolves it (flowc_resolve_module_import). Writes the
# canonical path to out and returns 1; 0 when it does not resolve; -3 when
# it names no module (skipped); -2 or -4 when the resolver reported why.
function mb_resolve(b: ptr<MlirBundle>, arena: AstArena, src: ptr<u8>, imp: i32, mpath: string, mod_dir: ptr<u8>, out: ptr<u8>) -> i32 {
    let found: ptr<u8> = malloc(MB_PATH as i64)
    mb_zero(found, MB_PATH)
    let ms: string = mod_dir as string
    let sd: string = b[0].search_dir as string
    let pr: string = b[0].project_root as string
    let r: i32 = flowc_resolve_module_import(mpath, src, arena.nodes[imp].name_start, arena.nodes[imp].name_end, arena.nodes[imp].ival, ms, sd, pr, found)
    let mut ok: i32 = 0
    if r > 0 {
        let fs: string = found as string
        if mb_realpath(fs, out) == 1 {
            ok = 1
        }
    } elif r != 0 - 1 {
        ok = r
    }
    free(found)
    return ok
}

# Python _resolve_recursive: imports first (in order), then the module.
function mb_visit(b: ptr<MlirBundle>, k: i32) {
    if b[0].err != 0 or b[0].state[k] != 0 {
        return
    }
    b[0].state[k] = 1
    let path: string = (b[0].paths + k * MB_PATH) as string
    let src: ptr<u8> = malloc(MB_SRC_CAP as i64)
    mb_zero(src, MB_SRC_CAP)
    let mut n: i32 = flowc_read_file(path, src, MB_SRC_CAP - 1)
    if n <= 0 {
        printf("flowc mlir: cannot read %s\n", path)
        b[0].err = 1
        free(src)
        return
    }
    src[n] = 0
    n = flowc_expand_for_mlir_in_place(src, n, MB_SRC_CAP)
    if n < 0 {
        b[0].err = 1
        free(src)
        return
    }
    let mut p: Parser = flowc_parser_new(src, n, MB_AST_CAP)
    let root: i32 = flowc_parse_program(&p)
    if root < 0 or p.err != 0 {
        puts("flowc emit: parse failed")
        flowc_parser_print_error(p, path)
        flowc_parser_free(p)
        b[0].err = 1
        free(src)
        return
    }
    let dir: ptr<u8> = malloc(MB_PATH as i64)
    mb_zero(dir, MB_PATH)
    flowc_resolve_dirname(path, dir, MB_PATH)
    let dep: ptr<u8> = malloc(MB_PATH as i64)
    let mut item: i32 = p.arena.nodes[root].a
    while item != AST_NONE and b[0].err == 0 {
        if p.arena.nodes[item].kind == AST_IMPORT {
            mb_zero(dep, MB_PATH)
            let res: i32 = mb_resolve(b, p.arena, src, item, path, dir, dep)
            if res < 0 {
                if res != 0 - 3 {
                    b[0].err = 1
                }
            } elif res == 0 {
                # Report the import as Python would refuse it.
                let mut line: i32 = 1
                let mut q: i32 = 0
                while q < p.arena.nodes[item].start {
                    if src[q] == 10 {
                        line = line + 1
                    }
                    q = q + 1
                }
                printf("flowc mlir: unsupported: import that does not resolve at line %d\n", line)
                b[0].err = 1
            } else {
                let d: i32 = mb_module(b, dep)
                if d >= 0 {
                    mb_visit(b, d)
                }
            }
        }
        item = p.arena.nodes[item].next
    }
    free(dep)
    free(dir)
    flowc_parser_free(p)
    if b[0].err == 0 {
        if b[0].norder >= MB_MAX_MODS {
            b[0].err = 1
        } else {
            b[0].order[b[0].norder] = k
            b[0].starts[b[0].norder] = b[0].all_len
            b[0].norder = b[0].norder + 1
            let o: i32 = mb_put(b[0].all, b[0].all_len, MB_ALL_CAP - 65536, src, n)
            let o2: i32 = mb_puts(b[0].all, o, MB_ALL_CAP - 65536, "\n")
            if o2 < 0 {
                puts("flowc mlir: unsupported: program larger than 8 MB at line 0")
                b[0].err = 1
            } else {
                b[0].all_len = o2
            }
        }
    }
    free(src)
    b[0].state[k] = 2
}

# 1 when the program at in_path has a top-level import (0 when it does not
# read or parse; the single-file path reports that).
export function flowc_mlir_wants_modules(in_path: string) -> i32 {
    let src: ptr<u8> = malloc(MB_SRC_CAP as i64)
    mb_zero(src, MB_SRC_CAP)
    let mut n: i32 = flowc_read_file(in_path, src, MB_SRC_CAP - 1)
    if n <= 0 {
        free(src)
        return 0
    }
    src[n] = 0
    n = flowc_expand_for_mlir_in_place(src, n, MB_SRC_CAP)
    if n < 0 {
        free(src)
        return 0
    }
    let mut p: Parser = flowc_parser_new(src, n, MB_AST_CAP)
    let root: i32 = flowc_parse_program(&p)
    let mut found: i32 = 0
    if root >= 0 and p.err == 0 {
        let mut item: i32 = p.arena.nodes[root].a
        while item != AST_NONE {
            if p.arena.nodes[item].kind == AST_IMPORT {
                found = 1
            }
            item = p.arena.nodes[item].next
        }
    }
    flowc_parser_free(p)
    free(src)
    return found
}

# The Stage-A typecheck of each module in order, dependencies first, with
# the exports of the modules before it in scope (flowc_bundle_typecheck's
# rules over this module list). Returns the error count.
function mb_typecheck(b: ptr<MlirBundle>, fatal_out: ptr<i32>) -> i32 {
    fatal_out[0] = 1
    let no_src: ptr<u8> = null
    let mut ctx: TcCtx = flowc_tc_init(no_src)
    ctx.lenient = 1
    if ctx.ns == null {
        return 1
    }
    let src: ptr<u8> = malloc(MB_SRC_CAP as i64)
    let mut total: i32 = 0
    let mut i: i32 = 0
    while i < b[0].norder {
        let s: i32 = b[0].starts[i]
        let n: i32 = b[0].starts[i + 1] - s
        mb_zero(src, MB_SRC_CAP)
        mb_put(src, 0, MB_SRC_CAP, b[0].all + s, n)
        let mpath: string = (b[0].paths + b[0].order[i] * MB_PATH) as string
        let mut p: Parser = flowc_parser_new(src, n, MB_AST_CAP)
        let root: i32 = flowc_parse_program(&p)
        if root < 0 or p.err != 0 {
            flowc_parser_print_error(p, mpath)
            flowc_parser_free(p)
            free(src)
            flowc_tc_free(&ctx)
            return 1
        }
        flowc_tc_reset_module(&ctx, src)
        flowc_tc_set_path(&ctx, mpath)
        total = total + flowc_tc_check_program(&ctx, p.arena, root)
        ctx.nlen = ctx.seed_nlen
        flowc_tc_seed_export(&ctx, p.arena, root, src)
        flowc_parser_free(p)
        i = i + 1
    }
    free(src)
    fatal_out[0] = ctx.fatal
    flowc_tc_free(&ctx)
    return total
}

# Emit MLIR for the program at in_path and every module it imports. Returns
# the bytes written to out, or -1 after printing why.
export function flowc_mlir_emit_program(in_path: string, out: ptr<u8>, out_cap: i32, typecheck: i32) -> i32 {
    let mut mb: MlirBundle = MlirBundle {
        paths: malloc((MB_MAX_MODS * MB_PATH) as i64), n: 0,
        state: mb_alloc_i32(MB_MAX_MODS),
        all: malloc(MB_ALL_CAP as i64), all_len: 0,
        order: mb_alloc_i32(MB_MAX_MODS), starts: mb_alloc_i32(MB_MAX_MODS + 1), norder: 0,
        project_root: malloc(MB_PATH as i64), search_dir: malloc(MB_PATH as i64), err: 0
    }
    let b: ptr<MlirBundle> = &mb
    mb_zero(mb.all, MB_ALL_CAP)
    mb_zero(mb.project_root, MB_PATH)
    mb_zero(mb.search_dir, MB_PATH)
    # The C bundle searches FLOWC_DIR, which `flow compile` sets to the
    # distribution root; the MLIR driver passes that root as FLOWC_ROOT.
    let mut sdir: string = getenv("FLOWC_DIR")
    let mut sdp: ptr<u8> = sdir
    if sdp == null or sdp[0] == 0 {
        sdir = getenv("FLOWC_ROOT")
        sdp = sdir
    }
    if sdp == null or sdp[0] == 0 {
        sdir = "."
    }
    mb_puts(mb.search_dir, 0, MB_PATH, sdir)
    # The nearest flow.toml above the entry, where packages resolve. A
    # program without one still resolves, as in the C bundle.
    flowc_resolve_project_root(in_path, mb.project_root, MB_PATH)
    # The walk.
    let rootp: ptr<u8> = malloc(MB_PATH as i64)
    mb_zero(rootp, MB_PATH)
    if mb_realpath(in_path, rootp) == 0 {
        puts("flowc emit: read FLOWC_IN failed")
        return 0 - 1
    }
    let rk: i32 = mb_module(b, rootp)
    free(rootp)
    mb_visit(b, rk)
    if mb.err != 0 {
        return 0 - 1
    }
    mb.starts[mb.norder] = mb.all_len
    if typecheck == 1 {
        let tc_fatal: array<i32, 1> = [0]
        let tc_errs: i32 = mb_typecheck(b, &tc_fatal[0] as ptr<i32>)
        # FLOWC_LENIENT=1 (Python --lenient): errors that are not fatal are
        # warnings.
        let lenient_ok: i32 = if tc_fatal[0] == 0 and mb_env_is("FLOWC_LENIENT", "1") == 1 { 1 } else { 0 }
        if tc_errs > 0 and lenient_ok == 1 {
            printf("flowc: %d type warning(s) (lenient mode)\n", tc_errs)
        }
        if tc_errs > 0 and lenient_ok == 0 {
            puts("flowc emit: bundle typecheck failed")
            printf("flowc emit: tc_errs=%d\n", tc_errs)
            return 0 - 1
        }
    }
    let mut p: Parser = flowc_parser_new(mb.all, mb.all_len, MB_AST_CAP * 4)
    let root: i32 = flowc_parse_program(&p)
    if root < 0 or p.err != 0 {
        puts("flowc emit: parse failed")
        flowc_parser_print_error(p, in_path)
        flowc_parser_free(p)
        return 0 - 1
    }
    # No pipeline fusion: the Python MLIR generator does not fuse stages.
    mb.starts[mb.norder] = mb.all_len
    # Module names for refusals, in emission order.
    let names: ptr<u8> = malloc((MB_MAX_MODS * MB_PATH) as i64)
    let mut i: i32 = 0
    while i < mb.norder {
        let src_name: ptr<u8> = mb.paths + mb.order[i] * MB_PATH
        mb_put(names + i * MB_PATH, 0, MB_PATH, src_name, mb_cstr_len(src_name))
        i = i + 1
    }
    let n: i32 = flowc_mlirgen_emit_modules(p.arena, root, mb.all, mb.all_len, MB_ALL_CAP, mb.starts, mb.norder, names, MB_PATH, out, out_cap)
    flowc_parser_free(p)
    free(names)
    return n
}
