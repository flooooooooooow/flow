# Stage-A Flow driver — CLI argv or getenv FLOWC_IN / FLOWC_OUT → parse → cgen → write.
#
# Emitted alone (imports skipped) and linked with flowc_frontend.o:
#   ./compiler/build/stage_a_driver_flow in.flow out.c
#   FLOWC_IN=... FLOWC_OUT=... ./compiler/build/stage_a_driver_flow
# Typecheck ON by default; opt-out: FLOWC_TYPECHECK=0 or FLOWC_NO_TYPECHECK=1.
# Optional: FLOWC_BUNDLE=1 emits entry + relative imports into one C TU
#   (FLOWC_DIR = search dir, default dirname of input).
#
# Keeps the hand-written C host (host/stage_a_driver.c) as a CLI fallback.

import .fileio { flowc_read_file, flowc_write_file }
import .parser { flowc_parser_new, flowc_parser_free, flowc_parse_program, Parser }
import .cgen { flowc_cgen_emit }
import .typecheck { flowc_typecheck }
import .resolve { flowc_bundle_emit, flowc_bundle_typecheck, flowc_resolve_dirname }

extern {
    function printf(fmt: string, val: i32) -> i32
    function puts(s: string) -> i32
    function malloc(size: i64) -> ptr<u8>
    function free(p: ptr<u8>) -> void
    function strlen(s: string) -> i64
    function getenv(name: string) -> string
}

# Non-null and non-empty getenv result → 1, else 0.
function flowc_driver_env_set(name: string) -> i32 {
    let v: string = getenv(name)
    let p: ptr<u8> = v
    if p == null {
        return 0
    }
    if strlen(v) == 0 {
        return 0
    }
    return 1
}

# Exact getenv value "0" → 1, else 0.
function flowc_driver_env_is_zero(name: string) -> i32 {
    let v: string = getenv(name)
    let p: ptr<u8> = v
    if p == null {
        return 0
    }
    if strlen(v) != 1 {
        return 0
    }
    if p[0] == 48 {
        return 1
    }
    return 0
}

# Stage-A typecheck default ON. Opt-out: FLOWC_TYPECHECK=0 or FLOWC_NO_TYPECHECK=1.
function flowc_driver_want_typecheck() -> i32 {
    if flowc_driver_env_set("FLOWC_NO_TYPECHECK") == 1 {
        return 0
    }
    if flowc_driver_env_is_zero("FLOWC_TYPECHECK") == 1 {
        return 0
    }
    return 1
}

function flowc_driver_run(in_path: string, out_path: string) -> i32 {
    # 1MB: parser bundle (token+ast+lexer+parser) needs headroom beyond 512K.
    let out_cap: i32 = 1048576
    let out: ptr<u8> = malloc(out_cap as i64)
    if out == null {
        puts("stage_a_driver_flow: malloc out failed")
        return 1
    }
    let mut zi: i32 = 0
    while zi < out_cap {
        out[zi] = 0
        zi = zi + 1
    }

    # Opt-in multi-file bundle: resolve .sibling / "path" imports → one C TU.
    if flowc_driver_env_set("FLOWC_BUNDLE") == 1 {
        let mut search_dir: string = "compiler/src"
        let dir_buf: ptr<u8> = malloc(256)
        if dir_buf == null {
            puts("stage_a_driver_flow: malloc dir failed")
            free(out)
            return 1
        }
        zi = 0
        while zi < 256 {
            dir_buf[zi] = 0
            zi = zi + 1
        }
        if flowc_driver_env_set("FLOWC_DIR") == 1 {
            search_dir = getenv("FLOWC_DIR")
        } else {
            let dlen: i32 = flowc_resolve_dirname(in_path, dir_buf, 256)
            if dlen > 0 {
                search_dir = dir_buf
            }
        }
        # Bundle typecheck (deps-first + export seed) when typecheck wanted.
        if flowc_driver_want_typecheck() == 1 {
            let tc_errs: i32 = flowc_bundle_typecheck(in_path, search_dir)
            if tc_errs > 0 {
                puts("stage_a_driver_flow: bundle typecheck failed")
                printf("stage_a_driver_flow: tc_errs=%d\n", tc_errs)
                free(dir_buf)
                free(out)
                return 1
            }
        }
        let nout: i32 = flowc_bundle_emit(in_path, search_dir, out, out_cap)
        free(dir_buf)
        if nout <= 0 {
            puts("stage_a_driver_flow: bundle emit failed")
            free(out)
            return 1
        }
        if flowc_write_file(out_path, out, nout) != 0 {
            puts("stage_a_driver_flow: write output failed")
            free(out)
            return 1
        }
        free(out)
        return 0
    }

    let src_cap: i32 = 262144
    let src: ptr<u8> = malloc(src_cap as i64)
    if src == null {
        puts("stage_a_driver_flow: malloc src failed")
        free(out)
        return 1
    }
    zi = 0
    while zi < src_cap {
        src[zi] = 0
        zi = zi + 1
    }
    let nsrc: i32 = flowc_read_file(in_path, src, src_cap - 1)
    if nsrc <= 0 {
        puts("stage_a_driver_flow: read input failed")
        free(src)
        free(out)
        return 1
    }
    src[nsrc] = 0

    let mut p: Parser = flowc_parser_new(src, nsrc, 262144)
    let root: i32 = flowc_parse_program(&p)
    if root < 0 or p.err != 0 {
        puts("stage_a_driver_flow: parse failed")
        printf("stage_a_driver_flow: at %d\n", p.cur.start)
        printf("stage_a_driver_flow: arena_len=%d\n", p.arena.len)
        flowc_parser_free(p)
        free(src)
        free(out)
        return 1
    }

    # Stage-A typecheck ON by default (opt-out for frontend dogfood modules).
    if flowc_driver_want_typecheck() == 1 {
        let tc_errs: i32 = flowc_typecheck(p.arena, root, src)
        if tc_errs > 0 {
            puts("stage_a_driver_flow: typecheck failed")
            printf("stage_a_driver_flow: tc_errs=%d\n", tc_errs)
            flowc_parser_free(p)
            free(src)
            free(out)
            return 1
        }
    }

    let nout: i32 = flowc_cgen_emit(p.arena, root, src, out, out_cap)
    if nout <= 0 {
        puts("stage_a_driver_flow: cgen failed")
        free(out)
        flowc_parser_free(p)
        free(src)
        return 1
    }

    if flowc_write_file(out_path, out, nout) != 0 {
        puts("stage_a_driver_flow: write output failed")
        free(out)
        flowc_parser_free(p)
        free(src)
        return 1
    }

    free(out)
    flowc_parser_free(p)
    free(src)
    return 0
}

# Stage-A cgen maps this to int main(int argc, char **argv).
function main(argc: i32, argv: ptr<ptr<u8>>) -> i32 {
    if argc == 3 {
        return flowc_driver_run(argv[1] as string, argv[2] as string)
    }
    if flowc_driver_env_set("FLOWC_IN") == 0 {
        puts("usage: stage_a_driver_flow <in.flow> <out.c>")
        return 2
    }
    if flowc_driver_env_set("FLOWC_OUT") == 0 {
        puts("usage: stage_a_driver_flow <in.flow> <out.c>")
        return 2
    }
    return flowc_driver_run(getenv("FLOWC_IN"), getenv("FLOWC_OUT"))
}
