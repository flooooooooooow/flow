# @module flowc.proof_lower
# @means  Erase the proof layer before a backend sees the program.
#
# The Python host treats `theorem`, `assume`, `therefore` and claim
# references as proof metadata with no runtime behaviour: the C generator
# skips theorem declarations, writes `assume` / `therefore` inside an
# ordinary function as a comment, and export and import brace lists that name
# claims are citations only (src/flow/module_resolver.py). This pass gives
# flowc the same semantics.
#
# It unlinks every theorem from the program, every assume / therefore from
# its block, and every claim reference from export and import lists. Each
# erased node, and every node inside its source span, is retagged AST_ERROR:
# unreachable, and invisible to the backends' arena scans and to
# flowc_ast_first_unsupported. A proof node found anywhere else stays as it
# is, so the backend still refuses it by name.
#
# Idempotent: typecheck and cgen both run it on the same arena.

import .ast {
    AstArena, AstNode, AST_NONE, AST_PROGRAM, AST_BLOCK, AST_EXPORT,
    AST_IMPORT, AST_ERROR, AST_THEOREM, AST_ASSUME, AST_THEREFORE,
    AST_CLAIM_REF
}

# Retag node `id` and every node whose source span lies inside its span.
function flowc_proof_retag_span(arena: AstArena, id: i32) -> void {
    let nodes: ptr<AstNode> = arena.nodes
    let s: i32 = nodes[id].start
    let e: i32 = nodes[id].end
    nodes[id].kind = AST_ERROR
    let mut i: i32 = 0
    while i < arena.len {
        let k: i32 = nodes[i].kind
        if k != AST_PROGRAM and k != AST_ERROR {
            if nodes[i].start >= s and nodes[i].end <= e and nodes[i].start < e {
                nodes[i].kind = AST_ERROR
            }
        }
        i = i + 1
    }
}

# 1 for a node the pass removes from a statement chain.
function flowc_proof_is_stmt(kind: i32) -> i32 {
    if kind == AST_ASSUME or kind == AST_THEREFORE {
        return 1
    }
    return 0
}

# Drop claim references from a name chain. Returns the new head.
function flowc_proof_filter_names(arena: AstArena, head: i32) -> i32 {
    let nodes: ptr<AstNode> = arena.nodes
    let mut new_head: i32 = AST_NONE
    let mut tail: i32 = AST_NONE
    let mut cur: i32 = head
    while cur != AST_NONE {
        let nxt: i32 = nodes[cur].next
        if nodes[cur].kind == AST_CLAIM_REF {
            nodes[cur].next = AST_NONE
            nodes[cur].kind = AST_ERROR
        } else {
            if tail == AST_NONE {
                new_head = cur
            } else {
                nodes[tail].next = cur
            }
            tail = cur
        }
        cur = nxt
    }
    if tail != AST_NONE {
        nodes[tail].next = AST_NONE
    }
    return new_head
}

# Drop assume / therefore statements from a block's statement chain.
function flowc_proof_filter_block(arena: AstArena, block: i32) -> void {
    let nodes: ptr<AstNode> = arena.nodes
    let mut new_head: i32 = AST_NONE
    let mut tail: i32 = AST_NONE
    let mut cur: i32 = nodes[block].a
    while cur != AST_NONE {
        let nxt: i32 = nodes[cur].next
        if flowc_proof_is_stmt(nodes[cur].kind) == 1 {
            nodes[cur].next = AST_NONE
            flowc_proof_retag_span(arena, cur)
        } else {
            if tail == AST_NONE {
                new_head = cur
            } else {
                nodes[tail].next = cur
            }
            tail = cur
        }
        cur = nxt
    }
    if tail != AST_NONE {
        nodes[tail].next = AST_NONE
    }
    nodes[block].a = new_head
}

# Erase the proof layer from the program at `root`. Returns the number of
# nodes unlinked (0 for a program without proofs).
export function flowc_proof_erase(arena: AstArena, root: i32) -> i32 {
    if root == AST_NONE or root < 0 {
        return 0
    }
    let nodes: ptr<AstNode> = arena.nodes
    if nodes[root].kind != AST_PROGRAM {
        return 0
    }
    let mut erased: i32 = 0

    # Top-level items: theorems, claim exports, claim imports.
    let mut new_head: i32 = AST_NONE
    let mut tail: i32 = AST_NONE
    let mut cur: i32 = nodes[root].a
    while cur != AST_NONE {
        let nxt: i32 = nodes[cur].next
        let mut keep: i32 = 1
        let k: i32 = nodes[cur].kind
        if k == AST_THEOREM {
            keep = 0
        }
        if k == AST_EXPORT and nodes[cur].ival == 1 {
            let before: i32 = nodes[cur].a
            nodes[cur].a = flowc_proof_filter_names(arena, before)
            if nodes[cur].a != before {
                erased = erased + 1
            }
            if nodes[cur].a == AST_NONE {
                keep = 0
            }
        }
        if k == AST_IMPORT {
            let before: i32 = nodes[cur].a
            nodes[cur].a = flowc_proof_filter_names(arena, before)
            if nodes[cur].a != before {
                erased = erased + 1
            }
            let mark: i32 = nodes[cur].b
            if mark != AST_NONE and nodes[mark].kind == AST_CLAIM_REF {
                nodes[mark].kind = AST_ERROR
                nodes[cur].b = AST_NONE
            }
        }
        if keep == 0 {
            nodes[cur].next = AST_NONE
            flowc_proof_retag_span(arena, cur)
            erased = erased + 1
        } else {
            if tail == AST_NONE {
                new_head = cur
            } else {
                nodes[tail].next = cur
            }
            tail = cur
        }
        cur = nxt
    }
    if tail != AST_NONE {
        nodes[tail].next = AST_NONE
    }
    nodes[root].a = new_head

    # Statements: assume / therefore inside ordinary function bodies.
    let mut i: i32 = 0
    while i < arena.len {
        if nodes[i].kind == AST_BLOCK {
            let mut has: i32 = 0
            let mut s: i32 = nodes[i].a
            while s != AST_NONE {
                if flowc_proof_is_stmt(nodes[s].kind) == 1 {
                    has = 1
                }
                s = nodes[s].next
            }
            if has == 1 {
                flowc_proof_filter_block(arena, i)
                erased = erased + 1
            }
        }
        i = i + 1
    }
    return erased
}
