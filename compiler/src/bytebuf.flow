# @module flowc.bytebuf
# @means  A growable byte buffer and the ASCII character tests that the
#         compiler's source expanders and the standard library share.
#
# Leaf module: externs only. The standard library re-exports it as
# `std.bytebuf` (lib/stdlib/bytebuf.flow), so a tool and the compiler use
# the same code.
#
# The bytes live in `p[0 .. len)`. `p[len]` is always 0, so `bb_cstr` is a
# NUL-terminated view without a copy. The buffer grows by doubling. `err`
# is set when an allocation fails; the write is then dropped.

extern {
    function malloc(size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function strlen(s: string) -> i64
}

export struct ByteBuf {
    p: ptr<u8>,
    len: i32,
    cap: i32,
    err: i32
}

# A buffer with room for `cap` bytes before it first grows.
export function bb_new(cap: i32) -> ptr<ByteBuf> {
    let b: ptr<ByteBuf> = malloc(24) as ptr<ByteBuf>
    let mut c: i32 = cap
    if c < 16 {
        c = 16
    }
    b[0].p = malloc((c + 1) as i64) as ptr<u8>
    b[0].len = 0
    b[0].cap = c
    b[0].err = 0
    if b[0].p == null {
        b[0].cap = 0
        b[0].err = 1
        return b
    }
    b[0].p[0] = 0
    return b
}

export function bb_free(b: ptr<ByteBuf>) {
    if b == null {
        return
    }
    if b[0].p != null {
        free(b[0].p as ptr<void>)
    }
    free(b as ptr<void>)
}

# Make room for `extra` more bytes. False when the allocation failed.
export function bb_reserve(b: ptr<ByteBuf>, extra: i32) -> bool {
    let need: i32 = b[0].len + extra
    if need <= b[0].cap {
        return true
    }
    let mut ncap: i32 = b[0].cap * 2 + 64
    if ncap < need {
        ncap = need
    }
    let np: ptr<u8> = realloc(b[0].p as ptr<void>, (ncap + 1) as i64) as ptr<u8>
    if np == null {
        b[0].err = 1
        return false
    }
    b[0].p = np
    b[0].cap = ncap
    return true
}

export function bb_putc(b: ptr<ByteBuf>, c: u8) {
    if b[0].len >= b[0].cap {
        if bb_reserve(b, 1) == false {
            return
        }
    }
    b[0].p[b[0].len] = c
    b[0].len = b[0].len + 1
    b[0].p[b[0].len] = 0
}

# Append `n` bytes from `src`.
export function bb_put_bytes(b: ptr<ByteBuf>, src: ptr<u8>, n: i32) {
    if n <= 0 {
        return
    }
    if bb_reserve(b, n) == false {
        return
    }
    let dst: ptr<u8> = b[0].p
    let base: i32 = b[0].len
    let mut i: i32 = 0
    while i < n {
        dst[base + i] = src[i]
        i = i + 1
    }
    b[0].len = base + n
    dst[b[0].len] = 0
}

export function bb_puts(b: ptr<ByteBuf>, s: string) {
    bb_put_bytes(b, s as ptr<u8>, strlen(s) as i32)
}

# Append src[s .. e).
export function bb_put_span(b: ptr<ByteBuf>, src: ptr<u8>, s: i32, e: i32) {
    if e <= s {
        return
    }
    if bb_reserve(b, e - s) == false {
        return
    }
    let dst: ptr<u8> = b[0].p
    let mut o: i32 = b[0].len
    let mut i: i32 = s
    while i < e {
        dst[o] = src[i]
        o = o + 1
        i = i + 1
    }
    b[0].len = o
    dst[o] = 0
}

# Decimal text of `v`.
export function bb_put_i64(b: ptr<ByteBuf>, v: i64) {
    if v < 0 {
        # Digits of a negative value come out one at a time, so the most
        # negative i64 (which has no positive counterpart) prints too.
        bb_putc(b, 45)
        if v <= 0 - 10 {
            bb_put_i64(b, 0 - (v / 10))
        }
        bb_putc(b, (48 - (v % 10)) as u8)
        return
    }
    if v >= 10 {
        bb_put_i64(b, v / 10)
    }
    bb_putc(b, (48 + (v % 10)) as u8)
}

export function bb_put_i32(b: ptr<ByteBuf>, v: i32) {
    bb_put_i64(b, v as i64)
}

export function bb_len(b: ptr<ByteBuf>) -> i32 {
    return b[0].len
}

# The byte at `i`, or -1 outside the buffer.
export function bb_at(b: ptr<ByteBuf>, i: i32) -> i32 {
    if i < 0 or i >= b[0].len {
        return 0 - 1
    }
    return b[0].p[i] as i32
}

# The contents as a NUL-terminated string. A view: it changes when the
# buffer does, and is freed with it.
export function bb_cstr(b: ptr<ByteBuf>) -> string {
    return b[0].p as string
}

# A fresh copy of the contents that outlives the buffer.
export function bb_str(b: ptr<ByteBuf>) -> string {
    let out: ptr<u8> = malloc((b[0].len + 1) as i64) as ptr<u8>
    let mut i: i32 = 0
    while i < b[0].len {
        out[i] = b[0].p[i]
        i = i + 1
    }
    out[b[0].len] = 0
    return out as string
}

# Drop everything past the first `n` bytes.
export function bb_truncate(b: ptr<ByteBuf>, n: i32) {
    if n >= 0 and n < b[0].len {
        b[0].len = n
        b[0].p[n] = 0
    }
}

export function bb_clear(b: ptr<ByteBuf>) {
    bb_truncate(b, 0)
}

# ── ASCII character tests ────────────────────────────────────────

# Python str.isspace() over ASCII, which is what `\s` matches there:
# space, \t \n \v \f \r and the separators 0x1c..0x1f.
export function bb_is_space(c: u8) -> bool {
    return c == 32 or (c >= 9 and c <= 13) or (c >= 28 and c <= 31)
}

export function bb_is_digit(c: u8) -> bool {
    return c >= 48 and c <= 57
}

export function bb_is_alpha(c: u8) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

# ASCII `\w`: letters, digits and underscore.
export function bb_is_word(c: u8) -> bool {
    return bb_is_alpha(c) or bb_is_digit(c) or c == 95
}

# True when a[as .. ae) and b[bs .. be) hold the same bytes.
export function bb_span_eq(a: ptr<u8>, a_s: i32, a_e: i32, b: ptr<u8>, b_s: i32, b_e: i32) -> bool {
    if a_e - a_s != b_e - b_s {
        return false
    }
    let mut i: i32 = 0
    while i < a_e - a_s {
        if a[a_s + i] != b[b_s + i] {
            return false
        }
        i = i + 1
    }
    return true
}
