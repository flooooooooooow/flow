    printf("cgen_ptr_ok=%d\n", cgen_ptr_ok)
    let cast_ok: i32 = test_parse_cast()
    printf("cast_ok=%d\n", cast_ok)
    let idx_as_ok: i32 = test_parse_index_assign()
    printf("index_assign_ok=%d\n", idx_as_ok)
    let cgen_cast_ok: i32 = test_cgen_cast()
    printf("cgen_cast_ok=%d\n", cgen_cast_ok)
    let cgen_void_ok: i32 = test_cgen_void()
    printf("cgen_void_ok=%d\n", cgen_void_ok)
    let jsgen_ok: i32 = test_jsgen_emit()
    printf("jsgen_ok=%d\n", jsgen_ok)
    let tc_ok: i32 = test_typecheck_ok()
    printf("typecheck_ok=%d\n", tc_ok)
    let tc_bad: i32 = test_typecheck_bad()
    printf("typecheck_bad=%d\n", tc_bad)
    let tc_av: i32 = test_typecheck_arity_void()
    printf("typecheck_arity_void=%d\n", tc_av)
    let tc_dl: i32 = test_typecheck_dup_let()
    printf("typecheck_dup_let=%d\n", tc_dl)
    let tc_dc: i32 = test_typecheck_dup_const()
    printf("typecheck_dup_const=%d\n", tc_dc)
    let tc_au: i32 = test_typecheck_assign_unknown()
    printf("typecheck_assign_unknown=%d\n", tc_au)
    let tc_bo: i32 = test_typecheck_break_outside()
    printf("typecheck_break_outside=%d\n", tc_bo)
    let tc_bf: i32 = test_typecheck_bad_field()
    printf("typecheck_bad_field=%d\n", tc_bf)
    let match_ok: i32 = test_parse_match()
    printf("match_ok=%d\n", match_ok)
    let cgen_match_ok: i32 = test_cgen_match()
    printf("cgen_match_ok=%d\n", cgen_match_ok)
    let tc_mc: i32 = test_typecheck_match_catchall()
    printf("typecheck_match_catchall=%d\n", tc_mc)
    let elif_ok: i32 = test_parse_elif()
    printf("elif_ok=%d\n", elif_ok)
