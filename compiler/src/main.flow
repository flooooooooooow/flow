        105, 51, 50, 32, 123, 10, 32, 32, 102, 111, 114, 32, 105, 32, 105, 110,
        32, 48, 32, 116, 111, 32, 49, 48, 32, 123, 10, 32, 32, 32, 32, 108,
        101, 116, 32, 120, 58, 32, 105, 51, 50, 32, 61, 32, 105, 10, 32, 32,
        125, 10, 32, 32, 114, 101, 116, 117, 114, 110, 32, 48, 10, 125, 10, 0
    ]
    let sp: ptr<u8> = src
    let mut len: i32 = 0
    while len < 80 and sp[len] != 0 {
        len = len + 1
    }
    let mut p: Parser = flowc_parser_new(sp, len, 256)
    let root: i32 = flowc_parse_program(&p)
