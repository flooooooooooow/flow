function test_parse_cast() -> i32 {
    # KW_AS + AST_CAST nodes for `(x as i64) as i32`
    let kw: array<u8, 2> = [97, 115]
    let kp: ptr<u8> = kw
    let mut la = flowc_lexer_new(kp, 2)
    let t0 = flowc_lexer_next(&la)
    let mut ok: i32 = 1
    if expect_kind(t0.kind, TOK_KEYWORD) == 0 { ok = 0 }
    if t0.kw != KW_AS { ok = 0 }

    # function f() -> i32 {
    #     let x: i32 = 1
    #     return (x as i64) as i32
    # }
    let src: array<u8, 72> = [
        102, 117, 110, 99, 116, 105, 111, 110, 32, 102, 40, 41, 32, 45, 62, 32,
        105, 51, 50, 32, 123, 10, 32, 32, 32, 32, 108, 101, 116, 32, 120, 58,
        32, 105, 51, 50, 32, 61, 32, 49, 10, 32, 32, 32, 32, 114, 101, 116,
        117, 114, 110, 32, 40, 120, 32, 97, 115, 32, 105, 54, 52, 41, 32, 97,
        115, 32, 105, 51, 50, 10, 125, 10
    ]
    let sp: ptr<u8> = src
    let mut p: Parser = flowc_parser_new(sp, 72, 256)
    let root: i32 = flowc_parse_program(&p)
    if root < 0 { ok = 0 }
    if p.err != 0 { ok = 0 }
    let n_cast: i32 = flowc_ast_count_kind(p.arena, AST_CAST)
    printf("casts=%d\n", n_cast)
    if n_cast != 2 { ok = 0 }
    flowc_parser_free(p)
    return ok
}

function test_parse_index_assign() -> i32 {
    # p[0] = 40  → AST_ASSIGN with INDEX lhs
    # function main() -> i32 {
    #     let mut x: i32 = 0
    #     let mut y: i32 = 0
    #     let p: ptr<i32> = &x
    #     let q: ptr<i32> = &y
    #     p[0] = 40
    #     q[0] = 2
    #     return p[0] + q[0]
    # }
    let src: array<u8, 173> = [
        102, 117, 110, 99, 116, 105, 111, 110, 32, 109, 97, 105, 110, 40, 41, 32,
        45, 62, 32, 105, 51, 50, 32, 123, 10, 32, 32, 32, 32, 108, 101, 116,
        32, 109, 117, 116, 32, 120, 58, 32, 105, 51, 50, 32, 61, 32, 48, 10,
        32, 32, 32, 32, 108, 101, 116, 32, 109, 117, 116, 32, 121, 58, 32, 105,
        51, 50, 32, 61, 32, 48, 10, 32, 32, 32, 32, 108, 101, 116, 32, 112,
        58, 32, 112, 116, 114, 60, 105, 51, 50, 62, 32, 61, 32, 38, 120, 10,
        32, 32, 32, 32, 108, 101, 116, 32, 113, 58, 32, 112, 116, 114, 60, 105,
        51, 50, 62, 32, 61, 32, 38, 121, 10, 32, 32, 32, 32, 112, 91, 48,
        93, 32, 61, 32, 52, 48, 10, 32, 32, 32, 32, 113, 91, 48, 93, 32,
        61, 32, 50, 10, 32, 32, 32, 32, 114, 101, 116, 117, 114, 110, 32, 112,
        91, 48, 93, 32, 43, 32, 113, 91, 48, 93, 10, 125, 10
    ]
    let sp: ptr<u8> = src
    let mut p: Parser = flowc_parser_new(sp, 173, 256)
    let root: i32 = flowc_parse_program(&p)
    let mut ok: i32 = 1
    if root < 0 { ok = 0 }
    if p.err != 0 { ok = 0 }
    let n_as: i32 = flowc_ast_count_kind(p.arena, AST_ASSIGN)
    let n_ix: i32 = flowc_ast_count_kind(p.arena, AST_INDEX)
    printf("assigns=%d\n", n_as)
    printf("indexes=%d\n", n_ix)
    if n_as != 2 { ok = 0 }
    if n_ix < 2 { ok = 0 }
    flowc_parser_free(p)
    return ok
}

