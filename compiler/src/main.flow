function test_parse_const() -> i32 {
    # const keyword + const X / export const Y
    let kw: array<u8, 5> = [99, 111, 110, 115, 116]
    let kp: ptr<u8> = kw
    let mut la = flowc_lexer_new(kp, 5)
    let t0 = flowc_lexer_next(&la)
    let mut ok: i32 = 1
    if expect_kind(t0.kind, TOK_KEYWORD) == 0 { ok = 0 }
    if t0.kw != KW_CONST { ok = 0 }

    # const X: i32 = 42
    # export const Y: i32 = 7
    # function main() -> i32 { return 0 }
    let src: array<u8, 78> = [
        99, 111, 110, 115, 116, 32, 88, 58, 32, 105, 51, 50, 32, 61, 32, 52,
        50, 10, 101, 120, 112, 111, 114, 116, 32, 99, 111, 110, 115, 116, 32, 89,
        58, 32, 105, 51, 50, 32, 61, 32, 55, 10, 102, 117, 110, 99, 116, 105,
        111, 110, 32, 109, 97, 105, 110, 40, 41, 32, 45, 62, 32, 105, 51, 50,
        32, 123, 32, 114, 101, 116, 117, 114, 110, 32, 48, 32, 125, 10
    ]
    let sp: ptr<u8> = src
    let mut p: Parser = flowc_parser_new(sp, 78, 256)
    let root: i32 = flowc_parse_program(&p)
    if root < 0 { ok = 0 }
    if p.err != 0 { ok = 0 }
    let n_c: i32 = flowc_ast_count_kind(p.arena, AST_CONST)
    printf("consts=%d\n", n_c)
    if n_c != 2 { ok = 0 }
    let mut exported: i32 = 0
    let mut i: i32 = 0
    while i < p.arena.len {
        if p.arena.nodes[i].kind == AST_CONST and p.arena.nodes[i].ival == 1 {
            exported = exported + 1
        }
        i = i + 1
    }
    printf("export_consts=%d\n", exported)
    if exported != 1 { ok = 0 }
    flowc_parser_free(p)
    return ok
}

