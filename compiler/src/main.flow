        115, 116, 114, 117, 99, 116, 32, 80, 111, 105, 110, 116, 32, 123, 10, 32,
        32, 32, 32, 120, 58, 32, 105, 51, 50, 44, 10, 32, 32, 32, 32, 121,
        58, 32, 105, 51, 50, 10, 125, 10, 10, 102, 117, 110, 99, 116, 105, 111,
        110, 32, 109, 97, 105, 110, 40, 41, 32, 45, 62, 32, 105, 51, 50, 32,
        123, 10, 32, 32, 32, 32, 108, 101, 116, 32, 112, 58, 32, 80, 111, 105,
        110, 116, 32, 61, 32, 80, 111, 105, 110, 116, 32, 123, 32, 120, 58, 32,
        50, 48, 44, 32, 121, 58, 32, 50, 50, 32, 125, 10, 32, 32, 32, 32,
        114, 101, 116, 117, 114, 110, 32, 112, 46, 120, 32, 43, 32, 112, 46, 121,
        10, 125, 10, 0, 0, 0, 0
    ]
    let sp: ptr<u8> = src
    let mut len: i32 = 0
    while len < 136 and sp[len] != 0 {
        len = len + 1
    }
    let mut p: Parser = flowc_parser_new(sp, len, 256)
    let root: i32 = flowc_parse_program(&p)
    let mut ok: i32 = 1
    if root < 0 { ok = 0 }
    if p.err != 0 { ok = 0 }

    let cap: i32 = 8192
    let bp: ptr<u8> = malloc(cap as i64)
    if bp == null {
        puts("cgen_struct: malloc failed")
        flowc_parser_free(p)
        return 0
    }
    let mut zi: i32 = 0
    while zi < cap {
        bp[zi] = 0
        zi = zi + 1
    }

    let mut n: i32 = flowc_cgen_emit(p.arena, root, sp, bp, cap)
    printf("cgen_struct_bytes=%d\n", n)
    if n <= 0 { ok = 0 }
    if flowc_bytes_contains(bp, n, "typedef struct") == 0 { ok = 0 }
    if flowc_bytes_contains(bp, n, "Point") == 0 { ok = 0 }
    if flowc_bytes_contains(bp, n, "int32_t x") == 0 { ok = 0 }
    if flowc_bytes_contains(bp, n, "int32_t y") == 0 { ok = 0 }
    if flowc_bytes_contains(bp, n, ".x = ") == 0 { ok = 0 }
    if flowc_bytes_contains(bp, n, ".y = ") == 0 { ok = 0 }

    free(bp)
    flowc_parser_free(p)
    return ok
}

