function main() -> i32 {
    if flowc_env_set("FLOWC_IN") == 1 {
        return flowc_emit_mode()
    }

    puts("flowc: self-hosting bootstrap")
    let lex_ok: i32 = test_lexer_smoke()
    printf("lexer_ok=%d\n", lex_ok)
    let parse_ok: i32 = test_parse_core()
    printf("parse_ok=%d\n", parse_ok)
    let for_ok: i32 = test_parse_for()
    printf("for_ok=%d\n", for_ok)
    let struct_ok: i32 = test_parse_struct()
    printf("struct_ok=%d\n", struct_ok)
    let extern_ok: i32 = test_parse_extern()
    printf("extern_ok=%d\n", extern_ok)
    let ie_ok: i32 = test_parse_import_export()
    printf("import_export_ok=%d\n", ie_ok)
    let bare_ok: i32 = test_parse_export_bare()
    printf("export_bare_ok=%d\n", bare_ok)
    let fixture_ok: i32 = test_parse_fixture_file()
    printf("fixture_ok=%d\n", fixture_ok)
    let ty_ok: i32 = test_parse_ptr_array_types()
    printf("ptr_array_ok=%d\n", ty_ok)
    let fi_ok: i32 = test_parse_field_index()
    printf("field_index_ok=%d\n", fi_ok)
    let lit_ok: i32 = test_parse_struct_lit()
    printf("struct_lit_ok=%d\n", lit_ok)
    let bc_ok: i32 = test_parse_break_continue()
    printf("break_continue_ok=%d\n", bc_ok)
    let str_ok: i32 = test_parse_string_lit()
    printf("string_ok=%d\n", str_ok)
    let const_ok: i32 = test_parse_const()
    printf("const_ok=%d\n", const_ok)
    let cgen_ok: i32 = test_cgen_emit()
    printf("cgen_ok=%d\n", cgen_ok)
    let for_cgen_ok: i32 = test_cgen_for()
    printf("cgen_for_ok=%d\n", for_cgen_ok)
    let logic_ok: i32 = test_cgen_logic()
    printf("cgen_logic_ok=%d\n", logic_ok)
    let string_cgen_ok: i32 = test_cgen_string()
    printf("cgen_string_ok=%d\n", string_cgen_ok)
    let cgen_const_ok: i32 = test_cgen_const()
    printf("cgen_const_ok=%d\n", cgen_const_ok)
    let cgen_struct_ok: i32 = test_cgen_struct()
    printf("cgen_struct_ok=%d\n", cgen_struct_ok)
