# Stage-A resolve: `.token` → compiler/src/token.flow
function test_resolve_sibling() -> i32 {
    # `.token`
    let span: array<u8, 6> = [46, 116, 111, 107, 101, 110]
    let sp: ptr<u8> = span
    let out: ptr<u8> = malloc(256)
    if out == null {
        puts("resolve_sibling: malloc failed")
        return 0
    }
    let mut zi: i32 = 0
    while zi < 256 {
        out[zi] = 0
        zi = zi + 1
    }
    let mut n: i32 = flowc_resolve_sibling_path(sp, 0, 6, "compiler/src", out, 256)
    printf("resolve_sib_len=%d\n", n)
    let mut ok: i32 = 1
    if n <= 0 { ok = 0 }
    if flowc_bytes_contains(out, n, "compiler/src/token.flow") == 0 { ok = 0 }
    free(out)
    return ok
}

# Stage-A bundle typecheck: bundle_tc_ok → 0 errs.
# Bundle mode is lenient for cross-module calls, so we only check the ok case.
function test_bundle_typecheck() -> i32 {
    let ok_errs: i32 = flowc_bundle_typecheck(
        "compiler/fixtures/bundle_tc_ok.flow",
        "compiler/fixtures"
    )
    printf("bundle_tc_ok_errs=%d\n", ok_errs)
    let mut ok: i32 = 1
    if ok_errs != 0 { ok = 0 }
    return ok
}

# Stage-A bundle: fixtures/bundle_main + .bundle_lib → one C TU with twice/N/main.
function test_bundle_emit() -> i32 {
    let out_cap: i32 = 65536
    let out: ptr<u8> = malloc(out_cap as i64)
    if out == null {
        puts("bundle_emit: malloc failed")
        return 0
    }
    let mut zi: i32 = 0
    while zi < out_cap {
        out[zi] = 0
        zi = zi + 1
    }
    let mut n: i32 = flowc_bundle_emit(
        "compiler/fixtures/bundle_main.flow",
        "compiler/fixtures",
        out,
        out_cap
    )
    printf("bundle_bytes=%d\n", n)
    let mut ok: i32 = 1
    if n <= 0 { ok = 0 }
    if flowc_bytes_contains(out, n, "twice") == 0 { ok = 0 }
    if flowc_bytes_contains(out, n, "int32_t N") == 0 { ok = 0 }
    if flowc_bytes_contains(out, n, "main") == 0 { ok = 0 }
    if flowc_bytes_contains(out, n, "#include <stdint.h>") == 0 { ok = 0 }
    # Preamble once: second module uses flags&1 (no second stdint include after body).
    # Count occurrences of the include line — expect exactly one.
    let needle: string = "#include <stdint.h>"
    let np: ptr<u8> = needle
    let nlen: i32 = strlen(needle) as i32
    let mut count: i32 = 0
    let mut i: i32 = 0
    while i <= n - nlen {
        let mut j: i32 = 0
        let mut hit: i32 = 1
        while j < nlen {
            if out[i + j] != np[j] {
                hit = 0
                break
            }
            j = j + 1
        }
        if hit == 1 {
            count = count + 1
        }
        i = i + 1
    }
    printf("bundle_stdint_includes=%d\n", count)
    if count != 1 { ok = 0 }
    free(out)
    return ok
}

function test_fmt_emit() -> i32 {
    # Messy: function add(a:i32,b:i32)->i32{\nlet x:i32=a+b\nreturn x\n}\n
    let src: array<u8, 64> = [
        102, 117, 110, 99, 116, 105, 111, 110, 32, 97, 100, 100, 40, 97, 58, 105,
        51, 50, 44, 98, 58, 105, 51, 50, 41, 45, 62, 105, 51, 50, 123, 10,
        108, 101, 116, 32, 120, 58, 105, 51, 50, 61, 97, 43, 98, 10, 114, 101,
        116, 117, 114, 110, 32, 120, 10, 125, 10, 0, 0, 0, 0, 0, 0, 0
    ]
    let sp: ptr<u8> = src
    let mut len: i32 = 0
    while len < 64 and sp[len] != 0 {
        len = len + 1
    }
    let mut p: Parser = flowc_parser_new(sp, len, 256)
    let root: i32 = flowc_parse_program(&p)
    let mut ok: i32 = 1
    if root < 0 { ok = 0 }
    if p.err != 0 { ok = 0 }

    let cap: i32 = 1024
    let bp: ptr<u8> = malloc(cap as i64)
    if bp == null {
        puts("fmt_emit: malloc failed")
        flowc_parser_free(p)
        return 0
    }
    let mut zi: i32 = 0
    while zi < cap {
        bp[zi] = 0
        zi = zi + 1
    }

    let mut n: i32 = flowc_fmt_emit(p.arena, root, sp, bp, cap)
    printf("fmt_bytes=%d\n", n)
    if n <= 0 { ok = 0 }
    if flowc_bytes_contains(bp, n, "function") == 0 { ok = 0 }
    if flowc_bytes_contains(bp, n, "return") == 0 { ok = 0 }
    if flowc_bytes_contains(bp, n, "let") == 0 { ok = 0 }
    if flowc_bytes_contains(bp, n, " -> ") == 0 { ok = 0 }
    if flowc_bytes_contains(bp, n, "a + b") == 0 { ok = 0 }
    if flowc_bytes_contains(bp, n, "{") == 0 { ok = 0 }
    if flowc_bytes_contains(bp, n, "}") == 0 { ok = 0 }

    free(bp)
    flowc_parser_free(p)
    return ok
}

# Stage-A match: int-literal arm + binding catch-all → AST_MATCH / AST_MATCH_ARM.
function test_parse_match() -> i32 {
    # function f(v: i32) -> i32 {
    #   let mut r: i32 = 0
    #   match v {
    #     1 => {
    #       r = 10
    #     }
    #     n => {
    #       r = n + 1
    #     }
    #   }
    #   return r
    # }
    let src: array<u8, 144> = [
        102, 117, 110, 99, 116, 105, 111, 110, 32, 102, 40, 118, 58, 32, 105, 51,
        50, 41, 32, 45, 62, 32, 105, 51, 50, 32, 123, 10, 32, 32, 108, 101,
        116, 32, 109, 117, 116, 32, 114, 58, 32, 105, 51, 50, 32, 61, 32, 48,
        10, 32, 32, 109, 97, 116, 99, 104, 32, 118, 32, 123, 10, 32, 32, 32,
        32, 49, 32, 61, 62, 32, 123, 10, 32, 32, 32, 32, 32, 32, 114, 32,
        61, 32, 49, 48, 10, 32, 32, 32, 32, 125, 10, 32, 32, 32, 32, 110,
        32, 61, 62, 32, 123, 10, 32, 32, 32, 32, 32, 32, 114, 32, 61, 32,
        110, 32, 43, 32, 49, 10, 32, 32, 32, 32, 125, 10, 32, 32, 125, 10,
        32, 32, 114, 101, 116, 117, 114, 110, 32, 114, 10, 125, 10, 0, 0, 0
    ]
    let sp: ptr<u8> = src
    let mut len: i32 = 0
    while len < 144 and sp[len] != 0 {
        len = len + 1
    }
    let mut p: Parser = flowc_parser_new(sp, len, 256)
    let root: i32 = flowc_parse_program(&p)
    let mut ok: i32 = 1
    if root < 0 { ok = 0 }
    if p.err != 0 { ok = 0 }
    let n_match: i32 = flowc_ast_count_kind(p.arena, AST_MATCH)
    let n_arm: i32 = flowc_ast_count_kind(p.arena, AST_MATCH_ARM)
    printf("matches=%d\n", n_match)
    printf("match_arms=%d\n", n_arm)
    if n_match != 1 { ok = 0 }
    if n_arm != 2 { ok = 0 }
    # Typecheck: binding arm name resolves inside its block → 0 errs.
    let errs: i32 = flowc_typecheck(p.arena, root, sp)
    printf("match_tc_errs=%d\n", errs)
    if errs != 0 { ok = 0 }
    flowc_parser_free(p)
    return ok
}

# Stage-A match cgen: temp + if/else chain + binding decl in final else.
function test_cgen_match() -> i32 {
    # Same program as test_parse_match.
    let src: array<u8, 144> = [
        102, 117, 110, 99, 116, 105, 111, 110, 32, 102, 40, 118, 58, 32, 105, 51,
        50, 41, 32, 45, 62, 32, 105, 51, 50, 32, 123, 10, 32, 32, 108, 101,
        116, 32, 109, 117, 116, 32, 114, 58, 32, 105, 51, 50, 32, 61, 32, 48,
        10, 32, 32, 109, 97, 116, 99, 104, 32, 118, 32, 123, 10, 32, 32, 32,
        32, 49, 32, 61, 62, 32, 123, 10, 32, 32, 32, 32, 32, 32, 114, 32,
        61, 32, 49, 48, 10, 32, 32, 32, 32, 125, 10, 32, 32, 32, 32, 110,
        32, 61, 62, 32, 123, 10, 32, 32, 32, 32, 32, 32, 114, 32, 61, 32,
        110, 32, 43, 32, 49, 10, 32, 32, 32, 32, 125, 10, 32, 32, 125, 10,
        32, 32, 114, 101, 116, 117, 114, 110, 32, 114, 10, 125, 10, 0, 0, 0
    ]
    let sp: ptr<u8> = src
    let mut len: i32 = 0
    while len < 144 and sp[len] != 0 {
        len = len + 1
    }
    let mut p: Parser = flowc_parser_new(sp, len, 256)
    let root: i32 = flowc_parse_program(&p)
    let mut ok: i32 = 1
    if root < 0 { ok = 0 }
    if p.err != 0 { ok = 0 }
    let cap: i32 = 8192
    let bp: ptr<u8> = malloc(cap as i64)
    if bp == null {
        puts("cgen_match: malloc failed")
        flowc_parser_free(p)
        return 0
    }
    let mut zi: i32 = 0
    while zi < cap {
        bp[zi] = 0
        zi = zi + 1
    }
    let mut n: i32 = flowc_cgen_emit(p.arena, root, sp, bp, cap)
    printf("cgen_match_bytes=%d\n", n)
    if n <= 0 { ok = 0 }
    if flowc_bytes_contains(bp, n, "int32_t __flowc_match = v;") == 0 { ok = 0 }
    if flowc_bytes_contains(bp, n, "if (__flowc_match == 1) {") == 0 { ok = 0 }
    if flowc_bytes_contains(bp, n, "} else {") == 0 { ok = 0 }
    if flowc_bytes_contains(bp, n, "int32_t n = __flowc_match;") == 0 { ok = 0 }
    free(bp)
    flowc_parser_free(p)
    return ok
}

