# @module flowc.c_parser
# @means  Parse C header declarations for @cImport.
#
# Uses popen("cpp -P ...") to preprocess a C header, then parses the
# resulting declarations to extract function prototypes, opaque typedefs,
# and enum constants. The output is a list of CDecl records that the
# compiler can turn into Flow extern declarations.
#
# This is the Flow-native equivalent of src/flow/c_header_parser.py.

@cInclude("stdio.h")
@cInclude("stdlib.h")

# popen/pclose/fgets/malloc/free/strlen are provided by stdio.h/stdlib.h.
# We declare them here only for Flow type checking; c_generator skips
# emitting conflicting prototypes.
extern {
    function popen(cmd: ptr<u8>, mode: ptr<u8>) -> ptr<void>
    function pclose(fp: ptr<void>) -> i32
    function fgets(buf: ptr<u8>, n: i32, fp: ptr<void>) -> ptr<u8>
    function malloc(n: i32) -> ptr<u8>
    function free(p: ptr<u8>) -> void
    function strlen(s: ptr<u8>) -> i64
}

# A parsed C declaration.
# kind: 0 = function, 1 = opaque type, 2 = enum constant
# name: the identifier (function name, typedef name, or enum constant)
# ret_c: C return type string (for functions)
# params_c: C parameter string (for functions)
# value: integer value (for enum constants)
struct CDecl {
    kind: i32,
    name: ptr<u8>,
    name_len: i32,
    ret_c: ptr<u8>,
    ret_c_len: i32,
    params_c: ptr<u8>,
    params_c_len: i32,
    value: i64,
}

const FLOWC_CPARSER_MAX_DECLS: i32 = 4096
const FLOWC_CPARSER_BUF_SIZE: i32 = 1048576

# Read a preprocessed C header into a buffer using popen + cpp.
# Returns the buffer length, or 0 on failure.
export function flowc_cparser_preprocess(header: ptr<u8>, header_len: i32, out_buf: ptr<u8>, out_cap: i32) -> i32 {
    return flowc_cparser_preprocess_with_dirs(header, header_len, null as ptr<u8>, 0, out_buf, out_cap)
}

# Preprocess with include directories. include_dirs is a packed list of
# null-terminated directory paths, one after another. dirs_len is the
# total byte length. Each directory gets -I prefix in the cpp command.
export function flowc_cparser_preprocess_with_dirs(header: ptr<u8>, header_len: i32, include_dirs: ptr<u8>, dirs_len: i32, out_buf: ptr<u8>, out_cap: i32) -> i32 {
    # Build command: echo '#include <header>' | cpp -P -I dir1 -I dir2 -
    # On macOS, cpp (clang) can't take a header name directly, so we
    # pipe the include directive through cpp via echo.
    let cmd_buf: ptr<u8> = malloc(1024)
    if cmd_buf == null {
        return 0
    }
    let pos: i32 = 0

    # Build: echo '#include <header>' | cpp -P
    let prefix: string = "echo '#include <"
    let prefix_ptr: ptr<u8> = prefix as ptr<u8>
    let prefix_len: i32 = strlen(prefix_ptr) as i32
    let i: i32 = 0
    while i < prefix_len and pos < 1023 {
        cmd_buf[pos] = prefix_ptr[i]
        pos = pos + 1
        i = i + 1
    }
    i = 0
    while i < header_len and pos < 1023 {
        cmd_buf[pos] = header[i]
        pos = pos + 1
        i = i + 1
    }

    let suffix: string = ">' | cpp -P "
    let suffix_ptr: ptr<u8> = suffix as ptr<u8>
    let suffix_len: i32 = strlen(suffix_ptr) as i32
    i = 0
    while i < suffix_len and pos < 1023 {
        cmd_buf[pos] = suffix_ptr[i]
        pos = pos + 1
        i = i + 1
    }

    # Add -I for each include directory (no space between -I and path)
    let dir_pos: i32 = 0
    while dir_pos < dirs_len and pos < 1023 {
        # Write "-I"
        if pos + 2 >= 1023 { break }
        cmd_buf[pos] = 45  # -
        pos = pos + 1
        cmd_buf[pos] = 73  # I
        pos = pos + 1
        # Copy directory path until null (no space after -I)
        while dir_pos < dirs_len and include_dirs[dir_pos] != 0 and pos < 1023 {
            cmd_buf[pos] = include_dirs[dir_pos]
            pos = pos + 1
            dir_pos = dir_pos + 1
        }
        # Skip the null terminator
        if dir_pos < dirs_len and include_dirs[dir_pos] == 0 {
            dir_pos = dir_pos + 1
        }
        # Add space after directory
        if pos < 1023 {
            cmd_buf[pos] = 32  # space
            pos = pos + 1
        }
    }

    # Final "-" for stdin
    if pos < 1023 {
        cmd_buf[pos] = 45  # -
        pos = pos + 1
    }
    cmd_buf[pos] = 0

    let fp: ptr<void> = popen(cmd_buf, "r" as ptr<u8>)
    free(cmd_buf)
    if fp == null {
        return 0
    }

    let line_buf: ptr<u8> = malloc(4096)
    if line_buf == null {
        pclose(fp)
        return 0
    }

    let total: i32 = 0
    let got: ptr<u8> = fgets(line_buf, 4096, fp)
    while got != null and total < out_cap - 1 {
        let len: i32 = flowc_cparser_strlen(line_buf)
        if total + len >= out_cap {
            break
        }
        let j: i32 = 0
        while j < len {
            out_buf[total + j] = line_buf[j]
            j = j + 1
        }
        total = total + len
        got = fgets(line_buf, 4096, fp)
    }

    free(line_buf)
    pclose(fp)
    out_buf[total] = 0
    return total
}

# Parse preprocessed C text into declarations.
# Returns the number of declarations parsed.
export function flowc_cparser_parse(text: ptr<u8>, text_len: i32, decls: ptr<CDecl>, max_decls: i32) -> i32 {
    let n_decls: i32 = 0
    let pos: i32 = 0

    while pos < text_len and n_decls < max_decls {
        # Skip whitespace
        while pos < text_len and flowc_cparser_is_space(text[pos]) {
            pos = pos + 1
        }
        if pos >= text_len {
            break
        }

        # Read until semicolon at brace depth 0
        let chunk_start: i32 = pos
        let depth: i32 = 0
        while pos < text_len {
            let ch: u8 = text[pos]
            if ch == 123 {  # {
                depth = depth + 1
            } elif ch == 125 {  # }
                depth = depth - 1
                if depth == 0 {
                    pos = pos + 1
                    # Check for trailing semicolon
                    if pos < text_len and text[pos] == 59 {
                        pos = pos + 1
                    }
                    break
                }
            } elif ch == 59 and depth == 0 {  # ;
                break
            }
            pos = pos + 1
        }
        if pos < text_len and text[pos] == 59 {
            pos = pos + 1
        }

        let chunk_len: i32 = pos - chunk_start
        if chunk_len <= 0 {
            continue
        }

        # Try to parse the chunk
        let n: i32 = flowc_cparser_parse_chunk(text, chunk_start, chunk_len, decls, n_decls, max_decls)
        n_decls = n_decls + n
    }

    return n_decls
}

# Parse a single top-level declaration chunk.
# Returns the number of declarations added (0, 1, or more for enums).
function flowc_cparser_parse_chunk(text: ptr<u8>, start: i32, len: i32, decls: ptr<CDecl>, n_decls: i32, max_decls: i32) -> i32 {
    if len <= 0 {
        return 0
    }

    # Skip leading whitespace
    let pos: i32 = start
    let end: i32 = start + len
    while pos < end and flowc_cparser_is_space(text[pos]) {
        pos = pos + 1
    }
    if pos >= end {
        return 0
    }

    # Check for "typedef"
    if flowc_cparser_starts_with(text, pos, end, "typedef") {
        return flowc_cparser_parse_typedef(text, pos, end, decls, n_decls, max_decls)
    }

    # Check for "extern"
    if flowc_cparser_starts_with(text, pos, end, "extern") {
        return 0  # Skip extern blocks
    }

    # Check for "static inline" or "__inline"
    if flowc_cparser_starts_with(text, pos, end, "static") {
        if flowc_cparser_contains(text, pos, end, "inline") or flowc_cparser_contains(text, pos, end, "__inline") {
            return 0  # Skip static inline functions
        }
    }
    if flowc_cparser_starts_with(text, pos, end, "__inline") {
        return 0
    }

    # Check for struct/union/enum
    if flowc_cparser_starts_with(text, pos, end, "struct") or flowc_cparser_starts_with(text, pos, end, "union") {
        return flowc_cparser_parse_struct(text, pos, end, decls, n_decls, max_decls)
    }
    if flowc_cparser_starts_with(text, pos, end, "enum") {
        return flowc_cparser_parse_enum(text, pos, end, decls, n_decls, max_decls)
    }

    # Skip chunks with braces (function definitions)
    if flowc_cparser_contains(text, pos, end, "{") {
        return 0
    }

    # Try to parse as a function declaration
    return flowc_cparser_parse_function(text, pos, end, decls, n_decls, max_decls)
}

# Parse a typedef declaration.
function flowc_cparser_parse_typedef(text: ptr<u8>, start: i32, end: i32, decls: ptr<CDecl>, n_decls: i32, max_decls: i32) -> i32 {
    # Skip "typedef"
    let pos: i32 = start + 7
    while pos < end and flowc_cparser_is_space(text[pos]) {
        pos = pos + 1
    }

    # typedef struct Name Name;  -> opaque type
    if flowc_cparser_starts_with(text, pos, end, "struct") or flowc_cparser_starts_with(text, pos, end, "union") {
        # Skip "struct"/"union"
        pos = pos + 6
        while pos < end and flowc_cparser_is_space(text[pos]) {
            pos = pos + 1
        }
        # Check for { (struct with body) or Name;
        if pos < end and text[pos] == 123 {  # {
            # typedef struct { ... } Name;  -> find the name after }
            while pos < end and text[pos] != 125 {  # }
                pos = pos + 1
            }
            if pos < end {
                pos = pos + 1  # skip }
                while pos < end and flowc_cparser_is_space(text[pos]) {
                    pos = pos + 1
                }
                # Read the name
                let name_start: i32 = pos
                while pos < end and flowc_cparser_is_ident_char(text[pos]) {
                    pos = pos + 1
                }
                let name_len: i32 = pos - name_start
                if name_len > 0 and n_decls < max_decls {
                    decls[n_decls].kind = 1
                    decls[n_decls].name = text + name_start
                    decls[n_decls].name_len = name_len
                    return 1
                }
            }
            return 0
        } else {
            # typedef struct Name Name;  -> read both names
            let name1_start: i32 = pos
            while pos < end and flowc_cparser_is_ident_char(text[pos]) {
                pos = pos + 1
            }
            let name1_len: i32 = pos - name1_start
            while pos < end and flowc_cparser_is_space(text[pos]) {
                pos = pos + 1
            }
            let name2_start: i32 = pos
            while pos < end and flowc_cparser_is_ident_char(text[pos]) {
                pos = pos + 1
            }
            let name2_len: i32 = pos - name2_start
            if name2_len > 0 and n_decls < max_decls {
                decls[n_decls].kind = 1
                decls[n_decls].name = text + name2_start
                decls[n_decls].name_len = name2_len
                return 1
            }
            return 0
        }
    }

    # typedef enum { ... } Name;  -> parse enum constants
    if flowc_cparser_starts_with(text, pos, end, "enum") {
        # Skip "enum"
        pos = pos + 4
        while pos < end and flowc_cparser_is_space(text[pos]) {
            pos = pos + 1
        }
        # Skip optional enum tag
        if pos < end and flowc_cparser_is_ident_char(text[pos]) {
            while pos < end and flowc_cparser_is_ident_char(text[pos]) {
                pos = pos + 1
            }
            while pos < end and flowc_cparser_is_space(text[pos]) {
                pos = pos + 1
            }
        }
        # Expect {
        if pos < end and text[pos] == 123 {
            return flowc_cparser_parse_enum_body(text, pos, end, decls, n_decls, max_decls)
        }
    }

    # Other typedefs: skip (C header provides them)
    return 0
}

# Parse struct/union forward declaration or definition.
function flowc_cparser_parse_struct(text: ptr<u8>, start: i32, end: i32, decls: ptr<CDecl>, n_decls: i32, max_decls: i32) -> i32 {
    # Skip "struct"/"union"
    let pos: i32 = start + 6
    while pos < end and flowc_cparser_is_space(text[pos]) {
        pos = pos + 1
    }
    # Read the struct name
    let name_start: i32 = pos
    while pos < end and flowc_cparser_is_ident_char(text[pos]) {
        pos = pos + 1
    }
    let name_len: i32 = pos - name_start
    if name_len <= 0 {
        return 0
    }
    # Check if it's a forward declaration (struct Name;) or definition (struct Name { ... })
    while pos < end and flowc_cparser_is_space(text[pos]) {
        pos = pos + 1
    }
    if pos < end and text[pos] == 123 {
        # struct Name { ... };  -> the C header provides the layout, skip
        return 0
    }
    # struct Name;  -> forward declaration, register as opaque type
    if n_decls < max_decls {
        decls[n_decls].kind = 1
        decls[n_decls].name = text + name_start
        decls[n_decls].name_len = name_len
        return 1
    }
    return 0
}

# Parse enum definition.
function flowc_cparser_parse_enum(text: ptr<u8>, start: i32, end: i32, decls: ptr<CDecl>, n_decls: i32, max_decls: i32) -> i32 {
    # Skip "enum"
    let pos: i32 = start + 4
    while pos < end and flowc_cparser_is_space(text[pos]) {
        pos = pos + 1
    }
    # Skip optional enum tag
    if pos < end and flowc_cparser_is_ident_char(text[pos]) {
        while pos < end and flowc_cparser_is_ident_char(text[pos]) {
            pos = pos + 1
        }
        while pos < end and flowc_cparser_is_space(text[pos]) {
            pos = pos + 1
        }
    }
    # Expect {
    if pos < end and text[pos] == 123 {
        return flowc_cparser_parse_enum_body(text, pos, end, decls, n_decls, max_decls)
    }
    return 0
}

# Parse the body of an enum { NAME, NAME = value, ... }
function flowc_cparser_parse_enum_body(text: ptr<u8>, brace_pos: i32, end: i32, decls: ptr<CDecl>, n_decls: i32, max_decls: i32) -> i32 {
    let pos: i32 = brace_pos + 1  # skip {
    let count: i32 = 0
    let auto_val: i64 = 0

    while pos < end and n_decls + count < max_decls {
        # Skip whitespace
        while pos < end and flowc_cparser_is_space(text[pos]) {
            pos = pos + 1
        }
        if pos >= end or text[pos] == 125 {  # }
            break
        }

        # Read the name
        let name_start: i32 = pos
        while pos < end and flowc_cparser_is_ident_char(text[pos]) {
            pos = pos + 1
        }
        let name_len: i32 = pos - name_start
        if name_len <= 0 {
            # Skip to next comma or }
            while pos < end and text[pos] != 44 and text[pos] != 125 {
                pos = pos + 1
            }
            if pos < end and text[pos] == 44 {
                pos = pos + 1
            }
            continue
        }

        # Check for = value
        while pos < end and flowc_cparser_is_space(text[pos]) {
            pos = pos + 1
        }
        let val: i64 = auto_val
        if pos < end and text[pos] == 61 {  # =
            pos = pos + 1
            while pos < end and flowc_cparser_is_space(text[pos]) {
                pos = pos + 1
            }
            # Try to parse an integer
            let val_start: i32 = pos
            if pos < end and text[pos] == 48 and pos + 1 < end and (text[pos + 1] == 120 or text[pos + 1] == 88) {
                # Hex: 0x...
                pos = pos + 2
                while pos < end and flowc_cparser_is_hex_char(text[pos]) {
                    pos = pos + 1
                }
                val = flowc_cparser_parse_hex(text + val_start, pos - val_start)
            } else {
                # Decimal
                while pos < end and flowc_cparser_is_digit(text[pos]) {
                    pos = pos + 1
                }
                # Remove suffixes (u, l, etc.)
                val = flowc_cparser_parse_decimal(text + val_start, pos - val_start)
            }
            auto_val = val + 1
        } else {
            auto_val = auto_val + 1
        }

        # Register the enum constant
        decls[n_decls + count].kind = 2
        decls[n_decls + count].name = text + name_start
        decls[n_decls + count].name_len = name_len
        decls[n_decls + count].value = val
        count = count + 1

        # Skip to next comma or }
        while pos < end and text[pos] != 44 and text[pos] != 125 {
            pos = pos + 1
        }
        if pos < end and text[pos] == 44 {
            pos = pos + 1
        }
    }

    return count
}

# Parse a function declaration: ret_type name(params)
function flowc_cparser_parse_function(text: ptr<u8>, start: i32, end: i32, decls: ptr<CDecl>, n_decls: i32, max_decls: i32) -> i32 {
    if n_decls >= max_decls {
        return 0
    }

    # Find the first opening paren
    let paren_pos: i32 = flowc_cparser_find_char(text, start, end, 40)  # (
    if paren_pos < 0 {
        return 0
    }

    # Find the matching close paren
    let depth: i32 = 1
    let pos: i32 = paren_pos + 1
    while pos < end and depth > 0 {
        if text[pos] == 40 {
            depth = depth + 1
        } elif text[pos] == 41 {
            depth = depth - 1
        }
        pos = pos + 1
    }
    if depth != 0 {
        return 0
    }
    let close_paren: i32 = pos - 1

    # Split before_paren into return type and function name
    # The function name is the last identifier before (
    let name_end: i32 = paren_pos
    while name_end > start and flowc_cparser_is_space(text[name_end - 1]) {
        name_end = name_end - 1
    }
    let name_start: i32 = name_end
    while name_start > start and flowc_cparser_is_ident_char(text[name_start - 1]) {
        name_start = name_start - 1
    }
    let fn_name_len: i32 = name_end - name_start
    if fn_name_len <= 0 {
        return 0
    }

    # Skip double-underscore names
    if fn_name_len >= 2 and text[name_start] == 95 and text[name_start + 1] == 95 {
        return 0
    }

    # Skip if function name is a C keyword or preprocessor macro
    if flowc_cparser_is_c_keyword(text, name_start, name_end) == 1 {
        return 0
    }

    # Skip if function name starts with uppercase (likely macro expansion)
    # Real C library functions are lowercase (sqrt, abs, strlen, etc.)
    let first_ch: u8 = text[name_start]
    if first_ch >= 65 and first_ch <= 90 {
        return 0
    }

    # Return type is everything before the function name
    let ret_end: i32 = name_start
    while ret_end > start and flowc_cparser_is_space(text[ret_end - 1]) {
        ret_end = ret_end - 1
    }

    # Skip if return type is empty (macro expansion with no type)
    if ret_end <= start {
        return 0
    }

    # Skip if return type contains "defined" (preprocessor artifact)
    if flowc_cparser_span_contains(text, start, ret_end, "defined") == 1 {
        return 0
    }

    decls[n_decls].kind = 0
    decls[n_decls].name = text + name_start
    decls[n_decls].name_len = fn_name_len
    decls[n_decls].ret_c = text + start
    decls[n_decls].ret_c_len = ret_end - start
    decls[n_decls].params_c = text + paren_pos + 1
    decls[n_decls].params_c_len = close_paren - paren_pos - 1
    return 1
}

# --- Helper functions ---

function flowc_cparser_is_space(ch: u8) -> i32 {
    if ch == 32 or ch == 9 or ch == 10 or ch == 13 {
        return 1
    }
    return 0
}

function flowc_cparser_is_ident_char(ch: u8) -> i32 {
    if (ch >= 97 and ch <= 122) or (ch >= 65 and ch <= 90) or ch == 95 or (ch >= 48 and ch <= 57) {
        return 1
    }
    return 0
}

function flowc_cparser_is_digit(ch: u8) -> i32 {
    if ch >= 48 and ch <= 57 {
        return 1
    }
    return 0
}

function flowc_cparser_is_hex_char(ch: u8) -> i32 {
    if (ch >= 48 and ch <= 57) or (ch >= 97 and ch <= 102) or (ch >= 65 and ch <= 70) {
        return 1
    }
    return 0
}

function flowc_cparser_starts_with(text: ptr<u8>, start: i32, end: i32, lit: string) -> i32 {
    let lit_ptr: ptr<u8> = lit as ptr<u8>
    let lit_len: i32 = strlen(lit_ptr) as i32
    if start + lit_len > end {
        return 0
    }
    let i: i32 = 0
    while i < lit_len {
        if text[start + i] != lit_ptr[i] {
            return 0
        }
        i = i + 1
    }
    # Check that the next char is a space or end (word boundary)
    if start + lit_len < end and flowc_cparser_is_ident_char(text[start + lit_len]) {
        return 0
    }
    return 1
}

function flowc_cparser_contains(text: ptr<u8>, start: i32, end: i32, lit: string) -> i32 {
    let lit_ptr: ptr<u8> = lit as ptr<u8>
    let lit_len: i32 = strlen(lit_ptr) as i32
    let i: i32 = start
    while i + lit_len <= end {
        let j: i32 = 0
        let is_match: i32 = 1
        while j < lit_len {
            if text[i + j] != lit_ptr[j] {
                is_match = 0
                break
            }
            j = j + 1
        }
        if is_match == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

function flowc_cparser_find_char(text: ptr<u8>, start: i32, end: i32, ch: u8) -> i32 {
    let i: i32 = start
    while i < end {
        if text[i] == ch {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

# Check if a span is a C keyword that should not be a function name.
function flowc_cparser_is_c_keyword(text: ptr<u8>, start: i32, end: i32) -> i32 {
    if flowc_cparser_span_eq(text, start, end, "void") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "int") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "char") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "long") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "short") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "float") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "double") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "unsigned") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "signed") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "const") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "volatile") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "struct") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "union") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "enum") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "typedef") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "static") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "extern") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "inline") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "auto") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "register") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "return") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "if") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "else") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "while") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "for") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "do") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "switch") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "case") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "break") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "continue") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "default") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "sizeof") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "defined") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "goto") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "restrict") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "_Bool") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "bool") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "_Complex") { return 1 }
    if flowc_cparser_span_eq(text, start, end, "_Imaginary") { return 1 }
    return 0
}

# Check if a span contains a substring.
function flowc_cparser_span_contains(text: ptr<u8>, start: i32, end: i32, lit: string) -> i32 {
    let lit_ptr: ptr<u8> = lit as ptr<u8>
    let lit_len: i32 = strlen(lit_ptr) as i32
    if lit_len <= 0 or end - start < lit_len {
        return 0
    }
    let i: i32 = start
    while i + lit_len <= end {
        let is_match: i32 = 1
        let j: i32 = 0
        while j < lit_len {
            if text[i + j] != lit_ptr[j] {
                is_match = 0
                break
            }
            j = j + 1
        }
        if is_match == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

function flowc_cparser_strlen(s: ptr<u8>) -> i32 {
    let n: i32 = 0
    while s[n] != 0 {
        n = n + 1
    }
    return n
}

function flowc_cparser_parse_hex(s: ptr<u8>, len: i32) -> i64 {
    # Skip 0x prefix
    let pos: i32 = 2
    let val: i64 = 0
    while pos < len {
        let ch: u8 = s[pos]
        let digit: i64 = 0
        if ch >= 48 and ch <= 57 {
            digit = ch as i64 - 48
        } elif ch >= 97 and ch <= 102 {
            digit = ch as i64 - 87
        } elif ch >= 65 and ch <= 70 {
            digit = ch as i64 - 55
        }
        val = val * 16 + digit
        pos = pos + 1
    }
    return val
}

function flowc_cparser_parse_decimal(s: ptr<u8>, len: i32) -> i64 {
    let val: i64 = 0
    let pos: i32 = 0
    while pos < len and s[pos] >= 48 and s[pos] <= 57 {
        val = val * 10 + (s[pos] as i64 - 48)
        pos = pos + 1
    }
    return val
}

# Convert a C type span to a Flow type string written into out_buf.
# Returns the length written, or 0 on failure.
# Handles: int, unsigned int, long, float, double, char, void, size_t,
# int32_t, uint32_t, etc. Pointers (* suffix) become ptr<T>.
export function flowc_cparser_c_type_to_flow(text: ptr<u8>, start: i32, end: i32, out_buf: ptr<u8>, out_cap: i32) -> i32 {
    let pos: i32 = start
    let out_pos: i32 = 0

    # Strip leading whitespace
    while pos < end and flowc_cparser_is_space(text[pos]) {
        pos = pos + 1
    }

    # Strip const/volatile/restrict qualifiers
    let stripped: i32 = 1
    while stripped == 1 {
        stripped = 0
        if flowc_cparser_starts_with(text, pos, end, "const") == 1 {
            pos = pos + 5
            stripped = 1
        } elif flowc_cparser_starts_with(text, pos, end, "volatile") == 1 {
            pos = pos + 8
            stripped = 1
        } elif flowc_cparser_starts_with(text, pos, end, "restrict") == 1 {
            pos = pos + 8
            stripped = 1
        } elif flowc_cparser_starts_with(text, pos, end, "__restrict") == 1 {
            pos = pos + 9
            stripped = 1
        }
        while pos < end and flowc_cparser_is_space(text[pos]) {
            pos = pos + 1
        }
    }

    # Count trailing * for pointer depth
    let ptr_count: i32 = 0
    let type_end: i32 = end
    while type_end > pos and text[type_end - 1] == 42 {  # *
        ptr_count = ptr_count + 1
        type_end = type_end - 1
        while type_end > pos and flowc_cparser_is_space(text[type_end - 1]) {
            type_end = type_end - 1
        }
    }

    # Map base C type to Flow type
    let flow_type: string = flowc_cparser_map_base_type(text, pos, type_end)
    let ft_ptr: ptr<u8> = flow_type as ptr<u8>
    let ft_len: i32 = strlen(ft_ptr) as i32

    # Write the base type
    let i: i32 = 0
    while i < ft_len and out_pos < out_cap - 1 {
        out_buf[out_pos] = ft_ptr[i]
        out_pos = out_pos + 1
        i = i + 1
    }

    # Wrap in ptr<...> for each pointer level
    let p: i32 = 0
    while p < ptr_count {
        if out_pos + 5 >= out_cap {
            return 0
        }
        # Shift existing content right by 4 bytes to make room for "ptr<"
        let j: i32 = out_pos
        while j > 0 {
            out_buf[j + 3] = out_buf[j - 1]
            j = j - 1
        }
        # Write "ptr<" at the beginning
        out_buf[0] = 112  # p
        out_buf[1] = 116  # t
        out_buf[2] = 114  # r
        out_buf[3] = 60   # <
        out_pos = out_pos + 4
        # Write ">" at the end
        out_buf[out_pos] = 62  # >
        out_pos = out_pos + 1
        p = p + 1
    }

    out_buf[out_pos] = 0
    return out_pos
}

# Map a base C type (without qualifiers or pointers) to a Flow type string.
function flowc_cparser_map_base_type(text: ptr<u8>, start: i32, end: i32) -> string {
    # Check each known C type by comparing the span
    if flowc_cparser_span_eq(text, start, end, "int") { return "i32" }
    if flowc_cparser_span_eq(text, start, end, "unsigned int") { return "u32" }
    if flowc_cparser_span_eq(text, start, end, "unsigned") { return "u32" }
    if flowc_cparser_span_eq(text, start, end, "long") { return "i64" }
    if flowc_cparser_span_eq(text, start, end, "unsigned long") { return "u64" }
    if flowc_cparser_span_eq(text, start, end, "long long") { return "i64" }
    if flowc_cparser_span_eq(text, start, end, "unsigned long long") { return "u64" }
    if flowc_cparser_span_eq(text, start, end, "short") { return "i16" }
    if flowc_cparser_span_eq(text, start, end, "unsigned short") { return "u16" }
    if flowc_cparser_span_eq(text, start, end, "char") { return "u8" }
    if flowc_cparser_span_eq(text, start, end, "unsigned char") { return "u8" }
    if flowc_cparser_span_eq(text, start, end, "signed char") { return "i8" }
    if flowc_cparser_span_eq(text, start, end, "float") { return "f32" }
    if flowc_cparser_span_eq(text, start, end, "double") { return "f64" }
    if flowc_cparser_span_eq(text, start, end, "long double") { return "f64" }
    if flowc_cparser_span_eq(text, start, end, "void") { return "void" }
    if flowc_cparser_span_eq(text, start, end, "size_t") { return "u64" }
    if flowc_cparser_span_eq(text, start, end, "ssize_t") { return "i64" }
    if flowc_cparser_span_eq(text, start, end, "ptrdiff_t") { return "i64" }
    if flowc_cparser_span_eq(text, start, end, "intptr_t") { return "i64" }
    if flowc_cparser_span_eq(text, start, end, "uintptr_t") { return "u64" }
    if flowc_cparser_span_eq(text, start, end, "int8_t") { return "i8" }
    if flowc_cparser_span_eq(text, start, end, "uint8_t") { return "u8" }
    if flowc_cparser_span_eq(text, start, end, "int16_t") { return "i16" }
    if flowc_cparser_span_eq(text, start, end, "uint16_t") { return "u16" }
    if flowc_cparser_span_eq(text, start, end, "int32_t") { return "i32" }
    if flowc_cparser_span_eq(text, start, end, "uint32_t") { return "u32" }
    if flowc_cparser_span_eq(text, start, end, "int64_t") { return "i64" }
    if flowc_cparser_span_eq(text, start, end, "uint64_t") { return "u64" }
    if flowc_cparser_span_eq(text, start, end, "bool") { return "bool" }
    if flowc_cparser_span_eq(text, start, end, "_Bool") { return "bool" }
    # Unknown type: return as-is (opaque type name)
    # For now, return "void" as a safe fallback
    return "void"
}

# Check if a span equals a literal string.
function flowc_cparser_span_eq(text: ptr<u8>, start: i32, end: i32, lit: string) -> i32 {
    let lit_ptr: ptr<u8> = lit as ptr<u8>
    let lit_len: i32 = strlen(lit_ptr) as i32
    if end - start != lit_len {
        return 0
    }
    let i: i32 = 0
    while i < lit_len {
        if text[start + i] != lit_ptr[i] {
            return 0
        }
        i = i + 1
    }
    return 1
}

# Generate Flow extern declarations from parsed CDecls.
# Writes "function name(params) -> ret_type\n" for each function decl.
# Returns total bytes written, or 0 on failure.
export function flowc_cparser_gen_externs(decls: ptr<CDecl>, n_decls: i32, out_buf: ptr<u8>, out_cap: i32) -> i32 {
    let out_pos: i32 = 0
    let type_buf: ptr<u8> = malloc(256)
    if type_buf == null {
        return 0
    }

    let i: i32 = 0
    while i < n_decls {
        if decls[i].kind == 0 {
            # Function declaration
            let name: ptr<u8> = decls[i].name
            let name_len: i32 = decls[i].name_len

            # Write "function "
            let prefix: string = "function "
            let prefix_ptr: ptr<u8> = prefix as ptr<u8>
            let prefix_len: i32 = strlen(prefix_ptr) as i32
            let k: i32 = 0
            while k < prefix_len and out_pos < out_cap - 1 {
                out_buf[out_pos] = prefix_ptr[k]
                out_pos = out_pos + 1
                k = k + 1
            }

            # Write function name
            let k2: i32 = 0
            while k2 < name_len and out_pos < out_cap - 1 {
                out_buf[out_pos] = name[k2]
                out_pos = out_pos + 1
                k2 = k2 + 1
            }

            # Write "("
            if out_pos >= out_cap - 1 { free(type_buf); return 0 }
            out_buf[out_pos] = 40  # (
            out_pos = out_pos + 1

            # Parse and write parameters
            out_pos = flowc_cparser_gen_params(decls[i].params_c, decls[i].params_c_len, out_buf, out_pos, out_cap, type_buf)

            # Write ") -> "
            if out_pos + 5 >= out_cap { free(type_buf); return 0 }
            out_buf[out_pos] = 41  # )
            out_pos = out_pos + 1
            out_buf[out_pos] = 32  # space
            out_pos = out_pos + 1
            out_buf[out_pos] = 45  # -
            out_pos = out_pos + 1
            out_buf[out_pos] = 62  # >
            out_pos = out_pos + 1
            out_buf[out_pos] = 32  # space
            out_pos = out_pos + 1

            # Convert and write return type
            let ret_len: i32 = flowc_cparser_c_type_to_flow(decls[i].ret_c, 0, decls[i].ret_c_len, type_buf, 256)
            if ret_len <= 0 {
                # Fallback: write "i32"
                out_buf[out_pos] = 105  # i
                out_pos = out_pos + 1
                out_buf[out_pos] = 51   # 3
                out_pos = out_pos + 1
                out_buf[out_pos] = 50   # 2
                out_pos = out_pos + 1
            } else {
                let k3: i32 = 0
                while k3 < ret_len and out_pos < out_cap - 1 {
                    out_buf[out_pos] = type_buf[k3]
                    out_pos = out_pos + 1
                    k3 = k3 + 1
                }
            }

            # Write newline
            if out_pos >= out_cap - 1 { free(type_buf); return 0 }
            out_buf[out_pos] = 10  # \n
            out_pos = out_pos + 1
        }
        i = i + 1
    }

    out_buf[out_pos] = 0
    free(type_buf)
    return out_pos
}

# Parse C function parameters and write Flow parameter declarations.
# C params like "int x, const char* y, double" become "x: i32, y: ptr<u8>, _: f64"
function flowc_cparser_gen_params(params: ptr<u8>, params_len: i32, out_buf: ptr<u8>, out_pos: i32, out_cap: i32, type_buf: ptr<u8>) -> i32 {
    if params_len <= 0 {
        return out_pos
    }

    let pos: i32 = 0
    let first: i32 = 1
    let param_idx: i32 = 0

    while pos < params_len {
        # Skip leading whitespace and commas
        while pos < params_len and (flowc_cparser_is_space(params[pos]) == 1 or params[pos] == 44) {
            pos = pos + 1
        }
        if pos >= params_len {
            break
        }

        # Find end of this parameter (next comma at depth 0)
        let param_start: i32 = pos
        let depth: i32 = 0
        while pos < params_len {
            if params[pos] == 40 {  # (
                depth = depth + 1
            } elif params[pos] == 41 {  # )
                depth = depth - 1
            } elif params[pos] == 44 and depth == 0 {  # ,
                break
            }
            pos = pos + 1
        }
        let param_end: i32 = pos

        # Trim trailing whitespace
        while param_end > param_start and flowc_cparser_is_space(params[param_end - 1]) == 1 {
            param_end = param_end - 1
        }

        if param_end > param_start {
            # Write comma separator
            if first == 0 {
                if out_pos + 2 >= out_cap { return out_pos }
                out_buf[out_pos] = 44  # ,
                out_pos = out_pos + 1
                out_buf[out_pos] = 32  # space
                out_pos = out_pos + 1
            }
            first = 0

            # Try to find parameter name (last identifier in the param)
            let name_end2: i32 = param_end
            while name_end2 > param_start and flowc_cparser_is_ident_char(params[name_end2 - 1]) == 0 {
                name_end2 = name_end2 - 1
            }
            let name_start2: i32 = name_end2
            while name_start2 > param_start and flowc_cparser_is_ident_char(params[name_start2 - 1]) == 1 {
                name_start2 = name_start2 - 1
            }

            # Check if the "name" is actually a type keyword (like "int", "char")
            # If so, there's no parameter name, use "_<idx>"
            let has_name: i32 = 0
            if name_end2 > name_start2 {
                # Check if the part before the name is a valid type
                let before_name: i32 = name_start2
                while before_name > param_start and flowc_cparser_is_space(params[before_name - 1]) == 1 {
                    before_name = before_name - 1
                }
                if before_name > param_start {
                    has_name = 1
                }
            }

            if has_name == 1 {
                # Write param name
                let k4: i32 = name_start2
                while k4 < name_end2 and out_pos < out_cap - 1 {
                    out_buf[out_pos] = params[k4]
                    out_pos = out_pos + 1
                    k4 = k4 + 1
                }
            } else {
                # No param name, write "_<idx>"
                if out_pos + 4 >= out_cap { return out_pos }
                out_buf[out_pos] = 95  # _
                out_pos = out_pos + 1
                # Write the index as digits
                let idx_str: string = ""
                # Simple int-to-string for small numbers
                let idx_val: i32 = param_idx
                if idx_val == 0 {
                    out_buf[out_pos] = 48  # 0
                    out_pos = out_pos + 1
                } else {
                    # Write digits in reverse
                    let digits: ptr<u8> = malloc(16)
                    let dlen: i32 = 0
                    while idx_val > 0 {
                        digits[dlen] = 48 + (idx_val % 10)
                        dlen = dlen + 1
                        idx_val = idx_val / 10
                    }
                    let d: i32 = dlen - 1
                    while d >= 0 and out_pos < out_cap - 1 {
                        out_buf[out_pos] = digits[d]
                        out_pos = out_pos + 1
                        d = d - 1
                    }
                    free(digits)
                }
            }

            # Write ": "
            if out_pos + 2 >= out_cap { return out_pos }
            out_buf[out_pos] = 58  # :
            out_pos = out_pos + 1
            out_buf[out_pos] = 32  # space
            out_pos = out_pos + 1

            # Convert and write the type
            # The type is the whole param if no name, or everything before the name
            let type_start: i32 = param_start
            let type_end2: i32 = param_end
            if has_name == 1 {
                type_end2 = name_start2
                while type_end2 > type_start and flowc_cparser_is_space(params[type_end2 - 1]) == 1 {
                    type_end2 = type_end2 - 1
                }
            }

            let pt_len: i32 = flowc_cparser_c_type_to_flow(params, type_start, type_end2, type_buf, 256)
            if pt_len <= 0 {
                # Fallback: write "ptr<void>"
                let fallback: string = "ptr<void>"
                let fb_ptr: ptr<u8> = fallback as ptr<u8>
                let fb_len: i32 = strlen(fb_ptr) as i32
                let k5: i32 = 0
                while k5 < fb_len and out_pos < out_cap - 1 {
                    out_buf[out_pos] = fb_ptr[k5]
                    out_pos = out_pos + 1
                    k5 = k5 + 1
                }
            } else {
                let k6: i32 = 0
                while k6 < pt_len and out_pos < out_cap - 1 {
                    out_buf[out_pos] = type_buf[k6]
                    out_pos = out_pos + 1
                    k6 = k6 + 1
                }
            }

            param_idx = param_idx + 1
        }
    }

    return out_pos
}
