# @module flowc.pkg_main
import .pkg { flowc_pkg_init, flowc_pkg_install, flowc_pkg_build, flowc_pkg_dispatch_fallback }
extern {
    function strcmp(a: string, b: string) -> i32
    function puts(s: string) -> i32
}
function main(argc: i32, argv: ptr<ptr<u8>>) -> i32 {
    if argc < 2 { return 1 }
    let cmd: string = argv[1] as string
    if strcmp(cmd, "init") == 0 {
        let mut name: string = ""
        if argc >= 3 {
            name = argv[2] as string
        }
        return flowc_pkg_init(name)
    }
    if strcmp(cmd, "install") == 0 { return flowc_pkg_install() }
    if strcmp(cmd, "build") == 0 { return flowc_pkg_build() }
    return flowc_pkg_dispatch_fallback(argc, argv)
}
