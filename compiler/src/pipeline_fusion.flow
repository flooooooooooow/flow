# @module flowc.pipeline_fusion
# @means  Compile-time fusion of adjacent map stages in |> pipelines.
#         Port of the python implementation in src/flow/pipeline_fusion.py.
#         Implements scale_f32(scale_f32(buf, n, a), n, b) -> scale_f32(buf, n, a*b)

import .ast { AstArena, AstNode, AST_CALL, AST_BINOP, AST_FLOAT, AST_IDENT, AST_NONE, AST_EXPR_STMT, AST_LET, AST_ASSIGN, AST_RETURN, flowc_ast_alloc }

extern {
    function printf(fmt: string, ...) -> i32
    function puts(s: string) -> i32
}

function flowc_name_is(src: ptr<u8>, start: i32, end: i32, name: string) -> i32 {
    let want: i32 = strlen(name) as i32
    if end - start != want { return 0 }
    let p: ptr<u8> = name as ptr<u8>
    let mut i: i32 = 0
    while i < want {
        if src[start + i] != p[i] { return 0 }
        i = i + 1
    }
    return 1
}

# 1 = scale_f32, 2 = scale_f64, 3 = offset_f32, 4 = offset_f64.
function flowc_stage_family(src: ptr<u8>, node: AstNode) -> i32 {
    if node.kind != AST_CALL { return 0 }
    if flowc_name_is(src, node.name_start, node.name_end, "scale_f32") == 1 { return 1 }
    if flowc_name_is(src, node.name_start, node.name_end, "scale_f64") == 1 { return 2 }
    if flowc_name_is(src, node.name_start, node.name_end, "offset_f32") == 1 { return 3 }
    if flowc_name_is(src, node.name_start, node.name_end, "offset_f64") == 1 { return 4 }
    return 0
}

function flowc_text_equal(src: ptr<u8>, a_start: i32, a_end: i32, b_start: i32, b_end: i32) -> i32 {
    if a_end - a_start != b_end - b_start { return 0 }
    let mut i: i32 = 0
    while i < a_end - a_start {
        if src[a_start + i] != src[b_start + i] { return 0 }
        i = i + 1
    }
    return 1
}

extern {
    function strlen(s: string) -> i64
}

# Fuse adjacent stages from one algebraic family. The pass repeats until no
# nested pair remains, so a chain of three or more stages is fully reduced.
export function flowc_fuse_pipelines(arena: ptr<AstArena>, src: ptr<u8>) -> void {
    let mut changed: i32 = 1
    while changed == 1 {
        changed = 0
        let len: i32 = arena[0].len
        let mut id: i32 = 0
        while id < len {
            let node: AstNode = arena[0].nodes[id]
            let family: i32 = flowc_stage_family(src, node)
            if family != 0 {
                let inner: i32 = node.a
                if inner != AST_NONE and arena[0].nodes[inner].kind == AST_CALL and
                   flowc_stage_family(src, arena[0].nodes[inner]) == family {
                    let inner_a: i32 = arena[0].nodes[inner].a
                    let inner_n: i32 = if inner_a == AST_NONE { AST_NONE } else { arena[0].nodes[inner_a].next }
                    let outer_n: i32 = arena[0].nodes[inner].next
                    if inner_a != AST_NONE and inner_n != AST_NONE and outer_n != AST_NONE and
                       flowc_text_equal(src, arena[0].nodes[inner_n].start, arena[0].nodes[inner_n].end,
                                        arena[0].nodes[outer_n].start, arena[0].nodes[outer_n].end) == 1 {
                        let inner_value: i32 = arena[0].nodes[inner_n].next
                        let outer_value: i32 = arena[0].nodes[outer_n].next
                        if inner_value != AST_NONE and outer_value != AST_NONE {
                            let binop_id: i32 = flowc_ast_alloc(arena, AST_BINOP, 0, 0)
                            if binop_id != AST_NONE {
                                arena[0].nodes[binop_id].a = inner_value
                                arena[0].nodes[binop_id].b = outer_value
                                # scale(a, b) is a * b. offset(a, b) is a + b.
                                arena[0].nodes[binop_id].ival = if family <= 2 { 26 } else { 23 }
                                arena[0].nodes[id].a = inner_a
                                arena[0].nodes[inner_a].next = inner_n
                                arena[0].nodes[inner_n].next = binop_id
                                arena[0].nodes[binop_id].next = AST_NONE
                                changed = 1
                            }
                        }
                    }
                }
            }
            id = id + 1
        }
    }
}
