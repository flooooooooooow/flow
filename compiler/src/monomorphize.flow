# @module flowc.monomorphize
# @means  Deterministic plain-type naming and request-policy primitives for
#         generic monomorphization. Compound type encoding, AST discovery and
#         substitution remain on the host until they can be ported byte-exactly.

extern {
    function strlen(s: ptr<u8>) -> i64
}

const FLOWC_MONO_MAX_DEPTH: i32 = 64

function mono_copy(src: string, dst: ptr<u8>, cap: i32) -> i32 {
    let p: ptr<u8> = src as ptr<u8>
    let n: i32 = strlen(p) as i32
    if n + 1 > cap {
        return 0 - 1
    }
    let mut i: i32 = 0
    while i < n {
        dst[i] = p[i]
        i = i + 1
    }
    dst[n] = 0
    return n
}

function mono_append(src: string, dst: ptr<u8>, offset: i32, cap: i32) -> i32 {
    let p: ptr<u8> = src as ptr<u8>
    let n: i32 = strlen(p) as i32
    if offset < 0 || offset + n + 1 > cap {
        return 0 - 1
    }
    let mut i: i32 = 0
    while i < n {
        dst[offset + i] = p[i]
        i = i + 1
    }
    dst[offset + n] = 0
    return offset + n
}

# Build the common specialization form used for plain named type arguments:
# `identity` + `i32` -> `identity_i32`.
export function flowc_mono_mangle_one(
    name: string,
    type_arg: string,
    out: ptr<u8>,
    out_cap: i32
) -> i32 {
    let n: i32 = mono_copy(name, out, out_cap)
    if n < 0 {
        return 0 - 1
    }
    if n + 2 > out_cap {
        return 0 - 1
    }
    out[n] = 95
    out[n + 1] = 0
    return mono_append(type_arg, out, n + 1, out_cap)
}

# Build the two-argument specialization form: `Pair_i32_f32`.
export function flowc_mono_mangle_two(
    name: string,
    first: string,
    second: string,
    out: ptr<u8>,
    out_cap: i32
) -> i32 {
    let n: i32 = flowc_mono_mangle_one(name, first, out, out_cap)
    if n < 0 {
        return 0 - 1
    }
    if n + 2 > out_cap {
        return 0 - 1
    }
    out[n] = 95
    out[n + 1] = 0
    return mono_append(second, out, n + 1, out_cap)
}

export function flowc_mono_depth_allowed(depth: i32) -> i32 {
    if depth < 0 {
        return 0
    }
    if depth >= FLOWC_MONO_MAX_DEPTH {
        return 0
    }
    return 1
}

# A specialization colliding with a concrete declaration is resolved by the
# concrete declaration instead of synthesized, matching the Python pass.
export function flowc_mono_should_generate(
    already_generated: i32,
    collides_with_concrete: i32,
    depth: i32
) -> i32 {
    if already_generated == 1 {
        return 0
    }
    if collides_with_concrete == 1 {
        return 0
    }
    return flowc_mono_depth_allowed(depth)
}
