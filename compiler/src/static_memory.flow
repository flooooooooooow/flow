# @module flowc.static_memory
# @means  Implements buffer interference graph analysis and static memory
#         lifetime scheduling to minimize memory allocation at runtime.

import .ast { AstArena }

extern {
    function malloc(size: i64) -> ptr<u8>
    function free(p: ptr<u8>) -> void
}

# MemoryPlanner in Flow
export struct MemoryPlanner {
    starts: ptr<i32>,
    ends: ptr<i32>,
    sizes: ptr<i32>,
    offsets: ptr<i32>,
    count: i32,
    cap: i32
}

export function memory_planner_new(cap: i32) -> MemoryPlanner {
    return MemoryPlanner {
        starts: malloc((cap as i64) * 4) as ptr<i32>,
        ends: malloc((cap as i64) * 4) as ptr<i32>,
        sizes: malloc((cap as i64) * 4) as ptr<i32>,
        offsets: malloc((cap as i64) * 4) as ptr<i32>,
        count: 0,
        cap: cap
    }
}

export function memory_planner_free(mp: ptr<MemoryPlanner>) {
    free(mp[0].starts as ptr<u8>)
    free(mp[0].ends as ptr<u8>)
    free(mp[0].sizes as ptr<u8>)
    free(mp[0].offsets as ptr<u8>)
}

export function memory_planner_add_buffer(mp: ptr<MemoryPlanner>, start_time: i32, end_time: i32, size: i32) -> i32 {
    if mp[0].count >= mp[0].cap {
        return 0 - 1
    }
    let k: i32 = mp[0].count
    mp[0].starts[k] = start_time
    mp[0].ends[k] = end_time
    mp[0].sizes[k] = size
    mp[0].count = k + 1
    return k
}

# Returns total size required
export function memory_planner_plan(mp: ptr<MemoryPlanner>) -> i32 {
    let mut total_size: i32 = 0
    let mut i: i32 = 0
    while i < mp[0].count {
        # Find offset
        let mut offset: i32 = 0
        let mut conflict: i32 = 1
        while conflict == 1 {
            conflict = 0
            let mut j: i32 = 0
            while j < i {
                # do they interfere?
                let start1: i32 = mp[0].starts[i]
                let end1: i32 = mp[0].ends[i]
                let start2: i32 = mp[0].starts[j]
                let end2: i32 = mp[0].ends[j]

                let mut max_start: i32 = start1
                if start2 > max_start { max_start = start2 }
                let mut min_end: i32 = end1
                if end2 < min_end { min_end = end2 }

                if max_start < min_end {
                    # yes, interfere
                    let alloc_offset: i32 = mp[0].offsets[j]
                    let alloc_size: i32 = mp[0].sizes[j]
                    let mut max_o: i32 = offset
                    if alloc_offset > max_o { max_o = alloc_offset }
                    let mut min_o_end: i32 = offset + mp[0].sizes[i]
                    let alloc_end: i32 = alloc_offset + alloc_size
                    if alloc_end < min_o_end { min_o_end = alloc_end }

                    if max_o < min_o_end {
                        conflict = 1
                        offset = alloc_offset + alloc_size
                        break
                    }
                }
                j = j + 1
            }
        }
        mp[0].offsets[i] = offset
        let end_offset: i32 = offset + mp[0].sizes[i]
        if end_offset > total_size {
            total_size = end_offset
        }
        i = i + 1
    }
    return total_size
}
