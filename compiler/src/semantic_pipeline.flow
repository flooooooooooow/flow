# @module flowc.semantic_pipeline
# @means  Allocation-free orchestration for static facts, runtime evidence,
#         recognition projection and residual extraction.

import .semantic_facts {
    FlowcSemanticFact,
    flowc_fact_valid, flowc_fact_visible
}
import .residual { flowc_residual_extract }

export struct FlowcSemanticLedger {
    facts: ptr<FlowcSemanticFact>,
    len: i32,
    cap: i32
}

export function flowc_semantic_ledger_new(
    storage: ptr<FlowcSemanticFact>,
    cap: i32
) -> FlowcSemanticLedger {
    return FlowcSemanticLedger {
        facts: storage,
        len: 0,
        cap: cap
    }
}

export function flowc_semantic_ledger_add(
    ledger: ptr<FlowcSemanticLedger>,
    fact: FlowcSemanticFact
) -> i32 {
    if flowc_fact_valid(fact) == 0 {
        return 0
    }
    if ledger[0].len >= ledger[0].cap {
        return 0
    }
    ledger[0].facts[ledger[0].len] = fact
    ledger[0].len = ledger[0].len + 1
    return 1
}

export function flowc_semantic_project(
    ledger: FlowcSemanticLedger,
    active_domains: i32,
    out: ptr<FlowcSemanticFact>,
    out_cap: i32
) -> i32 {
    let mut n: i32 = 0
    let mut i: i32 = 0
    while i < ledger.len and n < out_cap {
        if flowc_fact_visible(ledger.facts[i], active_domains) == 1 {
            out[n] = ledger.facts[i]
            n = n + 1
        }
        i = i + 1
    }
    return n
}

export function flowc_semantic_residuals(
    observed: FlowcSemanticLedger,
    represented: FlowcSemanticLedger,
    active_domains: i32,
    out: ptr<FlowcSemanticFact>,
    out_cap: i32
) -> i32 {
    return flowc_residual_extract(
        observed.facts,
        observed.len,
        represented.facts,
        represented.len,
        active_domains,
        out,
        out_cap
    )
}
