# @module flowc.misra_scan
# @means  Lightweight MISRA/CERT scan over generated C (#277).
#         Port of src/flow/misra_scan.py. Flags common deviations so
#         CI / flow analyze can produce evidence rows for compliance
#         matrices. Not a full static analyzer.
#
# Scans for:
#   MISRA 21.3: dynamic allocation (malloc/calloc/realloc/free)
#   MISRA 21.6: stdio I/O (printf/fprintf/sprintf/snprintf/scanf/gets)
#   MISRA 22.1: abort() fault path

extern {
    function strlen(s: string) -> i64
    function strcmp(a: string, b: string) -> i32
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>)
    function memcpy(dst: ptr<void>, src: ptr<void>, n: i64) -> ptr<void>
    function printf(fmt: string, ...) -> i32
    function puts(s: string) -> i32
}

# ── Finding struct ───────────────────────────────────────────────

export struct FlowcFinding {
    rule: string,
    status: string,
    detail: string,
    line: i32
}

# ── Character helpers ─────────────────────────────────────────────

function is_alpha(c: i32) -> i32 {
    if c >= 97 and c <= 122 {
        return 1
    }
    if c >= 65 and c <= 90 {
        return 1
    }
    if c == 95 {
        return 1
    }
    return 0
}

function is_digit(c: i32) -> i32 {
    if c >= 48 and c <= 57 {
        return 1
    }
    return 0
}

function is_word_char(c: i32) -> i32 {
    if is_alpha(c) == 1 {
        return 1
    }
    if is_digit(c) == 1 {
        return 1
    }
    return 0
}

function is_space(c: i32) -> i32 {
    if c == 32 or c == 9 or c == 13 {
        return 1
    }
    return 0
}

# ── Word-boundary keyword search ──────────────────────────────────

# Search for "keyword(" with word boundary on the left.
# Returns the index of the keyword start, or -1 if not found.
# We check that the character before the keyword is not a word char,
# and the character after the keyword is '(' (optional whitespace
# between keyword and '(').
function find_keyword_call(text: string, keyword: string) -> i32 {
    let tn: i32 = strlen(text) as i32
    let kn: i32 = strlen(keyword) as i32
    let tp: ptr<u8> = text
    let kp: ptr<u8> = keyword
    if kn == 0 or kn > tn {
        return -1
    }
    let mut i: i32 = 0
    while i <= tn - kn {
        # Check word boundary on the left
        if i > 0 {
            if is_word_char(tp[i - 1]) == 1 {
                i = i + 1
                continue
            }
        }
        # Compare keyword bytes
        let mut j: i32 = 0
        let mut ok: i32 = 1
        while j < kn {
            if tp[i + j] != kp[j] {
                ok = 0
                break
            }
            j = j + 1
        }
        if ok == 0 {
            i = i + 1
            continue
        }
        # Check that what follows is '(' (with optional whitespace)
        let mut k: i32 = i + kn
        while k < tn and is_space(tp[k]) == 1 {
            k = k + 1
        }
        if k < tn and tp[k] == 40 {
            return i
        }
        i = i + 1
    }
    return -1
}

# Check if a line contains any of the heap allocation functions.
# Returns 1 if found, 0 otherwise.
function line_has_heap_call(line: string) -> i32 {
    if find_keyword_call(line, "malloc") >= 0 {
        return 1
    }
    if find_keyword_call(line, "calloc") >= 0 {
        return 1
    }
    if find_keyword_call(line, "realloc") >= 0 {
        return 1
    }
    if find_keyword_call(line, "free") >= 0 {
        return 1
    }
    return 0
}

# Check if a line contains any of the stdio I/O functions.
function line_has_stdio_call(line: string) -> i32 {
    if find_keyword_call(line, "printf") >= 0 {
        return 1
    }
    if find_keyword_call(line, "fprintf") >= 0 {
        return 1
    }
    if find_keyword_call(line, "sprintf") >= 0 {
        return 1
    }
    if find_keyword_call(line, "snprintf") >= 0 {
        return 1
    }
    if find_keyword_call(line, "scanf") >= 0 {
        return 1
    }
    if find_keyword_call(line, "gets") >= 0 {
        return 1
    }
    return 0
}

# Check if a line contains abort().
function line_has_abort_call(line: string) -> i32 {
    if find_keyword_call(line, "abort") >= 0 {
        return 1
    }
    return 0
}

# ── Line helpers ─────────────────────────────────────────────────

# Check if a stripped line starts with '#' or '//'.
function is_comment_or_directive(line: string) -> i32 {
    let p: ptr<u8> = line
    let n: i32 = strlen(line) as i32
    let mut i: i32 = 0
    # Skip leading whitespace
    while i < n and is_space(p[i]) == 1 {
        i = i + 1
    }
    if i >= n {
        return 0
    }
    if p[i] == 35 {
        return 1
    }
    if i + 1 < n and p[i] == 47 and p[i + 1] == 47 {
        return 1
    }
    return 0
}

# Copy a substring [start, end) from src into a malloc'd buffer.
function substr(src: string, start: i32, end: i32) -> string {
    let mut s: i32 = start
    let mut e: i32 = end
    let n: i32 = strlen(src) as i32
    if s < 0 {
        s = 0
    }
    if e > n {
        e = n
    }
    if s >= e {
        return ""
    }
    let len: i32 = e - s
    let buf: ptr<u8> = malloc((len + 1) as i64) as ptr<u8>
    let p: ptr<u8> = src
    memcpy(buf, p + s, len as i64)
    buf[len] = 0
    return buf as string
}

# Return a stripped (trimmed) copy of a line.
function strip_line(line: string) -> string {
    let n: i32 = strlen(line) as i32
    let p: ptr<u8> = line
    let mut start: i32 = 0
    while start < n and is_space(p[start]) == 1 {
        start = start + 1
    }
    let mut end: i32 = n
    while end > start and is_space(p[end - 1]) == 1 {
        end = end - 1
    }
    return substr(line, start, end)
}

# Truncate a string to at most max_len bytes. Returns a new string.
function truncate(s: string, max_len: i32) -> string {
    let n: i32 = strlen(s) as i32
    if n <= max_len {
        return s
    }
    return substr(s, 0, max_len)
}

# Append b to a. Returns a new malloc'd string.
function str_append(a: string, b: string) -> string {
    let la: i32 = strlen(a) as i32
    let lb: i32 = strlen(b) as i32
    let total: i32 = la + lb
    let buf: ptr<u8> = malloc((total + 1) as i64) as ptr<u8>
    if la > 0 {
        memcpy(buf, a, la as i64)
    }
    if lb > 0 {
        memcpy(buf + la, b, lb as i64)
    }
    buf[total] = 0
    return buf as string
}

# ── Line iterator ────────────────────────────────────────────────

# Count the number of lines in text (split by '\n').
function count_lines(text: string) -> i32 {
    let n: i32 = strlen(text) as i32
    let p: ptr<u8> = text
    let mut count: i32 = 1
    let mut i: i32 = 0
    while i < n {
        if p[i] == 10 {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

# Extract line number 'line_no' (1-based) from text.
# Returns the line without the trailing newline.
function get_line(text: string, line_no: i32) -> string {
    let n: i32 = strlen(text) as i32
    let p: ptr<u8> = text
    let mut current: i32 = 1
    let mut start: i32 = 0
    let mut i: i32 = 0
    while i < n {
        if p[i] == 10 {
            if current == line_no {
                return substr(text, start, i)
            }
            current = current + 1
            start = i + 1
        }
        i = i + 1
    }
    if current == line_no {
        return substr(text, start, n)
    }
    return ""
}

# ── Scanner ──────────────────────────────────────────────────────

# Scan C source text for MISRA/CERT patterns.
# findings: output buffer (ptr<FlowcFinding>).
# max_findings: capacity of the buffer.
# Returns the number of findings written.
export function flowc_scan_c_source(
    text: string,
    findings: ptr<FlowcFinding>,
    max_findings: i32
) -> i32 {
    let mut written: i32 = 0
    let total_lines: i32 = count_lines(text)
    let mut line_no: i32 = 1
    while line_no <= total_lines and written < max_findings {
        let raw_line: string = get_line(text, line_no)
        if is_comment_or_directive(raw_line) == 1 {
            line_no = line_no + 1
            continue
        }
        let stripped: string = strip_line(raw_line)
        let detail_src: string = truncate(stripped, 80)

        if line_has_heap_call(raw_line) == 1 {
            let detail: string = str_append("dynamic allocation: ", detail_src)
            findings[written] = FlowcFinding {
                rule: "MISRA 21.3",
                status: "VIOLATION",
                detail: detail,
                line: line_no
            }
            written = written + 1
            if written >= max_findings {
                break
            }
        }

        if line_has_stdio_call(raw_line) == 1 {
            let detail: string = str_append("stdio I/O: ", detail_src)
            findings[written] = FlowcFinding {
                rule: "MISRA 21.6",
                status: "NOTE",
                detail: detail,
                line: line_no
            }
            written = written + 1
            if written >= max_findings {
                break
            }
        }

        if line_has_abort_call(raw_line) == 1 {
            let detail: string = str_append("abort() fault path: ", detail_src)
            findings[written] = FlowcFinding {
                rule: "MISRA 22.1",
                status: "NOTE",
                detail: detail,
                line: line_no
            }
            written = written + 1
            if written >= max_findings {
                break
            }
        }

        line_no = line_no + 1
    }
    return written
}

# Count violations in a findings array.
export function flowc_count_violations(findings: ptr<FlowcFinding>, count: i32) -> i32 {
    let mut v: i32 = 0
    let mut i: i32 = 0
    while i < count {
        if strcmp(findings[i].status, "VIOLATION") == 0 {
            v = v + 1
        }
        i = i + 1
    }
    return v
}

# Count notes in a findings array.
export function flowc_count_notes(findings: ptr<FlowcFinding>, count: i32) -> i32 {
    let mut n: i32 = 0
    let mut i: i32 = 0
    while i < count {
        if strcmp(findings[i].status, "NOTE") == 0 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

# ── Report (the `flow analyze` scan) ─────────────────────────────
#
# flowc_misra_report reproduces misra_scan.py's scan_c_source and
# format_report in one pass over the text: str.splitlines() line breaks,
# str.strip() whitespace, the `\b(name)\s*\(` searches, and details cut at
# 80 characters (code points, not bytes).

export struct MisraReport {
    text: string,
    violations: i32,
    notes: i32
}

struct MsBuf {
    data: ptr<u8>,
    len: i32,
    cap: i32
}

function ms_new() -> MsBuf {
    let d: ptr<u8> = malloc(4096) as ptr<u8>
    d[0] = 0
    return MsBuf { data: d, len: 0, cap: 4096 }
}

function ms_put_span(b: ptr<MsBuf>, src: ptr<u8>, start: i32, end: i32) {
    if end <= start {
        return
    }
    let n: i32 = end - start
    if b[0].len + n + 1 > b[0].cap {
        let mut nc: i32 = b[0].cap * 2
        while nc < b[0].len + n + 1 {
            nc = nc * 2
        }
        let nd: ptr<u8> = malloc(nc as i64) as ptr<u8>
        memcpy(nd, b[0].data, b[0].len as i64)
        free(b[0].data)
        b[0].data = nd
        b[0].cap = nc
    }
    let d: ptr<u8> = b[0].data
    memcpy(d + b[0].len, src + start, n as i64)
    b[0].len = b[0].len + n
    d[b[0].len] = 0
}

function ms_puts(b: ptr<MsBuf>, s: string) {
    ms_put_span(b, s as ptr<u8>, 0, strlen(s) as i32)
}

function ms_put_int(b: ptr<MsBuf>, v: i32) {
    let tmp: ptr<u8> = malloc(32) as ptr<u8>
    let mut n: i32 = 0
    let mut x: i32 = v
    if x == 0 {
        tmp[0] = 48
        n = 1
    }
    while x > 0 {
        tmp[n] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    let mut i: i32 = n - 1
    while i >= 0 {
        ms_put_span(b, tmp, i, i + 1)
        i = i - 1
    }
    free(tmp)
}

# Bytes in the UTF-8 sequence that starts with lead byte c.
function ms_seq_len(c: i32) -> i32 {
    if c >= 240 { return 4 }
    if c >= 224 { return 3 }
    if c >= 192 { return 2 }
    return 1
}

function ms_cp_len(p: ptr<u8>, i: i32, n: i32) -> i32 {
    let k: i32 = ms_seq_len(p[i] as i32)
    if i + k > n {
        return 1
    }
    return k
}

# Code point at p[i]. A malformed byte reads as itself.
function ms_cp(p: ptr<u8>, i: i32, n: i32) -> i32 {
    let c: i32 = p[i] as i32
    let k: i32 = ms_cp_len(p, i, n)
    if k == 1 {
        return c
    }
    let b1: i32 = (p[i + 1] as i32) % 64
    if k == 2 {
        return (c % 32) * 64 + b1
    }
    let b2: i32 = (p[i + 2] as i32) % 64
    if k == 3 {
        return (c % 16) * 4096 + b1 * 64 + b2
    }
    let b3: i32 = (p[i + 3] as i32) % 64
    return (c % 8) * 262144 + b1 * 4096 + b2 * 64 + b3
}

# Python str.isspace() for a code point.
function ms_is_py_space(cp: i32) -> i32 {
    if cp == 32 or (cp >= 9 and cp <= 13) or (cp >= 28 and cp <= 31) {
        return 1
    }
    if cp == 133 or cp == 160 or cp == 5760 or (cp >= 8192 and cp <= 8202) {
        return 1
    }
    if cp == 8232 or cp == 8233 or cp == 8239 or cp == 8287 or cp == 12288 {
        return 1
    }
    return 0
}

# A str.splitlines() line break at p[i]: its length in bytes, or 0.
function ms_line_break(p: ptr<u8>, i: i32, n: i32) -> i32 {
    let c: i32 = p[i] as i32
    if c == 13 {
        if i + 1 < n and p[i + 1] == 10 {
            return 2
        }
        return 1
    }
    if c == 10 or c == 11 or c == 12 or c == 28 or c == 29 or c == 30 {
        return 1
    }
    if c == 194 and i + 1 < n and p[i + 1] == 133 {
        return 2
    }
    if c == 226 and i + 2 < n and p[i + 1] == 128 and (p[i + 2] == 168 or p[i + 2] == 169) {
        return 3
    }
    return 0
}

# Is the character that ends just before byte i a regex \w? ASCII letters,
# digits and `_`; past ASCII, anything that is not a space, Latin-1
# punctuation or a symbol block counts as a letter. Generated C only has
# such characters in string literals and comments.
function ms_prev_is_word(p: ptr<u8>, start: i32, i: i32, n: i32) -> i32 {
    if i <= start {
        return 0
    }
    let mut j: i32 = i - 1
    while j > start and (p[j] as i32) >= 128 and (p[j] as i32) < 192 {
        j = j - 1
    }
    let cp: i32 = ms_cp(p, j, n)
    if cp < 128 {
        return is_word_char(cp)
    }
    if ms_is_py_space(cp) == 1 {
        return 0
    }
    if cp < 170 or (cp >= 8192 and cp <= 11263) or (cp >= 12288 and cp <= 12351) {
        return 0
    }
    return 1
}

# `\bname\s*\(` anywhere in p[start, end).
function ms_has_call(p: ptr<u8>, start: i32, end: i32, name: string, n: i32) -> i32 {
    let kn: i32 = strlen(name) as i32
    let kp: ptr<u8> = name
    let mut i: i32 = start
    while i + kn <= end {
        let mut ok: i32 = 1
        let mut j: i32 = 0
        while j < kn and ok == 1 {
            if p[i + j] != kp[j] {
                ok = 0
            }
            j = j + 1
        }
        if ok == 1 and ms_prev_is_word(p, start, i, n) == 0 {
            let mut k: i32 = i + kn
            let mut more: i32 = 1
            while k < end and more == 1 {
                if ms_is_py_space(ms_cp(p, k, n)) == 1 {
                    k = k + ms_cp_len(p, k, n)
                } else {
                    more = 0
                }
            }
            if k < end and p[k] == 40 {
                return 1
            }
        }
        i = i + 1
    }
    return 0
}

# which: 0 heap, 1 stdio, 2 abort.
function ms_any_call(p: ptr<u8>, start: i32, end: i32, n: i32, which: i32) -> i32 {
    if which == 0 {
        if ms_has_call(p, start, end, "malloc", n) == 1 { return 1 }
        if ms_has_call(p, start, end, "calloc", n) == 1 { return 1 }
        if ms_has_call(p, start, end, "realloc", n) == 1 { return 1 }
        if ms_has_call(p, start, end, "free", n) == 1 { return 1 }
        return 0
    }
    if which == 1 {
        if ms_has_call(p, start, end, "printf", n) == 1 { return 1 }
        if ms_has_call(p, start, end, "fprintf", n) == 1 { return 1 }
        if ms_has_call(p, start, end, "sprintf", n) == 1 { return 1 }
        if ms_has_call(p, start, end, "snprintf", n) == 1 { return 1 }
        if ms_has_call(p, start, end, "scanf", n) == 1 { return 1 }
        if ms_has_call(p, start, end, "gets", n) == 1 { return 1 }
        return 0
    }
    return ms_has_call(p, start, end, "abort", n)
}

function ms_finding(b: ptr<MsBuf>, status: string, rule: string, line: i32, what: string, p: ptr<u8>, ds: i32, de: i32) {
    ms_puts(b, "[")
    ms_puts(b, status)
    ms_puts(b, "] ")
    ms_puts(b, rule)
    ms_puts(b, ":")
    ms_put_int(b, line)
    ms_puts(b, "  ")
    ms_puts(b, what)
    ms_put_span(b, p, ds, de)
    ms_puts(b, "\n")
}

export function flowc_misra_report(text: string, standard: string, source: string) -> MisraReport {
    let p: ptr<u8> = text
    let n: i32 = strlen(text) as i32
    let mut rows: MsBuf = ms_new()
    let mut viol: i32 = 0
    let mut notes: i32 = 0
    let mut line_no: i32 = 0
    let mut i: i32 = 0
    while i < n {
        # One splitlines() line is [ls, le); the next starts at i.
        let ls: i32 = i
        let mut le: i32 = i
        let mut brk: i32 = 0
        while le < n and brk == 0 {
            brk = ms_line_break(p, le, n)
            if brk == 0 {
                le = le + 1
            }
        }
        i = le + brk
        line_no = line_no + 1
        # line.strip()
        let mut ss: i32 = ls
        let mut more: i32 = 1
        while ss < le and more == 1 {
            if ms_is_py_space(ms_cp(p, ss, n)) == 1 {
                ss = ss + ms_cp_len(p, ss, n)
            } else {
                more = 0
            }
        }
        let mut se: i32 = le
        more = 1
        while se > ss and more == 1 {
            let mut j: i32 = se - 1
            while j > ss and (p[j] as i32) >= 128 and (p[j] as i32) < 192 {
                j = j - 1
            }
            if ms_is_py_space(ms_cp(p, j, n)) == 1 {
                se = j
            } else {
                more = 0
            }
        }
        let is_hash: bool = ss < se and p[ss] == 35
        let is_slashes: bool = ss + 1 < se and p[ss] == 47 and p[ss + 1] == 47
        if not is_hash and not is_slashes {
            # stripped[:80]
            let mut de: i32 = ss
            let mut count: i32 = 0
            while de < se and count < 80 {
                de = de + ms_cp_len(p, de, n)
                count = count + 1
            }
            if de > se {
                de = se
            }
            if ms_any_call(p, ls, le, n, 0) == 1 {
                ms_finding(&rows, "VIOLATION", "MISRA 21.3", line_no, "dynamic allocation: ", p, ss, de)
                viol = viol + 1
            }
            if ms_any_call(p, ls, le, n, 1) == 1 {
                ms_finding(&rows, "NOTE", "MISRA 21.6", line_no, "stdio I/O: ", p, ss, de)
                notes = notes + 1
            }
            if ms_any_call(p, ls, le, n, 2) == 1 {
                ms_finding(&rows, "NOTE", "MISRA 22.1", line_no, "abort() fault path: ", p, ss, de)
                notes = notes + 1
            }
        }
    }
    let mut out: MsBuf = ms_new()
    ms_puts(&out, "Flow analyze (")
    ms_puts(&out, standard)
    ms_puts(&out, ")\nSource: ")
    ms_puts(&out, source)
    ms_puts(&out, "\n------------------------------------------------------------\n")
    if viol + notes == 0 {
        ms_puts(&out, "No flagged patterns.\n")
        return MisraReport { text: out.data as string, violations: 0, notes: 0 }
    }
    ms_put_span(&out, rows.data, 0, rows.len)
    ms_puts(&out, "------------------------------------------------------------\nSummary: ")
    ms_put_int(&out, viol)
    ms_puts(&out, " violation(s), ")
    ms_put_int(&out, notes)
    ms_puts(&out, " note(s)\nSee docs/certification/ for the full compliance matrix.\n")
    return MisraReport { text: out.data as string, violations: viol, notes: notes }
}
