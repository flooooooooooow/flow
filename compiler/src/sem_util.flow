# @module flowc.sem_util
# @means  Strings, growable vectors and a string-keyed hash map for the
#         semantic type checker (sem_check.flow, sem_types.flow).
#
# Strings are NUL-terminated byte strings. Everything allocated here lives
# until the compiler exits: one check of one program.

extern {
    function malloc(size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
    function strlen(s: string) -> i64
    function strcmp(a: string, b: string) -> i32
    function strncmp(a: string, b: string, n: i64) -> i32
}

# ---------------------------------------------------------------------------
# Strings
# ---------------------------------------------------------------------------

export function sem_s_len(s: string) -> i32 {
    return strlen(s) as i32
}

export function sem_s_eq(a: string, b: string) -> bool {
    return strcmp(a, b) == 0
}

export function sem_s_starts(s: string, prefix: string) -> bool {
    return strncmp(s, prefix, strlen(prefix)) == 0
}

export function sem_s_ends(s: string, suffix: string) -> bool {
    let n: i32 = sem_s_len(s)
    let m: i32 = sem_s_len(suffix)
    if m > n {
        return false
    }
    let p: ptr<u8> = s as ptr<u8>
    let q: ptr<u8> = suffix as ptr<u8>
    let mut i: i32 = 0
    while i < m {
        if p[n - m + i] != q[i] {
            return false
        }
        i = i + 1
    }
    return true
}

export function sem_s_byte(s: string, i: i32) -> i32 {
    let p: ptr<u8> = s as ptr<u8>
    return p[i] as i32
}

# Copy of bytes [start, end) of `s`.
export function sem_s_slice(s: string, start: i32, end: i32) -> string {
    let mut n: i32 = end - start
    if n < 0 {
        n = 0
    }
    let out: ptr<u8> = malloc((n + 1) as i64) as ptr<u8>
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    while i < n {
        out[i] = p[start + i]
        i = i + 1
    }
    out[n] = 0
    return out as string
}

export function sem_s_from(s: string, start: i32) -> string {
    return sem_s_slice(s, start, sem_s_len(s))
}

# Copy of a source span.
export function sem_s_span(src: ptr<u8>, start: i32, end: i32) -> string {
    return sem_s_slice(src as string, start, end)
}

# 1 when src[start..end) spells `lit`.
export function sem_s_span_is(src: ptr<u8>, start: i32, end: i32, lit: string) -> bool {
    let n: i32 = sem_s_len(lit)
    if end - start != n {
        return false
    }
    let q: ptr<u8> = lit as ptr<u8>
    let mut i: i32 = 0
    while i < n {
        if src[start + i] != q[i] {
            return false
        }
        i = i + 1
    }
    return true
}

# Index of `sub` in `s` at or after `from`, or -1.
export function sem_s_find(s: string, sub: string, from: i32) -> i32 {
    let n: i32 = sem_s_len(s)
    let m: i32 = sem_s_len(sub)
    let p: ptr<u8> = s as ptr<u8>
    let q: ptr<u8> = sub as ptr<u8>
    let mut i: i32 = from
    while i + m <= n {
        let mut j: i32 = 0
        while j < m and p[i + j] == q[j] {
            j = j + 1
        }
        if j == m {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

export function sem_s_contains(s: string, sub: string) -> bool {
    return sem_s_find(s, sub, 0) >= 0
}

export function sem_s_index_byte(s: string, c: i32) -> i32 {
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    while p[i] != 0 {
        if p[i] as i32 == c {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

export function sem_s_itoa(v: i64) -> string {
    if v == 0 {
        return "0"
    }
    let buf: ptr<u8> = malloc(24) as ptr<u8>
    let mut n: i64 = v
    let mut neg: bool = false
    if n < 0 {
        neg = true
        n = 0 - n
    }
    let mut tmp: array<u8, 24> = [0; 24]
    let mut k: i32 = 0
    while n > 0 {
        tmp[k] = (48 + (n % 10)) as u8
        n = n / 10
        k = k + 1
    }
    let mut o: i32 = 0
    if neg {
        buf[0] = 45
        o = 1
    }
    while k > 0 {
        k = k - 1
        buf[o] = tmp[k]
        o = o + 1
    }
    buf[o] = 0
    return buf as string
}

export function sem_s_is_digit(c: i32) -> bool {
    return c >= 48 and c <= 57
}

export function sem_s_is_alpha(c: i32) -> bool {
    return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95
}

export function sem_s_is_space(c: i32) -> bool {
    return c == 32 or c == 9 or c == 10 or c == 13
}

# Python str.strip() for ASCII whitespace.
export function sem_s_strip(s: string) -> string {
    let n: i32 = sem_s_len(s)
    let mut a: i32 = 0
    while a < n and sem_s_is_space(sem_s_byte(s, a)) {
        a = a + 1
    }
    let mut b: i32 = n
    while b > a and sem_s_is_space(sem_s_byte(s, b - 1)) {
        b = b - 1
    }
    return sem_s_slice(s, a, b)
}

# ---------------------------------------------------------------------------
# Growable vectors
# ---------------------------------------------------------------------------

export struct SemIntVec {
    data: ptr<i32>,
    len: i32,
    cap: i32
}

export function sem_iv_new() -> ptr<SemIntVec> {
    let v: ptr<SemIntVec> = malloc(16) as ptr<SemIntVec>
    v.cap = 8
    v.len = 0
    v.data = malloc(32) as ptr<i32>
    return v
}

export function sem_iv_push(v: ptr<SemIntVec>, x: i32) {
    if v.len >= v.cap {
        v.cap = v.cap * 2
        v.data = realloc(v.data as ptr<void>, (v.cap as i64) * 4) as ptr<i32>
    }
    v.data[v.len] = x
    v.len = v.len + 1
}

export function sem_iv_get(v: ptr<SemIntVec>, i: i32) -> i32 {
    return v.data[i]
}

export function sem_iv_has(v: ptr<SemIntVec>, x: i32) -> bool {
    let mut i: i32 = 0
    while i < v.len {
        if v.data[i] == x {
            return true
        }
        i = i + 1
    }
    return false
}

export struct SemStrVec {
    data: ptr<string>,
    len: i32,
    cap: i32
}

export function sem_sv_new() -> ptr<SemStrVec> {
    let v: ptr<SemStrVec> = malloc(16) as ptr<SemStrVec>
    v.cap = 8
    v.len = 0
    v.data = malloc(64) as ptr<string>
    return v
}

export function sem_sv_push(v: ptr<SemStrVec>, s: string) {
    if v.len >= v.cap {
        v.cap = v.cap * 2
        v.data = realloc(v.data as ptr<void>, (v.cap as i64) * 8) as ptr<string>
    }
    v.data[v.len] = s
    v.len = v.len + 1
}

export function sem_sv_get(v: ptr<SemStrVec>, i: i32) -> string {
    return v.data[i]
}

export function sem_sv_has(v: ptr<SemStrVec>, s: string) -> bool {
    let mut i: i32 = 0
    while i < v.len {
        if sem_s_eq(v.data[i], s) {
            return true
        }
        i = i + 1
    }
    return false
}

# Add `s` unless present (a small insertion-ordered set).
export function sem_sv_add(v: ptr<SemStrVec>, s: string) {
    if sem_sv_has(v, s) == false {
        sem_sv_push(v, s)
    }
}

# Sort in place by byte order (Python sorted() on ASCII names).
export function sem_sv_sort(v: ptr<SemStrVec>) {
    let mut i: i32 = 1
    while i < v.len {
        let cur: string = v.data[i]
        let mut j: i32 = i - 1
        while j >= 0 and strcmp(v.data[j], cur) > 0 {
            v.data[j + 1] = v.data[j]
            j = j - 1
        }
        v.data[j + 1] = cur
        i = i + 1
    }
}

# ", ".join(v)
export function sem_sv_join(v: ptr<SemStrVec>, sep: string) -> string {
    let mut out: string = ""
    let mut i: i32 = 0
    while i < v.len {
        if i > 0 {
            out = out + sep
        }
        out = out + v.data[i]
        i = i + 1
    }
    return out
}

# s.split(sep) for a one-byte separator.
export function sem_s_split(s: string, sep: i32) -> ptr<SemStrVec> {
    let out: ptr<SemStrVec> = sem_sv_new()
    let n: i32 = sem_s_len(s)
    let mut start: i32 = 0
    let mut i: i32 = 0
    while i <= n {
        if i == n or sem_s_byte(s, i) == sep {
            sem_sv_push(out, sem_s_slice(s, start, i))
            start = i + 1
        }
        i = i + 1
    }
    return out
}

# ---------------------------------------------------------------------------
# String-keyed hash map (open addressing, insertion never removes)
# ---------------------------------------------------------------------------

export struct SemStrMap {
    keys: ptr<string>,
    vals: ptr<i32>,
    cap: i32,
    count: i32
}

export function sem_sm_new() -> ptr<SemStrMap> {
    let m: ptr<SemStrMap> = malloc(24) as ptr<SemStrMap>
    m.cap = 64
    m.count = 0
    m.keys = malloc(64 * 8) as ptr<string>
    m.vals = malloc(64 * 4) as ptr<i32>
    let mut i: i32 = 0
    while i < 64 {
        m.keys[i] = null
        i = i + 1
    }
    return m
}

function sem_sm_hash(s: string) -> i32 {
    let p: ptr<u8> = s as ptr<u8>
    let mut h: i64 = 5381
    let mut i: i32 = 0
    while p[i] != 0 {
        h = ((h * 33) + (p[i] as i64)) % 1000000007
        i = i + 1
    }
    return h as i32
}

function sem_sm_slot(m: ptr<SemStrMap>, key: string) -> i32 {
    let mut i: i32 = sem_sm_hash(key) % m.cap
    while m.keys[i] as ptr<u8> != null {
        if sem_s_eq(m.keys[i], key) {
            return i
        }
        i = (i + 1) % m.cap
    }
    return i
}

function sem_sm_grow(m: ptr<SemStrMap>) {
    let old_keys: ptr<string> = m.keys
    let old_vals: ptr<i32> = m.vals
    let old_cap: i32 = m.cap
    m.cap = old_cap * 2
    m.keys = malloc((m.cap as i64) * 8) as ptr<string>
    m.vals = malloc((m.cap as i64) * 4) as ptr<i32>
    let mut i: i32 = 0
    while i < m.cap {
        m.keys[i] = null
        i = i + 1
    }
    i = 0
    while i < old_cap {
        if old_keys[i] as ptr<u8> != null {
            let s: i32 = sem_sm_slot(m, old_keys[i])
            m.keys[s] = old_keys[i]
            m.vals[s] = old_vals[i]
        }
        i = i + 1
    }
}

# The value for `key`, or -1.
export function sem_sm_get(m: ptr<SemStrMap>, key: string) -> i32 {
    let s: i32 = sem_sm_slot(m, key)
    if m.keys[s] as ptr<u8> == null {
        return 0 - 1
    }
    return m.vals[s]
}

export function sem_sm_has(m: ptr<SemStrMap>, key: string) -> bool {
    let s: i32 = sem_sm_slot(m, key)
    return m.keys[s] as ptr<u8> != null
}

export function sem_sm_put(m: ptr<SemStrMap>, key: string, val: i32) {
    if (m.count + 1) * 2 > m.cap {
        sem_sm_grow(m)
    }
    let s: i32 = sem_sm_slot(m, key)
    if m.keys[s] as ptr<u8> == null {
        m.keys[s] = key
        m.count = m.count + 1
    }
    m.vals[s] = val
}

# ---------------------------------------------------------------------------
# A growable vector of pointers (SemIntVec / SemStrVec lists)
# ---------------------------------------------------------------------------

export struct SemPtrVec {
    data: ptr<ptr<void>>,
    len: i32,
    cap: i32
}

export function sem_pv_new() -> ptr<SemPtrVec> {
    let v: ptr<SemPtrVec> = malloc(16) as ptr<SemPtrVec>
    v.cap = 8
    v.len = 0
    v.data = malloc(64) as ptr<ptr<void>>
    return v
}

export function sem_pv_push(v: ptr<SemPtrVec>, x: ptr<void>) {
    if v.len >= v.cap {
        v.cap = v.cap * 2
        v.data = realloc(v.data as ptr<void>, (v.cap as i64) * 8) as ptr<ptr<void>>
    }
    v.data[v.len] = x
    v.len = v.len + 1
}

export function sem_pv_get(v: ptr<SemPtrVec>, i: i32) -> ptr<void> {
    return v.data[i]
}

export function sem_pv_set(v: ptr<SemPtrVec>, i: i32, x: ptr<void>) {
    v.data[i] = x
}

# Accessors for vectors held in a struct field: flowc lowers `a.b.c` with
# pointer fields a and b to `(a->b).c`, so code reaching a vector through
# another pointer goes through these.
export function sem_iv_set(v: ptr<SemIntVec>, i: i32, x: i32) {
    v.data[i] = x
}

export function sem_iv_len(v: ptr<SemIntVec>) -> i32 {
    return v.len
}

export function sem_iv_setlen(v: ptr<SemIntVec>, n: i32) {
    v.len = n
}

export function sem_sv_len(v: ptr<SemStrVec>) -> i32 {
    return v.len
}

export function sem_sv_setlen(v: ptr<SemStrVec>, n: i32) {
    v.len = n
}

export function sem_sv_set(v: ptr<SemStrVec>, i: i32, s: string) {
    v.data[i] = s
}

export function sem_pv_len(v: ptr<SemPtrVec>) -> i32 {
    return v.len
}

export function sem_pv_setlen(v: ptr<SemPtrVec>, n: i32) {
    v.len = n
}
