# @module flowc.dynamics_dsl
# @means  Dynamics DSL expander (dsys / horizon / sense / ga evolve /
#         closed / analyze / wfc field / couple / guide / dynamics { } /
#         represent), the whole of src/flow/dynamics_dsl.py with the two
#         corrections from src/flow/_dynamics_dsl_fixes.py applied. Runs
#         before parse on every source flowc reads.
#
# Output is byte-identical to `expand_dynamics_dsl` in the Python module,
# including its quirks, and compiler/scripts/parity_dynamics_dsl.sh holds
# the two to that. Quirks kept on purpose:
#
#   * Once the DSL is detected, the result is the kept lines joined by
#     "\n" (Python `"\n".join(source.splitlines())`), so a trailing newline
#     is dropped and every line terminator becomes "\n".
#   * `_extract_brace_block` returns only once it is past the start line,
#     so a one-line `dsys p { ... }` also consumes the line after it, and
#     more when that line opens a block.
#   * `#` starts a comment anywhere, including inside a string.
#   * Brace counting sees braces in comments.
#   * A comment line inside `dynamics { }` is leftover, which is an error.
#
# Errors print `flowc dynamics: <str(exception)>`. Besides the DSL's own
# SyntaxError messages that covers the ValueError, IndexError and KeyError
# text Python produced for malformed numbers, short lines and unknown names.
#
# Floats format as Python does: `f"{v:.17g}"` for generated code and
# `repr(v)` inside phase-portrait helpers and one error hint. Both are
# computed from the exact binary value with a small bignum, so no variadic
# C call is needed.
#
# Regex has no Stage-A equivalent. Each pattern is a small template run by
# dy_match; every greedy run in these patterns is followed by a byte it
# cannot contain, so no backtracking is needed. Whitespace is Python's ASCII
# `\s` set (9..13, 28..32); a byte >= 128 counts as a word character.
#
# Leaf module: externs and the shared byte buffer (bytebuf.flow) only.

import .bytebuf { ByteBuf, bb_new, bb_putc, bb_puts, bb_put_span, bb_put_i64 }

extern {
    function strcmp(a: string, b: string) -> i32
    function strlen(s: string) -> i64
    function malloc(size: i64) -> ptr<u8>
    function realloc(p: ptr<u8>, size: i64) -> ptr<u8>
    function free(p: ptr<u8>) -> void
    function memcpy(dst: ptr<u8>, src: ptr<u8>, n: i64) -> ptr<u8>
    function strtod(s: string, e: ptr<u8>) -> f64
    function puts(s: string) -> i32
}

# ── Line helpers kept for tests/lang/test_dynamics_dsl.flow ─────

function dy_old_space(c: i32) -> i32 {
    if c == 32 or c == 9 or c == 13 or c == 10 { return 1 }
    return 0
}

function dy_old_starts(s: string, prefix: string) -> i32 {
    let sl: i32 = strlen(s) as i32
    let pl: i32 = strlen(prefix) as i32
    if pl > sl { return 0 }
    let sp: ptr<u8> = s as ptr<u8>
    let pp: ptr<u8> = prefix as ptr<u8>
    let mut i: i32 = 0
    while i < pl {
        if sp[i] != pp[i] { return 0 }
        i = i + 1
    }
    return 1
}

# Remove a trailing # comment and strip whitespace.
export function flowc_strip_comments(line: string) -> string {
    let n: i32 = strlen(line) as i32
    let p: ptr<u8> = line as ptr<u8>
    let mut hash_pos: i32 = 0 - 1
    let mut i: i32 = 0
    while i < n {
        if p[i] == 35 {
            hash_pos = i
            break
        }
        i = i + 1
    }
    let mut end: i32 = n
    if hash_pos >= 0 {
        end = hash_pos
    }
    while end > 0 and dy_old_space(p[end - 1] as i32) == 1 {
        end = end - 1
    }
    let mut start: i32 = 0
    while start < end and dy_old_space(p[start] as i32) == 1 {
        start = start + 1
    }
    if start >= end {
        return ""
    }
    let len: i32 = end - start
    let buf: ptr<u8> = malloc((len + 1) as i64)
    memcpy(buf, p + start, len as i64)
    buf[len] = 0
    return buf as string
}

# `dyn.dsys plant` -> `dsys plant`; `dynamics.horizon r` -> `horizon r`.
export function flowc_strip_dynamics_namespace(line: string) -> string {
    let stripped: string = flowc_strip_comments(line)
    let mut skip: i32 = 0
    if dy_old_starts(stripped, "dyn.") == 1 {
        skip = 4
    } else {
        if dy_old_starts(stripped, "dynamics.") == 1 {
            skip = 9
        }
    }
    if skip == 0 {
        return stripped
    }
    let n: i32 = strlen(stripped) as i32
    let len: i32 = n - skip
    let p: ptr<u8> = stripped as ptr<u8>
    let buf: ptr<u8> = malloc((len + 1) as i64)
    memcpy(buf, p + skip, len as i64)
    buf[len] = 0
    return buf as string
}

# A code point as UTF-8 (the messages carry a few non-ASCII signs).
function dy_utf8(b: ptr<ByteBuf>, cp: i32) {
    if cp < 128 {
        bb_putc(b, cp as u8)
        return
    }
    if cp < 2048 {
        bb_putc(b, (192 + cp / 64) as u8)
        bb_putc(b, (128 + cp % 64) as u8)
        return
    }
    bb_putc(b, (224 + cp / 4096) as u8)
    bb_putc(b, (128 + (cp / 64) % 64) as u8)
    bb_putc(b, (128 + cp % 64) as u8)
}

# ── Characters and spans ─────────────────────────────────────────

function dy_ws(ch: u8) -> i32 {
    if ch == 32 { return 1 }
    if ch >= 9 and ch <= 13 { return 1 }
    if ch >= 28 and ch <= 31 { return 1 }
    return 0
}

function dy_digit(ch: u8) -> i32 {
    if ch >= 48 and ch <= 57 { return 1 }
    return 0
}

function dy_word(ch: u8) -> i32 {
    if dy_digit(ch) == 1 { return 1 }
    if ch >= 65 and ch <= 90 { return 1 }
    if ch >= 97 and ch <= 122 { return 1 }
    if ch == 95 { return 1 }
    if ch >= 128 { return 1 }
    return 0
}

# Strip whitespace from both ends of se[0]..se[1] in p.
function dy_strip(p: ptr<u8>, se: ptr<i32>) {
    while se[0] < se[1] and dy_ws(p[se[0]]) == 1 {
        se[0] = se[0] + 1
    }
    while se[1] > se[0] and dy_ws(p[se[1] - 1]) == 1 {
        se[1] = se[1] - 1
    }
}

function dy_rstrip(p: ptr<u8>, se: ptr<i32>) {
    while se[1] > se[0] and dy_ws(p[se[1] - 1]) == 1 {
        se[1] = se[1] - 1
    }
}

# _strip_comments: cut at the first `#`, then strip.
function dy_strip_comments(p: ptr<u8>, se: ptr<i32>) {
    let mut k: i32 = se[0]
    while k < se[1] {
        if p[k] == 35 {
            se[1] = k
            break
        }
        k = k + 1
    }
    dy_strip(p, se)
}

function dy_count(p: ptr<u8>, s: i32, e: i32, ch: u8) -> i32 {
    let mut k: i32 = s
    let mut c: i32 = 0
    while k < e {
        if p[k] == ch {
            c = c + 1
        }
        k = k + 1
    }
    return c
}

function dy_find(p: ptr<u8>, s: i32, e: i32, ch: u8) -> i32 {
    let mut k: i32 = s
    while k < e {
        if p[k] == ch {
            return k
        }
        k = k + 1
    }
    return 0 - 1
}

function dy_find_str(p: ptr<u8>, s: i32, e: i32, lit: string) -> i32 {
    let lp: ptr<u8> = lit as ptr<u8>
    let ln: i32 = strlen(lit) as i32
    let mut k: i32 = s
    while k + ln <= e {
        let mut j: i32 = 0
        while j < ln and p[k + j] == lp[j] {
            j = j + 1
        }
        if j == ln {
            return k
        }
        k = k + 1
    }
    return 0 - 1
}

function dy_starts(p: ptr<u8>, s: i32, e: i32, lit: string) -> i32 {
    let lp: ptr<u8> = lit as ptr<u8>
    let ln: i32 = strlen(lit) as i32
    if e - s < ln {
        return 0
    }
    let mut j: i32 = 0
    while j < ln {
        if p[s + j] != lp[j] {
            return 0
        }
        j = j + 1
    }
    return 1
}

function dy_eq(p: ptr<u8>, s: i32, e: i32, lit: string) -> i32 {
    if e - s != (strlen(lit) as i32) {
        return 0
    }
    return dy_starts(p, s, e, lit)
}

function dy_spans_eq(a: ptr<u8>, as0: i32, ae: i32, b: ptr<u8>, bs: i32, be: i32) -> i32 {
    if ae - as0 != be - bs {
        return 0
    }
    let mut k: i32 = 0
    while k < ae - as0 {
        if a[as0 + k] != b[bs + k] {
            return 0
        }
        k = k + 1
    }
    return 1
}

function dy_has_nonws(p: ptr<u8>, s: i32, e: i32) -> i32 {
    let mut k: i32 = s
    while k < e {
        if dy_ws(p[k]) == 0 {
            return 1
        }
        k = k + 1
    }
    return 0
}

# ── Lines (str.splitlines) ───────────────────────────────────────

function dy_eol_len(p: ptr<u8>, i: i32, n: i32) -> i32 {
    let c: u8 = p[i]
    if c == 13 {
        if i + 1 < n and p[i + 1] == 10 {
            return 2
        }
        return 1
    }
    if c == 10 or c == 11 or c == 12 or c == 28 or c == 29 or c == 30 {
        return 1
    }
    if c == 194 and i + 1 < n and p[i + 1] == 133 {
        return 2
    }
    if c == 226 and i + 2 < n and p[i + 1] == 128 and (p[i + 2] == 168 or p[i + 2] == 169) {
        return 3
    }
    return 0
}

function dy_split_lines(p: ptr<u8>, n: i32, ls: ptr<i32>, le: ptr<i32>) -> i32 {
    let mut count: i32 = 0
    let mut start: i32 = 0
    let mut i: i32 = 0
    while i < n {
        let t: i32 = dy_eol_len(p, i, n)
        if t > 0 {
            ls[count] = start
            le[count] = i
            count = count + 1
            i = i + t
            start = i
        } else {
            i = i + 1
        }
    }
    if start < n {
        ls[count] = start
        le[count] = n
        count = count + 1
    }
    return count
}

# Split p[s..e) on whitespace runs (str.split()); returns the count.
function dy_split_ws(p: ptr<u8>, s: i32, e: i32, ws: ptr<i32>, we: ptr<i32>) -> i32 {
    let mut k: i32 = s
    let mut c: i32 = 0
    while k < e {
        while k < e and dy_ws(p[k]) == 1 {
            k = k + 1
        }
        if k >= e {
            break
        }
        ws[c] = k
        while k < e and dy_ws(p[k]) == 0 {
            k = k + 1
        }
        we[c] = k
        c = c + 1
    }
    return c
}

# ── Pattern templates ────────────────────────────────────────────
#
# Anchored at s. `^` = \s+, `~` = \s*, `@` = capture \w+, `#` = capture \d+,
# `$` = capture [\d.]+, `&` = capture [+\-\d.eE]+; any other byte is literal.
# Captures go to caps[2k], caps[2k+1]. Returns the end offset or -1.

function dy_numch(ch: u8) -> i32 {
    if dy_digit(ch) == 1 { return 1 }
    if ch == 43 or ch == 45 or ch == 46 or ch == 101 or ch == 69 { return 1 }
    return 0
}

function dy_match(p: ptr<u8>, s: i32, e: i32, pat: string, caps: ptr<i32>) -> i32 {
    let pp: ptr<u8> = pat as ptr<u8>
    let mut k: i32 = s
    let mut j: i32 = 0
    let mut nc: i32 = 0
    while pp[j] != 0 {
        let op: u8 = pp[j]
        if op == 94 or op == 126 {
            let st: i32 = k
            while k < e and dy_ws(p[k]) == 1 {
                k = k + 1
            }
            if op == 94 and k == st {
                return 0 - 1
            }
        } else {
            if op == 64 or op == 35 or op == 36 or op == 38 {
                let st2: i32 = k
                while k < e {
                    let ch: u8 = p[k]
                    let mut ok: i32 = 0
                    if op == 64 { ok = dy_word(ch) }
                    if op == 35 { ok = dy_digit(ch) }
                    if op == 36 {
                        if dy_digit(ch) == 1 or ch == 46 { ok = 1 }
                    }
                    if op == 38 { ok = dy_numch(ch) }
                    if ok == 0 {
                        break
                    }
                    k = k + 1
                }
                if k == st2 {
                    return 0 - 1
                }
                caps[nc * 2] = st2
                caps[nc * 2 + 1] = k
                nc = nc + 1
            } else {
                if k >= e or p[k] != op {
                    return 0 - 1
                }
                k = k + 1
            }
        }
        j = j + 1
    }
    return k
}

# ── Context ──────────────────────────────────────────────────────

export struct DyC {
    err: i32,
    msg: ptr<ByteBuf>,
    nm: ptr<ByteBuf>,
    fp: ptr<f64>,
    fnum: i32,
    fcap: i32,
    bd_kind: ptr<i32>,
    bd_var: ptr<i32>,
    bd_hz: ptr<i32>,
    nbd: i32,
    bdcap: i32,
    gl: ptr<i32>,
    ngl: i32,
    glcap: i32,
    at_name: ptr<i32>,
    at_val: ptr<f64>,
    nat: i32,
    atcap: i32
}

function dy_i32s(n: i32) -> ptr<i32> {
    return malloc(((n + 1) as i64) * 4) as ptr<i32>
}

function dy_i64s(n: i32) -> ptr<i64> {
    return malloc(((n + 1) as i64) * 8) as ptr<i64>
}

function dy_f64s(n: i32) -> ptr<f64> {
    return malloc(((n + 1) as i64) * 8) as ptr<f64>
}

# Copy p[s..e) into the name arena; returns its offset.
function dy_name(c: ptr<DyC>, p: ptr<u8>, s: i32, e: i32) -> i32 {
    let off: i32 = c[0].nm[0].len
    bb_put_span(c[0].nm, p, s, e)
    bb_putc(c[0].nm, 0)
    return off
}

function dy_name_lit(c: ptr<DyC>, s: string) -> i32 {
    let off: i32 = c[0].nm[0].len
    bb_puts(c[0].nm, s)
    bb_putc(c[0].nm, 0)
    return off
}

function dy_nstr(c: ptr<DyC>, off: i32) -> string {
    return (c[0].nm[0].p + off) as string
}

function dy_neq(c: ptr<DyC>, a: i32, b: i32) -> i32 {
    if strcmp(dy_nstr(c, a), dy_nstr(c, b)) == 0 {
        return 1
    }
    return 0
}

function dy_neq_lit(c: ptr<DyC>, a: i32, s: string) -> i32 {
    if strcmp(dy_nstr(c, a), s) == 0 {
        return 1
    }
    return 0
}

function dy_pn(b: ptr<ByteBuf>, c: ptr<DyC>, off: i32) {
    bb_puts(b, dy_nstr(c, off))
}

function dy_fpush(c: ptr<DyC>, v: f64) -> i32 {
    if c[0].fnum >= c[0].fcap {
        let ncap: i32 = c[0].fcap * 2 + 64
        c[0].fp = realloc(c[0].fp as ptr<u8>, ((ncap + 1) as i64) * 8) as ptr<f64>
        c[0].fcap = ncap
    }
    c[0].fp[c[0].fnum] = v
    c[0].fnum = c[0].fnum + 1
    return c[0].fnum - 1
}

function dy_bd(c: ptr<DyC>, kind: i32, var: i32, hz: i32) -> i32 {
    if c[0].nbd >= c[0].bdcap {
        let ncap: i32 = c[0].bdcap * 2 + 64
        c[0].bd_kind = realloc(c[0].bd_kind as ptr<u8>, ((ncap + 1) as i64) * 4) as ptr<i32>
        c[0].bd_var = realloc(c[0].bd_var as ptr<u8>, ((ncap + 1) as i64) * 4) as ptr<i32>
        c[0].bd_hz = realloc(c[0].bd_hz as ptr<u8>, ((ncap + 1) as i64) * 4) as ptr<i32>
        c[0].bdcap = ncap
    }
    c[0].bd_kind[c[0].nbd] = kind
    c[0].bd_var[c[0].nbd] = var
    c[0].bd_hz[c[0].nbd] = hz
    c[0].nbd = c[0].nbd + 1
    return c[0].nbd - 1
}

function dy_gl(c: ptr<DyC>, off: i32) -> i32 {
    if c[0].ngl >= c[0].glcap {
        let ncap: i32 = c[0].glcap * 2 + 64
        c[0].gl = realloc(c[0].gl as ptr<u8>, ((ncap + 1) as i64) * 4) as ptr<i32>
        c[0].glcap = ncap
    }
    c[0].gl[c[0].ngl] = off
    c[0].ngl = c[0].ngl + 1
    return c[0].ngl - 1
}

function dy_at(c: ptr<DyC>, name: i32, v: f64) -> i32 {
    if c[0].nat >= c[0].atcap {
        let ncap: i32 = c[0].atcap * 2 + 64
        c[0].at_name = realloc(c[0].at_name as ptr<u8>, ((ncap + 1) as i64) * 4) as ptr<i32>
        c[0].at_val = realloc(c[0].at_val as ptr<u8>, ((ncap + 1) as i64) * 8) as ptr<f64>
        c[0].atcap = ncap
    }
    c[0].at_name[c[0].nat] = name
    c[0].at_val[c[0].nat] = v
    c[0].nat = c[0].nat + 1
    return c[0].nat - 1
}

# Start an error message; returns the buffer to append to.
function dy_err(c: ptr<DyC>) -> ptr<ByteBuf> {
    c[0].err = 1
    c[0].msg[0].len = 0
    c[0].msg[0].p[0] = 0
    return c[0].msg
}

function dy_err_s(c: ptr<DyC>, s: string) {
    let m: ptr<ByteBuf> = dy_err(c)
    bb_puts(m, s)
}

# repr() of a str, as ValueError messages quote it.
function dy_repr_str(b: ptr<ByteBuf>, p: ptr<u8>, s: i32, e: i32) {
    let mut q: u8 = 39
    if dy_find(p, s, e, 39) >= 0 and dy_find(p, s, e, 34) < 0 {
        q = 34
    }
    bb_putc(b, q)
    let mut k: i32 = s
    while k < e {
        let ch: u8 = p[k]
        if ch == 92 or ch == q {
            bb_putc(b, 92)
        }
        bb_putc(b, ch)
        k = k + 1
    }
    bb_putc(b, q)
}

# ── Numbers: int() and float() ───────────────────────────────────

# Python int(s) over s = p[s..e) (already free of outer whitespace in
# every call site). Sets the error and returns 0 on failure.
function dy_int(c: ptr<DyC>, p: ptr<u8>, s0: i32, e0: i32) -> i64 {
    let mut s: i32 = s0
    let mut e: i32 = e0
    while s < e and dy_ws(p[s]) == 1 {
        s = s + 1
    }
    while e > s and dy_ws(p[e - 1]) == 1 {
        e = e - 1
    }
    let mut k: i32 = s
    let mut neg: i32 = 0
    if k < e and (p[k] == 43 or p[k] == 45) {
        if p[k] == 45 {
            neg = 1
        }
        k = k + 1
    }
    let mut v: i64 = 0
    let mut nd: i32 = 0
    let mut ok: i32 = 1
    let mut prev_us: i32 = 1
    while k < e {
        let ch: u8 = p[k]
        if dy_digit(ch) == 1 {
            v = v * 10 + ((ch - 48) as i64)
            nd = nd + 1
            prev_us = 0
        } else {
            if ch == 95 and prev_us == 0 {
                prev_us = 1
            } else {
                ok = 0
                break
            }
        }
        k = k + 1
    }
    if nd == 0 or prev_us == 1 {
        ok = 0
    }
    if ok == 0 {
        let m: ptr<ByteBuf> = dy_err(c)
        bb_puts(m, "invalid literal for int() with base 10: ")
        dy_repr_str(m, p, s0, e0)
        return 0
    }
    if neg == 1 {
        return 0 - v
    }
    return v
}

# `[0-9](_?[0-9])*` starting at k; returns the end or k when none.
function dy_digits_us(p: ptr<u8>, k: i32, e: i32) -> i32 {
    if k >= e or dy_digit(p[k]) == 0 {
        return k
    }
    let mut j: i32 = k + 1
    while j < e {
        if dy_digit(p[j]) == 1 {
            j = j + 1
        } else {
            if p[j] == 95 and j + 1 < e and dy_digit(p[j + 1]) == 1 {
                j = j + 2
            } else {
                break
            }
        }
    }
    return j
}

function dy_lower_eq(p: ptr<u8>, s: i32, e: i32, lit: string) -> i32 {
    let lp: ptr<u8> = lit as ptr<u8>
    let ln: i32 = strlen(lit) as i32
    if e - s != ln {
        return 0
    }
    let mut j: i32 = 0
    while j < ln {
        let mut ch: u8 = p[s + j]
        if ch >= 65 and ch <= 90 {
            ch = ch + 32
        }
        if ch != lp[j] {
            return 0
        }
        j = j + 1
    }
    return 1
}

# Python float(s). Sets the error and returns 0.0 on failure.
function dy_float(c: ptr<DyC>, p: ptr<u8>, s0: i32, e0: i32) -> f64 {
    let mut s: i32 = s0
    let mut e: i32 = e0
    while s < e and dy_ws(p[s]) == 1 {
        s = s + 1
    }
    while e > s and dy_ws(p[e - 1]) == 1 {
        e = e - 1
    }
    let mut k: i32 = s
    let mut neg: i32 = 0
    if k < e and (p[k] == 43 or p[k] == 45) {
        if p[k] == 45 {
            neg = 1
        }
        k = k + 1
    }
    let mut ok: i32 = 0
    let mut special: i32 = 0
    if dy_lower_eq(p, k, e, "inf") == 1 or dy_lower_eq(p, k, e, "infinity") == 1 {
        special = 1
        ok = 1
    }
    if dy_lower_eq(p, k, e, "nan") == 1 {
        special = 2
        ok = 1
    }
    if special == 0 {
        let a: i32 = dy_digits_us(p, k, e)
        let mut j: i32 = a
        let mut have: i32 = 0
        if a > k {
            have = 1
        }
        if j < e and p[j] == 46 {
            let b: i32 = dy_digits_us(p, j + 1, e)
            if b > j + 1 {
                have = 1
            }
            j = b
        }
        if have == 1 and j < e and (p[j] == 101 or p[j] == 69) {
            let mut x: i32 = j + 1
            if x < e and (p[x] == 43 or p[x] == 45) {
                x = x + 1
            }
            let xe: i32 = dy_digits_us(p, x, e)
            if xe == x {
                have = 0
            }
            j = xe
        }
        if have == 1 and j == e {
            ok = 1
        }
    }
    if ok == 0 {
        let m: ptr<ByteBuf> = dy_err(c)
        bb_puts(m, "could not convert string to float: ")
        dy_repr_str(m, p, s0, e0)
        return 0.0
    }
    if special == 1 {
        let big: f64 = 1.0e308 * 10.0
        if neg == 1 {
            return 0.0 - big
        }
        return big
    }
    if special == 2 {
        let z: f64 = 0.0
        return z / z
    }
    # strtod on a copy without underscores.
    let buf: ptr<u8> = malloc((e - s + 2) as i64)
    let mut q: i32 = 0
    let mut t: i32 = s
    while t < e {
        if p[t] != 95 {
            buf[q] = p[t]
            q = q + 1
        }
        t = t + 1
    }
    buf[q] = 0
    let v: f64 = strtod(buf as string, null)
    free(buf)
    return v
}

# ── Float formatting from the exact binary value ─────────────────

function dy_bits(x: f64) -> i64 {
    let tmp: ptr<f64> = malloc(8) as ptr<f64>
    tmp[0] = x
    let ip: ptr<i64> = tmp as ptr<i64>
    let b: i64 = ip[0]
    free(tmp as ptr<u8>)
    return b
}

# Exact decimal digits of a positive finite x: writes them to dig and the
# decimal point position to dp[0] (x = 0.DIGITS * 10^dp). Returns the count.
function dy_exact(x: f64, dig: ptr<u8>, dp: ptr<i32>) -> i32 {
    let b: i64 = dy_bits(x)
    let ex: i64 = (b >> 52) & 2047
    let frac: i64 = b & 4503599627370495
    let mut mant: i64 = frac
    let mut e2: i32 = 0 - 1074
    if ex != 0 {
        mant = frac + 4503599627370496
        e2 = (ex as i32) - 1075
    }
    # Base 1e9 limbs, little-endian.
    let limbs: ptr<i64> = malloc(1024) as ptr<i64>
    let mut nl: i32 = 0
    let mut m: i64 = mant
    while m > 0 {
        limbs[nl] = m % 1000000000
        m = m / 1000000000
        nl = nl + 1
    }
    let mut times: i32 = e2
    let mut mul: i64 = 2
    if e2 < 0 {
        times = 0 - e2
        mul = 5
    }
    let mut t: i32 = 0
    while t < times {
        let mut carry: i64 = 0
        let mut i: i32 = 0
        while i < nl {
            let v: i64 = limbs[i] * mul + carry
            limbs[i] = v % 1000000000
            carry = v / 1000000000
            i = i + 1
        }
        if carry > 0 {
            limbs[nl] = carry
            nl = nl + 1
        }
        t = t + 1
    }
    # Digits, most significant first.
    let mut nd: i32 = 0
    let mut top: i64 = limbs[nl - 1]
    let tmpd: ptr<u8> = malloc(16)
    let mut tn: i32 = 0
    while top > 0 {
        tmpd[tn] = (48 + (top % 10)) as u8
        top = top / 10
        tn = tn + 1
    }
    while tn > 0 {
        tn = tn - 1
        dig[nd] = tmpd[tn]
        nd = nd + 1
    }
    let mut li: i32 = nl - 2
    while li >= 0 {
        let mut v2: i64 = limbs[li]
        let mut d: i32 = 8
        while d >= 0 {
            dig[nd + d] = (48 + (v2 % 10)) as u8
            v2 = v2 / 10
            d = d - 1
        }
        nd = nd + 9
        li = li - 1
    }
    free(tmpd)
    free(limbs as ptr<u8>)
    if e2 < 0 {
        dp[0] = nd + e2
    } else {
        dp[0] = nd
    }
    return nd
}

# Round the nd exact digits to P significant digits (half to even on the
# exact value) into out; adjusts dp[0] on carry-out.
function dy_round(dig: ptr<u8>, nd: i32, pr: i32, out: ptr<u8>, dp: ptr<i32>) {
    let mut i: i32 = 0
    while i < pr {
        if i < nd {
            out[i] = dig[i]
        } else {
            out[i] = 48
        }
        i = i + 1
    }
    if nd <= pr {
        return
    }
    let nx: u8 = dig[pr]
    let mut up: i32 = 0
    if nx > 53 {
        up = 1
    }
    if nx == 53 {
        let mut rest: i32 = 0
        let mut k: i32 = pr + 1
        while k < nd {
            if dig[k] != 48 {
                rest = 1
            }
            k = k + 1
        }
        if rest == 1 {
            up = 1
        } else {
            if ((out[pr - 1] - 48) % 2) == 1 {
                up = 1
            }
        }
    }
    if up == 0 {
        return
    }
    let mut j: i32 = pr - 1
    while j >= 0 {
        if out[j] == 57 {
            out[j] = 48
            j = j - 1
        } else {
            out[j] = out[j] + 1
            return
        }
    }
    # All nines: 99..9 -> 100..0 with one more integer digit.
    out[0] = 49
    let mut z: i32 = 1
    while z < pr {
        out[z] = 48
        z = z + 1
    }
    dp[0] = dp[0] + 1
}

# nan / inf / zero / sign handling shared by both formats. Returns 1 when
# the value was fully written; otherwise writes the sign and returns 0.
function dy_fmt_special(b: ptr<ByteBuf>, v: f64, zero: string) -> i32 {
    if v != v {
        bb_puts(b, "nan")
        return 1
    }
    if dy_bits(v) < 0 {
        bb_putc(b, 45)
    }
    let d: f64 = v - v
    if d != d {
        bb_puts(b, "inf")
        return 1
    }
    if v == 0.0 {
        bb_puts(b, zero)
        return 1
    }
    return 0
}

function dy_exp10(b: ptr<ByteBuf>, x: i32) {
    if x < 0 {
        bb_putc(b, 45)
    } else {
        bb_putc(b, 43)
    }
    let mut ax: i32 = x
    if ax < 0 {
        ax = 0 - ax
    }
    if ax < 10 {
        bb_putc(b, 48)
    }
    bb_put_i64(b, ax as i64)
}

# f"{v:.17g}"
function dy_g17(b: ptr<ByteBuf>, v: f64) {
    if dy_fmt_special(b, v, "0") == 1 {
        return
    }
    let mut a: f64 = v
    if a < 0.0 {
        a = 0.0 - a
    }
    let dig: ptr<u8> = malloc(1200)
    let r: ptr<u8> = malloc(32)
    let dp: ptr<i32> = dy_i32s(1)
    let nd: i32 = dy_exact(a, dig, dp)
    dy_round(dig, nd, 17, r, dp)
    let decpt: i32 = dp[0]
    let x: i32 = decpt - 1
    # Significant digits after trailing zeros are dropped.
    let mut last: i32 = 17
    while last > 1 and r[last - 1] == 48 {
        last = last - 1
    }
    if x >= 0 - 4 and x < 17 {
        if decpt <= 0 {
            bb_puts(b, "0.")
            let mut z: i32 = 0
            while z < 0 - decpt {
                bb_putc(b, 48)
                z = z + 1
            }
            bb_put_span(b, r, 0, last)
        } else {
            bb_put_span(b, r, 0, decpt)
            if last > decpt {
                bb_putc(b, 46)
                bb_put_span(b, r, decpt, last)
            }
        }
    } else {
        bb_putc(b, r[0])
        if last > 1 {
            bb_putc(b, 46)
            bb_put_span(b, r, 1, last)
        }
        bb_putc(b, 101)
        dy_exp10(b, x)
    }
    free(dig)
    free(r)
    free(dp as ptr<u8>)
}

# repr(v): the shortest digits that read back as v.
function dy_repr(b: ptr<ByteBuf>, v: f64) {
    if dy_fmt_special(b, v, "0.0") == 1 {
        return
    }
    let mut a: f64 = v
    if a < 0.0 {
        a = 0.0 - a
    }
    let dig: ptr<u8> = malloc(1200)
    let r: ptr<u8> = malloc(32)
    let dp: ptr<i32> = dy_i32s(1)
    let nd: i32 = dy_exact(a, dig, dp)
    let exact_dp: i32 = dp[0]
    let chk: ptr<ByteBuf> = bb_new(64)
    let mut pr: i32 = 1
    while pr <= 17 {
        dp[0] = exact_dp
        dy_round(dig, nd, pr, r, dp)
        chk[0].len = 0
        bb_puts(chk, "0.")
        bb_put_span(chk, r, 0, pr)
        bb_putc(chk, 101)
        bb_put_i64(chk, dp[0] as i64)
        if strtod(chk[0].p as string, null) == a {
            break
        }
        pr = pr + 1
    }
    let mut last: i32 = pr
    while last > 1 and r[last - 1] == 48 {
        last = last - 1
    }
    let decpt: i32 = dp[0]
    let x: i32 = decpt - 1
    if x >= 0 - 4 and x < 16 {
        if decpt <= 0 {
            bb_puts(b, "0.")
            let mut z: i32 = 0
            while z < 0 - decpt {
                bb_putc(b, 48)
                z = z + 1
            }
            bb_put_span(b, r, 0, last)
        } else {
            if decpt >= last {
                bb_put_span(b, r, 0, last)
                let mut z2: i32 = last
                while z2 < decpt {
                    bb_putc(b, 48)
                    z2 = z2 + 1
                }
                bb_puts(b, ".0")
            } else {
                bb_put_span(b, r, 0, decpt)
                bb_putc(b, 46)
                bb_put_span(b, r, decpt, last)
            }
        }
    } else {
        bb_putc(b, r[0])
        if last > 1 {
            bb_putc(b, 46)
            bb_put_span(b, r, 1, last)
        }
        bb_putc(b, 101)
        dy_exp10(b, x)
    }
    free(dig)
    free(r)
    free(dp as ptr<u8>)
    free(chk[0].p)
    free(chk as ptr<u8>)
}

# _flow_f64: .17g, with ".0" when there is no "." or exponent.
function dy_flow_f64(b: ptr<ByteBuf>, v: f64) {
    let t: ptr<ByteBuf> = bb_new(40)
    dy_g17(t, v)
    let mut s: i32 = 0
    if t[0].p[0] == 46 {
        bb_putc(b, 48)
    }
    if t[0].len >= 2 and t[0].p[0] == 45 and t[0].p[1] == 46 {
        bb_puts(b, "-0")
        s = 1
    }
    bb_put_span(b, t[0].p, s, t[0].len)
    if dy_find(t[0].p, 0, t[0].len, 101) < 0 and dy_find(t[0].p, 0, t[0].len, 69) < 0 and dy_find(t[0].p, 0, t[0].len, 46) < 0 {
        bb_puts(b, ".0")
    }
    free(t[0].p)
    free(t as ptr<u8>)
}

# ── Program ──────────────────────────────────────────────────────

