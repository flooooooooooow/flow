# @module flowc.dynamics_dsl
# @means  Dynamics DSL utility helpers.
#         Port of _strip_comments and _strip_dynamics_namespace from
#         src/flow/dynamics_dsl.py. The Python original is a full DSL
#         parser and expander; this port exposes the line-level helpers.
#         Full DSL parsing, brace block extraction, and expansion stay
#         in Python.

extern {
    function strcmp(a: string, b: string) -> i32
    function strlen(s: string) -> i64
    function malloc(size: i64) -> ptr<void>
    function memcpy(dst: ptr<void>, src: ptr<void>, n: i64) -> ptr<void>
}

# ── String helpers ───────────────────────────────────────────────

function is_space(c: i32) -> i32 {
    if c == 32 or c == 9 or c == 13 or c == 10 { return 1 }
    return 0
}

function str_starts_with(s: string, prefix: string) -> i32 {
    let sl: i32 = strlen(s) as i32
    let pl: i32 = strlen(prefix) as i32
    if pl > sl { return 0 }
    let sp: ptr<u8> = s
    let pp: ptr<u8> = prefix
    let mut i: i32 = 0
    while i < pl {
        if sp[i] != pp[i] { return 0 }
        i = i + 1
    }
    return 1
}

# ── Strip comments ───────────────────────────────────────────────

# Remove a trailing # comment and strip whitespace.
# "code # comment" -> "code"
# "  code  " -> "code"
export function flowc_strip_comments(line: string) -> string {
    let n: i32 = strlen(line) as i32
    let p: ptr<u8> = line
    # Find the first #
    let mut hash_pos: i32 = -1
    let mut i: i32 = 0
    while i < n {
        if p[i] == 35 {
            hash_pos = i
            break
        }
        i = i + 1
    }
    let mut end: i32 = n
    if hash_pos >= 0 {
        end = hash_pos
    }
    # Strip trailing whitespace
    while end > 0 and is_space(p[end - 1]) == 1 {
        end = end - 1
    }
    # Strip leading whitespace
    let mut start: i32 = 0
    while start < end and is_space(p[start]) == 1 {
        start = start + 1
    }
    if start >= end {
        return ""
    }
    let len: i32 = end - start
    let buf: ptr<u8> = malloc((len + 1) as i64) as ptr<u8>
    memcpy(buf, p + start, len as i64)
    buf[len] = 0
    return buf as string
}

# ── Strip dynamics namespace ─────────────────────────────────────

# Allow `dyn.dsys` / `dynamics.horizon` as namespaced aliases.
# "dyn.dsys plant { ... }" -> "dsys plant { ... }"
# "dynamics.horizon rollout" -> "horizon rollout"
# "dsys plant { ... }" -> "dsys plant { ... }" (unchanged)
export function flowc_strip_dynamics_namespace(line: string) -> string {
    let stripped: string = flowc_strip_comments(line)
    if str_starts_with(stripped, "dyn.") == 1 {
        let n: i32 = strlen(stripped) as i32
        let len: i32 = n - 4
        let p: ptr<u8> = stripped
        let buf: ptr<u8> = malloc((len + 1) as i64) as ptr<u8>
        memcpy(buf, p + 4, len as i64)
        buf[len] = 0
        return buf as string
    }
    if str_starts_with(stripped, "dynamics.") == 1 {
        let n: i32 = strlen(stripped) as i32
        let len: i32 = n - 9
        let p: ptr<u8> = stripped
        let buf: ptr<u8> = malloc((len + 1) as i64) as ptr<u8>
        memcpy(buf, p + 9, len as i64)
        buf[len] = 0
        return buf as string
    }
    return stripped
}
