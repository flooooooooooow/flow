# @module flowc.denotation
# @means  Flow-native structural denotation for parsed flow declarations.
#
# The Python host keeps exact frozen semantic tuples. The self-hosted compiler
# uses canonical token fingerprints per semantic component so formatting and
# comments do not affect signatures. These fingerprints are semantic auditing
# metadata, not proof objects; optimisation soundness still comes from static
# proof or guards in semantic_facts.flow.

import .token { Token, Lexer, TOK_EOF }
import .lexer { flowc_lexer_new, flowc_lexer_next }
import .ast {
    AstArena, AST_NONE, AST_FLOW_DECL,
    FLOW_ITEM_MEMBER, FLOW_ITEM_EVOLVES, FLOW_ITEM_WHEN, FLOW_ITEM_EVERY,
    FLOW_ITEM_SOLVER, FLOW_ITEM_ALWAYS, FLOW_ITEM_NEVER,
    FLOW_ITEM_CONNECT, FLOW_ITEM_CHILD
}

extern {
    function strlen(s: string) -> i64
}

export struct FlowcDenotation {
    state_schema: u64,
    input_schema: u64,
    output_schema: u64,
    param_schema: u64,
    initial_state: u64,
    param_defaults: u64,
    dynamics: u64,
    output_maps: u64,
    timing: u64,
    events: u64,
    discrete_updates: u64,
    constraints: u64,
    composition: u64,
    event_count: i32,
    update_count: i32
}

export function flowc_den_mix(h: u64, value: u64) -> u64 {
    let x: u64 = h ^ value
    return x ^ (x << 7) ^ (x >> 3) ^ 5871781006564002453
}

export function flowc_den_empty() -> FlowcDenotation {
    return FlowcDenotation {
        state_schema: 0,
        input_schema: 0,
        output_schema: 0,
        param_schema: 0,
        initial_state: 0,
        param_defaults: 0,
        dynamics: 0,
        output_maps: 0,
        timing: 0,
        events: 0,
        discrete_updates: 0,
        constraints: 0,
        composition: 0,
        event_count: 0,
        update_count: 0
    }
}

function flowc_den_span_is(
    src: ptr<u8>,
    start: i32,
    end: i32,
    lit: string
) -> i32 {
    let n: i32 = strlen(lit) as i32
    if end - start < n {
        return 0
    }
    let p: ptr<u8> = lit
    let mut i: i32 = 0
    while i < n {
        if src[start + i] != p[i] {
            return 0
        }
        i = i + 1
    }
    if end - start == n {
        return 1
    }
    let c: u8 = src[start + n]
    if c == 32 or c == 9 or c == 10 or c == 13 {
        return 1
    }
    return 0
}

export function flowc_den_hash_bytes(
    src: ptr<u8>,
    start: i32,
    end: i32
) -> u64 {
    let mut h: u64 = 1469598103934665603
    let mut i: i32 = start
    while i < end {
        h = flowc_den_mix(h, src[i] as u64)
        i = i + 1
    }
    return h
}

# Token hashing ignores whitespace and comments because the lexer does.
export function flowc_den_hash_tokens(
    src: ptr<u8>,
    start: i32,
    end: i32
) -> u64 {
    if end <= start {
        return 0
    }
    let input: ptr<u8> = src + start
    let mut lex: Lexer = flowc_lexer_new(input, end - start)
    let mut h: u64 = 1469598103934665603
    let mut tok: Token = flowc_lexer_next(&lex)
    while tok.kind != TOK_EOF {
        h = flowc_den_mix(h, tok.kind as u64)
        h = flowc_den_mix(h, flowc_den_hash_bytes(input, tok.start, tok.end))
        tok = flowc_lexer_next(&lex)
    }
    return h
}

function flowc_den_hash_named_node(
    arena: AstArena,
    src: ptr<u8>,
    item: i32,
    child: i32
) -> u64 {
    let mut h: u64 = flowc_den_hash_bytes(
        src,
        arena.nodes[item].name_start,
        arena.nodes[item].name_end
    )
    if child != AST_NONE {
        h = flowc_den_mix(
            h,
            flowc_den_hash_tokens(
                src,
                arena.nodes[child].start,
                arena.nodes[child].end
            )
        )
    }
    return h
}

export function flowc_denotation_from_flow(
    arena: AstArena,
    flow_id: i32,
    src: ptr<u8>
) -> FlowcDenotation {
    let mut d: FlowcDenotation = flowc_den_empty()
    if flow_id == AST_NONE {
        return d
    }
    if arena.nodes[flow_id].kind != AST_FLOW_DECL {
        return d
    }

    let mut item: i32 = arena.nodes[flow_id].a
    while item != AST_NONE {
        let kind: i32 = arena.nodes[item].ival
        let item_hash: u64 = flowc_den_hash_tokens(
            src,
            arena.nodes[item].start,
            arena.nodes[item].end
        )

        if kind == FLOW_ITEM_MEMBER {
            let schema_hash: u64 = flowc_den_hash_named_node(
                arena, src, item, arena.nodes[item].a
            )
            if flowc_den_span_is(src, arena.nodes[item].start, arena.nodes[item].end, "state") == 1 {
                d.state_schema = flowc_den_mix(d.state_schema, schema_hash)
                if arena.nodes[item].b != AST_NONE {
                    d.initial_state = flowc_den_mix(
                        d.initial_state,
                        flowc_den_hash_named_node(arena, src, item, arena.nodes[item].b)
                    )
                }
            } elif flowc_den_span_is(src, arena.nodes[item].start, arena.nodes[item].end, "input") == 1 {
                d.input_schema = flowc_den_mix(d.input_schema, schema_hash)
            } elif flowc_den_span_is(src, arena.nodes[item].start, arena.nodes[item].end, "output") == 1 {
                d.output_schema = flowc_den_mix(d.output_schema, schema_hash)
                if arena.nodes[item].b != AST_NONE {
                    d.output_maps = flowc_den_mix(
                        d.output_maps,
                        flowc_den_hash_named_node(arena, src, item, arena.nodes[item].b)
                    )
                }
            } elif flowc_den_span_is(src, arena.nodes[item].start, arena.nodes[item].end, "param") == 1 {
                d.param_schema = flowc_den_mix(d.param_schema, schema_hash)
                if arena.nodes[item].b != AST_NONE {
                    d.param_defaults = flowc_den_mix(
                        d.param_defaults,
                        flowc_den_hash_named_node(arena, src, item, arena.nodes[item].b)
                    )
                }
            }
        } elif kind == FLOW_ITEM_EVOLVES {
            d.dynamics = flowc_den_mix(d.dynamics, item_hash)
        } elif kind == FLOW_ITEM_SOLVER {
            d.timing = flowc_den_mix(d.timing, item_hash)
        } elif kind == FLOW_ITEM_WHEN {
            d.events = flowc_den_mix(d.events, item_hash)
            d.event_count = d.event_count + 1
        } elif kind == FLOW_ITEM_EVERY {
            d.timing = flowc_den_mix(d.timing, item_hash)
            d.discrete_updates = flowc_den_mix(d.discrete_updates, item_hash)
            d.update_count = d.update_count + 1
        } elif kind == FLOW_ITEM_ALWAYS or kind == FLOW_ITEM_NEVER {
            d.constraints = flowc_den_mix(d.constraints, item_hash)
        } elif kind == FLOW_ITEM_CONNECT or kind == FLOW_ITEM_CHILD {
            d.composition = flowc_den_mix(d.composition, item_hash)
        }

        item = arena.nodes[item].next
    }
    return d
}
