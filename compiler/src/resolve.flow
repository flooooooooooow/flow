# @module flowc.resolve
# @means  Stage-A multi-file import resolve + C bundle emit + bundle typecheck.
#
# MVP: resolve `import .sibling` (ival=1) and `import "path"` (ival=2);
# skip dotted `pkg.mod` (ival=0). Bundle emit concatenates deps then entry
# into one TU (first module writes includes; rest use flowc_cgen_emit_ex flags&1).
# flowc_bundle_typecheck: deps-first check with growing seed of dep exports.

import .ast {
    AST_IMPORT
}
import .parser {
    flowc_parser_new, flowc_parser_free, flowc_parse_program, Parser
}
import .fileio { flowc_read_file }
import .cgen { flowc_cgen_emit_ex }
import .typecheck {
    TcCtx,
    flowc_tc_init, flowc_tc_free, flowc_tc_reset_module,
    flowc_tc_seed_export, flowc_tc_check_program
}

extern {
    function malloc(size: i64) -> ptr<u8>
    function free(p: ptr<u8>) -> void
    function strlen(s: string) -> i64
}

const FLOWC_RESOLVE_MAX_MODS: i32 = 16
const FLOWC_RESOLVE_PATH_CAP: i32 = 256
const FLOWC_RESOLVE_SRC_CAP: i32 = 65536
const FLOWC_RESOLVE_AST_CAP: i32 = 8192

# Copy NUL-terminated `s` into `dst` (cap includes NUL). Returns length, or -1.
function flowc_resolve_copy_cstr(s: string, dst: ptr<u8>, cap: i32) -> i32 {
    let p: ptr<u8> = s
    let n: i32 = strlen(s) as i32
    if n + 1 > cap {
        return 0 - 1
    }
    let mut i: i32 = 0
    while i < n {
        dst[i] = p[i]
        i = i + 1
    }
    dst[n] = 0
    return n
}

# Compare two NUL-terminated C strings in buffers. 1 if equal.
function flowc_resolve_cstr_eq(a: ptr<u8>, b: ptr<u8>) -> i32 {
    let mut i: i32 = 0
    while i < 4096 {
        let ca: i32 = a[i]
        let cb: i32 = b[i]
        if ca != cb {
            return 0
        }
        if ca == 0 {
            return 1
        }
        i = i + 1
    }
    return 0
}

# Find path in a row-major store (row_cap bytes per slot). Returns index or -1.
function flowc_resolve_find_path(store: ptr<u8>, n: i32, row_cap: i32, path: ptr<u8>) -> i32 {
    let mut i: i32 = 0
    while i < n {
        let slot: ptr<u8> = store + (i * row_cap)
        if flowc_resolve_cstr_eq(slot, path) == 1 {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

# Map import span to a filesystem path under search_dir.
# Relative `.name` span includes the leading dot → strip it → search_dir/name.flow
# String `"path"` span includes quotes → strip → search_dir/path (or absolute as-is).
export function flowc_resolve_sibling_path(
    import_span_src: ptr<u8>,
    name_start: i32,
    name_end: i32,
    search_dir: string,
    out_path: ptr<u8>,
    out_path_cap: i32
) -> i32 {
    if name_end <= name_start or out_path_cap <= 1 {
        return 0 - 1
    }
    let mut s: i32 = name_start
    let mut e: i32 = name_end
    # Strip leading '.' for relative imports.
    if import_span_src[s] == 46 {
        s = s + 1
    }
    # Strip quotes for string imports.
    if s < e and import_span_src[s] == 34 {
        s = s + 1
    }
    if e > s and import_span_src[e - 1] == 34 {
        e = e - 1
    }
    if e <= s {
        return 0 - 1
    }
    # Absolute path (starts with '/'): copy as-is.
    if import_span_src[s] == 47 {
        let nabs: i32 = e - s
        if nabs + 1 > out_path_cap {
            return 0 - 1
        }
        let mut ai: i32 = 0
        while ai < nabs {
            out_path[ai] = import_span_src[s + ai]
            ai = ai + 1
        }
        out_path[nabs] = 0
        return nabs
    }

    let dirp: ptr<u8> = search_dir
    let dlen: i32 = strlen(search_dir) as i32
    let mut has_slash: i32 = 0
    let mut si: i32 = s
    while si < e {
        if import_span_src[si] == 47 {
            has_slash = 1
        }
        si = si + 1
    }
    # Relative form `.name` (no slash after strip) → append .flow
    # String form may already end in .flow
    let mut need_flow: i32 = 0
    if has_slash == 0 {
        if import_span_src[name_start] == 46 {
            need_flow = 1
        } else {
            if e - s < 5 {
                need_flow = 1
            } else {
                if import_span_src[e - 5] != 46 or import_span_src[e - 4] != 102 or import_span_src[e - 3] != 108 or import_span_src[e - 2] != 111 or import_span_src[e - 1] != 119 {
                    need_flow = 1
                }
            }
        }
    }

    let namelen: i32 = e - s
    let mut total: i32 = dlen + 1 + namelen
    if need_flow == 1 {
        total = total + 5
    }
    if total + 1 > out_path_cap {
        return 0 - 1
    }
    let mut o: i32 = 0
    let mut di: i32 = 0
    while di < dlen {
        out_path[o] = dirp[di]
        o = o + 1
        di = di + 1
    }
    out_path[o] = 47
    o = o + 1
    let mut ni: i32 = 0
    while ni < namelen {
        out_path[o] = import_span_src[s + ni]
        o = o + 1
        ni = ni + 1
    }
    if need_flow == 1 {
        out_path[o] = 46
        o = o + 1
        out_path[o] = 102
        o = o + 1
        out_path[o] = 108
        o = o + 1
        out_path[o] = 111
        o = o + 1
        out_path[o] = 119
        o = o + 1
    }
    out_path[o] = 0
    return o
}

# Directory of a path (strip last `/component`). Writes into out; returns len or -1.
export function flowc_resolve_dirname(path: string, out: ptr<u8>, out_cap: i32) -> i32 {
    let p: ptr<u8> = path
    let n: i32 = strlen(path) as i32
    if n <= 0 or out_cap <= 1 {
        return 0 - 1
    }
    let mut last_slash: i32 = 0 - 1
    let mut i: i32 = 0
    while i < n {
        if p[i] == 47 {
            last_slash = i
        }
        i = i + 1
    }
    if last_slash < 0 {
        if out_cap < 2 {
            return 0 - 1
        }
        out[0] = 46
        out[1] = 0
        return 1
    }
    if last_slash == 0 {
        if out_cap < 2 {
            return 0 - 1
        }
        out[0] = 47
        out[1] = 0
        return 1
    }
    if last_slash + 1 > out_cap {
        return 0 - 1
    }
    let mut j: i32 = 0
    while j < last_slash {
        out[j] = p[j]
        j = j + 1
    }
    out[last_slash] = 0
    return last_slash
}

# Append unique path to store. Returns new length, or -1 on overflow / copy fail.
function flowc_resolve_append_path(store: ptr<u8>, n: i32, path: string) -> i32 {
    let path_p: ptr<u8> = path
    if flowc_resolve_find_path(store, n, FLOWC_RESOLVE_PATH_CAP, path_p) >= 0 {
        return n
    }
    if n >= FLOWC_RESOLVE_MAX_MODS {
        return 0 - 1
    }
    let slot: ptr<u8> = store + (n * FLOWC_RESOLVE_PATH_CAP)
    if flowc_resolve_copy_cstr(path, slot, FLOWC_RESOLVE_PATH_CAP) < 0 {
        return 0 - 1
    }
    return n + 1
}

# BFS-gather entry + relative/string imports into path_store (entry first).
# Returns module count, or -1 on failure.
function flowc_resolve_gather(
    entry_path: string,
    search_dir: string,
    path_store: ptr<u8>
) -> i32 {
    let mut n: i32 = flowc_resolve_append_path(path_store, 0, entry_path)
    if n < 0 {
        return 0 - 1
    }

    let src: ptr<u8> = malloc(FLOWC_RESOLVE_SRC_CAP as i64)
    let imp_path: ptr<u8> = malloc(FLOWC_RESOLVE_PATH_CAP as i64)
    if src == null or imp_path == null {
        if src != null {
            free(src)
        }
        if imp_path != null {
            free(imp_path)
        }
        return 0 - 1
    }

    let mut qi: i32 = 0
    while qi < n {
        let slot: ptr<u8> = path_store + (qi * FLOWC_RESOLVE_PATH_CAP)
        let mpath: string = slot

        let mut zi: i32 = 0
        while zi < FLOWC_RESOLVE_SRC_CAP {
            src[zi] = 0
            zi = zi + 1
        }
        let nsrc: i32 = flowc_read_file(mpath, src, FLOWC_RESOLVE_SRC_CAP - 1)
        if nsrc <= 0 {
            free(imp_path)
            free(src)
            return 0 - 1
        }
        src[nsrc] = 0

        let mut p: Parser = flowc_parser_new(src, nsrc, FLOWC_RESOLVE_AST_CAP)
        let root: i32 = flowc_parse_program(&p)
        if root < 0 or p.err != 0 {
            flowc_parser_free(p)
            free(imp_path)
            free(src)
            return 0 - 1
        }

        let mut ii: i32 = 0
        while ii < p.arena.len {
            if p.arena.nodes[ii].kind == AST_IMPORT {
                let form: i32 = p.arena.nodes[ii].ival
                if form == 1 or form == 2 {
                    let plen: i32 = flowc_resolve_sibling_path(
                        src,
                        p.arena.nodes[ii].name_start,
                        p.arena.nodes[ii].name_end,
                        search_dir,
                        imp_path,
                        FLOWC_RESOLVE_PATH_CAP
                    )
                    if plen < 0 {
                        flowc_parser_free(p)
                        free(imp_path)
                        free(src)
                        return 0 - 1
                    }
                    let dep: string = imp_path
                    let n2: i32 = flowc_resolve_append_path(path_store, n, dep)
                    if n2 < 0 {
                        flowc_parser_free(p)
                        free(imp_path)
                        free(src)
                        return 0 - 1
                    }
                    n = n2
                }
            }
            ii = ii + 1
        }

        flowc_parser_free(p)
        qi = qi + 1
    }

    free(imp_path)
    free(src)
    return n
}

# Emit one module's C into `out` (remaining capacity `out_cap`).
# flags forwarded to flowc_cgen_emit_ex.
function flowc_resolve_emit_one(path: string, out: ptr<u8>, out_cap: i32, flags: i32) -> i32 {
    let src: ptr<u8> = malloc(FLOWC_RESOLVE_SRC_CAP as i64)
    if src == null {
        return 0 - 1
    }
    let mut zi: i32 = 0
    while zi < FLOWC_RESOLVE_SRC_CAP {
        src[zi] = 0
        zi = zi + 1
    }
    let nsrc: i32 = flowc_read_file(path, src, FLOWC_RESOLVE_SRC_CAP - 1)
    if nsrc <= 0 {
        free(src)
        return 0 - 1
    }
    src[nsrc] = 0

    let mut p: Parser = flowc_parser_new(src, nsrc, FLOWC_RESOLVE_AST_CAP)
    let root: i32 = flowc_parse_program(&p)
    if root < 0 or p.err != 0 {
        flowc_parser_free(p)
        free(src)
        return 0 - 1
    }

    let n: i32 = flowc_cgen_emit_ex(p.arena, root, src, out, out_cap, flags)
    flowc_parser_free(p)
    free(src)
    return n
}

# Cross-file Stage-A typecheck for a bundle.
# Gather BFS (entry first); check deps-first with a growing seed of exports
# from already-checked modules. Returns total error count (0 = ok), or 1 on I/O/parse fail.
export function flowc_bundle_typecheck(entry_path: string, search_dir: string) -> i32 {
    let path_store: ptr<u8> = malloc((FLOWC_RESOLVE_MAX_MODS * FLOWC_RESOLVE_PATH_CAP) as i64)
    if path_store == null {
        return 1
    }
    let mut zi: i32 = 0
    let psz: i32 = FLOWC_RESOLVE_MAX_MODS * FLOWC_RESOLVE_PATH_CAP
    while zi < psz {
        path_store[zi] = 0
        zi = zi + 1
    }

    let nmods: i32 = flowc_resolve_gather(entry_path, search_dir, path_store)
    if nmods <= 0 {
        free(path_store)
        return 1
    }

    # Typed null: bare `null` breaks host C mangling (emits flowc_tc_init not _ptr_u8).
    let no_src: ptr<u8> = null
    let mut ctx: TcCtx = flowc_tc_init(no_src)
    if ctx.ns == null {
        free(path_store)
        return 1
    }

    let src: ptr<u8> = malloc(FLOWC_RESOLVE_SRC_CAP as i64)
    if src == null {
        flowc_tc_free(&ctx)
        free(path_store)
        return 1
    }

    let mut total_err: i32 = 0
    # Reverse BFS: deepest deps first, entry last (same order as emit).
    let mut mi: i32 = nmods
    while mi > 0 {
        mi = mi - 1
        let slot: ptr<u8> = path_store + (mi * FLOWC_RESOLVE_PATH_CAP)
        let mpath: string = slot

        zi = 0
        while zi < FLOWC_RESOLVE_SRC_CAP {
            src[zi] = 0
            zi = zi + 1
        }
        let nsrc: i32 = flowc_read_file(mpath, src, FLOWC_RESOLVE_SRC_CAP - 1)
        if nsrc <= 0 {
            free(src)
            flowc_tc_free(&ctx)
            free(path_store)
            return 1
        }
        src[nsrc] = 0

        let mut p: Parser = flowc_parser_new(src, nsrc, FLOWC_RESOLVE_AST_CAP)
        let root: i32 = flowc_parse_program(&p)
        if root < 0 or p.err != 0 {
            flowc_parser_free(p)
            free(src)
            flowc_tc_free(&ctx)
            free(path_store)
            return 1
        }

        flowc_tc_reset_module(&ctx, src)
        let errs: i32 = flowc_tc_check_program(&ctx, p.arena, root)
        total_err = total_err + errs

        # Keep only seeds; register this module's exports for later modules.
        ctx.nlen = ctx.seed_nlen
        flowc_tc_seed_export(&ctx, p.arena, root, src)

        flowc_parser_free(p)
    }

    free(src)
    flowc_tc_free(&ctx)
    free(path_store)
    return total_err
}

# Resolve entry + relative/string imports, emit concatenated C (deps then entry).
# Gather is BFS (entry first); emit reverses so deps come first.
# Returns bytes written, or -1 on failure.
export function flowc_bundle_emit(
    entry_path: string,
    search_dir: string,
    out: ptr<u8>,
    out_cap: i32
) -> i32 {
    let path_store: ptr<u8> = malloc((FLOWC_RESOLVE_MAX_MODS * FLOWC_RESOLVE_PATH_CAP) as i64)
    if path_store == null {
        return 0 - 1
    }
    let mut zi: i32 = 0
    let psz: i32 = FLOWC_RESOLVE_MAX_MODS * FLOWC_RESOLVE_PATH_CAP
    while zi < psz {
        path_store[zi] = 0
        zi = zi + 1
    }

    let nmods: i32 = flowc_resolve_gather(entry_path, search_dir, path_store)
    if nmods <= 0 {
        free(path_store)
        return 0 - 1
    }

    let mut written: i32 = 0
    # Reverse BFS order: last discovered (deepest deps) first, entry last.
    let mut mi: i32 = nmods
    let mut first: i32 = 1
    while mi > 0 {
        mi = mi - 1
        let slot: ptr<u8> = path_store + (mi * FLOWC_RESOLVE_PATH_CAP)
        let mpath: string = slot
        let mut flags: i32 = 0
        if first == 0 {
            flags = 1
        }
        first = 0
        let dest: ptr<u8> = out + written
        let rem: i32 = out_cap - written
        if rem <= 0 {
            free(path_store)
            return 0 - 1
        }
        let n: i32 = flowc_resolve_emit_one(mpath, dest, rem, flags)
        if n <= 0 {
            free(path_store)
            return 0 - 1
        }
        written = written + n
        if written < out_cap {
            out[written] = 10
            written = written + 1
        }
    }

    free(path_store)
    return written
}
