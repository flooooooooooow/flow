# @module flowc.semantic_facts
# @means  Shared fact/evidence representation for static, denotational and runtime semantics.
#
# Soundness rule:
#   OBSERVED facts are evidence only.
#   PROVEN facts may drive unconditional rewrites.
#   GUARDED facts may drive specialised paths only when the guard is emitted.
# Recognition and residual analysis never upgrade epistemic status by themselves.

export const FLOWC_FACT_NONE: i32 = 0
export const FLOWC_FACT_CONSTANT: i32 = 1
export const FLOWC_FACT_RANGE: i32 = 2
export const FLOWC_FACT_NONZERO: i32 = 3
export const FLOWC_FACT_NONNEGATIVE: i32 = 4
export const FLOWC_FACT_NONPOSITIVE: i32 = 5
export const FLOWC_FACT_POSITIVE: i32 = 6
export const FLOWC_FACT_NEGATIVE: i32 = 7
export const FLOWC_FACT_CONGRUENCE: i32 = 8
export const FLOWC_FACT_ALIGNMENT: i32 = 9
export const FLOWC_FACT_EQ: i32 = 10
export const FLOWC_FACT_NE: i32 = 11
export const FLOWC_FACT_LT: i32 = 12
export const FLOWC_FACT_LE: i32 = 13
export const FLOWC_FACT_GT: i32 = 14
export const FLOWC_FACT_GE: i32 = 15
export const FLOWC_FACT_TYPE: i32 = 16
export const FLOWC_FACT_EFFECT: i32 = 17
export const FLOWC_FACT_CONSTRAINT: i32 = 18
export const FLOWC_FACT_DENOTATION: i32 = 19

export const FLOWC_FACT_SOURCE_STATIC: i32 = 1
export const FLOWC_FACT_SOURCE_DENOTATIONAL: i32 = 2
export const FLOWC_FACT_SOURCE_DYNAMIC: i32 = 3
export const FLOWC_FACT_SOURCE_LEARNED: i32 = 4

export const FLOWC_FACT_STATUS_OBSERVED: i32 = 1
export const FLOWC_FACT_STATUS_CONTRACT: i32 = 2
export const FLOWC_FACT_STATUS_PROVEN: i32 = 3
export const FLOWC_FACT_STATUS_GUARDED: i32 = 4

export const FLOWC_RECOGNITION_NUMERICAL: i32 = 1
export const FLOWC_RECOGNITION_REALTIME: i32 = 2
export const FLOWC_RECOGNITION_CAUSAL: i32 = 4
export const FLOWC_RECOGNITION_SAFETY: i32 = 8
export const FLOWC_RECOGNITION_MEMORY: i32 = 16
export const FLOWC_RECOGNITION_ALL: i32 = 31

# Generic payload:
#   CONSTANT: lo=value
#   RANGE: lo=min, hi=max
#   CONGRUENCE: lo=residue, aux=modulus
#   ALIGNMENT: aux=power-of-two alignment
#   binary relations: left_id/right_id, payload unused
# confidence_ppm is evidence metadata, never a proof strength.
export struct FlowcSemanticFact {
    kind: i32,
    left_id: i32,
    right_id: i32,
    lo: i64,
    hi: i64,
    aux: u64,
    provenance: i32,
    status: i32,
    domain_mask: i32,
    samples: i32,
    confidence_ppm: i32
}

export function flowc_fact_none() -> FlowcSemanticFact {
    return FlowcSemanticFact {
        kind: FLOWC_FACT_NONE,
        left_id: -1,
        right_id: -1,
        lo: 0,
        hi: 0,
        aux: 0,
        provenance: FLOWC_FACT_SOURCE_STATIC,
        status: FLOWC_FACT_STATUS_OBSERVED,
        domain_mask: 0,
        samples: 0,
        confidence_ppm: 0
    }
}

export function flowc_fact_make(
    kind: i32,
    left_id: i32,
    right_id: i32,
    lo: i64,
    hi: i64,
    aux: u64,
    provenance: i32,
    status: i32,
    domain_mask: i32,
    samples: i32,
    confidence_ppm: i32
) -> FlowcSemanticFact {
    return FlowcSemanticFact {
        kind: kind,
        left_id: left_id,
        right_id: right_id,
        lo: lo,
        hi: hi,
        aux: aux,
        provenance: provenance,
        status: status,
        domain_mask: domain_mask,
        samples: samples,
        confidence_ppm: confidence_ppm
    }
}

export function flowc_fact_constant(
    value_id: i32,
    value: i64,
    provenance: i32,
    status: i32,
    domain_mask: i32,
    samples: i32
) -> FlowcSemanticFact {
    return flowc_fact_make(
        FLOWC_FACT_CONSTANT, value_id, -1, value, value, 0,
        provenance, status, domain_mask, samples, 1000000
    )
}

export function flowc_fact_range(
    value_id: i32,
    lo: i64,
    hi: i64,
    provenance: i32,
    status: i32,
    domain_mask: i32,
    samples: i32
) -> FlowcSemanticFact {
    return flowc_fact_make(
        FLOWC_FACT_RANGE, value_id, -1, lo, hi, 0,
        provenance, status, domain_mask, samples, 1000000
    )
}

export function flowc_fact_unary(
    kind: i32,
    value_id: i32,
    provenance: i32,
    status: i32,
    domain_mask: i32,
    samples: i32
) -> FlowcSemanticFact {
    return flowc_fact_make(
        kind, value_id, -1, 0, 0, 0,
        provenance, status, domain_mask, samples, 1000000
    )
}

export function flowc_fact_congruence(
    value_id: i32,
    residue: i64,
    modulus: u64,
    provenance: i32,
    status: i32,
    domain_mask: i32,
    samples: i32
) -> FlowcSemanticFact {
    return flowc_fact_make(
        FLOWC_FACT_CONGRUENCE, value_id, -1, residue, residue, modulus,
        provenance, status, domain_mask, samples, 1000000
    )
}

export function flowc_fact_alignment(
    value_id: i32,
    alignment: u64,
    provenance: i32,
    status: i32,
    domain_mask: i32,
    samples: i32
) -> FlowcSemanticFact {
    return flowc_fact_make(
        FLOWC_FACT_ALIGNMENT, value_id, -1, 0, 0, alignment,
        provenance, status, domain_mask, samples, 1000000
    )
}

export function flowc_fact_relation(
    kind: i32,
    left_id: i32,
    right_id: i32,
    provenance: i32,
    status: i32,
    domain_mask: i32,
    samples: i32
) -> FlowcSemanticFact {
    return flowc_fact_make(
        kind, left_id, right_id, 0, 0, 0,
        provenance, status, domain_mask, samples, 1000000
    )
}

export function flowc_fact_valid(fact: FlowcSemanticFact) -> i32 {
    if fact.kind == FLOWC_FACT_NONE {
        return 0
    }
    return 1
}

# Semantic identity deliberately ignores provenance, status and support.
# Two recognisers represent the same relation when the relation payload matches.
export function flowc_fact_equivalent(
    a: FlowcSemanticFact,
    b: FlowcSemanticFact
) -> i32 {
    if a.kind != b.kind { return 0 }
    if a.left_id != b.left_id { return 0 }
    if a.right_id != b.right_id { return 0 }
    if a.lo != b.lo { return 0 }
    if a.hi != b.hi { return 0 }
    if a.aux != b.aux { return 0 }
    return 1
}

export function flowc_fact_visible(
    fact: FlowcSemanticFact,
    active_domains: i32
) -> i32 {
    if flowc_fact_valid(fact) == 0 {
        return 0
    }
    if (fact.domain_mask & active_domains) == 0 {
        return 0
    }
    return 1
}

# The single authority boundary for optimisation consumers.
export function flowc_fact_can_optimize(fact: FlowcSemanticFact) -> i32 {
    if fact.status == FLOWC_FACT_STATUS_PROVEN {
        return 1
    }
    if fact.status == FLOWC_FACT_STATUS_GUARDED {
        return 1
    }
    return 0
}

export function flowc_fact_promote(
    fact: FlowcSemanticFact,
    statically_proven: i32,
    guard_available: i32
) -> FlowcSemanticFact {
    let mut out: FlowcSemanticFact = fact
    if flowc_fact_valid(fact) == 0 {
        return out
    }
    if statically_proven != 0 {
        out.status = FLOWC_FACT_STATUS_PROVEN
        return out
    }
    if guard_available != 0 {
        out.status = FLOWC_FACT_STATUS_GUARDED
        return out
    }
    return out
}
