# @module flowc.semver
# @means  Registry version parsing and requirement matching.
#
# Same rules as the package registry has always used:
#   parse:  leading X.Y.Z after stripping whitespace and leading "v"s; the
#           build ("+...") and pre-release ("-...") tails are ignored; a part
#           that is not an integer counts as 0.
#   match:  "*", "" and "latest" match anything; "^x.y.z" (same major, and for
#           0.x the same minor); ">=x.y.z"; "==x.y.z"; otherwise exact.

extern {
    function strlen(s: string) -> i64
    function malloc(size: i64) -> ptr<void>
}

export struct Semver {
    major: i64,
    minor: i64,
    patch: i64
}

function sv_space(c: i32) -> bool {
    return c == 32 or (c >= 9 and c <= 13) or (c >= 28 and c <= 31)
}

# Python int(text) for ASCII text: surrounding whitespace, an optional sign,
# digits with single underscores between them. Writes the value into out[0]
# and returns true, or returns false where Python raises ValueError.
export function flowc_semver_py_int(p: ptr<u8>, start: i32, end: i32, out: ptr<i64>) -> bool {
    let mut a: i32 = start
    let mut b: i32 = end
    while a < b and sv_space(p[a] as i32) {
        a = a + 1
    }
    while b > a and sv_space(p[b - 1] as i32) {
        b = b - 1
    }
    let mut neg: bool = false
    if a < b and (p[a] == 43 or p[a] == 45) {
        neg = p[a] == 45
        a = a + 1
    }
    if a >= b {
        return false
    }
    let mut v: i64 = 0
    let mut prev_digit: bool = false
    let mut i: i32 = a
    while i < b {
        let c: i32 = p[i] as i32
        if c >= 48 and c <= 57 {
            v = v * 10 + ((c - 48) as i64)
            prev_digit = true
        } else {
            if c == 95 and prev_digit and i + 1 < b {
                prev_digit = false
            } else {
                return false
            }
        }
        i = i + 1
    }
    if prev_digit == false {
        return false
    }
    if neg {
        v = 0 - v
    }
    out[0] = v
    return true
}

export function flowc_semver_parse(v_str: string) -> Semver {
    let p: ptr<u8> = v_str as ptr<u8>
    let n: i32 = strlen(v_str) as i32
    let mut a: i32 = 0
    let mut b: i32 = n
    while a < b and sv_space(p[a] as i32) {
        a = a + 1
    }
    while b > a and sv_space(p[b - 1] as i32) {
        b = b - 1
    }
    while a < b and p[a] == 118 {
        a = a + 1
    }
    # split("+")[0] then split("-")[0]
    let mut e: i32 = a
    while e < b and p[e] != 43 {
        e = e + 1
    }
    let mut e2: i32 = a
    while e2 < e and p[e2] != 45 {
        e2 = e2 + 1
    }
    let parts: array<i64, 3> = [0, 0, 0]
    let mut idx: i32 = 0
    let mut s: i32 = a
    let mut k: i32 = a
    let val: array<i64, 1> = [0]
    while idx < 3 {
        if s > e2 {
            break
        }
        k = s
        while k < e2 and p[k] != 46 {
            k = k + 1
        }
        if flowc_semver_py_int(p, s, k, &val[0] as ptr<i64>) {
            parts[idx] = val[0]
        } else {
            parts[idx] = 0
        }
        idx = idx + 1
        s = k + 1
    }
    return Semver { major: parts[0], minor: parts[1], patch: parts[2] }
}

# -1, 0 or 1 comparing a with b as (major, minor, patch) tuples.
export function flowc_semver_cmp(a: Semver, b: Semver) -> i32 {
    if a.major != b.major {
        if a.major < b.major {
            return -1
        }
        return 1
    }
    if a.minor != b.minor {
        if a.minor < b.minor {
            return -1
        }
        return 1
    }
    if a.patch != b.patch {
        if a.patch < b.patch {
            return -1
        }
        return 1
    }
    return 0
}

function sv_tail(p: ptr<u8>, from: i32) -> string {
    return (p + from) as string
}

export function flowc_semver_matches(requirement: string, version: string) -> bool {
    let p: ptr<u8> = requirement as ptr<u8>
    let n: i32 = strlen(requirement) as i32
    let mut a: i32 = 0
    let mut b: i32 = n
    while a < b and sv_space(p[a] as i32) {
        a = a + 1
    }
    while b > a and sv_space(p[b - 1] as i32) {
        b = b - 1
    }
    let req: ptr<u8> = malloc((b - a + 1) as i64) as ptr<u8>
    let mut i: i32 = 0
    while i < b - a {
        req[i] = p[a + i]
        i = i + 1
    }
    req[b - a] = 0
    let rn: i32 = b - a
    if rn == 0 {
        return true
    }
    if rn == 1 and req[0] == 42 {
        return true
    }
    if rn == 6 and req[0] == 108 and req[1] == 97 and req[2] == 116 and req[3] == 101 and req[4] == 115 and req[5] == 116 {
        return true
    }
    let ver: Semver = flowc_semver_parse(version)
    if req[0] == 94 {
        let base: Semver = flowc_semver_parse(sv_tail(req, 1))
        if ver.major != base.major {
            return false
        }
        if base.major == 0 {
            return ver.minor == base.minor and ver.patch >= base.patch
        }
        return flowc_semver_cmp(ver, base) >= 0
    }
    if rn >= 2 and req[0] == 62 and req[1] == 61 {
        return flowc_semver_cmp(ver, flowc_semver_parse(sv_tail(req, 2))) >= 0
    }
    if rn >= 2 and req[0] == 61 and req[1] == 61 {
        return flowc_semver_cmp(ver, flowc_semver_parse(sv_tail(req, 2))) == 0
    }
    return flowc_semver_cmp(ver, flowc_semver_parse(req as string)) == 0
}
