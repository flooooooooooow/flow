# @module flowc.sem_model
# @means  The state and the type-level rules of the semantic type checker,
#         a port of src/flow/type_checker.py (TypeChecker) to flowc.
#
# sem_check.flow walks declarations, statements and expressions; this module
# holds what that walk reads and writes: the program (its modules and the
# Python checker's flat declaration list), symbols and scopes, the struct,
# effect and unit tables, the diagnostics, and the rules that compare and
# resolve types (_parse_type, _can_coerce, _is_compatible, _can_cast, the
# unit arithmetic and the attribute vocabulary of src/flow/attributes.py).
#
# Every function mirrors the Python method it is named after, including its
# quirks: the goal is the same verdict and the same message for every
# program (compiler/scripts/parity_typecheck.flow).

import .ast {
    AstArena, AST_NONE, AST_TYPE, AST_EFFECT_ROW, AST_TYPE_FIXED_ARRAY,
    AST_TYPE_CAPABILITY, AST_TYPE_SPAN_MUTABLE
}
import .token { Lexer, Token, TOK_EOF, TOK_IDENT, TOK_KEYWORD, TOK_INT, TOK_FLOAT, TOK_STRING, TOK_AT, TOK_LPAREN, TOK_RPAREN, TOK_COMMA, TOK_EQ }
import .lexer { flowc_lexer_new, flowc_lexer_next }
import .sem_util {
    SemIntVec, SemStrVec, SemStrMap, SemPtrVec,
    sem_s_len, sem_s_eq, sem_s_starts, sem_s_ends, sem_s_byte, sem_s_slice, sem_s_from, sem_s_span, sem_s_span_is,
    sem_s_find, sem_s_contains, sem_s_index_byte, sem_s_itoa, sem_s_is_digit, sem_s_is_alpha, sem_s_strip, sem_s_split,
    sem_iv_new, sem_iv_push, sem_iv_get, sem_iv_has, sem_sv_new, sem_sv_push, sem_sv_get, sem_sv_has, sem_sv_add, sem_sv_sort, sem_sv_join,
    sem_sm_new, sem_sm_get, sem_sm_has, sem_sm_put, sem_pv_new, sem_pv_push, sem_pv_get, sem_pv_set,
    sem_iv_set, sem_iv_len, sem_iv_setlen, sem_sv_len, sem_sv_setlen, sem_sv_set, sem_pv_len, sem_pv_setlen
}
import .sem_types {
    SemTys, NO_SIZE,
    TK_VOID, TK_BOOL, TK_I8, TK_I16, TK_I32, TK_I64, TK_I128, TK_U8, TK_U16, TK_U32,
    TK_U64, TK_U128, TK_F32, TK_F64, TK_C64, TK_C128, TK_STRING, TK_STRUCT, TK_ARRAY,
    TK_SPAN, TK_POINTER, TK_FUNCTION, TK_NULL, TK_TYPE_ALIAS, TK_DISTINCT, TK_UNKNOWN,
    sem_tys_new, sem_ty_mk, sem_ty_named, sem_ty_ptr, sem_ty_array, sem_ty_struct, sem_ty_unknown, sem_ty_kind, sem_ty_name,
    sem_ty_nparams, sem_ty_param, sem_ty_add_param, sem_ty_neffects, sem_ty_effect, sem_ty_add_effect, sem_ty_str, sem_ty_eq,
    sem_tk_is_int, sem_tk_is_float, sem_tk_is_numeric, sem_tk_is_complex,
    sem_span_is_mutable, sem_is_span_type_name, sem_span_element_name, sem_format_span_type,
    sem_dims_new, sem_dims_normalize, sem_dims_combine, sem_dims_scale, sem_dims_eq, sem_dims_key,
    sem_pt_mk, sem_pt_name, sem_pt_nargs, sem_pt_arg, sem_pt_add_arg, sem_pt_add_effect, sem_pt_neffects, sem_pt_copy
}

extern {
    function malloc(size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
    function getenv(name: string) -> string
}

# Declaration kinds (the classes of the Python declaration list).
export const DK_FUNC: i32 = 1
export const DK_STRUCT: i32 = 2
export const DK_ENUM: i32 = 3
export const DK_ALIAS: i32 = 4
export const DK_DISTINCT: i32 = 5
export const DK_UNIT: i32 = 6
export const DK_EXTERN_TYPE: i32 = 7
export const DK_EFFECT: i32 = 8
export const DK_CAPABILITY: i32 = 9
export const DK_TRAIT: i32 = 10
export const DK_IMPL: i32 = 11
export const DK_CONST: i32 = 12
export const DK_STATIC: i32 = 13

# Struct-table entry kinds (what struct_types maps a name to).
export const SE_STRUCT: i32 = 1
export const SE_ALIAS: i32 = 2
export const SE_DISTINCT: i32 = 3

# Symbol kinds.
export const SK_FUNCTION: i32 = 1
export const SK_VARIABLE: i32 = 2
export const SK_CONST: i32 = 3
export const SK_TYPE: i32 = 4

export struct Sem {
    t: ptr<SemTys>,
    strict: bool,
    check_effect_rows: bool,
    safety_profile: bool,
    # modules
    nm: i32,
    m_ar: ptr<AstArena>,
    m_root: ptr<i32>,
    m_src: ptr<ptr<u8>>,
    m_path: ptr<string>,
    m_lines: ptr<SemPtrVec>,
    m_rows: ptr<SemPtrVec>,
    cm: i32,
    ar: AstArena,
    src: ptr<u8>,
    pos: i32,
    # the declaration list
    d_kind: ptr<SemIntVec>,
    d_mod: ptr<SemIntVec>,
    d_node: ptr<SemIntVec>,
    d_name: ptr<SemStrVec>,
    d_info: ptr<SemIntVec>,
    d_astart: ptr<SemIntVec>,
    d_alen: ptr<SemIntVec>,
    attr_pool: ptr<SemStrVec>,
    # functions (FunctionDecl)
    fi_name: ptr<SemStrVec>,
    fi_mangled: ptr<SemStrVec>,
    fi_mod: ptr<SemIntVec>,
    fi_node: ptr<SemIntVec>,
    fi_pstart: ptr<SemIntVec>,
    fi_plen: ptr<SemIntVec>,
    fi_ret: ptr<SemIntVec>,
    fi_astart: ptr<SemIntVec>,
    fi_alen: ptr<SemIntVec>,
    fi_extern: ptr<SemIntVec>,
    fi_variadic: ptr<SemIntVec>,
    fi_tpstart: ptr<SemIntVec>,
    fi_tplen: ptr<SemIntVec>,
    fi_estart: ptr<SemIntVec>,
    fi_elen: ptr<SemIntVec>,
    fi_body: ptr<SemIntVec>,
    fi_has_self: ptr<SemIntVec>,
    fp_names: ptr<SemStrVec>,
    fp_types: ptr<SemIntVec>,
    tp_names: ptr<SemStrVec>,
    tp_bounds: ptr<SemStrVec>,
    ef_pool: ptr<SemStrVec>,
    # impls, traits, effects, capabilities
    im_type: ptr<SemStrVec>,
    im_trait: ptr<SemStrVec>,
    im_methods: ptr<SemPtrVec>,
    # struct table entries
    se_name: ptr<SemStrVec>,
    se_kind: ptr<SemIntVec>,
    se_fstart: ptr<SemIntVec>,
    se_flen: ptr<SemIntVec>,
    se_base: ptr<SemIntVec>,
    se_tpstart: ptr<SemIntVec>,
    se_tplen: ptr<SemIntVec>,
    se_decl: ptr<SemIntVec>,
    sf_names: ptr<SemStrVec>,
    sf_types: ptr<SemIntVec>,
    struct_types: ptr<SemStrMap>,
    generic_struct_types: ptr<SemStrMap>,
    opaque_c_types: ptr<SemStrMap>,
    generic_function_decls: ptr<SemStrMap>,
    active_type_params: ptr<SemStrVec>,
    effect_types: ptr<SemStrMap>,
    capability_types: ptr<SemStrMap>,
    enum_decls: ptr<SemStrMap>,
    enum_variant_owner: ptr<SemStrMap>,
    trait_types: ptr<SemStrMap>,
    impl_pairs: ptr<SemStrMap>,
    impl_methods: ptr<SemStrMap>,
    impl_method_lists: ptr<SemPtrVec>,
    unit_base_order: ptr<SemStrVec>,
    unit_dims: ptr<SemStrMap>,
    unit_dim_list: ptr<SemPtrVec>,
    unit_canonical: ptr<SemStrMap>,
    unit_canonical_names: ptr<SemStrVec>,
    # symbols and scopes
    sy_name: ptr<SemStrVec>,
    sy_type: ptr<SemIntVec>,
    sy_kind: ptr<SemIntVec>,
    sy_mut: ptr<SemIntVec>,
    sy_def: ptr<SemIntVec>,
    sy_over: ptr<SemPtrVec>,
    g_scope: ptr<SemStrMap>,
    ls_name: ptr<SemStrVec>,
    ls_sym: ptr<SemIntVec>,
    frames: ptr<SemIntVec>,
    # diagnostics
    errors: ptr<SemStrVec>,
    err_mod: ptr<SemIntVec>,
    err_pos: ptr<SemIntVec>,
    fatal: ptr<SemStrVec>,
    warnings: ptr<SemStrVec>,
    warn_mod: ptr<SemIntVec>,
    warn_pos: ptr<SemIntVec>,
    relax_c_strings: bool,
    return_sink: ptr<SemIntVec>,
    # safety, domains, effects
    reason_pool: ptr<SemStrVec>,
    rt_unsafe_reason: ptr<SemStrMap>,
    heap_unsafe_reason: ptr<SemStrMap>,
    current_rt_safe_fn: string,
    current_safe_fn: string,
    rt_safe_from_domain: bool,
    handler_stack: ptr<SemPtrVec>,
    current_function_name: string,
    function_effects: ptr<SemStrMap>,
    function_effect_lists: ptr<SemPtrVec>,
    function_decls: ptr<SemStrMap>,
    static_names: ptr<SemStrMap>,
    local_storage: ptr<SemStrVec>,
    span_origin: ptr<SemStrMap>,
    origin_pool: ptr<SemStrVec>,
    current_return_type: i32,
    function_domains: ptr<SemStrMap>,
    static_domains: ptr<SemStrMap>,
    current_domain: i32,
    rdc_names: ptr<SemStrVec>,
    rdc_index: ptr<SemStrMap>,
    rdc_sets: ptr<SemPtrVec>,
    domain_reported: ptr<SemStrMap>,
    rt_site_fn: ptr<SemStrVec>,
    rt_site_name: ptr<SemStrVec>,
    rt_site_dom: ptr<SemIntVec>,
    dom_site_fn: ptr<SemStrVec>,
    dom_site_name: ptr<SemStrVec>,
    esc_static: ptr<SemStrMap>,
    esc_return: ptr<SemStrMap>,
    prop_keys: ptr<SemStrVec>,
    prop_index: ptr<SemStrMap>,
    prop_sets: ptr<SemPtrVec>,
    ref_seen: ptr<SemStrMap>,
    ref_key: ptr<SemStrVec>,
    ref_caller: ptr<SemStrVec>,
    ref_callee: ptr<SemStrVec>,
    ref_idx: ptr<SemIntVec>,
    ref_origin: ptr<SemStrVec>,
    ref_loc: ptr<SemStrVec>,
    # location of the statement being checked (for _location_suffix)
    stmt_node: i32,
    # A module holds an @cImport: the Python host read that header's
    # declarations; flowc does not, so names it may declare go unchecked.
    has_cimport: bool,
    # "mod:pipe block" -> the type of the block's source (fork placeholders)
    fork_src: ptr<SemStrMap>,
    # anonymous fork records by field signature, per module
    fork_sigs: ptr<SemStrMap>,
    fork_count: i32,
    # While checking an interpolation's expression (its own arena), error
    # positions stay at the string.
    pos_lock: bool,
    # @cImport headers (quotes stripped), the names they may declare, and
    # whether a header could not be read at all.
    cimport_headers: ptr<SemStrVec>,
    cimport_names: ptr<SemStrMap>,
    cimport_unknown: bool,
    root_mod: i32
}

export function sem_new(strict: bool) -> ptr<Sem> {
    # 8 KiB covers struct Sem (about 190 fields of at most 8 bytes);
    # sizeof<T>() is flowc-only, and this module keeps to the checker's rules.
    let c: ptr<Sem> = malloc(8192) as ptr<Sem>
    c.t = sem_tys_new()
    c.strict = strict
    c.check_effect_rows = false
    c.safety_profile = false
    let prof: string = getenv("FLOW_PROFILE")
    if prof as ptr<u8> != null {
        if sem_s_eq(prof, "safety") or sem_s_eq(prof, "flight") {
            c.safety_profile = true
        }
    }
    let se: string = getenv("FLOWC_STRICT_EFFECTS")
    if se as ptr<u8> != null {
        if sem_s_eq(se, "1") {
            c.check_effect_rows = true
        }
    }
    c.nm = 0
    c.m_ar = malloc(64 * 24) as ptr<AstArena>
    c.m_root = malloc(64 * 4) as ptr<i32>
    c.m_src = malloc(64 * 8) as ptr<ptr<u8>>
    c.m_path = malloc(64 * 8) as ptr<string>
    c.m_lines = sem_pv_new()
    c.m_rows = sem_pv_new()
    c.cm = 0 - 1
    c.src = null
    c.pos = 0
    c.d_kind = sem_iv_new()
    c.d_mod = sem_iv_new()
    c.d_node = sem_iv_new()
    c.d_name = sem_sv_new()
    c.d_info = sem_iv_new()
    c.d_astart = sem_iv_new()
    c.d_alen = sem_iv_new()
    c.attr_pool = sem_sv_new()
    c.fi_name = sem_sv_new()
    c.fi_mangled = sem_sv_new()
    c.fi_mod = sem_iv_new()
    c.fi_node = sem_iv_new()
    c.fi_pstart = sem_iv_new()
    c.fi_plen = sem_iv_new()
    c.fi_ret = sem_iv_new()
    c.fi_astart = sem_iv_new()
    c.fi_alen = sem_iv_new()
    c.fi_extern = sem_iv_new()
    c.fi_variadic = sem_iv_new()
    c.fi_tpstart = sem_iv_new()
    c.fi_tplen = sem_iv_new()
    c.fi_estart = sem_iv_new()
    c.fi_elen = sem_iv_new()
    c.fi_body = sem_iv_new()
    c.fi_has_self = sem_iv_new()
    c.fp_names = sem_sv_new()
    c.fp_types = sem_iv_new()
    c.tp_names = sem_sv_new()
    c.tp_bounds = sem_sv_new()
    c.ef_pool = sem_sv_new()
    c.im_type = sem_sv_new()
    c.im_trait = sem_sv_new()
    c.im_methods = sem_pv_new()
    c.se_name = sem_sv_new()
    c.se_kind = sem_iv_new()
    c.se_fstart = sem_iv_new()
    c.se_flen = sem_iv_new()
    c.se_base = sem_iv_new()
    c.se_tpstart = sem_iv_new()
    c.se_tplen = sem_iv_new()
    c.se_decl = sem_iv_new()
    c.sf_names = sem_sv_new()
    c.sf_types = sem_iv_new()
    c.struct_types = sem_sm_new()
    c.generic_struct_types = sem_sm_new()
    c.opaque_c_types = sem_sm_new()
    c.generic_function_decls = sem_sm_new()
    c.active_type_params = sem_sv_new()
    c.effect_types = sem_sm_new()
    c.capability_types = sem_sm_new()
    c.enum_decls = sem_sm_new()
    c.enum_variant_owner = sem_sm_new()
    c.trait_types = sem_sm_new()
    c.impl_pairs = sem_sm_new()
    c.impl_methods = sem_sm_new()
    c.impl_method_lists = sem_pv_new()
    c.unit_base_order = sem_sv_new()
    c.unit_dims = sem_sm_new()
    c.unit_dim_list = sem_pv_new()
    c.unit_canonical = sem_sm_new()
    c.unit_canonical_names = sem_sv_new()
    c.sy_name = sem_sv_new()
    c.sy_type = sem_iv_new()
    c.sy_kind = sem_iv_new()
    c.sy_mut = sem_iv_new()
    c.sy_def = sem_iv_new()
    c.sy_over = sem_pv_new()
    c.g_scope = sem_sm_new()
    c.ls_name = sem_sv_new()
    c.ls_sym = sem_iv_new()
    c.frames = sem_iv_new()
    c.errors = sem_sv_new()
    c.err_mod = sem_iv_new()
    c.err_pos = sem_iv_new()
    c.fatal = sem_sv_new()
    c.warnings = sem_sv_new()
    c.warn_mod = sem_iv_new()
    c.warn_pos = sem_iv_new()
    c.relax_c_strings = false
    c.return_sink = null
    c.reason_pool = sem_sv_new()
    c.rt_unsafe_reason = sem_sm_new()
    c.heap_unsafe_reason = sem_sm_new()
    c.current_rt_safe_fn = null
    c.current_safe_fn = null
    c.rt_safe_from_domain = false
    c.handler_stack = sem_pv_new()
    sem_pv_push(c.handler_stack, sem_sv_new() as ptr<void>)
    c.current_function_name = null
    c.function_effects = sem_sm_new()
    c.function_effect_lists = sem_pv_new()
    c.function_decls = sem_sm_new()
    c.static_names = sem_sm_new()
    c.local_storage = sem_sv_new()
    c.span_origin = sem_sm_new()
    c.origin_pool = sem_sv_new()
    c.current_return_type = 0 - 1
    c.function_domains = sem_sm_new()
    c.static_domains = sem_sm_new()
    c.current_domain = 0 - 1
    c.rdc_names = sem_sv_new()
    c.rdc_index = sem_sm_new()
    c.rdc_sets = sem_pv_new()
    c.domain_reported = sem_sm_new()
    c.rt_site_fn = sem_sv_new()
    c.rt_site_name = sem_sv_new()
    c.rt_site_dom = sem_iv_new()
    c.dom_site_fn = sem_sv_new()
    c.dom_site_name = sem_sv_new()
    c.esc_static = sem_sm_new()
    c.esc_return = sem_sm_new()
    c.prop_keys = sem_sv_new()
    c.prop_index = sem_sm_new()
    c.prop_sets = sem_pv_new()
    c.ref_seen = sem_sm_new()
    c.ref_key = sem_sv_new()
    c.ref_caller = sem_sv_new()
    c.ref_callee = sem_sv_new()
    c.ref_idx = sem_iv_new()
    c.ref_origin = sem_sv_new()
    c.ref_loc = sem_sv_new()
    c.stmt_node = 0 - 1
    c.has_cimport = false
    c.fork_src = sem_sm_new()
    c.fork_sigs = sem_sm_new()
    c.fork_count = 0
    c.pos_lock = false
    c.cimport_headers = sem_sv_new()
    c.cimport_names = sem_sm_new()
    c.cimport_unknown = false
    c.root_mod = 0 - 1
    # Builtin implicit UI layout state pointer.
    let ui: i32 = sem_sym_new(c, "_ui_state", sem_ty_ptr(c.t, sem_ty_mk(c.t, TK_VOID)), SK_VARIABLE)
    sem_iv_set(c.sy_mut, ui, 1)
    sem_scope_define_global(c, ui)
    return c
}

# ---------------------------------------------------------------------------
# Modules and AST access
# ---------------------------------------------------------------------------

export function sem_add_module(c: ptr<Sem>, arena: AstArena, root: i32, src: ptr<u8>, path: string) -> i32 {
    let m: i32 = c.nm
    c.m_ar[m] = arena
    c.m_root[m] = root
    c.m_src[m] = src
    c.m_path[m] = path
    sem_pv_push(c.m_lines, null)
    # owner node -> AST_EFFECT_ROW node, for the `with` rows of functions and
    # function types (the row records its owner in b).
    let rows: ptr<SemIntVec> = sem_iv_new()
    let mut i: i32 = 0
    while i < arena.len {
        sem_iv_push(rows, 0 - 1)
        i = i + 1
    }
    i = 0
    while i < arena.len {
        if arena.nodes[i].kind == AST_EFFECT_ROW {
            let owner: i32 = arena.nodes[i].b
            if owner >= 0 and owner < arena.len {
                rows.data[owner] = i
            }
        }
        i = i + 1
    }
    sem_pv_push(c.m_rows, rows as ptr<void>)
    c.nm = m + 1
    return m
}

export function sem_set_mod(c: ptr<Sem>, m: i32) {
    c.cm = m
    c.ar = c.m_ar[m]
    c.src = c.m_src[m]
}

export function sem_nk(c: ptr<Sem>, id: i32) -> i32 {
    if id < 0 {
        return 0
    }
    return c.ar.nodes[id].kind
}

export function sem_na(c: ptr<Sem>, id: i32) -> i32 {
    return c.ar.nodes[id].a
}

export function sem_nb(c: ptr<Sem>, id: i32) -> i32 {
    return c.ar.nodes[id].b
}

export function sem_ncc(c: ptr<Sem>, id: i32) -> i32 {
    return c.ar.nodes[id].c
}

export function sem_nnext(c: ptr<Sem>, id: i32) -> i32 {
    return c.ar.nodes[id].next
}

export function sem_nival(c: ptr<Sem>, id: i32) -> i32 {
    return c.ar.nodes[id].ival
}

export function sem_nstart(c: ptr<Sem>, id: i32) -> i32 {
    return c.ar.nodes[id].start
}

export function sem_nend(c: ptr<Sem>, id: i32) -> i32 {
    return c.ar.nodes[id].end
}

export function sem_nname(c: ptr<Sem>, id: i32) -> string {
    return sem_s_span(c.src, c.ar.nodes[id].name_start, c.ar.nodes[id].name_end)
}

export function sem_nname_is(c: ptr<Sem>, id: i32, lit: string) -> bool {
    return sem_s_span_is(c.src, c.ar.nodes[id].name_start, c.ar.nodes[id].name_end, lit)
}

export function sem_nlen(c: ptr<Sem>, first: i32) -> i32 {
    let mut n: i32 = 0
    let mut k: i32 = first
    while k != AST_NONE {
        n = n + 1
        k = c.ar.nodes[k].next
    }
    return n
}

# The effect row node of an AST_FN / function AST_TYPE, or -1.
export function sem_row_of(c: ptr<Sem>, owner: i32) -> i32 {
    let rows: ptr<SemIntVec> = sem_pv_get(c.m_rows, c.cm) as ptr<SemIntVec>
    if owner < 0 or owner >= rows.len {
        return 0 - 1
    }
    return rows.data[owner]
}

function sem_line_starts(c: ptr<Sem>, m: i32) -> ptr<SemIntVec> {
    let cached: ptr<SemIntVec> = sem_pv_get(c.m_lines, m) as ptr<SemIntVec>
    if cached != null {
        return cached
    }
    let v: ptr<SemIntVec> = sem_iv_new()
    sem_iv_push(v, 0)
    let src: ptr<u8> = c.m_src[m]
    let mut i: i32 = 0
    while src[i] != 0 {
        if src[i] == 10 {
            sem_iv_push(v, i + 1)
        }
        i = i + 1
    }
    sem_pv_set(c.m_lines, m, v as ptr<void>)
    return v
}

# 1-based line of byte offset `pos` in module `m`.
export function sem_line_of(c: ptr<Sem>, m: i32, pos: i32) -> i32 {
    let v: ptr<SemIntVec> = sem_line_starts(c, m)
    let mut lo: i32 = 0
    let mut hi: i32 = v.len - 1
    while lo < hi {
        let mid: i32 = (lo + hi + 1) / 2
        if v.data[mid] <= pos {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    return lo + 1
}

# 1-based column of byte offset `pos` in module `m`.
export function sem_col_of(c: ptr<Sem>, m: i32, pos: i32) -> i32 {
    let v: ptr<SemIntVec> = sem_line_starts(c, m)
    let ln: i32 = sem_line_of(c, m, pos)
    return pos - v.data[ln - 1] + 1
}

# The line (want_col false) or column the Python lexer gives the token at
# byte `pos` of module m. That lexer counts a newline only when it starts a
# run of whitespace: its WHITESPACE pattern `\s+` swallows every newline
# after the first character of a run, so a line holding only spaces does not
# count. Columns advance by the tab-expanded (expandtabs(4)) length of every
# token, comment and whitespace run, and reset at a counted newline. The
# messages that print a line or a column print these numbers.
export function sem_py_pos(c: ptr<Sem>, m: i32, pos: i32, want_col: bool) -> i32 {
    let src: ptr<u8> = c.m_src[m]
    let mut line: i32 = 1
    let mut col: i32 = 1
    let mut i: i32 = 0
    while i < pos and src[i] != 0 {
        let ch: i32 = src[i] as i32
        if ch == 35 {
            let mut k: i32 = 0
            while src[i] != 0 and src[i] != 10 {
                if src[i] == 9 {
                    k = k + 4 - (k % 4)
                } else {
                    k = k + 1
                }
                i = i + 1
            }
            col = col + k
        } elif ch == 10 {
            line = line + 1
            col = 1
            i = i + 1
        } elif ch == 32 or ch == 9 or ch == 13 or ch == 12 or ch == 11 {
            let mut k2: i32 = 0
            let mut kc: i32 = 0
            while src[i] == 32 or src[i] == 9 or src[i] == 13 or src[i] == 12 or src[i] == 11 or src[i] == 10 {
                if src[i] == 9 {
                    let add: i32 = 4 - (kc % 4)
                    k2 = k2 + add
                    kc = kc + add
                } elif src[i] == 10 or src[i] == 13 {
                    # expandtabs restarts its tab stops after a line break;
                    # the length still counts the break itself.
                    k2 = k2 + 1
                    kc = 0
                } else {
                    k2 = k2 + 1
                    kc = kc + 1
                }
                i = i + 1
            }
            col = col + k2
        } elif ch == 34 {
            col = col + 1
            i = i + 1
            while src[i] != 0 and src[i] != 34 {
                if src[i] == 92 and src[i + 1] != 0 {
                    col = col + 1
                    i = i + 1
                }
                col = col + 1
                i = i + 1
            }
            if src[i] == 34 {
                col = col + 1
                i = i + 1
            }
        } else {
            col = col + 1
            i = i + 1
        }
    }
    if want_col {
        return col
    }
    return line
}

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------

export function sem_err(c: ptr<Sem>, msg: string) {
    sem_sv_push(c.errors, msg)
    sem_iv_push(c.err_mod, c.cm)
    sem_iv_push(c.err_pos, c.pos)
}

export function sem_warn(c: ptr<Sem>, msg: string) {
    sem_sv_push(c.warnings, msg)
    sem_iv_push(c.warn_mod, c.cm)
    sem_iv_push(c.warn_pos, c.pos)
}

# Truncate the warning list back to `n`, as sem_err_truncate does errors.
export function sem_warn_truncate(c: ptr<Sem>, n: i32) {
    sem_sv_setlen(c.warnings, n)
    sem_iv_setlen(c.warn_mod, n)
    sem_iv_setlen(c.warn_pos, n)
}

# Truncate the error list back to `n` (the quiet re-checks of
# _infer_type_quiet discard what they report).
export function sem_err_truncate(c: ptr<Sem>, n: i32) {
    sem_sv_setlen(c.errors, n)
    sem_iv_setlen(c.err_mod, n)
    sem_iv_setlen(c.err_pos, n)
}

# ---------------------------------------------------------------------------
# Symbols and scopes
# ---------------------------------------------------------------------------

export function sem_sym_new(c: ptr<Sem>, name: string, ty: i32, kind: i32) -> i32 {
    let id: i32 = sem_sv_len(c.sy_name)
    sem_sv_push(c.sy_name, name)
    sem_iv_push(c.sy_type, ty)
    sem_iv_push(c.sy_kind, kind)
    sem_iv_push(c.sy_mut, 0)
    sem_iv_push(c.sy_def, 0 - 1)
    sem_pv_push(c.sy_over, null)
    return id
}

# Scope.define on the global scope: a function defined again under the same
# name becomes an overload; anything else replaces the old symbol.
export function sem_scope_define_global(c: ptr<Sem>, sym: i32) {
    let name: string = sem_sv_get(c.sy_name, sym)
    let old: i32 = sem_sm_get(c.g_scope, name)
    if old >= 0 and sem_iv_get(c.sy_kind, sym) == SK_FUNCTION and sem_iv_get(c.sy_kind, old) == SK_FUNCTION {
        let mut ov: ptr<SemIntVec> = sem_pv_get(c.sy_over, old) as ptr<SemIntVec>
        if ov == null {
            ov = sem_iv_new()
            sem_iv_push(ov, sem_iv_get(c.sy_type, old))
            sem_pv_set(c.sy_over, old, ov as ptr<void>)
        }
        sem_iv_push(ov, sem_iv_get(c.sy_type, sym))
        return
    }
    sem_sm_put(c.g_scope, name, sym)
}

export function sem_push_scope(c: ptr<Sem>) {
    sem_iv_push(c.frames, sem_sv_len(c.ls_name))
}

export function sem_pop_scope(c: ptr<Sem>) {
    let mark: i32 = sem_iv_get(c.frames, sem_iv_len(c.frames) - 1)
    sem_iv_setlen(c.frames, sem_iv_len(c.frames) - 1)
    sem_sv_setlen(c.ls_name, mark)
    sem_iv_setlen(c.ls_sym, mark)
}

# Define in the innermost scope (the global one when no local scope is open).
export function sem_scope_define(c: ptr<Sem>, sym: i32) {
    if sem_iv_len(c.frames) == 0 {
        sem_scope_define_global(c, sym)
        return
    }
    sem_sv_push(c.ls_name, sem_sv_get(c.sy_name, sym))
    sem_iv_push(c.ls_sym, sym)
}

export function sem_define_var(c: ptr<Sem>, name: string, ty: i32, mutable: bool) -> i32 {
    let s: i32 = sem_sym_new(c, name, ty, SK_VARIABLE)
    if mutable {
        sem_iv_set(c.sy_mut, s, 1)
    }
    sem_scope_define(c, s)
    return s
}

# current_scope.lookup(name): the symbol, or -1.
export function sem_lookup(c: ptr<Sem>, name: string) -> i32 {
    let mut i: i32 = sem_sv_len(c.ls_name) - 1
    while i >= 0 {
        if sem_s_eq(sem_sv_get(c.ls_name, i), name) {
            return sem_iv_get(c.ls_sym, i)
        }
        i = i - 1
    }
    return sem_sm_get(c.g_scope, name)
}

export function sem_sym_type(c: ptr<Sem>, s: i32) -> i32 {
    return sem_iv_get(c.sy_type, s)
}

export function sem_sym_kind(c: ptr<Sem>, s: i32) -> i32 {
    return sem_iv_get(c.sy_kind, s)
}

# ---------------------------------------------------------------------------
# Declarations, functions, struct entries
# ---------------------------------------------------------------------------

export function sem_decl_add(c: ptr<Sem>, kind: i32, m: i32, node: i32, name: string, info: i32) -> i32 {
    let id: i32 = sem_iv_len(c.d_kind)
    sem_iv_push(c.d_kind, kind)
    sem_iv_push(c.d_mod, m)
    sem_iv_push(c.d_node, node)
    sem_sv_push(c.d_name, name)
    sem_iv_push(c.d_info, info)
    sem_iv_push(c.d_astart, sem_sv_len(c.attr_pool))
    sem_iv_push(c.d_alen, 0)
    return id
}

export function sem_fi_new(c: ptr<Sem>, name: string, m: i32, node: i32) -> i32 {
    let id: i32 = sem_sv_len(c.fi_name)
    sem_sv_push(c.fi_name, name)
    sem_sv_push(c.fi_mangled, name)
    sem_iv_push(c.fi_mod, m)
    sem_iv_push(c.fi_node, node)
    sem_iv_push(c.fi_pstart, sem_sv_len(c.fp_names))
    sem_iv_push(c.fi_plen, 0)
    sem_iv_push(c.fi_ret, 0 - 1)
    sem_iv_push(c.fi_astart, sem_sv_len(c.attr_pool))
    sem_iv_push(c.fi_alen, 0)
    sem_iv_push(c.fi_extern, 0)
    sem_iv_push(c.fi_variadic, 0)
    sem_iv_push(c.fi_tpstart, sem_sv_len(c.tp_names))
    sem_iv_push(c.fi_tplen, 0)
    sem_iv_push(c.fi_estart, sem_sv_len(c.ef_pool))
    sem_iv_push(c.fi_elen, 0)
    sem_iv_push(c.fi_body, 0 - 1)
    sem_iv_push(c.fi_has_self, 0)
    return id
}

# Parameters, type parameters and effects of a function are appended to
# their pools right after fi_new, so each list is one contiguous run.
export function sem_fi_add_param(c: ptr<Sem>, fi: i32, name: string, pt: i32) {
    sem_sv_push(c.fp_names, name)
    sem_iv_push(c.fp_types, pt)
    sem_iv_set(c.fi_plen, fi, sem_iv_get(c.fi_plen, fi) + 1)
}

export function sem_fi_param_name(c: ptr<Sem>, fi: i32, i: i32) -> string {
    return sem_sv_get(c.fp_names, sem_iv_get(c.fi_pstart, fi) + i)
}

export function sem_fi_param_type(c: ptr<Sem>, fi: i32, i: i32) -> i32 {
    return sem_iv_get(c.fp_types, sem_iv_get(c.fi_pstart, fi) + i)
}

export function sem_fi_nparams(c: ptr<Sem>, fi: i32) -> i32 {
    return sem_iv_get(c.fi_plen, fi)
}

export function sem_fi_attr(c: ptr<Sem>, fi: i32, i: i32) -> string {
    return sem_sv_get(c.attr_pool, sem_iv_get(c.fi_astart, fi) + i)
}

export function sem_fi_nattrs(c: ptr<Sem>, fi: i32) -> i32 {
    return sem_iv_get(c.fi_alen, fi)
}

# `name in decl.attributes` (exact string match, as the Python list test).
export function sem_fi_has_attr(c: ptr<Sem>, fi: i32, name: string) -> bool {
    let mut i: i32 = 0
    while i < sem_fi_nattrs(c, fi) {
        if sem_s_eq(sem_fi_attr(c, fi, i), name) {
            return true
        }
        i = i + 1
    }
    return false
}

export function sem_fi_effect(c: ptr<Sem>, fi: i32, i: i32) -> string {
    return sem_sv_get(c.ef_pool, sem_iv_get(c.fi_estart, fi) + i)
}

export function sem_fi_neffects(c: ptr<Sem>, fi: i32) -> i32 {
    return sem_iv_get(c.fi_elen, fi)
}

export function sem_fi_ntparams(c: ptr<Sem>, fi: i32) -> i32 {
    return sem_iv_get(c.fi_tplen, fi)
}

export function sem_fi_tparam(c: ptr<Sem>, fi: i32, i: i32) -> string {
    return sem_sv_get(c.tp_names, sem_iv_get(c.fi_tpstart, fi) + i)
}

export function sem_fi_tbound(c: ptr<Sem>, fi: i32, i: i32) -> string {
    return sem_sv_get(c.tp_bounds, sem_iv_get(c.fi_tpstart, fi) + i)
}

export function sem_se_new(c: ptr<Sem>, name: string, kind: i32, decl: i32) -> i32 {
    let id: i32 = sem_sv_len(c.se_name)
    sem_sv_push(c.se_name, name)
    sem_iv_push(c.se_kind, kind)
    sem_iv_push(c.se_fstart, sem_sv_len(c.sf_names))
    sem_iv_push(c.se_flen, 0)
    sem_iv_push(c.se_base, 0 - 1)
    sem_iv_push(c.se_tpstart, sem_sv_len(c.tp_names))
    sem_iv_push(c.se_tplen, 0)
    sem_iv_push(c.se_decl, decl)
    return id
}

export function sem_se_add_field(c: ptr<Sem>, se: i32, name: string, pt: i32) {
    sem_sv_push(c.sf_names, name)
    sem_iv_push(c.sf_types, pt)
    sem_iv_set(c.se_flen, se, sem_iv_get(c.se_flen, se) + 1)
}

export function sem_se_nfields(c: ptr<Sem>, se: i32) -> i32 {
    return sem_iv_get(c.se_flen, se)
}

export function sem_se_field_name(c: ptr<Sem>, se: i32, i: i32) -> string {
    return sem_sv_get(c.sf_names, sem_iv_get(c.se_fstart, se) + i)
}

export function sem_se_field_type(c: ptr<Sem>, se: i32, i: i32) -> i32 {
    return sem_iv_get(c.sf_types, sem_iv_get(c.se_fstart, se) + i)
}

# struct_types[name], or -1.
export function sem_struct_entry(c: ptr<Sem>, name: string) -> i32 {
    return sem_sm_get(c.struct_types, name)
}

# ---------------------------------------------------------------------------
# Parsed types from the flowc AST (parser.py parse_type naming)
# ---------------------------------------------------------------------------

function sem_pt_join_names(c: ptr<Sem>, args: ptr<SemIntVec>) -> string {
    let mut s: string = ""
    let mut i: i32 = 0
    while i < args.len {
        if i > 0 {
            s = s + "_"
        }
        s = s + sem_pt_name(c.t, args.data[i])
        i = i + 1
    }
    return s
}

# The parser's Type for the AST_TYPE `ty` of the current module, or -1.
export function sem_pt_of_ast(c: ptr<Sem>, ty: i32) -> i32 {
    if ty < 0 {
        return 0 - 1
    }
    let t: ptr<SemTys> = c.t
    let ns: i32 = c.ar.nodes[ty].name_start
    let ne: i32 = c.ar.nodes[ty].name_end
    let iv: i32 = c.ar.nodes[ty].ival
    let inner: i32 = c.ar.nodes[ty].a
    let cc: i32 = c.ar.nodes[ty].c
    # (A, B) -> R [with E...]: fn_A_B__R
    if iv == 0 - 1 {
        let args: ptr<SemIntVec> = sem_iv_new()
        let mut p: i32 = inner
        while p != AST_NONE {
            sem_iv_push(args, sem_pt_of_ast(c, p))
            p = c.ar.nodes[p].next
        }
        let ret: i32 = sem_pt_of_ast(c, c.ar.nodes[ty].b)
        let mut key: string = "void"
        if args.len > 0 {
            key = sem_pt_join_names(c, args)
        }
        let id: i32 = sem_pt_mk(t, "fn_" + key + "__" + sem_pt_name(t, ret))
        t.pt_args[id] = args
        t.pt_elem[id] = ret
        let row: i32 = sem_row_of(c, ty)
        if row >= 0 {
            let mut e: i32 = c.ar.nodes[row].a
            while e != AST_NONE {
                sem_pt_add_effect(t, id, sem_nname(c, e))
                e = c.ar.nodes[e].next
            }
        }
        return id
    }
    # cfn(A, B) -> R: cfn_A_B__R
    if iv == 0 - 2 {
        let args: ptr<SemIntVec> = sem_iv_new()
        let mut p: i32 = inner
        while p != AST_NONE {
            sem_iv_push(args, sem_pt_of_ast(c, p))
            p = c.ar.nodes[p].next
        }
        let ret: i32 = sem_pt_of_ast(c, c.ar.nodes[ty].b)
        let mut key: string = "void"
        if args.len > 0 {
            key = sem_pt_join_names(c, args)
        }
        let id: i32 = sem_pt_mk(t, "cfn_" + key + "__" + sem_pt_name(t, ret))
        t.pt_args[id] = args
        t.pt_elem[id] = ret
        t.pt_cfn[id] = 1
        return id
    }
    # capability E
    if cc == AST_TYPE_CAPABILITY {
        let id: i32 = sem_pt_mk(t, "capability_" + sem_s_span(c.src, ns, ne))
        t.pt_cap[id] = 1
        return id
    }
    # [T; N]
    if cc == AST_TYPE_FIXED_ARRAY {
        let el: i32 = sem_pt_of_ast(c, inner)
        let id: i32 = sem_pt_mk(t, "array_" + sem_s_itoa(iv as i64) + "_" + sem_pt_name(t, el))
        t.pt_size[id] = iv
        t.pt_elem[id] = el
        return id
    }
    # &[T], &mut [T], &[T; N]: no name span, an inner type.
    if ns == ne and inner != AST_NONE {
        let el: i32 = sem_pt_of_ast(c, inner)
        let mut prefix: string = "span_const_"
        if cc == AST_TYPE_SPAN_MUTABLE {
            prefix = "span_mut_"
        }
        let id: i32 = sem_pt_mk(t, prefix + sem_pt_name(t, el))
        t.pt_elem[id] = el
        if iv > 0 {
            t.pt_size[id] = iv
        }
        return id
    }
    let name: string = sem_s_span(c.src, ns, ne)
    if inner == AST_NONE {
        return sem_pt_mk(t, name)
    }
    if sem_s_eq(name, "span") {
        let el: i32 = sem_pt_of_ast(c, inner)
        let mut prefix: string = "span_const_"
        if cc == AST_TYPE_SPAN_MUTABLE {
            prefix = "span_mut_"
        }
        let id: i32 = sem_pt_mk(t, prefix + sem_pt_name(t, el))
        t.pt_elem[id] = el
        if iv > 0 {
            t.pt_size[id] = iv
        }
        return id
    }
    if sem_s_eq(name, "array") {
        let el: i32 = sem_pt_of_ast(c, inner)
        if iv > 0 {
            let id: i32 = sem_pt_mk(t, "array_" + sem_s_itoa(iv as i64) + "_" + sem_pt_name(t, el))
            t.pt_size[id] = iv
            t.pt_elem[id] = el
            return id
        }
        let id2: i32 = sem_pt_mk(t, "array_" + sem_pt_name(t, el))
        t.pt_elem[id2] = el
        return id2
    }
    if sem_s_eq(name, "ptr") {
        let el: i32 = sem_pt_of_ast(c, inner)
        let id: i32 = sem_pt_mk(t, "ptr_" + sem_pt_name(t, el))
        t.pt_ptr[id] = 1
        t.pt_elem[id] = el
        return id
    }
    if sem_s_starts(name, "vec") and sem_s_len(name) > 3 and sem_s_is_digit(sem_s_byte(name, 3)) {
        let el: i32 = sem_pt_of_ast(c, inner)
        let id: i32 = sem_pt_mk(t, name + "_" + sem_pt_name(t, el))
        let mut k: i32 = 3
        let mut n: i32 = 0
        while k < sem_s_len(name) and sem_s_is_digit(sem_s_byte(name, k)) {
            n = n * 10 + sem_s_byte(name, k) - 48
            k = k + 1
        }
        t.pt_size[id] = n
        t.pt_elem[id] = el
        return id
    }
    # Name<A, B>: Name_A_B with type_args.
    let args: ptr<SemIntVec> = sem_iv_new()
    let mut p: i32 = inner
    while p != AST_NONE {
        sem_iv_push(args, sem_pt_of_ast(c, p))
        p = c.ar.nodes[p].next
    }
    let id: i32 = sem_pt_mk(t, name + "_" + sem_pt_join_names(c, args))
    t.pt_args[id] = args
    return id
}

# ---------------------------------------------------------------------------
# _parse_type and generic instantiation
# ---------------------------------------------------------------------------

export function sem_parse_named_scalar(c: ptr<Sem>, name: string) -> i32 {
    let t: ptr<SemTys> = c.t
    if sem_s_eq(name, "void") { return sem_ty_mk(t, TK_VOID) }
    if sem_s_eq(name, "bool") { return sem_ty_mk(t, TK_BOOL) }
    if sem_s_eq(name, "i8") { return sem_ty_mk(t, TK_I8) }
    if sem_s_eq(name, "i16") { return sem_ty_mk(t, TK_I16) }
    if sem_s_eq(name, "i32") { return sem_ty_mk(t, TK_I32) }
    if sem_s_eq(name, "i64") { return sem_ty_mk(t, TK_I64) }
    if sem_s_eq(name, "i128") { return sem_ty_mk(t, TK_I128) }
    if sem_s_eq(name, "u8") { return sem_ty_mk(t, TK_U8) }
    if sem_s_eq(name, "u16") { return sem_ty_mk(t, TK_U16) }
    if sem_s_eq(name, "u32") { return sem_ty_mk(t, TK_U32) }
    if sem_s_eq(name, "u64") { return sem_ty_mk(t, TK_U64) }
    if sem_s_eq(name, "u128") { return sem_ty_mk(t, TK_U128) }
    if sem_s_eq(name, "f32") { return sem_ty_mk(t, TK_F32) }
    if sem_s_eq(name, "f64") { return sem_ty_mk(t, TK_F64) }
    if sem_s_eq(name, "c64") { return sem_ty_mk(t, TK_C64) }
    if sem_s_eq(name, "c128") { return sem_ty_mk(t, TK_C128) }
    if sem_s_eq(name, "string") { return sem_ty_mk(t, TK_STRING) }
    return 0 - 1
}

# _rewrite_mangled_type_name: whole `_` segments that name a type parameter.
function sem_rewrite_mangled(c: ptr<Sem>, name: string, map_names: ptr<SemStrVec>, map_types: ptr<SemIntVec>) -> string {
    if sem_s_len(name) == 0 or map_names.len == 0 {
        return name
    }
    let parts: ptr<SemStrVec> = sem_s_split(name, 95)
    let mut out: string = ""
    let mut i: i32 = 0
    while i < parts.len {
        if i > 0 {
            out = out + "_"
        }
        let seg: string = sem_sv_get(parts, i)
        let k: i32 = sem_map_index(map_names, seg)
        if k >= 0 {
            let rn: string = sem_pt_name(c.t, map_types.data[k])
            if sem_s_len(rn) > 0 {
                out = out + rn
            } else {
                out = out + "void"
            }
        } else {
            out = out + seg
        }
        i = i + 1
    }
    return out
}

function sem_map_index(names: ptr<SemStrVec>, key: string) -> i32 {
    let mut i: i32 = 0
    while i < names.len {
        if sem_s_eq(names.data[i], key) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

# _substitute_parsed_type
export function sem_substitute_pt(c: ptr<Sem>, pt: i32, map_names: ptr<SemStrVec>, map_types: ptr<SemIntVec>) -> i32 {
    let t: ptr<SemTys> = c.t
    if pt < 0 {
        return pt
    }
    let k: i32 = sem_map_index(map_names, sem_pt_name(t, pt))
    if k >= 0 and sem_pt_nargs(t, pt) == 0 {
        let rep: i32 = map_types.data[k]
        let id: i32 = sem_pt_mk(t, sem_pt_name(t, rep))
        t.pt_ptr[id] = t.pt_ptr[rep]
        t.pt_cap[id] = t.pt_cap[rep]
        t.pt_size[id] = t.pt_size[rep]
        t.pt_elem[id] = t.pt_elem[rep]
        t.pt_args[id] = t.pt_args[rep]
        return id
    }
    let mut elem: i32 = 0 - 1
    if t.pt_elem[pt] >= 0 {
        elem = sem_substitute_pt(c, t.pt_elem[pt], map_names, map_types)
    }
    let id2: i32 = sem_pt_mk(t, sem_rewrite_mangled(c, sem_pt_name(t, pt), map_names, map_types))
    t.pt_ptr[id2] = t.pt_ptr[pt]
    t.pt_cap[id2] = t.pt_cap[pt]
    t.pt_size[id2] = t.pt_size[pt]
    t.pt_elem[id2] = elem
    if sem_pt_nargs(t, pt) > 0 {
        let mut i: i32 = 0
        while i < sem_pt_nargs(t, pt) {
            sem_pt_add_arg(t, id2, sem_substitute_pt(c, sem_pt_arg(t, pt, i), map_names, map_types))
            i = i + 1
        }
    }
    return id2
}

# _generic_type_args_from_name: (base name, type args) or false.
function sem_generic_args_from_name(c: ptr<Sem>, name: string, out_base: ptr<SemStrVec>, out_args: ptr<SemIntVec>) -> bool {
    let us: i32 = sem_s_index_byte(name, 95)
    if us < 0 {
        return false
    }
    let base: string = sem_s_slice(name, 0, us)
    let g: i32 = sem_sm_get(c.generic_struct_types, base)
    if g < 0 {
        return false
    }
    let parts: ptr<SemStrVec> = sem_s_split(sem_s_from(name, us + 1), 95)
    let n: i32 = sem_iv_get(c.se_tplen, g)
    if parts.len < n {
        return false
    }
    sem_sv_push(out_base, base)
    let mut i: i32 = 0
    while i < n {
        sem_iv_push(out_args, sem_pt_mk(c.t, sem_sv_get(parts, i)))
        i = i + 1
    }
    return true
}

# _ensure_generic_struct_instance(name, type_args); type_args may be null.
export function sem_ensure_generic_struct_instance(c: ptr<Sem>, name: string, type_args: ptr<SemIntVec>) -> bool {
    if sem_sm_has(c.struct_types, name) {
        return true
    }
    let us: i32 = sem_s_index_byte(name, 95)
    let mut base_name: string = name
    if us >= 0 {
        base_name = sem_s_slice(name, 0, us)
    }
    let mut g: i32 = sem_sm_get(c.generic_struct_types, base_name)
    let mut args: ptr<SemIntVec> = type_args
    if g < 0 {
        let ob: ptr<SemStrVec> = sem_sv_new()
        let oa: ptr<SemIntVec> = sem_iv_new()
        if sem_generic_args_from_name(c, name, ob, oa) == false {
            return false
        }
        base_name = sem_sv_get(ob, 0)
        args = oa
        g = sem_sm_get(c.generic_struct_types, base_name)
    } elif args == null {
        let ob2: ptr<SemStrVec> = sem_sv_new()
        let oa2: ptr<SemIntVec> = sem_iv_new()
        if sem_generic_args_from_name(c, name, ob2, oa2) == false {
            return false
        }
        args = oa2
    }
    if args == null or args.len == 0 or args.len != sem_iv_get(c.se_tplen, g) {
        return false
    }
    let map_names: ptr<SemStrVec> = sem_sv_new()
    let map_types: ptr<SemIntVec> = sem_iv_new()
    let mut i: i32 = 0
    while i < args.len {
        sem_sv_push(map_names, sem_sv_get(c.tp_names, sem_iv_get(c.se_tpstart, g) + i))
        sem_iv_push(map_types, args.data[i])
        i = i + 1
    }
    let se: i32 = sem_se_new(c, name, SE_STRUCT, sem_iv_get(c.se_decl, g))
    i = 0
    while i < sem_se_nfields(c, g) {
        sem_se_add_field(c, se, sem_se_field_name(c, g, i), sem_substitute_pt(c, sem_se_field_type(c, g, i), map_names, map_types))
        i = i + 1
    }
    sem_sm_put(c.struct_types, name, se)
    return true
}

# _parse_type
export function sem_parse_type(c: ptr<Sem>, pt: i32) -> i32 {
    let t: ptr<SemTys> = c.t
    if pt < 0 {
        # A missing annotation reads as the parser's default (void return).
        return sem_ty_mk(t, TK_VOID)
    }
    let name: string = sem_pt_name(t, pt)
    if sem_s_eq(name, "auto") {
        return sem_ty_named(t, TK_UNKNOWN, "auto")
    }
    if (sem_s_starts(name, "fn_") or sem_s_starts(name, "cfn_")) and sem_s_contains(name, "__") {
        let f: i32 = sem_ty_named(t, TK_FUNCTION, name)
        let mut i: i32 = 0
        while i < sem_pt_nargs(t, pt) {
            sem_ty_add_param(t, f, sem_parse_type(c, sem_pt_arg(t, pt, i)))
            i = i + 1
        }
        if t.pt_elem[pt] >= 0 {
            t.ret[f] = sem_parse_type(c, t.pt_elem[pt])
        } else {
            t.ret[f] = sem_ty_mk(t, TK_VOID)
        }
        if sem_s_starts(name, "fn_") {
            let mut e: i32 = 0
            while e < sem_pt_neffects(t, pt) {
                let ev: ptr<SemStrVec> = t.pt_effects[pt]
                sem_ty_add_effect(t, f, sem_sv_get(ev, e))
                e = e + 1
            }
        }
        return f
    }
    if sem_is_span_type_name(name) {
        let mut elem: i32 = 0 - 1
        if t.pt_elem[pt] >= 0 {
            elem = sem_parse_type(c, t.pt_elem[pt])
        } else {
            elem = sem_parse_named_scalar(c, sem_span_element_name(name))
            if elem < 0 {
                elem = sem_ty_named(t, TK_UNKNOWN, sem_span_element_name(name))
            }
        }
        let sp: i32 = sem_ty_named(t, TK_SPAN, name)
        t.elem[sp] = elem
        t.size[sp] = t.pt_size[pt]
        return sp
    }
    if sem_pt_nargs(t, pt) > 0 {
        let us: i32 = sem_s_index_byte(name, 95)
        let mut base: string = name
        if us >= 0 {
            base = sem_s_slice(name, 0, us)
        }
        if sem_sm_has(c.generic_struct_types, base) {
            sem_ensure_generic_struct_instance(c, name, t.pt_args[pt])
            return sem_ty_struct(t, name)
        }
    }
    if sem_sm_has(c.struct_types, name) == false {
        if sem_ensure_generic_struct_instance(c, name, null) {
            return sem_ty_struct(t, name)
        }
    }
    if sem_s_starts(name, "memref_") {
        let el: i32 = sem_parse_named_scalar(c, sem_s_from(name, 7))
        if el >= 0 {
            return sem_ty_ptr(t, el)
        }
    }
    let scalar: i32 = sem_parse_named_scalar(c, name)
    if scalar >= 0 {
        return scalar
    }
    if sem_s_starts(name, "capability_") {
        return sem_ty_struct(t, name)
    }
    if t.pt_ptr[pt] == 1 and t.pt_elem[pt] >= 0 {
        return sem_ty_ptr(t, sem_parse_type(c, t.pt_elem[pt]))
    }
    if sem_s_starts(name, "array_") and t.pt_elem[pt] >= 0 {
        return sem_ty_array(t, sem_parse_type(c, t.pt_elem[pt]), t.pt_size[pt])
    }
    if sem_s_starts(name, "array_") {
        let el2: i32 = sem_parse_named_scalar(c, sem_s_from(name, 6))
        if el2 >= 0 {
            return sem_ty_array(t, el2, t.pt_size[pt])
        }
        # Python falls off the elif chain here: the method returns None.
        return 0 - 1
    }
    if sem_s_starts(name, "memref_") {
        return sem_ty_ptr(t, sem_parse_type(c, sem_pt_mk(t, sem_s_from(name, 7))))
    }
    let se: i32 = sem_struct_entry(c, name)
    if se >= 0 {
        let k: i32 = sem_iv_get(c.se_kind, se)
        if k == SE_ALIAS {
            let al: i32 = sem_ty_named(t, TK_TYPE_ALIAS, name)
            t.base[al] = sem_parse_type(c, sem_iv_get(c.se_base, se))
            return al
        }
        if k == SE_DISTINCT {
            let di: i32 = sem_ty_named(t, TK_DISTINCT, name)
            t.base[di] = sem_parse_type(c, sem_iv_get(c.se_base, se))
            t.dims[di] = sem_unit_dims_of_name(c, name)
            return di
        }
        return sem_ty_struct(t, name)
    }
    return sem_ty_named(t, TK_UNKNOWN, name)
}

# A resolved parsed type by name (Type(name)).
export function sem_parse_type_name(c: ptr<Sem>, name: string) -> i32 {
    return sem_parse_type(c, sem_pt_mk(c.t, name))
}

# ---------------------------------------------------------------------------
# Units of measure
# ---------------------------------------------------------------------------

export function sem_unit_dims_of_name(c: ptr<Sem>, name: string) -> ptr<SemIntVec> {
    let k: i32 = sem_sm_get(c.unit_dims, name)
    if k < 0 {
        return null
    }
    return sem_pv_get(c.unit_dim_list, k) as ptr<SemIntVec>
}

export function sem_set_unit_dims(c: ptr<Sem>, name: string, d: ptr<SemIntVec>) {
    sem_sm_put(c.unit_dims, name, sem_pv_len(c.unit_dim_list))
    sem_pv_push(c.unit_dim_list, d as ptr<void>)
}

# _dims_of
export function sem_dims_of(c: ptr<Sem>, ty: i32) -> ptr<SemIntVec> {
    let tys: ptr<SemTys> = c.t
    if ty < 0 {
        return null
    }
    let k: i32 = tys.kind[ty]
    if k == TK_TYPE_ALIAS and tys.base[ty] >= 0 {
        return sem_dims_of(c, tys.base[ty])
    }
    if k == TK_DISTINCT {
        return tys.dims[ty]
    }
    return null
}

# _is_radian
export function sem_is_radian(c: ptr<Sem>, ty: i32) -> bool {
    let tys: ptr<SemTys> = c.t
    let mut x: i32 = ty
    while x >= 0 {
        if sem_s_eq(tys.name[x], "Radian") {
            return true
        }
        if tys.kind[x] != TK_TYPE_ALIAS {
            return false
        }
        x = tys.base[x]
    }
    return false
}

# _format_dims
export function sem_format_dims(c: ptr<Sem>, d: ptr<SemIntVec>) -> string {
    let num: ptr<SemStrVec> = sem_sv_new()
    let den: ptr<SemStrVec> = sem_sv_new()
    let mut i: i32 = 0
    while i < d.len {
        let e: i32 = d.data[i]
        if e != 0 {
            let mut base: string = "dim" + sem_s_itoa(i as i64)
            if i < sem_sv_len(c.unit_base_order) {
                base = sem_sv_get(c.unit_base_order, i)
            }
            let mut mag: i32 = e
            if mag < 0 {
                mag = 0 - mag
            }
            let mut part: string = base
            if mag != 1 {
                part = base + "^" + sem_s_itoa(mag as i64)
            }
            if e > 0 {
                sem_sv_push(num, part)
            } else {
                sem_sv_push(den, part)
            }
        }
        i = i + 1
    }
    let mut text: string = "1"
    if num.len > 0 {
        text = sem_sv_join(num, "*")
    }
    i = 0
    while i < den.len {
        text = text + "/" + sem_sv_get(den, i)
        i = i + 1
    }
    return text
}

# _unit_result_type
export function sem_unit_result_type(c: ptr<Sem>, dims: ptr<SemIntVec>) -> i32 {
    let tys: ptr<SemTys> = c.t
    let d: ptr<SemIntVec> = sem_dims_normalize(dims)
    if d.len == 0 {
        return sem_ty_mk(c.t, TK_F64)
    }
    let key: string = sem_dims_key(d)
    let k: i32 = sem_sm_get(c.unit_canonical, key)
    let mut name: string = ""
    if k >= 0 {
        name = sem_sv_get(c.unit_canonical_names, k)
    } else {
        name = sem_format_dims(c, d)
    }
    let id: i32 = sem_ty_named(c.t, TK_DISTINCT, name)
    tys.base[id] = sem_ty_mk(c.t, TK_F64)
    tys.dims[id] = d
    return id
}

# ---------------------------------------------------------------------------
# Kind predicates on types
# ---------------------------------------------------------------------------

export function sem_is_numeric(c: ptr<Sem>, ty: i32) -> bool {
    let tys: ptr<SemTys> = c.t
    return ty >= 0 and sem_tk_is_numeric(tys.kind[ty])
}

export function sem_is_integer(c: ptr<Sem>, ty: i32) -> bool {
    let tys: ptr<SemTys> = c.t
    return ty >= 0 and sem_tk_is_int(tys.kind[ty])
}

export function sem_is_float(c: ptr<Sem>, ty: i32) -> bool {
    let tys: ptr<SemTys> = c.t
    return ty >= 0 and sem_tk_is_float(tys.kind[ty])
}

export function sem_is_complex(c: ptr<Sem>, ty: i32) -> bool {
    let tys: ptr<SemTys> = c.t
    return ty >= 0 and sem_tk_is_complex(tys.kind[ty])
}

export function sem_is_span(c: ptr<Sem>, ty: i32) -> bool {
    let tys: ptr<SemTys> = c.t
    return ty >= 0 and tys.kind[ty] == TK_SPAN
}

export function sem_tkind(c: ptr<Sem>, ty: i32) -> i32 {
    return sem_ty_kind(c.t, ty)
}

export function sem_tstr(c: ptr<Sem>, ty: i32) -> string {
    return sem_ty_str(c.t, ty)
}

export function sem_is_dual(c: ptr<Sem>, ty: i32) -> bool {
    let tys: ptr<SemTys> = c.t
    return sem_tkind(c, ty) == TK_STRUCT and sem_s_eq(tys.name[ty], "Dual")
}

export function sem_is_tensor(c: ptr<Sem>, ty: i32) -> bool {
    let tys: ptr<SemTys> = c.t
    return sem_tkind(c, ty) == TK_STRUCT and sem_s_eq(tys.name[ty], "Tensor")
}

# _integer_bit_width, or 0 for None.
export function sem_integer_bit_width(c: ptr<Sem>, ty: i32) -> i32 {
    let k: i32 = sem_tkind(c, ty)
    if k == TK_I8 or k == TK_U8 or k == TK_BOOL { return 8 }
    if k == TK_I16 or k == TK_U16 { return 16 }
    if k == TK_I32 or k == TK_U32 { return 32 }
    if k == TK_I64 or k == TK_U64 { return 64 }
    if k == TK_I128 or k == TK_U128 { return 128 }
    return 0
}

function sem_int_order(k: i32) -> i32 {
    if k == TK_I8 { return 0 }
    if k == TK_U8 { return 1 }
    if k == TK_I16 { return 2 }
    if k == TK_U16 { return 3 }
    if k == TK_I32 { return 4 }
    if k == TK_U32 { return 5 }
    if k == TK_I64 { return 6 }
    if k == TK_U64 { return 7 }
    if k == TK_I128 { return 8 }
    if k == TK_U128 { return 9 }
    return 0
}

function sem_int_by_order(i: i32) -> i32 {
    if i == 0 { return TK_I8 }
    if i == 1 { return TK_U8 }
    if i == 2 { return TK_I16 }
    if i == 3 { return TK_U16 }
    if i == 4 { return TK_I32 }
    if i == 5 { return TK_U32 }
    if i == 6 { return TK_I64 }
    if i == 7 { return TK_U64 }
    if i == 8 { return TK_I128 }
    return TK_U128
}

# _numeric_common_type
export function sem_numeric_common_type(c: ptr<Sem>, a: i32, b: i32) -> i32 {
    let ka: i32 = sem_tkind(c, a)
    let kb: i32 = sem_tkind(c, b)
    if sem_tk_is_complex(ka) or sem_tk_is_complex(kb) {
        if ka == TK_C128 or kb == TK_C128 {
            return sem_ty_mk(c.t, TK_C128)
        }
        if ka == TK_C64 or kb == TK_C64 {
            if ka == TK_F64 or kb == TK_F64 {
                return sem_ty_mk(c.t, TK_C128)
            }
            return sem_ty_mk(c.t, TK_C64)
        }
    }
    if sem_tk_is_float(ka) or sem_tk_is_float(kb) {
        if ka == TK_F64 or kb == TK_F64 {
            return sem_ty_mk(c.t, TK_F64)
        }
        return sem_ty_mk(c.t, TK_F32)
    }
    let ia: i32 = sem_int_order(ka)
    let ib: i32 = sem_int_order(kb)
    if ia > ib {
        return sem_ty_mk(c.t, sem_int_by_order(ia))
    }
    return sem_ty_mk(c.t, sem_int_by_order(ib))
}

# ---------------------------------------------------------------------------
# Compatibility
# ---------------------------------------------------------------------------

# _is_type_param
export function sem_is_type_param(c: ptr<Sem>, ty: i32) -> bool {
    let tys: ptr<SemTys> = c.t
    if ty < 0 or sem_sv_len(c.active_type_params) == 0 {
        return false
    }
    let nm: string = tys.name[ty]
    if tys.kind[ty] == TK_UNKNOWN and sem_sv_has(c.active_type_params, nm) {
        return true
    }
    if sem_s_len(nm) > 0 {
        let parts: ptr<SemStrVec> = sem_s_split(nm, 95)
        let mut i: i32 = 0
        while i < parts.len {
            if sem_sv_has(c.active_type_params, sem_sv_get(parts, i)) {
                return true
            }
            i = i + 1
        }
    }
    if tys.elem[ty] >= 0 and sem_is_type_param(c, tys.elem[ty]) {
        return true
    }
    return false
}

# _span_elements_match
function sem_span_elements_match(c: ptr<Sem>, a: i32, e: i32) -> bool {
    if a < 0 or e < 0 {
        return true
    }
    return sem_ty_eq(c.t, a, e)
}

# _borrow_compatible
export function sem_borrow_compatible(c: ptr<Sem>, actual: i32, expected: i32) -> bool {
    let tys: ptr<SemTys> = c.t
    if sem_is_span(c, expected) == false {
        return false
    }
    let ka: i32 = sem_tkind(c, actual)
    if ka == TK_POINTER {
        return false
    }
    if ka == TK_ARRAY {
        return sem_span_elements_match(c, tys.elem[actual], tys.elem[expected])
    }
    if sem_is_span(c, actual) {
        if sem_span_elements_match(c, tys.elem[actual], tys.elem[expected]) == false {
            return false
        }
        return sem_span_is_mutable(tys.name[actual]) or sem_span_is_mutable(tys.name[expected]) == false
    }
    return false
}

# _is_function_to_void_pointer
export function sem_fn_to_void_ptr(c: ptr<Sem>, actual: i32, expected: i32) -> bool {
    let tys: ptr<SemTys> = c.t
    if sem_tkind(c, actual) != TK_FUNCTION or sem_tkind(c, expected) != TK_POINTER {
        return false
    }
    let el: i32 = tys.elem[expected]
    return el < 0 or tys.kind[el] == TK_VOID
}

function sem_effects_subset(c: ptr<Sem>, a: i32, e: i32) -> bool {
    let mut i: i32 = 0
    while i < sem_ty_neffects(c.t, a) {
        let x: string = sem_ty_effect(c.t, a, i)
        let mut found: bool = false
        let mut j: i32 = 0
        while j < sem_ty_neffects(c.t, e) {
            if sem_s_eq(sem_ty_effect(c.t, e, j), x) {
                found = true
            }
            j = j + 1
        }
        if found == false {
            return false
        }
        i = i + 1
    }
    return true
}

# _can_coerce. -1 (None) coerces to anything.
export function sem_can_coerce(c: ptr<Sem>, actual: i32, expected: i32) -> bool {
    let tys: ptr<SemTys> = c.t
    if actual < 0 or expected < 0 {
        return true
    }
    if sem_is_type_param(c, actual) or sem_is_type_param(c, expected) {
        return true
    }
    let ka: i32 = sem_tkind(c, actual)
    let ke: i32 = sem_tkind(c, expected)
    if c.strict == false and (ka == TK_VOID or ka == TK_UNKNOWN or ke == TK_VOID or ke == TK_UNKNOWN) {
        return true
    }
    if sem_is_span(c, expected) or sem_is_span(c, actual) {
        return sem_borrow_compatible(c, actual, expected)
    }
    if sem_ty_eq(c.t, actual, expected) {
        return true
    }
    let ad: ptr<SemIntVec> = sem_dims_of(c, actual)
    let ed: ptr<SemIntVec> = sem_dims_of(c, expected)
    if ad != null and ed != null {
        return sem_dims_eq(ad, ed)
    }
    if ad != null or ed != null {
        return false
    }
    if sem_tk_is_numeric(ka) and sem_tk_is_numeric(ke) {
        return true
    }
    if ka == TK_POINTER and ke == TK_POINTER {
        return true
    }
    if ka == TK_STRING and ke == TK_POINTER {
        return true
    }
    if sem_fn_to_void_ptr(c, actual, expected) {
        return true
    }
    if ka == TK_STRUCT and ke == TK_POINTER {
        return true
    }
    if sem_tk_is_numeric(ka) and ke == TK_POINTER {
        return true
    }
    if ka == TK_POINTER and sem_tk_is_numeric(ke) {
        return true
    }
    if ka == TK_ARRAY and ke == TK_POINTER {
        return true
    }
    if ka == TK_ARRAY and ke == TK_ARRAY {
        if tys.size[actual] == 0 {
            return true
        }
        if tys.elem[actual] >= 0 and tys.elem[expected] >= 0 {
            return sem_can_coerce(c, tys.elem[actual], tys.elem[expected])
        }
        return true
    }
    if ka == TK_NULL and ke == TK_POINTER {
        return true
    }
    if ka == TK_BOOL and sem_tk_is_numeric(ke) {
        return c.strict == false
    }
    if ke == TK_BOOL and sem_tk_is_numeric(ka) {
        return c.strict == false
    }
    if ka == TK_FUNCTION and ke == TK_FUNCTION {
        let n: i32 = sem_ty_nparams(c.t, actual)
        if n != sem_ty_nparams(c.t, expected) {
            return false
        }
        let mut i: i32 = 0
        while i < n {
            if sem_can_coerce(c, sem_ty_param(c.t, actual, i), sem_ty_param(c.t, expected, i)) == false {
                return false
            }
            i = i + 1
        }
        let mut ar: i32 = tys.ret[actual]
        if ar < 0 {
            ar = sem_ty_mk(c.t, TK_VOID)
        }
        let mut er: i32 = tys.ret[expected]
        if er < 0 {
            er = sem_ty_mk(c.t, TK_VOID)
        }
        if sem_can_coerce(c, ar, er) == false {
            return false
        }
        return sem_effects_subset(c, actual, expected)
    }
    if c.strict == false and (ka == TK_STRUCT or ke == TK_STRUCT) {
        return true
    }
    return false
}

# _is_c_string_pair
function sem_is_c_string_pair(c: ptr<Sem>, actual: i32, expected: i32) -> bool {
    let sa: bool = sem_tkind(c, actual) == TK_STRING or sem_s_eq(sem_ty_name(c.t, actual), "string")
    let se: bool = sem_tkind(c, expected) == TK_STRING or sem_s_eq(sem_ty_name(c.t, expected), "string")
    let pa: bool = sem_s_eq(sem_ty_name(c.t, actual), "ptr<i8>") or sem_s_eq(sem_ty_name(c.t, actual), "ptr<u8>") or sem_s_eq(sem_ty_name(c.t, actual), "ptr<char>")
    let pe: bool = sem_s_eq(sem_ty_name(c.t, expected), "ptr<i8>") or sem_s_eq(sem_ty_name(c.t, expected), "ptr<u8>") or sem_s_eq(sem_ty_name(c.t, expected), "ptr<char>")
    return (sa and pe) or (pa and se)
}

# _is_compatible
export function sem_is_compatible(c: ptr<Sem>, actual: i32, expected: i32) -> bool {
    # -1 (None) comes from a name only an @cImport header declares.
    if actual < 0 or expected < 0 {
        return true
    }
    let tys: ptr<SemTys> = c.t
    if sem_ty_eq(c.t, actual, expected) {
        return true
    }
    if sem_is_type_param(c, actual) or sem_is_type_param(c, expected) {
        return true
    }
    if c.relax_c_strings and sem_is_c_string_pair(c, actual, expected) {
        return true
    }
    let ka: i32 = sem_tkind(c, actual)
    let ke: i32 = sem_tkind(c, expected)
    if ka == TK_FUNCTION and ke == TK_FUNCTION {
        let n: i32 = sem_ty_nparams(c.t, actual)
        if n != sem_ty_nparams(c.t, expected) {
            return false
        }
        let mut i: i32 = 0
        while i < n {
            if sem_is_compatible(c, sem_ty_param(c.t, actual, i), sem_ty_param(c.t, expected, i)) == false {
                return false
            }
            i = i + 1
        }
        let mut ar: i32 = tys.ret[actual]
        if ar < 0 {
            ar = sem_ty_mk(c.t, TK_VOID)
        }
        let mut er: i32 = tys.ret[expected]
        if er < 0 {
            er = sem_ty_mk(c.t, TK_VOID)
        }
        return sem_is_compatible(c, ar, er)
    }
    if sem_is_span(c, expected) or sem_is_span(c, actual) {
        return sem_borrow_compatible(c, actual, expected)
    }
    let ad: ptr<SemIntVec> = sem_dims_of(c, actual)
    let ed: ptr<SemIntVec> = sem_dims_of(c, expected)
    if ad != null and ed != null {
        return sem_dims_eq(ad, ed)
    }
    if ad != null or ed != null {
        return false
    }
    if ke == TK_STRUCT and sem_s_starts(tys.name[expected], "capability_") {
        if ka == TK_STRUCT {
            return true
        }
    }
    if ke == TK_POINTER and ka == TK_I32 {
        return true
    }
    if ka == TK_POINTER and ke == TK_POINTER {
        let ae: i32 = tys.elem[actual]
        let ee: i32 = tys.elem[expected]
        if ae >= 0 and tys.kind[ae] == TK_VOID {
            return true
        }
        if ee >= 0 and tys.kind[ee] == TK_VOID {
            return true
        }
        if ae >= 0 and (tys.kind[ae] == TK_U8 or tys.kind[ae] == TK_I8) {
            return true
        }
        if ee >= 0 and (tys.kind[ee] == TK_U8 or tys.kind[ee] == TK_I8) {
            return true
        }
    }
    if ka == TK_STRUCT and ke == TK_POINTER {
        return true
    }
    if ka == TK_STRING and ke == TK_POINTER {
        let ee2: i32 = tys.elem[expected]
        if ee2 >= 0 {
            let k2: i32 = tys.kind[ee2]
            if k2 == TK_U8 or k2 == TK_I8 or k2 == TK_VOID {
                return true
            }
        }
    }
    if sem_fn_to_void_ptr(c, actual, expected) {
        return true
    }
    if ka == TK_ARRAY and ke == TK_POINTER {
        let ee3: i32 = tys.elem[expected]
        if ee3 >= 0 and tys.kind[ee3] == TK_VOID {
            return true
        }
        if sem_ty_eq(c.t, tys.elem[actual], ee3) {
            return true
        }
        if tys.elem[actual] >= 0 and ee3 >= 0 and sem_is_compatible(c, tys.elem[actual], ee3) {
            return true
        }
    }
    if ka == TK_ARRAY and ke == TK_ARRAY {
        if sem_ty_eq(c.t, tys.elem[actual], tys.elem[expected]) {
            return true
        }
        if tys.elem[actual] >= 0 and tys.elem[expected] >= 0 and sem_is_compatible(c, tys.elem[actual], tys.elem[expected]) {
            return true
        }
    }
    if sem_tk_is_int(ka) and sem_tk_is_int(ke) {
        return true
    }
    if sem_tk_is_float(ka) and sem_tk_is_float(ke) {
        return true
    }
    if sem_tk_is_int(ka) and sem_tk_is_float(ke) {
        return true
    }
    return false
}

function sem_is_byte_pointer(c: ptr<Sem>, ty: i32) -> bool {
    let tys: ptr<SemTys> = c.t
    if sem_tkind(c, ty) != TK_POINTER {
        return false
    }
    let el: i32 = tys.elem[ty]
    if el < 0 {
        return true
    }
    let k: i32 = tys.kind[el]
    return k == TK_I8 or k == TK_U8 or k == TK_VOID
}

function sem_is_byte_array(c: ptr<Sem>, ty: i32) -> bool {
    let tys: ptr<SemTys> = c.t
    if sem_tkind(c, ty) != TK_ARRAY {
        return false
    }
    let el: i32 = tys.elem[ty]
    return el >= 0 and (tys.kind[el] == TK_I8 or tys.kind[el] == TK_U8)
}

# _can_cast
export function sem_can_cast(c: ptr<Sem>, actual: i32, target: i32) -> bool {
    # -1 (None) comes from a name only an @cImport header declares.
    if actual < 0 or target < 0 {
        return true
    }
    let tys: ptr<SemTys> = c.t
    if sem_ty_eq(c.t, actual, target) {
        return true
    }
    let ad: ptr<SemIntVec> = sem_dims_of(c, actual)
    let td: ptr<SemIntVec> = sem_dims_of(c, target)
    if ad != null and td != null {
        return sem_dims_eq(ad, td)
    }
    if td != null {
        return sem_is_numeric(c, actual)
    }
    if ad != null {
        return sem_is_numeric(c, target)
    }
    let ka: i32 = sem_tkind(c, actual)
    let kt: i32 = sem_tkind(c, target)
    if kt == TK_DISTINCT and tys.base[target] >= 0 {
        return sem_ty_eq(c.t, actual, tys.base[target])
    }
    if ka == TK_DISTINCT and tys.base[actual] >= 0 {
        return sem_ty_eq(c.t, target, tys.base[actual])
    }
    let na_: bool = sem_tk_is_int(ka) or sem_tk_is_float(ka) or ka == TK_BOOL
    let nt_: bool = sem_tk_is_int(kt) or sem_tk_is_float(kt) or kt == TK_BOOL
    if na_ and nt_ {
        return true
    }
    if ka == TK_POINTER and kt == TK_POINTER {
        return true
    }
    if ka == TK_POINTER and sem_tk_is_int(kt) {
        return true
    }
    if kt == TK_POINTER and sem_tk_is_int(ka) {
        return true
    }
    if ka == TK_POINTER and kt == TK_FUNCTION {
        return true
    }
    if kt == TK_POINTER and ka == TK_FUNCTION {
        return true
    }
    if ka == TK_ARRAY and kt == TK_POINTER {
        let te: i32 = tys.elem[target]
        if te < 0 or tys.kind[te] == TK_VOID {
            return true
        }
        if sem_ty_eq(c.t, tys.elem[actual], te) {
            return true
        }
    }
    if sem_is_byte_pointer(c, actual) and kt == TK_STRING {
        return true
    }
    if ka == TK_STRING and sem_is_byte_pointer(c, target) {
        return true
    }
    if sem_is_byte_array(c, actual) and kt == TK_STRING {
        return true
    }
    if ka == TK_STRING and sem_is_byte_array(c, target) {
        return true
    }
    return false
}

# _undeclared_type_name: the name of an UNKNOWN type among a and b, or "".
export function sem_undeclared_type_name(c: ptr<Sem>, a: i32, b: i32) -> string {
    let tys: ptr<SemTys> = c.t
    if a >= 0 and tys.kind[a] == TK_UNKNOWN and sem_s_len(tys.name[a]) > 0 {
        return tys.name[a]
    }
    if b >= 0 and tys.kind[b] == TK_UNKNOWN and sem_s_len(tys.name[b]) > 0 {
        return tys.name[b]
    }
    return ""
}

# ---------------------------------------------------------------------------
# Attributes (src/flow/attributes.py)
# ---------------------------------------------------------------------------

# The attributes written in front of a declaration: the `@name` and
# `@name(args)` between byte offsets lo and hi, flattened as the Python
# parser does ("name" or "name(a,b)"). Appended to attr_pool; returns the
# count.
export function sem_scan_attributes(c: ptr<Sem>, lo: i32, hi: i32) -> i32 {
    let mut lx: Lexer = flowc_lexer_new(c.src, hi)
    lx.pos = lo
    let mut n: i32 = 0
    let mut tk: Token = flowc_lexer_next(&lx)
    while tk.kind != TOK_EOF {
        if tk.kind == TOK_AT {
            let nt: Token = flowc_lexer_next(&lx)
            if nt.kind != TOK_IDENT and nt.kind != TOK_KEYWORD {
                tk = nt
                continue
            }
            let name: string = sem_s_span(c.src, nt.start, nt.end)
            let save: Lexer = lx
            let pk: Token = flowc_lexer_next(&lx)
            if pk.kind == TOK_LPAREN {
                let mut args: string = ""
                let mut nargs: i32 = 0
                let mut cur: string = ""
                let mut have: bool = false
                let mut a: Token = flowc_lexer_next(&lx)
                while a.kind != TOK_EOF and a.kind != TOK_RPAREN {
                    if a.kind == TOK_COMMA {
                        if nargs > 0 {
                            args = args + ","
                        }
                        args = args + cur
                        nargs = nargs + 1
                        cur = ""
                        have = false
                    } elif a.kind == TOK_EQ {
                        cur = cur + "="
                    } elif a.kind == TOK_STRING {
                        cur = cur + sem_strip_quotes(sem_s_span(c.src, a.start, a.end))
                        have = true
                    } else {
                        cur = cur + sem_s_span(c.src, a.start, a.end)
                        have = true
                    }
                    a = flowc_lexer_next(&lx)
                }
                if have or sem_s_len(cur) > 0 {
                    if nargs > 0 {
                        args = args + ","
                    }
                    args = args + cur
                }
                if sem_s_eq(name, "cInclude") == false and sem_s_eq(name, "cImport") == false and sem_s_eq(name, "cEmbed") == false {
                    sem_sv_push(c.attr_pool, name + "(" + args + ")")
                    n = n + 1
                }
            } else {
                lx = save
                sem_sv_push(c.attr_pool, name)
                n = n + 1
            }
        }
        tk = flowc_lexer_next(&lx)
    }
    return n
}

# value.strip('"').strip("'")
function sem_strip_quotes(s: string) -> string {
    let mut a: i32 = 0
    let mut b: i32 = sem_s_len(s)
    while a < b and sem_s_byte(s, a) == 34 {
        a = a + 1
    }
    while b > a and sem_s_byte(s, b - 1) == 34 {
        b = b - 1
    }
    while a < b and sem_s_byte(s, a) == 39 {
        a = a + 1
    }
    while b > a and sem_s_byte(s, b - 1) == 39 {
        b = b - 1
    }
    return sem_s_slice(s, a, b)
}

# parse_attribute: the name; the arguments go to `args`.
export function sem_parse_attribute(attr: string, args: ptr<SemStrVec>) -> string {
    let lp: i32 = sem_s_index_byte(attr, 40)
    if lp >= 0 and sem_s_ends(attr, ")") {
        let name: string = sem_s_strip(sem_s_slice(attr, 0, lp))
        let rest: string = sem_s_slice(attr, lp + 1, sem_s_len(attr) - 1)
        let parts: ptr<SemStrVec> = sem_s_split(rest, 44)
        let mut i: i32 = 0
        while i < parts.len {
            let a: string = sem_s_strip(sem_sv_get(parts, i))
            if sem_s_len(a) > 0 {
                sem_sv_push(args, a)
            }
            i = i + 1
        }
        return name
    }
    return sem_s_strip(attr)
}

function sem_lifetime_index(d: string) -> i32 {
    if sem_s_eq(d, "callback") { return 0 }
    if sem_s_eq(d, "frame") { return 1 }
    if sem_s_eq(d, "session") { return 2 }
    if sem_s_eq(d, "application") { return 3 }
    return 0 - 1
}

export function sem_domain_name(i: i32) -> string {
    if i == 0 { return "callback" }
    if i == 1 { return "frame" }
    if i == 2 { return "session" }
    return "application"
}

# lifetime_domain over attr_pool[start, start+n): the rank, or -1 for None.
export function sem_lifetime_domain(c: ptr<Sem>, start: i32, n: i32) -> i32 {
    let mut i: i32 = 0
    while i < n {
        let args: ptr<SemStrVec> = sem_sv_new()
        let name: string = sem_parse_attribute(sem_sv_get(c.attr_pool, start + i), args)
        if sem_s_eq(name, "lifetime") and args.len == 1 and sem_lifetime_index(sem_sv_get(args, 0)) >= 0 {
            return sem_lifetime_index(sem_sv_get(args, 0))
        }
        i = i + 1
    }
    return 0 - 1
}

function sem_is_known_attribute(n: string) -> bool {
    return sem_sv_has(sem_known_attributes(), n)
}

function sem_known_attributes() -> ptr<SemStrVec> {
    let v: ptr<SemStrVec> = sem_sv_new()
    sem_sv_push(v, "always_inline")
    sem_sv_push(v, "c")
    sem_sv_push(v, "compile")
    sem_sv_push(v, "flow_api")
    sem_sv_push(v, "gpu")
    sem_sv_push(v, "guard")
    sem_sv_push(v, "hot")
    sem_sv_push(v, "inline")
    sem_sv_push(v, "interp")
    sem_sv_push(v, "jit")
    sem_sv_push(v, "libm")
    sem_sv_push(v, "lifetime")
    sem_sv_push(v, "mlir")
    sem_sv_push(v, "monomorphized")
    sem_sv_push(v, "noinline")
    sem_sv_push(v, "only")
    sem_sv_push(v, "python")
    sem_sv_push(v, "rt_safe")
    sem_sv_push(v, "safe")
    sem_sv_push(v, "target")
    sem_sv_push(v, "test")
    sem_sv_push(v, "unsafe")
    return v
}

function sem_takes_args(n: string) -> bool {
    return sem_s_eq(n, "only") or sem_s_eq(n, "guard") or sem_s_eq(n, "target") or sem_s_eq(n, "lifetime") or sem_s_eq(n, "python")
}

function sem_target_item_ok(item: string) -> bool {
    # ^[+-]?[A-Za-z0-9_.]+(?:-[A-Za-z0-9_.]+)*(?:=[A-Za-z0-9_.+]+(?:-[A-Za-z0-9_.+]+)*)?$
    let n: i32 = sem_s_len(item)
    let mut i: i32 = 0
    if i < n and (sem_s_byte(item, i) == 43 or sem_s_byte(item, i) == 45) {
        i = i + 1
    }
    let mut phase: i32 = 0
    let mut seg: i32 = 0
    while i < n {
        let ch: i32 = sem_s_byte(item, i)
        let word: bool = sem_s_is_alpha(ch) or sem_s_is_digit(ch) or ch == 46
        if phase == 0 {
            if word {
                seg = seg + 1
            } elif ch == 45 {
                if seg == 0 {
                    return false
                }
                seg = 0
            } elif ch == 61 {
                if seg == 0 {
                    return false
                }
                phase = 1
                seg = 0
            } else {
                return false
            }
        } else {
            if word or ch == 43 {
                seg = seg + 1
            } elif ch == 45 {
                if seg == 0 {
                    return false
                }
                seg = 0
            } else {
                return false
            }
        }
        i = i + 1
    }
    return seg > 0
}

# validate_target_spec: an error message, or "".
function sem_validate_target_spec(spec: string) -> string {
    if sem_s_len(spec) == 0 {
        return "@target(...) requires a non-empty target string"
    }
    let items: ptr<SemStrVec> = sem_s_split(spec, 44)
    let mut i: i32 = 0
    while i < items.len {
        let item: string = sem_s_strip(sem_sv_get(items, i))
        if sem_s_len(item) == 0 {
            return "@target(\"" + spec + "\") has an empty component"
        }
        if sem_target_item_ok(item) == false {
            return "@target(\"" + spec + "\") component '" + item + "' is not a valid target feature; expected forms are 'avx2', '+avx2', '-sse', 'no-sse', 'arch=haswell' or 'tune=native'"
        }
        i = i + 1
    }
    return ""
}

# sem_attribute_errors(fn_name, attrs) appended to the error list.
export function sem_attribute_errors(c: ptr<Sem>, fn_name: string, start: i32, n: i32) {
    let seen: ptr<SemStrVec> = sem_sv_new()
    let mut lifetime_seen: bool = false
    let mut i: i32 = 0
    while i < n {
        let args: ptr<SemStrVec> = sem_sv_new()
        let name: string = sem_parse_attribute(sem_sv_get(c.attr_pool, start + i), args)
        if sem_is_known_attribute(name) == false {
            let known: ptr<SemStrVec> = sem_known_attributes()
            let mut ks: string = ""
            let mut k: i32 = 0
            while k < known.len {
                if k > 0 {
                    ks = ks + ", "
                }
                ks = ks + "@" + sem_sv_get(known, k)
                k = k + 1
            }
            sem_err(c, "Unknown attribute '@" + name + "' on function '" + fn_name + "'. Known attributes: " + ks)
        } else {
            sem_sv_add(seen, name)
            if args.len > 0 and sem_takes_args(name) == false {
                sem_err(c, "Attribute '@" + name + "' on function '" + fn_name + "' takes no arguments")
            } elif sem_s_eq(name, "lifetime") {
                let known2: string = "callback, frame, session, application"
                if lifetime_seen {
                    sem_err(c, "'" + fn_name + "' declares more than one '@lifetime' domain; a declaration lives in exactly one domain")
                } else {
                    lifetime_seen = true
                    if args.len != 1 {
                        sem_err(c, "Attribute '@lifetime' on '" + fn_name + "' takes exactly one domain: " + known2)
                    } elif sem_lifetime_index(sem_sv_get(args, 0)) < 0 {
                        sem_err(c, "Unknown lifetime domain '" + sem_sv_get(args, 0) + "' on '" + fn_name + "'. Known domains: " + known2 + " (see docs/language/lifetime-domains.md)")
                    }
                }
            } elif sem_s_eq(name, "target") {
                if args.len == 0 {
                    sem_err(c, "Attribute '@target' on function '" + fn_name + "' requires a target string, e.g. @target(\"avx2\")")
                } else {
                    let problem: string = sem_validate_target_spec(sem_sv_join(args, ","))
                    if sem_s_len(problem) > 0 {
                        sem_err(c, problem + " (on function '" + fn_name + "')")
                    }
                }
            }
        }
        i = i + 1
    }
    if sem_sv_has(seen, "noinline") and (sem_sv_has(seen, "inline") or sem_sv_has(seen, "always_inline")) {
        sem_err(c, "Function '" + fn_name + "' cannot be both '@noinline' and '@inline'/'@always_inline'")
    }
    if sem_sv_has(seen, "safe") and sem_sv_has(seen, "unsafe") {
        sem_err(c, "Function '" + fn_name + "' cannot be both '@safe' and '@unsafe'")
    }
}
