# @module flowc.lsp_utils
# @means  LSP utility functions: identifier validation, word range,
#         and completion prefix extraction. Port of helper methods
#         from src/flow/lsp_server.py. The Python original is a full
#         JSON-RPC server; this port exposes the pure string helpers.
#         Full LSP protocol handling stays in Python.

extern {
    function strcmp(a: string, b: string) -> i32
    function strlen(s: string) -> i64
    function malloc(size: i64) -> ptr<void>
    function memcpy(dst: ptr<void>, src: ptr<void>, n: i64) -> ptr<void>
}

# ── Character helpers ────────────────────────────────────────────

function is_ident_start(c: i32) -> i32 {
    if c >= 97 and c <= 122 { return 1 }
    if c >= 65 and c <= 90 { return 1 }
    if c == 95 { return 1 }
    return 0
}

function is_ident_char(c: i32) -> i32 {
    if is_ident_start(c) == 1 { return 1 }
    if c >= 48 and c <= 57 { return 1 }
    return 0
}

function is_space(c: i32) -> i32 {
    if c == 32 or c == 9 or c == 13 or c == 10 { return 1 }
    return 0
}

# ── String helpers ───────────────────────────────────────────────

function substr(src: string, start: i32, end: i32) -> string {
    let n: i32 = strlen(src) as i32
    if start < 0 { start = 0 }
    if end > n { end = n }
    if start >= end { return "" }
    let len: i32 = end - start
    let buf: ptr<u8> = malloc((len + 1) as i64) as ptr<u8>
    let p: ptr<u8> = src
    memcpy(buf, p + start, len as i64)
    buf[len] = 0
    return buf as string
}

# ── Identifier validation ────────────────────────────────────────

# Check if a name is a lexically valid Flow identifier.
# Matches: ^[A-Za-z_][A-Za-z0-9_]*$
export function flowc_is_valid_identifier(name: string) -> i32 {
    let n: i32 = strlen(name) as i32
    if n == 0 { return 0 }
    let p: ptr<u8> = name
    if is_ident_start(p[0]) == 0 { return 0 }
    let mut i: i32 = 1
    while i < n {
        if is_ident_char(p[i]) == 0 { return 0 }
        i = i + 1
    }
    return 1
}

# ── Word range ───────────────────────────────────────────────────

export struct FlowcRange {
    start_line: i32,
    start_char: i32,
    end_line: i32,
    end_char: i32
}

# Range covering the word at (line, column) in a single line.
# If the cursor is not on a word, returns a single-character range.
export function flowc_word_range(line_text: string, column: i32) -> FlowcRange {
    let n: i32 = strlen(line_text) as i32
    let col: i32 = column
    if col > n {
        col = n - 1
    }
    if col < 0 {
        col = 0
    }
    let p: ptr<u8> = line_text
    let mut end: i32 = col
    while end < n and is_ident_char(p[end]) == 1 {
        end = end + 1
    }
    if end == col {
        end = col + 1
        if end > n { end = n }
    }
    return FlowcRange {
        start_line: 0,
        start_char: col,
        end_line: 0,
        end_char: end
    }
}

# ── Completion prefix ────────────────────────────────────────────

# Extract the word or dyn. prefix at the cursor for filtering completions.
# Includes dots and underscores (for dyn.dsys, obj.field, etc.).
export function flowc_completion_prefix(line_text: string, character: i32) -> string {
    let n: i32 = strlen(line_text) as i32
    let i: i32 = character
    if i > n { i = n }
    let p: ptr<u8> = line_text
    let mut start: i32 = i
    while start > 0 {
        let c: i32 = p[start - 1]
        if is_ident_char(c) == 1 or c == 46 {
            start = start - 1
        } else {
            break
        }
    }
    return substr(line_text, start, i)
}
