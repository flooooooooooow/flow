# @module flowc.strutil
# @means  String utility functions for the self-hosted compiler.
# Provides span comparison, length, copy, and path manipulation.

extern {
    function strlen(s: ptr<u8>) -> i64
    function strcmp(a: ptr<u8>, b: ptr<u8>) -> i32
    function strncmp(a: ptr<u8>, b: ptr<u8>, n: i64) -> i32
    function memcpy(dst: ptr<u8>, src: ptr<u8>, n: i64) -> ptr<u8>
    function malloc(n: i32) -> ptr<u8>
    function free(p: ptr<u8>) -> void
}

# Compare a byte span [start, end) against a C string literal.
# Returns 1 if equal, 0 otherwise.
export function flowc_streq_span(text: ptr<u8>, start: i32, end: i32, lit: ptr<u8>) -> i32 {
    let lit_len: i32 = strlen(lit) as i32
    if end - start != lit_len {
        return 0
    }
    let mut i: i32 = 0
    while i < lit_len {
        if text[start + i] != lit[i] {
            return 0
        }
        i = i + 1
    }
    return 1
}

# Compare a Flow string against a C string literal.
# Returns 1 if equal, 0 otherwise.
export function flowc_streq(s: string, lit: ptr<u8>) -> i32 {
    let sp: ptr<u8> = s as ptr<u8>
    if strcmp(sp, lit) == 0 {
        return 1
    }
    return 0
}

# Get the length of a Flow string.
export function flowc_strlen(s: string) -> i32 {
    let sp: ptr<u8> = s as ptr<u8>
    return strlen(sp) as i32
}

# Copy a byte span [start, end) from src into dst.
# Does not NUL-terminate. Returns the number of bytes copied.
export function flowc_strncpy_span(dst: ptr<u8>, src: ptr<u8>, start: i32, end: i32) -> i32 {
    let n: i32 = end - start
    if n <= 0 {
        return 0
    }
    let mut i: i32 = 0
    while i < n {
        dst[i] = src[start + i]
        i = i + 1
    }
    return n
}

# Duplicate a Flow string into a fresh heap buffer.
# Caller must free the result.
export function flowc_strdup(s: string) -> string {
    let sp: ptr<u8> = s as ptr<u8>
    let len: i32 = strlen(sp) as i32
    let buf: ptr<u8> = malloc(len + 1)
    if buf == null {
        return "" as string
    }
    if len > 0 {
        let _m: ptr<u8> = memcpy(buf, sp, len as i64)
    }
    buf[len] = 0
    return buf as string
}

# Check if a byte span starts with a given prefix string.
# Returns 1 if it does, 0 otherwise.
export function flowc_span_starts_with(text: ptr<u8>, start: i32, end: i32, lit: ptr<u8>) -> i32 {
    let lit_len: i32 = strlen(lit) as i32
    if end - start < lit_len {
        return 0
    }
    let mut i: i32 = 0
    while i < lit_len {
        if text[start + i] != lit[i] {
            return 0
        }
        i = i + 1
    }
    return 1
}

# Find the last occurrence of a byte in a span [start, end).
# Returns the index, or -1 if not found.
export function flowc_span_find_last(text: ptr<u8>, start: i32, end: i32, ch: i32) -> i32 {
    let mut i: i32 = end - 1
    while i >= start {
        if text[i] == ch {
            return i
        }
        i = i - 1
    }
    return 0 - 1
}

# Find the first occurrence of a byte in a span [start, end).
# Returns the index, or -1 if not found.
export function flowc_span_find_first(text: ptr<u8>, start: i32, end: i32, ch: i32) -> i32 {
    let mut i: i32 = start
    while i < end {
        if text[i] == ch {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

# Extract the basename from a path span [start, end).
# Returns the start index of the basename within the span.
# If no '/' is found, returns start.
export function flowc_path_basename_start(text: ptr<u8>, start: i32, end: i32) -> i32 {
    let slash: i32 = flowc_span_find_last(text, start, end, 47)
    if slash < 0 {
        return start
    }
    return slash + 1
}

# Check if a span ends with a suffix string.
# Returns 1 if it does, 0 otherwise.
export function flowc_span_ends_with(text: ptr<u8>, start: i32, end: i32, lit: ptr<u8>) -> i32 {
    let lit_len: i32 = strlen(lit) as i32
    if end - start < lit_len {
        return 0
    }
    let off: i32 = end - lit_len
    let mut i: i32 = 0
    while i < lit_len {
        if text[off + i] != lit[i] {
            return 0
        }
        i = i + 1
    }
    return 1
}
