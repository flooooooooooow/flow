# @module flowc.fir_analysis
# @means  CPU reference analyses over FIR-G (Phase 1).
#         Port of the core algorithms from src/flow/fir_analysis.py.
#         The Python original operates on the FirG graph object; this
#         port works on flat arrays (CSR call graph + effect bitvectors)
#         so a Flow caller can run the same fixpoint and reachability
#         without the Python object graph.
#
# Effect bits (matching fir_g.py):
#   EFF_READS_MEMORY=1, EFF_WRITES_MEMORY=2, EFF_ALLOCATES=4,
#   EFF_IO=8, EFF_FFI=16, EFF_PANIC=32, EFF_ATOMIC=64,
#   EFF_THREAD=128, EFF_GPU=256, EFF_UNKNOWN=32768

extern {
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>)
    function memcpy(dst: ptr<void>, src: ptr<void>, n: i64) -> ptr<void>
    function printf(fmt: string, ...) -> i32
    function puts(s: string) -> i32
    function strcmp(a: string, b: string) -> i32
    function strlen(s: string) -> i64
}

# ── Constants ────────────────────────────────────────────────────

export const FLOWC_EFF_READS_MEMORY: i32 = 1
export const FLOWC_EFF_WRITES_MEMORY: i32 = 2
export const FLOWC_EFF_ALLOCATES: i32 = 4
export const FLOWC_EFF_IO: i32 = 8
export const FLOWC_EFF_FFI: i32 = 16
export const FLOWC_EFF_PANIC: i32 = 32
export const FLOWC_EFF_ATOMIC: i32 = 64
export const FLOWC_EFF_THREAD: i32 = 128
export const FLOWC_EFF_GPU: i32 = 256
export const FLOWC_EFF_UNKNOWN: i32 = 32768

# Mask of all "dirty" effect bits for purity checking.
# Dirty = IO | FFI | GPU | WRITES_MEMORY | ALLOCATES | UNKNOWN
# = 8 | 16 | 256 | 2 | 4 | 32768 = 33054
export const FLOWC_EFF_DIRTY: i32 = 33054

# ── OpCode constants (matching fir_g.py OpCode enum) ─────────────

export const FLOWC_OP_NOP: i32 = 0
export const FLOWC_OP_CONST: i32 = 1
export const FLOWC_OP_PARAM: i32 = 2
export const FLOWC_OP_LOAD: i32 = 3
export const FLOWC_OP_STORE: i32 = 4
export const FLOWC_OP_BINOP: i32 = 5
export const FLOWC_OP_UNOP: i32 = 6
export const FLOWC_OP_CALL: i32 = 7
export const FLOWC_OP_RET: i32 = 8
export const FLOWC_OP_BR: i32 = 9
export const FLOWC_OP_COND_BR: i32 = 10
export const FLOWC_OP_PHI: i32 = 11
export const FLOWC_OP_ALLOCA: i32 = 12
export const FLOWC_OP_GEP: i32 = 13
export const FLOWC_OP_CAST: i32 = 14
export const FLOWC_OP_EFFECT: i32 = 15
export const FLOWC_OP_OTHER: i32 = 255

# ── Effect propagation ───────────────────────────────────────────

# Monotone call-graph effect OR-propagation to fixpoint.
# X^{t+1}[f] = X^t[f] OR union of X^t[c] for all callees c of f.
#
# bits: per-function effect bitvectors (ptr<i32>, num_funcs elements).
#       Mutated in place.
# row_offsets: CSR row offsets (ptr<i32>, num_funcs+1 elements).
# columns: CSR column indices (ptr<i32>, row_offsets[num_funcs] elements).
# num_funcs: number of functions.
# max_iters: maximum iterations before giving up.
#
# Returns the number of iterations to reach fixpoint.
export function flowc_propagate_effects(
    bits: ptr<i32>,
    row_offsets: ptr<i32>,
    columns: ptr<i32>,
    num_funcs: i32,
    max_iters: i32
) -> i32 {
    let mut iter: i32 = 0
    while iter < max_iters {
        let mut changed: i32 = 0
        let mut f: i32 = 0
        while f < num_funcs {
            let lo: i32 = row_offsets[f]
            let hi: i32 = row_offsets[f + 1]
            let acc: i32 = bits[f]
            let mut ei: i32 = lo
            while ei < hi {
                let cal: i32 = columns[ei]
                # acc |= bits[cal]
                # Bitwise OR via Flow's bitwise or operator
                let callee_bits: i32 = bits[cal]
                let combined: i32 = acc | callee_bits
                acc = combined
                ei = ei + 1
            }
            if acc != bits[f] {
                bits[f] = acc
                changed = 1
            }
            f = f + 1
        }
        iter = iter + 1
        if changed == 0 {
            break
        }
    }
    return iter
}

# ── Forward reachability ─────────────────────────────────────────

# Forward reachability on the call graph from a set of root function IDs.
# Uses an explicit stack (DFS).
#
# row_offsets: CSR row offsets (ptr<i32>, num_funcs+1 elements).
# columns: CSR column indices (ptr<i32>, row_offsets[num_funcs] elements).
# roots: array of root function IDs (ptr<i32>).
# num_roots: number of roots.
# num_funcs: total number of functions.
# visited: output bitmap (ptr<i32>, num_funcs elements). Set to 1 for reachable.
#
# Returns the number of reachable functions.
export function flowc_reachable_functions(
    row_offsets: ptr<i32>,
    columns: ptr<i32>,
    roots: ptr<i32>,
    num_roots: i32,
    num_funcs: i32,
    visited: ptr<i32>
) -> i32 {
    # Clear visited
    let mut i: i32 = 0
    while i < num_funcs {
        visited[i] = 0
        i = i + 1
    }

    # Stack for DFS (allocate enough for all funcs)
    let stack: ptr<i32> = malloc((num_funcs + 1) * 4) as ptr<i32>
    let mut sp: i32 = 0

    # Push roots
    let mut r: i32 = 0
    while r < num_roots {
        stack[sp] = roots[r]
        sp = sp + 1
        r = r + 1
    }

    let mut count: i32 = 0
    while sp > 0 {
        sp = sp - 1
        let f: i32 = stack[sp]
        if visited[f] == 1 {
            continue
        }
        visited[f] = 1
        count = count + 1

        let lo: i32 = row_offsets[f]
        let hi: i32 = row_offsets[f + 1]
        let mut ei: i32 = lo
        while ei < hi {
            let cal: i32 = columns[ei]
            if visited[cal] == 0 {
                stack[sp] = cal
                sp = sp + 1
            }
            ei = ei + 1
        }
    }

    free(stack as ptr<void>)
    return count
}

# ── Purity check ────────────────────────────────────────────────

# Check if a function is pure (no dirty effect bits).
# Returns 1 if pure, 0 if not.
export function flowc_is_pure(effect_bits: i32) -> i32 {
    if (effect_bits & FLOWC_EFF_DIRTY) == 0 {
        return 1
    }
    return 0
}

# Count pure functions in a bitvector array.
export function flowc_count_pure(bits: ptr<i32>, num_funcs: i32) -> i32 {
    let mut count: i32 = 0
    let mut i: i32 = 0
    while i < num_funcs {
        if flowc_is_pure(bits[i]) == 1 {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

# Count dead functions (not reachable).
# visited: the reachability bitmap from flowc_reachable_functions.
export function flowc_count_dead(visited: ptr<i32>, num_funcs: i32) -> i32 {
    let mut count: i32 = 0
    let mut i: i32 = 0
    while i < num_funcs {
        if visited[i] == 0 {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

# Count CALL ops in an opcode array.
# opcodes: ptr<i32> of opcode values, num_ops elements.
export function flowc_count_call_ops(opcodes: ptr<i32>, num_ops: i32) -> i32 {
    let mut count: i32 = 0
    let mut i: i32 = 0
    while i < num_ops {
        if opcodes[i] == FLOWC_OP_CALL {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

# ── Effect guessing (port of fir_graphify._guess_effect_for_name) ─

# Check if a name is in the IO names set.
function is_io_name(name: string) -> i32 {
    # flow_gfx_ or flow_audio_ prefix
    if str_starts_with(name, "flow_gfx_") == 1 { return 1 }
    if str_starts_with(name, "flow_audio_") == 1 { return 1 }
    # Exact matches
    if strcmp(name, "print") == 0 { return 1 }
    if strcmp(name, "println") == 0 { return 1 }
    if strcmp(name, "printf") == 0 { return 1 }
    if strcmp(name, "puts") == 0 { return 1 }
    if strcmp(name, "fprintf") == 0 { return 1 }
    if strcmp(name, "fputs") == 0 { return 1 }
    if strcmp(name, "read") == 0 { return 1 }
    if strcmp(name, "write") == 0 { return 1 }
    if strcmp(name, "fopen") == 0 { return 1 }
    if strcmp(name, "fclose") == 0 { return 1 }
    return 0
}

# Check if a name is in the allocation names set.
function is_alloc_name(name: string) -> i32 {
    if strcmp(name, "malloc") == 0 { return 1 }
    if strcmp(name, "calloc") == 0 { return 1 }
    if strcmp(name, "realloc") == 0 { return 1 }
    if strcmp(name, "free") == 0 { return 1 }
    if strcmp(name, "alloc") == 0 { return 1 }
    if strcmp(name, "arena_alloc") == 0 { return 1 }
    return 0
}

# Guess effect bits for a function name (port of _guess_effect_for_name).
# is_extern: 1 if the function is extern, 0 otherwise.
# Returns the effect bitvectors.
export function flowc_guess_effect_for_name(name: string, is_extern: i32) -> i32 {
    let bits: i32 = 0
    if is_extern != 0 {
        bits = bits | FLOWC_EFF_FFI
    }
    if is_io_name(name) == 1 {
        bits = bits | FLOWC_EFF_IO
    }
    if is_alloc_name(name) == 1 {
        bits = bits | FLOWC_EFF_ALLOCATES | FLOWC_EFF_WRITES_MEMORY
    }
    return bits
}

# ── String helpers (needed by is_io_name) ────────────────────────

function str_starts_with(s: string, prefix: string) -> i32 {
    let sl: i32 = strlen(s) as i32
    let pl: i32 = strlen(prefix) as i32
    if pl > sl { return 0 }
    let sp: ptr<u8> = s
    let pp: ptr<u8> = prefix
    let mut i: i32 = 0
    while i < pl {
        if sp[i] != pp[i] { return 0 }
        i = i + 1
    }
    return 1
}
