            flowc_cgen_putc(w, 40)
            let mut arg: i32 = arena.nodes[id].a
            let mut first: i32 = 1
            while arg != AST_NONE {
                if first == 0 {
                    flowc_cgen_puts(w, ", ")
                }
                first = 0
                flowc_cgen_emit_expr(w, arena, src, arg)
                arg = arena.nodes[arg].next
            }
            flowc_cgen_puts(w, ")")
            return
        }
        # Check for overloads. If there are multiple functions with this
        # name, resolve the best match and use the mangled name.
        let n_overloads: i32 = flowc_cgen_count_overloads(arena, src, arena.nodes[id].name_start, arena.nodes[id].name_end)
        let mut fn_id: i32 = AST_NONE
        if n_overloads > 1 {
            fn_id = flowc_cgen_bound_call_fn(w, arena, src, id)
            if fn_id == AST_NONE {
