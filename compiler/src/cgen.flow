                    flowc_cgen_puts(w, "fabsf")
                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "sqrt") == 1 {
                    flowc_cgen_puts(w, "sqrtf")
                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "sin") == 1 {
                    flowc_cgen_puts(w, "sinf")
                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "cos") == 1 {
                    flowc_cgen_puts(w, "cosf")
                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "tan") == 1 {
                    flowc_cgen_puts(w, "tanf")
                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "asin") == 1 {
                    flowc_cgen_puts(w, "asinf")
                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "acos") == 1 {
                    flowc_cgen_puts(w, "acosf")
                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "atan") == 1 {
                    flowc_cgen_puts(w, "atanf")
                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "atan2") == 1 {
                    flowc_cgen_puts(w, "atan2f")
                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "exp") == 1 {
                    flowc_cgen_puts(w, "expf")
                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "log") == 1 {
                    flowc_cgen_puts(w, "logf")
                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "log2") == 1 {
                    flowc_cgen_puts(w, "log2f")
                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "log10") == 1 {
                    flowc_cgen_puts(w, "log10f")
                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "sinh") == 1 {
                    flowc_cgen_puts(w, "sinhf")
                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "cosh") == 1 {
                    flowc_cgen_puts(w, "coshf")
                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "tanh") == 1 {
                    flowc_cgen_puts(w, "tanhf")
                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "cbrt") == 1 {
