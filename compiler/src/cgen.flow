                # Assume it's a closure if not found. (Not perfect, but works for the subset. In reality we should check if it's a known closure variable).
                # Actually, check if it's declared locally as a closure.
                let mut is_closure: i32 = 0
                let ns: i32 = arena.nodes[id].name_start
                let ne: i32 = arena.nodes[id].name_end
                let mut vi: i32 = 0
                while vi < arena.len {
                    if arena.nodes[vi].kind == AST_LET {
                        if flowc_cgen_span_eq(src, ns, ne, arena.nodes[vi].name_start, arena.nodes[vi].name_end) == 1 {
                            let init: i32 = arena.nodes[vi].b
                            if init != AST_NONE and arena.nodes[init].kind == AST_FN {
                                let lam_id: i32 = 0 - arena.nodes[init].name_start
                                let mut has_snap: i32 = 0
                                let mut ci: i32 = 0
                                while ci < w[0].lambda_cap_count {
                                    if w[0].lambda_cap_lambda[ci] == lam_id {
                                        has_snap = 1
                                    }
                                    ci = ci + 1
                                }
                                if has_snap == 1 {
                                    is_closure = 1
                                }
                            }
                        }
