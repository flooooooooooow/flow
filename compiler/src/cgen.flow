            }
        } else {
            fn_id = flowc_cgen_find_fn(arena, src, arena.nodes[id].name_start, arena.nodes[id].name_end)
            # A call through a closure value: f.fn(f.env, args...).
            let mut fat_callee: i32 = AST_NONE
