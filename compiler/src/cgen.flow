            flowc_cgen_puts(w, "))")
            return
        }
        # Target-independent type identity: compile-time u64 / bool constants (#775).
        if arena.nodes[id].b != AST_NONE {
            let tidk: i32 = flowc_type_id_builtin_kind(src, arena.nodes[id].name_start, arena.nodes[id].name_end)
            if tidk == FLOWC_TID_FAMILY or tidk == FLOWC_TID_SCHEMA {
                let mut key: u64 = 0
                if tidk == FLOWC_TID_FAMILY {
                    key = flowc_type_family_id(arena, src, arena.nodes[id].b)
                } else {
                    key = flowc_type_schema_id(arena, src, arena.nodes[id].b)
                }
                flowc_cgen_puts(w, "((uint64_t)0x")
                flowc_cgen_put_u64_hex(w, key)
                flowc_cgen_puts(w, "ULL)")
