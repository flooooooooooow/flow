                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "fmax") == 1 {
                    flowc_cgen_puts(w, "fmaxf")
                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "pow") == 1 {
                    flowc_cgen_puts(w, "powf")
                } elif is_f32_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "hypot") == 1 {
                    flowc_cgen_puts(w, "hypotf")
                } elif is_c64_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "cexp") == 1 {
                    flowc_cgen_puts(w, "cexpf")
                } elif is_c64_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "csqrt") == 1 {
                    flowc_cgen_puts(w, "csqrtf")
                } elif is_c64_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "conj") == 1 {
                    flowc_cgen_puts(w, "conjf")
                } elif is_c64_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "clog") == 1 {
                    flowc_cgen_puts(w, "clogf")
                } elif is_c64_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "cabs") == 1 {
                    flowc_cgen_puts(w, "cabsf")
                } elif is_c64_math == 1 and flowc_cgen_span_is(src, arena.nodes[id].name_start, arena.nodes[id].name_end, "carg") == 1 {
