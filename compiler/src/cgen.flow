                    }
                    farg = arena.nodes[farg].next
                    if fpty != AST_NONE {
                        fpty = arena.nodes[fpty].next
                    }
                }
                flowc_cgen_puts(w, ")")
                return
            }
            if fn_id != AST_NONE or flowc_cgen_is_libc_fn(arena, src, id) == 1 {
                let mut is_f32_math: i32 = 0
                let mut is_c64_math: i32 = 0
                # stdlib math is declared f32/c64. A bundle emits each
                # module in its own arena, so imported callees are not in
                # fn_id; their C return type is in the sig table (#734).
                if fn_id != AST_NONE {
                    let pty: i32 = flowc_cgen_fn_param_type(arena, fn_id, 0)
                    if pty != AST_NONE {
