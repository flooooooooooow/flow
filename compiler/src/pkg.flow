# @module flowc.pkg
# @means  Flow package manager: registry index, version selection,
#         install into flow_packages/, flow.lock, `add`, `sync`, `search`,
#         `info`, `init`, `publish`, `build`, `run`, `build-native`,
#         `run-native`, `clean`, and `native-link` (the [native] sources
#         that `flow run` links).
#
# This is the package manager that src/flow/package.py and registry.py used
# to be, ported rule for rule so that flow.lock and flow_packages/ come out
# byte-identical. The few steps that need another program (git, curl, tar,
# cp, rm) run it through std.process with an argument vector, no shell in
# between. Every decision stays here: which command to run, with which
# arguments, and what to do with the result.

import .pkg_json {
    SBuf, JDoc,
    sb_new, sb_putc, sb_puts, sb_put_int, sb_str,
    str_len, str_eq, str_slice, str_dup, str_cat, str_cat3, str_starts, str_ends,
    str_find, str_contains, str_find_byte, str_rfind_byte, str_lower, str_strip,
    JV_NULL, JV_BOOL, JV_INT, JV_FLOAT, JV_STR, JV_ARR, JV_OBJ, JV_MEM,
    jd_new, jd_add, jd_str, jd_obj, jd_arr, jd_kind, jd_sval, jd_is_str, jd_is_obj,
    jd_first, jd_next, jd_mem_val, jd_mem_key, jd_append, jd_count,
    jd_get, jd_has, jd_set, jd_copy_obj, jd_truthy,
    jd_py_str, jd_py_str_s, jd_py_repr, jd_toml_value,
    jd_parse_json, jd_parse_toml, jd_dump_json
}
import .semver { Semver, flowc_semver_parse, flowc_semver_cmp, flowc_semver_matches }
import .fileio { flowc_read_file, flowc_write_file, flowc_io_system, flowc_io_mkdir, flowc_io_remove }
import std.process { ProcCmd, ProcResult, proc_cmd, proc_arg, proc_cwd, proc_stdin, proc_stdout, proc_stderr, proc_run, proc_which, PROC_INHERIT, PROC_CAPTURE, PROC_NULL }

extern {
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function puts(s: string) -> i32
    function getenv(name: string) -> string
    function getcwd(buf: ptr<u8>, size: i64) -> ptr<u8>
    function readlink(path: string, buf: ptr<u8>, size: i64) -> i64
    function access(path: string, mode: i32) -> i32
    function opendir(path: string) -> ptr<void>
    function closedir(dir: ptr<void>) -> i32
    function fflush(fp: ptr<void>) -> i32
    function exit(code: i32) -> void
    function strcmp(a: string, b: string) -> i32
    function getpid() -> i32
    function rename(src: string, dst: string) -> i32
}

const GREEN: string = "\x1b[92m"
const BLUE: string = "\x1b[94m"
const YELLOW: string = "\x1b[93m"
const RED: string = "\x1b[91m"
const RESET: string = "\x1b[0m"
const BOLD: string = "\x1b[1m"
const CHECK: string = "\xe2\x9c\x93"
const DOWN: string = "\xe2\x86\x93"
const ARROW: string = "\xe2\x86\x92"
const DASH: string = "\xe2\x80\x94"

const READ_CAP: i32 = 16777216

export struct Pm {
    d: ptr<JDoc>,
    project_dir: string,
    repo_root: string,
    reg: i32,
    reg_pkgs: i32,
    reg_name: string,
    last_sha: string
}

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

function say(s: string) {
    let _r: i32 = puts(s)
}

function say_color(color: string, s: string) {
    say(str_cat3(color, s, RESET))
}

# ---------------------------------------------------------------------------
# Paths and files
# ---------------------------------------------------------------------------

export function pkg_env(name: string) -> string {
    let v: string = getenv(name)
    if v as ptr<u8> == null {
        return ""
    }
    return v
}

function cwd() -> string {
    let buf: ptr<u8> = malloc(4096) as ptr<u8>
    let r: ptr<u8> = getcwd(buf, 4096)
    if r == null {
        return "."
    }
    return buf as string
}

function path_join(a: string, b: string) -> string {
    if str_starts(b, "/") {
        return b
    }
    if str_ends(a, "/") {
        return str_cat(a, b)
    }
    return str_cat3(a, "/", b)
}

export function path_exists(p: string) -> bool {
    return access(p, 0) == 0
}

function path_is_dir(p: string) -> bool {
    let dir: ptr<void> = opendir(p)
    if dir == null {
        return false
    }
    let _c: i32 = closedir(dir)
    return true
}

function path_is_file(p: string) -> bool {
    return path_exists(p) and path_is_dir(p) == false
}

# Last path component (pathlib's .name) of a normalised path.
function path_name(p: string) -> string {
    let s: i32 = str_rfind_byte(p, 47)
    return str_slice(p, s + 1, str_len(p))
}

function path_parent(p: string) -> string {
    let s: i32 = str_rfind_byte(p, 47)
    if s <= 0 {
        if s == 0 {
            return "/"
        }
        return "."
    }
    return str_slice(p, 0, s)
}

# What str(pathlib.Path(p)) prints: repeated and trailing slashes and "."
# components removed. ".." is kept, as pathlib keeps it.
export function path_normalize(p: string) -> string {
    let pp: ptr<u8> = p as ptr<u8>
    let n: i32 = str_len(p)
    let sb: ptr<SBuf> = sb_new()
    let abs: bool = n > 0 and pp[0] == 47
    if abs {
        sb_putc(sb, 47)
    }
    let mut i: i32 = 0
    let mut wrote: bool = false
    while i < n {
        while i < n and pp[i] == 47 {
            i = i + 1
        }
        let s: i32 = i
        while i < n and pp[i] != 47 {
            i = i + 1
        }
        if i > s {
            let comp: string = str_slice(p, s, i)
            if str_eq(comp, ".") == false {
                if wrote {
                    sb_putc(sb, 47)
                }
                sb_puts(sb, comp)
                wrote = true
            }
        }
    }
    if wrote == false and abs == false {
        return "."
    }
    return sb_str(sb)
}

# pathlib's expanduser for "~" and "~/...".
function expand_user(p: string) -> string {
    if str_eq(p, "~") or str_starts(p, "~/") {
        let home: string = pkg_env("HOME")
        if str_len(home) > 0 {
            return str_cat(home, str_slice(p, 1, str_len(p)))
        }
    }
    return p
}

# Target of the symlink at p, or "" when p is not a symlink (or missing).
function read_link(p: string) -> string {
    let buf: ptr<u8> = malloc(4097) as ptr<u8>
    let n: i64 = readlink(p, buf, 4096)
    if n <= 0 {
        return ""
    }
    buf[n as i32] = 0
    return buf as string
}

# pathlib's Path.resolve() (strict=False), which is os.path.realpath: make
# the path absolute, then walk it one component at a time, following
# symlinks, applying ".." to what has been resolved so far, and keeping
# components that do not exist as written.
export function path_resolve(p: string) -> string {
    let mut rest: string = p
    if str_starts(p, "/") == false {
        rest = path_join(cwd(), p)
    }
    let mut cur: string = "/"
    let mut links: i32 = 0
    while str_len(rest) > 0 {
        let rp: ptr<u8> = rest as ptr<u8>
        let n: i32 = str_len(rest)
        let mut i: i32 = 0
        while i < n and rp[i] == 47 {
            i = i + 1
        }
        let s: i32 = i
        while i < n and rp[i] != 47 {
            i = i + 1
        }
        let comp: string = str_slice(rest, s, i)
        rest = str_slice(rest, i, n)
        if str_len(comp) == 0 or str_eq(comp, ".") {
            continue
        }
        if str_eq(comp, "..") {
            cur = path_parent(cur)
            continue
        }
        let cand: string = path_join(cur, comp)
        let target: string = read_link(cand)
        if str_len(target) == 0 or links > 40 {
            cur = cand
            continue
        }
        links = links + 1
        if str_starts(target, "/") {
            cur = "/"
        }
        rest = str_cat3(target, "/", rest)
    }
    return cur
}

# os.makedirs(p, exist_ok=True)
function mkdirs(p: string) {
    if str_len(p) == 0 or path_is_dir(p) {
        return
    }
    let parent: string = path_parent(p)
    if str_eq(parent, p) == false {
        mkdirs(parent)
    }
    let _m: i32 = flowc_io_mkdir(p)
}

function read_text(path: string) -> string {
    let buf: ptr<u8> = malloc(READ_CAP as i64) as ptr<u8>
    let n: i32 = flowc_read_file(path, buf, READ_CAP - 1)
    if n < 0 {
        buf[0] = 0
        return buf as string
    }
    buf[n] = 0
    return buf as string
}

function write_text(path: string, s: string) -> bool {
    return flowc_write_file(path, s as ptr<u8>, str_len(s)) == 0
}

# ---------------------------------------------------------------------------
# Other programs (tar, cp, rm, git, curl), run through std.process
# ---------------------------------------------------------------------------

function shell_quote(sb: ptr<SBuf>, s: string) {
    sb_putc(sb, 39)
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    while p[i] != 0 {
        if p[i] == 39 {
            sb_puts(sb, "'\\''")
        } else {
            sb_putc(sb, p[i] as i32)
        }
        i = i + 1
    }
    sb_putc(sb, 39)
}

function args1(pm: ptr<Pm>, a: string) -> i32 {
    let arr: i32 = jd_arr(pm[0].d)
    jd_append(pm[0].d, arr, jd_str(pm[0].d, a))
    return arr
}

function args_push(pm: ptr<Pm>, arr: i32, a: string) {
    jd_append(pm[0].d, arr, jd_str(pm[0].d, a))
}

# The exit status as a shell reports it: the child's code, 128 plus the
# signal that ended it, or 127 when it could not be started.
function child_status(r: ptr<ProcResult>) -> i32 {
    if str_len(r.error) > 0 {
        return 127
    }
    if r.exit_code < 0 {
        return 128 - r.exit_code
    }
    return r.exit_code
}

# Run `c` with stdin, stdout and stderr shared with this process, after
# flushing what this process has printed. Returns the exit status.
function run_shared(c: ptr<ProcCmd>) -> i32 {
    let _f: i32 = fflush(null)
    proc_stdin(c, PROC_INHERIT)
    proc_stdout(c, PROC_INHERIT)
    proc_stderr(c, PROC_INHERIT)
    return child_status(proc_run(c))
}

function cmd2(prog: string, a: string, b: string) -> ptr<ProcCmd> {
    let c: ptr<ProcCmd> = proc_cmd(prog)
    proc_arg(c, a)
    proc_arg(c, b)
    return c
}

# rm -rf p
function rmtree(pm: ptr<Pm>, p: string) {
    let _r: i32 = run_shared(cmd2("rm", "-rf", p))
}

# cp -p src dest, then touch dest. Returns the exit status.
function copy_file(pm: ptr<Pm>, src: string, dest: string) -> i32 {
    let c: ptr<ProcCmd> = cmd2("cp", "-p", src)
    proc_arg(c, dest)
    let rc: i32 = run_shared(c)
    if rc != 0 {
        return rc
    }
    let t: ptr<ProcCmd> = proc_cmd("touch")
    proc_arg(t, dest)
    return run_shared(t)
}

# shutil.copytree(src, dest, ignore=.git, build, flow_packages, __pycache__,
# *.pyc) after removing dest. Symlinks are followed. tar writes the tree to
# a scratch archive, which a second tar unpacks into dest.
function copy_package_dir(pm: ptr<Pm>, src: string, dest: string) {
    rmtree(pm, dest)
    let _m: i32 = run_shared(cmd2("mkdir", "-p", dest))
    let archive: string = str_cat(temp_path("flow-pkg-copytree"), ".tar")
    let pack: ptr<ProcCmd> = cmd2("tar", "-chf", archive)
    proc_arg(pack, "--exclude")
    proc_arg(pack, ".git")
    proc_arg(pack, "--exclude")
    proc_arg(pack, "build")
    proc_arg(pack, "--exclude")
    proc_arg(pack, "flow_packages")
    proc_arg(pack, "--exclude")
    proc_arg(pack, "__pycache__")
    proc_arg(pack, "--exclude")
    proc_arg(pack, "*.pyc")
    proc_arg(pack, ".")
    proc_cwd(pack, src)
    if run_shared(pack) == 0 {
        let unpack: ptr<ProcCmd> = cmd2("tar", "-xpf", archive)
        proc_cwd(unpack, dest)
        let _u: i32 = run_shared(unpack)
    }
    rmtree(pm, archive)
}

# Download url to dest with curl (15 s limit). Returns curl's exit status,
# or 200 when curl is not on PATH.
function fetch_url(pm: ptr<Pm>, url: string, dest: string) -> i32 {
    if str_len(proc_which("curl")) == 0 {
        return 200
    }
    let c: ptr<ProcCmd> = cmd2("curl", "-fsSL", "--max-time")
    proc_arg(c, "15")
    proc_arg(c, "-o")
    proc_arg(c, dest)
    proc_arg(c, url)
    return run_shared(c)
}

# ---------------------------------------------------------------------------
# Setup
# ---------------------------------------------------------------------------

export function pm_new(project_dir: string) -> ptr<Pm> {
    let pm: ptr<Pm> = malloc(64) as ptr<Pm>
    pm[0].d = jd_new()
    let mut dir: string = project_dir
    if str_starts(dir, "/") == false {
        dir = path_join(cwd(), dir)
    }
    pm[0].project_dir = path_normalize(dir)
    let mut root: string = pkg_env("FLOW_REPO_ROOT")
    if str_len(root) == 0 {
        root = "."
    }
    pm[0].repo_root = path_resolve(root)
    pm[0].reg = -1
    pm[0].reg_pkgs = -1
    pm[0].reg_name = "flow-packages"
    pm[0].last_sha = ""
    return pm
}

function config_file(pm: ptr<Pm>) -> string {
    return path_join(pm[0].project_dir, "flow.toml")
}

function packages_dir(pm: ptr<Pm>) -> string {
    return path_join(pm[0].project_dir, "flow_packages")
}

function lock_file(pm: ptr<Pm>) -> string {
    return path_join(pm[0].project_dir, "flow.lock")
}

function stdlib_file(pm: ptr<Pm>, name: string) -> string {
    return path_join(pm[0].repo_root, str_cat3("lib/stdlib/", name, ".flow"))
}

# ---------------------------------------------------------------------------
# Registry index
# ---------------------------------------------------------------------------

function fail_hard(msg: string) {
    say(msg)
    let _f: i32 = fflush(null)
    exit(1)
}

function empty_index(pm: ptr<Pm>) -> i32 {
    let d: ptr<JDoc> = pm[0].d
    let o: i32 = jd_obj(d)
    jd_set(d, o, "version", jd_add(d, JV_INT, "1", 0))
    jd_set(d, o, "name", jd_str(d, "flow-packages"))
    jd_set(d, o, "packages", jd_obj(d))
    return o
}

function load_index_file(pm: ptr<Pm>, path: string) -> i32 {
    if path_exists(path) == false {
        return empty_index(pm)
    }
    let root: i32 = jd_parse_json(pm[0].d, read_text(path))
    if root < 0 {
        fail_hard(str_cat3("Registry index is not valid JSON: ", path, ""))
    }
    return root
}

function fetch_remote_index(pm: ptr<Pm>, url: string) -> i32 {
    let mut home: string = pkg_env("FLOW_HOME")
    if str_len(home) == 0 {
        home = path_join(pkg_env("HOME"), ".flow")
    }
    let cache_dir: string = path_join(home, "cache")
    mkdirs(cache_dir)
    let cache: string = path_join(cache_dir, "index.json")
    if str_starts(url, "https://") == false and str_starts(url, "http://") == false {
        fail_hard(str_cat("registry URL must be http(s): ", url))
    }
    let tmp: string = str_cat(cache, ".download")
    if fetch_url(pm, url, tmp) == 0 {
        let raw: string = read_text(tmp)
        let _w: bool = write_text(cache, raw)
        rmtree(pm, tmp)
        let root: i32 = jd_parse_json(pm[0].d, raw)
        if root >= 0 {
            return root
        }
    }
    rmtree(pm, tmp)
    if path_exists(cache) {
        let root2: i32 = jd_parse_json(pm[0].d, read_text(cache))
        if root2 >= 0 {
            return root2
        }
    }
    fail_hard(str_cat("Failed to fetch registry index from ", url))
    return -1
}

function registry(pm: ptr<Pm>) {
    if pm[0].reg >= 0 {
        return
    }
    let d: ptr<JDoc> = pm[0].d
    let override: string = pkg_env("FLOW_REGISTRY_PATH")
    let url: string = pkg_env("FLOW_REGISTRY_URL")
    let mut root: i32 = -1
    if str_len(url) > 0 and str_len(override) == 0 {
        root = fetch_remote_index(pm, url)
    } else {
        let mut path: string = path_join(pm[0].repo_root, "registry/index.json")
        if str_len(override) > 0 {
            path = path_resolve(expand_user(override))
        }
        root = load_index_file(pm, path)
    }
    pm[0].reg = root
    let mut pkgs: i32 = jd_get(d, root, "packages")
    if jd_truthy(d, pkgs) == false {
        pkgs = jd_get(d, root, "packets")
    }
    if jd_truthy(d, pkgs) == false {
        pkgs = jd_get(d, root, "crates")
    }
    if jd_truthy(d, pkgs) == false or jd_kind(d, pkgs) != JV_OBJ {
        pkgs = jd_obj(d)
    }
    pm[0].reg_pkgs = pkgs
    let nm: i32 = jd_get(d, root, "name")
    if nm >= 0 {
        pm[0].reg_name = jd_py_str_s(d, nm)
    }
}

function reg_get(pm: ptr<Pm>, name: string) -> i32 {
    registry(pm)
    return jd_get(pm[0].d, pm[0].reg_pkgs, name)
}

# PackageVersion.version: str(data.get("version", "0.0.0")).
function pv_version(pm: ptr<Pm>, v: i32) -> string {
    let x: i32 = jd_get(pm[0].d, v, "version")
    if x < 0 {
        return "0.0.0"
    }
    return jd_py_str_s(pm[0].d, x)
}

function pv_yanked(pm: ptr<Pm>, v: i32) -> bool {
    return jd_truthy(pm[0].d, jd_get(pm[0].d, v, "yanked"))
}

# Highest matching version that is not yanked; the first listed wins a tie.
function resolve_version(pm: ptr<Pm>, meta: i32, req: string) -> i32 {
    let d: ptr<JDoc> = pm[0].d
    let versions: i32 = jd_get(d, meta, "versions")
    if jd_kind(d, versions) != JV_ARR {
        return -1
    }
    let mut best: i32 = -1
    let mut best_sv: Semver = Semver { major: 0, minor: 0, patch: 0 }
    let mut c: i32 = jd_first(d, versions)
    while c >= 0 {
        if pv_yanked(pm, c) == false {
            let ver: string = pv_version(pm, c)
            if flowc_semver_matches(req, ver) {
                let sv: Semver = flowc_semver_parse(ver)
                if best < 0 or flowc_semver_cmp(sv, best_sv) > 0 {
                    best = c
                    best_sv = sv
                }
            }
        }
        c = jd_next(d, c)
    }
    return best
}

function reg_resolve(pm: ptr<Pm>, name: string, req: string) -> i32 {
    let meta: i32 = reg_get(pm, name)
    if meta < 0 {
        return -1
    }
    return resolve_version(pm, meta, req)
}

# PackageVersion.to_dep_spec(): the flow.toml table for a registry version.
function to_dep_spec(pm: ptr<Pm>, v: i32) -> i32 {
    let d: ptr<JDoc> = pm[0].d
    let spec: i32 = jd_obj(d)
    let path: i32 = jd_get(d, v, "path")
    if jd_truthy(d, path) {
        let ps: string = jd_py_str_s(d, path)
        let mut out: string = path_normalize(ps)
        if str_starts(ps, "/") == false {
            out = path_resolve(path_join(pm[0].repo_root, ps))
        }
        jd_set(d, spec, "path", jd_str(d, out))
        return spec
    }
    let git: i32 = jd_get(d, v, "git")
    if jd_truthy(d, git) {
        jd_set(d, spec, "git", git)
        let tag: i32 = jd_get(d, v, "tag")
        let rev: i32 = jd_get(d, v, "rev")
        let branch: i32 = jd_get(d, v, "branch")
        if jd_truthy(d, tag) {
            jd_set(d, spec, "tag", tag)
        } else {
            if jd_truthy(d, rev) {
                jd_set(d, spec, "rev", rev)
            } else {
                if jd_truthy(d, branch) {
                    jd_set(d, spec, "branch", branch)
                }
            }
        }
        return spec
    }
    fail_hard(str_cat3("version ", pv_version(pm, v), " has no path or git source"))
    return -1
}

# ---------------------------------------------------------------------------
# flow.toml and flow.lock
# ---------------------------------------------------------------------------

export function pm_load_config(pm: ptr<Pm>) -> i32 {
    let path: string = config_file(pm)
    if path_exists(path) == false {
        say_color(RED, "No flow.toml found. Run 'flow init' first.")
        return -1
    }
    let root: i32 = jd_parse_toml(pm[0].d, read_text(path))
    if root < 0 {
        say_color(RED, str_cat("Error parsing flow.toml: ", pm[0].d[0].err))
        return -1
    }
    return root
}

# config.dependencies (data.get("dependencies", {})).
function cfg_table(pm: ptr<Pm>, root: i32, key: string) -> i32 {
    let v: i32 = jd_get(pm[0].d, root, key)
    if v < 0 {
        let o: i32 = jd_obj(pm[0].d)
        jd_set(pm[0].d, root, key, o)
        return o
    }
    return v
}

function cfg_str(pm: ptr<Pm>, tbl: i32, key: string, dflt: string) -> string {
    let v: i32 = jd_get(pm[0].d, tbl, key)
    if v < 0 {
        return dflt
    }
    return jd_py_str_s(pm[0].d, v)
}

function toml_list_line(pm: ptr<Pm>, sb: ptr<SBuf>, key: string, list: i32) {
    let d: ptr<JDoc> = pm[0].d
    if jd_truthy(d, list) == false or jd_kind(d, list) != JV_ARR {
        return
    }
    sb_puts(sb, key)
    sb_puts(sb, " = [")
    let mut c: i32 = jd_first(d, list)
    let mut first: bool = true
    while c >= 0 {
        if first == false {
            sb_puts(sb, ", ")
        }
        first = false
        sb_putc(sb, 34)
        jd_py_str(d, c, sb)
        sb_putc(sb, 34)
        c = jd_next(d, c)
    }
    sb_puts(sb, "]\n")
}

# FlowPackage.to_toml(): the manifest as `flow add` rewrites it.
function to_toml(pm: ptr<Pm>, root: i32) -> string {
    let d: ptr<JDoc> = pm[0].d
    let mut pkg: i32 = jd_get(d, root, "package")
    if pkg < 0 {
        pkg = jd_obj(d)
    }
    let mut native: i32 = jd_get(d, root, "native")
    if native < 0 {
        native = jd_obj(d)
    }
    let sb: ptr<SBuf> = sb_new()
    sb_puts(sb, "[package]\nname = \"")
    sb_puts(sb, cfg_str(pm, pkg, "name", "unnamed"))
    sb_puts(sb, "\"\nversion = \"")
    sb_puts(sb, cfg_str(pm, pkg, "version", "0.1.0"))
    sb_puts(sb, "\"\ndescription = \"")
    sb_puts(sb, cfg_str(pm, pkg, "description", ""))
    sb_puts(sb, "\"\nauthor = \"")
    sb_puts(sb, cfg_str(pm, pkg, "author", ""))
    sb_puts(sb, "\"\nlicense = \"")
    sb_puts(sb, cfg_str(pm, pkg, "license", "MIT"))
    sb_puts(sb, "\"\nentry = \"")
    sb_puts(sb, cfg_str(pm, pkg, "entry", "src/main.flow"))
    sb_puts(sb, "\"\n\n[dependencies]\n")
    let deps: i32 = cfg_table(pm, root, "dependencies")
    let mut c: i32 = jd_first(d, deps)
    while c >= 0 {
        sb_puts(sb, jd_mem_key(d, c))
        sb_puts(sb, " = ")
        jd_toml_value(d, jd_mem_val(d, c), sb)
        sb_putc(sb, 10)
        c = jd_next(d, c)
    }
    sb_puts(sb, "\n[dev-dependencies]\n")
    let dev: i32 = cfg_table(pm, root, "dev-dependencies")
    c = jd_first(d, dev)
    while c >= 0 {
        sb_puts(sb, jd_mem_key(d, c))
        sb_puts(sb, " = ")
        jd_toml_value(d, jd_mem_val(d, c), sb)
        sb_putc(sb, 10)
        c = jd_next(d, c)
    }
    let sources: i32 = jd_get(d, native, "sources")
    let frameworks: i32 = jd_get(d, native, "frameworks")
    let libs: i32 = jd_get(d, native, "libs")
    if jd_truthy(d, sources) or jd_truthy(d, frameworks) or jd_truthy(d, libs) {
        sb_puts(sb, "\n[native]\n")
        toml_list_line(pm, sb, "sources", sources)
        toml_list_line(pm, sb, "frameworks", frameworks)
        toml_list_line(pm, sb, "libs", libs)
        toml_list_line(pm, sb, "cflags", jd_get(d, native, "cflags"))
        toml_list_line(pm, sb, "ldflags", jd_get(d, native, "ldflags"))
    }
    sb_puts(sb, "\n[build]\nhost = \"flowc\"\n")
    sb_puts(sb, "# test_command = \"flow run tests/test_main.flow\"\n")
    sb_puts(sb, "\n[conventions]\n# avoid = [\n")
    sb_puts(sb, "#   { pattern = \"reverse for loop\", reason = \"generates incorrect step direction (#410)\", workaround = \"use while with explicit decrement\" },\n")
    sb_puts(sb, "# ]\n\n[patterns]\n")
    sb_puts(sb, "# math = \"use fabs((x) as f64) as f32 for single-precision abs\"\n")
    return sb_str(sb)
}

function read_lock(pm: ptr<Pm>) -> i32 {
    let d: ptr<JDoc> = pm[0].d
    let path: string = lock_file(pm)
    if path_exists(path) {
        let root: i32 = jd_parse_json(d, read_text(path))
        if root >= 0 and jd_kind(d, root) == JV_OBJ {
            return root
        }
    }
    let o: i32 = jd_obj(d)
    jd_set(d, o, "version", jd_add(d, JV_INT, "1", 0))
    jd_set(d, o, "packages", jd_obj(d))
    return o
}

function write_lock(pm: ptr<Pm>, lock: i32) {
    let sb: ptr<SBuf> = sb_new()
    jd_dump_json(pm[0].d, lock, sb, 0)
    sb_putc(sb, 10)
    let _w: bool = write_text(lock_file(pm), sb_str(sb))
}

# lock.setdefault("packages", {})
function lock_packages(pm: ptr<Pm>, lock: i32) -> i32 {
    let d: ptr<JDoc> = pm[0].d
    let p: i32 = jd_get(d, lock, "packages")
    if p >= 0 {
        return p
    }
    let o: i32 = jd_obj(d)
    jd_set(d, lock, "packages", o)
    return o
}

function lock_entry(pm: ptr<Pm>, version: i32, source: string, resolved: i32) -> i32 {
    let d: ptr<JDoc> = pm[0].d
    let e: i32 = jd_obj(d)
    jd_set(d, e, "version", version)
    jd_set(d, e, "source", jd_str(d, source))
    if resolved >= 0 {
        jd_set(d, e, "resolved", resolved)
    }
    return e
}

# ---------------------------------------------------------------------------
# Git URLs
# ---------------------------------------------------------------------------

export function looks_like_git_url(value: string) -> bool {
    let v: string = str_strip(value)
    if str_starts(v, "git+") or str_starts(v, "git@") or str_starts(v, "ssh://git@") or str_starts(v, "file://") {
        return true
    }
    if str_starts(v, "http://") or str_starts(v, "https://") {
        let lower: string = str_lower(v)
        if str_ends(lower, ".git") or str_contains(lower, ".git#") {
            return true
        }
        if str_contains(lower, "github.com/") or str_contains(lower, "gitlab.com/") or str_contains(lower, "bitbucket.org/") or str_contains(lower, "codeberg.org/") {
            return true
        }
    }
    return false
}

export function normalize_git_url(url: string) -> string {
    let mut u: string = str_strip(url)
    if str_starts(u, "git+") {
        u = str_slice(u, 4, str_len(u))
    }
    if str_contains(u, "#") and str_starts(u, "file://") == false {
        u = str_slice(u, 0, str_find_byte(u, 35))
    }
    let p: ptr<u8> = u as ptr<u8>
    let mut n: i32 = str_len(u)
    while n > 0 and p[n - 1] == 47 {
        n = n - 1
    }
    return str_slice(u, 0, n)
}

export function infer_git_name(url: string) -> string {
    let u: string = normalize_git_url(url)
    let mut path: string = u
    if str_starts(u, "git@") and str_contains(u, ":") {
        path = str_slice(u, str_find_byte(u, 58) + 1, str_len(u))
    }
    let mut name: string = ""
    let np: string = path_normalize(path)
    if str_eq(np, ".") == false and str_eq(np, "/") == false {
        name = path_name(np)
    }
    if str_ends(name, ".git") {
        name = str_slice(name, 0, str_len(name) - 4)
    }
    if str_len(name) == 0 {
        return "unnamed"
    }
    return name
}

# ---------------------------------------------------------------------------
# Install
# ---------------------------------------------------------------------------

function is_hex_sha(d: ptr<JDoc>, ref: i32) -> bool {
    if jd_kind(d, ref) != JV_STR {
        return false
    }
    let s: string = str_lower(jd_sval(d, ref))
    if str_len(s) < 7 {
        return false
    }
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    while p[i] != 0 {
        let c: i32 = p[i] as i32
        if (c >= 48 and c <= 57) == false and (c >= 97 and c <= 102) == false {
            return false
        }
        i = i + 1
    }
    return true
}

# Run git. argv holds the command ("git" first, as the Python command list
# did); stdout is discarded and stderr written to errfile. Returns git's
# exit status, or 200 when git is not on PATH.
function run_git(pm: ptr<Pm>, argv: i32, errfile: string) -> i32 {
    let d: ptr<JDoc> = pm[0].d
    if str_len(proc_which("git")) == 0 {
        return 200
    }
    let g: ptr<ProcCmd> = proc_cmd("git")
    let mut c: i32 = jd_next(d, jd_first(d, argv))
    while c >= 0 {
        proc_arg(g, jd_sval(d, c))
        c = jd_next(d, c)
    }
    let _f: i32 = fflush(null)
    proc_stdout(g, PROC_NULL)
    proc_stderr(g, PROC_CAPTURE)
    let r: ptr<ProcResult> = proc_run(g)
    let _w: bool = write_text(errfile, r.stderr)
    return child_status(r)
}

function git_argv(pm: ptr<Pm>) -> i32 {
    return args1(pm, "git")
}

# The HEAD commit of repo (git rev-parse HEAD), "" when git fails.
function git_head_sha(pm: ptr<Pm>, repo: string) -> string {
    let c: ptr<ProcCmd> = cmd2("git", "-C", repo)
    proc_arg(c, "rev-parse")
    proc_arg(c, "HEAD")
    let _f: i32 = fflush(null)
    proc_stdout(c, PROC_CAPTURE)
    proc_stderr(c, PROC_NULL)
    let r: ptr<ProcResult> = proc_run(c)
    let mut n: i32 = str_len(r.stdout)
    if n == 0 {
        return ""
    }
    # popen read at most 255 bytes.
    if n > 255 {
        n = 255
    }
    return str_strip(str_slice(r.stdout, 0, n))
}

# CalledProcessError's message for a failed git command.
function called_process_error(pm: ptr<Pm>, argv: i32, rc: i32) -> string {
    let sb: ptr<SBuf> = sb_new()
    sb_puts(sb, "Command '")
    jd_py_repr(pm[0].d, argv, sb)
    sb_puts(sb, "' returned non-zero exit status ")
    sb_put_int(sb, rc as i64)
    sb_puts(sb, ".")
    return sb_str(sb)
}

function git_failed(pm: ptr<Pm>, name: string, argv: i32, rc: i32, errfile: string, staging: string) -> bool {
    if rc == 200 {
        say_color(RED, "git not found on PATH")
        return false
    }
    let err: string = read_text(errfile)
    let sb: ptr<SBuf> = sb_new()
    sb_puts(sb, "Git dependency install failed for ")
    sb_puts(sb, name)
    sb_puts(sb, ": ")
    sb_puts(sb, called_process_error(pm, argv, rc))
    if str_len(err) > 0 {
        sb_puts(sb, " ")
        sb_puts(sb, DASH)
        sb_puts(sb, " ")
        sb_puts(sb, str_strip(err))
    }
    say_color(RED, sb_str(sb))
    if str_len(staging) > 0 and path_exists(staging) {
        rmtree(pm, staging)
    }
    return false
}

function install_git_dependency(pm: ptr<Pm>, name: string, spec: i32) -> bool {
    let d: ptr<JDoc> = pm[0].d
    pm[0].last_sha = ""
    let git_url: string = normalize_git_url(jd_py_str_s(d, jd_get(d, spec, "git")))
    let pdir: string = packages_dir(pm)
    let dest: string = path_join(pdir, name)
    let mut ref: i32 = jd_get(d, spec, "tag")
    if jd_truthy(d, ref) == false {
        ref = jd_get(d, spec, "rev")
    }
    if jd_truthy(d, ref) == false {
        ref = jd_get(d, spec, "branch")
    }
    let subdir: i32 = jd_get(d, spec, "subdir")
    let has_subdir: bool = jd_truthy(d, subdir)
    let mut clone_dest: string = dest
    let mut staging: string = ""
    if has_subdir {
        staging = path_join(pdir, str_cat(".git-staging-", name))
        if path_exists(staging) {
            rmtree(pm, staging)
        }
        clone_dest = staging
    }
    let errfile: string = temp_path(str_cat("flow-pkg-git-stderr-", name))

    if path_exists(clone_dest) and path_exists(path_join(clone_dest, ".git")) {
        let argv: i32 = git_argv(pm)
        args_push(pm, argv, "-C")
        args_push(pm, argv, clone_dest)
        args_push(pm, argv, "fetch")
        args_push(pm, argv, "--tags")
        args_push(pm, argv, "--prune")
        let rc: i32 = run_git(pm, argv, errfile)
        if rc != 0 {
            let ok: bool = git_failed(pm, name, argv, rc, errfile, staging)
            rmtree(pm, errfile)
            return ok
        }
    } else {
        if path_exists(clone_dest) {
            rmtree(pm, clone_dest)
        }
        let argv: i32 = git_argv(pm)
        args_push(pm, argv, "clone")
        if jd_truthy(d, ref) and is_hex_sha(d, ref) == false {
            args_push(pm, argv, "--depth")
            args_push(pm, argv, "1")
            args_push(pm, argv, "--branch")
            args_push(pm, argv, jd_py_str_s(d, ref))
            ref = -1
        }
        args_push(pm, argv, git_url)
        args_push(pm, argv, clone_dest)
        let rc: i32 = run_git(pm, argv, errfile)
        if rc != 0 {
            let ok: bool = git_failed(pm, name, argv, rc, errfile, staging)
            rmtree(pm, errfile)
            return ok
        }
    }
    if jd_truthy(d, ref) {
        let fetch: i32 = git_argv(pm)
        args_push(pm, fetch, "-C")
        args_push(pm, fetch, clone_dest)
        args_push(pm, fetch, "fetch")
        args_push(pm, fetch, "--tags")
        args_push(pm, fetch, "--prune")
        let _rf: i32 = run_git(pm, fetch, errfile)
        let argv: i32 = git_argv(pm)
        args_push(pm, argv, "-C")
        args_push(pm, argv, clone_dest)
        args_push(pm, argv, "checkout")
        args_push(pm, argv, jd_py_str_s(d, ref))
        let rc: i32 = run_git(pm, argv, errfile)
        if rc != 0 {
            let ok: bool = git_failed(pm, name, argv, rc, errfile, staging)
            rmtree(pm, errfile)
            return ok
        }
    }
    rmtree(pm, errfile)

    pm[0].last_sha = git_head_sha(pm, clone_dest)

    let mut label: string = git_url
    if has_subdir {
        let sub: string = jd_py_str_s(d, subdir)
        let src: string = path_join(clone_dest, sub)
        if path_exists(src) == false {
            say_color(RED, str_cat3(str_cat3("Git dependency ", name, ": subdir '"), sub, "' not found in repo"))
            return false
        }
        if path_exists(dest) {
            rmtree(pm, dest)
        }
        copy_package_dir(pm, src, dest)
        if path_exists(staging) {
            rmtree(pm, staging)
        }
        label = str_cat3(git_url, "/", sub)
    }
    say_color(GREEN, str_cat3(str_cat3(CHECK, " Installed ", name), " from git (", str_cat(label, ")")))
    return true
}

# A scratch file outside the project (TMPDIR, else /tmp).
function temp_path(stem: string) -> string {
    let mut dir: string = pkg_env("TMPDIR")
    if str_len(dir) == 0 {
        dir = "/tmp"
    }
    let sb: ptr<SBuf> = sb_new()
    sb_puts(sb, stem)
    sb_putc(sb, 45)
    sb_put_int(sb, getpid() as i64)
    return path_join(dir, sb_str(sb))
}

# pathlib's with_suffix(".flow") on flow_packages/<name>.
function with_flow_suffix(p: string) -> string {
    let name: string = path_name(p)
    let dot: i32 = str_rfind_byte(name, 46)
    if dot > 0 and dot < str_len(name) - 1 {
        return str_cat(str_slice(p, 0, str_len(p) - str_len(name) + dot), ".flow")
    }
    return str_cat(p, ".flow")
}

# Install one package from stdlib, a local path, git or the registry.
export function install_package(pm: ptr<Pm>, name: string, spec: i32) -> bool {
    let d: ptr<JDoc> = pm[0].d
    let pdir: string = packages_dir(pm)
    if path_is_dir(pdir) == false {
        let _m: i32 = flowc_io_mkdir(pdir)
    }

    let stdlib_path: string = stdlib_file(pm, name)
    if path_exists(stdlib_path) {
        let _c: i32 = copy_file(pm, stdlib_path, path_join(pdir, str_cat(name, ".flow")))
        say_color(GREEN, str_cat3(CHECK, " Installed ", str_cat(name, " from stdlib")))
        return true
    }

    if jd_kind(d, spec) == JV_OBJ {
        if jd_has(d, spec, "path") {
            let raw: string = expand_user(jd_py_str_s(d, jd_get(d, spec, "path")))
            let mut source: string = ""
            if str_starts(raw, "/") {
                source = path_resolve(raw)
            } else {
                source = path_resolve(path_join(pm[0].project_dir, raw))
            }
            if path_exists(source) == false {
                say_color(RED, str_cat("Path dependency not found: ", source))
                return false
            }
            let dest: string = path_join(pdir, name)
            if path_is_dir(source) {
                copy_package_dir(pm, source, dest)
            } else {
                let _c2: i32 = copy_file(pm, source, with_flow_suffix(dest))
            }
            say_color(GREEN, str_cat3(str_cat3(CHECK, " Installed ", name), " from ", source))
            return true
        }
        if jd_has(d, spec, "git") {
            return install_git_dependency(pm, name, spec)
        }
        let sb: ptr<SBuf> = sb_new()
        sb_puts(sb, "Unsupported dependency spec for ")
        sb_puts(sb, name)
        sb_puts(sb, ": ")
        jd_py_repr(d, spec, sb)
        say_color(RED, sb_str(sb))
        return false
    }

    if path_exists(path_join(pm[0].project_dir, str_cat(name, ".flow"))) {
        say_color(YELLOW, str_cat(name, " is a local file"))
        return true
    }

    let k: i32 = jd_kind(d, spec)
    if k == JV_STR or k < 0 or k == JV_NULL {
        let mut req: string = "*"
        if k == JV_STR {
            req = jd_sval(d, spec)
        }
        let v: i32 = reg_resolve(pm, name, req)
        if v >= 0 {
            let resolved: i32 = to_dep_spec(pm, v)
            say_color(BLUE, str_cat3(str_cat3(DOWN, " ", name), "@", str_cat(pv_version(pm, v), " from registry")))
            return install_package(pm, name, resolved)
        }
    }

    let sb2: ptr<SBuf> = sb_new()
    sb_puts(sb2, "Unknown dependency '")
    sb_puts(sb2, name)
    sb_puts(sb2, "'. Not in registry, path, git, or stdlib. Try: flow search ")
    sb_puts(sb2, name)
    say_color(RED, sb_str(sb2))
    return false
}

# Install every dependency and refresh flow.lock (FlowPackageManager.install).
export function pm_install(pm: ptr<Pm>) -> bool {
    let d: ptr<JDoc> = pm[0].d
    let cfg: i32 = pm_load_config(pm)
    if cfg < 0 {
        return false
    }
    say_color(BLUE, "Installing dependencies...")
    let mut success: bool = true
    let lock: i32 = read_lock(pm)
    let lpk: i32 = lock_packages(pm, lock)
    let deps: i32 = cfg_table(pm, cfg, "dependencies")
    let mut m: i32 = jd_first(d, deps)
    while m >= 0 {
        let name: string = jd_mem_key(d, m)
        let spec: i32 = jd_mem_val(d, m)
        m = jd_next(d, m)
        let mut locked: i32 = jd_get(d, lpk, name)
        if jd_kind(d, locked) != JV_OBJ {
            locked = -1
        }
        let mut install_spec: i32 = jd_get(d, locked, "resolved")
        if jd_truthy(d, install_spec) == false {
            install_spec = jd_get(d, locked, "version")
        }
        if jd_truthy(d, install_spec) == false {
            install_spec = spec
        }
        let spec_is_dict: bool = jd_kind(d, spec) == JV_OBJ
        if spec_is_dict {
            install_spec = spec
        }
        if install_package(pm, name, install_spec) == false {
            success = false
            continue
        }
        let mut resolved: i32 = -1
        let mut locked_ver: i32 = spec
        let mut source: string = "registry"
        if path_exists(stdlib_file(pm, name)) and spec_is_dict == false {
            source = "stdlib"
        } else {
            if spec_is_dict and jd_has(d, spec, "path") {
                source = "path"
            } else {
                if spec_is_dict and jd_has(d, spec, "git") {
                    source = "git"
                    if str_len(pm[0].last_sha) > 0 {
                        resolved = jd_copy_obj(d, spec)
                        jd_set(d, resolved, "rev", jd_str(d, pm[0].last_sha))
                    }
                } else {
                    let mut req: string = "*"
                    if jd_kind(d, spec) == JV_STR {
                        req = jd_sval(d, spec)
                    }
                    let v: i32 = reg_resolve(pm, name, req)
                    if v >= 0 {
                        locked_ver = jd_str(d, pv_version(pm, v))
                        resolved = to_dep_spec(pm, v)
                    }
                }
            }
        }
        if jd_truthy(d, resolved) == false {
            resolved = -1
        }
        jd_set(d, lpk, name, lock_entry(pm, locked_ver, source, resolved))
    }
    if success {
        write_lock(pm, lock)
        say(str_cat3("\n", GREEN, str_cat3(CHECK, " All dependencies installed (flow.lock updated)", RESET)))
    }
    return success
}

# find_flow_toml: walk up from the program (or directory) to a flow.toml.
function find_flow_toml(start: string) -> string {
    let mut cur: string = path_resolve(start)
    if path_is_file(cur) {
        cur = path_parent(cur)
    }
    while true {
        let cand: string = path_join(cur, "flow.toml")
        if path_is_file(cand) {
            return cand
        }
        let parent: string = path_parent(cur)
        if str_eq(parent, cur) {
            return ""
        }
        cur = parent
    }
    return ""
}

# FlowPackageManager.sync_for_program: install only when something is missing.
export function pm_sync_for_program(program: string) -> bool {
    let toml: string = find_flow_toml(program)
    if str_len(toml) == 0 {
        return true
    }
    let pm: ptr<Pm> = pm_new(path_parent(toml))
    let d: ptr<JDoc> = pm[0].d
    let cfg: i32 = pm_load_config(pm)
    if cfg < 0 {
        return false
    }
    let deps: i32 = cfg_table(pm, cfg, "dependencies")
    if jd_truthy(d, deps) == false {
        return true
    }
    let mut installed: bool = true
    let mut m: i32 = jd_first(d, deps)
    while m >= 0 {
        if path_exists(path_join(packages_dir(pm), jd_mem_key(d, m))) == false {
            installed = false
        }
        m = jd_next(d, m)
    }
    if path_exists(lock_file(pm)) and installed {
        return true
    }
    return pm_install(pm)
}

# ---------------------------------------------------------------------------
# add
# ---------------------------------------------------------------------------

export struct AddOpts {
    version: string,
    git: string,
    path: string,
    tag: string,
    rev: string,
    branch: string,
    subdir: string
}

function stdlib_exists(pm: ptr<Pm>, name: string) -> bool {
    return path_exists(stdlib_file(pm, name))
}

# FlowPackageManager.add
export function pm_add(pm: ptr<Pm>, package_name: string, o: ptr<AddOpts>) -> bool {
    let d: ptr<JDoc> = pm[0].d
    let cfg: i32 = pm_load_config(pm)
    if cfg < 0 {
        return false
    }
    let mut pkg_name: string = package_name
    let mut git: string = o[0].git
    let path: string = o[0].path
    let mut version: string = o[0].version
    if str_len(git) == 0 and str_len(path) == 0 and looks_like_git_url(pkg_name) {
        git = pkg_name
        pkg_name = infer_git_name(git)
    }
    # _parse_add_spec
    let mut name: string = str_strip(pkg_name)
    let mut ver_from_at: string = "*"
    if str_contains(pkg_name, "@") and str_starts(pkg_name, "@") == false and str_starts(pkg_name, "git@") == false {
        let at: i32 = str_find_byte(pkg_name, 64)
        name = str_strip(str_slice(pkg_name, 0, at))
        ver_from_at = str_strip(str_slice(pkg_name, at + 1, str_len(pkg_name)))
        if str_len(ver_from_at) == 0 {
            ver_from_at = "*"
        }
    }
    if str_eq(version, "*") and str_eq(ver_from_at, "*") == false {
        version = ver_from_at
    }
    if str_len(git) > 0 {
        git = normalize_git_url(git)
        if str_eq(name, "unnamed") or str_len(name) == 0 or looks_like_git_url(name) {
            name = infer_git_name(git)
        }
    }
    let deps: i32 = cfg_table(pm, cfg, "dependencies")
    if jd_has(d, deps, name) {
        say_color(YELLOW, str_cat(name, " already in dependencies"))
        return false
    }

    let mut spec: i32 = -1
    let mut source: string = ""
    if str_len(path) > 0 {
        spec = jd_obj(d)
        jd_set(d, spec, "path", jd_str(d, path))
        source = "path"
    } else {
        if str_len(git) > 0 {
            spec = jd_obj(d)
            jd_set(d, spec, "git", jd_str(d, git))
            if str_len(o[0].tag) > 0 {
                jd_set(d, spec, "tag", jd_str(d, o[0].tag))
            } else {
                if str_len(o[0].rev) > 0 {
                    jd_set(d, spec, "rev", jd_str(d, o[0].rev))
                } else {
                    if str_len(o[0].branch) > 0 {
                        jd_set(d, spec, "branch", jd_str(d, o[0].branch))
                    }
                }
            }
            if str_len(o[0].subdir) > 0 {
                jd_set(d, spec, "subdir", jd_str(d, o[0].subdir))
            }
            source = "git"
        } else {
            let v: i32 = reg_resolve(pm, name, version)
            if v < 0 {
                if stdlib_exists(pm, name) {
                    if str_eq(version, "*") {
                        spec = jd_str(d, "0.0.0")
                    } else {
                        spec = jd_str(d, version)
                    }
                    source = "stdlib"
                } else {
                    registry(pm)
                    say_color(RED, str_cat3(str_cat3("Package '", name, "' not found in registry ("), pm[0].reg_name, ")."))
                    let sb: ptr<SBuf> = sb_new()
                    sb_puts(sb, "  Try: ")
                    sb_puts(sb, BLUE)
                    sb_puts(sb, "flow search ")
                    sb_puts(sb, name)
                    sb_puts(sb, RESET)
                    sb_puts(sb, "  or  ")
                    sb_puts(sb, BLUE)
                    sb_puts(sb, "flow add --git <url> --name ")
                    sb_puts(sb, name)
                    sb_puts(sb, RESET)
                    say(sb_str(sb))
                    return false
                }
            } else {
                let pv: string = pv_version(pm, v)
                if str_eq(version, "*") or str_eq(version, "latest") {
                    spec = jd_str(d, pv)
                } else {
                    spec = jd_str(d, version)
                }
                if str_starts(version, "^") or str_starts(version, ">=") {
                    spec = jd_str(d, version)
                }
                source = "registry"
                say_color(BLUE, str_cat3(str_cat3("Resolved ", name, "@"), pv, str_cat(" from ", pm[0].reg_name)))
            }
        }
    }

    jd_set(d, deps, name, spec)
    let _w: bool = write_text(config_file(pm), to_toml(pm, cfg))
    let sb2: ptr<SBuf> = sb_new()
    sb_puts(sb2, CHECK)
    sb_puts(sb2, " Added ")
    sb_puts(sb2, name)
    sb_puts(sb2, " = ")
    jd_toml_value(d, spec, sb2)
    say_color(GREEN, sb_str(sb2))

    let ok: bool = install_package(pm, name, spec)
    if ok {
        let mut locked_ver: i32 = spec
        let mut resolved: i32 = -1
        if str_eq(source, "registry") {
            let mut req: string = "*"
            if jd_kind(d, spec) == JV_STR {
                req = jd_sval(d, spec)
            }
            let v2: i32 = reg_resolve(pm, name, req)
            if v2 >= 0 {
                locked_ver = jd_str(d, pv_version(pm, v2))
                resolved = to_dep_spec(pm, v2)
            }
        } else {
            if str_eq(source, "git") {
                resolved = jd_copy_obj(d, spec)
                let sha: string = pm[0].last_sha
                if str_len(sha) > 0 {
                    jd_set(d, resolved, "rev", jd_str(d, sha))
                    say_color(BLUE, str_cat("  pinned rev ", str_slice(sha, 0, 12)))
                }
            }
        }
        let lock: i32 = read_lock(pm)
        jd_set(d, lock_packages(pm, lock), name, lock_entry(pm, locked_ver, source, resolved))
        write_lock(pm, lock)
    }
    return ok
}

# ---------------------------------------------------------------------------
# search / info
# ---------------------------------------------------------------------------

function pkg_field(pm: ptr<Pm>, meta: i32, key: string, dflt: string) -> string {
    return cfg_str(pm, meta, key, dflt)
}

export function pm_search(pm: ptr<Pm>, query: string) -> bool {
    let d: ptr<JDoc> = pm[0].d
    registry(pm)
    let q: string = str_strip(str_lower(query))
    let total: i32 = jd_count(d, pm[0].reg_pkgs)
    let all: ptr<i32> = malloc(((total + 1) as i64) * 4) as ptr<i32>
    let scores: ptr<i32> = malloc(((total + 1) as i64) * 4) as ptr<i32>
    let mut n: i32 = 0
    let mut c: i32 = jd_first(d, pm[0].reg_pkgs)
    while c >= 0 {
        let name: string = jd_mem_key(d, c)
        if str_len(q) == 0 {
            all[n] = c
            scores[n] = 0
            n = n + 1
        } else {
            let descr: string = pkg_field(pm, jd_mem_val(d, c), "description", "")
            let hay: string = str_lower(str_cat3(name, " ", descr))
            if str_contains(hay, q) {
                let lname: string = str_lower(name)
                let mut score: i32 = 2
                if str_eq(lname, q) {
                    score = 0
                } else {
                    if str_starts(lname, q) {
                        score = 1
                    }
                }
                all[n] = c
                scores[n] = score
                n = n + 1
            }
        }
        c = jd_next(d, c)
    }
    if str_len(q) > 0 {
        # Stable insertion sort by (score, name).
        let mut i: i32 = 1
        while i < n {
            let cv: i32 = all[i]
            let cs: i32 = scores[i]
            let mut j: i32 = i - 1
            while j >= 0 and (scores[j] > cs or (scores[j] == cs and strcmp_names(jd_mem_key(d, all[j]), jd_mem_key(d, cv)) > 0)) {
                all[j + 1] = all[j]
                scores[j + 1] = scores[j]
                j = j - 1
            }
            all[j + 1] = cv
            scores[j + 1] = cs
            i = i + 1
        }
    }
    if n > 20 {
        n = 20
    }
    if n == 0 {
        let sb: ptr<SBuf> = sb_new()
        sb_puts(sb, "No packages matched ")
        jd_py_repr(d, jd_str(d, query), sb)
        say_color(YELLOW, sb_str(sb))
        return false
    }
    let hb: ptr<SBuf> = sb_new()
    sb_puts(hb, BOLD)
    sb_puts(hb, pm[0].reg_name)
    sb_puts(hb, RESET)
    sb_puts(hb, " ")
    sb_puts(hb, DASH)
    sb_puts(hb, " ")
    sb_put_int(hb, n as i64)
    sb_puts(hb, " package(s)\n")
    say(sb_str(hb))
    let mut k: i32 = 0
    while k < n {
        let mem: i32 = all[k]
        let meta: i32 = jd_mem_val(d, mem)
        let latest: i32 = resolve_version(pm, meta, "*")
        let mut ver: string = "?"
        if latest >= 0 {
            ver = pv_version(pm, latest)
        }
        say(str_cat3(str_cat3("  ", GREEN, jd_mem_key(d, mem)), RESET, str_cat("  ", ver)))
        let descr: i32 = jd_get(d, meta, "description")
        if jd_truthy(d, descr) {
            say(str_cat("    ", jd_py_str_s(d, descr)))
        }
        k = k + 1
    }
    return true
}

function strcmp_names(a: string, b: string) -> i32 {
    return strcmp(a, b)
}

export function pm_info(pm: ptr<Pm>, name: string) -> bool {
    let d: ptr<JDoc> = pm[0].d
    let meta: i32 = reg_get(pm, name)
    if meta < 0 {
        say_color(RED, str_cat("Unknown package: ", name))
        return false
    }
    let latest: i32 = resolve_version(pm, meta, "*")
    say(str_cat3(BOLD, name, RESET))
    say(str_cat("  description: ", pkg_field(pm, meta, "description", "")))
    say(str_cat("  license:     ", pkg_field(pm, meta, "license", "MIT")))
    let hp: i32 = jd_get(d, meta, "homepage")
    if jd_truthy(d, hp) {
        say(str_cat("  homepage:    ", jd_py_str_s(d, hp)))
    }
    say("  versions:")
    let versions: i32 = jd_get(d, meta, "versions")
    if jd_kind(d, versions) == JV_ARR {
        let mut c: i32 = jd_first(d, versions)
        while c >= 0 {
            let mut mark: string = ""
            if pv_yanked(pm, c) {
                mark = " (yanked)"
            }
            let mut src: string = "?"
            let p: i32 = jd_get(d, c, "path")
            let g: i32 = jd_get(d, c, "git")
            if jd_truthy(d, p) {
                src = jd_py_str_s(d, p)
            } else {
                if jd_truthy(d, g) {
                    src = jd_py_str_s(d, g)
                }
            }
            say(str_cat3(str_cat3("    ", pv_version(pm, c), mark), str_cat3("  ", ARROW, "  "), src))
            c = jd_next(d, c)
        }
    }
    if latest >= 0 {
        say(str_cat("  latest:      ", pv_version(pm, latest)))
    }
    return true
}

# ---------------------------------------------------------------------------
# init, publish, build, run, build-native, run-native, clean
#
# The rest of src/flow/package.py and src/flow/registry.py, ported with the
# same messages and files. scripts/check_pkg_commands.sh holds the goldens
# recorded from the Python version.
# ---------------------------------------------------------------------------

const ELLIPSIS: string = "\xe2\x80\xa6"

function pkg_table(pm: ptr<Pm>, cfg: i32, key: string) -> i32 {
    let v: i32 = jd_get(pm[0].d, cfg, key)
    if v < 0 {
        return jd_obj(pm[0].d)
    }
    return v
}

# FlowPackage.from_toml's list fields: native.get(key, []).
function cfg_list(pm: ptr<Pm>, tbl: i32, key: string) -> i32 {
    let v: i32 = jd_get(pm[0].d, tbl, key)
    if v < 0 or jd_kind(pm[0].d, v) != JV_ARR {
        return jd_arr(pm[0].d)
    }
    return v
}

function arr_has_str(pm: ptr<Pm>, arr: i32, s: string) -> bool {
    let d: ptr<JDoc> = pm[0].d
    let mut c: i32 = jd_first(d, arr)
    while c >= 0 {
        if str_eq(jd_sval(d, c), s) {
            return true
        }
        c = jd_next(d, c)
    }
    return false
}

function arr_extend_str(pm: ptr<Pm>, dst: i32, src: i32) {
    let d: ptr<JDoc> = pm[0].d
    let mut c: i32 = jd_first(d, src)
    while c >= 0 {
        args_push(pm, dst, jd_py_str_s(d, c))
        c = jd_next(d, c)
    }
}

# Contents of a file written by a child process, "" when there is none.
function read_or_empty(path: string) -> string {
    if path_exists(path) == false {
        return ""
    }
    return read_text(path)
}

# Run argv (an array node of strings). With errfile set, stdout is discarded
# and stderr kept in errfile (subprocess.run with capture_output); otherwise
# both pass through. Returns the exit status.
function run_argv(pm: ptr<Pm>, argv: i32, errfile: string) -> i32 {
    let d: ptr<JDoc> = pm[0].d
    let sb: ptr<SBuf> = sb_new()
    let mut c: i32 = jd_first(d, argv)
    let mut first: bool = true
    while c >= 0 {
        if first == false {
            sb_putc(sb, 32)
        }
        first = false
        shell_quote(sb, jd_sval(d, c))
        c = jd_next(d, c)
    }
    if str_len(errfile) > 0 {
        sb_puts(sb, " >/dev/null 2>")
        shell_quote(sb, errfile)
    }
    let _f: i32 = fflush(null)
    let st: i32 = flowc_io_system(sb_str(sb))
    if st < 0 {
        return 255
    }
    if st % 256 != 0 {
        return 128 + st % 128
    }
    return (st / 256) % 256
}

# ' '.join(cmd)
function join_plain(pm: ptr<Pm>, argv: i32) -> string {
    let d: ptr<JDoc> = pm[0].d
    let sb: ptr<SBuf> = sb_new()
    let mut c: i32 = jd_first(d, argv)
    let mut first: bool = true
    while c >= 0 {
        if first == false {
            sb_putc(sb, 32)
        }
        first = false
        sb_puts(sb, jd_sval(d, c))
        c = jd_next(d, c)
    }
    return sb_str(sb)
}

# Run a captured command; on failure print the header and its stderr.
function run_or_report(pm: ptr<Pm>, argv: i32, header: string) -> bool {
    let errfile: string = temp_path("flow-pkg-stderr")
    let rc: i32 = run_argv(pm, argv, errfile)
    let err: string = read_or_empty(errfile)
    rmtree(pm, errfile)
    if rc != 0 {
        say_color(RED, header)
        say(err)
        return false
    }
    return true
}

# ---------------------------------------------------------------------------
# init
# ---------------------------------------------------------------------------

export function pm_init(pm: ptr<Pm>, name_arg: string) -> bool {
    let d: ptr<JDoc> = pm[0].d
    if path_exists(config_file(pm)) {
        say_color(YELLOW, "Project already initialized (flow.toml exists)")
        return false
    }
    let mut name: string = name_arg
    if str_len(name) == 0 {
        name = path_name(pm[0].project_dir)
    }
    let root: i32 = jd_obj(d)
    let pkg: i32 = jd_obj(d)
    jd_set(d, pkg, "name", jd_str(d, name))
    jd_set(d, pkg, "description", jd_str(d, "A FLOW project"))
    jd_set(d, root, "package", pkg)
    let _w: bool = write_text(config_file(pm), to_toml(pm, root))
    say_color(GREEN, str_cat(CHECK, " Created flow.toml"))

    let src_dir: string = path_join(pm[0].project_dir, "src")
    if path_is_dir(src_dir) == false {
        let _m: i32 = flowc_io_mkdir(src_dir)
    }
    let main_file: string = path_join(src_dir, "main.flow")
    if path_exists(main_file) == false {
        let sb: ptr<SBuf> = sb_new()
        sb_puts(sb, "# ")
        sb_puts(sb, name)
        sb_puts(sb, " - A FLOW project\n\nfunction main() -> i32 {\n    printf(\"Hello from ")
        sb_puts(sb, name)
        sb_puts(sb, "!\\n\")\n    return 0\n}\n")
        let _w2: bool = write_text(main_file, sb_str(sb))
        say_color(GREEN, str_cat(CHECK, " Created src/main.flow"))
    }
    let gitignore: string = path_join(pm[0].project_dir, ".gitignore")
    if path_exists(gitignore) == false {
        let _w3: bool = write_text(gitignore, "# FLOW build artifacts\nbuild/\nflow_packages/\n*.o\n*.so\n*.dylib\n\n# Editor files\n.vscode/\n.idea/\n*.swp\n*~\n")
        say_color(GREEN, str_cat(CHECK, " Created .gitignore"))
    }
    say(str_cat3(str_cat3("\n", BOLD, "Project '"), name, str_cat("' initialized!", RESET)))
    say("\nNext steps:")
    say(str_cat3(str_cat3("  ", BLUE, "cd "), name, RESET))
    say(str_cat3("  ", BLUE, str_cat("flow run src/main.flow", RESET)))
    return true
}

# ---------------------------------------------------------------------------
# publish (registry.py's publish_local)
# ---------------------------------------------------------------------------

# registry.parse_semver's int(): the component's value, 0 when it is not one.
function semver_part(s: string) -> i32 {
    let t: string = str_strip(s)
    let p: ptr<u8> = t as ptr<u8>
    let n: i32 = str_len(t)
    let mut i: i32 = 0
    if n > 0 and (p[0] == 43 or p[0] == 45) {
        i = 1
    }
    if i >= n {
        return 0
    }
    let mut v: i32 = 0
    while i < n {
        let c: i32 = p[i] as i32
        if c < 48 or c > 57 {
            return 0
        }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    if p[0] == 45 {
        return 0 - v
    }
    return v
}

# parse_semver into out[0..3]: leading X.Y.Z, junk after it ignored.
function semver_key(v: string, out: ptr<i32>) {
    let mut core: string = str_strip(v)
    while str_starts(core, "v") {
        core = str_slice(core, 1, str_len(core))
    }
    let plus: i32 = str_find_byte(core, 43)
    if plus >= 0 {
        core = str_slice(core, 0, plus)
    }
    let dash: i32 = str_find_byte(core, 45)
    if dash >= 0 {
        core = str_slice(core, 0, dash)
    }
    let n: i32 = str_len(core)
    let p: ptr<u8> = core as ptr<u8>
    out[0] = 0
    out[1] = 0
    out[2] = 0
    let mut k: i32 = 0
    let mut start: i32 = 0
    let mut i: i32 = 0
    while i <= n and k < 3 {
        if i == n or p[i] == 46 {
            out[k] = semver_part(str_slice(core, start, i))
            k = k + 1
            start = i + 1
        }
        i = i + 1
    }
}

function semver_key_cmp(a: ptr<i32>, b: ptr<i32>) -> i32 {
    let mut i: i32 = 0
    while i < 3 {
        if a[i] < b[i] {
            return -1
        }
        if a[i] > b[i] {
            return 1
        }
        i = i + 1
    }
    return 0
}

# str(obj.get(key, dflt))
function obj_str(pm: ptr<Pm>, obj: i32, key: string, dflt: string) -> string {
    let v: i32 = jd_get(pm[0].d, obj, key)
    if v < 0 {
        return dflt
    }
    return jd_py_str_s(pm[0].d, v)
}

# obj.pop(key): unlink the member and return its value, or -1.
function obj_pop(d: ptr<JDoc>, obj: i32, key: string) -> i32 {
    let mut prev: i32 = -1
    let mut c: i32 = d[0].first[obj]
    while c >= 0 {
        if str_eq(d[0].sval[c], key) {
            if prev < 0 {
                d[0].first[obj] = d[0].next[c]
            } else {
                d[0].next[prev] = d[0].next[c]
            }
            d[0].next[c] = -1
            return d[0].first[c]
        }
        prev = c
        c = d[0].next[c]
    }
    return -1
}

# obj.setdefault(key, dflt)
function obj_setdefault(d: ptr<JDoc>, obj: i32, key: string, dflt: i32) -> i32 {
    if jd_has(d, obj, key) {
        return jd_get(d, obj, key)
    }
    jd_set(d, obj, key, dflt)
    return dflt
}

# FlowRegistry.publish_local: register a version in the local index.json.
function publish_local(pm: ptr<Pm>, index_path: string, name: string, version: string, description: string, license: string, path: string, git: string, tag: string) {
    let d: ptr<JDoc> = pm[0].d
    let data: i32 = load_index_file(pm, index_path)
    if jd_has(d, data, "crates") and jd_has(d, data, "packages") == false {
        jd_set(d, data, "packages", obj_pop(d, data, "crates"))
    }
    if jd_has(d, data, "packets") and jd_has(d, data, "packages") == false {
        jd_set(d, data, "packages", obj_pop(d, data, "packets"))
    }
    let packages: i32 = obj_setdefault(d, data, "packages", jd_obj(d))
    if jd_truthy(d, jd_get(d, data, "name")) == false {
        jd_set(d, data, "name", jd_str(d, "flow-packages"))
    }
    let fresh: i32 = jd_obj(d)
    jd_set(d, fresh, "description", jd_str(d, description))
    jd_set(d, fresh, "homepage", jd_str(d, ""))
    jd_set(d, fresh, "license", jd_str(d, license))
    jd_set(d, fresh, "versions", jd_arr(d))
    let entry: i32 = obj_setdefault(d, packages, name, fresh)
    if str_len(description) > 0 {
        jd_set(d, entry, "description", jd_str(d, description))
    }
    if str_len(license) > 0 {
        jd_set(d, entry, "license", jd_str(d, license))
    }
    let old: i32 = obj_setdefault(d, entry, "versions", jd_arr(d))

    # The kept versions and the new one, as node ids.
    let total: i32 = jd_count(d, old) + 1
    let ids: ptr<i32> = malloc(((total + 1) as i64) * 4) as ptr<i32>
    let keys: ptr<i32> = malloc(((total + 1) as i64) * 12) as ptr<i32>
    let order: ptr<i32> = malloc(((total + 1) as i64) * 4) as ptr<i32>
    let mut n: i32 = 0
    let mut c: i32 = jd_first(d, old)
    while c >= 0 {
        if str_eq(obj_str(pm, c, "version", "None"), version) == false {
            ids[n] = c
            n = n + 1
        }
        c = jd_next(d, c)
    }
    let ver: i32 = jd_obj(d)
    jd_set(d, ver, "version", jd_str(d, version))
    jd_set(d, ver, "yanked", jd_add(d, JV_BOOL, "", 0))
    if str_len(path) > 0 {
        jd_set(d, ver, "path", jd_str(d, path))
    }
    if str_len(git) > 0 {
        jd_set(d, ver, "git", jd_str(d, git))
        if str_len(tag) > 0 {
            jd_set(d, ver, "tag", jd_str(d, tag))
        }
    }
    ids[n] = ver
    n = n + 1

    # versions.sort(key=parse_semver, reverse=True): stable, highest first.
    let mut i: i32 = 0
    while i < n {
        semver_key(obj_str(pm, ids[i], "version", "0"), keys + i * 3)
        i = i + 1
    }
    i = 0
    while i < n {
        let mut j: i32 = i
        while j > 0 and semver_key_cmp(keys + order[j - 1] * 3, keys + i * 3) < 0 {
            order[j] = order[j - 1]
            j = j - 1
        }
        order[j] = i
        i = i + 1
    }
    let sorted: i32 = jd_arr(d)
    i = 0
    while i < n {
        let node: i32 = ids[order[i]]
        d[0].next[node] = -1
        jd_append(d, sorted, node)
        i = i + 1
    }
    jd_set(d, entry, "versions", sorted)

    mkdirs(path_parent(index_path))
    let sb: ptr<SBuf> = sb_new()
    jd_dump_json(d, data, sb, 0)
    sb_putc(sb, 10)
    let _w: bool = write_text(index_path, sb_str(sb))
}

# Path.relative_to: p below root, "." for root itself, "" when outside.
function relative_to(p: string, root: string) -> string {
    if str_eq(p, root) {
        return "."
    }
    let mut prefix: string = root
    if str_ends(root, "/") == false {
        prefix = str_cat(root, "/")
    }
    if str_starts(p, prefix) {
        return str_slice(p, str_len(prefix), str_len(p))
    }
    return ""
}

export function pm_publish(pm: ptr<Pm>, git: string, tag: string, path: string, dry_run: bool) -> bool {
    let cfg: i32 = pm_load_config(pm)
    if cfg < 0 {
        return false
    }
    let pkg: i32 = pkg_table(pm, cfg, "package")
    let name: string = cfg_str(pm, pkg, "name", "unnamed")
    let version: string = cfg_str(pm, pkg, "version", "0.1.0")
    let description: string = cfg_str(pm, pkg, "description", "")
    let license: string = cfg_str(pm, pkg, "license", "MIT")
    let mut pub_path: string = path
    if str_len(pub_path) == 0 and str_len(git) == 0 {
        pub_path = relative_to(path_resolve(pm[0].project_dir), pm[0].repo_root)
        if str_len(pub_path) == 0 {
            say_color(RED, "Package is outside the Flow repo. Pass --git <url> [--tag vX.Y.Z] to publish.")
            return false
        }
    }
    say_color(BLUE, str_cat3(str_cat3("Publishing ", name, "@"), version, ELLIPSIS))
    if str_len(pub_path) > 0 {
        say(str_cat("  source: ", pub_path))
    } else {
        say(str_cat("  source: ", git))
    }
    if dry_run {
        say_color(YELLOW, "dry-run: index not written")
        return true
    }
    let override: string = pkg_env("FLOW_REGISTRY_PATH")
    let mut index_path: string = path_join(pm[0].repo_root, "registry/index.json")
    if str_len(override) > 0 {
        index_path = path_resolve(expand_user(override))
    }
    # FlowRegistry() loads the index (or fetches FLOW_REGISTRY_URL) first.
    registry(pm)
    publish_local(pm, index_path, name, version, description, license, pub_path, git, tag)
    say_color(GREEN, str_cat3(CHECK, " Registered in ", index_path))
    say(str_cat3("\nNext: commit the index change (or open a PR) so others can ", BLUE, str_cat3("flow add ", name, RESET)))
    return true
}

# ---------------------------------------------------------------------------
# build, run, clean
# ---------------------------------------------------------------------------

function build_dir(pm: ptr<Pm>) -> string {
    return path_join(pm[0].project_dir, "build")
}

function config_entry(pm: ptr<Pm>, cfg: i32) -> string {
    return cfg_str(pm, pkg_table(pm, cfg, "package"), "entry", "src/main.flow")
}

function config_name(pm: ptr<Pm>, cfg: i32) -> string {
    return cfg_str(pm, pkg_table(pm, cfg, "package"), "name", "unnamed")
}

export function pm_build(pm: ptr<Pm>) -> bool {
    let cfg: i32 = pm_load_config(pm)
    if cfg < 0 {
        return false
    }
    let entry: string = config_entry(pm, cfg)
    let name: string = config_name(pm, cfg)
    let entry_file: string = path_normalize(path_join(pm[0].project_dir, entry))
    if path_exists(entry_file) == false {
        say_color(RED, str_cat("Entry file not found: ", entry))
        return false
    }
    if path_is_dir(build_dir(pm)) == false {
        let _m: i32 = flowc_io_mkdir(build_dir(pm))
    }
    say_color(BLUE, str_cat3("Building ", name, "..."))
    let argv: i32 = args1(pm, path_join(pm[0].repo_root, "flow"))
    args_push(pm, argv, "compile")
    args_push(pm, argv, entry_file)
    if run_or_report(pm, argv, "Build failed:") == false {
        return false
    }
    say_color(GREEN, str_cat3(CHECK, " Built ", name))
    return true
}

export function pm_run(pm: ptr<Pm>) -> bool {
    let cfg: i32 = pm_load_config(pm)
    if cfg < 0 {
        return false
    }
    let entry: string = config_entry(pm, cfg)
    let entry_file: string = path_normalize(path_join(pm[0].project_dir, entry))
    if path_exists(entry_file) == false {
        say_color(RED, str_cat("Entry file not found: ", entry))
        return false
    }
    let argv: i32 = args1(pm, path_join(pm[0].repo_root, "flow"))
    args_push(pm, argv, "run")
    args_push(pm, argv, entry_file)
    return run_argv(pm, argv, "") == 0
}

export function pm_clean(pm: ptr<Pm>) -> bool {
    if path_exists(build_dir(pm)) {
        rmtree(pm, build_dir(pm))
        say_color(GREEN, str_cat(CHECK, " Cleaned build/"))
    }
    return true
}

# ---------------------------------------------------------------------------
# build-native, run-native
# ---------------------------------------------------------------------------

# Path(p).stem
function path_stem(p: string) -> string {
    let name: string = path_name(p)
    let dot: i32 = str_rfind_byte(name, 46)
    if dot > 0 and dot < str_len(name) - 1 {
        return str_slice(name, 0, dot)
    }
    return name
}

function is_cxx_source(s: string) -> bool {
    return str_ends(s, ".cpp") or str_ends(s, ".cc") or str_ends(s, ".cxx") or str_ends(s, ".mm")
}

# FlowPackageManager._collect_dependency_native: native sources and flags of
# the installed dependencies, in dependency order, into the five arrays.
function collect_dependency_native(pm: ptr<Pm>, cfg: i32, sources: i32, frameworks: i32, libs: i32, cflags: i32, ldflags: i32) {
    let d: ptr<JDoc> = pm[0].d
    if path_exists(packages_dir(pm)) == false {
        return
    }
    let deps: i32 = pkg_table(pm, cfg, "dependencies")
    let mut m: i32 = jd_first(d, deps)
    while m >= 0 {
        let dep_dir: string = path_join(packages_dir(pm), jd_mem_key(d, m))
        let dep_toml: string = path_join(dep_dir, "flow.toml")
        if path_exists(dep_toml) {
            let root: i32 = jd_parse_toml(d, read_text(dep_toml))
            if root < 0 {
                say_color(YELLOW, str_cat3(str_cat3("Warning: could not read ", dep_toml, ": "), d[0].err, ""))
            } else {
                let native: i32 = pkg_table(pm, root, "native")
                let srcs: i32 = cfg_list(pm, native, "sources")
                let mut c: i32 = jd_first(d, srcs)
                while c >= 0 {
                    let native_path: string = path_resolve(path_join(dep_dir, jd_py_str_s(d, c)))
                    if arr_has_str(pm, sources, native_path) == false {
                        if path_exists(native_path) {
                            args_push(pm, sources, native_path)
                        } else {
                            say_color(YELLOW, str_cat("Warning: dep native source not found: ", native_path))
                        }
                    }
                    c = jd_next(d, c)
                }
                let fws: i32 = cfg_list(pm, native, "frameworks")
                c = jd_first(d, fws)
                while c >= 0 {
                    if arr_has_str(pm, frameworks, jd_py_str_s(d, c)) == false {
                        args_push(pm, frameworks, jd_py_str_s(d, c))
                    }
                    c = jd_next(d, c)
                }
                let ls: i32 = cfg_list(pm, native, "libs")
                c = jd_first(d, ls)
                while c >= 0 {
                    if arr_has_str(pm, libs, jd_py_str_s(d, c)) == false {
                        args_push(pm, libs, jd_py_str_s(d, c))
                    }
                    c = jd_next(d, c)
                }
                arr_extend_str(pm, cflags, cfg_list(pm, native, "cflags"))
                arr_extend_str(pm, ldflags, cfg_list(pm, native, "ldflags"))
            }
        }
        m = jd_next(d, m)
    }
}

# FLAG ITEM pairs ("-framework F", "-l LIB") for each distinct item of a,
# then of b.
function push_flag_pairs(pm: ptr<Pm>, argv: i32, flag: string, a: i32, b: i32) {
    let d: ptr<JDoc> = pm[0].d
    let seen: i32 = jd_arr(d)
    let mut pass: i32 = 0
    while pass < 2 {
        let mut list: i32 = a
        if pass == 1 {
            list = b
        }
        let mut c: i32 = jd_first(d, list)
        while c >= 0 {
            let s: string = jd_py_str_s(d, c)
            if arr_has_str(pm, seen, s) == false {
                args_push(pm, seen, s)
                args_push(pm, argv, flag)
                args_push(pm, argv, s)
            }
            c = jd_next(d, c)
        }
        pass = pass + 1
    }
}

function native_step(pm: ptr<Pm>, argv: i32) -> bool {
    say_color(BLUE, str_cat("Running: ", join_plain(pm, argv)))
    return run_or_report(pm, argv, "Native compilation failed:")
}

export function pm_build_native(pm: ptr<Pm>, entry_arg: string, release: bool) -> bool {
    let d: ptr<JDoc> = pm[0].d
    let cfg: i32 = pm_load_config(pm)
    if cfg < 0 {
        return false
    }
    let name: string = config_name(pm, cfg)
    let mut src_file: string = ""
    if str_len(entry_arg) > 0 {
        src_file = path_normalize(entry_arg)
    } else {
        src_file = path_normalize(path_join(pm[0].project_dir, config_entry(pm, cfg)))
    }
    if path_exists(src_file) == false {
        say_color(RED, str_cat("Entry file not found: ", src_file))
        return false
    }
    let bdir: string = build_dir(pm)
    if path_is_dir(bdir) == false {
        let _m: i32 = flowc_io_mkdir(bdir)
    }
    let output_file: string = path_join(bdir, name)
    let c_file: string = path_join(bdir, str_cat(name, ".c"))
    say_color(BLUE, str_cat3("Building ", name, " with native support..."))

    # Step 1: Flow to C with flowc.
    let emit: i32 = args1(pm, path_join(pm[0].repo_root, "compiler/scripts/flowc_emit.sh"))
    args_push(pm, emit, "--lenient")
    args_push(pm, emit, path_resolve(src_file))
    args_push(pm, emit, path_resolve(c_file))
    if run_or_report(pm, emit, "Flow compilation failed:") == false {
        return false
    }

    # Step 2: the Flow C output and the native sources together.
    let dep_sources: i32 = jd_arr(d)
    let dep_frameworks: i32 = jd_arr(d)
    let dep_libs: i32 = jd_arr(d)
    let dep_cflags: i32 = jd_arr(d)
    let dep_ldflags: i32 = jd_arr(d)
    collect_dependency_native(pm, cfg, dep_sources, dep_frameworks, dep_libs, dep_cflags, dep_ldflags)
    let native: i32 = pkg_table(pm, cfg, "native")

    let c_flags: i32 = jd_arr(d)
    if release {
        args_push(pm, c_flags, "-O2")
    } else {
        args_push(pm, c_flags, "-g")
        args_push(pm, c_flags, "-O0")
    }
    arr_extend_str(pm, c_flags, dep_cflags)
    arr_extend_str(pm, c_flags, cfg_list(pm, native, "cflags"))

    let sources: i32 = args1(pm, c_file)
    arr_extend_str(pm, sources, dep_sources)
    let own: i32 = cfg_list(pm, native, "sources")
    let mut c: i32 = jd_first(d, own)
    while c >= 0 {
        let rel: string = jd_py_str_s(d, c)
        let native_path: string = path_join(pm[0].project_dir, rel)
        if path_exists(native_path) {
            args_push(pm, sources, path_resolve(native_path))
        } else {
            say_color(YELLOW, str_cat("Warning: native source not found: ", rel))
        }
        c = jd_next(d, c)
    }
    let mut uses_cxx: bool = false
    c = jd_first(d, sources)
    while c >= 0 {
        if is_cxx_source(jd_sval(d, c)) {
            uses_cxx = true
        }
        c = jd_next(d, c)
    }

    let link_flags: i32 = jd_arr(d)
    push_flag_pairs(pm, link_flags, "-framework", dep_frameworks, cfg_list(pm, native, "frameworks"))
    push_flag_pairs(pm, link_flags, "-l", dep_libs, cfg_list(pm, native, "libs"))
    arr_extend_str(pm, link_flags, dep_ldflags)
    arr_extend_str(pm, link_flags, cfg_list(pm, native, "ldflags"))

    if uses_cxx {
        # The Flow C with clang, the native sources with clang++.
        let c_obj: string = path_join(bdir, str_cat(name, ".o"))
        let cc: i32 = args1(pm, "clang")
        c = jd_first(d, c_flags)
        while c >= 0 {
            if str_starts(jd_sval(d, c), "-std=c++") == false {
                args_push(pm, cc, jd_sval(d, c))
            }
            c = jd_next(d, c)
        }
        args_push(pm, cc, "-c")
        args_push(pm, cc, c_file)
        args_push(pm, cc, "-o")
        args_push(pm, cc, c_obj)
        if native_step(pm, cc) == false {
            return false
        }
        let objs: i32 = jd_arr(d)
        let mut idx: i32 = 0
        c = jd_next(d, jd_first(d, sources))
        while c >= 0 {
            let src: string = jd_sval(d, c)
            let isb: ptr<SBuf> = sb_new()
            sb_puts(isb, path_stem(src))
            sb_putc(isb, 95)
            sb_put_int(isb, idx as i64)
            sb_puts(isb, ".o")
            let obj: string = path_join(bdir, sb_str(isb))
            let cxx: i32 = args1(pm, "clang++")
            arr_extend_str(pm, cxx, c_flags)
            args_push(pm, cxx, "-c")
            args_push(pm, cxx, src)
            args_push(pm, cxx, "-o")
            args_push(pm, cxx, obj)
            if native_step(pm, cxx) == false {
                return false
            }
            args_push(pm, objs, obj)
            idx = idx + 1
            c = jd_next(d, c)
        }
        let link: i32 = args1(pm, "clang++")
        args_push(pm, link, c_obj)
        arr_extend_str(pm, link, objs)
        arr_extend_str(pm, link, link_flags)
        args_push(pm, link, "-o")
        args_push(pm, link, output_file)
        if native_step(pm, link) == false {
            return false
        }
    } else {
        let all: i32 = args1(pm, "clang")
        arr_extend_str(pm, all, c_flags)
        arr_extend_str(pm, all, sources)
        arr_extend_str(pm, all, link_flags)
        args_push(pm, all, "-o")
        args_push(pm, all, output_file)
        if native_step(pm, all) == false {
            return false
        }
    }
    say_color(GREEN, str_cat3(CHECK, " Built ", name))
    return true
}

export function pm_run_native(pm: ptr<Pm>, entry_arg: string) -> bool {
    if pm_build_native(pm, entry_arg, false) == false {
        return false
    }
    let cfg: i32 = pm_load_config(pm)
    if cfg < 0 {
        return false
    }
    let name: string = config_name(pm, cfg)
    say_color(BLUE, str_cat3("Running ", name, "..."))
    return run_argv(pm, args1(pm, path_join(build_dir(pm), name)), "") == 0
}

# ---------------------------------------------------------------------------
# native-link: the [native] sources of a program's project and packages
# ---------------------------------------------------------------------------

# Fold s into a two-part content key. Each part stays below 2^31, so no
# product overflows an i64.
function key_mix(h: ptr<i64>, s: string) {
    let p: ptr<u8> = s as ptr<u8>
    let mut a: i64 = h[0]
    let mut b: i64 = h[1]
    let mut i: i32 = 0
    while p[i] != 0 {
        let c: i64 = (p[i] as i64) + 1
        a = (a * 131 + c) % 2147483647
        b = (b * 257 + c) % 1000000007
        i = i + 1
    }
    h[0] = (a * 131) % 2147483647
    h[1] = (b * 257) % 1000000007
}

# Compile one native source into the object cache unless an object for the
# same compiler, flags, path and contents is already there. Returns the
# object path, or "" when the compiler failed.
function native_object(pm: ptr<Pm>, obj_dir: string, compiler: string, flags: i32, src: string) -> string {
    let d: ptr<JDoc> = pm[0].d
    let h: ptr<i64> = malloc(16) as ptr<i64>
    h[0] = 17
    h[1] = 31
    key_mix(h, compiler)
    let mut c: i32 = jd_first(d, flags)
    while c >= 0 {
        key_mix(h, jd_sval(d, c))
        c = jd_next(d, c)
    }
    key_mix(h, src)
    key_mix(h, read_text(src))
    let nb: ptr<SBuf> = sb_new()
    sb_puts(nb, path_stem(src))
    sb_putc(nb, 45)
    sb_put_int(nb, h[0])
    sb_putc(nb, 45)
    sb_put_int(nb, h[1])
    let obj: string = path_join(obj_dir, str_cat(sb_str(nb), ".o"))
    if path_exists(obj) {
        return obj
    }
    let tb: ptr<SBuf> = sb_new()
    sb_puts(tb, obj)
    sb_puts(tb, ".tmp.")
    sb_put_int(tb, getpid() as i64)
    let tmp: string = sb_str(tb)
    let argv: i32 = args1(pm, compiler)
    arr_extend_str(pm, argv, flags)
    args_push(pm, argv, "-c")
    args_push(pm, argv, src)
    args_push(pm, argv, "-o")
    args_push(pm, argv, tmp)
    say_color(BLUE, str_cat("Compiling native source ", src))
    if run_or_report(pm, argv, "Native compilation failed:") == false {
        let _r: i32 = flowc_io_remove(tmp)
        return ""
    }
    # Publish atomically; a concurrent build of the same key may have won.
    if rename(tmp, obj) != 0 {
        let _r2: i32 = flowc_io_remove(tmp)
    }
    return obj
}

# For `flow run` and `flow compile` on the flowc host: find the project that
# holds program, compile the [native] sources of its installed dependencies
# and its own (the sources, cflags, frameworks, libs and ldflags that
# build-native uses) into cached objects under build/flow_native/, and write
# the link arguments to out, one per line: the objects, then -framework and
# -l pairs, then ldflags. A line "@cxx" means a C++ source was compiled and
# the link needs the C++ standard library. No flow.toml writes nothing.
export function pm_native_link(program: string, out: string, cc: string, cxx: string, opt: string) -> bool {
    let toml: string = find_flow_toml(program)
    if str_len(toml) == 0 {
        return write_text(out, "")
    }
    let pm: ptr<Pm> = pm_new(path_parent(toml))
    let d: ptr<JDoc> = pm[0].d
    let cfg: i32 = pm_load_config(pm)
    if cfg < 0 {
        return false
    }
    let sources: i32 = jd_arr(d)
    let frameworks: i32 = jd_arr(d)
    let libs: i32 = jd_arr(d)
    let cflags: i32 = jd_arr(d)
    let ldflags: i32 = jd_arr(d)
    collect_dependency_native(pm, cfg, sources, frameworks, libs, cflags, ldflags)
    let native: i32 = pkg_table(pm, cfg, "native")
    let own: i32 = cfg_list(pm, native, "sources")
    let mut c: i32 = jd_first(d, own)
    while c >= 0 {
        let rel: string = jd_py_str_s(d, c)
        let native_path: string = path_resolve(path_join(pm[0].project_dir, rel))
        if arr_has_str(pm, sources, native_path) == false {
            if path_exists(native_path) {
                args_push(pm, sources, native_path)
            } else {
                say_color(YELLOW, str_cat("Warning: native source not found: ", rel))
            }
        }
        c = jd_next(d, c)
    }

    let flags: i32 = args1(pm, opt)
    arr_extend_str(pm, flags, cflags)
    arr_extend_str(pm, flags, cfg_list(pm, native, "cflags"))
    # The C compiler takes no -std=c++ flag meant for the C++ sources.
    let c_only: i32 = jd_arr(d)
    c = jd_first(d, flags)
    while c >= 0 {
        if str_starts(jd_sval(d, c), "-std=c++") == false {
            args_push(pm, c_only, jd_sval(d, c))
        }
        c = jd_next(d, c)
    }

    let lines: ptr<SBuf> = sb_new()
    let mut uses_cxx: bool = false
    if jd_count(d, sources) > 0 {
        let obj_dir: string = path_join(build_dir(pm), "flow_native")
        mkdirs(obj_dir)
        c = jd_first(d, sources)
        while c >= 0 {
            let src: string = jd_sval(d, c)
            let mut obj: string = ""
            if is_cxx_source(src) {
                uses_cxx = true
                obj = native_object(pm, obj_dir, cxx, flags, src)
            } else {
                obj = native_object(pm, obj_dir, cc, c_only, src)
            }
            if str_len(obj) == 0 {
                return false
            }
            sb_puts(lines, obj)
            sb_putc(lines, 10)
            c = jd_next(d, c)
        }
    }
    let link: i32 = jd_arr(d)
    push_flag_pairs(pm, link, "-framework", frameworks, cfg_list(pm, native, "frameworks"))
    push_flag_pairs(pm, link, "-l", libs, cfg_list(pm, native, "libs"))
    arr_extend_str(pm, link, ldflags)
    arr_extend_str(pm, link, cfg_list(pm, native, "ldflags"))
    c = jd_first(d, link)
    while c >= 0 {
        sb_puts(lines, jd_sval(d, c))
        sb_putc(lines, 10)
        c = jd_next(d, c)
    }
    if uses_cxx {
        sb_puts(lines, "@cxx\n")
    }
    return write_text(out, sb_str(lines))
}
