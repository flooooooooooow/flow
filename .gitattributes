# Treat Flow sources as first-class in the language bar once detectable.
# Upstream github-linguist does not yet know `Flow`; a linguist PR is welcome.
# Do not remap *.flow to another language (keeps history honest).
*.flow linguist-detectable=true

*.proof.md linguist-documentation
docs/** linguist-documentation
site/vendor/** linguist-vendored
third_party/** linguist-vendored
lib/verify/** linguist-documentation
examples/verify/** linguist-documentation

**/build/** linguist-generated
**/*.dSYM/** linguist-generated

# Checked-in outputs of repository generators. linguist-generated only
# collapses them in pull request diffs and drops them from language stats;
# merging is unchanged. Do not hand-merge them: take main's copy and
# regenerate (AGENTS.md, "Branches, pull requests and merge conflicts").
# No merge=ours or merge=union here: either would silently keep a stale or
# duplicated generated file.
compiler/bootstrap/flowc_stage_a.c linguist-generated
compiler/bootstrap/flowc_stage_a linguist-generated
docs/demos/overview.md linguist-generated
docs/library/stdlib-api.md linguist-generated
