# Simple FLOW Examples - No pointers

# Basic arithmetic
function add(a: i32, b: i32) -> i32 {
    return a + b
}

# Recursive factorial
function factorial(n: i32) -> i32 {
    if n <= 1 {
        return 1
    } else {
        return n * factorial(n - 1)
    }
}

# Array processing with individual variables
function sum_array() -> i32 {
    let sum: i32 = 0
    let i: i32 = 0
    
    while i < 10 {
        sum = sum + i  # Sum indices 0-9
        i = i + 1
    }
    
    return sum
}

# For loop example
function process_data() -> i32 {
    let total: i32 = 0
    
    for i in 0..100 {
        total = total + i
    }
    
    return total
}

# Conditional logic
function max(a: i32, b: i32) -> i32 {
    if a > b {
        return a
    } else {
        return b
    }
}

# Main function
function main() -> i32 {
    let result: i32 = add(10, 20)
    let fact: i32 = factorial(5)
    let sum: i32 = sum_array()
    let total: i32 = process_data()
    let maximum: i32 = max(15, 25)
    
    return result + fact + sum + total + maximum
}
