import "stdlib/hardware.flow"
import "stdlib/rf.flow"

@hardware
function process_blink(enable: bool, fast_mode: bool) -> bool {
    # This acts as a structural model of hardware.
    # In a full RTL lowerer, state variables act as registers.
    let mut reg: Register<bool> = register_new<bool>(false)
    let state: bool = register_read<bool>(reg)

    # Synchronize the inputs (which could come from a different clock domain)
    # to a specific domain (e.g. 1000 Hz) using our CDC primitive.
    let sync_enable: bool = cdc_sync<Hz1000, bool>(enable)
    let sync_fast: bool = cdc_sync<Hz1000, bool>(fast_mode)

    if sync_enable {
        if sync_fast {
            reg.value = not state
        } else {
            reg.value = true
        }
    } else {
        reg.value = false
    }

    return reg.value
}

function main() -> i32 {
    let mut b: bool = process_blink(true, true)
    b = process_blink(true, false)
    b = process_blink(false, false)
    return 0
}
