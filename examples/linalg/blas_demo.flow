# BLAS Demo: Comparing naive vs Accelerate-backed matrix operations
#
# Compile: ./flow build examples/linalg/blas_demo.flow -o build/blas_demo
# Run:     ./build/blas_demo
#
# Requires: -framework Accelerate (automatically linked on macOS)

import "stdlib/blas.flow"

extern {
    function printf(fmt: string, val: f64) -> i32
    function clock() -> i64
}

const CLOCKS_PER_SEC: f64 = 1000000.0

function benchmark_matmul(n: i32) -> void {
    print("Matrix multiplication ")
    print(n)
    print("x")
    print(n)
    println(":")
    
    # Create matrices
    let A: Mat = mat_new(n, n)
    let B: Mat = mat_new(n, n)
    let C: Mat = mat_new(n, n)
    
    # Initialize with some values
    for i in 0 to n {
        for j in 0 to n {
            mat_set(A, i, j, (i + j) % 7 + 1.0)
            mat_set(B, i, j, (i * j) % 11 + 1.0)
        }
    }
    
    # Benchmark BLAS gemm
    let t0: i64 = clock()
    gemm(A, B, C)
    let t1: i64 = clock()
    
    let elapsed: f64 = (t1 - t0) / CLOCKS_PER_SEC
    let flops: f64 = 2.0 * n * n * n
    let gflops: f64 = flops / elapsed / 1e9
    
    print("  BLAS gemm: ")
    printf("%.4f", elapsed)
    print(" sec, ")
    printf("%.2f", gflops)
    println(" GFLOPS")
    
    # Verify a sample element
    print("  C[0,0] = ")
    printf("%.4f", mat_get(C, 0, 0))
    println("")
    
    mat_free(A)
    mat_free(B)
    mat_free(C)
}

function benchmark_solve(n: i32) -> void {
    print("Linear solve ")
    print(n)
    print("x")
    print(n)
    println(":")
    
    # Create a diagonally dominant matrix (guaranteed invertible)
    let A: Mat = mat_new(n, n)
    for i in 0 to n {
        for j in 0 to n {
            if i == j {
                mat_set(A, i, j, n + 1.0)
            } else {
                mat_set(A, i, j, 1.0)
            }
