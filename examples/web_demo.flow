# Web Demo - Runs in browser via WebAssembly
function fibonacci(n: i32) -> i32 {
    if n <= 1 {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

function calculate_pi(iterations: i32) -> f32 {
    let pi: f32 = 0.0
    let i: i32 = 0
    while i < iterations {
        let term: f32 = 4.0 / (i * 2 + 1)
        if i % 2 == 0 {
            pi = pi + term
        } else {
            pi = pi - term
        }
        i = i + 1
    }
    return pi
}

function greet_user(name: string) -> string {
    return "Hello, " + name + "! Welcome to FLOW in the browser!"
}

function main() -> i32 {
    print("🌐 FLOW WebAssembly Demo")
    print("==========================")
    
    # Fibonacci calculation
    let fib_result: i32 = fibonacci(10)
    print("Fibonacci(10) = ")
    print(fib_result)
    
    # Pi calculation
    let pi_approx: f32 = calculate_pi(1000)
    print("Pi approximation: ")
    print(pi_approx)
    
    # String manipulation
    let greeting: string = greet_user("Web User")
    print(greeting)
    
    print("✅ WebAssembly demo complete!")
    return 0
}
