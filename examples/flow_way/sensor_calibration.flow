# Solve It the Flow Way: sensor calibration
#
# Problem:
#   1. subtract a fixed sensor offset
#   2. apply a gain
#   3. clamp the calibrated value to [0, 100]
#
# The point of this example is not the arithmetic. The value should visibly
# move through the stages as a Flow pipeline, and `_` should place the piped
# value into the middle argument of clamp.

function subtract_offset(x: i32, offset: i32) -> i32 {
    return x - offset
}

function multiply(x: i32, factor: i32) -> i32 {
    return x * factor
}

function clamp(lo: i32, x: i32, hi: i32) -> i32 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

function calibrate(raw: i32) -> i32 {
    return raw
        |> subtract_offset(10)
        |> multiply(2)
        |> clamp(0, _, 100)
}

function main() -> i32 {
    if calibrate(0) != 0 {
        return 1
    }
    if calibrate(20) != 20 {
        return 2
    }
    if calibrate(80) != 100 {
        return 3
    }

    println("sensor calibration: OK")
    return 0
}
