function main() -> i32 {
    printf("P3\n128 96\n255\n")
    let y: i32 = 0
    for y in 0..96 {
        let x: i32 = 0
        for x in 0..128 {
            if x >= 18 {
                if y >= 18 {
                    if x < 110 {
                        if y < 36 {
                            printf("80 170 255\n")
                        } else {
                            printf("20 20 24\n")
                        }
                    } else {
                        printf("20 20 24\n")
                    }
                } else {
                    printf("20 20 24\n")
                }
            } elif x >= 12 {
                if y >= 12 {
                    if x < 116 {
                        if y < 84 {
                            printf("32 40 60\n")
                        } else {
                            printf("20 20 24\n")
                        }
                    } else {
                        printf("20 20 24\n")
                    }
                } else {
                    printf("20 20 24\n")
                }
            } else {
                printf("20 20 24\n")
            }
        }
    }
    return 0
}
