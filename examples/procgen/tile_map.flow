# TILE MAP: biome tiles from height and moisture noise.
#
# MODEL
#   height = fBm2; moisture = fBm2 at a different salt. Biomes:
#     0 water   (height < sea)
#     1 beach   (height < sea + shelf)
#     2 desert  (dry lowland)
#     3 grass   (temperate)
#     4 forest  (wet)
#     5 rock    (high and steepish)
#     6 snow    (highest)
#
# THE MEASUREMENT
#   Histogram of biome fractions sums to 1. Water appears only where
#   height < sea (no water tiles above sea level).
#
# KEYS
#   1 sea -0.05   2 sea 0.00   3 sea 0.05   4 sea 0.10
#   R reseed   P pause   Esc quit
#
# Run (headless, gated):
#   FLOW_HOST=python ./flow record examples/procgen/tile_map.flow \
#       --frames 4 --out /tmp/pg_tile_map
# Run (windowed):
#   ./flow gfx examples/procgen/tile_map.flow

import "stdlib/gfx.flow"
import "stdlib/text.flow"
import "stdlib/procgen.flow"

extern {
    function printf(fmt: string, val: f64) -> i32
    function fabs(x: f64) -> f64
}

const WIN_W: i32 = 512
const WIN_H: i32 = 592
const FB_W: i32 = 512
const FB_H: i32 = 512
const FIELD_Y: i32 = 58
const MAX_FRAMES: i32 = 6000
const MAP: i32 = 64
const CELLS: i32 = 4096
const CELL_PX: i32 = 8
const ORIGIN_X: i32 = 0
const ORIGIN_Y: i32 = 0
const N_BIOMES: i32 = 7
const VERIFY_SEED: u32 = 161803
const VERIFY_SEA: f32 = 0.0
const SHELF: f32 = 0.06

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20
const KEY_4: i32 = 21

let mut rng_state: u32 = 161803

function rng_next() -> u32 {
    rng_state = rng_state * 1664525 + 1013904223
    return rng_state
}

function preset_sea(p: i32) -> f32 {
    if p == 1 { return 0.0 - 0.05 }
    if p == 2 { return 0.0 }
    if p == 3 { return 0.05 }
    return 0.10
}

function preset_name(p: i32) -> string {
    if p == 1 { return "SEA -0.05" }
    if p == 2 { return "SEA 0.00" }
    if p == 3 { return "SEA 0.05" }
    return "SEA 0.10"
}

function height_at(ix: i32, iy: i32) -> f32 {
    let x: f32 = (ix as f32) * 0.08
    let y: f32 = (iy as f32) * 0.08
    return procgen_fbm2(x, y, 5, 3)
}

function moist_at(ix: i32, iy: i32) -> f32 {
    let x: f32 = (ix as f32) * 0.09 + 20.0
    let y: f32 = (iy as f32) * 0.09 - 11.0
    return procgen_fbm2(x, y, 4, 9) * 0.5 + 0.5
}

function biome_at(ix: i32, iy: i32, sea: f32) -> i32 {
    let h: f32 = height_at(ix, iy)
    let m: f32 = moist_at(ix, iy)
    if h < sea { return 0 }
    if h < sea + SHELF { return 1 }
    if h > 0.45 { return 6 }
    if h > 0.30 { return 5 }
    if m < 0.35 { return 2 }
    if m > 0.65 { return 4 }
    return 3
}

function hist_and_check(sea: f32, hist: ptr<i32>) -> i32 {
    for b in 0 to N_BIOMES {
        hist[b] = 0
    }
    let mut water_ok: i32 = 1
    for iy in 0 to MAP {
        for ix in 0 to MAP {
            let b: i32 = biome_at(ix, iy, sea)
            hist[b] = hist[b] + 1
            let h: f32 = height_at(ix, iy)
            if b == 0 and h >= sea {
                water_ok = 0
            }
            if b != 0 and h < sea {
                water_ok = 0
            }
        }
    }
    return water_ok
}

function clear_fb(fb: ptr<u8>) -> void {
    for i in 0 to FB_W * FB_H * 3 {
        fb[i] = 0
    }
}

function put_rgb(fb: ptr<u8>, x: i32, y: i32, r: i32, g2: i32, b: i32) -> void {
    if x >= 0 and x < FB_W and y >= 0 and y < FB_H {
        let o: i32 = (y * FB_W + x) * 3
        fb[o] = r as u8
        fb[o + 1] = g2 as u8
        fb[o + 2] = b as u8
    }
}

function fill_rect_fb(fb: ptr<u8>, x: i32, y: i32, w: i32, h: i32,
                      r: i32, g2: i32, b: i32) -> void {
    for dy in 0 to h {
        for dx in 0 to w {
            put_rgb(fb, x + dx, y + dy, r, g2, b)
        }
    }
}

function draw_scene(g: Gfx, fb: ptr<u8>, sea: f32) -> void {
    clear_fb(fb)
    for iy in 0 to MAP {
        for ix in 0 to MAP {
            let b: i32 = biome_at(ix, iy, sea)
            let mut r: i32 = 40
            let mut g2: i32 = 40
            let mut bl: i32 = 40
            if b == 0 {
                r = 30
                g2 = 70
                bl = 150
            }
            if b == 1 {
                r = 210
                g2 = 190
                bl = 120
            }
            if b == 2 {
                r = 200
                g2 = 170
                bl = 90
            }
            if b == 3 {
                r = 70
                g2 = 150
                bl = 60
            }
            if b == 4 {
                r = 30
                g2 = 100
                bl = 40
            }
            if b == 5 {
                r = 110
                g2 = 105
                bl = 100
            }
            if b == 6 {
                r = 230
                g2 = 235
                bl = 240
            }
            fill_rect_fb(fb, ORIGIN_X + ix * CELL_PX, ORIGIN_Y + iy * CELL_PX,
                         CELL_PX, CELL_PX, r, g2, bl)
        }
    }
    gfx_blit_rgb(g, 0, FIELD_Y, FB_W, FB_H, fb)
}

function draw_hud(g: Gfx, preset: i32, water_frac: f64, paused: bool) -> void {
    let t1: i32 = gfx_draw_text(g, 8, 8, "TILE MAP", 2, 238, 234, 246)
    let t2: i32 = gfx_draw_text(g, 160, 12, preset_name(preset), 1, 255, 198, 96)
    let t3: i32 = gfx_draw_text(g, 280, 12, "WATER", 1, 150, 146, 168)
    let t4: i32 = gfx_draw_fixed(g, 320, 12, water_frac, 3, 1, 120, 255, 190)
    let t5: i32 = gfx_draw_text(g, 8, 28,
        "water beach desert grass forest rock snow", 1, 150, 146, 168)
    let t6: i32 = gfx_draw_text(g, 8, 42,
        "1-4 SEA  R RESEED  P PAUSE", 1, 112, 108, 132)
    if paused {
        let t7: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let t8: i32 = gfx_draw_text(g, 8, 572,
        "biomes from height + moisture fBm fields", 1, 122, 118, 144)
    let t9: i32 = gfx_draw_text(g, 8, 582,
        "gate: biome fractions sum to 1; water only below sea", 1, 122, 118, 144)
}

function main() -> i32 {
    let hist: array<i32, 7> = [0, 0, 0, 0, 0, 0, 0]
    let fb: array<u8, 786432> = [0, 0, 0, 0]

    println("")
    println("  TILE MAP  --  height + moisture biomes")
    println("  ========================================")
    println("")

    procgen_seed(VERIFY_SEED)
    let water_ok: i32 = hist_and_check(VERIFY_SEA, hist)
    let mut sum: i32 = 0
    for b in 0 to N_BIOMES {
        sum = sum + hist[b]
    }
    let frac_sum: f64 = (sum as f64) / (CELLS as f64)
    let water_frac: f64 = (hist[0] as f64) / (CELLS as f64)

    print("    cells                           : ")
    printf("%.0f", CELLS as f64)
    println("")
    print("    histogram sum / cells           : ")
    printf("%.6f", frac_sum)
    println("  (gate = 1)")
    print("    water fraction                  : ")
    printf("%.6f", water_frac)
    println("")
    print("    water only below sea            : ")
    printf("%.0f", water_ok as f64)
    println("")

    for b in 0 to N_BIOMES {
        let f: f64 = (hist[b] as f64) / (CELLS as f64)
        print("    biome ")
        printf("%.0f", b as f64)
        print(" fraction                 : ")
        printf("%.4f", f)
        println("")
    }
    println("")

    if fabs(frac_sum - 1.0) > 1.0e-9 {
        println("    FAIL: biome histogram fractions do not sum to 1")
        return 1
    }
    if water_ok == 0 {
        println("    FAIL: water tile found above sea level (or land below)")
        return 2
    }
    println("    PASS: biome fractions sum to 1; water only below sea")
    println("")

    let mut preset: i32 = 2
    let mut sea: f32 = preset_sea(preset)
    let mut water_live: f64 = water_frac
    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut reseed_held: bool = false
    let mut frame: i32 = 0

    let g: Gfx = gfx_open(WIN_W, WIN_H, "Tile map - Flow procgen")

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(g) { break }

        let mut want: i32 = -1
        if gfx_key_down(g, KEY_1) { want = 1 }
        if gfx_key_down(g, KEY_2) { want = 2 }
        if gfx_key_down(g, KEY_3) { want = 3 }
        if gfx_key_down(g, KEY_4) { want = 4 }
        if want >= 0 and want != preset {
            preset = want
            sea = preset_sea(preset)
            let ok: i32 = hist_and_check(sea, hist)
            water_live = (hist[0] as f64) / (CELLS as f64)
            if ok == 0 { water_live = water_live }
        }

        if gfx_key_down(g, KEY_R) {
            if !reseed_held {
                rng_state = rng_next()
                procgen_seed(rng_state)
                let ok2: i32 = hist_and_check(sea, hist)
                water_live = (hist[0] as f64) / (CELLS as f64)
                if ok2 == 0 { water_live = water_live }
            }
            reseed_held = true
        } else {
            reseed_held = false
        }

        if gfx_key_down(g, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        # Auto-cycle sea presets so the recorded GIF shows multiple biome mixes.
        if !paused and frame > 0 and frame % 50 == 0 {
            preset = (preset % 4) + 1
            sea = preset_sea(preset)
            rng_state = rng_next()
            procgen_seed(rng_state)
            let ok_c: i32 = hist_and_check(sea, hist)
            water_live = (hist[0] as f64) / (CELLS as f64)
            if ok_c == 0 { water_live = water_live }
        }

        gfx_clear(g, 12, 10, 18)
        draw_scene(g, fb, sea)
        draw_hud(g, preset, water_live, paused)
        gfx_present(g)
        frame = frame + 1
    }

    gfx_close(g)
    return 0
}
