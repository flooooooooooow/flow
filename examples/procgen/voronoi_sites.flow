# VORONOI SITES: cellular / Worley regions for biome partitioning.
#
# MODEL
#   Place N sites by hashing a coarse lattice (Worley feature points).
#   Each pixel joins the nearest site (Euclidean). Colour is a hash of the
#   winning site id so regions read as biomes.
#
# THE MEASUREMENT
#   Every cell is assigned (winner >= 0). Number of non-empty regions equals
#   the number of sites, so mean sites per region is exactly 1.
#
# KEYS
#   1 12 sites   2 18 sites   3 24 sites   4 36 sites
#   R reseed   P pause   Esc quit
#
# Run (headless, gated):
#   FLOW_HOST=python ./flow record examples/procgen/voronoi_sites.flow \
#       --frames 4 --out /tmp/pg_voronoi_sites
# Run (windowed):
#   ./flow gfx examples/procgen/voronoi_sites.flow

import "stdlib/gfx.flow"
import "stdlib/text.flow"
import "stdlib/procgen.flow"

extern {
    function printf(fmt: string, val: f64) -> i32
    function sqrtf(x: f32) -> f32
}

const WIN_W: i32 = 512
const WIN_H: i32 = 592
const FB_W: i32 = 512
const FB_H: i32 = 512
const FIELD_Y: i32 = 58
const MAX_FRAMES: i32 = 6000
const MAP: i32 = 128
const CELL_PX: i32 = 4
const MAX_SITES: i32 = 48
const VERIFY_SEED: u32 = 555001
const VERIFY_N: i32 = 24

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20
const KEY_4: i32 = 21

let mut rng_state: u32 = 555001

function rng_next() -> u32 {
    rng_state = rng_state * 1664525 + 1013904223
    return rng_state
}

function preset_n(p: i32) -> i32 {
    if p == 1 { return 12 }
    if p == 2 { return 18 }
    if p == 3 { return 24 }
    return 36
}

function preset_name(p: i32) -> string {
    if p == 1 { return "12 SITES" }
    if p == 2 { return "18 SITES" }
    if p == 3 { return "24 SITES" }
    return "36 SITES"
}

function place_sites(sx: ptr<f32>, sy: ptr<f32>, n: i32) -> void {
    for i in 0 to n {
        let h1: u32 = procgen_hash(i * 17 + 3, i * 31 + 5, 0, 100)
        let h2: u32 = procgen_hash(i * 19 + 7, i * 23 + 11, 1, 200)
        sx[i] = ((h1 % 10000) as f32) / 10000.0 * ((MAP - 1) as f32)
        sy[i] = ((h2 % 10000) as f32) / 10000.0 * ((MAP - 1) as f32)
    }
}

function nearest(sx: ptr<f32>, sy: ptr<f32>, n: i32, x: f32, y: f32) -> i32 {
    let mut best: i32 = 0
    let mut best_d: f32 = 1.0e9
    for i in 0 to n {
        let dx: f32 = x - sx[i]
        let dy: f32 = y - sy[i]
        let d: f32 = dx * dx + dy * dy
        if d < best_d {
            best_d = d
            best = i
        }
    }
    return best
}

function measure(sx: ptr<f32>, sy: ptr<f32>, n: i32, counts: ptr<i32>) -> f64 {
    for i in 0 to n {
        counts[i] = 0
    }
    let mut assigned: i32 = 0
    for iy in 0 to MAP {
        for ix in 0 to MAP {
            let w: i32 = nearest(sx, sy, n, ix as f32, iy as f32)
            if w >= 0 {
                assigned = assigned + 1
                counts[w] = counts[w] + 1
            }
        }
    }
    let mut regions: i32 = 0
    for i in 0 to n {
        if counts[i] > 0 {
            regions = regions + 1
        }
    }
    if regions == 0 { return 0.0 }
    return (n as f64) / (regions as f64)
}

function clear_fb(fb: ptr<u8>) -> void {
    for i in 0 to FB_W * FB_H * 3 {
        fb[i] = 0
    }
}

function put_rgb(fb: ptr<u8>, x: i32, y: i32, r: i32, g2: i32, b: i32) -> void {
    if x >= 0 and x < FB_W and y >= 0 and y < FB_H {
        let o: i32 = (y * FB_W + x) * 3
        fb[o] = r as u8
        fb[o + 1] = g2 as u8
        fb[o + 2] = b as u8
    }
}

function fill_rect_fb(fb: ptr<u8>, x: i32, y: i32, w: i32, h: i32,
                      r: i32, g2: i32, b: i32) -> void {
    for dy in 0 to h {
        for dx in 0 to w {
            put_rgb(fb, x + dx, y + dy, r, g2, b)
        }
    }
}

function draw_scene(g: Gfx, fb: ptr<u8>, sx: ptr<f32>, sy: ptr<f32>,
                    n: i32) -> void {
    clear_fb(fb)
    for iy in 0 to MAP {
        for ix in 0 to MAP {
            let w: i32 = nearest(sx, sy, n, ix as f32, iy as f32)
            let h: u32 = procgen_hash(w, w * 3, 0, 77)
            let r: i32 = 40 + ((h) % 180) as i32
            let g2: i32 = 40 + ((h >> 8) % 180) as i32
            let b: i32 = 50 + ((h >> 16) % 180) as i32
            fill_rect_fb(fb, ix * CELL_PX, iy * CELL_PX, CELL_PX, CELL_PX, r, g2, b)
        }
    }
    for i in 0 to n {
        let px: i32 = (sx[i] as i32) * CELL_PX
        let py: i32 = (sy[i] as i32) * CELL_PX
        fill_rect_fb(fb, px - 2, py - 2, 5, 5, 255, 255, 255)
    }
    gfx_blit_rgb(g, 0, FIELD_Y, FB_W, FB_H, fb)
}

function draw_hud(g: Gfx, preset: i32, n: i32, mean_spr: f64, paused: bool) -> void {
    let t1: i32 = gfx_draw_text(g, 8, 8, "VORONOI SITES", 2, 238, 234, 246)
    let t2: i32 = gfx_draw_text(g, 220, 12, preset_name(preset), 1, 255, 198, 96)
    let t3: i32 = gfx_draw_text(g, 330, 12, "N", 1, 150, 146, 168)
    let t4: i32 = gfx_draw_int(g, 346, 12, n, 1, 234, 232, 244)
    let t5: i32 = gfx_draw_text(g, 8, 28, "SITES/REGION", 1, 150, 146, 168)
    let t6: i32 = gfx_draw_fixed(g, 100, 28, mean_spr, 3, 1, 120, 255, 190)
    let t7: i32 = gfx_draw_text(g, 8, 42,
        "1-4 COUNT  R RESEED  P PAUSE", 1, 112, 108, 132)
    if paused {
        let t8: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let t9: i32 = gfx_draw_text(g, 8, 572,
        "Worley feature points; each pixel joins nearest site", 1, 122, 118, 144)
    let ta: i32 = gfx_draw_text(g, 8, 582,
        "gate: every cell assigned; mean sites per region = 1", 1, 122, 118, 144)
}

function main() -> i32 {
    let sx: array<f32, 48> = [0.0, 0.0, 0.0, 0.0]
    let sy: array<f32, 48> = [0.0, 0.0, 0.0, 0.0]
    let counts: array<i32, 48> = [0, 0, 0, 0]
    let fb: array<u8, 786432> = [0, 0, 0, 0]

    println("")
    println("  VORONOI SITES  --  cellular biome regions")
    println("  ==========================================")
    println("")

    procgen_seed(VERIFY_SEED)
    place_sites(sx, sy, VERIFY_N)
    let mean_spr: f64 = measure(sx, sy, VERIFY_N, counts)
    let mut assigned: i32 = 0
    for iy in 0 to MAP {
        for ix in 0 to MAP {
            let w: i32 = nearest(sx, sy, VERIFY_N, ix as f32, iy as f32)
            if w >= 0 { assigned = assigned + 1 }
        }
    }

    print("    sites                           : ")
    printf("%.0f", VERIFY_N as f64)
    println("")
    print("    cells assigned                  : ")
    printf("%.0f", assigned as f64)
    print(" / ")
    printf("%.0f", (MAP * MAP) as f64)
    println("")
    print("    mean sites per region           : ")
    printf("%.6f", mean_spr)
    println("  (gate ~ 1)")
    println("")

    if assigned != MAP * MAP {
        println("    FAIL: some cells unassigned")
        return 1
    }
    if mean_spr < 0.999 or mean_spr > 1.001 {
        println("    FAIL: mean sites per region not ~1")
        return 2
    }
    println("    PASS: every cell assigned; mean sites per region ~1")
    println("")

    let mut preset: i32 = 3
    let mut n: i32 = preset_n(preset)
    place_sites(sx, sy, n)
    let mut mean_live: f64 = mean_spr
    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut reseed_held: bool = false
    let mut frame: i32 = 0

    let g: Gfx = gfx_open(WIN_W, WIN_H, "Voronoi sites - Flow procgen")

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(g) { break }

        let mut want: i32 = -1
        if gfx_key_down(g, KEY_1) { want = 1 }
        if gfx_key_down(g, KEY_2) { want = 2 }
        if gfx_key_down(g, KEY_3) { want = 3 }
        if gfx_key_down(g, KEY_4) { want = 4 }
        if want >= 0 and want != preset {
            preset = want
            n = preset_n(preset)
            place_sites(sx, sy, n)
            mean_live = measure(sx, sy, n, counts)
        }

        if gfx_key_down(g, KEY_R) {
            if !reseed_held {
                rng_state = rng_next()
                procgen_seed(rng_state)
                place_sites(sx, sy, n)
                mean_live = measure(sx, sy, n, counts)
            }
            reseed_held = true
        } else {
            reseed_held = false
        }

        if gfx_key_down(g, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        # Auto-cycle site-count presets so the recorded GIF shows multiple partitions.
        if !paused and frame > 0 and frame % 50 == 0 {
            preset = (preset % 4) + 1
            n = preset_n(preset)
            rng_state = rng_next()
            procgen_seed(rng_state)
            place_sites(sx, sy, n)
            mean_live = measure(sx, sy, n, counts)
        }

        gfx_clear(g, 12, 10, 18)
        draw_scene(g, fb, sx, sy, n)
        draw_hud(g, preset, n, mean_live, paused)
        gfx_present(g)
        frame = frame + 1
    }

    gfx_close(g)
    return 0
}
