# HEIGHTMAP FBM: 2D fractal height with sea level and contour lines.
#
# MODEL
#   Height is five octaves of procgen_fbm2. Sea cuts everything below a
#   chosen level. Contours mark iso-heights on land.
#
# THE MEASUREMENT
#   After the sea cut, land fraction (cells above sea) must sit near a
#   chosen target for the preset seed. Deterministic: same seed, same map.
#
# KEYS
#   1 sea -0.05   2 sea 0.00   3 sea 0.05   4 sea 0.10
#   R reseed   P pause   Esc quit
#
# Run (headless, gated):
#   FLOW_HOST=python ./flow record examples/procgen/heightmap_fbm.flow \
#       --frames 4 --out /tmp/pg_heightmap_fbm
# Run (windowed):
#   ./flow gfx examples/procgen/heightmap_fbm.flow

import "stdlib/gfx.flow"
import "stdlib/text.flow"
import "stdlib/procgen.flow"

extern {
    function printf(fmt: string, val: f64) -> i32
    function fabs(x: f64) -> f64
}

const WIN_W: i32 = 512
const WIN_H: i32 = 592
const FB_W: i32 = 512
const FB_H: i32 = 512
const FIELD_Y: i32 = 58
const MAX_FRAMES: i32 = 6000
const MAP: i32 = 128
const CELLS: i32 = 16384
const CELL_PX: i32 = 4
const ORIGIN_X: i32 = 0
const ORIGIN_Y: i32 = 0
const VERIFY_SEED: u32 = 20260807
const TARGET_LAND: f64 = 0.52
const LAND_GATE: f64 = 0.08

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20
const KEY_4: i32 = 21

let mut rng_state: u32 = 20260807

function rng_next() -> u32 {
    rng_state = rng_state * 1664525 + 1013904223
    return rng_state
}

function preset_sea(p: i32) -> f32 {
    if p == 1 { return 0.0 - 0.05 }
    if p == 2 { return 0.0 }
    if p == 3 { return 0.05 }
    return 0.10
}

function preset_name(p: i32) -> string {
    if p == 1 { return "SEA -0.05" }
    if p == 2 { return "SEA 0.00" }
    if p == 3 { return "SEA 0.05" }
    return "SEA 0.10"
}

function height_at(ix: i32, iy: i32) -> f32 {
    let x: f32 = (ix as f32) * 0.045
    let y: f32 = (iy as f32) * 0.045
    return procgen_fbm2(x, y, 5, 11)
}

function land_fraction(sea: f32) -> f64 {
    let mut land: i32 = 0
    for iy in 0 to MAP {
        for ix in 0 to MAP {
            if height_at(ix, iy) > sea {
                land = land + 1
            }
        }
    }
    return (land as f64) / (CELLS as f64)
}

function clear_fb(fb: ptr<u8>) -> void {
    for i in 0 to FB_W * FB_H * 3 {
        fb[i] = 0
    }
}

function put_rgb(fb: ptr<u8>, x: i32, y: i32, r: i32, g2: i32, b: i32) -> void {
    if x >= 0 and x < FB_W and y >= 0 and y < FB_H {
        let o: i32 = (y * FB_W + x) * 3
        fb[o] = r as u8
        fb[o + 1] = g2 as u8
        fb[o + 2] = b as u8
    }
}

function fill_rect_fb(fb: ptr<u8>, x: i32, y: i32, w: i32, h: i32,
                      r: i32, g2: i32, b: i32) -> void {
    for dy in 0 to h {
        for dx in 0 to w {
            put_rgb(fb, x + dx, y + dy, r, g2, b)
        }
    }
}

function draw_scene(g: Gfx, fb: ptr<u8>, sea: f32) -> void {
    clear_fb(fb)
    for iy in 0 to MAP {
        for ix in 0 to MAP {
            let h: f32 = height_at(ix, iy)
            let mut r: i32 = 40
            let mut g2: i32 = 90
            let mut b: i32 = 160
            if h > sea {
                let t: f32 = (h - sea) / (1.0 - sea + 0.001)
                r = (40.0 + t * 80.0) as i32
                g2 = (90.0 + t * 120.0) as i32
                b = (40.0 + t * 40.0) as i32
                let band: f32 = h * 8.0
                let frac: f32 = band - (band as i32) as f32
                if frac < 0.0 { frac = 0.0 - frac }
                if frac < 0.08 {
                    r = 220
                    g2 = 210
                    b = 160
                }
            } else {
                let d: f32 = sea - h
                r = (20.0 + d * 40.0) as i32
                g2 = (50.0 + d * 60.0) as i32
                b = (120.0 + d * 80.0) as i32
            }
            fill_rect_fb(fb, ORIGIN_X + ix * CELL_PX, ORIGIN_Y + iy * CELL_PX,
                         CELL_PX, CELL_PX, r, g2, b)
        }
    }
    gfx_blit_rgb(g, 0, FIELD_Y, FB_W, FB_H, fb)
}

function draw_hud(g: Gfx, preset: i32, land: f64, sea: f32, paused: bool) -> void {
    let t1: i32 = gfx_draw_text(g, 8, 8, "HEIGHTMAP FBM", 2, 238, 234, 246)
    let t2: i32 = gfx_draw_text(g, 220, 12, preset_name(preset), 1, 255, 198, 96)
    let t3: i32 = gfx_draw_text(g, 330, 12, "LAND", 1, 150, 146, 168)
    let t4: i32 = gfx_draw_fixed(g, 362, 12, land, 3, 1, 120, 255, 190)
    let t5: i32 = gfx_draw_text(g, 8, 28, "SEA", 1, 150, 146, 168)
    let t6: i32 = gfx_draw_fixed(g, 36, 28, sea as f64, 2, 1, 234, 232, 244)
    let t7: i32 = gfx_draw_text(g, 8, 42,
        "1-4 SEA LEVEL  R RESEED  P PAUSE", 1, 112, 108, 132)
    if paused {
        let t8: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let t9: i32 = gfx_draw_text(g, 8, 572,
        "5-octave fBm height; contours on land; blue is below sea", 1, 122, 118, 144)
    let ta: i32 = gfx_draw_text(g, 8, 582,
        "gate: land fraction near target after sea cut (deterministic seed)", 1, 122, 118, 144)
}

function main() -> i32 {
    let fb: array<u8, 786432> = [0, 0, 0, 0]

    println("")
    println("  HEIGHTMAP FBM  --  fractal height with sea cut and contours")
    println("  ============================================================")
    println("")

    procgen_seed(VERIFY_SEED)
    let sea0: f32 = 0.0
    let land: f64 = land_fraction(sea0)
    let err: f64 = fabs(land - TARGET_LAND)

    print("    seed                            : ")
    printf("%.0f", VERIFY_SEED as f64)
    println("")
    print("    sea level                       : ")
    printf("%.3f", sea0 as f64)
    println("")
    print("    land fraction                   : ")
    printf("%.6f", land)
    println("")
    print("    target                          : ")
    printf("%.3f", TARGET_LAND)
    println("")
    print("    abs error                       : ")
    printf("%.6f", err)
    print("   (gate < ")
    printf("%.2f", LAND_GATE)
    println(")")
    println("")

    if err > LAND_GATE {
        println("    FAIL: land fraction far from target after sea cut")
        return 1
    }
    println("    PASS: land fraction near target for deterministic seed")
    println("")

    let mut preset: i32 = 2
    let mut sea: f32 = preset_sea(preset)
    procgen_seed(VERIFY_SEED)
    let mut land_live: f64 = land
    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut reseed_held: bool = false
    let mut frame: i32 = 0
    let mut pulse: i32 = 0

    let g: Gfx = gfx_open(WIN_W, WIN_H, "Heightmap fBm - Flow procgen")

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(g) { break }

        let mut want: i32 = -1
        if gfx_key_down(g, KEY_1) { want = 1 }
        if gfx_key_down(g, KEY_2) { want = 2 }
        if gfx_key_down(g, KEY_3) { want = 3 }
        if gfx_key_down(g, KEY_4) { want = 4 }
        if want >= 0 and want != preset {
            preset = want
            sea = preset_sea(preset)
            land_live = land_fraction(sea)
        }

        if gfx_key_down(g, KEY_R) {
            if !reseed_held {
                rng_state = rng_next()
                procgen_seed(rng_state)
                land_live = land_fraction(sea)
            }
            reseed_held = true
        } else {
            reseed_held = false
        }

        if gfx_key_down(g, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        if !paused {
            pulse = pulse + 1
        }

        gfx_clear(g, 12, 10, 18)
        draw_scene(g, fb, sea)
        draw_hud(g, preset, land_live, sea, paused)
        gfx_present(g)
        frame = frame + 1
    }

    gfx_close(g)
    return 0
}
