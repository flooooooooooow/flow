# GIERER-MEINHARDT: activator-inhibitor Turing patterns with a predicted wavelength.
#
# MODEL (Gierer and Meinhardt, 1972)
#   A short-range activator a catalyses its own production; a long-range
#   inhibitor h, produced by a, suppresses it. Diffusion-driven instability:
#
#     da/dt = Da * lap(a) + rho * a^2 / h - mu * a + rho0
#     dh/dt = Dh * lap(h) + rho * a^2 - nu * h
#
#   Those two lines are the body of `flow GMCell` below.
#
# HOMOGENEOUS STEADY STATE
#   a* = (nu + rho0) / mu
#   h* = rho * a*^2 / nu
#
# LINEAR THEORY
#   Jacobian of the reaction terms at (a*, h*):
#
#     J11 = 2 nu / a* - mu     J12 = -nu / h*
#     J21 = 2 rho a*           J22 = -nu
#
#   Growth rate of mode k is the largest real part of the eigenvalues of
#   J - k^2 diag(Da, Dh). Scanning k finds k_max; the predicted wavelength is
#   2 pi / k_max. The program measures the dominant wavelength from the radial
#   power spectrum of a and gates the relative error below 15 %.
#
# PARAMETERS
#   Da 0.0434   Dh 0.868   rho 0.05   rho0 0.001   mu 0.05   nu 0.08
#   128 x 128 periodic grid, dx = 1, five-point laplacian
#   dt 0.15 explicit Euler, 80 steps per displayed frame
#
# KEYS
#   1 STANDARD   2 SPARSE (nu 0.075)   3 DENSE (nu 0.090)
#   R reseed     P pause               Esc quit
#
# REFERENCE
#   A. Gierer and H. Meinhardt, Kybernetik 12:30-39 (1972).
#   A. M. Turing, Phil. Trans. R. Soc. B 237:37-72 (1952).
#
# Run (headless, gated):
#   FLOW_HOST=python ./flow record examples/morphogenesis/gierer_meinhardt.flow \
#       --frames 4 --out /tmp/rec_gierer_meinhardt
# Run (windowed):
#   ./flow gfx examples/morphogenesis/gierer_meinhardt.flow

import "stdlib/gfx.flow"
import "stdlib/text.flow"

extern {
    function printf(fmt: string, val: f64) -> i32
    function sqrt(x: f64) -> f64
    function fabs(x: f64) -> f64
    function sin(x: f64) -> f64
    function cos(x: f64) -> f64
}

const GRID: i32 = 128
const CELLS: i32 = 16384
const CELL_PX: i32 = 4
const FIELD_Y: i32 = 58
const FB_W: i32 = 512
const FB_H: i32 = 512
const WIN_W: i32 = 512
const WIN_H: i32 = 592
const MAX_FRAMES: i32 = 6000
const SUBSTEPS: i32 = 80
const TWO_PI: f64 = 6.283185307179586

const KMAX: i32 = 65
const SHELLS: i32 = 64
const VERIFY_STEPS: i32 = 12000

const DA: f64 = 0.0434
const DH: f64 = 0.868
const RHO: f64 = 0.05
const RHO0: f64 = 0.001
const MU: f64 = 0.05

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20

flow GMCell {
    state a : f64 = 1.62
    state h : f64 = 1.64

    param lap_a : f64 = 0.0
    param lap_h : f64 = 0.0
    param da    : f64 = 0.0434
    param dh    : f64 = 0.868
    param rho   : f64 = 0.05
    param rho0  : f64 = 0.001
    param mu    : f64 = 0.05
    param nu    : f64 = 0.08

    solver { dt 150 ms  method euler }

    a evolves as da * lap_a + rho * a * a / (h + 0.000001) - mu * a + rho0
    h evolves as dh * lap_h + rho * a * a - nu * h
}

let mut rng_state: u32 = 1901194261

function rng_next() -> u32 {
    rng_state = rng_state * 1664525 + 1013904223
    return rng_state
}

function rng_unit() -> f64 {
    let bits: i32 = ((rng_next() >> 9) % 65536) as i32
    return (bits as f64) / 65536.0
}

function preset_nu(p: i32) -> f64 {
    if p == 1 { return 0.075 }
    if p == 2 { return 0.090 }
    return 0.080
}

function preset_name(p: i32) -> string {
    if p == 1 { return "SPARSE" }
    if p == 2 { return "DENSE" }
    return "STANDARD"
}

function a_star(nu: f64) -> f64 {
    return (nu + RHO0) / MU
}

function h_star(nu: f64) -> f64 {
    let a0: f64 = a_star(nu)
    return RHO * a0 * a0 / nu
}

# Largest real eigenvalue of 2x2 [[a11,a12],[a21,a22]].
function growth_of(a11: f64, a12: f64, a21: f64, a22: f64) -> f64 {
    let tr: f64 = a11 + a22
    let det: f64 = a11 * a22 - a12 * a21
    let disc: f64 = tr * tr * 0.25 - det
    if disc >= 0.0 {
        return tr * 0.5 + sqrt(disc)
    }
    return tr * 0.5
}

# Scan dispersion of J - k^2 D about the homogeneous steady state.
function predicted_wavelength(nu: f64) -> f64 {
    let a0: f64 = a_star(nu)
    let h0: f64 = h_star(nu)
    let j11: f64 = 2.0 * nu / a0 - MU
    let j12: f64 = 0.0 - nu / h0
    let j21: f64 = 2.0 * RHO * a0
    let j22: f64 = 0.0 - nu

    let mut best_k: f64 = 0.1
    let mut best_g: f64 = -1.0e9
    let mut prev_g: f64 = -1.0e9
    let mut cur_g: f64 = -1.0e9
    let mut next_g: f64 = -1.0e9
    let mut best_i: i32 = 1
    let nscan: i32 = 600
    let kmax: f64 = 3.0
    for i in 0 to nscan {
        let k: f64 = 0.001 + (kmax - 0.001) * (i as f64) / ((nscan - 1) as f64)
        let g: f64 = growth_of(j11 - DA * k * k, j12, j21, j22 - DH * k * k)
        if g > best_g {
            best_g = g
            best_k = k
            best_i = i
            prev_g = cur_g
            cur_g = g
        } else {
            if i == best_i + 1 {
                next_g = g
            }
        }
        if i == best_i {
            cur_g = g
        }
        if i == best_i - 1 {
            prev_g = g
        }
    }
    # Recompute three samples around the peak for a parabolic refine.
    let dk: f64 = (kmax - 0.001) / ((nscan - 1) as f64)
    let km: f64 = best_k - dk
    let kp: f64 = best_k + dk
    let gm: f64 = growth_of(j11 - DA * km * km, j12, j21, j22 - DH * km * km)
    let g0: f64 = growth_of(j11 - DA * best_k * best_k, j12, j21, j22 - DH * best_k * best_k)
    let gp: f64 = growth_of(j11 - DA * kp * kp, j12, j21, j22 - DH * kp * kp)
    let den: f64 = gm - 2.0 * g0 + gp
    let mut kpeak: f64 = best_k
    if den < 0.0 {
        kpeak = kpeak + 0.5 * (gm - gp) / den * dk
    }
    if kpeak <= 0.0 { return 0.0 }
    return TWO_PI / kpeak
}

function seed_field(a: ptr<f64>, h: ptr<f64>, nu: f64) -> void {
    let a0: f64 = a_star(nu)
    let h0: f64 = h_star(nu)
    for i in 0 to CELLS {
        a[i] = a0 * (1.0 + 0.001 * (rng_unit() - 0.5))
        h[i] = h0
    }
}

function lap_at(f: ptr<f64>, x: i32, y: i32) -> f64 {
    let xm: i32 = (x + GRID - 1) % GRID
    let xp: i32 = (x + 1) % GRID
    let ym: i32 = ((y + GRID - 1) % GRID) * GRID
    let yp: i32 = ((y + 1) % GRID) * GRID
    let r: i32 = y * GRID
    return f[r + xm] + f[r + xp] + f[ym + x] + f[yp + x] - 4.0 * f[r + x]
}

function evolve(a: ptr<f64>, h: ptr<f64>, an: ptr<f64>, hn: ptr<f64>,
                nu: f64, dt: f64) -> void {
    let mut cell: GMCell = GMCell_new()
    cell.nu = nu
    cell.da = DA
    cell.dh = DH
    cell.rho = RHO
    cell.rho0 = RHO0
    cell.mu = MU
    for y in 0 to GRID {
        for x in 0 to GRID {
            let i: i32 = y * GRID + x
            cell.a = a[i]
            cell.h = h[i]
            cell.lap_a = lap_at(a, x, y)
            cell.lap_h = lap_at(h, x, y)
            GMCell_step(&cell, dt)
            if cell.a < 0.0 { cell.a = 0.0 }
            if cell.h < 0.000001 { cell.h = 0.000001 }
            an[i] = cell.a
            hn[i] = cell.h
        }
    }
}

function fill_twiddles(ct: ptr<f64>, st: ptr<f64>) -> void {
    for i in 0 to GRID {
        let ang: f64 = TWO_PI * (i as f64) / (GRID as f64)
        ct[i] = cos(ang)
        st[i] = sin(ang)
    }
}

function spectral_wavelength(a: ptr<f64>, ar: ptr<f64>, ai: ptr<f64>,
                             ct: ptr<f64>, st: ptr<f64>,
                             shell: ptr<f64>, shell_n: ptr<f64>) -> f64 {
    let mut mean: f64 = 0.0
    for i in 0 to CELLS {
        mean = mean + a[i]
    }
    mean = mean / (CELLS as f64)

    for y in 0 to GRID {
        let r: i32 = y * GRID
        let o: i32 = y * KMAX
        for kx in 0 to KMAX {
            let mut sr: f64 = 0.0
            let mut si: f64 = 0.0
            for x in 0 to GRID {
                let t: i32 = (kx * x) % GRID
                let d: f64 = a[r + x] - mean
                sr = sr + d * ct[t]
                si = si - d * st[t]
            }
            ar[o + kx] = sr
            ai[o + kx] = si
        }
    }

    for s in 0 to SHELLS {
        shell[s] = 0.0
        shell_n[s] = 0.0
    }

    for ky in 0 to GRID {
        let mut kyy: i32 = ky
        if kyy > GRID / 2 { kyy = kyy - GRID }
        for kx in 0 to KMAX {
            let mut re: f64 = 0.0
            let mut im: f64 = 0.0
            for y in 0 to GRID {
                let t: i32 = (ky * y) % GRID
                let ar_v: f64 = ar[y * KMAX + kx]
                let ai_v: f64 = ai[y * KMAX + kx]
                re = re + ar_v * ct[t] + ai_v * st[t]
                im = im + ai_v * ct[t] - ar_v * st[t]
            }
            let rad: f64 = sqrt(((kx * kx + kyy * kyy) as f64))
            let s: i32 = (rad + 0.5) as i32
            if s < SHELLS {
                shell[s] = shell[s] + re * re + im * im
                shell_n[s] = shell_n[s] + 1.0
            }
        }
    }

    for s in 0 to SHELLS {
        if shell_n[s] > 0.0 {
            shell[s] = shell[s] / shell_n[s]
        }
    }

    let mut best: i32 = 3
    for s in 3 to SHELLS - 2 {
        if shell[s] > shell[best] { best = s }
    }
    let sm: f64 = shell[best - 1]
    let s0: f64 = shell[best]
    let sp: f64 = shell[best + 1]
    let den: f64 = sm - 2.0 * s0 + sp
    let mut rpeak: f64 = best as f64
    if den < 0.0 {
        rpeak = rpeak + 0.5 * (sm - sp) / den
    }
    if rpeak < 0.5 { return 0.0 }
    return (GRID as f64) / rpeak
}

function amplitude(a: ptr<f64>) -> f64 {
    let mut lo: f64 = a[0]
    let mut hi: f64 = a[0]
    for i in 1 to CELLS {
        if a[i] < lo { lo = a[i] }
        if a[i] > hi { hi = a[i] }
    }
    return hi - lo
}

function shade_r(t: f64) -> i32 {
    let mut c: f64 = 28.0 + 240.0 * t
    if c > 255.0 { c = 255.0 }
    return c as i32
}

function shade_g(t: f64) -> i32 {
    let mut c: f64 = 20.0 + 200.0 * t * t
    if c > 250.0 { c = 250.0 }
    return c as i32
}

function shade_b(t: f64) -> i32 {
    let mut c: f64 = 26.0 + 120.0 * t * t * t
    if c > 210.0 { c = 210.0 }
    return c as i32
}

function paint_cell(fb: ptr<u8>, x: i32, y: i32, r: i32, g2: i32, b: i32) -> void {
    let px: i32 = x * CELL_PX
    let py: i32 = y * CELL_PX
    for dy in 0 to CELL_PX {
        let mut o: i32 = ((py + dy) * FB_W + px) * 3
        for dx in 0 to CELL_PX {
            fb[o] = r as u8
            fb[o + 1] = g2 as u8
            fb[o + 2] = b as u8
            o = o + 3
        }
    }
}

function draw_field(g: Gfx, fb: ptr<u8>, a: ptr<f64>, peak: f64) -> void {
    let mut inv: f64 = 1.0
    if peak > 0.001 { inv = 1.0 / peak }
    for y in 0 to GRID {
        for x in 0 to GRID {
            let mut t: f64 = a[y * GRID + x] * inv
            if t < 0.0 { t = 0.0 }
            if t > 1.0 { t = 1.0 }
            paint_cell(fb, x, y, shade_r(t), shade_g(t), shade_b(t))
        }
    }
    gfx_blit_rgb(g, 0, FIELD_Y, FB_W, FB_H, fb)
}

function draw_hud(g: Gfx, preset: i32, nu: f64, meas: f64, pred: f64,
                  amp: f64, paused: bool) -> void {
    let t1: i32 = gfx_draw_text(g, 8, 8, "GIERER-MEINHARDT", 2, 240, 232, 220)
    let t2: i32 = gfx_draw_text(g, 200, 12, preset_name(preset), 1, 255, 200, 120)
    let t3: i32 = gfx_draw_text(g, 280, 12, "nu", 1, 150, 140, 130)
    let t4: i32 = gfx_draw_fixed(g, 300, 12, nu, 3, 1, 240, 232, 220)
    let t5: i32 = gfx_draw_text(g, 360, 12, "AMP", 1, 150, 140, 130)
    let t6: i32 = gfx_draw_fixed(g, 388, 12, amp, 2, 1, 240, 232, 220)

    let t7: i32 = gfx_draw_text(g, 8, 28, "WAVELENGTH  MEASURED", 1, 150, 140, 130)
    let t8: i32 = gfx_draw_fixed(g, 140, 28, meas, 2, 1, 120, 255, 190)
    let t9: i32 = gfx_draw_text(g, 190, 28, "PREDICTED 2pi/k_max", 1, 150, 140, 130)
    let ta: i32 = gfx_draw_fixed(g, 318, 28, pred, 2, 1, 120, 255, 190)

    let tb: i32 = gfx_draw_text(g, 8, 42,
        "1 STANDARD  2 SPARSE  3 DENSE  R RESEED  P PAUSE",
        1, 110, 104, 96)
    if paused {
        let tc: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let td: i32 = gfx_draw_text(g, 8, 572,
        "a evolves as Da*lap(a) + rho*a^2/h - mu*a + rho0", 1, 120, 130, 150)
    let te: i32 = gfx_draw_text(g, 8, 582,
        "h evolves as Dh*lap(h) + rho*a^2 - nu*h", 1, 120, 130, 150)
}

function main() -> i32 {
    let aa: array<f64, 16384> = [0.0, 0.0, 0.0, 0.0]
    let ha: array<f64, 16384> = [0.0, 0.0, 0.0, 0.0]
    let ab: array<f64, 16384> = [0.0, 0.0, 0.0, 0.0]
    let hb: array<f64, 16384> = [0.0, 0.0, 0.0, 0.0]
    let fb: array<u8, 786432> = [0, 0, 0, 0]
    let ar: array<f64, 8320> = [0.0, 0.0, 0.0, 0.0]
    let ai: array<f64, 8320> = [0.0, 0.0, 0.0, 0.0]
    let ct: array<f64, 128> = [0.0, 0.0, 0.0, 0.0]
    let st: array<f64, 128> = [0.0, 0.0, 0.0, 0.0]
    let shell: array<f64, 64> = [0.0, 0.0, 0.0, 0.0]
    let shell_n: array<f64, 64> = [0.0, 0.0, 0.0, 0.0]
    fill_twiddles(ct, st)

    let nu: f64 = 0.08
    let dt: f64 = GMCell_default_dt()
    let pred: f64 = predicted_wavelength(nu)

    println("")
    println("  GIERER-MEINHARDT  --  activator-inhibitor wavelength")
    println("  ====================================================")
    println("")
    print("    a* = (nu+rho0)/mu               : ")
    printf("%9.6f", a_star(nu))
    println("")
    print("    h* = rho a*^2 / nu              : ")
    printf("%9.6f", h_star(nu))
    println("")
    print("    predicted wavelength 2pi/k_max  : ")
    printf("%9.6f", pred)
    println(" cells")

    rng_state = 1901194261
    seed_field(aa, ha, nu)
    for s in 0 to VERIFY_STEPS / 2 {
        evolve(aa, ha, ab, hb, nu, dt)
        evolve(ab, hb, aa, ha, nu, dt)
    }
    let meas: f64 = spectral_wavelength(aa, ar, ai, ct, st, shell, shell_n)
    let amp: f64 = amplitude(aa)
    let err: f64 = fabs(meas - pred) / pred

    print("    measured wavelength (spectrum)  : ")
    printf("%9.6f", meas)
    println(" cells")
    print("    relative error                  : ")
    printf("%9.6f", err)
    println("   (gate < 0.15)")
    print("    activator amplitude             : ")
    printf("%9.6f", amp)
    println("")
    println("")

    if amp < 0.1 {
        println("    FAIL: pattern amplitude stayed too small")
        return 1
    }
    if err > 0.15 {
        println("    FAIL: measured wavelength disagrees with linear theory")
        return 2
    }
    println("    PASS: dominant wavelength matches k_max from dispersion of J - k^2 D")
    println("")

    let mut preset: i32 = 0
    let mut nu_live: f64 = nu
    rng_state = 1901194261
    seed_field(aa, ha, nu_live)

    let g: Gfx = gfx_open(WIN_W, WIN_H, "Gierer-Meinhardt - Flow morphogenesis")
    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut reseed_held: bool = false
    let mut frame: i32 = 0
    let mut meas_live: f64 = meas

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(g) { break }

        let mut want: i32 = -1
        if gfx_key_down(g, KEY_1) { want = 0 }
        if gfx_key_down(g, KEY_2) { want = 1 }
        if gfx_key_down(g, KEY_3) { want = 2 }
        if want >= 0 and want != preset {
            preset = want
            nu_live = preset_nu(preset)
            seed_field(aa, ha, nu_live)
        }

        if gfx_key_down(g, KEY_R) {
            if !reseed_held {
                seed_field(aa, ha, nu_live)
            }
            reseed_held = true
        } else {
            reseed_held = false
        }

        if gfx_key_down(g, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        if !paused {
            for s in 0 to SUBSTEPS / 2 {
                evolve(aa, ha, ab, hb, nu_live, dt)
                evolve(ab, hb, aa, ha, nu_live, dt)
            }
        }

        let amp_live: f64 = amplitude(aa)
        if frame % 8 == 0 {
            meas_live = spectral_wavelength(aa, ar, ai, ct, st, shell, shell_n)
        }
        let pred_live: f64 = predicted_wavelength(nu_live)

        gfx_clear(g, 14, 12, 10)
        draw_field(g, fb, aa, a_star(nu_live) + 0.8 * amp_live)
        draw_hud(g, preset, nu_live, meas_live, pred_live, amp_live, paused)
        gfx_present(g)
        frame = frame + 1
    }

    gfx_close(g)
    return 0
}
