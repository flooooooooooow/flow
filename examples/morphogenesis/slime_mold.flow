# SLIME MOULD: Physarum agents building a transport network.
#
# MODEL (Jones, 2010, after Physarum polycephalum)
#   Every agent is three numbers: a position and a heading. It reads the
#   trail map at three points ahead of it, turns toward the strongest, steps
#   forward and deposits trail where it lands. The trail then blurs and
#   decays. That is the entire organism.
#
#     FL = trail at heading - sensor_angle, distance sensor_offset
#     F  = trail straight ahead
#     FR = trail at heading + sensor_angle
#     if F is the largest        keep the heading
#     if F is the smallest       turn left or right at random
#     otherwise                  turn toward the larger of FL and FR
#     move forward, deposit, then diffuse and decay the whole map
#
#   The agents never communicate. The trail map is the only shared state,
#   and it is also the thing being built. Reinforcement of used routes and
#   decay of unused ones is enough to produce a transport network with
#   junctions, redundant loops and pruning.
#
# PARAMETERS
#   2200 agents on a 128 x 128 periodic trail map (13 per cent occupancy),
#   one step per displayed frame, deposit 5.0, 3 x 3 box diffusion,
#   per-step decay per preset.
#
# KEYS
#   1 NETWORK   sensor 22 deg  offset 4   decay 0.10   arterial mesh
#   2 WEB       sensor 45 deg  offset 2   decay 0.06   fine dense weave
#   3 CELLS     sensor 12 deg  offset 7   decay 0.14   long routes, big voids
#   R reseed    P pause    Esc quit
#
# PHENOMENON
#   Start uniform, end structured. The same species of agent, three sensor
#   parameters apart, builds a coarse arterial network or a fine web. Real
#   Physarum solves shortest-path problems this way, and the sensor
#   geometry is what sets the scale of the network it settles on.
#
# Run: ./flow gfx examples/morphogenesis/slime_mold.flow

import "stdlib/gfx.flow"
import "stdlib/text.flow"

extern {
    function sin(x: f64) -> f64
    function cos(x: f64) -> f64
}

const GRID: i32 = 128
const CELLS: i32 = 16384
const CELL_PX: i32 = 4
const FIELD_Y: i32 = 58
const WIN_W: i32 = 512
const WIN_H: i32 = 592
const MAX_FRAMES: i32 = 6000
const AGENTS: i32 = 2200
const STEPS_PER_FRAME: i32 = 1
const DEPOSIT: f64 = 5.0
const SPEED: f64 = 1.0
const TWO_PI: f64 = 6.283185307179586
const DEG: f64 = 0.017453292519943295

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20

let mut rng_state: u32 = 606060601

function rng_next() -> u32 {
    rng_state = rng_state * 1664525 + 1013904223
    return rng_state
}

function rng_unit() -> f64 {
    let bits: i32 = ((rng_next() >> 9) % 65536) as i32
    return (bits as f64) / 65536.0
}

function preset_sensor_angle(p: i32) -> f64 {
    if p == 1 { return 45.0 }
    if p == 2 { return 12.0 }
    return 22.0
}

function preset_offset(p: i32) -> f64 {
    if p == 1 { return 2.0 }
    if p == 2 { return 7.0 }
    return 4.0
}

function preset_decay(p: i32) -> f64 {
    if p == 1 { return 0.06 }
    if p == 2 { return 0.14 }
    return 0.10
}

function preset_name(p: i32) -> string {
    if p == 1 { return "WEB" }
    if p == 2 { return "CELLS" }
    return "NETWORK"
}

function seed_agents(ax: ptr<f64>, ay: ptr<f64>, ah: ptr<f64>,
                     trail: ptr<f64>) -> void {
    for i in 0 to CELLS {
        trail[i] = 0.0
    }
    for i in 0 to AGENTS {
        ax[i] = rng_unit() * (GRID as f64)
        ay[i] = rng_unit() * (GRID as f64)
        ah[i] = rng_unit() * TWO_PI
    }
}

function wrapf(v: f64) -> f64 {
    let n: f64 = GRID as f64
    let mut r: f64 = v
    while r < 0.0 { r = r + n }
    while r >= n { r = r - n }
    return r
}

function sample(trail: ptr<f64>, x: f64, y: f64) -> f64 {
    let ix: i32 = (wrapf(x)) as i32
    let iy: i32 = (wrapf(y)) as i32
    return trail[iy * GRID + ix]
}

function move_agents(ax: ptr<f64>, ay: ptr<f64>, ah: ptr<f64>,
                     trail: ptr<f64>, sensor: f64, offset: f64) -> void {
    let sa: f64 = sensor * DEG
    for i in 0 to AGENTS {
        let h: f64 = ah[i]
        let f: f64 = sample(trail, ax[i] + offset * cos(h),
                            ay[i] + offset * sin(h))
        let fl: f64 = sample(trail, ax[i] + offset * cos(h - sa),
                             ay[i] + offset * sin(h - sa))
        let fr: f64 = sample(trail, ax[i] + offset * cos(h + sa),
                             ay[i] + offset * sin(h + sa))
        let mut nh: f64 = h
        if f >= fl and f >= fr {
            nh = h
        } else {
            if f < fl and f < fr {
                if rng_unit() < 0.5 { nh = h - sa } else { nh = h + sa }
            } else {
                if fl > fr { nh = h - sa } else { nh = h + sa }
            }
        }
        let nx: f64 = wrapf(ax[i] + SPEED * cos(nh))
        let ny: f64 = wrapf(ay[i] + SPEED * sin(nh))
        ax[i] = nx
        ay[i] = ny
        ah[i] = nh
        let idx: i32 = (ny as i32) * GRID + (nx as i32)
        trail[idx] = trail[idx] + DEPOSIT
    }
}

# 3 x 3 box blur plus exponential decay, the medium's own dynamics.
function diffuse(trail: ptr<f64>, tmp: ptr<f64>, decay: f64) -> void {
    let keep: f64 = 1.0 - decay
    for y in 0 to GRID {
        let ym: i32 = ((y + GRID - 1) % GRID) * GRID
        let yp: i32 = ((y + 1) % GRID) * GRID
        let r: i32 = y * GRID
        for x in 0 to GRID {
            let xm: i32 = (x + GRID - 1) % GRID
            let xp: i32 = (x + 1) % GRID
            let s: f64 = trail[r + xm] + trail[r + x] + trail[r + xp]
                       + trail[ym + xm] + trail[ym + x] + trail[ym + xp]
                       + trail[yp + xm] + trail[yp + x] + trail[yp + xp]
            tmp[r + x] = keep * s / 9.0
        }
    }
    for i in 0 to CELLS {
        trail[i] = tmp[i]
    }
}

function trail_mass(trail: ptr<f64>) -> f64 {
    let mut s: f64 = 0.0
    for i in 0 to CELLS {
        s = s + trail[i]
    }
    return s / (CELLS as f64)
}

# Contrast of the trail field: a network has high contrast, a uniform
# smear has none.
function trail_contrast(trail: ptr<f64>, mean: f64) -> f64 {
    let mut s: f64 = 0.0
    for i in 0 to CELLS {
        let d: f64 = trail[i] - mean
        s = s + d * d
    }
    let var: f64 = s / (CELLS as f64)
    if mean < 0.0001 { return 0.0 }
    return var / (mean * mean)
}

function draw_field(g: Gfx, trail: ptr<f64>) -> void {
    for y in 0 to GRID {
        for x in 0 to GRID {
            let v: f64 = trail[y * GRID + x]
            # Soft tone map, so a busy trunk never clips to flat white.
            let mut t: f64 = v / (v + 22.0)
            if t < 0.0 { t = 0.0 }
            if t > 1.0 { t = 1.0 }
            let mut rr: f64 = 14.0 + 250.0 * t
            let mut gg: f64 = 16.0 + 120.0 * t + 130.0 * t * t * t
            let mut bb: f64 = 22.0 + 30.0 * t + 170.0 * t * t * t * t
            if rr > 255.0 { rr = 255.0 }
            if gg > 255.0 { gg = 255.0 }
            if bb > 255.0 { bb = 255.0 }
            gfx_fill_rect(g, x * CELL_PX, FIELD_Y + y * CELL_PX,
                          CELL_PX, CELL_PX, rr as i32, gg as i32, bb as i32)
        }
    }
}

function draw_hud(g: Gfx, preset: i32, sensor: f64, offset: f64,
                  contrast: f64, steps: i32, paused: bool) -> void {
    let t1: i32 = gfx_draw_text(g, 8, 8, "SLIME MOULD  PHYSARUM NETWORK", 2,
                                244, 236, 224)
    let t2: i32 = gfx_draw_text(g, 8, 28, "MODE", 1, 154, 144, 130)
    let t3: i32 = gfx_draw_text(g, 40, 28, preset_name(preset), 1, 255, 196, 110)
    let t4: i32 = gfx_draw_text(g, 116, 28, "SENSOR", 1, 154, 144, 130)
    let t5: i32 = gfx_draw_fixed(g, 160, 28, sensor, 0, 1, 244, 236, 224)
    let t6: i32 = gfx_draw_text(g, 186, 28, "DEG", 1, 154, 144, 130)
    let t7: i32 = gfx_draw_text(g, 216, 28, "OFFSET", 1, 154, 144, 130)
    let t8: i32 = gfx_draw_fixed(g, 260, 28, offset, 0, 1, 244, 236, 224)
    let t9: i32 = gfx_draw_text(g, 286, 28, "CONTRAST", 1, 154, 144, 130)
    let ta: i32 = gfx_draw_fixed(g, 342, 28, contrast, 3, 1, 255, 210, 140)
    let tb: i32 = gfx_draw_text(g, 404, 28, "STEP", 1, 154, 144, 130)
    let tc: i32 = gfx_draw_int(g, 436, 28, steps, 1, 244, 236, 224)
    let td: i32 = gfx_draw_text(g, 8, 42,
        "2200 AGENTS   1 NETWORK  2 WEB  3 CELLS  R RESEED  P PAUSE",
        1, 116, 108, 98)
    if paused {
        let te: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let tf: i32 = gfx_draw_text(g, 8, 572,
        "sense three points ahead, turn to the strongest, deposit, decay",
        1, 130, 122, 112)
    let tg: i32 = gfx_draw_text(g, 8, 582,
        "the trail map is the only shared state and also the thing built",
        1, 130, 122, 112)
}

function main() -> i32 {
    let trail: array<f64, 16384> = [0.0, 0.0, 0.0, 0.0]
    let tmp: array<f64, 16384> = [0.0, 0.0, 0.0, 0.0]
    let ax: array<f64, 2200> = [0.0, 0.0, 0.0, 0.0]
    let ay: array<f64, 2200> = [0.0, 0.0, 0.0, 0.0]
    let ah: array<f64, 2200> = [0.0, 0.0, 0.0, 0.0]

    let mut preset: i32 = 0
    seed_agents(ax, ay, ah, trail)

    let g: Gfx = gfx_open(WIN_W, WIN_H, "Slime mould - Flow morphogenesis")

    let mut steps: i32 = 0
    let mut contrast: f64 = 0.0
    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut reseed_held: bool = false
    let mut frame: i32 = 0

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(g) { break }

        let mut want: i32 = -1
        if gfx_key_down(g, KEY_1) { want = 0 }
        if gfx_key_down(g, KEY_2) { want = 1 }
        if gfx_key_down(g, KEY_3) { want = 2 }
        if want >= 0 and want != preset {
            preset = want
            seed_agents(ax, ay, ah, trail)
            steps = 0
        }

        if gfx_key_down(g, KEY_R) {
            if !reseed_held {
                seed_agents(ax, ay, ah, trail)
                steps = 0
            }
            reseed_held = true
        } else {
            reseed_held = false
        }

        if gfx_key_down(g, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        if !paused {
            for k in 0 to STEPS_PER_FRAME {
                move_agents(ax, ay, ah, trail, preset_sensor_angle(preset),
                            preset_offset(preset))
                diffuse(trail, tmp, preset_decay(preset))
                steps = steps + 1
            }
            contrast = trail_contrast(trail, trail_mass(trail))
        }

        gfx_clear(g, 12, 12, 18)
        draw_field(g, trail)
        draw_hud(g, preset, preset_sensor_angle(preset),
                 preset_offset(preset), contrast, steps, paused)
        gfx_present(g)
        frame = frame + 1
    }

    gfx_close(g)
    return 0
}
