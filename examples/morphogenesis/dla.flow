# DIFFUSION-LIMITED AGGREGATION: growth where the shape is the history.
#
# MODEL (Witten and Sander, 1981)
#   A single seed sits at the centre. Particles are released one at a time
#   from a circle just outside the cluster and random-walk until they touch
#   it, at which point they freeze where they landed. Nothing steers them.
#
#     release on a circle of radius r_cluster + 4
#     while free:  step to a uniformly random neighbour
#                  if a neighbour cell is occupied, stick with probability p
#                  if the walk drifts past the kill radius, discard it
#
#   The tips of the cluster intercept walkers long before the fjords do, so
#   tips grow faster than valleys and the advantage compounds. That single
#   screening effect produces the whole dendrite.
#
# PARAMETERS
#   128 x 128 lattice, seed at the centre, 12 walkers launched per frame.
#   Kill radius 2 * r_cluster + 12. Colour encodes arrival order. When the
#   cluster reaches the edge of the dish it holds for two seconds, then a
#   fresh seed starts over.
#
# KEYS
#   1 VON NEUMANN   4-neighbour walk, p 1.0    open, wiry arms
#   2 MOORE         8-neighbour walk, p 1.0    thicker, faster arms
#   3 STICKY 0.25   8-neighbour walk, p 0.25   walkers probe deeper, denser
#   R restart    P pause    Esc quit
#
# PHENOMENON
#   The readout carries the point: N is the particle count, R the cluster
#   radius, and D = log N / log R settles near 1.7 rather than at 2. The
#   cluster is a fractal, and it is a fractal because of the order in which
#   it was built. This is growth history made visible.
#
# Run: ./flow gfx examples/morphogenesis/dla.flow

import "stdlib/gfx.flow"
import "stdlib/text.flow"

extern {
    function sin(x: f64) -> f64
    function cos(x: f64) -> f64
    function sqrt(x: f64) -> f64
    function log(x: f64) -> f64
}

const GRID: i32 = 128
const CELLS: i32 = 16384
const CELL_PX: i32 = 4
const FIELD_Y: i32 = 58
const WIN_W: i32 = 512
const WIN_H: i32 = 592
const MAX_FRAMES: i32 = 6000
const CENTER: i32 = 64
const PER_FRAME: i32 = 12
const MAX_WALK: i32 = 6000
const TWO_PI: f64 = 6.283185307179586

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20

let mut rng_state: u32 = 3141592653

function rng_next() -> u32 {
    rng_state = rng_state * 1664525 + 1013904223
    return rng_state
}

function rng_unit() -> f64 {
    let bits: i32 = ((rng_next() >> 9) % 65536) as i32
    return (bits as f64) / 65536.0
}

function rng_below(n: i32) -> i32 {
    return ((rng_next() >> 13) % (n as u32)) as i32
}

function mode_name(m: i32) -> string {
    if m == 1 { return "MOORE" }
    if m == 2 { return "STICKY 0.25" }
    return "VON NEUMANN"
}

function mode_dirs(m: i32) -> i32 {
    if m == 0 { return 4 }
    return 8
}

function mode_stick(m: i32) -> f64 {
    if m == 2 { return 0.25 }
    return 1.0
}

function dir_dx(d: i32) -> i32 {
    if d == 0 { return 1 }
    if d == 1 { return -1 }
    if d == 2 { return 0 }
    if d == 3 { return 0 }
    if d == 4 { return 1 }
    if d == 5 { return 1 }
    if d == 6 { return -1 }
    return -1
}

function dir_dy(d: i32) -> i32 {
    if d == 0 { return 0 }
    if d == 1 { return 0 }
    if d == 2 { return 1 }
    if d == 3 { return -1 }
    if d == 4 { return 1 }
    if d == 5 { return -1 }
    if d == 6 { return 1 }
    return -1
}

function reset(occ: ptr<i32>, age: ptr<i32>) -> void {
    for i in 0 to CELLS {
        occ[i] = 0
        age[i] = 0
    }
    occ[CENTER * GRID + CENTER] = 1
    age[CENTER * GRID + CENTER] = 1
}

function touches_cluster(occ: ptr<i32>, x: i32, y: i32, dirs: i32) -> bool {
    let mut d: i32 = 0
    while d < dirs {
        let nx: i32 = x + dir_dx(d)
        let ny: i32 = y + dir_dy(d)
        if nx >= 0 and nx < GRID and ny >= 0 and ny < GRID {
            if occ[ny * GRID + nx] == 1 {
                return true
            }
        }
        d = d + 1
    }
    return false
}

# One walker. Returns 1 if it froze onto the cluster.
function launch(occ: ptr<i32>, age: ptr<i32>, radius: f64, stamp: i32,
                dirs: i32, stick_p: f64) -> i32 {
    let mut birth: f64 = radius + 4.0
    if birth > 61.0 { birth = 61.0 }
    let mut kill: f64 = radius * 2.0 + 12.0
    if kill > 88.0 { kill = 88.0 }

    let theta: f64 = TWO_PI * rng_unit()
    let mut x: i32 = CENTER + (birth * cos(theta)) as i32
    let mut y: i32 = CENTER + (birth * sin(theta)) as i32

    let mut step: i32 = 0
    while step < MAX_WALK {
        let d: i32 = rng_below(dirs)
        x = x + dir_dx(d)
        y = y + dir_dy(d)
        if x < 1 or x >= GRID - 1 or y < 1 or y >= GRID - 1 {
            return 0
        }
        let fx: f64 = (x - CENTER) as f64
        let fy: f64 = (y - CENTER) as f64
        if fx * fx + fy * fy > kill * kill {
            return 0
        }
        if touches_cluster(occ, x, y, dirs) {
            if rng_unit() <= stick_p {
                occ[y * GRID + x] = 1
                age[y * GRID + x] = stamp
                return 1
            }
        }
        step = step + 1
    }
    return 0
}

function cluster_radius(occ: ptr<i32>) -> f64 {
    let mut best: f64 = 1.0
    for y in 0 to GRID {
        for x in 0 to GRID {
            if occ[y * GRID + x] == 1 {
                let fx: f64 = (x - CENTER) as f64
                let fy: f64 = (y - CENTER) as f64
                let r2: f64 = fx * fx + fy * fy
                if r2 > best { best = r2 }
            }
        }
    }
    return sqrt(best)
}

# Arrival order as colour: violet core, magenta mid, amber tips.
function draw_field(g: Gfx, occ: ptr<i32>, age: ptr<i32>, newest: i32) -> void {
    let mut inv: f64 = 1.0
    if newest > 1 { inv = 1.0 / (newest as f64) }
    for y in 0 to GRID {
        for x in 0 to GRID {
            let i: i32 = y * GRID + x
            let mut rr: i32 = 10
            let mut gg: i32 = 10
            let mut bb: i32 = 18
            if occ[i] == 1 {
                let t: f64 = (age[i] as f64) * inv
                let mut fr: f64 = 70.0 + 190.0 * t
                let mut fg: f64 = 20.0 + 200.0 * t * t * t
                let mut fb: f64 = 130.0 + 90.0 * (1.0 - t) - 40.0 * t
                if fr > 255.0 { fr = 255.0 }
                if fg > 255.0 { fg = 255.0 }
                if fb > 255.0 { fb = 255.0 }
                if fb < 20.0 { fb = 20.0 }
                rr = fr as i32
                gg = fg as i32
                bb = fb as i32
            }
            gfx_fill_rect(g, x * CELL_PX, FIELD_Y + y * CELL_PX,
                          CELL_PX, CELL_PX, rr, gg, bb)
        }
    }
}

function draw_hud(g: Gfx, mode: i32, n: i32, radius: f64, dim: f64,
                  launched: i32, paused: bool) -> void {
    let t1: i32 = gfx_draw_text(g, 8, 8, "DIFFUSION-LIMITED AGGREGATION", 2,
                                238, 232, 246)
    let t2: i32 = gfx_draw_text(g, 8, 28, "WALK", 1, 148, 142, 168)
    let t3: i32 = gfx_draw_text(g, 40, 28, mode_name(mode), 1, 255, 170, 210)
    let t4: i32 = gfx_draw_text(g, 128, 28, "N", 1, 148, 142, 168)
    let t5: i32 = gfx_draw_int(g, 140, 28, n, 1, 238, 232, 246)
    let t6: i32 = gfx_draw_text(g, 184, 28, "R", 1, 148, 142, 168)
    let t7: i32 = gfx_draw_fixed(g, 196, 28, radius, 1, 1, 238, 232, 246)
    let t8: i32 = gfx_draw_text(g, 238, 28, "D", 1, 148, 142, 168)
    let t9: i32 = gfx_draw_fixed(g, 250, 28, dim, 3, 1, 255, 210, 130)
    let ta: i32 = gfx_draw_text(g, 306, 28, "LAUNCHED", 1, 148, 142, 168)
    let tb: i32 = gfx_draw_int(g, 362, 28, launched, 1, 238, 232, 246)
    let tc: i32 = gfx_draw_text(g, 8, 42,
        "1 VON NEUMANN  2 MOORE  3 STICKY 0.25  R RESTART  P PAUSE",
        1, 108, 104, 126)
    if paused {
        let td: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let te: i32 = gfx_draw_text(g, 8, 572,
        "tips screen the fjords, so tips grow: D = log N / log R tends to 1.7",
        1, 122, 118, 142)
    let tf: i32 = gfx_draw_text(g, 8, 582,
        "colour is arrival order, oldest violet, newest amber", 1,
        122, 118, 142)
}

function main() -> i32 {
    let occ: array<i32, 16384> = [0, 0, 0, 0]
    let age: array<i32, 16384> = [0, 0, 0, 0]

    let mut mode: i32 = 1
    reset(occ, age)

    let g: Gfx = gfx_open(WIN_W, WIN_H, "DLA - Flow morphogenesis")

    let mut n: i32 = 1
    let mut launched: i32 = 0
    let mut radius: f64 = 1.0
    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut reset_held: bool = false
    let mut hold: i32 = 0
    let mut frame: i32 = 0

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(g) { break }

        let mut want: i32 = -1
        if gfx_key_down(g, KEY_1) { want = 0 }
        if gfx_key_down(g, KEY_2) { want = 1 }
        if gfx_key_down(g, KEY_3) { want = 2 }
        if want >= 0 and want != mode {
            mode = want
            reset(occ, age)
            n = 1
            launched = 0
            radius = 1.0
        }

        if gfx_key_down(g, KEY_R) {
            if !reset_held {
                reset(occ, age)
                n = 1
                launched = 0
                radius = 1.0
            }
            reset_held = true
        } else {
            reset_held = false
        }

        if gfx_key_down(g, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        # The cluster has run out of dish: admire it, then start again.
        if radius >= 60.0 {
            hold = hold + 1
            if hold > 120 {
                reset(occ, age)
                n = 1
                launched = 0
                radius = 1.0
                hold = 0
            }
        }

        if !paused and radius < 60.0 {
            let dirs: i32 = mode_dirs(mode)
            let stick_p: f64 = mode_stick(mode)
            for k in 0 to PER_FRAME {
                launched = launched + 1
                n = n + launch(occ, age, radius, n + 1, dirs, stick_p)
            }
            radius = cluster_radius(occ)
        }

        let mut dim: f64 = 0.0
        if radius > 1.5 {
            dim = log(n as f64) / log(radius)
        }

        gfx_clear(g, 10, 10, 18)
        draw_field(g, occ, age, n)
        draw_hud(g, mode, n, radius, dim, launched, paused)
        gfx_present(g)
        frame = frame + 1
    }

    gfx_close(g)
    return 0
}
