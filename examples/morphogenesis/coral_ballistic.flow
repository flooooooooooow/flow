# CORAL: ballistic deposition and the shadowing instability.
#
# MODEL (Vold, 1959; Family and Vicsek, 1985)
#   Particles rain onto a substrate and stick to the first thing they touch.
#   They never relax, never roll downhill, never fill a void. A column that
#   happens to be one cell taller than its neighbour intercepts particles
#   that would have landed in the gap, so it gets taller still. That is the
#   whole mechanism, and it is enough to grow coral.
#
#     drop a particle at a random x, travel along the incidence direction
#     at each cell, if any contact neighbour is occupied, freeze here
#     otherwise keep going until the substrate is reached
#
# PARAMETERS
#   128 x 128 lattice, substrate along the bottom row, 90 particles per
#   displayed frame, periodic in x. Colour is arrival order.
#
# KEYS
#   1 NORMAL      vertical rain, contacts below and to the sides
#   2 OBLIQUE     rain at 40 degrees, so the columns lean into the flux
#   3 POROUS      diagonal contacts stick too, the most open structure
#   R restart    P pause    Esc quit
#
# THE READOUT
#   FILL is the occupied fraction of everything below the surface, so it
#   measures porosity: the deposit is far from solid. H is the mean column
#   height and W the surface width, which grows without bound as the tall
#   columns pull away from the short ones.
#
# PHENOMENON
#   No branching rule is written down. Branches appear because being tall
#   is self-reinforcing when the growth medium arrives from outside. The
#   same instability shapes sputtered thin films, frost on a window and
#   the growth fronts of real corals.
#
# Run: ./flow gfx examples/morphogenesis/coral_ballistic.flow

import "stdlib/gfx.flow"
import "stdlib/text.flow"

extern {
    function sqrt(x: f64) -> f64
}

const GRID: i32 = 128
const CELLS: i32 = 16384
const CELL_PX: i32 = 4
const FIELD_Y: i32 = 58
const WIN_W: i32 = 512
const WIN_H: i32 = 592
const MAX_FRAMES: i32 = 6000
const PER_FRAME: i32 = 90

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20

let mut rng_state: u32 = 55511213

function rng_next() -> u32 {
    rng_state = rng_state * 1664525 + 1013904223
    return rng_state
}

function rng_below(n: i32) -> i32 {
    return ((rng_next() >> 13) % (n as u32)) as i32
}

function mode_name(m: i32) -> string {
    if m == 1 { return "OBLIQUE 40" }
    if m == 2 { return "POROUS" }
    return "NORMAL"
}

# Horizontal drift per row fallen.
function mode_drift(m: i32) -> f64 {
    if m == 1 { return 0.839 }
    return 0.0
}

function reset(occ: ptr<i32>, age: ptr<i32>) -> void {
    for i in 0 to CELLS {
        occ[i] = 0
        age[i] = 0
    }
    for x in 0 to GRID {
        occ[(GRID - 1) * GRID + x] = 1
        age[(GRID - 1) * GRID + x] = 1
    }
}

function solid(occ: ptr<i32>, x: i32, y: i32) -> bool {
    if y < 0 or y >= GRID { return false }
    let xx: i32 = (x + GRID) % GRID
    return occ[y * GRID + xx] == 1
}

# Does a particle at (x, y) touch the deposit?
function in_contact(occ: ptr<i32>, x: i32, y: i32, porous: bool) -> bool {
    if solid(occ, x, y + 1) { return true }
    if solid(occ, x - 1, y) { return true }
    if solid(occ, x + 1, y) { return true }
    if porous {
        if solid(occ, x - 1, y + 1) { return true }
        if solid(occ, x + 1, y + 1) { return true }
    }
    return false
}

# Drop one particle. Returns 1 if it froze inside the box.
function deposit(occ: ptr<i32>, age: ptr<i32>, stamp: i32,
                 drift: f64, porous: bool) -> i32 {
    let mut fx: f64 = rng_below(GRID) as f64
    let mut y: i32 = 0
    while y < GRID - 1 {
        let x: i32 = ((fx as i32) + GRID) % GRID
        if in_contact(occ, x, y, porous) {
            if occ[y * GRID + x] == 0 {
                occ[y * GRID + x] = 1
                age[y * GRID + x] = stamp
                return 1
            }
            return 0
        }
        fx = fx + drift
        if fx < 0.0 { fx = fx + (GRID as f64) }
        if fx >= (GRID as f64) { fx = fx - (GRID as f64) }
        y = y + 1
    }
    return 0
}

# Column heights, measured from the substrate up to the topmost deposit.
function column_top(occ: ptr<i32>, x: i32) -> i32 {
    for y in 0 to GRID {
        if occ[y * GRID + x] == 1 {
            return GRID - 1 - y
        }
    }
    return 0
}

function mean_height(occ: ptr<i32>) -> f64 {
    let mut s: f64 = 0.0
    for x in 0 to GRID {
        s = s + (column_top(occ, x) as f64)
    }
    return s / (GRID as f64)
}

function height_width(occ: ptr<i32>, mean: f64) -> f64 {
    let mut s: f64 = 0.0
    for x in 0 to GRID {
        let d: f64 = (column_top(occ, x) as f64) - mean
        s = s + d * d
    }
    return sqrt(s / (GRID as f64))
}

# Occupied fraction of the region below the mean surface.
function fill_fraction(occ: ptr<i32>) -> f64 {
    let mut filled: i32 = 0
    let mut total: i32 = 0
    for x in 0 to GRID {
        let h: i32 = column_top(occ, x)
        for k in 0 to h {
            total = total + 1
            if occ[(GRID - 1 - k) * GRID + x] == 1 { filled = filled + 1 }
        }
    }
    if total == 0 { return 0.0 }
    return (filled as f64) / (total as f64)
}

# Reef ramp: dark base, coral middles, bleached tips.
function draw_field(g: Gfx, occ: ptr<i32>, age: ptr<i32>, newest: i32) -> void {
    let mut inv: f64 = 1.0
    if newest > 1 { inv = 1.0 / (newest as f64) }
    for y in 0 to GRID {
        for x in 0 to GRID {
            let i: i32 = y * GRID + x
            let mut rr: i32 = 8
            let mut gg: i32 = 14
            let mut bb: i32 = 26
            if occ[i] == 1 {
                let t: f64 = (age[i] as f64) * inv
                let mut fr: f64 = 96.0 + 158.0 * t
                let mut fg: f64 = 34.0 + 60.0 * t + 140.0 * t * t * t
                let mut fb: f64 = 96.0 + 40.0 * t + 90.0 * t * t * t * t
                if fr > 255.0 { fr = 255.0 }
                if fg > 255.0 { fg = 255.0 }
                if fb > 255.0 { fb = 255.0 }
                rr = fr as i32
                gg = fg as i32
                bb = fb as i32
            }
            gfx_fill_rect(g, x * CELL_PX, FIELD_Y + y * CELL_PX,
                          CELL_PX, CELL_PX, rr, gg, bb)
        }
    }
}

function draw_hud(g: Gfx, mode: i32, n: i32, h: f64, w: f64, fill: f64,
                  paused: bool) -> void {
    let t1: i32 = gfx_draw_text(g, 8, 8, "CORAL  BALLISTIC DEPOSITION", 2,
                                244, 230, 236)
    let t2: i32 = gfx_draw_text(g, 8, 28, "RAIN", 1, 160, 138, 150)
    let t3: i32 = gfx_draw_text(g, 40, 28, mode_name(mode), 1, 255, 170, 160)
    let t4: i32 = gfx_draw_text(g, 116, 28, "N", 1, 160, 138, 150)
    let t5: i32 = gfx_draw_int(g, 128, 28, n, 1, 244, 230, 236)
    let t6: i32 = gfx_draw_text(g, 180, 28, "H", 1, 160, 138, 150)
    let t7: i32 = gfx_draw_fixed(g, 192, 28, h, 1, 1, 244, 230, 236)
    let t8: i32 = gfx_draw_text(g, 234, 28, "W", 1, 160, 138, 150)
    let t9: i32 = gfx_draw_fixed(g, 246, 28, w, 2, 1, 255, 210, 150)
    let ta: i32 = gfx_draw_text(g, 294, 28, "FILL", 1, 160, 138, 150)
    let tb: i32 = gfx_draw_fixed(g, 326, 28, fill, 3, 1, 244, 230, 236)
    let tc: i32 = gfx_draw_text(g, 8, 42,
        "1 NORMAL  2 OBLIQUE  3 POROUS  R RESTART  P PAUSE",
        1, 118, 100, 110)
    if paused {
        let td: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let te: i32 = gfx_draw_text(g, 8, 572,
        "stick on first contact, never relax: tall columns shadow short ones",
        1, 130, 112, 124)
    let tf: i32 = gfx_draw_text(g, 8, 582,
        "FILL below the surface stays well under 1, so the deposit is porous",
        1, 130, 112, 124)
}

function main() -> i32 {
    let occ: array<i32, 16384> = [0, 0, 0, 0]
    let age: array<i32, 16384> = [0, 0, 0, 0]

    let mut mode: i32 = 0
    reset(occ, age)

    let g: Gfx = gfx_open(WIN_W, WIN_H, "Coral - Flow morphogenesis")

    let mut n: i32 = 1
    let mut h: f64 = 0.0
    let mut w: f64 = 0.0
    let mut fill: f64 = 0.0
    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut reset_held: bool = false
    let mut hold: i32 = 0
    let mut frame: i32 = 0

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(g) { break }

        let mut want: i32 = -1
        if gfx_key_down(g, KEY_1) { want = 0 }
        if gfx_key_down(g, KEY_2) { want = 1 }
        if gfx_key_down(g, KEY_3) { want = 2 }
        if want >= 0 and want != mode {
            mode = want
            reset(occ, age)
            n = 1
            hold = 0
        }

        if gfx_key_down(g, KEY_R) {
            if !reset_held {
                reset(occ, age)
                n = 1
                hold = 0
            }
            reset_held = true
        } else {
            reset_held = false
        }

        if gfx_key_down(g, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        let full: bool = h > 104.0
        if full {
            hold = hold + 1
            if hold > 120 {
                reset(occ, age)
                n = 1
                hold = 0
            }
        }

        if !paused and !full {
            let drift: f64 = mode_drift(mode)
            let porous: bool = mode == 2
            for k in 0 to PER_FRAME {
                n = n + deposit(occ, age, n + 1, drift, porous)
            }
            h = mean_height(occ)
            w = height_width(occ, h)
            fill = fill_fraction(occ)
        }

        gfx_clear(g, 8, 12, 22)
        draw_field(g, occ, age, n)
        draw_hud(g, mode, n, h, w, fill, paused)
        gfx_present(g)
        frame = frame + 1
    }

    gfx_close(g)
    return 0
}
