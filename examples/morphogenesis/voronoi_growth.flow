# VORONOI GROWTH: Johnson-Mehl nucleation, and the Avrami exponent.
#
# MODEL (Kolmogorov 1937; Johnson and Mehl 1939; Avrami 1939-41)
#   Nuclei appear on a periodic lattice and grow as circular fronts at
#   constant speed G. A site crystallises at the earliest arrival time
#
#       t_arrive(x) = min over nuclei i of  t_i + |x - x_i| / G
#
#   which is exactly a distance transform of the nucleation events. The
#   transformed field is the Voronoi diagram of the nuclei when every
#   t_i is zero (site saturation), and a Johnson-Mehl tessellation when
#   nuclei keep appearing in the untransformed region (continuous
#   nucleation).
#
#   The transformed fraction X(t) obeys the Avrami relation
#
#       X(t) = 1 - exp(-k t^n)
#
#   so a plot of ln(-ln(1 - X)) against ln t is a straight line of slope
#   n. In two dimensions, site saturation gives n = 2 and continuous
#   nucleation gives n = 3. The program fits that line over the middle of
#   the transformation and gates both the slope and the straightness.
#
# WHAT IS MEASURED
#   Arrival times from an eight-pass periodic chamfer distance transform
#   (weights 1 and sqrt(2), in units of G). Sorted arrival times give X(t)
#   by counting; the Avrami fit uses forty logarithmically spaced samples
#   between the 5th and 70th percentiles of arrival. Gates:
#     site-saturated, N = 32 nuclei at t = 0: n in [1.70, 2.30], R^2 > 0.99
#     continuous nucleation to about 40 nuclei: n in [2.30, 3.20], R^2 > 0.99
#
# NUMERICS
#   128 x 128 periodic grid, G = 1. Headless verification builds the full
#   arrival field once per regime. The live view advances a time cursor
#   across the same field so the fronts can be watched.
#
# REFERENCE
#   M. Avrami, "Kinetics of phase change. I", J. Chem. Phys. 7:1103 (1939).
#   W. A. Johnson and R. F. Mehl, "Reaction kinetics in processes of
#   nucleation and growth", Trans. AIME 135:416 (1939).
#
# LIVE VIEW / KEYS
#   1 SITE-SAT    32 nuclei at t = 0, classical Voronoi cells
#   2 CONTINUOUS  nuclei keep appearing in free space
#   3 FEW         12 site-saturated nuclei, large grains
#   4 MANY        64 site-saturated nuclei, fine grains
#   R reseed      P pause      Esc quit
#
# Run: ./flow gfx examples/morphogenesis/voronoi_growth.flow

import "stdlib/gfx.flow"
import "stdlib/text.flow"

extern {
    function printf(fmt: string, val: f64) -> i32
    function calloc(n: i64, size: i64) -> ptr<void>
    function log(x: f64) -> f64
    function exp(x: f64) -> f64
    function fabs(x: f64) -> f64
    function sqrt(x: f64) -> f64
}

const GRID: i32 = 128
const CELLS: i32 = 16384
const CELL_PX: i32 = 4
const FIELD_Y: i32 = 58
const FB_W: i32 = 512
const FB_H: i32 = 512
const WIN_W: i32 = 512
const WIN_H: i32 = 592
const MAX_FRAMES: i32 = 6000
const MAX_NUC: i32 = 96
const INF: f64 = 1.0e30
const SQ2: f64 = 1.4142135623730951
const GSPEED: f64 = 1.0
const NSAMP: i32 = 40
const CHAMFER_ITERS: i32 = 8

const N_SITE: i32 = 32
const N_FEW: i32 = 12
const N_MANY: i32 = 64
const N_CONT: i32 = 40
const CONT_DT: f64 = 0.15

const SITE_N_LO: f64 = 1.70
const SITE_N_HI: f64 = 2.30
const CONT_N_LO: f64 = 2.30
const CONT_N_HI: f64 = 3.20
const R2_MIN: f64 = 0.99

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20
const KEY_4: i32 = 21

let mut rng_state: u32 = 1901194261

let mut arr: ptr<f64> = null
let mut own: ptr<i32> = null
let mut sorted: ptr<f64> = null
let mut nuc_x: ptr<i32> = null
let mut nuc_y: ptr<i32> = null
let mut nuc_t: ptr<f64> = null
let mut fb: ptr<u8> = null
let mut nnuc: i32 = 0

let mut fit_n: f64 = 0.0
let mut fit_r2: f64 = 0.0
let mut fit_k: f64 = 0.0

function rng_next() -> u32 {
    rng_state = rng_state * 1664525 + 1013904223
    return rng_state
}

function rng_unit() -> f64 {
    let bits: i32 = ((rng_next() >> 9) % 65536) as i32
    return (bits as f64) / 65536.0
}

function rng_below(n: i32) -> i32 {
    return ((rng_next() >> 11) % (n as u32)) as i32
}

function preset_name(p: i32) -> string {
    if p == 1 { return "CONTINUOUS" }
    if p == 2 { return "FEW" }
    if p == 3 { return "MANY" }
    return "SITE-SAT"
}

function clear_field() -> void {
    for i in 0 to CELLS {
        arr[i] = INF
        own[i] = -1
    }
}

function seed_site_sat(n: i32, seed: u32) -> void {
    rng_state = seed
    nnuc = 0
    clear_field()
    for k in 0 to n {
        let x: i32 = rng_below(GRID)
        let y: i32 = rng_below(GRID)
        nuc_x[nnuc] = x
        nuc_y[nnuc] = y
        nuc_t[nnuc] = 0.0
        let i: i32 = y * GRID + x
        if 0.0 < arr[i] {
            arr[i] = 0.0
            own[i] = nnuc
        }
        nnuc = nnuc + 1
    }
}

function seed_continuous(nmax: i32, seed: u32) -> void {
    rng_state = seed
    nnuc = 0
    clear_field()
    let mut t: f64 = 0.0
    for k in 0 to nmax * 8 {
        if nnuc >= nmax { break }
        t = t + CONT_DT
        let x: i32 = rng_below(GRID)
        let y: i32 = rng_below(GRID)
        let mut covered: bool = false
        for i in 0 to nnuc {
            let mut dx: i32 = x - nuc_x[i]
            if dx < 0 { dx = 0 - dx }
            let mut dy: i32 = y - nuc_y[i]
            if dy < 0 { dy = 0 - dy }
            if dx > GRID - dx { dx = GRID - dx }
            if dy > GRID - dy { dy = GRID - dy }
            let dist: f64 = sqrt((dx * dx + dy * dy) as f64)
            if nuc_t[i] + dist / GSPEED <= t {
                covered = true
            }
        }
        if !covered {
            nuc_x[nnuc] = x
            nuc_y[nnuc] = y
            nuc_t[nnuc] = t
            let idx: i32 = y * GRID + x
            if t < arr[idx] {
                arr[idx] = t
                own[idx] = nnuc
            }
            nnuc = nnuc + 1
        }
    }
}

function chamfer() -> void {
    let w1: f64 = 1.0 / GSPEED
    let w2: f64 = SQ2 / GSPEED
    for it in 0 to CHAMFER_ITERS {
        let mut changed: i32 = 0
        for y in 0 to GRID {
            let ym: i32 = (y + GRID - 1) % GRID
            for x in 0 to GRID {
                let xm: i32 = (x + GRID - 1) % GRID
                let xp: i32 = (x + 1) % GRID
                let i: i32 = y * GRID + x
                let mut best: f64 = arr[i]
                let mut bo: i32 = own[i]
                let c0: f64 = arr[ym * GRID + xm] + w2
                if c0 < best { best = c0; bo = own[ym * GRID + xm] }
                let c1: f64 = arr[ym * GRID + x] + w1
                if c1 < best { best = c1; bo = own[ym * GRID + x] }
                let c2: f64 = arr[ym * GRID + xp] + w2
                if c2 < best { best = c2; bo = own[ym * GRID + xp] }
                let c3: f64 = arr[y * GRID + xm] + w1
                if c3 < best { best = c3; bo = own[y * GRID + xm] }
                if best < arr[i] {
                    arr[i] = best
                    own[i] = bo
                    changed = changed + 1
                }
            }
        }
        for y in 0 to GRID {
            let yy: i32 = GRID - 1 - y
            let yp: i32 = (yy + 1) % GRID
            for x in 0 to GRID {
                let xx: i32 = GRID - 1 - x
                let xm: i32 = (xx + GRID - 1) % GRID
                let xp: i32 = (xx + 1) % GRID
                let i: i32 = yy * GRID + xx
                let mut best: f64 = arr[i]
                let mut bo: i32 = own[i]
                let c0: f64 = arr[yp * GRID + xp] + w2
                if c0 < best { best = c0; bo = own[yp * GRID + xp] }
                let c1: f64 = arr[yp * GRID + xx] + w1
                if c1 < best { best = c1; bo = own[yp * GRID + xx] }
                let c2: f64 = arr[yp * GRID + xm] + w2
                if c2 < best { best = c2; bo = own[yp * GRID + xm] }
                let c3: f64 = arr[yy * GRID + xp] + w1
                if c3 < best { best = c3; bo = own[yy * GRID + xp] }
                if best < arr[i] {
                    arr[i] = best
                    own[i] = bo
                    changed = changed + 1
                }
            }
        }
        if changed == 0 { break }
    }
}

# In-place heapsort of the arrival times into `sorted`.
function sort_arrivals() -> void {
    for i in 0 to CELLS {
        sorted[i] = arr[i]
    }
    let mut n: i32 = CELLS
    let mut start: i32 = n / 2 - 1
    while start >= 0 {
        let mut root: i32 = start
        while true {
            let mut child: i32 = 2 * root + 1
            if child >= n { break }
            if child + 1 < n {
                if sorted[child] < sorted[child + 1] { child = child + 1 }
            }
            if sorted[root] < sorted[child] {
                let tmp: f64 = sorted[root]
                sorted[root] = sorted[child]
                sorted[child] = tmp
                root = child
            } else {
                break
            }
        }
        start = start - 1
    }
    let mut end: i32 = n - 1
    while end > 0 {
        let tmp: f64 = sorted[0]
        sorted[0] = sorted[end]
        sorted[end] = tmp
        end = end - 1
        let mut root: i32 = 0
        while true {
            let mut child: i32 = 2 * root + 1
            if child > end { break }
            if child + 1 <= end {
                if sorted[child] < sorted[child + 1] { child = child + 1 }
            }
            if sorted[root] < sorted[child] {
                let sw: f64 = sorted[root]
                sorted[root] = sorted[child]
                sorted[child] = sw
                root = child
            } else {
                break
            }
        }
    }
}

function fraction_at(t: f64) -> f64 {
    # binary search on sorted arrivals
    let mut lo: i32 = 0
    let mut hi: i32 = CELLS
    while lo < hi {
        let mid: i32 = (lo + hi) / 2
        if sorted[mid] <= t {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return (lo as f64) / (CELLS as f64)
}

function fit_avrami() -> void {
    sort_arrivals()
    let mut tlo: f64 = sorted[(CELLS as f64 * 0.05) as i32]
    let mut thi: f64 = sorted[(CELLS as f64 * 0.70) as i32]
    if tlo < 1.0e-9 { tlo = sorted[1] }
    if thi <= tlo { thi = tlo * 2.0 }

    let mut sx: f64 = 0.0
    let mut sy: f64 = 0.0
    let mut sxx: f64 = 0.0
    let mut sxy: f64 = 0.0
    let mut npts: i32 = 0
    let mut xs: array<f64, 40> = [0.0, 0.0, 0.0, 0.0]
    let mut ys: array<f64, 40> = [0.0, 0.0, 0.0, 0.0]

    for k in 0 to NSAMP {
        let u: f64 = (k as f64) / ((NSAMP - 1) as f64)
        let t: f64 = exp(log(tlo) + u * (log(thi) - log(tlo)))
        let x: f64 = fraction_at(t)
        if x > 0.001 and x < 0.999 {
            let lx: f64 = log(t)
            let ly: f64 = log(0.0 - log(1.0 - x))
            xs[npts] = lx
            ys[npts] = ly
            sx = sx + lx
            sy = sy + ly
            sxx = sxx + lx * lx
            sxy = sxy + lx * ly
            npts = npts + 1
        }
    }

    fit_n = 0.0
    fit_r2 = 0.0
    fit_k = 0.0
    if npts < 8 { return }

    let nf: f64 = npts as f64
    let den: f64 = nf * sxx - sx * sx
    if fabs(den) < 1.0e-18 { return }
    let slope: f64 = (nf * sxy - sx * sy) / den
    let intercept: f64 = (sy - slope * sx) / nf
    let ymean: f64 = sy / nf
    let mut ss_res: f64 = 0.0
    let mut ss_tot: f64 = 0.0
    for i in 0 to npts {
        let pred: f64 = slope * xs[i] + intercept
        let e: f64 = ys[i] - pred
        ss_res = ss_res + e * e
        let d: f64 = ys[i] - ymean
        ss_tot = ss_tot + d * d
    }
    fit_n = slope
    fit_k = exp(intercept)
    if ss_tot > 0.0 {
        fit_r2 = 1.0 - ss_res / ss_tot
    }
}

function run_regime(kind: i32, n: i32, seed: u32) -> void {
    if kind == 1 {
        seed_continuous(n, seed)
    } else {
        seed_site_sat(n, seed)
    }
    chamfer()
    fit_avrami()
}

function paint_cell(buf: ptr<u8>, x: i32, y: i32, r: i32, g2: i32, b: i32) -> void {
    let px: i32 = x * CELL_PX
    let py: i32 = y * CELL_PX
    for dy in 0 to CELL_PX {
        let mut o: i32 = ((py + dy) * FB_W + px) * 3
        for dx in 0 to CELL_PX {
            buf[o] = r as u8
            buf[o + 1] = g2 as u8
            buf[o + 2] = b as u8
            o = o + 3
        }
    }
}

function hue_r(h: f64) -> i32 {
    let t: f64 = h * 6.0
    if t < 1.0 { return 220 }
    if t < 2.0 { return (220.0 - 140.0 * (t - 1.0)) as i32 }
    if t < 4.0 { return 80 }
    if t < 5.0 { return (80.0 + 140.0 * (t - 4.0)) as i32 }
    return 220
}

function hue_g(h: f64) -> i32 {
    let t: f64 = h * 6.0
    if t < 1.0 { return (80.0 + 140.0 * t) as i32 }
    if t < 3.0 { return 220 }
    if t < 4.0 { return (220.0 - 140.0 * (t - 3.0)) as i32 }
    return 80
}

function hue_b(h: f64) -> i32 {
    let t: f64 = h * 6.0
    if t < 2.0 { return 80 }
    if t < 3.0 { return (80.0 + 140.0 * (t - 2.0)) as i32 }
    if t < 5.0 { return 220 }
    return (220.0 - 140.0 * (t - 5.0)) as i32
}

function draw_field(g: Gfx, tnow: f64) -> void {
    for y in 0 to GRID {
        for x in 0 to GRID {
            let i: i32 = y * GRID + x
            let ta: f64 = arr[i]
            if ta > tnow {
                paint_cell(fb, x, y, 16, 14, 22)
            } else {
                let id: i32 = own[i]
                let mut h: f64 = 0.0
                if id >= 0 {
                    h = ((id * 47) % 256) as f64 / 256.0
                }
                let age: f64 = tnow - ta
                let mut bright: f64 = 0.55 + 0.45 * (1.0 - exp(0.0 - age * 0.08))
                if age < 1.2 { bright = 1.0 }
                let rr: i32 = (hue_r(h) as f64 * bright) as i32
                let gg: i32 = (hue_g(h) as f64 * bright) as i32
                let bb: i32 = (hue_b(h) as f64 * bright) as i32
                paint_cell(fb, x, y, rr, gg, bb)
            }
        }
    }
    gfx_blit_rgb(g, 0, FIELD_Y, FB_W, FB_H, fb)
}

function draw_hud(g: Gfx, preset: i32, tnow: f64, xfrac: f64, nexp: f64,
                  r2: f64, paused: bool) -> void {
    let t1: i32 = gfx_draw_text(g, 8, 8, "VORONOI GROWTH  JOHNSON-MEHL", 2,
                                236, 232, 244)
    let t2: i32 = gfx_draw_text(g, 8, 28, "MODE", 1, 150, 146, 168)
    let t3: i32 = gfx_draw_text(g, 42, 28, preset_name(preset), 1, 255, 196, 110)
    let t4: i32 = gfx_draw_text(g, 140, 28, "NUCLEI", 1, 150, 146, 168)
    let t5: i32 = gfx_draw_int(g, 184, 28, nnuc, 1, 236, 232, 244)
    let t6: i32 = gfx_draw_text(g, 230, 28, "t", 1, 150, 146, 168)
    let t7: i32 = gfx_draw_fixed(g, 244, 28, tnow, 1, 1, 236, 232, 244)
    let t8: i32 = gfx_draw_text(g, 300, 28, "X(t)", 1, 150, 146, 168)
    let t9: i32 = gfx_draw_fixed(g, 330, 28, xfrac, 3, 1, 130, 255, 190)
    let ta: i32 = gfx_draw_text(g, 390, 28, "n", 1, 150, 146, 168)
    let tb: i32 = gfx_draw_fixed(g, 404, 28, nexp, 2, 1, 130, 255, 190)
    let tc: i32 = gfx_draw_text(g, 450, 28, "R2", 1, 150, 146, 168)
    let td: i32 = gfx_draw_fixed(g, 470, 28, r2, 3, 1, 130, 255, 190)

    let te: i32 = gfx_draw_text(g, 8, 42,
        "1 SITE-SAT  2 CONTINUOUS  3 FEW  4 MANY  R RESEED  P PAUSE",
        1, 112, 108, 132)
    if paused {
        let tf: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let tg: i32 = gfx_draw_text(g, 8, 572,
        "t_arrive = min_i (t_i + |x - x_i| / G); X = 1 - exp(-k t^n)",
        1, 122, 118, 144)
    let th: i32 = gfx_draw_text(g, 8, 582,
        "site saturation n = 2 in 2D; continuous nucleation n = 3",
        1, 122, 118, 144)
}

function main() -> i32 {
    arr = calloc(CELLS as i64, 8 as i64)
    own = calloc(CELLS as i64, 4 as i64)
    sorted = calloc(CELLS as i64, 8 as i64)
    nuc_x = calloc(MAX_NUC as i64, 4 as i64)
    nuc_y = calloc(MAX_NUC as i64, 4 as i64)
    nuc_t = calloc(MAX_NUC as i64, 8 as i64)
    fb = calloc(786432 as i64, 1 as i64)

    println("")
    println("  VORONOI GROWTH  --  Johnson-Mehl fronts, Avrami exponent")
    println("  =========================================================")
    println("")
    println("    Kolmogorov / Johnson-Mehl / Avrami. Circular fronts at speed G")
    println("    on a 128 x 128 periodic lattice; arrival times by chamfer DT.")
    println("")

    run_regime(0, N_SITE, 1901194261)
    let n_site: f64 = fit_n
    let r2_site: f64 = fit_r2
    let nuc_site: i32 = nnuc

    println("  1. SITE SATURATION  (all nuclei at t = 0)")
    println("")
    print("     nuclei                        : ")
    printf("%10.0f", nuc_site as f64)
    println("")
    print("     Avrami exponent n             : ")
    printf("%10.4f", n_site)
    print("     gate [")
    printf("%.2f", SITE_N_LO)
    print(", ")
    printf("%.2f", SITE_N_HI)
    println("], theory 2")
    print("     R^2 of the Avrami line        : ")
    printf("%10.6f", r2_site)
    print("     gate > ")
    printf("%.2f", R2_MIN)
    println("")
    println("")

    run_regime(1, N_CONT, 1901194261)
    let n_cont: f64 = fit_n
    let r2_cont: f64 = fit_r2
    let nuc_cont: i32 = nnuc

    println("  2. CONTINUOUS NUCLEATION  (nuclei appear in free space)")
    println("")
    print("     nuclei accepted               : ")
    printf("%10.0f", nuc_cont as f64)
    println("")
    print("     Avrami exponent n             : ")
    printf("%10.4f", n_cont)
    print("     gate [")
    printf("%.2f", CONT_N_LO)
    print(", ")
    printf("%.2f", CONT_N_HI)
    println("], theory 3")
    print("     R^2 of the Avrami line        : ")
    printf("%10.6f", r2_cont)
    print("     gate > ")
    printf("%.2f", R2_MIN)
    println("")
    println("")

    if n_site != n_site or n_cont != n_cont or r2_site != r2_site {
        println("    FAIL: a measured quantity is NaN")
        return 1
    }
    if n_site < SITE_N_LO or n_site > SITE_N_HI {
        println("    FAIL: site-saturated Avrami exponent is not near 2")
        return 2
    }
    if r2_site < R2_MIN {
        println("    FAIL: site-saturated Avrami fit is not a straight line")
        return 3
    }
    if n_cont < CONT_N_LO or n_cont > CONT_N_HI {
        println("    FAIL: continuous-nucleation Avrami exponent is not near 3")
        return 4
    }
    if r2_cont < R2_MIN {
        println("    FAIL: continuous-nucleation Avrami fit is not a straight line")
        return 5
    }
    if n_cont <= n_site {
        println("    FAIL: continuous nucleation did not raise the Avrami exponent")
        return 6
    }
    println("    PASS: site saturation gives n near 2, continuous nucleation")
    println("          gives n near 3, and both Avrami lines are straight")
    println("")

    let mut preset: i32 = 0
    run_regime(0, N_SITE, 1901194261)
    let mut t_end: f64 = sorted[CELLS - 1]
    let mut tnow: f64 = 0.0
    let mut nexp: f64 = fit_n
    let mut r2: f64 = fit_r2

    let g: Gfx = gfx_open(WIN_W, WIN_H, "Voronoi growth - Flow morphogenesis")

    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut reseed_held: bool = false
    let mut frame: i32 = 0

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(g) { break }

        let mut want: i32 = -1
        if gfx_key_down(g, KEY_1) { want = 0 }
        if gfx_key_down(g, KEY_2) { want = 1 }
        if gfx_key_down(g, KEY_3) { want = 2 }
        if gfx_key_down(g, KEY_4) { want = 3 }
        if want >= 0 and want != preset {
            preset = want
            if preset == 0 { run_regime(0, N_SITE, 1901194261) }
            if preset == 1 { run_regime(1, N_CONT, 1901194261) }
            if preset == 2 { run_regime(0, N_FEW, 1901194261) }
            if preset == 3 { run_regime(0, N_MANY, 1901194261) }
            t_end = sorted[CELLS - 1]
            tnow = 0.0
            nexp = fit_n
            r2 = fit_r2
        }

        if gfx_key_down(g, KEY_R) {
            if !reseed_held {
                let seed: u32 = rng_next()
                if preset == 0 { run_regime(0, N_SITE, seed) }
                if preset == 1 { run_regime(1, N_CONT, seed) }
                if preset == 2 { run_regime(0, N_FEW, seed) }
                if preset == 3 { run_regime(0, N_MANY, seed) }
                t_end = sorted[CELLS - 1]
                tnow = 0.0
                nexp = fit_n
                r2 = fit_r2
            }
            reseed_held = true
        } else {
            reseed_held = false
        }

        if gfx_key_down(g, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        if !paused {
            tnow = tnow + t_end / 180.0
            if tnow > t_end * 1.05 { tnow = 0.0 }
        }

        let xfrac: f64 = fraction_at(tnow)
        gfx_clear(g, 12, 10, 18)
        draw_field(g, tnow)
        draw_hud(g, preset, tnow, xfrac, nexp, r2, paused)
        gfx_present(g)
        frame = frame + 1
    }

    gfx_close(g)
    return 0
}
