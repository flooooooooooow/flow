# RIVER EROSION: drainage networks from the stream-power law.
#
# MODEL (Howard 1994; Whipple and Tucker 1999)
#   A height field h on a periodic-x, open-bottom lattice evolves by
#
#       dh/dt = U - K * A^m * S^n
#
#   with a small hillslope diffusion D lap(h). A is the upstream
#   contributing area of each cell (D8 steepest-descent routing), and S is
#   the local slope along that link. U is uniform uplift. The lattice
#   drains through the open bottom edge.
#
# WHAT IS MEASURED
#   Hack's law: main-stem length L against drainage area A as L ~ A^h.
#   For each basin draining to the bottom edge the program records the
#   longest channel length and the basin area, then fits log L against
#   log A. Gates:
#     Hack exponent h in [0.45, 0.70] (theory near 0.5 to 0.6)
#     R^2 of the fit above 0.75
#     mean drainage density (channel cells / total) in (0.05, 0.60)
#
# NUMERICS
#   96 x 96 lattice, m = 0.5, n = 1.0, K = 0.1, U = 0.01, D = 0.002.
#   Headless: 400 uplift/erode steps from smooth noise, then measure.
#
# REFERENCE
#   A. D. Howard, "A detachment-limited model of drainage basin evolution",
#   Water Resour. Res. 30:2261-2285 (1994).
#   J. T. Hack, "Studies of longitudinal stream profiles in Virginia and
#   Maryland", USGS Prof. Paper 294-B (1957).
#
# LIVE VIEW / KEYS
#   1 STREAM    m = 0.5, n = 1.0, classic Hack
#   2 STEEP     m = 0.3, n = 0.7
#   3 DIFFUSE   larger D, rounded divides
#   4 FAST      larger K, deeper channels
#   R reseed    P pause    Esc quit
#
# Run: ./flow gfx examples/morphogenesis/river_erosion.flow

import "stdlib/gfx.flow"
import "stdlib/text.flow"

extern {
    function printf(fmt: string, val: f64) -> i32
    function calloc(n: i64, size: i64) -> ptr<void>
    function log(x: f64) -> f64
    function fabs(x: f64) -> f64
    function sqrt(x: f64) -> f64
    function pow(x: f64, y: f64) -> f64
}

const GRID: i32 = 96
const CELLS: i32 = 9216
const CELL_PX: i32 = 5
const FIELD_Y: i32 = 58
const FB_W: i32 = 480
const FB_H: i32 = 480
const WIN_W: i32 = 512
const WIN_H: i32 = 592
const MAX_FRAMES: i32 = 6000
const VERIFY_STEPS: i32 = 400
const STEPS_PER_FRAME: i32 = 2

const HACK_LO: f64 = 0.45
const HACK_HI: f64 = 0.70
const R2_MIN: f64 = 0.75
const DENS_LO: f64 = 0.05
const DENS_HI: f64 = 0.60

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20
const KEY_4: i32 = 21

let mut rng_state: u32 = 1901194261
let mut h: ptr<f64> = null
let mut area: ptr<f64> = null
let mut receiver: ptr<i32> = null
let mut order: ptr<i32> = null
let mut channel: ptr<i32> = null
let mut fb: ptr<u8> = null

let mut fit_h: f64 = 0.0
let mut fit_r2: f64 = 0.0
let mut dens: f64 = 0.0

function rng_next() -> u32 {
    rng_state = rng_state * 1664525 + 1013904223
    return rng_state
}

function rng_unit() -> f64 {
    let bits: i32 = ((rng_next() >> 9) % 65536) as i32
    return (bits as f64) / 65536.0
}

function preset_name(p: i32) -> string {
    if p == 1 { return "STEEP" }
    if p == 2 { return "DIFFUSE" }
    if p == 3 { return "FAST" }
    return "STREAM"
}

function preset_m(p: i32) -> f64 {
    if p == 1 { return 0.3 }
    return 0.5
}

function preset_n(p: i32) -> f64 {
    if p == 1 { return 0.7 }
    return 1.0
}

function preset_k(p: i32) -> f64 {
    if p == 3 { return 0.25 }
    return 0.10
}

function preset_d(p: i32) -> f64 {
    if p == 2 { return 0.02 }
    return 0.002
}

function seed_height(seed: u32) -> void {
    rng_state = seed
    for y in 0 to GRID {
        for x in 0 to GRID {
            let i: i32 = y * GRID + x
            # gentle southward tilt plus noise
            h[i] = 1.2 * (1.0 - (y as f64) / (GRID as f64)) + 0.08 * rng_unit()
        }
    }
}

function d8_route() -> void {
    for i in 0 to CELLS {
        area[i] = 1.0
        receiver[i] = i
        channel[i] = 0
    }
    for y in 0 to GRID {
        for x in 0 to GRID {
            let i: i32 = y * GRID + x
            if y == GRID - 1 {
                receiver[i] = i
            } else {
                let mut best_s: f64 = -1.0
                let mut best: i32 = i
                for dy in 0 to 2 {
                    for dx in 0 to 3 {
                        let nx: i32 = x + dx - 1
                        let ny: i32 = y + dy
                        if dy == 0 and dx == 1 { continue }
                        if nx < 0 or nx >= GRID { continue }
                        if ny < 0 or ny >= GRID { continue }
                        let j: i32 = ny * GRID + nx
                        let mut dist: f64 = 1.0
                        if dx != 1 and dy == 1 { dist = 1.41421356237 }
                        if dy == 0 { dist = 1.0 }
                        let drop: f64 = h[i] - h[j]
                        if drop > 0.0 {
                            let s: f64 = drop / dist
                            if s > best_s {
                                best_s = s
                                best = j
                            }
                        }
                    }
                }
                receiver[i] = best
            }
        }
    }

    # topological accumulate: many passes southward
    for pass in 0 to GRID + 2 {
        for y in 0 to GRID - 1 {
            for x in 0 to GRID {
                let i: i32 = y * GRID + x
                let r: i32 = receiver[i]
                if r != i {
                    area[r] = area[r] + 1.0
                }
            }
        }
        # reset donors contribution by recomputing from unity each full rebuild
        if pass < GRID + 1 {
            for i in 0 to CELLS {
                area[i] = 1.0
            }
            for y in 0 to GRID {
                for x in 0 to GRID {
                    let mut cur: i32 = y * GRID + x
                    let budget: i32 = GRID * 2
                    for k in 0 to budget {
                        let r: i32 = receiver[cur]
                        if r == cur { break }
                        area[r] = area[r] + 1.0
                        cur = r
                    }
                }
            }
            break
        }
    }
}

function erode_step(m: f64, nexp: f64, k: f64, u: f64, dcoef: f64) -> void {
    d8_route()
    let mut nh: array<f64, 9216> = [0.0, 0.0, 0.0, 0.0]
    for y in 0 to GRID {
        for x in 0 to GRID {
            let i: i32 = y * GRID + x
            let r: i32 = receiver[i]
            let mut s: f64 = 0.0
            if r != i {
                let rx: i32 = r % GRID
                let ry: i32 = r / GRID
                let mut dx: f64 = (rx - x) as f64
                let mut dy: f64 = (ry - y) as f64
                let dist: f64 = sqrt(dx * dx + dy * dy)
                if dist < 1.0e-9 { dist = 1.0 }
                s = (h[i] - h[r]) / dist
                if s < 0.0 { s = 0.0 }
            }
            let a: f64 = area[i]
            let erosion: f64 = k * pow(a, m) * pow(s, nexp)

            # hillslope laplacian (neumann-ish)
            let xm: i32 = x - 1
            let xp: i32 = x + 1
            let ym: i32 = y - 1
            let yp: i32 = y + 1
            let mut lap: f64 = 0.0
            let mut c: f64 = 0.0
            if xm >= 0 { lap = lap + h[y * GRID + xm]; c = c + 1.0 }
            if xp < GRID { lap = lap + h[y * GRID + xp]; c = c + 1.0 }
            if ym >= 0 { lap = lap + h[ym * GRID + x]; c = c + 1.0 }
            if yp < GRID { lap = lap + h[yp * GRID + x]; c = c + 1.0 }
            lap = lap - c * h[i]

            let mut hnew: f64 = h[i] + u - erosion + dcoef * lap
            if y == GRID - 1 { hnew = 0.0 }
            if hnew < 0.0 { hnew = 0.0 }
            nh[i] = hnew
        }
    }
    for i in 0 to CELLS {
        h[i] = nh[i]
    }
}

function mark_channels(thresh: f64) -> void {
    let mut nch: i32 = 0
    for i in 0 to CELLS {
        if area[i] >= thresh {
            channel[i] = 1
            nch = nch + 1
        } else {
            channel[i] = 0
        }
    }
    dens = (nch as f64) / (CELLS as f64)
}

function fit_hack() -> void {
    # For each bottom-edge outlet, walk upstream along the steepest donor
    # chain approximating the main stem: pick the neighbour that drains
    # here with largest area, repeatedly.
    let mut sx: f64 = 0.0
    let mut sy: f64 = 0.0
    let mut sxx: f64 = 0.0
    let mut sxy: f64 = 0.0
    let mut npts: i32 = 0
    let mut xs: array<f64, 96> = [0.0, 0.0, 0.0, 0.0]
    let mut ys: array<f64, 96> = [0.0, 0.0, 0.0, 0.0]

    for xout in 0 to GRID {
        let out: i32 = (GRID - 1) * GRID + xout
        if area[out] < 30.0 { continue }

        # basin area is area[out]; main stem length by climbing donors
        let mut len: f64 = 0.0
        let mut cur: i32 = out
        let budget: i32 = GRID * 2
        for k in 0 to budget {
            let cx: i32 = cur % GRID
            let cy: i32 = cur / GRID
            let mut best_a: f64 = -1.0
            let mut best: i32 = cur
            for dy in 0 - 1 to 2 {
                for dx in 0 - 1 to 2 {
                    if dx == 0 and dy == 0 { continue }
                    let nx: i32 = cx + dx
                    let ny: i32 = cy + dy
                    if nx < 0 or nx >= GRID or ny < 0 or ny >= GRID { continue }
                    let j: i32 = ny * GRID + nx
                    if receiver[j] == cur {
                        if area[j] > best_a {
                            best_a = area[j]
                            best = j
                        }
                    }
                }
            }
            if best == cur { break }
            len = len + 1.0
            cur = best
        }

        if len >= 4.0 {
            let lx: f64 = log(area[out])
            let ly: f64 = log(len)
            xs[npts] = lx
            ys[npts] = ly
            sx = sx + lx
            sy = sy + ly
            sxx = sxx + lx * lx
            sxy = sxy + lx * ly
            npts = npts + 1
        }
    }

    fit_h = 0.0
    fit_r2 = 0.0
    if npts < 5 { return }
    let nf: f64 = npts as f64
    let den: f64 = nf * sxx - sx * sx
    if fabs(den) < 1.0e-18 { return }
    let slope: f64 = (nf * sxy - sx * sy) / den
    let intercept: f64 = (sy - slope * sx) / nf
    let ymean: f64 = sy / nf
    let mut ss_res: f64 = 0.0
    let mut ss_tot: f64 = 0.0
    for i in 0 to npts {
        let pred: f64 = slope * xs[i] + intercept
        let e: f64 = ys[i] - pred
        ss_res = ss_res + e * e
        let d: f64 = ys[i] - ymean
        ss_tot = ss_tot + d * d
    }
    fit_h = slope
    if ss_tot > 0.0 {
        fit_r2 = 1.0 - ss_res / ss_tot
    }
}

function paint_cell(buf: ptr<u8>, x: i32, y: i32, r: i32, g2: i32, b: i32) -> void {
    let px: i32 = x * CELL_PX
    let py: i32 = y * CELL_PX
    for dy in 0 to CELL_PX {
        let mut o: i32 = ((py + dy) * FB_W + px) * 3
        for dx in 0 to CELL_PX {
            buf[o] = r as u8
            buf[o + 1] = g2 as u8
            buf[o + 2] = b as u8
            o = o + 3
        }
    }
}

function draw_field(g: Gfx) -> void {
    let mut hmin: f64 = 1.0e9
    let mut hmax: f64 = -1.0e9
    for i in 0 to CELLS {
        if h[i] < hmin { hmin = h[i] }
        if h[i] > hmax { hmax = h[i] }
    }
    let span: f64 = hmax - hmin
    if span < 1.0e-6 { span = 1.0 }
    for y in 0 to GRID {
        for x in 0 to GRID {
            let i: i32 = y * GRID + x
            let t: f64 = (h[i] - hmin) / span
            let mut rr: i32 = (40.0 + 100.0 * t) as i32
            let mut gg: i32 = (70.0 + 120.0 * t) as i32
            let mut bb: i32 = (40.0 + 60.0 * t) as i32
            if channel[i] == 1 {
                rr = 40
                gg = 120
                bb = 220
            }
            paint_cell(fb, x, y, rr, gg, bb)
        }
    }
    gfx_blit_rgb(g, 16, FIELD_Y, FB_W, FB_H, fb)
}

function draw_hud(g: Gfx, preset: i32, hack: f64, r2: f64, density: f64,
                  paused: bool) -> void {
    let t1: i32 = gfx_draw_text(g, 8, 8, "RIVER EROSION  STREAM POWER", 2,
                                236, 232, 224)
    let t2: i32 = gfx_draw_text(g, 8, 28, "MODE", 1, 150, 144, 130)
    let t3: i32 = gfx_draw_text(g, 42, 28, preset_name(preset), 1, 255, 196, 110)
    let t4: i32 = gfx_draw_text(g, 130, 28, "HACK h", 1, 150, 144, 130)
    let t5: i32 = gfx_draw_fixed(g, 178, 28, hack, 3, 1, 130, 255, 190)
    let t6: i32 = gfx_draw_text(g, 240, 28, "R2", 1, 150, 144, 130)
    let t7: i32 = gfx_draw_fixed(g, 260, 28, r2, 3, 1, 130, 255, 190)
    let t8: i32 = gfx_draw_text(g, 320, 28, "DENS", 1, 150, 144, 130)
    let t9: i32 = gfx_draw_fixed(g, 354, 28, density, 3, 1, 236, 232, 244)
    let ta: i32 = gfx_draw_text(g, 8, 42,
        "1 STREAM  2 STEEP  3 DIFFUSE  4 FAST  R RESEED  P PAUSE",
        1, 112, 108, 120)
    if paused {
        let tb: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let tc: i32 = gfx_draw_text(g, 8, 572,
        "dh/dt = U - K A^m S^n + D lap(h); A by D8 steepest descent",
        1, 122, 118, 132)
    let td: i32 = gfx_draw_text(g, 8, 582,
        "Hack: main-stem length L ~ A^h with h near one half",
        1, 122, 118, 132)
}

function main() -> i32 {
    h = calloc(CELLS as i64, 8 as i64)
    area = calloc(CELLS as i64, 8 as i64)
    receiver = calloc(CELLS as i64, 4 as i64)
    order = calloc(CELLS as i64, 4 as i64)
    channel = calloc(CELLS as i64, 4 as i64)
    fb = calloc((FB_W * FB_H * 3) as i64, 1 as i64)

    println("")
    println("  RIVER EROSION  --  stream-power law, Hack's exponent")
    println("  =====================================================")
    println("")

    seed_height(1901194261)
    let m: f64 = 0.5
    let nexp: f64 = 1.0
    let k: f64 = 0.10
    let u: f64 = 0.01
    let dcoef: f64 = 0.002
    for t in 0 to VERIFY_STEPS {
        erode_step(m, nexp, k, u, dcoef)
    }
    d8_route()
    mark_channels(20.0)
    fit_hack()

    println("  1. HACK'S LAW AFTER 400 STREAM-POWER STEPS")
    println("")
    print("     Hack exponent h               : ")
    printf("%10.4f", fit_h)
    print("     gate [")
    printf("%.2f", HACK_LO)
    print(", ")
    printf("%.2f", HACK_HI)
    println("]")
    print("     R^2 of log L against log A    : ")
    printf("%10.6f", fit_r2)
    print("     gate > ")
    printf("%.2f", R2_MIN)
    println("")
    print("     channel density               : ")
    printf("%10.4f", dens)
    print("     gate (")
    printf("%.2f", DENS_LO)
    print(", ")
    printf("%.2f", DENS_HI)
    println(")")
    println("")

    if fit_h != fit_h or fit_r2 != fit_r2 {
        println("    FAIL: a measured quantity is NaN")
        return 1
    }
    if fit_h < HACK_LO or fit_h > HACK_HI {
        println("    FAIL: Hack exponent outside the stated window")
        return 2
    }
    if fit_r2 < R2_MIN {
        println("    FAIL: Hack's law is not a straight line on this lattice")
        return 3
    }
    if dens < DENS_LO or dens > DENS_HI {
        println("    FAIL: channel density is outside the expected range")
        return 4
    }
    println("    PASS: drainage basins obey Hack's law with h near one half,")
    println("          and a connected channel network occupies a sensible fraction")
    println("")

    let mut preset: i32 = 0
    seed_height(1901194261)
    d8_route()
    mark_channels(20.0)
    fit_hack()

    let g: Gfx = gfx_open(WIN_W, WIN_H, "River erosion - Flow morphogenesis")
    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut reseed_held: bool = false
    let mut frame: i32 = 0

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(g) { break }

        let mut want: i32 = -1
        if gfx_key_down(g, KEY_1) { want = 0 }
        if gfx_key_down(g, KEY_2) { want = 1 }
        if gfx_key_down(g, KEY_3) { want = 2 }
        if gfx_key_down(g, KEY_4) { want = 3 }
        if want >= 0 and want != preset {
            preset = want
            seed_height(1901194261)
        }
        if gfx_key_down(g, KEY_R) {
            if !reseed_held {
                seed_height(rng_next())
            }
            reseed_held = true
        } else {
            reseed_held = false
        }
        if gfx_key_down(g, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        if !paused {
            let pm: f64 = preset_m(preset)
            let pn: f64 = preset_n(preset)
            let pk: f64 = preset_k(preset)
            let pd: f64 = preset_d(preset)
            for s in 0 to STEPS_PER_FRAME {
                erode_step(pm, pn, pk, 0.01, pd)
            }
            d8_route()
            mark_channels(20.0)
            if frame % 10 == 0 {
                fit_hack()
            }
        }

        gfx_clear(g, 14, 16, 18)
        draw_field(g)
        draw_hud(g, preset, fit_h, fit_r2, dens, paused)
        gfx_present(g)
        frame = frame + 1
    }

    gfx_close(g)
    return 0
}
