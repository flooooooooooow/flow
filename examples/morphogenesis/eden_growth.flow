# EDEN GROWTH: a compact cluster with a rough surface, and the roughness
# measured live.
#
# MODEL (Eden, 1961)
#   The complement of DLA. Instead of particles finding the cluster by
#   diffusing, every empty site touching the cluster is equally likely to be
#   filled next. Nothing screens anything, so the cluster stays compact and
#   nearly circular. What is interesting is the boundary.
#
#     perimeter = all empty sites with an occupied neighbour
#     repeat:  pick one uniformly at random
#              fill it, add its empty neighbours to the perimeter
#
# THE READOUT
#   W is the surface width: the standard deviation of the radial distance of
#   the growth front from the centre. Kardar-Parisi-Zhang scaling predicts
#   W growing like t^(1/3) for a growing interface in this class, so the
#   number climbs steadily instead of settling. The front never smooths out.
#
# PARAMETERS
#   128 x 128 lattice, seed at the centre, 120 sites filled per frame.
#   Colour is arrival order, so the rings show how the front advanced.
#
# KEYS
#   1 EDEN            fill on the first selection, rough KPZ front
#   2 NOISE-REDUCED   a site must be selected 4 times, much smoother front
#   3 ANISOTROPIC     horizontal neighbours enter the pool twice, so the
#                     cluster elongates along x
#   R restart    P pause    Esc quit
#
# PHENOMENON
#   Same growth rule as a bacterial colony on a plate. The bulk is boring
#   and the surface is not: compare the ragged front of mode 1 with the
#   near-circular front of mode 2 and watch W separate.
#
# Run: ./flow gfx examples/morphogenesis/eden_growth.flow

import "stdlib/gfx.flow"
import "stdlib/text.flow"

extern {
    function sqrt(x: f64) -> f64
}

const GRID: i32 = 128
const CELLS: i32 = 16384
const CELL_PX: i32 = 4
const FIELD_Y: i32 = 58
const WIN_W: i32 = 512
const WIN_H: i32 = 592
const MAX_FRAMES: i32 = 6000
const CENTER: i32 = 64
const PER_FRAME: i32 = 120
const POOL_CAP: i32 = 65536

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20

let mut rng_state: u32 = 271828183
let mut pool_len: i32 = 0

function rng_next() -> u32 {
    rng_state = rng_state * 1664525 + 1013904223
    return rng_state
}

function rng_below(n: i32) -> i32 {
    return ((rng_next() >> 11) % (n as u32)) as i32
}

function mode_name(m: i32) -> string {
    if m == 1 { return "NOISE-REDUCED" }
    if m == 2 { return "ANISOTROPIC" }
    return "EDEN"
}

function mode_need(m: i32) -> i32 {
    if m == 1 { return 4 }
    return 1
}

function pool_push(pool: ptr<i32>, idx: i32) -> void {
    if pool_len < POOL_CAP {
        pool[pool_len] = idx
        pool_len = pool_len + 1
    }
}

function reset(occ: ptr<i32>, age: ptr<i32>, hits: ptr<i32>,
               pool: ptr<i32>) -> void {
    for i in 0 to CELLS {
        occ[i] = 0
        age[i] = 0
        hits[i] = 0
    }
    pool_len = 0
    let seed: i32 = CENTER * GRID + CENTER
    occ[seed] = 1
    age[seed] = 1
    pool_push(pool, seed - GRID)
    pool_push(pool, seed + GRID)
    pool_push(pool, seed - 1)
    pool_push(pool, seed + 1)
}

function offer(pool: ptr<i32>, occ: ptr<i32>, idx: i32, copies: i32) -> void {
    if idx < 0 or idx >= CELLS { return }
    if occ[idx] == 1 { return }
    for c in 0 to copies {
        pool_push(pool, idx)
    }
}

# Fill one site. Returns 1 if a new cell was added.
function grow_once(occ: ptr<i32>, age: ptr<i32>, hits: ptr<i32>,
                   pool: ptr<i32>, stamp: i32, need: i32, aniso: bool) -> i32 {
    if pool_len == 0 { return 0 }
    let pick: i32 = rng_below(pool_len)
    let idx: i32 = pool[pick]
    # Swap-remove keeps the pool from growing without bound.
    pool_len = pool_len - 1
    pool[pick] = pool[pool_len]

    if occ[idx] == 1 { return 0 }
    let x: i32 = idx % GRID
    let y: i32 = idx / GRID
    if x < 1 or x >= GRID - 1 or y < 1 or y >= GRID - 1 { return 0 }

    hits[idx] = hits[idx] + 1
    if hits[idx] < need {
        # Not yet ripe: put it back so it can be drawn again.
        pool_push(pool, idx)
        return 0
    }

    occ[idx] = 1
    age[idx] = stamp
    let mut side: i32 = 1
    if aniso { side = 2 }
    offer(pool, occ, idx - GRID, 1)
    offer(pool, occ, idx + GRID, 1)
    offer(pool, occ, idx - 1, side)
    offer(pool, occ, idx + 1, side)
    return 1
}

# Front statistics: mean radius and standard deviation of the surface sites.
function front_mean(occ: ptr<i32>) -> f64 {
    let mut s: f64 = 0.0
    let mut n: i32 = 0
    for y in 1 to GRID - 1 {
        for x in 1 to GRID - 1 {
            let i: i32 = y * GRID + x
            if occ[i] == 1 {
                if occ[i - 1] == 0 or occ[i + 1] == 0
                   or occ[i - GRID] == 0 or occ[i + GRID] == 0 {
                    let fx: f64 = (x - CENTER) as f64
                    let fy: f64 = (y - CENTER) as f64
                    s = s + sqrt(fx * fx + fy * fy)
                    n = n + 1
                }
            }
        }
    }
    if n == 0 { return 0.0 }
    return s / (n as f64)
}

function front_width(occ: ptr<i32>, mean: f64) -> f64 {
    let mut s: f64 = 0.0
    let mut n: i32 = 0
    for y in 1 to GRID - 1 {
        for x in 1 to GRID - 1 {
            let i: i32 = y * GRID + x
            if occ[i] == 1 {
                if occ[i - 1] == 0 or occ[i + 1] == 0
                   or occ[i - GRID] == 0 or occ[i + GRID] == 0 {
                    let fx: f64 = (x - CENTER) as f64
                    let fy: f64 = (y - CENTER) as f64
                    let d: f64 = sqrt(fx * fx + fy * fy) - mean
                    s = s + d * d
                    n = n + 1
                }
            }
        }
    }
    if n < 2 { return 0.0 }
    return sqrt(s / (n as f64))
}

# Growth rings: cool core, warm front.
function draw_field(g: Gfx, occ: ptr<i32>, age: ptr<i32>, newest: i32) -> void {
    let mut inv: f64 = 1.0
    if newest > 1 { inv = 1.0 / (newest as f64) }
    for y in 0 to GRID {
        for x in 0 to GRID {
            let i: i32 = y * GRID + x
            let mut rr: i32 = 12
            let mut gg: i32 = 16
            let mut bb: i32 = 14
            if occ[i] == 1 {
                let t: f64 = (age[i] as f64) * inv
                let mut fr: f64 = 26.0 + 226.0 * t * t
                let mut fg: f64 = 96.0 + 150.0 * t
                let mut fb: f64 = 92.0 - 40.0 * t + 60.0 * t * t * t
                if fr > 255.0 { fr = 255.0 }
                if fg > 255.0 { fg = 255.0 }
                if fb > 255.0 { fb = 255.0 }
                if fb < 10.0 { fb = 10.0 }
                rr = fr as i32
                gg = fg as i32
                bb = fb as i32
            }
            gfx_fill_rect(g, x * CELL_PX, FIELD_Y + y * CELL_PX,
                          CELL_PX, CELL_PX, rr, gg, bb)
        }
    }
}

function draw_hud(g: Gfx, mode: i32, n: i32, mean: f64, width: f64,
                  paused: bool) -> void {
    let t1: i32 = gfx_draw_text(g, 8, 8, "EDEN GROWTH  SURFACE ROUGHNESS", 2,
                                232, 244, 234)
    let t2: i32 = gfx_draw_text(g, 8, 28, "RULE", 1, 140, 162, 146)
    let t3: i32 = gfx_draw_text(g, 40, 28, mode_name(mode), 1, 170, 250, 190)
    let t4: i32 = gfx_draw_text(g, 140, 28, "N", 1, 140, 162, 146)
    let t5: i32 = gfx_draw_int(g, 152, 28, n, 1, 232, 244, 234)
    let t6: i32 = gfx_draw_text(g, 200, 28, "MEAN R", 1, 140, 162, 146)
    let t7: i32 = gfx_draw_fixed(g, 244, 28, mean, 2, 1, 232, 244, 234)
    let t8: i32 = gfx_draw_text(g, 300, 28, "WIDTH W", 1, 140, 162, 146)
    let t9: i32 = gfx_draw_fixed(g, 352, 28, width, 3, 1, 255, 220, 140)
    let ta: i32 = gfx_draw_text(g, 8, 42,
        "1 EDEN  2 NOISE-REDUCED  3 ANISOTROPIC  R RESTART  P PAUSE",
        1, 104, 122, 110)
    if paused {
        let tb: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let tc: i32 = gfx_draw_text(g, 8, 572,
        "W = stddev of the front radius, the KPZ surface width", 1,
        118, 136, 124)
    let td: i32 = gfx_draw_text(g, 8, 582,
        "compact bulk, rough boundary: the interface never anneals", 1,
        118, 136, 124)
}

function main() -> i32 {
    let occ: array<i32, 16384> = [0, 0, 0, 0]
    let age: array<i32, 16384> = [0, 0, 0, 0]
    let hits: array<i32, 16384> = [0, 0, 0, 0]
    let pool: array<i32, 65536> = [0, 0, 0, 0]

    let mut mode: i32 = 0
    reset(occ, age, hits, pool)

    let g: Gfx = gfx_open(WIN_W, WIN_H, "Eden growth - Flow morphogenesis")

    let mut n: i32 = 1
    let mut mean: f64 = 0.0
    let mut width: f64 = 0.0
    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut reset_held: bool = false
    let mut hold: i32 = 0
    let mut frame: i32 = 0

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(g) { break }

        let mut want: i32 = -1
        if gfx_key_down(g, KEY_1) { want = 0 }
        if gfx_key_down(g, KEY_2) { want = 1 }
        if gfx_key_down(g, KEY_3) { want = 2 }
        if want >= 0 and want != mode {
            mode = want
            reset(occ, age, hits, pool)
            n = 1
            hold = 0
        }

        if gfx_key_down(g, KEY_R) {
            if !reset_held {
                reset(occ, age, hits, pool)
                n = 1
                hold = 0
            }
            reset_held = true
        } else {
            reset_held = false
        }

        if gfx_key_down(g, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        let full: bool = mean > 56.0
        if full {
            hold = hold + 1
            if hold > 120 {
                reset(occ, age, hits, pool)
                n = 1
                hold = 0
            }
        }

        if !paused and !full {
            let need: i32 = mode_need(mode)
            let aniso: bool = mode == 2
            for k in 0 to PER_FRAME {
                n = n + grow_once(occ, age, hits, pool, n + 1, need, aniso)
            }
            mean = front_mean(occ)
            width = front_width(occ, mean)
        }

        gfx_clear(g, 10, 14, 12)
        draw_field(g, occ, age, n)
        draw_hud(g, mode, n, mean, width, paused)
        gfx_present(g)
        frame = frame + 1
    }

    gfx_close(g)
    return 0
}
