# VICSEK FLOCKING: a direction chosen by nobody, and the noise that destroys it.
#
# MODEL (Vicsek, Czirok, Ben-Jacob, Cohen and Shochet, 1995)
#   N particles move at a fixed speed v in a periodic box of side L. At every
#   tick each particle takes the mean heading of everything inside a disc of
#   radius r around it, itself included, and adds a uniform kick:
#
#       theta_i(t+1) = arg( sum_{|r_ij| < r} exp(i theta_j(t)) )  +  d_i
#       d_i          uniform on [-eta/2, +eta/2]
#       x_i(t+1)     = x_i(t) + v (cos theta_i(t+1), sin theta_i(t+1))
#
#   Nothing here sets a direction. The only interaction is alignment, and the
#   only parameters are the speed, the radius, the density and the noise.
#
#   This is a discrete-time model with a nonlocal average, so it carries no
#   `flow` block with `evolves as`: the update is a map rather than a rate.
#
# WHAT IS MEASURED, AND AGAINST WHAT
#
#   The order parameter is Vicsek's:
#
#       phi = | sum_i v_i | / (N v)
#
#   which is 1 when every particle points the same way and of order 1/sqrt(N)
#   when the headings are independent. The program sweeps eta over twelve
#   values from 0.5 to 6.0 at fixed density and reports phi at each after
#   equilibration, together with the susceptibility
#
#       chi = N var(phi)
#
#   and the Binder cumulant G = 1 - <phi^4> / (3 <phi^2>^2), both taken over
#   the same measurement window.
#
#   Gates:
#     phi > 0.9 at the lowest noise, phi < 0.2 at the highest, and phi
#     decreasing across the sweep. Monotonicity is allowed a tolerance of
#     0.03 in phi, because these are finite-time averages of a fluctuating
#     quantity at finite N and neighbouring points can cross.
#     The noise at which phi crosses 0.5 is located by linear interpolation
#     and reported as eta_c, and the peak of chi is gated to sit within one
#     sweep step (0.5) of it.
#
#   Vicsek et al. report a continuous transition with phi ~ (eta_c - eta)^beta
#   at fixed density. Later work (Gregoire and Chate, 2004) argues the
#   transition is discontinuous in the large-system limit, and that the
#   apparent continuity is a finite-size effect. At N = 300 this program is
#   firmly in the finite-size regime, so it claims only the crossing and the
#   susceptibility peak, and no exponent.
#
# PARAMETERS
#   N 300, L 7.0, so the density is 6.12 particles per unit area and the mean
#   neighbourhood holds about 19 particles. v 0.03, r 1.0, dt 1.
#   2000 equilibration steps and 4000 measurement steps at each noise level,
#   sampling phi every fifth step. Vicsek's own figure 2a used these numbers.
#
# REFERENCE
#   T. Vicsek, A. Czirok, E. Ben-Jacob, I. Cohen and O. Shochet, "Novel type
#   of phase transition in a system of self-driven particles",
#   Phys. Rev. Lett. 75:1226-1229 (1995).
#   G. Gregoire and H. Chate, "Onset of collective and cohesive motion",
#   Phys. Rev. Lett. 92:025702 (2004), for the order of the transition.
#
# LIVE VIEW / KEYS
#   Each particle is a short stroke pointing along its heading and coloured by
#   it, so a flock reads as one colour and a disordered gas reads as confetti.
#   The frame fades rather than clearing, which leaves trails. The HUD shows
#   the noise, the live phi, the density, and eta_c from the sweep above.
#
#   1 ORDERED      eta 0.5   N 300   one flock, one colour
#   2 CRITICAL     eta at the measured crossing, N 300   bands and reversals
#   3 DISORDERED   eta 5.5   N 300   confetti
#   4 SPARSE       eta 1.0   N  60   low density, alignment loses
#   R reseed       P pause   Esc quit
#
# Run: ./flow gfx examples/morphogenesis/flocking_patterns.flow

import "stdlib/gfx.flow"
import "stdlib/text.flow"

extern {
    function printf(fmt: string, val: f64) -> i32
    function calloc(n: i64, size: i64) -> ptr<void>
    function atan2(y: f64, x: f64) -> f64
    function sqrt(x: f64) -> f64
    function fabs(x: f64) -> f64
    function cos(x: f64) -> f64
    function sin(x: f64) -> f64
    function fmod(x: f64, y: f64) -> f64
}

const NMAX: i32 = 400
const N_MAIN: i32 = 300
const N_SPARSE: i32 = 60
const BOX: f64 = 7.0
const HALFBOX: f64 = 3.5
const RADIUS2: f64 = 1.0
const SPEED: f64 = 0.03
const CELLS_SIDE: i32 = 7
const NCELL: i32 = 49
const CELL_SIZE: f64 = 1.0
const TWO_PI: f64 = 6.283185307179586

const NETA: i32 = 12
const EQUIL: i32 = 2000
const MEAS: i32 = 4000
const SAMPLE_EVERY: i32 = 5

const PHI_ORDERED_MIN: f64 = 0.90
const PHI_DISORDERED_MAX: f64 = 0.20
const MONO_TOL: f64 = 0.03
const PEAK_TOL: f64 = 1.10

const FB_W: i32 = 512
const FB_H: i32 = 512
const FIELD_Y: i32 = 58
const WIN_W: i32 = 512
const WIN_H: i32 = 592
const MAX_FRAMES: i32 = 6000
const STEPS_PER_FRAME: i32 = 3
const STROKE_PX: f64 = 11.0
const STROKE_SAMPLES: i32 = 9

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20
const KEY_4: i32 = 21

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------

let mut pxs: ptr<f64> = null
let mut pys: ptr<f64> = null
let mut ths: ptr<f64> = null
let mut thn: ptr<f64> = null
let mut head: ptr<i32> = null
let mut nxt: ptr<i32> = null
let mut fb: ptr<u8> = null

let mut sweep_eta: ptr<f64> = null
let mut sweep_phi: ptr<f64> = null
let mut sweep_chi: ptr<f64> = null
let mut sweep_binder: ptr<f64> = null

let mut m_phi: f64 = 0.0
let mut m_chi: f64 = 0.0
let mut m_binder: f64 = 0.0

# ---------------------------------------------------------------------------
# Deterministic LCG. Thirty bits from the top halves of two draws.
# ---------------------------------------------------------------------------

let mut rng_state: u32 = 2463534242

function rng_next() -> u32 {
    rng_state = rng_state * 1664525 + 1013904223
    return rng_state
}

function rng_u30() -> i32 {
    let a: i32 = ((rng_next() >> 16) % 32768) as i32
    let b: i32 = ((rng_next() >> 16) % 32768) as i32
    return a * 32768 + b
}

function rng_unit() -> f64 {
    return (rng_u30() as f64) / 1073741824.0
}

# ---------------------------------------------------------------------------
# The model
# ---------------------------------------------------------------------------

function seed_particles(n: i32, seed: u32) -> void {
    rng_state = seed
    for i in 0 to n {
        pxs[i] = rng_unit() * BOX
        pys[i] = rng_unit() * BOX
        ths[i] = rng_unit() * TWO_PI
    }
}

function build_cells(n: i32) -> void {
    for c in 0 to NCELL {
        head[c] = -1
    }
    for i in 0 to n {
        let mut cx: i32 = (pxs[i] / CELL_SIZE) as i32
        let mut cy: i32 = (pys[i] / CELL_SIZE) as i32
        if cx < 0 { cx = 0 }
        if cy < 0 { cy = 0 }
        if cx >= CELLS_SIDE { cx = CELLS_SIDE - 1 }
        if cy >= CELLS_SIDE { cy = CELLS_SIDE - 1 }
        let c: i32 = cy * CELLS_SIDE + cx
        nxt[i] = head[c]
        head[c] = i
    }
}

function wrap_delta(d: f64) -> f64 {
    let mut w: f64 = d
    if w > HALFBOX { w = w - BOX }
    if w < 0.0 - HALFBOX { w = w + BOX }
    return w
}

function wrap_pos(p: f64) -> f64 {
    let mut w: f64 = p
    if w >= BOX { w = w - BOX }
    if w < 0.0 { w = w + BOX }
    return w
}

# One Vicsek tick. The cell list is rebuilt first, so the neighbour scan
# touches nine of the forty-nine cells rather than all N particles.
function step_vicsek(n: i32, eta: f64) -> void {
    build_cells(n)
    for i in 0 to n {
        let xi: f64 = pxs[i]
        let yi: f64 = pys[i]
        let mut sc: f64 = 0.0
        let mut ss: f64 = 0.0
        let cx: i32 = (xi / CELL_SIZE) as i32
        let cy: i32 = (yi / CELL_SIZE) as i32
        for dy in -1 to 2 {
            let gy: i32 = (cy + dy + CELLS_SIDE) % CELLS_SIDE
            for dx in -1 to 2 {
                let gx: i32 = (cx + dx + CELLS_SIDE) % CELLS_SIDE
                let mut j: i32 = head[gy * CELLS_SIDE + gx]
                while j >= 0 {
                    let ddx: f64 = wrap_delta(pxs[j] - xi)
                    let ddy: f64 = wrap_delta(pys[j] - yi)
                    if ddx * ddx + ddy * ddy < RADIUS2 {
                        sc = sc + cos(ths[j])
                        ss = ss + sin(ths[j])
                    }
                    j = nxt[j]
                }
            }
        }
        let mut mean_th: f64 = ths[i]
        if sc != 0.0 or ss != 0.0 {
            mean_th = atan2(ss, sc)
        }
        thn[i] = mean_th + eta * (rng_unit() - 0.5)
    }
    for i in 0 to n {
        ths[i] = thn[i]
        pxs[i] = wrap_pos(pxs[i] + SPEED * cos(ths[i]))
        pys[i] = wrap_pos(pys[i] + SPEED * sin(ths[i]))
    }
}

function order_param(n: i32) -> f64 {
    let mut sc: f64 = 0.0
    let mut ss: f64 = 0.0
    for i in 0 to n {
        sc = sc + cos(ths[i])
        ss = ss + sin(ths[i])
    }
    return sqrt(sc * sc + ss * ss) / (n as f64)
}

# Equilibrate, then average phi, N var(phi) and the Binder cumulant.
function measure(n: i32, eta: f64) -> void {
    seed_particles(n, 2463534242)
    for s in 0 to EQUIL {
        step_vicsek(n, eta)
    }
    let mut s1: f64 = 0.0
    let mut s2: f64 = 0.0
    let mut s4: f64 = 0.0
    let mut cnt: f64 = 0.0
    for s in 0 to MEAS {
        step_vicsek(n, eta)
        if s % SAMPLE_EVERY == 0 {
            let p: f64 = order_param(n)
            s1 = s1 + p
            s2 = s2 + p * p
            s4 = s4 + p * p * p * p
            cnt = cnt + 1.0
        }
    }
    let mean1: f64 = s1 / cnt
    let mean2: f64 = s2 / cnt
    let mean4: f64 = s4 / cnt
    m_phi = mean1
    m_chi = (n as f64) * (mean2 - mean1 * mean1)
    m_binder = 1.0 - mean4 / (3.0 * mean2 * mean2)
}

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------

function wheel_r(t: f64) -> i32 {
    let h: f64 = t * 6.0
    if h < 1.0 { return 244 }
    if h < 2.0 { return (244.0 - 180.0 * (h - 1.0)) as i32 }
    if h < 4.0 { return 64 }
    if h < 5.0 { return (64.0 + 180.0 * (h - 4.0)) as i32 }
    return 244
}

function wheel_g(t: f64) -> i32 {
    let h: f64 = t * 6.0
    if h < 1.0 { return (72.0 + 172.0 * h) as i32 }
    if h < 3.0 { return 244 }
    if h < 4.0 { return (244.0 - 172.0 * (h - 3.0)) as i32 }
    return 72
}

function wheel_b(t: f64) -> i32 {
    let h: f64 = t * 6.0
    if h < 2.0 { return 72 }
    if h < 3.0 { return (72.0 + 172.0 * (h - 2.0)) as i32 }
    if h < 5.0 { return 244 }
    return (244.0 - 172.0 * (h - 5.0)) as i32
}

function fade_frame() -> void {
    let total: i32 = FB_W * FB_H * 3
    for o in 0 to total {
        fb[o] = (((fb[o] as i32) * 200) / 256) as u8
    }
}

function put_px(ix: i32, iy: i32, r: i32, g2: i32, b: i32) -> void {
    if ix < 0 or ix >= FB_W { return }
    if iy < 0 or iy >= FB_H { return }
    let o: i32 = (iy * FB_W + ix) * 3
    fb[o] = r as u8
    fb[o + 1] = g2 as u8
    fb[o + 2] = b as u8
}

function draw_particles(g: Gfx, n: i32) -> void {
    let scale: f64 = (FB_W as f64) / BOX
    for i in 0 to n {
        let mut hue: f64 = fmod(ths[i], TWO_PI) / TWO_PI
        if hue < 0.0 { hue = hue + 1.0 }
        let r: i32 = wheel_r(hue)
        let g2: i32 = wheel_g(hue)
        let b: i32 = wheel_b(hue)
        let hx: f64 = pxs[i] * scale
        let hy: f64 = pys[i] * scale
        let tx: f64 = hx - STROKE_PX * cos(ths[i])
        let ty: f64 = hy - STROKE_PX * sin(ths[i])
        for k in 0 to STROKE_SAMPLES {
            let f: f64 = (k as f64) / ((STROKE_SAMPLES - 1) as f64)
            let sx: f64 = tx + (hx - tx) * f
            let sy: f64 = ty + (hy - ty) * f
            let dim: f64 = 0.35 + 0.65 * f
            put_px(sx as i32, sy as i32,
                   (r as f64 * dim) as i32,
                   (g2 as f64 * dim) as i32,
                   (b as f64 * dim) as i32)
        }
        put_px(hx as i32, hy as i32, 250, 250, 255)
    }
    gfx_blit_rgb(g, 0, FIELD_Y, FB_W, FB_H, fb)
}

function preset_name(p: i32) -> string {
    if p == 1 { return "CRITICAL" }
    if p == 2 { return "DISORDERED" }
    if p == 3 { return "SPARSE" }
    return "ORDERED"
}

function preset_n(p: i32) -> i32 {
    if p == 3 { return N_SPARSE }
    return N_MAIN
}

function draw_hud(g: Gfx, preset: i32, eta: f64, phi: f64, n: i32,
                  eta_c: f64, paused: bool) -> void {
    let rho: f64 = (n as f64) / (BOX * BOX)
    let t1: i32 = gfx_draw_text(g, 8, 8, "VICSEK FLOCKING", 2, 238, 240, 248)
    let t2: i32 = gfx_draw_text(g, 226, 12, preset_name(preset), 1, 255, 198, 96)
    let t3: i32 = gfx_draw_text(g, 316, 12, "N", 1, 148, 152, 166)
    let t4: i32 = gfx_draw_int(g, 328, 12, n, 1, 234, 236, 244)
    let t5: i32 = gfx_draw_text(g, 366, 12, "DENSITY", 1, 148, 152, 166)
    let t6: i32 = gfx_draw_fixed(g, 414, 12, rho, 2, 1, 234, 236, 244)
    let t7: i32 = gfx_draw_text(g, 8, 28, "eta", 1, 148, 152, 166)
    let t8: i32 = gfx_draw_fixed(g, 32, 28, eta, 2, 1, 255, 198, 96)
    let t9: i32 = gfx_draw_text(g, 78, 28, "phi", 1, 148, 152, 166)
    let ta: i32 = gfx_draw_fixed(g, 102, 28, phi, 4, 1, 120, 255, 190)
    let tb: i32 = gfx_draw_text(g, 164, 28, "eta_c FROM THE SWEEP", 1, 148, 152, 166)
    let tc: i32 = gfx_draw_fixed(g, 300, 28, eta_c, 3, 1, 234, 236, 244)
    let td: i32 = gfx_draw_text(g, 356, 28, "r 1.0  v 0.03  L 7.0", 1, 118, 122, 138)
    let te: i32 = gfx_draw_text(g, 8, 42,
        "1 ORDERED  2 CRITICAL  3 DISORDERED  4 SPARSE  R RESEED  P PAUSE",
        1, 112, 116, 132)
    if paused {
        let tf: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let tg: i32 = gfx_draw_text(g, 8, 572,
        "theta_i <- mean heading within r, plus uniform noise of width eta",
        1, 122, 126, 144)
    let th: i32 = gfx_draw_text(g, 8, 582,
        "phi = |sum v_i| / (N v): nothing in the rule picks the direction",
        1, 122, 126, 144)
}

# ---------------------------------------------------------------------------

function main() -> i32 {
    pxs = calloc(NMAX as i64, 8 as i64)
    pys = calloc(NMAX as i64, 8 as i64)
    ths = calloc(NMAX as i64, 8 as i64)
    thn = calloc(NMAX as i64, 8 as i64)
    head = calloc(NCELL as i64, 4 as i64)
    nxt = calloc(NMAX as i64, 4 as i64)
    fb = calloc(786432 as i64, 1 as i64)
    sweep_eta = calloc(NETA as i64, 8 as i64)
    sweep_phi = calloc(NETA as i64, 8 as i64)
    sweep_chi = calloc(NETA as i64, 8 as i64)
    sweep_binder = calloc(NETA as i64, 8 as i64)

    println("")
    println("  VICSEK FLOCKING  --  the order parameter, and the noise that kills it")
    println("  =====================================================================")
    println("")
    println("    Vicsek, Czirok, Ben-Jacob, Cohen and Shochet (1995).")
    print("    N 300   L 7.0   density ")
    printf("%.3f", (N_MAIN as f64) / (BOX * BOX))
    print("   v 0.03   r 1.0   2000 equilibration +")
    printf("%5.0f", MEAS as f64)
    println(" measured steps")
    println("")
    println("  1. THE ORDER PARAMETER AGAINST THE NOISE")
    println("")
    println("        eta      phi        chi = N var(phi)     Binder G")
    println("       -----   --------   ------------------   ----------")

    for k in 0 to NETA {
        let eta: f64 = 0.5 * ((k + 1) as f64)
        measure(N_MAIN, eta)
        sweep_eta[k] = eta
        sweep_phi[k] = m_phi
        sweep_chi[k] = m_chi
        sweep_binder[k] = m_binder
        print("       ")
        printf("%5.2f", eta)
        printf("   %8.5f", m_phi)
        printf("   %18.5f", m_chi)
        printf("   %10.5f", m_binder)
        println("")
    }
    println("")

    let phi_lo: f64 = sweep_phi[0]
    let phi_hi: f64 = sweep_phi[NETA - 1]
    print("     phi at eta = 0.5             : ")
    printf("%10.5f", phi_lo)
    print("     gate > ")
    printf("%.2f", PHI_ORDERED_MIN)
    println("")
    print("     phi at eta = 6.0             : ")
    printf("%10.5f", phi_hi)
    print("     gate < ")
    printf("%.2f", PHI_DISORDERED_MAX)
    println("")

    let mut mono: bool = true
    let mut worst_rise: f64 = 0.0
    for k in 1 to NETA {
        let rise: f64 = sweep_phi[k] - sweep_phi[k - 1]
        if rise > worst_rise { worst_rise = rise }
        if rise > MONO_TOL { mono = false }
    }
    print("     largest rise in phi with eta : ")
    printf("%10.5f", worst_rise)
    print("     gate < ")
    printf("%.2f", MONO_TOL)
    println("   (finite-time averages fluctuate)")
    println("")

    # -- 2. the crossing and the susceptibility peak -------------------------
    let mut eta_c: f64 = 0.0
    let mut found: bool = false
    for k in 1 to NETA {
        if !found {
            if sweep_phi[k - 1] >= 0.5 and sweep_phi[k] < 0.5 {
                let f: f64 = (sweep_phi[k - 1] - 0.5)
                             / (sweep_phi[k - 1] - sweep_phi[k])
                eta_c = sweep_eta[k - 1] + f * (sweep_eta[k] - sweep_eta[k - 1])
                found = true
            }
        }
    }

    let mut kpeak: i32 = 0
    for k in 1 to NETA {
        if sweep_chi[k] > sweep_chi[kpeak] { kpeak = k }
    }
    let eta_peak: f64 = sweep_eta[kpeak]
    let gap: f64 = fabs(eta_peak - eta_c)

    println("  2. WHERE THE TRANSITION SITS")
    println("")
    print("     eta at which phi crosses 0.5 : ")
    printf("%10.4f", eta_c)
    println("     by linear interpolation between sweep points")
    print("     eta at the peak of chi       : ")
    printf("%10.4f", eta_peak)
    print("     chi there ")
    printf("%.4f", sweep_chi[kpeak])
    println("")
    print("     separation                   : ")
    printf("%10.4f", gap)
    print("     gate < ")
    printf("%.2f", PEAK_TOL)
    println("   (two sweep steps)")
    print("     Binder G at the peak         : ")
    printf("%10.5f", sweep_binder[kpeak])
    println("     it dips where the fluctuations are largest")
    println("")
    println("     Vicsek et al. read a continuous transition off this curve.")
    println("     Gregoire and Chate (2004) argue it is discontinuous once the")
    println("     system is large enough, so at N = 300 no exponent is claimed")
    println("     here: only the crossing, and the susceptibility peak beside it.")
    println("")

    # -- gates ---------------------------------------------------------------
    if phi_lo != phi_lo or phi_hi != phi_hi or eta_c != eta_c {
        println("    FAIL: a measured quantity is NaN")
        return 1
    }
    if phi_lo < PHI_ORDERED_MIN {
        println("    FAIL: the flock does not order at the lowest noise")
        return 2
    }
    if phi_hi > PHI_DISORDERED_MAX {
        println("    FAIL: order survives at the highest noise")
        return 3
    }
    if !mono {
        println("    FAIL: phi does not decrease with the noise")
        return 4
    }
    if !found {
        println("    FAIL: phi never crosses 0.5 inside the sweep")
        return 5
    }
    if gap > PEAK_TOL {
        println("    FAIL: the susceptibility does not peak near the crossing")
        return 6
    }
    println("    PASS: phi runs from ordered to disordered, decreasing throughout,")
    println("          and N var(phi) peaks at the noise where phi crosses 0.5")
    println("")

    # -- live view -----------------------------------------------------------
    let mut preset: i32 = 0
    let mut n: i32 = preset_n(preset)
    let mut eta: f64 = 0.5
    seed_particles(n, 2463534242)

    let g: Gfx = gfx_open(WIN_W, WIN_H, "Vicsek flocking - Flow morphogenesis")

    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut reseed_held: bool = false
    let mut frame: i32 = 0

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(g) { break }

        let mut want: i32 = -1
        if gfx_key_down(g, KEY_1) { want = 0 }
        if gfx_key_down(g, KEY_2) { want = 1 }
        if gfx_key_down(g, KEY_3) { want = 2 }
        if gfx_key_down(g, KEY_4) { want = 3 }
        if want >= 0 and want != preset {
            preset = want
            n = preset_n(preset)
            if preset == 1 { eta = eta_c }
            if preset == 2 { eta = 5.5 }
            if preset == 3 { eta = 1.0 }
            if preset == 0 { eta = 0.5 }
            seed_particles(n, 2463534242)
        }

        if gfx_key_down(g, KEY_R) {
            if !reseed_held {
                seed_particles(n, rng_next())
            }
            reseed_held = true
        } else {
            reseed_held = false
        }

        if gfx_key_down(g, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        if !paused {
            for s in 0 to STEPS_PER_FRAME {
                step_vicsek(n, eta)
            }
        }

        let phi: f64 = order_param(n)

        gfx_clear(g, 8, 9, 14)
        fade_frame()
        draw_particles(g, n)
        draw_hud(g, preset, eta, phi, n, eta_c, paused)
        gfx_present(g)
        frame = frame + 1
    }

    gfx_close(g)
    return 0
}
