# L-SYSTEM PLANT: a stochastic rewriting grammar, drawn as it grows.
#
# MODEL (Lindenmayer, 1968; Prusinkiewicz and Lindenmayer, 1990)
#   A plant here is a string over the alphabet F [ ] + - X, rewritten in
#   parallel six times from the axiom X. Every symbol is replaced at once,
#   which is the whole point of an L-system: growth is simultaneous across
#   the organism, not sequential like a program.
#
#     F -> FF
#     X -> F[+X]F[-X]+X      one of three productions, chosen at random
#     X -> F[-X]F[+X]-X
#     X -> F[+X][-X]FX
#
#   The finished string is then read by a turtle: F draws a segment forward,
#   + and - turn, [ pushes the turtle state and ] pops it.
#
# GROWTH IN TIME
#   The string is derived once. Each displayed frame interprets a longer
#   prefix of it, so the plant extends and branches in the order the grammar
#   produced. Reading a prefix of an L-system string is exactly reading the
#   plant's own developmental sequence.
#
# PARAMETERS
#   6 derivations, segment length 4 px, base turn angle per preset, a small
#   deterministic per-symbol angle jitter so no two branches are identical.
#   About 1300 segments, 15 revealed per frame.
#
# KEYS
#   1 BUSH   turn 21 deg    2 FERN   turn 13 deg    3 WEED   turn 31 deg
#   R new plant (new random productions)    P pause    Esc quit
#
# PHENOMENON
#   Nothing in this file describes a plant shape. It describes three string
#   substitutions and a turtle. The silhouette, the branching density and
#   the way side shoots trail the leader are all consequences.
#
# Run: ./flow gfx examples/morphogenesis/lsystem_plant.flow

import "stdlib/gfx.flow"
import "stdlib/text.flow"

extern {
    function sin(x: f64) -> f64
    function cos(x: f64) -> f64
}

const WIN_W: i32 = 512
const WIN_H: i32 = 592
const FIELD_Y: i32 = 58
const MAX_FRAMES: i32 = 6000

const BUF_CAP: i32 = 131072
const DERIVATIONS: i32 = 6
const SEG_PX: f64 = 4.0
const REVEAL_PER_FRAME: i32 = 15
const STACK_CAP: i32 = 64
const DEG: f64 = 0.017453292519943295

const CH_F: i32 = 70
const CH_X: i32 = 88
const CH_PLUS: i32 = 43
const CH_MINUS: i32 = 45
const CH_OPEN: i32 = 91
const CH_CLOSE: i32 = 93

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20

let mut rng_state: u32 = 22091979
let mut cur_len: i32 = 0
let mut seg_total: i32 = 0

function rng_next() -> u32 {
    rng_state = rng_state * 1664525 + 1013904223
    return rng_state
}

function rng_below(n: i32) -> i32 {
    return ((rng_next() >> 13) % (n as u32)) as i32
}

# A stable hash per symbol index: the same plant redraws identically every
# frame, so growth is the only thing that changes.
function sym_jitter(i: i32) -> f64 {
    let mut h: u32 = (i as u32) * 2654435761
    h = h ^ (h >> 15)
    h = h * 2246822519
    h = h ^ (h >> 13)
    let bits: i32 = ((h >> 8) % 2048) as i32
    return (bits as f64) / 1024.0 - 1.0
}

function preset_turn(p: i32) -> f64 {
    if p == 1 { return 13.0 }
    if p == 2 { return 31.0 }
    return 21.0
}

function preset_name(p: i32) -> string {
    if p == 1 { return "FERN" }
    if p == 2 { return "WEED" }
    return "BUSH"
}

function emit(dst: ptr<u8>, len: i32, c: i32) -> i32 {
    if len >= BUF_CAP { return len }
    dst[len] = c as u8
    return len + 1
}

# One production for X, chosen uniformly at random.
function expand_x(dst: ptr<u8>, len0: i32, variant: i32) -> i32 {
    let mut len: i32 = len0
    if variant == 0 {
        len = emit(dst, len, CH_F)
        len = emit(dst, len, CH_OPEN)
        len = emit(dst, len, CH_PLUS)
        len = emit(dst, len, CH_X)
        len = emit(dst, len, CH_CLOSE)
        len = emit(dst, len, CH_F)
        len = emit(dst, len, CH_OPEN)
        len = emit(dst, len, CH_MINUS)
        len = emit(dst, len, CH_X)
        len = emit(dst, len, CH_CLOSE)
        len = emit(dst, len, CH_PLUS)
        len = emit(dst, len, CH_X)
        return len
    }
    if variant == 1 {
        len = emit(dst, len, CH_F)
        len = emit(dst, len, CH_OPEN)
        len = emit(dst, len, CH_MINUS)
        len = emit(dst, len, CH_X)
        len = emit(dst, len, CH_CLOSE)
        len = emit(dst, len, CH_F)
        len = emit(dst, len, CH_OPEN)
        len = emit(dst, len, CH_PLUS)
        len = emit(dst, len, CH_X)
        len = emit(dst, len, CH_CLOSE)
        len = emit(dst, len, CH_MINUS)
        len = emit(dst, len, CH_X)
        return len
    }
    len = emit(dst, len, CH_F)
    len = emit(dst, len, CH_OPEN)
    len = emit(dst, len, CH_PLUS)
    len = emit(dst, len, CH_X)
    len = emit(dst, len, CH_CLOSE)
    len = emit(dst, len, CH_OPEN)
    len = emit(dst, len, CH_MINUS)
    len = emit(dst, len, CH_X)
    len = emit(dst, len, CH_CLOSE)
    len = emit(dst, len, CH_F)
    len = emit(dst, len, CH_X)
    return len
}

function derive(src: ptr<u8>, dst: ptr<u8>, len: i32) -> i32 {
    let mut out: i32 = 0
    for i in 0 to len {
        let c: i32 = src[i] as i32
        if c == CH_X {
            out = expand_x(dst, out, rng_below(3))
        } else {
            if c == CH_F {
                out = emit(dst, out, CH_F)
                out = emit(dst, out, CH_F)
            } else {
                out = emit(dst, out, c)
            }
        }
    }
    return out
}

function count_segments(s: ptr<u8>, len: i32) -> i32 {
    let mut n: i32 = 0
    for i in 0 to len {
        if s[i] as i32 == CH_F { n = n + 1 }
    }
    return n
}

function build(a: ptr<u8>, b: ptr<u8>) -> void {
    a[0] = CH_X as u8
    let mut len: i32 = 1
    for it in 0 to DERIVATIONS {
        if it % 2 == 0 {
            len = derive(a, b, len)
        } else {
            len = derive(b, a, len)
        }
    }
    # DERIVATIONS is even, so the result must end up in `a`.
    if DERIVATIONS % 2 == 1 {
        for i in 0 to len {
            a[i] = b[i]
        }
    }
    cur_len = len
    seg_total = count_segments(a, len)
}

# Interpret a prefix of the string: draw at most `budget` segments.
function turtle(g: Gfx, s: ptr<u8>, len: i32, budget: i32, turn: f64,
                sx: ptr<f64>, sy: ptr<f64>, sa: ptr<f64>, sd: ptr<i32>) -> i32 {
    let mut x: f64 = 256.0
    let mut y: f64 = (FIELD_Y + 508) as f64
    let mut ang: f64 = -90.0
    let mut depth: i32 = 0
    let mut sp: i32 = 0
    let mut drawn: i32 = 0

    let mut i: i32 = 0
    while i < len and drawn < budget {
        let c: i32 = s[i] as i32
        if c == CH_F {
            let nx: f64 = x + SEG_PX * cos(ang * DEG)
            let ny: f64 = y + SEG_PX * sin(ang * DEG)
            let mut t: f64 = (depth as f64) / 6.0
            if t > 1.0 { t = 1.0 }
            let r: i32 = (126.0 - 60.0 * t) as i32
            let gg: i32 = (84.0 + 130.0 * t) as i32
            let b: i32 = (52.0 + 40.0 * t) as i32
            let mut w: i32 = 4 - depth
            if w < 1 { w = 1 }
            let steps: i32 = 5
            for k in 0 to steps + 1 {
                let f: f64 = (k as f64) / (steps as f64)
                let px: i32 = (x + (nx - x) * f) as i32
                let py: i32 = (y + (ny - y) * f) as i32
                gfx_fill_rect(g, px - w / 2, py - w / 2, w, w, r, gg, b)
            }
            x = nx
            y = ny
            drawn = drawn + 1
        }
        if c == CH_PLUS {
            ang = ang + turn * (1.0 + 0.35 * sym_jitter(i))
        }
        if c == CH_MINUS {
            ang = ang - turn * (1.0 + 0.35 * sym_jitter(i))
        }
        if c == CH_OPEN {
            if sp < STACK_CAP {
                sx[sp] = x
                sy[sp] = y
                sa[sp] = ang
                sd[sp] = depth
                sp = sp + 1
            }
            depth = depth + 1
        }
        if c == CH_CLOSE {
            # A closing bracket is a branch tip: mark it with a leaf.
            gfx_fill_rect(g, (x as i32) - 2, (y as i32) - 2, 4, 4, 90, 200, 96)
            if sp > 0 {
                sp = sp - 1
                x = sx[sp]
                y = sy[sp]
                ang = sa[sp]
                depth = sd[sp]
            }
        }
        i = i + 1
    }
    return drawn
}

function draw_hud(g: Gfx, preset: i32, turn: f64, chars: i32, shown: i32,
                  total: i32, paused: bool) -> void {
    let t1: i32 = gfx_draw_text(g, 8, 8, "STOCHASTIC L-SYSTEM PLANT", 2,
                                232, 242, 226)
    let t2: i32 = gfx_draw_text(g, 8, 28, "FORM", 1, 140, 158, 134)
    let t3: i32 = gfx_draw_text(g, 40, 28, preset_name(preset), 1, 180, 250, 160)
    let t4: i32 = gfx_draw_text(g, 100, 28, "TURN", 1, 140, 158, 134)
    let t5: i32 = gfx_draw_fixed(g, 132, 28, turn, 1, 1, 232, 242, 226)
    let t6: i32 = gfx_draw_text(g, 176, 28, "DEG", 1, 140, 158, 134)
    let t7: i32 = gfx_draw_text(g, 206, 28, "SYMBOLS", 1, 140, 158, 134)
    let t8: i32 = gfx_draw_int(g, 258, 28, chars, 1, 232, 242, 226)
    let t9: i32 = gfx_draw_text(g, 306, 28, "DRAWN", 1, 140, 158, 134)
    let ta: i32 = gfx_draw_int(g, 344, 28, shown, 1, 232, 242, 226)
    let tb: i32 = gfx_draw_text(g, 386, 28, "OF", 1, 140, 158, 134)
    let tc: i32 = gfx_draw_int(g, 404, 28, total, 1, 232, 242, 226)
    let td: i32 = gfx_draw_text(g, 8, 42,
        "F->FF   X->F[+X]F[-X]+X | F[-X]F[+X]-X | F[+X][-X]FX   R NEW  P PAUSE",
        1, 104, 118, 100)
    if paused {
        let te: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let tf: i32 = gfx_draw_text(g, 8, 572,
        "6 parallel derivations, then a turtle reads a longer prefix each frame",
        1, 116, 132, 112)
    let tg: i32 = gfx_draw_text(g, 8, 582,
        "1 BUSH  2 FERN  3 WEED", 1, 116, 132, 112)
}

function main() -> i32 {
    let bufa: array<u8, 131072> = [0, 0, 0, 0]
    let bufb: array<u8, 131072> = [0, 0, 0, 0]
    let stx: array<f64, 64> = [0.0, 0.0, 0.0, 0.0]
    let sty: array<f64, 64> = [0.0, 0.0, 0.0, 0.0]
    let sta: array<f64, 64> = [0.0, 0.0, 0.0, 0.0]
    let std: array<i32, 64> = [0, 0, 0, 0]

    let mut preset: i32 = 0
    build(bufa, bufb)

    let g: Gfx = gfx_open(WIN_W, WIN_H, "L-system plant - Flow morphogenesis")

    let mut budget: i32 = 0
    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut new_held: bool = false
    let mut hold: i32 = 0
    let mut frame: i32 = 0

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(g) { break }

        let mut want: i32 = -1
        if gfx_key_down(g, KEY_1) { want = 0 }
        if gfx_key_down(g, KEY_2) { want = 1 }
        if gfx_key_down(g, KEY_3) { want = 2 }
        if want >= 0 and want != preset {
            preset = want
            budget = 0
            hold = 0
        }

        if gfx_key_down(g, KEY_R) {
            if !new_held {
                build(bufa, bufb)
                budget = 0
                hold = 0
            }
            new_held = true
        } else {
            new_held = false
        }

        if gfx_key_down(g, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        if !paused {
            if budget < seg_total {
                budget = budget + REVEAL_PER_FRAME
            } else {
                hold = hold + 1
                if hold > 150 {
                    build(bufa, bufb)
                    budget = 0
                    hold = 0
                }
            }
        }

        gfx_clear(g, 12, 16, 14)
        let shown: i32 = turtle(g, bufa, cur_len, budget, preset_turn(preset),
                                stx, sty, sta, std)
        draw_hud(g, preset, preset_turn(preset), cur_len, shown, seg_total,
                 paused)
        gfx_present(g)
        frame = frame + 1
    }

    gfx_close(g)
    return 0
}
