# HEAT MORPH: anisotropic diffusion sculpting a shape out of noise.
#
# MODEL (Perona-Malik, 1990)
#   Ordinary diffusion has one conductance everywhere, so it destroys edges
#   at the same rate it destroys noise. Make the conductance a function of
#   the local gradient and diffusion becomes a sculptor: it flattens the
#   interior of a region and refuses to cross its boundary.
#
#     dT/dt = div( g(|grad T|) grad T )
#           = sum over the four neighbours of  g(dT_k) * dT_k
#     g(d)  = 1 / (1 + (d/K)^2)
#
#   The four conductance-weighted fluxes are the parameters of `flow
#   HeatCell`, and its one line of dynamics is their sum.
#
# PARAMETERS
#   dt 0.2 explicit Euler (stable while the conductances stay <= 1),
#   128 x 128 grid, no-flux boundaries, 1 step per displayed frame. The
#   noise is re-thrown every 200 steps so the sculpting repeats.
#   K is the edge threshold: gradients well above K barely conduct.
#
# KEYS
#   1 ISOTROPIC     g = 1            the plain heat equation, edges melt
#   2 PERONA-MALIK  K = 0.10         noise dissolves, boundaries sharpen
#   3 DIRECTIONAL   gx 1.0, gy 0.06  conduction only along x, shapes smear
#   R reseed noise    P pause    Esc quit
#
# PHENOMENON
#   The same starting frame under three conductance laws. Watch the EDGE
#   readout, the mean gradient magnitude: isotropic diffusion drives it to
#   zero, Perona-Malik holds it up while erasing the noise, and directional
#   conduction pulls the shapes into horizontal bands. Diffusion is not one
#   process. What it does to a form depends entirely on g.
#
# Run: ./flow gfx examples/morphogenesis/heat_morph.flow

import "stdlib/gfx.flow"
import "stdlib/text.flow"

const GRID: i32 = 128
const CELLS: i32 = 16384
const CELL_PX: i32 = 4
const FIELD_Y: i32 = 58
const WIN_W: i32 = 512
const WIN_H: i32 = 592
const MAX_FRAMES: i32 = 6000
const SUBSTEPS: i32 = 1
const RESEED_AFTER: i32 = 200   # restart the quench so the demo loops

const MODE_ISO: i32 = 0
const MODE_PM: i32 = 1
const MODE_DIR: i32 = 2

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20

flow HeatCell {
    state temp : f64 = 0.0

    param flux_n : f64 = 0.0    # g(dT) * dT toward each neighbour
    param flux_s : f64 = 0.0
    param flux_e : f64 = 0.0
    param flux_w : f64 = 0.0
    param rate   : f64 = 1.0

    solver { dt 200 ms  method euler }

    temp evolves as rate * (flux_n + flux_s + flux_e + flux_w)
}

let mut rng_state: u32 = 987654321

function rng_next() -> u32 {
    rng_state = rng_state * 1664525 + 1013904223
    return rng_state
}

function rng_signed() -> f64 {
    let bits: i32 = ((rng_next() >> 9) % 65536) as i32
    return (bits as f64) / 32768.0 - 1.0
}

function mode_name(m: i32) -> string {
    if m == MODE_ISO { return "ISOTROPIC" }
    if m == MODE_DIR { return "DIRECTIONAL" }
    return "PERONA-MALIK"
}

# A disc, a bar and a ring, buried under heavy noise.
function shape_value(x: i32, y: i32) -> f64 {
    let mut v: f64 = 0.12
    let dx1: f64 = (x - 40) as f64
    let dy1: f64 = (y - 44) as f64
    if dx1 * dx1 + dy1 * dy1 < 900.0 { v = 0.62 }
    let dx2: f64 = (x - 84) as f64
    let dy2: f64 = (y - 86) as f64
    let r2: f64 = dx2 * dx2 + dy2 * dy2
    if r2 < 1024.0 and r2 > 361.0 { v = 0.88 }
    if x > 20 and x < 108 and y > 60 and y < 72 { v = 0.40 }
    let dx3: f64 = (x - 92) as f64
    let dy3: f64 = (y - 30) as f64
    if dx3 * dx3 + dy3 * dy3 < 289.0 { v = 0.97 }
    return v
}

function seed_field(t: ptr<f64>, noise: f64) -> void {
    for y in 0 to GRID {
        for x in 0 to GRID {
            let mut v: f64 = shape_value(x, y) + noise * rng_signed()
            if v < 0.0 { v = 0.0 }
            if v > 1.0 { v = 1.0 }
            t[y * GRID + x] = v
        }
    }
}

# Conductance for a difference d under mode m along axis (0 = x, 1 = y).
function conductance(d: f64, k: f64, m: i32, axis: i32) -> f64 {
    if m == MODE_ISO {
        return 1.0
    }
    if m == MODE_DIR {
        if axis == 0 { return 1.0 }
        return 0.06
    }
    let q: f64 = d / k
    return 1.0 / (1.0 + q * q)
}

function evolve(t: ptr<f64>, tn: ptr<f64>, k: f64, m: i32, dt: f64) -> void {
    let mut cell: HeatCell = HeatCell_new()
    for y in 0 to GRID {
        let mut ym: i32 = y - 1
        let mut yp: i32 = y + 1
        if ym < 0 { ym = 0 }
        if yp >= GRID { yp = GRID - 1 }
        let r: i32 = y * GRID
        for x in 0 to GRID {
            let mut xm: i32 = x - 1
            let mut xp: i32 = x + 1
            if xm < 0 { xm = 0 }
            if xp >= GRID { xp = GRID - 1 }
            let here: f64 = t[r + x]
            let dn: f64 = t[ym * GRID + x] - here
            let ds: f64 = t[yp * GRID + x] - here
            let de: f64 = t[r + xp] - here
            let dw: f64 = t[r + xm] - here
            cell.temp = here
            cell.flux_n = conductance(dn, k, m, 1) * dn
            cell.flux_s = conductance(ds, k, m, 1) * ds
            cell.flux_e = conductance(de, k, m, 0) * de
            cell.flux_w = conductance(dw, k, m, 0) * dw
            HeatCell_step(&cell, dt)
            tn[r + x] = cell.temp
        }
    }
}

function copy_field(src: ptr<f64>, dst: ptr<f64>) -> void {
    for i in 0 to CELLS {
        dst[i] = src[i]
    }
}

# Mean gradient magnitude: how much edge is left in the field.
function edge_energy(t: ptr<f64>) -> f64 {
    let mut s: f64 = 0.0
    for y in 0 to GRID - 1 {
        let r: i32 = y * GRID
        let rp: i32 = (y + 1) * GRID
        for x in 0 to GRID - 1 {
            let mut a: f64 = t[r + x + 1] - t[r + x]
            let mut b: f64 = t[rp + x] - t[r + x]
            if a < 0.0 { a = 0.0 - a }
            if b < 0.0 { b = 0.0 - b }
            s = s + a + b
        }
    }
    return s / ((GRID - 1) * (GRID - 1)) as f64
}

# Warm ember ramp so plateaus read as solid bodies.
function draw_field(g: Gfx, t: ptr<f64>) -> void {
    for y in 0 to GRID {
        for x in 0 to GRID {
            let mut v: f64 = t[y * GRID + x]
            if v < 0.0 { v = 0.0 }
            if v > 1.0 { v = 1.0 }
            let mut rr: f64 = 16.0 + 250.0 * v
            let mut gg: f64 = 14.0 + 90.0 * v + 150.0 * v * v * v
            let mut bb: f64 = 30.0 + 40.0 * v + 180.0 * v * v * v * v
            if rr > 255.0 { rr = 255.0 }
            if gg > 255.0 { gg = 255.0 }
            if bb > 255.0 { bb = 255.0 }
            gfx_fill_rect(g, x * CELL_PX, FIELD_Y + y * CELL_PX,
                          CELL_PX, CELL_PX, rr as i32, gg as i32, bb as i32)
        }
    }
}

function draw_hud(g: Gfx, m: i32, k: f64, edge: f64, steps: i32,
                  paused: bool) -> void {
    let t1: i32 = gfx_draw_text(g, 8, 8, "HEAT MORPH  ANISOTROPIC DIFFUSION", 2,
                                244, 234, 224)
    let t2: i32 = gfx_draw_text(g, 8, 28, "LAW", 1, 155, 142, 132)
    let t3: i32 = gfx_draw_text(g, 32, 28, mode_name(m), 1, 255, 190, 120)
    let t4: i32 = gfx_draw_text(g, 130, 28, "K", 1, 155, 142, 132)
    let t5: i32 = gfx_draw_fixed(g, 142, 28, k, 2, 1, 244, 234, 224)
    let t6: i32 = gfx_draw_text(g, 184, 28, "EDGE", 1, 155, 142, 132)
    let t7: i32 = gfx_draw_fixed(g, 216, 28, edge, 4, 1, 244, 234, 224)
    let t8: i32 = gfx_draw_text(g, 284, 28, "EULER STEPS", 1, 155, 142, 132)
    let t9: i32 = gfx_draw_int(g, 356, 28, steps, 1, 244, 234, 224)
    let ta: i32 = gfx_draw_text(g, 8, 42,
        "dt 0.2   1 ISOTROPIC  2 PERONA-MALIK  3 DIRECTIONAL  R RESEED  P PAUSE",
        1, 112, 104, 98)
    if paused {
        let tb: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let tc: i32 = gfx_draw_text(g, 8, 572,
        "temp evolves as flux_n + flux_s + flux_e + flux_w", 1, 130, 122, 116)
    let td: i32 = gfx_draw_text(g, 8, 582,
        "flux_k = g(dT_k) * dT_k     g(d) = 1 / (1 + (d/K)^2)", 1, 130, 122, 116)
}

function main() -> i32 {
    let ta: array<f64, 16384> = [0.0, 0.0, 0.0, 0.0]
    let tb: array<f64, 16384> = [0.0, 0.0, 0.0, 0.0]

    let k: f64 = 0.10
    let mut mode: i32 = MODE_PM
    seed_field(ta, 0.22)

    let g: Gfx = gfx_open(WIN_W, WIN_H, "Heat morph - Flow morphogenesis")
    let dt: f64 = HeatCell_default_dt()

    let mut steps: i32 = 0
    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut reseed_held: bool = false
    let mut frame: i32 = 0

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(g) { break }

        let mut want: i32 = -1
        if gfx_key_down(g, KEY_1) { want = MODE_ISO }
        if gfx_key_down(g, KEY_2) { want = MODE_PM }
        if gfx_key_down(g, KEY_3) { want = MODE_DIR }
        if want >= 0 and want != mode {
            mode = want
            rng_state = 987654321
            seed_field(ta, 0.22)
            steps = 0
        }

        if gfx_key_down(g, KEY_R) {
            if !reseed_held {
                seed_field(ta, 0.22)
                steps = 0
            }
            reseed_held = true
        } else {
            reseed_held = false
        }

        if gfx_key_down(g, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        if !paused {
            for s in 0 to SUBSTEPS {
                evolve(ta, tb, k, mode, dt)
                copy_field(tb, ta)
                steps = steps + 1
            }
            if steps >= RESEED_AFTER {
                seed_field(ta, 0.22)
                steps = 0
            }
        }

        gfx_clear(g, 14, 12, 16)
        draw_field(g, ta)
        draw_hud(g, mode, k, edge_energy(ta), steps, paused)
        gfx_present(g)
        frame = frame + 1
    }

    gfx_close(g)
    return 0
}
