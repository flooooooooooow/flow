# 1D dam break baseline for Flow's native shallow-water kernel.
import "stdlib/science/sofia_shallow_water.flow"
import "stdlib/math.flow"

extern {
    function printf(fmt: string, val: f64) -> i32
}

function main() -> i32 {
    let nx: i32 = 100
    let ny: i32 = 2
    let num_cells: i32 = 200

    let h: array<f64, 200> = [0.0, 0.0, 0.0, 0.0]
    let mx: array<f64, 200> = [0.0, 0.0, 0.0, 0.0]
    let my: array<f64, 200> = [0.0, 0.0, 0.0, 0.0]
    let z: array<f64, 200> = [0.0, 0.0, 0.0, 0.0]

    let hn: array<f64, 200> = [0.0, 0.0, 0.0, 0.0]
    let mxn: array<f64, 200> = [0.0, 0.0, 0.0, 0.0]
    let myn: array<f64, 200> = [0.0, 0.0, 0.0, 0.0]

    let hl: f64 = 2.0
    let hr: f64 = 0.5

    # Initialize 1D dam break
    for y in 0 to ny {
        for x in 0 to nx {
            let i: i32 = y * nx + x
            z[i] = 0.0
            if x < nx / 2 {
                h[i] = hl
            } else {
                h[i] = hr
            }
            mx[i] = 0.0
            my[i] = 0.0
        }
    }

    let before: f64 = sofia_sw_mass(h, num_cells, 1.0, 1.0)

    for step in 0 to 40 {
        sofia_sw_step_with_bed(h, mx, my, z, hn, mxn, myn,
                               nx, ny, 1.0, 1.0, 0.02, 9.81, 0.0)
        for i in 0 to num_cells {
            if hn[i] <= 0.0 or hn[i] != hn[i] { return 1 }
            h[i] = hn[i]
            mx[i] = mxn[i]
            my[i] = myn[i]
        }
    }

    let after: f64 = sofia_sw_mass(h, num_cells, 1.0, 1.0)
    let drift: f64 = sofia_sw_abs(after - before)

    println("Flow / shallow-water 1D dam break (wall boundaries)")
    print("initial mass = ")
    printf("%.12f\n", before)
    print("final mass   = ")
    printf("%.12f\n", after)
    print("mass error   = ")
    printf("%.12f\n", drift)

    if drift > 1e-8 { return 2 }
    return 0
}
