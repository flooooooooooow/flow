extern {
    function printf(fmt: string, ...) -> i32
}

function main() -> i32 {
    let rate: f64 = 0.8
    let dt: f64 = 0.1
    let mut amount: f64 = 10.0

    printf("t=%.1f amount=%.6f\n", 0.0, amount)
    for step in 0 to 10 {
        amount = amount + (0.0 - rate * amount) * dt
        if step == 4 or step == 9 {
            let time: f64 = (step + 1) as f64 * dt
            printf("t=%.1f amount=%.6f\n", time, amount)
        }
    }
    return 0
}
