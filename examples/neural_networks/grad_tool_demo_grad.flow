struct Grad_f {
    value: f32,
    d_a: f32,
    d_b: f32,
}

function grad_f(a: f32, b: f32) -> Grad_f {
    let v0: f32 = a
    let v1: f32 = b
    let v2: f32 = (v0 * v1)
    let v3: f32 = exp(v2)
    let v4: f32 = a
    let v5: f32 = sin(v4)
    let v6: f32 = (v3 + v5)

    # reverse-mode adjoints
    let adj6: f32 = 1.0
    let adj5: f32 = (1.0)
    let adj4: f32 = ((1.0)) * cos(v4)
    let adj3: f32 = (1.0)
    let adj2: f32 = ((1.0)) * exp(v2)
    let adj1: f32 = (((1.0)) * exp(v2)) * v0
    let adj0: f32 = (((1.0)) * exp(v2)) * v1

    let d_a: f32 = adj0 + adj4
    let d_b: f32 = adj1

    return Grad_f {
        value: v6,
        d_a: d_a,
        d_b: d_b,
    }
}

function grad_f_get(g: Grad_f, idx: i32) -> f32 {
    if idx == 0 { return g.d_a }
    if idx == 1 { return g.d_b }
    return 0.0
}
