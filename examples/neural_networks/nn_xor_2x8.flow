import "lib/stdlib/nn.flow"

function main() -> i32 {
    printf("=== XOR training (2x8x1) ===\n\n")

    let net: Net2x8x1 = Net2x8x1 {
        w00: 0.5, w01: 0.9,
        w10: 0.4, w11: 1.0,
        w20: -0.3, w21: 0.2,
        w30: 0.8, w31: -0.6,
        w40: -0.2, w41: 0.7,
        w50: 0.1, w51: -0.9,
        w60: 0.6, w61: 0.3,
        w70: -0.7, w71: 0.4,
        b0: -0.8, b1: -0.1, b2: 0.2, b3: 0.1, b4: 0.0, b5: 0.05, b6: -0.2, b7: 0.15,
        v0: -1.2, v1: 1.1, v2: 0.7, v3: -0.4, v4: 0.2, v5: -0.1, v6: 0.3, v7: -0.2,
        c: -0.3
    }

    printf("Before: loss=%.4f\n", net2x8x1_loss_xor(net))

    let lr: f32 = 2.0
    for epoch in 0..500 {
        let g: Grads2x8x1 = net2x8x1_grads_xor(net)
        net = net2x8x1_step(net, g, lr)
        if epoch % 100 == 0 {
            printf("  epoch %d: loss=%.4f\n", epoch, net2x8x1_loss_xor(net))
        }
    }

    printf("\nAfter: loss=%.4f\n", net2x8x1_loss_xor(net))
    printf("  0^0=%.3f  0^1=%.3f  1^0=%.3f  1^1=%.3f\n",
           net2x8x1_predict(net, 0.0, 0.0),
           net2x8x1_predict(net, 0.0, 1.0),
           net2x8x1_predict(net, 1.0, 0.0),
           net2x8x1_predict(net, 1.0, 1.0))

    return 0
}
