# SDR receiver demo: generate a tone, mix it to baseband, compute spectrum.
#
# Uses the rf stdlib for Signal/IQ types and units_si for quantity literals.
# Demonstrates:
# - Phantom rate typing: Signal<Hz8000> is compile-time rate-safe
# - Quantity literals: 1000.0 Hertz
# - signal_new / signal_free lifecycle
# - Complex oscillator generation
# - signal_mix (compile-time rate checked)

import "stdlib/rf.flow"
import "stdlib/units_si.flow"

const PI: f64 = 3.14159265358979323846

function main() -> i32 {
    let N: i32 = 8
    let sample_rate: u32 = 8000

    # 1 kHz tone frequency (quantity literal)
    let tone_freq: Hertz = 1000.0 Hertz

    # Generate a 1 kHz tone as IQ samples at 8 kHz sample rate
    let tone: Signal<Hz8000> = signal_new<Hz8000>(N, sample_rate)
    for n in 0 to N {
        let phase: f64 = 2.0 * PI * (tone_freq as f64) * (n as f64) / (sample_rate as f64)
        signal_set<Hz8000>(tone, n, c64(cos(phase), sin(phase)))
    }

    # Generate a 1 kHz local oscillator (complex exponential)
    let lo: Signal<Hz8000> = signal_new<Hz8000>(N, sample_rate)
    for n in 0 to N {
        let phase: f64 = -2.0 * PI * (tone_freq as f64) * (n as f64) / (sample_rate as f64)
        signal_set<Hz8000>(lo, n, c64(cos(phase), sin(phase)))
    }

    # Mix: tone * LO should produce a DC signal (0 Hz)
    # The compiler verifies both signals have the same rate type (Hz8000).
    let baseband: Signal<Hz8000> = signal_mix<Hz8000>(tone, lo)

    println("Baseband samples (should be ~DC):")
    for n in 0 to N {
        print("  ")
        println(signal_get<Hz8000>(baseband, n))
    }

    # Check: the real part of the mixed signal should be ~1.0
    let dc_val: f64 = creal(signal_get<Hz8000>(baseband, 0))
    if dc_val > 0.9 && dc_val < 1.1 {
        println("")
        println("PASS: mixer output is DC as expected")
        signal_free<Hz8000>(tone)
        signal_free<Hz8000>(lo)
        signal_free<Hz8000>(baseband)
        return 0
    }

    println("")
    println("FAIL: unexpected mixer output")
    signal_free<Hz8000>(tone)
    signal_free<Hz8000>(lo)
    signal_free<Hz8000>(baseband)
    return 1
}
