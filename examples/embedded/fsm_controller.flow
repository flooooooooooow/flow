import "stdlib/fsm.flow"
import "stdlib/interrupt.flow"
import "stdlib/rtos.flow"

const STATE_IDLE: i32 = 0
const STATE_CALIBRATING: i32 = 1
const STATE_RUNNING: i32 = 2
const STATE_ERROR: i32 = 3

const EVENT_START: i32 = 100
const EVENT_CAL_DONE: i32 = 101
const EVENT_FAULT: i32 = 102
const EVENT_RESET: i32 = 103

function main() -> i32 {
    print("Embedded FSM Controller with RTOS Ring Buffer\n")
    print("---------------------------------------------\n")

    # 1. Initialize State Machine
    let mut fsm: StateMachine = fsm_new(STATE_IDLE)
    fsm_add_transition(&fsm, STATE_IDLE, EVENT_START, STATE_CALIBRATING)
    fsm_add_transition(&fsm, STATE_CALIBRATING, EVENT_CAL_DONE, STATE_RUNNING)
    fsm_add_transition(&fsm, STATE_CALIBRATING, EVENT_FAULT, STATE_ERROR)
    fsm_add_transition(&fsm, STATE_RUNNING, EVENT_FAULT, STATE_ERROR)
    fsm_add_transition(&fsm, STATE_ERROR, EVENT_RESET, STATE_IDLE)

    # 2. SPSC telemetry ring buffer (ISR to task telemetry)
    let mut telemetry_rb: RtosRingBuffer = ring_buffer_new(8)

    # Critical section for hardware interrupt registration
    let cs: CriticalSection = critical_section_enter()
    irq_enable(5) # Enable telemetry timer IRQ line
    critical_section_exit(cs)

    # 3. Step FSM through operating sequence
    print("State 0 (IDLE)\n")

    # Start calibration
    if fsm_trigger(&fsm, EVENT_START) {
        print("Transitioned to CALIBRATING\n")
        ring_buffer_push(&telemetry_rb, 1) # telemetry status code
    }

    # Complete calibration
    if fsm_trigger(&fsm, EVENT_CAL_DONE) {
        print("Transitioned to RUNNING\n")
        ring_buffer_push(&telemetry_rb, 2)
    }

    # Simulate fault event
    if fsm_trigger(&fsm, EVENT_FAULT) {
        print("Fault detected! Transitioned to ERROR\n")
        ring_buffer_push(&telemetry_rb, 99)
    }

    # Read out telemetry ring buffer
    let mut code: i32 = 0
    while ring_buffer_pop(&telemetry_rb, &code) {
        print("Telemetry code: ")
        print(code)
        print("\n")
    }

    # Reset
    fsm_reset(&fsm)
    print("Controller reset to IDLE\n")

    ring_buffer_free(&telemetry_rb)
    fsm_free(&fsm)
    return 0
}
