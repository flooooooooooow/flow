# Composition Example: Car has-an Engine
# Demonstrates "has-a" relationship using nested structs

struct Engine {
    horsepower: i32
}

struct Car {
    engine: Engine
    weight: i32
}

# "Method" on Car that delegates to its Engine
function car_power(car: Car) -> i32 {
    return car.engine.horsepower
}

function main() -> i32 {
    let engine: Engine = Engine { horsepower: 150 }
    let car: Car = Car { engine: engine, weight: 1200 }
    let power: i32 = car_power(car)
    return power  # Should be 150
}
