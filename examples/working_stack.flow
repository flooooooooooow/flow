# Working Stack Implementation - FLOW version
function push(value: i32, top: i32) -> i32 {
    return top + 1
}

function pop(top: i32) -> i32 {
    if top > 0 {
        return top - 1
    } else {
        return 0
    }
}

function stack_demo() -> i32 {
    let top: i32 = -1
    let sum: i32 = 0
    
    # Push operations
    top = push(10, top)
    top = push(20, top)
    top = push(30, top)
    
    # Pop operations
    top = pop(top)
    top = pop(top)
    top = pop(top)
    
    # Return final stack size
    return top + 1
}

function main() -> i32 {
    let result: i32 = stack_demo()
    return result
}
