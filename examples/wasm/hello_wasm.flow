# Minimal Flow program for the WASM path (Flow → C → emcc).
#
#   ./flow run examples/wasm/hello_wasm.flow          # native smoke
#   ./flow wasm examples/wasm/hello_wasm.flow         # emit C/HTML (+ .wasm if emcc)
#   See docs/language/wasm.md and wasm/wasm_demo/

function fib(n: i32) -> i32 {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

function main() -> i32 {
    let v: i32 = fib(10)
    print("hello_wasm fib(10) =")
    print(v)
    if v != 55 {
        return 1
    }
    return 0
}
