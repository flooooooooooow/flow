# Minimal Flow program for the WASM path (Flow → C|MLIR → emcc).
#
#   ./flow run examples/wasm/hello_wasm.flow                    # native (C)
#   ./flow run --backend=mlir examples/wasm/hello_wasm.flow     # native (MLIR)
#   ./flow wasm examples/wasm/hello_wasm.flow --backend=c       # browser (C)
#   ./flow wasm examples/wasm/hello_wasm.flow --backend=mlir    # browser (MLIR)
#   ./scripts/build_wasm_hello.sh                               # CI-safe; skips without emcc
#
# emcc is not required for Flow→C/MLIR. See examples/wasm/README.md and docs/language/wasm.md.

function fib(n: i32) -> i32 {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

function main() -> i32 {
    let v: i32 = fib(10)
    print("hello_wasm fib(10) = ")
    println(v)
    if v != 55 {
        return 1
    }
    return 0
}
