# RUNAWAY SELECTION: Lande-Kirkpatrick trait-preference coevolution.
#
# MODEL
#   Male display trait z and female preference p coevolve under natural
#   selection on the trait (stabilising toward theta with strength G),
#   sexual selection from preference, and a cost of preference:
#
#        dz/dt = (1/2) G_z [ -G (z - theta) + B p ]
#        dp/dt = (1/2) G_p [  alpha z - D p ]
#
#   Equilibrium at (z, p) = (0, 0) when theta = 0. Linearisation is stable
#   when G D > B alpha (natural selection beats Fisherian feedback) and
#   runaway when G D < B alpha.
#
# GATES
#   1. Weak coupling (G D > B alpha): |z_inf| and |p_inf| < 0.05.
#   2. Strong coupling (runaway): |z| exceeds runaway threshold Z_RUN.
#
# KEYS
#   1 equilibrium   2 mild runaway   3 strong runaway
#   R reseed   P pause   Esc quit
#
# Run: FLOW_HOST=python ./flow record examples/evoleco/runaway_selection.flow --frames 4

import "stdlib/gfx.flow"
import "stdlib/text.flow"

extern {
    function printf(fmt: string, val: f64) -> i32
    function fabs(x: f64) -> f64
}

const WIN_W: i32 = 512
const WIN_H: i32 = 592
const FB_W: i32 = 512
const FB_H: i32 = 512
const FIELD_Y: i32 = 58
const MAX_FRAMES: i32 = 6000
const HIST: i32 = 280
const DT: f64 = 0.02
const THETA: f64 = 0.0
const G_NAT: f64 = 1.0
const D_COST: f64 = 1.0
const GZ: f64 = 0.5
const GP: f64 = 0.5
const Z_RUN: f64 = 2.5

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20

function preset_B(p: i32) -> f64 {
    if p == 1 { return 1.4 }
    if p == 2 { return 2.5 }
    return 0.4
}

function preset_alpha(p: i32) -> f64 {
    if p == 1 { return 1.0 }
    if p == 2 { return 2.0 }
    return 0.3
}

function preset_name(p: i32) -> string {
    if p == 1 { return "MILD RUN" }
    if p == 2 { return "STRONG RUN" }
    return "EQUILIBRIUM"
}

function step_zp(z: f64, p: f64, B: f64, alpha: f64, dt: f64,
                 out_z: ptr<f64>, out_p: ptr<f64>) -> void {
    let dz: f64 = 0.5 * GZ * (0.0 - G_NAT * (z - THETA) + B * p)
    let dp: f64 = 0.5 * GP * (alpha * z - D_COST * p)
    out_z[0] = z + dt * dz
    out_p[0] = p + dt * dp
}

function integrate(z0: f64, p0: f64, B: f64, alpha: f64, steps: i32,
                   out_z: ptr<f64>, out_p: ptr<f64>) -> void {
    let mut z: f64 = z0
    let mut p: f64 = p0
    let mut oz: array<f64, 1> = [0.0]
    let mut op: array<f64, 1> = [0.0]
    for t in 0 to steps {
        step_zp(z, p, B, alpha, DT, oz, op)
        z = oz[0]
        p = op[0]
        # Soft clamp to keep numerics sane for display/gates.
        if z > 20.0 { z = 20.0 }
        if z < -20.0 { z = -20.0 }
        if p > 20.0 { p = 20.0 }
        if p < -20.0 { p = -20.0 }
    }
    out_z[0] = z
    out_p[0] = p
}

let mut tz: array<f64, 280> = [0.0, 0.0, 0.0, 0.0]
let mut tp: array<f64, 280> = [0.0, 0.0, 0.0, 0.0]
let mut hist_len: i32 = 0

function fill_hist(z0: f64, p0: f64, B: f64, alpha: f64) -> void {
    let mut z: f64 = z0
    let mut p: f64 = p0
    let mut oz: array<f64, 1> = [0.0]
    let mut op: array<f64, 1> = [0.0]
    hist_len = 0
    for i in 0 to HIST {
        tz[hist_len] = z
        tp[hist_len] = p
        hist_len = hist_len + 1
        for k in 0 to 4 {
            step_zp(z, p, B, alpha, DT, oz, op)
            z = oz[0]
            p = op[0]
        }
        if z > 20.0 { z = 20.0 }
        if z < -20.0 { z = -20.0 }
        if p > 20.0 { p = 20.0 }
        if p < -20.0 { p = -20.0 }
    }
}

function clear_fb(fb: ptr<u8>) -> void {
    for i in 0 to FB_W * FB_H * 3 {
        fb[i] = 0
    }
}

function put_rgb(fb: ptr<u8>, x: i32, y: i32, r: i32, g2: i32, b: i32) -> void {
    if x >= 0 and x < FB_W and y >= 0 and y < FB_H {
        let o: i32 = (y * FB_W + x) * 3
        fb[o] = r as u8
        fb[o + 1] = g2 as u8
        fb[o + 2] = b as u8
    }
}

function fill_rect_fb(fb: ptr<u8>, x: i32, y: i32, w: i32, h: i32,
                      r: i32, g2: i32, b: i32) -> void {
    for dy in 0 to h {
        for dx in 0 to w {
            put_rgb(fb, x + dx, y + dy, r, g2, b)
        }
    }
}

function draw_scene(g: Gfx, fb: ptr<u8>, cursor: i32) -> void {
    clear_fb(fb)
    let px0: i32 = 40
    let py0: i32 = 40
    let pw: i32 = 432
    let ph: i32 = 220
    fill_rect_fb(fb, px0, py0, pw, ph, 18, 16, 28)
    fill_rect_fb(fb, px0, py0 + ph / 2, pw, 1, 50, 48, 70)
    # Runaway threshold lines.
    let yrun: i32 = py0 + ph / 2 - (((Z_RUN / 8.0) * ((ph / 2 - 4) as f64)) as i32)
    fill_rect_fb(fb, px0, yrun, pw, 1, 255, 100, 100)

    let scale: f64 = 8.0
    for i in 1 to hist_len {
        let x: i32 = px0 + (i * (pw - 1)) / (HIST - 1)
        let mut zz: f64 = tz[i] / scale
        let mut pp: f64 = tp[i] / scale
        if zz > 1.0 { zz = 1.0 }
        if zz < -1.0 { zz = -1.0 }
        if pp > 1.0 { pp = 1.0 }
        if pp < -1.0 { pp = -1.0 }
        let yz: i32 = py0 + ph / 2 - ((zz * ((ph / 2 - 4) as f64)) as i32)
        let yp: i32 = py0 + ph / 2 - ((pp * ((ph / 2 - 4) as f64)) as i32)
        put_rgb(fb, x, yz, 120, 220, 255)
        put_rgb(fb, x, yp, 255, 160, 90)
    }

    # Trait-preference phase plane.
    let qx0: i32 = 100
    let qy0: i32 = 290
    let qw: i32 = 312
    let qh: i32 = 170
    fill_rect_fb(fb, qx0, qy0, qw, qh, 18, 16, 28)
    fill_rect_fb(fb, qx0 + qw / 2, qy0, 1, qh, 50, 48, 70)
    fill_rect_fb(fb, qx0, qy0 + qh / 2, qw, 1, 50, 48, 70)
    for i in 0 to hist_len {
        let mut zz: f64 = tz[i] / scale
        let mut pp: f64 = tp[i] / scale
        if zz > 1.0 { zz = 1.0 }
        if zz < -1.0 { zz = -1.0 }
        if pp > 1.0 { pp = 1.0 }
        if pp < -1.0 { pp = -1.0 }
        let x: i32 = qx0 + qw / 2 + ((zz * ((qw / 2 - 4) as f64)) as i32)
        let y: i32 = qy0 + qh / 2 - ((pp * ((qh / 2 - 4) as f64)) as i32)
        put_rgb(fb, x, y, 180, 255, 160)
    }
    let mut si: i32 = cursor
    if si >= hist_len { si = hist_len - 1 }
    let mut zc: f64 = tz[si] / scale
    let mut pc: f64 = tp[si] / scale
    if zc > 1.0 { zc = 1.0 }
    if zc < -1.0 { zc = -1.0 }
    if pc > 1.0 { pc = 1.0 }
    if pc < -1.0 { pc = -1.0 }
    let hx: i32 = qx0 + qw / 2 + ((zc * ((qw / 2 - 4) as f64)) as i32)
    let hy: i32 = qy0 + qh / 2 - ((pc * ((qh / 2 - 4) as f64)) as i32)
    fill_rect_fb(fb, hx - 3, hy - 3, 7, 7, 255, 220, 100)

    gfx_blit_rgb(g, 0, FIELD_Y, FB_W, FB_H, fb)
}

function draw_hud(g: Gfx, preset: i32, z: f64, p: f64, B: f64, alpha: f64,
                  paused: bool) -> void {
    let t1: i32 = gfx_draw_text(g, 8, 8, "RUNAWAY SELECTION", 2, 238, 234, 246)
    let t2: i32 = gfx_draw_text(g, 260, 12, preset_name(preset), 1, 255, 198, 96)
    let t3: i32 = gfx_draw_text(g, 8, 28, "z", 1, 150, 146, 168)
    let t4: i32 = gfx_draw_fixed(g, 22, 28, z, 2, 1, 120, 220, 255)
    let t5: i32 = gfx_draw_text(g, 90, 28, "p", 1, 150, 146, 168)
    let t6: i32 = gfx_draw_fixed(g, 104, 28, p, 2, 1, 255, 160, 90)
    let t7: i32 = gfx_draw_text(g, 180, 28, "B", 1, 150, 146, 168)
    let t8: i32 = gfx_draw_fixed(g, 194, 28, B, 2, 1, 234, 232, 244)
    let t9: i32 = gfx_draw_text(g, 250, 28, "alpha", 1, 150, 146, 168)
    let ta: i32 = gfx_draw_fixed(g, 290, 28, alpha, 2, 1, 234, 232, 244)
    let tb: i32 = gfx_draw_text(g, 8, 42,
        "1 EQUILIBRIUM  2 MILD RUN  3 STRONG RUN  R RESEED  P PAUSE",
        1, 112, 108, 132)
    if paused {
        let tc: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let td: i32 = gfx_draw_text(g, 8, 572,
        "cyan = male trait z, orange = female preference p; Lande-Kirkpatrick",
        1, 122, 118, 144)
    let te: i32 = gfx_draw_text(g, 8, 582,
        "weak coupling -> natural optimum; strong Fisherian feedback runaway",
        1, 122, 118, 144)
}

function main() -> i32 {
    let fb: array<u8, 786432> = [0, 0, 0, 0]
    let mut oz: array<f64, 1> = [0.0]
    let mut op: array<f64, 1> = [0.0]

    println("")
    println("  RUNAWAY SELECTION  --  Lande-Kirkpatrick trait / preference")
    println("  ==========================================================")
    println("")

    # Weak: G D = 1 > B alpha = 0.12 -- stable at origin.
    integrate(0.5, 0.2, 0.4, 0.3, 5000, oz, op)
    let z_weak: f64 = oz[0]
    let p_weak: f64 = op[0]
    print("    weak: z_inf                       : ")
    printf("%.4f", z_weak)
    print("   p_inf ")
    printf("%.4f", p_weak)
    println("   (gate |z|,|p| < 0.05)")

    # Strong: G D = 1 < B alpha = 5 -- runaway.
    integrate(0.3, 0.1, 2.5, 2.0, 2500, oz, op)
    let z_strong: f64 = oz[0]
    let p_strong: f64 = op[0]
    print("    strong: z_inf                     : ")
    printf("%.4f", z_strong)
    print("   p_inf ")
    printf("%.4f", p_strong)
    println("   (gate |z| > Z_RUN)")
    println("")

    if fabs(z_weak) > 0.05 or fabs(p_weak) > 0.05 {
        println("    FAIL: weak coupling did not approach the natural optimum")
        return 1
    }
    if fabs(z_strong) < Z_RUN {
        println("    FAIL: strong coupling did not runaway past Z_RUN")
        return 2
    }
    println("    PASS: weak coupling equilibrates at theta; strong Fisherian")
    println("          feedback drives trait-preference runaway")
    println("")

    let mut preset: i32 = 0
    let mut B: f64 = preset_B(preset)
    let mut alpha: f64 = preset_alpha(preset)
    fill_hist(0.4, 0.15, B, alpha)

    let gfx: Gfx = gfx_open(WIN_W, WIN_H, "Runaway selection - Flow evoleco")
    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut reseed_held: bool = false
    let mut frame: i32 = 0
    let mut cursor: i32 = 0

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(gfx) { break }

        let mut want: i32 = -1
        if gfx_key_down(gfx, KEY_1) { want = 0 }
        if gfx_key_down(gfx, KEY_2) { want = 1 }
        if gfx_key_down(gfx, KEY_3) { want = 2 }
        if want >= 0 and want != preset {
            preset = want
            B = preset_B(preset)
            alpha = preset_alpha(preset)
            fill_hist(0.4, 0.15, B, alpha)
            cursor = 0
        }

        if gfx_key_down(gfx, KEY_R) {
            if !reseed_held {
                fill_hist(0.4, 0.15, B, alpha)
                cursor = 0
            }
            reseed_held = true
        } else {
            reseed_held = false
        }

        if gfx_key_down(gfx, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        if !paused {
            if cursor < hist_len - 1 { cursor = cursor + 1 }
        }

        let mut si: i32 = cursor
        if si >= hist_len { si = hist_len - 1 }
        gfx_clear(gfx, 12, 10, 18)
        draw_scene(gfx, fb, si)
        draw_hud(gfx, preset, tz[si], tp[si], B, alpha, paused)
        gfx_present(gfx)
        frame = frame + 1
    }

    gfx_close(gfx)
    return 0
}
