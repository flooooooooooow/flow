# ISLAND MIGRATION: Wright's island model and Fst = 1/(1 + 4 N m).
#
# MODEL
#   K demes of N diploids each. Every generation, within each deme a
#   Wright-Fisher sample is drawn, then a fraction m of gene copies is
#   replaced by migrants drawn from the mean frequency across demes
#   (continent-island / well-mixed migrant pool). At migration-drift
#   balance, with finite K demes, the expected differentiation is
#
#        Fst ≈ 1 / (1 + 4 N m K/(K-1))
#
#   which recovers Wright's 1/(1+4Nm) as K -> infinity. Weak mutation keeps
#   the metapopulation polymorphic so the time average is well defined.
#
# THE MEASUREMENT
#   Fst is estimated from deme allele frequencies as
#
#        Fst = (H_T - H_S) / H_T
#
#   with H_S the mean within-deme heterozygosity and H_T the heterozygosity
#   of the global mean frequency. After a burn-in, average Fst over a long
#   window and gate the relative error against the finite-K formula.
#
# KEYS
#   1 Nm=0.5   2 Nm=1   3 Nm=2   R reseed   P pause   Esc quit
#
# Run (headless, gated):
#   FLOW_HOST=python ./flow record examples/evoleco/island_migration.flow \
#       --frames 4 --out /tmp/eco_island_migration
# Run (windowed):
#   ./flow gfx examples/evoleco/island_migration.flow

import "stdlib/gfx.flow"
import "stdlib/text.flow"

extern {
    function printf(fmt: string, val: f64) -> i32
    function fabs(x: f64) -> f64
}

const WIN_W: i32 = 512
const WIN_H: i32 = 592
const FB_W: i32 = 512
const FB_H: i32 = 512
const FIELD_Y: i32 = 58
const MAX_FRAMES: i32 = 6000
const TRACE_LEN: i32 = 220
const K_DEMES: i32 = 16
const N_DIP: i32 = 50
const BURN: i32 = 800
const SAMPLE: i32 = 2000
const MUT_U: f64 = 0.0005
const ERR_GATE: f64 = 0.20

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20

let mut rng_state: u32 = 2718281829

function rng_next() -> u32 {
    rng_state = rng_state * 1664525 + 1013904223
    return rng_state
}

function rng_unit() -> f64 {
    let bits: i32 = ((rng_next() >> 9) % 65536) as i32
    return (bits as f64) / 65536.0
}

function preset_nm(p: i32) -> f64 {
    if p == 1 { return 1.0 }
    if p == 2 { return 2.0 }
    return 0.5
}

function preset_name(p: i32) -> string {
    if p == 1 { return "Nm=1" }
    if p == 2 { return "Nm=2" }
    return "Nm=0.5"
}

function hetero(p: f64) -> f64 {
    return 2.0 * p * (1.0 - p)
}

# Finite-island equilibrium (no mutation term; u kept tiny vs m).
function theory_fst(n: f64, m: f64, k: f64) -> f64 {
    return 1.0 / (1.0 + 4.0 * n * m * k / (k - 1.0))
}

function wf_step(p: f64, two_n: i32) -> f64 {
    let mut k: i32 = 0
    for i in 0 to two_n {
        if rng_unit() < p {
            k = k + 1
        }
    }
    return (k as f64) / (two_n as f64)
}

function mean_p(freq: ptr<f64>, k: i32) -> f64 {
    let mut s: f64 = 0.0
    for i in 0 to k {
        s = s + freq[i]
    }
    return s / (k as f64)
}

function fst_now(freq: ptr<f64>, k: i32) -> f64 {
    let pbar: f64 = mean_p(freq, k)
    let ht: f64 = hetero(pbar)
    if ht < 1.0e-12 { return 0.0 }
    let mut hs: f64 = 0.0
    for i in 0 to k {
        hs = hs + hetero(freq[i])
    }
    hs = hs / (k as f64)
    return (ht - hs) / ht
}

function step_islands(freq: ptr<f64>, next: ptr<f64>, k: i32, two_n: i32,
                      m: f64) -> void {
    let pbar: f64 = mean_p(freq, k)
    for d in 0 to k {
        let p_wf: f64 = wf_step(freq[d], two_n)
        let mut p_mig: f64 = (1.0 - m) * p_wf + m * pbar
        # Symmetric mutation keeps global polymorphism without reseeding.
        p_mig = (1.0 - MUT_U) * p_mig + MUT_U * (1.0 - p_mig)
        next[d] = p_mig
    }
    for d in 0 to k {
        freq[d] = next[d]
    }
}

function seed_islands(freq: ptr<f64>, k: i32) -> void {
    for d in 0 to k {
        # Spread initial frequencies so Fst starts high.
        freq[d] = (d as f64) / ((k - 1) as f64)
    }
}

function measure_fst(nm: f64) -> f64 {
    let m: f64 = nm / (N_DIP as f64)
    let two_n: i32 = 2 * N_DIP
    let freq: array<f64, 16> = [0.0, 0.0, 0.0, 0.0]
    let next: array<f64, 16> = [0.0, 0.0, 0.0, 0.0]
    seed_islands(freq, K_DEMES)
    for t in 0 to BURN {
        step_islands(freq, next, K_DEMES, two_n, m)
    }
    let mut sum: f64 = 0.0
    for t in 0 to SAMPLE {
        step_islands(freq, next, K_DEMES, two_n, m)
        sum = sum + fst_now(freq, K_DEMES)
    }
    return sum / (SAMPLE as f64)
}

function clear_fb(fb: ptr<u8>) -> void {
    for i in 0 to FB_W * FB_H * 3 {
        fb[i] = 0
    }
}

function put_rgb(fb: ptr<u8>, x: i32, y: i32, r: i32, g2: i32, b: i32) -> void {
    if x >= 0 and x < FB_W and y >= 0 and y < FB_H {
        let o: i32 = (y * FB_W + x) * 3
        fb[o] = r as u8
        fb[o + 1] = g2 as u8
        fb[o + 2] = b as u8
    }
}

function fill_rect_fb(fb: ptr<u8>, x: i32, y: i32, w: i32, h: i32,
                      r: i32, g2: i32, b: i32) -> void {
    for dy in 0 to h {
        for dx in 0 to w {
            put_rgb(fb, x + dx, y + dy, r, g2, b)
        }
    }
}

function draw_scene(g: Gfx, fb: ptr<u8>, freq: ptr<f64>, k: i32,
                    trace: ptr<f64>, tlen: i32, head: i32, fpred: f64) -> void {
    clear_fb(fb)

    # Deme frequency bars
    let bw: i32 = 22
    let gap: i32 = 6
    let base: i32 = 220
    let max_h: i32 = 160
    for d in 0 to k {
        let x: i32 = 24 + d * (bw + gap)
        let h: i32 = ((freq[d] * (max_h as f64)) as i32)
        fill_rect_fb(fb, x, base - max_h, bw, max_h, 28, 26, 40)
        fill_rect_fb(fb, x + 2, base - h, bw - 4, h, 240, 150, 70)
    }

    # Fst trace
    let px0: i32 = 40
    let py0: i32 = 260
    let pw: i32 = 432
    let ph: i32 = 180
    fill_rect_fb(fb, px0, py0, pw, ph, 18, 16, 28)
    let yeq: i32 = py0 + ph - 1 - ((fpred * ((ph - 1) as f64)) as i32)
    fill_rect_fb(fb, px0, yeq, pw, 1, 255, 180, 80)
    let mut i: i32 = 0
    while i < head and i < tlen {
        let x: i32 = px0 + (i * (pw - 1)) / (tlen - 1)
        let mut v: f64 = trace[i]
        if v < 0.0 { v = 0.0 }
        if v > 1.0 { v = 1.0 }
        let y: i32 = py0 + ph - 1 - ((v * ((ph - 1) as f64)) as i32)
        put_rgb(fb, x, y, 120, 255, 190)
        i = i + 1
    }

    gfx_blit_rgb(g, 0, FIELD_Y, FB_W, FB_H, fb)
}

function draw_hud(g: Gfx, preset: i32, nm: f64, fst: f64, fpred: f64,
                  err: f64, gen: i32, paused: bool) -> void {
    let t1: i32 = gfx_draw_text(g, 8, 8, "ISLAND MIGRATION", 2, 238, 234, 246)
    let t2: i32 = gfx_draw_text(g, 230, 12, preset_name(preset), 1, 255, 198, 96)
    let t3: i32 = gfx_draw_text(g, 300, 12, "Nm", 1, 150, 146, 168)
    let t4: i32 = gfx_draw_fixed(g, 322, 12, nm, 2, 1, 234, 232, 244)
    let t5: i32 = gfx_draw_text(g, 380, 12, "GEN", 1, 150, 146, 168)
    let t6: i32 = gfx_draw_int(g, 406, 12, gen, 1, 234, 232, 244)

    let t7: i32 = gfx_draw_text(g, 8, 28, "Fst", 1, 150, 146, 168)
    let t8: i32 = gfx_draw_fixed(g, 32, 28, fst, 4, 1, 120, 255, 190)
    let t9: i32 = gfx_draw_text(g, 100, 28, "Fst PRED", 1, 150, 146, 168)
    let ta: i32 = gfx_draw_fixed(g, 170, 28, fpred, 4, 1, 255, 198, 96)
    let tb: i32 = gfx_draw_text(g, 250, 28, "REL ERR", 1, 150, 146, 168)
    let tc: i32 = gfx_draw_fixed(g, 304, 28, err, 4, 1, 234, 232, 244)

    let td: i32 = gfx_draw_text(g, 8, 42,
        "1 Nm=0.5  2 Nm=1  3 Nm=2  R RESEED  P PAUSE",
        1, 112, 108, 132)
    if paused {
        let te: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let tf: i32 = gfx_draw_text(g, 8, 572,
        "Wright island model: Fst = 1/(1+4 N m K/(K-1)) at balance",
        1, 122, 118, 144)
    let tg: i32 = gfx_draw_text(g, 8, 582,
        "bars = deme allele frequencies; orange line = predicted Fst",
        1, 122, 118, 144)
}

function main() -> i32 {
    let fb: array<u8, 786432> = [0, 0, 0, 0]
    let freq: array<f64, 16> = [0.0, 0.0, 0.0, 0.0]
    let next: array<f64, 16> = [0.0, 0.0, 0.0, 0.0]
    let trace: array<f64, 220> = [0.0, 0.0, 0.0, 0.0]

    let nm: f64 = 1.0
    let m: f64 = nm / (N_DIP as f64)
    let fpred: f64 = theory_fst(N_DIP as f64, m, K_DEMES as f64)

    println("")
    println("  ISLAND MIGRATION  --  Wright Fst versus 1/(1+4Nm K/(K-1))")
    println("  ========================================================")
    println("")
    print("    K = ")
    printf("%.0f", K_DEMES as f64)
    print(" demes, N = ")
    printf("%.0f", N_DIP as f64)
    print(" diploids, Nm = ")
    printf("%.2f", nm)
    println("")
    print("    predicted Fst                   : ")
    printf("%.6f", fpred)
    println("  (= 1/(1+4Nm K/(K-1)))")
    println("")

    rng_state = 1901194261
    let fmeas: f64 = measure_fst(nm)
    let err: f64 = fabs(fmeas - fpred) / fpred
    print("    measured mean Fst               : ")
    printf("%.6f", fmeas)
    println("")
    print("    relative error                  : ")
    printf("%.6f", err)
    print("   (gate < ")
    printf("%.2f", ERR_GATE)
    println(")")
    println("")

    if err > ERR_GATE {
        println("    FAIL: measured Fst left 1/(1+4Nm K/(K-1))")
        return 1
    }
    println("    PASS: island-model Fst settles near 1/(1+4Nm K/(K-1))")
    println("")

    let mut preset: i32 = 1
    let mut nm_live: f64 = preset_nm(preset)
    let mut m_live: f64 = nm_live / (N_DIP as f64)
    let mut fpred_live: f64 = theory_fst(N_DIP as f64, m_live, K_DEMES as f64)
    seed_islands(freq, K_DEMES)
    let mut gen: i32 = 0
    let mut head: i32 = 0
    let mut fst: f64 = fst_now(freq, K_DEMES)
    trace[0] = fst
    head = 1

    let g: Gfx = gfx_open(WIN_W, WIN_H, "Island migration - Flow evoleco")
    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut reseed_held: bool = false
    let mut frame: i32 = 0

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(g) { break }

        let mut want: i32 = -1
        if gfx_key_down(g, KEY_1) { want = 0 }
        if gfx_key_down(g, KEY_2) { want = 1 }
        if gfx_key_down(g, KEY_3) { want = 2 }
        if want >= 0 and want != preset {
            preset = want
            nm_live = preset_nm(preset)
            m_live = nm_live / (N_DIP as f64)
            fpred_live = theory_fst(N_DIP as f64, m_live, K_DEMES as f64)
            seed_islands(freq, K_DEMES)
            gen = 0
            head = 1
            fst = fst_now(freq, K_DEMES)
            trace[0] = fst
        }

        if gfx_key_down(g, KEY_R) {
            if !reseed_held {
                seed_islands(freq, K_DEMES)
                gen = 0
                head = 1
                fst = fst_now(freq, K_DEMES)
                trace[0] = fst
            }
            reseed_held = true
        } else {
            reseed_held = false
        }

        if gfx_key_down(g, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        if !paused {
            for s in 0 to 2 {
                step_islands(freq, next, K_DEMES, 2 * N_DIP, m_live)
                gen = gen + 1
            }
            fst = fst_now(freq, K_DEMES)
            if head < TRACE_LEN {
                trace[head] = fst
                head = head + 1
            } else {
                for i in 0 to TRACE_LEN - 1 {
                    trace[i] = trace[i + 1]
                }
                trace[TRACE_LEN - 1] = fst
            }
        }

        let live_err: f64 = 0.0
        if fpred_live > 1.0e-12 {
            live_err = fabs(fst - fpred_live) / fpred_live
        }
        gfx_clear(g, 12, 10, 18)
        draw_scene(g, fb, freq, K_DEMES, trace, TRACE_LEN, head, fpred_live)
        draw_hud(g, preset, nm_live, fst, fpred_live, live_err, gen, paused)
        gfx_present(g)
        frame = frame + 1
    }

    gfx_close(g)
    return 0
}
