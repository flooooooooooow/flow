# REPLICATOR DYNAMICS: a three-strategy simplex converging to Nash.
#
# MODEL
#   Continuous replicator on the 2-simplex:
#
#     dx_i / dt = x_i ( (A x)_i - x^T A x )
#
#   For the cyclic partnership game
#
#     A = [[0, 2, 1],
#          [1, 0, 2],
#          [2, 1, 0]]
#
#   the unique interior Nash rest point is the barycentre (1/3, 1/3, 1/3),
#   and because the gain-cycle product exceeds the loss-cycle product the
#   rest point is asymptotically stable (Hofbauer and Sigmund). A second
#   biased matrix is built so its rest point sits at (0.5, 0.3, 0.2).
#
# GATES
#   1. The designed rest points really are rest points (equal payoffs).
#   2. From three interior starts, distance to the rest point is below 1e-4.
#
# KEYS
#   1 FAIR       Nash at centre
#   2 BIASED     Nash at (0.5, 0.3, 0.2)
#   3 FROM EDGE  start near a face
#   R reseed   P pause   Esc quit
#
# Run: FLOW_HOST=python ./flow record examples/evoleco/replicator_dynamics.flow --frames 4

import "stdlib/gfx.flow"
import "stdlib/text.flow"

extern {
    function printf(fmt: string, val: f64) -> i32
    function fabs(x: f64) -> f64
    function sqrt(x: f64) -> f64
}

const WIN_W: i32 = 512
const WIN_H: i32 = 592
const FIELD_Y: i32 = 58
const MAX_FRAMES: i32 = 6000
const HIST: i32 = 300
const DT: f64 = 0.05
const STEPS: i32 = 2500

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20

function payoff(mat: i32, i: i32, j: i32) -> f64 {
    if mat == 0 {
        # Fair cyclic partnership game; NE at centre, asymptotically stable.
        if i == 0 and j == 0 { return 0.0 }
        if i == 0 and j == 1 { return 2.0 }
        if i == 0 and j == 2 { return 1.0 }
        if i == 1 and j == 0 { return 1.0 }
        if i == 1 and j == 1 { return 0.0 }
        if i == 1 and j == 2 { return 2.0 }
        if i == 2 and j == 0 { return 2.0 }
        if i == 2 and j == 1 { return 1.0 }
        if i == 2 and j == 2 { return 0.0 }
        return 0.0
    }
    # Biased: rest point n = (0.5, 0.3, 0.2) with (A n)_i equal.
    # A = [[0, -1, 6.5], [1, 0, 2.5], [-1, 5, 0]]
    if i == 0 and j == 0 { return 0.0 }
    if i == 0 and j == 1 { return 0.0 - 1.0 }
    if i == 0 and j == 2 { return 6.5 }
    if i == 1 and j == 0 { return 1.0 }
    if i == 1 and j == 1 { return 0.0 }
    if i == 1 and j == 2 { return 2.5 }
    if i == 2 and j == 0 { return 0.0 - 1.0 }
    if i == 2 and j == 1 { return 5.0 }
    if i == 2 and j == 2 { return 0.0 }
    return 0.0
}

function fitness_i(mat: i32, x0: f64, x1: f64, x2: f64, i: i32) -> f64 {
    return payoff(mat, i, 0) * x0 + payoff(mat, i, 1) * x1 + payoff(mat, i, 2) * x2
}

let mut nx0: f64 = 0.0
let mut nx1: f64 = 0.0
let mut nx2: f64 = 0.0

function replicator_step(mat: i32, x0: f64, x1: f64, x2: f64, dt: f64) -> void {
    let f0: f64 = fitness_i(mat, x0, x1, x2, 0)
    let f1: f64 = fitness_i(mat, x0, x1, x2, 1)
    let f2: f64 = fitness_i(mat, x0, x1, x2, 2)
    let wbar: f64 = x0 * f0 + x1 * f1 + x2 * f2
    let y0: f64 = x0 + dt * x0 * (f0 - wbar)
    let y1: f64 = x1 + dt * x1 * (f1 - wbar)
    let y2: f64 = x2 + dt * x2 * (f2 - wbar)
    let s: f64 = y0 + y1 + y2
    if s <= 0.0 {
        nx0 = x0
        nx1 = x1
        nx2 = x2
        return
    }
    nx0 = y0 / s
    nx1 = y1 / s
    nx2 = y2 / s
}

function dist3(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64) -> f64 {
    let d0: f64 = a0 - b0
    let d1: f64 = a1 - b1
    let d2: f64 = a2 - b2
    return sqrt(d0 * d0 + d1 * d1 + d2 * d2)
}

function nash_of(mat: i32) -> void {
    if mat == 0 {
        nx0 = 1.0 / 3.0
        nx1 = 1.0 / 3.0
        nx2 = 1.0 / 3.0
        return
    }
    nx0 = 0.5
    nx1 = 0.3
    nx2 = 0.2
}

function is_rest_point(mat: i32, x0: f64, x1: f64, x2: f64) -> bool {
    let f0: f64 = fitness_i(mat, x0, x1, x2, 0)
    let f1: f64 = fitness_i(mat, x0, x1, x2, 1)
    let f2: f64 = fitness_i(mat, x0, x1, x2, 2)
    let wbar: f64 = x0 * f0 + x1 * f1 + x2 * f2
    return fabs(f0 - wbar) < 1.0e-9 and fabs(f1 - wbar) < 1.0e-9 and fabs(f2 - wbar) < 1.0e-9
}

function run_to(mat: i32, x0: f64, x1: f64, x2: f64, steps: i32) -> void {
    let mut a: f64 = x0
    let mut b: f64 = x1
    let mut c: f64 = x2
    for t in 0 to steps {
        replicator_step(mat, a, b, c, DT)
        a = nx0
        b = nx1
        c = nx2
    }
    nx0 = a
    nx1 = b
    nx2 = c
}

let mut hx0: array<f64, 300> = [0.0, 0.0, 0.0, 0.0]
let mut hx1: array<f64, 300> = [0.0, 0.0, 0.0, 0.0]
let mut hx2: array<f64, 300> = [0.0, 0.0, 0.0, 0.0]
let mut hist_len: i32 = 0

function fill_history(mat: i32, x0: f64, x1: f64, x2: f64) -> void {
    let mut a: f64 = x0
    let mut b: f64 = x1
    let mut c: f64 = x2
    hist_len = 0
    for t in 0 to HIST {
        hx0[hist_len] = a
        hx1[hist_len] = b
        hx2[hist_len] = c
        hist_len = hist_len + 1
        replicator_step(mat, a, b, c, DT)
        a = nx0
        b = nx1
        c = nx2
    }
}

function simplex_x(x0: f64, x1: f64, x2: f64) -> i32 {
    let left: f64 = 60.0
    let right: f64 = 452.0
    let mid: f64 = 256.0
    return ((x0 * mid + x1 * left + x2 * right) as i32)
}

function simplex_y(x0: f64, x1: f64, x2: f64) -> i32 {
    let top: f64 = (FIELD_Y + 70) as f64
    let bot: f64 = (FIELD_Y + 360) as f64
    return ((x0 * top + x1 * bot + x2 * bot) as i32)
}

function preset_mat(p: i32) -> i32 {
    if p == 1 { return 1 }
    return 0
}

function preset_name(p: i32) -> string {
    if p == 1 { return "BIASED" }
    if p == 2 { return "FROM EDGE" }
    return "FAIR"
}

function start_of(p: i32) -> void {
    if p == 2 {
        nx0 = 0.02
        nx1 = 0.49
        nx2 = 0.49
        return
    }
    if p == 1 {
        nx0 = 0.8
        nx1 = 0.1
        nx2 = 0.1
        return
    }
    nx0 = 0.8
    nx1 = 0.15
    nx2 = 0.05
}

function draw_hud(g: Gfx, preset: i32, d: f64, x0: f64, x1: f64, x2: f64,
                  paused: bool) -> void {
    let t1: i32 = gfx_draw_text(g, 8, 8, "REPLICATOR DYNAMICS  3-STRATEGY SIMPLEX", 2,
                                238, 234, 246)
    let t2: i32 = gfx_draw_text(g, 8, 28, "MODE", 1, 150, 146, 168)
    let t3: i32 = gfx_draw_text(g, 40, 28, preset_name(preset), 1, 255, 198, 96)
    let t4: i32 = gfx_draw_text(g, 160, 28, "DIST", 1, 150, 146, 168)
    let t5: i32 = gfx_draw_fixed(g, 192, 28, d, 6, 1, 120, 255, 190)
    let t6: i32 = gfx_draw_text(g, 280, 28, "x", 1, 150, 146, 168)
    let t7: i32 = gfx_draw_fixed(g, 296, 28, x0, 3, 1, 234, 232, 244)
    let t8: i32 = gfx_draw_fixed(g, 350, 28, x1, 3, 1, 234, 232, 244)
    let t9: i32 = gfx_draw_fixed(g, 404, 28, x2, 3, 1, 234, 232, 244)
    let ta: i32 = gfx_draw_text(g, 8, 42,
        "1 FAIR  2 BIASED  3 FROM EDGE  R RESEED  P PAUSE", 1, 112, 108, 132)
    if paused {
        let tb: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let tc: i32 = gfx_draw_text(g, 8, 572,
        "dx_i/dt = x_i ((A x)_i - x^T A x)", 1, 122, 118, 144)
    let td: i32 = gfx_draw_text(g, 8, 582,
        "trajectory on the simplex gated against the Nash rest point", 1, 122, 118, 144)
}

function draw_scene(g: Gfx, mat: i32, cursor: i32) -> void {
    let ax: i32 = 256
    let ay: i32 = FIELD_Y + 70
    let bx: i32 = 60
    let by: i32 = FIELD_Y + 360
    let cx: i32 = 452
    let cy: i32 = FIELD_Y + 360
    gfx_fill_rect(g, ax - 2, ay - 2, 5, 5, 255, 198, 96)
    gfx_fill_rect(g, bx - 2, by - 2, 5, 5, 120, 220, 255)
    gfx_fill_rect(g, cx - 2, cy - 2, 5, 5, 255, 120, 160)
    let t0: i32 = gfx_draw_text(g, ax - 4, ay - 16, "1", 1, 255, 198, 96)
    let t1: i32 = gfx_draw_text(g, bx - 10, by + 8, "2", 1, 120, 220, 255)
    let t2: i32 = gfx_draw_text(g, cx + 4, cy + 8, "3", 1, 255, 120, 160)

    nash_of(mat)
    let nx: i32 = simplex_x(nx0, nx1, nx2)
    let ny: i32 = simplex_y(nx0, nx1, nx2)
    gfx_fill_rect(g, nx - 4, ny - 4, 9, 9, 255, 80, 80)

    for i in 0 to hist_len {
        let x: i32 = simplex_x(hx0[i], hx1[i], hx2[i])
        let y: i32 = simplex_y(hx0[i], hx1[i], hx2[i])
        gfx_fill_rect(g, x, y, 2, 2, 140, 200, 255)
    }
    let mut si: i32 = cursor
    if si >= hist_len { si = hist_len - 1 }
    let wx: i32 = simplex_x(hx0[si], hx1[si], hx2[si])
    let wy: i32 = simplex_y(hx0[si], hx1[si], hx2[si])
    gfx_fill_rect(g, wx - 3, wy - 3, 7, 7, 255, 230, 120)
}

function main() -> i32 {
    println("")
    println("  REPLICATOR DYNAMICS  --  three strategies to a Nash rest point")
    println("  ==============================================================")
    println("")

    let fair_rest: bool = is_rest_point(0, 1.0 / 3.0, 1.0 / 3.0, 1.0 / 3.0)
    let bias_rest: bool = is_rest_point(1, 0.5, 0.3, 0.2)
    print("    fair barycentre is a rest point   : ")
    if fair_rest { println("yes") } else { println("NO") }
    print("    biased (0.5, 0.3, 0.2) rest point  : ")
    if bias_rest { println("yes") } else { println("NO") }

    run_to(0, 0.8, 0.15, 0.05, STEPS)
    let d_fair_a: f64 = dist3(nx0, nx1, nx2, 1.0 / 3.0, 1.0 / 3.0, 1.0 / 3.0)
    run_to(0, 0.1, 0.8, 0.1, STEPS)
    let d_fair_b: f64 = dist3(nx0, nx1, nx2, 1.0 / 3.0, 1.0 / 3.0, 1.0 / 3.0)
    run_to(0, 0.05, 0.15, 0.8, STEPS)
    let d_fair_c: f64 = dist3(nx0, nx1, nx2, 1.0 / 3.0, 1.0 / 3.0, 1.0 / 3.0)

    run_to(1, 0.8, 0.1, 0.1, STEPS)
    let d_bias: f64 = dist3(nx0, nx1, nx2, 0.5, 0.3, 0.2)

    print("    fair distance from start A        : ")
    printf("%.6e", d_fair_a)
    println("")
    print("    fair distance from start B        : ")
    printf("%.6e", d_fair_b)
    println("")
    print("    fair distance from start C        : ")
    printf("%.6e", d_fair_c)
    println("")
    print("    biased distance from start        : ")
    printf("%.6e", d_bias)
    println("   gate 1e-4")
    println("")

    let fair_ok: bool = fair_rest and d_fair_a < 1.0e-4 and d_fair_b < 1.0e-4 and d_fair_c < 1.0e-4
    let bias_ok: bool = bias_rest and d_bias < 1.0e-4
    if !fair_ok {
        println("    FAIL: fair game did not converge to the barycentre")
        return 1
    }
    if !bias_ok {
        println("    FAIL: biased game did not converge to its Nash rest point")
        return 2
    }
    println("    PASS: three starts reach the Nash rest point on both games;")
    println("          distance gated below 1e-4")
    println("")

    let mut preset: i32 = 0
    let mut mat_live: i32 = preset_mat(preset)
    start_of(preset)
    fill_history(mat_live, nx0, nx1, nx2)

    let gfx: Gfx = gfx_open(WIN_W, WIN_H, "Replicator dynamics - Flow evoleco")
    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut reseed_held: bool = false
    let mut frame: i32 = 0
    let mut cursor: i32 = 0

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(gfx) { break }

        let mut want: i32 = -1
        if gfx_key_down(gfx, KEY_1) { want = 0 }
        if gfx_key_down(gfx, KEY_2) { want = 1 }
        if gfx_key_down(gfx, KEY_3) { want = 2 }
        if want >= 0 and want != preset {
            preset = want
            mat_live = preset_mat(preset)
            start_of(preset)
            fill_history(mat_live, nx0, nx1, nx2)
            cursor = 0
        }

        if gfx_key_down(gfx, KEY_R) {
            if !reseed_held {
                start_of(preset)
                fill_history(mat_live, nx0, nx1, nx2)
                cursor = 0
            }
            reseed_held = true
        } else {
            reseed_held = false
        }

        if gfx_key_down(gfx, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        if !paused {
            if cursor < hist_len - 1 {
                cursor = cursor + 1
            }
        }

        let mut si: i32 = cursor
        if si >= hist_len { si = hist_len - 1 }
        nash_of(mat_live)
        let d: f64 = dist3(hx0[si], hx1[si], hx2[si], nx0, nx1, nx2)
        gfx_clear(gfx, 12, 10, 18)
        draw_scene(gfx, mat_live, si)
        draw_hud(gfx, preset, d, hx0[si], hx1[si], hx2[si], paused)
        gfx_present(gfx)
        frame = frame + 1
    }

    gfx_close(gfx)
    return 0
}
