# HAMILTON'S RULE: spatial kin selection sustains cooperation when rB > C.
#
# MODEL
#   Donation game on a lattice: a cooperator pays cost C so that each of its
#   neighbours receives benefit B. Strategies update by imitation of the
#   highest-scoring Moore neighbour (Nowak-style). Local clustering builds
#   relatedness r between neighbours. Hamilton's rule predicts cooperation
#   when r B > C.
#
#   Relatedness is estimated from the lattice as the regression of partner
#   strategy on focal strategy among random neighbour pairs:
#
#        r ≈ (P_CC - p_C^2) / (p_C (1 - p_C))
#
#   which is the standard pair relatedness for a 0/1 trait.
#
# GATES
#   1. Well-mixed (mean-field) at B=5, C=1: cooperators go extinct.
#   2. Spatial with B=5, C=1 (rB > C once clusters form): coop density > 0.25.
#   3. Spatial with B=1.2, C=1 (even large r cannot satisfy rB > C): dens < 0.05.
#
# KEYS
#   1 rB>C persist   2 borderline   3 rB<C extinct
#   R reseed   P pause   Esc quit
#
# Run: FLOW_HOST=python ./flow record examples/evoleco/hamilton_rule.flow --frames 4

import "stdlib/gfx.flow"
import "stdlib/text.flow"

extern {
    function printf(fmt: string, val: f64) -> i32
    function fabs(x: f64) -> f64
}

const GRID: i32 = 48
const CELLS: i32 = 2304
const CELL_PX: i32 = 10
const FB_W: i32 = 512
const FB_H: i32 = 512
const FIELD_Y: i32 = 58
const WIN_W: i32 = 512
const WIN_H: i32 = 592
const MAX_FRAMES: i32 = 6000
const GEN_GATE: i32 = 250
const C_COST: f64 = 1.0

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20

let mut rng_state: u32 = 1357924680

function rng_next() -> u32 {
    rng_state = rng_state * 1664525 + 1013904223
    return rng_state
}

function rng_unit() -> f64 {
    let bits: i32 = ((rng_next() >> 9) % 65536) as i32
    return (bits as f64) / 65536.0
}

let mut grid: array<i32, 2304> = [0, 0, 0, 0]
let mut nextg: array<i32, 2304> = [0, 0, 0, 0]
let mut score: array<f64, 2304> = [0.0, 0.0, 0.0, 0.0]
let mut fb: array<u8, 786432> = [0, 0, 0, 0]

function seed_grid(frac_c: f64) -> void {
    for i in 0 to CELLS {
        if rng_unit() < frac_c {
            grid[i] = 1
        } else {
            grid[i] = 0
        }
    }
}

function coop_density() -> f64 {
    let mut s: i32 = 0
    for i in 0 to CELLS {
        s = s + grid[i]
    }
    return (s as f64) / (CELLS as f64)
}

function relatedness() -> f64 {
    let p: f64 = coop_density()
    if p < 1.0e-6 or p > 1.0 - 1.0e-6 { return 0.0 }
    let mut pairs: i32 = 0
    let mut both: i32 = 0
    for y in 0 to GRID {
        for x in 0 to GRID {
            let i: i32 = y * GRID + x
            # Four orthogonal neighbours.
            let n1: i32 = y * GRID + (x + 1) % GRID
            let n2: i32 = ((y + 1) % GRID) * GRID + x
            pairs = pairs + 2
            if grid[i] == 1 and grid[n1] == 1 { both = both + 1 }
            if grid[i] == 1 and grid[n2] == 1 { both = both + 1 }
        }
    }
    let pcc: f64 = (both as f64) / (pairs as f64)
    return (pcc - p * p) / (p * (1.0 - p))
}

function score_all(b: f64) -> void {
    for y in 0 to GRID {
        for x in 0 to GRID {
            let i: i32 = y * GRID + x
            let mut s: f64 = 0.0
            # Receive benefits from cooperating neighbours; pay if self cooperates.
            for dy in 0 to 3 {
                for dx in 0 to 3 {
                    if dx != 1 or dy != 1 {
                        let yy: i32 = (y + dy - 1 + GRID) % GRID
                        let xx: i32 = (x + dx - 1 + GRID) % GRID
                        let j: i32 = yy * GRID + xx
                        if grid[j] == 1 {
                            s = s + b
                        }
                    }
                }
            }
            if grid[i] == 1 {
                s = s - C_COST * 8.0
            }
            score[i] = s
        }
    }
}

function imitate(b: f64) -> void {
    score_all(b)
    for y in 0 to GRID {
        for x in 0 to GRID {
            let i: i32 = y * GRID + x
            let mut best_s: f64 = score[i]
            let mut best: i32 = grid[i]
            for dy in 0 to 3 {
                for dx in 0 to 3 {
                    let yy: i32 = (y + dy - 1 + GRID) % GRID
                    let xx: i32 = (x + dx - 1 + GRID) % GRID
                    let j: i32 = yy * GRID + xx
                    if score[j] > best_s + 1.0e-15 {
                        best_s = score[j]
                        best = grid[j]
                    }
                }
            }
            nextg[i] = best
        }
    }
    for i in 0 to CELLS {
        grid[i] = nextg[i]
    }
}

function run_spatial(b: f64, gens: i32) -> f64 {
    seed_grid(0.5)
    for g in 0 to gens {
        imitate(b)
    }
    return coop_density()
}

# Well-mixed replicator for the donation game: f_C = B p - C, f_D = B p.
# Actually each cooperator pays C once and gives B to each random partner;
# in well-mixed pair interaction: payoff_C = -C + B p, payoff_D = B p...
# wait standard donation: C gets -C + B * (partner coop), D gets B * (partner).
# Mean: f_C = -C + B p, f_D = B p, so f_C - f_D = -C < 0 always. Extinction.
function mean_field(b: f64, p0: f64, steps: i32) -> f64 {
    let mut p: f64 = p0
    let dt: f64 = 0.05
    for t in 0 to steps {
        let fc: f64 = 0.0 - C_COST + b * p
        let fd: f64 = b * p
        let wbar: f64 = p * fc + (1.0 - p) * fd
        p = p + dt * p * (fc - wbar)
        if p < 0.0 { p = 0.0 }
        if p > 1.0 { p = 1.0 }
    }
    return p
}

function preset_b(p: i32) -> f64 {
    if p == 1 { return 2.5 }
    if p == 2 { return 1.2 }
    return 5.0
}

function preset_name(p: i32) -> string {
    if p == 1 { return "BORDER" }
    if p == 2 { return "rB<C" }
    return "rB>C"
}

function paint_cell(x: i32, y: i32, r: i32, g2: i32, b: i32) -> void {
    let px: i32 = x * CELL_PX + 16
    let py: i32 = y * CELL_PX + 16
    for dy in 0 to CELL_PX - 1 {
        let mut o: i32 = ((py + dy) * FB_W + px) * 3
        for dx in 0 to CELL_PX - 1 {
            fb[o] = r as u8
            fb[o + 1] = g2 as u8
            fb[o + 2] = b as u8
            o = o + 3
        }
    }
}

function draw_field(g: Gfx) -> void {
    for i in 0 to FB_W * FB_H * 3 {
        fb[i] = 0
    }
    for y in 0 to GRID {
        for x in 0 to GRID {
            if grid[y * GRID + x] == 1 {
                paint_cell(x, y, 70, 180, 220)
            } else {
                paint_cell(x, y, 200, 70, 70)
            }
        }
    }
    gfx_blit_rgb(g, 0, FIELD_Y, FB_W, FB_H, fb)
}

function draw_hud(g: Gfx, preset: i32, b: f64, dens: f64, r: f64,
                  gen: i32, paused: bool) -> void {
    let t1: i32 = gfx_draw_text(g, 8, 8, "HAMILTON RULE", 2, 238, 234, 246)
    let t2: i32 = gfx_draw_text(g, 200, 12, preset_name(preset), 1, 255, 198, 96)
    let t3: i32 = gfx_draw_text(g, 290, 12, "GEN", 1, 150, 146, 168)
    let t4: i32 = gfx_draw_int(g, 318, 12, gen, 1, 234, 232, 244)

    let t5: i32 = gfx_draw_text(g, 8, 28, "B", 1, 150, 146, 168)
    let t6: i32 = gfx_draw_fixed(g, 22, 28, b, 2, 1, 234, 232, 244)
    let t7: i32 = gfx_draw_text(g, 70, 28, "C", 1, 150, 146, 168)
    let t8: i32 = gfx_draw_fixed(g, 84, 28, C_COST, 1, 1, 234, 232, 244)
    let t9: i32 = gfx_draw_text(g, 120, 28, "r", 1, 150, 146, 168)
    let ta: i32 = gfx_draw_fixed(g, 134, 28, r, 3, 1, 255, 198, 96)
    let tb: i32 = gfx_draw_text(g, 200, 28, "rB-C", 1, 150, 146, 168)
    let tc: i32 = gfx_draw_fixed(g, 240, 28, r * b - C_COST, 3, 1, 120, 255, 190)
    let td: i32 = gfx_draw_text(g, 320, 28, "COOP", 1, 150, 146, 168)
    let te: i32 = gfx_draw_fixed(g, 356, 28, dens, 3, 1, 120, 255, 190)

    let tf: i32 = gfx_draw_text(g, 8, 42,
        "1 rB>C  2 BORDER  3 rB<C  R RESEED  P PAUSE", 1, 112, 108, 132)
    if paused {
        let tg: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let th: i32 = gfx_draw_text(g, 8, 572,
        "blue = C, red = D; r from neighbour pair correlation",
        1, 122, 118, 144)
    let ti: i32 = gfx_draw_text(g, 8, 582,
        "well-mixed kills C for all B; space + relatedness can satisfy rB > C",
        1, 122, 118, 144)
}

function main() -> i32 {
    println("")
    println("  HAMILTON'S RULE  --  spatial kin selection vs well-mixed death")
    println("  =============================================================")
    println("")

    let mf: f64 = mean_field(5.0, 0.5, 20000)
    rng_state = 1357924680
    let dens_hi: f64 = run_spatial(5.0, GEN_GATE)
    let r_hi: f64 = relatedness()
    rng_state = 1357924680
    let dens_lo: f64 = run_spatial(1.2, GEN_GATE)

    print("    well-mixed density at B=5         : ")
    printf("%.4f", mf)
    println("   (gate < 0.01)")
    print("    spatial density at B=5            : ")
    printf("%.4f", dens_hi)
    println("   (gate > 0.25)")
    print("    relatedness after B=5 run         : ")
    printf("%.4f", r_hi)
    print("   rB-C = ")
    printf("%.4f", r_hi * 5.0 - C_COST)
    println("")
    print("    spatial density at B=1.2          : ")
    printf("%.4f", dens_lo)
    println("   (gate < 0.05)")
    println("")

    if mf > 0.01 {
        println("    FAIL: well-mixed did not extinguish cooperators")
        return 1
    }
    if dens_hi < 0.25 {
        println("    FAIL: spatial structure did not sustain cooperation at B=5")
        return 2
    }
    if dens_lo > 0.05 {
        println("    FAIL: cooperation survived when rB < C even for r~1")
        return 3
    }
    println("    PASS: well-mixed kills C; space sustains C when rB > C is")
    println("          attainable, and not when B <= C")
    println("")

    let mut preset: i32 = 0
    let mut b: f64 = preset_b(preset)
    rng_state = 1357924680
    seed_grid(0.5)

    let gfx: Gfx = gfx_open(WIN_W, WIN_H, "Hamilton rule - Flow evoleco")
    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut reseed_held: bool = false
    let mut frame: i32 = 0
    let mut gen: i32 = 0
    let mut since_cycle: i32 = 0

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(gfx) { break }

        let mut want: i32 = -1
        if gfx_key_down(gfx, KEY_1) { want = 0 }
        if gfx_key_down(gfx, KEY_2) { want = 1 }
        if gfx_key_down(gfx, KEY_3) { want = 2 }
        if want >= 0 and want != preset {
            preset = want
            b = preset_b(preset)
            seed_grid(0.5)
            gen = 0
            since_cycle = 0
        }

        if gfx_key_down(gfx, KEY_R) {
            if !reseed_held {
                seed_grid(0.5)
                gen = 0
                since_cycle = 0
            }
            reseed_held = true
        } else {
            reseed_held = false
        }

        if gfx_key_down(gfx, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        if !paused {
            imitate(b)
            gen = gen + 1
            since_cycle = since_cycle + 1
            if since_cycle >= 90 {
                preset = (preset + 1) % 3
                b = preset_b(preset)
                seed_grid(0.5)
                gen = 0
                since_cycle = 0
            }
        }

        gfx_clear(gfx, 12, 10, 18)
        draw_field(gfx)
        draw_hud(gfx, preset, b, coop_density(), relatedness(), gen, paused)
        gfx_present(gfx)
        frame = frame + 1
    }

    gfx_close(gfx)
    return 0
}
