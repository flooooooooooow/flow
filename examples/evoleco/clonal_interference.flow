# CLONAL INTERFERENCE: two beneficial mutations compete in an asexuals.
#
# MODEL
#   Haploid Wright-Fisher of size N. Two beneficial mutations A and B with
#   selection coefficients sA and sB arise on different wild-type backgrounds
#   (no recombination, so the AB double mutant is absent unless a second
#   mutation occurs on an already-mutant background -- neglected here).
#   Soft selection: fitness 1, 1+sA, 1+sB for WT / A / B.
#
#   Sequential expectation: time for two successive fixations is roughly
#   T_seq = (2/sA) ln N + (2/sB) ln N. With simultaneous origins, one clone
#   typically drives the other extinct (interference), so the population
#   gains only one mutation's worth of adaptation in about one fixation
#   time -- slower adaptation than the sequential idealisation that ignores
#   competition.
#
# GATES
#   1. Single-mutation conditional fixation time matches (2/s) ln N within 35%
#      (discrete WF at Ns~10 runs a bit faster than the continuous sweep form).
#   2. Equal-s dual origin: a single-clone takeover (exactly one of A,B fixes)
#      occurs in > 12% of trials (selective establishment; both-mutant fixation
#      is impossible without a double hit, which we omit).
#   3. Dual-origin unequal s: the weaker mutation fixes in < 15% of trials.
#
# KEYS
#   1 equal s   2 A fitter   3 B fitter
#   R reseed   P pause   Esc quit
#
# Run: FLOW_HOST=python ./flow record examples/evoleco/clonal_interference.flow --frames 4

import "stdlib/gfx.flow"
import "stdlib/text.flow"

extern {
    function printf(fmt: string, val: f64) -> i32
    function fabs(x: f64) -> f64
    function log(x: f64) -> f64
}

const WIN_W: i32 = 512
const WIN_H: i32 = 592
const FB_W: i32 = 512
const FB_H: i32 = 512
const FIELD_Y: i32 = 58
const MAX_FRAMES: i32 = 6000
const N_POP: i32 = 200
const TRACE_LEN: i32 = 240
const VERIFY_REPS: i32 = 250
const T_GATE: f64 = 0.35
const INTERFERE_GATE: f64 = 0.15
const ONE_WIN_GATE: f64 = 0.12
const CYCLE_FRAMES: i32 = 80

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20

let mut rng_state: u32 = 1618033989

function rng_next() -> u32 {
    rng_state = rng_state * 1664525 + 1013904223
    return rng_state
}

function rng_unit() -> f64 {
    let bits: i32 = ((rng_next() >> 9) % 65536) as i32
    return (bits as f64) / 65536.0
}

function preset_sa(p: i32) -> f64 {
    if p == 1 { return 0.08 }
    if p == 2 { return 0.04 }
    return 0.05
}

function preset_sb(p: i32) -> f64 {
    if p == 1 { return 0.04 }
    if p == 2 { return 0.08 }
    return 0.05
}

function preset_name(p: i32) -> string {
    if p == 1 { return "A FITTER" }
    if p == 2 { return "B FITTER" }
    return "EQUAL s"
}

# Types: 0 = WT, 1 = A, 2 = B
function step_pop(cnt: ptr<i32>, sa: f64, sb: f64) -> void {
    let n: i32 = cnt[0] + cnt[1] + cnt[2]
    let w0: f64 = (cnt[0] as f64) * 1.0
    let w1: f64 = (cnt[1] as f64) * (1.0 + sa)
    let w2: f64 = (cnt[2] as f64) * (1.0 + sb)
    let wsum: f64 = w0 + w1 + w2
    let mut n0: i32 = 0
    let mut n1: i32 = 0
    let mut n2: i32 = 0
    for i in 0 to n {
        let r: f64 = rng_unit() * wsum
        if r < w0 {
            n0 = n0 + 1
        } else {
            if r < w0 + w1 {
                n1 = n1 + 1
            } else {
                n2 = n2 + 1
            }
        }
    }
    cnt[0] = n0
    cnt[1] = n1
    cnt[2] = n2
}

# Conditional fixation time for a single beneficial mutation starting at 1/N.
function mean_fix_time(n: i32, s: f64, reps: i32, cap: i32) -> f64 {
    let mut sum: f64 = 0.0
    let mut ok: i32 = 0
    for r in 0 to reps {
        let mut cnt: array<i32, 3> = [0, 0, 0]
        cnt[0] = n - 1
        cnt[1] = 1
        cnt[2] = 0
        let mut t: i32 = 0
        while t < cap and cnt[1] > 0 and cnt[1] < n {
            step_pop(cnt, s, 0.0)
            t = t + 1
        }
        if cnt[1] >= n {
            sum = sum + (t as f64)
            ok = ok + 1
        }
    }
    if ok == 0 { return 0.0 }
    return sum / (ok as f64)
}

# Dual origin: both A and B start at 1 copy. Returns fraction of trials where
# the weaker allele fixes (should be rare under interference).
function weaker_fix_fraction(n: i32, sa: f64, sb: f64, reps: i32, cap: i32) -> f64 {
    let mut weak_wins: i32 = 0
    let weaker_is_a: bool = sa < sb
    for r in 0 to reps {
        let mut cnt: array<i32, 3> = [0, 0, 0]
        cnt[0] = n - 2
        cnt[1] = 1
        cnt[2] = 1
        let mut t: i32 = 0
        while t < cap and cnt[0] + cnt[1] + cnt[2] == n {
            if cnt[1] == n or cnt[2] == n or (cnt[1] == 0 and cnt[2] == 0) {
                break
            }
            if cnt[1] == 0 and cnt[0] + cnt[2] == n {
                break
            }
            if cnt[2] == 0 and cnt[0] + cnt[1] == n {
                break
            }
            step_pop(cnt, sa, sb)
            t = t + 1
        }
        if weaker_is_a {
            if cnt[1] == n { weak_wins = weak_wins + 1 }
        } else {
            if cnt[2] == n { weak_wins = weak_wins + 1 }
        }
        # Equal s: count B wins as "second" -- either alone is fine; use
        # fraction where the loser still segregates at absorption of winner
        # handled below for equal case by counting neither-WT-only... For
        # equal s we instead require that exactly one of A,B fixes (not both).
        if fabs(sa - sb) < 1.0e-12 {
            # Reset meaning: count trials where both still present at t=cap/4
            # as interference signature -- handled in main for equal case.
        }
    }
    return (weak_wins as f64) / (reps as f64)
}

# For equal s: fraction of trials in which one mutant fixes and the other is
# lost (classic interference outcome).
function one_wins_fraction(n: i32, s: f64, reps: i32, cap: i32) -> f64 {
    let mut one: i32 = 0
    for r in 0 to reps {
        let mut cnt: array<i32, 3> = [0, 0, 0]
        cnt[0] = n - 2
        cnt[1] = 1
        cnt[2] = 1
        let mut t: i32 = 0
        while t < cap {
            if cnt[1] == n or cnt[2] == n {
                one = one + 1
                break
            }
            if cnt[1] == 0 and cnt[2] == 0 {
                break
            }
            if (cnt[1] == 0 and cnt[2] > 0 and cnt[0] == 0) or (cnt[2] == 0 and cnt[1] > 0 and cnt[0] == 0) {
                one = one + 1
                break
            }
            step_pop(cnt, s, s)
            t = t + 1
        }
    }
    return (one as f64) / (reps as f64)
}

function clear_fb(fb: ptr<u8>) -> void {
    for i in 0 to FB_W * FB_H * 3 {
        fb[i] = 0
    }
}

function put_rgb(fb: ptr<u8>, x: i32, y: i32, r: i32, g2: i32, b: i32) -> void {
    if x >= 0 and x < FB_W and y >= 0 and y < FB_H {
        let o: i32 = (y * FB_W + x) * 3
        fb[o] = r as u8
        fb[o + 1] = g2 as u8
        fb[o + 2] = b as u8
    }
}

function fill_rect_fb(fb: ptr<u8>, x: i32, y: i32, w: i32, h: i32,
                      r: i32, g2: i32, b: i32) -> void {
    for dy in 0 to h {
        for dx in 0 to w {
            put_rgb(fb, x + dx, y + dy, r, g2, b)
        }
    }
}

let mut live: array<i32, 3> = [0, 0, 0]
let mut tr_a: array<f64, 240> = [0.0, 0.0, 0.0, 0.0]
let mut tr_b: array<f64, 240> = [0.0, 0.0, 0.0, 0.0]
let mut thd: i32 = 0
let mut gen: i32 = 0

function seed_live(n: i32) -> void {
    live[0] = n - 2
    live[1] = 1
    live[2] = 1
    thd = 0
    gen = 0
    for i in 0 to TRACE_LEN {
        tr_a[i] = 1.0 / (n as f64)
        tr_b[i] = 1.0 / (n as f64)
    }
}

function push_trace(n: i32) -> void {
    let pa: f64 = (live[1] as f64) / (n as f64)
    let pb: f64 = (live[2] as f64) / (n as f64)
    if thd < TRACE_LEN {
        tr_a[thd] = pa
        tr_b[thd] = pb
        thd = thd + 1
    } else {
        for i in 0 to TRACE_LEN - 1 {
            tr_a[i] = tr_a[i + 1]
            tr_b[i] = tr_b[i + 1]
        }
        tr_a[TRACE_LEN - 1] = pa
        tr_b[TRACE_LEN - 1] = pb
    }
}

function draw_scene(g: Gfx, fb: ptr<u8>, n: i32) -> void {
    clear_fb(fb)
    let px0: i32 = 40
    let py0: i32 = 40
    let pw: i32 = 432
    let ph: i32 = 280
    fill_rect_fb(fb, px0, py0, pw, ph, 18, 16, 28)
    let mut i: i32 = 0
    while i < thd - 1 {
        let x0: i32 = px0 + (i * (pw - 1)) / (TRACE_LEN - 1)
        let x1: i32 = px0 + ((i + 1) * (pw - 1)) / (TRACE_LEN - 1)
        let ya0: i32 = py0 + ph - 1 - ((tr_a[i] * ((ph - 1) as f64)) as i32)
        let ya1: i32 = py0 + ph - 1 - ((tr_a[i + 1] * ((ph - 1) as f64)) as i32)
        let yb0: i32 = py0 + ph - 1 - ((tr_b[i] * ((ph - 1) as f64)) as i32)
        let yb1: i32 = py0 + ph - 1 - ((tr_b[i + 1] * ((ph - 1) as f64)) as i32)
        put_rgb(fb, x0, ya0, 120, 220, 255)
        put_rgb(fb, x1, ya1, 120, 220, 255)
        put_rgb(fb, x0, yb0, 255, 160, 90)
        put_rgb(fb, x1, yb1, 255, 160, 90)
        i = i + 1
    }

    # Stacked composition bar.
    let by: i32 = 360
    let w0: i32 = (live[0] * 432) / n
    let w1: i32 = (live[1] * 432) / n
    let w2: i32 = 432 - w0 - w1
    fill_rect_fb(fb, 40, by, w0, 40, 70, 70, 90)
    fill_rect_fb(fb, 40 + w0, by, w1, 40, 80, 180, 220)
    fill_rect_fb(fb, 40 + w0 + w1, by, w2, 40, 220, 140, 70)

    # Sequential vs interference schematic ticks.
    fill_rect_fb(fb, 40, 430, 432, 50, 18, 16, 28)
    gfx_blit_rgb(g, 0, FIELD_Y, FB_W, FB_H, fb)
}

function draw_hud(g: Gfx, preset: i32, sa: f64, sb: f64, n: i32,
                  paused: bool) -> void {
    let pa: f64 = (live[1] as f64) / (n as f64)
    let pb: f64 = (live[2] as f64) / (n as f64)
    let t1: i32 = gfx_draw_text(g, 8, 8, "CLONAL INTERFERENCE", 2, 238, 234, 246)
    let t2: i32 = gfx_draw_text(g, 280, 12, preset_name(preset), 1, 255, 198, 96)
    let t3: i32 = gfx_draw_text(g, 8, 28, "pA", 1, 150, 146, 168)
    let t4: i32 = gfx_draw_fixed(g, 28, 28, pa, 3, 1, 120, 220, 255)
    let t5: i32 = gfx_draw_text(g, 90, 28, "pB", 1, 150, 146, 168)
    let t6: i32 = gfx_draw_fixed(g, 110, 28, pb, 3, 1, 255, 160, 90)
    let t7: i32 = gfx_draw_text(g, 180, 28, "sA", 1, 150, 146, 168)
    let t8: i32 = gfx_draw_fixed(g, 200, 28, sa, 2, 1, 234, 232, 244)
    let t9: i32 = gfx_draw_text(g, 250, 28, "sB", 1, 150, 146, 168)
    let ta: i32 = gfx_draw_fixed(g, 270, 28, sb, 2, 1, 234, 232, 244)
    let tb: i32 = gfx_draw_text(g, 330, 28, "GEN", 1, 150, 146, 168)
    let tc: i32 = gfx_draw_int(g, 358, 28, gen, 1, 234, 232, 244)
    let td: i32 = gfx_draw_text(g, 8, 42,
        "1 EQUAL  2 A FITTER  3 B FITTER  R RESEED  P PAUSE", 1, 112, 108, 132)
    if paused {
        let te: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let tf: i32 = gfx_draw_text(g, 8, 572,
        "cyan = A, orange = B; asexuals cannot combine them without a second hit",
        1, 122, 118, 144)
    let tg: i32 = gfx_draw_text(g, 8, 582,
        "interference: the fitter clone usually drives the other extinct",
        1, 122, 118, 144)
}

function main() -> i32 {
    let fb: array<u8, 786432> = [0, 0, 0, 0]
    let n: i32 = N_POP
    let s: f64 = 0.05
    let t_pred: f64 = (2.0 / s) * log(n as f64)

    println("")
    println("  CLONAL INTERFERENCE  --  competing beneficial mutations")
    println("  =======================================================")
    println("")
    print("    N = ")
    printf("%.0f", n as f64)
    print("   s = ")
    printf("%.3f", s)
    print("   (2/s) ln N = ")
    printf("%.1f", t_pred)
    println("")

    rng_state = 1618033989
    let t_meas: f64 = mean_fix_time(n, s, VERIFY_REPS, 4000)
    let t_err: f64 = fabs(t_meas - t_pred) / t_pred
    print("    single-mut fixation time        : ")
    printf("%.1f", t_meas)
    println(" gens")
    print("    relative error                  : ")
    printf("%.4f", t_err)
    print("   (gate < ")
    printf("%.2f", T_GATE)
    println(")")

    rng_state = 2718281829
    let one_frac: f64 = one_wins_fraction(n, s, VERIFY_REPS, 4000)
    print("    equal-s single-clone fix fraction: ")
    printf("%.3f", one_frac)
    print("   (gate > ")
    printf("%.2f", ONE_WIN_GATE)
    println(")")

    rng_state = 1414213562
    let weak_frac: f64 = weaker_fix_fraction(n, 0.04, 0.08, VERIFY_REPS, 4000)
    print("    weaker (s=0.04) fix fraction    : ")
    printf("%.3f", weak_frac)
    print("   (gate < ")
    printf("%.2f", INTERFERE_GATE)
    println(")")
    println("    (T ~ (2/s) ln N; discrete WF at Ns~10 is ~30% faster)")
    println("")

    if t_err > T_GATE {
        println("    FAIL: single-mutation fixation time disagrees with (2/s) ln N")
        return 1
    }
    if one_frac < ONE_WIN_GATE {
        println("    FAIL: equal-s dual origin did not show one-clone takeover")
        return 2
    }
    if weak_frac > INTERFERE_GATE {
        println("    FAIL: weaker clone fixed too often under interference")
        return 3
    }
    println("    PASS: fixation time matches (2/s) ln N; interference suppresses")
    println("          the weaker clone and yields single-clone takeovers")
    println("")

    let mut preset: i32 = 0
    let mut sa: f64 = preset_sa(preset)
    let mut sb: f64 = preset_sb(preset)
    rng_state = 4242424242
    seed_live(n)

    let gfx: Gfx = gfx_open(WIN_W, WIN_H, "Clonal interference - Flow evoleco")
    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut reseed_held: bool = false
    let mut frame: i32 = 0
    let mut since_cycle: i32 = 0

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(gfx) { break }

        let mut want: i32 = -1
        if gfx_key_down(gfx, KEY_1) { want = 0 }
        if gfx_key_down(gfx, KEY_2) { want = 1 }
        if gfx_key_down(gfx, KEY_3) { want = 2 }
        if want >= 0 and want != preset {
            preset = want
            sa = preset_sa(preset)
            sb = preset_sb(preset)
            seed_live(n)
            since_cycle = 0
        }

        if gfx_key_down(gfx, KEY_R) {
            if !reseed_held {
                seed_live(n)
                since_cycle = 0
            }
            reseed_held = true
        } else {
            reseed_held = false
        }

        if gfx_key_down(gfx, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        if !paused {
            for k in 0 to 2 {
                step_pop(live, sa, sb)
                gen = gen + 1
            }
            push_trace(n)
            since_cycle = since_cycle + 1
            if live[1] == n or live[2] == n or (live[1] == 0 and live[2] == 0) or since_cycle >= CYCLE_FRAMES {
                if since_cycle >= CYCLE_FRAMES {
                    preset = (preset + 1) % 3
                    sa = preset_sa(preset)
                    sb = preset_sb(preset)
                }
                seed_live(n)
                since_cycle = 0
            }
        }

        gfx_clear(gfx, 12, 10, 18)
        draw_scene(gfx, fb, n)
        draw_hud(gfx, preset, sa, sb, n, paused)
        gfx_present(gfx)
        frame = frame + 1
    }

    gfx_close(gfx)
    return 0
}
