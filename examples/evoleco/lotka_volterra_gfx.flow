# LOTKA-VOLTERRA (graphics): orbits and the conserved first integral.
#
# Companion to examples/evolution/lotka_volterra.flow. Same two-line model,
# same first integral
#
#   V(x, y) = d x - c ln x + b y - a ln y
#
# drawn as a live phase portrait. The headless gate checks that V drifts by
# less than 1e-9 over several periods under the generated RK4 step -- the same
# evidence standard as the text companion, with a picture attached.
#
# KEYS
#   1 SMALL orbit    2 MEDIUM    3 LARGE
#   R reseed   P pause   Esc quit
#
# Run: FLOW_HOST=python ./flow record examples/evoleco/lotka_volterra_gfx.flow --frames 4

import "stdlib/gfx.flow"
import "stdlib/text.flow"

extern {
    function printf(fmt: string, val: f64) -> i32
    function fabs(x: f64) -> f64
    function log(x: f64) -> f64
    function sqrt(x: f64) -> f64
}

const WIN_W: i32 = 512
const WIN_H: i32 = 592
const FIELD_Y: i32 = 58
const MAX_FRAMES: i32 = 6000
const HIST: i32 = 400
const A: f64 = 1.0
const B: f64 = 0.1
const C: f64 = 0.5
const D: f64 = 0.02
const DT: f64 = 2.0e-4
const TWO_PI: f64 = 6.283185307179586

const KEY_P: i32 = 35
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20

flow LotkaVolterra {
    state x : f64 = 25.0
    state y : f64 = 10.0

    param a : f64 = 1.0
    param b : f64 = 0.1
    param c : f64 = 0.5
    param d : f64 = 0.02

    solver { dt 200 us  method rk4 }

    x evolves as a * x - b * x * y
    y evolves as 0.0 - c * y + d * x * y
}

function first_integral(s: LotkaVolterra) -> f64 {
    return s.d * s.x - s.c * log(s.x) + s.b * s.y - s.a * log(s.y)
}

let mut hx: array<f64, 400> = [0.0, 0.0, 0.0, 0.0]
let mut hy: array<f64, 400> = [0.0, 0.0, 0.0, 0.0]
let mut hist_len: i32 = 0
let mut v0_live: f64 = 0.0
let mut v_drift_live: f64 = 0.0

function preset_x0(p: i32) -> f64 {
    if p == 1 { return 35.0 }
    if p == 2 { return 55.0 }
    return 27.5
}

function preset_name(p: i32) -> string {
    if p == 1 { return "MEDIUM" }
    if p == 2 { return "LARGE" }
    return "SMALL"
}

function fill_orbit(x0: f64) -> void {
    let mut s: LotkaVolterra = LotkaVolterra_new()
    s.a = A
    s.b = B
    s.c = C
    s.d = D
    s.x = x0
    s.y = A / B
    v0_live = first_integral(s)
    v_drift_live = 0.0
    hist_len = 0
    let sub: i32 = 40
    for t in 0 to HIST {
        hx[hist_len] = s.x
        hy[hist_len] = s.y
        hist_len = hist_len + 1
        for k in 0 to sub {
            LotkaVolterra_step(&s, DT)
        }
        let dev: f64 = fabs(first_integral(s) - v0_live) / fabs(v0_live)
        if dev > v_drift_live { v_drift_live = dev }
    }
}

function measure_drift(x0: f64, cycles: i32) -> f64 {
    let mut s: LotkaVolterra = LotkaVolterra_new()
    s.a = A
    s.b = B
    s.c = C
    s.d = D
    s.x = x0
    s.y = A / B
    let v0: f64 = first_integral(s)
    let ystar: f64 = A / B
    let mut drift: f64 = 0.0
    let mut seen: i32 = 0
    let mut first: bool = true
    let budget: i32 = 5000000
    for k in 0 to budget {
        let py: f64 = s.y
        LotkaVolterra_step(&s, DT)
        let dev: f64 = fabs(first_integral(s) - v0) / fabs(v0)
        if dev > drift { drift = dev }
        if py < ystar and s.y >= ystar {
            if first {
                first = false
            } else {
                seen = seen + 1
                if seen >= cycles { break }
            }
        }
    }
    return drift
}

function draw_hud(g: Gfx, preset: i32, drift: f64, x: f64, y: f64,
                  paused: bool) -> void {
    let t1: i32 = gfx_draw_text(g, 8, 8, "LOTKA VOLTERRA  FIRST INTEGRAL", 2, 238, 234, 246)
    let t2: i32 = gfx_draw_text(g, 8, 28, "MODE", 1, 150, 146, 168)
    let t3: i32 = gfx_draw_text(g, 40, 28, preset_name(preset), 1, 255, 198, 96)
    let t4: i32 = gfx_draw_text(g, 120, 28, "x", 1, 150, 146, 168)
    let t5: i32 = gfx_draw_fixed(g, 136, 28, x, 2, 1, 234, 232, 244)
    let t6: i32 = gfx_draw_text(g, 200, 28, "y", 1, 150, 146, 168)
    let t7: i32 = gfx_draw_fixed(g, 216, 28, y, 2, 1, 234, 232, 244)
    let t8: i32 = gfx_draw_text(g, 290, 28, "V DRIFT", 1, 150, 146, 168)
    let t9: i32 = gfx_draw_fixed(g, 346, 28, drift, 2, 1, 120, 255, 190)
    let ta: i32 = gfx_draw_text(g, 420, 28, "e-9", 1, 120, 255, 190)
    let tb: i32 = gfx_draw_text(g, 8, 42,
        "1 SMALL  2 MEDIUM  3 LARGE  R RESEED  P PAUSE", 1, 112, 108, 132)
    if paused {
        let tc: i32 = gfx_draw_text(g, 430, 8, "PAUSED", 2, 255, 120, 120)
    }
    let td: i32 = gfx_draw_text(g, 8, 572,
        "x' = a x - b x y     y' = -c y + d x y", 1, 122, 118, 144)
    let te: i32 = gfx_draw_text(g, 8, 582,
        "V = d x - c ln x + b y - a ln y  is constant on every orbit", 1, 122, 118, 144)
}

function draw_scene(g: Gfx, cursor: i32) -> void {
    let x0: i32 = 40
    let y0: i32 = FIELD_Y + 40
    let w: i32 = 432
    let h: i32 = 400
    gfx_fill_rect(g, x0, y0, w, h, 22, 20, 32)

    let xstar: f64 = C / D
    let ystar: f64 = A / B
    # Axis ranges from the orbit envelope.
    let mut xmin: f64 = hx[0]
    let mut xmax: f64 = hx[0]
    let mut ymin: f64 = hy[0]
    let mut ymax: f64 = hy[0]
    for i in 1 to hist_len {
        if hx[i] < xmin { xmin = hx[i] }
        if hx[i] > xmax { xmax = hx[i] }
        if hy[i] < ymin { ymin = hy[i] }
        if hy[i] > ymax { ymax = hy[i] }
    }
    let mut xspan: f64 = xmax - xmin
    let mut yspan: f64 = ymax - ymin
    if xspan < 1.0 { xspan = 1.0 }
    if yspan < 1.0 { yspan = 1.0 }
    xmin = xmin - 0.05 * xspan
    xmax = xmax + 0.05 * xspan
    ymin = ymin - 0.05 * yspan
    ymax = ymax + 0.05 * yspan
    xspan = xmax - xmin
    yspan = ymax - ymin

    # Equilibrium cross.
    let ex: i32 = x0 + ((((xstar - xmin) / xspan) * (w as f64)) as i32)
    let ey: i32 = y0 + h - ((((ystar - ymin) / yspan) * (h as f64)) as i32)
    gfx_fill_rect(g, ex - 3, ey - 3, 7, 7, 255, 80, 80)

    for i in 0 to hist_len {
        let px: i32 = x0 + ((((hx[i] - xmin) / xspan) * (w as f64)) as i32)
        let py: i32 = y0 + h - ((((hy[i] - ymin) / yspan) * (h as f64)) as i32)
        gfx_fill_rect(g, px, py, 2, 2, 120, 220, 255)
    }
    let mut si: i32 = cursor
    if si >= hist_len { si = hist_len - 1 }
    let wx: i32 = x0 + ((((hx[si] - xmin) / xspan) * (w as f64)) as i32)
    let wy: i32 = y0 + h - ((((hy[si] - ymin) / yspan) * (h as f64)) as i32)
    gfx_fill_rect(g, wx - 3, wy - 3, 7, 7, 255, 198, 96)
}

function main() -> i32 {
    println("")
    println("  LOTKA-VOLTERRA GFX  --  orbits and the conserved first integral")
    println("  ===============================================================")
    println("")
    let xstar: f64 = C / D
    let ystar: f64 = A / B
    print("    equilibrium (c/d, a/b)             : (")
    printf("%.2f", xstar)
    print(", ")
    printf("%.2f", ystar)
    println(")")
    print("    small-orbit period 2pi/sqrt(a c)  : ")
    printf("%.6f", TWO_PI / sqrt(A * C))
    println("")
    println("")

    let d_small: f64 = measure_drift(27.5, 8)
    let d_med: f64 = measure_drift(35.0, 8)
    let d_large: f64 = measure_drift(55.0, 8)
    print("    V drift, small orbit (8 periods)  : ")
    printf("%.3e", d_small)
    println("")
    print("    V drift, medium orbit             : ")
    printf("%.3e", d_med)
    println("")
    print("    V drift, large orbit              : ")
    printf("%.3e", d_large)
    println("   gate 1e-9")
    println("")

    let mut worst: f64 = d_small
    if d_med > worst { worst = d_med }
    if d_large > worst { worst = d_large }
    if worst != worst {
        println("    FAIL: a measured quantity is NaN")
        return 1
    }
    if worst > 1.0e-9 {
        println("    FAIL: the first integral drifted past the gate")
        return 2
    }
    println("    PASS: V = d x - c ln x + b y - a ln y holds to 1e-9 over")
    println("          eight periods at three amplitudes")
    println("")

    let mut preset: i32 = 0
    fill_orbit(preset_x0(preset))

    let gfx: Gfx = gfx_open(WIN_W, WIN_H, "Lotka-Volterra - Flow evoleco")
    let mut paused: bool = false
    let mut pause_held: bool = false
    let mut reseed_held: bool = false
    let mut frame: i32 = 0
    let mut cursor: i32 = 0

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(gfx) { break }

        let mut want: i32 = -1
        if gfx_key_down(gfx, KEY_1) { want = 0 }
        if gfx_key_down(gfx, KEY_2) { want = 1 }
        if gfx_key_down(gfx, KEY_3) { want = 2 }
        if want >= 0 and want != preset {
            preset = want
            fill_orbit(preset_x0(preset))
            cursor = 0
        }

        if gfx_key_down(gfx, KEY_R) {
            if !reseed_held {
                fill_orbit(preset_x0(preset))
                cursor = 0
            }
            reseed_held = true
        } else {
            reseed_held = false
        }

        if gfx_key_down(gfx, KEY_P) {
            if !pause_held { paused = !paused }
            pause_held = true
        } else {
            pause_held = false
        }

        if !paused {
            if cursor < hist_len - 1 {
                cursor = cursor + 1
            } else {
                cursor = 0
            }
        }

        let mut si: i32 = cursor
        if si >= hist_len { si = hist_len - 1 }
        gfx_clear(gfx, 12, 10, 18)
        draw_scene(gfx, si)
        draw_hud(gfx, preset, v_drift_live * 1.0e9, hx[si], hy[si], paused)
        gfx_present(gfx)
        frame = frame + 1
    }

    gfx_close(gfx)
    return 0
}
