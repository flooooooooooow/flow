# FLOW Shader Language — photoreal material-ball gallery
#
# 60 PBR-style material studies. Together with shader_photoreal.flow's four
# ray-marched scenes this gives the photoreal gallery 64 runnable examples.

fn gallery_env(d: vec3, mode: f32) -> vec3 {
    let h: f32 = clamp(d.y * 0.5 + 0.5, 0.0, 1.0)
    let sun_dir: vec3 = normalize(vec3(-0.45, 0.55, -0.70))
    let s: f32 = max(dot(d, sun_dir), 0.0)
    let glow: f32 = pow(s, 12.0)
    let sun: f32 = pow(s, 180.0)
    if mode < 0.5 {
        return mix(vec3(0.72, 0.78, 0.88), vec3(0.07, 0.14, 0.28), h) + vec3(1.0, 0.82, 0.58) * glow * 0.35 + vec3(1.0) * sun * 3.0
    } else if mode < 1.5 {
        return mix(vec3(1.0, 0.32, 0.08), vec3(0.15, 0.03, 0.20), h) + vec3(1.0, 0.52, 0.12) * glow * 0.8 + vec3(1.0, 0.82, 0.42) * sun * 4.0
    } else if mode < 2.5 {
        return mix(vec3(0.68, 0.72, 0.76), vec3(0.30, 0.36, 0.44), h) + vec3(0.92, 0.96, 1.0) * glow * 0.15
    } else if mode < 3.5 {
        let stars: f32 = step(0.985, hash(floor(d.xz * 120.0)))
        return mix(vec3(0.03, 0.01, 0.07), vec3(0.006, 0.012, 0.04), h) + vec3(stars) * 0.75
    } else if mode < 4.5 {
        return mix(vec3(0.98, 0.62, 0.30), vec3(0.24, 0.48, 0.78), h) + vec3(1.0, 0.88, 0.56) * glow * 0.5 + vec3(1.0) * sun * 4.5
    } else if mode < 5.5 {
        let city: f32 = step(0.92, hash(floor(d.xz * 36.0))) * smoothstep(0.28, 0.0, abs(d.y + 0.08))
        return mix(vec3(0.04, 0.06, 0.16), vec3(0.008, 0.012, 0.05), h) + vec3(1.0, 0.12, 0.62) * city * 1.7
    } else if mode < 6.5 {
        return mix(vec3(0.76, 0.88, 0.96), vec3(0.18, 0.34, 0.56), h) + vec3(0.86, 0.94, 1.0) * glow * 0.25
    } else {
        let c: f32 = 0.5 + 0.5 * sin(d.x * 38.0 + d.z * 29.0)
        return mix(vec3(0.02, 0.34, 0.40), vec3(0.004, 0.05, 0.12), h) + vec3(0.08, 0.62, 0.56) * c * 0.16
    }
}

fn gallery_pattern(p: vec3, base: vec3, accent: vec3, mode: f32) -> vec3 {
    if mode < 0.5 {
        return base * (0.95 + 0.05 * fbm(p.xz * 8.0))
    } else if mode < 1.5 {
        let b: f32 = 0.88 + 0.12 * sin(p.y * 165.0 + fbm(p.xz * 12.0) * 5.0)
        return mix(base * b, accent, 0.08)
    } else if mode < 2.5 {
        let w: f32 = fbm(p.xz * 2.6 + vec2(p.y * 0.7, p.y * 0.3))
        let v: f32 = smoothstep(0.74, 0.94, 0.5 + 0.5 * sin((p.x + p.z) * 7.0 + w * 15.0))
        return mix(base, accent, v * 0.82)
    } else if mode < 3.5 {
        let w: f32 = fbm(p.xy * 3.5)
        let r: f32 = 0.5 + 0.5 * sin(length(p.xz) * 24.0 + w * 9.0)
        return mix(base, accent, smoothstep(0.30, 0.78, r) * 0.62)
    } else if mode < 4.5 {
        let n: f32 = fbm(p.xz * 18.0 + p.xy * 3.0)
        return mix(base, accent, smoothstep(0.54, 0.78, n) * 0.46)
    } else if mode < 5.5 {
        let w: f32 = 0.5 + 0.5 * sin(p.x * 92.0) * sin(p.y * 88.0)
        return mix(base * 0.72, accent, w * 0.34)
    } else if mode < 6.5 {
        let cell: f32 = mod(floor(p.x * 12.0) + floor(p.y * 12.0), 2.0)
        return mix(base, accent, cell * 0.34)
    } else {
        let w: f32 = fbm(p.xz * 5.0 + p.xy * 1.7)
        let b: f32 = 0.5 + 0.5 * sin((p.x + p.y + p.z) * 13.0 + w * 11.0)
        return mix(base, accent, smoothstep(0.42, 0.72, b) * 0.72)
    }
}

fn gallery_tonemap(c: vec3) -> vec3 {
    let x: vec3 = max(c, vec3(0.0))
    return x / (x + vec3(1.0))
}

fn gallery_ball(
    screen: vec2,
    t: f32,
    base: vec3,
    accent: vec3,
    metal: f32,
    roughness: f32,
    pattern: f32,
    environment: f32,
    transmission: f32,
    eta: f32,
    emission: f32
) -> vec3 {
    let ro: vec3 = vec3(0.0, 0.0, 2.75)
    let rd: vec3 = normalize(vec3(screen.x, screen.y, -1.85))
    let b: f32 = dot(ro, rd)
    let c: f32 = dot(ro, ro) - 0.82 * 0.82
    let h: f32 = b * b - c
    var col: vec3 = gallery_env(rd, environment)

    if h > 0.0 {
        let travel: f32 = -b - sqrt(h)
        let p: vec3 = ro + rd * travel
        let n: vec3 = normalize(p)
        let view: vec3 = normalize(ro - p)
        let light: vec3 = normalize(vec3(-0.48, 0.78, 0.42))
        let half_dir: vec3 = normalize(light + view)
        let ndl: f32 = max(dot(n, light), 0.0)
        let facing: f32 = max(dot(n, view), 0.0)
        let fresnel: f32 = pow(1.0 - facing, 5.0)
        let mat: vec3 = gallery_pattern(p, base, accent, pattern)
        let spec_power: f32 = mix(190.0, 10.0, clamp(roughness, 0.0, 1.0))
        let spec: f32 = pow(max(dot(n, half_dir), 0.0), spec_power)
        let reflected: vec3 = gallery_env(reflect(-view, n), environment)
        let f0: f32 = mix(0.04, 0.72, clamp(metal, 0.0, 1.0))
        let reflectance: f32 = f0 + (1.0 - f0) * fresnel
        let diffuse: vec3 = mat * (0.08 + ndl * 1.42) * (1.0 - metal) * (1.0 - transmission)
        col = diffuse + reflected * reflectance * (0.34 + metal * 0.92) + vec3(spec) * reflectance * 1.75

        if transmission > 0.01 {
            let rr: vec3 = refract(rd, n, eta * 0.985)
            let rg: vec3 = refract(rd, n, eta)
            let rb: vec3 = refract(rd, n, eta * 1.015)
            let through: vec3 = vec3(gallery_env(rr, environment).r, gallery_env(rg, environment).g, gallery_env(rb, environment).b)
            col = mix(col, through * mix(vec3(1.0), mat, 0.46), transmission * (1.0 - fresnel)) + reflected * fresnel * transmission
        }

        if pattern > 6.5 {
            let irid: f32 = 0.5 + 0.5 * sin(facing * 25.0 + fbm(p.xz * 4.0) * 7.0)
            col = col + accent * irid * (0.10 + metal * 0.10)
        }

        if emission > 0.0 {
            let pulse: f32 = 0.72 + 0.28 * sin(t * 2.1 + fbm(p.xz * 4.0) * 6.0)
            col = col + mix(mat, accent, 0.55) * emission * pulse
        }

        let contact: f32 = smoothstep(-0.80, -0.15, p.y)
        col = col * (0.72 + 0.28 * contact)
    }

    let floor_y: f32 = screen.y + 0.62
    let floor_glow: f32 = smoothstep(0.05, 0.0, abs(floor_y)) * smoothstep(1.15, 0.2, abs(screen.x))
    col = col + gallery_env(vec3(screen.x, 0.08, -1.0), environment) * floor_glow * 0.08
    return gallery_tonemap(col)
}

# Metals
shader fill photoreal_gold {
    let q: vec2 = uv * 2.0 - vec2(1.0)
    let screen: vec2 = vec2(q.x * resolution.x / resolution.y, -q.y)
    let col: vec3 = gallery_ball(screen, time, vec3(1.000, 0.720, 0.180), vec3(1.000, 0.450, 0.080), 1.000, 0.100, 0.0, 1.0, 0.000, 0.660, 0.000)
    color = vec4(col, 1.0)
}
