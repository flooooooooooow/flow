# SIMD probe: try to trigger LLVM SLP vectorization from scalar code
# This is scalar-only FLOW; the backend should pick best available SIMD via clang -O3 -march=native.

function probe(a: i32, b: i32, c: i32, d: i32) -> i32 {
    let x0: i32 = a * b
    let x1: i32 = b * c
    let x2: i32 = c * d
    let x3: i32 = d * a

    let y0: i32 = x0 + 1
    let y1: i32 = x1 + 2
    let y2: i32 = x2 + 3
    let y3: i32 = x3 + 4

    let z0: i32 = y0 + y1
    let z1: i32 = y2 + y3

    return z0 + z1
}

function main() -> i32 {
    return probe(10, 20, 30, 40)
}
