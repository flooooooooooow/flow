# SIMD SAXPY: a*x + y vectorizable loop
# MLIR backend emits vector.transfer_* (VF=4); C backend adds clang/GCC vectorize hints.

function saxpy(a: f32, x: memref_f32, y: memref_f32, out: memref_f32, n: i32) -> i32 {
    for i in 0 to n {
        out[i] = a * x[i] + y[i]
    }
    return 0
}

function main() -> i32 {
    println("simd_saxpy: compile with --mlir --optimize to inspect vector transfers")
    return 0
}
