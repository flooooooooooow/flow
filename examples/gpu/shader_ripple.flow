# Ripple / tunnel-ish fill shader
#
#   ./flow shader examples/gpu/shader_ripple.flow

shader fill ripple {
    let p = uv - vec2(0.5, 0.5)
    let r = length(p)
    let a = p.x * 6.0 + time * 2.0
    let bands = 0.5 + 0.5 * sin(r * 40.0 - time * 4.0)
    let glow = 0.15 / (r + 0.05)
    color = vec4(
        bands * (0.4 + 0.6 * sin(a)),
        bands * (0.4 + 0.6 * cos(a * 0.7)),
        clamp(glow, 0.0, 1.0),
        1.0
    )
}
