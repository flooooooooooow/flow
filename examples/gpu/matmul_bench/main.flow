import "time.flow"
import "io.flow"
import "matrix.flow"

function run_bench() -> i32 {
    let N: i32 = 512
    let size: i32 = N * N
    
    let A: array<f32> = array<f32>(size)
    let B: array<f32> = array<f32>(size)
    let C: array<f32> = array<f32>(size)
    
    # Initialize matrices
    for i in 0..size {
        A[i] = 1.0
        B[i] = 2.0
        C[i] = 0.0
    }
    
    print("Benchmarking Matrix Multiplication")
    print(N)
    
    # CPU Benchmark
    let start_cpu: f64 = get_time()
    matmul_cpu(A, B, C, N)
    let end_cpu: f64 = get_time()
    print_benchmark("CPU Time", end_cpu - start_cpu)
    print("Checksum CPU:")
    print(C[0] + C[size - 1])
    
    # GPU Benchmark
    let start_gpu: f64 = get_time()
    matmul_gpu(A, B, C, N)
    let end_gpu: f64 = get_time()
    print_benchmark("GPU Time", end_gpu - start_gpu)
    print("Checksum GPU:")
    print(C[0] + C[size - 1])
    
    return 0
}
