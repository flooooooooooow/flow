# Single-demo alias — full gallery is shader_showcase.flow
#
#   ./flow shader examples/gpu/shader_plasma.flow

shader fill plasma {
    let u: f32 = uv.x
    let v: f32 = uv.y
    let t: f32 = time
    color = vec4(
        0.5 + 0.5 * sin(u * 10.0 + t),
        0.5 + 0.5 * cos(v * 8.0 - t),
        0.5 + 0.5 * sin((u + v) * 4.0 + t * 1.3),
        1.0
    )
}
