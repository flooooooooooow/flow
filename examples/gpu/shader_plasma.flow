# Tiny fill-shader language demo
#
#   ./flow shader examples/gpu/shader_plasma.flow
#   ./flow shader examples/gpu/shader_plasma.flow --frames 3   # CI / headless-ish
#   ./flow shader examples/gpu/shader_plasma.flow --emit-only
#
# Builtins: uv (0..1), time (seconds), color (vec4 you must assign)

shader fill plasma {
    let u = uv.x
    let v = uv.y
    let t = time
    color = vec4(
        0.5 + 0.5 * sin(u * 10.0 + t),
        0.5 + 0.5 * cos(v * 8.0 - t),
        0.5 + 0.5 * sin((u + v) * 4.0 + t * 1.3),
        1.0
    )
}
