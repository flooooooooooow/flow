# FLOW Shader Language — photorealistic gallery
#
#   ./flow shader examples/gpu/shader_photoreal.flow
#
# Procedural ray-marched scenes using only FSL builtins: SDF geometry,
# finite-difference normals, soft shadows, ambient occlusion, Fresnel,
# reflection/refraction, procedural materials, and environment lighting.

fn sd_sphere(p: vec3, r: f32) -> f32 {
    return length(p) - r
}

fn sd_box(p: vec3, b: vec3) -> f32 {
    let q: vec3 = abs(p) - b
    return length(max(q, vec3(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0)
}

fn sd_torus(p: vec3, major: f32, minor: f32) -> f32 {
    let q: vec2 = vec2(length(p.xz) - major, p.y)
    return length(q) - minor
}

fn camera_ray(screen: vec2, ro: vec3, target: vec3, focal: f32) -> vec3 {
    let forward: vec3 = normalize(target - ro)
    let right: vec3 = normalize(cross(forward, vec3(0.0, 1.0, 0.0)))
    let up: vec3 = cross(right, forward)
    return normalize(forward * focal + right * screen.x + up * screen.y)
}

fn env_sky(d: vec3) -> vec3 {
    let h: f32 = clamp(d.y * 0.5 + 0.5, 0.0, 1.0)
    let horizon: vec3 = mix(vec3(0.72, 0.78, 0.88), vec3(0.08, 0.16, 0.30), h)
    let sun_dir: vec3 = normalize(vec3(-0.45, 0.55, -0.7))
    let sun: f32 = pow(max(dot(d, sun_dir), 0.0), 256.0)
    let glow: f32 = pow(max(dot(d, sun_dir), 0.0), 12.0)
    return horizon + vec3(1.0, 0.72, 0.42) * glow * 0.35 + vec3(1.0, 0.92, 0.78) * sun * 4.0
}

fn filmic(c: vec3) -> vec3 {
    let x: vec3 = max(c, vec3(0.0))
    return x / (x + vec3(1.0))
}

fn scene_studio(p: vec3) -> vec2 {
    var d: f32 = p.y + 1.0
    var material: f32 = 0.0

    let sphere_d: f32 = sd_sphere(p - vec3(-0.78, -0.12, 0.0), 0.88)
    if sphere_d < d {
        d = sphere_d
        material = 1.0
    }

    let box_d: f32 = sd_box(p - vec3(0.95, -0.42, 0.08), vec3(0.52, 0.58, 0.52))
    if box_d < d {
        d = box_d
        material = 2.0
    }

    let torus_d: f32 = sd_torus(p - vec3(0.12, 0.15, -0.9), 0.66, 0.16)
    if torus_d < d {
        d = torus_d
        material = 3.0
    }

    return vec2(d, material)
}

fn studio_normal(p: vec3) -> vec3 {
    let e: f32 = 0.0015
    let dx: f32 = scene_studio(p + vec3(e, 0.0, 0.0)).x - scene_studio(p - vec3(e, 0.0, 0.0)).x
    let dy: f32 = scene_studio(p + vec3(0.0, e, 0.0)).x - scene_studio(p - vec3(0.0, e, 0.0)).x
    let dz: f32 = scene_studio(p + vec3(0.0, 0.0, e)).x - scene_studio(p - vec3(0.0, 0.0, e)).x
    return normalize(vec3(dx, dy, dz))
}

fn studio_shadow(ro: vec3, rd: vec3) -> f32 {
    var t: f32 = 0.025
    var shade: f32 = 1.0
    for i in 0 to 28 {
        let h: f32 = scene_studio(ro + rd * t).x
        shade = min(shade, 14.0 * h / t)
        t = t + clamp(h, 0.025, 0.22)
    }
    return clamp(shade, 0.0, 1.0)
}

fn studio_ao(p: vec3, n: vec3) -> f32 {
    var occ: f32 = 0.0
    var weight: f32 = 1.0
    for i in 1 to 6 {
        let h: f32 = 0.035 * f32(i)
        let sample_d: f32 = scene_studio(p + n * h).x
        occ = occ + (h - sample_d) * weight
        weight = weight * 0.62
    }
    return clamp(1.0 - occ * 2.5, 0.0, 1.0)
}

fn scene_orb(p: vec3) -> vec2 {
    var d: f32 = p.y + 1.05
    var material: f32 = 0.0
    let sphere_d: f32 = sd_sphere(p - vec3(0.0, -0.05, 0.0), 1.0)
    if sphere_d < d {
        d = sphere_d
        material = 1.0
    }
    return vec2(d, material)
}

fn orb_normal(p: vec3) -> vec3 {
    let e: f32 = 0.0015
    let dx: f32 = scene_orb(p + vec3(e, 0.0, 0.0)).x - scene_orb(p - vec3(e, 0.0, 0.0)).x
    let dy: f32 = scene_orb(p + vec3(0.0, e, 0.0)).x - scene_orb(p - vec3(0.0, e, 0.0)).x
    let dz: f32 = scene_orb(p + vec3(0.0, 0.0, e)).x - scene_orb(p - vec3(0.0, 0.0, e)).x
    return normalize(vec3(dx, dy, dz))
}

fn orb_shadow(ro: vec3, rd: vec3) -> f32 {
    var t: f32 = 0.025
    var shade: f32 = 1.0
    for i in 0 to 24 {
        let h: f32 = scene_orb(ro + rd * t).x
        shade = min(shade, 12.0 * h / t)
        t = t + clamp(h, 0.025, 0.24)
    }
    return clamp(shade, 0.0, 1.0)
}

# ── 1. Studio materials ─────────────────────────────────────────────
# Ivory ceramic, copper, and gold under a soft studio light.

shader fill photoreal_studio {
    let raw: vec2 = uv * 2.0 - vec2(1.0)
    let screen: vec2 = vec2(raw.x * resolution.x / resolution.y, -raw.y)
    let orbit: f32 = time * 0.08
    let ro: vec3 = vec3(4.1 * sin(orbit), 1.45, 4.1 * cos(orbit))
    let rd: vec3 = camera_ray(screen, ro, vec3(0.0, -0.28, 0.0), 1.75)

    var travel: f32 = 0.0
    var material: f32 = -1.0
    var hit: bool = false
    var active: bool = true
    for i in 0 to 88 {
        if active {
            let sample: vec2 = scene_studio(ro + rd * travel)
            if sample.x < 0.0012 {
                material = sample.y
                hit = true
                active = false
            } else {
                travel = travel + sample.x * 0.78
                if travel > 18.0 {
                    active = false
                }
            }
        }
    }

    var col: vec3 = env_sky(rd)
    if hit {
        let pos: vec3 = ro + rd * travel
        let n: vec3 = studio_normal(pos)
        let view: vec3 = normalize(ro - pos)
        let light_pos: vec3 = vec3(-3.4, 5.4, 2.7)
        let light_dir: vec3 = normalize(light_pos - pos)
        let half_dir: vec3 = normalize(light_dir + view)
        let shadow: f32 = studio_shadow(pos + n * 0.012, light_dir)
        let ao: f32 = studio_ao(pos, n)
        let diffuse: f32 = max(dot(n, light_dir), 0.0) * shadow
        let fresnel: f32 = pow(1.0 - max(dot(n, view), 0.0), 5.0)

        var base: vec3 = vec3(0.82, 0.80, 0.74)
        var metal: f32 = 0.0
        var roughness: f32 = 0.22

        if material < 0.5 {
            let checker: f32 = mod(floor(pos.x * 1.7) + floor(pos.z * 1.7), 2.0)
            base = mix(vec3(0.055, 0.06, 0.065), vec3(0.16, 0.17, 0.18), checker)
            roughness = 0.48
        } else if material < 1.5 {
            base = vec3(0.92, 0.88, 0.78)
            roughness = 0.16
        } else if material < 2.5 {
            let brushed: f32 = 0.92 + 0.08 * sin(pos.y * 180.0 + fbm(pos.xz * 14.0) * 5.0)
            base = vec3(0.92, 0.43, 0.20) * brushed
            metal = 1.0
            roughness = 0.30
        } else {
            base = vec3(1.0, 0.72, 0.20)
            metal = 1.0
            roughness = 0.12
        }

        let spec_power: f32 = mix(96.0, 14.0, roughness)
        let spec: f32 = pow(max(dot(n, half_dir), 0.0), spec_power) * shadow
        let reflected: vec3 = env_sky(reflect(-view, n))
        let dielectric_f0: vec3 = vec3(0.04) + vec3(fresnel * 0.96)
        let metal_f0: vec3 = base + (vec3(1.0) - base) * fresnel
        let f0: vec3 = mix(dielectric_f0, metal_f0, metal)
        let direct: vec3 = base * (0.08 + diffuse * 1.55) * (1.0 - metal * 0.75)
        col = (direct + reflected * f0 * (0.30 + metal * 0.75) + vec3(spec) * f0 * 2.0) * ao
    }

    color = vec4(filmic(col), 1.0)
}

# ── 2. Glass orb ────────────────────────────────────────────────────
# Chromatic refraction and Schlick-style Fresnel against a procedural sky.

shader fill photoreal_glass {
    let raw: vec2 = uv * 2.0 - vec2(1.0)
    let screen: vec2 = vec2(raw.x * resolution.x / resolution.y, -raw.y)
    let ro: vec3 = vec3(3.5 * sin(time * 0.06), 1.0, 3.5 * cos(time * 0.06))
    let rd: vec3 = camera_ray(screen, ro, vec3(0.0, -0.18, 0.0), 1.8)

    var travel: f32 = 0.0
    var material: f32 = -1.0
    var hit: bool = false
    var active: bool = true
    for i in 0 to 80 {
        if active {
            let sample: vec2 = scene_orb(ro + rd * travel)
            if sample.x < 0.0012 {
                material = sample.y
                hit = true
                active = false
            } else {
                travel = travel + sample.x * 0.82
                if travel > 16.0 {
                    active = false
                }
            }
        }
    }

    var col: vec3 = env_sky(rd)
    if hit {
        let pos: vec3 = ro + rd * travel
        let n: vec3 = orb_normal(pos)
        let view: vec3 = normalize(ro - pos)
        let light_dir: vec3 = normalize(vec3(-2.8, 4.8, 2.2) - pos)
        let shadow: f32 = orb_shadow(pos + n * 0.012, light_dir)

        if material < 0.5 {
            let grain: f32 = fbm(pos.xz * 3.5)
            let stone: vec3 = mix(vec3(0.11, 0.10, 0.09), vec3(0.34, 0.30, 0.25), grain)
            let diffuse: f32 = max(dot(n, light_dir), 0.0) * shadow
            let sheen: f32 = pow(max(dot(reflect(-light_dir, n), view), 0.0), 80.0) * shadow
            col = stone * (0.12 + diffuse * 1.35) + vec3(sheen) * 0.7
        } else {
            let facing: f32 = max(dot(n, view), 0.0)
            let fresnel: f32 = 0.04 + 0.96 * pow(1.0 - facing, 5.0)
            let reflected: vec3 = env_sky(reflect(rd, n))
            let refr_r: vec3 = refract(rd, n, 0.655)
            let refr_g: vec3 = refract(rd, n, 0.662)
            let refr_b: vec3 = refract(rd, n, 0.670)
            let transmitted: vec3 = vec3(env_sky(refr_r).r, env_sky(refr_g).g, env_sky(refr_b).b)
            let absorption: vec3 = vec3(0.82, 0.95, 0.98)
            let rim: vec3 = vec3(0.72, 0.92, 1.0) * pow(1.0 - facing, 2.0) * 0.35
            col = mix(transmitted * absorption, reflected, fresnel) + rim
        }
    }

    color = vec4(filmic(col), 1.0)
}

# ── 3. Polished marble ──────────────────────────────────────────────
# Procedural stone veins with glossy indirect reflection.

shader fill photoreal_marble {
    let raw: vec2 = uv * 2.0 - vec2(1.0)
    let screen: vec2 = vec2(raw.x * resolution.x / resolution.y, -raw.y)
    let ro: vec3 = vec3(3.8, 1.2, 3.4)
    let rd: vec3 = camera_ray(screen, ro, vec3(0.0, -0.22, 0.0), 1.9)

    var travel: f32 = 0.0
    var material: f32 = -1.0
    var hit: bool = false
    var active: bool = true
    for i in 0 to 80 {
        if active {
            let sample: vec2 = scene_orb(ro + rd * travel)
            if sample.x < 0.0012 {
                material = sample.y
                hit = true
                active = false
            } else {
                travel = travel + sample.x * 0.82
                if travel > 16.0 {
                    active = false
                }
            }
        }
    }

    var col: vec3 = env_sky(rd)
    if hit {
        let pos: vec3 = ro + rd * travel
        let n: vec3 = orb_normal(pos)
        let view: vec3 = normalize(ro - pos)
        let light_dir: vec3 = normalize(vec3(-3.2, 5.2, 1.7) - pos)
        let shadow: f32 = orb_shadow(pos + n * 0.012, light_dir)
        let diffuse: f32 = max(dot(n, light_dir), 0.0) * shadow
        let reflected: vec3 = env_sky(reflect(-view, n))
        let spec: f32 = pow(max(dot(reflect(-light_dir, n), view), 0.0), 110.0) * shadow

        let warp: f32 = fbm(pos.xz * 2.4 + vec2(pos.y * 0.8, pos.y * 0.35))
        let veins: f32 = smoothstep(0.72, 0.92, 0.5 + 0.5 * sin((pos.x + pos.z) * 7.0 + warp * 14.0))
        var marble: vec3 = mix(vec3(0.72, 0.74, 0.70), vec3(0.96, 0.95, 0.90), fbm(pos.xz * 5.0))
        marble = mix(marble, vec3(0.18, 0.21, 0.20), veins * 0.72)

        if material < 0.5 {
            let tile: f32 = mod(floor(pos.x * 1.25) + floor(pos.z * 1.25), 2.0)
            marble = mix(marble * 0.45, marble * 0.75, tile)
        }

        let fresnel: f32 = 0.035 + 0.965 * pow(1.0 - max(dot(n, view), 0.0), 5.0)
        col = marble * (0.11 + diffuse * 1.4) + reflected * (0.10 + fresnel * 0.34) + vec3(spec) * 0.9
    }

    color = vec4(filmic(col), 1.0)
}

# ── 4. Sunset chrome ────────────────────────────────────────────────
# Mirror metal that reads almost entirely from the procedural environment.

shader fill photoreal_chrome {
    let raw: vec2 = uv * 2.0 - vec2(1.0)
    let screen: vec2 = vec2(raw.x * resolution.x / resolution.y, -raw.y)
    let ro: vec3 = vec3(3.25 * sin(time * 0.10), 0.95, 3.25 * cos(time * 0.10))
    let rd: vec3 = camera_ray(screen, ro, vec3(0.0, -0.18, 0.0), 1.85)

    var travel: f32 = 0.0
    var material: f32 = -1.0
    var hit: bool = false
    var active: bool = true
    for i in 0 to 80 {
        if active {
            let sample: vec2 = scene_orb(ro + rd * travel)
            if sample.x < 0.0012 {
                material = sample.y
                hit = true
                active = false
            } else {
                travel = travel + sample.x * 0.82
                if travel > 16.0 {
                    active = false
                }
            }
        }
    }

    var col: vec3 = env_sky(rd)
    if hit {
        let pos: vec3 = ro + rd * travel
        let n: vec3 = orb_normal(pos)
        let view: vec3 = normalize(ro - pos)
        let light_dir: vec3 = normalize(vec3(-3.0, 5.0, 2.0) - pos)
        let shadow: f32 = orb_shadow(pos + n * 0.012, light_dir)

        if material < 0.5 {
            let wet: f32 = 0.55 + 0.45 * fbm(pos.xz * 7.0)
            let asphalt: vec3 = vec3(0.045, 0.05, 0.055) * (0.7 + wet * 0.5)
            let diffuse: f32 = max(dot(n, light_dir), 0.0) * shadow
            let glint: f32 = pow(max(dot(reflect(-light_dir, n), view), 0.0), 150.0) * shadow
            col = asphalt * (0.2 + diffuse) + env_sky(reflect(-view, n)) * 0.10 + vec3(glint) * 0.65
        } else {
            let reflected: vec3 = env_sky(reflect(-view, n))
            let facing: f32 = max(dot(n, view), 0.0)
            let fresnel: f32 = 0.62 + 0.38 * pow(1.0 - facing, 5.0)
            let edge: vec3 = vec3(1.0, 0.58, 0.22) * pow(1.0 - facing, 3.0) * 0.22
            col = reflected * fresnel * 1.55 + edge
        }
    }

    color = vec4(filmic(col), 1.0)
}
