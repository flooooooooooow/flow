{
  "suite": "vgpu",
  "reference": "https://vgpu.sh/examples/",
  "cases": [
    {
      "id": "gradient",
      "upstream": "https://vgpu.sh/examples/gradient",
      "source": "examples/gpu/vgpu/gradient.flow",
      "fill": "vgpu_gradient",
      "fragmentEntry": "vgpu_gradient_frag",
      "renderer": "vgpu_gradient",
      "width": 160,
      "height": 90,
      "time": 0,
      "reference": "examples/gpu/vgpu/refs/gradient_160x90.rgba8.hex",
      "comparison": {
        "mode": "exact-rgba8"
      },
      "expect": "EXACT",
      "backends": [
        "metal",
        "webgpu"
      ]
    },
    {
      "id": "mnist",
      "upstream": "https://vgpu.sh/examples/mnist",
      "source": "examples/gpu/vgpu/mnist.flow",
      "comparison": {
        "mode": "numerical",
        "maxAbs": 0.0001
      },
      "backends": [
        "metal",
        "webgpu"
      ],
      "model": "mnist"
    },
    {
      "id": "depth",
      "upstream": "https://vgpu.sh/examples/depth",
      "source": "examples/gpu/vgpu/depth_estimation.flow",
      "comparison": {
        "mode": "numerical",
        "maxAbs": 0.0001
      },
      "backends": [
        "metal",
        "webgpu"
      ],
      "model": "depth"
    }
  ]
}
