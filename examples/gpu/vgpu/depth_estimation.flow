import "stdlib/tensor.flow"
import "stdlib/gpu_memory.flow"

# vgpu compatibility case: Depth estimation execution with shared GPU resources
#
# Connects Flow tensors and model execution to shared GPU resources, running
# ordinary @gpu kernels before and after depth estimation layer execution without
# mandatory CPU round trips.

@gpu
function depth_feature_extract(image: ptr<f32>, features: ptr<f32>, n: i32) -> void {
    let i: i32 = gpu_thread_id()
    if i < n {
        # Feature extraction preprocessing: scale and bias raw luminance
        features[i] = image[i] * 0.8 + 0.1
    }
}

@gpu
function depth_projection_layer(features: ptr<f32>, weights: ptr<f32>, depth_map: ptr<f32>, M: i32, K: i32, N: i32) -> void {
    let row: i32 = gpu_thread_id()
    if row < M {
        for col in 0 to N {
            let mut acc: f32 = 0.0
            for k in 0 to K {
                acc = acc + features[row * K + k] * weights[k * N + col]
            }
            depth_map[row * N + col] = acc
        }
    }
}

@gpu
function depth_colormap_tint(depth_map: ptr<f32>, colormap: ptr<f32>, n: i32) -> void {
    let i: i32 = gpu_thread_id()
    if i < n {
        # Postprocessing colormap tinting: clamp and inverse depth tinting
        let val: f32 = depth_map[i]
        if val < 0.0 {
            colormap[i] = 0.0
        } else {
            if val > 1.0 {
                colormap[i] = 1.0
            } else {
                colormap[i] = 1.0 - val
            }
        }
    }
}

# GPU model execution over shared GPU resources without CPU round trips
function depth_estimate_gpu(
    img_buf: GpuBuffer,
    feat_buf: GpuBuffer,
    w_buf: GpuBuffer,
    depth_buf: GpuBuffer,
    color_buf: GpuBuffer,
    feature_dim: i32,
    depth_out_dim: i32
) {
    if gpu_is_null(img_buf) or gpu_is_null(feat_buf) or gpu_is_null(color_buf) {
        return
    }

    let img_p: ptr<f32> = gpu_buffer_ptr(img_buf)
    let feat_p: ptr<f32> = gpu_buffer_ptr(feat_buf)
    let w_p: ptr<f32> = gpu_buffer_ptr(w_buf)
    let depth_p: ptr<f32> = gpu_buffer_ptr(depth_buf)
    let color_p: ptr<f32> = gpu_buffer_ptr(color_buf)

    if img_p == null or feat_p == null or color_p == null {
        return
    }

    # Step 1: Preprocessing @gpu feature extraction on GPU resource
    depth_feature_extract(img_p, feat_p, feature_dim)

    # Step 2: Linear depth projection layer on GPU resource
    depth_projection_layer(feat_p, w_p, depth_p, 1, feature_dim, depth_out_dim)

    # Step 3: Postprocessing @gpu colormap tinting on GPU resource
    depth_colormap_tint(depth_p, color_p, depth_out_dim)
}

# CPU reference depth estimator for numerical equivalence verification
function depth_estimate_cpu(image: Tensor, weights: Tensor) -> Tensor {
    # Step 1: Preprocess features
    let features: Tensor = tensor_zeros(image.dim0, image.dim1, 1, 1)
    for i in 0 to image.size {
        features.data[i] = image.data[i] * 0.8 + 0.1
    }

    # Step 2: Linear depth projection layer
    let raw_depth: Tensor = tensor_matmul(features, weights)

    # Step 3: Postprocess depth colormap
    let colormap: Tensor = tensor_zeros(raw_depth.dim0, raw_depth.dim1, 1, 1)
    for i in 0 to raw_depth.size {
        let val: f32 = raw_depth.data[i]
        if val < 0.0 {
            colormap.data[i] = 0.0
        } else {
            if val > 1.0 {
                colormap.data[i] = 1.0
            } else {
                colormap.data[i] = 1.0 - val
            }
        }
    }

    tensor_free(features)
    tensor_free(raw_depth)

    return colormap
}

function main() -> i32 {
    println("=== vgpu Depth Estimation ===")

    let feature_dim: i32 = 64  # 8x8 feature grid
    let depth_out_dim: i32 = 64

    # Allocate input image and depth estimation model weights
    let raw_image: Tensor = tensor_fill(1, feature_dim, 1, 1, 0.5)
    let weights: Tensor = tensor_fill(feature_dim, depth_out_dim, 1, 1, 0.02)

    # Allocate shared GPU buffers
    let img_buf: GpuBuffer = gpu_tensor_alloc(1, feature_dim, 1, 1)
    let feat_buf: GpuBuffer = gpu_tensor_alloc(1, feature_dim, 1, 1)
    let w_buf: GpuBuffer = gpu_tensor_alloc(feature_dim, depth_out_dim, 1, 1)
    let depth_buf: GpuBuffer = gpu_tensor_alloc(1, depth_out_dim, 1, 1)
    let color_buf: GpuBuffer = gpu_tensor_alloc(1, depth_out_dim, 1, 1)

    # Sync input data to shared GPU resources
    gpu_tensor_sync_h2d(img_buf, raw_image.data, feature_dim as i64)
    gpu_tensor_sync_h2d(w_buf, weights.data, (feature_dim * depth_out_dim) as i64)

    # Run GPU depth estimation model on shared GPU resources
    depth_estimate_gpu(img_buf, feat_buf, w_buf, depth_buf, color_buf, feature_dim, depth_out_dim)

    # Sync results from GPU resource to CPU tensor for verification
    let gpu_colormap: Tensor = tensor_zeros(1, depth_out_dim, 1, 1)
    if not gpu_is_null(color_buf) {
        gpu_tensor_sync_d2h(gpu_colormap.data, color_buf, depth_out_dim as i64)
    }

    # Run CPU reference depth estimator
    let cpu_colormap: Tensor = depth_estimate_cpu(raw_image, weights)

    let mean_depth_gpu: f32 = tensor_mean(gpu_colormap)
    let mean_depth_cpu: f32 = tensor_mean(cpu_colormap)

    println("Estimated Mean Depth (Reference):")
    println(mean_depth_cpu)

    println("Depth Colormap Output (Reference):")
    tensor_print(cpu_colormap)

    # Free resources
    tensor_free(raw_image)
    tensor_free(weights)
    tensor_free(gpu_colormap)
    tensor_free(cpu_colormap)

    gpu_free(img_buf)
    gpu_free(feat_buf)
    gpu_free(w_buf)
    gpu_free(depth_buf)
    gpu_free(color_buf)

    println("Depth estimation execution completed successfully.")
    return 0
}
