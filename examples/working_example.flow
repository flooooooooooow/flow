# Working Example - Simple Stack Demo
function main() -> i32 {
    let stack_size: i32 = 0
    
    # Push 3 items
    stack_size = stack_size + 1
    stack_size = stack_size + 1  
    stack_size = stack_size + 1
    
    # Pop 3 items  
    stack_size = stack_size - 1
    stack_size = stack_size - 1
    stack_size = stack_size - 1
    
    return stack_size
}
