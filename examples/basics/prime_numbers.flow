# Prime Numbers - FLOW version of C++ prime number checker
function is_prime(n: i32) -> i32 {
    if n <= 1 {
        return 0  # false
    }
    if n <= 3 {
        return 1  # true
    }
    if n % 2 == 0 || n % 3 == 0 {
        return 0  # false
    }
    
    let i: i32 = 5
    while i * i <= n {
        if n % i == 0 || n % (i + 2) == 0 {
            return 0  # false
        }
        i = i + 6
    }
    
    return 1  # true
}

function main() -> i32 {
    let limit: i32 = 30
    let count: i32 = 0
    let i: i32 = 2
    
    while i <= limit {
        if is_prime(i) == 1 {
            count = count + 1
            # Would print: i is prime
        }
        i = i + 1
    }
    
    return count
}
