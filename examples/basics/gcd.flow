# Greatest Common Divisor - FLOW version of C++ Euclidean algorithm
function gcd(a: i32, b: i32) -> i32 {
    let mut x: i32 = a
    let mut y: i32 = b
    while y != 0 {
        let temp: i32 = y
        y = x % y
        x = temp
    }
    return x
}

function main() -> i32 {
    let a: i32 = 56
    let b: i32 = 98
    let result: i32 = gcd(a, b)
    # Would print: "GCD of 56 and 98 is 14"
    return result
}
