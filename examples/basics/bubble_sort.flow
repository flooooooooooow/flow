# Bubble Sort - FLOW version of C++ bubble sort
# Since we don't have arrays, we'll simulate with variables
function bubble_sort_demo() -> i32 {
    # Simulate array: [64, 34, 25, 12, 22, 11, 90]
    let a1: i32 = 64
    let a2: i32 = 34
    let a3: i32 = 25
    let a4: i32 = 12
    let a5: i32 = 22
    let a6: i32 = 11
    let a7: i32 = 90
    
    let n: i32 = 7
    let i: i32 = 0
    let j: i32 = 0
    
    # Bubble sort algorithm
    while i < n - 1 {
        j = 0
        while j < n - i - 1 {
            # Compare adjacent elements (simplified)
            if a1 > a2 {
                let temp: i32 = a1
                a1 = a2
                a2 = temp
            }
            j = j + 1
        }
        i = i + 1
    }
    
    # Return sum of "sorted" elements
    return a1 + a2 + a3 + a4 + a5 + a6 + a7
}

function main() -> i32 {
    let result: i32 = bubble_sort_demo()
    return result
}
