# Simple Web Demo - Runs in browser via WebAssembly
function fibonacci(n: i32) -> i32 {
    if n <= 1 {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

function main() -> i32 {
    print("FLOW WebAssembly Demo")
    print("Fibonacci calculation")
    let fib_result: i32 = fibonacci(10)
    print("Result: ")
    print(fib_result)
    print("WebAssembly demo complete")
    return 0
}
