# Simple Import/Export Demo - No external dependencies

function test_basic_math() -> void {
    print("Testing Basic Math Functions")
    print("==========================")
    
    # Test basic arithmetic
    let a: f32 = 10.5
    let b: f32 = 3.2
    
    print("Add: " + a + " + " + b + " = " + (a + b))
    print("Subtract: " + a + " - " + b + " = " + (a - b))
    print("Multiply: " + a + " * " + b + " = " + (a * b))
    print("Divide: " + a + " / " + b + " = " + (a / b))
    
    # Test power function (using multiplication for simplicity)
    let power_result: f32 = a * a
    print("Power: " + a + " ^ 2 = " + power_result)
}

function test_simple_functions() -> void {
    print("\nTesting Simple Functions")
    print("========================")
    
    # Test fibonacci
    let n: i32 = 10
    let fib_result: i32 = fibonacci_simple(n)
    print("Fibonacci(" + n + ") = " + fib_result)
    
    # Test absolute value
    let negative: f32 = -5.7
    let abs_result: f32 = abs_simple(negative)
    print("Abs(" + negative + ") = " + abs_result)
}

function fibonacci_simple(n: i32) -> i32 {
    if n <= 1 {
        return n
    }
    return fibonacci_simple(n - 1) + fibonacci_simple(n - 2)
}

function abs_simple(x: f32) -> f32 {
    if x < 0.0 {
        return -x
    }
    return x
}

function main() -> i32 {
    print("FLOW Simple Import/Export Demo")
    print("==============================")
    print("This program demonstrates basic functionality")
    print("without external module dependencies.\n")
    
    test_basic_math()
    test_simple_functions()
    
    print("\n🎉 Simple Demo Complete!")
    print("✓ Basic arithmetic operations")
    print("✓ Function definitions and calls")
    print("✓ Variable declarations with types")
    print("✓ Control flow (if statements)")
    print("✓ Print statements")
    
    return 0
}
