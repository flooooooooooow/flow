# THE FALLING SAND GAME
#
# A reconstruction of the original browser sand toy (Dofi-Blog's "hell of
# sand", 2005) and the World of Sand lineage it started. Ten materials on a
# 384x192 cell grid, one cell per pixel, one packed RGB buffer blitted per
# frame.
#
# Materials and the interactions that define them:
#   WALL        static, indestructible; the pen never paints over it
#   SAND        falls, slides diagonally, piles at 45 degrees, sinks in water
#   WATER       falls, spreads laterally, boils to steam in fire
#   OIL         falls, spreads, floats on water, ignites from fire
#   FIRE        rises, eats oil and plant, boils water, melts ice, burns out
#   PLANT       static, grows into adjacent water, burns, dies in salt water
#   SALT        falls; dissolves on contact with water into SALT WATER
#   SALT WATER  a heavier liquid that kills plant
#   STEAM       rises, condenses back to water at the ceiling or on cooling
#   ICE         static, freezes neighbouring water, melts to water near fire
#   SPOUTS      static emitters for water, sand and oil
#
# Layering is a single density ladder with air on it as a real rung, so one
# comparison decides both what sinks and what rises:
#   steam 1 < fire 2 < air 3 < oil 4 < water 6 < salt water 7 < salt 9 < sand 10
# Oil floats on water, water sinks through oil, sand sinks through both, and
# steam bubbles up through all of them. Fire is capped at air, so a burning
# pool keeps its flame at the surface rather than swimming to the top.
#
# CONTROLS (no mouse in the gfx API, so the pen is on the keyboard)
#   Arrows      move the pen; hold to accelerate (2 -> 4 -> 6 px/frame)
#   Space       paint (strokes interpolate, so fast sweeps stay solid)
#   1..9 0      WALL SAND WATER OIL FIRE PLANT SALT ICE SPOUT-WATER ERASER
#   Q / E       cycle the full palette, including steam, salt water and the
#               sand and oil spouts
#   [ / ]       brush radius: 1 2 3 5 8 12
#   C           clear to an empty box
#   R           reload the opening scene
#   P           pause
#   Esc         quit
#
# MEASURED PERFORMANCE. Apple M4 Max, Apple clang 17, -O2, the headless
# recorder with frame writing switched off (FLOW_GFX_RECORD_SKIP=100000) so
# the number is simulation plus render plus blit and nothing else. 600 frames
# of the scripted demo below, best of three runs:
#
#   600 frames in 0.30 s          = 2000 frames/second
#   3 sub-steps x 384 x 192 cells = 221,184 cell visits per frame
#                                 = 442,400,000 cell visits/second
#   live particles over the run    13,110 rising to 19,014, mean ~15,900
#   15,900 x 3 sub-steps x 2000   = 95,400,000 particle updates/second
#
# Writing every frame to disk as a PPM drops it to ~420 frames/second, which
# is what the HUD reads during a recording. The HUD's figure comes from
# clock(3) over a rolling 15-frame window.
#
# The classic bug this avoids: scanning x in one direction every frame makes
# powders creep sideways. The horizontal scan direction flips every sub-step,
# and rows are walked bottom-up so falling material never falls twice.

import "stdlib/gfx.flow"
import "stdlib/text.flow"

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function clock() -> i32  # clock_t: i32 on emscripten; µs values fit i32 on both
}

# ============================================================================
# GEOMETRY
# ============================================================================

const GRID_W: i32 = 384
const GRID_H: i32 = 192
const HUD_H: i32 = 64
const WIN_W: i32 = 384
const WIN_H: i32 = 256

# Sub-steps per presented frame. One step per frame is the original's pace on
# a 200-cell-tall grid; three keeps the same feel at this size.
const SUBSTEPS: i32 = 3

# ============================================================================
# MATERIALS
# ============================================================================

const EMPTY: u8 = 0
const WALL: u8 = 1
const SAND: u8 = 2
const WATER: u8 = 3
const OIL: u8 = 4
const FIRE: u8 = 5
const PLANT: u8 = 6
const SALT: u8 = 7
const BRINE: u8 = 8
const STEAM: u8 = 9
const ICE: u8 = 10
const SRC_WATER: u8 = 11
const SRC_SAND: u8 = 12
const SRC_OIL: u8 = 13

const PALETTE_N: i32 = 14

const FIRE_LIFE: u8 = 60
const STEAM_LIFE: u8 = 200
const PLANT_MAX_GEN: u8 = 40

# ============================================================================
# KEYS (macOS NSEvent keycodes)
# ============================================================================

const KEY_SPACE: i32 = 49
const KEY_P: i32 = 35
const KEY_C: i32 = 8
const KEY_Q: i32 = 12
const KEY_E: i32 = 14
const KEY_LBRACK: i32 = 33
const KEY_RBRACK: i32 = 30
const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20
const KEY_4: i32 = 21
const KEY_5: i32 = 23
const KEY_6: i32 = 22
const KEY_7: i32 = 26
const KEY_8: i32 = 28
const KEY_9: i32 = 25
const KEY_0: i32 = 29

# ============================================================================
# MODULE STATE
# ============================================================================

struct Rgb { r: i32, g: i32, b: i32 }

let mut cells: ptr<u8> = null    # material id per cell
let mut aux: ptr<u8> = null      # fire/steam life, plant generation
let mut moved: ptr<u8> = null    # sub-step guard, one byte per cell
let mut fb: ptr<u8> = null       # packed RGB8, GRID_W * GRID_H * 3
let mut rng_state: u32 = 2463534242

# ============================================================================
# DETERMINISTIC LCG
# ============================================================================

function rnd() -> i32 {
    rng_state = rng_state * 1664525 + 1013904223
    return ((rng_state >> 16) % 32768) as i32
}

function rnd_below(n: i32) -> i32 {
    if n <= 1 {
        return 0
    }
    return rnd() % n
}

# Stable per-cell noise for texture; must not shimmer between frames.
function tex(x: i32, y: i32) -> i32 {
    let mut h: u32 = (x as u32) * 374761393 + (y as u32) * 668265263
    h = (h >> 13) * 1274126177
    return ((h >> 19) % 256) as i32
}

function iabs(v: i32) -> i32 {
    if v < 0 {
        return 0 - v
    }
    return v
}

# ============================================================================
# GRID ACCESS
# ============================================================================

function idx(x: i32, y: i32) -> i32 {
    return y * GRID_W + x
}

function inb(x: i32, y: i32) -> bool {
    return x >= 0 and x < GRID_W and y >= 0 and y < GRID_H
}

# Out of bounds reads as WALL, so nothing ever leaves the box.
function cell_at(x: i32, y: i32) -> u8 {
    if !inb(x, y) {
        return WALL
    }
    return cells[idx(x, y)]
}

function put(x: i32, y: i32, v: u8, a: u8) -> void {
    if !inb(x, y) {
        return
    }
    let i: i32 = idx(x, y)
    cells[i] = v
    aux[i] = a
    moved[i] = 1 as u8
}

function swap_at(x1: i32, y1: i32, x2: i32, y2: i32) -> void {
    let i: i32 = idx(x1, y1)
    let j: i32 = idx(x2, y2)
    let cv: u8 = cells[i]
    let av: u8 = aux[i]
    cells[i] = cells[j]
    aux[i] = aux[j]
    cells[j] = cv
    aux[j] = av
    moved[i] = 1 as u8
    moved[j] = 1 as u8
}

# ============================================================================
# MATERIAL PROPERTIES
# ============================================================================

# Air is a real rung on the ladder, so a lighter material rises through it and
# a heavier one sinks through it with the same comparison.
function density(v: u8) -> i32 {
    if v == STEAM { return 1 }
    if v == FIRE { return 2 }
    if v == EMPTY { return 3 }
    if v == OIL { return 4 }
    if v == WATER { return 6 }
    if v == BRINE { return 7 }
    if v == SALT { return 9 }
    if v == SAND { return 10 }
    return 100
}

function is_static(v: u8) -> bool {
    return v == WALL or v == PLANT or v == ICE
        or v == SRC_WATER or v == SRC_SAND or v == SRC_OIL
}

function is_liquid(v: u8) -> bool {
    return v == WATER or v == OIL or v == BRINE
}

# Can `mover` move into a cell holding `target` while sinking?
function sinks_into(target: u8, d: i32) -> bool {
    if is_static(target) {
        return false
    }
    return density(target) < d
}

# `ceiling` is what separates a flame from a bubble. Steam takes ceiling 99 and
# so bubbles up through water and oil; fire takes 3 and so only climbs through
# air, which keeps a burning oil pool alight at its surface instead of letting
# the flame swim to the top of the liquid.
function rises_into(target: u8, d: i32, ceiling: i32) -> bool {
    if is_static(target) {
        return false
    }
    let td: i32 = density(target)
    return td > d and td <= ceiling
}

function nb_dx(k: i32) -> i32 {
    if k == 0 { return 0 }
    if k == 1 { return 0 }
    if k == 2 { return -1 }
    return 1
}

function nb_dy(k: i32) -> i32 {
    if k == 0 { return -1 }
    if k == 1 { return 1 }
    return 0
}

function initial_aux(v: u8) -> u8 {
    if v == FIRE { return FIRE_LIFE }
    if v == STEAM { return STEAM_LIFE }
    return 0 as u8
}

# Ignition life is jittered so a sheet of oil catching all at once burns down
# as a ragged front instead of a set of flat bands.
function fresh_fire() -> u8 {
    return (FIRE_LIFE as i32 - rnd_below(28)) as u8
}

# ============================================================================
# MOVEMENT
# ============================================================================

# Powders: straight down, then a diagonal slide that also needs the cell
# beside it free. Requiring the side cell is what gives a pile its 45-degree
# angle of repose instead of letting grains tunnel through a wall of grains.
function step_powder(x: i32, y: i32, v: u8) -> void {
    let d: i32 = density(v)
    if sinks_into(cell_at(x, y + 1), d) {
        swap_at(x, y, x, y + 1)
        return
    }
    let mut first: i32 = -1
    if rnd_below(2) == 1 {
        first = 1
    }
    let mut k: i32 = 0
    while k < 2 {
        let mut dx: i32 = first
        if k == 1 {
            dx = 0 - first
        }
        if sinks_into(cell_at(x + dx, y + 1), d) and sinks_into(cell_at(x + dx, y), d) {
            swap_at(x, y, x + dx, y + 1)
            return
        }
        k = k + 1
    }
}

# Liquids: down, diagonal, then a lateral run of up to `spread` cells. The run
# is what makes a pool level out instead of standing in a heap.
function step_liquid(x: i32, y: i32, v: u8, spread: i32) -> void {
    let d: i32 = density(v)
    if sinks_into(cell_at(x, y + 1), d) {
        swap_at(x, y, x, y + 1)
        return
    }
    let mut first: i32 = -1
    if rnd_below(2) == 1 {
        first = 1
    }
    let mut k: i32 = 0
    while k < 2 {
        let mut dx: i32 = first
        if k == 1 {
            dx = 0 - first
        }
        if sinks_into(cell_at(x + dx, y + 1), d) {
            swap_at(x, y, x + dx, y + 1)
            return
        }
        k = k + 1
    }
    let mut bx: i32 = x
    let mut s: i32 = 0
    while s < spread {
        let nx: i32 = bx + first
        if !sinks_into(cell_at(nx, y), d) {
            break
        }
        bx = nx
        s = s + 1
    }
    if bx != x {
        swap_at(x, y, bx, y)
    }
}

# Gases: up, diagonally up, then sideways.
function step_gas(x: i32, y: i32, v: u8, ceiling: i32) -> void {
    let d: i32 = density(v)
    if rises_into(cell_at(x, y - 1), d, ceiling) {
        swap_at(x, y, x, y - 1)
        return
    }
    let mut first: i32 = -1
    if rnd_below(2) == 1 {
        first = 1
    }
    let mut k: i32 = 0
    while k < 2 {
        let mut dx: i32 = first
        if k == 1 {
            dx = 0 - first
        }
        if rises_into(cell_at(x + dx, y - 1), d, ceiling) {
            swap_at(x, y, x + dx, y - 1)
            return
        }
        k = k + 1
    }
    if rises_into(cell_at(x + first, y), d, ceiling) {
        swap_at(x, y, x + first, y)
    }
}

# ============================================================================
# PER-MATERIAL RULES
# ============================================================================

function update_sand(x: i32, y: i32) -> void {
    step_powder(x, y, SAND)
}

function update_salt(x: i32, y: i32) -> void {
    # A grain in contact with water dissolves: the grain goes, the water it
    # touched turns brackish.
    let mut k: i32 = 0
    while k < 4 {
        let nx: i32 = x + nb_dx(k)
        let ny: i32 = y + nb_dy(k)
        if cell_at(nx, ny) == WATER {
            put(nx, ny, BRINE, 0 as u8)
            put(x, y, EMPTY, 0 as u8)
            return
        }
        k = k + 1
    }
    step_powder(x, y, SALT)
}

function update_water(x: i32, y: i32) -> void {
    let mut k: i32 = 0
    while k < 4 {
        if cell_at(x + nb_dx(k), y + nb_dy(k)) == FIRE {
            put(x, y, STEAM, STEAM_LIFE)
            return
        }
        k = k + 1
    }
    step_liquid(x, y, WATER, 5)
}

function update_brine(x: i32, y: i32) -> void {
    let mut k: i32 = 0
    while k < 4 {
        let nx: i32 = x + nb_dx(k)
        let ny: i32 = y + nb_dy(k)
        let n: u8 = cell_at(nx, ny)
        if n == FIRE {
            put(x, y, STEAM, STEAM_LIFE)
            return
        }
        # Salt is what kills a plant; fresh water is what feeds it.
        if n == PLANT and rnd_below(6) == 0 {
            put(nx, ny, EMPTY, 0 as u8)
        }
        k = k + 1
    }
    step_liquid(x, y, BRINE, 4)
}

function update_oil(x: i32, y: i32) -> void {
    let mut k: i32 = 0
    while k < 4 {
        if cell_at(x + nb_dx(k), y + nb_dy(k)) == FIRE {
            put(x, y, FIRE, fresh_fire())
            return
        }
        k = k + 1
    }
    step_liquid(x, y, OIL, 3)
}

function update_fire(x: i32, y: i32) -> void {
    let i: i32 = idx(x, y)
    let life: u8 = aux[i]
    if life == 0 {
        cells[i] = EMPTY
        aux[i] = 0 as u8
        return
    }
    aux[i] = (life as i32 - 1) as u8

    let mut doused: bool = false
    let mut k: i32 = 0
    while k < 4 {
        let nx: i32 = x + nb_dx(k)
        let ny: i32 = y + nb_dy(k)
        let n: u8 = cell_at(nx, ny)
        if n == OIL and rnd_below(2) == 0 {
            put(nx, ny, FIRE, fresh_fire())
        } elif n == PLANT and rnd_below(5) == 0 {
            put(nx, ny, FIRE, fresh_fire())
        } elif n == WATER or n == BRINE {
            put(nx, ny, STEAM, STEAM_LIFE)
            doused = true
        } elif n == ICE {
            put(nx, ny, WATER, 0 as u8)
            doused = true
        }
        k = k + 1
    }
    if doused {
        cells[i] = EMPTY
        aux[i] = 0 as u8
        moved[i] = 1 as u8
        return
    }
    # One diagonal try as well. Four-neighbour spread alone advances a burn
    # front row by row and the flame ends up looking banded; the diagonal
    # rounds it off.
    let dx: i32 = rnd_below(2) * 2 - 1
    let dy: i32 = rnd_below(2) * 2 - 1
    let dn: u8 = cell_at(x + dx, y + dy)
    if dn == OIL or dn == PLANT {
        if rnd_below(2) == 0 {
            put(x + dx, y + dy, FIRE, fresh_fire())
        }
    }
    step_gas(x, y, FIRE, 3)
}

function update_steam(x: i32, y: i32) -> void {
    let i: i32 = idx(x, y)
    let life: u8 = aux[i]
    if life == 0 {
        cells[i] = WATER
        aux[i] = 0 as u8
        moved[i] = 1 as u8
        return
    }
    aux[i] = (life as i32 - 1) as u8
    # Condensation on the ceiling: the classic returns the water it boiled.
    if y <= 2 and rnd_below(10) == 0 {
        cells[i] = WATER
        aux[i] = 0 as u8
        moved[i] = 1 as u8
        return
    }
    step_gas(x, y, STEAM, 99)
}

function update_plant(x: i32, y: i32) -> void {
    let i: i32 = idx(x, y)
    let gen: u8 = aux[i]
    let mut k: i32 = 0
    while k < 4 {
        let nx: i32 = x + nb_dx(k)
        let ny: i32 = y + nb_dy(k)
        let n: u8 = cell_at(nx, ny)
        if n == FIRE {
            cells[i] = FIRE
            aux[i] = fresh_fire()
            moved[i] = 1 as u8
            return
        }
        if n == BRINE and rnd_below(4) == 0 {
            cells[i] = EMPTY
            aux[i] = 0 as u8
            moved[i] = 1 as u8
            return
        }
        k = k + 1
    }
    if gen >= PLANT_MAX_GEN {
        return
    }
    if rnd_below(7) != 0 {
        return
    }
    let dir: i32 = rnd_below(4)
    let gx: i32 = x + nb_dx(dir)
    let gy: i32 = y + nb_dy(dir)
    if cell_at(gx, gy) == WATER {
        put(gx, gy, PLANT, (gen as i32 + 1) as u8)
    }
}

function update_ice(x: i32, y: i32) -> void {
    let mut k: i32 = 0
    while k < 4 {
        let nx: i32 = x + nb_dx(k)
        let ny: i32 = y + nb_dy(k)
        let n: u8 = cell_at(nx, ny)
        if n == FIRE {
            put(x, y, WATER, 0 as u8)
            return
        }
        k = k + 1
    }
    if rnd_below(48) != 0 {
        return
    }
    let dir: i32 = rnd_below(4)
    let fx: i32 = x + nb_dx(dir)
    let fy: i32 = y + nb_dy(dir)
    if cell_at(fx, fy) == WATER {
        put(fx, fy, ICE, 0 as u8)
    }
}

function update_source(x: i32, y: i32, v: u8) -> void {
    if rnd_below(3) != 0 {
        return
    }
    let mut out: u8 = WATER
    if v == SRC_SAND {
        out = SAND
    } elif v == SRC_OIL {
        out = OIL
    }
    let below: u8 = cell_at(x, y + 1)
    if below == EMPTY {
        put(x, y + 1, out, 0 as u8)
        return
    }
    let side: i32 = rnd_below(2) * 2 - 1
    if cell_at(x + side, y) == EMPTY {
        put(x + side, y, out, 0 as u8)
    }
}

# ============================================================================
# THE SIMULATION PASS
# ============================================================================

function clear_moved() -> void {
    let n: i32 = GRID_W * GRID_H
    let mut i: i32 = 0
    while i < n {
        moved[i] = 0 as u8
        i = i + 1
    }
}

# Bottom-up rows so a falling grain lands in a row already resolved; the x
# direction flips every sub-step so powders do not creep one way over time.
function simulate(left_to_right: bool) -> void {
    clear_moved()
    let mut y: i32 = GRID_H - 1
    while y >= 0 {
        let mut n: i32 = 0
        while n < GRID_W {
            let mut x: i32 = n
            if !left_to_right {
                x = GRID_W - 1 - n
            }
            n = n + 1
            let i: i32 = y * GRID_W + x
            if moved[i] != 0 {
                continue
            }
            let v: u8 = cells[i]
            if v == EMPTY or v == WALL {
                continue
            }
            if v == SAND {
                update_sand(x, y)
            } elif v == WATER {
                update_water(x, y)
            } elif v == OIL {
                update_oil(x, y)
            } elif v == FIRE {
                update_fire(x, y)
            } elif v == PLANT {
                update_plant(x, y)
            } elif v == SALT {
                update_salt(x, y)
            } elif v == BRINE {
                update_brine(x, y)
            } elif v == STEAM {
                update_steam(x, y)
            } elif v == ICE {
                update_ice(x, y)
            } elif v == SRC_WATER or v == SRC_SAND or v == SRC_OIL {
                update_source(x, y, v)
            }
        }
        y = y - 1
    }
}

# ============================================================================
# COLOUR
# ============================================================================

function clampc(v: i32) -> i32 {
    if v < 0 { return 0 }
    if v > 255 { return 255 }
    return v
}

function material_color(v: u8, a: u8, x: i32, y: i32) -> Rgb {
    let t: i32 = tex(x, y)
    if v == EMPTY {
        return Rgb { r: 12, g: 12, b: 18 }
    }
    if v == WALL {
        let s: i32 = 96 + t % 28
        return Rgb { r: s, g: s, b: clampc(s + 8) }
    }
    if v == SAND {
        return Rgb { r: clampc(198 + t % 32), g: clampc(168 + t % 28), b: clampc(78 + t % 24) }
    }
    if v == WATER {
        return Rgb { r: clampc(32 + t % 12), g: clampc(96 + t % 20), b: clampc(198 + t % 40) }
    }
    if v == BRINE {
        return Rgb { r: clampc(86 + t % 18), g: clampc(140 + t % 18), b: clampc(180 + t % 26) }
    }
    if v == OIL {
        let s2: i32 = t % 18
        return Rgb { r: clampc(62 + s2), g: clampc(44 + s2), b: clampc(28 + s2) }
    }
    if v == FIRE {
        # Hot core fading to red as the cell burns down.
        let heat: i32 = a as i32
        let r: i32 = clampc(228 + heat / 3)
        let g: i32 = clampc(88 + heat * 2 + t % 34)
        let b: i32 = clampc(heat / 3 - 8)
        return Rgb { r: r, g: g, b: b }
    }
    if v == PLANT {
        # Older growth darkens a little but stays unmistakably green.
        let gen: i32 = a as i32
        return Rgb { r: clampc(28 + gen / 2), g: clampc(178 - gen + t % 22), b: clampc(58 + gen / 3) }
    }
    if v == SALT {
        let s3: i32 = 226 + t % 26
        return Rgb { r: clampc(s3), g: clampc(s3), b: 255 }
    }
    if v == STEAM {
        let s4: i32 = 150 + (a as i32) / 6 + t % 24
        return Rgb { r: clampc(s4), g: clampc(s4 + 6), b: clampc(s4 + 16) }
    }
    if v == ICE {
        return Rgb { r: clampc(158 + t % 22), g: clampc(214 + t % 20), b: 250 }
    }
    if v == SRC_WATER {
        return Rgb { r: 60, g: 190, b: 255 }
    }
    if v == SRC_SAND {
        return Rgb { r: 255, g: 214, b: 96 }
    }
    return Rgb { r: 180, g: 120, b: 60 }
}

function fb_set(x: i32, y: i32, c: Rgb) -> void {
    if !inb(x, y) {
        return
    }
    let o: i32 = (y * GRID_W + x) * 3
    fb[o] = clampc(c.r) as u8
    fb[o + 1] = clampc(c.g) as u8
    fb[o + 2] = clampc(c.b) as u8
}

# One pass over the grid: paint every cell and count the live particles.
function render_grid() -> i32 {
    let mut count: i32 = 0
    let mut y: i32 = 0
    while y < GRID_H {
        let mut x: i32 = 0
        while x < GRID_W {
            let i: i32 = y * GRID_W + x
            let v: u8 = cells[i]
            let c: Rgb = material_color(v, aux[i], x, y)
            let o: i32 = i * 3
            fb[o] = c.r as u8
            fb[o + 1] = c.g as u8
            fb[o + 2] = c.b as u8
            if v != EMPTY and v != WALL {
                count = count + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return count
}

function overlay_cursor(cx: i32, cy: i32, r: i32, c: Rgb) -> void {
    let inner: i32 = r * r
    let outer: i32 = (r + 1) * (r + 1) + r
    let mut dy: i32 = 0 - r - 1
    while dy <= r + 1 {
        let mut dx: i32 = 0 - r - 1
        while dx <= r + 1 {
            let d2: i32 = dx * dx + dy * dy
            if d2 >= inner and d2 <= outer {
                fb_set(cx + dx, cy + dy, c)
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
    fb_set(cx, cy, c)
}

# ============================================================================
# PALETTE AND PEN
# ============================================================================

function palette_at(i: i32) -> u8 {
    if i == 0 { return WALL }
    if i == 1 { return SAND }
    if i == 2 { return WATER }
    if i == 3 { return OIL }
    if i == 4 { return FIRE }
    if i == 5 { return PLANT }
    if i == 6 { return SALT }
    if i == 7 { return ICE }
    if i == 8 { return SRC_WATER }
    if i == 9 { return EMPTY }
    if i == 10 { return STEAM }
    if i == 11 { return BRINE }
    if i == 12 { return SRC_SAND }
    return SRC_OIL
}

function material_name(v: u8) -> string {
    if v == WALL { return "WALL" }
    if v == SAND { return "SAND" }
    if v == WATER { return "WATER" }
    if v == OIL { return "OIL" }
    if v == FIRE { return "FIRE" }
    if v == PLANT { return "PLANT" }
    if v == SALT { return "SALT" }
    if v == ICE { return "ICE" }
    if v == SRC_WATER { return "SPOUT WATER" }
    if v == EMPTY { return "ERASER" }
    if v == STEAM { return "STEAM" }
    if v == BRINE { return "SALT WATER" }
    if v == SRC_SAND { return "SPOUT SAND" }
    return "SPOUT OIL"
}

function brush_radius(i: i32) -> i32 {
    if i <= 0 { return 1 }
    if i == 1 { return 2 }
    if i == 2 { return 3 }
    if i == 3 { return 5 }
    if i == 4 { return 8 }
    return 12
}

const BRUSH_STEPS: i32 = 6

# The pen never eats a wall: only the wall pen and the eraser touch one. That
# keeps a hand-drawn scene from dissolving under a careless sweep.
function paint_disc(cx: i32, cy: i32, r: i32, v: u8) -> void {
    let rr: i32 = r * r + r
    let a: u8 = initial_aux(v)
    let mut dy: i32 = 0 - r
    while dy <= r {
        let mut dx: i32 = 0 - r
        while dx <= r {
            if dx * dx + dy * dy <= rr {
                let px: i32 = cx + dx
                let py: i32 = cy + dy
                if inb(px, py) {
                    let i: i32 = idx(px, py)
                    let cur: u8 = cells[i]
                    if cur != WALL or v == WALL or v == EMPTY {
                        cells[i] = v
                        aux[i] = a
                    }
                }
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
}

function paint_stroke(x0: i32, y0: i32, x1: i32, y1: i32, r: i32, v: u8) -> void {
    let dx: i32 = x1 - x0
    let dy: i32 = y1 - y0
    let mut steps: i32 = iabs(dx)
    if iabs(dy) > steps {
        steps = iabs(dy)
    }
    if steps == 0 {
        paint_disc(x1, y1, r, v)
        return
    }
    let mut s: i32 = 0
    while s <= steps {
        paint_disc(x0 + dx * s / steps, y0 + dy * s / steps, r, v)
        s = s + 1
    }
}

# ============================================================================
# SCENE
# ============================================================================

function fill_rect_cells(x: i32, y: i32, w: i32, h: i32, v: u8) -> void {
    let mut j: i32 = 0
    while j < h {
        let mut i: i32 = 0
        while i < w {
            put(x + i, y + j, v, initial_aux(v))
            i = i + 1
        }
        j = j + 1
    }
}

function clear_grid() -> void {
    let n: i32 = GRID_W * GRID_H
    let mut i: i32 = 0
    while i < n {
        cells[i] = EMPTY
        aux[i] = 0 as u8
        i = i + 1
    }
}

function build_box() -> void {
    clear_grid()
    fill_rect_cells(0, GRID_H - 2, GRID_W, 2, WALL)
    fill_rect_cells(0, 0, 2, GRID_H, WALL)
    fill_rect_cells(GRID_W - 2, 0, 2, GRID_H, WALL)
}

# The opening scene exercises every interaction without a keypress: a water
# spout onto an ice shelf, a sand spout onto a ledge, an oil pool waiting for
# a spark, a pond with plants in it, and a salt block about to fall in.
function build_scene() -> void {
    build_box()

    fill_rect_cells(20, 96, 148, 5, WALL)      # left ledge
    fill_rect_cells(216, 70, 148, 5, WALL)     # right ledge
    fill_rect_cells(56, 142, 272, 5, WALL)     # middle ledge

    fill_rect_cells(60, 130, 264, 12, OIL)     # oil pool on the middle ledge
    fill_rect_cells(28, 84, 38, 12, ICE)       # ice shelf on the left ledge

    fill_rect_cells(92, 16, 8, 4, SRC_WATER)
    fill_rect_cells(270, 14, 8, 4, SRC_SAND)

    fill_rect_cells(2, 166, GRID_W - 4, 24, WATER)
    fill_rect_cells(336, 152, 22, 12, SALT)

    put(40, 189, PLANT, 0 as u8)
    put(41, 189, PLANT, 0 as u8)
    put(150, 189, PLANT, 0 as u8)
    put(151, 189, PLANT, 0 as u8)
    put(300, 189, PLANT, 0 as u8)
    put(301, 189, PLANT, 0 as u8)
}

# ============================================================================
# HUD
# ============================================================================

function draw_swatch(g: Gfx, x: i32, y: i32, w: i32, h: i32, v: u8, selected: bool) -> void {
    let c: Rgb = material_color(v, initial_aux(v), 3, 5)
    if v == EMPTY {
        gfx_fill_rect(g, x, y, w, h, 34, 34, 44)
    } else {
        gfx_fill_rect(g, x, y, w, h, c.r, c.g, c.b)
    }
    if selected {
        gfx_fill_rect(g, x - 2, y - 2, w + 4, 2, 255, 255, 255)
        gfx_fill_rect(g, x - 2, y + h, w + 4, 2, 255, 255, 255)
        gfx_fill_rect(g, x - 2, y - 2, 2, h + 4, 255, 255, 255)
        gfx_fill_rect(g, x + w, y - 2, 2, h + 4, 255, 255, 255)
    }
}

function swatch_key_char(i: i32) -> i32 {
    if i < 9 {
        return 49 + i
    }
    if i == 9 {
        return 48
    }
    return 0
}

function draw_hud(g: Gfx, sel: i32, brush_i: i32, particles: i32, fps: f64,
                  paused: bool) -> void {
    gfx_fill_rect(g, 0, 0, WIN_W, HUD_H, 22, 22, 30)
    gfx_fill_rect(g, 0, HUD_H - 2, WIN_W, 2, 60, 60, 78)

    let v: u8 = palette_at(sel)
    let c: Rgb = material_color(v, initial_aux(v), 3, 5)
    gfx_draw_text(g, 6, 5, material_name(v), 2, c.r, c.g, c.b)

    if paused {
        gfx_draw_text_right(g, WIN_W - 6, 5, "PAUSED", 2, 240, 210, 90)
    } else {
        gfx_draw_text_right(g, WIN_W - 6, 5, "FPS", 1, 130, 134, 150)
        let mut shown: f64 = fps
        if shown > 9999.0 {
            shown = 9999.0
        }
        gfx_draw_fixed(g, 273, 5, shown, 1, 2, 200, 230, 200)
    }

    gfx_draw_text(g, 6, 24, "BRUSH", 1, 130, 134, 150)
    gfx_draw_int(g, 42, 24, brush_radius(brush_i) * 2 + 1, 1, 230, 230, 240)
    gfx_draw_text(g, 78, 24, "PARTICLES", 1, 130, 134, 150)
    gfx_draw_int(g, 138, 24, particles, 1, 230, 230, 240)
    gfx_draw_text(g, 208, 24, "1-0 QE PICK  [] SIZE  C CLR", 1, 96, 100, 118)

    let mut i: i32 = 0
    while i < PALETTE_N {
        let sx: i32 = 6 + i * 27
        draw_swatch(g, sx, 38, 23, 16, palette_at(i), i == sel)
        let ch: i32 = swatch_key_char(i)
        if ch != 0 {
            gfx_draw_char(g, sx + 9, 42, ch, 1, 16, 16, 22)
        }
        i = i + 1
    }
}

# ============================================================================
# INPUT HELPERS
# ============================================================================

function held(g: Gfx, code: i32) -> bool {
    return gfx_key_down(g, code)
}

function edge(now: bool, prev: bool) -> bool {
    return now and !prev
}

function axis_speed(hold: i32) -> i32 {
    if hold < 6 { return 2 }
    if hold < 14 { return 4 }
    return 6
}

# ============================================================================
# MAIN
# ============================================================================

function main() -> i32 {
    let n: i32 = GRID_W * GRID_H
    cells = calloc(n as i64, 1) as ptr<u8>
    aux = calloc(n as i64, 1) as ptr<u8>
    moved = calloc(n as i64, 1) as ptr<u8>
    fb = calloc((n * 3) as i64, 1) as ptr<u8>
    if cells == null or aux == null or moved == null or fb == null {
        return 1
    }

    build_scene()

    let g: Gfx = gfx_open(WIN_W, WIN_H, "The Falling Sand Game - Flow")

    let mut sel: i32 = 1
    let mut brush_i: i32 = 2
    let mut cx: i32 = GRID_W / 2
    let mut cy: i32 = 36
    let mut paused: bool = false
    let mut scan_lr: bool = true
    let mut particles: i32 = 0
    let mut fps: f64 = 0.0

    let mut hold_x: i32 = 0
    let mut hold_y: i32 = 0

    let mut p_left: bool = false
    let mut p_right: bool = false
    let mut p_up: bool = false
    let mut p_down: bool = false
    let mut p_q: bool = false
    let mut p_e: bool = false
    let mut p_lb: bool = false
    let mut p_rb: bool = false
    let mut p_c: bool = false
    let mut p_p: bool = false
    let mut p_r: bool = false

    let mut fps_t0: i32 = clock()
    let mut fps_n: i32 = 0

    while !gfx_should_close(g) {
        gfx_poll(g)
        if gfx_key_down(g, KEY_ESC) {
            break
        }

        let k_left: bool = held(g, KEY_LEFT) or held(g, KEY_A)
        let k_right: bool = held(g, KEY_RIGHT) or held(g, KEY_D)
        let k_up: bool = held(g, KEY_UP) or held(g, KEY_W)
        let k_down: bool = held(g, KEY_DOWN) or held(g, KEY_S)
        let k_space: bool = held(g, KEY_SPACE)
        let k_q: bool = held(g, KEY_Q)
        let k_e: bool = held(g, KEY_E)
        let k_lb: bool = held(g, KEY_LBRACK)
        let k_rb: bool = held(g, KEY_RBRACK)
        let k_c: bool = held(g, KEY_C)
        let k_p: bool = held(g, KEY_P)
        let k_r: bool = held(g, KEY_R)

        # Element selection.
        if held(g, KEY_1) { sel = 0 }
        if held(g, KEY_2) { sel = 1 }
        if held(g, KEY_3) { sel = 2 }
        if held(g, KEY_4) { sel = 3 }
        if held(g, KEY_5) { sel = 4 }
        if held(g, KEY_6) { sel = 5 }
        if held(g, KEY_7) { sel = 6 }
        if held(g, KEY_8) { sel = 7 }
        if held(g, KEY_9) { sel = 8 }
        if held(g, KEY_0) { sel = 9 }
        if edge(k_q, p_q) {
            sel = (sel + PALETTE_N - 1) % PALETTE_N
        }
        if edge(k_e, p_e) {
            sel = (sel + 1) % PALETTE_N
        }
        if edge(k_lb, p_lb) and brush_i > 0 {
            brush_i = brush_i - 1
        }
        if edge(k_rb, p_rb) and brush_i < BRUSH_STEPS - 1 {
            brush_i = brush_i + 1
        }
        if edge(k_p, p_p) {
            paused = !paused
        }
        if edge(k_c, p_c) {
            build_box()
        }
        if edge(k_r, p_r) {
            build_scene()
        }

        # Pen movement, with a hold ramp so long sweeps are quick and taps are
        # precise.
        if k_left or k_right {
            hold_x = hold_x + 1
        } else {
            hold_x = 0
        }
        if k_up or k_down {
            hold_y = hold_y + 1
        } else {
            hold_y = 0
        }
        let px: i32 = cx
        let py: i32 = cy
        let sx: i32 = axis_speed(hold_x)
        let sy: i32 = axis_speed(hold_y)
        if k_left {
            cx = cx - sx
        }
        if k_right {
            cx = cx + sx
        }
        if k_up {
            cy = cy - sy
        }
        if k_down {
            cy = cy + sy
        }
        if cx < 0 { cx = 0 }
        if cx > GRID_W - 1 { cx = GRID_W - 1 }
        if cy < 0 { cy = 0 }
        if cy > GRID_H - 1 { cy = GRID_H - 1 }

        let r: i32 = brush_radius(brush_i)
        if k_space {
            paint_stroke(px, py, cx, cy, r, palette_at(sel))
        }

        if !paused {
            let mut s: i32 = 0
            while s < SUBSTEPS {
                simulate(scan_lr)
                scan_lr = !scan_lr
                s = s + 1
            }
        }

        particles = render_grid()
        overlay_cursor(cx, cy, r, Rgb { r: 255, g: 255, b: 255 })

        gfx_clear(g, 12, 12, 18)
        gfx_blit_rgb(g, 0, HUD_H, GRID_W, GRID_H, fb)
        draw_hud(g, sel, brush_i, particles, fps, paused)
        gfx_present(g)

        fps_n = fps_n + 1
        if fps_n >= 15 {
            let t1: i32 = clock()
            let dt: f64 = ((t1 - fps_t0) as f64) / 1000000.0
            if dt > 0.0 {
                fps = (fps_n as f64) / dt
            }
            fps_t0 = t1
            fps_n = 0
        }

        p_left = k_left
        p_right = k_right
        p_up = k_up
        p_down = k_down
        p_q = k_q
        p_e = k_e
        p_lb = k_lb
        p_rb = k_rb
        p_c = k_c
        p_p = k_p
        p_r = k_r
    }

    gfx_close(g)
    return 0
}
