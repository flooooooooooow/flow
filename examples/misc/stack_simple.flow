# Simple Stack Implementation - FLOW version
function main() -> i32 {
    # Simulate stack operations with variables
    let stack_size: i32 = 0
    let result: i32 = 0
    
    # Push operations (increment stack size)
    stack_size = stack_size + 1  # push 10
    stack_size = stack_size + 1  # push 20
    stack_size = stack_size + 1  # push 30
    
    # Pop operations (decrement stack size)
    stack_size = stack_size - 1  # pop
    stack_size = stack_size - 1  # pop
    stack_size = stack_size - 1  # pop
    
    # Return final stack size (should be 0)
    return stack_size
}
