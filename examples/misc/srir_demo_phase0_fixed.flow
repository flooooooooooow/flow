function clamp_i32(v: i32, lo: i32, hi: i32) -> i32 {
    let result: i32 = v
    if result < lo {
        result = lo
    }
    if result > hi {
        result = hi
    }
    return result
}

function main() -> i32 {
    let w: i32 = 128
    let h: i32 = 96

    # Phase 0 SRIR (minimal): a Transform group with two DrawRect nodes.
    # Represented with primitives only (FLOW MLIR backend does not lower struct types yet).
    let tx: i32 = 12
    let ty: i32 = 12

    # Local rects
    let panel_lx: i32 = 0
    let panel_ly: i32 = 0
    let panel_lw: i32 = 104
    let panel_lh: i32 = 72

    let hi_lx: i32 = 6
    let hi_ly: i32 = 6
    let hi_lw: i32 = 92
    let hi_lh: i32 = 18

    # World rects (translation only in Phase 0)
    let panel_x: i32 = panel_lx + tx
    let panel_y: i32 = panel_ly + ty
    let panel_w: i32 = panel_lw
    let panel_h: i32 = panel_lh

    let hi_x: i32 = hi_lx + tx
    let hi_y: i32 = hi_ly + ty
    let hi_w: i32 = hi_lw
    let hi_h: i32 = hi_lh

    # SRIR dump (deterministic, human-readable)
    printf("SRIR nodes=4 root=0\n")
    printf("node 0 kind=Group fc=1 ns=-1\n")
    printf("node 1 kind=Transform tx=%d ty=%d fc=2 ns=-1\n", tx, ty)
    printf("node 2 kind=DrawRect lb=%d,%d,%d,%d rgba=%d,%d,%d,%d\n", panel_lx, panel_ly, panel_lw, panel_lh, 32, 40, 60, 255)
    printf("node 3 kind=DrawRect lb=%d,%d,%d,%d rgba=%d,%d,%d,%d\n", hi_lx, hi_ly, hi_lw, hi_lh, 80, 170, 255, 200)

    # RPlan dump (scheduled draw ops with world-space bounds)
    printf("RPLAN ops=2\n")
    printf("op 0 kind=FillRect bb=%d,%d,%d,%d rgba=%d,%d,%d,%d\n", panel_x, panel_y, panel_w, panel_h, 32, 40, 60, 255)
    printf("op 1 kind=FillRect bb=%d,%d,%d,%d rgba=%d,%d,%d,%d\n", hi_x, hi_y, hi_w, hi_h, 80, 170, 255, 200)

    # CPU raster (procedural, per-pixel) -> ASCII PPM
    printf("P3\n%d %d\n255\n", w, h)
    let y: i32 = 0
    for y in 0..h {
        let x: i32 = 0
        for x in 0..w {
            # Direct color computation without reassignment
            if x >= hi_x {
                if y >= hi_y {
                    if x < hi_x + hi_w {
                        if y < hi_y + hi_h {
                            let sa: i32 = 200
                            let inva: i32 = 255 - sa
                            let r: i32 = (80 * sa + 32 * inva) / 255
                            let g: i32 = (170 * sa + 40 * inva) / 255
                            let b: i32 = (255 * sa + 60 * inva) / 255
                            printf("%d %d %d\n", r, g, b)
                        } else {
                            printf("%d %d %d\n", 20, 20, 24)
                        }
                    } else {
                        printf("%d %d %d\n", 20, 20, 24)
                    }
                } else {
                    printf("%d %d %d\n", 20, 20, 24)
                }
            } elif x >= panel_x {
                if y >= panel_y {
                    if x < panel_x + panel_w {
                        if y < panel_y + panel_h {
                            printf("%d %d %d\n", 32, 40, 60)
                        } else {
                            printf("%d %d %d\n", 20, 20, 24)
                        }
                    } else {
                        printf("%d %d %d\n", 20, 20, 24)
                    }
                } else {
                    printf("%d %d %d\n", 20, 20, 24)
                }
            } else {
                printf("%d %d %d\n", 20, 20, 24)
            }
        }
    }

    return 0
}
