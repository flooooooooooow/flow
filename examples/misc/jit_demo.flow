# JIT Demo with Hot Reload
# This file demonstrates FLOW's JIT compilation and hot reload capabilities

# Simple function that will be recompiled on changes
function calculate(x: i32, y: i32) -> i32 {
    let result: i32 = x * y + 42
    return result
}

# Main function for JIT execution
function main() -> i32 {
    let a: i32 = 10
    let b: i32 = 20
    
    let result: i32 = calculate(a, b)
    
    # In a real JIT, this would print to console
    # For now, just return the result
    return result
}
