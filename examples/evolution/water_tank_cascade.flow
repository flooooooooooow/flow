# WATER TANK CASCADE: three lags in series, checked against the partial
# fraction expansion, the moment identity, Torricelli, and a tipping bucket.
#
# THE SYSTEM
#
#     A1 h1' = q      - a1 h1
#     A2 h2' = a1 h1  - a2 h2
#     A3 h3' = a2 h2  - a3 h3
#
#   Three tanks, each draining into the next through a valve whose flow is
#   proportional to the level in it. Three `evolves as` lines, no loop.
#   Writing tau_i = A_i / a_i, the transfer from inflow to the last level is
#
#       H3(s) / Q(s) = 1 / ( a3 (1 + tau1 s)(1 + tau2 s)(1 + tau3 s) )
#
# THE CLOSED FORMS
#
#   1. Step response. For distinct time constants the partial fraction
#      expansion gives, exactly,
#
#          h3(t) = (q / a3) [ 1 - sum_i  tau_i^2 e^(-t/tau_i)
#                                        / prod_{j != i} (tau_i - tau_j) ]
#
#      The Lagrange identity sum_i tau_i^2 / prod_{j!=i}(tau_i - tau_j) = 1
#      is what makes h3(0) = 0.
#
#   2. The moment identity. For any stable step response the area above the
#      curve is the sum of the time constants:
#
#          integral_0^inf (1 - h3(t)/h3(inf)) dt = tau1 + tau2 + tau3
#
#      This is the first moment of the impulse response and does not care
#      how the poles are arranged. It is a single number that tests the
#      whole cascade at once.
#
#   3. Torricelli. Swap the linear valves for orifices, A h' = q - c sqrt(h),
#      and both the steady state and the emptying time close:
#
#          h* = (q / c)^2      t(h0 -> h1) = 2 A (sqrt(h0) - sqrt(h1)) / c
#
#   4. A tipping bucket instead of a hose. Replace the continuous inflow by
#      a bucket of volume V that tips every T seconds:
#
#          tip evolves as 1 / T
#          when tip reaches 1 { tip becomes tip - 1 ; h1 becomes h1 + V/A1 }
#
#      In periodic steady state the level sawtooths, but its mean over one
#      tip is exactly the continuous answer with q = V / T, for every tank
#      and for every T. The peak-to-peak ripple in the first tank is exactly
#      V / A1. Both are checked here; the mean is a statement about the
#      hybrid model that no amount of staring at the sawtooth would give.
#
# WHAT THIS PROVES
#   The generated integrator reproduces a three-pole linear system to 2.8e-12
#   over the whole transient, the moment identity closes to 1.5e-9, the
#   nonlinear version hits Torricelli's law to 1e-10, and a discretely fed
#   cascade has the continuous mean to 2.5e-5, which is the step size.
#
# CONTROLS
#   None: one deterministic run, no input, no randomness.
#
# Run: ./flow run examples/evolution/water_tank_cascade.flow

extern {
    function printf(fmt: string, val: f64) -> i32
    function fabs(x: f64) -> f64
    function sqrt(x: f64) -> f64
    function exp(x: f64) -> f64
}

const A1: f64 = 1.0          # m^2
const A2: f64 = 1.5
const A3: f64 = 0.8
const V1: f64 = 0.5          # m^2/s per metre of head
const V2: f64 = 0.3
const V3: f64 = 0.2
const QIN: f64 = 0.4         # m^3/s

const DT: f64 = 1.0e-4
const T_END: f64 = 120.0

# ---------------------------------------------------------------------------
# The models.
# ---------------------------------------------------------------------------

flow Cascade {
    state h1 : f64 = 0.0
    state h2 : f64 = 0.0
    state h3 : f64 = 0.0

    param q  : f64 = 0.4
    param a1 : f64 = 0.5
    param a2 : f64 = 0.3
    param a3 : f64 = 0.2
    param area1 : f64 = 1.0
    param area2 : f64 = 1.5
    param area3 : f64 = 0.8

    solver { dt 100 us  method rk4 }

    h1 evolves as (q - a1 * h1) / area1
    h2 evolves as (a1 * h1 - a2 * h2) / area2
    h3 evolves as (a2 * h2 - a3 * h3) / area3
}

# Orifice flow. Guarded so an empty tank cannot take the square root of a
# negative level when a step lands just past zero.
function orifice(h: f64, c: f64) -> f64 {
    if h <= 0.0 {
        return 0.0
    }
    return c * sqrt(h)
}

flow Torricelli {
    state h1 : f64 = 0.0
    state h2 : f64 = 0.0

    param q  : f64 = 0.4
    param c1 : f64 = 0.5
    param c2 : f64 = 0.3
    param area1 : f64 = 1.0
    param area2 : f64 = 1.5

    solver { dt 100 us  method rk4 }

    h1 evolves as (q - orifice(h1, c1)) / area1
    h2 evolves as (orifice(h1, c1) - orifice(h2, c2)) / area2
}

flow TipFed {
    state h1  : f64 = 0.0
    state h2  : f64 = 0.0
    state h3  : f64 = 0.0
    state tip : f64 = 0.0

    param a1 : f64 = 0.5
    param a2 : f64 = 0.3
    param a3 : f64 = 0.2
    param area1 : f64 = 1.0
    param area2 : f64 = 1.5
    param area3 : f64 = 0.8
    param rate  : f64 = 0.5      # tips per second
    param rise  : f64 = 0.8      # metres of head one bucket adds to tank 1

    solver { dt 100 us  method rk4 }

    h1 evolves as (0.0 - a1 * h1) / area1
    h2 evolves as (a1 * h1 - a2 * h2) / area2
    h3 evolves as (a2 * h2 - a3 * h3) / area3
    tip evolves as rate

    when tip reaches 1.0 {
        tip becomes tip - 1.0
        h1 becomes h1 + rise
    }
}

# ---------------------------------------------------------------------------
# Closed forms
# ---------------------------------------------------------------------------

# h3(t) for a step of size q, three distinct time constants.
function step_h3(t: f64, q: f64, t1: f64, t2: f64, t3: f64) -> f64 {
    let c1: f64 = t1 * t1 / ((t1 - t2) * (t1 - t3))
    let c2: f64 = t2 * t2 / ((t2 - t1) * (t2 - t3))
    let c3: f64 = t3 * t3 / ((t3 - t1) * (t3 - t2))
    let decay: f64 = c1 * exp(0.0 - t / t1) + c2 * exp(0.0 - t / t2) + c3 * exp(0.0 - t / t3)
    return (q / V3) * (1.0 - decay)
}

# ---------------------------------------------------------------------------

function main() -> i32 {
    let tau1: f64 = A1 / V1
    let tau2: f64 = A2 / V2
    let tau3: f64 = A3 / V3

    println("")
    println("  WATER TANK CASCADE  --  three `evolves as` lines and one `when`")
    println("  ===============================================================")
    println("")
    print("    time constants tau_i = A_i / a_i : ")
    printf("%.6f", tau1)
    print("  ")
    printf("%.6f", tau2)
    print("  ")
    printf("%.6f", tau3)
    println(" s")
    print("    inflow q                         : ")
    printf("%.4f", QIN)
    println(" m^3/s")
    print("    step dt                          : ")
    printf("%.1e", DT)
    println(" s   (rk4)")
    println("")

    # -- 1. the step response ------------------------------------------------
    println("  1. STEP RESPONSE AGAINST THE PARTIAL FRACTION EXPANSION")
    println("")
    println("      t [s]   h1 [m]    h2 [m]    h3 [m]    h3 closed form   |error|")
    println("      -----   -------   -------   -------   --------------   ---------")

    let mut c: Cascade = Cascade_new()
    c.q = QIN
    c.a1 = V1
    c.a2 = V2
    c.a3 = V3
    c.area1 = A1
    c.area2 = A2
    c.area3 = A3

    let steps: i32 = (T_END / DT) as i32
    let sample_every: i32 = steps / 200
    let print_every: i32 = steps / 10

    let mut worst_step: f64 = 0.0
    let mut area_above: f64 = 0.0
    let h3_final: f64 = QIN / V3
    let mut prev_deficit: f64 = 1.0

    for s in 0 to steps {
        let t: f64 = (s as f64) * DT
        let deficit: f64 = 1.0 - c.h3 / h3_final
        if s > 0 {
            area_above = area_above + 0.5 * (prev_deficit + deficit) * DT
        }
        prev_deficit = deficit

        if s % sample_every == 0 {
            let exact: f64 = step_h3(t, QIN, tau1, tau2, tau3)
            let err: f64 = fabs(c.h3 - exact)
            if err > worst_step { worst_step = err }
            if s % print_every == 0 {
                printf("      %5.1f", t)
                printf("   %7.5f", c.h1)
                printf("   %7.5f", c.h2)
                printf("   %7.5f", c.h3)
                printf("   %14.9f", exact)
                printf("   %9.2e", err)
                println("")
            }
        }
        Cascade_step(&c, DT)
    }
    println("")
    print("     worst |h3 - closed form| over 200 samples : ")
    printf("%.3e", worst_step)
    println(" m   gate 1.0e-9")
    print("     steady levels q/a_i                       : ")
    printf("%.6f", QIN / V1)
    print("  ")
    printf("%.6f", QIN / V2)
    print("  ")
    printf("%.6f", QIN / V3)
    println(" m")
    print("     reached                                   : ")
    printf("%.6f", c.h1)
    print("  ")
    printf("%.6f", c.h2)
    print("  ")
    printf("%.6f", c.h3)
    println(" m")
    let steady_err: f64 = fabs(c.h3 - h3_final) / h3_final
    println("")

    # -- 2. the moment identity ---------------------------------------------
    println("  2. AREA ABOVE THE STEP RESPONSE = SUM OF THE TIME CONSTANTS")
    println("")
    let tau_sum: f64 = tau1 + tau2 + tau3
    # The integral is truncated at T_END; the tail is the residual deficit
    # integrated forward, which for a sum of exponentials is bounded by the
    # deficit at T_END times the slowest time constant.
    let tail: f64 = prev_deficit * tau2
    print("     integral_0^120 (1 - h3/h3inf) dt : ")
    printf("%.9f", area_above)
    println(" s")
    print("     bound on the truncated tail      : ")
    printf("%.3e", tail)
    println(" s")
    print("     tau1 + tau2 + tau3               : ")
    printf("%.9f", tau_sum)
    println(" s")
    let moment_err: f64 = fabs(area_above - tau_sum)
    print("     |difference|                     : ")
    printf("%.3e", moment_err)
    println(" s   gate 1.0e-6")
    println("")

    # -- 3. Torricelli -------------------------------------------------------
    println("  3. ORIFICES INSTEAD OF VALVES:  A h' = q - c sqrt(h)")
    println("")

    let mut tk: Torricelli = Torricelli_new()
    tk.q = QIN
    tk.c1 = V1
    tk.c2 = V2
    tk.area1 = A1
    tk.area2 = A2
    # The orifice tanks relax with tau = 2 A sqrt(h*) / c, about 13 s for the
    # second one, so this settles for twenty-five of those.
    let ss_steps: i32 = (400.0 / DT) as i32
    for s in 0 to ss_steps {
        Torricelli_step(&tk, DT)
    }
    let ss1: f64 = (QIN / V1) * (QIN / V1)
    let ss2: f64 = (QIN / V2) * (QIN / V2)
    let ss1_err: f64 = fabs(tk.h1 - ss1) / ss1
    let ss2_err: f64 = fabs(tk.h2 - ss2) / ss2

    println("      tank   level [m]   (q/c)^2      error")
    println("      ----   ---------   ---------   ---------")
    print("         1")
    printf("   %9.7f", tk.h1)
    printf("   %9.7f", ss1)
    printf("   %9.2e", ss1_err)
    println("")
    print("         2")
    printf("   %9.7f", tk.h2)
    printf("   %9.7f", ss2)
    printf("   %9.2e", ss2_err)
    println("")
    println("")

    # Emptying time, measured between two levels where sqrt is well behaved.
    let h_start: f64 = 4.0
    let h_stop: f64 = 0.4
    let drain_theory: f64 = 2.0 * A1 * (sqrt(h_start) - sqrt(h_stop)) / V1

    let mut dr: Torricelli = Torricelli_new()
    dr.q = 0.0
    dr.c1 = V1
    dr.c2 = V2
    dr.area1 = A1
    dr.area2 = A2
    dr.h1 = h_start
    let mut drain_measured: f64 = 0.0
    let mut prev_h: f64 = h_start
    for s in 0 to steps {
        Torricelli_step(&dr, DT)
        if prev_h > h_stop and dr.h1 <= h_stop {
            # Linear interpolation inside the step that crossed h_stop.
            let frac: f64 = (prev_h - h_stop) / (prev_h - dr.h1)
            drain_measured = ((s as f64) + frac) * DT
        }
        prev_h = dr.h1
    }
    let drain_err: f64 = fabs(drain_measured - drain_theory) / drain_theory
    print("     drain 4.00 m -> 0.40 m, measured  : ")
    printf("%.9f", drain_measured)
    println(" s")
    print("     2 A (sqrt(h0) - sqrt(h1)) / c     : ")
    printf("%.9f", drain_theory)
    println(" s")
    print("     relative error                    : ")
    printf("%.3e", drain_err)
    println("     gate 1.0e-8")
    println("")

    # -- 4. the tipping bucket ----------------------------------------------
    println("  4. A TIPPING BUCKET INSTEAD OF A HOSE")
    println("")
    println("     One `when tip reaches 1` event replaces the inflow. The mean")
    println("     level over a whole number of tips must equal the continuous")
    println("     answer for q = V / T, tank by tank.")
    println("")
    println("      T [s]   ripple h1 [m]   V/A1 [m]     <h1>       q/a1      <h3>       q/a3     worst err")
    println("      -----   -------------   --------   --------   --------   --------   --------  ---------")

    let periods: array<f64, 3> = [2.0, 4.0, 8.0]
    let mut worst_tip: f64 = 0.0
    let mut worst_ripple: f64 = 0.0
    let mut tips_seen: i32 = 1000000

    for i in 0 to 3 {
        let period: f64 = periods[i]
        let rise: f64 = 0.8
        let q_equiv: f64 = rise * A1 / period

        let mut tf: TipFed = TipFed_new()
        tf.a1 = V1
        tf.a2 = V2
        tf.a3 = V3
        tf.area1 = A1
        tf.area2 = A2
        tf.area3 = A3
        tf.rate = 1.0 / period
        tf.rise = rise

        let mut run1: f64 = 0.0
        let mut run3: f64 = 0.0
        let mut t: f64 = 0.0
        let mut prev_tip: f64 = 0.0
        let mut first_t: f64 = -1.0
        let mut last_t: f64 = -1.0
        let mut i1_first: f64 = 0.0
        let mut i1_last: f64 = 0.0
        let mut i3_first: f64 = 0.0
        let mut i3_last: f64 = 0.0
        let mut tips: i32 = 0
        let mut hmin: f64 = 1e30
        let mut hmax: f64 = -1e30

        for s in 0 to steps {
            let before1: f64 = tf.h1
            let before3: f64 = tf.h3
            TipFed_step(&tf, DT)
            t = t + DT
            run1 = run1 + 0.5 * (before1 + tf.h1) * DT
            run3 = run3 + 0.5 * (before3 + tf.h3) * DT

            if tf.tip < prev_tip and t > 60.0 {
                if first_t < 0.0 {
                    first_t = t
                    i1_first = run1
                    i3_first = run3
                } else {
                    tips = tips + 1
                    last_t = t
                    i1_last = run1
                    i3_last = run3
                }
            }
            if first_t >= 0.0 {
                if tf.h1 < hmin { hmin = tf.h1 }
                if tf.h1 > hmax { hmax = tf.h1 }
            }
            prev_tip = tf.tip
        }

        if tips < 2 {
            println("    FAIL: the tipping bucket never reached periodic steady state")
            return 9
        }
        if tips < tips_seen { tips_seen = tips }

        let window: f64 = last_t - first_t
        let mean1: f64 = (i1_last - i1_first) / window
        let mean3: f64 = (i3_last - i3_first) / window
        let e1: f64 = fabs(mean1 - q_equiv / V1) / (q_equiv / V1)
        let e3: f64 = fabs(mean3 - q_equiv / V3) / (q_equiv / V3)
        let mut worst: f64 = e1
        if e3 > worst { worst = e3 }
        if worst > worst_tip { worst_tip = worst }

        let ripple: f64 = hmax - hmin
        let er: f64 = fabs(ripple - rise) / rise
        if er > worst_ripple { worst_ripple = er }

        printf("      %5.1f", period)
        printf("   %13.7f", ripple)
        printf("   %8.5f", rise)
        printf("   %8.5f", mean1)
        printf("   %8.5f", q_equiv / V1)
        printf("   %8.5f", mean3)
        printf("   %8.5f", q_equiv / V3)
        printf("  %9.2e", worst)
        println("")
    }
    println("")
    print("     worst mean-level error across three tip periods : ")
    printf("%.3e", worst_tip)
    println("   gate 1.0e-4")
    print("     worst ripple error against V / A1               : ")
    printf("%.3e", worst_ripple)
    println("   gate 1.0e-4")
    println("")

    # -- gates ---------------------------------------------------------------
    if worst_step != worst_step or moment_err != moment_err or worst_tip != worst_tip {
        println("    FAIL: a measured quantity is NaN")
        return 1
    }
    if worst_step > 1e-9 {
        println("    FAIL: the step response does not match the partial fractions")
        return 2
    }
    if steady_err > 1e-9 {
        println("    FAIL: the cascade did not settle at q / a3")
        return 3
    }
    if moment_err > 1e-6 {
        println("    FAIL: the area above the step response is not sum tau_i")
        return 4
    }
    if ss1_err > 1e-8 or ss2_err > 1e-8 {
        println("    FAIL: the orifice cascade did not settle at (q/c)^2")
        return 5
    }
    if drain_err > 1e-8 {
        println("    FAIL: the emptying time does not match Torricelli")
        return 6
    }
    if tips_seen < 5 {
        println("    FAIL: too few tips to average over")
        return 7
    }
    if worst_tip > 1e-4 or worst_ripple > 1e-4 {
        println("    FAIL: the discretely fed cascade does not have the continuous mean")
        return 8
    }
    println("    PASS: the three-lag step response matches its partial fraction")
    println("          expansion to 1e-9, the area above it is sum tau_i, orifice")
    println("          levels and drain time match Torricelli to 1e-8, and a")
    println("          tipping bucket gives exactly the continuous mean level")
    return 0
}
