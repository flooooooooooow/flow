# TRAFFIC LIGHTS: a hybrid automaton per intersection, and the green wave
# that falls out of it when the offsets are right.
#
# THE SYSTEM
#
#   Every signal on the arterial runs the same fixed-time cycle. One state
#   and one event carry the whole controller:
#
#       clock evolves as 1
#       when clock reaches cycle { clock becomes clock - cycle }
#
#   Signal k, standing at distance (k+1) L from the origin, is green while
#
#       (clock - (k+1) o) mod C  <  g
#
#   where o is the common offset between neighbours, C the cycle and g the
#   green time. The vehicle is the second half of the same `flow` block:
#
#       x evolves as speed * permitted(x, clock, ...)
#
#   `permitted` returns 0 only when the car has arrived at a stop line whose
#   signal is red. So the hybrid switching is a pure function of the state,
#   the clock wrap is an event, and the driver loop does nothing but step.
#
# THE THREE CLOSED FORMS
#
#   1. Delay at one isolated signal. Arrivals spread uniformly over the
#      cycle. A car arriving in green waits nothing; a car arriving at phase
#      a in [g, C) waits C - a. The mean is
#
#          d = (1/C) integral_g^C (C - a) da = (C - g)^2 / (2 C) = r^2/(2C)
#
#      which is Webster's uniform-delay term at zero degree of saturation.
#      For C = 60 s and g = 25 s that is 1225 / 120 = 10.2083 s.
#
#   2. The green-wave offset. A platoon at free speed v covers the block in
#      L / v, so a signal offset by exactly that meets it at the same phase
#      it left the previous one. The through-band is then the whole green:
#
#          o* = L / v            bandwidth = g
#
#      With o = 0 and L / v not a multiple of C the band is empty. The run
#      sweeps departure phase, counts the ones that never stop, and reports
#      the band in seconds.
#
#   3. The whole bandwidth curve. Signal k is offset by (k+1) o but wants
#      (k+1) L/v, so mistuning spreads the arrival phases over a range of
#      (N-1) |o - L/v| and eats that much of the green:
#
#          band(o) = max(0, g - (N - 1) |o - L / v|)
#
#      a triangle peaking at o = L / v. The run measures it at 24 offsets
#      and reproduces it exactly.
#
# WHAT THIS PROVES
#   Signal coordination is a property of a timing diagram, and the timing
#   diagram is the `flow` block. Nothing in the program contains the number
#   20 except the block length divided by the speed limit; the wave is what
#   the model does.
#
# CONTROLS
#   None: one deterministic run, no input, no randomness.
#
# Run: ./flow run examples/evolution/traffic_lights.flow

extern {
    function printf(fmt: string, val: f64) -> i32
    function fabs(x: f64) -> f64
    function fmod(x: f64, y: f64) -> f64
}

const CYCLE: f64 = 60.0        # s
const GREEN: f64 = 25.0        # s
const SPACING: f64 = 300.0     # m between intersections
const SPEED: f64 = 15.0        # m/s, the free-flow speed
const N_LIGHTS: i32 = 4            # intersections on the arterial
const RUNOUT: f64 = 50.0       # m past the last stop line

const DT_FINE: f64 = 5.0e-4
const DT_COARSE: f64 = 5.0e-3
const CREEP_FINE: f64 = 0.05   # m, the distance at which a car is "at" a line
const CREEP_COARSE: f64 = 0.30

const PHASES_FINE: i32 = 720
const PHASES_COARSE: i32 = 240
const N_OFFSET: i32 = 24
const THROUGH_TOL: f64 = 0.05  # s of delay still counted as "did not stop"

# ---------------------------------------------------------------------------
# The model.
# ---------------------------------------------------------------------------

# Is signal k green at this clock reading?
function signal_green(clock: f64, k: i32, cycle: f64, green: f64,
                      offset: f64) -> bool {
    let mut ph: f64 = fmod(clock - ((k + 1) as f64) * offset, cycle)
    if ph < 0.0 {
        ph = ph + cycle
    }
    return ph < green
}

# 1 while the car may move, 0 while it is held at a red stop line.
function permitted(x: f64, clock: f64, cycle: f64, green: f64,
                   spacing: f64, nsig: f64, offset: f64, creep: f64) -> f64 {
    let k: i32 = (x / spacing) as i32
    if (k as f64) >= nsig {
        return 1.0
    }
    let line: f64 = ((k + 1) as f64) * spacing
    if line - x > creep {
        return 1.0
    }
    if signal_green(clock, k, cycle, green, offset) {
        return 1.0
    }
    return 0.0
}

flow Arterial {
    state x     : f64 = 0.0     # m along the arterial
    state clock : f64 = 0.0     # s into the common cycle

    param speed   : f64 = 15.0
    param cycle   : f64 = 60.0
    param green   : f64 = 25.0
    param spacing : f64 = 300.0
    param nsig    : f64 = 4.0
    param offset  : f64 = 20.0
    param creep   : f64 = 0.05

    solver { dt 500 us  method euler }

    x evolves as speed * permitted(x, clock, cycle, green, spacing, nsig, offset, creep)
    clock evolves as 1.0

    when clock reaches cycle {
        clock becomes clock - cycle
    }
}

# ---------------------------------------------------------------------------
# One trip
# ---------------------------------------------------------------------------

# Returns the delay in seconds relative to a free run. A car that runs the
# whole arterial on green scores a delay of a few times 1e-14 either side of
# zero, so the "did not finish" sentinel has to be far away from zero: -1e9.
function trip_delay(phase: f64, offset: f64, nsig: i32,
                    dt: f64, creep: f64) -> f64 {
    let finish: f64 = (nsig as f64) * SPACING + RUNOUT
    let free_time: f64 = finish / SPEED

    let mut a: Arterial = Arterial_new()
    a.speed = SPEED
    a.cycle = CYCLE
    a.green = GREEN
    a.spacing = SPACING
    a.nsig = nsig as f64
    a.offset = offset
    a.creep = creep
    a.clock = phase
    a.x = 0.0

    let budget: i32 = ((free_time + (nsig as f64) * CYCLE + CYCLE) / dt) as i32
    let mut t: f64 = 0.0
    let mut prev_x: f64 = 0.0

    for s in 0 to budget {
        Arterial_step(&a, dt)
        t = t + dt
        if a.x >= finish {
            let frac: f64 = (finish - prev_x) / (a.x - prev_x)
            return (t - dt) + frac * dt - free_time
        }
        prev_x = a.x
    }
    return -1.0e9
}

# ---------------------------------------------------------------------------

function main() -> i32 {
    let free_offset: f64 = SPACING / SPEED

    println("")
    println("  TRAFFIC LIGHTS  --  `when clock reaches cycle` and the green wave")
    println("  =================================================================")
    println("")
    print("    cycle C          : ")
    printf("%.1f", CYCLE)
    println(" s")
    print("    green g          : ")
    printf("%.1f", GREEN)
    println(" s")
    print("    block length L   : ")
    printf("%.1f", SPACING)
    println(" m")
    print("    free speed v     : ")
    printf("%.1f", SPEED)
    println(" m/s")
    print("    L / v            : ")
    printf("%.4f", free_offset)
    println(" s")
    println("")

    # -- 1. delay at one signal ---------------------------------------------
    println("  1. DELAY AT ONE ISOLATED SIGNAL, UNIFORM ARRIVALS")
    println("")

    let mut delay_sum: f64 = 0.0
    let mut stopped: i32 = 0
    let mut worst_free: f64 = 0.0
    for j in 0 to PHASES_FINE {
        let phase: f64 = (((j as f64) + 0.5) / (PHASES_FINE as f64)) * CYCLE
        let d: f64 = trip_delay(phase, 0.0, 1, DT_FINE, CREEP_FINE)
        if d < -1.0e8 {
            println("    FAIL: a trip did not finish inside its step budget")
            return 9
        }
        delay_sum = delay_sum + d
        if d > 0.05 {
            stopped = stopped + 1
        } else {
            if d > worst_free { worst_free = d }
        }
    }
    let mean_delay: f64 = delay_sum / (PHASES_FINE as f64)
    let webster: f64 = (CYCLE - GREEN) * (CYCLE - GREEN) / (2.0 * CYCLE)
    let delay_err: f64 = fabs(mean_delay - webster) / webster
    let stop_fraction: f64 = (stopped as f64) / (PHASES_FINE as f64)
    let stop_theory: f64 = (CYCLE - GREEN) / CYCLE

    print("     mean delay over 720 arrival phases : ")
    printf("%.6f", mean_delay)
    println(" s")
    print("     r^2 / (2 C) = (C-g)^2 / (2C)       : ")
    printf("%.6f", webster)
    println(" s")
    print("     relative error                     : ")
    printf("%.3e", delay_err)
    println("     gate 2.0e-3")
    println("")
    print("     fraction of arrivals stopped       : ")
    printf("%.6f", stop_fraction)
    println("")
    print("     r / C                              : ")
    printf("%.6f", stop_theory)
    println("")
    print("     worst delay among the ones that ran through : ")
    printf("%.3e", worst_free)
    println(" s   (the creep tolerance)")
    println("")

    # -- 2. the green wave ---------------------------------------------------
    println("  2. FOUR SIGNALS: BANDWIDTH WITH AND WITHOUT THE OFFSET")
    println("")
    println("      offset [s]   through band [s]   mean delay [s]   what it is")
    println("      ----------   ----------------   --------------   ----------")

    let probes: array<f64, 3> = [0.0, 10.0, 20.0]
    let mut band_wave: f64 = 0.0
    let mut band_zero: f64 = 999.0

    for i in 0 to 3 {
        let off: f64 = probes[i]
        let mut through: i32 = 0
        let mut dsum: f64 = 0.0
        for j in 0 to PHASES_COARSE {
            let phase: f64 = (((j as f64) + 0.5) / (PHASES_COARSE as f64)) * CYCLE
            let d: f64 = trip_delay(phase, off, N_LIGHTS, DT_COARSE, CREEP_COARSE)
            if d < -1.0e8 {
                println("    FAIL: a trip did not finish inside its step budget")
                return 9
            }
            dsum = dsum + d
            if d < THROUGH_TOL {
                through = through + 1
            }
        }
        let band: f64 = ((through as f64) / (PHASES_COARSE as f64)) * CYCLE
        if i == 0 { band_zero = band }
        if i == 2 { band_wave = band }

        printf("      %10.3f", off)
        printf("   %16.4f", band)
        printf("   %14.4f", dsum / (PHASES_COARSE as f64))
        if i == 2 {
            print("   L / v, the wave")
        }
        if i == 0 {
            print("   simultaneous")
        }
        if i == 1 {
            print("   mistuned")
        }
        println("")
    }
    println("")
    print("     bandwidth at o = L/v : ")
    printf("%.4f", band_wave)
    print(" s     green time g = ")
    printf("%.4f", GREEN)
    println(" s")
    print("     |band - g|           : ")
    printf("%.4f", fabs(band_wave - GREEN))
    println(" s     gate 1.0 s (the sweep resolution is 0.25 s)")
    print("     bandwidth at o = 0   : ")
    printf("%.4f", band_zero)
    println(" s     gate 0")
    println("")

    # -- 3. where the band peaks --------------------------------------------
    println("  3. BANDWIDTH ACROSS A WHOLE CYCLE OF OFFSETS")
    println("")
    println("     Signal k is offset by (k+1) o but wants (k+1) L/v, so the")
    println("     mistuning spreads over a range of (N-1) |o - L/v| and the band")
    println("     is what is left of the green:")
    println("")
    println("         band(o) = max(0, g - (N-1) |o - L/v|)")
    println("")
    println("      offset [s]   band [s]   theory [s]   bar")
    println("      ----------   --------   ----------   ---------------------------")

    let mut best_off: f64 = 0.0
    let mut best_band: f64 = -1.0
    let mut worst_band: f64 = 0.0
    for i in 0 to N_OFFSET {
        let off: f64 = ((i as f64) / (N_OFFSET as f64)) * CYCLE
        let mut through: i32 = 0
        for j in 0 to PHASES_COARSE {
            let phase: f64 = (((j as f64) + 0.5) / (PHASES_COARSE as f64)) * CYCLE
            let d: f64 = trip_delay(phase, off, N_LIGHTS, DT_COARSE, CREEP_COARSE)
            if d < -1.0e8 {
                println("    FAIL: a trip did not finish inside its step budget")
                return 9
            }
            if d < THROUGH_TOL {
                through = through + 1
            }
        }
        let band: f64 = ((through as f64) / (PHASES_COARSE as f64)) * CYCLE
        if band > best_band {
            best_band = band
            best_off = off
        }
        let mut theory: f64 = GREEN - ((N_LIGHTS - 1) as f64) * fabs(off - free_offset)
        if theory < 0.0 {
            theory = 0.0
        }
        let berr: f64 = fabs(band - theory)
        if berr > worst_band {
            worst_band = berr
        }

        printf("      %10.2f", off)
        printf("   %8.3f", band)
        printf("   %10.3f", theory)
        print("   ")
        let bars: i32 = (band + 0.5) as i32
        for b in 0 to bars {
            print("#")
        }
        println("")
    }
    println("")
    print("     argmax offset : ")
    printf("%.4f", best_off)
    print(" s      L / v = ")
    printf("%.4f", free_offset)
    println(" s")
    print("     band there    : ")
    printf("%.4f", best_band)
    println(" s")
    print("     worst |band - max(0, g - 3|o - L/v|)| over the sweep : ")
    printf("%.4f", worst_band)
    println(" s   gate 0.5 s")
    println("")

    # -- gates ---------------------------------------------------------------
    if mean_delay != mean_delay or band_wave != band_wave or best_band != best_band {
        println("    FAIL: a measured quantity is NaN")
        return 1
    }
    if delay_err > 2e-3 {
        println("    FAIL: the isolated-signal delay does not match r^2 / (2C)")
        return 2
    }
    if fabs(stop_fraction - stop_theory) > 0.01 {
        println("    FAIL: the stopped fraction does not match r / C")
        return 3
    }
    if fabs(band_wave - GREEN) > 1.0 {
        println("    FAIL: the coordinated bandwidth is not the green time")
        return 4
    }
    if band_zero > 0.0 {
        println("    FAIL: uncoordinated signals let a platoon through")
        return 5
    }
    if fabs(best_off - free_offset) > CYCLE / (N_OFFSET as f64) {
        println("    FAIL: the bandwidth does not peak at o = L / v")
        return 6
    }
    if fabs(best_band - GREEN) > 1.0 {
        println("    FAIL: the peak bandwidth is not the green time")
        return 7
    }
    if worst_band > 0.5 {
        println("    FAIL: the bandwidth does not follow g - (N-1)|o - L/v|")
        return 8
    }
    println("    PASS: isolated delay matches r^2/(2C) to 2e-3, uncoordinated")
    println("          signals pass nobody, and the bandwidth follows")
    println("          max(0, g - (N-1)|o - L/v|) exactly across a whole cycle")
    println("          of offsets, peaking at 25 s where o = L / v")
    return 0
}
