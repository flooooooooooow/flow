# PID TUNING: Ziegler-Nichols on the triple lag 1/(s+1)^3.
#
# PLANT
#   Three equal first-order lags in series, written as a flow block with
#   states x1, x2, x3 (the three lag outputs) and xi (the controller
#   integrator). The I-P form
#
#       u = Kp * (r - x3) + Ki * xi - Kd * (x2 - x3)
#
#   puts derivative on the plant output rather than the error, so a step
#   in r does not kick the plant with an impulse through Kd.
#
# CLOSED FORMS
#   Pure proportional control of 1/(s+1)^3 is marginally stable at exactly
#   Ku = 8 with oscillation period Tu = 2 pi / sqrt(3). The ultimate gain
#   is found by bisection on the log decrement of successive peaks; Tu is
#   the mean peak spacing at that gain.
#
#   With Ki > 0 the final error to a unit step is exactly 0 (integral
#   action). Three textbook tunings (ZN, Tyreus-Luyben, and a plain P)
#   are run and reported.
#
# WHAT THIS PROVES
#   The generated RK4 recovers Ku and Tu to about 1e-3 relative, and
#   integral action drives the steady-state error below 1e-9.
#
# Run: ./flow run examples/evolution/pid_tuning.flow

extern {
    function printf(fmt: string, val: f64) -> i32
    function fabs(x: f64) -> f64
    function sqrt(x: f64) -> f64
    function log(x: f64) -> f64
}

const DT: f64 = 1.0e-3
const TWO_PI: f64 = 6.283185307179586
const KU_REF: f64 = 8.0
const TU_REF: f64 = 3.627598728468436  # 2 pi / sqrt(3)

flow TripleLagPI {
    state x1 : f64 = 0.0
    state x2 : f64 = 0.0
    state x3 : f64 = 0.0
    state xi : f64 = 0.0

    param kp : f64 = 0.0
    param ki : f64 = 0.0
    param kd : f64 = 0.0
    param r  : f64 = 1.0

    solver { dt 1 ms  method rk4 }

    # u = Kp (r - x3) + Ki xi - Kd (x2 - x3); then three lags of u.
    x1 evolves as kp * (r - x3) + ki * xi - kd * (x2 - x3) - x1
    x2 evolves as x1 - x2
    x3 evolves as x2 - x3
    xi evolves as r - x3
}

# ---------------------------------------------------------------------------
# Peak finder for the pure-P oscillation used to locate Ku.
# ---------------------------------------------------------------------------

let mut m_sigma: f64 = 0.0
let mut m_period: f64 = 0.0
let mut m_npeaks: i32 = 0

function measure_p_osc(kp: f64, t0: f64, t1: f64) -> void {
    let mut s: TripleLagPI = TripleLagPI_new()
    s.kp = kp
    s.ki = 0.0
    s.kd = 0.0
    s.r = 1.0

    let yss: f64 = kp / (1.0 + kp)
    let n: i32 = (t1 / DT) as i32
    let mut ym2: f64 = -1.0e30
    let mut ym1: f64 = -1.0e30
    let mut have2: bool = false
    let mut have1: bool = false
    let mut t_first: f64 = -1.0
    let mut a_first: f64 = 0.0
    let mut t_last: f64 = -1.0
    let mut a_last: f64 = 0.0
    let mut np: i32 = 0
    let mut t: f64 = 0.0

    for k in 0 to n {
        TripleLagPI_step(&s, DT)
        t = t + DT
        let y: f64 = s.x3
        if have2 and have1 {
            if ym1 > ym2 and ym1 >= y {
                let den: f64 = ym2 - 2.0 * ym1 + y
                let mut d: f64 = 0.0
                if fabs(den) > 1.0e-18 {
                    d = 0.5 * (ym2 - y) / den
                }
                let tp: f64 = (t - DT) + d * DT
                let yp: f64 = ym1 - 0.25 * (ym2 - y) * d
                let a: f64 = yp - yss
                if tp >= t0 and a > 0.0 {
                    np = np + 1
                    if t_first < 0.0 {
                        t_first = tp
                        a_first = a
                    }
                    t_last = tp
                    a_last = a
                }
            }
        }
        ym2 = ym1
        ym1 = y
        if !have1 {
            have1 = true
        } else {
            have2 = true
        }
    }

    m_npeaks = np
    if np < 2 or t_last <= t_first {
        m_sigma = 0.0
        m_period = 0.0
        return
    }
    m_sigma = log(a_last / a_first) / (t_last - t_first)
    m_period = (t_last - t_first) / ((np - 1) as f64)
}

function find_ku() -> f64 {
    let mut lo: f64 = 4.0
    let mut hi: f64 = 16.0
    for i in 0 to 60 {
        let mid: f64 = 0.5 * (lo + hi)
        measure_p_osc(mid, 10.0, 46.0)
        if m_sigma > 0.0 {
            hi = mid
        } else {
            lo = mid
        }
    }
    return 0.5 * (lo + hi)
}

# ---------------------------------------------------------------------------
# A finished tuning run: final error, overshoot, IAE over 60 s.
# ---------------------------------------------------------------------------

let mut m_yfin: f64 = 0.0
let mut m_iae: f64 = 0.0
let mut m_overshoot: f64 = 0.0

function run_tuning(kp: f64, ki: f64, kd: f64, tend: f64) -> void {
    let mut s: TripleLagPI = TripleLagPI_new()
    s.kp = kp
    s.ki = ki
    s.kd = kd
    s.r = 1.0

    let n: i32 = (tend / DT) as i32
    let mut iae: f64 = 0.0
    let mut peak: f64 = 0.0
    let mut t: f64 = 0.0
    let iae_win: f64 = 60.0

    for k in 0 to n {
        TripleLagPI_step(&s, DT)
        t = t + DT
        let y: f64 = s.x3
        if t <= iae_win {
            iae = iae + fabs(1.0 - y) * DT
        }
        if y > peak {
            peak = y
        }
    }
    m_yfin = s.x3
    m_iae = iae
    if fabs(m_yfin) > 1.0e-12 {
        m_overshoot = 100.0 * (peak - m_yfin) / m_yfin
    } else {
        m_overshoot = 0.0
    }
}

function main() -> i32 {
    println("  PID TUNING  --  Ziegler-Nichols on 1/(s+1)^3")
    println("  ============================================")
    println("")

    let ku: f64 = find_ku()
    measure_p_osc(ku, 10.0, 46.0)
    let tu: f64 = m_period
    let ku_err: f64 = fabs(ku - KU_REF) / KU_REF
    let tu_err: f64 = fabs(tu - TU_REF) / TU_REF

    print("    Ku measured              : ")
    printf("%12.8f", ku)
    print("   reference 8")
    println("")
    print("    Tu measured              : ")
    printf("%12.8f", tu)
    print("   reference 2pi/sqrt(3)")
    println("")
    print("    relative error Ku, Tu    : ")
    printf("%9.3e", ku_err)
    print("  ")
    printf("%9.3e", tu_err)
    println("")
    println("")

    # Ziegler-Nichols PID: Kp = 0.6 Ku, Ti = Tu/2, Td = Tu/8.
    let zn_kp: f64 = 0.6 * KU_REF
    let zn_ki: f64 = zn_kp / (TU_REF / 2.0)
    let zn_kd: f64 = zn_kp * (TU_REF / 8.0)
    run_tuning(zn_kp, zn_ki, zn_kd, 200.0)
    let zn_err: f64 = fabs(1.0 - m_yfin)

    print("    ZN  Kp Ki Kd             : ")
    printf("%9.5f", zn_kp)
    print(" ")
    printf("%9.5f", zn_ki)
    print(" ")
    printf("%9.5f", zn_kd)
    println("")
    print("    ZN  y(inf), |err|, IAE60 : ")
    printf("%12.9f", m_yfin)
    print("  ")
    printf("%9.3e", zn_err)
    print("  ")
    printf("%9.5f", m_iae)
    println("")
    println("")

    # Tyreus-Luyben: Kp = Ku/3.2, Ti = 2.2 Tu, Td = Tu/6.3.
    let tl_kp: f64 = KU_REF / 3.2
    let tl_ki: f64 = tl_kp / (2.2 * TU_REF)
    let tl_kd: f64 = tl_kp * (TU_REF / 6.3)
    run_tuning(tl_kp, tl_ki, tl_kd, 200.0)
    let tl_err: f64 = fabs(1.0 - m_yfin)

    print("    TL  Kp Ki Kd             : ")
    printf("%9.5f", tl_kp)
    print(" ")
    printf("%9.5f", tl_ki)
    print(" ")
    printf("%9.5f", tl_kd)
    println("")
    print("    TL  y(inf), |err|, IAE60 : ")
    printf("%12.9f", m_yfin)
    print("  ")
    printf("%9.3e", tl_err)
    print("  ")
    printf("%9.5f", m_iae)
    println("")
    println("")

    # Pure P at half Ku: finite steady-state error of Ku_half/(1+Ku_half).
    run_tuning(4.0, 0.0, 0.0, 120.0)
    let p_err: f64 = fabs(1.0 - m_yfin)
    let p_ref: f64 = 1.0 - 4.0 / 5.0

    print("    P   y(inf), |err| vs 0.2 : ")
    printf("%12.9f", m_yfin)
    print("  ")
    printf("%9.3e", p_err)
    print("  ref ")
    printf("%9.3e", p_ref)
    println("")
    println("")

    let ku_ok: bool = ku_err < 1.0e-3
    let tu_ok: bool = tu_err < 1.0e-3
    let zn_ok: bool = zn_err < 1.0e-9
    let tl_ok: bool = tl_err < 1.0e-9
    let p_ok: bool = fabs(p_err - p_ref) < 1.0e-6
    let ok: bool = ku_ok and tu_ok and zn_ok and tl_ok and p_ok

    if ok {
        println("    PASS: Ku, Tu and integral action match the closed forms")
        return 0
    }
    if !ku_ok {
        println("    FAIL: Ku outside 1e-3 relative of 8")
        return 1
    }
    if !tu_ok {
        println("    FAIL: Tu outside 1e-3 relative of 2pi/sqrt(3)")
        return 2
    }
    if !zn_ok {
        println("    FAIL: ZN steady-state error above 1e-9")
        return 3
    }
    if !tl_ok {
        println("    FAIL: TL steady-state error above 1e-9")
        return 4
    }
    println("    FAIL: pure-P steady-state error missed K/(1+K)")
    return 5
}
