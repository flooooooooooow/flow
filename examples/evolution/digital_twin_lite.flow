# DIGITAL TWIN LITE — small plant + observer narrative (VISION.md: digital twins).
#
# A "digital twin" in control theory is an observer: a simulation running
# alongside a physical plant, fed the same inputs, but continually corrected
# by the plant's measured outputs to track its internal state.
#
# Here, a physical DC Motor (the plant) starts at rest. A Twin simulation
# starts with a bad guess of the state (pos = 0.5, vel = 2.0). Both receive
# the same voltage command, but the Twin also receives the plant's measured
# position. A Luenberger observer term (L1, L2) in the Twin's dynamics
# pulls its simulated state toward the physical reality.
#
# Run: ./flow run examples/evolution/digital_twin_lite.flow

extern {
    function printf(fmt: string, val: f64) -> i32
    function fabs(x: f64) -> f64
}

# The physical plant (reality)
flow Motor {
    state pos: f64 = 0.0
    state vel: f64 = 0.0

    input voltage: f64

    param friction: f64 = 0.1

    # Simplified DC motor
    pos evolves as vel
    vel evolves as -friction * vel + voltage
}

# The digital twin (observer)
flow Twin {
    state pos: f64 = 0.5   # Starts with an incorrect state estimate
    state vel: f64 = 2.0   # Starts with an incorrect state estimate

    input voltage: f64     # Known control input
    input pos_meas: f64    # Measured output from the plant

    param friction: f64 = 0.1
    param L1: f64 = 2.0    # Observer gain for position
    param L2: f64 = 1.0    # Observer gain for velocity

    # Luenberger observer: dx_hat/dt = A x_hat + B u + L (y - C x_hat)
    pos evolves as vel + L1 * (pos_meas - pos)
    vel evolves as -friction * vel + voltage + L2 * (pos_meas - pos)
}

function main() -> i32 {
    let mut plant: Motor = Motor_new()
    let mut twin: Twin = Twin_new()

    let dt: f64 = 0.01
    let steps: i32 = 600

    println("")
    println("  DIGITAL TWIN LITE -- observer tracking a physical plant")
    println("  =======================================================")
    println("")
    println("      t [s]   plant pos  twin pos   |   plant vel  twin vel")
    println("    -------  ---------- ---------   |  ---------- ---------")

    let mut pos_err_end: f64 = 0.0
    let mut vel_err_end: f64 = 0.0

    for k in 0 to steps + 1 {
        let t: f64 = k * dt

        # 1. Drive the physical plant
        plant.voltage = 1.0

        # 2. Drive the twin with the same input + measured output
        twin.voltage = 1.0
        twin.pos_meas = plant.pos

        if k % 60 == 0 {
            print("    ")
            printf("%7.2f", t)
            printf("  %9.4f", plant.pos)
            printf(" %9.4f", twin.pos)
            print("   | ")
            printf(" %9.4f", plant.vel)
            printf(" %9.4f", twin.vel)
            println("")
        }

        Motor_step(&plant, dt)
        Twin_step(&twin, dt)

        if k == steps {
            pos_err_end = fabs(plant.pos - twin.pos)
            vel_err_end = fabs(plant.vel - twin.vel)
        }
    }

    println("")
    print("    final position error : ")
    printf("%.4f", pos_err_end)
    println("")
    print("    final velocity error : ")
    printf("%.4f", vel_err_end)
    println("")
    println("")

    if pos_err_end > 0.02 or vel_err_end > 0.02 {
        println("    FAIL: twin did not converge to plant state")
        return 1
    }

    println("    OK: observer successfully tracks physical plant")
    return 0
}
