# PACEMAKER: a VVI demand pacemaker as two states and two events, and the
# staircase its refractory period cuts into the rate response.
#
# THE SYSTEM
#
#   Two clocks. The sinoatrial node ramps and fires; the device counts the
#   time since the last ventricular event and paces if nothing arrives.
#
#       sa  evolves as sa_rate            # the heart's own oscillator
#       esc evolves as 1                  # the escape timer, seconds
#
#       when sa  reaches 1   { sa becomes sa - 1 ; esc becomes sensed(esc) }
#       when esc reaches lri { esc becomes 0 ; sa becomes 0 }
#
#   `sensed(esc)` is the sensing rule: a beat arriving inside the ventricular
#   refractory period is invisible to the device and leaves the escape timer
#   running, so
#
#       sensed(esc) = esc      if esc <  vrp
#                     0        otherwise
#
#   The paced beat resets the sinoatrial node as well, standing in for the
#   retrograde penetration that makes a ventricular-paced beat reset the
#   upstream pacemaker.
#
# THE CLOSED FORM
#
#   Let T = 60 / bpm be the intrinsic interval. After a ventricular event the
#   sinus beats land at T, 2T, 3T, ... and the first one at or beyond the
#   refractory period is the one the device sees. If that is later than the
#   lower rate interval the device paces first. So the escape interval in
#   steady state is
#
#       interval = min( lri , ceil(vrp / T) * T )
#
#   and the delivered rate is 60 / interval. Two regimes and a staircase:
#
#     - slow heart, T > lri:            paced at exactly the lower rate limit
#     - normal heart, vrp <= T < lri:   fully inhibited, rate is the heart's
#     - fast heart, T < vrp:            every other beat is invisible, and
#                                       the delivered rate halves, then thirds
#
#   With lri = 1.0 s (60 min^-1) and vrp = 0.32 s the fold is at
#   60 / 0.32 = 187.5 min^-1: a heart at 170 comes through at 170, a heart at
#   200 comes through at 100.
#
# WHAT THIS PROVES
#   Every number in the table below is produced by two `when` blocks and a
#   two-line ramp. The staircase is not coded anywhere; it is what a
#   refractory period does to a periodic input.
#
# THE REFERENCES IT IS CHECKED AGAINST
#
#   free-running sinus interval   1 / sa_rate exactly
#   delivered interval            min(lri, ceil(vrp/T) T)
#   paced beats                   all of them when T > lri, none otherwise
#
# CONTROLS
#   None: one deterministic run, no input, no randomness.
#
# Run: ./flow run examples/evolution/pacemaker.flow

extern {
    function printf(fmt: string, val: f64) -> i32
    function fabs(x: f64) -> f64
    function ceil(x: f64) -> f64
}

const DT: f64 = 1.0e-5
const LRI: f64 = 1.0          # s, lower rate interval = 60 min^-1
const VRP: f64 = 0.32         # s, ventricular refractory period
const WARMUP: f64 = 25.0      # s
const T_END: f64 = 105.0      # s
const N_RATE: i32 = 14

# ---------------------------------------------------------------------------
# The model.
# ---------------------------------------------------------------------------

# A beat inside the refractory period is not seen, so the escape timer keeps
# running. Outside it, the beat inhibits the device and restarts the timer.
function sensed(esc: f64, vrp: f64) -> f64 {
    if esc < vrp {
        return esc
    }
    return 0.0
}

flow Pacemaker {
    state sa  : f64 = 0.0     # sinoatrial phase, fires at 1
    state esc : f64 = 0.0     # s since the last ventricular event

    param sa_rate : f64 = 1.0     # intrinsic beats per second
    param lri     : f64 = 1.0     # s
    param vrp     : f64 = 0.32    # s

    solver { dt 10 us  method euler }

    sa evolves as sa_rate
    esc evolves as 1.0

    when sa reaches 1.0 {
        sa becomes sa - 1.0
        esc becomes sensed(esc, vrp)
    }

    when esc reaches lri {
        esc becomes 0.0
        sa becomes 0.0
    }
}

# ---------------------------------------------------------------------------
# Closed form
# ---------------------------------------------------------------------------

function delivered_interval(bpm: f64, lri: f64, vrp: f64) -> f64 {
    let t: f64 = 60.0 / bpm
    let k: f64 = ceil(vrp / t)
    let sensed_at: f64 = k * t
    if sensed_at < lri {
        return sensed_at
    }
    return lri
}

# ---------------------------------------------------------------------------
# One configuration, measured
# ---------------------------------------------------------------------------

let mut m_interval: f64 = 0.0
let mut m_paced: i32 = 0
let mut m_sensed: i32 = 0

function measure(bpm: f64) -> void {
    let mut p: Pacemaker = Pacemaker_new()
    p.sa_rate = bpm / 60.0
    p.lri = LRI
    p.vrp = VRP
    p.sa = 0.0
    p.esc = 0.0

    let steps: i32 = (T_END / DT) as i32
    let mut t: f64 = 0.0
    let mut prev_esc: f64 = 0.0
    let mut first: f64 = -1.0
    let mut last: f64 = -1.0
    let mut beats: i32 = 0
    let mut paced: i32 = 0
    let mut sensed_count: i32 = 0

    for s in 0 to steps {
        Pacemaker_step(&p, DT)
        t = t + DT
        # Any ventricular event drives the escape timer backwards.
        if p.esc < prev_esc {
            if t > WARMUP {
                if first < 0.0 {
                    first = t
                } else {
                    beats = beats + 1
                    last = t
                    # A pace happens exactly when the timer had run to lri.
                    if prev_esc > LRI - 2.0 * DT {
                        paced = paced + 1
                    } else {
                        sensed_count = sensed_count + 1
                    }
                }
            }
        }
        prev_esc = p.esc
    }

    m_paced = paced
    m_sensed = sensed_count
    if beats < 1 or last <= first {
        m_interval = 0.0
        return
    }
    m_interval = (last - first) / (beats as f64)
}

# ---------------------------------------------------------------------------

function main() -> i32 {
    println("")
    println("  PACEMAKER  --  two ramps, two `when` guards, one refractory period")
    println("  ==================================================================")
    println("")
    print("    lower rate interval lri : ")
    printf("%.4f", LRI)
    print(" s   = ")
    printf("%.1f", 60.0 / LRI)
    println(" min^-1")
    print("    refractory period vrp   : ")
    printf("%.4f", VRP)
    print(" s   fold at ")
    printf("%.1f", 60.0 / VRP)
    println(" min^-1")
    print("    step dt                 : ")
    printf("%.1e", DT)
    println(" s")
    println("")

    # -- 1. the sinus node alone --------------------------------------------
    println("  1. THE SINUS NODE ON ITS OWN  (device disabled: lri set huge)")
    println("")

    let mut free: Pacemaker = Pacemaker_new()
    free.sa_rate = 72.0 / 60.0
    free.lri = 1.0e6
    free.vrp = VRP
    let free_steps: i32 = (60.0 / DT) as i32
    let mut fb: i32 = 0
    let mut ft_first: f64 = -1.0
    let mut ft_last: f64 = -1.0
    let mut prev_sa: f64 = 0.0
    let mut ft: f64 = 0.0
    for s in 0 to free_steps {
        Pacemaker_step(&free, DT)
        ft = ft + DT
        if free.sa < prev_sa {
            if ft_first < 0.0 {
                ft_first = ft
            } else {
                fb = fb + 1
                ft_last = ft
            }
        }
        prev_sa = free.sa
    }
    let free_interval: f64 = (ft_last - ft_first) / (fb as f64)
    let free_theory: f64 = 60.0 / 72.0
    let free_err: f64 = fabs(free_interval - free_theory) / free_theory
    print("     measured interval at 72 min^-1 : ")
    printf("%.9f", free_interval)
    println(" s")
    print("     1 / sa_rate                    : ")
    printf("%.9f", free_theory)
    println(" s")
    print("     relative error                 : ")
    printf("%.3e", free_err)
    println("     gate 1.0e-4")
    println("")

    # -- 2. the rate response staircase -------------------------------------
    println("  2. DELIVERED RATE AGAINST INTRINSIC RATE")
    println("")
    println("      intrinsic   T [s]    interval [s]   min(lri, ceil(vrp/T)T)   delivered   theory   paced  sensed")
    println("      ---------   ------   ------------   ----------------------   ---------   ------   -----  ------")

    let rates: array<f64, 14> = [30.0, 40.0, 45.0, 50.0, 55.0, 62.0, 70.0,
                                 85.0, 100.0, 130.0, 170.0, 200.0, 240.0, 300.0]
    let mut worst_rate: f64 = 0.0
    let mut pace_wrong: i32 = 0
    let mut beats_seen: i32 = 1000000

    for i in 0 to N_RATE {
        let bpm: f64 = rates[i]
        let period: f64 = 60.0 / bpm
        measure(bpm)
        let theory: f64 = delivered_interval(bpm, LRI, VRP)
        let out_bpm: f64 = 60.0 / m_interval
        let theory_bpm: f64 = 60.0 / theory
        let err: f64 = fabs(out_bpm - theory_bpm)
        if err > worst_rate { worst_rate = err }

        # Below the lower rate limit every beat must be paced; above it, none.
        if period > LRI {
            if m_sensed != 0 { pace_wrong = pace_wrong + 1 }
            if m_paced < 10 { pace_wrong = pace_wrong + 1 }
        } else {
            if m_paced != 0 { pace_wrong = pace_wrong + 1 }
            if m_sensed < 10 { pace_wrong = pace_wrong + 1 }
        }
        let total: i32 = m_paced + m_sensed
        if total < beats_seen { beats_seen = total }

        printf("      %9.1f", bpm)
        printf("   %6.4f", period)
        printf("   %12.7f", m_interval)
        printf("   %22.7f", theory)
        printf("   %9.4f", out_bpm)
        printf("   %6.1f", theory_bpm)
        printf("   %5.0f", m_paced as f64)
        printf("  %6.0f", m_sensed as f64)
        println("")
    }
    println("")
    print("     worst delivered-rate error : ")
    printf("%.4f", worst_rate)
    println(" min^-1   gate 0.05")
    println("")

    # -- 3. the staircase, drawn ---------------------------------------------
    println("  3. THE SAME TABLE AS A PICTURE  (each # is 4 min^-1 delivered)")
    println("")
    for i in 0 to N_RATE {
        let bpm: f64 = rates[i]
        let theory: f64 = delivered_interval(bpm, LRI, VRP)
        printf("      %5.0f", bpm)
        print(" -> ")
        let bars: i32 = ((60.0 / theory) / 4.0 + 0.5) as i32
        for b in 0 to bars {
            print("#")
        }
        printf("  %.1f", 60.0 / theory)
        println("")
    }
    println("")
    println("     The rise from 62 to 170 is the device standing aside. The drop")
    println("     at 200 is the refractory period hiding every second beat, and")
    println("     it lands exactly where 60 / vrp says it should.")
    println("")

    # -- gates ---------------------------------------------------------------
    if free_err != free_err or worst_rate != worst_rate {
        println("    FAIL: a measured quantity is NaN")
        return 1
    }
    if free_err > 1e-4 {
        println("    FAIL: the free-running sinus interval is not 1 / sa_rate")
        return 2
    }
    if beats_seen < 40 {
        println("    FAIL: too few ventricular events to average over")
        return 3
    }
    if worst_rate > 0.05 {
        println("    FAIL: the delivered rate does not follow min(lri, ceil(vrp/T) T)")
        return 4
    }
    if pace_wrong != 0 {
        println("    FAIL: the device paced when it should have been inhibited")
        return 5
    }
    println("    PASS: the free-running interval is 1/sa_rate, the delivered rate")
    println("          follows min(lri, ceil(vrp/T) T) to 0.05 min^-1 over fourteen")
    println("          intrinsic rates, and the device is fully paced below the")
    println("          lower rate limit and fully inhibited above it")
    return 0
}
