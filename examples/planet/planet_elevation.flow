# PLANET ELEVATION: hypsometry and sea-level land fraction.
#
# Runs grid + tectonics + elevation. Gates land fraction near the target.
# Draws an equirect elev map and a hypsometric curve overlay.
#
# KEYS
#   1-4 seed presets   Esc quit
#
# Run: FLOW_HOST=python ./flow gfx examples/planet/planet_elevation.flow

import "stdlib/gfx.flow"
import "stdlib/text.flow"
import "stdlib/planet.flow"

extern {
    function printf(fmt: string, val: f64) -> i32
    function fabs(x: f64) -> f64
    function calloc(n: i64, size: i64) -> ptr<void>
}

const SEED: u32 = 42
const PLATES: i32 = 12
const WIN_W: i32 = 512
const WIN_H: i32 = 592
const FIELD_Y: i32 = 58
const FB_W: i32 = 512
const FB_H: i32 = 256
const MAX_FRAMES: i32 = 6000
const LAND_TARGET: f64 = 0.29
const LAND_TOL: f64 = 0.02
const BINS: i32 = 64
const PLOT_H: i32 = 120

const KEY_1: i32 = 18
const KEY_2: i32 = 19
const KEY_3: i32 = 20
const KEY_4: i32 = 21

let mut fb: ptr<u8> = null
let mut hist: ptr<f32> = null
let mut m_land: f64 = 0.0
let mut m_sea: f64 = 0.0
let mut cursor: i32 = 0
let mut preset: i32 = 0

function preset_seed(p: i32) -> u32 {
    if p == 0 { return 42 }
    if p == 1 { return 77 }
    if p == 2 { return 101 }
    return 256
}

function color_elev(e: f32) -> i32 {
    if e <= 0.0 {
        let t: f32 = pl_clampf((-e) / 5.0, 0.0, 1.0)
        let r: i32 = (10.0 + 20.0 * (1.0 - t)) as i32
        let g: i32 = (30.0 + 60.0 * (1.0 - t)) as i32
        let b: i32 = (80.0 + 100.0 * (1.0 - t)) as i32
        return (r << 16) + (g << 8) + b
    }
    let t: f32 = pl_clampf(e / 4.5, 0.0, 1.0)
    let r: i32 = (40.0 + 180.0 * t) as i32
    let g: i32 = (90.0 + 100.0 * (1.0 - t * 0.5)) as i32
    let b: i32 = (40.0 + 40.0 * t) as i32
    if e > 3.0 {
        let u: f32 = pl_clampf((e - 3.0) / 2.0, 0.0, 1.0)
        let rr: i32 = (r as f32 * (1.0 - u) + 245.0 * u) as i32
        let gg: i32 = (g as f32 * (1.0 - u) + 245.0 * u) as i32
        let bb: i32 = (b as f32 * (1.0 - u) + 250.0 * u) as i32
        return (rr << 16) + (gg << 8) + bb
    }
    return (r << 16) + (g << 8) + b
}

function put_px(x: i32, y: i32, r: i32, g: i32, b: i32) -> void {
    if x < 0 or x >= FB_W or y < 0 or y >= FB_H { return }
    let o: i32 = (y * FB_W + x) * 3
    fb[o] = r as u8
    fb[o + 1] = g as u8
    fb[o + 2] = b as u8
}

function draw_map() -> void {
    let n: i32 = planet_cells()
    for y in 0 to FB_H {
        let lat: f32 = 90.0 - 180.0 * ((y as f32) + 0.5) / (FB_H as f32)
        for x in 0 to FB_W {
            let lon: f32 = -180.0 + 360.0 * ((x as f32) + 0.5) / (FB_W as f32)
            let i: i32 = planet_cell_at_lonlat(lon, lat)
            if i < 0 or i >= n {
                put_px(x, y, 0, 0, 0)
            } else {
                let c: i32 = color_elev(planet_elev(i))
                put_px(x, y, (c >> 16) & 255, (c >> 8) & 255, c & 255)
            }
        }
    }
}

function rebuild_elev(p: i32) -> void {
    planet_seed(preset_seed(p))
    planet_stage_tectonics(PLATES)
    planet_stage_elevation()
    m_land = planet_land_fraction() as f64
    m_sea = planet_sea_datum() as f64
    planet_hypsometric_hist(-6.0, 6.0, BINS, hist)
    draw_map()
}

function draw_hypsometric(g: Gfx, ox: i32, oy: i32) -> void {
    gfx_fill_rect(g, ox, oy, BINS * 4 + 8, PLOT_H + 8, 20, 22, 28)
    let mut peak: f32 = 0.001
    for b in 0 to BINS {
        if hist[b] > peak { peak = hist[b] }
    }
    for b in 0 to BINS {
        let h: i32 = ((hist[b] / peak) * (PLOT_H as f32)) as i32
        let x: i32 = ox + 4 + b * 4
        let y: i32 = oy + 4 + PLOT_H - h
        let elev: f32 = -6.0 + 12.0 * ((b as f32) + 0.5) / (BINS as f32)
        let mut r: i32 = 80
        let mut gg: i32 = 160
        let mut bb: i32 = 90
        if elev <= 0.0 {
            r = 50
            gg = 90
            bb = 180
        }
        if b == cursor {
            r = 255
            gg = 220
            bb = 90
        }
        gfx_fill_rect(g, x, y, 3, h, r, gg, bb)
    }
    # cumulative hypsometric marker at sea level bin
    let frac0: f32 = planet_hypsometric(0.0)
    let mark_x: i32 = ox + 4 + ((0.0 - (-6.0)) / 12.0 * (BINS as f32)) as i32 * 4
    gfx_fill_rect(g, mark_x, oy + 4, 2, PLOT_H, 255, 120, 120)
    let t: i32 = gfx_draw_fixed(g, ox + 4, oy + PLOT_H + 12, frac0 as f64, 3, 1, 200, 180, 180)
}

function draw_hud(g: Gfx) -> void {
    let t1: i32 = gfx_draw_text(g, 8, 8, "PLANET ELEVATION  HYPSOMETRY + SEA LEVEL", 2,
                                238, 234, 246)
    let t2: i32 = gfx_draw_text(g, 8, 28, "LAND", 1, 150, 146, 168)
    let t3: i32 = gfx_draw_fixed(g, 42, 28, m_land, 3, 1, 120, 255, 190)
    let t4: i32 = gfx_draw_text(g, 120, 28, "TARGET", 1, 150, 146, 168)
    let t5: i32 = gfx_draw_fixed(g, 170, 28, LAND_TARGET, 2, 1, 234, 232, 244)
    let t6: i32 = gfx_draw_text(g, 240, 28, "SEA DATUM", 1, 150, 146, 168)
    let t7: i32 = gfx_draw_fixed(g, 314, 28, m_sea, 3, 1, 234, 232, 244)
    let t8: i32 = gfx_draw_text(g, 400, 28, "SEED", 1, 150, 146, 168)
    let t9: i32 = gfx_draw_int(g, 436, 28, preset_seed(preset) as i32, 1, 255, 198, 96)
    let ta: i32 = gfx_draw_text(g, 8, 42, "1-4 SEEDS  bars = elev area; red line = sea level", 1, 112, 108, 132)
    let tb: i32 = gfx_draw_text(g, 8, 572,
        "crust dichotomy + fractal relief; sea cut to land-fraction target", 1, 122, 118, 144)
    let tc: i32 = gfx_draw_text(g, 8, 582,
        "gate: land fraction within 0.02 of target 0.29", 1, 122, 118, 144)
}

function main() -> i32 {
    fb = calloc((FB_W * FB_H * 3) as i64, 1 as i64)
    hist = calloc(BINS as i64, 4 as i64)
    if fb == null or hist == null {
        println("  FAIL: alloc")
        return 1
    }

    println("")
    println("  PLANET ELEVATION  --  hypsometry and land fraction")
    println("  ===================================================")
    println("")

    if !planet_init() {
        println("    FAIL: planet_init")
        return 1
    }
    planet_seed(SEED)
    planet_stage_grid()
    planet_stage_tectonics(PLATES)
    planet_stage_elevation()

    m_land = planet_land_fraction() as f64
    m_sea = planet_sea_datum() as f64
    planet_hypsometric_hist(-6.0, 6.0, BINS, hist)

    print("     land fraction                 : ")
    printf("%10.4f", m_land)
    print("     target ")
    printf("%.2f", LAND_TARGET)
    println("")
    print("     sea datum (raw, km)           : ")
    printf("%10.4f", m_sea)
    println("")
    print("     hypsometric at 0 km           : ")
    printf("%10.4f", planet_hypsometric(0.0) as f64)
    println("")
    println("")

    if fabs(m_land - LAND_TARGET) > LAND_TOL {
        println("    FAIL: land fraction off target")
        return 2
    }
    println("    PASS: land fraction is within tolerance of the target")
    println("")

    draw_map()
    let g: Gfx = gfx_open(WIN_W, WIN_H, "Planet elevation - Flow")
    let mut frame: i32 = 0

    while frame < MAX_FRAMES {
        if !gfx_frame_pump(g) { break }

        let mut want: i32 = -1
        if gfx_key_down(g, KEY_1) { want = 0 }
        if gfx_key_down(g, KEY_2) { want = 1 }
        if gfx_key_down(g, KEY_3) { want = 2 }
        if gfx_key_down(g, KEY_4) { want = 3 }
        if want >= 0 and want != preset {
            preset = want
            rebuild_elev(preset)
        }

        # Auto-cycle seed presets so the recorded GIF rebuilds distinct worlds.
        if frame > 0 and frame % 50 == 0 {
            preset = (preset + 1) % 4
            rebuild_elev(preset)
        }

        cursor = (frame / 2) % BINS
        gfx_clear(g, 12, 14, 18)
        gfx_blit_rgb(g, 0, FIELD_Y + 20, FB_W, FB_H, fb)
        draw_hypsometric(g, 120, FIELD_Y + FB_H + 28)
        draw_hud(g)
        gfx_present(g)
        frame = frame + 1
    }
    gfx_close(g)
    return 0
}
