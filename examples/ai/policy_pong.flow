# Episode results (set by play_episode).
let mut ep_len: i32 = 0
let mut ep_hits: i32 = 0
let mut ep_missed: i32 = 0

# Same LCG as the game (environment randomness for serves).
function env_rng_next(seed: u32) -> u32 {
    return seed * 1664525 + 1013904223
}

function env_rng_range(seed: u32, max: i32) -> i32 {
    let mut val: i32 = (seed % (max as u32)) as i32
    if val < 0 { val = 0 - val }
    return val
}

function abs_f32(v: f32) -> f32 {
    if v < 0.0 { return 0.0 - v }
    return v
}

# One pong episode from the agent's serve until the agent misses, HIT_CAP
# rallies, or the frame/decision cap. Fills the trajectory buffers and the
# ep_* result statics.
function play_episode(mode: i32, env_seed: u32) -> void {
    let mut rng_seed: u32 = env_seed

    let mut player_y: i32 = 210
    let mut ai_y: i32 = 210
    let mut ball_x: i32 = 101120
    let mut ball_y: i32 = 62720
    let mut ball_vx: i32 = 0
    let mut ball_vy: i32 = 0

    # Serve toward the agent, random vertical angle (game formula).
    ball_vx = -896
    rng_seed = env_rng_next(rng_seed)
    ball_vy = env_rng_range(rng_seed, 1025) - 512

    let mut hits: i32 = 0
    let mut missed: bool = false
    let mut done: bool = false
    let mut frame: i32 = 0
    let mut t: i32 = 0
    let mut action: i32 = 1
    let mut prev_gap: f32 = -1.0

    while !done and frame < FRAME_CAP and t < MAX_DECISIONS {
        # ---- decision every ACT_EVERY frames ----
        if frame % ACT_EVERY == 0 {
            let x0: f32 = (ball_vx as f32) / 1792.0
            let x1: f32 = (ball_vy as f32) / 1792.0
            let ball_cy: i32 = ball_y / 256 + BALL_SIZE / 2
            let pad_cy: i32 = player_y + PAD_H / 2
            let x2: f32 = ((ball_cy - pad_cy) as f32) / 200.0

            # Shaping: reward the previous decision for closing the gap.
            let gap: f32 = abs_f32((ball_cy - pad_cy) as f32)
            if t > 0 and prev_gap >= 0.0 {
                ep_r[t - 1] = ep_r[t - 1] + 0.005 * (prev_gap - gap)
            }
            prev_gap = gap

            let xbuf: array<f32, 3> = [x0, x1, x2]
            let xp: ptr<f32> = xbuf
            if mode == MODE_TRAIN {
                mlp_forward(xp)
                action = mlp_sample()
            } elif mode == MODE_GREEDY {
                mlp_forward(xp)
                action = mlp_argmax()
            } else {
                action = ai_rand_range(3)
            }

            ep_x[t * 3] = x0
            ep_x[t * 3 + 1] = x1
            ep_x[t * 3 + 2] = x2
            ep_a[t] = action
            ep_r[t] = 0.0
            t = t + 1
        }

        # ---- agent paddle (game speed: 6 px/frame while held) ----
        if action == 0 { player_y = player_y - 6 }
        if action == 2 { player_y = player_y + 6 }
        if player_y < COURT_TOP { player_y = COURT_TOP }
        if player_y > COURT_BOT - PAD_H { player_y = COURT_BOT - PAD_H }

        # ---- scripted opponent, verbatim from the game ----
        let ball_cy2: i32 = ball_y / 256 + BALL_SIZE / 2
        let ai_cy: i32 = ai_y + PAD_H / 2
        if ball_vx > 0 {
            if ball_cy2 > ai_cy + 4 { ai_y = ai_y + 4 }
            if ball_cy2 < ai_cy - 4 { ai_y = ai_y - 4 }
        } else {
            if ai_cy < 246 { ai_y = ai_y + 2 }
            if ai_cy > 254 { ai_y = ai_y - 2 }
        }
        if ai_y < COURT_TOP { ai_y = COURT_TOP }
        if ai_y > COURT_BOT - PAD_H { ai_y = COURT_BOT - PAD_H }

        # ---- ball movement, verbatim from the game ----
        ball_x = ball_x + ball_vx
        ball_y = ball_y + ball_vy

        if ball_y < COURT_TOP * 256 {
            ball_y = COURT_TOP * 256
            if ball_vy < 0 { ball_vy = 0 - ball_vy }
        }
        if ball_y > (COURT_BOT - BALL_SIZE) * 256 {
            ball_y = (COURT_BOT - BALL_SIZE) * 256
            if ball_vy > 0 { ball_vy = 0 - ball_vy }
        }

        let bx: i32 = ball_x / 256
        let by: i32 = ball_y / 256

        # Agent paddle collision (angle from hit position).
        if ball_vx < 0 and bx <= PLAYER_X + PAD_W and bx >= PLAYER_X - 8 {
            if by + BALL_SIZE >= player_y and by <= player_y + PAD_H {
                ball_x = (PLAYER_X + PAD_W) * 256
                let mut sp: i32 = 0 - ball_vx
                sp = sp + 48
                if sp > 1792 { sp = 1792 }
                ball_vx = sp
                let offset: i32 = (by + BALL_SIZE / 2) - (player_y + PAD_H / 2)
                ball_vy = offset * 20
                hits = hits + 1
                if t > 0 { ep_r[t - 1] = ep_r[t - 1] + 1.0 }
                if hits >= HIT_CAP { done = true }
            }
        }

        # Opponent paddle collision.
        if ball_vx > 0 and bx + BALL_SIZE >= AI_X and bx <= AI_X + 8 {
            if by + BALL_SIZE >= ai_y and by <= ai_y + PAD_H {
                ball_x = (AI_X - BALL_SIZE) * 256
                let mut sp2: i32 = ball_vx
                sp2 = sp2 + 48
                if sp2 > 1792 { sp2 = 1792 }
                ball_vx = 0 - sp2
                let offset2: i32 = (by + BALL_SIZE / 2) - (ai_y + PAD_H / 2)
                ball_vy = offset2 * 20
            }
        }

        # Agent misses: episode over.
        if bx < -20 {
            missed = true
            done = true
            if t > 0 { ep_r[t - 1] = ep_r[t - 1] - 1.0 }
        }

        # Opponent misses: agent point, re-serve toward the agent.
        if bx > WIN_W + 20 {
            if t > 0 { ep_r[t - 1] = ep_r[t - 1] + 1.5 }
            ball_x = 101120
            ball_y = 62720
            ball_vx = -896
            rng_seed = env_rng_next(rng_seed)
            ball_vy = env_rng_range(rng_seed, 1025) - 512
        }

        frame = frame + 1
    }

    ep_len = t
    ep_hits = hits
    ep_missed = 0
    if missed { ep_missed = 1 }
}

# REINFORCE update over the stored episode: reward-to-go returns, mean-return
# baseline, one gradient step per decision.
function train_on_episode() -> void {
    if ep_len == 0 { return }

    let mut g: f32 = 0.0
    let mut t: i32 = ep_len - 1
    while t >= 0 {
        g = ep_r[t] + GAMMA * g
        ep_g[t] = g
        t = t - 1
    }

    # Whiten the returns (mean 0, std 1) so update size stays stable across
    # episodes; unnormalized REINFORCE diverges after its first successes.
    let mut mean: f32 = 0.0
    let mut i: i32 = 0
    while i < ep_len {
        mean = mean + ep_g[i]
        i = i + 1
    }
    mean = mean / (ep_len as f32)

    let mut var: f32 = 0.0
    let mut j: i32 = 0
    while j < ep_len {
        let d: f32 = ep_g[j] - mean
        var = var + d * d
        j = j + 1
    }
    var = var / (ep_len as f32)
    let mut scale: f32 = 1.0
    if var > 0.0001 {
        scale = 1.0 / sqrtf(var)
    }

    let mut k: i32 = 0
    while k < ep_len {
        let xbuf: array<f32, 3> = [ep_x[k * 3], ep_x[k * 3 + 1], ep_x[k * 3 + 2]]
        let xp: ptr<f32> = xbuf
        mlp_reinforce(xp, ep_a[k], (ep_g[k] - mean) * scale, LR)
        k = k + 1
    }
}

# Average hits per episode for a mode over n episodes on fixed eval seeds.
function eval_mode(mode: i32, n: i32) -> f32 {
    let mut total: i32 = 0
    let mut i: i32 = 0
    while i < n {
        let seed: u32 = 90000 + (i as u32) * 31
        play_episode(mode, seed)
        total = total + ep_hits
        i = i + 1
    }
    return (total as f32) / (n as f32)
}

function main() -> i32 {
    println("POLICY-PONG: REINFORCE on headless pong vs the scripted opponent")
    println("policy = 3-8-3 MLP (ball dx, dy, relative y), stdlib/ai.flow")
    println("")

    let episodes: i32 = 500
    let eval_n: i32 = 100

    # Random baseline on the evaluation seeds (rally capped at 4 hits).
    ai_seed(2718 as u32)
    let base_avg: f32 = eval_mode(MODE_RANDOM, eval_n)
    print("random baseline: avg rally ")
    printf("%.2f", base_avg as f64)
    print(" hits over ")
    print(eval_n)
    println(" episodes")
    println("")

    # Train.
    mlp_init(3, 8, 3, 1337 as u32)
    println("training 500 episodes (REINFORCE, gamma 0.98, lr 0.005):")
    let mut win_hits: i32 = 0
    let mut win_miss: i32 = 0
    let mut ep: i32 = 0
    while ep < episodes {
        let seed: u32 = 660000 + (ep as u32) * 97
        play_episode(MODE_TRAIN, seed)
        train_on_episode()
        win_hits = win_hits + ep_hits
        win_miss = win_miss + ep_missed
        ep = ep + 1
        if ep % 50 == 0 {
            let avg: f32 = (win_hits as f32) / 50.0
            let hit_rate: f32 = (win_hits as f32) / ((win_hits + win_miss) as f32)
            print("  episode ")
            print(ep)
            print("  avg_rally ")
            printf("%.2f", avg as f64)
            print("  hit_rate ")
            printf("%.2f", hit_rate as f64)
            println("")
            win_hits = 0
            win_miss = 0
        }
    }
    println("")

    # Evaluate greedy policy on the baseline's seeds.
    let pol_avg: f32 = eval_mode(MODE_GREEDY, eval_n)
    print("trained (greedy): avg rally ")
    printf("%.2f", pol_avg as f64)
    print(" hits over ")
    print(eval_n)
    println(" episodes (cap 4)")
    print("random baseline : avg rally ")
    printf("%.2f", base_avg as f64)
    println(" hits")
    print("margin          : ")
    printf("%.2f", (pol_avg - base_avg) as f64)
    println(" hits per episode")
    println("")

    if pol_avg >= 2.5 and pol_avg >= base_avg * 2.0 + 0.5 {
        println("PASS: trained paddle rallies far beyond the random baseline")
        return 0
    }
    println("FAIL: trained paddle did not clear the margin")
    return 1
}
