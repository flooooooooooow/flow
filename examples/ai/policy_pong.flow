# POLICY-PONG - REINFORCE policy gradient on headless pong.
#
# Re-simulates the ball/paddle physics of examples/games/pong_gfx.flow without
# graphics: same 8-bit fixed-point ball, same paddle collision (angle from hit
# offset, speed up per hit) and the same scripted tracking opponent on the
# right. The agent drives the left paddle.
#
# Policy: 3-8-3 MLP from stdlib/ai.flow (inputs: ball dx, ball dy, ball y
# relative to the paddle; actions: up / stay / down), trained with REINFORCE:
# sampled softmax actions, reward-to-go returns whitened per episode, one
# mlp_reinforce gradient step per decision.
#
# Rewards: +1 per paddle hit, -1 for a miss, +1.5 when the opponent misses,
# plus a small shaping term for closing the gap to the ball.
#
# Prints rally length (hits per episode) improving over training, then
# evaluates greedy vs a random-action baseline on the same seeds. Exits 0
# only if the trained paddle rallies far longer than random.
#
# Run: ./flow run examples/ai/policy_pong.flow

import "stdlib/ai.flow"

extern {
    function printf(fmt: string, v: f64) -> i32
    function sqrtf(x: f32) -> f32
}

