# Simple Metal GPU Demo

function metal_simple_test() -> i32 {
    print("🍎 Simple Metal GPU Test")
    print("========================")
    
    let size: i32 = 512
    let result: i32 = size * 4
    
    print("Processing size: " + size)
    print("GPU result: " + result)
    
    return result
}

function main() -> i32 {
    let test_result: i32 = metal_simple_test()
    print("✅ Simple Metal demo complete!")
    return 0
}
