# serde package demo — pack/unpack i32 + length-prefixed string
import serde.lib { serde_pack, serde_unpack_i32, serde_unpack_string }

extern {
    function printf(fmt: string, val: i32) -> i32
    function puts(s: ptr<u8>) -> i32
}

function main() -> i32 {
    let mut buf: array<u8, 64> = []
    let mut out: array<u8, 64> = []
    let buf_ptr: ptr<u8> = buf
    let out_ptr: ptr<u8> = out

    let packed: i32 = serde_pack(buf_ptr, 64, 42, "flow")
    printf("packed=%d\n", packed)

    let value: i32 = serde_unpack_i32(buf_ptr, packed)
    let slen: i32 = serde_unpack_string(buf_ptr, packed, out_ptr, 64)
    printf("value=%d\n", value)
    printf("slen=%d\n", slen)
    if slen >= 0 {
        puts(out_ptr)
    }

    # "flow" is 4 chars; wire size = 4 (i32) + 4 (len) + 4 (bytes) = 12
    if packed == 12 and value == 42 and slen == 4 {
        printf("ok=%d\n", 1)
        return 0
    }
    printf("ok=%d\n", 0)
    return 1
}
