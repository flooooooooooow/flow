# Spectral filter design + plotting — entirely in Flow
#
# Designs four low-pass filters at 44.1 kHz with a 2000 Hz design cutoff:
#   1. Windowed-sinc FIR (33 taps, Hamming)  — textbook spectral design
#   2. Kaiser-window FIR (N, beta from spec) — optimized stopband for the
#      requested 60 dB attenuation over a 1600 Hz transition band
#   3. RBJ biquad (Butterworth Q = 1/sqrt2)  — exact bilinear cookbook
#   4. One-pole (bilinear-prewarped, exact half-power point on fc) — the
#      simplest low-pass (its -3 dB reading of 1995 Hz is the 0.7079
#      convention; the true 1/sqrt2 cutoff sits exactly on fc)
#
# Design conventions (the "perfect" reading of each):
#   - FIRs: windowed-sinc places the -6 dB point at the design cutoff fc
#     (Hamming's finite window nudges it to 2034 Hz; the 101-tap Kaiser
#     lands at 1999 Hz, essentially exact).
#   - Biquad: RBJ cookbook is exact, but the bilinear warp shifts the -3 dB
#     point slightly below fc (measured ~1998 Hz); Q = 1/sqrt2 is the true
#     Butterworth value (maximally flat in the passband).
#   - One-pole: c = (1 - tan(wc/2))/(1 + tan(wc/2)) — the bilinear transform
#     with prewarped cutoff places the true half-power point (|H| = 1/sqrt2,
#     -3.0103 dB) EXACTLY on fc. The printed -3 dB crossing reads 0.25% low
#     (1995 Hz) only because the "-3 dB" convention is 10^(-3/20) = 0.7079
#     rather than 1/sqrt2 = 0.7071. Rejected: the naive 1 - wc Taylor
#     approximation (-3 dB ~18% high, 2371 Hz) and matched-z c = exp(-wc)
#     (-3 dB 0.45% high, 2009 Hz).
#
# Every crossover (-3 dB, -6 dB) is found by log-frequency bisection, so the
# printed numbers are exact to f32 precision instead of coarse-grid bins.
# Each filter's magnitude response |H(f)| is evaluated on a log-frequency
# grid and rendered, together with the Hamming FIR impulse response, as an
# SVG plot wrapped in a dark-themed HTML page written to build/.
#
# Run:  FLOW_HOST=python ./flow run examples/audio/spectral_filter_design.flow
#
# Native-only: declares FILE*/mkdir externs, so it stays out of the wasm
# gallery manifest (no extern stubs for these yet).
#
# Math intrinsics (sin/cos/log/exp/sqrt) map to libm in the C backend, so
# no stdlib import is needed -- importing stdlib/math.flow would shadow them
# with its stub bodies.

extern {
    function strlen(s: string) -> i64
    function fopen(path: string, mode: string) -> ptr<void>
    function fclose(fp: ptr<void>) -> i32
    function fwrite(buf: ptr<u8>, size: i64, count: i64, fp: ptr<void>) -> i32
    function mkdir(path: string, mode: i32) -> i32
}

const SAMPLE_RATE: f32 = 44100.0
const CUTOFF_HZ: f32 = 2000.0
const TWO_PI: f32 = 6.283185307179586
const PI: f32 = 3.141592653589793
const LN10: f32 = 2.302585093
const Q_BUTTER: f32 = 0.7071067811865476   # 1/sqrt(2), exact Butterworth

# Kaiser spec: 60 dB stopband, 1600 Hz transition band (passband edge 1200 Hz,
# stopband edge 2800 Hz). beta from A>50 formula; N fixed at 101 taps which
# exceeds the N~100 the Kaiser length formula demands.
const KAISER_A: f32 = 60.0
const KAISER_BETA: f32 = 0.1102 * (KAISER_A - 8.7)   # = 5.65
const KAISER_TAPS: i32 = 101

# Filter kind selectors for the shared response/crossover helpers.
const KIND_HAMMING: i32 = 0
const KIND_KAISER: i32 = 1
const KIND_BIQUAD: i32 = 2
const KIND_ONEPOLE: i32 = 3

# ---------- plot geometry ----------

const X0: f32 = 70.0
const X1: f32 = 940.0
const DB_TOP: f32 = 5.0
const DB_BOT: f32 = -80.0
const PANEL_Y0: f32 = 62.0
const PANEL_Y1: f32 = 380.0
const IMP_X0: f32 = 70.0
const IMP_X1: f32 = 940.0
const IMP_Y0: f32 = 470.0
const IMP_Y1: f32 = 690.0
const IMP_HMIN: f32 = -0.15
const IMP_HMAX: f32 = 0.25

# ---------- filter designs ----------

struct Biquad {
    b0: f32
    b1: f32
    b2: f32
    a1: f32
    a2: f32
}

struct OnePole {
    c: f32
}

# RBJ cookbook low-pass, exact sin/cos. Q = 1/sqrt(2) is the Butterworth
# (maximally flat) choice. Note the bilinear warp moves the -3 dB point a
# hair below fc; the cookbook itself is exact for the discrete transfer.
function design_biquad_lowpass(cutoff_norm: f32, q: f32) -> Biquad {
    let omega: f32 = TWO_PI * cutoff_norm
    let sn: f32 = sin(omega)
    let cs: f32 = cos(omega)
    let alpha: f32 = sn / (2.0 * q)
    let b0: f32 = (1.0 - cs) / 2.0
    let b1: f32 = 1.0 - cs
    let b2: f32 = (1.0 - cs) / 2.0
    let a0: f32 = 1.0 + alpha
    let a1: f32 = -2.0 * cs
    let a2: f32 = 1.0 - alpha
    return Biquad {
        b0: b0 / a0, b1: b1 / a0, b2: b2 / a0,
        a1: a1 / a0, a2: a2 / a0
    }
}

# Bilinear-transform one-pole with prewarped cutoff: c = (1 - t)/(1 + t)
# with t = tan(wc/2). The prewarp guarantees |H(e^{jwc})| = 1/sqrt2 exactly,
# so the true cutoff (half-power, -3.0103 dB) lands on fc; the table's
# rounded -3 dB crossing (10^(-3/20)) reads 1995 Hz by convention. The
# transfer function carries the (1 + z^-1)/2 zero at Nyquist, giving
# -6 dB/octave rolloff above fc. Alternatives rejected: naive c = 1 - wc
# (Taylor truncation, -3 dB ~18% high at 2371 Hz) and matched-z c = exp(-wc)
# (-3 dB 0.45% high at 2009 Hz).
function design_onepole_lowpass(cutoff_norm: f32) -> OnePole {
    let t: f32 = tan(PI * cutoff_norm)
    let c: f32 = (1.0 - t) / (1.0 + t)
    return OnePole { c: c }
}

# Modified Bessel I0 via the power series I0(x) = sum_k ((x/2)^k / k!)^2.
# Term recurrence: t_k = t_{k-1} * (x/2)^2 / k^2. Converges in ~20 terms for
# x <= 6 (Kaiser beta stays < 8 in practice).
function bessel_i0(x: f32) -> f32 {
    let mut sum: f32 = 1.0
    let mut term: f32 = 1.0
    let hx: f32 = x / 2.0
    let hx2: f32 = hx * hx
    let mut k: f32 = 1.0
    while k < 40.0 {
        term = term * hx2 / (k * k)
        sum = sum + term
        if term < 0.0000000001 {
            k = 40.0
        } else {
            k = k + 1.0
        }
    }
    return sum
}

# Kaiser-windowed sinc FIR, spec-optimized: beta from the target stopband
# attenuation, tap count fixed at KAISER_TAPS (>= the Kaiser length formula
# demands for the given transition band). Normalized to unity DC gain.
function design_kaiser_fir(cutoff_norm: f32) -> array<f32, 101> {
    let i0b: f32 = bessel_i0(KAISER_BETA)
    let mut h: array<f32, 101> = [0.0]
    let center: f32 = 50.0
    let mut sum: f32 = 0.0
    let mut n: i32 = 0
    while n < KAISER_TAPS {
        let u: f32 = 2.0 * (n as f32) / ((KAISER_TAPS - 1) as f32) - 1.0
        let mut arg: f32 = 1.0 - u * u
        if arg < 0.0 {
            arg = 0.0
        }
        let w: f32 = bessel_i0(KAISER_BETA * sqrt(arg)) / i0b
        let m: f32 = (n as f32) - center
        let x: f32 = 2.0 * cutoff_norm * m
        let tap: f32 = 2.0 * cutoff_norm * sinc(x) * w
        h[n] = tap
        sum = sum + tap
        n = n + 1
    }
    n = 0
    while n < KAISER_TAPS {
        h[n] = h[n] / sum
        n = n + 1
    }
    return h
}

# sinc(x) = sin(pi x) / (pi x), with the x = 0 limit.
function sinc(x: f32) -> f32 {
    let mut ax: f32 = x
    if x < 0.0 {
        ax = -x
    }
    if ax < 0.00001 {
        return 1.0
    }
    return sin(PI * x) / (PI * x)
}

# ---------- frequency responses (evaluate H(e^jw)) ----------

# FIR: H = sum_n h[n] e^{-jwn}
function fir_response_at(h: array<f32, 33>, w: f32) -> f32 {
    let mut re: f32 = 0.0
    let mut im: f32 = 0.0
    let mut n: i32 = 0
    while n < 33 {
        let nw: f32 = (n as f32) * w
        re = re + h[n] * cos(nw)
        im = im - h[n] * sin(nw)
        n = n + 1
    }
    return sqrt(re * re + im * im)
}

# Kaiser FIR (101 taps): same DFT sum, sized for the optimized design.
function kaiser_response_at(h: array<f32, 101>, w: f32) -> f32 {
    let mut re: f32 = 0.0
    let mut im: f32 = 0.0
    let mut n: i32 = 0
    while n < KAISER_TAPS {
        let nw: f32 = (n as f32) * w
        re = re + h[n] * cos(nw)
        im = im - h[n] * sin(nw)
        n = n + 1
    }
    return sqrt(re * re + im * im)
}

# Biquad: H = (b0 + b1 e^{-jw} + b2 e^{-2jw}) / (1 + a1 e^{-jw} + a2 e^{-2jw})
function biquad_response_at(f: Biquad, w: f32) -> f32 {
    let c1: f32 = cos(w)
    let s1: f32 = sin(w)
    let c2: f32 = cos(2.0 * w)
    let s2: f32 = sin(2.0 * w)
    let br: f32 = f.b0 + f.b1 * c1 + f.b2 * c2
    let bi: f32 = -(f.b1 * s1 + f.b2 * s2)
    let ar: f32 = 1.0 + f.a1 * c1 + f.a2 * c2
    let ai: f32 = -(f.a1 * s1 + f.a2 * s2)
    let num: f32 = br * br + bi * bi
    let den: f32 = ar * ar + ai * ai
    if den < 0.0000000001 {
        return 0.0
    }
    return sqrt(num / den)
}

# Bilinear one-pole: H = ((1-c)/2)(1 + z^-1)/(1 - c z^-1), so
# |H(e^{jw})| = (1-c) cos(w/2) / |1 - c e^{-jw}|. The cos(w/2) factor is the
# Nyquist zero; at w = 0 it evaluates to 1 (unity DC gain).
function onepole_response_at(f: OnePole, w: f32) -> f32 {
    let den_re: f32 = 1.0 - f.c * cos(w)
    let den_im: f32 = f.c * sin(w)
    let den: f32 = den_re * den_re + den_im * den_im
    if den < 0.0000000001 {
        return 0.0
    }
    let num: f32 = (1.0 - f.c) * cos(w / 2.0)
    return num / sqrt(den)
}

# |H| to dB with an -80 dB floor.
function to_db(mag: f32) -> f32 {
    let mut db: f32 = -80.0
    if mag > 0.0001 {
        db = 20.0 * log(mag) / LN10
    }
    if db < -80.0 {
        db = -80.0
    }
    return db
}

# Display helpers: snap f32 measurement noise so DC gain reads 0.00, not -0.00.
function snap_dc(db: f32) -> f32 {
    if db > -0.005 && db < 0.005 {
        return 0.0
    }
    return db
}

# Display formatting for the HTML table. Flow renders f32 with full
# precision ("1995.320557"), so round to whole Hz and to one decimal dB
# via integer arithmetic before string concat.
function hz_disp(f: f32) -> i32 {
    return (f + 0.5) as i32
}

function db_disp(f: f32) -> string {
    let v: i32 = (f * 10.0) as i32
    let whole: i32 = v / 10
    let mut tenth: i32 = v - whole * 10
    if tenth < 0 {
        tenth = 0 - tenth
    }
    return whole + "." + tenth
}

# dB at frequency f for filter kind (shared by the plot and the bisection).
function db_at(kind: i32, fir: array<f32, 33>, kaiser: array<f32, 101>, bq: Biquad, op: OnePole, f: f32) -> f32 {
    let w: f32 = TWO_PI * f / SAMPLE_RATE
    if kind == KIND_HAMMING {
        return to_db(fir_response_at(fir, w))
    }
    if kind == KIND_KAISER {
        return to_db(kaiser_response_at(kaiser, w))
    }
    if kind == KIND_BIQUAD {
        return to_db(biquad_response_at(bq, w))
    }
    return to_db(onepole_response_at(op, w))
}

# Exact crossover finder: bisect on log-frequency until the response crosses
# level_db. 50 iterations resolves f32 precision over [20, 20000] Hz.
function find_crossing(kind: i32, fir: array<f32, 33>, kaiser: array<f32, 101>, bq: Biquad, op: OnePole, level_db: f32) -> f32 {
    let mut lo: f32 = 20.0
    let mut hi: f32 = 20000.0
    let mut it: i32 = 0
    while it < 50 {
        let mid: f32 = exp((log(lo) + log(hi)) / 2.0)
        if db_at(kind, fir, kaiser, bq, op, mid) <= level_db {
            hi = mid
        } else {
            lo = mid
        }
        it = it + 1
    }
    return exp((log(lo) + log(hi)) / 2.0)
}

# ---------- plot coordinate helpers ----------

function x_for_f(f: f32) -> f32 {
    return X0 + (X1 - X0) * (log(f / 20.0) / log(1000.0))
}

function y_for_db(db: f32) -> f32 {
    return PANEL_Y1 - (PANEL_Y1 - PANEL_Y0) * ((db - DB_BOT) / (DB_TOP - DB_BOT))
}

function x_for_tap(n: i32) -> f32 {
    return IMP_X0 + (IMP_X1 - IMP_X0) * (n as f32) / 32.0
}

function y_for_h(h: f32) -> f32 {
    let scale: f32 = (IMP_Y1 - IMP_Y0) / (IMP_HMAX - IMP_HMIN)
    return IMP_Y1 - (h - IMP_HMIN) * scale
}

# ---------- file output ----------

function write_file(path: string, text: string) -> i32 {
    let fp: ptr<void> = fopen(path, "wb")
    if fp == null {
        return 1
    }
    let n: i32 = strlen(text) as i32
    let wrote: i32 = fwrite(text as ptr<u8>, 1, n, fp)
    let _c: i32 = fclose(fp)
    if wrote != n {
        return 1
    }
    return 0
}

function main() -> i32 {
    let fc_norm: f32 = CUTOFF_HZ / SAMPLE_RATE
    let bq: Biquad = design_biquad_lowpass(fc_norm, Q_BUTTER)
    let op: OnePole = design_onepole_lowpass(fc_norm)

    # Windowed-sinc FIR taps (Hamming), designed inline so no array crosses
    # a function boundary. Normalized to unity DC gain.
    let mut fir: array<f32, 33> = [0.0]
    let mut fir_sum: f32 = 0.0
    let mut n: i32 = 0
    while n < 33 {
        let m: f32 = (n as f32) - 16.0
        let window: f32 = 0.54 - 0.46 * cos(TWO_PI * (n as f32) / 32.0)
        let tap: f32 = 2.0 * fc_norm * sinc(2.0 * fc_norm * m) * window
        fir[n] = tap
        fir_sum = fir_sum + tap
        n = n + 1
    }
    let mut i: i32 = 0
    while i < 33 {
        fir[i] = fir[i] / fir_sum
        i = i + 1
    }

    # Spec-optimized Kaiser FIR (101 taps, beta from 60 dB target).
    let kaiser: array<f32, 101> = design_kaiser_fir(fc_norm)

    # ---------- exact measurements (bisected, not grid-quantized) ----------
    let dc_fir: f32 = snap_dc(db_at(KIND_HAMMING, fir, kaiser, bq, op, 1.0))
    let dc_bq: f32 = snap_dc(db_at(KIND_BIQUAD, fir, kaiser, bq, op, 1.0))
    let dc_op: f32 = snap_dc(db_at(KIND_ONEPOLE, fir, kaiser, bq, op, 1.0))
    let dc_k: f32 = snap_dc(db_at(KIND_KAISER, fir, kaiser, bq, op, 1.0))

    let f3_ham: f32 = find_crossing(KIND_HAMMING, fir, kaiser, bq, op, -3.0)
    let f3_k: f32 = find_crossing(KIND_KAISER, fir, kaiser, bq, op, -3.0)
    let f3_bq: f32 = find_crossing(KIND_BIQUAD, fir, kaiser, bq, op, -3.0)
    let f3_op: f32 = find_crossing(KIND_ONEPOLE, fir, kaiser, bq, op, -3.0)

    let f6_ham: f32 = find_crossing(KIND_HAMMING, fir, kaiser, bq, op, -6.0)
    let f6_k: f32 = find_crossing(KIND_KAISER, fir, kaiser, bq, op, -6.0)
    let f6_bq: f32 = find_crossing(KIND_BIQUAD, fir, kaiser, bq, op, -6.0)
    let f6_op: f32 = find_crossing(KIND_ONEPOLE, fir, kaiser, bq, op, -6.0)

    let s4_ham: f32 = db_at(KIND_HAMMING, fir, kaiser, bq, op, 4000.0)
    let s4_k: f32 = db_at(KIND_KAISER, fir, kaiser, bq, op, 4000.0)
    let s4_bq: f32 = db_at(KIND_BIQUAD, fir, kaiser, bq, op, 4000.0)
    let s4_op: f32 = db_at(KIND_ONEPOLE, fir, kaiser, bq, op, 4000.0)

    let s8_k: f32 = db_at(KIND_KAISER, fir, kaiser, bq, op, 8000.0)
    let s8_bq: f32 = db_at(KIND_BIQUAD, fir, kaiser, bq, op, 8000.0)

    printf("Spectral filter design @ %.0f Hz sample rate, design cutoff %.0f Hz\n", SAMPLE_RATE, CUTOFF_HZ)
    printf("  Hamming FIR  33 taps : -3 dB %.0f Hz, -6 dB %.0f Hz, @4k %.1f dB, DC %.2f dB\n", f3_ham, f6_ham, s4_ham, dc_fir)
    printf("  Kaiser FIR 101 taps  : -3 dB %.0f Hz, -6 dB %.0f Hz, @4k %.1f dB, @8k %.1f dB, DC %.2f dB\n", f3_k, f6_k, s4_k, s8_k, dc_k)
    printf("  Biquad  Q=1/sqrt2    : -3 dB %.0f Hz, -6 dB %.0f Hz, @4k %.1f dB, @8k %.1f dB, DC %.2f dB\n", f3_bq, f6_bq, s4_bq, s8_bq, dc_bq)
    printf("  One-pole bilinear    : -3 dB %.0f Hz, -6 dB %.0f Hz, @4k %.1f dB, DC %.2f dB\n", f3_op, f6_op, s4_op, dc_op)

    # ---------- magnitude-response polylines ----------
    let mut fir_pts: string = ""
    let mut k_pts: string = ""
    let mut bq_pts: string = ""
    let mut op_pts: string = ""
    let mut first_fir: i32 = 1
    let mut first_k: i32 = 1
    let mut first_bq: i32 = 1
    let mut first_op: i32 = 1
    let mut k: i32 = 0
    while k < 48 {
        let frac: f32 = (k as f32) / 47.0
        let f: f32 = 20.0 * exp(frac * log(1000.0))
        let db_fir: f32 = db_at(KIND_HAMMING, fir, kaiser, bq, op, f)
        let db_k: f32 = db_at(KIND_KAISER, fir, kaiser, bq, op, f)
        let db_bq: f32 = db_at(KIND_BIQUAD, fir, kaiser, bq, op, f)
        let db_op: f32 = db_at(KIND_ONEPOLE, fir, kaiser, bq, op, f)
        let px: f32 = x_for_f(f)
        let py_fir: f32 = y_for_db(db_fir)
        let py_k: f32 = y_for_db(db_k)
        let py_bq: f32 = y_for_db(db_bq)
        let py_op: f32 = y_for_db(db_op)

        if first_fir == 1 {
            fir_pts = px + "," + py_fir
            first_fir = 0
        } else {
            fir_pts = fir_pts + " " + px + "," + py_fir
        }
        if first_k == 1 {
            k_pts = px + "," + py_k
            first_k = 0
        } else {
            k_pts = k_pts + " " + px + "," + py_k
        }
        if first_bq == 1 {
            bq_pts = px + "," + py_bq
            first_bq = 0
        } else {
            bq_pts = bq_pts + " " + px + "," + py_bq
        }
        if first_op == 1 {
            op_pts = px + "," + py_op
            first_op = 0
        } else {
            op_pts = op_pts + " " + px + "," + py_op
        }
        k = k + 1
    }

    # ---------- assemble the SVG ----------
    let mut svg: string = ""
    svg = svg + "<svg xmlns='http://www.w3.org/2000/svg' width='960' height='700' viewBox='0 0 960 700'>"
    svg = svg + "<rect width='960' height='700' fill='#0f1420'/>"
    svg = svg + "<text x='480' y='28' fill='#e8eef8' font-size='16' text-anchor='middle' font-weight='bold'>Magnitude response |H(f)| — 44.1 kHz, cutoff 2000 Hz</text>"

    # Vertical decade gridlines + labels
    let gx20: f32 = x_for_f(20.0)
    let gx100: f32 = x_for_f(100.0)
    let gx1k: f32 = x_for_f(1000.0)
    let gx10k: f32 = x_for_f(10000.0)
    let gx20k: f32 = x_for_f(20000.0)
    svg = svg + "<line x1='" + gx20 + "' y1='" + PANEL_Y0 + "' x2='" + gx20 + "' y2='" + PANEL_Y1 + "' stroke='#232d3f' stroke-width='1'/>"
    svg = svg + "<line x1='" + gx100 + "' y1='" + PANEL_Y0 + "' x2='" + gx100 + "' y2='" + PANEL_Y1 + "' stroke='#232d3f' stroke-width='1'/>"
    svg = svg + "<line x1='" + gx1k + "' y1='" + PANEL_Y0 + "' x2='" + gx1k + "' y2='" + PANEL_Y1 + "' stroke='#232d3f' stroke-width='1'/>"
    svg = svg + "<line x1='" + gx10k + "' y1='" + PANEL_Y0 + "' x2='" + gx10k + "' y2='" + PANEL_Y1 + "' stroke='#232d3f' stroke-width='1'/>"
    svg = svg + "<line x1='" + gx20k + "' y1='" + PANEL_Y0 + "' x2='" + gx20k + "' y2='" + PANEL_Y1 + "' stroke='#232d3f' stroke-width='1'/>"
    svg = svg + "<text x='" + gx20 + "' y='" + (PANEL_Y1 + 16) + "' fill='#7c8aa5' font-size='10' text-anchor='middle'>20</text>"
    svg = svg + "<text x='" + gx100 + "' y='" + (PANEL_Y1 + 16) + "' fill='#7c8aa5' font-size='10' text-anchor='middle'>100</text>"
    svg = svg + "<text x='" + gx1k + "' y='" + (PANEL_Y1 + 16) + "' fill='#7c8aa5' font-size='10' text-anchor='middle'>1k</text>"
    svg = svg + "<text x='" + gx10k + "' y='" + (PANEL_Y1 + 16) + "' fill='#7c8aa5' font-size='10' text-anchor='middle'>10k</text>"
    svg = svg + "<text x='" + gx20k + "' y='" + (PANEL_Y1 + 16) + "' fill='#7c8aa5' font-size='10' text-anchor='middle'>20k</text>"

    # Horizontal dB gridlines + labels
    let gy0: f32 = y_for_db(0.0)
    let gy20: f32 = y_for_db(-20.0)
    let gy40: f32 = y_for_db(-40.0)
    let gy60: f32 = y_for_db(-60.0)
    let gy80: f32 = y_for_db(-80.0)
    svg = svg + "<line x1='" + X0 + "' y1='" + gy0 + "' x2='" + X1 + "' y2='" + gy0 + "' stroke='#2c3750' stroke-width='1'/>"
    svg = svg + "<line x1='" + X0 + "' y1='" + gy20 + "' x2='" + X1 + "' y2='" + gy20 + "' stroke='#232d3f' stroke-width='1'/>"
    svg = svg + "<line x1='" + X0 + "' y1='" + gy40 + "' x2='" + X1 + "' y2='" + gy40 + "' stroke='#232d3f' stroke-width='1'/>"
    svg = svg + "<line x1='" + X0 + "' y1='" + gy60 + "' x2='" + X1 + "' y2='" + gy60 + "' stroke='#232d3f' stroke-width='1'/>"
    svg = svg + "<line x1='" + X0 + "' y1='" + gy80 + "' x2='" + X1 + "' y2='" + gy80 + "' stroke='#232d3f' stroke-width='1'/>"
    svg = svg + "<text x='" + (X0 - 8) + "' y='" + (gy0 + 3) + "' fill='#7c8aa5' font-size='10' text-anchor='end'>0</text>"
    svg = svg + "<text x='" + (X0 - 8) + "' y='" + (gy20 + 3) + "' fill='#7c8aa5' font-size='10' text-anchor='end'>-20</text>"
    svg = svg + "<text x='" + (X0 - 8) + "' y='" + (gy40 + 3) + "' fill='#7c8aa5' font-size='10' text-anchor='end'>-40</text>"
    svg = svg + "<text x='" + (X0 - 8) + "' y='" + (gy60 + 3) + "' fill='#7c8aa5' font-size='10' text-anchor='end'>-60</text>"
    svg = svg + "<text x='" + (X0 - 8) + "' y='" + (gy80 + 3) + "' fill='#7c8aa5' font-size='10' text-anchor='end'>-80</text>"

    # Cutoff marker
    let gxfc: f32 = x_for_f(CUTOFF_HZ)
    svg = svg + "<line x1='" + gxfc + "' y1='" + PANEL_Y0 + "' x2='" + gxfc + "' y2='" + PANEL_Y1 + "' stroke='#5a6b8c' stroke-width='1' stroke-dasharray='4 3'/>"

    # Axes box
    svg = svg + "<rect x='" + X0 + "' y='" + PANEL_Y0 + "' width='" + (X1 - X0) + "' height='" + (PANEL_Y1 - PANEL_Y0) + "' fill='none' stroke='#3a465e'/>"

    # Curves
    svg = svg + "<polyline points='" + fir_pts + "' fill='none' stroke='#ff7e67' stroke-width='2.2' stroke-linejoin='round'/>"
    svg = svg + "<polyline points='" + k_pts + "' fill='none' stroke='#c084fc' stroke-width='2.2' stroke-linejoin='round'/>"
    svg = svg + "<polyline points='" + bq_pts + "' fill='none' stroke='#5ad7ff' stroke-width='2.2' stroke-linejoin='round'/>"
    svg = svg + "<polyline points='" + op_pts + "' fill='none' stroke='#b2ff5e' stroke-width='2.2' stroke-linejoin='round'/>"

    # Legend
    svg = svg + "<rect x='690' y='72' width='12' height='12' fill='#ff7e67'/><text x='708' y='82' fill='#dbe4f0' font-size='12'>FIR 33-tap (Hamming)</text>"
    svg = svg + "<rect x='690' y='92' width='12' height='12' fill='#c084fc'/><text x='708' y='102' fill='#dbe4f0' font-size='12'>Kaiser 101-tap (A=60 dB)</text>"
    svg = svg + "<rect x='690' y='112' width='12' height='12' fill='#5ad7ff'/><text x='708' y='122' fill='#dbe4f0' font-size='12'>Biquad Q=1/√2</text>"
    svg = svg + "<rect x='690' y='132' width='12' height='12' fill='#b2ff5e'/><text x='708' y='142' fill='#dbe4f0' font-size='12'>One-pole (bilinear)</text>"

    # ---------- impulse response panel (FIR taps) ----------
    svg = svg + "<text x='480' y='" + (IMP_Y0 - 22) + "' fill='#e8eef8' font-size='15' text-anchor='middle' font-weight='bold'>FIR impulse response h[n]</text>"
    let base_y: f32 = y_for_h(0.0)
    svg = svg + "<line x1='" + IMP_X0 + "' y1='" + base_y + "' x2='" + IMP_X1 + "' y2='" + base_y + "' stroke='#2c3750' stroke-width='1'/>"
    let ypos: f32 = y_for_h(0.1)
    let yneg: f32 = y_for_h(-0.1)
    svg = svg + "<line x1='" + IMP_X0 + "' y1='" + ypos + "' x2='" + IMP_X1 + "' y2='" + ypos + "' stroke='#232d3f' stroke-width='1'/>"
    svg = svg + "<line x1='" + IMP_X0 + "' y1='" + yneg + "' x2='" + IMP_X1 + "' y2='" + yneg + "' stroke='#232d3f' stroke-width='1'/>"

    let mut t: i32 = 0
    while t < 33 {
        let tx: f32 = x_for_tap(t)
        let ty: f32 = y_for_h(fir[t])
        svg = svg + "<line x1='" + tx + "' y1='" + base_y + "' x2='" + tx + "' y2='" + ty + "' stroke='#ff7e67' stroke-width='2'/>"
        svg = svg + "<circle cx='" + tx + "' cy='" + ty + "' r='2.2' fill='#ff7e67'/>"
        t = t + 1
    }
    svg = svg + "<text x='" + x_for_tap(0) + "' y='" + (IMP_Y1 + 16) + "' fill='#7c8aa5' font-size='10' text-anchor='middle'>0</text>"
    svg = svg + "<text x='" + x_for_tap(16) + "' y='" + (IMP_Y1 + 16) + "' fill='#7c8aa5' font-size='10' text-anchor='middle'>16</text>"
    svg = svg + "<text x='" + x_for_tap(32) + "' y='" + (IMP_Y1 + 16) + "' fill='#7c8aa5' font-size='10' text-anchor='middle'>32</text>"
    svg = svg + "<rect x='" + IMP_X0 + "' y='" + IMP_Y0 + "' width='" + (IMP_X1 - IMP_X0) + "' height='" + (IMP_Y1 - IMP_Y0) + "' fill='none' stroke='#3a465e'/>"
    svg = svg + "</svg>"

    # ---------- metrics table (exact, bisected) ----------
    let mut table: string = "<table><tr><th>Filter</th><th>−3 dB</th><th>−6 dB</th><th>@4 kHz</th><th>@8 kHz</th><th>DC gain</th></tr>"
    table = table + "<tr><td>Hamming FIR 33</td><td>" + hz_disp(f3_ham) + " Hz</td><td>" + hz_disp(f6_ham) + " Hz</td><td>" + db_disp(s4_ham) + " dB</td><td>—</td><td>" + db_disp(dc_fir) + " dB</td></tr>"
    table = table + "<tr><td>Kaiser FIR 101 (A=60)</td><td>" + hz_disp(f3_k) + " Hz</td><td>" + hz_disp(f6_k) + " Hz</td><td>" + db_disp(s4_k) + " dB</td><td>" + db_disp(s8_k) + " dB</td><td>" + db_disp(dc_k) + " dB</td></tr>"
    table = table + "<tr><td>Biquad Q=1/√2</td><td>" + hz_disp(f3_bq) + " Hz</td><td>" + hz_disp(f6_bq) + " Hz</td><td>" + db_disp(s4_bq) + " dB</td><td>" + db_disp(s8_bq) + " dB</td><td>" + db_disp(dc_bq) + " dB</td></tr>"
    table = table + "<tr><td>One-pole (bilinear)</td><td>" + hz_disp(f3_op) + " Hz</td><td>" + hz_disp(f6_op) + " Hz</td><td>" + db_disp(s4_op) + " dB</td><td>—</td><td>" + db_disp(dc_op) + " dB</td></tr></table>"

    # ---------- HTML wrapper ----------
    let html: string = "<!doctype html><html><head><meta charset='utf-8'><title>Spectral Filter Design — Flow</title>"
    html = html + "<style>body{background:#0b0f17;color:#dbe4f0;font-family:system-ui,'Segoe UI',sans-serif;padding:36px;max-width:1000px;margin:auto}"
    html = html + "h1{font-size:21px;letter-spacing:.4px;margin-bottom:6px}h2{font-size:13.5px;color:#8fa3bf;font-weight:500;margin:0 0 18px;line-height:1.5}"
    html = html + ".legend{display:flex;gap:20px;margin:16px 0;flex-wrap:wrap;font-size:13px;color:#b9c6da}"
    html = html + ".chip{display:flex;align-items:center;gap:8px}.sw{width:22px;height:3px;border-radius:2px}"
    html = html + "code{background:#151c2a;padding:2px 6px;border-radius:4px;font-size:12.5px}"
    html = html + "table{border-collapse:collapse;margin:18px 0 4px;width:100%;font-size:13px}"
    html = html + "th,td{border:1px solid #232d3f;padding:7px 12px;text-align:left}th{color:#8fa3bf;font-weight:600}td{color:#c9d4e4}"
    html = html + "footer{margin-top:22px;color:#6b7a94;font-size:12.5px;line-height:1.7}</style></head><body>"
    html = html + "<h1>🎛️ Spectral Filter Design in Flow</h1>"
    html = html + "<h2>Four low-pass designs at 44.1 kHz (design cutoff 2000 Hz) — Hamming FIR, spec-optimized Kaiser FIR, RBJ Butterworth biquad, bilinear one-pole — with exact bisected crossovers and stopband measurements, computed and rendered by a single Flow program.</h2>"
    html = html + "<div class='legend'><span class='chip'><span class='sw' style='background:#ff7e67'></span>FIR 33-tap (Hamming)</span>"
    html = html + "<span class='chip'><span class='sw' style='background:#c084fc'></span>Kaiser 101-tap (A=60 dB)</span>"
    html = html + "<span class='chip'><span class='sw' style='background:#5ad7ff'></span>Biquad Q=1/√2</span>"
    html = html + "<span class='chip'><span class='sw' style='background:#b2ff5e'></span>One-pole (bilinear)</span></div>"
    html = html + svg
    html = html + table
    html = html + "<footer>Generated by <code>examples/audio/spectral_filter_design.flow</code> — run with <code>./flow run examples/audio/spectral_filter_design.flow</code>. "
    html = html + "Crossovers are log-frequency bisections; the Kaiser β=5.65 is set for 60 dB stopband attenuation over a 1600 Hz transition band. "
    html = html + "Filter math is plain Flow (<code>sin</code>/<code>cos</code>/<code>log</code>/<code>exp</code> map to libm in the C backend).</footer>"
    html = html + "</body></html>"

    # ---------- write artifacts ----------
    let _mk: i32 = mkdir("build", 493)
    if write_file("build/spectral_filter_design.svg", svg) != 0 {
        println("failed to write build/spectral_filter_design.svg")
        return 1
    }
    if write_file("build/spectral_filter_design.html", html) != 0 {
        println("failed to write build/spectral_filter_design.html")
        return 1
    }
    printf("Wrote build/spectral_filter_design.html (+ .svg)\n")
    return 0
}
