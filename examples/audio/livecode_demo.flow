# flow:lenient - type checker does not yet resolve trait/capability-based audio overloads (DelayLine vs DelayLineF32)
# Livecoding Demo - Make Music in FLOW
#
# This demonstrates how FLOW makes audio programming easier than ANY other language.
# No boilerplate, no setup, just write music!
#
# Compare to:
# - SuperCollider: Requires server boot, SynthDef creation, bus routing
# - ChucK: Requires UGen connection, time advancement
# - Sonic Pi: Ruby-based, not compiled, slower
# - Max/MSP: Visual, not code
# - Pure Data: Visual, not code
#
# FLOW: Just import and play!

import "stdlib/audio/livecode.flow"
import "stdlib/audio/scales.flow"
import "stdlib/audio/clock.flow"

# =============================================================================
# Example 1: Simple Bassline
# =============================================================================

function example_bassline() -> f32 {
    # Create a clock at 120 BPM
    let clock: Clock = clock_medium(sample_rate_44100())
    let pos: i64 = 0  # Would be updated each sample

    # Four-note bass pattern on C
    let pattern: array<i32, 4> = [
        note_C(2),      # C2
        note_C(2),      # C2
        note_G(2),      # G2 (fifth)
        note_F(2)       # F2 (fourth)
    ]

    # Play the pattern with bass synth
    return pattern_4(pattern, clock, pos, bass)
}

# =============================================================================
# Example 2: House Beat
# =============================================================================

function example_house_beat() -> f32 {
    let clock: Clock = clock_house(sample_rate_44100())  # 128 BPM
    let pos: i64 = 0

    # One line for a complete house beat!
    return house_beat(clock, pos)
}

# =============================================================================
# Example 3: Chord Progression
# =============================================================================

function example_chords() -> f32 {
    let clock: Clock = clock_medium(sample_rate_44100())
    let pos: i64 = 0

    # I - V - vi - IV progression (pop music!)
    let root: i32 = note_C(4)
    let progression: array<array<i32, 3>, 4> = progression_pop(root)

    # Play the progression with pad synth
    return chord_progression(progression, clock, pos)
}

# =============================================================================
# Example 4: Melody from Scale
# =============================================================================

function example_melody() -> f32 {
    let clock: Clock = clock_medium(sample_rate_44100())
    let pos: i64 = 0

    # C major scale
    let scale: array<i32, 7> = scale_major(note_C(4))

    # Melody pattern: C D E G E D C E
    let pattern: array<i32, 8> = [
        scale[0],  # C
        scale[1],  # D
        scale[2],  # E
        scale[4],  # G
        scale[2],  # E
        scale[1],  # D
        scale[0],  # C
        scale[2]   # E
    ]

    # Play with lead synth
    return pattern_8(pattern, clock, pos, lead)
}

# =============================================================================
# Example 5: Euclidean Rhythm
# =============================================================================

function example_euclidean() -> f32 {
    let clock: Clock = clock_medium(sample_rate_44100())
    let pos: i64 = 0

    # 5 hits in 8 steps (funky rhythm!)
    # Pattern: [x . x . x . x x]
    return euclidean_pattern(5, 8, clock, pos, kick)
}

# =============================================================================
# Example 6: Complete Track
# =============================================================================

function example_complete_track() -> f32 {
    let clock: Clock = clock_new(128.0, sample_rate_44100())
    let pos: i64 = 0

    # Drums
    let drums: f32 = house_beat(clock, pos)

    # Bassline
    let bass_notes: array<i32, 4> = [
        note_C(2), note_C(2), note_G(2), note_Bb(2)
    ]
    let bassline: f32 = pattern_4(bass_notes, clock, pos, bass)

    # Melody
    let melody_notes: array<i32, 8> = [
        note_C(5), note_E(5), note_G(5), note_C(6),
        note_G(5), note_E(5), note_D(5), note_C(5)
    ]
    let melody: f32 = pattern_8(melody_notes, clock, pos, lead)

    # Chord pad
    let chords: array<array<i32, 3>, 4> = [
        chord_minor(note_C(3)),
        chord_major(note_F(3)),
        chord_minor(note_G(3)),
        chord_major(note_Bb(3))
    ]
    let chord_pad: f32 = chord_progression(chords, clock, pos)

    # Mix everything
    let mix: f32 = drums * 0.8 + bassline * 0.6 + melody * 0.5 + chord_pad * 0.3

    # Add effects
    let with_fx: f32 = with_delay(mix, clock)
    let with_verb: f32 = with_reverb(with_fx, 0.4)

    # Master output
    return master_out(with_verb)
}

# =============================================================================
# Example 7: Live Coding Style (Change While Playing!)
# =============================================================================

function livecode_pattern(bar_number: i32) -> f32 {
    let clock: Clock = clock_new(140.0, sample_rate_44100())
    let pos: i64 = 0

    # Different pattern each bar - change code while it plays!
    let mut pattern: array<i32, 4> = [0, 0, 0, 0]

    if bar_number % 4 == 0 {
        # First bar: just root
        pattern = [note_C(3), note_C(3), note_C(3), note_C(3)]
    } elif bar_number % 4 == 1 {
        # Second bar: add fifth
        pattern = [note_C(3), note_G(3), note_C(3), note_G(3)]
    } elif bar_number % 4 == 2 {
        # Third bar: walking bass
        pattern = [note_C(3), note_D(3), note_E(3), note_F(3)]
    } else {
        # Fourth bar: octave jump
        pattern = [note_C(3), note_C(2), note_G(3), note_C(4)]
    }

    return pattern_4(pattern, clock, pos, bass)
}

# =============================================================================
# Example 8: Generative Music
# =============================================================================

function generative_melody(seed: i32) -> f32 {
    let clock: Clock = clock_medium(sample_rate_44100())
    let pos: i64 = 0

    # Use seed to generate different melodies
    let scale: array<i32, 7> = scale_pentatonic_major(note_C(4))

    # "Random" pattern based on seed
    let degree1: i32 = seed % 5
    let degree2: i32 = (seed + 2) % 5
    let degree3: i32 = (seed + 4) % 5
    let degree4: i32 = (seed + 1) % 5

    let pattern: array<i32, 4> = [
        scale[degree1],
        scale[degree2],
        scale[degree3],
        scale[degree4]
    ]

    return pattern_4(pattern, clock, pos, pluck)
}

# =============================================================================
# Main: Demonstrate All Examples
# =============================================================================

