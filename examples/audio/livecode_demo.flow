    println("   pattern_4(pattern, clock, pos, bass)")
    println("")

    println("2. House Beat:")
    println("   house_beat(clock, pos)")
    println("   ^ That's it! Kick, clap, hi-hats, done.")
    println("")

    println("3. Chord Progression:")
    println("   let chords = progression_pop(C4)")
    println("   chord_progression(chords, clock, pos)")
    println("")

    println("4. Euclidean Rhythm:")
    println("   euclidean_pattern(5, 8, clock, pos, kick)")
    println("   ^ 5 hits in 8 steps, automatically!")
    println("")

    println("5. Complete Track:")
    println("   drums + bass + melody + chords + effects")
    println("   All in ~10 lines of code!")
