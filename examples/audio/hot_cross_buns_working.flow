# Hot Cross Buns - Working Version
# Uses direct MIDI notes instead of scales module to avoid C generator array bug
#
# Melody: E D C, E D C, C C C C, D D D D, E D C

import "stdlib/audio.flow"
import "stdlib/audio/oscillators.flow"

# Direct MIDI note numbers (avoiding scales module for now)
const E4: i32 = 64  # E4
const D4: i32 = 62  # D4
const C4: i32 = 60  # C4 (middle C)

# Convert MIDI to frequency (simple version)
function note_to_freq(midi: i32) -> f32 {
    # f = 440 * 2^((midi - 69) / 12)
    # Simple approximation for our notes
    if midi == 60 { return 261.63 }  # C4
    if midi == 62 { return 293.66 }  # D4
    if midi == 64 { return 329.63 }  # E4
    return 440.0
}

# Play a single note with sine wave
function play_note(freq: f32, position: i64, duration: i64) -> f32 {
    let rate: f64 = 44100.0

    # Simple envelope
    let phase: f64 = position / duration
    let mut envelope: f32 = 1.0

    if phase < 0.1 {
        # Attack
        envelope = phase / 0.1
    } else {
        if phase > 0.8 {
            # Release
            envelope = (1.0 - phase) / 0.2
        }
    }

    # Generate sine wave
    let osc_phase: f64 = (position * freq) / rate
    let sample: f32 = sine(osc_phase) * envelope * 0.4

    return sample
}

function main() -> i32 {
    println("========================================")
    println("  Hot Cross Buns - Sine Wave Player")
    println("========================================")
    println("")

    # Define melody structure
    println("Melody:")
    println("  Part 1: E D C (Hot cross buns)")
    println("  Part 2: E D C (Hot cross buns)")
    println("  Part 3: C C C C (One a penny)")
    println("  Part 4: D D D D (Two a penny)")
    println("  Part 5: E D C (Hot cross buns)")
    println("")

    # Note frequencies
    let freq_e: f32 = note_to_freq(E4)
    let freq_d: f32 = note_to_freq(D4)
    let freq_c: f32 = note_to_freq(C4)

    print("E4 = ")
    printf("%.2f", freq_e)
    println(" Hz")

    print("D4 = ")
    printf("%.2f", freq_d)
    println(" Hz")

    print("C4 = ")
    printf("%.2f", freq_c)
    println(" Hz")
    println("")

    # Demonstrate sample generation
    println("Generating sample waveforms...")
    println("")

    let quarter_note: i64 = 22050  # ~0.5 seconds at 44.1kHz
    let eighth_note: i64 = 11025   # ~0.25 seconds

    # Generate a few samples of the first note (E)
    println("First note (E4) samples:")
    for i in 0 to 10 {
        let pos: i64 = i * 1000
        let sample: f32 = play_note(freq_e, pos, quarter_note)
        print("  Sample ")
        print(i)
        print(": ")
        printf("%.6f", sample)
        println("")
    }

    println("")
    println("========================================")
    println("To hear this melody:")
    println("========================================")
    println("")
    println("1. The play_note() function generates sine")
    println("   waves at the correct frequencies")
    println("")
    println("2. Each note has:")
    println("   - Attack envelope (fade in)")
    println("   - Sustain (full volume)")
    println("   - Release (fade out)")
    println("")
    println("3. The melody plays at 100 BPM:")
    println("   - Quarter notes: ~0.5 seconds")
    println("   - Eighth notes: ~0.25 seconds")
    println("")
    println("4. To actually play audio:")
    println("   - Hook this up to PortAudio, SDL, or JACK")
    println("   - Call play_note() in audio callback")
    println("   - Sequence through all 17 notes")
    println("")
    println("The waveforms are ready to send to speakers!")

    return 0
}
