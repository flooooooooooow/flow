# Filter sweep: one sawtooth, one moving cutoff.
#
# WHAT YOU WILL HEAR
#   Six seconds of a 110 Hz sawtooth through a resonant lowpass whose cutoff
#   climbs from 120 Hz to 6 kHz and falls back. The pitch never changes. What
#   changes is how many of the saw's harmonics survive the filter, which is
#   the whole of subtractive synthesis in one gesture.
#
# LISTEN
#   ./flow audio examples/audio/filter_sweep.flow
#
# RENDER AND CHECK (this is what CI runs; no sound card involved)
#   FLOW_AUDIO_RENDER=build/audio/filter_sweep.wav \
#     ./flow audio examples/audio/filter_sweep.flow
#   The render is read back and asserted on. Exit code is 0 only if every
#   check passes.

import "stdlib/audio.flow"
import "stdlib/audio/oscillators.flow"
import "stdlib/audio/filters.flow"
import "stdlib/audio/safety.flow"
import "stdlib/audio/sink.flow"
import "stdlib/audio/verify.flow"

const RATE_HZ: i32 = 48000
const BLOCK: i32 = 256
const SECONDS: f32 = 6.0

# Cutoff endpoints of the sweep, in Hz.
const CUT_LO: f32 = 120.0
const CUT_HI: f32 = 6000.0

# Resonance. High enough to hear the filter singing, low enough that the
# limiter has almost nothing to do.
const RES_Q: f32 = 4.0

const NOTE_HZ: f32 = 110.0

# Coefficients are recomputed every 32 samples rather than every sample: the
# sweep moves at 0.33 Hz, so 0.67 ms of staleness is inaudible and it saves
# 97% of the trig.
const COEFF_EVERY: i32 = 32

function main() -> i32 {
    println("filter sweep")
    println("  6.0 seconds, 110 Hz sawtooth")
    println("  resonant lowpass, cutoff 120 Hz -> 6 kHz -> 120 Hz, Q 4.0")
    println("  the note stays put; the brightness moves")

    let rate: SampleRate = sample_rate_48000()
    let mut out: AudioSink = sink_open(RATE_HZ, 2, BLOCK)
    let sp: ptr<AudioSink> = &out
    let mut chain: SafetyChain = safety_new(rate, SECONDS)
    let cp: ptr<SafetyChain> = &chain
    let buf: AudioBufferF32 = audio_buffer_alloc_f32(BLOCK, 2, layout_interleaved())

    let mut osc: Phasor = phasor_new(NOTE_HZ as f64, rate)
    let mut lp: Biquad = biquad_lowpass(CUT_LO, RES_Q, rate)
    let total: f32 = safety_total_frames(cp) as f32
    let mut n_done: i64 = 0
    let mut coeff_ctr: i32 = 0

    while !safety_finished(cp) {
        let n: i32 = safety_next_block(cp, BLOCK)
        let mut i: i32 = 0
        while i < n {
            if coeff_ctr == 0 {
                # Triangle 0 -> 1 -> 0 over the render, exponential in Hz so
                # the sweep sounds even rather than crawling at the bottom.
                let t: f32 = (n_done as f32) / total
                let mut up: f32 = t * 2.0
                if up > 1.0 {
                    up = 2.0 - up
                }
                let cut: f32 = CUT_LO * powf(CUT_HI / CUT_LO, up)
                lp = biquad_set_cutoff(lp, cut, RES_Q, rate)
            }
            coeff_ctr = coeff_ctr + 1
            if coeff_ctr >= COEFF_EVERY {
                coeff_ctr = 0
            }

            let raw: f32 = saw(phasor_value(osc)) * 0.25
            osc = phasor_tick(osc)
            lp = biquad_tick(lp, raw)
            let s: f32 = biquad_output(lp)

            let fr: Frame = safety_process_frame(cp, s, s)
            audio_buffer_set_f32(buf, i, 0, fr.left)
            audio_buffer_set_f32(buf, i, 1, fr.right)
            n_done = n_done + 1
            i = i + 1
        }
        sink_write(sp, buf.data, n)
    }

    sink_close(sp)
    audio_buffer_free_f32(buf)
    safety_report(cp)

    if sink_is_render() {
        let spec: VerifySpec = verify_spec(SECONDS as f64, safety_ceiling_db(cp),
                                           NOTE_HZ as f64)
        if !verify_run(sink_render_path(), spec) {
            return 1
        }
    }
    return 0
}
