# A delay, and the guard that will not let you set its feedback to 1.05.
#
# WHAT YOU WILL HEAR
#   Ten seconds. Three short 440 Hz blips, each echoing away into a 375 ms
#   delay. Before any of it plays, the program tries three feedback
#   coefficients and prints what the guard does with each.
#
# WHY THE GUARD EXISTS
#   A delay whose output is fed back into its input multiplies the signal by
#   the feedback coefficient once per round trip. Below 1 that is a decaying
#   echo. At exactly 1 it never decays. Above 1 it grows without bound, and
#   at 1.05 with a 375 ms delay it is 20 dB louder every three seconds. On
#   headphones that is not a bug report, it is an injury.
#
#   So `feedback_guard` refuses any magnitude at or above 1 outright and
#   returns zero. There is no sensible thing to substitute for "make this
#   louder forever". Between 0.98 and 1 it clamps and says so, because the
#   tail would outlast the watchdog.
#
#   The right way to ask for a tail is in seconds, not in a number between
#   0 and 1 that you guessed: `rt60_to_feedback(seconds, delay_seconds)`
#   returns the coefficient that decays by 60 dB in the time you named.
#
# LISTEN
#   ./flow audio examples/audio/delay_feedback_guard.flow
#
# RENDER AND CHECK
#   FLOW_AUDIO_RENDER=build/audio/delay_feedback_guard.wav \
#     ./flow audio examples/audio/delay_feedback_guard.flow

import "stdlib/audio.flow"
import "stdlib/audio/oscillators.flow"
import "stdlib/audio/envelopes.flow"
import "stdlib/audio/delay_line.flow"
import "stdlib/audio/safety.flow"
import "stdlib/audio/sink.flow"
import "stdlib/audio/verify.flow"

const RATE_HZ: i32 = 48000
const BLOCK: i32 = 256
const SECONDS: f32 = 10.0

const DELAY_MS: f32 = 375.0
const TAIL_SECONDS: f32 = 3.0

const BLIP_HZ: f32 = 440.0
const BLIP_STEP: i32 = 120000         # 2.5 s at 48 kHz
const BLIP_COUNT: i32 = 3

function main() -> i32 {
    let rate: SampleRate = sample_rate_48000()
    let delay_s: f32 = DELAY_MS / 1000.0

    println("delay and the feedback guard")
    println("")
    println("  asking for feedback 1.05:")
    let refused: f32 = feedback_guard(1.05)
    printf("    guard returned %.4f\n", refused as f64)
    println("")
    println("  asking for feedback 0.995:")
    let clamped: f32 = feedback_guard(0.995)
    printf("    guard returned %.4f\n", clamped as f64)
    println("")
    printf("  asking for a %.1f s tail on a %.0f ms delay:\n",
           TAIL_SECONDS as f64, DELAY_MS as f64)
    let fb: f32 = rt60_to_feedback(TAIL_SECONDS, delay_s)
    printf("    rt60_to_feedback returned %.4f\n", fb as f64)
    printf("    feedback_to_rt60 turns that back into %.2f s\n",
           feedback_to_rt60(fb, delay_s) as f64)
    println("")
    println("  now playing")
    println("    10.0 seconds, three 440 Hz blips at 0.0 s, 2.5 s and 5.0 s")
    printf("    each echoes into a %.0f ms delay with feedback %.4f\n",
           DELAY_MS as f64, fb as f64)

    let mut out: AudioSink = sink_open(RATE_HZ, 2, BLOCK)
    let sp: ptr<AudioSink> = &out
    let mut chain: SafetyChain = safety_new(rate, SECONDS)
    let cp: ptr<SafetyChain> = &chain
    let buf: AudioBufferF32 = audio_buffer_alloc_f32(BLOCK, 2, layout_interleaved())

    let mut osc: Phasor = phasor_new(BLIP_HZ as f64, rate)
    let mut blip_env: AR = ar_new(seconds_new(0.004), seconds_new(0.160), rate)

    # Two delay lines, slightly different lengths, so the echoes drift apart
    # across the stereo field instead of sitting on top of each other.
    let mut dl_l: DelayLineF32 = delay_line_new(600.0, rate)
    dl_l = delay_line_set_time(dl_l, DELAY_MS, rate)
    dl_l = delay_line_set_feedback(dl_l, fb)
    dl_l = delay_line_set_mix(dl_l, 0.62)

    let mut dl_r: DelayLineF32 = delay_line_new(600.0, rate)
    dl_r = delay_line_set_time(dl_r, DELAY_MS * 1.5, rate)
    dl_r = delay_line_set_feedback(dl_r, fb)
    dl_r = delay_line_set_mix(dl_r, 0.62)

    let mut n: i32 = 0
    let mut blip: i32 = -1

    while !safety_finished(cp) {
        let count: i32 = safety_next_block(cp, BLOCK)
        let mut i: i32 = 0
        while i < count {
            let slot: i32 = n / BLIP_STEP
            if slot != blip and slot < BLIP_COUNT {
                blip = slot
                blip_env = ar_trigger(blip_env)
                osc = phasor_reset(osc)
            }
            blip_env = ar_tick(blip_env)
            let dry: f32 = sine(phasor_value(osc)) * ar_value(blip_env) * 0.55
            osc = phasor_tick(osc)

            dl_l = delay_line_tick(dl_l, dry)
            dl_r = delay_line_tick(dl_r, dry)

            let fr: Frame = safety_process_frame(cp, delay_line_output(dl_l),
                                                 delay_line_output(dl_r))
            audio_buffer_set_f32(buf, i, 0, fr.left)
            audio_buffer_set_f32(buf, i, 1, fr.right)
            n = n + 1
            i = i + 1
        }
        sink_write(sp, buf.data, count)
    }

    sink_close(sp)
    audio_buffer_free_f32(buf)
    safety_report(cp)

    if sink_is_render() {
        let spec: VerifySpec = verify_spec(SECONDS as f64, safety_ceiling_db(cp),
                                           BLIP_HZ as f64)
        if !verify_run(sink_render_path(), spec) {
            return 1
        }
    }
    return 0
}
