# Audio Synthesizer Demo
#
# Demonstrates Flow's audio library with a simple subtractive synth.
# This example shows:
#   - Oscillator usage (Phasor + waveshaping)
#   - Filter design (Biquad lowpass)
#   - Envelope generation (ADSR)
#   - Immutable state pattern
#
# Run: ./flow run examples/audio_synth_demo.flow

import "stdlib/audio.flow"
import "stdlib/audio/oscillators.flow"
import "stdlib/audio/filters.flow"
import "stdlib/audio/envelopes.flow"

# =============================================================================
# Synth Voice State
# =============================================================================

# A single synth voice with oscillator, filter, and envelope
struct SynthVoice {
    osc: Phasor
    filter: Biquad
    amp_env: ADSR
    filter_env: ADSR
    base_cutoff: f32
    filter_env_amount: f32
}

# Create a new synth voice
function synth_voice_new(freq: f64, rate: SampleRate) -> SynthVoice {
    let osc: Phasor = phasor_new(freq, rate)
    let filter: Biquad = biquad_lowpass(2000.0, 0.707, rate)
    
    # Amp envelope: fast attack, medium decay, sustain at 0.7, medium release
    let amp_env: ADSR = adsr_new_ms(5.0, 100.0, 0.7, 200.0, rate)
    
    # Filter envelope: slightly slower attack, longer decay
    let filter_env: ADSR = adsr_new_ms(10.0, 300.0, 0.3, 200.0, rate)
    
    return SynthVoice {
        osc: osc,
        filter: filter,
        amp_env: amp_env,
        filter_env: filter_env,
        base_cutoff: 500.0,
        filter_env_amount: 3000.0
    }
}

# Trigger the voice (note on)
function synth_voice_note_on(v: SynthVoice) -> SynthVoice {
    let amp: ADSR = adsr_gate_on(v.amp_env)
    let filt: ADSR = adsr_gate_on(v.filter_env)
    return SynthVoice {
        osc: v.osc,
        filter: v.filter,
        amp_env: amp,
        filter_env: filt,
        base_cutoff: v.base_cutoff,
        filter_env_amount: v.filter_env_amount
    }
}

# Release the voice (note off)
function synth_voice_note_off(v: SynthVoice) -> SynthVoice {
    let amp: ADSR = adsr_gate_off(v.amp_env)
    let filt: ADSR = adsr_gate_off(v.filter_env)
    return SynthVoice {
        osc: v.osc,
        filter: v.filter,
        amp_env: amp,
        filter_env: filt,
        base_cutoff: v.base_cutoff,
        filter_env_amount: v.filter_env_amount
    }
}

# Process one sample
function synth_voice_tick(v: SynthVoice, rate: SampleRate) -> SynthVoice {
    # Advance oscillator
    let new_osc: Phasor = phasor_tick(v.osc)
    
    # Advance envelopes
    let new_amp_env: ADSR = adsr_tick(v.amp_env)
    let new_filter_env: ADSR = adsr_tick(v.filter_env)
    
    # Calculate filter cutoff from envelope
    let filter_env_val: f32 = adsr_value(new_filter_env)
    let cutoff: f32 = v.base_cutoff + filter_env_val * v.filter_env_amount
    
    # Update filter coefficients
    let new_filter: Biquad = biquad_set_cutoff(v.filter, cutoff, 2.0, rate)
    
    return SynthVoice {
        osc: new_osc,
        filter: new_filter,
        amp_env: new_amp_env,
        filter_env: new_filter_env,
        base_cutoff: v.base_cutoff,
        filter_env_amount: v.filter_env_amount
    }
}

# Get current sample output
function synth_voice_output(v: SynthVoice) -> f32 {
    # Get oscillator phase
    let phase: f64 = phasor_value(v.osc)
    
    # Generate saw wave
    let raw: f32 = saw(phase)
    
    # Apply filter
    let filtered: f32 = biquad_process(v.filter, raw)
    
    # Apply amplitude envelope
    let amp: f32 = adsr_value(v.amp_env)
    
    return filtered * amp
}

# Check if voice is still sounding
function synth_voice_is_active(v: SynthVoice) -> bool {
    return adsr_is_active(v.amp_env)
}

# =============================================================================
# Main Demo
# =============================================================================

function main() -> i32 {
    printf("=== Flow Audio Synth Demo ===\n\n")
    
    # Set up at 44.1kHz
    let rate: SampleRate = sample_rate_44100()
    printf("Sample rate: %.0f Hz\n", rate.hz)
    
    # Create a voice at 440Hz (A4)
    let freq: f64 = 440.0
    printf("Creating synth voice at %.1f Hz\n", freq)
    let voice: SynthVoice = synth_voice_new(freq, rate)
    
    # Trigger note
    printf("Note on!\n")
    voice = synth_voice_note_on(voice)
    
    # Simulate 100 samples of attack/sustain
    printf("\nProcessing 100 samples (attack phase):\n")
    let i: i32 = 0
    while i < 100 {
        voice = synth_voice_tick(voice, rate)
        let sample: f32 = synth_voice_output(voice)
        
        # Print every 20 samples
        if i % 20 == 0 {
            let amp: f32 = adsr_value(voice.amp_env)
            let filt_env: f32 = adsr_value(voice.filter_env)
            printf("  Sample %d: output=%.4f, amp_env=%.3f, filter_env=%.3f\n", 
                   i, sample, amp, filt_env)
        }
        i = i + 1
    }
    
    # Release note
    printf("\nNote off!\n")
    voice = synth_voice_note_off(voice)
    
    # Simulate 100 samples of release
    printf("\nProcessing 100 samples (release phase):\n")
    i = 0
    while i < 100 {
        voice = synth_voice_tick(voice, rate)
        let sample: f32 = synth_voice_output(voice)
        
        # Print every 20 samples
        if i % 20 == 0 {
            let amp: f32 = adsr_value(voice.amp_env)
            printf("  Sample %d: output=%.4f, amp_env=%.3f\n", i, sample, amp)
        }
        i = i + 1
    }
    
    # Check if voice is done
    let active: bool = synth_voice_is_active(voice)
    if active {
        printf("\nVoice still active: yes\n")
    } else {
        printf("\nVoice still active: no\n")
    }
    
    printf("\n=== Demo Complete ===\n")
    printf("\nThis demonstrates:\n")
    printf("  - Phasor-based oscillator with saw wave\n")
    printf("  - Biquad lowpass filter with envelope modulation\n")
    printf("  - ADSR envelope for amplitude and filter\n")
    printf("  - Immutable state pattern (tick returns new state)\n")
    
    return 0
}
