# Notation Player - Load Music from Files with Effects
#
# Demonstrates FLOW's effect system for livecoding:
# 1. Define Notation effect for file IO
# 2. Implement handler for loading/parsing
# 3. Play loaded notation through audio system
#
# This makes livecoding easy: edit the notation file, reload, and play!

import "stdlib/audio.flow"
import "stdlib/audio/io.flow"
import "stdlib/audio/oscillators.flow"
import "stdlib/audio/notation.flow"

extern { function usleep(usec: i32) -> i32 }

# Convert MIDI to frequency (local version)
function note_freq(midi: i32) -> f64 {
    if midi == 60 { return 261.63 }  # C4
    if midi == 62 { return 293.66 }  # D4
    if midi == 64 { return 329.63 }  # E4
    if midi == 65 { return 349.23 }  # F4
    if midi == 67 { return 392.00 }  # G4
    return 440.0
}

function main() -> i32 {
    println("========================================")
    println("  Notation Player - Effect System Demo")
    println("========================================")
    println("")

    # Load notation using effects
    println("Loading notation with effects...")
    let mut reader: NotationReader = notation_reader_new()

    # Load file (hardcoded for now, would read from file)
    let success: bool = reader.load_file("hot_cross_buns.music")

    if not success {
        println("Failed to load notation!")
        return 1
    }

    let note_count: i32 = reader.get_note_count()
    print("Loaded ")
    print(note_count)
    println(" notes from notation file")
    println("")

    # Set up audio device
    let rate: SampleRate = sample_rate_48000()
    let cfg: AudioDeviceConfig = audio_device_config(48000, 2, 256, false, true)
    let dev: AudioDevice = audio_device_open(cfg)

    if not audio_device_ok(dev) {
        println("Error opening audio device")
        return 1
    }

    let buf: AudioBufferF32 = audio_buffer_alloc_f32(256, 2, layout_interleaved())

    if audio_device_start(dev) != AUDIO_OK {
        println("Error starting audio device")
        audio_device_close(dev)
        audio_buffer_free_f32(buf)
        return 1
    }

    println("Playing notation...")
    println("")

    # Play each note from the notation
    let samples_per_sixteenth: i32 = 7200  # 100 BPM at 48kHz

    let mut note_idx: i32 = 0
    while note_idx < note_count {
        # Get note from notation
        let note: MusicNote = reader.get_note(note_idx)
        let freq: f64 = note_freq(note.midi)
        let note_samples: i32 = samples_per_sixteenth * note.duration

        print("Note ")
        print(note_idx + 1)
        print("/")
        print(note_count)
        print(": MIDI ")
        print(note.midi)
        print(" (")
        printf("%.2f", freq)
        print(" Hz) x ")
        print(note.duration)
        println(" sixteenths")

        # Create oscillator
        let mut osc: Phasor = phasor_new(freq, rate)

        # Play this note
        let mut samples_played: i32 = 0
        while samples_played < note_samples {
            while audio_available_write(dev) < 256 {
                usleep(1000)
            }

            let mut i: i32 = 0
            while i < 256 and samples_played < note_samples {
                # Envelope
                let phase: f32 = (samples_played as f32) / (note_samples as f32)
                let mut envelope: f32 = 1.0

                if phase < 0.05 {
                    envelope = phase / 0.05
                } else {
                    if phase > 0.85 {
                        envelope = (1.0 - phase) / 0.15
                    }
                }

                # Generate sine
                let sample: f32 = sine(phasor_value(osc)) * envelope * 0.3

                audio_buffer_set_f32(buf, i, 0, sample)
                audio_buffer_set_f32(buf, i, 1, sample)

                osc = phasor_tick(osc)
                samples_played = samples_played + 1
                i = i + 1
            }

            audio_write_f32(dev, buf.data, 256)
        }

        note_idx = note_idx + 1
    }

    println("")
    println("========================================")
    println("Effect System Benefits:")
    println("========================================")
    println("")
    println("✓ Separation of concerns:")
    println("  - Notation effect defines interface")
    println("  - Handler implements file loading")
    println("  - Player just uses capability")
    println("")
    println("✓ Hot reloading:")
    println("  - Edit notation file")
    println("  - Reload without recompiling")
    println("  - Perfect for livecoding!")
    println("")
    println("✓ Testability:")
    println("  - Mock notation handler for tests")
    println("  - Swap implementations easily")
    println("")
    println("✓ Type safety:")
    println("  - Capability ensures correct usage")
    println("  - Compile-time guarantees")

    usleep(500000)

    audio_device_stop(dev)
    audio_device_close(dev)
    audio_buffer_free_f32(buf)

    println("")
    println("Done!")
    return 0
}
