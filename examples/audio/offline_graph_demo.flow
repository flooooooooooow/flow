# Offline graph demo (no audio device required)

import "stdlib/audio.flow"
import "stdlib/audio/graph_scheduler.flow"

function main() -> i32 {
    let rate: SampleRate = sample_rate_48000()
    let buf: AudioBufferF32 = audio_buffer_alloc_f32(8, 2, layout_interleaved())

    let i: i32 = 0
    while i < 8 {
        audio_buffer_set_f32(buf, i, 0, 1.0)
        audio_buffer_set_f32(buf, i, 1, 0.5)
        i = i + 1
    }

    let nodes: array<AudioNode, 32> = [
        audio_node_default(), audio_node_default(), audio_node_default(), audio_node_default(),
        audio_node_default(), audio_node_default(), audio_node_default(), audio_node_default(),
        audio_node_default(), audio_node_default(), audio_node_default(), audio_node_default(),
        audio_node_default(), audio_node_default(), audio_node_default(), audio_node_default(),
        audio_node_default(), audio_node_default(), audio_node_default(), audio_node_default(),
        audio_node_default(), audio_node_default(), audio_node_default(), audio_node_default(),
        audio_node_default(), audio_node_default(), audio_node_default(), audio_node_default(),
        audio_node_default(), audio_node_default(), audio_node_default(), audio_node_default()
    ]
    let g: AudioGraph = audio_graph_init(rate, nodes)
    let g1: AudioGraph = audio_graph_add_gain(g, -6.0)
    let g2: AudioGraph = audio_graph_add_lowpass(g1, 8000.0, 0.707)
    let g3: AudioGraph = audio_graph_add_pan(g2, 0.2)

    let g4: AudioGraph = audio_graph_process_interleaved(g3, buf, 8)
    let l0: f32 = audio_buffer_get_f32(buf, 0, 0)
    let r0: f32 = audio_buffer_get_f32(buf, 0, 1)

    printf("Offline demo: first frame L=%f R=%f\n", l0, r0)
    audio_buffer_free_f32(buf)
    return 0
}
