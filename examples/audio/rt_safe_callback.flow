# Minimal @rt_safe callback — stack locals + fixed-bound loops only.
# See docs/library/rt-safety.md and examples/audio/lattice_allpass_phase_engine.flow
#
#   ./flow run examples/audio/rt_safe_callback.flow
#
# Illegal (rejected under --strict @rt_safe checking):
#   extern { function malloc(size: i64) -> ptr<void> }
#   @rt_safe
#   function bad() -> void {
#       let p: ptr<void> = malloc(16)   # type error: heap from @rt_safe
#   }

extern {
    function i32_to_f32(v: i32) -> f32
}

@rt_safe
function process_sample(x: f32, gain: f32) -> f32 {
    return x * gain
}

@rt_safe
function process_block(n: i32, gain: f32) -> f32 {
    let mut acc: f32 = 0.0
    let mut i: i32 = 0
    while i < n {
        let s: f32 = 0.1 * i32_to_f32(i)
        acc = acc + process_sample(s, gain)
        i = i + 1
    }
    return acc
}

function main() -> i32 {
    let y: f32 = process_block(8, 0.5)
    print("rt_safe_callback acc=")
    println(y)
    return 0
}
