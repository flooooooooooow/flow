# Minimal @rt_safe callback — stack locals + fixed buffers only.
# See docs/library/rt-safety.md and examples/audio/lattice_allpass_phase_engine.flow
# Run: ./flow run examples/audio/rt_safe_callback.flow
#
# Illegal (would fail under --strict @rt_safe checking):
#   @rt_safe
#   function bad() -> void { let p = malloc(16) }

@rt_safe
function process_sample(x: f32, gain: f32) -> f32 {
    return x * gain
}

@rt_safe
function process_block(n: i32, gain: f32) -> f32 {
    let mut acc: f32 = 0.0
    let mut i: i32 = 0
    while i < n {
        let s: f32 = 0.1 * i32_to_f32(i)
        acc = acc + process_sample(s, gain)
        i = i + 1
    }
    return acc
}

function main() -> i32 {
    let y: f32 = process_block(8, 0.5)
    print("rt_safe_callback acc=")
    print(y)
    return 0
}
