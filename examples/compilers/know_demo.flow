# know + fingerprint dogfood

import "compiler/src/claim_address.flow"
import "compiler/src/claim_path.flow"
import "compiler/src/know.flow"

extern {
    function printf(fmt: string, s: string) -> i32
    function strcmp(a: string, b: string) -> i32
    function puts(s: string) -> i32
}

function main() -> i32 {
    let mut failed: i32 = 0

    let q: string = flowc_normalize_query("verify.Bool.disjunction.order_does_not_matter")
    if strcmp(q, "Bool.disjunction.order_does_not_matter") != 0 {
        printf("%s\n", "FAIL: normalize_query")
        failed = 1
    }

    let fp: string = flowc_claim_fingerprint("0 + n == n by plus")
    printf("fp: %s\n", fp)
    if strcmp(fp, "0+n=n") != 0 {
        printf("%s\n", "FAIL: fingerprint")
        failed = 1
    }

    let key: string = flowc_claim_fingerprint_key("Nat", "addition", fp)
    if strcmp(key, "Nat/addition#0+n=n") != 0 {
        printf("%s\n", "FAIL: fingerprint_key")
        failed = 1
    }

    let addr: FlowcClaimAddress = flowc_claim_make("Bool", "disjunction", "order does not matter")
    let slug: string = flowc_claim_slug(addr)
    if strcmp(slug, "Bool.disjunction.order_does_not_matter") != 0 {
        printf("%s\n", "FAIL: claim slug")
        failed = 1
    }

    let guillemets: string = flowc_claim_guillemets(addr)
    printf("guillemets: %s\n", guillemets)
    if strcmp(guillemets, "«Bool» «disjunction» «order does not matter»") != 0 {
        printf("%s\n", "FAIL: guillemets")
        failed = 1
    }

    let display: string = flowc_claim_display(addr)
    printf("display: %s\n", display)

    let qualified: string = flowc_qualify("compiler/src/Bool.flow", slug)
    printf("qualified: %s\n", qualified)

    let prefix: string = flowc_package_prefix("compiler/src/Bool.flow")
    printf("prefix: %s\n", prefix)
    if strcmp(prefix, "flow") != 0 {
        printf("%s\n", "FAIL: package prefix")
        failed = 1
    }

    if failed == 1 {
        return 1
    }
    printf("%s\n", "know+fingerprint: PASS")
    return 0
}
