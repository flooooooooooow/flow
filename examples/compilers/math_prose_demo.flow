# math_prose + proof_sub dogfood demo
# flow:lenient: strict checker gap, string vs byte-buffer coercions (ptr<u8>, array<u8, N>). Board card flow-strict-string-buffer-coercions.

import "compiler/src/claim_address.flow"
import "compiler/src/claim_path.flow"
import "compiler/src/math_prose.flow"
import "compiler/src/proof_sub.flow"

extern {
    function printf(fmt: string, s: string) -> i32
    function strcmp(a: string, b: string) -> i32
}

function main() -> i32 {
    let mut failed: i32 = 0

    let car: string = flowc_carrier_mathematical("Nat")
    if strcmp(car, "the natural numbers") != 0 {
        printf("%s\n", "FAIL: carrier")
        failed = 1
    }

    let addr: FlowcClaimAddress = flowc_claim_parse("Nat/+.zero-left")
    let prose: string = flowc_addr_prose(addr)
    printf("prose: %s\n", prose)
    if strcmp(prose, "zero is the left identity, for addition on the natural numbers") != 0 {
        printf("%s\n", "FAIL: addr_prose")
        failed = 1
    }

    let open: string = flowc_tier_opening_mathematical("definition", addr)
    printf("tier: %s\n", open)
    if strcmp(open, "We stipulate zero is the left identity for addition on the natural numbers — this is a definition, not a derived fact.") != 0 {
        printf("%s\n", "FAIL: tier_opening")
        failed = 1
    }

    let one: string = flowc_instantiate_one("Nat/+.zero-left", "n")
    printf("inst1: %s\n", one)
    if strcmp(one, "0 + n == n") != 0 {
        printf("%s\n", "FAIL: instantiate_one")
        failed = 1
    }

    let two: string = flowc_instantiate_two("«Nat» «addition» «order does not matter»", "m", "n")
    printf("inst2: %s\n", two)
    if strcmp(two, "m + n == n + m") != 0 {
        printf("%s\n", "FAIL: instantiate_two")
        failed = 1
    }

    if failed == 1 {
        return 1
    }
    printf("%s\n", "math_prose+proof_sub: PASS")
    return 0
}
