# Rosetta Code task: Sieve of Eratosthenes
# Print every prime up to 50 using the classic sieve.

extern {
    function printf(fmt: string, val: i32) -> i32
}

function main() -> i32 {
    let mut is_composite: array<bool, 51> = [false; 51]
    let mut i: i32 = 2
    while i * i <= 50 {
        if is_composite[i] == false {
            let mut j: i32 = i * i
            while j <= 50 {
                is_composite[j] = true
                j = j + i
            }
        }
        i = i + 1
    }
    let mut n: i32 = 2
    while n <= 50 {
        if is_composite[n] == false {
            printf("%d ", n)
        }
        n = n + 1
    }
    println("")
    return 0
}
