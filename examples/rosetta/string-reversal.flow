# Rosetta Code task: Reverse a string
# Print a string with its characters in reverse order.

extern {
    function putchar(c: i32) -> i32
    function strlen(s: string) -> i64
}

function reverse(s: string) {
    let mut i: i32 = strlen(s) as i32 - 1
    while i >= 0 {
        putchar(s[i] as i32)
        i = i - 1
    }
    putchar(10)
}

function main() -> i32 {
    reverse("Rosetta Code")
    reverse("Flow language")
    return 0
}
