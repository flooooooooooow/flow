# XOR MLP via grad codegen (pattern-adoption #170).
# No hand-written dense_backward — gradients come from
# scripts/tools/grad/flow_grad_flow.py → nn_xor_loss_clean_grad.flow
# wrapped by lib/stdlib/nn_autogen.flow.
#
# Hand backprop walkthrough:
#   examples/ml/models/mlp_xor_from_scratch.flow
#
# Architecture: 2 → 2 (sigmoid) → 1 (sigmoid). Tourist path for AD honesty.
#
# Run: ./flow run examples/ml/models/mlp_xor.flow

import "lib/stdlib/nn.flow"
import "lib/stdlib/nn_autogen.flow"

extern {
    function printf(fmt: string, val: f32) -> i32
}

function main() -> i32 {
    println("XOR Neural Network (grad codegen)")
    println("=================================")
    println("Architecture: 2 -> 2 (sigmoid) -> 1 (sigmoid)")
    println("Grads: net2x2x1_grads_xor_autogen (flow_grad_flow.py)")
    println("")

    let mut net: Net2x2x1 = Net2x2x1 {
        w00: 0.5, w01: 0.9,
        w10: 0.4, w11: 1.0,
        b0: -0.8, b1: -0.1,
        v0: -1.2, v1: 1.1,
        c: -0.3
    }

    print("Before loss = ")
    printf("%.4f", net2x2x1_loss_xor(net))
    println("")

    let lr: f32 = 2.0
    let epochs: i32 = 500
    for epoch in 0 to epochs {
        let g: Grads2x2x1 = net2x2x1_grads_xor_autogen(net)
        net = net2x2x1_step(net, g, lr)
        if epoch % 100 == 0 {
            print("  epoch ")
            print(epoch)
            print(": loss = ")
            printf("%.4f", net2x2x1_loss_xor(net))
            println("")
        }
    }

    println("")
    println("After:")
    print("  0^0 = ")
    printf("%.3f", net2x2x1_predict(net, 0.0, 0.0))
    println(" (want ~0)")
    print("  0^1 = ")
    printf("%.3f", net2x2x1_predict(net, 0.0, 1.0))
    println(" (want ~1)")
    print("  1^0 = ")
    printf("%.3f", net2x2x1_predict(net, 1.0, 0.0))
    println(" (want ~1)")
    print("  1^1 = ")
    printf("%.3f", net2x2x1_predict(net, 1.0, 1.0))
    println(" (want ~0)")
    print("  loss = ")
    printf("%.4f", net2x2x1_loss_xor(net))
    println("")

    let final_loss: f32 = net2x2x1_loss_xor(net)
    if final_loss > 0.15 {
        println("FAIL: loss did not converge")
        return 1
    }
    println("OK: trained without hand dense_backward")
    return 0
}
