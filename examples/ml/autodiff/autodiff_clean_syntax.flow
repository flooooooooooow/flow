# Clean autodiff syntax — Dual operators (+ - * /) (#161).

import "stdlib/autodiff.flow"

# Rosenbrock function: f(x) = (1 - x)² + 100(x² - 1)²
function rosenbrock(x: Dual) -> Dual {
    let one_minus: Dual = 1.0 - x
    let term1: Dual = one_minus * one_minus
    let x2: Dual = x * x
    let term2: Dual = 100.0 * (x2 - 1.0) * (x2 - 1.0)
    return term1 + term2
}

# Logistic loss: L(w) = -[ y·log(σ(w)) + (1-y)·log(1-σ(w)) ]
function logistic_loss(w: Dual, y: f32) -> Dual {
    let p: Dual = sigmoid(w)
    let loss_pos: Dual = y * log(p)
    let loss_neg: Dual = (1.0 - y) * log(1.0 - p)
    return -(loss_pos + loss_neg)
}

# Quadratic with coefficients: f(x) = ax² + bx + c
function quadratic_auto(x: Dual, a: f32, b: f32, c: f32) -> Dual {
    return a * x * x + b * x + c
}

function main() -> i32 {
    printf("=== Clean Autodiff Syntax Demo (Dual operators) ===\n\n")
    
    let x1: Dual = dx(0.8)
    let f1: Dual = rosenbrock(x1)
    printf("Rosenbrock(0.8) = %f\n", f1.val)
    printf("dRosenbrock/dx  = %f\n\n", f1.grad)
    
    let w: Dual = dx(-0.4)
    let loss: Dual = logistic_loss(w, 1.0)
    printf("LogisticLoss(-0.4, 1) = %f\n", loss.val)
    printf("dLoss/dw              = %f\n\n", loss.grad)
    
    let x2: Dual = dx(2.0)
    let q: Dual = quadratic_auto(x2, 2.0, 3.0, 1.0)
    printf("Quadratic(2) = 2(4) + 3(2) + 1 = %f\n", q.val)
    printf("dQuadratic/dx = 4x + 3 = 4(2) + 3 = %f\n", q.grad)
    
    return 0
}
