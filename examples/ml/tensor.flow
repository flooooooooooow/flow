# Tensor demo — uses stdlib/tensor.flow
import "stdlib/tensor.flow"

function main() -> i32 {
    println("Tensor Library Demo (stdlib)")
    let a: Tensor = tensor_rand(2, 3, 1, 1, 42)
    let b: Tensor = tensor_ones(2, 3, 1, 1)
    let c: Tensor = tensor_matmul(tensor_rand(2, 3, 1, 1, 1), tensor_rand(3, 4, 1, 1, 2))
    tensor_print(c)
    tensor_free(a)
    tensor_free(b)
    tensor_free(c)
    return 0
}