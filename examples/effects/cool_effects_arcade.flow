# Cool effect + capability demo: toggleable logging

# Abstract effect

effect Log {
    emit(message: string) -> void,
    debug(message: string) -> void,
}

# Capabilities

capability ConsoleLogger {
    effect Log,
    function emit(message: string) -> void {
        return void
    },
    function debug(message: string) -> void {
        return void
    },
}

capability SilentLogger {
    effect Log,
    function emit(message: string) -> void {
        return void
    },
    function debug(message: string) -> void {
        return void
    },
}

# A tiny "arcade" simulation that uses effects instead of direct I/O

function tick(frame: i32, score: i32) -> i32 {
    Log.debug("tick")
    if frame == 5 {
        Log.emit("BONUS!")
    }
    return score + frame
}

function run_game(n: i32) -> i32 {
    Log.emit("Starting game")
    let score: i32 = 0
    for i in 0..n {
        score = tick(i, score)
    }
    Log.emit("Game finished")
    return score
}

function main() -> i32 {
    # Loud mode
    handle Log with ConsoleLogger {
        Log.emit("=== LOUD MODE ===")
        let s1: i32 = run_game(10)
        print("Final score:")
        print(s1)
    }

    # Silent mode
    handle Log with SilentLogger {
        let s2: i32 = run_game(10)
        print("Silent score:")
        print(s2)
    }

    return 0
}
