# Effect-based capability dispatch example

effect Log {
    emit(message: string) -> void,
}

capability ConsoleLogger {
    effect Log,
    function emit(message: string) -> void {
        # Print to console
        # In a real implementation, this would call a system function
        return void
    }
}

function process_data(data: i32) -> i32 {
    Log.emit("Processing data...")
    let result: i32 = data * 2
    Log.emit("Processing complete")
    return result
}

function main() -> i32 {
    handle Log with ConsoleLogger {
        let result: i32 = process_data(21)
        return result
    }
}
