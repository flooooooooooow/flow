# Async / Timeout / Retry as Policy Effects
#
# Prefer examples/effects/async_primitives.flow for the stdlib `Async` /
# `AsyncIO` handle/with path -- this file focuses on Timeout and Retry,
# which async_primitives.flow does not cover.
#
# NOTE: this file previously used the older `capability Async` /
# `capability Timeout` / `capability Retry` *parameter* style, passing a
# stateful struct (e.g. `timeout: capability Timeout`) into business
# functions and calling mutating methods on it. That never worked: every
# `Effect.op(...)` call compiles to a dispatch through the effect's global
# current-handler pointer, not through whatever was passed as an argument,
# and this file never installed a handler with `handle ... with ...` -- so
# every call silently fell back to its zeroed default (see
# docs/effects-showcase.md, "Honest limitations"). This version follows the
# same fix as `examples/effects/state_effects.flow`: capabilities stay
# stateless pure policy functions, and the real mutable state (elapsed
# time, attempt counters) lives in ordinary `let mut` locals in the caller,
# threaded through handle/with.
#
# Unlike Mojo/Julia which need async/await syntax, Flow uses effects.

# ============================================================================
# ASYNC EFFECT: business logic depends only on the effect, no handler param
# ============================================================================

effect Async {
    delay(ms: i32) -> void,
    spawn(task_id: i32) -> void,
    join(task_id: i32) -> i32,
}

function fetch_user_data(user_id: i32) -> i32 {
    print("  Fetching user ")
    println(user_id)
    Async.delay(100)  # Simulate network delay
    return user_id * 10  # Simulated data
}

function fetch_orders(user_id: i32) -> i32 {
    print("  Fetching orders for user ")
    println(user_id)
    Async.delay(150)
    return user_id * 5  # Number of orders
}

function process_user(user_id: i32) -> i32 {
    let data: i32 = fetch_user_data(user_id)
    let orders: i32 = fetch_orders(user_id)
    return data + orders
}

# Parallel fetch simulation
function fetch_all_users(num_users: i32) -> i32 {
    let mut total: i32 = 0

    # Spawn tasks
    for i in 0 to num_users {
        Async.spawn(i)
    }

    # Await results
    for i in 0 to num_users {
        let result: i32 = Async.join(i)
        total = total + result
    }

    return total
}

# Stateless sync stand-in (same shape as lib/stdlib/async.flow's
# SimulatedAsync): delay/spawn are no-ops (virtual time), join(task_id)
# returns a deterministic stand-in result.
capability SyncAsync {
    effect Async,

    function delay(ms: i32) -> void {
        return
    },

    function spawn(task_id: i32) -> void {
        return
    },

    function join(task_id: i32) -> i32 {
        return task_id * 10
    },
}

# ============================================================================
# TIMEOUT EFFECT: pure policy over an explicit elapsed/deadline pair
# ============================================================================

effect Timeout {
    has_expired(elapsed_ms: i32, deadline_ms: i32) -> i32,
}

function with_timeout(work: i32, deadline_ms: i32) -> i32 {
    let mut result: i32 = 0
    let mut elapsed: i32 = 0
    for i in 0 to work {
        elapsed = elapsed + 100  # Simulate time passing
        if Timeout.has_expired(elapsed, deadline_ms) == 1 {
            println("  Timeout!")
            return -1
        }
        result = result + i
    }
    return result
}

capability SimpleTimeout {
    effect Timeout,

    function has_expired(elapsed_ms: i32, deadline_ms: i32) -> i32 {
        if elapsed_ms >= deadline_ms {
            return 1
        }
        return 0
    },
}

# ============================================================================
# RETRY EFFECT: pure policy over an explicit attempt/max pair
# ============================================================================

effect Retry {
    should_retry(attempt: i32, max_attempts: i32) -> i32,
}

function unreliable_operation(max_attempts: i32) -> i32 {
    let mut attempts: i32 = 0
    let mut success: i32 = 0

    while success == 0 {
        attempts = attempts + 1

        # Simulate: succeed on 3rd attempt
        if attempts >= 3 {
            success = 1
        } else {
            print("  Attempt ")
            print(attempts)
            println(" failed")

            if Retry.should_retry(attempts, max_attempts) == 0 {
                return -1  # Give up
            }
        }
    }

    print("  Success on attempt ")
    println(attempts)
    return 1
}

capability LinearRetry {
    effect Retry,

    function should_retry(attempt: i32, max_attempts: i32) -> i32 {
        if attempt < max_attempts {
            return 1
        }
        return 0
    },
}

# ============================================================================
# DEMO
# ============================================================================

function main() -> i32 {
    println("Async Effects Demo")
    println("==================")
    println("")

    # Async demo
    println("=== Async Effect (sync simulation) ===")
    let mut result: i32 = 0
    let mut batch: i32 = 0
    handle Async with SyncAsync {
        result = process_user(1)
        batch = fetch_all_users(3)
    }
    print("Process user result: ")
    println(result)
    print("Fetch all users (3) result: ")
    println(batch)

    println("")

    # Timeout demo
    println("=== Timeout Effect ===")
    let mut work_result: i32 = 0
    let mut timeout_result: i32 = 0
    handle Timeout with SimpleTimeout {
        work_result = with_timeout(5, 1000)
        timeout_result = with_timeout(100, 1000)
    }
    print("Work result (small): ")
    println(work_result)
    print("Work result (large, may timeout): ")
    println(timeout_result)

    println("")

    # Retry demo
    println("=== Retry Effect ===")
    let mut retry_result: i32 = 0
    handle Retry with LinearRetry {
        retry_result = unreliable_operation(5)
    }
    print("Operation result: ")
    println(retry_result)

    println("")
    println("Key insight: Async patterns are just effects!")
    println("No special syntax needed - effects are composable.")

    return 0
}
