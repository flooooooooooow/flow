# Working Effects Example
# This demonstrates FLOW's effect system with actual C code generation

# Define a Log effect - abstract operations for logging
effect Log {
    emit(message: string) -> void,
    level(lvl: i32) -> void,
}

# ConsoleLogger capability - implements Log by printing to console
capability ConsoleLogger {
    effect Log,
    
    function emit(message: string) -> void {
        printf("%s\n", message)
        return void
    },
    
    function level(lvl: i32) -> void {
        printf("Log level: %d\n", lvl)
        return void
    },
}

# SilentLogger capability - implements Log by doing nothing
capability SilentLogger {
    effect Log,
    
    function emit(message: string) -> void {
        # Do nothing - silent mode
        return void
    },
    
    function level(lvl: i32) -> void {
        # Do nothing - silent mode
        return void
    },
}

# A function that uses the Log effect abstractly
function do_work(x: i32) -> i32 {
    Log::emit("Starting work...")
    let result: i32 = x * 2
    Log::emit("Work complete!")
    return result
}

# Another function that uses Log for debugging
function process(n: i32) -> i32 {
    Log::level(1)
    let sum: i32 = 0
    let i: i32 = 0
    while i < n {
        sum = sum + i
        i = i + 1
    }
    Log::emit("Processing done")
    return sum
}

function main() -> i32 {
    # Test 1: Use ConsoleLogger - should print messages
    printf("=== Test with ConsoleLogger ===\n")
    handle Log with ConsoleLogger {
        let r1: i32 = do_work(21)
        printf("Result: %d\n", r1)
    }
    
    # Test 2: Use SilentLogger - should be quiet
    printf("\n=== Test with SilentLogger ===\n")
    handle Log with SilentLogger {
        let r2: i32 = do_work(10)
        printf("Result: %d\n", r2)
    }
    
    # Test 3: Nested effects
    printf("\n=== Test nested handles ===\n")
    handle Log with ConsoleLogger {
        Log::emit("Outer scope")
        handle Log with SilentLogger {
            Log::emit("This should be silent")
        }
        Log::emit("Back to outer scope")
    }
    
    return 0
}

