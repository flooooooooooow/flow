# Effect-row Phase 2: declare effects on the signature with `with E`.
# Stable checking requires callers to handle (or re-declare) those effects.
#
# Legacy zero defaults require an explicit compiler opt-out:
#   ./flow run examples/effects/effect_rows.flow
#   FLOWC_PERMISSIVE_EFFECTS=1 ./flow transpile examples/effects/effect_rows.flow --c -o /tmp/er.c

effect Log {
    info(msg: string) -> void,
}

capability Console {
    effect Log,
    function info(msg: string) -> void {
        printf("%s\n", msg)
    },
}

# Declares that this function may perform Log; body needs no local handle.
function greet(name: string) -> void with Log {
    Log.info("hello")
    Log.info(name)
}

function shout() -> void with Log {
    greet("world")
    Log.info("!")
}

function main() -> i32 {
    handle Log with Console {
        shout()
    }
    return 0
}
