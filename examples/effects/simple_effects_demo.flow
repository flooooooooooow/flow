# Simplified Effect-Based Capability Dispatch Example

effect Log {
    emit(message: string) -> void,
}

capability ConsoleLogger {
    effect Log,
    function emit(message: string) -> void {
        return void
    },
}

function process_data(data: string) -> string {
    Log.emit("Processing data...")
    return data + " (processed)"
}

function main() -> i32 {
    handle Log with ConsoleLogger {
        let result: string = process_data("test")
    }
    
    return 0
}
