# Simple GPU FFT Demonstration
# This demonstrates FLOW's effect-based programming for HPC

effect GPU {
    allocate(size: i32) -> i64,
    free(buffer: i64) -> void,
    copy_to_device(data: array_f32, buffer: i64) -> void,
    copy_from_device(buffer: i64, data: array_f32) -> void,
}

effect FFT {
    fft_forward(input: i64, output: i64, size: i32) -> void,
    fft_inverse(input: i64, output: i64, size: i32) -> void,
}

capability CUDAGPU {
    effect GPU,
    effect FFT,
    
    function allocate(size: i32) -> i64 {
        return cuda_malloc(size * 4)
    },
    
    function free(buffer: i64) -> void {
        cuda_free(buffer)
    },
    
    function copy_to_device(data: array_f32, buffer: i64) -> void {
        cudaMemcpy_host_to_device(data, buffer)
    },
    
    function copy_from_device(buffer: i64, data: array_f32) -> void {
        cudaMemcpy_device_to_host(buffer, data)
    },
    
    function fft_forward(input: i64, output: i64, size: i32) -> void {
        cufft_execute(input, output, size, FORWARD)
    },
    
    function fft_inverse(input: i64, output: i64, size: i32) -> void {
        cufft_execute(input, output, size, INVERSE)
    },
}

function simple_fft(data: array_f32) -> array_f32 {
    handle GPU, FFT with CUDAGPU {
        let size: i32 = 4
        let input: i64 = allocate(size)
        let output: i64 = allocate(size)
        
        copy_to_device(data, input)
        fft_forward(input, output, size)
        
        let result: array_f32 = [0.0, 0.0, 0.0, 0.0]
        copy_from_device(output, result)
        
        free(input)
        free(output)
        
        return result
    }
}

function main() -> i32 {
    let test_data: array_f32 = [1.0, 2.0, 3.0, 4.0]
    let spectrum: array_f32 = simple_fft(test_data)
    
    print("FFT computation complete")
    return 0
}
