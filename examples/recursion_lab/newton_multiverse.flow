# NEWTON MULTIVERSE
# A native Flow recursive solver over the complex plane for z^3 - 1.
# Each pixel recursively follows Newton basins; the unstable boundary is fractal.
# Emits a binary PPM image; no rasterization engine or Python is involved.
extern {
    function printf(fmt: string, ...) -> i32
    function putchar(c: i32) -> i32
    function sqrt(x: f64) -> f64
    function sin(x: f64) -> f64
    function cos(x: f64) -> f64
}

struct Orbit {
    x: f64,
    y: f64,
    iteration: i32,
    root: i32,
    trap: f64
}

function find_root(x: f64, y: f64) -> i32 {
    let u: f64 = x - 1.0
    let v: f64 = x + 0.5
    let d0: f64 = u*u + y*y
    let d1: f64 = v*v + (y - 0.8660254037844386)*(y - 0.8660254037844386)
    let d2: f64 = v*v + (y + 0.8660254037844386)*(y + 0.8660254037844386)
    if d0 <= d1 and d0 <= d2 { return 0 }
    if d1 <= d2 { return 1 }
    return 2
}

function solve(x: f64, y: f64, iteration: i32, trap: f64) -> Orbit {
    let x2: f64 = x*x - y*y
    let y2: f64 = 2.0*x*y
    let x3: f64 = x2*x - y2*y
    let y3: f64 = x2*y + y2*x
    let dx: f64 = x3 - 1.0
    let err: f64 = dx*dx + y3*y3
    let radial: f64 = x*x + y*y
    let mut nearest: f64 = trap
    let orbit_ring: f64 = (radial - 0.73)*(radial - 0.73)
    if orbit_ring < nearest { nearest = orbit_ring }
    if err < 0.0000000001 or iteration >= 29 {
        return Orbit { x: x, y: y, iteration: iteration, root: find_root(x,y), trap: nearest }
    }
    let a: f64 = 3.0*x2
    let b: f64 = 3.0*y2
    let denom: f64 = a*a + b*b
    if denom < 0.0000000000001 or denom > 1000000000000000.0 {
        return Orbit { x: x, y: y, iteration: 29, root: 3, trap: nearest }
    }
    let nx: f64 = x - (dx*a + y3*b)/denom
    let ny: f64 = y - (y3*a - dx*b)/denom
    return solve(nx, ny, iteration + 1, nearest)
}

function bound(v: i32) -> i32 {
    if v < 0 { return 0 }
    if v > 255 { return 255 }
    return v
}

function pixel(x: i32, y: i32, w: i32, h: i32) {
    let zx: f64 = ((x as f64) / (w as f64) - 0.5)*4.12 - 0.12
    let zy: f64 = ((y as f64) / (h as f64) - 0.5)*2.77
    let o: Orbit = solve(zx,zy,0,10.0)
    let depth: f64 = o.iteration as f64
    let bands: f64 = 0.65 + 0.35*cos(depth*0.71)
    let trap_glow: f64 = 1.0/(1.0 + o.trap*160.0)
    let edge: f64 = 0.36 + 0.64*(1.0 - depth/39.0)
    let lum: f64 = (0.53 + trap_glow*0.36)*bands*edge
    let mut rr: f64 = 28.0
    let mut gg: f64 = 26.0
    let mut bb: f64 = 48.0
    if o.root == 0 { rr=244.0; gg=128.0; bb=92.0 }
    if o.root == 1 { rr=80.0; gg=230.0; bb=201.0 }
    if o.root == 2 { rr=125.0; gg=138.0; bb=255.0 }
    let shimmer: f64 = 15.0*sin(depth*1.71 + o.trap*32.0)
    let r: i32 = bound((rr*lum+shimmer) as i32)
    let g: i32 = bound((gg*lum+shimmer*0.6) as i32)
    let b: i32 = bound((bb*lum + 7.0) as i32)
    putchar(r)
    putchar(g)
    putchar(b)
}

function main() -> i32 {
    let width: i32 = 920
    let height: i32 = 610
    printf("P6\n%d %d\n255\n",width,height)
    for y in 0..610 {
        for x in 0..920 {
            pixel(x,y,width,height)
        }
    }
    return 0
}
