struct Point {
    x: f32,
    y: f32
}

struct Circle {
    center: Point,
    radius: f32
}

function test_scoping_A() -> f32 {
    # Local Circle 'c'
    let c: Circle = Circle {
        center: Point { x: 1.0, y: 2.0 },
        radius: 10.0
    }
    return c.center.x
}

function test_scoping_B() -> f32 {
    # Different 'c' with same name in another function
    let c: Point = Point { x: 5.0, y: 6.0 }
    return c.y
}

function main() -> i32 {
    let a: f32 = test_scoping_A()
    let b: f32 = test_scoping_B()
    
    print("Point A.x: " + a)
    print("Point B.y: " + b)
    
    return 0
}
