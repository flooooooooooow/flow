# Stack Demo - FLOW version of C++ stack
function main() -> i32 {
    # Initial stack is empty (size = 0)
    let stack_size: i32 = 0
    
    # Push operation: add 1 to stack size
    stack_size = stack_size + 1
    
    # Push another item
    stack_size = stack_size + 1
    
    # Pop operation: subtract 1 from stack size
    stack_size = stack_size - 1
    
    # Return final stack size (should be 1)
    return stack_size
}
