# @module examples.verify.geometry
# @means  An exterior angle and its adjacent interior angle sum to two right angles.
# @from   euclid — Elements, Book I, Proposition 13
# @tier   derived

# @means  exterior at C plus angle C equals two right angles.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «triangle» «exterior angle equals remote interior sum», «Geometry» «triangle» «interior angles sum to two right angles»

theorem «Geometry» «triangle» «exterior plus adjacent interior is two right» () {
    assume «Geometry» «triangle» «exterior angle equals remote interior sum»()
    assume «Geometry» «triangle» «interior angles sum to two right angles»()
    therefore exterior_at_C + angle_C == two_right_angles
}

export «Geometry» «triangle» «exterior plus adjacent interior is two right»