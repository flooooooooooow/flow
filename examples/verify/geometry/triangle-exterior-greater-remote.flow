# @module examples.verify.geometry
# @means  An exterior angle exceeds either remote interior angle.
# @from   euclid — Elements, Book I, Proposition 16
# @tier   derived

# @means  exterior at C is greater than angle A.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «triangle» «exterior angle equals remote interior sum», «Geometry» «triangle» «each interior angle is less than two right»

theorem «Geometry» «triangle» «exterior angle exceeds remote interior» () {
    assume «Geometry» «triangle» «exterior angle equals remote interior sum»()
    assume «Geometry» «triangle» «each interior angle is less than two right»()
    therefore exterior_at_C > angle_A
}

export «Geometry» «triangle» «exterior angle exceeds remote interior»