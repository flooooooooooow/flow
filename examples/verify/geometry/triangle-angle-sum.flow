# @module examples.verify.geometry
# @means  The interior angles of a triangle sum to two right angles.
# @from   euclid — Elements, Book I, Proposition 32
# @tier   derived
# @needs  «Geometry» «parallel lines» «alternate angles are equal»
# @diagram triangle-angle-sum

theorem «Geometry» «triangle» «interior angles sum to two right angles» () {
    assume «Geometry» «parallel lines» «alternate angles are equal»()
    therefore angle_A + angle_B + angle_C == two_right_angles
}