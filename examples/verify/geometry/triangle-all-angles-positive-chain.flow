# @module examples.verify.geometry
# @means  All three triangle angles are positive, chained witness.
# @from   euclid — Elements, Book I, Proposition 32
# @tier   derived

# @means  angles A, B, and C are each greater than zero.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «triangle» «angle B is positive witness», «Geometry» «triangle» «angle C is positive witness», «Geometry» «triangle» «first interior angle is positive»

theorem «Geometry» «triangle» «all angles positive chain» () {
    assume «Geometry» «triangle» «angle B is positive witness»()
    assume «Geometry» «triangle» «angle C is positive witness»()
    assume «Geometry» «triangle» «first interior angle is positive»()
    therefore angle_A > 0 && angle_B > 0 && angle_C > 0
}

export «Geometry» «triangle» «all angles positive chain»