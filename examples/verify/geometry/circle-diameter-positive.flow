# @module examples.verify.geometry
# @means  A circle diameter is positive.
# @from   euclid — Elements, Book I, Definition 15
# @tier   derived

# @means  diameter AB is greater than zero.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «circle» «radius is positive», «Geometry» «circle» «diameter equals two radii»

theorem «Geometry» «circle» «diameter is positive» () {
    assume «Geometry» «circle» «radius is positive»()
    assume «Geometry» «circle» «diameter equals two radii»()
    therefore diameter_AB > 0
}

export «Geometry» «circle» «diameter is positive»