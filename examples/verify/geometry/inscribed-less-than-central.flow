# @module examples.verify.geometry
# @means  An inscribed angle is less than the central angle on the same arc.
# @from   euclid — Elements, Book III, Proposition 20
# @tier   derived

# @means  angle APB is less than angle AOB when arc AB is less than a full turn.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «circle» «inscribed angle is half the central angle», «Geometry» «circle» «positive central gives positive inscribed»

theorem «Geometry» «circle» «inscribed less than central on same arc» () {
    assume «Geometry» «circle» «inscribed angle is half the central angle»()
    assume «Geometry» «circle» «positive central gives positive inscribed»()
    therefore angle_APB < angle_AOB
}

export «Geometry» «circle» «inscribed less than central on same arc»