# @module examples.verify.geometry
# @means  A circle radius is positive.
# @from   euclid — Elements, Book I, Definition 15
# @tier   derived

# @means  radius OA is greater than zero.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «circle» «diameter equals two radii», «Geometry» «circle» «radii from the centre are equal»

theorem «Geometry» «circle» «radius is positive» () {
    assume «Geometry» «circle» «diameter equals two radii»()
    assume «Geometry» «circle» «radii from the centre are equal»()
    therefore radius_OA > 0
}

export «Geometry» «circle» «radius is positive»