# @module examples.verify.geometry
# @means  The interior angle sum of a triangle is positive.
# @from   euclid — Elements, Book I, Proposition 32
# @tier   derived

# @means  angle A plus angle B plus angle C is greater than zero.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «triangle» «interior angles sum to two right angles», «Geometry» «triangle» «each interior angle is less than two right»

theorem «Geometry» «triangle» «interior angle sum is positive» () {
    assume «Geometry» «triangle» «interior angles sum to two right angles»()
    assume «Geometry» «triangle» «each interior angle is less than two right»()
    therefore angle_A + angle_B + angle_C > 0
}

export «Geometry» «triangle» «interior angle sum is positive»