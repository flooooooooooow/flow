# @module examples.verify.geometry
# @means  Angle B in a triangle is positive.
# @from   euclid — Elements, Book I, Proposition 32
# @tier   derived

# @means  angle B is greater than zero.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «triangle» «all interior angles are positive», «Geometry» «triangle» «second interior angle is positive»

theorem «Geometry» «triangle» «angle B is positive witness» () {
    assume «Geometry» «triangle» «all interior angles are positive»()
    assume «Geometry» «triangle» «second interior angle is positive»()
    therefore angle_B > 0
}

export «Geometry» «triangle» «angle B is positive witness»