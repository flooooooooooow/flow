# @module examples.verify.geometry
# @means  The interior angle sum equals half a full turn.
# @from   euclid — Elements, Book I, Proposition 32
# @tier   derived

# @means  angle A plus angle B plus angle C equals two right angles.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «triangle» «interior sum less than one full turn», «Geometry» «triangle» «interior angles sum to two right angles»

theorem «Geometry» «triangle» «interior sum equals half turn» () {
    assume «Geometry» «triangle» «interior sum less than one full turn»()
    assume «Geometry» «triangle» «interior angles sum to two right angles»()
    therefore angle_A + angle_B + angle_C == two_right_angles
}

export «Geometry» «triangle» «interior sum equals half turn»