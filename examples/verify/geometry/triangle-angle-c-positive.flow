# @module examples.verify.geometry
# @means  Angle C in a triangle is positive.
# @from   euclid — Elements, Book I, Proposition 32
# @tier   derived

# @means  angle C is greater than zero.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «triangle» «all interior angles are positive», «Geometry» «triangle» «third interior angle is positive»

theorem «Geometry» «triangle» «angle C is positive witness» () {
    assume «Geometry» «triangle» «all interior angles are positive»()
    assume «Geometry» «triangle» «third interior angle is positive»()
    therefore angle_C > 0
}

export «Geometry» «triangle» «angle C is positive witness»