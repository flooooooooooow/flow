# @module examples.verify.geometry
# @means  The apex angle bisector is perpendicular to the base.
# @from   euclid — Elements, Book I, Proposition 5
# @tier   derived

# @means  apex bisector is perpendicular to base.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «isosceles triangle» «median equals bisector at apex», «Geometry» «isosceles triangle» «apex median perpendicular to base»

theorem «Geometry» «isosceles triangle» «bisector perpendicular to base» () {
    assume «Geometry» «isosceles triangle» «median equals bisector at apex»()
    assume «Geometry» «isosceles triangle» «apex median perpendicular to base»()
    therefore bisect_angle_A perpendicular base_BC
}

export «Geometry» «isosceles triangle» «bisector perpendicular to base»