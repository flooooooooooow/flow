# @module examples.verify.geometry
# @means  The square on the hypotenuse is positive.
# @from   euclid — Elements, Book I, Proposition 47
# @tier   derived

# @means  c squared is greater than zero.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «right triangle» «leg squares are positive», «Geometry» «right triangle» «the Pythagorean relation holds»

theorem «Geometry» «right triangle» «hypotenuse square is positive» () {
    assume «Geometry» «right triangle» «leg squares are positive»()
    assume «Geometry» «right triangle» «the Pythagorean relation holds»()
    therefore c * c > 0
}

export «Geometry» «right triangle» «hypotenuse square is positive»