# @module examples.verify.geometry
# @means  The square on the second leg is positive.
# @from   euclid — Elements, Book I, Proposition 47
# @tier   derived

# @means  b squared is greater than zero.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «right triangle» «leg squares are positive», «Geometry» «right triangle» «second leg is shorter than hypotenuse»

theorem «Geometry» «right triangle» «second leg square is positive» () {
    assume «Geometry» «right triangle» «leg squares are positive»()
    assume «Geometry» «right triangle» «second leg is shorter than hypotenuse»()
    therefore b * b > 0
}

export «Geometry» «right triangle» «second leg square is positive»