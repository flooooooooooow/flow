# @module examples.verify.geometry
# @means  The third interior angle of a triangle is positive.
# @from   euclid — Elements, Book I, Proposition 32
# @tier   derived

# @means  angle C is greater than zero.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «triangle» «interior angle sum is positive», «Geometry» «triangle» «two angles determine the third»

theorem «Geometry» «triangle» «third interior angle is positive» () {
    assume «Geometry» «triangle» «interior angle sum is positive»()
    assume «Geometry» «triangle» «two angles determine the third»()
    therefore angle_C > 0
}

export «Geometry» «triangle» «third interior angle is positive»