# @module examples.verify.geometry
# @means  A positive central angle gives a positive inscribed angle.
# @from   euclid — Elements, Book III, Proposition 20
# @tier   derived

# @means  angle APB is positive when angle AOB is positive.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «circle» «inscribed angle is half the central angle», «Geometry» «circle» «inscribed angles on same arc are equal»

theorem «Geometry» «circle» «positive central gives positive inscribed» () {
    assume «Geometry» «circle» «inscribed angle is half the central angle»()
    assume «Geometry» «circle» «inscribed angles on same arc are equal»()
    therefore angle_APB > 0
}

export «Geometry» «circle» «positive central gives positive inscribed»