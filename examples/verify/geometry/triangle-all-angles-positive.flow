# @module examples.verify.geometry
# @means  All three interior angles of a triangle are positive.
# @from   euclid — Elements, Book I, Proposition 32
# @tier   derived

# @means  angle A, angle B, and angle C are each greater than zero.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «triangle» «first interior angle is positive», «Geometry» «triangle» «second interior angle is positive», «Geometry» «triangle» «third interior angle is positive»

theorem «Geometry» «triangle» «all interior angles are positive» () {
    assume «Geometry» «triangle» «first interior angle is positive»()
    assume «Geometry» «triangle» «second interior angle is positive»()
    assume «Geometry» «triangle» «third interior angle is positive»()
    therefore angle_A > 0
}

export «Geometry» «triangle» «all interior angles are positive»