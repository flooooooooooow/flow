# @module examples.verify.geometry
# @means  The second interior angle of a triangle is positive.
# @from   euclid — Elements, Book I, Proposition 32
# @tier   derived

# @means  angle B is greater than zero.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «triangle» «first interior angle is positive», «Geometry» «triangle» «interior angle sum is positive»

theorem «Geometry» «triangle» «second interior angle is positive» () {
    assume «Geometry» «triangle» «first interior angle is positive»()
    assume «Geometry» «triangle» «interior angle sum is positive»()
    therefore angle_B > 0
}

export «Geometry» «triangle» «second interior angle is positive»