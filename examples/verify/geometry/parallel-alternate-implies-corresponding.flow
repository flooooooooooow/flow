# @module examples.verify.geometry
# @means  Equal alternate angles imply equal corresponding angles.
# @from   euclid — Elements, Book I, Proposition 29
# @tier   derived

# @means  corresponding angles equal when alternate angles equal.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «parallel lines» «alternate angles are equal», «Geometry» «parallel lines» «corresponding angles are equal»

theorem «Geometry» «parallel lines» «alternate equal implies corresponding equal» () {
    assume «Geometry» «parallel lines» «alternate angles are equal»()
    assume «Geometry» «parallel lines» «corresponding angles are equal»()
    therefore angle_corresponding_alpha == angle_corresponding_beta
}

export «Geometry» «parallel lines» «alternate equal implies corresponding equal»