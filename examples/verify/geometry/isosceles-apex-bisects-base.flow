# @module examples.verify.geometry
# @means  The apex angle bisector meets the base at its midpoint.
# @from   euclid — Elements, Book I, Proposition 5
# @tier   derived

# @means  midpoint of BC lies on the apex bisector.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «isosceles triangle» «median to base is perpendicular», «Geometry» «isosceles triangle» «equal base angles imply equal sides»

theorem «Geometry» «isosceles triangle» «apex bisector meets base at midpoint» () {
    assume «Geometry» «isosceles triangle» «median to base is perpendicular»()
    assume «Geometry» «isosceles triangle» «equal base angles imply equal sides»()
    therefore midpoint_BC == foot_of_bisector
}

export «Geometry» «isosceles triangle» «apex bisector meets base at midpoint»