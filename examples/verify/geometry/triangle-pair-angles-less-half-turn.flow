# @module examples.verify.geometry
# @means  Any pair of triangle angles sums to less than half a turn.
# @from   euclid — Elements, Book I, Proposition 17
# @tier   derived

# @means  angle A plus angle B is less than two right angles.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «triangle» «three positive angles half turn», «Geometry» «triangle» «each interior angle less than two right»

theorem «Geometry» «triangle» «pair angles less half turn» () {
    assume «Geometry» «triangle» «three positive angles half turn»()
    assume «Geometry» «triangle» «each interior angle less than two right»()
    therefore angle_A + angle_B < two_right_angles
}

export «Geometry» «triangle» «pair angles less half turn»