# @module examples.verify.geometry
# @means  Equal sides imply equal base angles.
# @from   euclid — Elements, Book I, Proposition 5
# @tier   derived

# @means  if side AB equals side AC then angle at B equals angle at C.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «isosceles triangle» «base angles are equal», «Geometry» «triangle congruence» «side-angle-side implies congruence»

theorem «Geometry» «isosceles triangle» «equal sides imply equal base angles» () {
    assume «Geometry» «isosceles triangle» «base angles are equal»()
    assume «Geometry» «triangle congruence» «side-angle-side implies congruence»()
    therefore angle_at_B == angle_at_C
}

export «Geometry» «isosceles triangle» «equal sides imply equal base angles»