# @module examples.verify.geometry
# @means  An exterior angle strictly exceeds each remote interior angle.
# @from   euclid — Elements, Book I, Proposition 16
# @tier   derived

# @means  exterior strictly greater than each remote interior.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «triangle» «exterior strictly greater remote interior», «Geometry» «triangle» «exterior exceeds min remote interior»

theorem «Geometry» «triangle» «exterior strict each remote» () {
    assume «Geometry» «triangle» «exterior strictly greater remote interior»()
    assume «Geometry» «triangle» «exterior exceeds min remote interior»()
    therefore angle_exterior > angle_remote_A && angle_exterior > angle_remote_B
}

export «Geometry» «triangle» «exterior strict each remote»