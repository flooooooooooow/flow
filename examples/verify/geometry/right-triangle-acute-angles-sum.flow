# @module examples.verify.geometry
# @means  The two acute angles in a right triangle sum to one right angle.
# @from   euclid — Elements, Book I, Proposition 32
# @tier   derived

# @means  angle A plus angle B equals one right angle when angle C is right.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «circle» «Thales right angle in semicircle», «Geometry» «triangle» «interior angles sum to two right angles»

theorem «Geometry» «right triangle» «acute angles sum to one right angle» () {
    assume «Geometry» «circle» «Thales right angle in semicircle»()
    assume «Geometry» «triangle» «interior angles sum to two right angles»()
    therefore angle_A + angle_B == one_right_angle
}

export «Geometry» «right triangle» «acute angles sum to one right angle»