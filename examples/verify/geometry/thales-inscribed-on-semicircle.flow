# @module examples.verify.geometry
# @means  Any point on a semicircle gives a right inscribed angle.
# @from   euclid — Elements, Book III, Proposition 31
# @tier   derived

# @means  angle ACB is one right angle for C on semicircle AB.
# @from   euclid
# @tier   derived
# @needs  «Geometry» «circle» «semicircle unique right inscribed», «Geometry» «circle» «semicircle inscribed angle is right witness»

theorem «Geometry» «circle» «inscribed on semicircle is right» () {
    assume «Geometry» «circle» «semicircle unique right inscribed»()
    assume «Geometry» «circle» «semicircle inscribed angle is right witness»()
    therefore angle_ACB == one_right_angle
}

export «Geometry» «circle» «inscribed on semicircle is right»