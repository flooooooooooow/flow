# @module examples.verify.math.derived
# @means  Union with the empty set on the left changes nothing.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  empty ∪ s = s.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «union» «order does not matter», «Finset» «union» «empty is the left identity»

theorem «Finset» «union» «empty on the left gives the set» (s: Finset) {
    assume «Finset» «union» «order does not matter»(empty, s)
    assume «Finset» «union» «empty is the left identity»(s)
    therefore empty ∪ s == s
}

export «Finset» «union» «empty on the left gives the set»