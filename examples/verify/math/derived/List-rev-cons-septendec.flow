# @module examples.verify.math.derived
# @means  Reversing a septendecuple cons list.
# @from   church — https://en.wikipedia.org/wiki/Reverse_(list)
# @tier   derived

# @means  rev of seventeen cons ending in nil reverses element order.
# @from   church
# @tier   derived
# @needs  «List» «reverse» «reverse of cons is append of reverse tail», «List» «reverse» «reverse of sedecuple cons»

theorem «List» «reverse» «reverse of septendecuple cons» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat, g: Nat, h: Nat, i: Nat, j: Nat, k: Nat, l: Nat, m: Nat, n: Nat, o: Nat, p: Nat, q: Nat) {
    assume «List» «reverse» «reverse of cons is append of reverse tail»(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, cons(k, cons(l, cons(m, cons(n, cons(o, cons(p, cons(q, nil)))))))))))))))))
    assume «List» «reverse» «reverse of sedecuple cons»(b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q)
    therefore rev(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, cons(k, cons(l, cons(m, cons(n, cons(o, cons(p, cons(q, nil)))))))))))))))) == cons(q, cons(p, cons(o, cons(n, cons(m, cons(l, cons(k, cons(j, cons(i, cons(h, cons(g, cons(f, cons(e, cons(d, cons(c, cons(b, cons(a, nil)))))))))))))))))
}

export «List» «reverse» «reverse of septendecuple cons»