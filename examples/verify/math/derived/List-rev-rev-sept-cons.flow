# @module examples.verify.math.derived
# @means  Double reverse restores a septuple cons list.
# @from   church — https://en.wikipedia.org/wiki/Reverse_(list)
# @tier   derived

# @means  rev(rev(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, xs)))))))) = cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, xs))))))).
# @from   church
# @tier   derived
# @needs  «List» «reverse» «reverse is an involution»

theorem «List» «reverse» «double reverse of septuple cons» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat, g: Nat, xs: List) {
    assume «List» «reverse» «reverse is an involution»(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, xs))))))))
    therefore rev(rev(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, xs)))))))) == cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, xs)))))))
}

export «List» «reverse» «double reverse of septuple cons»