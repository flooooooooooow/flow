# @module examples.verify.math.derived
# @means  Second projection retrieves the second component.
# @from   church — https://en.wikipedia.org/wiki/Product_type
# @tier   derived

# @means  snd(pair(a, b)) = b.
# @from   church
# @tier   derived
# @needs  «Pair» «second projection» «second component is retrieved»

theorem «Pair» «second projection» «second projection from pairing» (a: Nat, b: Nat) {
    assume «Pair» «second projection» «second component is retrieved»(a, b)
    therefore snd(pair(a, b)) == b
}

export «Pair» «second projection» «second projection from pairing»