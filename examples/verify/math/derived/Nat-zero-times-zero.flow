# @module examples.verify.math.derived
# @means  Zero times zero is zero for natural numbers.
# @from   peano — https://en.wikipedia.org/wiki/Peano_axioms
# @tier   derived

# @means  0 * 0 = 0.
# @from   peano
# @tier   derived
# @needs  «Nat» «multiplication» «zero is the left annihilator»

theorem «Nat» «multiplication» «zero times zero is zero» () {
    assume «Nat» «multiplication» «zero is the left annihilator»(0)
    therefore 0 * 0 == 0
}

export «Nat» «multiplication» «zero times zero is zero»