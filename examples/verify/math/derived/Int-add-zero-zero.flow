# @module examples.verify.math.derived
# @means  Zero plus zero is zero for integers.
# @from   landau — *Foundations of Analysis*, Ch. 1
# @tier   derived

# @means  0 + 0 = 0.
# @from   landau
# @tier   derived
# @needs  «Int» «addition» «zero is the left identity»

theorem «Int» «addition» «zero plus zero is zero» () {
    assume «Int» «addition» «zero is the left identity»(0)
    therefore 0 + 0 == 0
}

export «Int» «addition» «zero plus zero is zero»