# @module examples.verify.math.derived
# @means  Join absorbs meet on the lattice order.
# @from   davey-priestley — *Introduction to Lattices and Order*
# @tier   derived

# @means  a ∨ (a ∧ b) = a.
# @from   davey-priestley
# @tier   derived
# @needs  «Order» «join» «order does not matter», «Order» «meet» «order does not matter», «Order» «join» «repeating does not change the value»

theorem «Order» «join» «join absorbs meet» (a: Nat, b: Nat) {
    assume «Order» «join» «order does not matter»(a, b)
    assume «Order» «meet» «order does not matter»(a, b)
    assume «Order» «join» «repeating does not change the value»(a)
    therefore join(a, meet(a, b)) == a
}

export «Order» «join» «join absorbs meet»