# @module examples.verify.math.derived
# @means  Intersection distributes over union on the left.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  a ∩ (b ∪ c) = (a ∩ b) ∪ (a ∩ c).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «intersection» «parentheses do not matter», «Finset» «union» «parentheses do not matter», «Finset» «intersection» «order does not matter»

theorem «Finset» «intersection» «left distribution over union holds» (a: Finset, b: Finset, c: Finset) {
    assume «Finset» «intersection» «parentheses do not matter»(a, b, c)
    assume «Finset» «union» «parentheses do not matter»(a, b, c)
    assume «Finset» «intersection» «order does not matter»(b, c)
    therefore a ∩ (b ∪ c) == (a ∩ b) ∪ (a ∩ c)
}

export «Finset» «intersection» «left distribution over union holds»