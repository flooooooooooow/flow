# @module examples.verify.math.derived
# @means  Choosing nine from a successor set.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  choose(succ(n), 9) = choose(n, 8) + choose(n, 9).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Comb» «choose» «Pascal recurrence holds», «Comb» «choose» «choosing eight from a successor»

theorem «Comb» «choose» «choosing nine from a successor» (n: Nat) {
    assume «Comb» «choose» «Pascal recurrence holds»(succ(n), 9)
    assume «Comb» «choose» «choosing eight from a successor»(n)
    therefore choose(succ(n), 9) == choose(n, 8) + choose(n, 9)
}

export «Comb» «choose» «choosing nine from a successor»