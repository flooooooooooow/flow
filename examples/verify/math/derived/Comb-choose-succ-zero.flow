# @module examples.verify.math.derived
# @means  Choosing none from a successor set gives one.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  choose(succ(n), 0) = 1.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Comb» «choose» «Pascal recurrence holds», «Comb» «choose» «choosing none gives one»

theorem «Comb» «choose» «choosing none from a successor» (n: Nat) {
    assume «Comb» «choose» «Pascal recurrence holds»(succ(n), 0)
    assume «Comb» «choose» «choosing none gives one»(n)
    therefore choose(succ(n), 0) == 1
}

export «Comb» «choose» «choosing none from a successor»