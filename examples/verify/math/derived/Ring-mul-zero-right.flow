# @module examples.verify.math.derived
# @means  Zero on the right annihilates ring multiplication.
# @from   dummit-foote — *Abstract Algebra*, §7.1
# @tier   derived

# @means  r * 0 = 0.
# @from   dummit-foote
# @tier   derived
# @needs  «Ring» «multiplication» «zero on the left gives zero», «Ring» «addition» «order does not matter»

theorem «Ring» «multiplication» «zero on the right gives zero» (r: Ring) {
    assume «Ring» «multiplication» «zero on the left gives zero»(r)
    assume «Ring» «addition» «order does not matter»(r, 0)
    therefore r * 0 == 0
}

export «Ring» «multiplication» «zero on the right gives zero»