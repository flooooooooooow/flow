# @module examples.verify.math.derived
# @means  First projection commutes with pairing of projections.
# @from   church — https://en.wikipedia.org/wiki/Product_type
# @tier   derived

# @means  fst(pair(fst(p), snd(p))) = fst(p).
# @from   church
# @tier   derived
# @needs  «Pair» «first projection» «first component is retrieved», «Pair» «second projection» «second component is retrieved»

theorem «Pair» «first projection» «first projection factors through pairing» (a: Nat, b: Nat) {
    assume «Pair» «first projection» «first component is retrieved»(a, b)
    assume «Pair» «second projection» «second component is retrieved»(a, b)
    therefore fst(pair(fst(pair(a, b)), snd(pair(a, b)))) == fst(pair(a, b))
}

export «Pair» «first projection» «first projection factors through pairing»