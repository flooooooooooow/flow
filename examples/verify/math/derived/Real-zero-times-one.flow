# @module examples.verify.math.derived
# @means  Zero times one is zero for reals.
# @from   landau — *Foundations of Analysis*
# @tier   derived

# @means  0 * 1 = 0.
# @from   landau
# @tier   derived
# @needs  «Real» «multiplication» «zero on the left gives zero»

theorem «Real» «multiplication» «zero times one is zero» () {
    assume «Real» «multiplication» «zero on the left gives zero»(1)
    therefore 0 * 1 == 0
}

export «Real» «multiplication» «zero times one is zero»