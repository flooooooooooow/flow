# @module examples.verify.math.derived
# @means  One is the left multiplicative identity for reals.
# @from   landau — *Foundations of Analysis*
# @tier   derived

# @means  1 * x = x.
# @from   landau
# @tier   derived
# @needs  «Real» «multiplication» «one is the right identity», «Real» «multiplication» «order does not matter»

import .Real-mul-comm { mul-comm }

theorem «Real» «multiplication» «one on the left gives the value» (x: Real) {
    assume «Real» «multiplication» «one is the right identity»(x)
    assume «Real» «multiplication» «order does not matter»(1, x)
    therefore 1 * x == x
}

export «Real» «multiplication» «one on the left gives the value»