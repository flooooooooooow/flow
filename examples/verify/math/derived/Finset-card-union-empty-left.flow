# @module examples.verify.math.derived
# @means  Empty left union preserves cardinality bound.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card(empty ∪ s) <= card(s).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «union» «empty on the left gives the set», «Nat» «order» «less-or-equal is reflexive»

theorem «Finset» «cardinality» «empty left union size is bounded» (s: Finset) {
    assume «Finset» «union» «empty on the left gives the set»(s)
    assume «Nat» «order» «less-or-equal is reflexive»(card(s))
    therefore card(empty ∪ s) <= card(s)
}

export «Finset» «cardinality» «empty left union size is bounded»