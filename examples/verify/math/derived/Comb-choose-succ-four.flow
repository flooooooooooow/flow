# @module examples.verify.math.derived
# @means  Choosing four from a successor set.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  choose(succ(n), 4) = choose(n, 3) + choose(n, 4).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Comb» «choose» «Pascal recurrence holds», «Comb» «choose» «choosing three from a successor»

theorem «Comb» «choose» «choosing four from a successor» (n: Nat) {
    assume «Comb» «choose» «Pascal recurrence holds»(succ(n), 4)
    assume «Comb» «choose» «choosing three from a successor»(n)
    therefore choose(succ(n), 4) == choose(n, 3) + choose(n, 4)
}

export «Comb» «choose» «choosing four from a successor»