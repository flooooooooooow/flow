# @module examples.verify.math.derived
# @means  One is the left multiplicative identity in a ring.
# @from   dummit-foote — *Abstract Algebra*, §7.1
# @tier   derived

# @means  1 * r = r.
# @from   dummit-foote
# @tier   derived
# @needs  «Ring» «multiplication» «one is the left identity»

theorem «Ring» «multiplication» «one is the left multiplicative identity» (r: Ring) {
    assume «Ring» «multiplication» «one is the left identity»(r)
    therefore 1 * r == r
}

export «Ring» «multiplication» «one is the left multiplicative identity»