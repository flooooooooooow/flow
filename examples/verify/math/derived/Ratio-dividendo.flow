# @module examples.verify.math.derived
# @means  Proportional magnitudes satisfy dividendo.
# @from   euclid — Elements, Book V, Proposition 12
# @tier   derived

# @means  a:b = c:d implies (a-b):b = (c-d):d.
# @from   euclid
# @tier   derived
# @needs  «Ratio» «proportion» «componendo holds», «Ratio» «proportion» «invertendo holds»

import .Ratio-componendo { componendo }

theorem «Ratio» «proportion» «dividendo holds» (a: Magnitude, b: Magnitude, c: Magnitude, d: Magnitude) {
    assume «Ratio» «proportion» «componendo holds»(a, b, c, d)
    assume «Ratio» «proportion» «invertendo holds»(a, b, c, d)
    therefore ratio(a - b, b) == ratio(c - d, d)
}

export «Ratio» «proportion» «dividendo holds»