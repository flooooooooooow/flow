# @module examples.verify.math.derived
# @means  Nonuple swap returns the original pair.
# @from   church — https://en.wikipedia.org/wiki/Product_type
# @tier   derived

# @means  nine nested swaps on a pair returns the pair.
# @from   church
# @tier   derived
# @needs  «Pair» «swap» «octuple swap returns pair», «Pair» «swap» «septuple swap returns pair»

theorem «Pair» «swap» «nonuple swap returns pair» (a: Nat, b: Nat) {
    assume «Pair» «swap» «octuple swap returns pair»(a, b)
    assume «Pair» «swap» «septuple swap returns pair»(a, b)
    therefore swap(swap(swap(swap(swap(swap(swap(swap(swap(pair(a, b)))))))))) == pair(a, b)
}

export «Pair» «swap» «nonuple swap returns pair»