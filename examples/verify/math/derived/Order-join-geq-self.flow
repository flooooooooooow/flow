# @module examples.verify.math.derived
# @means  Join is at least each argument.
# @from   davey-priestley — *Introduction to Lattices and Order*
# @tier   derived

# @means  a <= join(a, b).
# @from   davey-priestley
# @tier   derived
# @needs  «Order» «join» «join is above the left argument»

theorem «Order» «join» «join is at least the left argument» (a: Nat, b: Nat) {
    assume «Order» «join» «join is above the left argument»(a, b)
    therefore a <= join(a, b)
}

export «Order» «join» «join is at least the left argument»