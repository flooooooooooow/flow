# @module examples.verify.math.derived
# @means  Self-union does not increase cardinality.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card(s ∪ s) <= card(s).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «union» «repeating does not change the set», «Nat» «order» «less-or-equal is reflexive»

theorem «Finset» «cardinality» «self union size is bounded» (s: Finset) {
    assume «Finset» «union» «repeating does not change the set»(s)
    assume «Nat» «order» «less-or-equal is reflexive»(card(s))
    therefore card(s ∪ s) <= card(s)
}

export «Finset» «cardinality» «self union size is bounded»