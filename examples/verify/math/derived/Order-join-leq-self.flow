# @module examples.verify.math.derived
# @means  Join with itself is above the argument.
# @from   davey-priestley — *Introduction to Lattices and Order*
# @tier   derived

# @means  a <= join(a, a).
# @from   davey-priestley
# @tier   derived
# @needs  «Order» «join» «join with itself equals the argument», «Nat» «order» «less-or-equal is reflexive»

theorem «Order» «join» «join with itself is above the argument derived» (a: Nat) {
    assume «Order» «join» «join with itself equals the argument»(a)
    assume «Nat» «order» «less-or-equal is reflexive»(a)
    therefore a <= join(a, a)
}

export «Order» «join» «join with itself is above the argument derived»