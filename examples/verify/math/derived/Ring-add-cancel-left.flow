# @module examples.verify.math.derived
# @means  Equal ring elements can be subtracted from the left.
# @from   dummit-foote — *Abstract Algebra*, §7.1
# @tier   derived

# @means  c + a = c + b implies a = b.
# @from   dummit-foote
# @tier   derived
# @needs  «Ring» «addition» «right cancellation holds», «Ring» «addition» «order does not matter»

import .Ring-add-cancel { add-cancel-right }

theorem «Ring» «addition» «left cancellation holds» (a: Ring, b: Ring, c: Ring) {
    if c + a == c + b {
        assume «Ring» «addition» «right cancellation holds»(a, b, c)
        assume «Ring» «addition» «order does not matter»(c, a)
        therefore a == b
    }
}

export «Ring» «addition» «left cancellation holds»