# @module examples.verify.math.derived
# @means  Reverse after left-empty append preserves length.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len(rev(nil ++ xs)) = len(xs).
# @from   church
# @tier   derived
# @needs  «List» «length» «reverse preserves length», «List» «length» «empty append preserves length»

theorem «List» «length» «reverse after left empty append preserves length» (xs: List) {
    assume «List» «length» «reverse preserves length»(nil ++ xs)
    assume «List» «length» «empty append preserves length»(xs)
    therefore len(rev(nil ++ xs)) == len(xs)
}

export «List» «length» «reverse after left empty append preserves length»