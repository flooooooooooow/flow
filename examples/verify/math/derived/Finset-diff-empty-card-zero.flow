# @module examples.verify.math.derived
# @means  Difference with empty then empty has cardinality zero.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card((s \ empty) ∩ empty) = 0.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «cardinality» «difference with empty preserves cardinality», «Finset» «cardinality» «empty set has cardinality zero»

theorem «Finset» «cardinality» «diff empty then empty has card zero» (s: Finset) {
    assume «Finset» «cardinality» «difference with empty preserves cardinality»(s)
    assume «Finset» «cardinality» «empty set has cardinality zero»()
    therefore card((s \ empty) ∩ empty) == 0
}

export «Finset» «cardinality» «diff empty then empty has card zero»