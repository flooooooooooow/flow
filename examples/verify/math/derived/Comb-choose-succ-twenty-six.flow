# @module examples.verify.math.derived
# @means  Choosing twenty-six from a successor set.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  choose(succ(n), 26) = choose(n, 25) + choose(n, 26).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Comb» «choose» «Pascal recurrence holds», «Comb» «choose» «choosing twenty five from a successor»

theorem «Comb» «choose» «choosing twenty six from a successor» (n: Nat) {
    assume «Comb» «choose» «Pascal recurrence holds»(succ(n), 26)
    assume «Comb» «choose» «choosing twenty five from a successor»(n)
    therefore choose(succ(n), 26) == choose(n, 25) + choose(n, 26)
}

export «Comb» «choose» «choosing twenty six from a successor»