# @module examples.verify.math.derived
# @means  Meet with itself is below the argument.
# @from   davey-priestley — *Introduction to Lattices and Order*
# @tier   derived

# @means  meet(a, a) <= a.
# @from   davey-priestley
# @tier   derived
# @needs  «Order» «meet» «meet with itself equals the argument», «Nat» «order» «less-or-equal is reflexive»

theorem «Order» «meet» «meet with itself is below the argument derived» (a: Nat) {
    assume «Order» «meet» «meet with itself equals the argument»(a)
    assume «Nat» «order» «less-or-equal is reflexive»(a)
    therefore meet(a, a) <= a
}

export «Order» «meet» «meet with itself is below the argument derived»