# @module examples.verify.math.derived
# @means  Choosing twenty-five from a successor set.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  choose(succ(n), 25) = choose(n, 24) + choose(n, 25).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Comb» «choose» «Pascal recurrence holds», «Comb» «choose» «choosing twenty four from a successor»

theorem «Comb» «choose» «choosing twenty five from a successor» (n: Nat) {
    assume «Comb» «choose» «Pascal recurrence holds»(succ(n), 25)
    assume «Comb» «choose» «choosing twenty four from a successor»(n)
    therefore choose(succ(n), 25) == choose(n, 24) + choose(n, 25)
}

export «Comb» «choose» «choosing twenty five from a successor»