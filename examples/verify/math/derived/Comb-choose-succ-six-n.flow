# @module examples.verify.math.derived
# @means  Choosing six from a successor set.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  choose(succ(n), 6) = choose(n, 5) + choose(n, 6).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Comb» «choose» «Pascal recurrence holds», «Comb» «choose» «choosing five from a successor»

theorem «Comb» «choose» «choosing six from a successor derived» (n: Nat) {
    assume «Comb» «choose» «Pascal recurrence holds»(succ(n), 6)
    assume «Comb» «choose» «choosing five from a successor»(n)
    therefore choose(succ(n), 6) == choose(n, 5) + choose(n, 6)
}

export «Comb» «choose» «choosing six from a successor derived»