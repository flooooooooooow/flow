# @module examples.verify.math.derived
# @means  Thirteen plus zero is thirteen in a monoid witness.
# @from   dummit-foote — *Abstract Algebra*, §1.1
# @tier   derived

# @means  13 + 0 = 13.
# @from   dummit-foote
# @tier   derived
# @needs  «Monoid» «addition» «zero is the right additive identity», «Monoid» «addition» «twelve plus zero is twelve»

theorem «Monoid» «addition» «thirteen plus zero is thirteen» () {
    assume «Monoid» «addition» «zero is the right additive identity»(13)
    assume «Monoid» «addition» «twelve plus zero is twelve»()
    therefore 13 + 0 == 13
}

export «Monoid» «addition» «thirteen plus zero is thirteen»