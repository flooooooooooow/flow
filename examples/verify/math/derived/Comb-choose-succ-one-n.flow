# @module examples.verify.math.derived
# @means  Choosing one from a successor set gives the successor count.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  choose(succ(n), 1) = succ(n).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Comb» «choose» «Pascal recurrence holds», «Comb» «choose» «choosing one gives the count»

theorem «Comb» «choose» «choosing one from a successor gives the count» (n: Nat) {
    assume «Comb» «choose» «Pascal recurrence holds»(succ(n), 1)
    assume «Comb» «choose» «choosing one gives the count»(n)
    therefore choose(succ(n), 1) == succ(n)
}

export «Comb» «choose» «choosing one from a successor gives the count»