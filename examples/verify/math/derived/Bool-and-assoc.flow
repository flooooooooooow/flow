# @module examples.verify.math.derived
# @means  Conjunction associates: regrouping ands does not change the result.
# @from   boole — https://en.wikipedia.org/wiki/Associative_property
# @tier   derived

# @means  (a ∧ b) ∧ c = a ∧ (b ∧ c).
# @from   boole — https://en.wikipedia.org/wiki/Boolean_algebra
# @tier   derived
# @needs  «Bool» «conjunction» «order does not matter»

theorem «Bool» «conjunction» «parentheses do not matter» (a: bool, b: bool, c: bool) {
    if a == true {
        if b == true {
            therefore (a and b) and c == a and (b and c)
        } elif c == true {
            therefore (a and b) and c == a and (b and c)
        } else {
            therefore (a and b) and c == a and (b and c)
        }
    } elif b == true {
        if c == true {
            therefore (a and b) and c == a and (b and c)
        } else {
            therefore (a and b) and c == a and (b and c)
        }
    } elif c == true {
        therefore (a and b) and c == a and (b and c)
    } else {
        therefore (a and b) and c == a and (b and c)
    }
}

export «Bool» «conjunction» «parentheses do not matter»