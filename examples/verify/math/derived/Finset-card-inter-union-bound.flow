# @module examples.verify.math.derived
# @means  Intersection cardinality is bounded by union cardinality.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card(s ∩ t) <= card(s ∪ t).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «cardinality» «intersection card is at most union card»

theorem «Finset» «cardinality» «intersection card at most union card» (s: Finset, t: Finset) {
    assume «Finset» «cardinality» «intersection card is at most union card»(s, t)
    therefore card(s ∩ t) <= card(s ∪ t)
}

export «Finset» «cardinality» «intersection card at most union card»