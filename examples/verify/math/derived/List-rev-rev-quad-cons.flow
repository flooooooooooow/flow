# @module examples.verify.math.derived
# @means  Double reverse restores a quadruple cons list.
# @from   church — https://en.wikipedia.org/wiki/Reverse_(list)
# @tier   derived

# @means  rev(rev(cons(a, cons(b, cons(c, cons(d, xs)))))) = cons(a, cons(b, cons(c, cons(d, xs)))).
# @from   church
# @tier   derived
# @needs  «List» «reverse» «reverse is an involution»

theorem «List» «reverse» «double reverse of quadruple cons» (a: Nat, b: Nat, c: Nat, d: Nat, xs: List) {
    assume «List» «reverse» «reverse is an involution»(cons(a, cons(b, cons(c, cons(d, xs)))))
    therefore rev(rev(cons(a, cons(b, cons(c, cons(d, xs)))))) == cons(a, cons(b, cons(c, cons(d, xs))))
}

export «List» «reverse» «double reverse of quadruple cons»