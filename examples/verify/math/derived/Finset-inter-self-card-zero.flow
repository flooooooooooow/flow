# @module examples.verify.math.derived
# @means  Self-intersection then empty has cardinality zero.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card((s ∩ s) ∩ empty) = 0.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «intersection» «self intersect empty derived», «Finset» «cardinality» «empty set has cardinality zero»

theorem «Finset» «cardinality» «self intersect empty card zero» (s: Finset) {
    assume «Finset» «intersection» «self intersect empty derived»(s)
    assume «Finset» «cardinality» «empty set has cardinality zero»()
    therefore card((s ∩ s) ∩ empty) == 0
}

export «Finset» «cardinality» «self intersect empty card zero»