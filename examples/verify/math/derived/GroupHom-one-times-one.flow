# @module examples.verify.math.derived
# @means  One times one maps to one under a group homomorphism.
# @from   dummit-foote — *Abstract Algebra*, §3.1
# @tier   derived

# @means  f(1 * 1) = 1.
# @from   dummit-foote
# @tier   derived
# @needs  «GroupHom» «preservation» «homomorphisms preserve multiplication», «GroupHom» «preservation» «homomorphisms preserve the identity»

theorem «GroupHom» «preservation» «one times one maps to identity» (f: GroupHom) {
    assume «GroupHom» «preservation» «homomorphisms preserve multiplication»(f, 1, 1)
    assume «GroupHom» «preservation» «homomorphisms preserve the identity»(f)
    therefore f(1 * 1) == 1
}

export «GroupHom» «preservation» «one times one maps to identity»