# @module examples.verify.math.derived
# @means  Four plus zero is four for natural numbers.
# @from   peano — https://en.wikipedia.org/wiki/Peano_axioms
# @tier   derived

# @means  4 + 0 = 4.
# @from   peano
# @tier   derived
# @needs  «Nat» «addition» «zero is the right identity»

theorem «Nat» «addition» «four plus zero is four» () {
    let four = succ(succ(succ(succ(0))))
    assume «Nat» «addition» «zero is the right identity»(four)
    therefore four + 0 == four
}

export «Nat» «addition» «four plus zero is four»