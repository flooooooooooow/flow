# @module examples.verify.math.derived
# @means  Zero times one is zero for rationals via left annihilation.
# @from   landau — *Foundations of Analysis*
# @tier   derived

# @means  0 * 1 = 0.
# @from   landau
# @tier   derived
# @needs  «Rat» «multiplication» «zero on the left gives zero»

theorem «Rat» «multiplication» «zero times one is zero derived» () {
    assume «Rat» «multiplication» «zero on the left gives zero»(1)
    therefore 0 * 1 == 0
}

export «Rat» «multiplication» «zero times one is zero derived»