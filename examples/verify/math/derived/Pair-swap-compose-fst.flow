# @module examples.verify.math.derived
# @means  Swapping twice restores the first projection.
# @from   church — https://en.wikipedia.org/wiki/Product_type
# @tier   derived

# @means  fst(swap(swap(pair(a, b)))) = a.
# @from   church
# @tier   derived
# @needs  «Pair» «first projection» «first component is retrieved», «Pair» «swap» «double swap returns the pair»

theorem «Pair» «swap» «double swap preserves first projection» (a: Nat, b: Nat) {
    assume «Pair» «first projection» «first component is retrieved»(a, b)
    assume «Pair» «swap» «double swap returns the pair»(a, b)
    therefore fst(swap(swap(pair(a, b)))) == a
}

export «Pair» «swap» «double swap preserves first projection»