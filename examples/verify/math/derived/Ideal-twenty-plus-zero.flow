# @module examples.verify.math.derived
# @means  Twenty plus zero is twenty in an ideal witness.
# @from   dummit-foote — *Abstract Algebra*, §7.1
# @tier   derived

# @means  20 + 0 = 20 in an ideal.
# @from   dummit-foote
# @tier   derived
# @needs  «Ideal» «addition» «zero is the right additive identity», «Ideal» «addition» «nineteen plus zero in ideal»

theorem «Ideal» «addition» «twenty plus zero in ideal» () {
    assume «Ideal» «addition» «zero is the right additive identity»(20)
    assume «Ideal» «addition» «nineteen plus zero in ideal»()
    therefore 20 + 0 == 20
}

export «Ideal» «addition» «twenty plus zero in ideal»