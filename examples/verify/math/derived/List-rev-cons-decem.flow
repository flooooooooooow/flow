# @module examples.verify.math.derived
# @means  Reversing a decuple cons list.
# @from   church — https://en.wikipedia.org/wiki/Reverse_(list)
# @tier   derived

# @means  rev of ten cons ending in nil reverses element order.
# @from   church
# @tier   derived
# @needs  «List» «reverse» «reverse of cons is append of reverse tail», «List» «reverse» «reverse of nonuple cons»

theorem «List» «reverse» «reverse of decuple cons» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat, g: Nat, h: Nat, i: Nat, j: Nat) {
    assume «List» «reverse» «reverse of cons is append of reverse tail»(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, nil))))))))))
    assume «List» «reverse» «reverse of nonuple cons»(b, c, d, e, f, g, h, i, j)
    therefore rev(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, nil))))))))))) == cons(j, cons(i, cons(h, cons(g, cons(f, cons(e, cons(d, cons(c, cons(b, cons(a, nil)))))))))))
}

export «List» «reverse» «reverse of decuple cons»