# @module examples.verify.math.derived
# @means  Self-intersection cardinality is at most self cardinality.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card(s ∩ s) <= card(s).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «cardinality» «intersection card is at most left card»

theorem «Finset» «cardinality» «self intersection card bound derived» (s: Finset) {
    assume «Finset» «cardinality» «intersection card is at most left card»(s, s)
    therefore card(s ∩ s) <= card(s)
}

export «Finset» «cardinality» «self intersection card bound derived»