# @module examples.verify.math.derived
# @means  Union with the empty set on the right preserves cardinality.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card(s ∪ empty) = card(s).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «union» «empty on the right gives the set», «Nat» «order» «less-or-equal is reflexive»

theorem «Finset» «cardinality» «union with empty on the right preserves size» (s: Finset) {
    assume «Finset» «union» «empty on the right gives the set»(s)
    assume «Nat» «order» «less-or-equal is reflexive»(card(s))
    therefore card(s ∪ empty) <= card(s)
}

export «Finset» «cardinality» «union with empty on the right preserves size»