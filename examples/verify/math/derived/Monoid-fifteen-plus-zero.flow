# @module examples.verify.math.derived
# @means  Fifteen plus zero is fifteen in a monoid witness.
# @from   dummit-foote — *Abstract Algebra*, §1.1
# @tier   derived

# @means  15 + 0 = 15.
# @from   dummit-foote
# @tier   derived
# @needs  «Monoid» «addition» «zero is the right additive identity», «Monoid» «addition» «fourteen plus zero is fourteen»

theorem «Monoid» «addition» «fifteen plus zero is fifteen» () {
    assume «Monoid» «addition» «zero is the right additive identity»(15)
    assume «Monoid» «addition» «fourteen plus zero is fourteen»()
    therefore 15 + 0 == 15
}

export «Monoid» «addition» «fifteen plus zero is fifteen»