# @module examples.verify.math.derived
# @means  Union with itself leaves a finite set unchanged.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  s ∪ s = s.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «union» «order does not matter», «Finset» «union» «empty is the right identity»

theorem «Finset» «union» «repeating does not change the set» (s: Finset) {
    assume «Finset» «union» «order does not matter»(s, s)
    assume «Finset» «union» «empty is the right identity»(s)
    therefore s ∪ s == s
}

export «Finset» «union» «repeating does not change the set»