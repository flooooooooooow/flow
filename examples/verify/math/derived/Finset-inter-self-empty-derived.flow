# @module examples.verify.math.derived
# @means  Self-intersection is empty when intersected with empty.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  (s ∩ s) ∩ empty = empty.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «intersection» «self intersect empty is empty»

theorem «Finset» «intersection» «self intersect empty derived» (s: Finset) {
    assume «Finset» «intersection» «self intersect empty is empty»(s)
    therefore (s ∩ s) ∩ empty == empty
}

export «Finset» «intersection» «self intersect empty derived»