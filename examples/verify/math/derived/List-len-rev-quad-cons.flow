# @module examples.verify.math.derived
# @means  Reverse preserves length of a quadruple cons list.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len(rev(cons(a, cons(b, cons(c, cons(d, nil)))))) = 4.
# @from   church
# @tier   derived
# @needs  «List» «length» «reverse preserves length», «List» «length» «quadruple cons nil has length four»

theorem «List» «length» «reverse of quadruple cons has length four» (a: Nat, b: Nat, c: Nat, d: Nat) {
    assume «List» «length» «reverse preserves length»(cons(a, cons(b, cons(c, cons(d, nil)))))
    assume «List» «length» «quadruple cons nil has length four»(a, b, c, d)
    therefore len(rev(cons(a, cons(b, cons(c, cons(d, nil)))))) == 4
}

export «List» «length» «reverse of quadruple cons has length four»