# @module examples.verify.math.derived
# @means  Quattuordecuple cons ending in nil has length fourteen.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len of fourteen cons ending in nil equals 14.
# @from   church
# @tier   derived
# @needs  «List» «length» «cons increases length by one», «List» «length» «tredecuple cons nil has length thirteen»

theorem «List» «length» «quattuordecuple cons nil has length fourteen» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat, g: Nat, h: Nat, i: Nat, j: Nat, k: Nat, l: Nat, m: Nat, n: Nat) {
    assume «List» «length» «cons increases length by one»(cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, cons(k, cons(l, cons(m, cons(n, nil))))))))))))))
    assume «List» «length» «tredecuple cons nil has length thirteen»(b, c, d, e, f, g, h, i, j, k, l, m, n)
    therefore len(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, cons(k, cons(l, cons(m, cons(n, nil))))))))))))))) == 14
}

export «List» «length» «quattuordecuple cons nil has length fourteen»