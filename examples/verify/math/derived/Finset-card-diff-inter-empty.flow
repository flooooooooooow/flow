# @module examples.verify.math.derived
# @means  Intersection difference empty has bounded cardinality.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card((s ∩ t) \ empty) <= card(s ∪ t).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «cardinality» «inter diff empty card derived», «Finset» «cardinality» «inter union card bound derived»

theorem «Finset» «cardinality» «inter diff empty card bound» (s: Finset, t: Finset) {
    assume «Finset» «cardinality» «inter diff empty card derived»(s, t)
    assume «Finset» «cardinality» «inter union card bound derived»(s, t)
    therefore card((s ∩ t) \ empty) <= card(s ∪ t)
}

export «Finset» «cardinality» «inter diff empty card bound»