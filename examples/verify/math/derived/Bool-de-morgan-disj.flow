# @module examples.verify.math.derived
# @means  De Morgan law for disjunction and conjunction.
# @from   boole — https://en.wikipedia.org/wiki/De_Morgan%27s_laws
# @tier   derived

# @means  ¬(a ∨ b) = (¬a) ∧ (¬b).
# @from   boole
# @tier   derived
# @needs  «Bool» «negation» «double negation returns the value»

theorem «Bool» «negation» «de Morgan for disjunction and conjunction» (a: bool, b: bool) {
    if a == true {
        if b == true {
            therefore !(a or b) == (!a) and (!b)
        } else {
            therefore !(a or b) == (!a) and (!b)
        }
    } elif b == true {
        therefore !(a or b) == (!a) and (!b)
    } else {
        therefore !(a or b) == (!a) and (!b)
    }
}

export «Bool» «negation» «de Morgan for disjunction and conjunction»