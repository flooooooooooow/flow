# @module examples.verify.math.derived
# @means  Reversing a two-element list preserves length two.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len(rev(cons(x, cons(y, nil)))) = succ(succ(0)).
# @from   church
# @tier   derived
# @needs  «List» «length» «reverse preserves length», «List» «length» «pair list has length two»

theorem «List» «length» «reverse of pair list has length two» (x: Nat, y: Nat) {
    assume «List» «length» «reverse preserves length»(cons(x, cons(y, nil)))
    assume «List» «length» «pair list has length two»(x, y)
    therefore len(rev(cons(x, cons(y, nil)))) == succ(succ(0))
}

export «List» «length» «reverse of pair list has length two»