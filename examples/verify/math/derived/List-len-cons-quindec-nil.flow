# @module examples.verify.math.derived
# @means  Quindecuple cons ending in nil has length fifteen.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len of fifteen cons ending in nil equals 15.
# @from   church
# @tier   derived
# @needs  «List» «length» «cons increases length by one», «List» «length» «quattuordecuple cons nil has length fourteen»

theorem «List» «length» «quindecuple cons nil has length fifteen» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat, g: Nat, h: Nat, i: Nat, j: Nat, k: Nat, l: Nat, m: Nat, n: Nat, o: Nat) {
    assume «List» «length» «cons increases length by one»(cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, cons(k, cons(l, cons(m, cons(n, cons(o, nil)))))))))))))))
    assume «List» «length» «quattuordecuple cons nil has length fourteen»(b, c, d, e, f, g, h, i, j, k, l, m, n, o)
    therefore len(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, cons(k, cons(l, cons(m, cons(n, cons(o, nil))))))))))))))) == 15
}

export «List» «length» «quindecuple cons nil has length fifteen»