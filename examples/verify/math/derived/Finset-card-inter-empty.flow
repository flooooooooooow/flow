# @module examples.verify.math.derived
# @means  Intersecting with the empty set has cardinality zero.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card(s ∩ empty) = 0.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «intersection» «empty on the right gives empty», «Finset» «cardinality» «the empty set has size zero»

theorem «Finset» «cardinality» «intersection with empty has size zero» (s: Finset) {
    assume «Finset» «intersection» «empty on the right gives empty»(s)
    assume «Finset» «cardinality» «the empty set has size zero»()
    therefore card(s ∩ empty) == 0
}

export «Finset» «cardinality» «intersection with empty has size zero»