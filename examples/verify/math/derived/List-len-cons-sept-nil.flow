# @module examples.verify.math.derived
# @means  Septuple cons ending in nil has length seven.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, nil))))))) = 7.
# @from   church
# @tier   derived
# @needs  «List» «length» «cons increases length by one», «List» «length» «sextuple cons nil has length six»

theorem «List» «length» «septuple cons nil has length seven» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat, g: Nat) {
    assume «List» «length» «cons increases length by one»(cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, nil)))))))
    assume «List» «length» «sextuple cons nil has length six»(b, c, d, e, f, g)
    therefore len(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, nil))))))) == 7
}

export «List» «length» «septuple cons nil has length seven»