# @module examples.verify.math.derived
# @means  Choosing two from a successor set.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  choose(succ(n), 2) = choose(n, 1) + choose(n, 2).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Comb» «choose» «Pascal recurrence holds», «Comb» «choose» «choosing one gives the count»

theorem «Comb» «choose» «choosing two from a successor» (n: Nat) {
    assume «Comb» «choose» «Pascal recurrence holds»(succ(n), 2)
    assume «Comb» «choose» «choosing one gives the count»(n)
    therefore choose(succ(n), 2) == choose(n, 1) + choose(n, 2)
}

export «Comb» «choose» «choosing two from a successor»