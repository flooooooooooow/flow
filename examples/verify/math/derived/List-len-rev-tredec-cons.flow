# @module examples.verify.math.derived
# @means  Reverse preserves length of a tredecuple cons list.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len(rev(tredecuple cons ending in nil)) = 13.
# @from   church
# @tier   derived
# @needs  «List» «length» «reverse preserves length», «List» «length» «tredecuple cons nil has length thirteen»

theorem «List» «length» «reverse of tredecuple cons has length thirteen» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat, g: Nat, h: Nat, i: Nat, j: Nat, k: Nat, l: Nat, m: Nat) {
    assume «List» «length» «reverse preserves length»(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, cons(k, cons(l, cons(m, nil))))))))))))))
    assume «List» «length» «tredecuple cons nil has length thirteen»(a, b, c, d, e, f, g, h, i, j, k, l, m)
    therefore len(rev(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, cons(k, cons(l, cons(m, nil))))))))))))))) == 13
}

export «List» «length» «reverse of tredecuple cons has length thirteen»