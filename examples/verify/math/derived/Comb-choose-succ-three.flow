# @module examples.verify.math.derived
# @means  Choosing three from a successor set.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  choose(succ(n), 3) = choose(n, 2) + choose(n, 3).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Comb» «choose» «Pascal recurrence holds», «Comb» «choose» «choosing two via Pascal»

theorem «Comb» «choose» «choosing three from a successor» (n: Nat) {
    assume «Comb» «choose» «Pascal recurrence holds»(succ(n), 3)
    assume «Comb» «choose» «choosing two via Pascal»(n)
    therefore choose(succ(n), 3) == choose(n, 2) + choose(n, 3)
}

export «Comb» «choose» «choosing three from a successor»