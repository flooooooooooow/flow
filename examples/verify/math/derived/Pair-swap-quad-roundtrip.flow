# @module examples.verify.math.derived
# @means  Quadruple swap returns the original pair.
# @from   church — https://en.wikipedia.org/wiki/Product_type
# @tier   derived

# @means  swap(swap(swap(swap(pair(a, b))))) = pair(a, b).
# @from   church
# @tier   derived
# @needs  «Pair» «swap» «triple swap returns pair», «Pair» «swap» «compose swap twice is identity»

theorem «Pair» «swap» «quadruple swap returns pair» (a: Nat, b: Nat) {
    assume «Pair» «swap» «triple swap returns pair»(a, b)
    assume «Pair» «swap» «compose swap twice is identity»(a, b)
    therefore swap(swap(swap(swap(pair(a, b))))) == pair(a, b)
}

export «Pair» «swap» «quadruple swap returns pair»