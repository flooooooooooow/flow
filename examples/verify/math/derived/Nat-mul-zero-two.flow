# @module examples.verify.math.derived
# @means  Zero times two is zero for natural numbers.
# @from   peano — https://en.wikipedia.org/wiki/Peano_axioms
# @tier   derived

# @means  0 * 2 = 0.
# @from   peano
# @tier   derived
# @needs  «Nat» «multiplication» «zero is the left annihilator»

theorem «Nat» «multiplication» «zero times two is zero» () {
    let two = succ(succ(0))
    assume «Nat» «multiplication» «zero is the left annihilator»(two)
    therefore 0 * two == 0
}

export «Nat» «multiplication» «zero times two is zero»