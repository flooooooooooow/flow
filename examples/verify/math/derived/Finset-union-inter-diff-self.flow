# @module examples.verify.math.derived
# @means  Union intersect difference with self is empty.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  ((s ∪ t) ∩ s) \ ((s ∪ t) ∩ s) = empty.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «difference» «intersection diff self is empty», «Finset» «cardinality» «union intersect self card derived»

theorem «Finset» «difference» «union intersect diff self derived» (s: Finset, t: Finset) {
    assume «Finset» «difference» «intersection diff self is empty»(s, t)
    assume «Finset» «cardinality» «union intersect self card derived»(s, t)
    therefore ((s ∪ t) ∩ s) \ ((s ∪ t) ∩ s) == empty
}

export «Finset» «difference» «union intersect diff self derived»