# @module examples.verify.math.derived
# @means  Double reverse restores a duodecuple cons list.
# @from   church — https://en.wikipedia.org/wiki/Reverse_(list)
# @tier   derived

# @means  rev(rev(duodecuple cons with tail xs)) = duodecuple cons with tail xs.
# @from   church
# @tier   derived
# @needs  «List» «reverse» «reverse is an involution»

theorem «List» «reverse» «double reverse of duodecuple cons» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat, g: Nat, h: Nat, i: Nat, j: Nat, k: Nat, l: Nat, xs: List) {
    assume «List» «reverse» «reverse is an involution»(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, cons(k, cons(l, xs)))))))))))))
    therefore rev(rev(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, cons(k, cons(l, xs)))))))))))))) == cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, cons(k, cons(l, xs)))))))))))))
}

export «List» «reverse» «double reverse of duodecuple cons»