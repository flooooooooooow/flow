# @module examples.verify.math.derived
# @means  Intersection union then empty has cardinality zero.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card((s ∩ t) ∪ empty) = card(s ∩ t).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «cardinality» «union with empty preserves cardinality», «Finset» «cardinality» «inter union card bound derived»

theorem «Finset» «cardinality» «inter union empty card derived» (s: Finset, t: Finset) {
    assume «Finset» «cardinality» «union with empty preserves cardinality»(s ∩ t)
    assume «Finset» «cardinality» «inter union card bound derived»(s, t)
    therefore card((s ∩ t) ∪ empty) == card(s ∩ t)
}

export «Finset» «cardinality» «inter union empty card derived»