# @module examples.verify.math.derived
# @means  Choosing thirteen from a successor set.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  choose(succ(n), 13) = choose(n, 12) + choose(n, 13).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Comb» «choose» «Pascal recurrence holds», «Comb» «choose» «choosing twelve from a successor»

theorem «Comb» «choose» «choosing thirteen from a successor» (n: Nat) {
    assume «Comb» «choose» «Pascal recurrence holds»(succ(n), 13)
    assume «Comb» «choose» «choosing twelve from a successor»(n)
    therefore choose(succ(n), 13) == choose(n, 12) + choose(n, 13)
}

export «Comb» «choose» «choosing thirteen from a successor»