# @module examples.verify.math.derived
# @means  Six plus one is seven for natural numbers.
# @from   peano — https://en.wikipedia.org/wiki/Peano_axioms
# @tier   derived

# @means  6 + 1 = 7.
# @from   peano
# @tier   derived
# @needs  «Nat» «addition» «successor on the right via commutativity», «Nat» «addition» «zero is the right identity»

theorem «Nat» «addition» «six plus one is seven» () {
    let six = succ(succ(succ(succ(succ(succ(0))))))
    assume «Nat» «addition» «successor on the right via commutativity»(six, 0)
    assume «Nat» «addition» «zero is the right identity»(six)
    therefore six + succ(0) == succ(six)
}

export «Nat» «addition» «six plus one is seven»