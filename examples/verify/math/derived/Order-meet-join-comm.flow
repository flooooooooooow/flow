# @module examples.verify.math.derived
# @means  Meet below join commutes in arguments.
# @from   davey-priestley — *Introduction to Lattices and Order*
# @tier   derived

# @means  meet(a, b) <= join(a, b) and meet(b, a) <= join(b, a).
# @from   davey-priestley
# @tier   derived
# @needs  «Order» «lattice» «meet below join symmetric», «Order» «lattice» «meet is below join»

theorem «Order» «lattice» «meet below join commutes» (a: Nat, b: Nat) {
    assume «Order» «lattice» «meet below join symmetric»(a, b)
    assume «Order» «lattice» «meet is below join»(a, b)
    therefore meet(a, b) <= join(a, b)
}

export «Order» «lattice» «meet below join commutes»