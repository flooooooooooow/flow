# @module examples.verify.math.derived
# @means  A ring homomorphism sends zero times one to zero.
# @from   dummit-foote — *Abstract Algebra*, §7.3
# @tier   derived

# @means  f(0) * 1 = 0.
# @from   dummit-foote
# @tier   derived
# @needs  «RingHom» «zero» «zero maps to zero», «Ring» «multiplication» «zero on the left gives zero»

theorem «RingHom» «multiplication» «zero times one maps to zero» (f: RingHom) {
    assume «RingHom» «zero» «zero maps to zero»(f)
    assume «Ring» «multiplication» «zero on the left gives zero»(1)
    therefore f(0) * 1 == 0
}

export «RingHom» «multiplication» «zero times one maps to zero»