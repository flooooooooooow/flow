# @module examples.verify.math.derived
# @means  Five plus zero is five in a monoid witness.
# @from   dummit-foote — *Abstract Algebra*, §1.1
# @tier   derived

# @means  5 + 0 = 5.
# @from   dummit-foote
# @tier   derived
# @needs  «Monoid» «addition» «zero is the right additive identity», «Monoid» «addition» «four plus zero is four»

theorem «Monoid» «addition» «five plus zero is five» () {
    assume «Monoid» «addition» «zero is the right additive identity»(5)
    assume «Monoid» «addition» «four plus zero is four»()
    therefore 5 + 0 == 5
}

export «Monoid» «addition» «five plus zero is five»