# @module examples.verify.math.derived
# @means  Tredecuple cons ending in nil has length thirteen.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len of thirteen cons ending in nil equals 13.
# @from   church
# @tier   derived
# @needs  «List» «length» «cons increases length by one», «List» «length» «duodecuple cons nil has length twelve»

theorem «List» «length» «tredecuple cons nil has length thirteen» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat, g: Nat, h: Nat, i: Nat, j: Nat, k: Nat, l: Nat, m: Nat) {
    assume «List» «length» «cons increases length by one»(cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, cons(k, cons(l, cons(m, nil)))))))))))))
    assume «List» «length» «duodecuple cons nil has length twelve»(b, c, d, e, f, g, h, i, j, k, l, m)
    therefore len(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, cons(k, cons(l, cons(m, nil)))))))))))))) == 13
}

export «List» «length» «tredecuple cons nil has length thirteen»