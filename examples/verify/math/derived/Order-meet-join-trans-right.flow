# @module examples.verify.math.derived
# @means  Meet below join via right transitivity witness.
# @from   davey-priestley — *Introduction to Lattices and Order*
# @tier   derived

# @means  meet(a, b) <= join(b, a).
# @from   davey-priestley
# @tier   derived
# @needs  «Order» «lattice» «meet below join in dual order», «Order» «leq» «transitivity holds»

theorem «Order» «lattice» «meet below join via right transitivity» (a: Nat, b: Nat) {
    assume «Order» «lattice» «meet below join in dual order»(a, b)
    assume «Order» «leq» «transitivity holds»(meet(a, b), join(a, b), join(b, a))
    therefore meet(a, b) <= join(b, a)
}

export «Order» «lattice» «meet below join via right transitivity»