# @module examples.verify.math.derived
# @means  The inverse of the identity stays in a subgroup.
# @from   dummit-foote — *Abstract Algebra*, §2.2
# @tier   derived

# @means  inv(1) in H for every subgroup H.
# @from   dummit-foote
# @tier   derived
# @needs  «Subgroup» «inverse» «subgroup inverses stay in the subgroup», «Subgroup» «membership» «subgroups contain the identity»

theorem «Subgroup» «inverse» «identity inverse stays in the subgroup» (H: Subgroup) {
    if 1 in H {
        assume «Subgroup» «inverse» «subgroup inverses stay in the subgroup»(H, 1)
        assume «Subgroup» «membership» «subgroups contain the identity»(H)
        therefore inv(1) in H
    }
}

export «Subgroup» «inverse» «identity inverse stays in the subgroup»