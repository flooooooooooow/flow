# @module examples.verify.math.derived
# @means  Reversing a singleton preserves length one.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len(rev(cons(x, nil))) = succ(0).
# @from   church
# @tier   derived
# @needs  «List» «length» «reverse preserves length», «List» «length» «singleton has length one»

theorem «List» «length» «reverse of singleton has length one» (x: Nat) {
    assume «List» «length» «reverse preserves length»(cons(x, nil))
    assume «List» «length» «singleton has length one»(x)
    therefore len(rev(cons(x, nil))) == succ(0)
}

export «List» «length» «reverse of singleton has length one»