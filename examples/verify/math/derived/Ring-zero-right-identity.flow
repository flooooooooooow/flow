# @module examples.verify.math.derived
# @means  Zero is the right additive identity in a ring.
# @from   dummit-foote — *Abstract Algebra*, §7.1
# @tier   derived

# @means  r + 0 = r.
# @from   dummit-foote
# @tier   derived
# @needs  «Ring» «addition» «zero is the right identity»

theorem «Ring» «addition» «zero is the right additive identity» (r: Ring) {
    assume «Ring» «addition» «zero is the right identity»(r)
    therefore r + 0 == r
}

export «Ring» «addition» «zero is the right additive identity»