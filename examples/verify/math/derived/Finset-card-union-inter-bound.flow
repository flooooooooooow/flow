# @module examples.verify.math.derived
# @means  Union cardinality bounds intersection cardinality from below.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card(s ∩ t) <= card(s ∪ t).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «cardinality» «intersection card at most union card»

theorem «Finset» «cardinality» «union bounds intersection card derived» (s: Finset, t: Finset) {
    assume «Finset» «cardinality» «intersection card at most union card»(s, t)
    therefore card(s ∩ t) <= card(s ∪ t)
}

export «Finset» «cardinality» «union bounds intersection card derived»