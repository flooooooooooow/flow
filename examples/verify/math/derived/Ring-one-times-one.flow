# @module examples.verify.math.derived
# @means  One times one is one in a ring.
# @from   dummit-foote — *Abstract Algebra*, §7.1
# @tier   derived

# @means  1 * 1 = 1.
# @from   dummit-foote
# @tier   derived
# @needs  «Ring» «multiplication» «one is the left identity»

theorem «Ring» «multiplication» «one times one is one» () {
    assume «Ring» «multiplication» «one is the left identity»(1)
    therefore 1 * 1 == 1
}

export «Ring» «multiplication» «one times one is one»