# @module examples.verify.math.derived
# @means  Choosing fifteen from a successor set.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  choose(succ(n), 15) = choose(n, 14) + choose(n, 15).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Comb» «choose» «Pascal recurrence holds», «Comb» «choose» «choosing fourteen from a successor»

theorem «Comb» «choose» «choosing fifteen from a successor» (n: Nat) {
    assume «Comb» «choose» «Pascal recurrence holds»(succ(n), 15)
    assume «Comb» «choose» «choosing fourteen from a successor»(n)
    therefore choose(succ(n), 15) == choose(n, 14) + choose(n, 15)
}

export «Comb» «choose» «choosing fifteen from a successor»