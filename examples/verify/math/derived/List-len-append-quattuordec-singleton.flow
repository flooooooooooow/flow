# @module examples.verify.math.derived
# @means  Appending fourteen singletons gives length fourteen.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len of fourteen appended singletons equals 14.
# @from   church
# @tier   derived
# @needs  «List» «length» «append preserves length sum», «List» «length» «append of thirteen singletons has length thirteen»

theorem «List» «length» «append of fourteen singletons has length fourteen» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat, g: Nat, h: Nat, i: Nat, j: Nat, k: Nat, l: Nat, m: Nat, n: Nat) {
    assume «List» «length» «append preserves length sum»(cons(a, nil) ++ cons(b, nil) ++ cons(c, nil) ++ cons(d, nil) ++ cons(e, nil) ++ cons(f, nil) ++ cons(g, nil) ++ cons(h, nil) ++ cons(i, nil) ++ cons(j, nil) ++ cons(k, nil) ++ cons(l, nil) ++ cons(m, nil), cons(n, nil))
    assume «List» «length» «append of thirteen singletons has length thirteen»(a, b, c, d, e, f, g, h, i, j, k, l, m)
    therefore len(cons(a, nil) ++ cons(b, nil) ++ cons(c, nil) ++ cons(d, nil) ++ cons(e, nil) ++ cons(f, nil) ++ cons(g, nil) ++ cons(h, nil) ++ cons(i, nil) ++ cons(j, nil) ++ cons(k, nil) ++ cons(l, nil) ++ cons(m, nil) ++ cons(n, nil)) == 14
}

export «List» «length» «append of fourteen singletons has length fourteen»