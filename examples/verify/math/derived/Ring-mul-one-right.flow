# @module examples.verify.math.derived
# @means  One is the right multiplicative identity in a ring.
# @from   dummit-foote — *Abstract Algebra*, §7.1
# @tier   derived

# @means  r * 1 = r.
# @from   dummit-foote
# @tier   derived
# @needs  «Ring» «multiplication» «one is the left identity», «Ring» «multiplication» «parentheses do not matter»

theorem «Ring» «multiplication» «one is the right identity» (r: Ring) {
    assume «Ring» «multiplication» «one is the left identity»(r)
    assume «Ring» «multiplication» «parentheses do not matter»(r, 1, 1)
    therefore r * 1 == r
}

export «Ring» «multiplication» «one is the right identity»