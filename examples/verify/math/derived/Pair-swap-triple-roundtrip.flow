# @module examples.verify.math.derived
# @means  Triple swap returns the original pair.
# @from   church — https://en.wikipedia.org/wiki/Product_type
# @tier   derived

# @means  swap(swap(swap(pair(a, b)))) = pair(a, b).
# @from   church
# @tier   derived
# @needs  «Pair» «swap» «compose swap twice is identity», «Pair» «swap» «swap exchanges components»

theorem «Pair» «swap» «triple swap returns pair» (a: Nat, b: Nat) {
    assume «Pair» «swap» «compose swap twice is identity»(a, b)
    assume «Pair» «swap» «swap exchanges components»(a, b)
    therefore swap(swap(swap(pair(a, b)))) == pair(a, b)
}

export «Pair» «swap» «triple swap returns pair»