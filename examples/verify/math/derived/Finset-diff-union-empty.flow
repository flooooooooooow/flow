# @module examples.verify.math.derived
# @means  Difference of union with empty is the union.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  (s ∪ t) \ empty = s ∪ t.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «difference» «difference with empty preserves the set»

theorem «Finset» «difference» «union difference empty derived» (s: Finset, t: Finset) {
    assume «Finset» «difference» «difference with empty preserves the set»(s ∪ t)
    therefore (s ∪ t) \ empty == s ∪ t
}

export «Finset» «difference» «union difference empty derived»