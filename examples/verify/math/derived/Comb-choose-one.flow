# @module examples.verify.math.derived
# @means  Choosing one item from n gives n possibilities.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  choose(n, 1) = n.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Comb» «choose» «Pascal recurrence holds», «Comb» «choose» «choosing none gives one»

theorem «Comb» «choose» «choosing one gives the count» (n: Nat) {
    assume «Comb» «choose» «choosing none gives one»(pred(n))
    assume «Comb» «choose» «Pascal recurrence holds»(n, 1)
    therefore choose(n, 1) == n
}

export «Comb» «choose» «choosing one gives the count»