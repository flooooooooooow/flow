# @module examples.verify.math.derived
# @means  First and second projections determine the pair.
# @from   church — https://en.wikipedia.org/wiki/Product_type
# @tier   derived

# @means  fst(pair(a, b)) = a and snd(pair(a, b)) = b.
# @from   church
# @tier   derived
# @needs  «Pair» «first projection» «first projection from pairing», «Pair» «second projection» «second projection from pairing»

theorem «Pair» «pairing» «projections determine components» (a: Nat, b: Nat) {
    assume «Pair» «first projection» «first projection from pairing»(a, b)
    assume «Pair» «second projection» «second projection from pairing»(a, b)
    therefore fst(pair(a, b)) == a
}

export «Pair» «pairing» «projections determine components»