# @module examples.verify.math.derived
# @means  Zero plus one is one in a ring.
# @from   dummit-foote — *Abstract Algebra*, §7.1
# @tier   derived

# @means  0 + 1 = 1.
# @from   dummit-foote
# @tier   derived
# @needs  «Ring» «addition» «zero is the left identity»

theorem «Ring» «addition» «zero plus one is one» () {
    assume «Ring» «addition» «zero is the left identity»(1)
    therefore 0 + 1 == 1
}

export «Ring» «addition» «zero plus one is one»