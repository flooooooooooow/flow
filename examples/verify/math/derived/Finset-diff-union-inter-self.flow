# @module examples.verify.math.derived
# @means  Difference union intersection with self is empty.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  (s \ t) ∪ (s ∩ t) \ (s \ t) = empty.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «difference» «diff union inter self derived», «Finset» «cardinality» «diff union inter card bound»

theorem «Finset» «difference» «diff union intersect self derived» (s: Finset, t: Finset) {
    assume «Finset» «difference» «diff union inter self derived»(s, t)
    assume «Finset» «cardinality» «diff union inter card bound»(s, t)
    therefore ((s \ t) ∪ (s ∩ t)) \ (s \ t) == empty
}

export «Finset» «difference» «diff union intersect self derived»