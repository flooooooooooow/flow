# @module examples.verify.math.derived
# @means  Intersection commutes as a derived consequence.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  a ∩ b = b ∩ a.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «intersection» «order does not matter»

theorem «Finset» «intersection» «intersection commutes derived» (a: Finset, b: Finset) {
    assume «Finset» «intersection» «order does not matter»(a, b)
    therefore a ∩ b == b ∩ a
}

export «Finset» «intersection» «intersection commutes derived»