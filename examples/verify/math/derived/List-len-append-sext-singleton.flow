# @module examples.verify.math.derived
# @means  Appending six singletons gives length six.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len of six appended singletons equals 6.
# @from   church
# @tier   derived
# @needs  «List» «length» «append preserves length sum», «List» «length» «append of five singletons has length five»

theorem «List» «length» «append of six singletons has length six» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat) {
    assume «List» «length» «append preserves length sum»(cons(a, nil) ++ cons(b, nil) ++ cons(c, nil) ++ cons(d, nil) ++ cons(e, nil), cons(f, nil))
    assume «List» «length» «append of five singletons has length five»(a, b, c, d, e)
    therefore len(cons(a, nil) ++ cons(b, nil) ++ cons(c, nil) ++ cons(d, nil) ++ cons(e, nil) ++ cons(f, nil)) == 6
}

export «List» «length» «append of six singletons has length six»