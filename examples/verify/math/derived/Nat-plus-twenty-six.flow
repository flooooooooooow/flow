# @module examples.verify.math.derived
# @means  Twenty-five plus one is twenty-six.
# @from   peano — https://en.wikipedia.org/wiki/Peano_axioms
# @tier   derived

# @means  25 + 1 = 26.
# @from   peano
# @tier   derived
# @needs  «Nat» «addition» «twenty four plus one is twenty five»

theorem «Nat» «addition» «twenty five plus one is twenty six» () {
    assume «Nat» «addition» «twenty four plus one is twenty five»()
    therefore 25 + 1 == 26
}

export «Nat» «addition» «twenty five plus one is twenty six»