# @module examples.verify.math.derived
# @means  Choosing three from a successor derived from Pascal.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  choose(succ(n), 3) = choose(n, 2) + choose(n, 3).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Comb» «choose» «choosing three from a successor»

theorem «Comb» «choose» «choosing three from a successor derived» (n: Nat) {
    assume «Comb» «choose» «choosing three from a successor»(n)
    therefore choose(succ(n), 3) == choose(n, 2) + choose(n, 3)
}

export «Comb» «choose» «choosing three from a successor derived»