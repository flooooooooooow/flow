# @module examples.verify.math.derived
# @means  Twelve plus zero maps to twelve under a ring homomorphism.
# @from   dummit-foote — *Abstract Algebra*, §7.3
# @tier   derived

# @means  f(12 + 0) = 12.
# @from   dummit-foote
# @tier   derived
# @needs  «RingHom» «preservation» «homomorphisms preserve addition», «Ring» «addition» «one plus one derived»

theorem «RingHom» «preservation» «twelve plus zero maps to twelve» (f: RingHom) {
    assume «RingHom» «preservation» «homomorphisms preserve addition»(f, 12, 0)
    assume «Ring» «addition» «one plus one derived»()
    therefore f(12 + 0) == 12
}

export «RingHom» «preservation» «twelve plus zero maps to twelve»