# @module examples.verify.math.derived
# @means  Reverse preserves length of a septuple cons list.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len(rev(septuple cons ending in nil)) = 7.
# @from   church
# @tier   derived
# @needs  «List» «length» «reverse preserves length», «List» «length» «septuple cons nil has length seven»

theorem «List» «length» «reverse of septuple cons has length seven» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat, g: Nat) {
    assume «List» «length» «reverse preserves length»(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, nil))))))))
    assume «List» «length» «septuple cons nil has length seven»(a, b, c, d, e, f, g)
    therefore len(rev(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, nil)))))))) == 7
}

export «List» «length» «reverse of septuple cons has length seven»