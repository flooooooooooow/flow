# @module examples.verify.math.derived
# @means  Swapping twice restores the second projection.
# @from   church — https://en.wikipedia.org/wiki/Product_type
# @tier   derived

# @means  snd(swap(swap(pair(a, b)))) = b.
# @from   church
# @tier   derived
# @needs  «Pair» «second projection» «second component is retrieved», «Pair» «swap» «double swap returns the pair»

theorem «Pair» «swap» «double swap preserves second projection» (a: Nat, b: Nat) {
    assume «Pair» «second projection» «second component is retrieved»(a, b)
    assume «Pair» «swap» «double swap returns the pair»(a, b)
    therefore snd(swap(swap(pair(a, b)))) == b
}

export «Pair» «swap» «double swap preserves second projection»