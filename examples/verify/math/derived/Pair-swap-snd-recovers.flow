# @module examples.verify.math.derived
# @means  Swapping recovers the second component as first.
# @from   church — https://en.wikipedia.org/wiki/Product_type
# @tier   derived

# @means  snd(swap(pair(a, b))) = a.
# @from   church
# @tier   derived
# @needs  «Pair» «swap» «swap exchanges components», «Pair» «second projection» «second projection from pairing»

theorem «Pair» «swap» «swap recovers second as first» (a: Nat, b: Nat) {
    assume «Pair» «swap» «swap exchanges components»(a, b)
    assume «Pair» «second projection» «second projection from pairing»(b, a)
    therefore snd(swap(pair(a, b))) == a
}

export «Pair» «swap» «swap recovers second as first»