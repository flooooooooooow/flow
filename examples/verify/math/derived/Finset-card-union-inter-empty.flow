# @module examples.verify.math.derived
# @means  Union intersected with empty has cardinality zero.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card((a ∪ b) ∩ empty) = 0.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «intersection» «union with empty on the right annihilates», «Finset» «cardinality» «the empty set has size zero»

theorem «Finset» «cardinality» «union intersect empty has size zero» (a: Finset, b: Finset) {
    assume «Finset» «intersection» «union with empty on the right annihilates»(a, b)
    assume «Finset» «cardinality» «the empty set has size zero»()
    therefore card((a ∪ b) ∩ empty) == 0
}

export «Finset» «cardinality» «union intersect empty has size zero»