# @module examples.verify.math.derived
# @means  Join absorbs meet as a derived lattice law.
# @from   davey-priestley — *Introduction to Lattices and Order*
# @tier   derived

# @means  join(a, meet(a, b)) = a.
# @from   davey-priestley
# @tier   derived
# @needs  «Order» «join» «join absorbs meet»

theorem «Order» «join» «join absorbs meet derived» (a: Nat, b: Nat) {
    assume «Order» «join» «join absorbs meet»(a, b)
    therefore join(a, meet(a, b)) == a
}

export «Order» «join» «join absorbs meet derived»