# @module examples.verify.math.derived
# @means  Union difference intersection empty has bounded cardinality.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card((s ∪ t) \ (s ∩ t)) <= card(s ∪ t).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «cardinality» «union diff inter empty card derived», «Finset» «cardinality» «union intersect card bound derived»

theorem «Finset» «cardinality» «union diff inter empty card bound» (s: Finset, t: Finset) {
    assume «Finset» «cardinality» «union diff inter empty card derived»(s, t)
    assume «Finset» «cardinality» «union intersect card bound derived»(s, t)
    therefore card((s ∪ t) \ (s ∩ t)) <= card(s ∪ t)
}

export «Finset» «cardinality» «union diff inter empty card bound»