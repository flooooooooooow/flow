# @module examples.verify.math.derived
# @means  Three plus zero is three in a monoid witness.
# @from   dummit-foote — *Abstract Algebra*, §1.1
# @tier   derived

# @means  3 + 0 = 3.
# @from   dummit-foote
# @tier   derived
# @needs  «Monoid» «addition» «zero is the right additive identity», «Monoid» «addition» «two plus zero is two»

theorem «Monoid» «addition» «three plus zero is three» () {
    assume «Monoid» «addition» «zero is the right additive identity»(3)
    assume «Monoid» «addition» «two plus zero is two»()
    therefore 3 + 0 == 3
}

export «Monoid» «addition» «three plus zero is three»