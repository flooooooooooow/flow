# @module examples.verify.math.derived
# @means  Self-union intersected with empty is empty.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  (s ∪ s) ∩ empty = empty.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «union» «repeating does not change the set», «Finset» «intersection» «empty on the right gives empty»

theorem «Finset» «intersection» «self union intersect empty is empty» (s: Finset) {
    assume «Finset» «union» «repeating does not change the set»(s)
    assume «Finset» «intersection» «empty on the right gives empty»(s ∪ s)
    therefore (s ∪ s) ∩ empty == empty
}

export «Finset» «intersection» «self union intersect empty is empty»