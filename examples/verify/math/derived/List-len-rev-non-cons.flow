# @module examples.verify.math.derived
# @means  Reverse preserves length of a nonuple cons list.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len(rev(nonuple cons ending in nil)) = 9.
# @from   church
# @tier   derived
# @needs  «List» «length» «reverse preserves length», «List» «length» «nonuple cons nil has length nine»

theorem «List» «length» «reverse of nonuple cons has length nine» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat, g: Nat, h: Nat, i: Nat) {
    assume «List» «length» «reverse preserves length»(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, nil))))))))))
    assume «List» «length» «nonuple cons nil has length nine»(a, b, c, d, e, f, g, h, i)
    therefore len(rev(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, nil))))))))))) == 9
}

export «List» «length» «reverse of nonuple cons has length nine»