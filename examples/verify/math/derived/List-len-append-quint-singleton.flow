# @module examples.verify.math.derived
# @means  Appending five singletons gives length five.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len(cons(a, nil) ++ cons(b, nil) ++ cons(c, nil) ++ cons(d, nil) ++ cons(e, nil)) = 5.
# @from   church
# @tier   derived
# @needs  «List» «length» «append preserves length sum», «List» «length» «append of four singletons has length four»

theorem «List» «length» «append of five singletons has length five» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat) {
    assume «List» «length» «append preserves length sum»(cons(a, nil) ++ cons(b, nil) ++ cons(c, nil) ++ cons(d, nil), cons(e, nil))
    assume «List» «length» «append of four singletons has length four»(a, b, c, d)
    therefore len(cons(a, nil) ++ cons(b, nil) ++ cons(c, nil) ++ cons(d, nil) ++ cons(e, nil)) == 5
}

export «List» «length» «append of five singletons has length five»