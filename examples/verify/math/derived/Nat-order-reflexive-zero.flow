# @module examples.verify.math.derived
# @means  Zero is less than or equal to itself.
# @from   peano — https://en.wikipedia.org/wiki/Total_order
# @tier   derived

# @means  0 <= 0.
# @from   peano
# @tier   derived
# @needs  «Nat» «order» «less-or-equal is reflexive»

theorem «Nat» «order» «zero is below itself» () {
    assume «Nat» «order» «less-or-equal is reflexive»(0)
    therefore 0 <= 0
}

export «Nat» «order» «zero is below itself»