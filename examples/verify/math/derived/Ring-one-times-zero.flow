# @module examples.verify.math.derived
# @means  One times zero is zero in a ring.
# @from   dummit-foote — *Abstract Algebra*, §7.1
# @tier   derived

# @means  1 * 0 = 0.
# @from   dummit-foote
# @tier   derived
# @needs  «Ring» «multiplication» «zero on the right gives zero»

theorem «Ring» «multiplication» «one times zero is zero» () {
    assume «Ring» «multiplication» «zero on the right gives zero»(1)
    therefore 1 * 0 == 0
}

export «Ring» «multiplication» «one times zero is zero»