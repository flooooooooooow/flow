# @module examples.verify.math.derived
# @means  Zero plus zero stays in an ideal.
# @from   dummit-foote — *Abstract Algebra*, §7.3
# @tier   derived

# @means  If 0 in I then 0 + 0 in I.
# @from   dummit-foote
# @tier   derived
# @needs  «Ideal» «addition» «ideal sums stay in the ideal», «Ideal» «membership» «ideals contain zero»

theorem «Ideal» «addition» «zero plus zero stays in the ideal derived» (I: Ideal) {
    if 0 in I {
        assume «Ideal» «addition» «ideal sums stay in the ideal»(I, 0, 0)
        assume «Ideal» «membership» «ideals contain zero»(I)
        therefore 0 + 0 in I
    }
}

export «Ideal» «addition» «zero plus zero stays in the ideal derived»