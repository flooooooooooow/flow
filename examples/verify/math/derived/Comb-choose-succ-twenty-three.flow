# @module examples.verify.math.derived
# @means  Choosing twenty-three from a successor set.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  choose(succ(n), 23) = choose(n, 22) + choose(n, 23).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Comb» «choose» «Pascal recurrence holds», «Comb» «choose» «choosing twenty two from a successor»

theorem «Comb» «choose» «choosing twenty three from a successor» (n: Nat) {
    assume «Comb» «choose» «Pascal recurrence holds»(succ(n), 23)
    assume «Comb» «choose» «choosing twenty two from a successor»(n)
    therefore choose(succ(n), 23) == choose(n, 22) + choose(n, 23)
}

export «Comb» «choose» «choosing twenty three from a successor»