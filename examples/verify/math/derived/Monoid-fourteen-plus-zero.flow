# @module examples.verify.math.derived
# @means  Fourteen plus zero is fourteen in a monoid witness.
# @from   dummit-foote — *Abstract Algebra*, §1.1
# @tier   derived

# @means  14 + 0 = 14.
# @from   dummit-foote
# @tier   derived
# @needs  «Monoid» «addition» «zero is the right additive identity», «Monoid» «addition» «thirteen plus zero is thirteen»

theorem «Monoid» «addition» «fourteen plus zero is fourteen» () {
    assume «Monoid» «addition» «zero is the right additive identity»(14)
    assume «Monoid» «addition» «thirteen plus zero is thirteen»()
    therefore 14 + 0 == 14
}

export «Monoid» «addition» «fourteen plus zero is fourteen»