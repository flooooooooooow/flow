# @module examples.verify.math.derived
# @means  Difference with empty leaves cardinality unchanged.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card(s \ empty) = card(s).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «cardinality» «difference with empty preserves cardinality»

theorem «Finset» «cardinality» «difference with empty preserves cardinality» (s: Finset) {
    assume «Finset» «cardinality» «difference with empty preserves cardinality»(s)
    therefore card(s \ empty) == card(s)
}

export «Finset» «cardinality» «difference with empty preserves cardinality»