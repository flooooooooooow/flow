# @module examples.verify.math.derived
# @means  Meet absorbs join as a derived lattice law.
# @from   davey-priestley — *Introduction to Lattices and Order*
# @tier   derived

# @means  meet(a, join(a, b)) = a.
# @from   davey-priestley
# @tier   derived
# @needs  «Order» «meet» «meet absorbs join»

theorem «Order» «meet» «meet absorbs join derived» (a: Nat, b: Nat) {
    assume «Order» «meet» «meet absorbs join»(a, b)
    therefore meet(a, join(a, b)) == a
}

export «Order» «meet» «meet absorbs join derived»