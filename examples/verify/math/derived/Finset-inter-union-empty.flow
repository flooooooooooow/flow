# @module examples.verify.math.derived
# @means  Intersection distributes over union against empty.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  (a ∪ b) ∩ empty = empty.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «intersection» «union with empty on the right annihilates», «Finset» «union» «order does not matter»

theorem «Finset» «intersection» «intersection with empty after union annihilates» (a: Finset, b: Finset) {
    assume «Finset» «intersection» «union with empty on the right annihilates»(a, b)
    assume «Finset» «union» «order does not matter»(a, b)
    therefore (a ∪ b) ∩ empty == empty
}

export «Finset» «intersection» «intersection with empty after union annihilates»