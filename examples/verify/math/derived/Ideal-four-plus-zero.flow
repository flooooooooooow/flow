# @module examples.verify.math.derived
# @means  Four plus zero is four in an ideal witness.
# @from   dummit-foote — *Abstract Algebra*, §7.1
# @tier   derived

# @means  4 + 0 = 4 in an ideal.
# @from   dummit-foote
# @tier   derived
# @needs  «Ideal» «addition» «zero is the right additive identity», «Ideal» «addition» «three plus zero in ideal»

theorem «Ideal» «addition» «four plus zero in ideal» () {
    assume «Ideal» «addition» «zero is the right additive identity»(4)
    assume «Ideal» «addition» «three plus zero in ideal»()
    therefore 4 + 0 == 4
}

export «Ideal» «addition» «four plus zero in ideal»