# @module examples.verify.math.derived
# @means  Union intersected with empty vanishes.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  (s ∪ t) ∩ empty = empty.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «intersection» «intersecting with empty gives empty»

theorem «Finset» «intersection» «union intersect empty derived» (s: Finset, t: Finset) {
    assume «Finset» «intersection» «intersecting with empty gives empty»(s ∪ t)
    therefore (s ∪ t) ∩ empty == empty
}

export «Finset» «intersection» «union intersect empty derived»