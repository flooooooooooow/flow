# @module examples.verify.math.derived
# @means  Join above meet is preserved under transitivity.
# @from   davey-priestley — *Introduction to Lattices and Order*
# @tier   derived

# @means  If meet(a, b) <= c and join(a, b) >= c then join(a, b) >= meet(a, b).
# @from   davey-priestley
# @tier   derived
# @needs  «Order» «lattice» «meet is below join», «Order» «leq» «transitivity holds»

theorem «Order» «lattice» «join above meet via transitivity» (a: Nat, b: Nat, c: Nat) {
    assume «Order» «lattice» «meet is below join»(a, b)
    assume «Order» «leq» «transitivity holds»(meet(a, b), c, join(a, b))
    therefore join(a, b) >= meet(a, b)
}

export «Order» «lattice» «join above meet via transitivity»