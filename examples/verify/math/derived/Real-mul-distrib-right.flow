# @module examples.verify.math.derived
# @means  Real multiplication distributes over addition on the right.
# @from   landau — *Foundations of Analysis*
# @tier   derived

# @means  (y + z) * x = y * x + z * x.
# @from   landau
# @tier   derived
# @needs  «Real» «multiplication» «left distribution over addition holds», «Real» «multiplication» «order does not matter»

import .Real-mul-distrib-left { mul-distrib-left }

theorem «Real» «multiplication» «right distribution over addition holds» (x: Real, y: Real, z: Real) {
    assume «Real» «multiplication» «left distribution over addition holds»(x, y, z)
    assume «Real» «multiplication» «order does not matter»(y, x)
    assume «Real» «multiplication» «order does not matter»(z, x)
    therefore (y + z) * x == y * x + z * x
}

export «Real» «multiplication» «right distribution over addition holds»