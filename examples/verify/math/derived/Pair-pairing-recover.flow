# @module examples.verify.math.derived
# @means  Pairing projections recovers the original pair.
# @from   church — https://en.wikipedia.org/wiki/Product_type
# @tier   derived

# @means  pair(a, b) = pair(fst(pair(a, b)), snd(pair(a, b))).
# @from   church
# @tier   derived
# @needs  «Pair» «first projection» «first component is retrieved», «Pair» «second projection» «second component is retrieved», «Pair» «pairing» «components determine the pair»

theorem «Pair» «pairing» «pairing recovers projections» (a: Nat, b: Nat) {
    assume «Pair» «first projection» «first component is retrieved»(a, b)
    assume «Pair» «second projection» «second component is retrieved»(a, b)
    assume «Pair» «pairing» «components determine the pair»(a, b)
    therefore pair(a, b) == pair(fst(pair(a, b)), snd(pair(a, b)))
}

export «Pair» «pairing» «pairing recovers projections»