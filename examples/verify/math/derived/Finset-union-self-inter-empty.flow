# @module examples.verify.math.derived
# @means  Self-union intersected with empty vanishes.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  (s ∪ s) ∩ empty = empty.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «intersection» «self union intersect empty is empty»

theorem «Finset» «intersection» «self union intersect empty derived» (s: Finset) {
    assume «Finset» «intersection» «self union intersect empty is empty»(s)
    therefore (s ∪ s) ∩ empty == empty
}

export «Finset» «intersection» «self union intersect empty derived»