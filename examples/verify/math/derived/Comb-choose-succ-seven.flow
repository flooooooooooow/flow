# @module examples.verify.math.derived
# @means  Choosing seven from a successor set.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  choose(succ(n), 7) = choose(n, 6) + choose(n, 7).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Comb» «choose» «Pascal recurrence holds», «Comb» «choose» «choosing six from a successor»

theorem «Comb» «choose» «choosing seven from a successor» (n: Nat) {
    assume «Comb» «choose» «Pascal recurrence holds»(succ(n), 7)
    assume «Comb» «choose» «choosing six from a successor»(n)
    therefore choose(succ(n), 7) == choose(n, 6) + choose(n, 7)
}

export «Comb» «choose» «choosing seven from a successor»