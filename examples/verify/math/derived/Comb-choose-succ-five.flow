# @module examples.verify.math.derived
# @means  Choosing five from a successor set.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  choose(succ(n), 5) = choose(n, 4) + choose(n, 5).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Comb» «choose» «Pascal recurrence holds», «Comb» «choose» «choosing four from a successor»

theorem «Comb» «choose» «choosing five from a successor» (n: Nat) {
    assume «Comb» «choose» «Pascal recurrence holds»(succ(n), 5)
    assume «Comb» «choose» «choosing four from a successor»(n)
    therefore choose(succ(n), 5) == choose(n, 4) + choose(n, 5)
}

export «Comb» «choose» «choosing five from a successor»