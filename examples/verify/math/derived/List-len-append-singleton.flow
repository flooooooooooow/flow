# @module examples.verify.math.derived
# @means  Appending a singleton increases length by one.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len(xs ++ cons(y, nil)) = succ(len(xs)).
# @from   church
# @tier   derived
# @needs  «List» «length» «length adds under append», «Nat» «addition» «successor on the right via commutativity»

theorem «List» «length» «append singleton increases length by one» (xs: List, y: Nat) {
    assume «List» «length» «length adds under append»(xs, cons(y, nil))
    assume «Nat» «addition» «successor on the right via commutativity»(len(xs), 0)
    therefore len(xs ++ cons(y, nil)) == succ(len(xs))
}

export «List» «length» «append singleton increases length by one»