# @module examples.verify.math.derived
# @means  The empty list has length zero.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len(nil) = 0.
# @from   church
# @tier   derived
# @needs  «List» «append» «empty is the left identity», «Nat» «addition» «zero is the left identity»

theorem «List» «length» «the empty list has length zero» () {
    assume «List» «append» «empty is the left identity»(nil)
    assume «Nat» «addition» «zero is the left identity»(0)
    therefore len(nil) == 0
}

export «List» «length» «the empty list has length zero»