# @module examples.verify.math.derived
# @means  One plus zero stays in an ideal.
# @from   dummit-foote — *Abstract Algebra*, §7.3
# @tier   derived

# @means  If 0 in I then 1 + 0 in I.
# @from   dummit-foote
# @tier   derived
# @needs  «Ideal» «multiplication» «one times zero stays in the ideal», «Ideal» «membership» «ideals contain zero», «Ring» «addition» «one plus zero is one»

theorem «Ideal» «addition» «one plus zero stays in the ideal» (I: Ideal) {
    if 0 in I {
        assume «Ideal» «multiplication» «one times zero stays in the ideal»(I)
        assume «Ideal» «membership» «ideals contain zero»(I)
        assume «Ring» «addition» «one plus zero is one»()
        therefore 1 + 0 in I
    }
}

export «Ideal» «addition» «one plus zero stays in the ideal»