# @module examples.verify.math.derived
# @means  Reverse preserves length of a quintuple cons list.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len(rev(cons(a, cons(b, cons(c, cons(d, cons(e, nil))))))) = 5.
# @from   church
# @tier   derived
# @needs  «List» «length» «reverse preserves length», «List» «length» «quintuple cons nil has length five»

theorem «List» «length» «reverse of quintuple cons has length five» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat) {
    assume «List» «length» «reverse preserves length»(cons(a, cons(b, cons(c, cons(d, cons(e, nil))))))
    assume «List» «length» «quintuple cons nil has length five»(a, b, c, d, e)
    therefore len(rev(cons(a, cons(b, cons(c, cons(d, cons(e, nil))))))) == 5
}

export «List» «length» «reverse of quintuple cons has length five»