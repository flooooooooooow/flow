# @module examples.verify.math.derived
# @means  Tredecuple swap returns the original pair.
# @from   church — https://en.wikipedia.org/wiki/Product_type
# @tier   derived

# @means  thirteen nested swaps on a pair returns the pair.
# @from   church
# @tier   derived
# @needs  «Pair» «swap» «duodecuple swap returns pair», «Pair» «swap» «undecuple swap returns pair»

theorem «Pair» «swap» «tredecuple swap returns pair» (a: Nat, b: Nat) {
    assume «Pair» «swap» «duodecuple swap returns pair»(a, b)
    assume «Pair» «swap» «undecuple swap returns pair»(a, b)
    therefore swap(swap(swap(swap(swap(swap(swap(swap(swap(swap(swap(swap(swap(pair(a, b))))))))))))))) == pair(a, b)
}

export «Pair» «swap» «tredecuple swap returns pair»