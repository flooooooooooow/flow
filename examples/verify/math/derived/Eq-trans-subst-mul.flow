# @module examples.verify.math.derived
# @means  Transitive equality preserves right multiplication.
# @from   leibniz — https://en.wikipedia.org/wiki/Substitution_(logic)
# @tier   derived

# @means  If a = b and b = c then a * d = c * d.
# @from   leibniz
# @tier   derived
# @needs  «Eq» «equality» «equal terms multiply the same on the right», «Eq» «equality» «equality reverses»

import .Eq-symmetric { eq-symmetric }

theorem «Eq» «equality» «transitive substitution on multiplication» (a: Nat, b: Nat, c: Nat, d: Nat) {
    if a == b {
        if b == c {
            assume «Eq» «equality» «equal terms multiply the same on the right»(a, b, d)
            assume «Eq» «equality» «equality reverses»(b, c)
            assume «Eq» «equality» «equal terms multiply the same on the right»(b, c, d)
            therefore a * d == c * d
        }
    }
}

export «Eq» «equality» «transitive substitution on multiplication»