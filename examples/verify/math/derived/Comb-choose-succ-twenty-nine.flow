# @module examples.verify.math.derived
# @means  Choosing twenty-nine from a successor set.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  choose(succ(n), 29) = choose(n, 28) + choose(n, 29).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Comb» «choose» «Pascal recurrence holds», «Comb» «choose» «choosing twenty eight from a successor»

theorem «Comb» «choose» «choosing twenty nine from a successor» (n: Nat) {
    assume «Comb» «choose» «Pascal recurrence holds»(succ(n), 29)
    assume «Comb» «choose» «choosing twenty eight from a successor»(n)
    therefore choose(succ(n), 29) == choose(n, 28) + choose(n, 29)
}

export «Comb» «choose» «choosing twenty nine from a successor»