# @module examples.verify.math.derived
# @means  Sixteen plus zero is sixteen in a monoid witness.
# @from   dummit-foote — *Abstract Algebra*, §1.1
# @tier   derived

# @means  16 + 0 = 16.
# @from   dummit-foote
# @tier   derived
# @needs  «Monoid» «addition» «zero is the right additive identity», «Monoid» «addition» «fifteen plus zero is fifteen»

theorem «Monoid» «addition» «sixteen plus zero is sixteen» () {
    assume «Monoid» «addition» «zero is the right additive identity»(16)
    assume «Monoid» «addition» «fifteen plus zero is fifteen»()
    therefore 16 + 0 == 16
}

export «Monoid» «addition» «sixteen plus zero is sixteen»