# @module examples.verify.math.derived
# @means  Triple cons ending in nil has length three.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len(cons(a, cons(b, cons(c, nil)))) = 3.
# @from   church
# @tier   derived
# @needs  «List» «length» «cons increases length by one», «List» «length» «double cons has length two»

theorem «List» «length» «triple cons nil has length three» (a: Nat, b: Nat, c: Nat) {
    assume «List» «length» «cons increases length by one»(cons(b, cons(c, nil)))
    assume «List» «length» «double cons has length two»(b, c)
    therefore len(cons(a, cons(b, cons(c, nil)))) == 3
}

export «List» «length» «triple cons nil has length three»