# @module examples.verify.math.derived
# @means  The identity element is its own inverse.
# @from   dummit-foote — *Abstract Algebra*, §1.1
# @tier   derived

# @means  inv(1) = 1.
# @from   dummit-foote
# @tier   derived
# @needs  «Group» «inverse» «left inverse recovers the identity», «Group» «identity» «one is the right identity»

theorem «Group» «inverse» «the identity is its own inverse» () {
    assume «Group» «inverse» «left inverse recovers the identity»(1)
    assume «Group» «identity» «one is the right identity»(1)
    therefore inv(1) == 1
}

export «Group» «inverse» «the identity is its own inverse»