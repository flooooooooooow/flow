# @module examples.verify.math.derived
# @means  Three times zero is zero for natural numbers.
# @from   peano — https://en.wikipedia.org/wiki/Peano_axioms
# @tier   derived

# @means  3 * 0 = 0.
# @from   peano
# @tier   derived
# @needs  «Nat» «multiplication» «zero is the right annihilator»

theorem «Nat» «multiplication» «three times zero is zero» () {
    let three = succ(succ(succ(0)))
    assume «Nat» «multiplication» «zero is the right annihilator»(three)
    therefore three * 0 == 0
}

export «Nat» «multiplication» «three times zero is zero»