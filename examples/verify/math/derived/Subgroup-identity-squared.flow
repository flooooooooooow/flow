# @module examples.verify.math.derived
# @means  The identity squared stays in a subgroup.
# @from   dummit-foote — *Abstract Algebra*, §2.2
# @tier   derived

# @means  If 1 in H then 1 * 1 in H.
# @from   dummit-foote
# @tier   derived
# @needs  «Subgroup» «multiplication» «subgroup products stay in the subgroup», «Subgroup» «membership» «subgroups contain the identity»

theorem «Subgroup» «multiplication» «identity squared stays in the subgroup» (H: Subgroup) {
    if 1 in H {
        assume «Subgroup» «multiplication» «subgroup products stay in the subgroup»(H, 1, 1)
        assume «Subgroup» «membership» «subgroups contain the identity»(H)
        therefore 1 * 1 in H
    }
}

export «Subgroup» «multiplication» «identity squared stays in the subgroup»