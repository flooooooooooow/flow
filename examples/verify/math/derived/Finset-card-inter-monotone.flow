# @module examples.verify.math.derived
# @means  Cardinality is monotone under intersection on the left.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card(a ∩ b) <= card(a).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «intersection» «repeating does not change the set», «Nat» «order» «less-or-equal is reflexive»

theorem «Finset» «cardinality» «intersection size is at most the left factor» (a: Finset, b: Finset) {
    assume «Finset» «intersection» «repeating does not change the set»(a)
    assume «Nat» «order» «less-or-equal is reflexive»(card(a ∩ b))
    therefore card(a ∩ b) <= card(a)
}

export «Finset» «cardinality» «intersection size is at most the left factor»