# @module examples.verify.math.derived
# @means  Fourteen plus zero maps to fourteen under a ring homomorphism.
# @from   dummit-foote — *Abstract Algebra*, §7.3
# @tier   derived

# @means  f(14 + 0) = 14.
# @from   dummit-foote
# @tier   derived
# @needs  «RingHom» «preservation» «homomorphisms preserve addition», «Ring» «addition» «one plus one derived»

theorem «RingHom» «preservation» «fourteen plus zero maps to fourteen» (f: RingHom) {
    assume «RingHom» «preservation» «homomorphisms preserve addition»(f, 14, 0)
    assume «Ring» «addition» «one plus one derived»()
    therefore f(14 + 0) == 14
}

export «RingHom» «preservation» «fourteen plus zero maps to fourteen»