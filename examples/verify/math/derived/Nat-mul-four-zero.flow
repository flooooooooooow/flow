# @module examples.verify.math.derived
# @means  Four times zero is zero for natural numbers.
# @from   peano — https://en.wikipedia.org/wiki/Peano_axioms
# @tier   derived

# @means  4 * 0 = 0.
# @from   peano
# @tier   derived
# @needs  «Nat» «multiplication» «zero is the right annihilator»

theorem «Nat» «multiplication» «four times zero is zero» () {
    let four = succ(succ(succ(succ(0))))
    assume «Nat» «multiplication» «zero is the right annihilator»(four)
    therefore four * 0 == 0
}

export «Nat» «multiplication» «four times zero is zero»