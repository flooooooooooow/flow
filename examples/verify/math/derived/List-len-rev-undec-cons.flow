# @module examples.verify.math.derived
# @means  Reverse preserves length of an undecuple cons list.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len(rev(undecuple cons ending in nil)) = 11.
# @from   church
# @tier   derived
# @needs  «List» «length» «reverse preserves length», «List» «length» «undecuple cons nil has length eleven»

theorem «List» «length» «reverse of undecuple cons has length eleven» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat, g: Nat, h: Nat, i: Nat, j: Nat, k: Nat) {
    assume «List» «length» «reverse preserves length»(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, cons(k, nil))))))))))))
    assume «List» «length» «undecuple cons nil has length eleven»(a, b, c, d, e, f, g, h, i, j, k)
    therefore len(rev(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, cons(k, nil)))))))))))) == 11
}

export «List» «length» «reverse of undecuple cons has length eleven»