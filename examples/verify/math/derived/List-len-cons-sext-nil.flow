# @module examples.verify.math.derived
# @means  Sextuple cons ending in nil has length six.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, nil))))))) = 6.
# @from   church
# @tier   derived
# @needs  «List» «length» «cons increases length by one», «List» «length» «quintuple cons nil has length five»

theorem «List» «length» «sextuple cons nil has length six» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat) {
    assume «List» «length» «cons increases length by one»(cons(b, cons(c, cons(d, cons(e, cons(f, nil))))))
    assume «List» «length» «quintuple cons nil has length five»(b, c, d, e, f)
    therefore len(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, nil))))))) == 6
}

export «List» «length» «sextuple cons nil has length six»