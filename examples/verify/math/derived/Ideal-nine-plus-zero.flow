# @module examples.verify.math.derived
# @means  Nine plus zero is nine in an ideal witness.
# @from   dummit-foote — *Abstract Algebra*, §7.1
# @tier   derived

# @means  9 + 0 = 9 in an ideal.
# @from   dummit-foote
# @tier   derived
# @needs  «Ideal» «addition» «zero is the right additive identity», «Ideal» «addition» «eight plus zero in ideal»

theorem «Ideal» «addition» «nine plus zero in ideal» () {
    assume «Ideal» «addition» «zero is the right additive identity»(9)
    assume «Ideal» «addition» «eight plus zero in ideal»()
    therefore 9 + 0 == 9
}

export «Ideal» «addition» «nine plus zero in ideal»