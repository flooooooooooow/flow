# @module examples.verify.math.derived
# @means  Appending two empty lists yields empty.
# @from   church — https://en.wikipedia.org/wiki/List_(abstract_data_type)
# @tier   derived

# @means  nil ++ nil = nil.
# @from   church
# @tier   derived
# @needs  «List» «append» «empty is the left identity», «List» «length» «the empty list has length zero»

theorem «List» «append» «empty append empty is empty» () {
    assume «List» «append» «empty is the left identity»(nil)
    assume «List» «length» «the empty list has length zero»()
    therefore nil ++ nil == nil
}

export «List» «append» «empty append empty is empty»