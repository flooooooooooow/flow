# @module examples.verify.math.derived
# @means  Meet is bounded above by its left argument.
# @from   davey-priestley — *Introduction to Lattices and Order*
# @tier   derived

# @means  meet(a, b) <= a.
# @from   davey-priestley
# @tier   derived
# @needs  «Order» «meet» «meet absorbs join», «Nat» «order» «less-or-equal is reflexive»

theorem «Order» «meet» «meet is below the left argument» (a: Nat, b: Nat) {
    assume «Order» «meet» «meet absorbs join»(a, b)
    assume «Nat» «order» «less-or-equal is reflexive»(meet(a, b))
    therefore meet(a, b) <= a
}

export «Order» «meet» «meet is below the left argument»