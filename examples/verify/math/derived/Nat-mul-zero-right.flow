# @module examples.verify.math.derived
# @means  Zero on the right annihilates natural multiplication.
# @from   peano — https://en.wikipedia.org/wiki/Peano_axioms
# @tier   derived

# @means  n * 0 = 0.
# @from   peano
# @tier   derived
# @needs  «Nat» «multiplication» «zero is the left annihilator», «Nat» «multiplication» «order does not matter»

import verify.Nat-mul { zero-left-annihilator }
import .Nat-mul-commutes { mul-commutes }

theorem «Nat» «multiplication» «zero on the right gives zero» (n: Nat) {
    assume «Nat» «multiplication» «zero is the left annihilator»(n)
    assume «Nat» «multiplication» «order does not matter»(n, 0)
    therefore n * 0 == 0
}

export «Nat» «multiplication» «zero on the right gives zero»