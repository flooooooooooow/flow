# @module examples.verify.math.derived
# @means  Dual meet below join antisymmetric witness.
# @from   davey-priestley — *Introduction to Lattices and Order*
# @tier   derived

# @means  meet(b, a) <= join(b, a).
# @from   davey-priestley
# @tier   derived
# @needs  «Order» «lattice» «meet below join in dual order», «Order» «lattice» «meet below join via left transitivity»

theorem «Order» «lattice» «dual meet below join antisymmetric witness» (a: Nat, b: Nat) {
    assume «Order» «lattice» «meet below join in dual order»(a, b)
    assume «Order» «lattice» «meet below join via left transitivity»(b, a)
    therefore meet(b, a) <= join(b, a)
}

export «Order» «lattice» «dual meet below join antisymmetric witness»