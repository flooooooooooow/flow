# @module examples.verify.math.derived
# @means  Equal factors stay equal when multiplied on the left.
# @from   leibniz — https://en.wikipedia.org/wiki/Substitution_(logic)
# @tier   derived

# @means  From a = b we deduce c * a = c * b.
# @from   peano/induction — Gries & Schneider, Ch. 3
# @tier   derived
# @needs  «Nat» «multiplication» «order does not matter», «Eq» «equality» «equal terms multiply the same on the right»

import .Nat-mul-commutes { mul-commutes }

theorem «Eq» «equality» «equal terms multiply the same on the left» (a: Nat, b: Nat, c: Nat) {
    if a == b {
        assume «Nat» «multiplication» «order does not matter»(a, c)
        assume «Eq» «equality» «equal terms multiply the same on the right»(a, b, c)
        therefore c * a == c * b
    }
}

export «Eq» «equality» «equal terms multiply the same on the left»