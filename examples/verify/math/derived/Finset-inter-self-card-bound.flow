# @module examples.verify.math.derived
# @means  Self-intersection cardinality is bounded by the set size.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card(s ∩ s) <= card(s).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «intersection» «repeating does not change the set», «Finset» «cardinality» «self intersection size is bounded»

theorem «Finset» «cardinality» «self intersection size is bounded derived» (s: Finset) {
    assume «Finset» «intersection» «repeating does not change the set»(s)
    assume «Finset» «cardinality» «self intersection size is bounded»(s)
    therefore card(s ∩ s) <= card(s)
}

export «Finset» «cardinality» «self intersection size is bounded derived»