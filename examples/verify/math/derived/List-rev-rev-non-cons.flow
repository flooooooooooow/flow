# @module examples.verify.math.derived
# @means  Double reverse restores a nonuple cons list.
# @from   church — https://en.wikipedia.org/wiki/Reverse_(list)
# @tier   derived

# @means  rev(rev(nonuple cons with tail xs)) = nonuple cons with tail xs.
# @from   church
# @tier   derived
# @needs  «List» «reverse» «reverse is an involution»

theorem «List» «reverse» «double reverse of nonuple cons» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat, g: Nat, h: Nat, i: Nat, xs: List) {
    assume «List» «reverse» «reverse is an involution»(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, xs))))))))))
    therefore rev(rev(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, xs))))))))))) == cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, xs))))))))))
}

export «List» «reverse» «double reverse of nonuple cons»