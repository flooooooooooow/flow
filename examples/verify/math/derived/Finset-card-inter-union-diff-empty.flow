# @module examples.verify.math.derived
# @means  Intersection union difference empty has bounded cardinality.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card((s ∩ t) ∪ (s \ t)) <= card(s ∪ t).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «cardinality» «inter union diff empty card derived», «Finset» «cardinality» «union diff inter empty card bound»

theorem «Finset» «cardinality» «inter union diff empty card bound» (s: Finset, t: Finset) {
    assume «Finset» «cardinality» «inter union diff empty card derived»(s, t)
    assume «Finset» «cardinality» «union diff inter empty card bound»(s, t)
    therefore card((s ∩ t) ∪ (s \ t)) <= card(s ∪ t)
}

export «Finset» «cardinality» «inter union diff empty card bound»