# @module examples.verify.math.derived
# @means  Sixteen plus zero maps to sixteen under a ring homomorphism.
# @from   dummit-foote — *Abstract Algebra*, §7.3
# @tier   derived

# @means  f(16 + 0) = 16.
# @from   dummit-foote
# @tier   derived
# @needs  «RingHom» «preservation» «homomorphisms preserve addition», «Ring» «addition» «one plus one derived»

theorem «RingHom» «preservation» «sixteen plus zero maps to sixteen» (f: RingHom) {
    assume «RingHom» «preservation» «homomorphisms preserve addition»(f, 16, 0)
    assume «Ring» «addition» «one plus one derived»()
    therefore f(16 + 0) == 16
}

export «RingHom» «preservation» «sixteen plus zero maps to sixteen»