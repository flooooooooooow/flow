# @module examples.verify.math.derived
# @means  Meet below join is preserved under transitivity.
# @from   davey-priestley — *Introduction to Lattices and Order*
# @tier   derived

# @means  If meet(a, b) <= c and c <= join(a, b) then meet(a, b) <= join(a, b).
# @from   davey-priestley
# @tier   derived
# @needs  «Order» «lattice» «meet is below join», «Order» «leq» «transitivity holds»

theorem «Order» «lattice» «meet below join via transitivity» (a: Nat, b: Nat, c: Nat) {
    assume «Order» «lattice» «meet is below join»(a, b)
    assume «Order» «leq» «transitivity holds»(meet(a, b), c, join(a, b))
    therefore meet(a, b) <= join(a, b)
}

export «Order» «lattice» «meet below join via transitivity»