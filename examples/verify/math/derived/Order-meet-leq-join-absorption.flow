# @module examples.verify.math.derived
# @means  Meet is below join via absorption.
# @from   davey-priestley — *Introduction to Lattices and Order*
# @tier   derived

# @means  meet(a, b) <= join(a, b).
# @from   davey-priestley
# @tier   derived
# @needs  «Order» «meet» «meet absorbs join derived», «Order» «join» «join absorbs meet derived»

theorem «Order» «lattice» «meet is below join via absorption» (a: Nat, b: Nat) {
    assume «Order» «meet» «meet absorbs join derived»(a, b)
    assume «Order» «join» «join absorbs meet derived»(a, b)
    therefore meet(a, b) <= join(a, b)
}

export «Order» «lattice» «meet is below join via absorption»