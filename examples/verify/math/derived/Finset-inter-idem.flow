# @module examples.verify.math.derived
# @means  Intersection with itself leaves a finite set unchanged.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  s ∩ s = s.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «intersection» «order does not matter», «Finset» «intersection» «empty is the right annihilator»

theorem «Finset» «intersection» «repeating does not change the set» (s: Finset) {
    assume «Finset» «intersection» «order does not matter»(s, s)
    assume «Finset» «intersection» «empty is the right annihilator»(empty)
    therefore s ∩ s == s
}

export «Finset» «intersection» «repeating does not change the set»