# @module examples.verify.math.derived
# @means  Eight plus zero is eight in a monoid witness.
# @from   dummit-foote — *Abstract Algebra*, §1.1
# @tier   derived

# @means  8 + 0 = 8.
# @from   dummit-foote
# @tier   derived
# @needs  «Monoid» «addition» «zero is the right additive identity», «Monoid» «addition» «seven plus zero is seven»

theorem «Monoid» «addition» «eight plus zero is eight» () {
    assume «Monoid» «addition» «zero is the right additive identity»(8)
    assume «Monoid» «addition» «seven plus zero is seven»()
    therefore 8 + 0 == 8
}

export «Monoid» «addition» «eight plus zero is eight»