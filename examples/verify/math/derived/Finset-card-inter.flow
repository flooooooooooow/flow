# @module examples.verify.math.derived
# @means  Cardinality of an intersection is at most each operand.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card(a ∩ b) ≤ card(a).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «intersection» «order does not matter», «Nat» «order» «less-or-equal is reflexive»

theorem «Finset» «cardinality» «intersection size is at most each factor» (a: Finset, b: Finset) {
    assume «Finset» «intersection» «order does not matter»(a, b)
    assume «Nat» «order» «less-or-equal is reflexive»(card(a))
    therefore card(a ∩ b) <= card(a)
}

export «Finset» «cardinality» «intersection size is at most each factor»