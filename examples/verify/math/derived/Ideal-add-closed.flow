# @module examples.verify.math.derived
# @means  Ideal addition closure follows from ideal axioms.
# @from   dummit-foote — *Abstract Algebra*, §7.3
# @tier   derived

# @means  If a in I and b in I then a + b in I when I is an ideal.
# @from   dummit-foote
# @tier   derived
# @needs  «Ideal» «addition» «closed under addition», «Ring» «addition» «zero is the left identity»

theorem «Ideal» «addition» «ideal sums stay in the ideal» (I: Ideal, a: Ring, b: Ring) {
    if a in I {
        if b in I {
            assume «Ideal» «addition» «closed under addition»(I, a, b)
            assume «Ring» «addition» «zero is the left identity»(a)
            therefore a + b in I
        }
    }
}

export «Ideal» «addition» «ideal sums stay in the ideal»