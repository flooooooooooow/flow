# @module examples.verify.math.derived
# @means  Nonuple cons ending in nil has length nine.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len of nine cons ending in nil equals 9.
# @from   church
# @tier   derived
# @needs  «List» «length» «cons increases length by one», «List» «length» «octuple cons nil has length eight»

theorem «List» «length» «nonuple cons nil has length nine» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat, g: Nat, h: Nat, i: Nat) {
    assume «List» «length» «cons increases length by one»(cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, nil)))))))))
    assume «List» «length» «octuple cons nil has length eight»(b, c, d, e, f, g, h, i)
    therefore len(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, nil)))))))))) == 9
}

export «List» «length» «nonuple cons nil has length nine»