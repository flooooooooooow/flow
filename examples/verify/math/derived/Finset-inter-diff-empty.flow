# @module examples.verify.math.derived
# @means  Intersection difference with empty is the intersection.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  (s ∩ t) \ empty = s ∩ t.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «difference» «difference with empty preserves the set»

theorem «Finset» «difference» «intersection diff empty derived» (s: Finset, t: Finset) {
    assume «Finset» «difference» «difference with empty preserves the set»(s ∩ t)
    therefore (s ∩ t) \ empty == s ∩ t
}

export «Finset» «difference» «intersection diff empty derived»