# @module examples.verify.math.derived
# @means  Reversing a quadruple cons list.
# @from   church — https://en.wikipedia.org/wiki/Reverse_(list)
# @tier   derived

# @means  rev(cons(a, cons(b, cons(c, cons(d, nil))))) = cons(d, cons(c, cons(b, cons(a, nil)))).
# @from   church
# @tier   derived
# @needs  «List» «reverse» «reverse of cons is append of reverse tail», «List» «reverse» «reverse of triple cons»

theorem «List» «reverse» «reverse of quadruple cons» (a: Nat, b: Nat, c: Nat, d: Nat) {
    assume «List» «reverse» «reverse of cons is append of reverse tail»(a, cons(b, cons(c, cons(d, nil))))
    assume «List» «reverse» «reverse of triple cons»(b, c, d)
    therefore rev(cons(a, cons(b, cons(c, cons(d, nil))))) == cons(d, cons(c, cons(b, cons(a, nil))))
}

export «List» «reverse» «reverse of quadruple cons»