# @module examples.verify.math.derived
# @means  Double reverse restores an undecuple cons list.
# @from   church — https://en.wikipedia.org/wiki/Reverse_(list)
# @tier   derived

# @means  rev(rev(undecuple cons with tail xs)) = undecuple cons with tail xs.
# @from   church
# @tier   derived
# @needs  «List» «reverse» «reverse is an involution»

theorem «List» «reverse» «double reverse of undecuple cons» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat, g: Nat, h: Nat, i: Nat, j: Nat, k: Nat, xs: List) {
    assume «List» «reverse» «reverse is an involution»(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, cons(k, xs))))))))))))
    therefore rev(rev(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, cons(k, xs))))))))))))) == cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, cons(k, xs))))))))))))
}

export «List» «reverse» «double reverse of undecuple cons»