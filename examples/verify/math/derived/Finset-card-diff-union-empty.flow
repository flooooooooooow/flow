# @module examples.verify.math.derived
# @means  Union difference with empty preserves cardinality.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  card((s ∪ t) \ empty) = card(s ∪ t).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «cardinality» «union diff empty card derived»

theorem «Finset» «cardinality» «union diff empty card bound» (s: Finset, t: Finset) {
    assume «Finset» «cardinality» «union diff empty card derived»(s, t)
    therefore card((s ∪ t) \ empty) == card(s ∪ t)
}

export «Finset» «cardinality» «union diff empty card bound»