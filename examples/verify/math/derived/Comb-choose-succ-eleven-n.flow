# @module examples.verify.math.derived
# @means  Choosing eleven from a successor set.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  choose(succ(n), 11) = choose(n, 10) + choose(n, 11).
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Comb» «choose» «Pascal recurrence holds», «Comb» «choose» «choosing ten from a successor»

theorem «Comb» «choose» «choosing eleven from a successor derived» (n: Nat) {
    assume «Comb» «choose» «Pascal recurrence holds»(succ(n), 11)
    assume «Comb» «choose» «choosing ten from a successor»(n)
    therefore choose(succ(n), 11) == choose(n, 10) + choose(n, 11)
}

export «Comb» «choose» «choosing eleven from a successor derived»