# @module examples.verify.math.derived
# @means  Reverse distributes over append.
# @from   church — https://en.wikipedia.org/wiki/List_(abstract_data_type)
# @tier   derived

# @means  rev(xs ++ ys) = rev(ys) ++ rev(xs).
# @from   church/induction
# @tier   derived
# @needs  «List» «append» «empty is the left identity», «List» «reverse» «reversing empty yields empty», «List» «append» «parentheses do not matter»

theorem «List» «reverse» «reverse distributes over append» (xs: List, ys: List) {
    if xs == nil {
        assume «List» «reverse» «reversing empty yields empty»()
        assume «List» «append» «empty is the left identity»(ys)
        therefore rev(xs ++ ys) == rev(ys) ++ rev(xs)
    } else {
        let rest = tail(xs)
        assume «List» «reverse» «reverse distributes over append»(rest, ys)
        assume «List» «append» «parentheses do not matter»(rest, ys, rev(xs))
        therefore rev(xs ++ ys) == rev(ys) ++ rev(xs)
    }
}

export «List» «reverse» «reverse distributes over append»