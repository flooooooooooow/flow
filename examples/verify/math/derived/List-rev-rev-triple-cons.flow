# @module examples.verify.math.derived
# @means  Double reverse restores a triple cons list.
# @from   church — https://en.wikipedia.org/wiki/Reverse_(list)
# @tier   derived

# @means  rev(rev(cons(a, cons(b, cons(c, xs))))) = cons(a, cons(b, cons(c, xs))).
# @from   church
# @tier   derived
# @needs  «List» «reverse» «reverse is an involution»

theorem «List» «reverse» «double reverse of triple cons» (a: Nat, b: Nat, c: Nat, xs: List) {
    assume «List» «reverse» «reverse is an involution»(cons(a, cons(b, cons(c, xs))))
    therefore rev(rev(cons(a, cons(b, cons(c, xs))))) == cons(a, cons(b, cons(c, xs)))
}

export «List» «reverse» «double reverse of triple cons»