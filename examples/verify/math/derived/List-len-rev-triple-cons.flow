# @module examples.verify.math.derived
# @means  Reverse preserves length of a triple cons list.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len(rev(cons(a, cons(b, cons(c, nil))))) = 3.
# @from   church
# @tier   derived
# @needs  «List» «length» «reverse preserves length», «List» «length» «double cons has length two»

theorem «List» «length» «reverse of triple cons has length three» (a: Nat, b: Nat, c: Nat) {
    assume «List» «length» «reverse preserves length»(cons(a, cons(b, cons(c, nil))))
    assume «List» «length» «double cons has length two»(b, c)
    therefore len(rev(cons(a, cons(b, cons(c, nil))))) == 3
}

export «List» «length» «reverse of triple cons has length three»