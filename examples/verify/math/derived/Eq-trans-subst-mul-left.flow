# @module examples.verify.math.derived
# @means  Transitive equality preserves left multiplication.
# @from   leibniz — https://en.wikipedia.org/wiki/Substitution_(logic)
# @tier   derived

# @means  If a = b and b = c then d * a = d * c.
# @from   leibniz
# @tier   derived
# @needs  «Eq» «equality» «equal terms multiply the same on the left», «Eq» «equality» «equality reverses»

import .Eq-symmetric { eq-symmetric }

theorem «Eq» «equality» «transitive substitution on multiplication on the left» (a: Nat, b: Nat, c: Nat, d: Nat) {
    if a == b {
        if b == c {
            assume «Eq» «equality» «equal terms multiply the same on the left»(a, b, d)
            assume «Eq» «equality» «equality reverses»(b, c)
            assume «Eq» «equality» «equal terms multiply the same on the left»(b, c, d)
            therefore d * a == d * c
        }
    }
}

export «Eq» «equality» «transitive substitution on multiplication on the left»