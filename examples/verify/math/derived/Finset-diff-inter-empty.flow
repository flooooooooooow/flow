# @module examples.verify.math.derived
# @means  Difference of intersection with empty is the intersection.
# @from   graham-knuth-patashnik — *Concrete Mathematics*
# @tier   derived

# @means  (s ∩ t) \ empty = s ∩ t.
# @from   graham-knuth-patashnik
# @tier   derived
# @needs  «Finset» «difference» «intersection diff empty derived»

theorem «Finset» «difference» «inter diff empty is intersection» (s: Finset, t: Finset) {
    assume «Finset» «difference» «intersection diff empty derived»(s, t)
    therefore (s ∩ t) \ empty == s ∩ t
}

export «Finset» «difference» «inter diff empty is intersection»