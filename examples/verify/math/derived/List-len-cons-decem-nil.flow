# @module examples.verify.math.derived
# @means  Decuple cons ending in nil has length ten.
# @from   church — https://en.wikipedia.org/wiki/Length_of_a_list
# @tier   derived

# @means  len of ten cons ending in nil equals 10.
# @from   church
# @tier   derived
# @needs  «List» «length» «cons increases length by one», «List» «length» «nonuple cons nil has length nine»

theorem «List» «length» «decuple cons nil has length ten» (a: Nat, b: Nat, c: Nat, d: Nat, e: Nat, f: Nat, g: Nat, h: Nat, i: Nat, j: Nat) {
    assume «List» «length» «cons increases length by one»(cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, nil))))))))))
    assume «List» «length» «nonuple cons nil has length nine»(b, c, d, e, f, g, h, i, j)
    therefore len(cons(a, cons(b, cons(c, cons(d, cons(e, cons(f, cons(g, cons(h, cons(i, cons(j, nil))))))))))) == 10
}

export «List» «length» «decuple cons nil has length ten»