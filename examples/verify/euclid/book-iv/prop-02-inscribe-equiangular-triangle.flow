# @module examples.verify.euclid.book-iv
# @means  In a given circle to inscribe a triangle equiangular to a given triangle.
# @from   euclid — Elements, Book IV, Proposition 2
# @tier   derived
# @needs  «Geometry» «Euclid Book I» «Proposition 23: copy a given angle onto a line at a point», «Geometry» «Euclid Book III» «Proposition 21: angles in the same segment are equal»

theorem «Geometry» «Euclid Book IV» «Proposition 2: in a circle to inscribe a triangle equiangular to a given triangle» () {
    let circle = given_circle
    let ABC = given_triangle
    let DEF = inscribed_triangle
    therefore angle_DEF == angle_ABC
    assume «Geometry» «Euclid Book I» «Proposition 23: copy a given angle onto a line at a point»()
    assume «Geometry» «Euclid Book III» «Proposition 21: angles in the same segment are equal»()
    therefore inscribed_triangle_equiangular
}
