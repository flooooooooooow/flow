# @module examples.verify.euclid.book-iv
# @means  In a given circle to inscribe a rectilineal figure equilateral and equiangular.
# @from   euclid — Elements, Book IV, Proposition 14
# @tier   derived
# @needs  «Geometry» «Euclid Book IV» «Proposition 9: in a circle to inscribe a regular pentagon», «Geometry» «Euclid Book III» «Proposition 26: in equal circles equal angles stand on equal arcs»

theorem «Geometry» «Euclid Book IV» «Proposition 14: in a circle to inscribe a regular polygon» () {
    let circle = given_circle
    let polygon = inscribed_regular_polygon
    let n = number_of_sides
    therefore regular_polygon_in_circle
    assume «Geometry» «Euclid Book IV» «Proposition 9: in a circle to inscribe a regular pentagon»()
    assume «Geometry» «Euclid Book III» «Proposition 26: in equal circles equal angles stand on equal arcs»()
    therefore regular_polygon_inscribed
}
