# @module examples.verify.euclid.book-vi
# @means  Equiangular parallelograms in which the sides about the equal angles are reciprocally proportional are equal.
# @from   euclid — Elements, Book VI, Proposition 15
# @tier   derived
# @needs  «Geometry» «Euclid Book VI» «Proposition 14: equal equiangular parallelograms have reciprocally proportional sides»

theorem «Geometry» «Euclid Book VI» «Proposition 15: equiangular parallelograms with reciprocal sides are equal» () {
    let ABCD = parallelogram_1
    let EFGH = parallelogram_2
    let reciprocal = side_ratio
    therefore area_ABCD == area_EFGH
    assume «Geometry» «Euclid Book VI» «Proposition 14: equal equiangular parallelograms have reciprocally proportional sides»()
    therefore reciprocal_sides_implies_equal
}
