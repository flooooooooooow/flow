# @module examples.verify.euclid.book-vi
# @means  Similar parallelograms are to one another in the duplicate ratio of the homologous sides.
# @from   euclid — Elements, Book VI, Proposition 31
# @tier   derived
# @needs  «Geometry» «Euclid Book VI» «Proposition 26: similar parallelograms are in duplicate ratio of homologous sides»

theorem «Geometry» «Euclid Book VI» «Proposition 31: similar parallelograms are as the duplicate ratio of homologous sides» () {
    let par1 = parallelogram_1
    let par2 = parallelogram_2
    let s1 = side_1
    therefore ratio(par1, par2) == duplicate(s1)
    assume «Geometry» «Euclid Book VI» «Proposition 26: similar parallelograms are in duplicate ratio of homologous sides»()
    therefore similar_par_ratio_as_duplicate
}
