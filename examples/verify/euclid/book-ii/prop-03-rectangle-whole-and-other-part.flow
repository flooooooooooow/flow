# @module examples.verify.euclid.book-ii
# @means  If a straight line is cut, the rectangle by the whole and the other segment equals the rectangle by the segments together with the square on the other segment.
# @from   euclid — Elements, Book II, Proposition 3
# @tier   derived
# @needs  «Geometry» «Euclid Book II» «Proposition 2: the rectangle by the whole and one part equals the parts plus a square», «Geometry» «Euclid Book I» «Proposition 34: complements of parallelograms about the diameter are equal»

theorem «Geometry» «Euclid Book II» «Proposition 3: the rectangle by the whole and the other part equals the parts plus a square» () {
    let whole = straight_line_AB
    let C = segment_AC
    let D = segment_CB
    therefore rect(whole, D) == rect(C, D) + sq(D)
    assume «Geometry» «Euclid Book II» «Proposition 2: the rectangle by the whole and one part equals the parts plus a square»()
    assume «Geometry» «Euclid Book I» «Proposition 34: complements of parallelograms about the diameter are equal»()
    therefore rect(whole, part_D) == rect(parts) + sq(D)
}
