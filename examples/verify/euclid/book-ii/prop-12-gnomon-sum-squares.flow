# @module examples.verify.euclid.book-ii
# @means  To apply a gnomon equal to the excess of one square over another in a parallelogram.
# @from   euclid — Elements, Book II, Proposition 12
# @tier   derived
# @needs  «Geometry» «Euclid Book II» «Proposition 11: a gnomon equals the rectangle by the segments», «Geometry» «Euclid Book II» «Proposition 4: the square on the whole equals the squares on the parts plus twice their rectangle»

theorem «Geometry» «Euclid Book II» «Proposition 12: a gnomon equals the excess of two squares» () {
    let sq_A = square_on_larger
    let sq_B = square_on_smaller
    let gnomon = gnomon_in_parallelogram
    therefore gnomon == sq_A - sq_B
    assume «Geometry» «Euclid Book II» «Proposition 11: a gnomon equals the rectangle by the segments»()
    assume «Geometry» «Euclid Book II» «Proposition 4: the square on the whole equals the squares on the parts plus twice their rectangle»()
    therefore gnomon_equals_sq_A_minus_sq_B
}
