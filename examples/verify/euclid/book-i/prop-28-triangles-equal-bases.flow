# @module examples.verify.euclid.book-i
# @means  Triangles on equal bases and in the same parallels are equal.
# @from   euclid — Elements, Book I, Proposition 28
# @tier   derived
# @needs  «Geometry» «Euclid Book I» «Proposition 27: a triangle is half a parallelogram on same base»

theorem «Geometry» «Euclid Book I» «Proposition 28: triangles on equal bases and parallels are equal» () {
    let parallelogram_on_AB_and_EF = parallelograms_through_equal_bases
    assume triangles_ABC_and_DEF_on_equal_bases_between_same_parallels
    assume «Geometry» «Euclid Book I» «Proposition 27: a triangle is half a parallelogram on same base»()
    therefore triangle_ABC == triangle_DEF
}