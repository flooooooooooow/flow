# @module examples.verify.euclid.book-i
# @means  In a triangle, an exterior angle equals the sum of the two remote interior angles.
# @from   euclid — Elements, Book I, Proposition 32
# @tier   derived
# @needs  «Geometry» «Euclid Book I» «Proposition 29: alternate angles are equal when a transversal crosses parallels», «Geometry» «Euclid Book I» «Proposition 31: interior angles on one side sum to two right angles»

theorem «Geometry» «Euclid Book I» «Proposition 32: an exterior angle equals the sum of remote interior angles» () {
    let D = point_on_BC_produced_beyond_C
    let line_through_C_parallel_to_AB = parallel_at_C_to_AB
    assume triangle_ABC_with_exterior_angle_ACD
    assume «Geometry» «Euclid Book I» «Proposition 29: alternate angles are equal when a transversal crosses parallels»()
    assume «Geometry» «Euclid Book I» «Proposition 31: interior angles on one side sum to two right angles»()
    therefore angle_ACD == angle_CAB + angle_ABC
}