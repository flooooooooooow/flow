# @module examples.verify.euclid.book-v
# @means  If a first magnitude is greater than a second, the third is greater than the fourth when the four are proportional.
# @from   euclid — Elements, Book V, Proposition 9
# @tier   derived
# @needs  «Geometry» «Euclid Book V» «Proposition 8: if the first exceeds the third then the second exceeds the fourth»

theorem «Geometry» «Euclid Book V» «Proposition 9: if the first exceeds the second then the third exceeds the fourth» () {
    let a = first
    let b = second
    let c = third
    let d = fourth
    therefore a > b implies c > d
    assume «Geometry» «Euclid Book V» «Proposition 8: if the first exceeds the third then the second exceeds the fourth»()
    therefore a_greater_b_implies_c_greater_d
}
