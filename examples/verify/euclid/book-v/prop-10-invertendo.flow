# @module examples.verify.euclid.book-v
# @means  If four magnitudes are proportional, they are also proportional inversely.
# @from   euclid — Elements, Book V, Proposition 10
# @tier   derived
# @needs  «Geometry» «Euclid Book V» «Proposition 7: proportional magnitudes satisfy alternando»

theorem «Geometry» «Euclid Book V» «Proposition 10: proportional magnitudes satisfy invertendo» () {
    let a = first
    let b = second
    let c = third
    let d = fourth
    therefore ratio(b, a) == ratio(d, c)
    assume «Geometry» «Euclid Book V» «Proposition 7: proportional magnitudes satisfy alternando»()
    therefore ratio_a_b_implies_ratio_b_a
}
