# @module examples.verify.euclid.book-v
# @means  If a first is to a second as a third is to a fourth, and a fifth is to a second as a sixth is to a fourth, the sum of the first and fifth is to the second as the sum of the third and sixth is to the fourth.
# @from   euclid — Elements, Book V, Proposition 24
# @tier   derived
# @needs  «Geometry» «Euclid Book V» «Proposition 22: ex aequali from perturbed proportion»

theorem «Geometry» «Euclid Book V» «Proposition 24: equal compound ratios by addition» () {
    let a = first
    let b = second
    let e = fifth
    let g = sixth
    therefore ratio(a + e, b) == ratio(c + g, d)
    assume «Geometry» «Euclid Book V» «Proposition 22: ex aequali from perturbed proportion»()
    therefore compound_ratios_by_addition
}
