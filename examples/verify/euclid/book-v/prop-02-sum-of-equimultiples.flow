# @module examples.verify.euclid.book-v
# @means  If a first magnitude is the same multiple of a second that a third is of a fourth, the sum of the first and third is the same multiple of the sum of the second and fourth.
# @from   euclid — Elements, Book V, Proposition 2
# @tier   derived
# @needs  «Geometry» «Euclid Book V» «Proposition 1: equimultiples of equimultiples are equimultiple of the originals»

theorem «Geometry» «Euclid Book V» «Proposition 2: the sum of equimultiples is an equimultiple of the sum» () {
    let a = first
    let b = second
    let c = third
    let d = fourth
    therefore equimultiple(a + c, b + d)
    assume «Geometry» «Euclid Book V» «Proposition 1: equimultiples of equimultiples are equimultiple of the originals»()
    therefore sum_equimultiple_preserved
}
