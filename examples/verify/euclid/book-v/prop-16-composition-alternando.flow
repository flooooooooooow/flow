# @module examples.verify.euclid.book-v
# @means  If four magnitudes are proportional, the sum of the first and third is to the third as the sum of the second and fourth is to the fourth.
# @from   euclid — Elements, Book V, Proposition 16
# @tier   derived
# @needs  «Geometry» «Euclid Book V» «Proposition 7: proportional magnitudes satisfy alternando», «Geometry» «Euclid Book V» «Proposition 11: proportional magnitudes satisfy componendo»

theorem «Geometry» «Euclid Book V» «Proposition 16: composition holds with alternando» () {
    let a = first
    let b = second
    let c = third
    let d = fourth
    therefore ratio(a + c, c) == ratio(b + d, d)
    assume «Geometry» «Euclid Book V» «Proposition 7: proportional magnitudes satisfy alternando»()
    assume «Geometry» «Euclid Book V» «Proposition 11: proportional magnitudes satisfy componendo»()
    therefore composition_alternando_holds
}
