# @module examples.verify.euclid.book-v
# @means  If four magnitudes are proportional, they are also proportional by division.
# @from   euclid — Elements, Book V, Proposition 12
# @tier   derived
# @needs  «Geometry» «Euclid Book V» «Proposition 11: proportional magnitudes satisfy componendo»

theorem «Geometry» «Euclid Book V» «Proposition 12: proportional magnitudes satisfy dividendo» () {
    let a = first
    let b = second
    let c = third
    let d = fourth
    therefore ratio(a - b, b) == ratio(c - d, d)
    assume «Geometry» «Euclid Book V» «Proposition 11: proportional magnitudes satisfy componendo»()
    therefore ratio_a_b_implies_ratio_a_minus_b_b
}
