# @module examples.verify.euclid.book-iii
# @means  The opposite angles of quadrilaterals in circles equal two right angles.
# @from   euclid — Elements, Book III, Proposition 22
# @tier   derived
# @needs  «Geometry» «Euclid Book III» «Proposition 21: angles in the same segment are equal», «Geometry» «Euclid Book I» «Proposition 13: adjacent angles on a straight line sum to two right angles»

theorem «Geometry» «Euclid Book III» «Proposition 22: opposite angles of a cyclic quadrilateral sum to two right angles» () {
    let ABCD = cyclic_quadrilateral
    let angle_A = angle_DAB
    let angle_C = angle_BCD
    therefore angle_A + angle_C == two_right_angles
    assume «Geometry» «Euclid Book III» «Proposition 21: angles in the same segment are equal»()
    assume «Geometry» «Euclid Book I» «Proposition 13: adjacent angles on a straight line sum to two right angles»()
    therefore opposite_angles_sum_two_right
}
