# @module examples.verify.euclid.book-iii
# @means  To cut off from a circle a segment containing an angle equal to a given rectilineal angle.
# @from   euclid — Elements, Book III, Proposition 34
# @tier   derived
# @needs  «Geometry» «Euclid Book III» «Proposition 33: to construct on a given straight line a segment similar to a given segment»

theorem «Geometry» «Euclid Book III» «Proposition 34: to cut off a segment containing an angle equal to a given rectilineal angle» () {
    let circle = given_circle
    let given_angle = rectilineal_angle
    let seg = required_segment
    therefore segment_contains_given_angle
    assume «Geometry» «Euclid Book III» «Proposition 33: to construct on a given straight line a segment similar to a given segment»()
    therefore segment_with_given_angle_exists
}
