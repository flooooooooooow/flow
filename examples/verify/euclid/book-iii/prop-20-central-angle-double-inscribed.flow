# @module examples.verify.euclid.book-iii
# @means  In a circle the angle at the center is double the angle at the circumference when the angles stand on the same arc.
# @from   euclid — Elements, Book III, Proposition 20
# @tier   derived
# @needs  «Geometry» «Euclid Book I» «Proposition 32: exterior angle equals sum of remote interior angles»

theorem «Geometry» «Euclid Book III» «Proposition 20: the central angle is double the inscribed angle on the same arc» () {
    let O = center
    let A = point_on_circumference
    let B = second_point
    therefore angle_AOB == 2 * angle_ACB
    assume «Geometry» «Euclid Book I» «Proposition 32: exterior angle equals sum of remote interior angles»()
    therefore central_angle_double_inscribed
}
