# @module examples.verify.euclid.book-iii
# @means  In equal circles equal angles at the centers or circumferences stand on equal circumferences.
# @from   euclid — Elements, Book III, Proposition 26
# @tier   derived
# @needs  «Geometry» «Euclid Book III» «Proposition 20: the central angle is double the inscribed angle on the same arc»

theorem «Geometry» «Euclid Book III» «Proposition 26: in equal circles equal angles stand on equal arcs» () {
    let C1 = equal_circle_1
    let C2 = equal_circle_2
    let arc1 = arc_from_angle
    therefore arc1 == arc2
    assume «Geometry» «Euclid Book III» «Proposition 20: the central angle is double the inscribed angle on the same arc»()
    therefore equal_angles_on_equal_arcs
}
