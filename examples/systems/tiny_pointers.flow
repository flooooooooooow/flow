        all_ok = 0
    }
    if r3_ok == 0 {
        all_ok = 0
    }
    if st_ok == 0 {
        all_ok = 0
    }
    if all_ok == 1 {
        println("PASS — every allocation, dereference and stability check verified.")
        println("Theorems 1 + 2 + 6 + 7 + 8 + 9, rebuilt from scratch in Flow:")
        println("  · fixed-size tiny pointers:   6 bits  vs 16-bit raw pointer")
        println("  · variable-size tiny pointers: ~3 bits expected (O(1 + log δ⁻¹)),")
        println("    doubly-exponential tail Pr[size ≥ ℓ] ≤ 2^(−2^Ω(ℓ)) confirmed")
        println("  · stable dictionary: values never move, even across rehash")
        println("  · relaxed retrieval: O(1)-expected hints beat the Ω(log log n)")
        println("    dynamic-retrieval lower bound — H rebuild leaves hints valid")
        println("  · Theorem 6 tradeoff: r = 1..4 levels of indirection — the")
        println("    retriever (the O(n log⁽ʳ⁾ n) term) shrinks 15 → 4 → 2 → 1")
        println("    bits/key while the worst-case cascade depth grows 1 → 4")
        println("    levels with r; expected per-op stays O(1) (Phase 8b)")
        println("  · succinct rotation-based BST: children are O(1)-bit tiny")
        println("    retrievers; rotations stay constant-time (Theorem 7)")
        println("  · variable-size value dictionaries: Σ(2^⌈log vᵢ⌉ + O(log vᵢ))")
        println("    bits per key — a uniform 64-bit dictionary becomes arbitrary-")
        println("    length, bound tight when values are uniform-max (Theorem 9)")
        println("  · variable-size KEY dictionaries (Thm 9 analogue): keys cost")
        println("    Σ(2^⌈log kᵢ⌉ + O(log kᵢ)) too — skew on both sides of each pair")
        println("    (Phase 12)")
        println("  · lower bounds: ANY scheme pays Ω(log log log n + log δ⁻¹)")
        println("    bits fixed / Ω(log δ⁻¹) variable — measured: the Theorem-5")
        println("    fullest-bin floor holds at every budget s, the variable mean")
        println("    sits at/above log₂δ⁻¹, and every bit below 6 forces")
        println("    dereference collisions on this very table (Phase 13)")
    println("  · deamortized dynamic resizing: the Θ(m) resize copy is spread over")
    println("    the following ops — worst per-op work caps at RV_BUDGET + RV_SCAN")
    println("    units vs Θ(live) for one-shot resizing, same workload (Phase 14)")
    println("  · r-levels of indirection: the v ≤ 64 cap is lifted — 128/256-bit")
    println("    values live behind a 5-bit p₁ = O(log k) in an 8-bit base slot,")
    println("    and the base pointer stays 8 bits for every value size (Phase 15)")
    println("  · optimal internal-memory stash: the bucket is implicit (two-choice")
    println("    hash), so each stash entry is a 4-bit tiny pointer (Θ(log ε⁻¹));")
    println("    the adaptive-filter lookup is exact in O(1) RAM + ONE external")
    println("    read, positions never move, and the stash is O(m log ε⁻¹) = O(m)")
    println("    bits vs m·log₂(4m) for a naive full-address stash (Phase 16)")
    println("  · r=3 r-levels chain: the O(log log k) middle pointer p₂ lifts the")
    println("    value cap from 256 bits to 2^32 bits through base(8) → p₂(6) →")
    println("    p₁(5) → value; every pointer width is CONSTANT in v — the base")
    println("    never grows, only the word count does (Phase 15 extension)")
    } else {
        println("FAIL — see above.")
    }
    println("")

    bstree_destroy(bt)
    vtable_destroy(bvt)
    rhash_destroy(rh)
    vtable_destroy(rvt)
    registry_destroy(rreg)
    vtable_destroy(vt)
    registry_destroy(vreg)
    dmap_destroy(dm)
    registry_destroy(reg)
    primary_destroy(pr)
    secondary_destroy(sec)
    free(values_raw)
    free(vdb_raw)
    free(vdv_raw)
    registry_destroy(vdreg)
    vdtable_destroy(vdt)
    free(kvb_raw)
    free(kvv_raw)
    free(vposs_raw)
    free(vptrs_raw)
    free(kca_raw)
    free(kc1_raw)
    free(kb_raw)
    free(kw3_raw)
    free(kw2_raw)
    free(kw1_raw)
    free(kw0_raw)
    registry_destroy(kdreg)
    vdtable_destroy(vvt)
    rltable_destroy(krltp)
    vdtable_destroy(kvt)
    rvtable_destroy(&dvt)
    free(dvb_raw)
    free(dvv_raw)
    registry_destroy(dreg)
    rvtable_destroy(&nvt)
    free(nvb_raw)
    free(nvv_raw)
    registry_destroy(nreg)
    rltable_destroy(&rlt)
    free(rla_raw)
    free(rl1_raw)
    free(rlb_raw)
    free(rw3_raw)
    free(rw2_raw)
    free(rw1_raw)
    free(rw0_raw)
    registry_destroy(rlreg)
    vdtable_destroy(rlbase)
    r3a_destroy(&r3a)
    r3p2_destroy(&r3t)
    registry_destroy(r3reg)
    vdtable_destroy(r3base)
    free(r3w_raw)
    free(r3p1_raw)
    free(r3p2_raw)
    free(r3scr_raw)
    registry_destroy(streg)
    st_destroy(&stt)
    if all_ok == 1 {
        return 0
    }
    return 1
}
