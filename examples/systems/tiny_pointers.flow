    println("║  no single insert ever copies Θ(m) values                            ║")
    println("╚══════════════════════════════════════════════════════════════════════╝")
    println("")
    println("The Theorem-9 dictionary must resize its dereference tables as the live")
    println("count changes — naively that is a Θ(m) copy on the triggering op. The")
    println("paper's zone-aggregated resizing spreads each rebuild over the following")
    println("operations ('the time needed to rebuild a component of size s is Θ(s),")
    println("so the dynamic resizing of Bi can be deamortized to take O(1) time per")
    println("operation'). Every tiny pointer gains one generation bit naming its")
    println("dereference table, and a background migration drains the old generation")
    println("into the new one at a fixed per-op budget (RV_BUDGET = 16 values).")
    println("")
    println("Phase 14 runs the SAME workload (load 30k → churn → drain → reload, 12")
    println("resize transitions) twice — naive one-shot resizing vs deamortized —")
    println("and compares the worst-case per-operation cost of each.")
    println("")
}

function banner() {
    println("")
    println("╔══════════════════════════════════════════════════════════════════════╗")
    println("║  Tiny Pointers  —  arXiv:2111.12800  (Bender · Conway · Farach-      ║")
    println("║  Colton · Kuszmaul · Tagliavini)  —  implemented in Flow             ║")
    println("╚══════════════════════════════════════════════════════════════════════╝")
    println("")
    println("A dereference table lets each key own one slot in a shared value array.")
    println("Because (key, pointer) are both known at lookup time, the pointer only")
    println("needs to encode the slot within a hash-derived bucket:  o(log n) bits.")
    println("")
}

function report_sizes() {
    print("Dereference table  n = ")
    print(N_SLOTS)
    println(" slots   load factor 1 - δ = 0.75   (δ = 1/4)")
    print("  primary   (load-balancing):      ")
    print(P_SLOTS)
    print(" slots = ")
    print(P_BUCKETS)
    print(" buckets × ")
    print(P_BUCKET)
    println("")
    print("  secondary (power-of-2-choices):   ")
    print(S_SLOTS)
    print(" slots = ")
    print(S_BUCKETS)
    print(" buckets ×  ")
    print(S_BUCKET)
    println("")
    println("")
    print("  tiny pointer:  ")
    print(TP_BITS)
    println(" bits   (1 table bit + 5 slot bits)   [fixed size]")
    print("  raw pointer:  ")
    print(LOG_N)
    println(" bits   (log₂ n)")
    println("  → 10 bits saved per pointer (62%), constant-time operations w.h.p.")
    println("  theory bound:  Θ(log log log n + log δ⁻¹) ≈ Θ(2 + 2) bits — achieved 6")
    println("")
}

# The paper's abstract promises two pointer results and five applications.
# This map links each to the phase(s) that measure it — the same table as the
# 'Abstract-claim coverage' sections of docs/library/tiny-pointers.md and
# docs/library/tiny-pointers-variable-values.md, so a terminal run
# self-links to the doc sections.
function coverage_map() {
    println("")
    println("Abstract-claim coverage  (arXiv:2111.12800 → phase · doc section)")
    println("──────────────────────────────────────────────────────────────────")
    println("  pointer results:")
    println("    · fixed-size Θ(log log log n + log k) bits   → Theorem 1 (Phases 1–4)")
    println("    · variable-size Θ(log k) expected bits       → Theorem 2 (Phases 5–6)")
    println("  applications:")
    println("    ① relaxed retrieval nv + O(n log⁽ʳ⁾ n), O(1)-expected hints, O(r) insert/delete")
    println("        → Theorem 6 (Phases 7–8, 8b)  ·  §6.2")
    println("    ② succinct rotation-based BSTs               → Theorem 7 (Phases 9–10)  ·  §6.3")
    println("    ③ stable fixed-capacity dicts, 1 + o(1)      → Theorem 8 (Phases 3–4)  ·  §6.4")
    println("    ④ arbitrary-size values, log⁽ʳ⁾ n + O(log j) → Theorem 9 (Phases 11/12/14/15)  ·  §6.5")
    println("        (deep dive: docs/library/tiny-pointers-variable-values.md)")
    println("    ⑤ optimal internal-memory stash O(n log ε⁻¹) → Theorem 10 (Phase 16)  ·  §6.6")
    println("  (Theorems 3–5 are lower bounds / intermediate steps, not constructions.)")
    println("  full theorem table: docs/library/tiny-pointers.md")
    println("──────────────────────────────────────────────────────────────────")
    println("")
}

function banner2() {
    println("")
    println("╔══════════════════════════════════════════════════════════════════════╗")
    println("║  Theorem 2 — VARIABLE-SIZE tiny pointers                             ║")
    println("║  O(1 + log δ⁻¹) EXPECTED bits  ·  Pr[size ≥ ℓ] ≤ 2^(−2^Ω(ℓ))         ║")
    println("╚══════════════════════════════════════════════════════════════════════╝")
    println("")
    println("Fixed-size pointers are stuck at Θ(log log log n + log δ⁻¹) bits. By")
    println("letting pointer size vary, Theorem 2 removes the log log log n term:")
    println("expected size O(1 + log δ⁻¹), and the tail is DOUBLY exponential — a")
    println("pointer of size ℓ occurs with probability ≤ 2^(−2^Ω(ℓ)).")
    println("")
    println("Construction (paper §4, Prop 1):  n/log n containers × log₂ s levels.")
    println("  level i: sᵢ = s/2ⁱ buckets × b slots, plus an overflow array of sᵢ")
    println("  slots; invariant Lᵢ ≤ sᵢ holds deterministically, so overflow arrays")
    println("  can never fill. Allocate descends levels; a bucket-full cascade goes")
    println("  to level i+1 only while Lᵢ₊₁ < sᵢ₊₁, else to level i's overflow array.")
    println("")
    println("  concrete instance:  n = 65536  ·  4096 containers  ·  s = 32  ·  b = 2")
    println("  levels 0–4:  sᵢ = 32, 16, 8, 4, 2 buckets   (186 slots / container)")
    println("")
    println("  pointer sizes (self-delimiting encoding, real bit lengths):")
    println("    table slot, level i:      Elias-γ(i+1) + 1 + ⌈log₂b⌉   = O(log i)")
    println("    overflow slot, level i:   Elias-γ(5−i)  + 1 + ⌈log₂sᵢ⌉  = O(log sᵢ)")
    println("")
}

function banner3() {
    println("")
    println("╔══════════════════════════════════════════════════════════════════════╗")
    println("║  Theorem 6 — RELAXED RETRIEVAL (tiny retrievers)                     ║")
    println("║  O(1)-expected hints beat the Ω(log log n) retrieval lower bound     ║")
    println("╚══════════════════════════════════════════════════════════════════════╝")
    println("")
    println("Classic dynamic retrieval (Insert/Delete/Query on k-bit keys with v-bit")
    println("values) provably needs Ω(log log n) metadata bits per value — even for")
    println("v = 1. Relax the contract: Insert returns a hint r the user keeps, and")
    println("Query(x, r) / Delete(x, r) present both. Hints are then just the")
    println("variable-size tiny pointers of Theorem 2 — O(1) EXPECTED bits.")
    println("")
    println("Construction: Allocate(x) → p; s_x = Dereference(x, p) is a slot UNIQUE")
    println("to x, and the dereference table's store is never read ('we need not even")
    println("allocate space for it'). Store (s_x, y) in hash table H whose keys live")
    println("in the tiny universe [2n] — log C(2n,n) = O(n) bits by Stirling, so H")
    println("costs nv + O(n) total. Query = H[s_x]; Delete = H[s_x] + Free(x, p).")
    println("")
}

function banner4() {
    println("")
    println("╔══════════════════════════════════════════════════════════════════════╗")
    println("║  Theorem 7 — SUCCINCT ROTATION-BASED BINARY SEARCH TREES             ║")
    println("║  child pointers = O(1)-bit tiny retrievers · rotations stay O(1)     ║")
    println("╚══════════════════════════════════════════════════════════════════════╝")
    println("")
    println("There are at most 4ⁿ ordered binary trees on n nodes, so the pointer")
    println("structure fits in O(n) bits — yet classic succinct trees cannot do")
    println("ROTATIONS, and rotation-based trees (AVL, red-black, splay) live on")
    println("them. Theorem 7 fixes this: each child pointer is a tiny retriever")
    println("(Theorem 6) keyed on x◦0 / x◦1 whose slot in the node array holds the")
    println("child. A rotation rewrites only 2-3 edge slots in O(1) time — no node")
    println("moves, no retriever changes. Tree structure: nk + O(n) bits total.")
    println("")
}

# ============================================================================
# main
# ============================================================================

function main() -> i32 {
    banner()
    report_sizes()
    coverage_map()

    # per-phase wall-clock timers (benchmark block before the summary)
    let mut t0: i64 = 0
    let mut t1: i64 = 0
    let mut t2: i64 = 0
    let mut t3: i64 = 0
    let mut t4: i64 = 0
    let mut t5: i64 = 0
    let mut t6: i64 = 0
    let mut t7: i64 = 0
    let mut t8: i64 = 0
    let mut t9: i64 = 0
    let mut t10: i64 = 0
    let mut t11: i64 = 0
    let mut t12: i64 = 0
    let mut t13: i64 = 0
    let mut t14a: i64 = 0
    let mut t14b: i64 = 0
    let mut t14: i64 = 0
    let mut t15: i64 = 0
    let mut t16: i64 = 0
    let mut t7b: i64 = 0

    let pr: PrimaryTable = primary_create()
    let sec: SecondaryTable = secondary_create()
    let values_raw: ptr<u8> = malloc(N_SLOTS * 4)
    let values: ptr<i32> = values_raw
    let mut i: i32 = 0
    while i < N_SLOTS {
        values[i] = -1
        i = i + 1
    }

    let mut reg: Registry = registry_create()
    let rp: ptr<Registry> = &reg

    # ---- phase 1: bulk load to load factor 0.75 ----------------------------
    println("────────────────────────────────────────────────────────────────────────")
    print("Phase 1 — bulk load: ")
    print(MAX_LIVE)
    println(" distinct keys to load factor 0.75")
    t0 = now_ns()
    let mut overflow: i32 = 0
    let mut max_primary: i32 = 0
    let mut max_secondary: i32 = 0
    i = 0
    while i < MAX_LIVE {
        let key: i32 = distinct_key(i)
        let value: i32 = (key * 7) & 0xFFFF
        let ok: i32 = reg_insert(rp, pr, sec, values, key, value)
        if ok == 0 {
            println("FAIL: table over capacity during bulk load")
            return 1
        }
        # track overflow + max bucket loads
        let tp: i32 = reg.tp[i]
        if (tp & TP_TABLE_BIT) != 0 {
            overflow = overflow + 1
        }
        i = i + 1
    }
    # max bucket loads
    i = 0
    while i < P_BUCKETS {
        if pr.counts[i] > max_primary {
            max_primary = pr.counts[i]
        }
        i = i + 1
    }
    i = 0
    while i < S_BUCKETS {
        if sec.counts[i] > max_secondary {
            max_secondary = sec.counts[i]
        }
        i = i + 1
    }

    let errors: i32 = reg_verify(rp, pr, sec, values)
    print("  inserted: ")
    print(MAX_LIVE)
    print("   overflow to secondary: ")
    println(overflow)
    print("  max primary bucket load: ")
    println(max_primary)
    print("  max secondary bucket load: ")
    println(max_secondary)
    print("  verify: ")
    println(errors)
    print("  (theory: overflow ≤ δ²n = ")
    print((N_SLOTS * DELTA_NUM * DELTA_NUM) / (DELTA_DEN * DELTA_DEN))
    println(" w.h.p.; secondary max load ≈ O(log log n))")
    println("")
    t1 = now_ns() - t0

    # ---- phase 2: dynamic churn (insert/delete) ----------------------------
    println("────────────────────────────────────────────────────────────────────────")
    print("Phase 2 — dynamic churn: ")
    print(CHURN_OPS)
    println(" random insert/delete ops")
    t0 = now_ns()
    let mut state: i32 = 987654321
    let sp: ptr<i32> = &state
    let mut next_key: i32 = MAX_LIVE
    let mut ops: i32 = 0
    let mut churn_errors: i32 = 0
    while ops < CHURN_OPS {
        let r: i32 = rng_next(sp) % 100
        # Insert only while below the advertised load factor; otherwise delete.
        if r < 55 and reg.live_top[0] < MAX_LIVE {
            let key: i32 = distinct_key(next_key)
            let value: i32 = (key * 7) & 0xFFFF
            let ok: i32 = reg_insert(rp, pr, sec, values, key, value)
            if ok == 0 {
                println("FAIL: churn insert overflowed the table")
                return 1
            }
            next_key = next_key + 1
        } else {
            let _d: i32 = reg_delete_random(rp, pr, sec, sp)
        }
        if (ops % 5000) == 4999 {
            let e: i32 = reg_verify(rp, pr, sec, values)
            churn_errors = churn_errors + e
        }
        ops = ops + 1
    }
    let final_live: i32 = reg.live_top[0]
    print("  ops: ")
    print(CHURN_OPS)
    print("   live keys now: ")
    println(final_live)
    print("  verification errors (checked every 5000 ops): ")
    println(churn_errors)
    t2 = now_ns() - t0

    # ---- phase 3: stability (referential integrity) ------------------------
    println("────────────────────────────────────────────────────────────────────────")
    println("Phase 3 — stability: values must never move (Theorem 8)")
    t0 = now_ns()
    # Snapshot the positions of the first 8 live keys by registry index.
    let mut pinned: array<i32, 8> = [-1]
    let mut pin_keys: array<i32, 8> = [-1]
    let mut pin_vals: array<i32, 8> = [-1]
    let mut pin_idx: array<i32, 8> = [-1]
    i = 0
    while i < 8 {
        let idx: i32 = reg.live_list[i]
        pin_idx[i] = idx
        pinned[i] = reg.pos[idx]
        pin_keys[i] = reg.key[idx]
        pin_vals[i] = reg.val[idx]
        i = i + 1
    }
    # More churn (deleting only NON-pinned keys): any movement of the pinned
    # values would break the checks below.
    ops = 0
    while ops < CHURN_OPS {
        let r: i32 = rng_next(sp) % 100
        if r < 55 and reg.live_top[0] < MAX_LIVE {
            let key: i32 = distinct_key(next_key)
            let value: i32 = (key * 7) & 0xFFFF
            let ok: i32 = reg_insert(rp, pr, sec, values, key, value)
            if ok == 0 {
                println("FAIL: stability churn overflowed the table")
                return 1
            }
            next_key = next_key + 1
        } else {
            # delete a random live key, skipping the 8 pinned ones
            let mut attempts: i32 = 0
            let mut did_del: i32 = 0
            while attempts < 64 and did_del == 0 {
                let top: i32 = reg.live_top[0]
                if top > 0 {
                    let j: i32 = rng_next(sp) % top
                    let idx: i32 = reg.live_list[j]
                    let mut is_pinned: i32 = 0
                    let mut p: i32 = 0
                    while p < 8 {
                        if idx == pin_idx[p] {
                            is_pinned = 1
                        }
                        p = p + 1
                    }
                    if is_pinned == 0 {
                        let key: i32 = reg.key[idx]
                        let tp: i32 = reg.tp[idx]
                        tp_free(pr, sec, key, tp)
                        reg.live[idx] = 0
                        reg.tp[idx] = -1
                        reg.live_list[j] = reg.live_list[top - 1]
                        reg.live_top[0] = top - 1
                        did_del = 1
                    }
                }
                attempts = attempts + 1
            }
        }
        ops = ops + 1
    }
    let mut stab_ok: i32 = 1
    i = 0
    while i < 8 {
        let idx: i32 = pin_idx[i]
        if reg.live[idx] != 1 {
            stab_ok = 0
        }
        if reg.pos[idx] != pinned[i] {
            stab_ok = 0
        }
        if reg.key[idx] != pin_keys[i] {
            stab_ok = 0
        }
        if reg.val[idx] != pin_vals[i] {
            stab_ok = 0
        }
        if reg.pos[idx] == pinned[i] and values[reg.pos[idx]] != reg.val[idx] {
            stab_ok = 0
        }
        i = i + 1
    }
    print("  after ")
    print(CHURN_OPS)
    println(" more ops, 8 pinned values: ")
    if stab_ok == 1 {
        println("positions unchanged ✓")
    } else {
        println("MOVED ✗")
    }
    println("")
    t3 = now_ns() - t0

    # ---- phase 4: stable dictionary demo -----------------------------------
    println("────────────────────────────────────────────────────────────────────────")
    println("Phase 4 — stable dictionary (Theorem 8): map key → tiny pointer")
    println("  value array replaced by tiny pointers into the dereference table;")
    println("  a full map rehash (reallocation) cannot invalidate any value.")
    t0 = now_ns()
    let mut dm: DMap = dmap_create()
    let dmp: ptr<DMap> = &dm
    let mut dict_keys: array<i32, 8> = [-1]
    let mut dict_pos: array<i32, 8> = [-1]
    let mut dict_val: array<i32, 8> = [-1]
    i = 0
    while i < 8 {
        let key: i32 = distinct_key(next_key)
        let value: i32 = 100000 + i
        let mut pos: i32 = 0
        let tp: i32 = tp_allocate(pr, sec, values, key, value, &pos)
        if tp < 0 {
            println("FAIL: dictionary allocate")
            return 1
        }
        let oki: i32 = dmap_insert(dmp, key, tp)
        if oki == 0 {
            println("FAIL: dictionary insert")
            return 1
        }
        dict_keys[i] = key
        dict_pos[i] = pos
        dict_val[i] = value
        next_key = next_key + 1
        i = i + 1
    }
    # Verify lookups before rehash.
    let mut look_ok: i32 = 1
    i = 0
    while i < 8 {
        let tp: i32 = dmap_lookup(dmp, dict_keys[i])
        if tp < 0 {
            look_ok = 0
        }
        if tp >= 0 and tp_dereference(pr, sec, dict_keys[i], tp) != dict_pos[i] {
            look_ok = 0
        }
        i = i + 1
    }
    # Full rehash: the map reallocates and repositions every entry.
    let moved: i32 = dmap_rebuild(dmp)
    let mut after_ok: i32 = 1
    i = 0
    while i < 8 {
        let tp: i32 = dmap_lookup(dmp, dict_keys[i])
        if tp < 0 {
            after_ok = 0
        }
        if tp >= 0 and tp_dereference(pr, sec, dict_keys[i], tp) != dict_pos[i] {
            after_ok = 0
        }
        if tp >= 0 and values[dict_pos[i]] != dict_val[i] {
            after_ok = 0
        }
        i = i + 1
    }
    print("  8 dict entries, lookups before rehash: ")
    if look_ok == 1 {
        println("all correct ✓")
    } else {
        println("FAILED ✗")
    }
    print("  rehash moved ")
    print(moved)
    print(" map entries; lookups after: ")
    if after_ok == 1 {
        println("all correct, values never moved ✓")
    } else {
        println("FAILED ✗")
    }
    println("")
    t4 = now_ns() - t0

    # ---- phase 5: Theorem 2 — variable-size tiny pointers -------------------
    banner2()
    println("────────────────────────────────────────────────────────────────────────")
    print("Phase 5 — natural load: ")
    print(V_MAX_LIVE)
    print(" uniform keys into ")
    print(V_N_CONTAINERS)
    println(" containers")
    t0 = now_ns()
    let mut vt: VarTable = vtable_create()
    let vtp: ptr<VarTable> = &vt
    let mut vreg: Registry = registry_create()
    let vrp: ptr<Registry> = &vreg
    # per-level counts of live pointers at the end
    let mut v_levels: array<i32, 5> = [0]
    i = 0
    while i < V_MAX_LIVE {
        let key: i32 = distinct_key(i)
        let value: i32 = (key * 7) & 0xFFFF
        let ok: i32 = vreg_insert(vrp, vtp, key, value)
        if ok == 0 {
            println("FAIL: variable table over capacity during bulk load")
            return 1
        }
        i = i + 1
    }
    let v_errs: i32 = vreg_verify(vrp, vtp)
    let v_inv: i32 = vtable_check(vtp)
    print("  inserted ")
    print(V_MAX_LIVE)
    print("   verify: ")
    print(v_errs)
    print("   invariants: ")
    print(v_inv)
    println("")
    # level histogram over live keys
    i = 0
    while i < REG_SIZE {
        if vreg.live[i] == 1 {
            let lvl: i32 = (vreg.tp[i] >> 5) & 7
            v_levels[lvl] = v_levels[lvl] + 1
        }
        i = i + 1
    }
    print("  pointer levels (natural):  ")
    i = 0
    while i < V_LEVELS {
        print("L")
        print(i)
        print(":")
        print(v_levels[i])
        print("  ")
        i = i + 1
    }
    println("")
    println("  → ~98% of keys get a 3-bit pointer; the doubly-exponential tail is")
    println("    invisible at this scale (that is the point).")
    println("")
    t5 = now_ns() - t0

    # ---- phase 6: adversarial cascade --------------------------------------
    println("────────────────────────────────────────────────────────────────────────")
    println("Phase 6 — adversarial cascade: 20 keys forced into ONE container")
    println("  (offline bit-exact search found keys sharing container 5, level-0")
    println("  bucket 3, and — nested — the same level-1/2/3 buckets)")
    t0 = now_ns()
    # evict container 5's natural occupants so we own it
    let evicted: i32 = vreg_evict_container(vrp, vtp, 5)
    print("  evicted ")
    print(evicted)
    println(" natural occupants of container 5")
    # the adversarial key set, deepest-colliding first
    let adv_keys: array<i32, 20> = [
        32055649, 46581792, 211865382, 279651079, 283243506, 333410880, 408277389, 439905052,
        26503531, 54582752, 56783627, 73319737,
        2121761, 6236346, 16609716, 17826984,
        2135, 95883, 365132, 562735
    ]
    let mut adv_levels: array<i32, 5> = [0]
    let mut adv_of: array<i32, 5> = [0]
    i = 0
    while i < 20 {
        let key: i32 = adv_keys[i]
        let value: i32 = (key * 7) & 0xFFFF
        let ok: i32 = vreg_insert(vrp, vtp, key, value)
        if ok == 0 {
            println("FAIL: adversarial insert")
            return 1
        }
        # last inserted key is at next_idx-1; record its level + overflow use
        let idx: i32 = vreg.next_idx[0] - 1
        let lvl: i32 = (vreg.tp[idx] >> 5) & 7
        let of: i32 = (vreg.tp[idx] >> 8) & 1
        adv_levels[lvl] = adv_levels[lvl] + 1
        adv_of[lvl] = adv_of[lvl] + of
        i = i + 1
    }
    let v_errs2: i32 = vreg_verify(vrp, vtp)
    let v_inv2: i32 = vtable_check(vtp)
    print("  verify (all ")
    print(vreg.live_top[0])
    print(" live keys): ")
    print(v_errs2)
    print("   invariants: ")
    print(v_inv2)
    println("")
    print("  adversarial pointer levels:  ")
    i = 0
    while i < V_LEVELS {
        print("L")
        print(i)
        print(":")
        print(adv_levels[i])
        print("  ")
        i = i + 1
    }
    println("")
    print("  overflow arrays engaged:     ")
    i = 0
    while i < V_LEVELS {
        print("O")
        print(i)
        print(":")
        print(adv_of[i])
        print("  ")
        i = i + 1
    }
    println("")
    print("  even a forced worst case never exceeds 11 bits (raw pointer: ")
    print(LOG_N)
    println(").")
    println("")

    # ---- tail-bound table --------------------------------------------------
    let tail_ok: i32 = vtail_report(vrp)
    t6 = now_ns() - t0

    # ---- phase 7: relaxed retrieval (Theorem 6) ----------------------------
    banner3()
    println("────────────────────────────────────────────────────────────────────────")
    println("Phase 7 — relaxed retrieval: Insert(x,y) → O(1)-expected hint r")
    println("  the dereference table is used ONLY for the unique slot it hands")
    println("  out — its store is never read (paper: 'we need not even allocate")
    println("  space for it'). Values live in hash table H keyed on the slot.")
    t0 = now_ns()
    let mut rvt: VarTable = vtable_create()
    let rvtp: ptr<VarTable> = &rvt
    let mut rh: RHash = rhash_create()
    let rhp: ptr<RHash> = &rh
    let mut rreg: Registry = registry_create()
    let rrp: ptr<Registry> = &rreg
    let mut rhints: array<i32, 16> = [0]
    let mut r_max_hint: i32 = 0
    let mut r_mean_sum: i32 = 0
    i = 0
    while i < R_MAX_LIVE {
        let key: i32 = distinct_key(i)
        let value: i32 = (key * 7) & 0xFFFF
        let ok: i32 = rreg_insert(rrp, rvtp, rhp, key, value)
        if ok == 0 {
            println("FAIL: retrieval insert")
            return 1
        }
        let ridx: i32 = rreg.next_idx[0] - 1
        let rsz: i32 = vtp_size(rreg.tp[ridx])
        rhints[rsz] = rhints[rsz] + 1
        r_mean_sum = r_mean_sum + rsz
        if rsz > r_max_hint {
            r_max_hint = rsz
        }
        i = i + 1
    }
    let mut r_dups: i32 = 0
    let r_errs: i32 = rreg_verify(rrp, rvtp, rhp, &r_dups)
    let r_inv: i32 = vtable_check(rvtp)
    let h_count: i32 = rhash_count(rhp)
    print("  inserted ")
    print(R_MAX_LIVE)
    print("   verify: ")
    print(r_errs)
    print("   slot dups: ")
    print(r_dups)
    print("   H entries: ")
    print(h_count)
    print("   invariants: ")
    print(r_inv)
    println("")
    let r_pct: f32 = ((rhints[3] as f32) / (R_MAX_LIVE as f32)) * 100.0
    let r_mean: f32 = (r_mean_sum as f32) / (R_MAX_LIVE as f32)
    print("  hint size: ")
    print(r_pct)
    print("% at 3 bits · mean ")
    print(r_mean)
    print(" bits · worst ")
    print(r_max_hint)
    print(" bits   (raw pointer: ")
    print(LOG_N)
    println(")")
    println("  classic dynamic retrieval lower bound: Ω(log log n) = 4 bits/value")
    print("  at n = 2^")
    print(LOG_N)
    println("  →  O(1)-expected hints BEAT the lower bound.")
    println("")
    t7 = now_ns() - t0

    # ---- phase 8: churn + tombstoned deletes + auxiliary rebuild -----------
    println("────────────────────────────────────────────────────────────────────────")
    print("Phase 8 — churn + rebuild: ")
    print(R_CHURN_OPS)
    println(" ops, then H rebuilds in place")
    t0 = now_ns()
    println("  Delete(x, r) tombstones slot s_x in H and frees the table slot;")
    println("  H then REBUILDS with a new seed — hints name slots, not H cells,")
    println("  so every hint must survive untouched.")
    let ev2: i32 = rreg_evict_container(rrp, rvtp, rhp, 5)
    print("  evicted ")
    print(ev2)
    println(" natural occupants of container 5 (adversarial closing)")
    i = 0
    while i < 20 {
        let key: i32 = adv_keys[i]
        let value: i32 = (key * 7) & 0xFFFF
        let ok: i32 = rreg_insert(rrp, rvtp, rhp, key, value)
        if ok == 0 {
            println("FAIL: retrieval adversarial insert")
            return 1
        }
        i = i + 1
    }
    let r_errs2: i32 = rreg_verify(rrp, rvtp, rhp, &r_dups)
    print("  20 worst-case hints in; verify: ")
    print(r_errs2)
    print("   dups: ")
    print(r_dups)
    println("")
    ops = 0
    let mut r_churn_errors: i32 = 0
    while ops < R_CHURN_OPS {
        let rr: i32 = rng_next(sp) % 100
        if rr < 55 and rreg.live_top[0] < R_MAX_LIVE + 32 {
            let key: i32 = distinct_key(next_key)
            let value: i32 = (key * 7) & 0xFFFF
            let ok: i32 = rreg_insert(rrp, rvtp, rhp, key, value)
            if ok == 0 {
                println("FAIL: retrieval churn insert")
                return 1
            }
            next_key = next_key + 1
        } else {
            let _d: i32 = rreg_delete_random(rrp, rvtp, rhp, sp)
        }
        if (ops % 5000) == 4999 {
            let e: i32 = rreg_verify(rrp, rvtp, rhp, &r_dups)
            r_churn_errors = r_churn_errors + e
        }
        ops = ops + 1
    }
    let moved_h: i32 = rhash_rebuild(rhp)
    let r_after: i32 = rreg_verify(rrp, rvtp, rhp, &r_dups)
    let h_count2: i32 = rhash_count(rhp)
    print("  churn ops: ")
    print(R_CHURN_OPS)
    print("   verify errors: ")
    print(r_churn_errors)
    print("   live: ")
    print(rreg.live_top[0])
    println("")
    print("  H rebuilt (")
    print(moved_h)
    print(" entries, new seed); verify after: ")
    print(r_after)
    print("   H entries: ")
    print(h_count2)
    println("")
    println("  → every hint survived the auxiliary rebuild untouched (they name")
    println("    slots in the dereference table, not cells in H).")
    println("")
    t8 = now_ns() - t0

    # ---- phase 8b: Theorem 6 tradeoff — r levels of indirection ------------
    println("────────────────────────────────────────────────────────────────────────")
    println("Phase 8b — Theorem 6 TRADEOFF: r levels of indirection (paper §6.2)")
    println("  sweep r = 1..4: the retriever (level-0 slot code) costs w₀ = ⌈log⁽ʳ⁾ n⌉")
    println("  bits — the O(n log⁽ʳ⁾ n) space term — while insert/delete descend up")
    println("  to r bucket levels: the O(r)-time side of the tradeoff curve.")
    t0 = now_ns()
    let mut rr_ok: i32 = 1
    let mut rr_run: i32 = 1
    let log2n: i32 = log2i(2 * RR_N)
    while rr_run <= 4 {
        let r: i32 = rr_run
        let mut rrc: RrChain = rr_chain_create(r, log2n, 0)
        let rrcp: ptr<RrChain> = &rrc
        let mut rrreg: Registry = registry_create()
        let rrrp: ptr<Registry> = &rrreg
        let mut rr_bits_sum: i32 = 0
        let mut rr_dep_sum: i32 = 0
        let mut rr_max_dep: i32 = 0
        let mut rr_ins: i32 = 0
        i = 0
        while i < RR_N {
            let key: i32 = distinct_key(next_key)
            next_key = next_key + 1
            let value: i32 = (key * 7) & 0xFFFF
            let d: i32 = rr_insert(rrcp, rrrp, key, value)
            if d < 0 {
                println("FAIL: r-tradeoff load insert")
                return 1
            }
            rr_dep_sum = rr_dep_sum + d
            rr_ins = rr_ins + 1
            if d > rr_max_dep {
                rr_max_dep = d
            }
            i = i + 1
        }
        let mut rr_dups: i32 = 0
        let rr_errs: i32 = rr_verify(rrcp, rrrp, &rr_dups)
        let rr_sz: i32 = rrreg.live_top[0]
        i = 0
        while i < REG_SIZE {
            if rrreg.live[i] == 1 {
                rr_bits_sum = rr_bits_sum + rr_bits(rrcp, rrreg.tp[i])
            }
            i = i + 1
        }
        # churn: 55/45 insert/delete, timed
        ops = 0
        let mut rr_cerr: i32 = 0
        let tC: i64 = now_ns()
        while ops < RR_CHURN {
            let rr2: i32 = rng_next(sp) % 100
            if rr2 < 55 and rrreg.live_top[0] < RR_N + 64 {
                let key: i32 = distinct_key(next_key)
                next_key = next_key + 1
                let value: i32 = (key * 7) & 0xFFFF
                let d: i32 = rr_insert(rrcp, rrrp, key, value)
                if d < 0 {
                    println("FAIL: r-tradeoff churn insert")
                    return 1
                }
                rr_dep_sum = rr_dep_sum + d
                rr_ins = rr_ins + 1
                if d > rr_max_dep {
                    rr_max_dep = d
                }
            } else {
                let top: i32 = rrreg.live_top[0]
                if top > 0 {
                    let j: i32 = rng_next(sp) % top
                    let ridx: i32 = rrreg.live_list[j]
                    rr_delete(rrcp, rrreg.key[ridx], rrreg.tp[ridx])
                    rrreg.live[ridx] = 0
                    rrreg.live_list[j] = rrreg.live_list[top - 1]
                    rrreg.live_top[0] = top - 1
                }
            }
            if (ops % 2000) == 1999 {
                let e: i32 = rr_verify(rrcp, rrrp, &rr_dups)
                rr_cerr = rr_cerr + e
            }
            ops = ops + 1
        }
        let tD: i64 = now_ns()
        let rr_after: i32 = rr_verify(rrcp, rrrp, &rr_dups)
        let rr_per_op: f64 = ((tD - tC) as f64) / (RR_CHURN as f64)
        # adversarial worst case: every level a single bucket — all keys
        # collide at every level and cascade to the deepest bucket (O(r)).
        # (single-bucket mode mallocs the full level tables — degenerate but
        # harmless: r=1 alone is a 2^15-slot table for 64 keys, freed below)
        let mut rca: RrChain = rr_chain_create(r, log2n, 1)
        let rcap: ptr<RrChain> = &rca
        let mut arreg: Registry = registry_create()
        let arp: ptr<Registry> = &arreg
        let mut adv_max_d: i32 = 0
        let tE: i64 = now_ns()
        i = 0
        while i < RR_ADV {
            let key: i32 = distinct_key(next_key)
            next_key = next_key + 1
            let value: i32 = (key * 7) & 0xFFFF
            let d: i32 = rr_insert(rcap, arp, key, value)
            if d < 0 {
                println("FAIL: r-tradeoff adversarial insert")
                return 1
            }
            if d > adv_max_d {
                adv_max_d = d
            }
            i = i + 1
        }
        let tF: i64 = now_ns()
        let adv_sum_ns: i64 = tF - tE
        let adv_d: i32 = rr_verify(rcap, arp, &rr_dups)
        let rr_w0: i32 = rrc.bw[0]
        let rr_meta: i32 = rr_sz * rr_w0
        let rr_mean_bits: f32 = (rr_bits_sum as f32) / (rr_sz as f32)
        print("  r=")
        print(r)
        print("  w₀ = ⌈log⁽ʳ⁾ n⌉ = ")
        print(rr_w0)
        print(" bits · retriever metadata n·w₀ = ")
        print(rr_meta)
        print(" bits (")
        printf("%.2f", rr_mean_bits)
        print(" bits/key incl. level tag) · nv + n·w₀ = ")
        print(rr_meta + rr_sz * 16)
        print(" bits")
        println("")
        print("    load ")
        print(RR_N)
        print(" keys: verify ")
        print(rr_errs)
        print(" · mean descent ")
        printf("%.2f", (rr_dep_sum as f32) / (rr_ins as f32))
        print(" · max descent depth ")
        print(rr_max_dep + 1)
        print(" · churn ")
        printf("%.1f", rr_per_op)
        print(" ns/op avg · churn verify ")
        print(rr_cerr)
        print("/")
        print(rr_after)
        println("")
        print("    worst case (single-bucket cascade, ")
        print(RR_ADV)
        print(" keys, every level a single bucket): max descent depth ")
        print(adv_max_d + 1)
        print(" = r · total insert ")
        print(adv_sum_ns)
        print(" ns (mean ")
        printf("%.1f", (adv_sum_ns as f64) / (RR_ADV as f64))
        print(" ns/op) · verify ")
        print(adv_d)
        println("")
        if rr_errs != 0 or rr_cerr != 0 or rr_after != 0 or rr_dups != 0 or adv_d != 0 {
            rr_ok = 0
        }
        rr_chain_destroy(rrc)
        rr_chain_destroy(rca)
        registry_destroy(rrreg)
        registry_destroy(arreg)
        rr_run = rr_run + 1
    }
    t7b = now_ns() - t0
    println("")

    # ---- phase 9: succinct rotation-based BST (Theorem 7) ------------------
    banner4()
    println("────────────────────────────────────────────────────────────────────────")
    print("Phase 9 — AVL tree from ")
    print(BST_N)
    println(" SORTED keys (the worst case for a plain")
    t0 = now_ns()
    println("  BST): children reached only through tiny retrievers; every rotation")
    println("  rewrites 2-3 store slots while nodes and retrievers never move.")
    let mut bt: BSTree = bstree_create()
    let btp: ptr<BSTree> = &bt
    let mut bvt: VarTable = vtable_create()
    let bvtp: ptr<VarTable> = &bvt
    let mut root: i32 = BST_NULL
    i = 0
    while i < BST_N {
        root = bst_insert_avl(btp, bvtp, root, i, (i * 7) & 0xFFFF)
        i = i + 1
    }
    if root < 0 {
        println("FAIL: BST build")
        return 1
    }
    let mut last: i32 = -1
    let mut cnt: i32 = 0
    let mut ierr: i32 = 0
    bst_inorder_check(btp, bvtp, root, &last, &cnt, &ierr)
    let perr: i32 = bst_ptr_check(btp, bvtp)
    let hgt_root: i32 = bst_height(btp, root)
    let bchk: i32 = bst_balance_check(btp, bvtp, root)
    let vchk: i32 = vtable_check(bvtp)
    print("  inserted ")
    print(BST_N)
    print(" sorted keys — height ")
    print(hgt_root)
    print(" (AVL bound ≈ ")
    print(2 * log2i(BST_N) + 1)
    println(")")
    print("  in-order: ")
    print(cnt)
    print(" nodes, out-of-order pairs: ")
    print(ierr)
    println("")
    print("  balance check: height ")
    print(bchk)
    print(" (returned height; -1 = unbalanced)   pointer integrity: ")
    print(perr)
    print("   table invariants: ")
    print(vchk)
    println("")
    # pointer-size stats
    let mut bsum: i32 = 0
    i = 0
    while i < bt.n[0] {
        bsum = bsum + vtp_size(bt.lh[i]) + vtp_size(bt.rh[i])
        i = i + 1
    }
    let bmean: f32 = (bsum as f32) / (2.0 * (bt.n[0] as f32))
    let btot_raw: i32 = bt.n[0] * 2 * LOG_N
    print("  child pointers: ")
    print(bmean)
    print(" bits/node avg (tiny) vs ")
    print(LOG_N)
    print(" raw → structure ")
    print(bsum)
    print(" bits vs ")
    print(btot_raw)
    println(" bits for a raw BST (2n log n)")
    print("  rotations during AVL build: ")
    print(bt.rot[0])
    println(" — all constant-time edge overwrites")
    # average search depth via tiny-pointer navigation (values verified too,
    # so the b-bit value array is exercised, not just the pointers)
    let mut depth_sum: i32 = 0
    let mut val_err: i32 = 0
    let mut di: i32 = 0
    while di < 2048 {
        let kk: i32 = rng_next(sp) % BST_N
        let mut cur: i32 = root
        let mut depth: i32 = 0
        let mut done: i32 = 0
        while done == 0 {
            if cur == BST_NULL {
                done = 1
            } else {
                if kk == bt.key[cur] {
                    depth_sum = depth_sum + depth
                    if bt.val[cur] != ((kk * 7) & 0xFFFF) {
                        val_err = val_err + 1
                    }
                    done = 1
                } else {
                    if kk < bt.key[cur] {
                        cur = bst_child(btp, bvtp, cur, 0)
                    } else {
                        cur = bst_child(btp, bvtp, cur, 1)
                    }
                    depth = depth + 1
                }
            }
        }
        di = di + 1
    }
    let dmean: f32 = (depth_sum as f32) / 2048.0
    print("  avg search depth over 2048 random keys: ")
    print(dmean)
    print("  (log₂ n = ")
    print(log2i(BST_N))
    print(")   value mismatches: ")
    print(val_err)
    println("")
    println("  nodes never move: key i lives at array position i; retrievers never")
    println("  change — rotations rewrite only the 2-3 touched store slots.")
    println("")
    t9 = now_ns() - t0

    # ---- phase 10: rotation storm ------------------------------------------
    println("────────────────────────────────────────────────────────────────────────")
    print("Phase 10 — rotation storm: ")
    print(BST_STORM)
    println(" random rotations at random nodes")
    t0 = now_ns()
    println("  rotations preserve in-order order by definition — the storm churns")
    println("  the tree shape without ever moving a node or rewriting a retriever.")
    let mut att: i32 = 0
    let rot_before: i32 = bt.rot[0]
    while att < BST_STORM {
        let kk: i32 = rng_next(sp) % BST_N
        let side: i32 = rng_next(sp) % 2
        root = bst_rotate_key(btp, bvtp, root, kk, side)
        att = att + 1
    }
    let s_rot: i32 = bt.rot[0] - rot_before
    let mut last2: i32 = -1
    let mut cnt2: i32 = 0
    let mut ierr2: i32 = 0
    bst_inorder_check(btp, bvtp, root, &last2, &cnt2, &ierr2)
    let perr2: i32 = bst_ptr_check(btp, bvtp)
    print("  ")
    print(BST_STORM)
    print(" attempts, ")
    print(s_rot)
    println(" real rotations (rest: no child on that side)")
    print("  in-order after storm: ")
    print(cnt2)
    print(" nodes, out-of-order: ")
    print(ierr2)
    println("")
    print("  pointer integrity: ")
    print(perr2)
    println("   — retrievers, slots and node positions all untouched ✓")
    println("")
    t10 = now_ns() - t0

    # ---- phase 11: variable-size value dictionaries (Theorem 9) -----------
    banner5()
    println("────────────────────────────────────────────────────────────────────────")
    print("Phase 11 — variable-size value dictionaries: ")
    print(VD_MAX_KEYS)
    println(" keys, skewed value sizes (Theorem 9)")
    println("  each v-bit value lives in size class ⌈log₂ v⌉; class j has its own")
    println("  dereference-table storage with 2^j-bit slots, so the value space is")
    println("  Σ(2^⌈log vᵢ⌉ + O(log vᵢ)) instead of a uniform 64-bit slot per key.")
    t0 = now_ns()
    let mut vdt: VDTable = vdtable_create()
    let vdtp: ptr<VDTable> = &vdt
    let mut vdreg: Registry = registry_create()
    let vdrp: ptr<Registry> = &vdreg
    let vdv_raw: ptr<u8> = malloc(REG_SIZE * 8)
    let vdv: ptr<i64> = vdv_raw
    let vdb_raw: ptr<u8> = malloc(REG_SIZE * 4)
    let vdb: ptr<i32> = vdb_raw
    let mut vd_hist: array<i32, 7> = [0]
    i = 0
    while i < VD_MAX_KEYS {
        let key: i32 = distinct_key(i)
        let mut vdbits: i32 = 0
        let value: i64 = vd_make_value(sp, key, &vdbits)
        let ok: i32 = vdreg_insert(vdrp, vdv, vdb, vdtp, key, value, vdbits)
        if ok == 0 {
            println("FAIL: variable-value insert")
            return 1
        }
        vd_hist[vd_class_of(vdbits)] = vd_hist[vd_class_of(vdbits)] + 1
        i = i + 1
    }
    let vd_errs: i32 = vdreg_verify(vdrp, vdv, vdb, vdtp)
    let vd_inv: i32 = vdtable_check(vdtp)
    print("  verify (all ")
    print(vdreg.live_top[0])
    print(" live): ")
    print(vd_errs)
    print("   per-class invariants: ")
    print(vd_inv)
    println("")
    print("  value sizes by class (1,2,4,8,16,32,64-bit slots):  ")
    i = 0
    while i < 7 {
        print(vd_hist[i])
        print("  ")
        i = i + 1
    }
    println("")
    # value-space accounting vs the uniform 64-bit baseline
    let mut vd_payload: i32 = 0
    let mut vd_ptr: i32 = 0
    i = 0
    while i < REG_SIZE {
        if vdreg.live[i] == 1 {
            let j: i32 = vd_class_of(vdb[i])
            vd_payload = vd_payload + vd_cap(j)
            vd_ptr = vd_ptr + 7
        }
        i = i + 1
    }
    let vd_live: i32 = vdreg.live_top[0]
    let vd_used: i32 = vd_payload + vd_ptr
    let vd_base: i32 = 64 * vd_live
    let vd_mean: f32 = (vd_used as f32) / (vd_live as f32)
    print("  value space (payload + 7-bit pointers): ")
    print(vd_used)
    print(" bits = ")
    print(vd_mean)
    print(" bits/value   vs uniform 64-bit: ")
    print(vd_base)
    print(" bits  →  ")
    print((100.0 * (vd_base as f32 - vd_used as f32)) / (vd_base as f32))
    println("% saved")
    # churn: delete random keys, insert fresh skewed values
    ops = 0
    let mut vd_churn_errors: i32 = 0
    while ops < CHURN_OPS {
        let rr: i32 = rng_next(sp) % 100
        if rr < 55 and vdreg.live_top[0] < VD_MAX_KEYS + 32 {
            let key: i32 = distinct_key(next_key)
            let mut vdbits2: i32 = 0
            let value2: i64 = vd_make_value(sp, key, &vdbits2)
            let ok2: i32 = vdreg_insert(vdrp, vdv, vdb, vdtp, key, value2, vdbits2)
            if ok2 == 0 {
                println("FAIL: variable-value churn insert")
                return 1
            }
            next_key = next_key + 1
        } else {
            let _d2: i32 = vdreg_delete_random(vdrp, vdtp, sp)
        }
        if (ops % 5000) == 4999 {
            let e: i32 = vdreg_verify(vdrp, vdv, vdb, vdtp)
            vd_churn_errors = vd_churn_errors + e
        }
        ops = ops + 1
    }
    # uniform 64-bit control: every value max-size — the bound becomes tight
    let mut ui: i32 = 0
    while ui < 8192 {
        let key: i32 = distinct_key(next_key)
        let value: i64 = hash_u32(key, 88) as i64
        let ok: i32 = vdreg_insert(vdrp, vdv, vdb, vdtp, key, value, 64)
        if ok == 0 {
            println("FAIL: uniform control insert")
            return 1
        }
        next_key = next_key + 1
        ui = ui + 1
    }
    let vd_after: i32 = vdreg_verify(vdrp, vdv, vdb, vdtp)
    let vd_inv2: i32 = vdtable_check(vdtp)
    let vd_live2: i32 = vdreg.live_top[0]
    let mut vd_p2: i32 = 0
    i = 0
    while i < REG_SIZE {
        if vdreg.live[i] == 1 {
            vd_p2 = vd_p2 + vd_cap(vd_class_of(vdb[i]))
        }
        i = i + 1
    }
    let vd_used2: i32 = vd_p2 + 7 * vd_live2
    let vd_mean2: f32 = (vd_used2 as f32) / (vd_live2 as f32)
    print("  churn: ")
    print(CHURN_OPS)
    print(" ops + uniform 64-bit control (+8192): verify ")
    print(vd_churn_errors + vd_after)
    print("   invariants: ")
    print(vd_inv2)
    println("")
    print("  final: ")
    print(vd_live2)
    print(" live · ")
    print(vd_mean2)
    println(" bits/value — skewed values stay ≈ their size, only max-size")
    println("  values pay the full 64 bits (the bound is tight when all values")
    println("  are large, exactly as the paper predicts).")
    println("")
    t11 = now_ns() - t0

    # ---- phase 12: variable-size keys + values combined (Thm 9 keys analogue)
    banner6()
    println("────────────────────────────────────────────────────────────────────────")
    print("Phase 12 — variable-size key + value dictionaries: ")
    print(KD_MAX_KEYS)
    println(" pairs, skewed key and value sizes")
    println("  keys AND values are size-classed (Theorem 9's remark applied to the")
    println("  key array): a k-bit key lives in class ⌈log₂ k⌉ (2^⌈log k⌉-bit slots),")
    println("  a v-bit value in class ⌈log₂ v⌉ — the pair costs Σ(2^⌈log kᵢ⌉ + 2^⌈log vᵢ⌉")
    println("  + O(log kᵢ) + O(log vᵢ)) instead of a uniform 64+64-bit slot.")
    println("  Keys of 65-256 bits additionally go through the r-levels chain (the")
    println("  Phase-15 value chain mirrored on the KEY side): the key lives in a")
    println("  compact key arena behind a 5-bit p₁, held in an 8-bit base slot —")
    println("  the base pointer stays 8 bits for EVERY key size.")
    t0 = now_ns()
    let mut kvt: VDTable = vdtable_create()
    let kvtp: ptr<VDTable> = &kvt
    let mut krlt: RLTable = rltable_create()
    let krltp: ptr<RLTable> = &krlt
    let mut vvt: VDTable = vdtable_create()
    let vvtp: ptr<VDTable> = &vvt
    let mut kdreg: Registry = registry_create()
    let kdrp: ptr<Registry> = &kdreg
    let kw0_raw: ptr<u8> = malloc(REG_SIZE * 8)
    let kw0: ptr<i64> = kw0_raw
    let kw1_raw: ptr<u8> = malloc(REG_SIZE * 8)
    let kw1: ptr<i64> = kw1_raw
    let kw2_raw: ptr<u8> = malloc(REG_SIZE * 8)
    let kw2: ptr<i64> = kw2_raw
    let kw3_raw: ptr<u8> = malloc(REG_SIZE * 8)
    let kw3: ptr<i64> = kw3_raw
    let kb_raw: ptr<u8> = malloc(REG_SIZE * 4)
    let kb: ptr<i32> = kb_raw
    let kc1_raw: ptr<u8> = malloc(REG_SIZE * 4)
    let kc1: ptr<i32> = kc1_raw
    let kca_raw: ptr<u8> = malloc(REG_SIZE * 4)
    let kca: ptr<i32> = kca_raw
    let vptrs_raw: ptr<u8> = malloc(REG_SIZE * 4)
    let vptrs: ptr<i32> = vptrs_raw
    let vposs_raw: ptr<u8> = malloc(REG_SIZE * 4)
    let vposs: ptr<i32> = vposs_raw
    let kvv_raw: ptr<u8> = malloc(REG_SIZE * 8)
    let kvv: ptr<i64> = kvv_raw
    let kvb_raw: ptr<u8> = malloc(REG_SIZE * 4)
    let kvb: ptr<i32> = kvb_raw
    let mut kd_khist: array<i32, 9> = [0]   # 7 direct classes + 128-bit + 256-bit arena
    let mut kd_vhist: array<i32, 7> = [0]
    let mut kd_chained: i32 = 0             # keys in the arena (65-256 bits)
    i = 0
    while i < KD_MAX_KEYS {
        let key: i32 = distinct_key(i)
        let mut kdbits: i32 = 0
        let mut k0: i64 = 0
        let mut k1: i64 = 0
        let mut k2: i64 = 0
        let mut k3: i64 = 0
        kch_make_key(sp, key, &kdbits, &k0, &k1, &k2, &k3)
        let mut vdbits: i32 = 0
        let vpay: i64 = vd_make_value(sp, key, &vdbits)
        let ok: i32 = kchreg_insert(kdrp, kvtp, krltp, vvtp,
                                    kw0, kw1, kw2, kw3, kb, kc1, kca,
                                    vptrs, vposs, kvv, kvb,
                                    key, kdbits, k0, k1, k2, k3, vdbits, vpay)
        if ok == 0 {
            println("FAIL: variable-key insert")
            return 1
        }
        if kdbits < KDK_BIG {
            kd_khist[vd_class_of(kdbits)] = kd_khist[vd_class_of(kdbits)] + 1
        } else {
            let kac: i32 = rl_arena_class(kdbits)
            kd_khist[7 + kac] = kd_khist[7 + kac] + 1
            kd_chained = kd_chained + 1
        }
        kd_vhist[vd_class_of(vdbits)] = kd_vhist[vd_class_of(vdbits)] + 1
        i = i + 1
    }
    let kd_errs: i32 = kchreg_verify(kdrp, kvtp, krltp, vvtp,
                                     kw0, kw1, kw2, kw3, kb, kc1, kca,
                                     vptrs, vposs, kvv, kvb)
    let kd_kinv: i32 = vdtable_check(kvtp)
    let kd_kainv: i32 = kchtable_check(krltp)
    let kd_vinv: i32 = vdtable_check(vvtp)
    print("  verify (all ")
    print(kdreg.live_top[0])
    print(" live pairs): ")
    print(kd_errs)
    print("   key-table invariants: ")
    print(kd_kinv)
    print("   key-arena invariants: ")
    print(kd_kainv)
    print("   value-table invariants: ")
    print(kd_vinv)
    println("")
    print("  key sizes by class (1,2,4,8,16,32,64 + 128/256-bit arena): ")
    i = 0
    while i < 9 {
        print(kd_khist[i])
        print("  ")
        i = i + 1
    }
    println("")
    print("  value sizes by class (1,2,4,8,16,32,64-bit slots): ")
    i = 0
    while i < 7 {
        print(kd_vhist[i])
        print("  ")
        i = i + 1
    }
    println("")
    print("  chained keys (65-256 bits through the arena): ")
    print(kd_chained)
    print(" of ")
    print(KD_MAX_KEYS)
    println(" — the base pointer stays 8 bits for every key size")
    # combined key+value space accounting: chained keys pay the 8-bit holder +
    # 5-bit p₁ (13 bits) and the arena slot's 128/256-bit cap, like Phase 15
    let mut kd_kpayload: i32 = 0
    let mut kd_vpayload: i32 = 0
    let mut kd_kptrs: i32 = 0
    i = 0
    while i < REG_SIZE {
        if kdreg.live[i] == 1 {
            if kc1[i] < 0 {
                kd_kpayload = kd_kpayload + vd_cap(vd_class_of(kb[i]))
                kd_kptrs = kd_kptrs + 7            # direct key pointer
            } else {
                if kb[i] <= 128 {
                    kd_kpayload = kd_kpayload + 128
                } else {
                    kd_kpayload = kd_kpayload + 256
                }
                kd_kptrs = kd_kptrs + 13           # 8-bit holder + 5-bit p₁
            }
            kd_vpayload = kd_vpayload + vd_cap(vd_class_of(kvb[i]))
        }
        i = i + 1
    }
    let kd_live: i32 = kdreg.live_top[0]
    let kd_used: i32 = kd_kpayload + kd_vpayload + kd_kptrs + 7 * kd_live
    let kd_base: i32 = 128 * kd_live
    let kd_base256: i32 = 320 * kd_live
    let kd_mean: f32 = (kd_used as f32) / (kd_live as f32)
    print("  combined key+value space (payloads + 2×7-bit pointers, chained")
    println(" keys +13):")
    print("  ")
    print(kd_used)
    print(" bits = ")
    print(kd_mean)
    print(" bits/pair   vs uniform 64+64: ")
    print(kd_base)
    print(" bits  →  ")
    print((100.0 * (kd_base as f32 - kd_used as f32)) / (kd_base as f32))
    print("% saved   vs uniform 256+64: ")
    print(kd_base256)
    print(" bits  →  ")
    print((100.0 * (kd_base256 as f32 - kd_used as f32)) / (kd_base256 as f32))
    println("% saved")
    # churn: delete random pairs, insert fresh skewed pairs
    ops = 0
    let mut kd_churn_errors: i32 = 0
    while ops < CHURN_OPS {
        let rr: i32 = rng_next(sp) % 100
        if rr < 55 and kdreg.live_top[0] < KD_MAX_KEYS + 32 {
            let key: i32 = distinct_key(next_key)
            let mut kdbits2: i32 = 0
            let mut k02: i64 = 0
            let mut k12: i64 = 0
            let mut k22: i64 = 0
            let mut k32: i64 = 0
            kch_make_key(sp, key, &kdbits2, &k02, &k12, &k22, &k32)
            let mut vdbits2: i32 = 0
            let vpay2: i64 = vd_make_value(sp, key, &vdbits2)
            let ok2: i32 = kchreg_insert(kdrp, kvtp, krltp, vvtp,
                                         kw0, kw1, kw2, kw3, kb, kc1, kca,
                                         vptrs, vposs, kvv, kvb,
                                         key, kdbits2, k02, k12, k22, k32, vdbits2, vpay2)
            if ok2 == 0 {
                println("FAIL: variable-key churn insert")
                return 1
            }
            next_key = next_key + 1
        } else {
            let _d3: i32 = kchreg_delete_random(kdrp, kvtp, krltp, vvtp, kc1, vptrs, sp)
        }
        if (ops % 5000) == 4999 {
            let e: i32 = kchreg_verify(kdrp, kvtp, krltp, vvtp,
                                       kw0, kw1, kw2, kw3, kb, kc1, kca,
                                       vptrs, vposs, kvv, kvb)
            kd_churn_errors = kd_churn_errors + e
        }
        ops = ops + 1
    }
    # uniform 64+64 control (direct: both sides max-size — both direct bounds
    # become tight) + uniform 256+64 control (chained keys at max size — the
    # key-chain bound becomes tight)
    let mut kui: i32 = 0
    while kui < KD_CONTROL {
        let key: i32 = distinct_key(next_key)
        let kpay: i64 = hash_u32(key, 88) as i64
        let vpay: i64 = hash_u32(key, 89) as i64
        let ok: i32 = kchreg_insert(kdrp, kvtp, krltp, vvtp,
                                    kw0, kw1, kw2, kw3, kb, kc1, kca,
                                    vptrs, vposs, kvv, kvb,
                                    key, 64, kpay, 0, 0, 0, 64, vpay)
        if ok == 0 {
            println("FAIL: uniform key control insert")
            return 1
        }
        next_key = next_key + 1
        kui = kui + 1
    }
    let mut kbi: i32 = 0
    while kbi < KDK_CONTROL_BIG {
        let key: i32 = distinct_key(next_key)
        let kpay: i64 = hash_u32(key, 98) as i64
        let vpay: i64 = hash_u32(key, 99) as i64
        let ok: i32 = kchreg_insert(kdrp, kvtp, krltp, vvtp,
                                    kw0, kw1, kw2, kw3, kb, kc1, kca,
                                    vptrs, vposs, kvv, kvb,
                                    key, 256, kpay, kpay, kpay, kpay, 64, vpay)
        if ok == 0 {
            println("FAIL: uniform 256+64 control insert")
            return 1
        }
        next_key = next_key + 1
        kbi = kbi + 1
    }
    let kd_after: i32 = kchreg_verify(kdrp, kvtp, krltp, vvtp,
                                      kw0, kw1, kw2, kw3, kb, kc1, kca,
                                      vptrs, vposs, kvv, kvb)
    let kd_kinv2: i32 = vdtable_check(kvtp)
    let kd_kainv2: i32 = kchtable_check(krltp)
    let kd_vinv2: i32 = vdtable_check(vvtp)
    let kd_live2: i32 = kdreg.live_top[0]
    let mut kd_kp2: i32 = 0
    let mut kd_vp2: i32 = 0
    let mut kd_kptr2: i32 = 0
    i = 0
    while i < REG_SIZE {
        if kdreg.live[i] == 1 {
            if kc1[i] < 0 {
                kd_kp2 = kd_kp2 + vd_cap(vd_class_of(kb[i]))
                kd_kptr2 = kd_kptr2 + 7
            } else {
                if kb[i] <= 128 {
                    kd_kp2 = kd_kp2 + 128
                } else {
                    kd_kp2 = kd_kp2 + 256
                }
                kd_kptr2 = kd_kptr2 + 13
            }
            kd_vp2 = kd_vp2 + vd_cap(vd_class_of(kvb[i]))
        }
        i = i + 1
    }
    let kd_used2: i32 = kd_kp2 + kd_vp2 + kd_kptr2 + 7 * kd_live2
    let kd_mean2: f32 = (kd_used2 as f32) / (kd_live2 as f32)
    print("  churn: ")
    print(CHURN_OPS)
    print(" ops + uniform 64+64 control (+")
    print(KD_CONTROL)
    print(") + uniform 256+64 control (+")
    print(KDK_CONTROL_BIG)
    print("): verify ")
    print(kd_churn_errors + kd_after)
    print("   invariants: ")
    print(kd_kinv2 + kd_kainv2 + kd_vinv2)
    println("")
    print("  final: ")
    print(kd_live2)
    print(" live pairs · ")
    print(kd_mean2)
    println(" bits/pair — skewed keys+values stay ≈ their sizes, only the")
    println("  uniform 64+64 control pays the full 128 bits and the uniform")
    println("  256+64 control pays 320 (the chained-key bound tightens exactly")
    println("  as the paper predicts).")
    println("")
    t12 = now_ns() - t0

    # ---- phase 13: the lower bounds (Theorems 3-5) -------------------------
    banner7()
    t0 = now_ns()
    # Part A — Theorem 5 (Vöcking): ANY sequential rule that gives m balls
    # d = 2^s random bin choices leaves a fullest bin of Ω((log log m)/d).
    # Simulate least-loaded placement — the BEST possible rule — at every
    # pointer budget s, and verify F(s)·2^s ≥ log₂log₂m on every row.
    let lb_m: i32 = N_SLOTS        # m = 65536 balls into 65536 bins
    let bins_raw: ptr<i32> = malloc(lb_m * 4)
    let bins: ptr<i32> = bins_raw
    # log₂log₂m = log₂(LOG_N) — derive it so the floor tracks n in the bench
    let mut lb_lg: i32 = LOG_N
    let mut lb_floor: i32 = 0
    while lb_lg > 1 {
        lb_lg = lb_lg / 2
        lb_floor = lb_floor + 1
    }
    let mut lb_a_ok: i32 = 1
    print("  Part A — Theorem 5 floor: m = ")
    print(lb_m)
    println(" balls into m bins, least-loaded of d = 2^s (the best rule)")
    let mut lb_s: i32 = 0
    while lb_s <= LB_S_MAX {
        let mut z: i32 = 0
        while z < lb_m {
            bins[z] = 0
            z = z + 1
        }
        let d: i32 = 1 << lb_s
        let F: i32 = lb_place(bins, lb_m, d)
        let prod: i32 = F * d
        print("    s = ")
        print(lb_s)
        print("   d = 2^")
        print(lb_s)
        print(" = ")
        print(d)
        print("    fullest bin F = ")
        print(F)
        print("   F·2^s = ")
        print(prod)
        if prod >= lb_floor {
            print("  ✓  ≥ log₂log₂m = ")
            println(lb_floor)
        } else {
            println("  ✗  BELOW the floor")
            lb_a_ok = 0
        }
        lb_s = lb_s + 1
    }
    print("    F shrinks only logarithmically (7,4,2,2,2,2,2): doubling d")
    println("  saves < 1 load — the Ω((log log m)/d) floor, measured.")
    println("")
    # Part B — Theorem 4 (fixed-size): s = Ω(log log log n + log δ⁻¹). At
    # n = 2^16, δ = 1/4 the floor is 4 bits; the live pointer is 6. Mask the
    # real pointer to s bits and count the FORCED dereference collisions —
    # every bit below the real width breaks uniqueness on this very table.
    print("  Part B — Theorem 4: mask the live ")
    print(TP_BITS)
    println("-bit pointer to s bits, count forced collisions")
    let mut lb_b_ok: i32 = 1
    let mut lb_s2: i32 = TP_BITS
    let mut lb_coll_prev: i32 = 0
    while lb_s2 >= 3 {
        let coll: i32 = lb_mask_collisions(&reg, pr, sec, lb_s2)
        print("    s = ")
        print(lb_s2)
        print("   forced collisions: ")
        print(coll)
        if lb_s2 == TP_BITS {
            if coll == 0 {
                println("  ✓  real width names every slot uniquely")
            } else {
                println("  ✗  unexpected collisions at the real width")
                lb_b_ok = 0
            }
        } else {
            if coll > lb_coll_prev {
                println("  ✓  fewer bits ⇒ more collisions, as Theorem 4 predicts")
            } else {
                println("  ✗  monotonicity broken")
                lb_b_ok = 0
            }
        }
        lb_coll_prev = coll
        lb_s2 = lb_s2 - 1
    }
    println("    the scheme provably cannot spend fewer than the floor:")
    println("    even 5 bits collides on thousands of keys.")
    println("")
    # Part C — Theorem 3 (variable-size): expected pointer size Ω(log δ⁻¹).
    # The live variable-size registry (Phase 2) keeps its pointers at the
    # measured mean; log₂δ⁻¹ = log₂4 = 2 bits is the floor.
    let mut lb_sum: i32 = 0
    let mut lb_live: i32 = 0
    i = 0
    while i < REG_SIZE {
        if vreg.live[i] == 1 {
            let lvl: i32 = (vreg.tp[i] >> 5) & 7
            let of: i32 = (vreg.tp[i] >> 8) & 1
            let mut sz: i32 = elias_bits(lvl + 1) + 1 + 1
            if of == 1 {
                sz = elias_bits(V_LEVELS - lvl) + 1 + (V_LEVELS - lvl)
            }
            lb_sum = lb_sum + sz
            lb_live = lb_live + 1
        }
        i = i + 1
    }
    let lb_mean: f32 = (lb_sum as f32) / (lb_live as f32)
    let mut lb_c_ok: i32 = 1
    print("  Part C — Theorem 3: live variable-size mean ")
    print(lb_mean)
    print(" bits over ")
    print(lb_live)
    println(" pointers vs floor log₂δ⁻¹ = 2")
    if lb_mean >= 2.0 {
        println("    ✓  at/above the floor — the scheme cannot beat it")
    } else {
        println("    ✗  below the floor")
        lb_c_ok = 0
    }
    println("")
    free(bins_raw)
    t13 = now_ns() - t0

    # ---- phase 14: deamortized dynamic resizing (paper Section 6.1) --------
    banner8()
    println("────────────────────────────────────────────────────────────────────────")
    print("Phase 14 — deamortized dynamic resizing: ")
    print(RV_LOAD)
    print(" load + ")
    print(RV_CHURN)
    print(" churn + ")
    print(RV_DRAIN)
    print(" drain + ")
    print(RV_RELOAD)
    println(" reload, two runs (naive vs deamortized)")
    println("  same workload, same seed: the naive run finishes each resize inside the")
    println("  triggering op (the textbook Θ(m) copy); the deamortized run spreads it")
    println("  over the following ops at a fixed budget (RV_BUDGET = 16 values,")
    println("  RV_SCAN = 64 entries examined per op).")
    t0 = now_ns()
    let mut nvt: RVTable = rvtable_create()
    let nvtp: ptr<RVTable> = &nvt
    let mut nreg: Registry = registry_create()
    let nregp: ptr<Registry> = &nreg
    let nvv_raw: ptr<u8> = malloc(REG_SIZE * 8)
    let nvv: ptr<i64> = nvv_raw
    let nvb_raw: ptr<u8> = malloc(REG_SIZE * 4)
    let nvb: ptr<i32> = nvb_raw
    let mut sp_n: i32 = 987654321
    let mut n_max_work: i32 = 0
    let mut n_max_ns: i64 = 0
    let mut n_errs: i32 = 0
    rv_run_workload(nvtp, nregp, nvv, nvb, &sp_n, 1, &n_max_work, &n_max_ns, &n_errs)
    t14a = now_ns() - t0
    print("  naive one-shot resizing:   worst op = ")
    print(n_max_work)
    print(" work units · ")
    print(n_max_ns)
    print(" ns · verify ")
    print(n_errs)
    println("")
    t0 = now_ns()
    let mut dvt: RVTable = rvtable_create()
    let dvtp: ptr<RVTable> = &dvt
    let mut dreg: Registry = registry_create()
    let dregp: ptr<Registry> = &dreg
    let dvv_raw: ptr<u8> = malloc(REG_SIZE * 8)
    let dvv: ptr<i64> = dvv_raw
    let dvb_raw: ptr<u8> = malloc(REG_SIZE * 4)
    let dvb: ptr<i32> = dvb_raw
    let mut sp_d: i32 = 987654321
    let mut d_max_work: i32 = 0
    let mut d_max_ns: i64 = 0
    let mut d_errs: i32 = 0
    rv_run_workload(dvtp, dregp, dvv, dvb, &sp_d, 2, &d_max_work, &d_max_ns, &d_errs)
    t14b = now_ns() - t0
    print("  deamortized budget-per-op:  worst op = ")
    print(d_max_work)
    print(" work units · ")
    print(d_max_ns)
    print(" ns · verify ")
    print(d_errs)
    println("")
    print("  worst-case per-op: ")
    print(n_max_work)
    print(" → ")
    print(d_max_work)
    print(" work units — the naive trigger op pays Θ(live) in one shot; the")
    println("")
    print("  deamortized op caps at RV_BUDGET + RV_SCAN + 2 = ")
    print(RV_BUDGET + RV_SCAN + 2)
    print(" (measured worst ")
    print(d_max_work)
    println(" — the resize cost is fully spread, as Section 6.1 requires).")
    println("")
    let mut rv_ok: i32 = 1
    if n_errs != 0 {
        rv_ok = 0
    }
    if d_errs != 0 {
        rv_ok = 0
    }
    if d_max_work > RV_BUDGET + RV_SCAN + 2 {
        rv_ok = 0
    }
    if n_max_work <= 100 * d_max_work {
        rv_ok = 0
    }
    t14 = t14a + t14b

    # ---- phase 15: r-levels of indirection (paper Theorem 9 proof, §6.5) ---
    banner9()
    println("────────────────────────────────────────────────────────────────────────")
    print("Phase 15 — r-levels of indirection: ")
    print(RL_KEYS)
    println(" keys, values up to 256 bits (Theorem 9 proof)")
    println("  values ≤ 64 bits store directly in the size-class base table; values")
    println("  of 65–256 bits live in the level-1 arena behind a 5-bit p₁ = O(log k)")
    println("  held in an 8-bit base slot — the base pointer never grows with v.")
    t0 = now_ns()
    let mut rlbase: VDTable = vdtable_create()
    let rlbp: ptr<VDTable> = &rlbase
    let mut rlt: RLTable = rltable_create()
    let rltp: ptr<RLTable> = &rlt
    let mut rlreg: Registry = registry_create()
    let rlrp: ptr<Registry> = &rlreg
    let rw0_raw: ptr<u8> = malloc(REG_SIZE * 8)
    let rw0: ptr<i64> = rw0_raw
    let rw1_raw: ptr<u8> = malloc(REG_SIZE * 8)
    let rw1: ptr<i64> = rw1_raw
    let rw2_raw: ptr<u8> = malloc(REG_SIZE * 8)
    let rw2: ptr<i64> = rw2_raw
    let rw3_raw: ptr<u8> = malloc(REG_SIZE * 8)
    let rw3: ptr<i64> = rw3_raw
    let rlb_raw: ptr<u8> = malloc(REG_SIZE * 4)
    let rlb: ptr<i32> = rlb_raw
    let rl1_raw: ptr<u8> = malloc(REG_SIZE * 4)
    let rl1: ptr<i32> = rl1_raw
    let rla_raw: ptr<u8> = malloc(REG_SIZE * 4)
    let rla: ptr<i32> = rla_raw
    let mut rl_hist: array<i32, 9> = [0]
    i = 0
    while i < RL_KEYS {
        let key: i32 = distinct_key(i)
        let mut rlbits: i32 = 0
        let mut w0: i64 = 0
        let mut w1: i64 = 0
        let mut w2: i64 = 0
        let mut w3: i64 = 0
        rl_make_words(sp, key, &rlbits, &w0, &w1, &w2, &w3)
        let ok: i32 = rlreg_insert(rlrp, rlbp, rltp, rw0, rw1, rw2, rw3, rlb, rl1, rla,
                                   key, w0, w1, w2, w3, rlbits)
        if ok == 0 {
            println("FAIL: r-levels insert")
            return 1
        }
        rl_hist[vd_class_of(rlbits)] = rl_hist[vd_class_of(rlbits)] + 1
        i = i + 1
    }
    let rl_errs: i32 = rlreg_verify(rlrp, rw0, rw1, rw2, rw3, rlb, rl1, rla, rlbp, rltp)
    let rl_inv: i32 = rltable_check(rltp)
    let rl_binv: i32 = vdtable_check(rlbp)
    print("  verify (all ")
    print(rlreg.live_top[0])
    print(" live, 128/256-bit through the chain): ")
    print(rl_errs)
    print("   arena invariants: ")
    print(rl_inv)
    print("   base invariants: ")
    print(rl_binv)
    println("")
    print("  value sizes by class (1..256-bit slots):  ")
    i = 0
    while i < 9 {
        print(rl_hist[i])
        print("  ")
        i = i + 1
    }
    println("")
    # churn: delete random keys, insert fresh skewed values (incl. big ones)
    ops = 0
    let mut rl_churn_errors: i32 = 0
    while ops < RL_CHURN {
        let rr: i32 = rng_next(sp) % 100
        if rr < 55 and rlreg.live_top[0] < RL_KEYS + 64 {
            let key: i32 = distinct_key(next_key)
            let mut rlbits2: i32 = 0
            let mut u0: i64 = 0
            let mut u1: i64 = 0
            let mut u2: i64 = 0
            let mut u3: i64 = 0
            rl_make_words(sp, key, &rlbits2, &u0, &u1, &u2, &u3)
            let ok2: i32 = rlreg_insert(rlrp, rlbp, rltp, rw0, rw1, rw2, rw3, rlb, rl1, rla,
                                        key, u0, u1, u2, u3, rlbits2)
            if ok2 == 0 {
                println("FAIL: r-levels churn insert")
                return 1
            }
            next_key = next_key + 1
        } else {
            let _d15: i32 = rlreg_delete_random(rlrp, rlbp, rltp, rl1, sp)
        }
        if (ops % 2500) == 2499 {
            let e: i32 = rlreg_verify(rlrp, rw0, rw1, rw2, rw3, rlb, rl1, rla, rlbp, rltp)
            rl_churn_errors = rl_churn_errors + e
        }
        ops = ops + 1
    }
    let rl_after: i32 = rlreg_verify(rlrp, rw0, rw1, rw2, rw3, rlb, rl1, rla, rlbp, rltp)
    let rl_inv2: i32 = rltable_check(rltp)
    # ---- space accounting: r-levels chain vs single-level vs uniform-256 ----
    let rl_live: i32 = rlreg.live_top[0]
    let mut rl_payload: i32 = 0
    let mut rl_small: i32 = 0
    let mut rl_b128: i32 = 0
    let mut rl_b256: i32 = 0
    i = 0
    while i < REG_SIZE {
        if rlreg.live[i] == 1 {
            let bits: i32 = rlb[i]
            rl_payload = rl_payload + vd_cap(vd_class_of(bits))
            if bits <= 64 {
                rl_small = rl_small + 1
            } else {
                if bits <= 128 {
                    rl_b128 = rl_b128 + 1
                } else {
                    rl_b256 = rl_b256 + 1
                }
            }
        }
        i = i + 1
    }
    let rl_big: i32 = rl_b128 + rl_b256
    let rl_used: i32 = rl_payload + 8 * rl_live + 13 * rl_big
    let rl_single: i32 = rl_payload + 8 * rl_live
    let rl_uniform: i32 = 256 * rl_live
    let rl_mean: f32 = (rl_used as f32) / (rl_live as f32)
    let mut rl_ok: i32 = 1
    if rl_errs != 0 {
        rl_ok = 0
    }
    if rl_inv != 0 {
        rl_ok = 0
    }
    if rl_binv != 0 {
        rl_ok = 0
    }
    if rl_churn_errors != 0 {
        rl_ok = 0
    }
    if rl_after != 0 {
        rl_ok = 0
    }
    if rl_inv2 != 0 {
        rl_ok = 0
    }
    if rl_big <= 0 {
        rl_ok = 0
    }
    if rl_used >= rl_uniform {
        rl_ok = 0
    }
    print("  churn: ")
    print(RL_CHURN)
    print(" ops: verify ")
    print(rl_churn_errors + rl_after)
    print("   arena invariants: ")
    print(rl_inv2)
    println("")
    print("  space: ")
    print(rl_live)
    print(" live (")
    print(rl_small)
    print(" ≤ 64-bit, ")
    print(rl_b128)
    print(" × 128-bit, ")
    print(rl_b256)
    print(" × 256-bit) — r-levels ")
    print(rl_used)
    print(" bits = ")
    print(rl_mean)
    println(" bits/value")
    print("    vs single-level size-classed: ")
    print(rl_single)
    println(" bits (base pointer + payload — a 256-bit value would need a")
    print("    256-bit base slot and a growing class tag)")
    println("")
    print("    vs uniform 256-bit: ")
    print(rl_uniform)
    print(" bits  →  ")
    print((100.0 * (rl_uniform as f32 - rl_used as f32)) / (rl_uniform as f32))
    print("% saved (r-levels);  ")
    print((100.0 * (rl_uniform as f32 - rl_single as f32)) / (rl_uniform as f32))
    println("% (single-level)")
    print("  the chain's second level costs 13 bits/value (8-bit holder + 5-bit")
    println("  p₁) on big values only — the paper's O(log v) per-value pointer")
    print("  overhead — and the base pointer itself never grows (8 bits for")
    println("  v = 1..256), so the base table's geometry is independent of value")
    println("  size (the paper's 'base pointer … is O(log⁽ʳ⁾ n) bits').")
    println("")

    # ---- phase 15b: r = 3 — the O(log log k) middle pointer p₂ -------------
    println("  ── r = 3: base(8) → p₂(6) → p₁(5) → value, up to 2^32 bits ────────")
    print("  ")
    print(RL3_KEYS)
    print(" keys; chained values of 65..2^18 bits (design width 2^32), verified")
    println("  bit-exactly through the three-level chain")
    let mut r3a: R3Arena = r3a_create()
    let r3ap: ptr<R3Arena> = &r3a
    let mut r3t: R3P2 = r3p2_create()
    let r3tp: ptr<R3P2> = &r3t
    let mut r3reg: Registry = registry_create()
    let r3rp: ptr<Registry> = &r3reg
    let mut r3base: VDTable = vdtable_create()
    let r3bp: ptr<VDTable> = &r3base
    let r3w_raw: ptr<u8> = malloc(REG_SIZE * 4)
    let r3w: ptr<i32> = r3w_raw
    let r3p1_raw: ptr<u8> = malloc(REG_SIZE * 4)
    let r3p1: ptr<i32> = r3p1_raw
    let r3p2_raw: ptr<u8> = malloc(REG_SIZE * 4)
    let r3p2: ptr<i32> = r3p2_raw
    let r3scr_raw: ptr<u8> = malloc(RL3_MAX_WORDS * 8)
    let r3scr: ptr<i64> = r3scr_raw
    let mut r3_big: i32 = 0
    let mut r3_huge: i32 = 0
    let mut r3_next_key: i32 = 0
    let mut r3_ops: i32 = 0
    i = 0
    while i < RL3_KEYS {
        let key: i32 = distinct_key(i)
        let ok: i32 = r3_insert(r3rp, r3bp, r3tp, r3ap, r3scr, key,
                                r3w, r3p1, r3p2, sp, &r3_big, &r3_huge)
        if ok == 0 {
            println("FAIL: r=3 insert")
            return 1
        }
        i = i + 1
    }
    let r3_errs: i32 = r3_verify(r3rp, r3bp, r3tp, r3ap, r3w, r3p1, r3p2)
    let r3_inv: i32 = r3_table_check(r3rp, r3bp, r3tp, r3ap, r3p1, r3p2)
    print("  verify (all ")
    print(r3reg.live_top[0])
    print(" live, through base → p₂ → p₁ → pool): ")
    print(r3_errs)
    print("   invariants: ")
    print(r3_inv)
    print("   chained: ")
    print(r3_big)
    print(" (incl. ")
    print(r3_huge)
    println(" class-1 > 2^12 bits)")
    # churn: delete random keys, insert fresh big values through the chain
    let mut r3_churn_errors: i32 = 0
    r3_ops = 0
    while r3_ops < RL3_CHURN {
        let r: i32 = rng_next(sp) % 100
        if r < 55 {
            let key: i32 = distinct_key(r3_next_key)
            let ok: i32 = r3_insert(r3rp, r3bp, r3tp, r3ap, r3scr, key,
                                    r3w, r3p1, r3p2, sp, &r3_big, &r3_huge)
            if ok == 0 {
                r3_churn_errors = r3_churn_errors + 1
            }
            r3_next_key = r3_next_key + 1
        } else {
            let _d3: i32 = r3_delete_random(r3rp, r3bp, r3tp, r3ap, r3p1, r3p2, sp)
        }
        if (r3_ops % 1000) == 999 {
            r3_churn_errors = r3_churn_errors + r3_verify(r3rp, r3bp, r3tp, r3ap, r3w, r3p1, r3p2)
        }
        r3_ops = r3_ops + 1
    }
    let r3_after: i32 = r3_verify(r3rp, r3bp, r3tp, r3ap, r3w, r3p1, r3p2)
    let r3_inv2: i32 = r3_table_check(r3rp, r3bp, r3tp, r3ap, r3p1, r3p2)
    print("  churn (")
    print(RL3_CHURN)
    print(" ops incl. deletes + fresh big values): verify ")
    print(r3_churn_errors + r3_after)
    print("   invariants: ")
    print(r3_inv2)
    println("")
    # ---- space accounting: r=3 chain vs r=2 chain vs uniform-sized-to-max ----
    let r3_live: i32 = r3reg.live_top[0]
    let mut r3_payload: i32 = 0
    let mut r3_chain_count: i32 = 0
    let mut r3_max_bits: i32 = 0
    let mut r3_ghuge: i32 = 0
    i = 0
    while i < REG_SIZE {
        if r3reg.live[i] == 1 {
            let bits: i32 = r3w[i]
            if bits <= 64 {
                r3_payload = r3_payload + vd_cap(vd_class_of(bits))
            } else {
                r3_payload = r3_payload + (((bits + 63) / 64) * 64)
                r3_chain_count = r3_chain_count + 1
                if bits > 65536 {
                    r3_ghuge = r3_ghuge + 1
                }
            }
            if bits > r3_max_bits {
                r3_max_bits = bits
            }
        }
        i = i + 1
    }
    let r3_chain_bits: i32 = r3_chain_count * 19    # 8-bit holder + 6-bit p₂ + 5-bit p₁
    let r3_used: i32 = r3_payload + 8 * r3_live + r3_chain_bits
    let r3_uniform: i64 = (r3_max_bits as i64) * (r3_live as i64)
    let r3_mean: f32 = (r3_used as f32) / (r3_live as f32)
    let mut r3_ok: i32 = 1
    if r3_errs != 0 {
        r3_ok = 0
    }
    if r3_inv != 0 {
        r3_ok = 0
    }
    if r3_churn_errors != 0 {
        r3_ok = 0
    }
    if r3_after != 0 {
        r3_ok = 0
    }
    if r3_inv2 != 0 {
        r3_ok = 0
    }
    if r3_big <= 0 {
        r3_ok = 0
    }
    if r3_huge <= 0 {
        r3_ok = 0
    }
    if (r3_used as i64) >= r3_uniform {
        r3_ok = 0
    }
    if r3_ghuge <= 0 {
        r3_ok = 0
    }
    print("  space: ")
    print(r3_live)
    print(" live — r=3 chain ")
    print(r3_used)
    print(" bits = ")
    print(r3_mean)
    print(" bits/key (base pointer 8 = CONSTANT; ")
    print(19)
    print(" bits per BIG value: 8-bit holder + 6-bit p₂ + 5-bit p₁, vs r=2's 13)")
    println("")
    print("    pointer hierarchy: base 8 bits (never grows with v, even at 2^32)")
    println("    → p₂ 6 bits → p₁ 5 bits — all three CONSTANT in v; only the")
    print("    word count grows. ")
    print(r3_ghuge)
    print(" values > 2^16 bits; uniform-sized-to-max ")
    print(r3_uniform)
    print(" bits → ")
    print((100.0 * ((r3_uniform as f32) - (r3_used as f32))) / (r3_uniform as f32))
    println("% saved; the +6 bits over r=2 lift the value cap 256 → 2^32 bits")
    println("")
    t15 = now_ns() - t0

    # ---- phase 16: optimal internal-memory stash (paper Theorem 10, §6.6) ---
    banner10()
    println("────────────────────────────────────────────────────────────────────────")
    print("Phase 16 — optimal internal-memory stash: ")
    print(ST_M)
    print(" keys in a ")
    print(ST_EXT)
    println("-slot external dereference table (load 1/4, ε = 3/4)")
    println("  the stash is O(m log ε⁻¹) = O(m) internal bits: each entry is a 4-bit")
    println("  tiny pointer (1 choice + 3 slot; the bucket is implicit), vs 15 bits")
    println("  per key for a naive full-address stash. Positions never move.")
    t0 = now_ns()
    let mut stt: STStash = st_create()
    let stp: ptr<STStash> = &stt
    let mut streg: Registry = registry_create()
    let strp: ptr<Registry> = &streg
    let mut st_state: i32 = 987654321
    let st_sp: ptr<i32> = &st_state
    let mut st_next_key: i32 = ST_M
    let mut st_fails: i32 = 0
    let mut st_ops: i32 = 0
    i = 0
    while i < ST_M {
        let key: i32 = distinct_key(i)
        let value: i32 = (hash_u32(key, ST_V_SALT) & 0x00FFFFFF) | 1
        let ok: i32 = st_insert(strp, stp, key, value)
        if ok == 0 {
            st_fails = st_fails + 1
        }
        i = i + 1
    }
    let st_errs: i32 = st_verify(strp, stp)
    let st_inv: i32 = sttable_check(strp, stp)
    print("  verify (all ")
    print(streg.live_top[0])
    print(" live, via the prefix-free filter + one external read): ")
    print(st_errs)
    print("   insert failures: ")
    print(st_fails)
    print("   invariants: ")
    print(st_inv)
    println("")
    # query storm: ST_QUERIES random live queries; count external reads
    stt.reads[0] = 0
    let mut st_storm_errs: i32 = 0
    st_ops = 0
    while st_ops < ST_QUERIES {
        let top: i32 = streg.live_top[0]
        let j: i32 = rng_next(st_sp) % top
        let idx: i32 = streg.live_list[j]
        let pos: i32 = st_query(stp, streg.key[idx])
        if pos != streg.pos[idx] {
            st_storm_errs = st_storm_errs + 1
        }
        st_ops = st_ops + 1
    }
    let st_reads: i32 = stt.reads[0]
    print("  query storm (")
    print(ST_QUERIES)
    print(" random queries): external reads = ")
    print(st_reads)
    print(" (one per query — the paper's single-access claim), errors ")
    print(st_storm_errs)
    println("")
    # churn: 55% insert / 45% delete, with periodic re-verification
    let mut st_churn_fails: i32 = 0
    let mut st_churn_verify: i32 = 0
    st_ops = 0
    while st_ops < ST_CHURN {
        let r: i32 = rng_next(st_sp) % 100
        if r < 55 {
            let key: i32 = distinct_key(st_next_key)
            let value: i32 = (hash_u32(key, ST_V_SALT) & 0x00FFFFFF) | 1
            let ok: i32 = st_insert(strp, stp, key, value)
            if ok == 0 {
                st_churn_fails = st_churn_fails + 1
            }
            st_next_key = st_next_key + 1
        } else {
            let _d16: i32 = st_delete_random(strp, stp, st_sp)
        }
        if (st_ops % 2000) == 1999 {
            st_churn_verify = st_churn_verify + st_verify(strp, stp)
        }
        st_ops = st_ops + 1
    }
    let st_after: i32 = st_verify(strp, stp)
    let st_inv2: i32 = sttable_check(strp, stp)
    print("  churn (")
    print(ST_CHURN)
    print(" ops incl. deletes + fresh inserts): verify ")
    print(st_churn_verify + st_after)
    print("   insert failures: ")
    print(st_churn_fails)
    print("   invariants: ")
    print(st_inv2)
    println("")
    # ---- space accounting: tiny stash vs naive full-address stash ----------
    let st_live: i32 = streg.live_top[0]
    let mut st_ptr_bits: i32 = 0
    let mut st_adapt: i32 = 0
    i = 0
    while i < REG_SIZE {
        if streg.live[i] == 1 {
            st_ptr_bits = st_ptr_bits + 4
            st_adapt = st_adapt + stt.ent_len[i]
        }
        i = i + 1
    }
    let st_stash_bits: i32 = st_ptr_bits + st_adapt
    let st_naive_bits: i32 = st_live * 15
    let st_mean: f32 = (st_stash_bits as f32) / (st_live as f32)
    let st_adapt_mean: f32 = (st_adapt as f32) / (st_live as f32)
    let mut st_ok: i32 = 1
    if st_errs != 0 {
        st_ok = 0
    }
    if st_inv != 0 {
        st_ok = 0
    }
    if st_fails != 0 {
        st_ok = 0
    }
    if st_reads != ST_QUERIES {
        st_ok = 0
    }
    if st_storm_errs != 0 {
        st_ok = 0
    }
    if st_churn_fails != 0 {
        st_ok = 0
    }
    if st_churn_verify != 0 {
        st_ok = 0
    }
    if st_after != 0 {
        st_ok = 0
    }
    if st_inv2 != 0 {
        st_ok = 0
    }
    if st_stash_bits >= st_naive_bits {
        st_ok = 0
    }
    print("  space: ")
    print(st_live)
    print(" live — stash ")
    print(st_stash_bits)
    print(" bits = ")
    print(st_mean)    print("  bits/key (4-bit pointer + ")
    print(st_adapt_mean)
    print(" adaptivity — the paper's O(m log ε⁻¹) = O(m), independent of the")
    println(" external array size: the 4 pointer bits never grow with it)")
    print("    vs naive full-address stash: ")
    print(st_naive_bits)
    print(" bits = 15/key  →  ")
    print((100.0 * (st_naive_bits as f32 - st_stash_bits as f32)) / (st_naive_bits as f32))
    println("% saved (Gonnet–Larson's O(n log ε⁻¹) beats a full-address O(n log m))")
    println("")
    t16 = now_ns() - t0

    # ---- wall-clock benchmark block ---------------------------------------
    println("────────────────────────────────────────────────────────────────────────")
