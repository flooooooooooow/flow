# SIMD probe (f32): try to trigger LLVM SLP vectorization more easily.
# Still scalar FLOW; expect backend/LLVM to pick best SIMD.

effect Dummy { emit(message: string) -> void, }

function probe(a: f32, b: f32, c: f32, d: f32) -> f32 {
    let x0: f32 = a * b
    let x1: f32 = b * c
    let x2: f32 = c * d
    let x3: f32 = d * a

    let y0: f32 = x0 + 1.0
    let y1: f32 = x1 + 2.0
    let y2: f32 = x2 + 3.0
    let y3: f32 = x3 + 4.0

    let z0: f32 = y0 + y1
    let z1: f32 = y2 + y3

    return z0 + z1
}

function main() -> i32 {
    # Keep FLOW's i32 main; convert by scaling and truncating via simple ops.
    let r: f32 = probe(10.0, 20.0, 30.0, 40.0)
    # cheap conversion placeholder (until explicit casts exist)
    return 0
}
