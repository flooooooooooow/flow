# MAIN FUNCTION
# =============================================================================

function main() -> i32 {
    printf("\n")
    printf("╔══════════════════════════════════════════════════════════════════╗\n")
    printf("║                                                                  ║\n")
    printf("║     ███████╗██╗      ██████╗ ██╗    ██╗██████╗ ██████╗           ║\n")
    printf("║     ██╔════╝██║     ██╔═══██╗██║    ██║██╔══██╗██╔══██╗          ║\n")
    printf("║     █████╗  ██║     ██║   ██║██║ █╗ ██║██║  ██║██████╔╝          ║\n")
    printf("║     ██╔══╝  ██║     ██║   ██║██║███╗██║██║  ██║██╔══██╗          ║\n")
    printf("║     ██║     ███████╗╚██████╔╝╚███╔███╔╝██████╔╝██████╔╝          ║\n")
    printf("║     ╚═╝     ╚══════╝ ╚═════╝  ╚══╝╚══╝ ╚═════╝ ╚═════╝           ║\n")
    printf("║                                                                  ║\n")
    printf("║           In-Memory Database Demo - FLOW Language                ║\n")
    printf("║                                                                  ║\n")
    printf("╚══════════════════════════════════════════════════════════════════╝\n")
    printf("\n")
    
    # Use the Logger effect with ConsoleLogger capability
    handle Logger with ConsoleLogger {
        # Demo 1: Schema creation
        let schema: TableSchema = demo_schema_creation()
        
        # Demo 2: Data insertion
        let table: Table = demo_insert_data(schema)
        
        # Demo 3: Queries
        demo_queries(table)
        
        # Demo 4: Generics
        demo_generics()
        
        # Demo 5: Pattern matching
        demo_pattern_matching()
        
        # Demo 6: Option and Result types
        demo_option_result()
        
        # Demo 7: Traits
        demo_traits()
        
        # Demo 8: Index structures
        demo_index()
        
        # Demo 9: Algorithms
        demo_algorithms()
        
        # Demo 10: Transactions
        table = demo_transactions(table)
        
        # Demo 11: Delete operation
        table = demo_delete(table)
        
        # Final table scan
        printf("╔══════════════════════════════════════════════════════════════════╗\n")
        printf("║              FlowDB - Final Table State                          ║\n")
        printf("╚══════════════════════════════════════════════════════════════════╝\n\n")
        scan_with_log(table)
    }
    
    printf("╔══════════════════════════════════════════════════════════════════╗\n")
    printf("║                    Demo Complete!                                ║\n")
    printf("╚══════════════════════════════════════════════════════════════════╝\n\n")
    
    printf("Flow language features demonstrated:\n")
    printf("  ✓ Structs and user-defined types\n")
    printf("  ✓ Functions with typed parameters\n")
    printf("  ✓ Control flow (if, while, for, match)\n")
    printf("  ✓ Fixed-size arrays\n")
    printf("  ✓ Generics (Box<T>, Pair<K,V>)\n")
    printf("  ✓ Option and Result types\n")
    printf("  ✓ Effects and capabilities\n")
    printf("  ✓ Traits and implementations\n")
    printf("  ✓ Module imports and exports\n")
    printf("  ✓ Pattern matching\n")
    printf("  ✓ Algorithms (hashing, sorting, search)\n")
    printf("\n")
    
    return 0
}
