# ============================================================================
# FlowDB - Comprehensive FLOW Language Demo
# ============================================================================
#
# This is a complete, working demonstration of FLOW language features.
# Run with: ./flow run examples/flowdb/demo.flow
#
# Features demonstrated:
# - Structs and user-defined types
# - Functions with typed parameters
# - Control flow (if/elif/else, while, for)
# - Pattern matching (match statements with braces)
# - Generics (Box<T>, Pair<K,V>)
# - Traits and implementations
# - Effects and capabilities
# - Option types for nullable values
# - Result types for error handling
# - Module imports
# - Algorithms and data structures

import "stdlib/option.flow"
import "stdlib/result.flow"

# =============================================================================
# CORE TYPES - Structs
# =============================================================================

# A database value that can hold different types
struct Value {
    type_id: i32      # 0=int, 1=float, 2=string, 3=bool
    int_val: i64
    float_val: f64
    str_val: string
    bool_val: bool
    is_null: bool
}

# A database row with up to 4 columns
struct Row {
    id: i64
    col0: Value
    col1: Value
    col2: Value
    col3: Value
    is_deleted: bool
}

# Table statistics
struct Stats {
    total_rows: i64
    deleted_rows: i64
    queries: i64
}

# =============================================================================
# VALUE CONSTRUCTORS
# =============================================================================

function value_null() -> Value {
    return Value {
        type_id: 0, int_val: 0, float_val: 0.0,
        str_val: "", bool_val: false, is_null: true
    }
}

function value_int(v: i64) -> Value {
    return Value {
        type_id: 0, int_val: v, float_val: 0.0,
        str_val: "", bool_val: false, is_null: false
    }
}

function value_float(v: f64) -> Value {
    return Value {
        type_id: 1, int_val: 0, float_val: v,
        str_val: "", bool_val: false, is_null: false
    }
}

function value_string(v: string) -> Value {
    return Value {
        type_id: 2, int_val: 0, float_val: 0.0,
        str_val: v, bool_val: false, is_null: false
    }
}

function value_bool(v: bool) -> Value {
    return Value {
        type_id: 3, int_val: 0, float_val: 0.0,
        str_val: "", bool_val: v, is_null: false
    }
}

# =============================================================================
# GENERICS - Box<T> and Pair<K, V>
# =============================================================================

struct Box<T> {
    value: T
    has_value: bool
}

struct Pair<K, V> {
    key: K
    value: V
}

# =============================================================================
# TRAITS - Display, Comparable
# =============================================================================

trait Display {
    function show(self) -> void
}

impl Display for Value {
    function show(self) -> void {
        if self.is_null {
            printf("NULL")
        } elif self.type_id == 0 {
            printf("%lld", self.int_val)
        } elif self.type_id == 1 {
            printf("%.2f", self.float_val)
        } elif self.type_id == 2 {
            printf("'%s'", self.str_val)
        } elif self.type_id == 3 {
            if self.bool_val {
                printf("TRUE")
            } else {
                printf("FALSE")
            }
        }
    }
}

trait Comparable {
    function compare(self, other: Value) -> i32
}

impl Comparable for Value {
    function compare(self, other: Value) -> i32 {
        if self.is_null {
            if other.is_null { return 0 }
            return -1
        }
        if other.is_null { return 1 }
        
        if self.type_id == 0 {
            if self.int_val < other.int_val { return -1 }
            if self.int_val > other.int_val { return 1 }
            return 0
        }
        if self.type_id == 1 {
            if self.float_val < other.float_val { return -1 }
            if self.float_val > other.float_val { return 1 }
            return 0
        }
        return 0
    }
}

# =============================================================================
# EFFECTS - Database operations with explicit side effects
# =============================================================================

effect Logger {
    log(level: string, message: string) -> void
}

capability ConsoleLogger {
    effect Logger,
    function log(level: string, message: string) -> void {
        printf("[%s] %s\n", level, message)
    }
}

capability SilentLogger {
    effect Logger,
    function log(level: string, message: string) -> void {
        # Silent - no output
        return void
    }
}

# =============================================================================
# TABLE OPERATIONS
# =============================================================================

struct Table {
    row0: Row
    row1: Row
    row2: Row
    row3: Row
    row4: Row
    row5: Row
    row6: Row
    row7: Row
    count: i32
    next_id: i64
    stats: Stats
}

function empty_row() -> Row {
    return Row {
        id: -1,
        col0: value_null(),
        col1: value_null(),
        col2: value_null(),
        col3: value_null(),
        is_deleted: false
    }
}

function table_new() -> Table {
    let r: Row = empty_row()
    return Table {
        row0: r, row1: r, row2: r, row3: r,
        row4: r, row5: r, row6: r, row7: r,
        count: 0,
        next_id: 1,
        stats: Stats { total_rows: 0, deleted_rows: 0, queries: 0 }
    }
}

function get_row(t: Table, idx: i32) -> Row {
    if idx == 0 { return t.row0 }
    if idx == 1 { return t.row1 }
    if idx == 2 { return t.row2 }
    if idx == 3 { return t.row3 }
    if idx == 4 { return t.row4 }
    if idx == 5 { return t.row5 }
    if idx == 6 { return t.row6 }
    if idx == 7 { return t.row7 }
    return empty_row()
}

function set_row(t: Table, idx: i32, r: Row) -> Table {
    if idx == 0 { return Table { row0: r, row1: t.row1, row2: t.row2, row3: t.row3, row4: t.row4, row5: t.row5, row6: t.row6, row7: t.row7, count: t.count, next_id: t.next_id, stats: t.stats } }
    if idx == 1 { return Table { row0: t.row0, row1: r, row2: t.row2, row3: t.row3, row4: t.row4, row5: t.row5, row6: t.row6, row7: t.row7, count: t.count, next_id: t.next_id, stats: t.stats } }
    if idx == 2 { return Table { row0: t.row0, row1: t.row1, row2: r, row3: t.row3, row4: t.row4, row5: t.row5, row6: t.row6, row7: t.row7, count: t.count, next_id: t.next_id, stats: t.stats } }
    if idx == 3 { return Table { row0: t.row0, row1: t.row1, row2: t.row2, row3: r, row4: t.row4, row5: t.row5, row6: t.row6, row7: t.row7, count: t.count, next_id: t.next_id, stats: t.stats } }
    if idx == 4 { return Table { row0: t.row0, row1: t.row1, row2: t.row2, row3: t.row3, row4: r, row5: t.row5, row6: t.row6, row7: t.row7, count: t.count, next_id: t.next_id, stats: t.stats } }
    if idx == 5 { return Table { row0: t.row0, row1: t.row1, row2: t.row2, row3: t.row3, row4: t.row4, row5: r, row6: t.row6, row7: t.row7, count: t.count, next_id: t.next_id, stats: t.stats } }
    if idx == 6 { return Table { row0: t.row0, row1: t.row1, row2: t.row2, row3: t.row3, row4: t.row4, row5: t.row5, row6: r, row7: t.row7, count: t.count, next_id: t.next_id, stats: t.stats } }
    if idx == 7 { return Table { row0: t.row0, row1: t.row1, row2: t.row2, row3: t.row3, row4: t.row4, row5: t.row5, row6: t.row6, row7: r, count: t.count, next_id: t.next_id, stats: t.stats } }
    return t
}

function insert_row(t: Table, c0: Value, c1: Value, c2: Value, c3: Value) -> Table {
    if t.count >= 8 {
        Logger.log("ERROR", "Table is full!")
        return t
    }
    
    let new_row: Row = Row {
        id: t.next_id,
        col0: c0, col1: c1, col2: c2, col3: c3,
        is_deleted: false
    }
    
    let updated: Table = set_row(t, t.count, new_row)
    let new_stats: Stats = Stats {
        total_rows: updated.stats.total_rows + 1,
        deleted_rows: updated.stats.deleted_rows,
        queries: updated.stats.queries
    }
    
    Logger.log("INFO", "Row inserted successfully")
    
    return Table {
        row0: updated.row0, row1: updated.row1, row2: updated.row2, row3: updated.row3,
        row4: updated.row4, row5: updated.row5, row6: updated.row6, row7: updated.row7,
        count: updated.count + 1,
        next_id: updated.next_id + 1,
        stats: new_stats
    }
}

function print_table(t: Table) -> void {
    printf("\n+------+----------+----------+----------+----------+\n")
    printf("| ID   | Col0     | Col1     | Col2     | Col3     |\n")
    printf("+------+----------+----------+----------+----------+\n")
    
    for i in 0 to t.count {
        let r: Row = get_row(t, i)
        if r.is_deleted == false {
            printf("| %-4lld | ", r.id)
            Value_Display_show(r.col0)
            printf(" | ")
            Value_Display_show(r.col1)
            printf(" | ")
            Value_Display_show(r.col2)
            printf(" | ")
            Value_Display_show(r.col3)
            printf(" |\n")
        }
    }
    
    printf("+------+----------+----------+----------+----------+\n")
    printf("(%d rows)\n\n", t.count)
}

# =============================================================================
# AGGREGATION FUNCTIONS
# =============================================================================

function sum_column(t: Table, col_idx: i32) -> f64 {
    let sum: f64 = 0.0
    
    for i in 0 to t.count {
        let r: Row = get_row(t, i)
        if r.is_deleted == false {
            let v: Value = r.col0
            if col_idx == 1 { v = r.col1 }
            if col_idx == 2 { v = r.col2 }
            if col_idx == 3 { v = r.col3 }
            
            if v.type_id == 0 {
                sum = sum + v.int_val
            } elif v.type_id == 1 {
                sum = sum + v.float_val
            }
        }
    }
    
    return sum
}

function avg_column(t: Table, col_idx: i32) -> f64 {
    let count: i32 = 0
    let sum: f64 = 0.0
    
    for i in 0 to t.count {
        let r: Row = get_row(t, i)
        if r.is_deleted == false {
            let v: Value = r.col0
            if col_idx == 1 { v = r.col1 }
            if col_idx == 2 { v = r.col2 }
            if col_idx == 3 { v = r.col3 }
            
            if v.type_id == 0 {
                sum = sum + v.int_val
                count = count + 1
            } elif v.type_id == 1 {
                sum = sum + v.float_val
                count = count + 1
            }
        }
    }
    
    if count > 0 {
        return sum / count
    }
    return 0.0
}

# =============================================================================
# PATTERN MATCHING DEMO
# =============================================================================

function describe_value(v: Value) -> void {
    match v.type_id {
        0 => {
            printf("Integer: %lld\n", v.int_val)
        }
        1 => {
            printf("Float: %.2f\n", v.float_val)
        }
        2 => {
            printf("String: '%s'\n", v.str_val)
        }
        3 => {
            if v.bool_val {
                printf("Boolean: TRUE\n")
            } else {
                printf("Boolean: FALSE\n")
            }
        }
        _ => {
            printf("Unknown type\n")
        }
    }
}

# =============================================================================
# OPTION TYPE DEMO
# =============================================================================

function find_by_id(t: Table, target_id: i64) -> Option_i32 {
    for i in 0 to t.count {
        let r: Row = get_row(t, i)
        if r.id == target_id {
            if r.is_deleted == false {
                return some_i32(i)
            }
        }
    }
    return none_i32()
}

# =============================================================================
# RESULT TYPE DEMO
# =============================================================================

# Note: safe_divide is already in stdlib/result.flow, so we just use it

# =============================================================================
# ALGORITHMS
# =============================================================================

function is_prime(n: i32) -> bool {
    if n <= 1 { return false }
    if n <= 3 { return true }
    if n % 2 == 0 { return false }
    
    let i: i32 = 3
    while i * i <= n {
        if n % i == 0 { return false }
        i = i + 2
    }
    return true
}

function fibonacci(n: i32) -> i64 {
    if n <= 0 { return 0 }
    if n == 1 { return 1 }
    
    let a: i64 = 0
    let b: i64 = 1
    for i in 2 to n + 1 {
        let temp: i64 = a + b
        a = b
        b = temp
    }
    return b
}

# =============================================================================
# MAIN DEMO
# =============================================================================

function main() -> i32 {
    printf("\n")
    printf("╔══════════════════════════════════════════════════════════════════╗\n")
    printf("║                                                                  ║\n")
    printf("║     ███████╗██╗      ██████╗ ██╗    ██╗██████╗ ██████╗           ║\n")
    printf("║     ██╔════╝██║     ██╔═══██╗██║    ██║██╔══██╗██╔══██╗          ║\n")
    printf("║     █████╗  ██║     ██║   ██║██║ █╗ ██║██║  ██║██████╔╝          ║\n")
    printf("║     ██╔══╝  ██║     ██║   ██║██║███╗██║██║  ██║██╔══██╗          ║\n")
    printf("║     ██║     ███████╗╚██████╔╝╚███╔███╔╝██████╔╝██████╔╝          ║\n")
    printf("║     ╚═╝     ╚══════╝ ╚═════╝  ╚══╝╚══╝ ╚═════╝ ╚═════╝           ║\n")
    printf("║                                                                  ║\n")
    printf("║           FLOW Language Feature Demonstration                    ║\n")
    printf("║                                                                  ║\n")
    printf("╚══════════════════════════════════════════════════════════════════╝\n\n")
    
    # Use effect system for logging
    handle Logger with ConsoleLogger {
        # =========== STRUCTS AND TYPES ===========
        printf("═══ 1. STRUCTS AND TYPES ═══\n\n")
        
        let v1: Value = value_int(42)
        let v2: Value = value_float(3.14)
        let v3: Value = value_string("Hello")
        let v4: Value = value_bool(true)
        
        printf("Created values:\n")
        printf("  Integer: ")
        Value_Display_show(v1)
        printf("\n  Float: ")
        Value_Display_show(v2)
        printf("\n  String: ")
        Value_Display_show(v3)
        printf("\n  Boolean: ")
        Value_Display_show(v4)
        printf("\n\n")
        
        # =========== GENERICS ===========
        printf("═══ 2. GENERICS ═══\n\n")
        
        let box_i: Box<i32> = Box<i32> { value: 100, has_value: true }
        let box_f: Box<f32> = Box<f32> { value: 2.718, has_value: true }
        let pair: Pair<i32, f32> = Pair<i32, f32> { key: 1, value: 99.5 }
        
        printf("Box<i32>.value = %d\n", box_i.value)
        printf("Box<f32>.value = %f\n", box_f.value)
        printf("Pair<i32, f32> = (%d, %f)\n\n", pair.key, pair.value)
        
        # =========== PATTERN MATCHING ===========
        printf("═══ 3. PATTERN MATCHING ═══\n\n")
        
        printf("Describing values with match:\n")
        describe_value(v1)
        describe_value(v2)
        describe_value(v3)
        describe_value(v4)
        printf("\n")
        
        # =========== DATABASE OPERATIONS WITH EFFECTS ===========
        printf("═══ 4. DATABASE WITH EFFECTS ═══\n\n")
        
        let t: Table = table_new()
        
        # Insert some employees
        t = insert_row(t, value_int(1), value_string("Alice"), value_int(30), value_float(75000.0))
        t = insert_row(t, value_int(2), value_string("Bob"), value_int(25), value_float(55000.0))
        t = insert_row(t, value_int(3), value_string("Carol"), value_int(35), value_float(85000.0))
        t = insert_row(t, value_int(4), value_string("Dave"), value_int(28), value_float(62000.0))
        
        print_table(t)
        
        # Aggregation
        printf("═══ 5. AGGREGATION QUERIES ═══\n\n")
        let salary_sum: f64 = sum_column(t, 3)
        let salary_avg: f64 = avg_column(t, 3)
        printf("SUM(salary) = %.2f\n", salary_sum)
        printf("AVG(salary) = %.2f\n\n", salary_avg)
        
        # =========== OPTION TYPES ===========
        printf("═══ 6. OPTION TYPES ═══\n\n")
        
        let found: Option_i32 = find_by_id(t, 2)
        if is_some_i32(found) {
            printf("Found row with ID 2 at index %d\n", unwrap_i32(found))
        }
        
        let not_found: Option_i32 = find_by_id(t, 99)
        if is_none_i32(not_found) {
            printf("Row with ID 99 not found (Option is None)\n")
        }
        printf("\n")
        
        # =========== RESULT TYPES ===========
        printf("═══ 7. RESULT TYPES ═══\n\n")
        
        let res_ok: Result_f64_string = safe_divide(10.0, 2.0)
        printf("10.0 / 2.0 = ")
        if is_ok_f64(res_ok) {
            printf("%.2f (Ok)\n", res_ok.value)
        }
        
        let res_err: Result_f64_string = safe_divide(10.0, 0.0)
        printf("10.0 / 0.0 = ")
        if is_err_f64(res_err) {
            printf("Error: %s\n", res_err.error)
        }
        printf("\n")
        
        # =========== ALGORITHMS ===========
        printf("═══ 8. ALGORITHMS ═══\n\n")
        
        printf("Prime numbers up to 30: ")
        for i in 2 to 31 {
            if is_prime(i) {
                printf("%d ", i)
            }
        }
        printf("\n\n")
        
        printf("Fibonacci sequence (first 10):\n  ")
        for i in 0 to 10 {
            printf("%lld ", fibonacci(i))
        }
        printf("\n\n")
        
        # =========== TRAIT COMPARISON ===========
        printf("═══ 9. TRAIT METHODS ═══\n\n")
        
        let cmp1: i32 = Value_Comparable_compare(value_int(10), value_int(20))
        let cmp2: i32 = Value_Comparable_compare(value_int(20), value_int(10))
        let cmp3: i32 = Value_Comparable_compare(value_int(15), value_int(15))
        
        printf("compare(10, 20) = %d (expected: -1)\n", cmp1)
        printf("compare(20, 10) = %d (expected: 1)\n", cmp2)
        printf("compare(15, 15) = %d (expected: 0)\n\n", cmp3)
    }
    
    printf("╔══════════════════════════════════════════════════════════════════╗\n")
    printf("║                    Demo Complete!                                ║\n")
    printf("╚══════════════════════════════════════════════════════════════════╝\n\n")
    
    printf("FLOW language features demonstrated:\n")
    printf("  ✓ Structs and user-defined types\n")
    printf("  ✓ Functions with typed parameters\n")
    printf("  ✓ Control flow (if/elif/else, while, for)\n")
    printf("  ✓ Pattern matching (match statement)\n")
    printf("  ✓ Generics (Box<T>, Pair<K,V>)\n")
    printf("  ✓ Traits and implementations\n")
    printf("  ✓ Effects and capabilities\n")
    printf("  ✓ Option types for nullable values\n")
    printf("  ✓ Result types for error handling\n")
    printf("  ✓ Module imports\n")
    printf("  ✓ Algorithms (prime, fibonacci)\n")
    printf("\n")
    
    return 0
}
