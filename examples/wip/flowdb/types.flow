# FlowDB - Core Data Types Module
# Demonstrates: structs, generics, Option types, arrays
#
# This module defines the fundamental data structures for our
# in-memory database system.

import "stdlib/option.flow"
import "stdlib/result.flow"

# =============================================================================
# FIELD TYPES - What kind of data can be stored
# =============================================================================

# Field type enumeration (using integer constants for now)
# 0 = Integer, 1 = Float, 2 = String, 3 = Boolean
struct FieldType {
    type_id: i32
}

export const FIELD_TYPE_INT: i32 = 0
export const FIELD_TYPE_FLOAT: i32 = 1
export const FIELD_TYPE_STRING: i32 = 2
export const FIELD_TYPE_BOOL: i32 = 3

export function field_type_int() -> FieldType {
    return FieldType { type_id: FIELD_TYPE_INT }
}

export function field_type_float() -> FieldType {
    return FieldType { type_id: FIELD_TYPE_FLOAT }
}

export function field_type_string() -> FieldType {
    return FieldType { type_id: FIELD_TYPE_STRING }
}

export function field_type_bool() -> FieldType {
    return FieldType { type_id: FIELD_TYPE_BOOL }
}

export function field_type_name(ft: FieldType) -> string {
    if ft.type_id == 0 { return "INTEGER" }
    if ft.type_id == 1 { return "FLOAT" }
    if ft.type_id == 2 { return "STRING" }
    if ft.type_id == 3 { return "BOOLEAN" }
    return "UNKNOWN"
}

# =============================================================================
# VALUE - A dynamically-typed value (tagged union style)
# =============================================================================

export struct Value {
    type_id: i32      # Which type is stored
    int_val: i64      # Storage for integer
    float_val: f64    # Storage for float
    str_val: string   # Storage for string
    bool_val: bool    # Storage for boolean
    is_null: bool     # NULL handling
}

export function value_null() -> Value {
    return Value {
        type_id: 0,
        int_val: 0,
        float_val: 0.0,
        str_val: "",
        bool_val: false,
        is_null: true
    }
}

export function value_int(v: i64) -> Value {
    return Value {
        type_id: FIELD_TYPE_INT,
        int_val: v,
        float_val: 0.0,
        str_val: "",
        bool_val: false,
        is_null: false
    }
}

export function value_float(v: f64) -> Value {
    return Value {
        type_id: FIELD_TYPE_FLOAT,
        int_val: 0,
        float_val: v,
        str_val: "",
        bool_val: false,
        is_null: false
    }
}

export function value_string(v: string) -> Value {
    return Value {
        type_id: FIELD_TYPE_STRING,
        int_val: 0,
        float_val: 0.0,
        str_val: v,
        bool_val: false,
        is_null: false
    }
}

export function value_bool(v: bool) -> Value {
    return Value {
        type_id: FIELD_TYPE_BOOL,
        int_val: 0,
        float_val: 0.0,
        str_val: "",
        bool_val: v,
        is_null: false
    }
}

export function value_is_null(v: Value) -> bool {
    return v.is_null
}

export function value_get_int(v: Value) -> Option_i64 {
    if v.is_null or v.type_id != FIELD_TYPE_INT {
        return Option_i64 { has_value: false, value: 0 }
    }
    return Option_i64 { has_value: true, value: v.int_val }
}

export function value_get_float(v: Value) -> Option_f64 {
    if v.is_null or v.type_id != FIELD_TYPE_FLOAT {
        return none_f64()
    }
    return some_f64(v.float_val)
}

# =============================================================================
# COLUMN DEFINITION - Schema for a single column
# =============================================================================

export struct ColumnDef {
    name: string
    field_type: FieldType
    is_primary_key: bool
    is_nullable: bool
    has_index: bool
}

export function column_def_new(name: string, ft: FieldType) -> ColumnDef {
    return ColumnDef {
        name: name,
        field_type: ft,
        is_primary_key: false,
        is_nullable: true,
        has_index: false
    }
}

export function column_def_primary(name: string, ft: FieldType) -> ColumnDef {
    return ColumnDef {
        name: name,
        field_type: ft,
        is_primary_key: true,
        is_nullable: false,
        has_index: true
    }
}

# =============================================================================
# ROW - A single database row (fixed max columns for simplicity)
# =============================================================================

const MAX_COLUMNS: i32 = 16

export struct Row {
    id: i64                    # Internal row ID
    col0: Value
    col1: Value
    col2: Value
    col3: Value
    col4: Value
    col5: Value
    col6: Value
    col7: Value
    num_columns: i32
    is_deleted: bool           # Soft delete marker
}

export function row_new(id: i64) -> Row {
    return Row {
        id: id,
        col0: value_null(),
        col1: value_null(),
        col2: value_null(),
        col3: value_null(),
        col4: value_null(),
        col5: value_null(),
        col6: value_null(),
        col7: value_null(),
        num_columns: 0,
        is_deleted: false
    }
}

export function row_set_value(r: Row, col_idx: i32, val: Value) -> Row {
    if col_idx == 0 { return Row { id: r.id, col0: val, col1: r.col1, col2: r.col2, col3: r.col3, col4: r.col4, col5: r.col5, col6: r.col6, col7: r.col7, num_columns: r.num_columns, is_deleted: r.is_deleted } }
    if col_idx == 1 { return Row { id: r.id, col0: r.col0, col1: val, col2: r.col2, col3: r.col3, col4: r.col4, col5: r.col5, col6: r.col6, col7: r.col7, num_columns: r.num_columns, is_deleted: r.is_deleted } }
    if col_idx == 2 { return Row { id: r.id, col0: r.col0, col1: r.col1, col2: val, col3: r.col3, col4: r.col4, col5: r.col5, col6: r.col6, col7: r.col7, num_columns: r.num_columns, is_deleted: r.is_deleted } }
    if col_idx == 3 { return Row { id: r.id, col0: r.col0, col1: r.col1, col2: r.col2, col3: val, col4: r.col4, col5: r.col5, col6: r.col6, col7: r.col7, num_columns: r.num_columns, is_deleted: r.is_deleted } }
    if col_idx == 4 { return Row { id: r.id, col0: r.col0, col1: r.col1, col2: r.col2, col3: r.col3, col4: val, col5: r.col5, col6: r.col6, col7: r.col7, num_columns: r.num_columns, is_deleted: r.is_deleted } }
    if col_idx == 5 { return Row { id: r.id, col0: r.col0, col1: r.col1, col2: r.col2, col3: r.col3, col4: r.col4, col5: val, col6: r.col6, col7: r.col7, num_columns: r.num_columns, is_deleted: r.is_deleted } }
    if col_idx == 6 { return Row { id: r.id, col0: r.col0, col1: r.col1, col2: r.col2, col3: r.col3, col4: r.col4, col5: r.col5, col6: val, col7: r.col7, num_columns: r.num_columns, is_deleted: r.is_deleted } }
    if col_idx == 7 { return Row { id: r.id, col0: r.col0, col1: r.col1, col2: r.col2, col3: r.col3, col4: r.col4, col5: r.col5, col6: r.col6, col7: val, num_columns: r.num_columns, is_deleted: r.is_deleted } }
    return r
}

export function row_get_value(r: Row, col_idx: i32) -> Value {
    if col_idx == 0 { return r.col0 }
    if col_idx == 1 { return r.col1 }
    if col_idx == 2 { return r.col2 }
    if col_idx == 3 { return r.col3 }
    if col_idx == 4 { return r.col4 }
    if col_idx == 5 { return r.col5 }
    if col_idx == 6 { return r.col6 }
    if col_idx == 7 { return r.col7 }
    return value_null()
}

export function row_delete(r: Row) -> Row {
    return Row {
        id: r.id,
        col0: r.col0, col1: r.col1, col2: r.col2, col3: r.col3,
        col4: r.col4, col5: r.col5, col6: r.col6, col7: r.col7,
        num_columns: r.num_columns,
        is_deleted: true
    }
}

# =============================================================================
# GENERIC CONTAINERS - Box<T> and Pair<A,B>
# =============================================================================

# Generic box for wrapping values
struct Box<T> {
    value: T
    has_value: bool
}

export function box_new<T>(val: T) -> Box<T> {
    return Box<T> { value: val, has_value: true }
}

export function box_empty<T>(default_val: T) -> Box<T> {
    return Box<T> { value: default_val, has_value: false }
}

# Generic pair for key-value associations
struct Pair<K, V> {
    key: K
    value: V
}

export function pair_new<K, V>(k: K, v: V) -> Pair<K, V> {
    return Pair<K, V> { key: k, value: v }
}

# =============================================================================
# TABLE METADATA - Schema definition
# =============================================================================

export struct TableSchema {
    name: string
    num_columns: i32
    col0_def: ColumnDef
    col1_def: ColumnDef
    col2_def: ColumnDef
    col3_def: ColumnDef
    col4_def: ColumnDef
    col5_def: ColumnDef
    col6_def: ColumnDef
    col7_def: ColumnDef
}

export function schema_new(name: string) -> TableSchema {
    let empty_col: ColumnDef = column_def_new("", field_type_int())
    return TableSchema {
        name: name,
        num_columns: 0,
        col0_def: empty_col,
        col1_def: empty_col,
        col2_def: empty_col,
        col3_def: empty_col,
        col4_def: empty_col,
        col5_def: empty_col,
        col6_def: empty_col,
        col7_def: empty_col
    }
}

export function schema_add_column(s: TableSchema, col: ColumnDef) -> TableSchema {
    let idx: i32 = s.num_columns
    let new_count: i32 = s.num_columns + 1
    
    if idx == 0 { return TableSchema { name: s.name, num_columns: new_count, col0_def: col, col1_def: s.col1_def, col2_def: s.col2_def, col3_def: s.col3_def, col4_def: s.col4_def, col5_def: s.col5_def, col6_def: s.col6_def, col7_def: s.col7_def } }
    if idx == 1 { return TableSchema { name: s.name, num_columns: new_count, col0_def: s.col0_def, col1_def: col, col2_def: s.col2_def, col3_def: s.col3_def, col4_def: s.col4_def, col5_def: s.col5_def, col6_def: s.col6_def, col7_def: s.col7_def } }
    if idx == 2 { return TableSchema { name: s.name, num_columns: new_count, col0_def: s.col0_def, col1_def: s.col1_def, col2_def: col, col3_def: s.col3_def, col4_def: s.col4_def, col5_def: s.col5_def, col6_def: s.col6_def, col7_def: s.col7_def } }
    if idx == 3 { return TableSchema { name: s.name, num_columns: new_count, col0_def: s.col0_def, col1_def: s.col1_def, col2_def: s.col2_def, col3_def: col, col4_def: s.col4_def, col5_def: s.col5_def, col6_def: s.col6_def, col7_def: s.col7_def } }
    if idx == 4 { return TableSchema { name: s.name, num_columns: new_count, col0_def: s.col0_def, col1_def: s.col1_def, col2_def: s.col2_def, col3_def: s.col3_def, col4_def: col, col5_def: s.col5_def, col6_def: s.col6_def, col7_def: s.col7_def } }
    if idx == 5 { return TableSchema { name: s.name, num_columns: new_count, col0_def: s.col0_def, col1_def: s.col1_def, col2_def: s.col2_def, col3_def: s.col3_def, col4_def: s.col4_def, col5_def: col, col6_def: s.col6_def, col7_def: s.col7_def } }
    if idx == 6 { return TableSchema { name: s.name, num_columns: new_count, col0_def: s.col0_def, col1_def: s.col1_def, col2_def: s.col2_def, col3_def: s.col3_def, col4_def: s.col4_def, col5_def: s.col5_def, col6_def: col, col7_def: s.col7_def } }
    if idx == 7 { return TableSchema { name: s.name, num_columns: new_count, col0_def: s.col0_def, col1_def: s.col1_def, col2_def: s.col2_def, col3_def: s.col3_def, col4_def: s.col4_def, col5_def: s.col5_def, col6_def: s.col6_def, col7_def: col } }
    return s
}

export function schema_get_column(s: TableSchema, idx: i32) -> ColumnDef {
    if idx == 0 { return s.col0_def }
    if idx == 1 { return s.col1_def }
    if idx == 2 { return s.col2_def }
    if idx == 3 { return s.col3_def }
    if idx == 4 { return s.col4_def }
    if idx == 5 { return s.col5_def }
    if idx == 6 { return s.col6_def }
    if idx == 7 { return s.col7_def }
    return column_def_new("", field_type_int())
}

# =============================================================================
# STATISTICS - Tracking database metrics
# =============================================================================

export struct TableStats {
    total_rows: i64
    deleted_rows: i64
    num_inserts: i64
    num_updates: i64
    num_deletes: i64
    num_queries: i64
}

export function stats_new() -> TableStats {
    return TableStats {
        total_rows: 0,
        deleted_rows: 0,
        num_inserts: 0,
        num_updates: 0,
        num_deletes: 0,
        num_queries: 0
    }
}

export function stats_record_insert(s: TableStats) -> TableStats {
    return TableStats {
        total_rows: s.total_rows + 1,
        deleted_rows: s.deleted_rows,
        num_inserts: s.num_inserts + 1,
        num_updates: s.num_updates,
        num_deletes: s.num_deletes,
        num_queries: s.num_queries
    }
}

export function stats_record_delete(s: TableStats) -> TableStats {
    return TableStats {
        total_rows: s.total_rows,
        deleted_rows: s.deleted_rows + 1,
        num_inserts: s.num_inserts,
        num_updates: s.num_updates,
        num_deletes: s.num_deletes + 1,
        num_queries: s.num_queries
    }
}

export function stats_record_query(s: TableStats) -> TableStats {
    return TableStats {
        total_rows: s.total_rows,
        deleted_rows: s.deleted_rows,
        num_inserts: s.num_inserts,
        num_updates: s.num_updates,
        num_deletes: s.num_deletes,
        num_queries: s.num_queries + 1
    }
}

export function stats_active_rows(s: TableStats) -> i64 {
    return s.total_rows - s.deleted_rows
}
