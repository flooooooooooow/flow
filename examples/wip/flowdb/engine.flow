# FlowDB - Database Engine Module
# Demonstrates: effects, capabilities, handlers, scoped side effects
#
# The engine uses FLOW's effect system to make database operations
# explicit and controllable. All I/O is tracked through effects.

import "types.flow"
import "traits.flow"
import "stdlib/result.flow"

# =============================================================================
# EFFECT: Database - Core database operations
# =============================================================================

effect Database {
    # Insert a row, returns the new row ID
    insert_row(row: Row) -> i64,
    
    # Find a row by ID
    find_by_id(id: i64) -> Row,
    
    # Delete a row by ID, returns success
    delete_row(id: i64) -> bool,
    
    # Update a row
    update_row(row: Row) -> bool,
    
    # Get current row count
    row_count() -> i64,
    
    # Get next available ID
    next_id() -> i64,
}

# =============================================================================
# EFFECT: Logger - Audit logging for all operations
# =============================================================================

effect Logger {
    log_info(message: string) -> void,
    log_error(message: string) -> void,
    log_query(query_type: string, affected: i64) -> void,
}

# =============================================================================
# CAPABILITY: ConsoleLogger - Log to stdout
# =============================================================================

capability ConsoleLogger {
    effect Logger,
    
    function log_info(message: string) -> void {
        printf("[INFO] %s\n", message)
    }
    
    function log_error(message: string) -> void {
        printf("[ERROR] %s\n", message)
    }
    
    function log_query(query_type: string, affected: i64) -> void {
        printf("[QUERY] %s - %lld rows affected\n", query_type, affected)
    }
}

# =============================================================================
# CAPABILITY: SilentLogger - No logging (for performance)
# =============================================================================

capability SilentLogger {
    effect Logger,
    
    function log_info(message: string) -> void {
        # Do nothing
        return void
    }
    
    function log_error(message: string) -> void {
        return void
    }
    
    function log_query(query_type: string, affected: i64) -> void {
        return void
    }
}

# =============================================================================
# TABLE STORAGE - In-memory table (fixed size for demo)
# =============================================================================

const MAX_ROWS: i32 = 1000

export struct Table {
    schema: TableSchema
    stats: TableStats
    next_id: i64
    
    # Fixed array storage (FLOW arrays not fully dynamic yet)
    row0: Row
    row1: Row
    row2: Row
    row3: Row
    row4: Row
    row5: Row
    row6: Row
    row7: Row
    row8: Row
    row9: Row
    row10: Row
    row11: Row
    row12: Row
    row13: Row
    row14: Row
    row15: Row
    row_count_actual: i32
}

export function table_new(schema: TableSchema) -> Table {
    let empty_row: Row = row_new(-1)
    return Table {
        schema: schema,
        stats: stats_new(),
        next_id: 1,
        row0: empty_row, row1: empty_row, row2: empty_row, row3: empty_row,
        row4: empty_row, row5: empty_row, row6: empty_row, row7: empty_row,
        row8: empty_row, row9: empty_row, row10: empty_row, row11: empty_row,
        row12: empty_row, row13: empty_row, row14: empty_row, row15: empty_row,
        row_count_actual: 0
    }
}

# Get a row by index
function table_get_row(t: Table, idx: i32) -> Row {
    if idx == 0 { return t.row0 }
    if idx == 1 { return t.row1 }
    if idx == 2 { return t.row2 }
    if idx == 3 { return t.row3 }
    if idx == 4 { return t.row4 }
    if idx == 5 { return t.row5 }
    if idx == 6 { return t.row6 }
    if idx == 7 { return t.row7 }
    if idx == 8 { return t.row8 }
    if idx == 9 { return t.row9 }
    if idx == 10 { return t.row10 }
    if idx == 11 { return t.row11 }
    if idx == 12 { return t.row12 }
    if idx == 13 { return t.row13 }
    if idx == 14 { return t.row14 }
    if idx == 15 { return t.row15 }
    return row_new(-1)
}

# Set a row by index - returns new table (immutable update)
function table_set_row(t: Table, idx: i32, r: Row) -> Table {
    if idx == 0 { return Table { schema: t.schema, stats: t.stats, next_id: t.next_id, row0: r, row1: t.row1, row2: t.row2, row3: t.row3, row4: t.row4, row5: t.row5, row6: t.row6, row7: t.row7, row8: t.row8, row9: t.row9, row10: t.row10, row11: t.row11, row12: t.row12, row13: t.row13, row14: t.row14, row15: t.row15, row_count_actual: t.row_count_actual } }
    if idx == 1 { return Table { schema: t.schema, stats: t.stats, next_id: t.next_id, row0: t.row0, row1: r, row2: t.row2, row3: t.row3, row4: t.row4, row5: t.row5, row6: t.row6, row7: t.row7, row8: t.row8, row9: t.row9, row10: t.row10, row11: t.row11, row12: t.row12, row13: t.row13, row14: t.row14, row15: t.row15, row_count_actual: t.row_count_actual } }
    if idx == 2 { return Table { schema: t.schema, stats: t.stats, next_id: t.next_id, row0: t.row0, row1: t.row1, row2: r, row3: t.row3, row4: t.row4, row5: t.row5, row6: t.row6, row7: t.row7, row8: t.row8, row9: t.row9, row10: t.row10, row11: t.row11, row12: t.row12, row13: t.row13, row14: t.row14, row15: t.row15, row_count_actual: t.row_count_actual } }
    if idx == 3 { return Table { schema: t.schema, stats: t.stats, next_id: t.next_id, row0: t.row0, row1: t.row1, row2: t.row2, row3: r, row4: t.row4, row5: t.row5, row6: t.row6, row7: t.row7, row8: t.row8, row9: t.row9, row10: t.row10, row11: t.row11, row12: t.row12, row13: t.row13, row14: t.row14, row15: t.row15, row_count_actual: t.row_count_actual } }
    if idx == 4 { return Table { schema: t.schema, stats: t.stats, next_id: t.next_id, row0: t.row0, row1: t.row1, row2: t.row2, row3: t.row3, row4: r, row5: t.row5, row6: t.row6, row7: t.row7, row8: t.row8, row9: t.row9, row10: t.row10, row11: t.row11, row12: t.row12, row13: t.row13, row14: t.row14, row15: t.row15, row_count_actual: t.row_count_actual } }
    if idx == 5 { return Table { schema: t.schema, stats: t.stats, next_id: t.next_id, row0: t.row0, row1: t.row1, row2: t.row2, row3: t.row3, row4: t.row4, row5: r, row6: t.row6, row7: t.row7, row8: t.row8, row9: t.row9, row10: t.row10, row11: t.row11, row12: t.row12, row13: t.row13, row14: t.row14, row15: t.row15, row_count_actual: t.row_count_actual } }
    if idx == 6 { return Table { schema: t.schema, stats: t.stats, next_id: t.next_id, row0: t.row0, row1: t.row1, row2: t.row2, row3: t.row3, row4: t.row4, row5: t.row5, row6: r, row7: t.row7, row8: t.row8, row9: t.row9, row10: t.row10, row11: t.row11, row12: t.row12, row13: t.row13, row14: t.row14, row15: t.row15, row_count_actual: t.row_count_actual } }
    if idx == 7 { return Table { schema: t.schema, stats: t.stats, next_id: t.next_id, row0: t.row0, row1: t.row1, row2: t.row2, row3: t.row3, row4: t.row4, row5: t.row5, row6: t.row6, row7: r, row8: t.row8, row9: t.row9, row10: t.row10, row11: t.row11, row12: t.row12, row13: t.row13, row14: t.row14, row15: t.row15, row_count_actual: t.row_count_actual } }
    if idx == 8 { return Table { schema: t.schema, stats: t.stats, next_id: t.next_id, row0: t.row0, row1: t.row1, row2: t.row2, row3: t.row3, row4: t.row4, row5: t.row5, row6: t.row6, row7: t.row7, row8: r, row9: t.row9, row10: t.row10, row11: t.row11, row12: t.row12, row13: t.row13, row14: t.row14, row15: t.row15, row_count_actual: t.row_count_actual } }
    if idx == 9 { return Table { schema: t.schema, stats: t.stats, next_id: t.next_id, row0: t.row0, row1: t.row1, row2: t.row2, row3: t.row3, row4: t.row4, row5: t.row5, row6: t.row6, row7: t.row7, row8: t.row8, row9: r, row10: t.row10, row11: t.row11, row12: t.row12, row13: t.row13, row14: t.row14, row15: t.row15, row_count_actual: t.row_count_actual } }
    return t
}

# =============================================================================
# DATABASE OPERATIONS (Pure functions, no effects)
# =============================================================================

# Insert a row into the table, returns (new_table, assigned_id)
export function db_insert(t: Table, r: Row) -> Table {
    if t.row_count_actual >= 16 {
        # Table full - in a real system, we'd resize
        return t
    }
    
    let new_id: i64 = t.next_id
    let new_row: Row = Row {
        id: new_id,
        col0: r.col0, col1: r.col1, col2: r.col2, col3: r.col3,
        col4: r.col4, col5: r.col5, col6: r.col6, col7: r.col7,
        num_columns: r.num_columns,
        is_deleted: false
    }
    
    let idx: i32 = t.row_count_actual
    let updated: Table = table_set_row(t, idx, new_row)
    
    return Table {
        schema: updated.schema,
        stats: stats_record_insert(updated.stats),
        next_id: new_id + 1,
        row0: updated.row0, row1: updated.row1, row2: updated.row2, row3: updated.row3,
        row4: updated.row4, row5: updated.row5, row6: updated.row6, row7: updated.row7,
        row8: updated.row8, row9: updated.row9, row10: updated.row10, row11: updated.row11,
        row12: updated.row12, row13: updated.row13, row14: updated.row14, row15: updated.row15,
        row_count_actual: idx + 1
    }
}

# Find a row by ID
export function db_find_by_id(t: Table, id: i64) -> Row {
    for i in 0 to t.row_count_actual {
        let r: Row = table_get_row(t, i)
        if r.id == id and r.is_deleted == false {
            return r
        }
    }
    return row_new(-1)  # Not found
}

# Delete a row by ID (soft delete)
export function db_delete(t: Table, id: i64) -> Table {
    for i in 0 to t.row_count_actual {
        let r: Row = table_get_row(t, i)
        if r.id == id and r.is_deleted == false {
            let deleted_row: Row = row_delete(r)
            let updated: Table = table_set_row(t, i, deleted_row)
            return Table {
                schema: updated.schema,
                stats: stats_record_delete(updated.stats),
                next_id: updated.next_id,
                row0: updated.row0, row1: updated.row1, row2: updated.row2, row3: updated.row3,
                row4: updated.row4, row5: updated.row5, row6: updated.row6, row7: updated.row7,
                row8: updated.row8, row9: updated.row9, row10: updated.row10, row11: updated.row11,
                row12: updated.row12, row13: updated.row13, row14: updated.row14, row15: updated.row15,
                row_count_actual: updated.row_count_actual
            }
        }
    }
    return t  # Not found, return unchanged
}

# Count active (non-deleted) rows
export function db_count(t: Table) -> i64 {
    let count: i64 = 0
    for i in 0 to t.row_count_actual {
        let r: Row = table_get_row(t, i)
        if r.is_deleted == false {
            count = count + 1
        }
    }
    return count
}

# =============================================================================
# HIGH-LEVEL API WITH LOGGING (Uses effects)
# =============================================================================

# Insert with logging
export function insert_with_log(t: Table, r: Row) -> Table {
    Logger.log_info("Inserting new row")
    let result: Table = db_insert(t, r)
    Logger.log_query("INSERT", 1)
    return result
}

# Delete with logging
export function delete_with_log(t: Table, id: i64) -> Table {
    Logger.log_info("Deleting row")
    let before_count: i64 = db_count(t)
    let result: Table = db_delete(t, id)
    let after_count: i64 = db_count(result)
    let affected: i64 = before_count - after_count
    Logger.log_query("DELETE", affected)
    return result
}

# Full table scan with logging
export function scan_with_log(t: Table) -> void {
    Logger.log_info("Starting full table scan")
    let count: i64 = db_count(t)
    Logger.log_query("SCAN", count)
    
    printf("\n")
    print_header(t.schema)
    
    for i in 0 to t.row_count_actual {
        let r: Row = table_get_row(t, i)
        if r.is_deleted == false {
            print_row(r, t.schema)
        }
    }
    
    printf("+")
    for j in 0 to t.schema.num_columns {
        printf("----------+")
    }
    printf("\n")
    printf("(%lld rows)\n\n", count)
}

# =============================================================================
# TRANSACTION SUPPORT (Simplified)
# =============================================================================

export struct Transaction {
    original_table: Table
    current_table: Table
    is_active: bool
    num_operations: i32
}

export function transaction_begin(t: Table) -> Transaction {
    Logger.log_info("BEGIN TRANSACTION")
    return Transaction {
        original_table: t,
        current_table: t,
        is_active: true,
        num_operations: 0
    }
}

export function transaction_commit(tx: Transaction) -> Table {
    if tx.is_active == false {
        Logger.log_error("Cannot commit: transaction not active")
        return tx.original_table
    }
    Logger.log_info("COMMIT TRANSACTION")
    return tx.current_table
}

export function transaction_rollback(tx: Transaction) -> Table {
    if tx.is_active == false {
        Logger.log_error("Cannot rollback: transaction not active")
        return tx.original_table
    }
    Logger.log_info("ROLLBACK TRANSACTION")
    return tx.original_table
}
