# Producer → transform → consumer pipeline over Go-style channels.
# Run: ./flow run examples/concurrency/pipeline.flow
#
# Stages communicate with channel_i32_send / channel_i32_recv.
# This runs stages in parallel threads using thread_spawn.

import "stdlib/concurrent.flow"

struct ProduceArgs {
    out: ptr<Channel_i32>,
    n: i32
}

function produce(arg: ptr<i8>) -> void {
    let args: ptr<ProduceArgs> = arg as ptr<ProduceArgs>
    for i in 1 to args.n + 1 {
        let _: bool = channel_i32_send(args.out, i)
    }
    channel_i32_close(args.out)
}

struct TransformArgs {
    inp: ptr<Channel_i32>,
    out: ptr<Channel_i32>
}

function transform(arg: ptr<i8>) -> void {
    let args: ptr<TransformArgs> = arg as ptr<TransformArgs>
    let mut v: i32 = 0
    while channel_i32_recv(args.inp, &v) {
        # Double each value
        let _: bool = channel_i32_send(args.out, v * 2)
    }
    channel_i32_close(args.out)
}

function main() -> i32 {
    printf("Channel pipeline demo\n")
    let mut a: Channel_i32 = channel_i32_new(8)
    let mut b: Channel_i32 = channel_i32_new(8)
    let ap: ptr<Channel_i32> = &a
    let bp: ptr<Channel_i32> = &b

    let mut prod_args: ProduceArgs = ProduceArgs { out: ap, n: 5 }
    let mut t1: Thread = thread_spawn(produce as ptr<i8>, &prod_args as ptr<i8>)

    let mut trans_args: TransformArgs = TransformArgs { inp: ap, out: bp }
    let mut t2: Thread = thread_spawn(transform as ptr<i8>, &trans_args as ptr<i8>)

    let mut v: i32 = 0
    let mut sum: i32 = 0
    let mut count: i32 = 0
    while channel_i32_recv(bp, &v) {
        sum = sum + v
        count = count + 1
        printf("  stage3 got %d\n", v)
    }
    printf("pipeline: count=%d sum=%d (expect count=5 sum=30)\n", count, sum)

    let _j1: i32 = thread_join(&t1)
    let _j2: i32 = thread_join(&t2)

    channel_i32_destroy(ap)
    channel_i32_destroy(bp)

    if count != 5 {
        return 1
    }
    if sum != 30 {
        return 2
    }
    printf("OK\n")
    return 0
}
