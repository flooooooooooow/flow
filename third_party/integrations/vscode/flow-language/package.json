{
  "name": "flow-language",
  "displayName": "FLOW Language",
  "description": "Flow language support: syntax, snippets, tasks, run/compile, and LSP (effects, autodiff, C backend).",
  "version": "0.3.0",
  "publisher": "quilio",
  "author": "Flow contributors",
  "license": "MIT",
  "homepage": "https://github.com/flooooooooooow/flow",
  "repository": {
    "type": "git",
    "url": "https://github.com/flooooooooooow/flow.git",
    "directory": "third_party/integrations/vscode/flow-language"
  },
  "bugs": {
    "url": "https://github.com/flooooooooooow/flow/issues"
  },
  "qna": "https://github.com/flooooooooooow/flow/discussions",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Debuggers",
    "Testing",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "flow",
    "flow-lang",
    "algebraic effects",
    "autodiff",
    "dsl",
    "syntax",
    "lsp",
    "debugger",
    "testing"
  ],
  "extensionDependencies": [],
  "extensionPack": [],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:flow",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "flow",
        "aliases": [
          "FLOW",
          "Flow",
          "flow"
        ],
        "extensions": [
          ".flow"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/flow-file.svg",
          "dark": "./images/flow-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "flow",
        "scopeName": "source.flow",
        "path": "./syntaxes/flow.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "flow.restartLsp",
        "title": "FLOW: Restart Language Server",
        "category": "Flow"
      },
      {
        "command": "flow.runFile",
        "title": "FLOW: Run Current File",
        "category": "Flow",
        "icon": "$(play)"
      },
      {
        "command": "flow.compileFile",
        "title": "FLOW: Compile Current File",
        "category": "Flow",
        "icon": "$(tools)"
      },
      {
        "command": "flow.formatFile",
        "title": "FLOW: Format Current File",
        "category": "Flow",
        "icon": "$(symbol-ruler)"
      },
      {
        "command": "flow.debugFile",
        "title": "FLOW: Debug Current File",
        "category": "Flow",
        "icon": "$(debug-alt)"
      },
      {
        "command": "flow.debugBuildOnly",
        "title": "FLOW: Build Debug Binary",
        "category": "Flow"
      },
      {
        "command": "flow.refreshTests",
        "title": "FLOW: Refresh Test Explorer",
        "category": "Flow"
      },
      {
        "command": "flow.openDocs",
        "title": "FLOW: Open Documentation",
        "category": "Flow"
      }
    ],
    "keybindings": [
      {
        "command": "flow.runFile",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorLangId == flow"
      },
      {
        "command": "flow.compileFile",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorLangId == flow"
      },
      {
        "command": "flow.debugFile",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorLangId == flow"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "flow.runFile",
          "when": "resourceLangId == flow",
          "group": "navigation@1"
        },
        {
          "command": "flow.debugFile",
          "when": "resourceLangId == flow",
          "group": "navigation@2"
        },
        {
          "command": "flow.compileFile",
          "when": "resourceLangId == flow",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "flow.runFile",
          "when": "resourceLangId == flow",
          "group": "flow@1"
        },
        {
          "command": "flow.debugFile",
          "when": "resourceLangId == flow",
          "group": "flow@2"
        },
        {
          "command": "flow.compileFile",
          "when": "resourceLangId == flow",
          "group": "flow@3"
        },
        {
          "command": "flow.formatFile",
          "when": "resourceLangId == flow",
          "group": "flow@4"
        }
      ],
      "commandPalette": [
        {
          "command": "flow.runFile",
          "when": "editorLangId == flow"
        },
        {
          "command": "flow.compileFile",
          "when": "editorLangId == flow"
        },
        {
          "command": "flow.debugFile",
          "when": "editorLangId == flow"
        },
        {
          "command": "flow.formatFile",
          "when": "editorLangId == flow"
        }
      ]
    },
    "configurationDefaults": {
      "[flow]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "quilio.flow-language",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    },
    "snippets": [
      {
        "language": "flow",
        "path": "./snippets/flow.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "flow",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "Flow CLI subcommand (run, compile, test, …)"
          },
          "file": {
            "type": "string",
            "description": "Optional .flow path relative to workspace"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "flow",
        "owner": "flow",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(.*\\.flow):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "FLOW",
      "properties": {
        "flow.lspPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a dedicated FLOW LSP binary. When empty, uses python3 -m flow.lsp_server."
        },
        "flow.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python used to launch flow.lsp_server when flow.lspPath is empty."
        },
        "flow.repoPath": {
          "type": "string",
          "default": "",
          "description": "Path to a Flow language checkout (adds <repo>/src to PYTHONPATH). Auto-detected from the workspace when possible."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  }
}
