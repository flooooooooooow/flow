{
  "function": {
    "prefix": ["fn", "function"],
    "body": [
      "function ${1:name}(${2:args}) -> ${3:i32} {",
      "    $0",
      "    return 0",
      "}"
    ],
    "description": "Function with return type"
  },
  "function void": {
    "prefix": ["fnvoid", "procedure"],
    "body": [
      "function ${1:name}(${2:args}) {",
      "    $0",
      "}"
    ],
    "description": "Void function"
  },
  "main": {
    "prefix": ["main", "fnmain"],
    "body": [
      "function main() -> i32 {",
      "    $0",
      "    return 0",
      "}"
    ],
    "description": "Program entry point"
  },
  "let": {
    "prefix": "let",
    "body": "let ${1:name}: ${2:i32} = ${3:0}",
    "description": "Immutable binding"
  },
  "let mut": {
    "prefix": ["letmut", "mut"],
    "body": "let mut ${1:name}: ${2:i32} = ${3:0}",
    "description": "Mutable binding"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "    ${2:field}: ${3:i32},",
      "    $0",
      "}"
    ],
    "description": "Struct declaration"
  },
  "effect": {
    "prefix": "effect",
    "body": [
      "effect ${1:Name} {",
      "    ${2:op}(${3:args}) -> ${4:i32},",
      "    $0",
      "}"
    ],
    "description": "Algebraic effect interface"
  },
  "capability": {
    "prefix": ["capability", "cap"],
    "body": [
      "capability ${1:Name} for ${2:Effect} {",
      "    function ${3:op}(${4:args}) -> ${5:i32} {",
      "        $0",
      "        return 0",
      "    }",
      "}"
    ],
    "description": "Effect capability (handler)"
  },
  "handle": {
    "prefix": "handle",
    "body": [
      "handle ${1:Effect} with ${2:Capability} {",
      "    $0",
      "}"
    ],
    "description": "Install effect handler for a dynamic scope"
  },
  "extern": {
    "prefix": "extern",
    "body": [
      "extern {",
      "    function ${1:name}(${2:args}) -> ${3:i32}",
      "}"
    ],
    "description": "FFI extern block"
  },
  "import": {
    "prefix": "import",
    "body": "import \"${1:stdlib/math.flow}\"",
    "description": "Import a Flow module"
  },
  "export function": {
    "prefix": ["exportfn", "export function"],
    "body": [
      "export function ${1:name}(${2:args}) -> ${3:i32} {",
      "    $0",
      "    return 0",
      "}"
    ],
    "description": "Exported function"
  },
  "for range": {
    "prefix": ["for", "forin"],
    "body": [
      "for ${1:i} in ${2:0} to ${3:n} {",
      "    $0",
      "}"
    ],
    "description": "Inclusive for-range loop (0 to n)"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "While loop"
  },
  "if else": {
    "prefix": ["if", "ifel"],
    "body": [
      "if ${1:condition} {",
      "    $2",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "If / else"
  },
  "match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "    ${2:pattern} => {",
      "        $0",
      "    }",
      "    default => {",
      "    }",
      "}"
    ],
    "description": "Match expression"
  },
  "flow evolves": {
    "prefix": ["flow", "evolves"],
    "body": [
      "flow ${1:System} {",
      "    state ${2:x}: ${3:f64} = ${4:0.0}",
      "    state ${5:v}: ${6:f64} = ${7:0.0}",
      "",
      "    ${2:x} evolves as ${5:v}",
      "    ${5:v} evolves as ${8:-(gravity / length) * sin(${2:x})}",
      "    $0",
      "}"
    ],
    "description": "Evolution system (flow / evolves as)"
  },
  "test assert": {
    "prefix": ["assert", "expect"],
    "body": "expect(${1:condition})",
    "description": "Expectation / assert helper"
  },
  "println": {
    "prefix": ["println", "print"],
    "body": "println(${1:\"hello\"})",
    "description": "Print with newline"
  },
  "ptr type": {
    "prefix": "ptr",
    "body": "ptr<${1:i32}>",
    "description": "Pointer type"
  },
  "array type": {
    "prefix": "array",
    "body": "array<${1:i32}, ${2:16}>",
    "description": "Fixed array type"
  },
  "dynamics namespace block": {
    "prefix": ["dynamics", "dyn-block"],
    "body": [
      "dynamics {",
      "    dsys ${1:plant} {",
      "        discrete",
      "        dt ${2:0.1}",
      "        n ${3:2} m ${4:1} p ${5:1}",
      "        A ${6:1.0 0.1 0.0 1.0}",
      "        B ${7:0.0 0.1}",
      "        C ${8:1.0 0.0}",
      "    }",
      "    horizon ${9:rollout} finite ${10:50}",
      "    sense on ${1:plant} {",
      "        controllable -> ${11:plant_ok}",
      "        spectral -> ${12:rho_open}",
      "    }",
      "    $0",
      "}"
    ],
    "description": "Namespaced dynamics DSL block (dsys + horizon + sense)"
  },
  "dyn.dsys": {
    "prefix": ["dyn.dsys", "dsys"],
    "body": [
      "dyn.dsys ${1:plant} {",
      "    ${2|discrete,continuous|}",
      "    dt ${3:0.1}",
      "    n ${4:2} m ${5:1} p ${6:1}",
      "    A ${7:1.0 0.1 0.0 1.0}",
      "    B ${8:0.0 0.1}",
      "    C ${9:1.0 0.0}",
      "}"
    ],
    "description": "Declare a linear plant (dynamics DSL)"
  },
  "dyn.horizon": {
    "prefix": ["dyn.horizon", "horizon"],
    "body": "dyn.horizon ${1:rollout} finite ${2:50}",
    "description": "Finite analysis horizon"
  },
  "dyn.sense": {
    "prefix": ["dyn.sense", "sense"],
    "body": [
      "dyn.sense on ${1:plant} {",
      "    controllable -> ${2:plant_ok}",
      "    spectral -> ${3:rho_open}",
      "    $0",
      "}"
    ],
    "description": "Open-loop sense bindings"
  },
  "dyn.ga evolve": {
    "prefix": ["dyn.ga", "ga evolve"],
    "body": [
      "dyn.ga evolve on ${1:plant} over ${2:rollout} -> ${3:k1} ${4:k2} {",
      "    population ${5:12}",
      "    generations ${6:30}",
      "    mutation ${7:0.3}",
      "}"
    ],
    "description": "GA feedback gain search"
  },
  "dyn.closed": {
    "prefix": ["dyn.closed", "closed"],
    "body": [
      "dyn.closed ${1:plant} with ${2:k1} ${3:k2} {",
      "    spectral -> ${4:rho_cl}",
      "    energy over ${5:rollout} -> ${6:E_cl}",
      "    stable -> ${7:stable_cl}",
      "}"
    ],
    "description": "Closed-loop certification"
  },
  "dyn.analyze": {
    "prefix": ["dyn.analyze", "analyze"],
    "body": [
      "dyn.analyze ${1:plant} ga ${2:k1} ${3:k2} over ${4:rollout} -> ${5:report} {",
      "    full",
      "}"
    ],
    "description": "One-shot GAAnalysisReport pipeline"
  },
  "sort": {
    "prefix": ["sort", "|> sort"],
    "body": "${1:xs} |> sort",
    "description": "Declarative ascending sort (in-place)"
  },
  "sortBy multi-key": {
    "prefix": ["sortBy", "sort by"],
    "body": "${1:xs} |> sortBy [${2|asc,desc|} .${3:score}, ${4|asc,desc|} .${5:name}]",
    "description": "Declarative multi-key ordering"
  },
  "sort by field": {
    "prefix": ["sort by field"],
    "body": "${1:xs} |> sort by .${2:score}",
    "description": "Sort struct array by one field"
  },
  "sort descending": {
    "prefix": ["sort descending"],
    "body": "${1:xs} |> sort descending",
    "description": "Declarative descending sort"
  },
  "shader fill": {
    "prefix": ["shader", "shader fill"],
    "body": [
      "shader fill ${1:name} {",
      "    fn color(uv: vec2) -> vec4 {",
      "        return vec4(${2:uv.x}, ${3:uv.y}, ${4:0.2}, 1.0)",
      "    }",
      "}"
    ],
    "description": "Fill-shader (FSL) fragment"
  }
}
