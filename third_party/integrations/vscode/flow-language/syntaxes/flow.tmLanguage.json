{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FLOW",
  "scopeName": "source.flow",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#dynamics" },
    { "include": "#ordering" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "dynamics": {
      "patterns": [
        {
          "name": "keyword.control.dynamics.flow",
          "match": "\\b(?:dyn|dynamics)\\.(?:dsys|horizon|sense|ga|closed|analyze|wfc|couple|guide)\\b"
        },
        {
          "name": "keyword.control.dynamics.flow",
          "match": "(?<=^|\\s)(?:dyn|dynamics)(?=\\s*\\{)"
        },
        {
          "name": "keyword.control.dynamics.flow",
          "match": "(?<=^|\\s)(?:dsys|horizon|sense|closed|analyze|(?:ga\\s+evolve)|(?:wfc\\s+field)|couple|guide)(?=\\s)"
        },
        {
          "name": "keyword.other.dynamics.flow",
          "match": "\\b(?:controllable|spectral|gramian|stable|population|generations|mutation|discrete|continuous)\\b"
        }
      ]
    },
    "ordering": {
      "patterns": [
        {
          "name": "keyword.control.ordering.flow",
          "match": "\\b(?:sortBy|sort|order)\\b"
        },
        {
          "name": "keyword.other.ordering.flow",
          "match": "\\b(?:asc|desc|ascending|descending|unique|adaptive|compact|entropy)\\b"
        },
        {
          "name": "keyword.operator.pipeline.flow",
          "match": "\\|>"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.flow",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.flow",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.flow",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow",
          "match": "\\b(if|elif|else|while|for|return|match|default|handle|with|parallel|in|step|to|and|or|not|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.flow",
          "match": "\\b(function|let|mut|struct|enum|effect|capability|import|export|module|extern|const|theorem|assume|therefore|type|impl|trait)\\b"
        },
        {
          "name": "constant.language.flow",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.flow",
          "match": "\\b(i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|f32|f64|bool|void|string|array|ptr|vec)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.flow",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.flow",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.flow",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.flow",
          "match": "(->|\\.\\.|\\.|\\/|\\*|\\+|-|==|!=|<=|>=|<|>|&&|\\|\\||!|=)"
        }
      ]
    }
  }
}
