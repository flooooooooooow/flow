      },
      {
        "label": "Flow Dim",
        "uiTheme": "vs-dark",
        "path": "./themes/flow-dim.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/flooooooooooow/flow.git",
    "directory": "third_party/integrations/vscode/flow-themes"
