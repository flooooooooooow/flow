# Proposed addition for github-linguist `lib/linguist/languages.yml` (#172).
# Upstream: https://github.com/github-linguist/linguist/blob/main/CONTRIBUTING.md
#
# Flow:
#   type: programming
#   color: "#4A90D9"
#   extensions:
#   - ".flow"
#   tm_scope: source.flow
#   ace_mode: text
#   language_id: <assigned by linguist maintainers>

Flow:
  type: programming
  color: "#4A90D9"
  extensions:
  - ".flow"
  tm_scope: source.flow
  ace_mode: text
  wrappers: []
