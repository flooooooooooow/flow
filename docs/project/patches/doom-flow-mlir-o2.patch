@@ -71,17 +68,14 @@ export PYTHONPATH="$FLOW_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
 FLOWC=flow.transpiler
 mkdir -p "$TMP"
 
-# MLIR→LLVM IR is not opt-stable yet: -O1+ infers noreturn on D_DoomMain and
-# wasm-ld/binaryen drop most of the game. Stay on -O0 until that is fixed.
+# Both backends use -O2. Flow #250/#257 fixed the false-noreturn / alloca-spill
+# UB that used to make MLIR -O1+ drop the main loop (flow#253).
 EMCC_OPT=(-O2)
 if [ "$BACKEND" = "mlir" ]; then
-  EMCC_OPT=(-O0)
