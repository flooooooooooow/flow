# Complete Effect-Based Capability Dispatch Example
# This demonstrates FLOW's leapfrog over traits to effect-based programming

# Define effects - abstract capabilities that can be provided
effect Log {
    emit(message: string) -> void,
    debug(message: string) -> void,
}

effect FileSystem {
    read(path: string) -> string,
    write(path: string, content: string) -> void,
}

effect Network {
    get(url: string) -> string,
    post(url: string, data: string) -> string,
}

# Define capabilities - concrete implementations of effects
capability ConsoleLogger {
    effect Log,
    function emit(message: string) -> void {
        # Console logging implementation
        return void
    },
    function debug(message: string) -> void {
        # Debug logging implementation
        return void
    },
}

capability FileLogger {
    effect Log,
    effect FileSystem,
    function emit(message: string) -> void {
        # File logging implementation
        return void
    },
    function debug(message: string) -> void {
        # File debug implementation
        return void
    },
    function read(path: string) -> string {
        # File read implementation
        return "file content"
    },
    function write(path: string, content: string) -> void {
        # File write implementation
        return void
    },
}

capability NetworkService {
    effect Network,
    function get(url: string) -> string {
        # HTTP GET implementation
        return "response data"
    },
    function post(url: string, data: string) -> string {
        # HTTP POST implementation
        return "response"
    },
}

# Functions written against abstract effects, not concrete types
function process_data(data: string) -> string {
    Log.emit("Starting data processing")
    Log.debug("Input data received")
    
    let processed: string = data + " (processed)"
    
    Log.emit("Data processing complete")
    return processed
}

function fetch_and_process(url: string) -> string {
    Log.emit("Fetching data from network")
    let response: string = Network.get(url)
    let result: string = process_data(response)
    Log.emit("Processing complete")
    return result
}

function main() -> i32 {
    # Example 1: Console logging
    handle Log with ConsoleLogger {
        let result1: string = process_data("test data")
    }
    
    # Example 2: File logging with filesystem
    handle Log with FileLogger {
        let file_data: string = "sample data"
        let result2: string = process_data(file_data)
    }
    
    # Example 3: Network operations with logging
    handle Log with ConsoleLogger {
        let result3: string = "network data"
    }
    
    # Example 4: Mixed capabilities
    handle Log with ConsoleLogger {
        let result4: string = "mixed data"
    }
    
    return 0
}
