# Power Function - FLOW version of C++ pow() function
function power(base: i32, exp: i32) -> i32 {
    if exp == 0 {
        return 1
    }
    if exp == 1 {
        return base
    }
    
    let result: i32 = 1
    let i: i32 = 0
    
    while i < exp {
        result = result * base
        i = i + 1
    }
    
    return result
}

function main() -> i32 {
    let base: i32 = 2
    let exp: i32 = 10
    let result: i32 = power(base, exp)
    # Would print: "2^10 = 1024"
    return result
}
