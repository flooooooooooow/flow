# SIMD Loop Probe: SAXPY-like operation
# This should trigger LLVM loop vectorization with -O3 -march=native

function saxpy(a: f32, x: memref_f32, y: memref_f32, out: memref_f32, n: i32) -> void {
    for i in 0..n {
        out[i] = a * x[i] + y[i]
    }
    return void
}

function main() -> i32 {
    return 0
}
