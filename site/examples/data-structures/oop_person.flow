# OOP-style Example: Person with "method" function
# Demonstrates struct + function acting like a method

struct Person {
    name: i32,  # Simplified: name stored as ID (no strings yet)
    age: i32
}

# "Method" that operates on a Person struct
function person_greet(p: Person) -> i32 {
    # Return age as "greeting" (no strings yet)
    return p.age
}

function main() -> i32 {
    let alice: Person = Person { name: 1, age: 30 }
    let greeting: i32 = person_greet(alice)
    return greeting  # Should be 30
}
