# FLOW Programming Language Grammar
# EBNF (Extended Backus-Naur Form) Specification
# Generated from parser.py implementation

# =============================================================================
# PROGRAM STRUCTURE
# =============================================================================

program ::= declaration* EOF ;

declaration ::= export_marker? (
    function_decl
  | struct_decl
  | effect_decl
  | capability_decl
  | const_decl
  | import_decl
  | extern_decl
) ;

export_marker ::= "export" ;

# =============================================================================
# IMPORTS AND EXTERNALS
# =============================================================================

import_decl ::= "import" STRING ;

extern_decl ::= "extern" STRING? "{" extern_function* "}" ;

extern_function ::= "function" IDENTIFIER "(" parameter_list ")" ("->" type)? ;

# =============================================================================
# CONSTANTS
# =============================================================================

const_decl ::= "const" IDENTIFIER ":" type "=" expression ;

# =============================================================================
# FUNCTIONS
# =============================================================================

function_decl ::= "function" IDENTIFIER "(" parameter_list ")" ("->" type)? block ;

parameter_list ::= parameter ("," parameter)* | ε ;

parameter ::= IDENTIFIER ":" type ;

# =============================================================================
# STRUCTS
# =============================================================================

struct_decl ::= "struct" IDENTIFIER "{" field_decl* "}" ;

field_decl ::= IDENTIFIER ":" type ;

# =============================================================================
# EFFECTS AND CAPABILITIES
# =============================================================================

effect_decl ::= "effect" IDENTIFIER "{" effect_operation* "}" ;

effect_operation ::= IDENTIFIER "(" parameter_list ")" ("->" type)? ;

capability_decl ::= "capability" IDENTIFIER "{" capability_method* "}" ;

capability_method ::= IDENTIFIER ":" effect_operation ;

# =============================================================================
# STATEMENTS
# =============================================================================

block ::= "{" statement* "}" ;

statement ::= (
    var_decl
  | assignment
  | return_stmt
  | if_stmt
  | while_stmt
  | for_stmt
  | handle_stmt
  | match_stmt
  | expression_stmt
  | effect_decl
  | capability_decl
) ;

var_decl ::= "let" IDENTIFIER (":" type)? "=" expression ;

assignment ::= IDENTIFIER "=" expression ;

return_stmt ::= "return" expression? ;

if_stmt ::= "if" expression block ("elif" expression block)* ("else" block)? ;

while_stmt ::= "while" expression block ;

for_stmt ::= ("parallel")? "for" IDENTIFIER "in" range_expr block ;

range_expr ::= expression "to" expression ("step" expression)? ;

handle_stmt ::= "handle" expression "with" "{" handler_case* "}" ;

handler_case ::= effect_operation "=>" expression ;

match_stmt ::= "match" expression "{" match_case* "}" ;

match_case ::= pattern "=>" expression ;

pattern ::= IDENTIFIER | "_" ;

expression_stmt ::= expression ;

# =============================================================================
# TYPES
# =============================================================================

type ::= (
    primitive_type
  | array_type
  | pointer_type
  | struct_type
  | function_type
) ;

primitive_type ::= (
    "i8" | "i16" | "i32" | "i64" | "i128"
  | "u8" | "u16" | "u32" | "u64" | "u128"
  | "f32" | "f64"
  | "bool" | "string" | "void"
) ;

array_type ::= "array" "<" type ("," NUMBER)? ">" ;

pointer_type ::= "ptr" "<" type ">" ;

struct_type ::= IDENTIFIER ;

function_type ::= "(" parameter_list ")" "->" type ;

# =============================================================================
# EXPRESSIONS
# =============================================================================

expression ::= logical_or_expr ;

logical_or_expr ::= logical_and_expr ("||" logical_and_expr)* ;

logical_and_expr ::= equality_expr ("&&" equality_expr)* ;

equality_expr ::= comparison_expr (("==" | "!=") comparison_expr)* ;

comparison_expr ::= term_expr (("<" | ">" | "<=" | ">=") term_expr)* ;

term_expr ::= factor_expr (("+" | "-") factor_expr)* ;

factor_expr ::= unary_expr (("*" | "/" | "%") unary_expr)* ;

unary_expr ::= ("-" | "!") unary_expr | primary_expr ;

primary_expr ::= (
    literal
  | variable
  | function_call
  | struct_literal
  | array_literal
  | paren_expr
  | array_access
  | member_access
) ;

literal ::= NUMBER | STRING | "true" | "false" ;

variable ::= IDENTIFIER ;

function_call ::= IDENTIFIER "(" argument_list ")" ;

argument_list ::= expression ("," expression)* | ε ;

struct_literal ::= IDENTIFIER "{" field_init* "}" ;

field_init ::= IDENTIFIER ":" expression ;

array_literal ::= "[" expression ("," expression)* "]" ;

paren_expr ::= "(" expression ")" ;

array_access ::= primary_expr "[" expression "]" ;

member_access ::= primary_expr "." IDENTIFIER ;

# =============================================================================
# LEXICAL TOKENS
# =============================================================================

IDENTIFIER ::= [a-zA-Z_][a-zA-Z0-9_]* ;

NUMBER ::= [0-9]+ ("." [0-9]+)? ;

STRING ::= '"' [^"]* '"' ;

# Keywords
FUNCTION ::= "function" ;
LET ::= "let" ;
RETURN ::= "return" ;
IF ::= "if" ;
ELIF ::= "elif" ;
ELSE ::= "else" ;
WHILE ::= "while" ;
FOR ::= "for" ;
IN ::= "in" ;
PARALLEL ::= "parallel" ;
STEP ::= "step" ;
TO ::= "to" ;
MATCH ::= "match" ;
DEFAULT ::= "default" ;
WITH ::= "with" ;
HANDLE ::= "handle" ;
EFFECT ::= "effect" ;
CAPABILITY ::= "capability" ;
IMPORT ::= "import" ;
EXPORT ::= "export" ;
EXTERN ::= "extern" ;
CONST ::= "const" ;
STRUCT ::= "struct" ;

# Types
I8 ::= "i8" ;
I16 ::= "i16" ;
I32 ::= "i32" ;
I64 ::= "i64" ;
I128 ::= "i128" ;
U8 ::= "u8" ;
U16 ::= "u16" ;
U32 ::= "u32" ;
U64 ::= "u64" ;
U128 ::= "u128" ;
F32 ::= "f32" ;
F64 ::= "f64" ;
BOOL ::= "bool" ;
VOID ::= "void" ;
STRING ::= "string" ;
VEC ::= "vec" ;

# Symbols
LPAREN ::= "(" ;
RPAREN ::= ")" ;
LBRACE ::= "{" ;
RBRACE ::= "}" ;
LBRACKET ::= "[" ;
RBRACKET ::= "]" ;
SEMICOLON ::= ";" ;
COLON ::= ":" ;
COMMA ::= "," ;
DOTDOT ::= ".." ;
DOT ::= "." ;
ARROW ::= "->" ;
ASSIGN ::= "=" ;
DOUBLE_COLON ::= "::" ;
FAT_ARROW ::= "=>" ;

# Operators
PLUS ::= "+" ;
MINUS ::= "-" ;
STAR ::= "*" ;
SLASH ::= "/" ;
PERCENT ::= "%" ;
EQUALS ::= "==" ;
NOT_EQUALS ::= "!=" ;
LESS ::= "<" ;
GREATER ::= ">" ;
LESS_EQUAL ::= "<=" ;
GREATER_EQUAL ::= ">=" ;
AND ::= "&&" ;
OR ::= "||" ;
NOT ::= "!" ;

# Special
EOF ::= <end of input> ;

# =============================================================================
# NOTES
# =============================================================================

# 1. ε represents empty (optional)
# 2. Parentheses () indicate grouping, not tokens
# 3. Square brackets [] indicate optional elements
# 4. Curly braces {} indicate zero or more repetitions
# 5. Pipe | indicates alternatives
# 6. Operator precedence is handled by the expression hierarchy
# 7. Whitespace and comments are ignored by the lexer