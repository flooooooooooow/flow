#!/usr/bin/env bash
# Flow language server launcher. Runs the native server (tools/lsp/main.flow)
# through `flow lsp`, which builds it with the Stage-A compiler on first use.
# Editors that expect a dedicated executable point here; stdin/stdout carry
# the JSON-RPC stream.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$SOURCE_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
exec "$SCRIPT_DIR/flow" lsp "$@"
