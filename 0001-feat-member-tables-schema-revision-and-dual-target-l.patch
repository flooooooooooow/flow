+        if flowc_type_sizeof_wasm32(p.arena, sp, hp) != 8 { ok = 0 }
+        if flowc_type_layout_native64(p.arena, sp, hp) == flowc_type_layout_wasm32(p.arena, sp, hp) {
+            ok = 0
+        }
     }
