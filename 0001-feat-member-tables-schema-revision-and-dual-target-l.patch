         ok = 0
     }
     if ok == 1 {
@@ -2566,6 +2570,26 @@ function test_type_id() -> i32 {
         if flowc_type_transport_safe(p.arena, sp, pt) != 1 { ok = 0 }
         if flowc_type_transport_safe(p.arena, sp, i32t) != 1 { ok = 0 }
         if flowc_type_transport_safe(p.arena, sp, ptrt) != 0 { ok = 0 }
+        if flowc_type_schema_revision(p.arena, sp, pt) != 2 { ok = 0 }
+        if flowc_type_schema_revision(p.arena, sp, nm) != 0 { ok = 0 }
+        if flowc_type_member_count(p.arena, sp, pt) != 2 { ok = 0 }
+        if flowc_type_member_count(p.arena, sp, nm) != 3 { ok = 0 }
+        if flowc_type_member_count(p.arena, sp, i32t) != 0 { ok = 0 }
+        let mt: u64 = flowc_type_member_table(p.arena, sp, pt)
+        let mn: u64 = flowc_type_member_table(p.arena, sp, nm)
+        if mt == (0 as u64) { ok = 0 }
+        if mt == mn { ok = 0 }
+        if flowc_type_sizeof_native64(p.arena, sp, pt) != 8 { ok = 0 }
+        if flowc_type_sizeof_wasm32(p.arena, sp, pt) != 8 { ok = 0 }
+        if flowc_type_layout_native64(p.arena, sp, pt) != flowc_type_layout_wasm32(p.arena, sp, pt) {
+            # Point is TransportSafe; both ABIs must agree.
+            ok = 0
+        }
