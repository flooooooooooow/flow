# Naive recursive Fibonacci. Measures function call overhead.
# Prints "result <n>" and "seconds <t>". Timed region is the single fib(35) call.

@cEmbed("#ifndef _POSIX_C_SOURCE
#define _POSIX_C_SOURCE 200809L
#endif
#include <time.h>
/* Monotonic clock in nanoseconds. clock_gettime(CLOCK_MONOTONIC) is POSIX
   and works on Linux and on macOS 10.12 and later. */
static int64_t bench_now_ns(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (int64_t)ts.tv_sec * 1000000000LL + (int64_t)ts.tv_nsec;
}")
extern {
    function bench_now_ns() -> i64
    function printf(fmt: string, val: f64) -> i32
}

function fib(n: i32) -> i64 {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

function main() -> i32 {
    let t0: i64 = bench_now_ns()
    let result: i64 = fib(35)
    let t1: i64 = bench_now_ns()
    let secs: f64 = (t1 - t0) / 1000000000.0
    print("result ")
    println(result)
    printf("seconds %.9f\n", secs)
    return 0
}
