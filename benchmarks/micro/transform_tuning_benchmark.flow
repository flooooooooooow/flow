# @module benchmarks.micro.transform_tuning_benchmark
# @means  Transform dialect tuning: tile a 128x128 linalg.matmul with each
#         tile size through mlir-opt's transform interpreter, lower it, time
#         100 calls from a C harness, and keep the fastest size. This is the
#         autotune_transform loop of the retired mlir_optimizer.py.
#
#   ./flow tool benchmarks/micro/transform_tuning_benchmark.flow
#   ./flow tool benchmarks/micro/transform_tuning_benchmark.flow --pmu-event=cache-misses
#   ./flow tool benchmarks/micro/transform_tuning_benchmark.flow --search=bayesian --metric=cost-model

import "tools/flow_cli/sys.flow"
import "benchmarks/bench_tools.flow"
import "scripts/tools/mlir_tune/cost.flow"
import "scripts/tools/mlir_tune/search.flow"
import std.process { ProcCmd, ProcResult, ProcStrs, proc_arg, proc_cmd, proc_run, proc_stderr, proc_which, PROC_MERGE }

const KERNEL: string = "module attributes {transform.with_named_sequence} {\n  func.func @matmul_kernel(%A: memref<128x128xf32>, %B: memref<128x128xf32>, %C: memref<128x128xf32>) attributes {llvm.emit_c_interface} {\n    linalg.matmul ins(%A, %B: memref<128x128xf32>, memref<128x128xf32>)\n                  outs(%C: memref<128x128xf32>)\n    func.return\n  }\n}\n"

const HARNESS: string = "#include <stdio.h>\n#include <stdlib.h>\n#include <time.h>\n\nstruct MemRefDescriptor {\n  float *allocated;\n  float *aligned;\n  long offset;\n  long sizes[2];\n  long strides[2];\n};\n\nextern void _mlir_ciface_matmul_kernel(struct MemRefDescriptor *A, struct MemRefDescriptor *B, struct MemRefDescriptor *C);\n\nstatic double get_time(void) {\n    struct timespec ts;\n    clock_gettime(CLOCK_MONOTONIC, &ts);\n    return ts.tv_sec + ts.tv_nsec * 1e-9;\n}\n\nstatic int correct(const float *C, int N) {\n    return C[0] == 256.0f && C[N * N - 1] == 256.0f;\n}\n\nint main(void) {\n    int N = 128;\n    int size = N * N * sizeof(float);\n    float *A_data = malloc(size);\n    float *B_data = malloc(size);\n    float *C_data = malloc(size);\n    for (int i = 0; i < N * N; i++) {\n        A_data[i] = 1.0f;\n        B_data[i] = 2.0f;\n        C_data[i] = 0.0f;\n    }\n    struct MemRefDescriptor A = {A_data, A_data, 0, {N, N}, {N, 1}};\n    struct MemRefDescriptor B = {B_data, B_data, 0, {N, N}, {N, 1}};\n    struct MemRefDescriptor C = {C_data, C_data, 0, {N, N}, {N, 1}};\n    _mlir_ciface_matmul_kernel(&A, &B, &C);\n    if (!correct(C_data, N)) {\n        fprintf(stderr, \"matmul correctness check failed\\n\");\n        return 2;\n    }\n    double start = get_time();\n    for (int i = 0; i < 100; i++) {\n        _mlir_ciface_matmul_kernel(&A, &B, &C);\n    }\n    double end = get_time();\n    printf(\"%f\\n\", end - start);\n    free(A_data);\n    free(B_data);\n    free(C_data);\n    return 0;\n}\n"

# The transform script that tiles the matmul by a three-dimensional schedule.
function transform_of(tiles: string) -> string {
    return "  transform.named_sequence @__transform_main(%arg0: !transform.any_op {transform.readonly}) {\n    %matmul = transform.structured.match ops{[\"linalg.matmul\"]} in %arg0 : (!transform.any_op) -> !transform.any_op\n    %tiled_linalg_op, %loops:3 = transform.structured.tile_using_for %matmul tile_sizes [" + tiles + "] : (!transform.any_op) -> (!transform.any_op, !transform.any_op, !transform.any_op, !transform.any_op)\n    transform.yield\n  }\n}\n"
}

function strip_transform_script(s: string) -> string {
    let marker: i32 = s_find(s, "\n  transform.named_sequence", 0)
    if marker < 0 {
        return s
    }
    let close: i32 = s_find(s, "\n  }\n}\n", marker)
    if close < 0 {
        return s
    }
    return s_slice(s, 0, marker) + "\n}\n"
}

# The value after "NAME=" in `flow mlir-lower --tools` output, or "".
function tool_line(text: string, name: string) -> string {
    let lines: ptr<ProcStrs> = s_lines(text)
    let mut i: i32 = 0
    while i < sl_len(lines) {
        let l: string = sl_get(lines, i)
        if s_starts(l, name + "=") {
            return s_from(l, s_len(name) + 1)
        }
        i = i + 1
    }
    return ""
}

function bounded_int(s: string, hi: i32) -> i32 {
    let n: i32 = s_len(s)
    if n == 0 { return -1 }
    let mut value: i32 = 0
    let mut i: i32 = 0
    while i < n {
        let c: i32 = s[i] as i32
        if c < 48 or c > 57 { return -1 }
        let digit: i32 = c - 48
        if value > hi / 10 or (value == hi / 10 and digit > hi % 10) {
            return -1
        }
        value = value * 10 + digit
        i = i + 1
    }
    return value
}

function valid_candidate(s: string) -> bool {
    let fields: ptr<ProcStrs> = s_split(s, 44)
    let n: i32 = sl_len(fields)
    if n < 1 or n > 3 { return false }
    let mut i: i32 = 0
    while i < n {
        let field: string = sl_get(fields, i)
        let value: i32 = bounded_int(field, 4096)
        if value <= 0 or value > 4096 { return false }
        i = i + 1
    }
    return true
}

function candidate_space(spec: string) -> ptr<ProcStrs> {
    let candidates: ptr<ProcStrs> = s_split(spec, 59)
    let n: i32 = sl_len(candidates)
    if n < 1 or n > 16 { return null }
    let mut i: i32 = 0
    while i < n {
        if not valid_candidate(sl_get(candidates, i)) { return null }
        i = i + 1
    }
    return candidates
}

function valid_repetitions(s: string) -> bool {
    let n: i32 = bounded_int(s, 16)
    return n >= 1 and n <= 16
}

# Run `argv` with its output discarded; true on status 0.
function quiet_ok(argv: ptr<ProcStrs>) -> bool {
    let c: ptr<ProcCmd> = cmd(argv)
    cmd_quiet(c)
    return run(c) == 0
}

# Tile, lower, build and run with tile size `t`: the harness's runtime
# output, or "" when a step fails.
function evaluate(opt: string, translate: string, cc: string, work: string, candidate: string, tag: string) -> string {
    let d: string = work + "/t" + tag
    let _m: bool = mkdir_p(d)
    let _w: bool = write_text(d + "/in.mlir", s_slice(KERNEL, 0, s_len(KERNEL) - 2) + transform_of(candidate))
    let a: ptr<ProcStrs> = sl_of3(opt, "--mlir-print-op-on-diagnostic=false", "--pass-pipeline=builtin.module(transform-interpreter)")
    sl_push(a, d + "/in.mlir")
    sl_push2(a, "-o", d + "/tiled.mlir")
    if not quiet_ok(a) {
        return ""
    }
    let _strip: bool = write_text(d + "/tiled.mlir", strip_transform_script(read_text(d + "/tiled.mlir")))
    let b: ptr<ProcStrs> = sl_of1(opt)
    sl_extend(b, s_words("--convert-linalg-to-loops --memref-expand --expand-strided-metadata --lower-affine --convert-scf-to-cf --convert-vector-to-llvm --finalize-memref-to-llvm --convert-func-to-llvm --convert-index-to-llvm --convert-arith-to-llvm --convert-cf-to-llvm --reconcile-unrealized-casts"))
    sl_push(b, d + "/tiled.mlir")
    sl_push2(b, "-o", d + "/lowered.mlir")
    if not quiet_ok(b) {
        return ""
    }
    let c: ptr<ProcStrs> = sl_of3(translate, "--mlir-to-llvmir", d + "/lowered.mlir")
    sl_push2(c, "-o", d + "/llvm.ll")
    if not quiet_ok(c) {
        return ""
    }
    let e: ptr<ProcStrs> = sl_of3(cc, "-O3", "-Wno-override-module")
    sl_push2(e, d + "/llvm.ll", work + "/harness.c")
    sl_push2(e, "-o", d + "/bench")
    if not quiet_ok(e) {
        return ""
    }
    let rc: ptr<ProcCmd> = cmd(sl_of1(d + "/bench"))
    cmd_quiet_err(rc)
    return capture(rc)
}

# Run the compiled candidate under Linux perf. perf writes its CSV record to
# stderr, so merge it with the harness output and parse the named event below.
# A missing PMU permission or unsupported event returns an empty string and
# leaves the caller on the wall-time metric.
function evaluate_pmu(perf: string, event: string, bench: string) -> string {
    let c: ptr<ProcCmd> = proc_cmd(perf)
    proc_arg(c, "stat")
    proc_arg(c, "-x,")
    proc_arg(c, "-e")
    proc_arg(c, event)
    proc_arg(c, bench)
    proc_stderr(c, PROC_MERGE)
    let r: ptr<ProcResult> = proc_run(c)
    if r.exit_code != 0 {
        return ""
    }
    return r.stdout
}

function pmu_value(text: string, event: string) -> f64 {
    let lines: ptr<ProcStrs> = s_lines(text)
    let mut i: i32 = 0
    while i < sl_len(lines) {
        let line: string = sl_get(lines, i)
        if s_contains(line, "," + event + ",") {
            let fields: ptr<ProcStrs> = s_split(line, 44)
            if sl_len(fields) > 0 and not s_contains(sl_get(fields, 0), "<") {
                return bench_parse(sl_get(fields, 0))
            }
        }
        i = i + 1
    }
    return 0.0
}

function valid_pmu_event(s: string) -> bool {
    return s == "cycles" or s == "instructions" or s == "cache-misses" or
           s == "branches" or s == "branch-misses" or s == "ipc" or
           s == "stalled-cycles-frontend" or s == "stalled-cycles-backend"
}

function valid_search(s: string) -> bool {
    return s == "genetic" or s == "bayesian"
}

function valid_metric(s: string) -> bool {
    return s == "runtime" or s == "cost-model"
}

function valid_evals(s: string) -> bool {
    let n: i32 = bounded_int(s, 64)
    return n >= 1 and n <= 64
}

function valid_seed(s: string) -> bool {
    let n: i32 = bounded_int(s, 1000000)
    return n >= 1 and n <= 1000000
}

function valid_extent(s: string) -> bool {
    let n: i32 = bounded_int(s, 4096)
    return n >= 8 and n <= 4096
}

function valid_target(s: string) -> bool {
    return s == "cpu" or s == "gpu" or s == "nvptx" or s == "amdgpu"
}

function pmu_probe_events(event: string) -> string {
    if event == "ipc" {
        return "cycles,instructions"
    }
    return event
}

function pmu_metric(text: string, event: string) -> f64 {
    if event == "ipc" {
        let cy: f64 = pmu_value(text, "cycles")
        let ins: f64 = pmu_value(text, "instructions")
        if cy <= 0.0 or ins <= 0.0 {
            return 0.0
        }
        return cy / ins
    }
    return pmu_value(text, event)
}

function pmu_label(event: string, use_pmu: bool) -> string {
    if not use_pmu {
        return "runtime"
    }
    if event == "ipc" {
        return "cpi (1/ipc)"
    }
    return event
}

# Mean of `repetitions` compiled runs, or -1 when a step fails.
function measure_mean(opt: string, translate: string, cc: string, work: string, candidate: string, tag: string, repetitions: i32, use_pmu: bool, perf: string, pmu_event: string) -> f64 {
    let mut total: f64 = 0.0
    let mut measured: i32 = 0
    let mut repetition: i32 = 0
    while repetition < repetitions {
        let bench_tag: string = tag + "-" + s_itoa(repetition)
        let m: string = evaluate(opt, translate, cc, work, candidate, bench_tag)
        if s_len(m) == 0 {
            break
        }
        let mut metric: f64 = bench_parse(m)
        if use_pmu {
            let pmu: string = evaluate_pmu(perf, pmu_probe_events(pmu_event), work + "/t" + bench_tag + "/bench")
            let measured_pmu: f64 = pmu_metric(pmu, pmu_event)
            if s_len(pmu) == 0 or measured_pmu <= 0.0 {
                return -2.0
            }
            metric = measured_pmu
        }
        total = total + metric
        measured = measured + 1
        repetition = repetition + 1
    }
    if measured == 0 {
        return -1.0
    }
    return total / (measured as f64)
}

function main(argc: i32, argv: ptr<ptr<u8>>) -> i32 {
    let root: string = bench_root("benchmarks/micro/transform_tuning_benchmark.flow")
    let work: string = mktemp_dir(tmp_base() + "/flow-tune.XXXXXX")
    if s_len(work) == 0 {
        errln("transform_tuning_benchmark: cannot create a temporary directory")
        return 1
    }
    on_exit_remove(work)
    outln("Running transform dialect tuning benchmark...")
    let mut tiles: ptr<ProcStrs> = s_words("8,8,8 16,16,8 32,16,8 64,32,16")
    let mut repetitions: i32 = 3
    let mut pmu_event: string = ""
    let mut search: string = ""
    let mut metric_kind: string = "runtime"
    let mut evals: i32 = 8
    let mut seed: i32 = 1
    let mut extent: i32 = 128
    let mut target: string = "cpu"
    let mut i: i32 = 1
    while i < argc {
        let arg: string = argv[i] as string
        if s_starts(arg, "--candidates=") {
            let parsed: ptr<ProcStrs> = candidate_space(s_from(arg, 13))
            if parsed == null {
                errln("transform_tuning_benchmark: --candidates expects one to sixteen semicolon-separated positive schedules")
                return 2
            }
            tiles = parsed
        } elif arg == "--candidates" {
            errln("transform_tuning_benchmark: --candidates requires a value")
            return 2
        } elif s_starts(arg, "--repetitions=") {
            let spec: string = s_from(arg, 14)
            if not valid_repetitions(spec) {
                errln("transform_tuning_benchmark: --repetitions expects an integer from one to sixteen")
                return 2
            }
            repetitions = bounded_int(spec, 16)
        } elif arg == "--repetitions" {
            errln("transform_tuning_benchmark: --repetitions requires a value")
            return 2
        } elif s_starts(arg, "--pmu-event=") {
            pmu_event = s_from(arg, 12)
        } elif arg == "--pmu-event" {
            errln("transform_tuning_benchmark: --pmu-event requires a value")
            return 2
        } elif s_starts(arg, "--search=") {
            search = s_from(arg, 9)
        } elif arg == "--search" {
            errln("transform_tuning_benchmark: --search requires a value")
            return 2
        } elif s_starts(arg, "--metric=") {
            metric_kind = s_from(arg, 9)
        } elif arg == "--metric" {
            errln("transform_tuning_benchmark: --metric requires a value")
            return 2
        } elif s_starts(arg, "--evals=") {
            let spec: string = s_from(arg, 8)
            if not valid_evals(spec) {
                errln("transform_tuning_benchmark: --evals expects an integer from one to sixty-four")
                return 2
            }
            evals = bounded_int(spec, 64)
        } elif arg == "--evals" {
            errln("transform_tuning_benchmark: --evals requires a value")
            return 2
        } elif s_starts(arg, "--seed=") {
            let spec: string = s_from(arg, 7)
            if not valid_seed(spec) {
                errln("transform_tuning_benchmark: --seed expects an integer from one to 1000000")
                return 2
            }
            seed = bounded_int(spec, 1000000)
        } elif arg == "--seed" {
            errln("transform_tuning_benchmark: --seed requires a value")
            return 2
        } elif s_starts(arg, "--extent=") {
            let spec: string = s_from(arg, 9)
            if not valid_extent(spec) {
                errln("transform_tuning_benchmark: --extent expects an integer from eight to 4096")
                return 2
            }
            extent = bounded_int(spec, 4096)
        } elif arg == "--extent" {
            errln("transform_tuning_benchmark: --extent requires a value")
            return 2
        } elif s_starts(arg, "--target=") {
            target = s_from(arg, 9)
        } elif arg == "--target" {
            errln("transform_tuning_benchmark: --target requires a value")
            return 2
        }
        i = i + 1
    }
    if s_len(pmu_event) > 0 and not valid_pmu_event(pmu_event) {
        errln("transform_tuning_benchmark: --pmu-event must be one of 'cycles', 'instructions', 'cache-misses', 'branches', 'branch-misses', 'ipc', 'stalled-cycles-frontend', 'stalled-cycles-backend'")
        return 2
    }
    if s_len(search) > 0 and not valid_search(search) {
        errln("transform_tuning_benchmark: --search must be one of 'genetic', 'bayesian'")
        return 2
    }
    if not valid_metric(metric_kind) {
        errln("transform_tuning_benchmark: --metric must be one of 'runtime', 'cost-model'")
        return 2
    }
    if not valid_target(target) {
        errln("transform_tuning_benchmark: --target must be one of 'cpu', 'gpu', 'nvptx', 'amdgpu'")
        return 2
    }
    if metric_kind == "cost-model" and s_len(pmu_event) > 0 {
        errln("transform_tuning_benchmark: --metric=cost-model cannot be combined with --pmu-event")
        return 2
    }
    let use_cost: bool = metric_kind == "cost-model"
    let mut opt: string = ""
    let mut translate: string = ""
    let mut cc: string = ""
    let mut has_toolchain: bool = false
    if not use_cost {
        let tc: ptr<ProcCmd> = bench_flow(root, sl_of2("mlir-lower", "--tools"))
        cmd_quiet_err(tc)
        let tools_text: string = capture(tc)
        opt = tool_line(tools_text, "mlir-opt")
        translate = tool_line(tools_text, "mlir-translate")
        cc = which("clang")
        if s_len(cc) == 0 {
            cc = which("cc")
        }
        has_toolchain = s_len(opt) > 0 and s_len(translate) > 0 and s_len(cc) > 0
        let _k: bool = write_text(work + "/kernel.mlir", KERNEL)
        let _h: bool = write_text(work + "/harness.c", HARNESS)
    }
    let mut cost_oracle: bool = use_cost
    if s_len(search) > 0 and not use_cost and not has_toolchain {
        cost_oracle = true
    }
    let start: i64 = bench_epoch_s()
    let mut best: string = ""
    let mut best_metric: f64 = 0.0
    let mut search_n: i32 = 0
    let gpu: bool = tune_is_gpu_target(target)
    let perf: string = if s_len(pmu_event) > 0 { proc_which("perf") } else { "" }
    let mut use_pmu: bool = false
    if s_len(perf) > 0 and not cost_oracle {
        let probe: string = proc_which("true")
        if s_len(probe) > 0 {
            let probe_text: string = evaluate_pmu(perf, pmu_probe_events(pmu_event), probe)
            use_pmu = s_len(probe_text) > 0 and pmu_metric(probe_text, pmu_event) > 0.0
        }
    }
    let n: i32 = sl_len(tiles)
    if cost_oracle or has_toolchain {
        let tms: ptr<i32> = tune_i32s(n)
        let tns: ptr<i32> = tune_i32s(n)
        let tks: ptr<i32> = tune_i32s(n)
        let seen: ptr<i32> = tune_i32s(n)
        let costs: ptr<i32> = tune_i32s(n)
        let seedp: ptr<i32> = tune_i32s(1)
        seedp[0] = seed
        let mut k: i32 = 0
        while k < n {
            tms[k] = tune_tile_dim(sl_get(tiles, k), 0)
            tns[k] = tune_tile_dim(sl_get(tiles, k), 1)
            tks[k] = tune_tile_dim(sl_get(tiles, k), 2)
            seen[k] = 0
            costs[k] = 0
            k = k + 1
        }
        let mut pick: i32 = 0
        let pop: ptr<i32> = tune_i32s(4)
        let fit: ptr<i32> = tune_i32s(4)
        let mut pop_n: i32 = 0
        let mut genetic_init: bool = search == "genetic"
        while true {
            let mut idx: i32 = -1
            if s_len(search) == 0 {
                if pick >= n {
                    break
                }
                idx = pick
                pick = pick + 1
            } elif search == "bayesian" {
                if search_n >= evals {
                    break
                }
                idx = tune_bayesian_next(n, tms, tns, tks, seen, costs)
                if idx < 0 {
                    break
                }
            } else {
                if search_n >= evals {
                    break
                }
                if genetic_init {
                    if pop_n >= 4 or pop_n >= n or pop_n >= evals {
                        genetic_init = false
                    }
                }
                if genetic_init {
                    idx = tune_rng(seedp, n)
                    let mut tries: i32 = 0
                    while seen[idx] != 0 and tries < n {
                        idx = tune_rng(seedp, n)
                        tries = tries + 1
                    }
                    if seen[idx] != 0 {
                        idx = 0
                        while idx < n and seen[idx] != 0 {
                            idx = idx + 1
                        }
                        if idx >= n {
                            break
                        }
                    }
                } else {
                    idx = tune_genetic_child(n, tms, tns, tks, pop, pop_n, fit, seedp)
                    let mut tries2: i32 = 0
                    while seen[idx] != 0 and tries2 < 8 {
                        idx = tune_genetic_child(n, tms, tns, tks, pop, pop_n, fit, seedp)
                        tries2 = tries2 + 1
                    }
                    if seen[idx] != 0 {
                        idx = 0
                        while idx < n and seen[idx] != 0 {
                            idx = idx + 1
                        }
                        if idx >= n {
                            break
                        }
                    }
                }
            }
            if seen[idx] != 0 {
                break
            }
            let t: string = sl_get(tiles, idx)
            let mut v: f64 = 0.0
            if cost_oracle {
                v = tune_schedule_cost(t, extent, gpu) as f64
                outln("Evaluator cost-model score: " + bench_fixed(v, 4))
            } else {
                let m: f64 = measure_mean(opt, translate, cc, work, t, s_itoa(idx), repetitions, use_pmu, perf, pmu_event)
                if m == -2.0 {
                    errln("transform_tuning_benchmark: PMU measurement failed after a successful preflight; refusing to mix PMU counts with wall-time measurements")
                    return 1
                }
                if m < 0.0 {
                    seen[idx] = 1
                    continue
                }
                v = m
                if use_pmu {
                    outln("Evaluator mean " + pmu_label(pmu_event, true) + ": " + bench_fixed(v, 4) + " over " + s_itoa(repetitions) + " run(s)")
                } else {
                    outln("Evaluator mean runtime: " + bench_fixed(v, 4) + "s over " + s_itoa(repetitions) + " run(s)")
                }
            }
            let mut icost: i32 = v as i32
            if not cost_oracle {
                icost = (v * 1000000.0) as i32
                if icost <= 0 {
                    icost = 1
                }
            }
            seen[idx] = 1
            costs[idx] = icost
            search_n = search_n + 1
            if s_len(search) > 0 and search == "genetic" {
                if pop_n < 4 {
                    pop[pop_n] = idx
                    fit[pop_n] = icost
                    pop_n = pop_n + 1
                } else {
                    let mut worst: i32 = 0
                    let mut w: i32 = 1
                    while w < pop_n {
                        if fit[w] > fit[worst] {
                            worst = w
                        }
                        w = w + 1
                    }
                    if icost <= fit[worst] {
                        pop[worst] = idx
                        fit[worst] = icost
                    }
                }
            }
            if s_len(best) == 0 or v < best_metric {
                best = t
                best_metric = v
            }
        }
    } else {
        best = sl_get(tiles, 0)
    }
    let end: i64 = bench_epoch_s()
    outln("")
    outln("Benchmark Results:")
    outln("Evaluated tile schedules: [" + sl_join(tiles, ", ") + "]")
    if s_len(search) > 0 {
        outln("Search algorithm: " + search)
        outln("Search evaluations: " + s_itoa(search_n))
    }
    if use_cost {
        outln("Note: Analytic cost model selected the schedule without lowering.")
    } elif cost_oracle {
        outln("Note: Toolchain (mlir-opt, mlir-translate, clang) not fully available in VM.")
        outln("Reported tuning metric uses the analytic cost model.")
    } elif not has_toolchain {
        outln("Note: Toolchain (mlir-opt, mlir-translate, clang) not fully available in VM.")
        outln("Reported tuning metric is pending toolchain availability, but pipeline logic is successfully tested.")
    }
    if s_len(pmu_event) > 0 and not use_pmu and not cost_oracle {
        outln("Note: perf or the requested PMU event is unavailable; reported tuning metric uses wall time.")
    }
    if s_len(best) > 0 {
        outln("Successfully selected best tile schedule: " + best)
        if cost_oracle {
            outln("Best cost-model score: " + bench_fixed(best_metric, 6))
        } elif has_toolchain {
            if use_pmu {
                outln("Best " + pmu_label(pmu_event, true) + ": " + bench_fixed(best_metric, 6))
            } else {
                outln("Best runtime: " + bench_fixed(best_metric, 6) + "s")
            }
        } else {
            outln("Best simulated runtime: [Pending Toolchain]")
        }
    } else {
        outln("Tuning failed. All generated tile sizes failed to lower or execute.")
    }
    outln("Total meta-compilation time: " + s_itoa((end - start) as i32) + ".00s")
    cli_exit(0)
    return 0
}
