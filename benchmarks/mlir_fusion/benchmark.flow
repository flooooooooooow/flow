# @module benchmarks.mlir_fusion.benchmark
# @means  Loop fusion benchmark: matrix and stencil kernels optimized with
#         and without --loop-fusion at O3 to compare affine/linalg fusion
#         against un-fused scf.for.
#
#   ./flow tool benchmarks/mlir_fusion/benchmark.flow

import "tools/flow_cli/sys.flow"
import "benchmarks/bench_tools.flow"
import std.process { ProcCmd, ProcStrs }

const MATRIX_SCF_KERNEL: string = "
module {
  func.func @main() -> i32 {
    %c0 = arith.constant 0 : index
    %c100000 = arith.constant 100000 : index
    %c1 = arith.constant 1 : index
    
    %c1_f32 = arith.constant 1.0 : f32
    %c2_f32 = arith.constant 2.0 : f32
    
    %alloc_a = memref.alloc() : memref<100000xf32>
    %alloc_b = memref.alloc() : memref<100000xf32>
    %alloc_c = memref.alloc() : memref<100000xf32>
    
    scf.for %i = %c0 to %c100000 step %c1 {
      memref.store %c1_f32, %alloc_a[%i] : memref<100000xf32>
      memref.store %c2_f32, %alloc_b[%i] : memref<100000xf32>
    }
    
    scf.for %i = %c0 to %c100000 step %c1 {
      %v1 = memref.load %alloc_a[%i] : memref<100000xf32>
      %v2 = memref.load %alloc_b[%i] : memref<100000xf32>
      %v3 = arith.addf %v1, %v2 : f32
      %v4 = arith.mulf %v3, %c2_f32 : f32
      memref.store %v4, %alloc_c[%i] : memref<100000xf32>
    }
    
    %res_f32 = memref.load %alloc_c[%c0] : memref<100000xf32>
    %res = arith.fptosi %res_f32 : f32 to i32
    
    return %res : i32
  }
}
"

const MATRIX_AFFINE_KERNEL: string = "
module {
  func.func @main() -> i32 {
    %c1_f32 = arith.constant 1.0 : f32
    %c2_f32 = arith.constant 2.0 : f32
    
    %alloc_a = memref.alloc() : memref<100000xf32>
    %alloc_b = memref.alloc() : memref<100000xf32>
    %alloc_c = memref.alloc() : memref<100000xf32>
    
    affine.for %i = 0 to 100000 {
      affine.store %c1_f32, %alloc_a[%i] : memref<100000xf32>
      affine.store %c2_f32, %alloc_b[%i] : memref<100000xf32>
    }
    
    affine.for %i = 0 to 100000 {
      %v1 = affine.load %alloc_a[%i] : memref<100000xf32>
      %v2 = affine.load %alloc_b[%i] : memref<100000xf32>
      %v3 = arith.addf %v1, %v2 : f32
      %v4 = arith.mulf %v3, %c2_f32 : f32
      affine.store %v4, %alloc_c[%i] : memref<100000xf32>
    }
    
    %c0_idx = arith.constant 0 : index
    %res_f32 = affine.load %alloc_c[%c0_idx] : memref<100000xf32>
    %res = arith.fptosi %res_f32 : f32 to i32
    
    return %res : i32
  }
}
"

const STENCIL_SCF_KERNEL: string = "
module {
  func.func @main() -> i32 {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c100000 = arith.constant 100000 : index
    
    %c1_f32 = arith.constant 1.0 : f32
    %c2_f32 = arith.constant 2.0 : f32
    
    %alloc_a = memref.alloc() : memref<100000xf32>
    %alloc_b = memref.alloc() : memref<100000xf32>
    
    scf.for %i = %c0 to %c100000 step %c1 {
      memref.store %c1_f32, %alloc_a[%i] : memref<100000xf32>
    }
    
    %c1_iter = arith.constant 1 : index
    %c99999 = arith.constant 99999 : index
    
    scf.for %i = %c1_iter to %c99999 step %c1 {
      %im1 = arith.subi %i, %c1 : index
      %ip1 = arith.addi %i, %c1 : index
      
      %v1 = memref.load %alloc_a[%im1] : memref<100000xf32>
      %v2 = memref.load %alloc_a[%ip1] : memref<100000xf32>
      %v5 = memref.load %alloc_a[%i] : memref<100000xf32>
      
      %s1 = arith.addf %v1, %v2 : f32
      %s2 = arith.addf %s1, %v5 : f32
      %s3 = arith.mulf %s2, %c2_f32 : f32
      memref.store %s3, %alloc_b[%i] : memref<100000xf32>
    }
    
    %res_f32 = memref.load %alloc_b[%c1] : memref<100000xf32>
    %res = arith.fptosi %res_f32 : f32 to i32
    
    return %res : i32
  }
}
"

const STENCIL_AFFINE_KERNEL: string = "
module {
  func.func @main() -> i32 {
    %c1_f32 = arith.constant 1.0 : f32
    %c2_f32 = arith.constant 2.0 : f32
    
    %alloc_a = memref.alloc() : memref<100000xf32>
    %alloc_b = memref.alloc() : memref<100000xf32>
    
    affine.for %i = 0 to 100000 {
      affine.store %c1_f32, %alloc_a[%i] : memref<100000xf32>
    }
    
    affine.for %i = 1 to 99999 {
      %v1 = affine.load %alloc_a[%i - 1] : memref<100000xf32>
      %v2 = affine.load %alloc_a[%i + 1] : memref<100000xf32>
      %v5 = affine.load %alloc_a[%i] : memref<100000xf32>
      
      %s1 = arith.addf %v1, %v2 : f32
      %s2 = arith.addf %s1, %v5 : f32
      %s3 = arith.mulf %s2, %c2_f32 : f32
      affine.store %s3, %alloc_b[%i] : memref<100000xf32>
    }
    
    %c1 = arith.constant 1 : index
    %res_f32 = affine.load %alloc_b[%c1] : memref<100000xf32>
    %res = arith.fptosi %res_f32 : f32 to i32
    
    return %res : i32
  }
}
"

const MATRIX_EXPECTED: i32 = 6
const STENCIL_EXPECTED: i32 = 6

struct Outcome {
    ok: bool,
    res: i32,
    ms: string
}

function measure(root: string, work: string, tag: string, expected: i32, kernel: string, flags: ptr<ProcStrs>, is_affine: bool) -> Outcome {
    let failed: Outcome = Outcome { ok: false, res: 0, ms: "" }
    let _k: bool = write_text(work + "/in_" + tag + ".mlir", kernel)
    
    let o: ptr<ProcStrs> = sl_of3("mlir-optimize", "--opt-level", "O3")
    sl_push(o, "--enable-affine-tiling")
    sl_push(o, "--affine-tile-size=128")
    sl_extend(o, flags)
    sl_push2(o, work + "/in_" + tag + ".mlir", work + "/" + tag + ".mlir")
    if run(bench_flow(root, o)) != 0 {
        return failed
    }
    
    let mut input_to_lower: string = work + "/" + tag + ".mlir"
    
    if is_affine {
        let affine_lower: ptr<ProcStrs> = sl_of3("mlir-opt", "--lower-affine", work + "/" + tag + ".mlir")
        sl_push2(affine_lower, "-o", work + "/" + tag + "_lowered.mlir")
        if run_argv(affine_lower) != 0 {
            return failed
        }
        input_to_lower = work + "/" + tag + "_lowered.mlir"
    }
    
    if run(bench_flow(root, sl_of3("mlir-lower", input_to_lower, work + "/" + tag + ".ll"))) != 0 {
        return failed
    }
    let c: ptr<ProcStrs> = sl_of3("clang", "-O2", "-Wno-override-module")
    sl_push2(c, work + "/" + tag + ".ll", "-o")
    sl_push2(c, work + "/" + tag, "-lm")
    if run_argv(c) != 0 {
        return failed
    }
    let mut best: string = ""
    let mut res: i32 = 0
    let mut k: i32 = 0
    while k < 3 {
        let t0: f64 = bench_now_ms()
        let mut j: i32 = 0
        while j < 5 {
            res = run_argv(sl_of1(work + "/" + tag))
            j = j + 1
        }
        let t1: f64 = bench_now_ms()
        let dt: string = bench_fixed((t1 - t0) / 5.0, 3)
        if s_len(best) == 0 or bench_parse(dt) < bench_parse(best) {
            best = dt
        }
        k = k + 1
    }
    if res != expected {
        errln("mlir_fusion: " + tag + " returned " + s_itoa(res) + ", expected " + s_itoa(expected))
        return failed
    }
    return Outcome { ok: true, res: res, ms: best }
}

function run_benchmark(root: string, here: string, work: string, name: string, kernel_scf: string, kernel_affine: string, expected: i32) -> string {
    outln("Running " + name + " scf.for...")
    let scf: Outcome = measure(root, work, name + "_scf", expected, kernel_scf, sl_new(), false)
    if not scf.ok {
        cli_exit(1)
    }
    let time_scf: f64 = bench_parse(scf.ms)
    outln("Result: " + s_itoa(scf.res) + ", Time: " + bench_fixed(time_scf, 2) + " ms")
    
    outln("")
    outln("Running " + name + " affine without fusion...")
    let base: Outcome = measure(root, work, name + "_base", expected, kernel_affine, sl_of1("--no-loop-fusion"), true)
    if not base.ok {
        cli_exit(1)
    }
    let time_base: f64 = bench_parse(base.ms)
    outln("Result: " + s_itoa(base.res) + ", Time: " + bench_fixed(time_base, 2) + " ms")
    
    outln("")
    outln("Running " + name + " affine with fusion...")
    let fused: Outcome = measure(root, work, name + "_fused", expected, kernel_affine, sl_of1("--loop-fusion"), true)
    if not fused.ok {
        cli_exit(1)
    }
    let time_fused: f64 = bench_parse(fused.ms)
    outln("Result: " + s_itoa(fused.res) + ", Time: " + bench_fixed(time_fused, 2) + " ms")
    
    let diff: string = bench_fixed(time_scf - time_fused, 2)
    let pct: string = bench_fixed((time_scf - time_fused) / time_scf * 100.0, 2)
    outln("")
    outln("Speedup over scf: " + pct + "% (" + diff + " ms)")
    outln("")
    
    return name + ":\n  scf.for: " + bench_fixed(time_scf, 2) + " ms\n  affine (no fusion): " + bench_fixed(time_base, 2) + " ms\n  affine (fused): " + bench_fixed(time_fused, 2) + " ms\n  Speedup (fused vs scf): " + pct + "%\n"
}

function main() -> i32 {
    let root: string = bench_root("benchmarks/mlir_fusion/benchmark.flow")
    let here: string = root + "/benchmarks/mlir_fusion"
    let work: string = mktemp_dir(tmp_base() + "/flow-fusion.XXXXXX")
    if s_len(work) == 0 {
        errln("mlir_fusion: cannot create a temporary directory")
        return 1
    }
    on_exit_remove(work)
    
    let mut report: string = "MLIR Fusion Benchmark (Affine vs scf.for)\n\n"
    
    report = report + run_benchmark(root, here, work, "matrix", MATRIX_SCF_KERNEL, MATRIX_AFFINE_KERNEL, MATRIX_EXPECTED)
    report = report + "\n"
    report = report + run_benchmark(root, here, work, "stencil", STENCIL_SCF_KERNEL, STENCIL_AFFINE_KERNEL, STENCIL_EXPECTED)

    let _r: bool = write_text(here + "/benchmark_report.txt", report)
    cli_exit(0)
    return 0
}
