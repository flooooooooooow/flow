import "stdlib/math.flow"
import "stdlib/memory.flow"

export function main() -> i32 {
    let size: i32 = 10000000
    let a: ptr<f32> = alloc_f32(size)
    let b: ptr<f32> = alloc_f32(size)
    let out: ptr<f32> = alloc_f32(size)
    
    let mut i: i32 = 0
    while i < size {
        a[i] = (i as f32) * 0.001
        b[i] = 1.0 - (i as f32) * 0.001
        i = i + 1
    }
    
    let gamma: f32 = 0.5
    
    for j in 0 to size step 1 {
        let diff: f32 = a[j] - b[j]
        out[j] = exp(-gamma * diff * diff)
    }
    
    # Just to make sure logic operates
    let mid_val: f32 = out[size/2]
    if mid_val < 0.0 or mid_val > 1.0 {
        return 1
    }
    
    return 0
}
