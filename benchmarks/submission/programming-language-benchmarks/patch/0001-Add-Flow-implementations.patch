From 1129a7501ae3e6007a3d5eb85f45b444ae6c3411 Mon Sep 17 00:00:00 2001
From: Flow Contributors <flow@example.com>
Date: Sat, 3 Oct 2026 13:40:08 +0000
Subject: [PATCH] Add Flow implementations

---
 bench                |  9 +++++++++
 minimal/minimal.flow |  3 +++
 record/record.flow   | 25 +++++++++++++++++++++++++
 3 files changed, 37 insertions(+)
 create mode 100644 minimal/minimal.flow
 create mode 100644 record/record.flow

diff --git a/bench b/bench
index dd60553..a3144b1 100755
--- a/bench
+++ b/bench
@@ -208,6 +208,15 @@ do
         run_benchmark "./${file}" "zig            "
     fi

+    # Flow
+    if [ -f ${file}.flow ] \
+    && command -v flow > /dev/null \
+    && should_run_language "flow"
+    then
+        FLOW_BUILD_ROOT=$PWD flow compile ${file}.flow > /dev/null 2>&1
+        run_benchmark "./${file}" "flow           "
+    fi
+
     # Rust
     if [ -f ${file}.rs ] \
     && command -v rustc > /dev/null \
diff --git a/minimal/minimal.flow b/minimal/minimal.flow
new file mode 100644
index 0000000..53922fc
--- /dev/null
+++ b/minimal/minimal.flow
@@ -0,0 +1,3 @@
+function main() -> i32 {
+    return 0
+}
diff --git a/record/record.flow b/record/record.flow
new file mode 100644
index 0000000..55144da
--- /dev/null
+++ b/record/record.flow
@@ -0,0 +1,25 @@
+# Match record/record.c: allocate NRECORDS structs, fill, free.
+extern {
+    function malloc(size: i64) -> ptr<void>
+    function free(p: ptr<void>) -> void
+}
+
+const NRECORDS: i64 = 8388608
+
+struct record {
+    id: i32
+}
+
+function main() -> i32 {
+    let records: ptr<record> = malloc(NRECORDS * 4) as ptr<record>
+    if records == null {
+        return 1
+    }
+    let mut i: i64 = 0
+    while i < NRECORDS {
+        records[i].id = i as i32
+        i = i + 1
+    }
+    free(records as ptr<void>)
+    return 0
+}
+--
+2.53.0
