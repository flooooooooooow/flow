# @module benchmarks.mlir_pipelining.benchmark
# @means  Software pipelining and multi-buffering: optimize a memory-bound
#         MLIR loop at O3 with and without --enable-loop-pipelining
#         --enable-multi-buffering (`flow mlir-optimize`; loop fusion on, as
#         the retired mlir_optimizer.py command line had it), lower, build,
#         and time five runs three times. Writes
#         benchmarks/mlir_pipelining/benchmark_report.txt.
#
#   ./flow tool benchmarks/mlir_pipelining/benchmark.flow

import "tools/flow_cli/sys.flow"
import "benchmarks/bench_tools.flow"
import std.process { ProcCmd, ProcStrs }

const KERNEL: string = "module {\n  func.func @main() -> i32 {\n    %c0 = arith.constant 0 : index\n    %c10000000 = arith.constant 10000000 : index\n    %c1 = arith.constant 1 : index\n\n    %c0_i32 = arith.constant 0 : i32\n    %c1_i32 = arith.constant 1 : i32\n    %c2_i32 = arith.constant 2 : i32\n    %c3_i32 = arith.constant 3 : i32\n\n    %alloc_a = memref.alloc() : memref<10000000xi32>\n    %alloc_b = memref.alloc() : memref<10000000xi32>\n    %alloc_c = memref.alloc() : memref<10000000xi32>\n\n    scf.for %iv = %c0 to %c10000000 step %c1 {\n       memref.store %c1_i32, %alloc_a[%iv] : memref<10000000xi32>\n       memref.store %c2_i32, %alloc_b[%iv] : memref<10000000xi32>\n    }\n\n    scf.for %iv = %c0 to %c10000000 step %c1 {\n      %v1 = memref.load %alloc_a[%iv] : memref<10000000xi32>\n      %v2 = memref.load %alloc_b[%iv] : memref<10000000xi32>\n      %v3 = arith.muli %v1, %c2_i32 : i32\n      %v4 = arith.addi %v3, %v2 : i32\n      %v5 = arith.muli %v4, %c3_i32 : i32\n      memref.store %v5, %alloc_c[%iv] : memref<10000000xi32>\n    }\n\n    %res = memref.load %alloc_c[%c0] : memref<10000000xi32>\n    return %res : i32\n  }\n}\n"

# One configuration's outcome: the program's exit status and its best
# per-run time in milliseconds (as printed, three decimals).
struct Outcome {
    ok: bool,
    res: i32,
    ms: string
}

# Optimize with `flags`, lower, build, then time five runs three times.
function measure(root: string, work: string, tag: string, flags: ptr<ProcStrs>) -> Outcome {
    let failed: Outcome = Outcome { ok: false, res: 0, ms: "" }
    let o: ptr<ProcStrs> = sl_of3("mlir-optimize", "--opt-level", "O3")
    sl_push(o, "--loop-fusion")
    sl_extend(o, flags)
    sl_push2(o, work + "/in.mlir", work + "/" + tag + ".mlir")
    if run(bench_flow(root, o)) != 0 {
        return failed
    }
    if run(bench_flow(root, sl_of3("mlir-lower", work + "/" + tag + ".mlir", work + "/" + tag + ".ll"))) != 0 {
        return failed
    }
    let c: ptr<ProcStrs> = sl_of3("clang", "-O2", "-Wno-override-module")
    sl_push2(c, work + "/" + tag + ".ll", "-o")
    sl_push2(c, work + "/" + tag, "-lm")
    if run_argv(c) != 0 {
        return failed
    }
    let mut best: string = ""
    let mut res: i32 = 0
    let mut k: i32 = 0
    while k < 3 {
        let t0: f64 = bench_now_ms()
        let mut j: i32 = 0
        while j < 5 {
            res = run_argv(sl_of1(work + "/" + tag))
            j = j + 1
        }
        let t1: f64 = bench_now_ms()
        let dt: string = bench_fixed((t1 - t0) / 5.0, 3)
        if s_len(best) == 0 or bench_parse(dt) < bench_parse(best) {
            best = dt
        }
        k = k + 1
    }
    return Outcome { ok: true, res: res, ms: best }
}

function main() -> i32 {
    let root: string = bench_root("benchmarks/mlir_pipelining/benchmark.flow")
    let here: string = root + "/benchmarks/mlir_pipelining"
    let work: string = mktemp_dir(tmp_base() + "/flow-pipelining.XXXXXX")
    if s_len(work) == 0 {
        errln("mlir_pipelining: cannot create a temporary directory")
        return 1
    }
    on_exit_remove(work)
    let _k: bool = write_text(work + "/in.mlir", KERNEL)
    outln("Running without pipelining...")
    let base: Outcome = measure(root, work, "base", sl_new())
    if not base.ok {
        cli_exit(1)
    }
    let time_base: f64 = bench_parse(base.ms)
    outln("Result: " + s_itoa(base.res) + ", Time: " + bench_fixed(time_base, 2) + " ms")
    outln("")
    outln("Running with pipelining...")
    let pipe: Outcome = measure(root, work, "pipe", sl_of2("--enable-loop-pipelining", "--enable-multi-buffering"))
    if not pipe.ok {
        cli_exit(1)
    }
    let time_pipe: f64 = bench_parse(pipe.ms)
    outln("Result: " + s_itoa(pipe.res) + ", Time: " + bench_fixed(time_pipe, 2) + " ms")
    let diff: string = bench_fixed(time_base - time_pipe, 2)
    let pct: string = bench_fixed((time_base - time_pipe) / time_base * 100.0, 2)
    outln("")
    outln("Speedup: " + pct + "% (" + diff + " ms)")
    let mut reasoning: string = ""
    if bench_parse(pct) < 5.0 {
        reasoning = " (Note: software pipelining and multi-buffering gain little here. Out-of-order CPUs already overlap the memory latency this loop exposes. MLIR's scf pipelining transform mostly targets statically scheduled hardware: spatial architectures, VLIW and DSPs.)"
    }
    let report: string = "MLIR Pipelining Benchmark\nBaseline: " + bench_fixed(time_base, 2) + " ms\nPipelined: " + bench_fixed(time_pipe, 2) + " ms\nSpeedup: " + pct + "%" + reasoning + "\n"
    let _r: bool = write_text(here + "/benchmark_report.txt", report)
    cli_exit(0)
    return 0
}
