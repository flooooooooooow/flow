function main() -> i32 {
    let mut arr1: [i32; 100] = [0; 100];
    let mut arr2: [i32; 100] = [1; 100];
    let mut arr3: [i32; 100] = [2; 100];

    # Loop 1
    for i in 0..100 {
        arr1[i] = arr2[i] + arr3[i];
    }

    # Loop 2
    for i in 0..100 {
        arr2[i] = arr1[i] + arr3[i];
    }

    return arr2[50];
}
