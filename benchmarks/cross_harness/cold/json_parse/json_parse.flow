# Genuine JSON document parsing, object/array traversal and strict
# integer validation. This is NOT the substring scanner in json_key_scan.
# Matched against Python json.loads on an identical document (#747).

import "scripts/tools/lib/json.flow"

function main() -> i32 {
    let payload: string = "{\"records\": [{\"id\": 10, \"count\": 250}, {\"id\": 20, \"count\": 350}, {\"id\": 30, \"count\": 450}, {\"id\": 40, \"count\": 550}]}"
    let mut total: i64 = 0
    let mut iteration: i32 = 0
    while iteration < 1000 {
        let doc: ptr<Json> = json_parse(payload)
        if json_error(doc) != "" {
            json_free(doc)
            return 1
        }
        let records: i32 = json_get(doc, 0, "records")
        if records < 0 or json_kind(doc, records) != json_kind_array() {
            json_free(doc)
            return 2
        }
        let mut item: i32 = json_first(doc, records)
        let mut count: i32 = 0
        let mut subtotal: i64 = 0
        while item >= 0 {
            if json_kind(doc, item) != json_kind_object() {
                json_free(doc)
                return 3
            }
            let field: i32 = json_get(doc, item, "count")
            if field < 0 or not json_is_int(doc, field) {
                json_free(doc)
                return 4
            }
            subtotal = subtotal + json_int(doc, field)
            count = count + 1
            item = json_next(doc, item)
        }
        json_free(doc)
        if count != 4 or subtotal != 1600 {
            return 5
        }
        total = total + subtotal
        iteration = iteration + 1
    }
    if total != 1600000 {
        return 6
    }
    # Malformed JSON must be rejected, not mined for incidental digits.
    let invalid: ptr<Json> = json_parse("{\"records\":[")
    let accepted: bool = json_error(invalid) == ""
    json_free(invalid)
    if accepted {
        return 7
    }
    return 0
}
