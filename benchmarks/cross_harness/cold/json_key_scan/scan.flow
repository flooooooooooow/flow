# Fast key substring scan, NOT a JSON parser. The full document
# grammar-validation benchmark is cold/json_parse (#747).
extern {
    function strlen(s: string) -> i64
}

function parse_nth_int_after_key(json_str: string, key: string, target_occ: i32) -> i32 {
    let p_json: ptr<u8> = json_str as ptr<u8>
    let p_key: ptr<u8> = key as ptr<u8>
    let json_len: i64 = strlen(json_str)
    let key_len: i64 = strlen(key)

    let mut occ: i32 = 0
    let mut i: i64 = 0
    while i + key_len < json_len {
        let mut match_key: bool = true
        let mut k: i64 = 0
        while k < key_len {
            if p_json[i + k] != p_key[k] {
                match_key = false
            }
            k = k + 1
        }

        if match_key {
            occ = occ + 1
            if occ == target_occ {
                let mut j: i64 = i + key_len
                while j < json_len and (p_json[j] < 48 as u8 or p_json[j] > 57 as u8) {
                    j = j + 1
                }
                let mut val: i32 = 0
                while j < json_len and p_json[j] >= 48 as u8 and p_json[j] <= 57 as u8 {
                    val = val * 10 + (p_json[j] as i32 - 48)
                    j = j + 1
                }
                return val
            }
        }
        i = i + 1
    }
    return 0
}

function main() -> i32 {
    let json_data: string = "{\"records\": [{\"id\": 10, \"count\": 250}, {\"id\": 20, \"count\": 350}, {\"id\": 30, \"count\": 450}, {\"id\": 40, \"count\": 550}]}"
    let key: string = "\"count\":"

    let mut total_count: i32 = 0
    let mut iter: i32 = 0
    while iter < 10000 {
        let c1: i32 = parse_nth_int_after_key(json_data, key, 1)
        let c2: i32 = parse_nth_int_after_key(json_data, key, 2)
        let c3: i32 = parse_nth_int_after_key(json_data, key, 3)
        let c4: i32 = parse_nth_int_after_key(json_data, key, 4)
        total_count = total_count + c1 + c2 + c3 + c4
        iter = iter + 1
    }

    if total_count != 16000000 {
        return 1
    }
    return 0
}
