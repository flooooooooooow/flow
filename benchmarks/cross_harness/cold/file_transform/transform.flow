extern {
    function fopen(path: string, mode: string) -> ptr<void>
    function fclose(f: ptr<void>) -> i32
    function fputs(s: string, f: ptr<void>) -> i32
    function fgetc(f: ptr<void>) -> i32
    function fputc(c: i32, f: ptr<void>) -> i32
    function remove(path: string) -> i32
}

function main() -> i32 {
    let in_path: string = "/tmp/flow_file_transform_in.txt"
    let out_path: string = "/tmp/flow_file_transform_out.txt"

    let f_in: ptr<void> = fopen(in_path, "w")
    if f_in == null {
        return 1
    }

    let mut line: i32 = 0
    while line < 200 {
        fputs("key_", f_in)
        let d1: i32 = 48 + (line / 100) % 10
        let d2: i32 = 48 + (line / 10) % 10
        let d3: i32 = 48 + line % 10
        fputc(d1, f_in)
        fputc(d2, f_in)
        fputc(d3, f_in)
        fputs("=value_data_payload_string_line_\n", f_in)
        line = line + 1
    }
    fclose(f_in)

    let f_read: ptr<void> = fopen(in_path, "r")
    let f_out: ptr<void> = fopen(out_path, "w")
    if f_read == null or f_out == null {
        return 2
    }

    let mut ch: i32 = fgetc(f_read)
    let mut total_bytes: i32 = 0
    while ch != -1 {
        let mut out_ch: i32 = ch
        if ch >= 97 and ch <= 122 {
            out_ch = ch - 32
        }
        fputc(out_ch, f_out)
        total_bytes = total_bytes + 1
        ch = fgetc(f_read)
    }

    fclose(f_read)
    fclose(f_out)

    remove(in_path)
    remove(out_path)

    if total_bytes <= 0 {
        return 3
    }

    return 0
}
