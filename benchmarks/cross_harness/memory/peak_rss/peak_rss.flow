# Touch a live 4 MiB heap so peak RSS and peak live heap are visible
# to the #740 profiler and to /usr/bin/time.

extern {
    function malloc(size: i64) -> ptr<u8>
    function free(p: ptr<u8>) -> void
}

function main() -> i32 {
    let n: i64 = 4194304
    let p: ptr<u8> = malloc(n)
    if p == null {
        return 1
    }
    let mut i: i64 = 0
    while i < n {
        p[i] = (i % 251) as u8
        i = i + 4096
    }
    let v: i32 = p[0] as i32
    free(p)
    if v != 0 {
        return 1
    }
    return 0
}
