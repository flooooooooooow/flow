# Allocate, copy, and free. #740 records heap count/bytes, peak live,
# and memcpy volume without a source-level counter.

extern {
    function malloc(size: i64) -> ptr<u8>
    function free(p: ptr<u8>) -> void
    function memcpy(dst: ptr<u8>, src: ptr<u8>, n: i64) -> ptr<u8>
}

function main() -> i32 {
    let mut i: i32 = 0
    let mut sum: i32 = 0
    while i < 256 {
        let src: ptr<u8> = malloc(1024)
        let dst: ptr<u8> = malloc(1024)
        if src == null or dst == null {
            return 1
        }
        src[0] = (i % 251) as u8
        src[1023] = 7 as u8
        let _c: ptr<u8> = memcpy(dst, src, 1024)
        sum = sum + (dst[0] as i32) + (dst[1023] as i32)
        free(dst)
        free(src)
        i = i + 1
    }
    if sum < 0 {
        return 1
    }
    println("allocations: 512")
    println("copies: 262144")
    return 0
}
