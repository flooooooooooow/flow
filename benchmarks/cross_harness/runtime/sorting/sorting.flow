# In-place heapsort plus binary search (#745).
# Same O(n log n) sort and O(log n) probes as the native and Python twins.

extern {
    function malloc(size: i64) -> ptr<i32>
    function free(p: ptr<i32>) -> void
}

function sift_down(xs: ptr<i32>, start: i32, n: i32) {
    let mut root: i32 = start
    while true {
        let left: i32 = root * 2 + 1
        if left >= n {
            return
        }
        let mut cand: i32 = root
        if xs[cand] < xs[left] {
            cand = left
        }
        let right: i32 = left + 1
        if right < n {
            if xs[cand] < xs[right] {
                cand = right
            }
        }
        if cand == root {
            return
        }
        let tmp: i32 = xs[root]
        xs[root] = xs[cand]
        xs[cand] = tmp
        root = cand
    }
}

function heap_sort(xs: ptr<i32>, n: i32) {
    let mut start: i32 = n / 2 - 1
    while start >= 0 {
        sift_down(xs, start, n)
        start = start - 1
    }
    let mut end: i32 = n - 1
    while end > 0 {
        let tmp: i32 = xs[0]
        xs[0] = xs[end]
        xs[end] = tmp
        sift_down(xs, 0, end)
        end = end - 1
    }
}

function binary_search(xs: ptr<i32>, n: i32, key: i32) -> i32 {
    let mut lo: i32 = 0
    let mut hi: i32 = n
    while lo < hi {
        let mid: i32 = lo + (hi - lo) / 2
        let v: i32 = xs[mid]
        if v == key {
            return mid
        }
        if v < key {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return 0 - 1
}

function main() -> i32 {
    let n: i32 = 4096
    let xs: ptr<i32> = malloc((n as i64) * 4)
    if xs == null {
        return 1
    }
    let mut i: i32 = 0
    while i < n {
        xs[i] = (((i as i64) * 1103515245 + 12345) % 100000) as i32
        i = i + 1
    }
    let k0: i32 = xs[0]
    let k1: i32 = xs[n / 2]
    let k2: i32 = xs[n - 1]
    heap_sort(xs, n)
    let mut checksum: i32 = 0
    i = 0
    while i < n {
        checksum = checksum + xs[i]
        i = i + 1
    }
    if binary_search(xs, n, k0) < 0 {
        free(xs)
        return 2
    }
    if binary_search(xs, n, k1) < 0 {
        free(xs)
        return 3
    }
    if binary_search(xs, n, k2) < 0 {
        free(xs)
        return 4
    }
    i = 1
    while i < n {
        if xs[i - 1] > xs[i] {
            free(xs)
            return 5
        }
        i = i + 1
    }
    free(xs)
    if checksum != 204872320 {
        return 6
    }
    return 0
}
