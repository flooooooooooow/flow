import "time.flow"

function main() -> i32 {
    let start: f64 = get_time()
    
    # Simple arithmetic benchmark
    let result: f64 = 0.0
    for i in 0..1000000 {
        result = result + 1.0
    }
    
    let end: f64 = get_time()
    
    print("Simple Arithmetic Benchmark:")
    print(end - start)
    print("Result:")
    print(result)
    
    return 0
}
