# @module benchmarks.bench_tools
# @means  Shared helpers for the benchmark runners under benchmarks/: the
#         repository root, wall clocks, and number parsing and formatting.
#
# The runners are Flow programs started with `./flow tool PATH.flow`, which
# sets FLOW_REPO_ROOT. Processes, files and strings come from
# tools/flow_cli/sys.flow. The C below formats with snprintf, so a number
# prints exactly as printf(1) and awk printed it in the shell runners.

@cEmbed("#include <stdio.h>
#include <stdlib.h>
#include <time.h>
static const char bench_fmt_f[] = {'%', '.', '*', 'f', 0};
static const char bench_fmt_date[] = {'%', 'Y', '-', '%', 'm', '-', '%', 'd', 0};
static const char *bench_fixed_c(double v, int32_t decimals) {
  char *b = (char *)malloc(64);
  snprintf(b, 64, bench_fmt_f, (int)decimals, v);
  return b;
}
static double bench_parse_c(const char *s) { return strtod(s, 0); }
static int64_t bench_now_us_c(void) {
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (int64_t)ts.tv_sec * 1000000 + (int64_t)(ts.tv_nsec / 1000);
}
static int64_t bench_epoch_s_c(void) { return (int64_t)time(0); }
static const char *bench_utc_date_c(void) {
  char *b = (char *)malloc(32);
  time_t t = time(0);
  struct tm tmv;
  gmtime_r(&t, &tmv);
  strftime(b, 32, bench_fmt_date, &tmv);
  return b;
}
")

import "tools/flow_cli/sys.flow"
import std.process { ProcCmd, ProcStrs, proc_argv }

extern {
    function bench_fixed_c(v: f64, decimals: i32) -> string
    function bench_parse_c(s: string) -> f64
    function bench_now_us_c() -> i64
    function bench_epoch_s_c() -> i64
    function bench_utc_date_c() -> string
}

# The repository root from `./flow tool`. Run any other way, the program
# says how to start it and stops with status 2. The corpus gates build and
# run every program with a main, and they inherit FLOW_REPO_ROOT from their
# own `./flow tool` start, so the variable alone is not enough: the binary
# must also be the one `./flow tool` cached under build/flow-tools.
export function bench_root(program: string) -> string {
    let r: string = env("FLOW_REPO_ROOT")
    if s_len(r) == 0 or not s_contains(proc_argv(0), "/build/flow-tools/") {
        errln("usage: ./flow tool " + program + " [args...]")
        cli_exit(2)
    }
    return r
}

# printf "%.Nf"
export function bench_fixed(v: f64, decimals: i32) -> string {
    return bench_fixed_c(v, decimals)
}

# The leading number of `s` (strtod), 0 when there is none.
export function bench_parse(s: string) -> f64 {
    return bench_parse_c(s)
}

# Microseconds on a monotonic clock.
export function bench_now_us() -> i64 {
    return bench_now_us_c()
}

# Milliseconds on a monotonic clock, with the fraction.
export function bench_now_ms() -> f64 {
    return (bench_now_us_c() as f64) / 1000.0
}

# `date +%s`
export function bench_epoch_s() -> i64 {
    return bench_epoch_s_c()
}

# `date -u +%Y-%m-%d`
export function bench_utc_date() -> string {
    return bench_utc_date_c()
}

# The number of lines of `text` containing `needle` (`grep -c`).
export function bench_count_lines(text: string, needle: string) -> i32 {
    let lines: ptr<ProcStrs> = s_lines(text)
    let mut n: i32 = 0
    let mut i: i32 = 0
    while i < sl_len(lines) {
        if s_contains(sl_get(lines, i), needle) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

# The lines of a file (`wc -l`): its newline count.
export function bench_wc_l(path: string) -> i32 {
    let text: string = read_text(path)
    let mut n: i32 = 0
    let mut i: i32 = 0
    while i < s_len(text) {
        if s_byte(text, i) == 10 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

# `./flow ARGS...` from the repository root, as a command to run.
export function bench_flow(root: string, args: ptr<ProcStrs>) -> ptr<ProcCmd> {
    let argv: ptr<ProcStrs> = sl_of1(root + "/flow")
    sl_extend(argv, args)
    return cmd(argv)
}
