# @module benchmarks.gpu.gpu_microbenchmark
# @means  Build and run the GPU microbenchmarks (gpu_microbenchmark.c)
#         against the Flow GPU runtime: runtime/gpu_metal.m on macOS, the
#         simulated figures elsewhere.
#
#   ./flow tool benchmarks/gpu/gpu_microbenchmark.flow
#
# CC picks the compiler (default clang).

import "tools/flow_cli/sys.flow"
import "benchmarks/bench_tools.flow"
import std.process { ProcCmd, ProcStrs }

function main() -> i32 {
    let root: string = bench_root("benchmarks/gpu/gpu_microbenchmark.flow")
    let here: string = root + "/benchmarks/gpu"
    let work: string = mktemp_dir(tmp_base() + "/flow-gpu-bench.XXXXXX")
    if s_len(work) == 0 {
        errln("gpu_microbenchmark: cannot create a temporary directory")
        return 1
    }
    on_exit_remove(work)
    let a: ptr<ProcStrs> = sl_of2(env_or("CC", "clang"), "-O2")
    if s_eq(uname_s(), "Darwin") {
        sl_push2(a, "-fobjc-arc", "-I" + root + "/runtime")
        sl_push2(a, here + "/gpu_microbenchmark.c", root + "/runtime/gpu_metal.m")
        sl_push2(a, "-framework", "Metal")
        sl_push2(a, "-framework", "Foundation")
    } else {
        sl_push2(a, "-I" + root + "/runtime", here + "/gpu_microbenchmark.c")
    }
    sl_push2(a, "-o", work + "/gpu_bench")
    let rc: i32 = run_argv(a)
    if rc != 0 {
        cli_exit(rc)
    }
    cli_exit(run_argv(sl_of1(work + "/gpu_bench")))
    return 0
}
