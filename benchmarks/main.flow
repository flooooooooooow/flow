import "time.flow"
import "io.flow"
import "flow_benchmarks.flow"

function run_bench() -> i32 {
    print("=== FLOW Performance Benchmarks ===")
    print("")
    
    print("CPU Benchmarks:")
    print("---------------")
    
    # Matrix multiplication benchmark
    let N: i32 = 512
    let size: i32 = N * N
    let A: array<f32> = array<f32>(size)
    let B: array<f32> = array<f32>(size)
    let C: array<f32> = array<f32>(size)
    
    # Initialize matrices
    for i in 0..size {
        A[i] = 1.0
        B[i] = 2.0
        C[i] = 0.0
    }
    
    let start_cpu: f64 = get_time()
    matmul_cpu(A, B, C, N)
    let end_cpu: f64 = get_time()
    print_benchmark("Matrix Multiplication CPU", end_cpu - start_cpu)
    print("Checksum CPU:")
    print(C[0] + C[size - 1])
    
    # GPU benchmark
    let start_gpu: f64 = get_time()
    matmul_gpu(A, B, C, N)
    let end_gpu: f64 = get_time()
    print_benchmark("Matrix Multiplication GPU", end_gpu - start_gpu)
    print("Checksum GPU:")
    print(C[0] + C[size - 1])
    
    # Sorting benchmarks
    let sort_n: i32 = 10000
    let arr_bubble: array<f32> = array<f32>(sort_n)
    let arr_quick: array<f32> = array<f32>(sort_n)
    
    # Initialize arrays
    for i in 0..sort_n {
        arr_bubble[i] = 0.001
        arr_quick[i] = arr_bubble[i]
    }
    
    let start_bubble: f64 = get_time()
    bubble_sort(arr_bubble, sort_n)
    let end_bubble: f64 = get_time()
    print_benchmark("Bubble Sort", end_bubble - start_bubble)
    
    let start_quick: f64 = get_time()
    quick_sort(arr_quick, sort_n)
    let end_quick: f64 = get_time()
    print_benchmark("Quick Sort", end_quick - start_quick)
    
    # Vector operations
    let vec_n: i32 = 1000000
    let vec_a: array<f32> = array<f32>(vec_n)
    let vec_b: array<f32> = array<f32>(vec_n)
    let vec_result: array<f32> = array<f32>(vec_n)
    
    # Initialize vectors
    for i in 0..vec_n {
        vec_a[i] = 1.0
        vec_b[i] = 2.0
    }
    
    let start_vec_add: f64 = get_time()
    vector_add(vec_a, vec_b, vec_result, vec_n)
    let end_vec_add: f64 = get_time()
    print_benchmark("Vector Addition CPU", end_vec_add - start_vec_add)
    
    let start_vec_mul: f64 = get_time()
    vector_multiply(vec_a, vec_b, vec_result, vec_n)
    let end_vec_mul: f64 = get_time()
    print_benchmark("Vector Multiplication CPU", end_vec_mul - start_vec_mul)
    
    # GPU vector operations
    let start_vec_add_gpu: f64 = get_time()
    vector_add_gpu(vec_a, vec_b, vec_result, vec_n)
    let end_vec_add_gpu: f64 = get_time()
    print_benchmark("Vector Addition GPU", end_vec_add_gpu - start_vec_add_gpu)
    
    let start_vec_mul_gpu: f64 = get_time()
    vector_multiply_gpu(vec_a, vec_b, vec_result, vec_n)
    let end_vec_mul_gpu: f64 = get_time()
    print_benchmark("Vector Multiplication GPU", end_vec_mul_gpu - start_vec_mul_gpu)
    
    # Fibonacci benchmarks
    let fib_n: i32 = 40
    
    let start_fib_rec: f64 = get_time()
    let fib_rec_result: i32 = fibonacci_recursive(fib_n)
    let end_fib_rec: f64 = get_time()
    print_benchmark("Fibonacci Recursive", end_fib_rec - start_fib_rec)
    print("Result:")
    print(fib_rec_result)
    
    let start_fib_iter: f64 = get_time()
    let fib_iter_result: i32 = fibonacci_iterative(fib_n)
    let end_fib_iter: f64 = get_time()
    print_benchmark("Fibonacci Iterative", end_fib_iter - start_fib_iter)
    print("Result:")
    print(fib_iter_result)
    
    # Prime counting
    let prime_N: i32 = 1000000
    let start_primes: f64 = get_time()
    let prime_count: i32 = count_primes(prime_N)
    let end_primes: f64 = get_time()
    print_benchmark("Prime Counting", end_primes - start_primes)
    print("Result:")
    print(prime_count)
    
    # Monte Carlo Pi
    let mc_samples: i32 = 10000000
    let start_mc: f64 = get_time()
    let pi_estimate: f32 = monte_carlo_pi(mc_samples)
    let end_mc: f64 = get_time()
    print_benchmark("Monte Carlo Pi", end_mc - start_mc)
    print("Estimate:")
    print(pi_estimate)
    
    print("")
    print("=== Benchmark Complete ===")
    
    return 0
}
