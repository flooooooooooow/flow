# @module benchmarks.standardized.bench
# @means  Standardized benchmark runner, compatible with
#         github.com/andrewmcwattersandco/programming-language-benchmarks:
#         each benchmark built from Flow and run 10 times, reporting the
#         mean of the times it prints (or of the wall time when it prints
#         none), and the NumPy subject in
#         benchmarks/baselines/python/standardized when python3 and NumPy
#         are installed.
#
#   ./flow tool benchmarks/standardized/bench.flow
#
# Binaries and the generated C go to benchmarks/standardized/build. A build
# step that fails stops the run with its status, as `set -e` did.

import "tools/flow_cli/sys.flow"
import "benchmarks/bench_tools.flow"
import std.process { ProcCmd, ProcStrs, proc_arg }

const C_FLAGS: string = "-O3 -march=native -ffast-math"

# The leading run of digits and dots of the first line that starts with
# one (`grep -oE '^[0-9.]+' | head -1`), or "".
function first_number(text: string) -> string {
    let lines: ptr<ProcStrs> = s_lines(text)
    let mut i: i32 = 0
    while i < sl_len(lines) {
        let l: string = sl_get(lines, i)
        let mut n: i32 = 0
        while n < s_len(l) and ((s_byte(l, n) >= 48 and s_byte(l, n) <= 57) or s_byte(l, n) == 46) {
            n = n + 1
        }
        if n > 0 {
            return s_slice(l, 0, n)
        }
        i = i + 1
    }
    return ""
}

# `echo "scale=1; total / n" | bc`: truncated to one decimal, with no zero
# before the point below 1, as bc prints it.
function bc_mean(total: f64, n: i32) -> string {
    let tenths: i64 = (total * 10.0 / (n as f64)) as i64
    if tenths == 0 {
        return "0"
    }
    let s: string = bench_fixed((tenths as f64) / 10.0, 1)
    if s_starts(s, "0.") {
        return s_from(s, 1)
    }
    return s
}

function run_python_subject(subject: string, iterations: i32) {
    out("  python numpy    ")
    let v: ptr<ProcCmd> = cmd(sl_of2("python3", "--version"))
    cmd_quiet(v)
    if run(v) != 0 {
        outln("skipped (python3 not found)")
        return
    }
    let mut total: f64 = 0.0
    let mut i: i32 = 0
    while i < iterations {
        let c: ptr<ProcCmd> = cmd(sl_of2("python3", subject))
        cmd_quiet_err(c)
        let text: string = capture(c)
        if last_status() != 0 {
            outln("skipped (the subject did not run; is NumPy installed?)")
            return
        }
        let r: string = first_number(text)
        if s_len(r) > 0 {
            total = total + bench_parse(r)
        }
        i = i + 1
    }
    outln("mean " + bc_mean(total, iterations) + " µs")
}

# Run `c`; stop the program with its status when it fails.
function must(c: ptr<ProcCmd>) {
    let rc: i32 = run(c)
    if rc != 0 {
        cli_exit(rc)
    }
}

function run_benchmark(root: string, build: string, name: string, flow_file: string, iterations: i32) {
    out("  flow            ")
    let e: ptr<ProcCmd> = cmd(sl_of3("compiler/scripts/flowc_emit.sh", "--lenient", flow_file))
    proc_arg(e, build + "/" + name + ".c")
    cmd_cwd(e, root)
    cmd_quiet_err(e)
    must(e)
    let cc: ptr<ProcStrs> = sl_of1("clang")
    sl_extend(cc, s_words(C_FLAGS))
    sl_push2(cc, "-D_DEFAULT_SOURCE", "-Iruntime")
    sl_push2(cc, "-lm", build + "/" + name + ".c")
    sl_push2(cc, "-o", build + "/" + name)
    let c: ptr<ProcCmd> = cmd(cc)
    cmd_cwd(c, root)
    cmd_quiet_err(c)
    must(c)
    let exe: string = build + "/" + name
    let mut total: f64 = 0.0
    let mut found: bool = false
    let mut i: i32 = 0
    while i < iterations {
        let r: ptr<ProcCmd> = cmd(sl_of1(exe))
        cmd_quiet_err(r)
        let n: string = first_number(capture(r))
        if s_len(n) > 0 {
            total = total + bench_parse(n)
            found = true
        }
        i = i + 1
    }
    if found and total != 0.0 {
        outln("mean " + bc_mean(total, iterations) + " µs")
        return
    }
    # No time printed: the wall time of the runs.
    let start: i64 = bench_now_us()
    let mut k: i32 = 0
    while k < iterations {
        let q: ptr<ProcCmd> = cmd(sl_of1(exe))
        cmd_quiet(q)
        must(q)
        k = k + 1
    }
    let end: i64 = bench_now_us()
    outln("mean " + bc_mean((end - start) as f64, iterations) + " µs")
}

function main() -> i32 {
    let root: string = bench_root("benchmarks/standardized/bench.flow")
    let here: string = root + "/benchmarks/standardized"
    let build: string = here + "/build"
    let _m: bool = mkdir_p(build)
    outln("=== Flow Language Standardized Benchmarks ===")
    outln("(Compatible with programming-language-benchmarks)")
    outln("")
    outln("minimal")
    run_benchmark(root, build, "minimal", here + "/minimal/minimal.flow", 10)
    outln("record")
    run_benchmark(root, build, "record", here + "/record/record.flow", 10)
    run_python_subject(root + "/benchmarks/baselines/python/standardized/record_numpy.py", 10)
    outln("json")
    run_benchmark(root, build, "json", here + "/json/json.flow", 10)
    outln("")
    outln("Done.")
    cli_exit(0)
    return 0
}
