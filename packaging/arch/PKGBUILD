# Maintainer: Flow Language Team <team@flow-lang.org>
pkgname=flow-language
pkgver=1.0.2
pkgrel=1
pkgdesc="Flow programming language toolchain and runtime"
arch=('x86_64' 'aarch64')
url="https://github.com/flooooooooooow/flow"
license=('MIT')
depends=('clang' 'python')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/flooooooooooow/flow/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
    cd "flow-${pkgver}"
    install -d "${pkgdir}/usr/bin" "${pkgdir}/usr/lib/flow"
    cp -r src lib runtime compiler "${pkgdir}/usr/lib/flow/"
    install -m755 flow "${pkgdir}/usr/bin/flow"
}
