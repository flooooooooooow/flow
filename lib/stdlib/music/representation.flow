# Experimental observation-derived musical representation core.
# Tonal positions are cents relative to an explicitly supplied reference,
# not MIDI note numbers and not a prescribed tuning system.
# A gesture's crest and release are independent pitch trajectory samples.

export struct MusicGesture {
    onset_cents: f64,
    crest_cents: f64,
    release_cents: f64,
    duration_beats: f64,
    articulation: i32
}

export struct MusicLoss {
    onset_squared_cents: f64,
    contour_squared_cents: f64,
    duration_squared_beats: f64,
    articulation_mismatches: i32
}

export function music_gesture(onset: f64, crest: f64, release: f64, beats: f64, articulation: i32) -> MusicGesture {
    return MusicGesture {
        onset_cents: onset,
        crest_cents: crest,
        release_cents: release,
        duration_beats: beats,
        articulation: articulation
    }
}

export function music_abs(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 - x
    }
    return x
}

export function music_square(x: f64) -> f64 {
    return x * x
}

# The sole purpose of this fixed-grid projection is to be a LOSSY BASELINE.
# Correct for negative cents as well as positive cents.
export function music_round_to(value: f64, step: f64) -> f64 {
    if step <= 0.0 {
        return value
    }
    let scaled: f64 = value / step
    if scaled >= 0.0 {
        return (((scaled + 0.5) as i32) as f64) * step
    }
    return (((scaled - 0.5) as i32) as f64) * step
}

export function music_nearest(value: f64, centers: ptr<f64>, count: i32) -> f64 {
    if count <= 0 {
        return value
    }
    let mut nearest: f64 = centers[0]
    let mut error: f64 = music_abs(value - nearest)
    let mut i: i32 = 1
    while i < count {
        let next_error: f64 = music_abs(value - centers[i])
        if next_error < error {
            error = next_error
            nearest = centers[i]
        }
        i = i + 1
    }
    return nearest
}

# Residual-driven dictionary growth (deterministic farthest-first).
# An extra landmark is introduced only when the current representation
# fails the prescribed maximum onset reconstruction error budget.
# This is an exploratory codebook, NOT a learned raga/maqam grammar.
# count and capacity must reflect the actual input/output buffer lengths.
export function music_discover_landmarks(
    events: ptr<MusicGesture>,
    count: i32,
    centers: ptr<f64>,
    capacity: i32,
    max_error_cents: f64
) -> i32 {
    if count <= 0 or capacity <= 0 {
        return 0
    }
    let mut size: i32 = 1
    centers[0] = events[0].onset_cents
    let mut tolerance: f64 = max_error_cents
    if tolerance < 0.0 {
        tolerance = 0.0
    }
    while size < capacity {
        let mut maximum: f64 = 0.0
        let mut farthest: f64 = centers[0]
        let mut i: i32 = 0
        while i < count {
            let pitch: f64 = events[i].onset_cents
            let error: f64 = music_abs(pitch - music_nearest(pitch, centers, size))
            if error > maximum {
                maximum = error
                farthest = pitch
            }
            i = i + 1
        }
        if maximum <= tolerance {
            break
        }
        centers[size] = farthest
        size = size + 1
    }
    return size
}

# Preserve the expressive interval contour relative to a learned pitch
# landmark: the representation may quantize the onset without flattening
# its actual crest, release, duration or articulation.
export function music_project_gesture(e: MusicGesture, centers: ptr<f64>, count: i32) -> MusicGesture {
    let snapped: f64 = music_nearest(e.onset_cents, centers, count)
    return music_gesture(
        snapped,
        snapped + (e.crest_cents - e.onset_cents),
        snapped + (e.release_cents - e.onset_cents),
        e.duration_beats,
        e.articulation
    )
}

# Deliberately lossy Western equal-temperament / note-only baseline.
# Quantizes onset to a 100-cent grid, duration to quarter-beat boundaries,
# and drops pitch trajectories and articulation. Not a model of every
# Western practice; just a deliberately information-poor MIDI-like export.
export function music_project_fixed_grid(e: MusicGesture) -> MusicGesture {
    let pitch: f64 = music_round_to(e.onset_cents, 100.0)
    return music_gesture(pitch, pitch, pitch, music_round_to(e.duration_beats, 0.25), 0)
}

export function music_measure_loss(original: MusicGesture, projected: MusicGesture) -> MusicLoss {
    let original_crest: f64 = original.crest_cents - original.onset_cents
    let projected_crest: f64 = projected.crest_cents - projected.onset_cents
    let original_release: f64 = original.release_cents - original.onset_cents
    let projected_release: f64 = projected.release_cents - projected.onset_cents
    let mut mismatch: i32 = 0
    if original.articulation != projected.articulation {
        mismatch = 1
    }
    return MusicLoss {
        onset_squared_cents: music_square(original.onset_cents - projected.onset_cents),
        contour_squared_cents: music_square(original_crest - projected_crest) + music_square(original_release - projected_release),
        duration_squared_beats: music_square(original.duration_beats - projected.duration_beats),
        articulation_mismatches: mismatch
    }
}

# Piecewise linear pitch trajectory with a crest at 40% of the gesture.
# Phase is clamped to [0,1]; synthesis may evaluate it per audio sample.
export function music_pitch_at(e: MusicGesture, phase: f64) -> f64 {
    if phase <= 0.0 {
        return e.onset_cents
    }
    if phase >= 1.0 {
        return e.release_cents
    }
    if phase < 0.4 {
        return e.onset_cents + (e.crest_cents - e.onset_cents) * (phase / 0.4)
    }
    return e.crest_cents + (e.release_cents - e.crest_cents) * ((phase - 0.4) / 0.6)
}

# Return a concrete counterexample: two distinguishable observed onsets
# which are identical after projection to the fixed 100-cent grid.
# This is a witness of representation loss, not a value judgment.
export struct MusicPitchCollision {
    found: bool,
    left_index: i32,
    right_index: i32,
    original_separation_cents: f64,
    projected_separation_cents: f64
}

export function music_find_onset_collision(events: ptr<MusicGesture>, count: i32, minimum_separation_cents: f64) -> MusicPitchCollision {
    let mut i: i32 = 0
    while i < count {
        let mut j: i32 = i + 1
        while j < count {
            let original: f64 = music_abs(events[i].onset_cents - events[j].onset_cents)
            let pi: MusicGesture = music_project_fixed_grid(events[i])
            let pj: MusicGesture = music_project_fixed_grid(events[j])
            let projected: f64 = music_abs(pi.onset_cents - pj.onset_cents)
            if original > minimum_separation_cents and projected < 0.001 {
                return MusicPitchCollision {
                    found: true,
                    left_index: i,
                    right_index: j,
                    original_separation_cents: original,
                    projected_separation_cents: projected
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    return MusicPitchCollision {
        found: false,
        left_index: -1,
        right_index: -1,
        original_separation_cents: 0.0,
        projected_separation_cents: 0.0
    }
}
