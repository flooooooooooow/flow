# Processes: run a program with an argument vector and capture what it
# prints, read this program's own arguments and environment.
#
#   import std.process { ProcCmd, ProcResult, proc_cmd, proc_arg, proc_run }
#
#   let c: ptr<ProcCmd> = proc_cmd("git")
#   proc_arg(c, "ls-files")
#   proc_timeout_ms(c, 10000)
#   let r: ptr<ProcResult> = proc_run(c)
#   if r.exit_code == 0 { ... r.stdout ... }
#
# The child is started with posix_spawnp, so no shell reads the arguments
# and none of them needs quoting. stdout and stderr are captured by default;
# each can instead pass through to this program's own streams, go to
# /dev/null, or (stderr only) join stdout. stdin is /dev/null unless the
# command is given input text or told to inherit.
#
# exit_code follows Python's subprocess: the exit status, or minus the
# signal number when a signal ended the child. A command that runs past its
# timeout is killed with SIGKILL and has timed_out set. A command that
# could not be started has exit_code 127 and says why in `error`.
#
# Everything above the system calls is Flow. The C below is a thin shim:
# the calls whose prototypes or struct layouts differ between platforms
# (posix_spawn file actions, poll, the wait status macros) and argv, which
# C only hands to main. It declares read, write, pipe and friends under
# private names, so a program that declares them itself through `extern`
# with Flow types still compiles.
#
# Works with the Stage-A compiler alone: nothing from runtime/ is linked.

@cEmbed("#include <errno.h>
#include <spawn.h>
#include <signal.h>
#include <sys/wait.h>
#if defined(__APPLE__)
#include <crt_externs.h>
#endif
#define FLOW_PROC_STR2(x) #x
#define FLOW_PROC_STR(x) FLOW_PROC_STR2(x)
#define FLOW_PROC_SYM(n) FLOW_PROC_STR(__USER_LABEL_PREFIX__) FLOW_PROC_STR(n)
extern long flow_proc_c_read(int, void *, unsigned long) __asm__(FLOW_PROC_SYM(read));
extern long flow_proc_c_write(int, const void *, unsigned long) __asm__(FLOW_PROC_SYM(write));
extern int flow_proc_c_close(int) __asm__(FLOW_PROC_SYM(close));
extern int flow_proc_c_pipe(int *) __asm__(FLOW_PROC_SYM(pipe));
extern int flow_proc_c_fcntl(int, int, ...) __asm__(FLOW_PROC_SYM(fcntl));
extern int flow_proc_c_access(const char *, int) __asm__(FLOW_PROC_SYM(access));
extern char *flow_proc_c_getcwd(char *, unsigned long) __asm__(FLOW_PROC_SYM(getcwd));
extern int flow_proc_c_chdir(const char *) __asm__(FLOW_PROC_SYM(chdir));
extern int flow_proc_c_getpid(void) __asm__(FLOW_PROC_SYM(getpid));
extern int flow_proc_c_kill(int, int) __asm__(FLOW_PROC_SYM(kill));
struct flow_proc_pollfd { int fd; short events; short revents; };
#if defined(__APPLE__)
extern int flow_proc_c_poll(struct flow_proc_pollfd *, unsigned int, int) __asm__(FLOW_PROC_SYM(poll));
#else
extern int flow_proc_c_poll(struct flow_proc_pollfd *, unsigned long, int) __asm__(FLOW_PROC_SYM(poll));
#endif
extern char **environ;
static int flow_proc_argc_v = 0;
static char **flow_proc_argv_v = 0;
#if defined(__APPLE__)
static void flow_proc_args_load(void) {
  if (flow_proc_argv_v == 0) { flow_proc_argc_v = *_NSGetArgc(); flow_proc_argv_v = *_NSGetArgv(); }
}
#elif defined(__GLIBC__)
__attribute__((constructor)) static void flow_proc_args_init(int argc, char **argv, char **envp) {
  (void)envp; flow_proc_argc_v = argc; flow_proc_argv_v = argv;
}
static void flow_proc_args_load(void) { }
#else
static void flow_proc_args_load(void) {
  if (flow_proc_argv_v != 0) { return; }
  FILE *fp = fopen(\"/proc/self/cmdline\", \"rb\");
  if (fp == 0) { return; }
  size_t cap = 4096, len = 0; char *buf = (char *)malloc(cap + 1);
  for (;;) { size_t got = fread(buf + len, 1, cap - len, fp); len += got; if (got == 0) { break; }
    if (len == cap) { cap *= 2; buf = (char *)realloc(buf, cap + 1); } }
  fclose(fp); buf[len] = 0;
  int n = 0; for (size_t i = 0; i < len; i++) { if (buf[i] == 0) { n++; } }
  char **v = (char **)malloc(sizeof(char *) * (size_t)(n + 1)); int k = 0; size_t s = 0;
  for (size_t i = 0; i < len; i++) { if (buf[i] == 0) { v[k++] = buf + s; s = i + 1; } }
  v[k] = 0; flow_proc_argc_v = k; flow_proc_argv_v = v;
}
#endif
static int32_t flow_proc_argc(void) { flow_proc_args_load(); return (int32_t)flow_proc_argc_v; }
static const char *flow_proc_argv(int32_t i) {
  flow_proc_args_load();
  if (i < 0 || i >= flow_proc_argc_v || flow_proc_argv_v == 0) { return 0; }
  return flow_proc_argv_v[i];
}
static int32_t flow_proc_environ_count(void) { int32_t n = 0; while (environ != 0 && environ[n] != 0) { n++; } return n; }
static const char *flow_proc_environ_at(int32_t i) { return environ[i]; }
static int32_t flow_proc_errno(void) { return (int32_t)errno; }
static int32_t flow_proc_pipe(int32_t *fds) {
  int p[2];
  if (flow_proc_c_pipe(p) != 0) { return -1; }
  flow_proc_c_fcntl(p[0], 2, 1);
  flow_proc_c_fcntl(p[1], 2, 1);
  fds[0] = p[0]; fds[1] = p[1];
  return 0;
}
static int32_t flow_proc_close(int32_t fd) { return (int32_t)flow_proc_c_close(fd); }
static int64_t flow_proc_read(int32_t fd, uint8_t *buf, int64_t n) {
  for (;;) { long got = flow_proc_c_read(fd, buf, (unsigned long)n); if (got >= 0 || errno != EINTR) { return (int64_t)got; } }
}
static int64_t flow_proc_write(int32_t fd, uint8_t *buf, int64_t off, int64_t n) {
  void (*old)(int) = signal(SIGPIPE, SIG_IGN);
  long put;
  for (;;) { put = flow_proc_c_write(fd, buf + off, (unsigned long)n); if (put >= 0 || errno != EINTR) { break; } }
  signal(SIGPIPE, old);
  return (int64_t)put;
}
static int32_t flow_proc_poll(int32_t *fds, int32_t *events, int32_t *revents, int32_t n, int32_t timeout_ms) {
  struct flow_proc_pollfd p[3];
  int32_t i;
  if (n > 3) { n = 3; }
  for (i = 0; i < n; i++) { p[i].fd = fds[i]; p[i].events = (short)(events[i] == 1 ? 1 : 4); p[i].revents = 0; }
  int r = flow_proc_c_poll(p, n, timeout_ms);
  for (i = 0; i < n; i++) { revents[i] = (p[i].revents & (1 | 4)) != 0 ? 1 : ((p[i].revents & (8 | 16 | 32)) != 0 ? 2 : 0); }
  if (r < 0 && errno == EINTR) { return 0; }
  return (int32_t)r;
}
static int32_t flow_proc_sleep_ms(int32_t ms) { return (int32_t)flow_proc_c_poll(0, 0, ms); }
static int64_t flow_proc_now_ms(void) {
  struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
  return (int64_t)ts.tv_sec * 1000 + (int64_t)(ts.tv_nsec / 1000000);
}
static int32_t flow_proc_setup_fd(posix_spawn_file_actions_t *fa, int32_t mode, int32_t fd, int32_t target, int32_t writing) {
  if (mode == 1) { return posix_spawn_file_actions_adddup2(fa, fd, target); }
  if (mode == 2) { return posix_spawn_file_actions_addopen(fa, target, \"/dev/null\", writing ? 1 : 0, 0); }
  if (mode == 3) { return posix_spawn_file_actions_adddup2(fa, 1, target); }
  return 0;
}
#if defined(__APPLE__) || (defined(__GLIBC__) && (__GLIBC__ > 2 || (__GLIBC__ == 2 && __GLIBC_MINOR__ >= 29)))
#define FLOW_PROC_HAVE_CHDIR 1
#else
#define FLOW_PROC_HAVE_CHDIR 0
#endif
static int32_t flow_proc_spawn_can_chdir(void) { return FLOW_PROC_HAVE_CHDIR; }
static int32_t flow_proc_spawn(const char **argv, const char **envp, const char *cwd,
    int32_t in_mode, int32_t in_fd, int32_t out_mode, int32_t out_fd, int32_t err_mode, int32_t err_fd) {
  posix_spawn_file_actions_t fa;
  pid_t pid = 0;
  int rc;
  if (posix_spawn_file_actions_init(&fa) != 0) { return -ENOMEM; }
  rc = flow_proc_setup_fd(&fa, in_mode, in_fd, 0, 0);
  if (rc == 0) { rc = flow_proc_setup_fd(&fa, out_mode, out_fd, 1, 1); }
  if (rc == 0) { rc = flow_proc_setup_fd(&fa, err_mode, err_fd, 2, 1); }
#if FLOW_PROC_HAVE_CHDIR
  if (rc == 0 && cwd != 0 && cwd[0] != 0) { rc = posix_spawn_file_actions_addchdir_np(&fa, cwd); }
#endif
  if (rc == 0) {
    rc = posix_spawnp(&pid, argv[0], &fa, 0, (char *const *)argv, envp != 0 ? (char *const *)envp : environ);
  }
  posix_spawn_file_actions_destroy(&fa);
  if (rc != 0) { return -(int32_t)rc; }
  return (int32_t)pid;
}
static int32_t flow_proc_wait(int32_t pid, int32_t nohang, int32_t *code) {
  int st = 0; pid_t r;
  for (;;) { r = waitpid((pid_t)pid, &st, nohang ? WNOHANG : 0); if (r >= 0 || errno != EINTR) { break; } }
  if (r <= 0) { return (int32_t)r; }
  if (WIFEXITED(st)) { *code = (int32_t)WEXITSTATUS(st); }
  else if (WIFSIGNALED(st)) { *code = -(int32_t)WTERMSIG(st); }
  else { *code = -1; }
  return 1;
}
static int32_t flow_proc_kill(int32_t pid, int32_t sig) { return (int32_t)flow_proc_c_kill((int)pid, (int)sig); }
static int32_t flow_proc_sigkill(void) { return (int32_t)SIGKILL; }
static int32_t flow_proc_sigterm(void) { return (int32_t)SIGTERM; }
static int32_t flow_proc_access_x(const char *path) { return flow_proc_c_access(path, 1) == 0 ? 1 : 0; }
static const char *flow_proc_getcwd(void) {
  char *buf = (char *)malloc(4096);
  if (buf == 0 || flow_proc_c_getcwd(buf, 4096) == 0) { return 0; }
  return buf;
}
static int32_t flow_proc_chdir(const char *path) { return (int32_t)flow_proc_c_chdir(path); }
static int32_t flow_proc_getpid(void) { return (int32_t)flow_proc_c_getpid(); }
static const char *flow_proc_strerror(int32_t e) { return strerror(e); }
")

import std.bytebuf { ByteBuf, bb_new, bb_put_bytes, bb_str, bb_free }

extern {
    function flow_proc_argc() -> i32
    function flow_proc_argv(i: i32) -> string
    function flow_proc_environ_count() -> i32
    function flow_proc_environ_at(i: i32) -> string
    function flow_proc_errno() -> i32
    function flow_proc_pipe(fds: ptr<i32>) -> i32
    function flow_proc_close(fd: i32) -> i32
    function flow_proc_read(fd: i32, buf: ptr<u8>, n: i64) -> i64
    function flow_proc_write(fd: i32, buf: ptr<u8>, off: i64, n: i64) -> i64
    function flow_proc_poll(fds: ptr<i32>, events: ptr<i32>, revents: ptr<i32>, n: i32, timeout_ms: i32) -> i32
    function flow_proc_sleep_ms(ms: i32) -> i32
    function flow_proc_now_ms() -> i64
    function flow_proc_spawn_can_chdir() -> i32
    function flow_proc_spawn(argv: ptr<string>, envp: ptr<string>, cwd: string, in_mode: i32, in_fd: i32, out_mode: i32, out_fd: i32, err_mode: i32, err_fd: i32) -> i32
    function flow_proc_wait(pid: i32, nohang: i32, code: ptr<i32>) -> i32
    function flow_proc_kill(pid: i32, sig: i32) -> i32
    function flow_proc_sigkill() -> i32
    function flow_proc_sigterm() -> i32
    function flow_proc_access_x(path: string) -> i32
    function flow_proc_getcwd() -> string
    function flow_proc_chdir(path: string) -> i32
    function flow_proc_getpid() -> i32
    function flow_proc_strerror(e: i32) -> string
    function malloc(size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
    function strlen(s: string) -> i64
    function strcmp(a: string, b: string) -> i32
    function strncmp(a: string, b: string, n: i64) -> i32
    function getenv(name: string) -> string
    function setenv(name: string, value: string, overwrite: i32) -> i32
    function unsetenv(name: string) -> i32
}

# How a child's stream is connected. PROC_MERGE is for stderr only: it
# joins stdout, as `2>&1` does.
export const PROC_CAPTURE: i32 = 0
export const PROC_INHERIT: i32 = 1
export const PROC_NULL: i32 = 2
export const PROC_MERGE: i32 = 3

# C-side modes of flow_proc_spawn.
const FD_INHERIT: i32 = 0
const FD_PIPE: i32 = 1
const FD_NULL: i32 = 2
const FD_TO_STDOUT: i32 = 3

# A growable list of strings (argv, environment overrides).
export struct ProcStrs {
    items: ptr<string>,
    len: i32,
    cap: i32
}

# A command to run. Build it with proc_cmd and the setters below.
export struct ProcCmd {
    argv: ptr<ProcStrs>,
    env: ptr<ProcStrs>,
    clear_env: bool,
    cwd: string,
    timeout_ms: i64,
    input: string,
    has_input: bool,
    in_mode: i32,
    out_mode: i32,
    err_mode: i32,
    in_fd: i32,
    out_fd: i32
}

# A pipe that can connect two spawned commands. proc_attach_stdin and
# proc_attach_stdout consume the corresponding end when the command starts.
export struct ProcPipe {
    read_fd: i32,
    write_fd: i32
}

# What a finished command did.
export struct ProcResult {
    # Exit status, or minus the signal number that ended the child.
    exit_code: i32,
    stdout: string,
    stderr: string,
    timed_out: bool,
    # "" when the child started; otherwise why it could not.
    error: string,
    elapsed_ms: i64,
    pid: i32
}

# A running child. Keep the handle until proc_wait or proc_wait_any returns.
export struct ProcHandle {
    pid: i32,
    in_fd: i32,
    out_fd: i32,
    err_fd: i32,
    input: string,
    input_len: i64,
    input_off: i64,
    out_b: ptr<ByteBuf>,
    err_b: ptr<ByteBuf>,
    chunk: ptr<u8>,
    result: ptr<ProcResult>,
    start_ms: i64,
    deadline: i64,
    finished: bool
}

# ---------------------------------------------------------------------------
# String lists
# ---------------------------------------------------------------------------

export function proc_strs_new() -> ptr<ProcStrs> {
    let l: ptr<ProcStrs> = malloc(24) as ptr<ProcStrs>
    l.cap = 8
    l.len = 0
    l.items = malloc(8 * 9) as ptr<string>
    l.items[0] = null as string
    return l
}

# Append `s`; the list stays NULL-terminated, so `items` is a C argv.
export function proc_strs_push(l: ptr<ProcStrs>, s: string) {
    if l.len + 1 >= l.cap {
        l.cap = l.cap * 2
        l.items = realloc(l.items as ptr<void>, ((l.cap + 1) as i64) * 8) as ptr<string>
    }
    l.items[l.len] = s
    l.len = l.len + 1
    l.items[l.len] = null as string
}

export function proc_strs_len(l: ptr<ProcStrs>) -> i32 {
    return l.len
}

export function proc_strs_get(l: ptr<ProcStrs>, i: i32) -> string {
    if i < 0 or i >= l.len {
        return ""
    }
    return l.items[i]
}

# ---------------------------------------------------------------------------
# Building a command
# ---------------------------------------------------------------------------

# A command that runs `program`, found on PATH when it has no slash.
export function proc_cmd(program: string) -> ptr<ProcCmd> {
    let c: ptr<ProcCmd> = malloc(96) as ptr<ProcCmd>
    c.argv = proc_strs_new()
    proc_strs_push(c.argv, program)
    c.env = proc_strs_new()
    c.clear_env = false
    c.cwd = ""
    c.timeout_ms = 0
    c.input = ""
    c.has_input = false
    c.in_mode = PROC_NULL
    c.out_mode = PROC_CAPTURE
    c.err_mode = PROC_CAPTURE
    c.in_fd = 0 - 1
    c.out_fd = 0 - 1
    return c
}

# `/bin/sh -c script`, for when a shell is wanted.
export function proc_sh(script: string) -> ptr<ProcCmd> {
    let c: ptr<ProcCmd> = proc_cmd("/bin/sh")
    proc_arg(c, "-c")
    proc_arg(c, script)
    return c
}

export function proc_arg(c: ptr<ProcCmd>, a: string) {
    proc_strs_push(c.argv, a)
}

# Set NAME=value in the child's environment, on top of this program's.
export function proc_env(c: ptr<ProcCmd>, name: string, value: string) {
    let n: i64 = strlen(name)
    let mut i: i32 = 0
    while i < c.env.len {
        let old: string = c.env.items[i]
        let mut k: i32 = 0
        let oldp: ptr<u8> = old as ptr<u8>
        while oldp[k] != 0 and oldp[k] != 61 {
            k = k + 1
        }
        if k as i64 == n and strncmp(old, name, n) == 0 {
            c.env.items[i] = name + "=" + value
            return
        }
        i = i + 1
    }
    proc_strs_push(c.env, name + "=" + value)
}

# Start the child with only the variables given through proc_env.
export function proc_env_clear(c: ptr<ProcCmd>) {
    c.clear_env = true
}

# Run the child in `dir`.
export function proc_cwd(c: ptr<ProcCmd>, dir: string) {
    c.cwd = dir
}

# Kill the child with SIGKILL after `ms` milliseconds. 0 means no limit.
export function proc_timeout_ms(c: ptr<ProcCmd>, ms: i64) {
    c.timeout_ms = ms
}

# Feed `text` to the child's stdin, then close it.
export function proc_input(c: ptr<ProcCmd>, text: string) {
    c.input = text
    c.has_input = true
    c.in_mode = PROC_CAPTURE
}

# stdin: PROC_NULL (the default) or PROC_INHERIT.
export function proc_stdin(c: ptr<ProcCmd>, mode: i32) {
    c.in_mode = mode
    c.has_input = false
}

# stdout: PROC_CAPTURE (the default), PROC_INHERIT or PROC_NULL.
export function proc_stdout(c: ptr<ProcCmd>, mode: i32) {
    c.out_mode = mode
}

# stderr: PROC_CAPTURE (the default), PROC_INHERIT, PROC_NULL or PROC_MERGE.
export function proc_stderr(c: ptr<ProcCmd>, mode: i32) {
    c.err_mode = mode
}

# Create one pipe for use by two commands.
export function proc_pipe_new() -> ptr<ProcPipe> {
    let p: ptr<ProcPipe> = malloc(8) as ptr<ProcPipe>
    let fds: ptr<i32> = malloc(8) as ptr<i32>
    if flow_proc_pipe(fds) != 0 {
        p.read_fd = 0 - 1
        p.write_fd = 0 - 1
        return p
    }
    p.read_fd = fds[0]
    p.write_fd = fds[1]
    return p
}

export function proc_pipe_close_read(p: ptr<ProcPipe>) {
    if p.read_fd >= 0 {
        let _r: i32 = flow_proc_close(p.read_fd)
        p.read_fd = 0 - 1
    }
}

export function proc_pipe_close_write(p: ptr<ProcPipe>) {
    if p.write_fd >= 0 {
        let _r: i32 = flow_proc_close(p.write_fd)
        p.write_fd = 0 - 1
    }
}

# Attach a pipe end before spawning. The parent closes the attached end after
# the child inherits it.
export function proc_attach_stdin(c: ptr<ProcCmd>, p: ptr<ProcPipe>) {
    c.in_fd = p.read_fd
    p.read_fd = 0 - 1
    c.in_mode = PROC_CAPTURE
}

export function proc_attach_stdout(c: ptr<ProcCmd>, p: ptr<ProcPipe>) {
    c.out_fd = p.write_fd
    p.write_fd = 0 - 1
    c.out_mode = PROC_CAPTURE
}

# ---------------------------------------------------------------------------
# Running
# ---------------------------------------------------------------------------

function proc_env_key_len(entry: string) -> i32 {
    let p: ptr<u8> = entry as ptr<u8>
    let mut i: i32 = 0
    while p[i] != 0 and p[i] != 61 {
        i = i + 1
    }
    return i
}

# The child's environment: this program's (unless cleared) without the
# overridden names, then the overrides. null when nothing changes.
function proc_build_env(c: ptr<ProcCmd>) -> ptr<string> {
    if c.clear_env == false and c.env.len == 0 {
        return null as ptr<string>
    }
    let out: ptr<ProcStrs> = proc_strs_new()
    if c.clear_env == false {
        let n: i32 = flow_proc_environ_count()
        let mut i: i32 = 0
        while i < n {
            let e: string = flow_proc_environ_at(i)
            let klen: i32 = proc_env_key_len(e)
            let mut overridden: bool = false
            let mut j: i32 = 0
            while j < c.env.len {
                let o: string = c.env.items[j]
                if proc_env_key_len(o) == klen and strncmp(o, e, (klen + 1) as i64) == 0 {
                    overridden = true
                }
                j = j + 1
            }
            if overridden == false {
                proc_strs_push(out, e)
            }
            i = i + 1
        }
    }
    let mut k: i32 = 0
    while k < c.env.len {
        proc_strs_push(out, c.env.items[k])
        k = k + 1
    }
    return out.items
}

function proc_fd_mode(mode: i32) -> i32 {
    if mode == PROC_CAPTURE {
        return FD_PIPE
    }
    if mode == PROC_NULL {
        return FD_NULL
    }
    if mode == PROC_MERGE {
        return FD_TO_STDOUT
    }
    return FD_INHERIT
}

function proc_result_new() -> ptr<ProcResult> {
    let r: ptr<ProcResult> = malloc(64) as ptr<ProcResult>
    r.exit_code = 0 - 1
    r.stdout = ""
    r.stderr = ""
    r.timed_out = false
    r.error = ""
    r.elapsed_ms = 0
    r.pid = 0 - 1
    return r
}

# Read what is available on `fd` into `b`. False at end of file.
function proc_drain(fd: i32, b: ptr<ByteBuf>, chunk: ptr<u8>) -> bool {
    let got: i64 = flow_proc_read(fd, chunk, 65536)
    if got <= 0 {
        return false
    }
    bb_put_bytes(b, chunk, got as i32)
    return true
}

# Wait for the child to exit, up to `deadline` (0: no limit). Kills it
# when the deadline passes. Returns the exit code.
function proc_reap(pid: i32, deadline: i64, r: ptr<ProcResult>) -> i32 {
    let code: ptr<i32> = malloc(4) as ptr<i32>
    code[0] = 0 - 1
    if deadline == 0 {
        let _w: i32 = flow_proc_wait(pid, 0, code)
        return code[0]
    }
    while true {
        let got: i32 = flow_proc_wait(pid, 1, code)
        if got != 0 {
            return code[0]
        }
        if flow_proc_now_ms() >= deadline {
            r.timed_out = true
            let _k: i32 = flow_proc_kill(pid, flow_proc_sigkill())
            let _w2: i32 = flow_proc_wait(pid, 0, code)
            return code[0]
        }
        let _s: i32 = flow_proc_sleep_ms(5)
    }
    return code[0]
}

function proc_handle_close_fds(h: ptr<ProcHandle>) {
    if h.in_fd >= 0 {
        let _a: i32 = flow_proc_close(h.in_fd)
        h.in_fd = 0 - 1
    }
    if h.out_fd >= 0 {
        let _b: i32 = flow_proc_close(h.out_fd)
        h.out_fd = 0 - 1
    }
    if h.err_fd >= 0 {
        let _c: i32 = flow_proc_close(h.err_fd)
        h.err_fd = 0 - 1
    }
}

# Advance one child without waiting for another child to finish.
function proc_handle_tick(h: ptr<ProcHandle>, timeout_ms: i32) -> bool {
    if h.finished {
        return true
    }
    let fds: ptr<i32> = malloc(12) as ptr<i32>
    let evs: ptr<i32> = malloc(12) as ptr<i32>
    let rev: ptr<i32> = malloc(12) as ptr<i32>
    let mut n: i32 = 0
    if h.in_fd >= 0 {
        fds[n] = h.in_fd
        evs[n] = 2
        n = n + 1
    }
    if h.out_fd >= 0 {
        fds[n] = h.out_fd
        evs[n] = 1
        n = n + 1
    }
    if h.err_fd >= 0 {
        fds[n] = h.err_fd
        evs[n] = 1
        n = n + 1
    }
    let ready: i32 = flow_proc_poll(fds, evs, rev, n, timeout_ms)
    if ready >= 0 {
        let mut k: i32 = 0
        while k < n {
            if rev[k] != 0 {
                let fd: i32 = fds[k]
                if fd == h.in_fd {
                    let mut step: i64 = h.input_len - h.input_off
                    if step > 512 { step = 512 }
                    let put: i64 = flow_proc_write(h.in_fd, h.input as ptr<u8>, h.input_off, step)
                    if put > 0 { h.input_off = h.input_off + put }
                    if put < 0 or h.input_off >= h.input_len or rev[k] == 2 {
                        let _i: i32 = flow_proc_close(h.in_fd)
                        h.in_fd = 0 - 1
                    }
                } elif fd == h.out_fd {
                    if proc_drain(h.out_fd, h.out_b, h.chunk) == false {
                        let _o: i32 = flow_proc_close(h.out_fd)
                        h.out_fd = 0 - 1
                    }
                } elif fd == h.err_fd {
                    if proc_drain(h.err_fd, h.err_b, h.chunk) == false {
                        let _e: i32 = flow_proc_close(h.err_fd)
                        h.err_fd = 0 - 1
                    }
                }
            }
            k = k + 1
        }
    }
    let code: ptr<i32> = malloc(4) as ptr<i32>
    let exited: i32 = flow_proc_wait(h.pid, 1, code)
    if exited != 0 and h.result.exit_code == 0 - 1 {
        h.result.exit_code = code[0]
    }
    # Once waitpid reports exit, every child-side write end is closed. Drain
    # to EOF directly so a short final write cannot leave the handle pending.
    if exited != 0 {
        while h.out_fd >= 0 {
            if proc_drain(h.out_fd, h.out_b, h.chunk) == false {
                let _o2: i32 = flow_proc_close(h.out_fd)
                h.out_fd = 0 - 1
            }
        }
        while h.err_fd >= 0 {
            if proc_drain(h.err_fd, h.err_b, h.chunk) == false {
                let _e2: i32 = flow_proc_close(h.err_fd)
                h.err_fd = 0 - 1
            }
        }
    }
    if h.deadline > 0 and flow_proc_now_ms() >= h.deadline and h.result.exit_code == 0 - 1 {
        h.result.timed_out = true
        let _k: i32 = flow_proc_kill(h.pid, flow_proc_sigkill())
        let _w: i32 = flow_proc_wait(h.pid, 0, code)
        h.result.exit_code = code[0]
    }
    if h.result.exit_code != 0 - 1 and h.in_fd < 0 and h.out_fd < 0 and h.err_fd < 0 {
        h.finished = true
        h.result.stdout = bb_str(h.out_b)
        h.result.stderr = bb_str(h.err_b)
        h.result.elapsed_ms = flow_proc_now_ms() - h.start_ms
    }
    return h.finished
}

# Spawn a command and return immediately. Captured streams are drained by
# proc_wait or proc_wait_any, so several children can run together.
export function proc_spawn(c: ptr<ProcCmd>) -> ptr<ProcHandle> {
    let h: ptr<ProcHandle> = malloc(160) as ptr<ProcHandle>
    h.pid = 0 - 1
    h.in_fd = 0 - 1
    h.out_fd = 0 - 1
    h.err_fd = 0 - 1
    h.input = c.input
    h.input_len = strlen(c.input)
    h.input_off = 0
    h.out_b = bb_new(4096)
    h.err_b = bb_new(1024)
    h.chunk = malloc(65536) as ptr<u8>
    h.result = proc_result_new()
    h.start_ms = flow_proc_now_ms()
    h.deadline = 0
    h.finished = false
    let pin: ptr<i32> = malloc(8) as ptr<i32>
    let pout: ptr<i32> = malloc(8) as ptr<i32>
    let perr: ptr<i32> = malloc(8) as ptr<i32>
    pin[0] = 0 - 1; pin[1] = 0 - 1
    pout[0] = 0 - 1; pout[1] = 0 - 1
    perr[0] = 0 - 1; perr[1] = 0 - 1
    let feed: bool = c.has_input
    let cap_out: bool = c.out_mode == PROC_CAPTURE and c.out_fd < 0
    let cap_err: bool = c.err_mode == PROC_CAPTURE
    let mut pipe_ok: bool = true
    if feed and c.in_fd < 0 and flow_proc_pipe(pin) != 0 { pipe_ok = false }
    if cap_out and flow_proc_pipe(pout) != 0 { pipe_ok = false }
    if cap_err and flow_proc_pipe(perr) != 0 { pipe_ok = false }
    let mut argv: ptr<string> = c.argv.items
    let mut cwd: string = c.cwd
    if strlen(c.cwd) > 0 and flow_proc_spawn_can_chdir() == 0 {
        let wrapped: ptr<ProcStrs> = proc_strs_new()
        proc_strs_push(wrapped, "/bin/sh")
        proc_strs_push(wrapped, "-c")
        proc_strs_push(wrapped, "cd \"$0\" && exec \"$@\"")
        proc_strs_push(wrapped, c.cwd)
        let mut wi: i32 = 0
        while wi < c.argv.len { proc_strs_push(wrapped, c.argv.items[wi]); wi = wi + 1 }
        argv = wrapped.items
        cwd = ""
    }
    let mut in_fd: i32 = c.in_fd
    let attached_in_fd: i32 = c.in_fd
    if in_fd < 0 and feed { in_fd = pin[0] }
    let mut out_fd: i32 = c.out_fd
    let attached_out_fd: i32 = c.out_fd
    if out_fd < 0 and cap_out { out_fd = pout[1] }
    let mut in_spawn_mode: i32 = proc_fd_mode(c.in_mode)
    let mut out_spawn_mode: i32 = proc_fd_mode(c.out_mode)
    if in_fd >= 0 { in_spawn_mode = FD_PIPE }
    if out_fd >= 0 { out_spawn_mode = FD_PIPE }
    if pipe_ok {
        h.pid = flow_proc_spawn(argv, proc_build_env(c), cwd,
            in_spawn_mode, in_fd,
            out_spawn_mode, out_fd,
            proc_fd_mode(c.err_mode), perr[1])
    }
    if pin[0] >= 0 { let _a: i32 = flow_proc_close(pin[0]) }
    if pout[1] >= 0 { let _b: i32 = flow_proc_close(pout[1]) }
    if perr[1] >= 0 { let _c: i32 = flow_proc_close(perr[1]) }
    if attached_in_fd >= 0 { let _ai: i32 = flow_proc_close(attached_in_fd) }
    if attached_out_fd >= 0 { let _ao: i32 = flow_proc_close(attached_out_fd) }
    if c.in_fd >= 0 { c.in_fd = 0 - 1 }
    if c.out_fd >= 0 { c.out_fd = 0 - 1 }
    h.in_fd = pin[1]
    h.out_fd = pout[0]
    h.err_fd = perr[0]
    if c.in_fd < 0 and feed == false and h.in_fd >= 0 {
        let _d: i32 = flow_proc_close(h.in_fd)
        h.in_fd = 0 - 1
    }
    if c.in_fd < 0 and feed and h.input_len == 0 and h.in_fd >= 0 {
        let _e: i32 = flow_proc_close(h.in_fd)
        h.in_fd = 0 - 1
    }
    if c.out_fd >= 0 { h.out_fd = 0 - 1 }
    if h.pid < 0 {
        proc_handle_close_fds(h)
        h.result.exit_code = 127
        h.result.error = c.argv.items[0] + ": spawn failed"
        h.finished = true
        return h
    }
    h.result.pid = h.pid
    if c.timeout_ms > 0 { h.deadline = h.start_ms + c.timeout_ms }
    return h
}

export function proc_wait(h: ptr<ProcHandle>) -> ptr<ProcResult> {
    while h.finished == false {
        let _d: bool = proc_handle_tick(h, 20)
    }
    return h.result
}

# Wait for whichever child finishes first. index receives its position.
export function proc_wait_any(handles: ptr<ptr<ProcHandle>>, n: i32, index: ptr<i32>) -> ptr<ProcResult> {
    while true {
        let mut i: i32 = 0
        while i < n {
            let h: ptr<ProcHandle> = handles[i]
            let _d: bool = proc_handle_tick(h, 0)
            if h.finished {
                index[0] = i
                return h.result
            }
            i = i + 1
        }
        let _s: i32 = flow_proc_sleep_ms(1)
    }
    return null as ptr<ProcResult>
}

# Run the command to completion and return what it did.
export function proc_run(c: ptr<ProcCmd>) -> ptr<ProcResult> {
    let r: ptr<ProcResult> = proc_result_new()
    let start: i64 = flow_proc_now_ms()
    let mut cwd: string = c.cwd
    let mut argv: ptr<string> = c.argv.items
    if strlen(c.cwd) > 0 and flow_proc_spawn_can_chdir() == 0 {
        # No posix_spawn_file_actions_addchdir_np (glibc before 2.29):
        # let a shell change directory and exec the command.
        let wrapped: ptr<ProcStrs> = proc_strs_new()
        proc_strs_push(wrapped, "/bin/sh")
        proc_strs_push(wrapped, "-c")
        proc_strs_push(wrapped, "cd \"$0\" && exec \"$@\"")
        proc_strs_push(wrapped, c.cwd)
        let mut i: i32 = 0
        while i < c.argv.len {
            proc_strs_push(wrapped, c.argv.items[i])
            i = i + 1
        }
        argv = wrapped.items
        cwd = ""
    }

    # Pipes: [read end, write end] for each captured stream.
    let pin: ptr<i32> = malloc(8) as ptr<i32>
    let pout: ptr<i32> = malloc(8) as ptr<i32>
    let perr: ptr<i32> = malloc(8) as ptr<i32>
    pin[0] = 0 - 1
    pin[1] = 0 - 1
    pout[0] = 0 - 1
    pout[1] = 0 - 1
    perr[0] = 0 - 1
    perr[1] = 0 - 1
    let feed: bool = c.has_input
    let cap_out: bool = c.out_mode == PROC_CAPTURE
    let cap_err: bool = c.err_mode == PROC_CAPTURE
    let mut pipe_ok: bool = true
    if feed and flow_proc_pipe(pin) != 0 {
        pipe_ok = false
    }
    if cap_out and flow_proc_pipe(pout) != 0 {
        pipe_ok = false
    }
    if cap_err and flow_proc_pipe(perr) != 0 {
        pipe_ok = false
    }
    let mut in_mode: i32 = proc_fd_mode(c.in_mode)
    if feed {
        in_mode = FD_PIPE
    }
    let mut pid: i32 = 0 - 1
    if pipe_ok {
        pid = flow_proc_spawn(argv, proc_build_env(c), cwd, in_mode, pin[0], proc_fd_mode(c.out_mode), pout[1], proc_fd_mode(c.err_mode), perr[1])
    }
    # The child has its copies; close ours of the child's ends.
    if pin[0] >= 0 {
        let _c0: i32 = flow_proc_close(pin[0])
    }
    if pout[1] >= 0 {
        let _c1: i32 = flow_proc_close(pout[1])
    }
    if perr[1] >= 0 {
        let _c2: i32 = flow_proc_close(perr[1])
    }
    if pid < 0 {
        if pin[1] >= 0 {
            let _c3: i32 = flow_proc_close(pin[1])
        }
        if pout[0] >= 0 {
            let _c4: i32 = flow_proc_close(pout[0])
        }
        if perr[0] >= 0 {
            let _c5: i32 = flow_proc_close(perr[0])
        }
        r.exit_code = 127
        if pipe_ok {
            r.error = c.argv.items[0] + ": " + flow_proc_strerror(0 - pid)
        } else {
            r.error = "pipe: " + flow_proc_strerror(flow_proc_errno())
        }
        r.elapsed_ms = flow_proc_now_ms() - start
        return r
    }
    r.pid = pid

    let mut deadline: i64 = 0
    if c.timeout_ms > 0 {
        deadline = start + c.timeout_ms
    }
    let out_b: ptr<ByteBuf> = bb_new(4096)
    let err_b: ptr<ByteBuf> = bb_new(1024)
    let chunk: ptr<u8> = malloc(65536) as ptr<u8>
    let fds: ptr<i32> = malloc(12) as ptr<i32>
    let evs: ptr<i32> = malloc(12) as ptr<i32>
    let rev: ptr<i32> = malloc(12) as ptr<i32>
    let mut in_fd: i32 = pin[1]
    let mut out_fd: i32 = pout[0]
    let mut err_fd: i32 = perr[0]
    let input: ptr<u8> = c.input as ptr<u8>
    let in_len: i64 = strlen(c.input)
    let mut in_off: i64 = 0
    if in_fd >= 0 and in_len == 0 {
        let _ci: i32 = flow_proc_close(in_fd)
        in_fd = 0 - 1
    }
    while in_fd >= 0 or out_fd >= 0 or err_fd >= 0 {
        let mut wait_ms: i32 = 0 - 1
        if deadline > 0 {
            let left: i64 = deadline - flow_proc_now_ms()
            if left <= 0 {
                r.timed_out = true
                break
            }
            wait_ms = left as i32
            if left > 1000000 {
                wait_ms = 1000000
            }
        }
        let mut n: i32 = 0
        if in_fd >= 0 {
            fds[n] = in_fd
            evs[n] = 2
            n = n + 1
        }
        if out_fd >= 0 {
            fds[n] = out_fd
            evs[n] = 1
            n = n + 1
        }
        if err_fd >= 0 {
            fds[n] = err_fd
            evs[n] = 1
            n = n + 1
        }
        let ready: i32 = flow_proc_poll(fds, evs, rev, n, wait_ms)
        if ready < 0 {
            break
        }
        let mut k: i32 = 0
        while k < n {
            if rev[k] != 0 {
                let fd: i32 = fds[k]
                if fd == in_fd {
                    # At most 512 bytes (PIPE_BUF on every platform) per
                    # write, so a write after POLLOUT never blocks.
                    let mut step: i64 = in_len - in_off
                    if step > 512 {
                        step = 512
                    }
                    let put: i64 = flow_proc_write(in_fd, input, in_off, step)
                    if put > 0 {
                        in_off = in_off + put
                    }
                    if put < 0 or in_off >= in_len or rev[k] == 2 {
                        let _ci2: i32 = flow_proc_close(in_fd)
                        in_fd = 0 - 1
                    }
                } elif fd == out_fd {
                    if proc_drain(out_fd, out_b, chunk) == false {
                        let _co: i32 = flow_proc_close(out_fd)
                        out_fd = 0 - 1
                    }
                } elif fd == err_fd {
                    if proc_drain(err_fd, err_b, chunk) == false {
                        let _ce: i32 = flow_proc_close(err_fd)
                        err_fd = 0 - 1
                    }
                }
            }
            k = k + 1
        }
    }
    if in_fd >= 0 {
        let _x0: i32 = flow_proc_close(in_fd)
    }
    if out_fd >= 0 {
        let _x1: i32 = flow_proc_close(out_fd)
    }
    if err_fd >= 0 {
        let _x2: i32 = flow_proc_close(err_fd)
    }
    if r.timed_out {
        let _k: i32 = flow_proc_kill(pid, flow_proc_sigkill())
    }
    r.exit_code = proc_reap(pid, deadline, r)
    r.stdout = bb_str(out_b)
    r.stderr = bb_str(err_b)
    bb_free(out_b)
    bb_free(err_b)
    r.elapsed_ms = flow_proc_now_ms() - start
    return r
}

# Run with stdout and stderr passed through; return the exit code.
export function proc_status(c: ptr<ProcCmd>) -> i32 {
    proc_stdout(c, PROC_INHERIT)
    proc_stderr(c, PROC_INHERIT)
    let r: ptr<ProcResult> = proc_run(c)
    return r.exit_code
}

# stdout of `c`, or "" when it could not start. stderr passes through.
export function proc_output(c: ptr<ProcCmd>) -> string {
    proc_stderr(c, PROC_INHERIT)
    let r: ptr<ProcResult> = proc_run(c)
    return r.stdout
}

# True when the command started and exited 0 within its time limit.
export function proc_ok(r: ptr<ProcResult>) -> bool {
    return r.exit_code == 0 and r.timed_out == false and strlen(r.error) == 0
}

# ---------------------------------------------------------------------------
# This program
# ---------------------------------------------------------------------------

# Number of command-line arguments, the program name included.
export function proc_argc() -> i32 {
    return flow_proc_argc()
}

# Argument `i` (0 is the program name), or "" past the end.
export function proc_argv(i: i32) -> string {
    let s: string = flow_proc_argv(i)
    if (s as ptr<u8>) == null {
        return ""
    }
    return s
}

# All arguments after the program name.
export function proc_args() -> ptr<ProcStrs> {
    let l: ptr<ProcStrs> = proc_strs_new()
    let n: i32 = flow_proc_argc()
    let mut i: i32 = 1
    while i < n {
        proc_strs_push(l, flow_proc_argv(i))
        i = i + 1
    }
    return l
}

# The value of environment variable `name`, or "" when it is unset.
export function proc_getenv(name: string) -> string {
    let v: string = getenv(name)
    if (v as ptr<u8>) == null {
        return ""
    }
    return v
}

export function proc_has_env(name: string) -> bool {
    return (getenv(name) as ptr<u8>) != null
}

export function proc_setenv(name: string, value: string) -> bool {
    return setenv(name, value, 1) == 0
}

export function proc_unsetenv(name: string) -> bool {
    return unsetenv(name) == 0
}

# This program's environment as NAME=value strings.
export function proc_environ() -> ptr<ProcStrs> {
    let l: ptr<ProcStrs> = proc_strs_new()
    let n: i32 = flow_proc_environ_count()
    let mut i: i32 = 0
    while i < n {
        proc_strs_push(l, flow_proc_environ_at(i))
        i = i + 1
    }
    return l
}

# The working directory, or "" when it cannot be read.
export function proc_getcwd() -> string {
    let s: string = flow_proc_getcwd()
    if (s as ptr<u8>) == null {
        return ""
    }
    return s
}

export function proc_chdir(dir: string) -> bool {
    return flow_proc_chdir(dir) == 0
}

export function proc_pid() -> i32 {
    return flow_proc_getpid()
}

# Milliseconds on a monotonic clock, for timing.
export function proc_now_ms() -> i64 {
    return flow_proc_now_ms()
}

export function proc_sleep_ms(ms: i32) {
    let _s: i32 = flow_proc_sleep_ms(ms)
}

# The path `name` runs as: `name` itself when it has a slash and is
# executable, else the first executable match on PATH, else "".
export function proc_which(name: string) -> string {
    let p: ptr<u8> = name as ptr<u8>
    let n: i32 = strlen(name) as i32
    if n == 0 {
        return ""
    }
    let mut i: i32 = 0
    while i < n {
        if p[i] == 47 {
            if flow_proc_access_x(name) != 0 {
                return name
            }
            return ""
        }
        i = i + 1
    }
    let path: string = proc_getenv("PATH")
    let pp: ptr<u8> = path as ptr<u8>
    let plen: i32 = strlen(path) as i32
    let mut s: i32 = 0
    while s <= plen {
        let mut e: i32 = s
        while e < plen and pp[e] != 58 {
            e = e + 1
        }
        # An empty PATH entry means the current directory.
        let mut dir: string = "."
        if e > s {
            let d: ptr<u8> = malloc((e - s + 1) as i64) as ptr<u8>
            let mut k: i32 = 0
            while k < e - s {
                d[k] = pp[s + k]
                k = k + 1
            }
            d[e - s] = 0
            dir = d as string
        }
        let cand: string = dir + "/" + name
        if flow_proc_access_x(cand) != 0 {
            return cand
        }
        s = e + 1
    }
    return ""
}

# errno after the last failed system call, and its text.
export function proc_errno() -> i32 {
    return flow_proc_errno()
}

export function proc_strerror(e: i32) -> string {
    return flow_proc_strerror(e)
}
