# errno, signals and the C constants that go with them (issue #1075).
#
#   import std.os { os_errno, os_signal_watch, os_signal_take, SIGINT, EINTR }
#
# The constants below are `extern const` declarations: each names the C
# macro of the same name, so its value comes from this platform's headers
# when the C output is compiled (SIGCHLD is 20 on macOS and 17 on Linux).
# A program can declare more the same way, for any header the C output
# includes:
#
#   extern {
#       const SIGWINCH: i32
#       const STAT_SIZE: i64 = "(int64_t)sizeof(struct stat)"
#   }
#
# errno is a macro over a per-thread location (__error() on macOS,
# __errno_location() on Linux), so it is read through os_errno().
#
# Signals: os_signal_watch(sig) installs a C handler that only counts
# deliveries; the program polls with os_signal_take(sig), which is safe to
# do from any Flow code. os_signal_handle(sig, f as ptr<void>) installs a
# Flow function `f(sig: i32)` as the handler itself. It then runs inside
# the signal, where only async-signal-safe work is allowed.

@cEmbed("#include <errno.h>
#include <signal.h>
static volatile sig_atomic_t flow_os_sig_counts[65];
static void flow_os_sig_count(int s) { if (s > 0 && s < 65) { flow_os_sig_counts[s] = flow_os_sig_counts[s] + 1; } }
static int32_t flow_os_sig_install(int32_t sig, void (*h)(int)) {
  struct sigaction sa;
  if (sig <= 0 || sig >= 65) { return 0; }
  memset(&sa, 0, sizeof sa);
  sa.sa_handler = h;
  sigemptyset(&sa.sa_mask);
  sa.sa_flags = SA_RESTART;
  return sigaction(sig, &sa, 0) == 0 ? 1 : 0;
}
static int32_t flow_os_sig_watch(int32_t sig) { return flow_os_sig_install(sig, flow_os_sig_count); }
static int32_t flow_os_sig_handle(int32_t sig, void *fn) { return flow_os_sig_install(sig, (void (*)(int))fn); }
static int32_t flow_os_sig_ignore(int32_t sig) { return flow_os_sig_install(sig, SIG_IGN); }
static int32_t flow_os_sig_default(int32_t sig) { return flow_os_sig_install(sig, SIG_DFL); }
static int32_t flow_os_sig_take(int32_t sig) {
  int32_t n;
  if (sig <= 0 || sig >= 65) { return 0; }
  n = (int32_t)flow_os_sig_counts[sig];
  flow_os_sig_counts[sig] = flow_os_sig_counts[sig] - n;
  return n;
}
static int32_t flow_os_sig_peek(int32_t sig) { return (sig > 0 && sig < 65) ? (int32_t)flow_os_sig_counts[sig] : 0; }
static int32_t flow_os_raise(int32_t sig) { return (int32_t)raise(sig); }
static int32_t flow_os_errno(void) { return (int32_t)errno; }
static void flow_os_set_errno(int32_t e) { errno = e; }
static const char *flow_os_strerror(int32_t e) { return strerror(e); }
")

extern {
    function flow_os_sig_watch(sig: i32) -> i32
    function flow_os_sig_handle(sig: i32, handler: ptr<void>) -> i32
    function flow_os_sig_ignore(sig: i32) -> i32
    function flow_os_sig_default(sig: i32) -> i32
    function flow_os_sig_take(sig: i32) -> i32
    function flow_os_sig_peek(sig: i32) -> i32
    function flow_os_raise(sig: i32) -> i32
    function flow_os_errno() -> i32
    function flow_os_set_errno(e: i32) -> void
    function flow_os_strerror(e: i32) -> string

    # Signals.
    const SIGHUP: i32
    const SIGINT: i32
    const SIGQUIT: i32
    const SIGABRT: i32
    const SIGKILL: i32
    const SIGPIPE: i32
    const SIGALRM: i32
    const SIGTERM: i32
    const SIGCHLD: i32
    const SIGCONT: i32
    const SIGSTOP: i32
    const SIGTSTP: i32
    const SIGUSR1: i32
    const SIGUSR2: i32
    const SIGWINCH: i32

    # errno values.
    const EPERM: i32
    const ENOENT: i32
    const ESRCH: i32
    const EINTR: i32
    const EIO: i32
    const EBADF: i32
    const ECHILD: i32
    const EAGAIN: i32
    const EWOULDBLOCK: i32
    const ENOMEM: i32
    const EACCES: i32
    const EEXIST: i32
    const ENOTDIR: i32
    const EISDIR: i32
    const EINVAL: i32
    const ENOSPC: i32
    const EPIPE: i32
    const ERANGE: i32
    const EINPROGRESS: i32
    const EADDRINUSE: i32
    const ECONNREFUSED: i32
    const ECONNRESET: i32
    const ETIMEDOUT: i32
}

# errno after the last failed system call.
export function os_errno() -> i32 {
    return flow_os_errno()
}

export function os_set_errno(e: i32) {
    flow_os_set_errno(e)
}

# strerror(e): the system's text for an errno value.
export function os_strerror(e: i32) -> string {
    return flow_os_strerror(e)
}

# Count deliveries of `sig` instead of taking its default action. False
# when the signal cannot be caught (SIGKILL, SIGSTOP) or is out of range.
export function os_signal_watch(sig: i32) -> bool {
    return flow_os_sig_watch(sig) != 0
}

# Deliveries of a watched `sig` since the last call; resets the count.
export function os_signal_take(sig: i32) -> i32 {
    return flow_os_sig_take(sig)
}

# Deliveries of a watched `sig` not yet taken.
export function os_signal_pending(sig: i32) -> i32 {
    return flow_os_sig_peek(sig)
}

# Run `handler`, a Flow function taking the signal number as i32, when
# `sig` arrives. Pass it as `name as ptr<void>`.
export function os_signal_handle(sig: i32, handler: ptr<void>) -> bool {
    return flow_os_sig_handle(sig, handler) != 0
}

export function os_signal_ignore(sig: i32) -> bool {
    return flow_os_sig_ignore(sig) != 0
}

export function os_signal_default(sig: i32) -> bool {
    return flow_os_sig_default(sig) != 0
}

# Send `sig` to this process.
export function os_raise(sig: i32) -> i32 {
    return flow_os_raise(sig)
}
