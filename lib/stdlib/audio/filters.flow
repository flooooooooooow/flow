# Audio Filters Module
#
# Digital filters for audio processing.
# All filters use immutable state pattern: filter_tick(state, input) -> new_state
#
# Usage:
#   import "stdlib/audio.flow"
#   import "stdlib/audio/filters.flow"
#   
#   let rate: SampleRate = sample_rate_44100()
#   let lpf: Biquad = biquad_lowpass(1000.0, 0.707, rate)
#   let lpf2: Biquad = biquad_tick(lpf, input_sample)
#   let output: f32 = biquad_output(lpf2)

import "stdlib/audio.flow"

# =============================================================================
# One-Pole Filter (First Order)
# =============================================================================

# Simple one-pole lowpass/highpass filter
# Good for parameter smoothing and simple filtering
export struct OnePole {
    coeff: f32   # Filter coefficient (0 = no filtering, ~1 = infinite smoothing)
    state: f32   # Filter state (previous output)
}

# Create a one-pole lowpass from cutoff frequency
export function onepole_lowpass(cutoff_hz: f32, rate: SampleRate) -> OnePole {
    # coeff = exp(-2π * cutoff / sample_rate)
    # Approximation: coeff ≈ 1 - (2π * cutoff / sample_rate) for low cutoffs
    let two_pi: f32 = 6.28318
    let ratio: f32 = cutoff_hz / rate.hz
    let mut coeff: f32 = 1.0 - two_pi * ratio
    if coeff < 0.0 {
        coeff = 0.0
    }
    if coeff > 0.999 {
        coeff = 0.999
    }
    return OnePole { coeff: coeff, state: 0.0 }
}

# Create a one-pole from smoothing time in milliseconds
export function onepole_smooth(time_ms: f32, rate: SampleRate) -> OnePole {
    # coeff = exp(-1 / (time_s * sample_rate))
    let time_samples: f32 = time_ms * rate.hz / 1000.0
    if time_samples < 1.0 {
        return OnePole { coeff: 0.0, state: 0.0 }
    }
    let mut coeff: f32 = 1.0 - 1.0 / time_samples
    if coeff < 0.0 {
        coeff = 0.0
    }
    if coeff > 0.999 {
        coeff = 0.999
    }
    return OnePole { coeff: coeff, state: 0.0 }
}

# Process one sample through the filter
export function onepole_tick(f: OnePole, input: f32) -> OnePole {
    # y[n] = (1 - coeff) * x[n] + coeff * y[n-1]
    let output: f32 = (1.0 - f.coeff) * input + f.coeff * f.state
    return OnePole { coeff: f.coeff, state: output }
}

# Get the current output value
export function onepole_output(f: OnePole) -> f32 {
    return f.state
}

# Reset filter state to zero
export function onepole_reset(f: OnePole) -> OnePole {
    return OnePole { coeff: f.coeff, state: 0.0 }
}

# Set filter state directly (for initialization)
export function onepole_set_state(f: OnePole, value: f32) -> OnePole {
    return OnePole { coeff: f.coeff, state: value }
}

# =============================================================================
# DC Blocker
# =============================================================================

# Removes DC offset from signal using a one-pole highpass
export struct DCBlocker {
    coeff: f32
    x1: f32    # Previous input
    y1: f32    # Previous output
}

# Create DC blocker (default: ~10Hz cutoff at 44.1kHz)
export function dcblocker_new(rate: SampleRate) -> DCBlocker {
    # R = 1 - (2π * 10 / sample_rate)
    let mut coeff: f32 = 1.0 - 62.83 / rate.hz
    if coeff < 0.9 {
        coeff = 0.9
    }
    return DCBlocker { coeff: coeff, x1: 0.0, y1: 0.0 }
}

# Process one sample
export function dcblocker_tick(dc: DCBlocker, input: f32) -> DCBlocker {
    # y[n] = x[n] - x[n-1] + R * y[n-1]
    let output: f32 = input - dc.x1 + dc.coeff * dc.y1
    return DCBlocker { coeff: dc.coeff, x1: input, y1: output }
}

# Get output
export function dcblocker_output(dc: DCBlocker) -> f32 {
    return dc.y1
}

# =============================================================================
# Biquad Filter (Second Order)
# =============================================================================

# Standard biquad filter with 5 coefficients
# Transfer function: H(z) = (b0 + b1*z^-1 + b2*z^-2) / (1 + a1*z^-1 + a2*z^-2)
export struct Biquad {
    # Coefficients
    b0: f32
    b1: f32
    b2: f32
    a1: f32
    a2: f32
    # State (Direct Form II Transposed)
    z1: f32
    z2: f32
}

# Create a bypass biquad (passes signal unchanged)
export function biquad_bypass() -> Biquad {
    return Biquad {
        b0: 1.0, b1: 0.0, b2: 0.0,
        a1: 0.0, a2: 0.0,
        z1: 0.0, z2: 0.0
    }
}

# Lowpass filter
# cutoff: frequency in Hz
# q: resonance (0.707 = Butterworth, no resonance)
export function biquad_lowpass(cutoff: f32, q: f32, rate: SampleRate) -> Biquad {
    let omega: f32 = 6.28318 * cutoff / rate.hz
    let sin_omega: f32 = omega - omega * omega * omega / 6.0  # sin approx
    let cos_omega: f32 = 1.0 - omega * omega / 2.0            # cos approx
    let alpha: f32 = sin_omega / (2.0 * q)
    
    let b0: f32 = (1.0 - cos_omega) / 2.0
    let b1: f32 = 1.0 - cos_omega
    let b2: f32 = (1.0 - cos_omega) / 2.0
    let a0: f32 = 1.0 + alpha
    let a1: f32 = -2.0 * cos_omega
    let a2: f32 = 1.0 - alpha
    
    # Normalize by a0
    return Biquad {
        b0: b0 / a0, b1: b1 / a0, b2: b2 / a0,
        a1: a1 / a0, a2: a2 / a0,
        z1: 0.0, z2: 0.0
    }
}

# Highpass filter
export function biquad_highpass(cutoff: f32, q: f32, rate: SampleRate) -> Biquad {
    let omega: f32 = 6.28318 * cutoff / rate.hz
    let sin_omega: f32 = omega - omega * omega * omega / 6.0
    let cos_omega: f32 = 1.0 - omega * omega / 2.0
    let alpha: f32 = sin_omega / (2.0 * q)
    
    let b0: f32 = (1.0 + cos_omega) / 2.0
    let b1: f32 = -(1.0 + cos_omega)
    let b2: f32 = (1.0 + cos_omega) / 2.0
    let a0: f32 = 1.0 + alpha
    let a1: f32 = -2.0 * cos_omega
    let a2: f32 = 1.0 - alpha
    
    return Biquad {
        b0: b0 / a0, b1: b1 / a0, b2: b2 / a0,
        a1: a1 / a0, a2: a2 / a0,
        z1: 0.0, z2: 0.0
    }
}

# Bandpass filter (constant 0dB peak gain)
export function biquad_bandpass(center: f32, q: f32, rate: SampleRate) -> Biquad {
    let omega: f32 = 6.28318 * center / rate.hz
    let sin_omega: f32 = omega - omega * omega * omega / 6.0
    let cos_omega: f32 = 1.0 - omega * omega / 2.0
    let alpha: f32 = sin_omega / (2.0 * q)
    
    let b0: f32 = alpha
    let b1: f32 = 0.0
    let b2: f32 = -alpha
    let a0: f32 = 1.0 + alpha
    let a1: f32 = -2.0 * cos_omega
    let a2: f32 = 1.0 - alpha
    
    return Biquad {
        b0: b0 / a0, b1: b1 / a0, b2: b2 / a0,
        a1: a1 / a0, a2: a2 / a0,
        z1: 0.0, z2: 0.0
    }
}

# Notch filter (band-reject)
export function biquad_notch(center: f32, q: f32, rate: SampleRate) -> Biquad {
    let omega: f32 = 6.28318 * center / rate.hz
    let sin_omega: f32 = omega - omega * omega * omega / 6.0
    let cos_omega: f32 = 1.0 - omega * omega / 2.0
    let alpha: f32 = sin_omega / (2.0 * q)
    
    let b0: f32 = 1.0
    let b1: f32 = -2.0 * cos_omega
    let b2: f32 = 1.0
    let a0: f32 = 1.0 + alpha
    let a1: f32 = -2.0 * cos_omega
    let a2: f32 = 1.0 - alpha
    
    return Biquad {
        b0: b0 / a0, b1: b1 / a0, b2: b2 / a0,
        a1: a1 / a0, a2: a2 / a0,
        z1: 0.0, z2: 0.0
    }
}

# All-pass filter (phase shift, no amplitude change)
export function biquad_allpass(center: f32, q: f32, rate: SampleRate) -> Biquad {
    let omega: f32 = 6.28318 * center / rate.hz
    let sin_omega: f32 = omega - omega * omega * omega / 6.0
    let cos_omega: f32 = 1.0 - omega * omega / 2.0
    let alpha: f32 = sin_omega / (2.0 * q)
    
    let b0: f32 = 1.0 - alpha
    let b1: f32 = -2.0 * cos_omega
    let b2: f32 = 1.0 + alpha
    let a0: f32 = 1.0 + alpha
    let a1: f32 = -2.0 * cos_omega
    let a2: f32 = 1.0 - alpha
    
    return Biquad {
        b0: b0 / a0, b1: b1 / a0, b2: b2 / a0,
        a1: a1 / a0, a2: a2 / a0,
        z1: 0.0, z2: 0.0
    }
}

# Process one sample through biquad (Direct Form II Transposed)
export function biquad_tick(f: Biquad, input: f32) -> Biquad {
    let output: f32 = input * f.b0 + f.z1
    let new_z1: f32 = input * f.b1 - output * f.a1 + f.z2
    let new_z2: f32 = input * f.b2 - output * f.a2
    
    return Biquad {
        b0: f.b0, b1: f.b1, b2: f.b2,
        a1: f.a1, a2: f.a2,
        z1: new_z1, z2: new_z2
    }
}

# Get the output from last tick (stored in z1 calculation)
# Note: The actual output should be stored; this is a simplified version
export function biquad_output(f: Biquad) -> f32 {
    # For proper implementation, output should be stored in struct
    # This returns z1 as a proxy (not accurate for first sample)
    return f.z1
}

# Process and return output in one call (convenience)
export function biquad_process(f: Biquad, input: f32) -> f32 {
    let output: f32 = input * f.b0 + f.z1
    return output
}

# Reset filter state
export function biquad_reset(f: Biquad) -> Biquad {
    return Biquad {
        b0: f.b0, b1: f.b1, b2: f.b2,
        a1: f.a1, a2: f.a2,
        z1: 0.0, z2: 0.0
    }
}

# Update cutoff frequency (recalculates coefficients for lowpass)
export function biquad_set_cutoff(f: Biquad, cutoff: f32, q: f32, rate: SampleRate) -> Biquad {
    let new_filter: Biquad = biquad_lowpass(cutoff, q, rate)
    # Preserve state for smooth transitions
    return Biquad {
        b0: new_filter.b0, b1: new_filter.b1, b2: new_filter.b2,
        a1: new_filter.a1, a2: new_filter.a2,
        z1: f.z1, z2: f.z2
    }
}

# =============================================================================
# State Variable Filter (SVF)
# =============================================================================

# Multi-mode filter with simultaneous lowpass, highpass, bandpass outputs
export struct SVF {
    g: f32       # Frequency coefficient
    k: f32       # Damping coefficient (1/Q)
    ic1eq: f32   # Integrator 1 state
    ic2eq: f32   # Integrator 2 state
}

# Create SVF from cutoff and Q
export function svf_new(cutoff: f32, q: f32, rate: SampleRate) -> SVF {
    # g = tan(π * cutoff / sample_rate)
    let pi_fc: f32 = 3.14159 * cutoff / rate.hz
    # tan approximation for small angles
    let mut g: f32 = pi_fc + pi_fc * pi_fc * pi_fc / 3.0
    let k: f32 = 1.0 / q
    return SVF { g: g, k: k, ic1eq: 0.0, ic2eq: 0.0 }
}

# Process one sample, returns lowpass output
export function svf_tick_lowpass(f: SVF, input: f32) -> SVF {
    let v0: f32 = input
    let v3: f32 = v0 - f.ic2eq
    let v1: f32 = f.ic1eq + f.g * (v3 - f.k * f.ic1eq)
    let v2: f32 = f.ic2eq + f.g * v1
    
    return SVF { g: f.g, k: f.k, ic1eq: v1, ic2eq: v2 }
}

# Get lowpass output
export function svf_lowpass(f: SVF) -> f32 {
    return f.ic2eq
}

# Get highpass output
export function svf_highpass(f: SVF, input: f32) -> f32 {
    return input - f.k * f.ic1eq - f.ic2eq
}

# Get bandpass output
export function svf_bandpass(f: SVF) -> f32 {
    return f.ic1eq
}

# Reset SVF state
export function svf_reset(f: SVF) -> SVF {
    return SVF { g: f.g, k: f.k, ic1eq: 0.0, ic2eq: 0.0 }
}
