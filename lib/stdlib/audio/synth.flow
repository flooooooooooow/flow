# Synth Presets Module - Ready-to-Use Instruments
#
# Pre-configured synthesizers that sound good out of the box.
# Easier than any other language - just pick a synth and play!
#
# Usage:
#   import "stdlib/audio/synth.flow"
#
#   let synth: Synth = synth_bass()
#   let sample: f32 = synth_tick(synth, note_C(3))

import "stdlib/audio.flow"
import "stdlib/audio/oscillators.flow"
import "stdlib/audio/envelopes.flow"
import "stdlib/audio/filters.flow"

# =============================================================================
# Synth State
# =============================================================================

# Simple monophonic synth state
export struct Synth {
    osc1: Phasor
    osc2: Phasor
    env: ADSREnvelope
    filter: Biquad
    filter_cutoff: f32
    filter_res: f32
    mix: f32              # Osc1/Osc2 mix (0.0 = osc1, 1.0 = osc2)
    detune: f64           # Osc2 detune amount (cents)
    waveform1: i32        # 0=sine, 1=saw, 2=square, 3=triangle
    waveform2: i32
}

# Envelope state
export struct ADSREnvelope {
    attack: f64          # Attack time in samples
    decay: f64           # Decay time in samples
    sustain: f32         # Sustain level (0.0 to 1.0)
    release: f64         # Release time in samples
    current: f32         # Current envelope value
    stage: i32           # 0=off, 1=attack, 2=decay, 3=sustain, 4=release
    time: i64            # Time in current stage
}

# =============================================================================
# Waveform Generation
# =============================================================================

function generate_waveform(phase: f64, waveform: i32) -> f32 {
    if waveform == 0 {
        # Sine wave
        return sine(phase)
    } elif waveform == 1 {
        # Sawtooth
        return 2.0 * phase - 1.0
    } elif waveform == 2 {
        # Square wave
        if phase < 0.5 {
            return 1.0
        } else {
            return -1.0
        }
    } else {
        # Triangle wave
        if phase < 0.5 {
            return 4.0 * phase - 1.0
        } else {
            return 3.0 - 4.0 * phase
        }
    }
}

# =============================================================================
# Preset Constructors
# =============================================================================

# Deep bass synth - thick and powerful
export function synth_bass() -> Synth {
    let rate: SampleRate = sample_rate_44100()
    let env: ADSREnvelope = envelope_new(
        220.0,      # 5ms attack
        4410.0,     # 100ms decay
        0.7,        # 70% sustain
        8820.0      # 200ms release
    )

    return Synth {
        osc1: phasor_new(100.0, rate),
        osc2: phasor_new(100.0, rate),
        env: env,
        filter: biquad_lowpass(800.0, 0.7, rate),
        filter_cutoff: 800.0,
        filter_res: 0.7,
        mix: 0.5,
        detune: 7.0,        # 7 cents detune for fatness
        waveform1: 1,       # Sawtooth
        waveform2: 2        # Square
    }
}

# Lead synth - bright and cutting
export function synth_lead() -> Synth {
    let rate: SampleRate = sample_rate_44100()
    let env: ADSREnvelope = envelope_new(
        882.0,      # 20ms attack
        2205.0,     # 50ms decay
        0.8,        # 80% sustain
        4410.0      # 100ms release
    )

    return Synth {
        osc1: phasor_new(440.0, rate),
        osc2: phasor_new(440.0, rate),
        env: env,
        filter: biquad_lowpass(3000.0, 0.5, rate),
        filter_cutoff: 3000.0,
        filter_res: 0.5,
        mix: 0.7,
        detune: 12.0,       # 12 cents detune
        waveform1: 1,       # Sawtooth
        waveform2: 1        # Sawtooth
    }
}

# Pad synth - lush and atmospheric
export function synth_pad() -> Synth {
    let rate: SampleRate = sample_rate_44100()
    let env: ADSREnvelope = envelope_new(
        22050.0,    # 500ms attack (slow)
        11025.0,    # 250ms decay
        0.9,        # 90% sustain
        22050.0     # 500ms release (long)
    )

    return Synth {
        osc1: phasor_new(220.0, rate),
        osc2: phasor_new(220.0, rate),
        env: env,
        filter: biquad_lowpass(1200.0, 0.3, rate),
        filter_cutoff: 1200.0,
        filter_res: 0.3,
        mix: 0.5,
        detune: 5.0,        # Slight detune for width
        waveform1: 1,       # Sawtooth
        waveform2: 3        # Triangle
    }
}

# Pluck synth - percussive and bright
export function synth_pluck() -> Synth {
    let rate: SampleRate = sample_rate_44100()
    let env: ADSREnvelope = envelope_new(
        44.0,       # 1ms attack (instant)
        4410.0,     # 100ms decay
        0.0,        # 0% sustain (dies out)
        2205.0      # 50ms release
    )

    return Synth {
        osc1: phasor_new(330.0, rate),
        osc2: phasor_new(330.0, rate),
        env: env,
        filter: biquad_lowpass(2000.0, 0.4, rate),
        filter_cutoff: 2000.0,
        filter_res: 0.4,
        mix: 0.3,
        detune: 3.0,
        waveform1: 2,       # Square
        waveform2: 3        # Triangle
    }
}

# Organ synth - classic tone wheel sound
export function synth_organ() -> Synth {
    let rate: SampleRate = sample_rate_44100()
    let env: ADSREnvelope = envelope_new(
        44.0,       # 1ms attack (instant)
        441.0,      # 10ms decay
        1.0,        # 100% sustain (organ-like)
        882.0       # 20ms release (quick)
    )

    return Synth {
        osc1: phasor_new(262.0, rate),
        osc2: phasor_new(262.0, rate),
        env: env,
        filter: biquad_lowpass(5000.0, 0.2, rate),
        filter_cutoff: 5000.0,
        filter_res: 0.2,
        mix: 0.5,
        detune: 0.0,        # No detune (pure)
        waveform1: 0,       # Sine
        waveform2: 0        # Sine
    }
}

# FM synth - digital and metallic
export function synth_fm() -> Synth {
    let rate: SampleRate = sample_rate_44100()
    let env: ADSREnvelope = envelope_new(
        220.0,      # 5ms attack
        2205.0,     # 50ms decay
        0.6,        # 60% sustain
        3307.0      # 75ms release
    )

    return Synth {
        osc1: phasor_new(440.0, rate),
        osc2: phasor_new(880.0, rate),  # 2x frequency for FM
        env: env,
        filter: biquad_lowpass(8000.0, 0.3, rate),
        filter_cutoff: 8000.0,
        filter_res: 0.3,
        mix: 0.4,
        detune: 0.0,
        waveform1: 0,       # Sine
        waveform2: 0        # Sine
    }
}

# Sub bass - deep rumble
export function synth_sub() -> Synth {
    let rate: SampleRate = sample_rate_44100()
    let env: ADSREnvelope = envelope_new(
        882.0,      # 20ms attack
        2205.0,     # 50ms decay
        0.8,        # 80% sustain
        6615.0      # 150ms release
    )

    return Synth {
        osc1: phasor_new(55.0, rate),
        osc2: phasor_new(55.0, rate),
        env: env,
        filter: biquad_lowpass(150.0, 0.8, rate),
        filter_cutoff: 150.0,   # Very low cutoff
        filter_res: 0.8,        # High resonance
        mix: 0.5,
        detune: 0.0,
        waveform1: 0,       # Sine (clean sub)
        waveform2: 0        # Sine
    }
}

# Brass synth - punchy and bright
export function synth_brass() -> Synth {
    let rate: SampleRate = sample_rate_44100()
    let env: ADSREnvelope = envelope_new(
        2205.0,     # 50ms attack
        4410.0,     # 100ms decay
        0.75,       # 75% sustain
        4410.0      # 100ms release
    )

    return Synth {
        osc1: phasor_new(220.0, rate),
        osc2: phasor_new(220.0, rate),
        env: env,
        filter: biquad_lowpass(2500.0, 0.6, rate),
        filter_cutoff: 2500.0,
        filter_res: 0.6,
        mix: 0.6,
        detune: 8.0,
        waveform1: 1,       # Sawtooth
        waveform2: 2        # Square
    }
}

# =============================================================================
# Envelope Functions
# =============================================================================

function envelope_new(attack: f64, decay: f64, sustain: f32, release: f64) -> ADSREnvelope {
    return ADSREnvelope {
        attack: attack,
        decay: decay,
        sustain: sustain,
        release: release,
        current: 0.0,
        stage: 0,
        time: 0
    }
}

function envelope_tick(env: ADSREnvelope, gate: bool) -> ADSREnvelope {
    let mut new_env: ADSREnvelope = env

    if gate {
        if new_env.stage == 0 {
            # Start attack
            new_env.stage = 1
            new_env.time = 0
        }

        if new_env.stage == 1 {
            # Attack stage
            new_env.current = new_env.time / new_env.attack
            new_env.time = new_env.time + 1
            if new_env.current >= 1.0 {
                new_env.stage = 2
                new_env.time = 0
            }
        } elif new_env.stage == 2 {
            # Decay stage
            let decay_progress: f32 = new_env.time / new_env.decay
            new_env.current = 1.0 - (1.0 - new_env.sustain) * decay_progress
            new_env.time = new_env.time + 1
            if decay_progress >= 1.0 {
                new_env.stage = 3
            }
        }
        # Sustain stage (new_env.stage == 3) - hold at sustain level
    } else {
        # Gate off - enter release
        if new_env.stage != 0 and new_env.stage != 4 {
            new_env.stage = 4
            new_env.time = 0
        }

        if new_env.stage == 4 {
            let release_progress: f32 = new_env.time / new_env.release
            new_env.current = new_env.current * (1.0 - release_progress)
            new_env.time = new_env.time + 1
            if release_progress >= 1.0 {
                new_env.stage = 0
                new_env.current = 0.0
            }
        }
    }

    return new_env
}

# =============================================================================
# Synth Tick (Generate Sample)
# =============================================================================

# Generate one sample from the synth
export function synth_tick(synth: Synth, freq: f32, gate: bool) -> f32 {
    # Update oscillators with frequency
    let rate: SampleRate = sample_rate_44100()
    let osc1: Phasor = phasor_set_freq(synth.osc1, freq, rate)
    let osc2: Phasor = phasor_set_freq(synth.osc2, freq * (1.0 + synth.detune / 1200.0), rate)

    # Generate waveforms
    let wave1: f32 = generate_waveform(phasor_value(osc1), synth.waveform1)
    let wave2: f32 = generate_waveform(phasor_value(osc2), synth.waveform2)

    # Mix oscillators
    let mixed: f32 = wave1 * (1.0 - synth.mix) + wave2 * synth.mix

    # Apply envelope
    let env: ADSREnvelope = envelope_tick(synth.env, gate)
    let output: f32 = mixed * env.current

    # Apply filter
    let filtered_output: f32 = biquad_process(synth.filter, output)

    return filtered_output
}
