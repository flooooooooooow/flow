# Audio Effects Module - Common Effects Processors
#
# Ready-to-use effects: reverb, delay, distortion, chorus, etc.
# Easier than any plugin or effect library!
#
# Usage:
#   import "stdlib/audio/effects.flow"
#
#   let delay: Delay = delay_quarter_note(clock)
#   let wet: f32 = delay_process(delay, dry_signal)

import "stdlib/audio.flow"
import "stdlib/audio/delay_line.flow"
import "stdlib/audio/clock.flow"

# =============================================================================
# Delay Effect
# =============================================================================

export struct Delay {
    buffer: DelayLineF32
    time_samples: i32     # Delay time in samples
    feedback: f32         # Feedback amount (0.0 to 1.0)
    mix: f32             # Dry/wet mix (0.0 = dry, 1.0 = wet)
}

# Create a delay with time in samples (assumes 44.1kHz; use delay_new_at_rate
# for other sample rates)
export function delay_new(time_samples: i32, feedback: f32, mix: f32) -> Delay {
    let rate: SampleRate = sample_rate_44100()
    return delay_new_at_rate(time_samples, feedback, mix, rate)
}

# Create a delay with time in samples at a specific sample rate
export function delay_new_at_rate(time_samples: i32, feedback: f32, mix: f32, rate: SampleRate) -> Delay {
    let time_ms: f32 = (time_samples / rate.hz) * 1000.0
    # Give the underlying delay line some headroom above the requested time
    # so later calls to delay_set_time (if added) don't need reallocation.
    let max_ms: f32 = time_ms * 2.0 + 10.0
    let base: DelayLineF32 = delay_line_new(max_ms, rate)
    let timed: DelayLineF32 = delay_line_set_time(base, time_ms, rate)
    let with_fb: DelayLineF32 = delay_line_set_feedback(timed, feedback)
    let with_mix: DelayLineF32 = delay_line_set_mix(with_fb, mix)
    return Delay {
        buffer: with_mix,
        time_samples: time_samples,
        feedback: feedback,
        mix: mix
    }
}

# Create a delay synced to clock (quarter note)
export function delay_quarter_note(clock: Clock) -> Delay {
    let time: i32 = samples_per_quarter(clock)
    return delay_new(time, 0.5, 0.3)
}

# Create a delay synced to clock (eighth note)
export function delay_eighth_note(clock: Clock) -> Delay {
    let time: i32 = samples_per_eighth(clock)
    return delay_new(time, 0.6, 0.25)
}

# Create a delay synced to clock (dotted eighth - classic dub delay)
export function delay_dotted_eighth(clock: Clock) -> Delay {
    let time: i32 = samples_per_eighth(clock) * 1.5
    return delay_new(time, 0.65, 0.4)
}

# Process one sample through delay
# Note: this returns only the output sample (matching the historical API);
# use delay_tick if you need the updated Delay state for the next call.
export function delay_process(delay: Delay, input: f32) -> f32 {
    let ticked: DelayLineF32 = delay_line_tick(delay.buffer, input)
    return delay_line_output(ticked)
}

# Process one sample through delay, returning the updated Delay state
# (threading this back in on the next call gives a real running delay line).
export function delay_tick(delay: Delay, input: f32) -> Delay {
    let ticked: DelayLineF32 = delay_line_tick(delay.buffer, input)
    return Delay {
        buffer: ticked,
        time_samples: delay.time_samples,
        feedback: delay.feedback,
        mix: delay.mix
    }
}

# Get the last output sample from a Delay (after delay_tick)
export function delay_output(delay: Delay) -> f32 {
    return delay_line_output(delay.buffer)
}

# =============================================================================
# Distortion / Saturation
# =============================================================================

export struct Distortion {
    drive: f32        # Input gain (1.0 to 10.0+)
    tone: f32         # Tone control (0.0 = dark, 1.0 = bright)
    mix: f32          # Dry/wet mix
}

export function distortion_new(drive: f32, tone: f32, mix: f32) -> Distortion {
    return Distortion {
        drive: drive,
        tone: tone,
        mix: mix
    }
}

# Presets
export function distortion_light() -> Distortion {
    return distortion_new(2.0, 0.6, 0.5)
}

export function distortion_medium() -> Distortion {
    return distortion_new(4.0, 0.5, 0.7)
}

export function distortion_heavy() -> Distortion {
    return distortion_new(8.0, 0.4, 0.9)
}

export function distortion_fuzz() -> Distortion {
    return distortion_new(15.0, 0.3, 1.0)
}

# Process one sample
export function distortion_process(dist: Distortion, input: f32) -> f32 {
    # Apply drive
    let driven: f32 = input * dist.drive

    # Soft clipping (tanh-like)
    let clipped: f32 = soft_clip(driven)

    # Simple tone control (low-pass simulation)
    # In reality, would use a filter
    let toned: f32 = clipped * dist.tone + clipped * 0.5 * (1.0 - dist.tone)

    # Mix
    let mut output: f32 = input * (1.0 - dist.mix) + toned * dist.mix

    return output
}

# =============================================================================
# Chorus Effect
# =============================================================================

export struct Chorus {
    delay: DelayLineF32
    rate: f32          # LFO rate in Hz
    depth: f32         # Modulation depth in samples
    mix: f32
    phase: f32         # LFO phase
}

export function chorus_new(rate: f32, depth: f32, mix: f32) -> Chorus {
    let sr: SampleRate = sample_rate_44100()
    let base: DelayLineF32 = delay_line_new(30.0, sr)  # Max delay ~30ms
    let timed: DelayLineF32 = delay_line_set_time(base, 15.0, sr)
    let with_mix: DelayLineF32 = delay_line_set_mix(timed, mix)
    return Chorus {
        delay: with_mix,
        rate: rate,
        depth: depth,
        mix: mix,
        phase: 0.0
    }
}

# Presets
export function chorus_subtle() -> Chorus {
    return chorus_new(0.5, 100.0, 0.3)
}

export function chorus_medium() -> Chorus {
    return chorus_new(1.0, 200.0, 0.5)
}

export function chorus_wide() -> Chorus {
    return chorus_new(2.0, 400.0, 0.7)
}

# Process one sample (simplified - would need LFO from oscillators)
# Note: this returns only the output sample (matching the historical API);
# use chorus_tick if you need the updated Chorus state for the next call.
export function chorus_process(chorus: Chorus, input: f32) -> f32 {
    let ticked: DelayLineF32 = delay_line_tick(chorus.delay, input)
    return delay_line_output(ticked)
}

# Process one sample through the chorus, returning the updated Chorus state
export function chorus_tick(chorus: Chorus, input: f32) -> Chorus {
    let sr: SampleRate = sample_rate_44100()
    let lfo: f32 = sine_approx(chorus.phase)
    let mod_ms: f32 = 15.0 + lfo * (chorus.depth / sr.hz) * 1000.0
    let retimed: DelayLineF32 = delay_line_set_time(chorus.delay, mod_ms, sr)
    let ticked: DelayLineF32 = delay_line_tick(retimed, input)
    let mut new_phase: f32 = chorus.phase + chorus.rate * 0.0001
    if new_phase >= 1.0 {
        new_phase = new_phase - 1.0
    }
    return Chorus {
        delay: ticked,
        rate: chorus.rate,
        depth: chorus.depth,
        mix: chorus.mix,
        phase: new_phase
    }
}

# Simple sine approximation for LFO
function sine_approx(phase: f32) -> f32 {
    # Use phase-based approximation
    if phase < 0.5 {
        return 4.0 * phase * (1.0 - phase)  # Parabola approximation
    } else {
        let p: f32 = phase - 0.5
        return -4.0 * p * (1.0 - p)
    }
}

# =============================================================================
# Compressor / Limiter
# =============================================================================

export struct Compressor {
    threshold: f32     # Threshold in linear amplitude (0.0 to 1.0)
    ratio: f32         # Compression ratio (1.0 = no compression, 10.0 = limiting)
    attack: f32        # Attack time in samples
    release: f32       # Release time in samples
    gain_reduction: f32  # Current gain reduction
}

export function compressor_new(threshold: f32, ratio: f32, attack: f32, release: f32) -> Compressor {
    return Compressor {
        threshold: threshold,
        ratio: ratio,
        attack: attack,
        release: release,
        gain_reduction: 1.0
    }
}

# Presets
export function compressor_gentle() -> Compressor {
    return compressor_new(0.7, 2.0, 100.0, 1000.0)
}

export function compressor_medium() -> Compressor {
    return compressor_new(0.5, 4.0, 50.0, 500.0)
}

export function compressor_hard() -> Compressor {
    return compressor_new(0.3, 8.0, 10.0, 200.0)
}

export function limiter() -> Compressor {
    return compressor_new(0.9, 20.0, 1.0, 100.0)
}

# Process one sample (simplified envelope follower)
export function compressor_process(comp: Compressor, input: f32) -> f32 {
    # Get absolute value
    let mut level: f32 = input
    if level < 0.0 {
        level = -level
    }

    # Calculate target gain reduction
    let mut target_gain: f32 = 1.0
    if level > comp.threshold {
        let over: f32 = level - comp.threshold
        let compressed: f32 = over / comp.ratio
        target_gain = (comp.threshold + compressed) / level
    }

    # Smooth gain reduction (attack/release)
    let mut new_gain: f32 = comp.gain_reduction
    if target_gain < new_gain {
        # Attack
        new_gain = new_gain - (new_gain - target_gain) / comp.attack
    } else {
        # Release
        new_gain = new_gain + (target_gain - new_gain) / comp.release
    }

    # Apply gain reduction
    let mut output: f32 = input * new_gain

    return output
}

# =============================================================================
# Bitcrusher / Lo-Fi Effect
# =============================================================================

export struct Bitcrusher {
    bits: i32          # Bit depth (1 to 16)
    sample_rate_div: i32  # Sample rate divider
    counter: i32       # Internal counter
    held_sample: f32   # Sample & hold value
}

export function bitcrusher_new(bits: i32, sample_rate_div: i32) -> Bitcrusher {
    return Bitcrusher {
        bits: bits,
        sample_rate_div: sample_rate_div,
        counter: 0,
        held_sample: 0.0
    }
}

# Presets
export function bitcrusher_lofi() -> Bitcrusher {
    return bitcrusher_new(8, 4)   # 8-bit, 1/4 sample rate
}

export function bitcrusher_telephone() -> Bitcrusher {
    return bitcrusher_new(6, 8)   # 6-bit, 1/8 sample rate
}

export function bitcrusher_crushed() -> Bitcrusher {
    return bitcrusher_new(4, 16)  # 4-bit, 1/16 sample rate
}

# Process one sample
export function bitcrusher_process(crusher: Bitcrusher, input: f32) -> f32 {
    # Sample rate reduction (sample & hold)
    let mut output: f32 = crusher.held_sample
    let mut new_counter: i32 = crusher.counter + 1

    if new_counter >= crusher.sample_rate_div {
        new_counter = 0
        output = input

        # Bit depth reduction (2^bits quantization levels)
        let levels: f32 = pow(2.0, crusher.bits as f32)
        let quantized: f32 = (input * levels) / levels
        output = quantized
    }

    return output
}

# =============================================================================
# Reverb (Simple Freeverb-style)
# =============================================================================

export struct CombFilter {
    buffer: DelayLineF32
    damp: f32
    filter_store: f32
}

export function comb_new(delay_ms: f32, sr: SampleRate) -> CombFilter {
    let mut base: DelayLineF32 = delay_line_new(delay_ms + 1.0, sr)
    base = delay_line_set_time(base, delay_ms, sr)
    return CombFilter {
        buffer: base,
        damp: 0.5,
        filter_store: 0.0
    }
}

export function comb_tick(comb: CombFilter, input: f32) -> CombFilter {
    let max_frames: i32 = comb.buffer.buffer.frames
    if max_frames <= 0 {
        return comb
    }
    let mut read_pos: i32 = comb.buffer.write_pos - comb.buffer.delay_samples
    if read_pos < 0 { read_pos = read_pos + max_frames }
    let delayed: f32 = audio_buffer_get_f32(comb.buffer.buffer, read_pos, 0)

    let filter_store: f32 = delayed * (1.0 - comb.damp) + comb.filter_store * comb.damp

    let write_val: f32 = input + filter_store * comb.buffer.feedback
    audio_buffer_set_f32(comb.buffer.buffer, comb.buffer.write_pos, 0, write_val)

    let mut next_pos: i32 = comb.buffer.write_pos + 1
    if next_pos >= max_frames { next_pos = 0 }

    let updated_buffer: DelayLineF32 = DelayLineF32 {
        buffer: comb.buffer.buffer,
        write_pos: next_pos,
        delay_samples: comb.buffer.delay_samples,
        feedback: comb.buffer.feedback,
        wet: comb.buffer.wet,
        last: delayed
    }

    return CombFilter {
        buffer: updated_buffer,
        damp: comb.damp,
        filter_store: filter_store
    }
}

export struct AllpassFilter {
    buffer: DelayLineF32
}

export function allpass_new(delay_ms: f32, sr: SampleRate) -> AllpassFilter {
    let mut base: DelayLineF32 = delay_line_new(delay_ms + 1.0, sr)
    base = delay_line_set_time(base, delay_ms, sr)
    return AllpassFilter {
        buffer: base
    }
}

export function allpass_tick(allpass: AllpassFilter, input: f32) -> AllpassFilter {
    let max_frames: i32 = allpass.buffer.buffer.frames
    if max_frames <= 0 {
        return allpass
    }
    let mut read_pos: i32 = allpass.buffer.write_pos - allpass.buffer.delay_samples
    if read_pos < 0 { read_pos = read_pos + max_frames }

    let delayed: f32 = audio_buffer_get_f32(allpass.buffer.buffer, read_pos, 0)

    # Allpass filter standard Schroeder implementation:
    # v[n] = x[n] + g * v[n-D] (written to delay line)
    # y[n] = -g * v[n] + v[n-D]
    # feedback g is typically 0.5 for Reverb allpass
    let g: f32 = 0.5

    let v_n: f32 = input + delayed * g
    audio_buffer_set_f32(allpass.buffer.buffer, allpass.buffer.write_pos, 0, v_n)

    let out: f32 = -g * v_n + delayed

    let mut next_pos: i32 = allpass.buffer.write_pos + 1
    if next_pos >= max_frames { next_pos = 0 }

    let updated_buffer: DelayLineF32 = DelayLineF32 {
        buffer: allpass.buffer.buffer,
        write_pos: next_pos,
        delay_samples: allpass.buffer.delay_samples,
        feedback: allpass.buffer.feedback,
        wet: allpass.buffer.wet,
        last: out
    }

    return AllpassFilter {
        buffer: updated_buffer
    }
}

export struct Reverb {
    room_size: f32     # Room size (0.0 to 1.0)
    damping: f32       # High frequency damping (0.0 to 1.0)
    mix: f32           # Dry/wet mix
    c1: CombFilter
    c2: CombFilter
    c3: CombFilter
    c4: CombFilter
    a1: AllpassFilter
    a2: AllpassFilter
    last_out: f32
}

export function reverb_new(room_size: f32, damping: f32, mix: f32) -> Reverb {
    let sr: SampleRate = sample_rate_44100()

    # Schroeder reverberator typical delay times (ms)
    let mut c1: CombFilter = comb_new(29.7, sr)
    let mut c2: CombFilter = comb_new(37.1, sr)
    let mut c3: CombFilter = comb_new(41.1, sr)
    let mut c4: CombFilter = comb_new(43.7, sr)

    let a1: AllpassFilter = allpass_new(5.0, sr)
    let a2: AllpassFilter = allpass_new(1.7, sr)

    # Set feedback based on room_size
    let fb: f32 = room_size * 0.28 + 0.7  # scaled to standard range (0.7 to 0.98)

    c1.buffer.feedback = fb
    c2.buffer.feedback = fb
    c3.buffer.feedback = fb
    c4.buffer.feedback = fb

    c1.damp = damping
    c2.damp = damping
    c3.damp = damping
    c4.damp = damping

    return Reverb {
        room_size: room_size,
        damping: damping,
        mix: mix,
        c1: c1,
        c2: c2,
        c3: c3,
        c4: c4,
        a1: a1,
        a2: a2,
        last_out: 0.0
    }
}

# Presets
export function reverb_small_room() -> Reverb {
    return reverb_new(0.3, 0.5, 0.2)
}

export function reverb_medium_hall() -> Reverb {
    return reverb_new(0.6, 0.4, 0.3)
}

export function reverb_large_hall() -> Reverb {
    return reverb_new(0.85, 0.3, 0.4)
}

export function reverb_plate() -> Reverb {
    return reverb_new(0.7, 0.6, 0.35)
}

# Process one sample, updating the Reverb state and returning the updated Reverb struct
export function reverb_tick(rev: Reverb, input: f32) -> Reverb {
    let in_mix: f32 = input * 0.015  # simple scaling to avoid blowing up

    # 4 Parallel Comb Filters
    let nc1: CombFilter = comb_tick(rev.c1, in_mix)
    let nc2: CombFilter = comb_tick(rev.c2, in_mix)
    let nc3: CombFilter = comb_tick(rev.c3, in_mix)
    let nc4: CombFilter = comb_tick(rev.c4, in_mix)

    let combs_out: f32 = nc1.buffer.last + nc2.buffer.last + nc3.buffer.last + nc4.buffer.last

    # 2 Series Allpass Filters
    let na1: AllpassFilter = allpass_tick(rev.a1, combs_out)
    let na2: AllpassFilter = allpass_tick(rev.a2, na1.buffer.last)

    # Output mix
    let wet_out: f32 = na2.buffer.last
    let out: f32 = input * (1.0 - rev.mix) + wet_out * rev.mix

    return Reverb {
        room_size: rev.room_size,
        damping: rev.damping,
        mix: rev.mix,
        c1: nc1,
        c2: nc2,
        c3: nc3,
        c4: nc4,
        a1: na1,
        a2: na2,
        last_out: out
    }
}

# Process one sample (simplified - full reverb needs comb filters)
# Note: To use the true stateful comb/allpass reverb, use reverb_tick instead.
export function reverb_process(rev: Reverb, input: f32) -> f32 {
    # Placeholder - real reverb is complex
    # For now, just mix dry signal
    return input * (1.0 - rev.mix) + input * 0.3 * rev.mix
}

