# Musical Notation Module - Load Music from Files
#
# Simple text-based notation for livecoding:
#   C4/4 D4/4 E4/2    # Note/duration (4=quarter, 2=eighth, 8=half, etc.)
#   - C4 = note name + octave
#   - /4 = duration in sixteenth notes
#
# Usage with effects:
#   effect Notation {
#       function load_file(path: string) -> bool
#       function get_note_count() -> i32
#       function get_note(idx: i32) -> Note
#   }

import "stdlib/audio.flow"
import "stdlib/string.flow"

# =============================================================================
# Note Structure
# =============================================================================

export struct MusicNote {
    midi: i32       # MIDI note number (60 = C4)
    duration: i32   # Duration in sixteenth notes
}

# =============================================================================
# Notation Effect
# =============================================================================

export effect Notation {
    function load_file(path: string) -> bool
    function get_note_count() -> i32
    function get_note(idx: i32) -> MusicNote
    function parse_line(line: string) -> bool
}

# =============================================================================
# Note Name Parsing
# =============================================================================

# Parse note name to MIDI number (e.g., "C4" -> 60)
export function parse_note_name(name: string) -> i32 {
    let len: i32 = str_len(name) as i32
    if len < 2 {
        return 60
    }

    let p: ptr<i8> = name as ptr<i8>
    let c0: i32 = p[0] as i32

    let mut note: i32 = 0
    if c0 == 67 { note = 0 }      # C
    elif c0 == 68 { note = 2 }    # D
    elif c0 == 69 { note = 4 }    # E
    elif c0 == 70 { note = 5 }    # F
    elif c0 == 71 { note = 7 }    # G
    elif c0 == 65 { note = 9 }    # A
    elif c0 == 66 { note = 11 }   # B
    else { return 60 }

    let mut octave_idx: i32 = 1

    if len > 2 {
        let c1: i32 = p[1] as i32
        if c1 == 35 {             # #
            note = note + 1
            octave_idx = 2
        } elif c1 == 98 {         # b
            note = note - 1
            octave_idx = 2
        }
    }

    let c_oct: i32 = p[octave_idx] as i32
    let octave: i32 = c_oct - 48

    return (octave + 1) * 12 + note
}

# Helper: Parse a single note/duration pair
# Format: "C4/4" means C4 for 4 sixteenth notes (quarter note)
export function parse_note_simple(note_str: string, duration: i32) -> MusicNote {
    # Simplified version - would parse string properly
    let midi: i32 = 60  # Default C4
    return MusicNote { midi: midi, duration: duration }
}

# =============================================================================
# Notation Handler Implementation
# =============================================================================

export struct NotationReader {
    notes: array<MusicNote, 128>  # Max 128 notes
    count: i32
    loaded: bool
}

export function notation_reader_new() -> NotationReader {
    let empty_notes: array<MusicNote, 128> = []
    return NotationReader {
        notes: empty_notes,
        count: 0,
        loaded: false
    }
}

# Append one note. Returns false when the reader is full.
#
# This is how you build a sequence today. The text-file parser below is not
# implemented; it returns a fixed tune whatever path you give it, and the
# comment there says so.
export function notation_add(reader: ptr<NotationReader>, midi: i32, duration: i32) -> bool {
    if reader.count >= 128 {
        return false
    }
    reader.notes[reader.count] = MusicNote { midi: midi, duration: duration }
    reader.count = reader.count + 1
    reader.loaded = true
    return true
}

# Append a rest. A MIDI number below 0 means silence; players are expected
# to check for it.
export function notation_add_rest(reader: ptr<NotationReader>, duration: i32) -> bool {
    return notation_add(reader, -1, duration)
}

export function note_is_rest(n: MusicNote) -> bool {
    return n.midi < 0
}

export function notation_clear(reader: ptr<NotationReader>) -> void {
    reader.count = 0
    reader.loaded = false
}

# Total length of the sequence in sixteenth notes.
export function notation_total_sixteenths(reader: ptr<NotationReader>) -> i32 {
    let mut total: i32 = 0
    let mut i: i32 = 0
    while i < reader.count {
        total = total + reader.notes[i].duration
        i = i + 1
    }
    return total
}

# NOT A PARSER. This ignores `path` entirely and loads a fixed tune, so that
# the players in examples/audio have something to read while the text format
# above is still unimplemented. Use notation_add to build a real sequence.
export function notation_load_file(reader: ptr<NotationReader>, path: string) -> bool {
    let reader_ptr: ptr<NotationReader> = reader
    reader_ptr.notes[0] = MusicNote { midi: 64, duration: 4 }   # E4/4
    reader_ptr.notes[1] = MusicNote { midi: 62, duration: 4 }   # D4/4
    reader_ptr.notes[2] = MusicNote { midi: 60, duration: 8 }   # C4/8
    reader_ptr.notes[3] = MusicNote { midi: 64, duration: 4 }
    reader_ptr.notes[4] = MusicNote { midi: 62, duration: 4 }
    reader_ptr.notes[5] = MusicNote { midi: 60, duration: 8 }
    reader_ptr.notes[6] = MusicNote { midi: 60, duration: 2 }
    reader_ptr.notes[7] = MusicNote { midi: 60, duration: 2 }
    reader_ptr.notes[8] = MusicNote { midi: 60, duration: 2 }
    reader_ptr.notes[9] = MusicNote { midi: 60, duration: 2 }
    reader_ptr.notes[10] = MusicNote { midi: 62, duration: 2 }
    reader_ptr.notes[11] = MusicNote { midi: 62, duration: 2 }
    reader_ptr.notes[12] = MusicNote { midi: 62, duration: 2 }
    reader_ptr.notes[13] = MusicNote { midi: 62, duration: 2 }
    reader_ptr.notes[14] = MusicNote { midi: 64, duration: 4 }
    reader_ptr.notes[15] = MusicNote { midi: 62, duration: 4 }
    reader_ptr.notes[16] = MusicNote { midi: 60, duration: 8 }

    reader_ptr.count = 17
    reader_ptr.loaded = true
    return true
}

export function load_file(reader: ptr<NotationReader>, path: string) -> bool {
    return notation_load_file(reader, path)
}

export function get_note_count(reader: ptr<NotationReader>) -> i32 {
    return reader.count
}

export function get_note(reader: ptr<NotationReader>, idx: i32) -> MusicNote {
    if idx >= 0 and idx < reader.count {
        return reader.notes[idx]
    }
    # Return default note if out of bounds
    return MusicNote { midi: 60, duration: 4 }
}

export function parse_line(reader: ptr<NotationReader>, line: string) -> bool {
    # Would parse a line like "C4/4 D4/4 E4/2"
    # For now, just return success
    return true
}

# =============================================================================
# Utility Functions
# =============================================================================

# Create a notation reader and load a file
export function load_notation(path: string) -> NotationReader {
    let mut reader: NotationReader = notation_reader_new()
    let success: bool = reader.load_file(path)
    return reader
}

# Convert note name to MIDI (manual mapping for now)
export function note_name_to_midi(note: i32, octave: i32) -> i32 {
    # note: 0=C, 1=C#, 2=D, 3=D#, 4=E, 5=F, 6=F#, 7=G, 8=G#, 9=A, 10=A#, 11=B
    return octave * 12 + note
}

# Quick note constructors
export function note_from_name(name: i32, octave: i32, duration: i32) -> MusicNote {
    return MusicNote {
        midi: note_name_to_midi(name, octave),
        duration: duration
    }
}

# =============================================================================
# Notation Format Documentation
# =============================================================================

# Text file format (.flow-music or .flowmusic):
#
# # Comments start with #
# E4/4 D4/4 C4/8   # Hot cross buns (note/duration)
# E4/4 D4/4 C4/8   # Hot cross buns
# C4/2 C4/2 C4/2 C4/2   # One a penny
# D4/2 D4/2 D4/2 D4/2   # Two a penny
# E4/4 D4/4 C4/8   # Hot cross buns
#
# Note format: <name><octave>/<duration>
#   - name: C, D, E, F, G, A, B (with # for sharp, b for flat)
#   - octave: 0-9 (4 = middle octave)
#   - duration: sixteenth notes (2=eighth, 4=quarter, 8=half, 16=whole)
#
# Special:
#   - Rest: R/4 (rest for 4 sixteenths)
#   - Repeat: @2 (repeat previous section twice)
#   - Tempo: BPM:120 (set tempo)
#   - Section: [intro], [verse], [chorus]
