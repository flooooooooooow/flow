# Audio SIMD Helpers
#
# Backed by runtime/audio_simd.c. These are safe CPU fast paths that can be
# auto-vectorized by the compiler.

extern { function flow_audio_gain_interleaved_f32_fast(data: ptr<f32>, frames: i32, channels: i32, gain: f32) -> void }
extern { function flow_audio_mix_interleaved_f32_fast(dst: ptr<f32>, src: ptr<f32>, frames: i32, channels: i32) -> void }
extern { function flow_audio_copy_interleaved_f32_fast(dst: ptr<f32>, src: ptr<f32>, frames: i32, channels: i32) -> void }

# Portable implementation (no external link required)
export function audio_gain_interleaved_f32(data: ptr<f32>, frames: i32, channels: i32, gain: f32) -> void {
    let total: i32 = frames * channels
    let i: i32 = 0
    while i < total {
        data[i] = data[i] * gain
        i = i + 1
    }
}

# Optional fast path (requires runtime/audio_simd.c)
export function audio_gain_interleaved_f32_fast(data: ptr<f32>, frames: i32, channels: i32, gain: f32) -> void {
    flow_audio_gain_interleaved_f32_fast(data, frames, channels, gain)
}

export function audio_mix_interleaved_f32(dst: ptr<f32>, src: ptr<f32>, frames: i32, channels: i32) -> void {
    let total: i32 = frames * channels
    let i: i32 = 0
    while i < total {
        dst[i] = dst[i] + src[i]
        i = i + 1
    }
}

export function audio_copy_interleaved_f32(dst: ptr<f32>, src: ptr<f32>, frames: i32, channels: i32) -> void {
    let total: i32 = frames * channels
    let i: i32 = 0
    while i < total {
        dst[i] = src[i]
        i = i + 1
    }
}

export function audio_mix_interleaved_f32_fast(dst: ptr<f32>, src: ptr<f32>, frames: i32, channels: i32) -> void {
    flow_audio_mix_interleaved_f32_fast(dst, src, frames, channels)
}

export function audio_copy_interleaved_f32_fast(dst: ptr<f32>, src: ptr<f32>, frames: i32, channels: i32) -> void {
    flow_audio_copy_interleaved_f32_fast(dst, src, frames, channels)
}
