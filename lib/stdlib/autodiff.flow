# FLOW Automatic Differentiation Library
# 
# Two modes:
# 1. Forward mode: Dual numbers (simple, good for few inputs)
# 2. Reverse mode: Tape-based via effects (powerful, good for many inputs)

# =============================================================================
# FORWARD MODE - Dual Numbers
# =============================================================================
# 
# A dual number is (value, derivative): x + εx'
# where ε² = 0 (infinitesimal)
#
# Arithmetic:
#   (a + εa') + (b + εb') = (a+b) + ε(a'+b')
#   (a + εa') * (b + εb') = ab + ε(a'b + ab')
#   (a + εa') / (b + εb') = a/b + ε(a'b - ab')/b²

struct Dual {
    val: f32,    # The value
    grad: f32    # The derivative (tangent)
}

# Seed forward-mode AD: Dual(x, 1) so ∂/∂x propagates.
export function dual_var(x: f32) -> Dual {
    return Dual { val: x, grad: 1.0 }
}

# Lift a constant into Dual space: Dual(x, 0).
export function dual_const(x: f32) -> Dual {
    return Dual { val: x, grad: 0.0 }
}

# Dual addition: (a+b, a'+b').
export function dual_add(a: Dual, b: Dual) -> Dual {
    return Dual { 
        val: a.val + b.val, 
        grad: a.grad + b.grad 
    }
}

# Dual subtraction: (a-b, a'-b').
export function dual_sub(a: Dual, b: Dual) -> Dual {
    return Dual { 
        val: a.val - b.val, 
        grad: a.grad - b.grad 
    }
}

# Dual multiply via product rule: (ab, a'b + ab').
export function dual_mul(a: Dual, b: Dual) -> Dual {
    return Dual { 
        val: a.val * b.val, 
        grad: a.grad * b.val + a.val * b.grad 
    }
}

# Dual divide via quotient rule: a/b with derivative (a'b - ab')/b².
export function dual_div(a: Dual, b: Dual) -> Dual {
    let b_sq: f32 = b.val * b.val
    return Dual { 
        val: a.val / b.val, 
        grad: (a.grad * b.val - a.val * b.grad) / b_sq 
    }
}

# Dual power x^n for constant n: derivative n x^{n-1} x'.
export function dual_pow(x: Dual, n: f32) -> Dual {
    let val_pow: f32 = pow(x.val, n)
    return Dual {
        val: val_pow,
        grad: n * pow(x.val, n - 1.0) * x.grad
    }
}

# Dual square x² with derivative 2x x'.
export function dual_sq(x: Dual) -> Dual {
    return Dual {
        val: x.val * x.val,
        grad: 2.0 * x.val * x.grad
    }
}

# Dual square root √x; domain x.val > 0.
export function dual_sqrt(x: Dual) -> Dual {
    let s: f32 = sqrt(x.val)
    return Dual {
        val: s,
        grad: x.grad / (2.0 * s)
    }
}

# Dual exponential e^x with derivative e^x x'.
export function dual_exp(x: Dual) -> Dual {
    let e: f32 = exp(x.val)
    return Dual {
        val: e,
        grad: e * x.grad
    }
}

# Dual natural log ln(x); domain x.val > 0.
export function dual_log(x: Dual) -> Dual {
    return Dual {
        val: log(x.val),
        grad: x.grad / x.val
    }
}

# Dual sine (radians): (sin x, cos(x) x').
export function dual_sin(x: Dual) -> Dual {
    return Dual {
        val: sin(x.val),
        grad: cos(x.val) * x.grad
    }
}

# Dual cosine (radians): (cos x, -sin(x) x').
export function dual_cos(x: Dual) -> Dual {
    return Dual {
        val: cos(x.val),
        grad: -1.0 * sin(x.val) * x.grad
    }
}

# Dual tangent (radians): derivative x' / cos²(x).
export function dual_tan(x: Dual) -> Dual {
    let c: f32 = cos(x.val)
    return Dual {
        val: tan(x.val),
        grad: x.grad / (c * c)
    }
}

# Dual ReLU: max(0,x); gradient is 0 for x <= 0.
export function dual_relu(x: Dual) -> Dual {
    if x.val > 0.0 {
        return x
    } else {
        return Dual { val: 0.0, grad: 0.0 }
    }
}

# Dual sigmoid σ(x)=1/(1+e^{-x}); derivative σ(1-σ)x'.
export function dual_sigmoid(x: Dual) -> Dual {
    let s: f32 = 1.0 / (1.0 + exp(-1.0 * x.val))
    return Dual {
        val: s,
        grad: s * (1.0 - s) * x.grad
    }
}

# Dual tanh; derivative (1 - tanh²x) x'.
export function dual_tanh(x: Dual) -> Dual {
    let t: f32 = tanh(x.val)
    return Dual {
        val: t,
        grad: (1.0 - t * t) * x.grad
    }
}

# =============================================================================
# REVERSE MODE - Effect-Based (Tape Recording)
# =============================================================================
#
# Uses FLOW's effect system to record a computation tape,
# then replay it backwards to compute gradients.

effect Tape {
    # Record an operation to the tape
    record(op: i32, inputs: array<i32>, output: i32, local_grad: f32) -> void,
    
    # Create a new tracked variable, returns its index
    track(value: f32) -> i32,
    
    # Get the gradient for a variable
    get_grad(idx: i32) -> f32,
    
    # Trigger backward pass from a variable
    backward(idx: i32) -> void,
}

# A tracked value in reverse mode
struct Tracked {
    idx: i32,    # Index in the tape
    val: f32     # Current value
}

# =============================================================================
# HELPER: Numerical gradient check
# =============================================================================

# Central finite-difference gradient: (f+ - f-) / (2ε).
# Useful for checking autodiff implementations.
export function numerical_grad(f_plus: f32, f_minus: f32, epsilon: f32) -> f32 {
    return (f_plus - f_minus) / (2.0 * epsilon)
}


# =============================================================================
# HELPER: Extract value and gradient from dual
# =============================================================================

# Extract primal value from a Dual.
export function dual_val(d: Dual) -> f32 {
    return d.val
}

# Extract forward-mode derivative (tangent) from a Dual.
export function dual_grad(d: Dual) -> f32 {
    return d.grad
}

# =============================================================================
# SHORT ALIASES - Less typing!
# =============================================================================

# Alias for dual_var: Dual(x, 1).
export function dx(x: f32) -> Dual {
    return Dual { val: x, grad: 1.0 }
}

# Alias for dual_const: Dual(x, 0).
export function d(x: f32) -> Dual {
    return Dual { val: x, grad: 0.0 }
}

# =============================================================================
# OVERLOADED OPERATIONS - Same name, different argument types!
# =============================================================================
# FLOW supports function overloading: mul(Dual, Dual), mul(Dual, f32), mul(f32, Dual)
# all work and resolve to the correct implementation based on argument types.

# --- add: Addition ---

# Overloaded Dual+Dual addition with forward gradients.
export function add(a: Dual, b: Dual) -> Dual {
    return Dual { val: a.val + b.val, grad: a.grad + b.grad }
}

# Add Dual and scalar constant.
export function add(a: Dual, b: f32) -> Dual {
    return Dual { val: a.val + b, grad: a.grad }
}

# Add scalar constant and Dual.
export function add(a: f32, b: Dual) -> Dual {
    return Dual { val: a + b.val, grad: b.grad }
}

# --- sub: Subtraction ---

# Overloaded Dual−Dual subtraction with forward gradients.
export function sub(a: Dual, b: Dual) -> Dual {
    return Dual { val: a.val - b.val, grad: a.grad - b.grad }
}

# Subtract scalar from Dual.
export function sub(a: Dual, b: f32) -> Dual {
    return Dual { val: a.val - b, grad: a.grad }
}

# Subtract Dual from scalar (gradient negated).
export function sub(a: f32, b: Dual) -> Dual {
    return Dual { val: a - b.val, grad: -b.grad }
}

# --- mul: Multiplication ---

# Overloaded Dual×Dual multiply (product rule).
export function mul(a: Dual, b: Dual) -> Dual {
    return Dual { val: a.val * b.val, grad: a.grad * b.val + a.val * b.grad }
}

# Scale Dual by scalar.
export function mul(a: Dual, b: f32) -> Dual {
    return Dual { val: a.val * b, grad: a.grad * b }
}

# Scale Dual by scalar (left multiply).
export function mul(a: f32, b: Dual) -> Dual {
    return Dual { val: a * b.val, grad: a * b.grad }
}

# --- div: Division ---

# Dual÷Dual division (quotient rule). Prefer this name for operator `/` sugar.
export function div(a: Dual, b: Dual) -> Dual {
    let b_sq: f32 = b.val * b.val
    return Dual { val: a.val / b.val, grad: (a.grad * b.val - a.val * b.grad) / b_sq }
}

# Dual÷Dual division (quotient rule); legacy name ddiv.
export function ddiv(a: Dual, b: Dual) -> Dual {
    return div(a, b)
}

# Divide Dual by scalar.
export function div(a: Dual, b: f32) -> Dual {
    return Dual { val: a.val / b, grad: a.grad / b }
}

# Divide Dual by scalar; named divs to avoid C div conflict historically.
export function divs(a: Dual, b: f32) -> Dual {
    return div(a, b)
}

# Divide scalar by Dual (reciprocal-style quotient rule).
export function div(a: f32, b: Dual) -> Dual {
    let b_sq: f32 = b.val * b.val
    return Dual { val: a / b.val, grad: -a * b.grad / b_sq }
}

# Divide scalar by Dual; legacy name rdiv.
export function rdiv(a: f32, b: Dual) -> Dual {
    return div(a, b)
}

# --- Legacy aliases (for backwards compatibility) ---

# Legacy alias: scalar + Dual.
export function addc(a: f32, b: Dual) -> Dual { return add(a, b) }
# Legacy alias: scalar − Dual.
export function rsub(a: f32, b: Dual) -> Dual { return sub(a, b) }
# Legacy alias: scalar × Dual.
export function smul(a: f32, b: Dual) -> Dual { return mul(a, b) }
# Scale Dual by scalar (alias of mul).
export function scale(a: f32, b: Dual) -> Dual { return mul(a, b) }

# --- Pure scalar versions (for convenience in expressions) ---

# Scalar addition (overload for mixed Dual expressions).
export function add(a: f32, b: f32) -> f32 { return a + b }
# Scalar subtraction overload.
export function sub(a: f32, b: f32) -> f32 { return a - b }
# Scalar multiplication overload.
export function mul(a: f32, b: f32) -> f32 { return a * b }

# Negate Dual value and gradient.
export function neg(a: Dual) -> Dual {
    return Dual { val: -a.val, grad: -a.grad }
}

# =============================================================================
# SHORT ALIASES FOR COMMON TRANSCENDENTALS
# =============================================================================
# Note: These delegate to dual_* versions to avoid shadowing C math functions

# Short alias for dual_sigmoid.
export function sigmoid(x: Dual) -> Dual {
    return dual_sigmoid(x)
}

# Short alias for dual_log (natural logarithm).
export function ln(x: Dual) -> Dual {
    return dual_log(x)
}

# Alias of ln / dual_log on Dual.
export function log(x: Dual) -> Dual {
    return dual_log(x)
}

# Short alias for dual_exp.
export function e(x: Dual) -> Dual {
    return dual_exp(x)
}

# Dual sine alias (avoids shadowing C sin).
export function sinD(x: Dual) -> Dual {
    return dual_sin(x)
}

# Dual cosine alias (avoids shadowing C cos).
export function cosD(x: Dual) -> Dual {
    return dual_cos(x)
}

# Dual tanh alias (avoids shadowing C tanh).
export function tanhD(x: Dual) -> Dual {
    return dual_tanh(x)
}

# =============================================================================
# COMBINED OPERATIONS - Common patterns in one call
# =============================================================================

# Dual square x².
export function sq(x: Dual) -> Dual {
    return Dual { val: x.val * x.val, grad: 2.0 * x.val * x.grad }
}

# Dual cube x³.
export function cube(x: Dual) -> Dual {
    let x2: f32 = x.val * x.val
    return Dual { val: x2 * x.val, grad: 3.0 * x2 * x.grad }
}

# Dual fourth power x⁴.
export function pow4(x: Dual) -> Dual {
    let x2: f32 = x.val * x.val
    let x3: f32 = x2 * x.val
    return Dual { val: x2 * x2, grad: 4.0 * x3 * x.grad }
}

# Squared residual (x − c)² for constant c.
export function sq_diff(x: Dual, c: f32) -> Dual {
    let diff: f32 = x.val - c
    return Dual { val: diff * diff, grad: 2.0 * diff * x.grad }
}

# Affine map a*x + b on Dual.
export function linear(x: Dual, a: f32, b: f32) -> Dual {
    return Dual { val: a * x.val + b, grad: a * x.grad }
}

# Quadratic a*x² + b*x + c on Dual.
export function quadratic(x: Dual, a: f32, b: f32, c: f32) -> Dual {
    let x2: f32 = x.val * x.val
    return Dual { 
        val: a * x2 + b * x.val + c, 
        grad: (2.0 * a * x.val + b) * x.grad 
    }
}

# Dual sin(a*x) for constant scale a.
export function sin_scaled(x: Dual, a: f32) -> Dual {
    return Dual {
        val: sin(a * x.val),
        grad: a * cos(a * x.val) * x.grad
    }
}

# Dual cos(a*x) for constant scale a.
export function cos_scaled(x: Dual, a: f32) -> Dual {
    return Dual {
        val: cos(a * x.val),
        grad: -a * sin(a * x.val) * x.grad
    }
}

# Dual exp(a*x) for constant scale a.
export function exp_scaled(x: Dual, a: f32) -> Dual {
    let e: f32 = exp(a * x.val)
    return Dual { val: e, grad: a * e * x.grad }
}

# =============================================================================
# CHAIN HELPERS - Common compositions
# =============================================================================

# Chain helper: Dual sum f + g.
export function chain_add(f: Dual, g: Dual) -> Dual {
    return dual_add(f, g)
}

# Chain helper: Dual product f * g.
export function chain_mul(f: Dual, g: Dual) -> Dual {
    return dual_mul(f, g)
}

# Weighted Dual sum: a*f + b*g.
export function weighted_sum(f: Dual, a: f32, g: Dual, b: f32) -> Dual {
    return Dual {
        val: a * f.val + b * g.val,
        grad: a * f.grad + b * g.grad
    }
}

# Sum of three Dual values (and their gradients).
export function sum3(a: Dual, b: Dual, c: Dual) -> Dual {
    return Dual {
        val: a.val + b.val + c.val,
        grad: a.grad + b.grad + c.grad
    }
}

# =============================================================================
# EXAMPLE USAGE (Forward Mode)
# =============================================================================
#
# To compute derivative of f(x) = x² + 2x + 1 at x=3:
#
# function f(x: Dual) -> Dual {
#     let x_sq = dual_sq(x)
#     let two_x = dual_mul(dual_const(2.0), x)
#     let sum1 = dual_add(x_sq, two_x)
#     return dual_add(sum1, dual_const(1.0))
# }
#
# function main() -> i32 {
#     let x = dual_var(3.0)  # x=3, dx=1
#     let result = f(x)
#     # result.val = 16.0 (f(3) = 9 + 6 + 1)
#     # result.grad = 8.0  (f'(x) = 2x + 2, f'(3) = 8)
#     printf("f(3) = %f, f'(3) = %f\n", result.val, result.grad)
#     return 0
# }
