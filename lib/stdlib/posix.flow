# FLOW POSIX Standard Library
# File I/O, processes, environment, and system calls
#
# Prototypes and constants come from the system headers rather than being
# written out here. Both halves of this module used to be hand-copied, and
# both were wrong:
#
#   - The prototypes disagreed with libc (`read` returns ssize_t, not i32), and
#     the generated C includes <unistd.h> either way, so every program that
#     imported this module failed with "conflicting types for 'read'".
#   - The constants were macOS values. O_CREAT is 0x200 on macOS and 0x40 on
#     Linux; SIGCHLD is 20 on macOS and 17 on Linux. The numbers here said 512
#     and 17, so one platform was always wrong.
#
# @cImport reads both from the headers, so the values are the platform's own
# and the C output keeps using the macro. See issue #550.

@cImport("fcntl.h")
@cImport("unistd.h")
@cImport("sys/stat.h")
@cImport("sys/wait.h")
@cImport("signal.h")
@cImport("stdlib.h")
@cImport("time.h")

# =============================================================================
# File Descriptors
# =============================================================================

struct FileDescriptor {
    fd: i32
}

# Standard file descriptors.
#
# Not named stdin/stdout/stderr: those are libc macros. On macOS `stdin`
# expands to `__stdinp`, so the generated C declared `FileDescriptor
# __stdinp(void)` against libc's `FILE *__stdinp`, and every program importing
# this module failed to compile.
function stdin_fd() -> FileDescriptor {
    return FileDescriptor { fd: 0 }
}

function stdout_fd() -> FileDescriptor {
    return FileDescriptor { fd: 1 }
}

function stderr_fd() -> FileDescriptor {
    return FileDescriptor { fd: 2 }
}

# =============================================================================
# File Operations
# =============================================================================

# 0644. Not a macro in any header, so it stays a Flow constant.
const DEFAULT_MODE: i32 = 420

function file_open(path: string, flags: i32) -> FileDescriptor {
    let fd: i32 = open(path, flags, DEFAULT_MODE)
    return FileDescriptor { fd: fd }
}

function file_close(f: FileDescriptor) -> i32 {
    return close(f.fd)
}

function file_is_valid(f: FileDescriptor) -> bool {
    return f.fd >= 0
}
