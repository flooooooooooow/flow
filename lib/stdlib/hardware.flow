# Hardware / RTL Module - Clock Domains and Partitions
#
# Primitives for physical hardware deployment, clock domain crossing (CDC),
# and structural modeling of digital logic.
#
# Usage:
#   import "stdlib/hardware.flow"
#   import "stdlib/rf.flow" # if rate markers are used
#
#   @hardware
#   function cdc_example(in: f32) -> f32 {
#       return cdc_sync<Hz1000>(in)
#   }

export struct ClockDomain<Rate> {
    _marker: i32
}

export struct Register<T> {
    value: T
}

export function register_new<T>(initial: T) -> Register<T> {
    return Register<T> { value: initial }
}

export function register_read<T>(reg: Register<T>) -> T {
    return reg.value
}

# Emulate a clock domain crossing (CDC) synchronizer.
# In a software simulation, this is a pass-through.
# In an RTL backend, this lowers to a multi-stage flip-flop synchronizer
# bridging the source clock domain to the `TargetRate` clock domain.
export function cdc_sync<TargetRate, T>(val: T) -> T {
    return val
}
