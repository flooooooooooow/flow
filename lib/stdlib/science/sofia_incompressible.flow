# Flow-native incompressible velocity projection on a uniform periodic 3D grid.
# This is a pressure-Poisson component, not a complete wall-modelled LES solver.
# Cell-centred arrays, compatible backward divergence / forward gradient;
# the composed operator is the standard seven-point Laplacian.
# Jacobi solve is intended for correctness baselines, not high-Re production CFD.

extern {
    function sqrt(x: f64) -> f64
}

export function sofia_inc_index(x: i32, y: i32, z: i32, nx: i32, ny: i32) -> i32 {
    return (z * ny + y) * nx + x
}

# Backward-difference divergence, periodic boundaries.
export function sofia_inc_divergence_rms(
    ux: ptr<f64>, uy: ptr<f64>, uz: ptr<f64>,
    nx: i32, ny: i32, nz: i32, dx: f64
) -> f64 {
    let mut norm2: f64 = 0.0
    for z in 0 to nz {
        let mut zm: i32 = z - 1
        if zm < 0 { zm = nz - 1 }
        for y in 0 to ny {
            let mut ym: i32 = y - 1
            if ym < 0 { ym = ny - 1 }
            for x in 0 to nx {
                let mut xm: i32 = x - 1
                if xm < 0 { xm = nx - 1 }
                let i: i32 = sofia_inc_index(x, y, z, nx, ny)
                let imx: i32 = sofia_inc_index(xm, y, z, nx, ny)
                let imy: i32 = sofia_inc_index(x, ym, z, nx, ny)
                let imz: i32 = sofia_inc_index(x, y, zm, nx, ny)
                let d: f64 = (ux[i] - ux[imx] + uy[i] - uy[imy]
                              + uz[i] - uz[imz]) / dx
                norm2 = norm2 + d * d
            }
        }
    }
    return sqrt(norm2 / ((nx * ny * nz) as f64))
}

# Projects input velocity onto a numerically divergence-free subspace.
# Inputs and outputs must not alias. p and scratch and rhs are scratch arrays,
# each at least nx*ny*nz long. nx,ny,nz>=3, dx>0, dt>0.
# Jacobi iterations control remaining divergence, not a residual tolerance.
export function sofia_inc_project_periodic(
    ux: ptr<f64>, uy: ptr<f64>, uz: ptr<f64>,
    ux_next: ptr<f64>, uy_next: ptr<f64>, uz_next: ptr<f64>,
    p: ptr<f64>, scratch: ptr<f64>, rhs: ptr<f64>,
    nx: i32, ny: i32, nz: i32, dx: f64, dt: f64, iterations: i32
) -> void {
    let n: i32 = nx * ny * nz
    let scale: f64 = 1.0 / (dx * dt)
    for i in 0 to n { p[i] = 0.0 }
    for z in 0 to nz {
        let mut zm: i32 = z - 1
        if zm < 0 { zm = nz - 1 }
        for y in 0 to ny {
            let mut ym: i32 = y - 1
            if ym < 0 { ym = ny - 1 }
            for x in 0 to nx {
                let mut xm: i32 = x - 1
                if xm < 0 { xm = nx - 1 }
                let i: i32 = sofia_inc_index(x, y, z, nx, ny)
                rhs[i] = (ux[i] - ux[sofia_inc_index(xm, y, z, nx, ny)]
                         + uy[i] - uy[sofia_inc_index(x, ym, z, nx, ny)]
                         + uz[i] - uz[sofia_inc_index(x, y, zm, nx, ny)]) * scale
            }
        }
    }
    let dx2: f64 = dx * dx
    for step in 0 to iterations {
        for z in 0 to nz {
            let mut zm: i32 = z - 1
            let mut zp: i32 = z + 1
            if zm < 0 { zm = nz - 1 }
            if zp >= nz { zp = 0 }
            for y in 0 to ny {
                let mut ym: i32 = y - 1
                let mut yp: i32 = y + 1
                if ym < 0 { ym = ny - 1 }
                if yp >= ny { yp = 0 }
                for x in 0 to nx {
                    let mut xm: i32 = x - 1
                    let mut xp: i32 = x + 1
                    if xm < 0 { xm = nx - 1 }
                    if xp >= nx { xp = 0 }
                    let i: i32 = sofia_inc_index(x, y, z, nx, ny)
                    scratch[i] = (
                        p[sofia_inc_index(xm, y, z, nx, ny)]
                      + p[sofia_inc_index(xp, y, z, nx, ny)]
                      + p[sofia_inc_index(x, ym, z, nx, ny)]
                      + p[sofia_inc_index(x, yp, z, nx, ny)]
                      + p[sofia_inc_index(x, y, zm, nx, ny)]
                      + p[sofia_inc_index(x, y, zp, nx, ny)]
                      - dx2 * rhs[i]) / 6.0
                }
            }
        }
        for i in 0 to n { p[i] = scratch[i] }
    }
    let grad_scale: f64 = dt / dx
    for z in 0 to nz {
        let mut zp: i32 = z + 1
        if zp >= nz { zp = 0 }
        for y in 0 to ny {
            let mut yp: i32 = y + 1
            if yp >= ny { yp = 0 }
            for x in 0 to nx {
                let mut xp: i32 = x + 1
                if xp >= nx { xp = 0 }
                let i: i32 = sofia_inc_index(x, y, z, nx, ny)
                ux_next[i] = ux[i] - grad_scale
                             * (p[sofia_inc_index(xp, y, z, nx, ny)] - p[i])
                uy_next[i] = uy[i] - grad_scale
                             * (p[sofia_inc_index(x, yp, z, nx, ny)] - p[i])
                uz_next[i] = uz[i] - grad_scale
                             * (p[sofia_inc_index(x, y, zp, nx, ny)] - p[i])
            }
        }
    }
}


# Forward Euler / central difference momentum step (advection and diffusion).
# Inputs and outputs must not alias. nu is kinematic viscosity.
# This implements explicit conservative upwind/central momentum advection and central difference diffusion.
# No immersed boundary handling; just a periodic cartesian grid.
export function sofia_inc_momentum_step_periodic(
    ux: ptr<f64>, uy: ptr<f64>, uz: ptr<f64>,
    ux_next: ptr<f64>, uy_next: ptr<f64>, uz_next: ptr<f64>,
    nx: i32, ny: i32, nz: i32, dx: f64, dt: f64, nu: f64
) -> void {
    let dx2: f64 = dx * dx
    let inv_dx: f64 = 1.0 / dx

    for z in 0 to nz {
        let mut zm: i32 = z - 1
        let mut zp: i32 = z + 1
        if zm < 0 { zm = nz - 1 }
        if zp >= nz { zp = 0 }

        for y in 0 to ny {
            let mut ym: i32 = y - 1
            let mut yp: i32 = y + 1
            if ym < 0 { ym = ny - 1 }
            if yp >= ny { yp = 0 }

            for x in 0 to nx {
                let mut xm: i32 = x - 1
                let mut xp: i32 = x + 1
                if xm < 0 { xm = nx - 1 }
                if xp >= nx { xp = 0 }

                let i: i32 = sofia_inc_index(x, y, z, nx, ny)
                let ixm: i32 = sofia_inc_index(xm, y, z, nx, ny)
                let ixp: i32 = sofia_inc_index(xp, y, z, nx, ny)
                let iym: i32 = sofia_inc_index(x, ym, z, nx, ny)
                let iyp: i32 = sofia_inc_index(x, yp, z, nx, ny)
                let izm: i32 = sofia_inc_index(x, y, zm, nx, ny)
                let izp: i32 = sofia_inc_index(x, y, zp, nx, ny)

                let cx: f64 = ux[i]
                let cy: f64 = uy[i]
                let cz: f64 = uz[i]

                # Conservative advection: div(u @ u) using central difference flux.
                let u_ip: f64 = (ux[ixp] + cx) * 0.5
                let u_im: f64 = (cx + ux[ixm]) * 0.5
                let u_jp: f64 = (ux[iyp] + cx) * 0.5
                let u_jm: f64 = (cx + ux[iym]) * 0.5
                let u_kp: f64 = (ux[izp] + cx) * 0.5
                let u_km: f64 = (cx + ux[izm]) * 0.5

                let v_ip: f64 = (uy[ixp] + cy) * 0.5
                let v_im: f64 = (cy + uy[ixm]) * 0.5
                let v_jp: f64 = (uy[iyp] + cy) * 0.5
                let v_jm: f64 = (cy + uy[iym]) * 0.5
                let v_kp: f64 = (uy[izp] + cy) * 0.5
                let v_km: f64 = (cy + uy[izm]) * 0.5

                let w_ip: f64 = (uz[ixp] + cz) * 0.5
                let w_im: f64 = (cz + uz[ixm]) * 0.5
                let w_jp: f64 = (uz[iyp] + cz) * 0.5
                let w_jm: f64 = (cz + uz[iym]) * 0.5
                let w_kp: f64 = (uz[izp] + cz) * 0.5
                let w_km: f64 = (cz + uz[izm]) * 0.5

                let adv_x: f64 = (u_ip * u_ip - u_im * u_im + v_jp * u_jp - v_jm * u_jm + w_kp * u_kp - w_km * u_km) * inv_dx
                let adv_y: f64 = (u_ip * v_ip - u_im * v_im + v_jp * v_jp - v_jm * v_jm + w_kp * v_kp - w_km * v_km) * inv_dx
                let adv_z: f64 = (u_ip * w_ip - u_im * w_im + v_jp * w_jp - v_jm * w_jm + w_kp * w_kp - w_km * w_km) * inv_dx

                # Diffusion
                let diff_x: f64 = (ux[ixp] + ux[ixm] + ux[iyp] + ux[iym] + ux[izp] + ux[izm] - 6.0 * cx) / dx2
                let diff_y: f64 = (uy[ixp] + uy[ixm] + uy[iyp] + uy[iym] + uy[izp] + uy[izm] - 6.0 * cy) / dx2
                let diff_z: f64 = (uz[ixp] + uz[ixm] + uz[iyp] + uz[iym] + uz[izp] + uz[izm] - 6.0 * cz) / dx2

                ux_next[i] = cx + dt * (nu * diff_x - adv_x)
                uy_next[i] = cy + dt * (nu * diff_y - adv_y)
                uz_next[i] = cz + dt * (nu * diff_z - adv_z)
            }
        }
    }
}
