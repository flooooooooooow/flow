# flow:lenient - cast arrays to ptrs
# Cryptographic primitives (FFI to platform or bundled implementations)

extern {
    function flow_sha256(data: ptr<i8>, len: i64, out: ptr<i8>) -> void
    function flow_hmac_sha256(key: ptr<i8>, key_len: i64, data: ptr<i8>, data_len: i64, out: ptr<i8>) -> void
    function flow_random_bytes(buf: ptr<i8>, len: i64) -> i32
}

const SHA256_DIGEST_SIZE: i32 = 32

struct Sha256Digest {
    bytes: array<u8, 32>,
}

function sha256_digest_size() -> i32 {
    return SHA256_DIGEST_SIZE
}

function sha256_hash(data: ptr<i8>, len: i64, out: ptr<i8>) -> void {
    flow_sha256(data, len, out)
}

function secure_random(buf: ptr<i8>, len: i64) -> i32 {
    return flow_random_bytes(buf, len)
}

function hmac_sha256(key: ptr<i8>, key_len: i64, data: ptr<i8>, data_len: i64, out: ptr<i8>) -> void {
    flow_hmac_sha256(key, key_len, data, data_len, out)
}
