# Interrupt management and hardware barriers for embedded and bare-metal systems.
#
# Provides global interrupt control, critical sections,
# memory barriers, and software IRQ dispatch.

@cEmbed("#include <stdint.h>")
@cEmbed("static volatile uint32_t flow_irq_global_state = 1;")
@cEmbed("static volatile uint64_t flow_irq_enabled_bits = 0;")
@cEmbed("static volatile uint64_t flow_irq_pending_bits = 0;")
@cEmbed("static inline void flow_irq_enable_raw(void) { flow_irq_global_state = 1; }")
@cEmbed("static inline uint32_t flow_irq_disable_raw(void) { uint32_t prev = flow_irq_global_state; flow_irq_global_state = 0; return prev; }")
@cEmbed("static inline void flow_irq_restore_raw(uint32_t s) { flow_irq_global_state = s; }")
@cEmbed("static inline uint32_t flow_irq_is_enabled_raw(void) { return flow_irq_global_state; }")
@cEmbed("static inline void flow_dmb_raw(void) { __atomic_thread_fence(__ATOMIC_SEQ_CST); }")
@cEmbed("static inline void flow_dsb_raw(void) { __atomic_thread_fence(__ATOMIC_SEQ_CST); }")
@cEmbed("static inline void flow_isb_raw(void) { __atomic_thread_fence(__ATOMIC_SEQ_CST); }")

extern {
    function flow_irq_enable_raw() -> void
    function flow_irq_disable_raw() -> u32
    function flow_irq_restore_raw(s: u32) -> void
    function flow_irq_is_enabled_raw() -> u32
    function flow_dmb_raw() -> void
    function flow_dsb_raw() -> void
    function flow_isb_raw() -> void
}

export struct CriticalSection {
    prev_state: u32
}

# Globally enable interrupts.
export function interrupt_enable() {
    flow_irq_enable_raw()
}

# Globally disable interrupts. Returns the previous interrupt state.
export function interrupt_disable() -> u32 {
    return flow_irq_disable_raw()
}

# Restore previous interrupt state.
export function interrupt_restore(prev: u32) {
    flow_irq_restore_raw(prev)
}

# Check if interrupts are globally enabled.
export function interrupt_is_enabled() -> bool {
    return flow_irq_is_enabled_raw() != 0
}

# Enter a critical section, disabling interrupts and saving previous state.
export function critical_section_enter() -> CriticalSection {
    let s: u32 = flow_irq_disable_raw()
    return CriticalSection { prev_state: s }
}

# Exit a critical section, restoring the prior interrupt state.
export function critical_section_exit(cs: CriticalSection) {
    flow_irq_restore_raw(cs.prev_state)
}

# Data memory barrier (DMB): ensures that all memory accesses before the barrier
# complete before any memory access after the barrier.
export function data_memory_barrier() {
    flow_dmb_raw()
}

# Data synchronization barrier (DSB): ensures that all instructions before the barrier
# complete before executing any instruction after the barrier.
export function data_sync_barrier() {
    flow_dsb_raw()
}

# Instruction synchronization barrier (ISB): flushes the pipeline and prefetches
# subsequent instructions from the cache or memory.
export function instruction_sync_barrier() {
    flow_isb_raw()
}

# Software IRQ state.
let mut IRQ_ENABLED_MASK: i64 = 0
let mut IRQ_PENDING_MASK: i64 = 0

# Enable an IRQ line (0 <= irq < 64).
export function irq_enable(irq: i32) -> bool {
    if irq < 0 or irq >= 64 {
        return false
    }
    let mask: i64 = (1 as i64) << (irq as i64)
    IRQ_ENABLED_MASK = IRQ_ENABLED_MASK | mask
    return true
}

# Disable an IRQ line (0 <= irq < 64).
export function irq_disable(irq: i32) -> bool {
    if irq < 0 or irq >= 64 {
        return false
    }
    let mask: i64 = (1 as i64) << (irq as i64)
    IRQ_ENABLED_MASK = IRQ_ENABLED_MASK & (~mask)
    return true
}

# Query whether an IRQ line is enabled.
export function irq_is_enabled(irq: i32) -> bool {
    if irq < 0 or irq >= 64 {
        return false
    }
    let mask: i64 = (1 as i64) << (irq as i64)
    return (IRQ_ENABLED_MASK & mask) != 0
}

# Mark an IRQ as pending.
export function irq_set_pending(irq: i32) -> bool {
    if irq < 0 or irq >= 64 {
        return false
    }
    let mask: i64 = (1 as i64) << (irq as i64)
    IRQ_PENDING_MASK = IRQ_PENDING_MASK | mask
    return true
}

# Clear pending status for an IRQ line.
export function irq_clear_pending(irq: i32) -> bool {
    if irq < 0 or irq >= 64 {
        return false
    }
    let mask: i64 = (1 as i64) << (irq as i64)
    IRQ_PENDING_MASK = IRQ_PENDING_MASK & (~mask)
    return true
}

# Query whether an IRQ line is pending.
export function irq_is_pending(irq: i32) -> bool {
    if irq < 0 or irq >= 64 {
        return false
    }
    let mask: i64 = (1 as i64) << (irq as i64)
    return (IRQ_PENDING_MASK & mask) != 0
}

# Reset all software IRQ lines.
export function irq_reset_all() {
    IRQ_ENABLED_MASK = 0
    IRQ_PENDING_MASK = 0
}
