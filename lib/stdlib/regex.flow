# Regular expressions: the part of Python's `re` that programs and the
# repository tools use, with Python's matching rules.
#
#   import std.regex { Regex, RxMatch, rx_compile, rx_search, rx_m_group }
#
#   let r: ptr<Regex> = rx_compile("(\\w+)@(?P<host>[\\w.]+)", 0)
#   let m: ptr<RxMatch> = rx_search(r, "mail bob@example.org today")
#   if m != null {
#       rx_m_group(m, 1)            # "bob"
#       rx_m_named(m, "host")       # "example.org"
#       rx_m_start(m, 0)            # 5, in characters as Python counts
#   }
#
# Syntax: literals and escapes (\n \t \xhh \uhhhh \Uhhhhhhhh), `.`,
# classes with ranges and negation, \s \S \w \W \d \D, \b \B \A \Z, ^ and
# $, groups `( )`, `(?: )` and `(?P<name> )`, backreferences \1 and
# (?P=name), lookahead (?= ) (?! ), fixed-width lookbehind (?<= ) (?<! ),
# alternation, the quantifiers * + ? {m} {m,} {,n} {m,n} each optionally
# lazy with a trailing `?`, (?#comments) and global inline flags such as
# (?ims) at the start. Not supported, and rejected with an error: scoped
# flags (?i: ), conditionals (?(1) ), atomic groups, possessive
# quantifiers and verbose mode.
#
# Matching runs on code points, so `.`, bounded repeats and match
# positions count characters the way Python does; rx_m_byte_start and
# rx_m_byte_end give UTF-8 byte offsets into the Flow string. \w, \d and
# \s follow Python's Unicode rules for ASCII and the common Latin, Greek,
# Cyrillic and mathematical ranges, or ASCII alone under RX_ASCII.
# RX_IGNORECASE folds ASCII, Latin-1, Greek and Cyrillic letters.
#
# search, match and fullmatch return null when nothing matches. findall,
# finditer (rx_next), sub and split step over empty matches as Python 3.7
# and later do.
#
# The matcher backtracks with continuation frames on an explicit stack and
# has a fast path for a repeated single character.

extern {
    function malloc(size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
    function strlen(s: string) -> i64
    function strcmp(a: string, b: string) -> i32
}

import std.bytebuf { ByteBuf, bb_new, bb_putc, bb_puts, bb_put_span, bb_str, bb_free }

# Flag values are Python's: re.I, re.M, re.S, re.A.
export const RX_IGNORECASE: i32 = 2
export const RX_MULTILINE: i32 = 8
export const RX_DOTALL: i32 = 16
export const RX_ASCII: i32 = 256

const N_CHAR: i32 = 1
const N_ANY: i32 = 2
const N_CLASS: i32 = 3
const N_BOL: i32 = 4
const N_EOL: i32 = 5
const N_WORDB: i32 = 6
const N_NWORDB: i32 = 7
const N_GROUP: i32 = 8
const N_REPEAT: i32 = 9
const N_BOS: i32 = 10
const N_EOS: i32 = 11
const N_BACKREF: i32 = 12
const N_LOOK: i32 = 13

# Lookaround kinds (node field b).
const LK_AHEAD: i32 = 0
const LK_NAHEAD: i32 = 1
const LK_BEHIND: i32 = 2
const LK_NBEHIND: i32 = 3

# Continuation frame kinds.
const F_SEQ: i32 = 1
const F_REP: i32 = 2
const F_CAPEND: i32 = 3
const F_LOOKEND: i32 = 4

# Class flag bits for \s \S \w \W \d \D inside a class.
const C_SPACE: i32 = 1
const C_NSPACE: i32 = 2
const C_WORD: i32 = 4
const C_NWORD: i32 = 8
const C_DIGIT: i32 = 16
const C_NDIGIT: i32 = 32

export struct Regex {
    # nodes
    kind: ptr<i32>,
    na: ptr<i32>,
    nb: ptr<i32>,
    nc: ptr<i32>,
    nd: ptr<i32>,
    next: ptr<i32>,
    nn: i32,
    ncap: i32,
    # group alternatives: start node of each alternative (-1 = empty)
    alts: ptr<i32>,
    nalts: i32,
    altcap: i32,
    # classes: ranges [lo, hi], plus per-class range slice, flags, negation
    rlo: ptr<i32>,
    rhi: ptr<i32>,
    nr: i32,
    rcap: i32,
    cstart: ptr<i32>,
    ccount: ptr<i32>,
    cflags: ptr<i32>,
    cneg: ptr<i32>,
    ncls: i32,
    ccap: i32,
    start: i32,
    flags: i32,
    error: string,
    # capture groups: count, and a name per group ("" when unnamed)
    ngroups: i32,
    gnames: ptr<string>,
    gcap: i32,
    has_backref: bool,
    # parse state
    pat: ptr<i32>,
    plen: i32,
    pp: i32,
    # match state
    text: ptr<i32>,
    tlen: i32,
    fkind: ptr<i32>,
    fnode: ptr<i32>,
    fcount: ptr<i32>,
    fpos: ptr<i32>,
    fparent: ptr<i32>,
    fn: i32,
    fcap: i32,
    caps: bool,
    cs: ptr<i32>,
    ce: ptr<i32>,
    # saved capture values for lookarounds
    save: ptr<i32>,
    nsave: i32,
    savecap: i32,
    # where the current attempt started, and the rules for accepting it
    mstart: i32,
    need_end: bool,
    forbid_pos: i32
}

# A text decoded to code points, with the UTF-8 byte offset of each.
export struct RxText {
    src: string,
    cps: ptr<i32>,
    offs: ptr<i32>,
    len: i32
}

# One match: group g spans code points [starts[g], ends[g]), -1 when the
# group did not take part. Group 0 is the whole match.
export struct RxMatch {
    re: ptr<Regex>,
    text: ptr<RxText>,
    ngroups: i32,
    starts: ptr<i32>,
    ends: ptr<i32>
}

# A list of strings. findall with two or more groups fills it row by row,
# `width` strings per match.
export struct RxStrs {
    items: ptr<string>,
    len: i32,
    cap: i32,
    width: i32
}

# ---------------------------------------------------------------------------
# UTF-8 decoding
# ---------------------------------------------------------------------------

function rx_decode_into(s: string, out_len: ptr<i32>, offs: ptr<i32>) -> ptr<i32> {
    let n: i32 = strlen(s) as i32
    let p: ptr<u8> = s as ptr<u8>
    let out: ptr<i32> = malloc(((n + 1) as i64) * 4) as ptr<i32>
    let mut i: i32 = 0
    let mut o: i32 = 0
    while i < n {
        let c: i32 = p[i] as i32
        let mut cp: i32 = c
        let mut extra: i32 = 0
        if c >= 240 and c < 248 {
            cp = c & 7
            extra = 3
        } elif c >= 224 and c < 240 {
            cp = c & 15
            extra = 2
        } elif c >= 192 and c < 224 {
            cp = c & 31
            extra = 1
        }
        if offs != null {
            offs[o] = i
        }
        if extra > 0 {
            let mut k: i32 = 1
            let mut ok: bool = true
            while k <= extra {
                if i + k >= n {
                    ok = false
                } elif ((p[i + k] as i32) & 192) != 128 {
                    ok = false
                }
                k = k + 1
            }
            if ok {
                k = 1
                while k <= extra {
                    cp = (cp << 6) | ((p[i + k] as i32) & 63)
                    k = k + 1
                }
                i = i + extra + 1
            } else {
                cp = c
                i = i + 1
            }
        } else {
            i = i + 1
        }
        out[o] = cp
        o = o + 1
    }
    out[o] = 0
    if offs != null {
        offs[o] = n
    }
    out_len[0] = o
    return out
}

# Decode `s` into a fresh code point array; the length goes to out_len[0].
export function rx_decode(s: string, out_len: ptr<i32>) -> ptr<i32> {
    return rx_decode_into(s, out_len, null as ptr<i32>)
}

# Decode `s` once for repeated matching.
export function rx_text(s: string) -> ptr<RxText> {
    let t: ptr<RxText> = malloc(32) as ptr<RxText>
    let n: i32 = strlen(s) as i32
    let lenp: ptr<i32> = malloc(4) as ptr<i32>
    let offs: ptr<i32> = malloc(((n + 1) as i64) * 4) as ptr<i32>
    t.src = s
    t.cps = rx_decode_into(s, lenp, offs)
    t.offs = offs
    t.len = lenp[0]
    return t
}

function rx_utf8_put(b: ptr<ByteBuf>, cp: i32) {
    if cp < 128 {
        bb_putc(b, cp as u8)
    } elif cp < 2048 {
        bb_putc(b, (192 | (cp >> 6)) as u8)
        bb_putc(b, (128 | (cp & 63)) as u8)
    } elif cp < 65536 {
        bb_putc(b, (224 | (cp >> 12)) as u8)
        bb_putc(b, (128 | ((cp >> 6) & 63)) as u8)
        bb_putc(b, (128 | (cp & 63)) as u8)
    } else {
        bb_putc(b, (240 | (cp >> 18)) as u8)
        bb_putc(b, (128 | ((cp >> 12) & 63)) as u8)
        bb_putc(b, (128 | ((cp >> 6) & 63)) as u8)
        bb_putc(b, (128 | (cp & 63)) as u8)
    }
}

# The substring of `t` between code points s and e.
function rx_text_slice(t: ptr<RxText>, s: i32, e: i32) -> string {
    if s < 0 or e <= s {
        return ""
    }
    let b: ptr<ByteBuf> = bb_new(e - s + 1)
    bb_put_span(b, t.src as ptr<u8>, t.offs[s], t.offs[e])
    let out: string = bb_str(b)
    bb_free(b)
    return out
}

# ---------------------------------------------------------------------------
# Character predicates (Python str semantics)
# ---------------------------------------------------------------------------

function rx_in(cp: i32, lo: i32, hi: i32) -> bool {
    return cp >= lo and cp <= hi
}

export function rx_is_space(cp: i32) -> bool {
    if cp == 32 or rx_in(cp, 9, 13) or rx_in(cp, 28, 31) {
        return true
    }
    if cp == 133 or cp == 160 or cp == 5760 or rx_in(cp, 8192, 8202) {
        return true
    }
    return cp == 8232 or cp == 8233 or cp == 8239 or cp == 8287 or cp == 12288
}

export function rx_is_digit(cp: i32) -> bool {
    if rx_in(cp, 48, 57) {
        return true
    }
    if rx_in(cp, 1632, 1641) or rx_in(cp, 1776, 1785) or rx_in(cp, 2406, 2415) {
        return true
    }
    return rx_in(cp, 65296, 65305)
}

function rx_letterlike_word(cp: i32) -> bool {
    # U+2100..U+214F: letters such as the double-struck R, N, Z, Q, C.
    if cp == 8450 or cp == 8455 or rx_in(cp, 8458, 8467) or cp == 8469 {
        return true
    }
    if rx_in(cp, 8473, 8477) or cp == 8484 or cp == 8486 or cp == 8488 {
        return true
    }
    if rx_in(cp, 8490, 8493) or rx_in(cp, 8495, 8505) or rx_in(cp, 8508, 8511) {
        return true
    }
    return rx_in(cp, 8517, 8521) or cp == 8526
}

export function rx_is_word(cp: i32) -> bool {
    if cp < 128 {
        return rx_in(cp, 48, 57) or rx_in(cp, 65, 90) or rx_in(cp, 97, 122) or cp == 95
    }
    if cp < 192 {
        return cp == 170 or cp == 178 or cp == 179 or cp == 181 or cp == 185 or cp == 186 or rx_in(cp, 188, 190)
    }
    if cp == 215 or cp == 247 {
        return false
    }
    if cp < 688 {
        return true
    }
    if cp < 880 {
        return rx_in(cp, 688, 705)
    }
    if cp < 1280 {
        return not (cp == 885 or cp == 894 or cp == 900 or cp == 901 or cp == 903 or cp == 1014 or rx_in(cp, 1154, 1161))
    }
    if cp < 8192 {
        return true
    }
    if cp < 8304 {
        return false
    }
    if cp < 8352 {
        return not (rx_in(cp, 8314, 8318) or rx_in(cp, 8330, 8334))
    }
    if cp < 8448 {
        return false
    }
    if cp < 8528 {
        return rx_letterlike_word(cp)
    }
    if cp < 8592 {
        return true
    }
    if cp < 11264 {
        return rx_in(cp, 9312, 9371) or rx_in(cp, 9450, 9471) or rx_in(cp, 10102, 10131)
    }
    if cp < 11776 {
        return true
    }
    if cp < 11904 {
        return false
    }
    if rx_in(cp, 12288, 12351) {
        return rx_in(cp, 12293, 12295) or rx_in(cp, 12321, 12329) or rx_in(cp, 12337, 12341) or rx_in(cp, 12344, 12348)
    }
    if rx_in(cp, 57344, 63743) or rx_in(cp, 65024, 65135) {
        return false
    }
    if rx_in(cp, 65280, 65519) {
        return rx_in(cp, 65296, 65305) or rx_in(cp, 65313, 65338) or rx_in(cp, 65345, 65370) or rx_in(cp, 65382, 65500)
    }
    if rx_in(cp, 126976, 129791) {
        return false
    }
    return true
}

# Simple lower and upper case for ASCII, Latin-1, Greek and Cyrillic.
export function rx_lower(cp: i32) -> i32 {
    if rx_in(cp, 65, 90) {
        return cp + 32
    }
    if cp < 192 {
        return cp
    }
    if rx_in(cp, 192, 222) and cp != 215 {
        return cp + 32
    }
    if rx_in(cp, 913, 939) and cp != 930 {
        return cp + 32
    }
    if rx_in(cp, 1040, 1071) {
        return cp + 32
    }
    if rx_in(cp, 1024, 1039) {
        return cp + 80
    }
    return cp
}

export function rx_upper(cp: i32) -> i32 {
    if rx_in(cp, 97, 122) {
        return cp - 32
    }
    if cp < 224 {
        return cp
    }
    if rx_in(cp, 224, 254) and cp != 247 {
        return cp - 32
    }
    if rx_in(cp, 945, 971) and cp != 962 {
        return cp - 32
    }
    if rx_in(cp, 1072, 1103) {
        return cp - 32
    }
    if rx_in(cp, 1104, 1119) {
        return cp - 80
    }
    return cp
}

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

function rx_grow(p: ptr<i32>, cap: i32) -> ptr<i32> {
    return realloc(p as ptr<void>, (cap as i64) * 4) as ptr<i32>
}

function rx_alloc(cap: i32) -> ptr<i32> {
    return malloc((cap as i64) * 4) as ptr<i32>
}

function rx_node(r: ptr<Regex>, kind: i32, a: i32, b: i32, c: i32, d: i32) -> i32 {
    if r.nn == r.ncap {
        let nc: i32 = r.ncap * 2
        r.kind = rx_grow(r.kind, nc)
        r.na = rx_grow(r.na, nc)
        r.nb = rx_grow(r.nb, nc)
        r.nc = rx_grow(r.nc, nc)
        r.nd = rx_grow(r.nd, nc)
        r.next = rx_grow(r.next, nc)
        r.ncap = nc
    }
    let i: i32 = r.nn
    r.kind[i] = kind
    r.na[i] = a
    r.nb[i] = b
    r.nc[i] = c
    r.nd[i] = d
    r.next[i] = 0 - 1
    r.nn = i + 1
    return i
}

function rx_add_alt(r: ptr<Regex>, start: i32) {
    if r.nalts == r.altcap {
        r.altcap = r.altcap * 2
        r.alts = rx_grow(r.alts, r.altcap)
    }
    r.alts[r.nalts] = start
    r.nalts = r.nalts + 1
}

function rx_add_range(r: ptr<Regex>, lo: i32, hi: i32) {
    if r.nr == r.rcap {
        r.rcap = r.rcap * 2
        r.rlo = rx_grow(r.rlo, r.rcap)
        r.rhi = rx_grow(r.rhi, r.rcap)
    }
    r.rlo[r.nr] = lo
    r.rhi[r.nr] = hi
    r.nr = r.nr + 1
}

function rx_new_class(r: ptr<Regex>, neg: bool) -> i32 {
    if r.ncls == r.ccap {
        r.ccap = r.ccap * 2
        r.cstart = rx_grow(r.cstart, r.ccap)
        r.ccount = rx_grow(r.ccount, r.ccap)
        r.cflags = rx_grow(r.cflags, r.ccap)
        r.cneg = rx_grow(r.cneg, r.ccap)
    }
    let id: i32 = r.ncls
    r.cstart[id] = r.nr
    r.ccount[id] = 0
    r.cflags[id] = 0
    if neg {
        r.cneg[id] = 1
    } else {
        r.cneg[id] = 0
    }
    r.ncls = id + 1
    return id
}

function rx_class_range(r: ptr<Regex>, id: i32, lo: i32, hi: i32) {
    rx_add_range(r, lo, hi)
    r.ccount[id] = r.ccount[id] + 1
}

function rx_class_flag(r: ptr<Regex>, id: i32, flag: i32) {
    r.cflags[id] = r.cflags[id] | flag
}

# A one-flag class for \s \S \w \W \d \D outside brackets.
function rx_flag_class(r: ptr<Regex>, flag: i32) -> i32 {
    let id: i32 = rx_new_class(r, false)
    rx_class_flag(r, id, flag)
    return id
}

# A new capture group; returns its number.
function rx_new_group(r: ptr<Regex>, name: string) -> i32 {
    r.ngroups = r.ngroups + 1
    if r.ngroups >= r.gcap {
        r.gcap = r.gcap * 2
        r.gnames = realloc(r.gnames as ptr<void>, (r.gcap as i64) * 8) as ptr<string>
    }
    r.gnames[r.ngroups] = name
    return r.ngroups
}

# ---------------------------------------------------------------------------
# Parser
# ---------------------------------------------------------------------------

function rx_peek(r: ptr<Regex>) -> i32 {
    if r.pp >= r.plen {
        return 0 - 1
    }
    return r.pat[r.pp]
}

function rx_peek_at(r: ptr<Regex>, k: i32) -> i32 {
    if r.pp + k >= r.plen {
        return 0 - 1
    }
    return r.pat[r.pp + k]
}

function rx_fail(r: ptr<Regex>, msg: string) -> i32 {
    if strlen(r.error) == 0 {
        r.error = msg
    }
    return 0 - 2
}

function rx_is_ascii_digit(c: i32) -> bool {
    return c >= 48 and c <= 57
}

function rx_is_ascii_letter(c: i32) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

function rx_hex_val(c: i32) -> i32 {
    if rx_is_ascii_digit(c) {
        return c - 48
    }
    if c >= 97 and c <= 102 {
        return c - 87
    }
    if c >= 65 and c <= 70 {
        return c - 55
    }
    return 0 - 1
}

# `digits` hex digits at the cursor as a code point, or -2 on error.
function rx_parse_hex(r: ptr<Regex>, digits: i32) -> i32 {
    let mut v: i32 = 0
    let mut i: i32 = 0
    while i < digits {
        let h: i32 = rx_hex_val(rx_peek(r))
        if h < 0 {
            return rx_fail(r, "incomplete escape")
        }
        v = v * 16 + h
        r.pp = r.pp + 1
        i = i + 1
    }
    if v > 1114111 {
        return rx_fail(r, "bad escape (code point out of range)")
    }
    return v
}

function rx_class_escape_flag(c: i32) -> i32 {
    if c == 115 {
        return C_SPACE
    }
    if c == 83 {
        return C_NSPACE
    }
    if c == 119 {
        return C_WORD
    }
    if c == 87 {
        return C_NWORD
    }
    if c == 100 {
        return C_DIGIT
    }
    if c == 68 {
        return C_NDIGIT
    }
    return 0
}

# The code point a character escape (the letter after the backslash, which
# the cursor has passed) stands for, -1 when it is not a character escape,
# or -2 on error. `in_class` selects the rules inside brackets.
function rx_char_escape(r: ptr<Regex>, e: i32, in_class: bool) -> i32 {
    if e == 110 { return 10 }
    if e == 116 { return 9 }
    if e == 114 { return 13 }
    if e == 102 { return 12 }
    if e == 118 { return 11 }
    if e == 97 { return 7 }
    if e == 120 {
        return rx_parse_hex(r, 2)
    }
    if e == 117 {
        return rx_parse_hex(r, 4)
    }
    if e == 85 {
        return rx_parse_hex(r, 8)
    }
    if e == 98 and in_class {
        return 8
    }
    if e == 48 {
        # \0 and up to two more octal digits.
        let mut v: i32 = 0
        let mut k: i32 = 0
        while k < 2 and rx_peek(r) >= 48 and rx_peek(r) <= 55 {
            v = v * 8 + (rx_peek(r) - 48)
            r.pp = r.pp + 1
            k = k + 1
        }
        return v
    }
    if rx_is_ascii_letter(e) or rx_is_ascii_digit(e) {
        return 0 - 1
    }
    return e
}

# Parse "[...]" with the opening bracket already consumed.
function rx_parse_class(r: ptr<Regex>) -> i32 {
    let mut neg: bool = false
    if rx_peek(r) == 94 {
        neg = true
        r.pp = r.pp + 1
    }
    let id: i32 = rx_new_class(r, neg)
    let mut first: bool = true
    while true {
        let c: i32 = rx_peek(r)
        if c < 0 {
            return rx_fail(r, "unterminated character set")
        }
        if c == 93 and not first {
            r.pp = r.pp + 1
            break
        }
        first = false
        r.pp = r.pp + 1
        let mut lo: i32 = c
        if c == 92 {
            let e: i32 = rx_peek(r)
            if e < 0 {
                return rx_fail(r, "bad escape (end of pattern)")
            }
            r.pp = r.pp + 1
            let fl: i32 = rx_class_escape_flag(e)
            if fl != 0 {
                rx_class_flag(r, id, fl)
                continue
            }
            lo = rx_char_escape(r, e, true)
            if lo == 0 - 2 {
                return 0 - 2
            }
            if lo == 0 - 1 {
                return rx_fail(r, "bad escape in character set")
            }
        }
        let mut hi: i32 = lo
        if rx_peek(r) == 45 and rx_peek_at(r, 1) != 93 and rx_peek_at(r, 1) >= 0 {
            r.pp = r.pp + 1
            let h: i32 = rx_peek(r)
            r.pp = r.pp + 1
            hi = h
            if h == 92 {
                let e2: i32 = rx_peek(r)
                r.pp = r.pp + 1
                if rx_class_escape_flag(e2) != 0 {
                    return rx_fail(r, "bad character range")
                }
                hi = rx_char_escape(r, e2, true)
                if hi == 0 - 2 {
                    return 0 - 2
                }
                if hi == 0 - 1 {
                    return rx_fail(r, "bad escape in character set")
                }
            }
            if hi < lo {
                return rx_fail(r, "bad character range")
            }
        }
        rx_class_range(r, id, lo, hi)
    }
    return rx_node(r, N_CLASS, id, 0, 0, 0)
}

# Parse a decimal number at the cursor; -1 if none.
function rx_parse_int(r: ptr<Regex>) -> i32 {
    let mut v: i32 = 0 - 1
    while rx_is_ascii_digit(rx_peek(r)) {
        if v < 0 {
            v = 0
        }
        v = v * 10 + (rx_peek(r) - 48)
        r.pp = r.pp + 1
    }
    return v
}

# A group name at the cursor up to the code point `close`, which is
# consumed. "" on error.
function rx_parse_name(r: ptr<Regex>, close: i32) -> string {
    let b: ptr<ByteBuf> = bb_new(16)
    let mut n: i32 = 0
    while rx_peek(r) >= 0 and rx_peek(r) != close {
        let c: i32 = rx_peek(r)
        if not (rx_is_word(c)) or (n == 0 and rx_is_ascii_digit(c)) {
            let _f: i32 = rx_fail(r, "bad character in group name")
            return ""
        }
        rx_utf8_put(b, c)
        r.pp = r.pp + 1
        n = n + 1
    }
    if rx_peek(r) != close {
        let _f2: i32 = rx_fail(r, "missing group name terminator")
        return ""
    }
    r.pp = r.pp + 1
    if n == 0 {
        let _f3: i32 = rx_fail(r, "missing group name")
        return ""
    }
    let s: string = bb_str(b)
    bb_free(b)
    return s
}

# The number of the group called `name`, or -1.
export function rx_group_index(r: ptr<Regex>, name: string) -> i32 {
    let mut g: i32 = 1
    while g <= r.ngroups {
        if strcmp(r.gnames[g], name) == 0 {
            return g
        }
        g = g + 1
    }
    return 0 - 1
}

# Global inline flags `(?aimsx)` at the cursor, which sits after "(?".
# Returns -1 when the letters end in ':' (a scoped group), else consumes
# through ')'.
function rx_parse_inline_flags(r: ptr<Regex>) -> i32 {
    while true {
        let c: i32 = rx_peek(r)
        if c == 105 {
            r.flags = r.flags | RX_IGNORECASE
        } elif c == 109 {
            r.flags = r.flags | RX_MULTILINE
        } elif c == 115 {
            r.flags = r.flags | RX_DOTALL
        } elif c == 97 {
            r.flags = r.flags | RX_ASCII
        } elif c == 117 or c == 76 {
            # re.U is the default for str patterns; re.L needs bytes.
            if c == 76 {
                return rx_fail(r, "bad inline flags: cannot use 'L' flag with a str pattern")
            }
        } elif c == 41 {
            r.pp = r.pp + 1
            return 0
        } elif c == 58 or c == 45 {
            return rx_fail(r, "scoped inline flags are not supported")
        } elif c == 120 {
            return rx_fail(r, "verbose mode is not supported")
        } else {
            return rx_fail(r, "unknown flag")
        }
        r.pp = r.pp + 1
    }
    return 0
}

# One atom as a single node with next = -1, -1 at a sequence end, -2 on
# error, or -3 for an item that matches nothing and is dropped (an inline
# flag group or a comment).
function rx_parse_atom(r: ptr<Regex>) -> i32 {
    let c: i32 = rx_peek(r)
    if c < 0 or c == 124 or c == 41 {
        return 0 - 1
    }
    let at: i32 = r.pp
    r.pp = r.pp + 1
    if c == 40 {
        let mut group: i32 = 0 - 1
        let mut look: i32 = 0 - 1
        if rx_peek(r) == 63 {
            let q: i32 = rx_peek_at(r, 1)
            if q == 58 {
                r.pp = r.pp + 2
            } elif q == 80 and rx_peek_at(r, 2) == 60 {
                r.pp = r.pp + 3
                let name: string = rx_parse_name(r, 62)
                if strlen(r.error) > 0 {
                    return 0 - 2
                }
                if rx_group_index(r, name) >= 0 {
                    return rx_fail(r, "redefinition of group name")
                }
                group = rx_new_group(r, name)
            } elif q == 80 and rx_peek_at(r, 2) == 61 {
                r.pp = r.pp + 3
                let gname: string = rx_parse_name(r, 41)
                if strlen(r.error) > 0 {
                    return 0 - 2
                }
                let gi: i32 = rx_group_index(r, gname)
                if gi < 0 {
                    return rx_fail(r, "unknown group name")
                }
                r.has_backref = true
                return rx_node(r, N_BACKREF, gi, 0, 0, 0)
            } elif q == 61 {
                r.pp = r.pp + 2
                look = LK_AHEAD
            } elif q == 33 {
                r.pp = r.pp + 2
                look = LK_NAHEAD
            } elif q == 60 and rx_peek_at(r, 2) == 61 {
                r.pp = r.pp + 3
                look = LK_BEHIND
            } elif q == 60 and rx_peek_at(r, 2) == 33 {
                r.pp = r.pp + 3
                look = LK_NBEHIND
            } elif q == 35 {
                # (?#comment)
                while rx_peek(r) >= 0 and rx_peek(r) != 41 {
                    r.pp = r.pp + 1
                }
                if rx_peek(r) != 41 {
                    return rx_fail(r, "missing ), unterminated comment")
                }
                r.pp = r.pp + 1
                return 0 - 3
            } elif rx_is_ascii_letter(q) {
                if at != 0 {
                    return rx_fail(r, "global flags not at the start of the expression")
                }
                r.pp = r.pp + 1
                if rx_parse_inline_flags(r) == 0 - 2 {
                    return 0 - 2
                }
                return 0 - 3
            } else {
                return rx_fail(r, "unsupported group extension")
            }
        } else {
            group = rx_new_group(r, "")
        }
        let body: i32 = rx_parse_alternation(r)
        if body == 0 - 2 {
            return 0 - 2
        }
        if rx_peek(r) != 41 {
            return rx_fail(r, "missing ), unterminated subpattern")
        }
        r.pp = r.pp + 1
        if look >= 0 {
            let mut width: i32 = 0
            if look == LK_BEHIND or look == LK_NBEHIND {
                width = rx_width(r, body)
                if width < 0 {
                    return rx_fail(r, "look-behind requires fixed-width pattern")
                }
            }
            return rx_node(r, N_LOOK, body, look, width, 0)
        }
        r.nc[body] = group
        return body
    }
    if c == 46 {
        return rx_node(r, N_ANY, 0, 0, 0, 0)
    }
    if c == 94 {
        return rx_node(r, N_BOL, 0, 0, 0, 0)
    }
    if c == 36 {
        return rx_node(r, N_EOL, 0, 0, 0, 0)
    }
    if c == 91 {
        return rx_parse_class(r)
    }
    if c == 42 or c == 43 or c == 63 {
        return rx_fail(r, "nothing to repeat")
    }
    if c == 92 {
        let e: i32 = rx_peek(r)
        if e < 0 {
            return rx_fail(r, "bad escape (end of pattern)")
        }
        r.pp = r.pp + 1
        let fl: i32 = rx_class_escape_flag(e)
        if fl != 0 {
            return rx_node(r, N_CLASS, rx_flag_class(r, fl), 0, 0, 0)
        }
        if e == 98 {
            return rx_node(r, N_WORDB, 0, 0, 0, 0)
        }
        if e == 66 {
            return rx_node(r, N_NWORDB, 0, 0, 0, 0)
        }
        if e == 65 {
            return rx_node(r, N_BOS, 0, 0, 0, 0)
        }
        if e == 90 {
            return rx_node(r, N_EOS, 0, 0, 0, 0)
        }
        if rx_is_ascii_digit(e) and e != 48 {
            # \1 .. \99: a backreference to a group already opened.
            let mut g: i32 = e - 48
            if rx_is_ascii_digit(rx_peek(r)) {
                g = g * 10 + (rx_peek(r) - 48)
                r.pp = r.pp + 1
            }
            if g > r.ngroups {
                return rx_fail(r, "invalid group reference")
            }
            r.has_backref = true
            return rx_node(r, N_BACKREF, g, 0, 0, 0)
        }
        let lit: i32 = rx_char_escape(r, e, false)
        if lit == 0 - 2 {
            return 0 - 2
        }
        if lit == 0 - 1 {
            return rx_fail(r, "bad escape")
        }
        return rx_node(r, N_CHAR, lit, 0, 0, 0)
    }
    return rx_node(r, N_CHAR, c, 0, 0, 0)
}

# Width in code points of every match of the sequence starting at node n,
# or -1 when matches can differ in width.
function rx_width(r: ptr<Regex>, start: i32) -> i32 {
    let mut total: i32 = 0
    let mut n: i32 = start
    while n >= 0 {
        let k: i32 = r.kind[n]
        if k == N_CHAR or k == N_ANY or k == N_CLASS {
            total = total + 1
        } elif k == N_GROUP {
            let mut w: i32 = 0 - 2
            let mut i: i32 = 0
            while i < r.nb[n] {
                let aw: i32 = rx_width(r, r.alts[r.na[n] + i])
                if aw < 0 {
                    return 0 - 1
                }
                if w == 0 - 2 {
                    w = aw
                } elif aw != w {
                    return 0 - 1
                }
                i = i + 1
            }
            if w > 0 {
                total = total + w
            }
        } elif k == N_REPEAT {
            if r.nb[n] != r.nc[n] {
                return 0 - 1
            }
            let cw: i32 = rx_width(r, r.na[n])
            if cw < 0 {
                return 0 - 1
            }
            total = total + cw * r.nb[n]
        } elif k == N_BACKREF {
            return 0 - 1
        }
        n = r.next[n]
    }
    return total
}

# Try to read a {m,n} quantifier at the cursor. Returns true and fills
# mm[0], mm[1] when one is present; otherwise leaves the cursor alone.
function rx_parse_braces(r: ptr<Regex>, mm: ptr<i32>) -> bool {
    if rx_peek(r) != 123 {
        return false
    }
    let save: i32 = r.pp
    r.pp = r.pp + 1
    let lo: i32 = rx_parse_int(r)
    let mut hi: i32 = lo
    if rx_peek(r) == 44 {
        r.pp = r.pp + 1
        hi = rx_parse_int(r)
    } elif lo < 0 {
        r.pp = save
        return false
    }
    if rx_peek(r) != 125 {
        r.pp = save
        return false
    }
    r.pp = r.pp + 1
    if lo < 0 {
        mm[0] = 0
    } else {
        mm[0] = lo
    }
    mm[1] = hi
    return true
}

# Parse a concatenation. Returns its first node, -1 when empty, -2 on error.
function rx_parse_seq(r: ptr<Regex>) -> i32 {
    let mut head: i32 = 0 - 1
    let mut tail: i32 = 0 - 1
    let mm: ptr<i32> = rx_alloc(2)
    while true {
        let atom: i32 = rx_parse_atom(r)
        if atom == 0 - 2 {
            return 0 - 2
        }
        if atom == 0 - 3 {
            continue
        }
        if atom == 0 - 1 {
            break
        }
        let mut node: i32 = atom
        let q: i32 = rx_peek(r)
        let mut lo: i32 = 0 - 1
        let mut hi: i32 = 0 - 1
        if q == 42 {
            lo = 0
            hi = 0 - 1
            r.pp = r.pp + 1
        } elif q == 43 {
            lo = 1
            hi = 0 - 1
            r.pp = r.pp + 1
        } elif q == 63 {
            lo = 0
            hi = 1
            r.pp = r.pp + 1
        } elif rx_parse_braces(r, mm) {
            lo = mm[0]
            hi = mm[1]
            if hi >= 0 and hi < lo {
                return rx_fail(r, "min repeat greater than max repeat")
            }
        }
        if lo >= 0 {
            let ak: i32 = r.kind[atom]
            if ak == N_BOL or ak == N_EOL or ak == N_BOS or ak == N_EOS or ak == N_WORDB or ak == N_NWORDB {
                return rx_fail(r, "nothing to repeat")
            }
            let mut greedy: i32 = 1
            if rx_peek(r) == 63 {
                greedy = 0
                r.pp = r.pp + 1
            } elif rx_peek(r) == 43 {
                return rx_fail(r, "possessive quantifiers are not supported")
            }
            let nxq: i32 = rx_peek(r)
            if nxq == 42 or nxq == 43 or nxq == 63 {
                return rx_fail(r, "multiple repeat")
            }
            node = rx_node(r, N_REPEAT, atom, lo, hi, greedy)
        }
        if head < 0 {
            head = node
        } else {
            r.next[tail] = node
        }
        tail = node
    }
    return head
}

# Parse alternatives separated by '|'. Returns one non-capturing GROUP
# node (its capture number, field c, is 0), or -2.
function rx_parse_alternation(r: ptr<Regex>) -> i32 {
    let mut cap: i32 = 8
    let mut work: ptr<i32> = rx_alloc(8)
    let mut n: i32 = 0
    while true {
        let s: i32 = rx_parse_seq(r)
        if s == 0 - 2 {
            return 0 - 2
        }
        if n == cap {
            cap = cap * 2
            work = rx_grow(work, cap)
        }
        work[n] = s
        n = n + 1
        if rx_peek(r) == 124 {
            r.pp = r.pp + 1
        } else {
            break
        }
    }
    let first: i32 = r.nalts
    let mut i: i32 = 0
    while i < n {
        rx_add_alt(r, work[i])
        i = i + 1
    }
    return rx_node(r, N_GROUP, first, n, 0, 0)
}

# Compile `pattern` with Python-style `flags`. Check rx_ok or rx_error
# afterwards: a pattern that does not compile matches nothing.
export function rx_compile(pattern: string, flags: i32) -> ptr<Regex> {
    let r: ptr<Regex> = malloc(512) as ptr<Regex>
    r.ncap = 64
    r.nn = 0
    r.kind = rx_alloc(64)
    r.na = rx_alloc(64)
    r.nb = rx_alloc(64)
    r.nc = rx_alloc(64)
    r.nd = rx_alloc(64)
    r.next = rx_alloc(64)
    r.altcap = 16
    r.nalts = 0
    r.alts = rx_alloc(16)
    r.rcap = 16
    r.nr = 0
    r.rlo = rx_alloc(16)
    r.rhi = rx_alloc(16)
    r.ccap = 8
    r.ncls = 0
    r.cstart = rx_alloc(8)
    r.ccount = rx_alloc(8)
    r.cflags = rx_alloc(8)
    r.cneg = rx_alloc(8)
    r.flags = flags
    r.error = ""
    r.ngroups = 0
    r.gcap = 8
    r.gnames = malloc(64) as ptr<string>
    r.gnames[0] = ""
    r.has_backref = false
    r.fcap = 256
    r.fn = 0
    r.fkind = rx_alloc(256)
    r.fnode = rx_alloc(256)
    r.fcount = rx_alloc(256)
    r.fpos = rx_alloc(256)
    r.fparent = rx_alloc(256)
    r.caps = true
    r.savecap = 64
    r.nsave = 0
    r.save = rx_alloc(64)
    r.mstart = 0
    r.need_end = false
    r.forbid_pos = 0 - 1
    r.start = 0 - 1
    let lenp: ptr<i32> = rx_alloc(1)
    r.pat = rx_decode(pattern, lenp)
    r.plen = lenp[0]
    r.pp = 0
    let top: i32 = rx_parse_alternation(r)
    r.cs = rx_alloc(r.ngroups + 1)
    r.ce = rx_alloc(r.ngroups + 1)
    if top == 0 - 2 {
        return r
    }
    if r.pp < r.plen {
        let _e: i32 = rx_fail(r, "unbalanced parenthesis")
        return r
    }
    # Case-insensitive literals are stored folded.
    if (r.flags & RX_IGNORECASE) != 0 {
        let mut i: i32 = 0
        while i < r.nn {
            if r.kind[i] == N_CHAR {
                r.na[i] = rx_lower(r.na[i])
            }
            i = i + 1
        }
    }
    r.start = top
    return r
}

# re.MULTILINE | re.DOTALL, the flag set the repository tools use.
export function rx_py_flags() -> i32 {
    return RX_MULTILINE | RX_DOTALL
}

export function rx_error(r: ptr<Regex>) -> string {
    return r.error
}

export function rx_ok(r: ptr<Regex>) -> bool {
    return strlen(r.error) == 0
}

# Number of capture groups.
export function rx_group_count(r: ptr<Regex>) -> i32 {
    return r.ngroups
}

# ---------------------------------------------------------------------------
# Matcher
# ---------------------------------------------------------------------------

function rx_flag_hit(r: ptr<Regex>, fl: i32, cp: i32) -> bool {
    let ascii: bool = (r.flags & RX_ASCII) != 0
    if (fl & (C_SPACE | C_NSPACE)) != 0 {
        let mut sp: bool = rx_is_space(cp)
        if ascii and cp >= 128 {
            sp = false
        }
        if (fl & C_SPACE) != 0 and sp {
            return true
        }
        if (fl & C_NSPACE) != 0 and not sp {
            return true
        }
    }
    if (fl & (C_WORD | C_NWORD)) != 0 {
        let mut wd: bool = rx_is_word(cp)
        if ascii and cp >= 128 {
            wd = false
        }
        if (fl & C_WORD) != 0 and wd {
            return true
        }
        if (fl & C_NWORD) != 0 and not wd {
            return true
        }
    }
    if (fl & (C_DIGIT | C_NDIGIT)) != 0 {
        let mut dg: bool = rx_is_digit(cp)
        if ascii and cp >= 128 {
            dg = false
        }
        if (fl & C_DIGIT) != 0 and dg {
            return true
        }
        if (fl & C_NDIGIT) != 0 and not dg {
            return true
        }
    }
    return false
}

function rx_ranges_hit(r: ptr<Regex>, id: i32, cp: i32) -> bool {
    let s: i32 = r.cstart[id]
    let e: i32 = s + r.ccount[id]
    let mut i: i32 = s
    while i < e {
        if cp >= r.rlo[i] and cp <= r.rhi[i] {
            return true
        }
        i = i + 1
    }
    return false
}

function rx_class_match(r: ptr<Regex>, id: i32, cp: i32) -> bool {
    let mut hit: bool = false
    let fl: i32 = r.cflags[id]
    if fl != 0 {
        hit = rx_flag_hit(r, fl, cp)
    }
    if not hit {
        hit = rx_ranges_hit(r, id, cp)
        if not hit and (r.flags & RX_IGNORECASE) != 0 {
            let lo: i32 = rx_lower(cp)
            let up: i32 = rx_upper(cp)
            hit = (lo != cp and rx_ranges_hit(r, id, lo)) or (up != cp and rx_ranges_hit(r, id, up))
        }
    }
    if r.cneg[id] != 0 {
        return not hit
    }
    return hit
}

# Does single-character node n match the character at pos?
function rx_char_at(r: ptr<Regex>, n: i32, pos: i32) -> bool {
    if pos >= r.tlen {
        return false
    }
    let cp: i32 = r.text[pos]
    let k: i32 = r.kind[n]
    if k == N_CHAR {
        if cp == r.na[n] {
            return true
        }
        return (r.flags & RX_IGNORECASE) != 0 and rx_lower(cp) == r.na[n]
    }
    if k == N_ANY {
        return cp != 10 or (r.flags & RX_DOTALL) != 0
    }
    return rx_class_match(r, r.na[n], cp)
}

function rx_word_at(r: ptr<Regex>, pos: i32) -> bool {
    if pos < 0 or pos >= r.tlen {
        return false
    }
    let cp: i32 = r.text[pos]
    if (r.flags & RX_ASCII) != 0 and cp >= 128 {
        return false
    }
    return rx_is_word(cp)
}

function rx_push(r: ptr<Regex>, kind: i32, node: i32, count: i32, pos: i32, parent: i32) -> i32 {
    if r.fn == r.fcap {
        let nc: i32 = r.fcap * 2
        r.fkind = rx_grow(r.fkind, nc)
        r.fnode = rx_grow(r.fnode, nc)
        r.fcount = rx_grow(r.fcount, nc)
        r.fpos = rx_grow(r.fpos, nc)
        r.fparent = rx_grow(r.fparent, nc)
        r.fcap = nc
    }
    let i: i32 = r.fn
    r.fkind[i] = kind
    r.fnode[i] = node
    r.fcount[i] = count
    r.fpos[i] = pos
    r.fparent[i] = parent
    r.fn = i + 1
    return i
}

# Save every capture on the save stack; returns the mark to restore.
function rx_save_caps(r: ptr<Regex>) -> i32 {
    let mark: i32 = r.nsave
    let need: i32 = mark + 2 * (r.ngroups + 1)
    if need > r.savecap {
        while r.savecap < need {
            r.savecap = r.savecap * 2
        }
        r.save = rx_grow(r.save, r.savecap)
    }
    let mut g: i32 = 0
    while g <= r.ngroups {
        r.save[mark + 2 * g] = r.cs[g]
        r.save[mark + 2 * g + 1] = r.ce[g]
        g = g + 1
    }
    r.nsave = need
    return mark
}

function rx_restore_caps(r: ptr<Regex>, mark: i32, keep: bool) {
    if not keep {
        let mut g: i32 = 0
        while g <= r.ngroups {
            r.cs[g] = r.save[mark + 2 * g]
            r.ce[g] = r.save[mark + 2 * g + 1]
            g = g + 1
        }
    }
    r.nsave = mark
}

# Resume continuation k at pos. Returns the match end or -1.
function rx_cont(r: ptr<Regex>, pos: i32, k: i32) -> i32 {
    if k < 0 {
        # The end of the whole pattern: fullmatch must reach the end, and
        # after an empty match the next one may not be empty at its start.
        if r.need_end and pos != r.tlen {
            return 0 - 1
        }
        if pos == r.mstart and r.mstart == r.forbid_pos {
            return 0 - 1
        }
        return pos
    }
    let fk: i32 = r.fkind[k]
    if fk == F_SEQ {
        return rx_match_seq(r, r.fnode[k], pos, r.fparent[k])
    }
    if fk == F_REP {
        return rx_rep(r, r.fnode[k], r.fcount[k], pos, r.fpos[k], r.fparent[k])
    }
    if fk == F_CAPEND {
        let g: i32 = r.fnode[k]
        let old_s: i32 = r.cs[g]
        let old_e: i32 = r.ce[g]
        r.cs[g] = r.fcount[k]
        r.ce[g] = pos
        let got: i32 = rx_cont(r, pos, r.fparent[k])
        if got < 0 {
            r.cs[g] = old_s
            r.ce[g] = old_e
        }
        return got
    }
    # F_LOOKEND: a lookbehind must end where it was tried.
    if r.fpos[k] >= 0 and pos != r.fpos[k] {
        return 0 - 1
    }
    return pos
}

function rx_is_single(r: ptr<Regex>, n: i32) -> bool {
    let k: i32 = r.kind[n]
    return k == N_CHAR or k == N_ANY or k == N_CLASS
}

# Repeat node n after `count` iterations, the last one starting at lastpos.
# kafter continues past the repeat.
function rx_rep(r: ptr<Regex>, n: i32, count: i32, pos: i32, lastpos: i32, kafter: i32) -> i32 {
    let child: i32 = r.na[n]
    let lo: i32 = r.nb[n]
    let hi: i32 = r.nc[n]
    let greedy: bool = r.nd[n] != 0
    let mark: i32 = r.fn
    if count < lo {
        if count > 0 and pos == lastpos {
            return rx_cont(r, pos, kafter)
        }
        let f: i32 = rx_push(r, F_REP, n, count + 1, pos, kafter)
        let got: i32 = rx_match_seq(r, child, pos, f)
        r.fn = mark
        return got
    }
    let can_more: bool = (hi < 0 or count < hi) and pos != lastpos
    if greedy {
        if can_more {
            let f2: i32 = rx_push(r, F_REP, n, count + 1, pos, kafter)
            let got2: i32 = rx_match_seq(r, child, pos, f2)
            r.fn = mark
            if got2 >= 0 {
                return got2
            }
        }
        return rx_cont(r, pos, kafter)
    }
    let got3: i32 = rx_cont(r, pos, kafter)
    if got3 >= 0 {
        return got3
    }
    if can_more {
        let f3: i32 = rx_push(r, F_REP, n, count + 1, pos, kafter)
        let got4: i32 = rx_match_seq(r, child, pos, f3)
        r.fn = mark
        return got4
    }
    return 0 - 1
}

# Group n at pos, then continuation `after`.
function rx_group(r: ptr<Regex>, n: i32, pos: i32, after: i32) -> i32 {
    let mark: i32 = r.fn
    let mut k: i32 = after
    let g: i32 = r.nc[n]
    if g > 0 and r.caps {
        k = rx_push(r, F_CAPEND, g, pos, 0, after)
    }
    let first: i32 = r.na[n]
    let count: i32 = r.nb[n]
    let mut i: i32 = 0
    while i < count {
        let got: i32 = rx_match_seq(r, r.alts[first + i], pos, k)
        if got >= 0 {
            r.fn = mark
            return got
        }
        i = i + 1
    }
    r.fn = mark
    return 0 - 1
}

# Lookaround node n at pos, then the rest of the sequence from `rest`.
function rx_look(r: ptr<Regex>, n: i32, pos: i32, rest: i32, k: i32) -> i32 {
    let kind: i32 = r.nb[n]
    let behind: bool = kind == LK_BEHIND or kind == LK_NBEHIND
    let negative: bool = kind == LK_NAHEAD or kind == LK_NBEHIND
    let saved: i32 = rx_save_caps(r)
    let mark: i32 = r.fn
    let mut hit: bool = false
    let mut look_from: i32 = pos
    let mut want_end: i32 = 0 - 1
    if behind {
        look_from = pos - r.nc[n]
        want_end = pos
    }
    if look_from >= 0 {
        let fe: i32 = rx_push(r, F_LOOKEND, 0, 0, want_end, 0 - 1)
        # The pattern end rules apply to the whole match, not inside a
        # lookaround: lift them while it runs.
        let need_end: bool = r.need_end
        let forbid: i32 = r.forbid_pos
        r.need_end = false
        r.forbid_pos = 0 - 1
        hit = rx_group(r, r.na[n], look_from, fe) >= 0
        r.need_end = need_end
        r.forbid_pos = forbid
    }
    r.fn = mark
    if hit == negative {
        rx_restore_caps(r, saved, false)
        return 0 - 1
    }
    if negative {
        rx_restore_caps(r, saved, false)
    }
    let got: i32 = rx_match_seq(r, rest, pos, k)
    rx_restore_caps(r, saved, got >= 0)
    return got
}

# Backreference to group g at pos: the end of the repeat, or -1.
function rx_backref(r: ptr<Regex>, g: i32, pos: i32) -> i32 {
    let s: i32 = r.cs[g]
    let e: i32 = r.ce[g]
    if s < 0 or e < 0 {
        return 0 - 1
    }
    let n: i32 = e - s
    if pos + n > r.tlen {
        return 0 - 1
    }
    let fold: bool = (r.flags & RX_IGNORECASE) != 0
    let mut i: i32 = 0
    while i < n {
        let a: i32 = r.text[s + i]
        let b: i32 = r.text[pos + i]
        if a != b {
            if not fold or rx_lower(a) != rx_lower(b) {
                return 0 - 1
            }
        }
        i = i + 1
    }
    return pos + n
}

# Match the sequence starting at node n from pos, then continuation k.
function rx_match_seq(r: ptr<Regex>, start: i32, start_pos: i32, k: i32) -> i32 {
    let t: ptr<i32> = r.text
    let multiline: bool = (r.flags & RX_MULTILINE) != 0
    let mut n: i32 = start
    let mut pos: i32 = start_pos
    while n >= 0 {
        let kind: i32 = r.kind[n]
        if kind == N_CHAR or kind == N_ANY or kind == N_CLASS {
            if not rx_char_at(r, n, pos) {
                return 0 - 1
            }
            pos = pos + 1
        } elif kind == N_BOL {
            let at_line_start: bool = pos == 0 or (multiline and t[pos - 1] == 10)
            if at_line_start == false {
                return 0 - 1
            }
        } elif kind == N_EOL {
            let at_end: bool = pos == r.tlen
            let before_final_nl: bool = pos == r.tlen - 1 and t[pos] == 10
            let at_line_end: bool = at_end or before_final_nl or (multiline and pos < r.tlen and t[pos] == 10)
            if at_line_end == false {
                return 0 - 1
            }
        } elif kind == N_BOS {
            if pos != 0 {
                return 0 - 1
            }
        } elif kind == N_EOS {
            if pos != r.tlen {
                return 0 - 1
            }
        } elif kind == N_WORDB or kind == N_NWORDB {
            let edge: bool = rx_word_at(r, pos - 1) != rx_word_at(r, pos)
            if kind == N_WORDB and not edge {
                return 0 - 1
            }
            if kind == N_NWORDB and edge {
                return 0 - 1
            }
        } elif kind == N_BACKREF {
            pos = rx_backref(r, r.na[n], pos)
            if pos < 0 {
                return 0 - 1
            }
        } elif kind == N_LOOK {
            return rx_look(r, n, pos, r.next[n], k)
        } elif kind == N_GROUP {
            let mark: i32 = r.fn
            let mut after: i32 = k
            if r.next[n] >= 0 {
                after = rx_push(r, F_SEQ, r.next[n], 0, 0, k)
            }
            let got: i32 = rx_group(r, n, pos, after)
            r.fn = mark
            return got
        } else {
            # N_REPEAT
            let mark2: i32 = r.fn
            let mut after2: i32 = k
            if r.next[n] >= 0 {
                after2 = rx_push(r, F_SEQ, r.next[n], 0, 0, k)
            }
            let child: i32 = r.na[n]
            let lo: i32 = r.nb[n]
            let hi: i32 = r.nc[n]
            if rx_is_single(r, child) {
                let mut j: i32 = pos
                let mut got_n: i32 = 0
                while (hi < 0 or got_n < hi) and rx_char_at(r, child, j) {
                    j = j + 1
                    got_n = got_n + 1
                }
                if got_n < lo {
                    r.fn = mark2
                    return 0 - 1
                }
                if r.nd[n] != 0 {
                    let mut c: i32 = got_n
                    while c >= lo {
                        let res: i32 = rx_cont(r, pos + c, after2)
                        if res >= 0 {
                            r.fn = mark2
                            return res
                        }
                        c = c - 1
                    }
                } else {
                    let mut c2: i32 = lo
                    while c2 <= got_n {
                        let res2: i32 = rx_cont(r, pos + c2, after2)
                        if res2 >= 0 {
                            r.fn = mark2
                            return res2
                        }
                        c2 = c2 + 1
                    }
                }
                r.fn = mark2
                return 0 - 1
            }
            let res3: i32 = rx_rep(r, n, 0, pos, 0 - 1, after2)
            r.fn = mark2
            return res3
        }
        n = r.next[n]
    }
    return rx_cont(r, pos, k)
}

# One attempt at each start position from `from` (only `from` itself when
# `anchored`). On success cs[0], ce[0] hold the match.
function rx_exec(r: ptr<Regex>, text: ptr<i32>, tlen: i32, from_pos: i32, anchored: bool, need_end: bool, must_advance: bool) -> bool {
    if strlen(r.error) > 0 or from_pos > tlen {
        return false
    }
    r.text = text
    r.tlen = tlen
    r.need_end = need_end
    r.forbid_pos = 0 - 1
    if must_advance {
        r.forbid_pos = from_pos
    }
    # A top group with one alternative that starts with a literal lets the
    # scan skip positions that cannot start a match.
    let mut lead: i32 = 0 - 1
    let top: i32 = r.start
    if r.nb[top] == 1 and r.nc[top] == 0 and (r.flags & RX_IGNORECASE) == 0 {
        let s0: i32 = r.alts[r.na[top]]
        if s0 >= 0 and r.kind[s0] == N_CHAR {
            lead = r.na[s0]
        }
    }
    let mut s: i32 = from_pos
    while s <= tlen {
        if lead < 0 or (s < tlen and text[s] == lead) {
            r.fn = 0
            r.nsave = 0
            r.mstart = s
            let mut g: i32 = 0
            while g <= r.ngroups {
                r.cs[g] = 0 - 1
                r.ce[g] = 0 - 1
                g = g + 1
            }
            let end: i32 = rx_match_seq(r, top, s, 0 - 1)
            if end >= 0 {
                r.cs[0] = s
                r.ce[0] = end
                return true
            }
        }
        if anchored {
            return false
        }
        s = s + 1
    }
    return false
}

# ---------------------------------------------------------------------------
# Searching
# ---------------------------------------------------------------------------

# re.search on already-decoded text, as a yes or no.
export function rx_test_cps(r: ptr<Regex>, text: ptr<i32>, tlen: i32) -> bool {
    r.caps = r.has_backref
    let hit: bool = rx_exec(r, text, tlen, 0, false, false, false)
    r.caps = true
    return hit
}

# True when the pattern matches anywhere in `text` (re.search as a bool).
export function rx_test(r: ptr<Regex>, text: string) -> bool {
    let lenp: ptr<i32> = rx_alloc(1)
    let cps: ptr<i32> = rx_decode(text, lenp)
    return rx_test_cps(r, cps, lenp[0])
}

function rx_capture(r: ptr<Regex>, t: ptr<RxText>) -> ptr<RxMatch> {
    let m: ptr<RxMatch> = malloc(40) as ptr<RxMatch>
    m.re = r
    m.text = t
    m.ngroups = r.ngroups
    m.starts = rx_alloc(r.ngroups + 1)
    m.ends = rx_alloc(r.ngroups + 1)
    let mut g: i32 = 0
    while g <= r.ngroups {
        m.starts[g] = r.cs[g]
        m.ends[g] = r.ce[g]
        g = g + 1
    }
    return m
}

function rx_find_in(r: ptr<Regex>, t: ptr<RxText>, from_pos: i32, anchored: bool, need_end: bool, must_advance: bool) -> ptr<RxMatch> {
    if rx_exec(r, t.cps, t.len, from_pos, anchored, need_end, must_advance) {
        return rx_capture(r, t)
    }
    return null as ptr<RxMatch>
}

# re.search: the first match anywhere in `text`, or null.
export function rx_search(r: ptr<Regex>, text: string) -> ptr<RxMatch> {
    return rx_find_in(r, rx_text(text), 0, false, false, false)
}

# pattern.search(text, pos): the first match at or after code point `pos`.
# ^ and \b still see the text before `pos`.
export function rx_search_from(r: ptr<Regex>, text: string, pos: i32) -> ptr<RxMatch> {
    let t: ptr<RxText> = rx_text(text)
    let mut p: i32 = pos
    if p < 0 {
        p = 0
    }
    return rx_find_in(r, t, p, false, false, false)
}

# re.match: a match that starts at the beginning of `text`, or null.
export function rx_match(r: ptr<Regex>, text: string) -> ptr<RxMatch> {
    return rx_find_in(r, rx_text(text), 0, true, false, false)
}

# re.fullmatch: a match that covers all of `text`, or null.
export function rx_fullmatch(r: ptr<Regex>, text: string) -> ptr<RxMatch> {
    return rx_find_in(r, rx_text(text), 0, true, true, false)
}

# re.finditer: the match after `m` in the same text, or null. An empty
# match is followed by a search that may not match empty at the same place.
export function rx_next(m: ptr<RxMatch>) -> ptr<RxMatch> {
    let next_pos: i32 = m.ends[0]
    let was_empty: bool = m.starts[0] == m.ends[0]
    return rx_find_in(m.re, m.text, next_pos, false, false, was_empty)
}

# ---------------------------------------------------------------------------
# Match objects
# ---------------------------------------------------------------------------

# Number of capture groups (group 0 is the whole match and not counted).
export function rx_m_groups(m: ptr<RxMatch>) -> i32 {
    return m.ngroups
}

# True when group g took part in the match.
export function rx_m_matched(m: ptr<RxMatch>, g: i32) -> bool {
    return g >= 0 and g <= m.ngroups and m.starts[g] >= 0
}

# Text of group g; "" when it did not take part (Python's None).
export function rx_m_group(m: ptr<RxMatch>, g: i32) -> string {
    if not rx_m_matched(m, g) {
        return ""
    }
    return rx_text_slice(m.text, m.starts[g], m.ends[g])
}

# Text of the group called `name`.
export function rx_m_named(m: ptr<RxMatch>, name: string) -> string {
    return rx_m_group(m, rx_group_index(m.re, name))
}

# Start and end of group g in code points, as Python's m.start(g) and
# m.end(g); -1 when the group did not take part.
export function rx_m_start(m: ptr<RxMatch>, g: i32) -> i32 {
    if not rx_m_matched(m, g) {
        return 0 - 1
    }
    return m.starts[g]
}

export function rx_m_end(m: ptr<RxMatch>, g: i32) -> i32 {
    if not rx_m_matched(m, g) {
        return 0 - 1
    }
    return m.ends[g]
}

# Start and end of group g as UTF-8 byte offsets into the Flow string.
export function rx_m_byte_start(m: ptr<RxMatch>, g: i32) -> i32 {
    if not rx_m_matched(m, g) {
        return 0 - 1
    }
    return m.text.offs[m.starts[g]]
}

export function rx_m_byte_end(m: ptr<RxMatch>, g: i32) -> i32 {
    if not rx_m_matched(m, g) {
        return 0 - 1
    }
    return m.text.offs[m.ends[g]]
}

# ---------------------------------------------------------------------------
# String lists
# ---------------------------------------------------------------------------

function rx_strs_new(width: i32) -> ptr<RxStrs> {
    let l: ptr<RxStrs> = malloc(24) as ptr<RxStrs>
    l.cap = 8
    l.len = 0
    l.width = width
    l.items = malloc(64) as ptr<string>
    return l
}

function rx_strs_push(l: ptr<RxStrs>, s: string) {
    if l.len == l.cap {
        l.cap = l.cap * 2
        l.items = realloc(l.items as ptr<void>, (l.cap as i64) * 8) as ptr<string>
    }
    l.items[l.len] = s
    l.len = l.len + 1
}

export function rx_strs_len(l: ptr<RxStrs>) -> i32 {
    return l.len
}

export function rx_strs_get(l: ptr<RxStrs>, i: i32) -> string {
    if i < 0 or i >= l.len {
        return ""
    }
    return l.items[i]
}

# Strings per match in a findall result: 1, or the group count when the
# pattern has two or more groups.
export function rx_strs_width(l: ptr<RxStrs>) -> i32 {
    return l.width
}

# ---------------------------------------------------------------------------
# findall, sub, split, escape
# ---------------------------------------------------------------------------

# re.findall. With no groups each item is a whole match, with one group it
# is that group, and with more the groups of each match follow one another
# (rx_strs_width per match). A group that did not take part gives "".
export function rx_findall(r: ptr<Regex>, text: string) -> ptr<RxStrs> {
    let mut width: i32 = 1
    if r.ngroups > 1 {
        width = r.ngroups
    }
    let out: ptr<RxStrs> = rx_strs_new(width)
    let t: ptr<RxText> = rx_text(text)
    let mut m: ptr<RxMatch> = rx_find_in(r, t, 0, false, false, false)
    while m != null {
        if r.ngroups == 0 {
            rx_strs_push(out, rx_m_group(m, 0))
        } else {
            let mut g: i32 = 1
            while g <= r.ngroups {
                rx_strs_push(out, rx_m_group(m, g))
                g = g + 1
            }
        }
        m = rx_next(m)
    }
    return out
}

# Append the expansion of a sub() template for match m. Returns false on a
# bad template (the message goes to r.error).
function rx_expand_into(b: ptr<ByteBuf>, m: ptr<RxMatch>, tmpl: string) -> bool {
    let p: ptr<u8> = tmpl as ptr<u8>
    let n: i32 = strlen(tmpl) as i32
    let mut i: i32 = 0
    while i < n {
        let c: u8 = p[i]
        if c != 92 or i + 1 >= n {
            bb_putc(b, c)
            i = i + 1
            continue
        }
        let e: u8 = p[i + 1]
        if e >= 48 and e <= 57 {
            if e == 48 {
                # \0: an octal escape (NUL unless digits follow).
                bb_putc(b, 0)
                i = i + 2
                continue
            }
            let mut g: i32 = (e - 48) as i32
            i = i + 2
            if i < n and p[i] >= 48 and p[i] <= 57 {
                g = g * 10 + ((p[i] - 48) as i32)
                i = i + 1
            }
            if g > m.ngroups {
                m.re.error = "invalid group reference in template"
                return false
            }
            bb_puts(b, rx_m_group(m, g))
            continue
        }
        if e == 103 and i + 2 < n and p[i + 2] == 60 {
            # \g<name> or \g<number>
            let mut j: i32 = i + 3
            while j < n and p[j] != 62 {
                j = j + 1
            }
            if j >= n {
                m.re.error = "missing >, unterminated name in template"
                return false
            }
            let nb: ptr<ByteBuf> = bb_new(j - i)
            bb_put_span(nb, p, i + 3, j)
            let name: string = bb_str(nb)
            bb_free(nb)
            let np: ptr<u8> = name as ptr<u8>
            let mut gi: i32 = 0 - 1
            if strlen(name) > 0 and np[0] >= 48 and np[0] <= 57 {
                gi = 0
                let mut q: i32 = 0
                while np[q] != 0 {
                    if np[q] < 48 or np[q] > 57 {
                        m.re.error = "bad character in group name in template"
                        return false
                    }
                    gi = gi * 10 + ((np[q] - 48) as i32)
                    q = q + 1
                }
            } else {
                gi = rx_group_index(m.re, name)
            }
            if gi < 0 or gi > m.ngroups {
                m.re.error = "unknown group name in template"
                return false
            }
            bb_puts(b, rx_m_group(m, gi))
            i = j + 1
            continue
        }
        let mut lit: i32 = 0 - 1
        if e == 110 { lit = 10 }
        if e == 116 { lit = 9 }
        if e == 114 { lit = 13 }
        if e == 102 { lit = 12 }
        if e == 118 { lit = 11 }
        if e == 97 { lit = 7 }
        if e == 98 { lit = 8 }
        if e == 92 { lit = 92 }
        if lit >= 0 {
            bb_putc(b, lit as u8)
            i = i + 2
            continue
        }
        if (e >= 65 and e <= 90) or (e >= 97 and e <= 122) {
            m.re.error = "bad escape in template"
            return false
        }
        # Any other escaped character stays as written, backslash and all.
        bb_putc(b, c)
        bb_putc(b, e)
        i = i + 2
    }
    return true
}

# m.expand(template): the template with \1, \g<name> and escapes filled in.
export function rx_m_expand(m: ptr<RxMatch>, tmpl: string) -> string {
    let b: ptr<ByteBuf> = bb_new(64)
    let _ok: bool = rx_expand_into(b, m, tmpl)
    let s: string = bb_str(b)
    bb_free(b)
    return s
}

# re.sub: `text` with the first `count` matches (all when count is 0)
# replaced by the expansion of `repl`. A bad template leaves `text` as it
# is and sets rx_error.
export function rx_sub(r: ptr<Regex>, repl: string, text: string, count: i32) -> string {
    let t: ptr<RxText> = rx_text(text)
    let b: ptr<ByteBuf> = bb_new((strlen(text) as i32) + 16)
    let src: ptr<u8> = text as ptr<u8>
    let mut last: i32 = 0
    let mut n: i32 = 0
    let mut m: ptr<RxMatch> = rx_find_in(r, t, 0, false, false, false)
    while m != null and (count <= 0 or n < count) {
        bb_put_span(b, src, t.offs[last], t.offs[m.starts[0]])
        if rx_expand_into(b, m, repl) == false {
            bb_free(b)
            return text
        }
        last = m.ends[0]
        n = n + 1
        m = rx_next(m)
    }
    bb_put_span(b, src, t.offs[last], t.offs[t.len])
    let out: string = bb_str(b)
    bb_free(b)
    return out
}

# re.split: the pieces of `text` between matches, with the groups of each
# match in between. At most `maxsplit` splits when it is above 0.
export function rx_split(r: ptr<Regex>, text: string, maxsplit: i32) -> ptr<RxStrs> {
    let out: ptr<RxStrs> = rx_strs_new(1)
    let t: ptr<RxText> = rx_text(text)
    let mut last: i32 = 0
    let mut n: i32 = 0
    let mut m: ptr<RxMatch> = rx_find_in(r, t, 0, false, false, false)
    while m != null and (maxsplit <= 0 or n < maxsplit) {
        rx_strs_push(out, rx_text_slice(t, last, m.starts[0]))
        let mut g: i32 = 1
        while g <= r.ngroups {
            rx_strs_push(out, rx_m_group(m, g))
            g = g + 1
        }
        last = m.ends[0]
        n = n + 1
        m = rx_next(m)
    }
    rx_strs_push(out, rx_text_slice(t, last, t.len))
    return out
}

# re.escape: `s` with every character that has a meaning in a pattern
# escaped, so the pattern matches `s` literally.
export function rx_escape(s: string) -> string {
    let p: ptr<u8> = s as ptr<u8>
    let n: i32 = strlen(s) as i32
    let b: ptr<ByteBuf> = bb_new(n * 2 + 1)
    # Python 3.7's set: ( ) [ ] { } ? * + - | ^ $ \ . & ~ # space and
    # \t \n \v \f \r.
    let special: string = "()[]{}?*+-|^$\\.&~# "
    let sp: ptr<u8> = special as ptr<u8>
    let sn: i32 = strlen(special) as i32
    let mut i: i32 = 0
    while i < n {
        let c: u8 = p[i]
        let mut esc: bool = c >= 9 and c <= 13
        let mut k: i32 = 0
        while k < sn and not esc {
            if sp[k] == c {
                esc = true
            }
            k = k + 1
        }
        if esc {
            bb_putc(b, 92)
        }
        bb_putc(b, c)
        i = i + 1
    }
    let out: string = bb_str(b)
    bb_free(b)
    return out
}
