# =============================================================================
# Common IP Addresses
# =============================================================================

const INADDR_ANY: i32 = 0
const INADDR_LOOPBACK: i32 = 2130706433  # 127.0.0.1
const INADDR_BROADCAST: i32 = -1         # 255.255.255.255
