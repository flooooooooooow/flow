# FLOW Networking Standard Library
# TCP/UDP sockets, HTTP client

struct Socket {
    fd: i32,
    domain: i32,
    socket_type: i32,
    protocol: i32
}

struct SockAddr_in {
    family: u16,
    port: u16,
    addr: u32,
    zero: array<u8, 8>
}

extern {
    function flow_net_htons(hostshort: i16) -> u16
    function flow_net_htonl(hostlong: i32) -> u32
    function flow_net_socket(domain: i32, sock_type: i32, protocol: i32) -> i32
    function flow_net_bind(fd: i32, addr: ptr<SockAddr_in>, len: u32) -> i32
    function flow_net_listen(fd: i32, backlog: i32) -> i32
    function flow_net_accept(fd: i32, addr: ptr<SockAddr_in>, len: ptr<u32>) -> i32
    function flow_net_recv(fd: i32, buf: ptr<u8>, len: u32, flags: i32) -> i32
    function flow_net_send(fd: i32, buf: ptr<u8>, len: u32, flags: i32) -> i32
    function flow_net_connect(fd: i32, addr: ptr<SockAddr_in>, len: u32) -> i32
    function flow_net_set_reuseaddr(fd: i32) -> void
}

function sockaddr_in_new(port: i32, addr: i32) -> SockAddr_in {
    return SockAddr_in {
        family: 2,       # AF_INET
        port: flow_net_htons(port as i16),
        addr: flow_net_htonl(addr),
        zero: []
    }
}

const AF_INET: i32 = 2
const INADDR_ANY: i32 = 0

struct TcpListener {
    socket: Socket,
    port: i32
}

struct TcpStream {
    socket: Socket,
    connected: bool
}

function tcp_listener_new(port: i32) -> TcpListener {
    let fd = flow_net_socket(2, 1, 0)
    let sock = Socket { fd: fd, domain: 2, socket_type: 1, protocol: 0 }
    return TcpListener { socket: sock, port: port }
}

function tcp_stream_new() -> TcpStream {
    let fd = flow_net_socket(2, 1, 0)
    let sock = Socket { fd: fd, domain: 2, socket_type: 1, protocol: 0 }
    return TcpStream { socket: sock, connected: false }
}

function tcp_stream_is_connected(stream: TcpStream) -> bool {
    return stream.connected
}

struct UdpSocket {
    socket: Socket,
    bound: bool
}

function udp_socket_new() -> UdpSocket {
    let fd = flow_net_socket(2, 2, 0)
    let sock = Socket { fd: fd, domain: 2, socket_type: 2, protocol: 0 }
    return UdpSocket { socket: sock, bound: false }
}

struct HttpResponse {
    status_code: i32,
    body_length: i32,
    success: bool
}

struct HttpRequest {
    method: string,
    url: string,
    host: string,
    port: i32
}

function http_request_new(method: string, url: string) -> HttpRequest {
    return HttpRequest { method: method, url: url, host: "", port: 80 }
}

function http_get(url: string) -> HttpResponse {
    return HttpResponse { status_code: 0, body_length: 0, success: false }
}

function http_post(url: string, body: string) -> HttpResponse {
    return HttpResponse { status_code: 0, body_length: 0, success: false }
}

extern {
    function gethostbyname(name: string) -> ptr<i8>
}

function resolve_hostname(hostname: string) -> i32 {
    return 0
}
