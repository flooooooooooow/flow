# Manual memory management — real libc heap (C backend)
#
# Flow has no GC. Heap memory is yours to allocate and free.
# Prefer arenas in hot paths; always free what you malloc.

extern {
    function malloc(size: i64) -> ptr<void>
    function calloc(nmemb: i64, size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

# ── Sizes ──────────────────────────────────────────────────────────

export function sizeof_i8() -> i64 { return 1 }
export function sizeof_i32() -> i64 { return 4 }
export function sizeof_i64() -> i64 { return 8 }
export function sizeof_f32() -> i64 { return 4 }
export function sizeof_f64() -> i64 { return 8 }
export function sizeof_ptr() -> i64 { return 8 }

# Generic sizeof — C backend emits `(int64_t)sizeof(T)` after monomorphization.
# Body is a placeholder; never executed as written.
function sizeof<T>() -> i64 {
    return 0
}

export function alignof_i32() -> i64 { return 4 }
export function alignof_i64() -> i64 { return 8 }
export function alignof_f32() -> i64 { return 4 }
export function alignof_f64() -> i64 { return 8 }

# ── Alignment helpers ───────────────────────────────────────────────

export function is_power_of_two(value: i64) -> bool {
    if value <= 0 {
        return false
    }
    return (value & (value - 1)) == 0
}

export function align_up(size: i64, alignment: i64) -> i64 {
    if !is_power_of_two(alignment) {
        return size
    }
    return (size + alignment - 1) & ~(alignment - 1)
}

export function align_down(size: i64, alignment: i64) -> i64 {
    if !is_power_of_two(alignment) {
        return size
    }
    return size & ~(alignment - 1)
}

# ── Typed heap helpers ──────────────────────────────────────────────

export function alloc_bytes(size: i64) -> ptr<void> {
    return malloc(size)
}

export function alloc_zeroed(size: i64) -> ptr<void> {
    return calloc(1, size)
}

export function alloc_i32(count: i64) -> ptr<i32> {
    return calloc(count, sizeof_i32())
}

export function alloc_f32(count: i64) -> ptr<f32> {
    return calloc(count, sizeof_f32())
}

export function alloc_f64(count: i64) -> ptr<f64> {
    return calloc(count, sizeof_f64())
}

export function memory_zero_i32(p: ptr<i32>, count: i64) -> void {
    let mut i: i64 = 0
    while i < count {
        p[i] = 0
        i = i + 1
    }
}

export function memory_copy_i32(dst: ptr<i32>, src: ptr<i32>, count: i64) -> void {
    let mut i: i64 = 0
    while i < count {
        dst[i] = src[i]
        i = i + 1
    }
}

# ── Uninitialized growth helpers (#424) ─────────────────────────────
# realloc without zeroing the new region. Callers must initialize every
# new element before reading it. Use grow_zeroed when zero-fill is needed.

export function grow_uninit(p: ptr<void>, new_size: i64) -> ptr<void> {
    return realloc(p, new_size)
}

export function grow_zeroed(p: ptr<void>, old_size: i64, new_size: i64) -> ptr<void> {
    let result: ptr<void> = realloc(p, new_size)
    if result != null {
        if new_size > old_size {
            let delta: i64 = new_size - old_size
            let dst: ptr<i8> = result + old_size
            let mut i: i64 = 0
            while i < delta {
                dst[i] = 0
                i = i + 1
            }
        }
    }
    return result
}

# Allocate exactly count * elem_size bytes, no minimum capacity floor.
# Callers must initialize elements before reading.
export function alloc_uninit(elem_size: i64, count: i64) -> ptr<void> {
    return malloc(elem_size * count)
}

# ── Arena (bump allocator) ──────────────────────────────────────────
# Fast sequential allocs from one slab; free everything with arena_destroy.

export struct Arena {
    buffer: ptr<i8>,
    capacity: i64,
    offset: i64
}

export function arena_create(capacity: i64) -> Arena {
    let raw: ptr<void> = malloc(capacity)
    if raw == null {
        return Arena { buffer: null, capacity: 0, offset: 0 }
    }
    let buf: ptr<i8> = raw
    return Arena { buffer: buf, capacity: capacity, offset: 0 }
}

export function arena_alloc(arena: ptr<Arena>, size: i64) -> ptr<void> {
    let a: Arena = arena[0]
    let aligned: i64 = align_up(size, 8)
    if a.buffer == null {
        return null
    }
    if a.offset + aligned > a.capacity {
        return null
    }
    let out: ptr<void> = a.buffer + a.offset
    arena[0].offset = a.offset + aligned
    return out
}

export function arena_alloc_i32(arena: ptr<Arena>, count: i64) -> ptr<i32> {
    return arena_alloc(arena, count * sizeof_i32())
}

export function arena_alloc_f32(arena: ptr<Arena>, count: i64) -> ptr<f32> {
    return arena_alloc(arena, count * sizeof_f32())
}

export function arena_reset(arena: ptr<Arena>) -> void {
    arena[0].offset = 0
}

export function arena_destroy(arena: ptr<Arena>) -> void {
    let a: Arena = arena[0]
    if a.buffer != null {
        let mut p: ptr<void> = a.buffer
        free(p)
    }
    arena[0].buffer = null
    arena[0].capacity = 0
    arena[0].offset = 0
}

export function arena_used(arena: Arena) -> i64 {
    return arena.offset
}

export function arena_remaining(arena: Arena) -> i64 {
    return arena.capacity - arena.offset
}

# ── Frame domain (docs/language/lifetime-domains.md) ─────────────────
# An Arena plus the bookkeeping a frame loop wants: how deep the deepest
# frame went, and how many frames have run. Freeing a whole frame's worth
# of allocations is `frame_begin`, which is one store of zero.
#
# Create and destroy at startup and shutdown. Everything else on this
# list is bump-pointer arithmetic and is legal in the `callback` and
# `frame` domains and inside `@rt_safe`.

export struct FrameArena {
    arena: Arena,
    high_water: i64,
    frames: i64
}

export function frame_arena_create(capacity: i64) -> FrameArena {
    let a: Arena = arena_create(capacity)
    return FrameArena { arena: a, high_water: 0, frames: 0 }
}

export function frame_arena_destroy(f: ptr<FrameArena>) -> void {
    let buf: ptr<i8> = f[0].arena.buffer
    if buf != null {
        let mut p: ptr<void> = buf
        free(p)
    }
    f[0].arena.buffer = null
    f[0].arena.capacity = 0
    f[0].arena.offset = 0
}

# Reset the frame. This is the whole deallocation.
export function frame_begin(f: ptr<FrameArena>) -> void {
    f[0].arena.offset = 0
}

export function frame_alloc(f: ptr<FrameArena>, size: i64) -> ptr<void> {
    let base: ptr<i8> = f[0].arena.buffer
    let off: i64 = f[0].arena.offset
    let cap: i64 = f[0].arena.capacity
    let aligned: i64 = align_up(size, 8)
    if base == null {
        return null
    }
    if off + aligned > cap {
        return null
    }
    let out: ptr<void> = base + off
    f[0].arena.offset = off + aligned
    return out
}

export function frame_alloc_i32(f: ptr<FrameArena>, count: i64) -> ptr<i32> {
    return frame_alloc(f, count * sizeof_i32())
}

export function frame_alloc_f32(f: ptr<FrameArena>, count: i64) -> ptr<f32> {
    return frame_alloc(f, count * sizeof_f32())
}

export function frame_alloc_f64(f: ptr<FrameArena>, count: i64) -> ptr<f64> {
    return frame_alloc(f, count * sizeof_f64())
}

# Close the frame: record the high-water mark so a fixed capacity can be
# sized from a real run, and count the frame.
export function frame_end(f: ptr<FrameArena>) -> void {
    let used: i64 = f[0].arena.offset
    if used > f[0].high_water {
        f[0].high_water = used
    }
    f[0].frames = f[0].frames + 1
}

export function frame_used(f: FrameArena) -> i64 {
    return f.arena.offset
}

export function frame_remaining(f: FrameArena) -> i64 {
    return f.arena.capacity - f.arena.offset
}

export function frame_high_water(f: FrameArena) -> i64 {
    return f.high_water
}

export function frame_count(f: FrameArena) -> i64 {
    return f.frames
}
