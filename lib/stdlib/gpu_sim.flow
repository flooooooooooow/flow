# GPU simulation layer (CPU-backed) to model DeviceContext/Queue/Buffer/Layouts.
# This is a compatibility + teaching layer to mirror Mojo-style APIs.

extern {
    function malloc(size: i32) -> ptr<void>
    function free(ptr: ptr<void>) -> void
    function memcpy(dest: ptr<void>, src: ptr<void>, n: i32) -> ptr<void>
}

struct DeviceContext {
    has_gpu: bool,
    queue_depth: i32,
}

struct DeviceProperties {
    name: string,
    max_threads_per_block: i32,
    warp_size: i32,
    max_blocks: i32,
    max_shared_kb: i32,
    supports_fp16: bool,
    supports_int64: bool,
}

struct CommandQueue {
    pending: i32,
}

struct Dim3 {
    x: i32,
    y: i32,
    z: i32,
}

struct LaunchConfig {
    grid: Dim3,
    block: Dim3,
    total_threads: i32,
}

struct HostBufferF32 {
    data: ptr<f32>,
    len: i32,
}

struct DeviceBufferF32 {
    data: ptr<f32>,
    len: i32,
}

struct Layout {
    size: i32,
    stride: i32,
}

struct Layout2D {
    rows: i32,
    cols: i32,
    stride: i32,
}

struct Layout3D {
    depth: i32,
    rows: i32,
    cols: i32,
    stride_y: i32,
    stride_z: i32,
}

struct LayoutTensorF32 {
    data: ptr<f32>,
    layout: Layout,
}

struct LayoutTensor2DF32 {
    data: ptr<f32>,
    layout: Layout2D,
}

struct LayoutTensor3DF32 {
    data: ptr<f32>,
    layout: Layout3D,
}

function device_context() -> DeviceContext {
    return DeviceContext { has_gpu: true, queue_depth: 0 }
}

function device_properties(ctx: DeviceContext) -> DeviceProperties {
    return DeviceProperties {
        name: "FLOW GPU Sim",
        max_threads_per_block: 1024,
        warp_size: 32,
        max_blocks: 65535,
        max_shared_kb: 48,
        supports_fp16: true,
        supports_int64: true
    }
}

function device_queue(ctx: DeviceContext) -> CommandQueue {
    return CommandQueue { pending: 0 }
}

function host_buffer_f32(ptr: ptr<f32>, len: i32) -> HostBufferF32 {
    return HostBufferF32 { data: ptr, len: len }
}

function host_alloc_f32(len: i32) -> HostBufferF32 {
    if len <= 0 or len > 536870911 {
        return HostBufferF32 { data: null, len: 0 }
    }
    let bytes: i32 = len * 4
    let raw: ptr<f32> = malloc(bytes)
    return HostBufferF32 { data: raw, len: len }
}

function host_free_f32(buf: HostBufferF32) -> void {
    free(buf.data)
}

function device_alloc_f32(len: i32) -> DeviceBufferF32 {
    if len <= 0 or len > 536870911 {
        return DeviceBufferF32 { data: null, len: 0 }
    }
    let bytes: i32 = len * 4
    let raw: ptr<f32> = malloc(bytes)
    return DeviceBufferF32 { data: raw, len: len }
}

function device_free_f32(buf: DeviceBufferF32) -> void {
    free(buf.data)
}

function copy_host_to_device(src: HostBufferF32, dst: DeviceBufferF32) -> void {
    if src.data == null or dst.data == null or src.len <= 0 or
       src.len > dst.len or src.len > 536870911 {
        return
    }
    let bytes: i32 = src.len * 4
    memcpy(dst.data, src.data, bytes)
}

function copy_device_to_host(src: DeviceBufferF32, dst: HostBufferF32) -> void {
    if src.data == null or dst.data == null or src.len <= 0 or
       src.len > dst.len or src.len > 536870911 {
        return
    }
    let bytes: i32 = src.len * 4
    memcpy(dst.data, src.data, bytes)
}

function layout_1d(size: i32) -> Layout {
    if size <= 0 {
        return Layout { size: 0, stride: 0 }
    }
    return Layout { size: size, stride: 1 }
}

function layout_2d(rows: i32, cols: i32) -> Layout2D {
    if rows <= 0 or cols <= 0 or rows > 2147483647 / cols {
        return Layout2D { rows: 0, cols: 0, stride: 0 }
    }
    return Layout2D { rows: rows, cols: cols, stride: cols }
}

function layout_3d(depth: i32, rows: i32, cols: i32) -> Layout3D {
    if depth <= 0 or rows <= 0 or cols <= 0 or rows > 2147483647 / cols {
        return Layout3D { depth: 0, rows: 0, cols: 0, stride_y: 0, stride_z: 0 }
    }
    let plane: i32 = rows * cols
    if depth > 2147483647 / plane {
        return Layout3D { depth: 0, rows: 0, cols: 0, stride_y: 0, stride_z: 0 }
    }
    let stride_y: i32 = cols
    let stride_z: i32 = plane
    return Layout3D { depth: depth, rows: rows, cols: cols, stride_y: stride_y, stride_z: stride_z }
}

function tensor_from_device(buf: DeviceBufferF32, layout: Layout) -> LayoutTensorF32 {
    return LayoutTensorF32 { data: buf.data, layout: layout }
}

function tensor_from_host(buf: HostBufferF32, layout: Layout) -> LayoutTensorF32 {
    return LayoutTensorF32 { data: buf.data, layout: layout }
}

function tensor2d_from_device(buf: DeviceBufferF32, layout: Layout2D) -> LayoutTensor2DF32 {
    return LayoutTensor2DF32 { data: buf.data, layout: layout }
}

function tensor2d_from_host(buf: HostBufferF32, layout: Layout2D) -> LayoutTensor2DF32 {
    return LayoutTensor2DF32 { data: buf.data, layout: layout }
}

function tensor3d_from_device(buf: DeviceBufferF32, layout: Layout3D) -> LayoutTensor3DF32 {
    return LayoutTensor3DF32 { data: buf.data, layout: layout }
}

function tensor3d_from_host(buf: HostBufferF32, layout: Layout3D) -> LayoutTensor3DF32 {
    return LayoutTensor3DF32 { data: buf.data, layout: layout }
}

function layout_index_2d(layout: Layout2D, row: i32, col: i32) -> i32 {
    return row * layout.stride + col
}

function layout_index_3d(layout: Layout3D, z: i32, row: i32, col: i32) -> i32 {
    return z * layout.stride_z + row * layout.stride_y + col
}

# Empty configuration is an explicit failure value, never a dispatch.
# The CPU simulator uses signed i32 dimensions and 1024 threads per block.
function grid_invalid() -> LaunchConfig {
    let zero: Dim3 = Dim3 { x: 0, y: 0, z: 0 }
    return LaunchConfig { grid: zero, block: zero, total_threads: 0 }
}

function grid_1d(n: i32, block_x: i32) -> LaunchConfig {
    if n <= 0 or block_x <= 0 or block_x > 1024 {
        return grid_invalid()
    }
    # Ceil division without n + block_x - 1 overflow.
    let blocks: i32 = (n - 1) / block_x + 1
    if blocks > 2147483647 / block_x {
        return grid_invalid()
    }
    let grid: Dim3 = Dim3 { x: blocks, y: 1, z: 1 }
    let block: Dim3 = Dim3 { x: block_x, y: 1, z: 1 }
    return LaunchConfig { grid: grid, block: block, total_threads: blocks * block_x }
}

function grid_2d(width: i32, height: i32, block_x: i32, block_y: i32) -> LaunchConfig {
    if width <= 0 or height <= 0 or block_x <= 0 or block_y <= 0 {
        return grid_invalid()
    }
    if block_x > 1024 or block_y > 1024 / block_x {
        return grid_invalid()
    }
    let threads: i32 = block_x * block_y
    let blocks_x: i32 = (width - 1) / block_x + 1
    let blocks_y: i32 = (height - 1) / block_y + 1
    if blocks_x > 2147483647 / blocks_y {
        return grid_invalid()
    }
    let blocks: i32 = blocks_x * blocks_y
    if blocks > 2147483647 / threads {
        return grid_invalid()
    }
    let grid: Dim3 = Dim3 { x: blocks_x, y: blocks_y, z: 1 }
    let block: Dim3 = Dim3 { x: block_x, y: block_y, z: 1 }
    return LaunchConfig { grid: grid, block: block, total_threads: blocks * threads }
}

function grid_3d(width: i32, height: i32, depth: i32, block_x: i32, block_y: i32, block_z: i32) -> LaunchConfig {
    if width <= 0 or height <= 0 or depth <= 0 or
       block_x <= 0 or block_y <= 0 or block_z <= 0 {
        return grid_invalid()
    }
    if block_x > 1024 or block_y > 1024 / block_x {
        return grid_invalid()
    }
    let xy: i32 = block_x * block_y
    if block_z > 1024 / xy {
        return grid_invalid()
    }
    let threads: i32 = xy * block_z
    let blocks_x: i32 = (width - 1) / block_x + 1
    let blocks_y: i32 = (height - 1) / block_y + 1
    let blocks_z: i32 = (depth - 1) / block_z + 1
    if blocks_x > 2147483647 / blocks_y {
        return grid_invalid()
    }
    let blocks_xy: i32 = blocks_x * blocks_y
    if blocks_xy > 2147483647 / blocks_z {
        return grid_invalid()
    }
    let blocks: i32 = blocks_xy * blocks_z
    if blocks > 2147483647 / threads {
        return grid_invalid()
    }
    let grid: Dim3 = Dim3 { x: blocks_x, y: blocks_y, z: blocks_z }
    let block: Dim3 = Dim3 { x: block_x, y: block_y, z: block_z }
    return LaunchConfig { grid: grid, block: block, total_threads: blocks * threads }
}

function enqueue_queue(q: CommandQueue) -> CommandQueue {
    return CommandQueue { pending: q.pending + 1 }
}

function synchronize(q: CommandQueue) -> CommandQueue {
    return CommandQueue { pending: 0 }
}

# CPU-backed kernel emulation
function kernel_vec_add(a: LayoutTensorF32, b: LayoutTensorF32, out: LayoutTensorF32) -> void {
    let n: i32 = a.layout.size
    let mut i: i32 = 0
    while i < n {
        out.data[i] = a.data[i] + b.data[i]
        i = i + 1
    }
}

function launch_vec_add_1d(cfg: LaunchConfig, a: LayoutTensorF32, b: LayoutTensorF32, out: LayoutTensorF32, n: i32) -> void {
    let bx: i32 = cfg.block.x
    let mut block_id: i32 = 0
    while block_id < cfg.grid.x {
        let mut thread_id: i32 = 0
        while thread_id < bx {
            let idx: i32 = block_id * bx + thread_id
            if idx < n {
                out.data[idx] = a.data[idx] + b.data[idx]
            }
            thread_id = thread_id + 1
        }
        block_id = block_id + 1
    }
}

function kernel_add_2d(a: LayoutTensor2DF32, b: LayoutTensor2DF32, out: LayoutTensor2DF32) -> void {
    let mut r: i32 = 0
    while r < a.layout.rows {
        let mut c: i32 = 0
        while c < a.layout.cols {
            let idx: i32 = layout_index_2d(a.layout, r, c)
            out.data[idx] = a.data[idx] + b.data[idx]
            c = c + 1
        }
        r = r + 1
    }
}

function kernel_add_3d(a: LayoutTensor3DF32, b: LayoutTensor3DF32, out: LayoutTensor3DF32) -> void {
    let mut z: i32 = 0
    while z < a.layout.depth {
        let mut r: i32 = 0
        while r < a.layout.rows {
            let mut c: i32 = 0
            while c < a.layout.cols {
                let idx: i32 = layout_index_3d(a.layout, z, r, c)
                out.data[idx] = a.data[idx] + b.data[idx]
                c = c + 1
            }
            r = r + 1
        }
        z = z + 1
    }
}
