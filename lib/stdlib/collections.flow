# FLOW Collections Standard Library
# HashMap, Set, Queue, Stack, Vector

# =============================================================================
# Vector (Dynamic Array)
# =============================================================================

struct Vector_i32 {
    data: ptr<i32>,
    len: i32,
    capacity: i32
}

function vector_i32_new() -> Vector_i32 {
    let cap: i32 = 4
    let mut data: ptr<i32> = null
    if cap > 0 {
        data = calloc(cap as usize, sizeof_i32()) as ptr<i32>
    }
    return Vector_i32 { data: data, len: 0, capacity: cap }
}

function vector_i32_len(v: Vector_i32) -> i32 {
    return v.len
}

function vector_i32_is_empty(v: Vector_i32) -> bool {
    return v.len == 0
}

# =============================================================================
# Stack (LIFO)
# =============================================================================

struct Stack_i32 {
    data: ptr<i32>,
    top: i32,
    capacity: i32
}

function stack_i32_new(cap: i32) -> Stack_i32 {
    let mut data: ptr<i32> = null
    if cap > 0 {
        data = calloc(cap as usize, sizeof_i32()) as ptr<i32>
    }
    return Stack_i32 { data: data, top: -1, capacity: cap }
}

function stack_i32_is_empty(s: Stack_i32) -> bool {
    return s.top < 0
}

function stack_i32_is_full(s: Stack_i32) -> bool {
    return s.top >= s.capacity - 1
}

# =============================================================================
# Queue (FIFO)
# =============================================================================

struct Queue_i32 {
    data: ptr<i32>,
    front: i32,
    rear: i32,
    size: i32,
    capacity: i32
}

function queue_i32_new(cap: i32) -> Queue_i32 {
    let mut data: ptr<i32> = null
    if cap > 0 {
        data = calloc(cap as usize, sizeof_i32()) as ptr<i32>
    }
    return Queue_i32 { data: data, front: 0, rear: -1, size: 0, capacity: cap }
}

function queue_i32_is_empty(q: Queue_i32) -> bool {
    return q.size == 0
}

function queue_i32_is_full(q: Queue_i32) -> bool {
    return q.size >= q.capacity
}

function queue_i32_len(q: Queue_i32) -> i32 {
    return q.size
}

# =============================================================================
# HashEntry and HashMap
# =============================================================================

struct HashEntry_string_i32 {
    key: string,
    value: i32,
    occupied: bool
}

struct HashMap_string_i32 {
    buckets: ptr<HashEntry_string_i32>,
    size: i32,
    capacity: i32
}

# Simple string hash function (djb2)
function hash_string(s: string) -> i32 {
    # djb2 hash - implemented via extern
    return 5381  # Placeholder - actual hashing done in C
}

function hashmap_string_i32_new(cap: i32) -> HashMap_string_i32 {
    let mut buckets: ptr<HashEntry_string_i32> = null
    if cap > 0 {
        # HashEntry_string_i32 layout is pointer + i32 + bool + padding (~16 bytes on 64-bit).
        let entry_size: usize = 16
        buckets = calloc(cap as usize, entry_size) as ptr<HashEntry_string_i32>
    }
    return HashMap_string_i32 { buckets: buckets, size: 0, capacity: cap }
}

function hashmap_string_i32_len(m: HashMap_string_i32) -> i32 {
    return m.size
}

function hashmap_string_i32_is_empty(m: HashMap_string_i32) -> bool {
    return m.size == 0
}

# =============================================================================
# HashMap_i64_i64 — open addressing for Euler / memoization (#252)
# =============================================================================

struct HashMap_i64_i64 {
    keys: ptr<i64>,
    values: ptr<i64>,
    occupied: ptr<i32>,
    size: i32,
    capacity: i32
}

function hash_i64(k: i64) -> i32 {
    let mut h: i64 = k
    if h < 0 {
        h = 0 - h
    }
    return (h % 2147483647) as i32
}

function hashmap_i64_i64_new(cap: i32) -> HashMap_i64_i64 {
    let mut c: i32 = cap
    if c < 8 {
        c = 8
    }
    let keys: ptr<i64> = calloc(c as usize, sizeof_i64()) as ptr<i64>
    let values: ptr<i64> = calloc(c as usize, sizeof_i64()) as ptr<i64>
    let occupied: ptr<i32> = calloc(c as usize, sizeof_i32()) as ptr<i32>
    return HashMap_i64_i64 {
        keys: keys,
        values: values,
        occupied: occupied,
        size: 0,
        capacity: c
    }
}

function hashmap_i64_i64_len(m: HashMap_i64_i64) -> i32 {
    return m.size
}

function hashmap_i64_i64_contains(m: HashMap_i64_i64, key: i64) -> bool {
    if m.capacity <= 0 {
        return false
    }
    let start: i32 = hash_i64(key) % m.capacity
    let mut i: i32 = start
    while true {
        if m.occupied[i] == 0 {
            return false
        }
        if m.occupied[i] == 1 {
            if m.keys[i] == key {
                return true
            }
        }
        i = i + 1
        if i >= m.capacity {
            i = 0
        }
        if i == start {
            return false
        }
    }
    return false
}

function hashmap_i64_i64_get(m: HashMap_i64_i64, key: i64, default_value: i64) -> i64 {
    if m.capacity <= 0 {
        return default_value
    }
    let start: i32 = hash_i64(key) % m.capacity
    let mut i: i32 = start
    while true {
        if m.occupied[i] == 0 {
            return default_value
        }
        if m.occupied[i] == 1 {
            if m.keys[i] == key {
                return m.values[i]
            }
        }
        i = i + 1
        if i >= m.capacity {
            i = 0
        }
        if i == start {
            return default_value
        }
    }
    return default_value
}

function hashmap_i64_i64_insert(m: HashMap_i64_i64, key: i64, value: i64) -> HashMap_i64_i64 {
    if m.capacity <= 0 {
        return m
    }
    # Soft load factor — caller should recreate with larger cap when size is high.
    let start: i32 = hash_i64(key) % m.capacity
    let mut i: i32 = start
    while true {
        if m.occupied[i] == 0 {
            m.keys[i] = key
            m.values[i] = value
            m.occupied[i] = 1
            m.size = m.size + 1
            return m
        }
        if m.occupied[i] == 1 {
            if m.keys[i] == key {
                m.values[i] = value
                return m
            }
        }
        i = i + 1
        if i >= m.capacity {
            i = 0
        }
        if i == start {
            return m
        }
    }
    return m
}

function hashmap_i64_i64_free(m: HashMap_i64_i64) -> void {
    if m.keys != null {
        free(m.keys as ptr<void>)
    }
    if m.values != null {
        free(m.values as ptr<void>)
    }
    if m.occupied != null {
        free(m.occupied as ptr<void>)
    }
}

# =============================================================================
# Set (unique elements)
# =============================================================================

struct Set_i32 {
    data: ptr<i32>,
    size: i32,
    capacity: i32
}

function set_i32_new(cap: i32) -> Set_i32 {
    let mut data: ptr<i32> = null
    if cap > 0 {
        data = calloc(cap as usize, sizeof_i32()) as ptr<i32>
    }
    return Set_i32 { data: data, size: 0, capacity: cap }
}

function set_i32_len(s: Set_i32) -> i32 {
    return s.size
}

function set_i32_is_empty(s: Set_i32) -> bool {
    return s.size == 0
}

# =============================================================================
# LinkedList Node
# =============================================================================

struct ListNode_i32 {
    value: i32,
    next: ptr<ListNode_i32>
}

struct LinkedList_i32 {
    head: ptr<ListNode_i32>,
    tail: ptr<ListNode_i32>,
    len: i32
}

function linkedlist_i32_new() -> LinkedList_i32 {
    return LinkedList_i32 { head: null, tail: null, len: 0 }
}

function linkedlist_i32_len(l: LinkedList_i32) -> i32 {
    return l.len
}

function linkedlist_i32_is_empty(l: LinkedList_i32) -> bool {
    return l.len == 0
}

# =============================================================================
# Priority Queue (Min-Heap)
# =============================================================================

struct PriorityQueue_i32 {
    data: ptr<i32>,
    size: i32,
    capacity: i32
}

function pq_i32_new(cap: i32) -> PriorityQueue_i32 {
    let mut data: ptr<i32> = null
    if cap > 0 {
        data = calloc(cap as usize, sizeof_i32()) as ptr<i32>
    }
    return PriorityQueue_i32 { data: data, size: 0, capacity: cap }
}

function pq_i32_is_empty(pq: PriorityQueue_i32) -> bool {
    return pq.size == 0
}

function pq_i32_len(pq: PriorityQueue_i32) -> i32 {
    return pq.size
}

# =============================================================================
# Pair / Tuple
# =============================================================================

struct Pair_i32_i32 {
    first: i32,
    second: i32
}

function pair_i32_i32_new(a: i32, b: i32) -> Pair_i32_i32 {
    return Pair_i32_i32 { first: a, second: b }
}

struct Triple_i32_i32_i32 {
    first: i32,
    second: i32,
    third: i32
}

function triple_new(a: i32, b: i32, c: i32) -> Triple_i32_i32_i32 {
    return Triple_i32_i32_i32 { first: a, second: b, third: c }
}
