# FLOW String Utilities
# Formatting helpers for converting numbers to strings

extern {
    function sprintf(buf: ptr<i8>, fmt: string, val: i32) -> i32
    function snprintf(buf: ptr<i8>, size: i64, fmt: string, val: i32) -> i32
}

# Buffer size for number conversions
const ITOA_BUF_SIZE: i32 = 32

# Convert integer to string (decimal)
# Note: Returns pointer to static buffer - not thread-safe
# For thread-safe version, use itoa_buf with your own buffer
function itoa(n: i32) -> string {
    # Use sprintf to format
    return format_int(n)
}

# Format an integer using printf-style format
function format_int(n: i32) -> string {
    # This is a simple wrapper - the C generator handles print specially
    return ""
}

# Convert unsigned integer to hex string
function to_hex(n: i32) -> string {
    return format_hex(n)
}

function format_hex(n: i32) -> string {
    return ""
}
