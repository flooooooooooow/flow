# ML neural-network building blocks (stdlib)
# Import: import "stdlib/ml_nn.flow"
# MLIR-first training via tensor ops + ptr-based SGD

import "stdlib/tensor.flow"

# ============================================================================
# SGD OPTIMIZER (pointer params)
# ============================================================================

struct SGD {
    learning_rate: f32,
    weight_decay: f32
}

function sgd_create(lr: f32) -> SGD {
    return SGD { learning_rate: lr, weight_decay: 0.0 }
}

function sgd_step(opt: SGD, params: ptr<f32>, grads: ptr<f32>, size: i32) {
    for i in 0 to size {
        let g: f32 = grads[i] + opt.weight_decay * params[i]
        params[i] = params[i] - opt.learning_rate * g
    }
}

# ============================================================================
# 2D DENSE LAYER (tensor API)
# ============================================================================

struct Dense2D {
    weights: Tensor,   # (in_features, out_features)
    bias: Tensor       # (1, out_features)
}

function dense2d_create(in_features: i32, out_features: i32, seed: i32) -> Dense2D {
    let scale: f32 = sqrt(2.0 / (in_features + out_features))
    let w: Tensor = tensor_rand(in_features, out_features, 1, 1, seed)
    let w_scaled: Tensor = tensor_scale(w, scale)
    tensor_free(w)
    let b: Tensor = tensor_zeros(1, out_features, 1, 1)
    return Dense2D { weights: w_scaled, bias: b }
}

function dense2d_forward(layer: Dense2D, input: Tensor) -> Tensor {
    # input: (batch, in_features), weights: (in, out) -> (batch, out)
    let batch: i32 = input.dim0
    let out: Tensor = tensor_zeros(batch, layer.weights.dim1, 1, 1)
    for b in 0 to batch {
        for j in 0 to layer.weights.dim1 {
            let mut sum: f32 = layer.bias.data[j]
            for i in 0 to layer.weights.dim0 {
                sum = sum + input.data[b * input.dim1 + i] * layer.weights.data[i * layer.weights.dim1 + j]
            }
            out.data[b * out.dim1 + j] = sum
        }
    }
    return out
}

function dense2d_free(layer: Dense2D) {
    tensor_free(layer.weights)
    tensor_free(layer.bias)
}

# ============================================================================
# TRAINING UTILITIES
# ============================================================================

function nn_mse_loss(pred: Tensor, target: Tensor) -> f32 {
    let diff: Tensor = tensor_sub(pred, target)
    let sq: Tensor = tensor_mul(diff, diff)
    let loss: f32 = tensor_sum(sq) / pred.size
    tensor_free(diff)
    tensor_free(sq)
    return loss
}

function nn_mse_backward(pred: Tensor, target: Tensor) -> Tensor {
    let n: f32 = pred.size
    let grad: Tensor = tensor_zeros(pred.dim0, pred.dim1, pred.dim2, pred.dim3)
    for i in 0 to pred.size {
        grad.data[i] = 2.0 * (pred.data[i] - target.data[i]) / n
    }
    return grad
}

function nn_forward_relu(layer: Dense2D, input: Tensor) -> Tensor {
    let logits: Tensor = dense2d_forward(layer, input)
    let out: Tensor = tensor_relu(logits)
    tensor_free(logits)
    return out
}

struct Dense2DGrad {
    grad_input: Tensor,
    grad_weights: Tensor,
    grad_bias: Tensor
}

function dense2d_backward(layer: Dense2D, input: Tensor, grad_out: Tensor) -> Dense2DGrad {
    # grad_input = grad_out @ W^T
    let grad_input: Tensor = tensor_matmul_backward_a(input, layer.weights, grad_out)
    # grad_weights = input^T @ grad_out
    let grad_weights: Tensor = tensor_matmul_backward_b(input, layer.weights, grad_out)
    # grad_bias = sum over batch
    let grad_bias: Tensor = tensor_zeros(1, layer.weights.dim1, 1, 1)
    for b in 0 to grad_out.dim0 {
        for j in 0 to grad_out.dim1 {
            let g: f32 = grad_out.data[b * grad_out.dim1 + j]
            let cur: f32 = grad_bias.data[j]
            grad_bias.data[j] = cur + g
        }
    }
    return Dense2DGrad {
        grad_input: grad_input,
        grad_weights: grad_weights,
        grad_bias: grad_bias
    }
}

function dense2d_grad_free(g: Dense2DGrad) {
    tensor_free(g.grad_input)
    tensor_free(g.grad_weights)
    tensor_free(g.grad_bias)
}

# ============================================================================
# 2-LAYER MLP (tensor API + autograd helpers)
# ============================================================================

struct MLP2 {
    layer1: Dense2D,
    layer2: Dense2D
}

struct MLP2Activations {
    input: Tensor,
    h1: Tensor,
    pred: Tensor
}

function mlp2_create(in_features: i32, hidden: i32, out_features: i32, seed: i32) -> MLP2 {
    return MLP2 {
        layer1: dense2d_create(in_features, hidden, seed),
        layer2: dense2d_create(hidden, out_features, seed + 1)
    }
}

function mlp2_forward(mlp: MLP2, input: Tensor) -> MLP2Activations {
    let logits1: Tensor = dense2d_forward(mlp.layer1, input)
    let h1: Tensor = tensor_sigmoid(logits1)
    tensor_free(logits1)
    let logits2: Tensor = dense2d_forward(mlp.layer2, h1)
    let pred: Tensor = tensor_sigmoid(logits2)
    tensor_free(logits2)
    return MLP2Activations { input: input, h1: h1, pred: pred }
}

struct MLP2Grads {
    layer1: Dense2DGrad,
    layer2: Dense2DGrad
}

function mlp2_backward(mlp: MLP2, cache: MLP2Activations, target: Tensor) -> MLP2Grads {
    let grad_pred: Tensor = nn_mse_backward(cache.pred, target)
    let logits2: Tensor = dense2d_forward(mlp.layer2, cache.h1)
    let grad_logits2: Tensor = tensor_sigmoid_backward(cache.pred, grad_pred)
    tensor_free(grad_pred)
    let g2: Dense2DGrad = dense2d_backward(mlp.layer2, cache.h1, grad_logits2)
    tensor_free(logits2)
    tensor_free(grad_logits2)
    let logits1: Tensor = dense2d_forward(mlp.layer1, cache.input)
    let grad_h1: Tensor = g2.grad_input
    let grad_logits1: Tensor = tensor_sigmoid_backward(cache.h1, grad_h1)
    tensor_free(grad_h1)
    let g1: Dense2DGrad = dense2d_backward(mlp.layer1, cache.input, grad_logits1)
    tensor_free(logits1)
    tensor_free(grad_logits1)
    let g2_out: Dense2DGrad = Dense2DGrad {
        grad_input: tensor_zeros(1, 1, 1, 1),
        grad_weights: g2.grad_weights,
        grad_bias: g2.grad_bias
    }
    return MLP2Grads { layer1: g1, layer2: g2_out }
}

function mlp2_grads_free(grads: MLP2Grads) {
    dense2d_grad_free(grads.layer1)
    dense2d_grad_free(grads.layer2)
}

function mlp2_free(mlp: MLP2) {
    dense2d_free(mlp.layer1)
    dense2d_free(mlp.layer2)
}

function mlp2_activations_free(cache: MLP2Activations) {
    tensor_free(cache.h1)
    tensor_free(cache.pred)
}