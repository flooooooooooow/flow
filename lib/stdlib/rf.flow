# RF / SDR Module - IQ Samples and Rate-Typed Signals
#
# Complex baseband processing primitives for software-defined radio.
# Builds on c64/c128 complex types.
#
# Usage:
#   import "stdlib/rf.flow"
#   let sig: Signal<Hz1000> = signal_new<Hz1000>(1024)
#   let iq: IQSample = iq_from_real(0.5)
#
# Compile-time rate safety:
#   Signal<R> carries a phantom type parameter R that tags the sample
#   rate. signal_mix<R> requires both inputs to have the same R, so
#   mixing signals at different rates is a compile-time error.

# =============================================================================
# Type aliases
# =============================================================================

# IQ (In-phase / Quadrature) sample: a complex baseband sample.
# Transparent alias for c64. Use IQ when you want the RF naming convention
# but don't need type-safety against mixing with plain complex numbers.
export type IQ = c64

# Type-safe IQ sample. Distinct from c64 so the type checker rejects
# accidental mixing of IQ samples with arbitrary complex arithmetic.
export distinct type IQSample = c64

# =============================================================================
# Rate marker types (phantom type parameters for Signal<R>)
# =============================================================================
#
# These are distinct types used as phantom type parameters. They don't appear
# in Signal's fields but tag the signal with its sample rate so the compiler
# can reject rate mismatches at compile time.
#
# To create a new rate marker: `distinct type HzMyRate = u32`

export distinct type Hz1000 = u32
export distinct type Hz8000 = u32
export distinct type Hz16000 = u32
export distinct type Hz22050 = u32
export distinct type Hz24000 = u32
export distinct type Hz32000 = u32
export distinct type Hz44100 = u32
export distinct type Hz48000 = u32
export distinct type Hz96000 = u32
export distinct type Hz1M = u32
export distinct type Hz2_4M = u32
export distinct type Hz10M = u32

# =============================================================================
# Signal struct (phantom rate type parameter)
# =============================================================================

# A signal buffer with a compile-time sample rate tag.
# R is a phantom type parameter (rate marker). It does not appear in the
# fields but is checked by the type system when signals are combined.
export struct Signal<R> {
    data: ptr<c64>,
    len: i32,
    sample_rate: u32,
}

# =============================================================================
# IQ constructors
# =============================================================================

export function iq(re: f32, im: f32) -> IQ {
    return c64(re, im)
}

export function iq_from_real(re: f32) -> IQ {
    return c64(re, 0.0)
}

export function iq_sample(re: f32, im: f32) -> IQSample {
    return c64(re, im) as IQSample
}

export function iq_sample_from_iq(z: IQ) -> IQSample {
    return z as IQSample
}

# =============================================================================
# Signal lifecycle
# =============================================================================

extern { function malloc(size: i32) -> ptr<c64> }
extern { function free(ptr: ptr<c64>) -> void }
extern { function memcpy(dst: ptr<c64>, src: ptr<c64>, n: i32) -> ptr<c64> }

# Create a new signal with the given rate marker and runtime sample rate.
# The rate parameter populates the runtime field; R provides compile-time safety.
export function signal_new<R>(length: i32, rate: u32) -> Signal<R> {
    let buf: ptr<c64> = malloc(length * 8)
    let s: Signal<R> = Signal<R> { data: buf, len: length, sample_rate: rate }
    return s
}

export function signal_free<R>(s: Signal<R>) -> void {
    free(s.data)
}

export function signal_rate<R>(s: Signal<R>) -> u32 {
    return s.sample_rate
}

export function signal_length<R>(s: Signal<R>) -> i32 {
    return s.len
}

# =============================================================================
# Signal operations
# =============================================================================

export function signal_set<R>(s: Signal<R>, index: i32, value: c64) -> void {
    if index >= 0 && index < s.len {
        s.data[index] = value
    }
}

export function signal_get<R>(s: Signal<R>, index: i32) -> c64 {
    if index >= 0 && index < s.len {
        return s.data[index]
    }
    return c64(0.0, 0.0)
}

# Mix two signals: multiply sample-by-sample. Both signals must have
# the same rate type R. This is enforced at compile time.
export function signal_mix<R>(a: Signal<R>, b: Signal<R>) -> Signal<R> {
    let mut n: i32 = a.len
    if b.len < n { n = b.len }
    let result: Signal<R> = signal_new<R>(n, a.sample_rate)
    for i in 0 to n {
        result.data[i] = a.data[i] * b.data[i]
    }
    return result
}

# Scale a signal by a real scalar (amplitude gain).
export function signal_scale<R>(s: Signal<R>, gain: f32) -> void {
    let g: c64 = c64(gain, 0.0)
    for i in 0 to s.len {
        s.data[i] = s.data[i] * g
    }
}

# Compute the magnitude spectrum (|X[k]|) of a signal.
# Uses a naive DFT: O(N^2). Fine for small N; use FFT for real work.
export function signal_magnitude_spectrum<R>(s: Signal<R>, out: ptr<f64>) -> void {
    let n: i32 = s.len
    for k in 0 to n {
        let mut re: f64 = 0.0
        let mut im: f64 = 0.0
        for j in 0 to n {
            let angle: f64 = -2.0 * 3.14159265358979323846 * (k as f64) * (j as f64) / (n as f64)
            let c: f64 = cos(angle)
            let sn: f64 = sin(angle)
            let sample_re: f64 = creal(s.data[j])
            let sample_im: f64 = cimag(s.data[j])
            re = re + sample_re * c - sample_im * sn
            im = im + sample_re * sn + sample_im * c
        }
        out[k] = sqrt(re * re + im * im)
    }
}
