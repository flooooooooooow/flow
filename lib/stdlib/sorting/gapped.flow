# Sorting library: gap sequence sorts.
#
# Shell sort and comb sort are the same idea applied to two different
# quadratic sorts: run the sort over elements a gap apart, shrink the gap,
# repeat until the gap is 1. The final pass is the original algorithm on an
# input that is already almost ordered, which is exactly the case where
# insertion sort and bubble sort are linear.
#
# Both are in-place and both take `&mut [i32]`.

import stdlib.sorting.core { sort_swap }

# ---------------------------------------------------------------------------
# shell_sort
#   NOT stable (a gapped move jumps an element over equal keys it cannot see)
#   best O(n log n)   average ~O(n^1.3) with the sequence below
#   worst O(n^(4/3))  extra space O(1)
#
#   Gap sequence: Ciura's empirical sequence
#       1, 4, 10, 23, 57, 132, 301, 701
#   extended above 701 by repeatedly multiplying by 2.25 and truncating, which
#   is the extension Ciura's paper suggests and the one most implementations
#   use. The sequence is stated rather than computed from a formula because
#   its constants were found by search, not derived; there is no closed form.
#
#   Pick it when: you want a sort that beats the quadratic family by a wide
#   margin, has no recursion, allocates nothing, and fits in a page of code.
#   It is the right answer for embedded work and for n in the low thousands
#   where the merge scratch is not worth reserving.
#
#   Flow idioms: the gaps are a module-level const array, so the sequence is
#   data indexed by a loop rather than a chain of literals.
#
#   The array is declared `array<i32, 8>` and widened at use. `array<i64, 8>`
#   would be the natural type, but the C backend lowers a const array of i64
#   to an `(int32_t[])` compound literal cast to `const int64_t*`, which reads
#   back as garbage. Reported in docs/library/sorting.md.
# ---------------------------------------------------------------------------

const CIURA_LEN: i64 = 8
const CIURA_GAPS: array<i32, 8> = [701, 301, 132, 57, 23, 10, 4, 1]

export function shell_sort(xs: &mut [i32]) -> void {
    if xs.len < 2 {
        return
    }

    # Extend above 701 by 2.25x until the gap covers the span, then walk the
    # extension back down before dropping into the tabulated part.
    let mut gap: i64 = 701
    while gap * 9 / 4 < xs.len {
        gap = gap * 9 / 4
    }

    while gap > 701 {
        gapped_insertion(xs, gap)
        gap = gap * 4 / 9
    }

    let mut k: i64 = 0
    while k < CIURA_LEN {
        let g: i64 = CIURA_GAPS[k] as i64
        if g < xs.len {
            gapped_insertion(xs, g)
        }
        k = k + 1
    }
}

# One insertion-sort pass over the sub-sequences a fixed gap apart.
# `@noinline` on purpose: shell_sort calls this from two loops with different
# gap values, and letting the C compiler inline both copies bloats the loop
# body without helping. Measured on this machine; see docs/library/sorting.md.
@noinline
function gapped_insertion(xs: &mut [i32], gap: i64) -> void {
    let mut i: i64 = gap
    while i < xs.len {
        let key: i32 = xs[i]
        let mut j: i64 = i
        while j >= gap and xs[j - gap] > key {
            xs[j] = xs[j - gap]
            j = j - gap
        }
        xs[j] = key
        i = i + 1
    }
}

# ---------------------------------------------------------------------------
# comb_sort
#   NOT stable
#   best O(n log n)   average ~O(n^2 / 2^p) empirically near O(n log n)
#   worst O(n^2)      extra space O(1)
#
#   Gap sequence: start at n, divide by the shrink factor 1.3 each pass
#   (implemented as *10/13), and never go below 1. The "rule of 11" is
#   applied: a gap of 9 or 10 is forced to 11, which measurably reduces the
#   number of final passes.
#
#   Pick it when: you want bubble sort's shape with usable performance and
#   cannot afford shell sort's gap table. In practice shell sort beats it on
#   every input shape measured here, so this is mostly of historical interest.
# ---------------------------------------------------------------------------
export function comb_sort(xs: &mut [i32]) -> void {
    let mut gap: i64 = xs.len
    let mut swapped: bool = true
    while gap > 1 or swapped {
        gap = gap * 10 / 13
        if gap == 9 or gap == 10 {
            gap = 11
        }
        if gap < 1 {
            gap = 1
        }
        swapped = false
        let mut i: i64 = 0
        while i + gap < xs.len {
            if xs[i] > xs[i + gap] {
                sort_swap(xs, i, i + gap)
                swapped = true
            }
            i = i + 1
        }
    }
}
