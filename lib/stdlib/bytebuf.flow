# Growable byte buffer and ASCII character tests.
#
# The code lives in compiler/src/bytebuf.flow, a leaf module the compiler's
# source expanders use; this module re-exports it so programs and tools
# share one copy. `import std.bytebuf`.
#
#   let b: ptr<ByteBuf> = bb_new(64)
#   bb_puts(b, "n = ")
#   bb_put_i32(b, 42)
#   bb_putc(b, 10)
#   let s: string = bb_str(b)     # a copy; bb_cstr(b) is a view
#   bb_free(b)

export import "../../compiler/src/bytebuf.flow"
