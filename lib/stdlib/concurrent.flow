# FLOW Concurrency Standard Library
# Threads, mutexes, channels, atomics

# =============================================================================
# Thread
# =============================================================================

struct Thread {
    id: i64,
    running: bool
}

# Low-level pthread functions
extern function pthread_create(thread: ptr<i64>, attr: ptr<i8>, start_routine: ptr<i8>, arg: ptr<i8>) -> i32
extern function pthread_join(thread: i64, retval: ptr<ptr<i8>>) -> i32
extern function pthread_detach(thread: i64) -> i32
extern function pthread_self() -> i64
extern function pthread_exit(retval: ptr<i8>) -> void

function thread_new() -> Thread {
    return Thread { id: 0, running: false }
}

function thread_is_running(t: Thread) -> bool {
    return t.running
}

# =============================================================================
# Mutex (Mutual Exclusion Lock)
# =============================================================================

struct Mutex {
    locked: bool,
    owner: i64,
    # Opaque storage for the underlying pthread_mutex_t.
    # 64 bytes is sufficient for all platforms (Linux: 40, macOS: 64).
    _opaque: array<u8, 64>
}

extern function pthread_mutex_init(mutex: ptr<void>, attr: ptr<void>) -> i32
extern function pthread_mutex_lock(mutex: ptr<void>) -> i32
extern function pthread_mutex_unlock(mutex: ptr<void>) -> i32
extern function pthread_mutex_trylock(mutex: ptr<void>) -> i32
extern function pthread_mutex_destroy(mutex: ptr<void>) -> i32

function mutex_new() -> Mutex {
    let m: Mutex = Mutex { locked: false, owner: 0, _opaque: [] }
    pthread_mutex_init(&m._opaque as ptr<void>, null)
    return m
}

function mutex_lock(m: ptr<Mutex>) -> void {
    pthread_mutex_lock(&m._opaque as ptr<void>)
    m.locked = true
    m.owner = pthread_self()
}

function mutex_unlock(m: ptr<Mutex>) -> void {
    m.locked = false
    m.owner = 0
    pthread_mutex_unlock(&m._opaque as ptr<void>)
}

function mutex_trylock(m: ptr<Mutex>) -> bool {
    let result: i32 = pthread_mutex_trylock(&m._opaque as ptr<void>)
    if result == 0 {
        m.locked = true
        m.owner = pthread_self()
        return true
    }
    return false
}

function mutex_destroy(m: ptr<Mutex>) -> void {
    pthread_mutex_destroy(&m._opaque as ptr<void>)
}

function mutex_is_locked(m: Mutex) -> bool {
    return m.locked
}

# =============================================================================
# Condition Variable
# =============================================================================

struct CondVar {
    initialized: bool
}

extern function pthread_cond_init(cond: ptr<void>, attr: ptr<void>) -> i32
extern function pthread_cond_wait(cond: ptr<void>, mutex: ptr<void>) -> i32
extern function pthread_cond_signal(cond: ptr<void>) -> i32
extern function pthread_cond_broadcast(cond: ptr<void>) -> i32
extern function pthread_cond_destroy(cond: ptr<void>) -> i32

function condvar_new() -> CondVar {
    return CondVar { initialized: false }
}

# =============================================================================
# Read-Write Lock
# =============================================================================

struct RwLock {
    readers: i32,
    writer: bool,
    _opaque: array<u8, 128>
}

extern function pthread_rwlock_init(rwlock: ptr<void>, attr: ptr<void>) -> i32
extern function pthread_rwlock_rdlock(rwlock: ptr<void>) -> i32
extern function pthread_rwlock_wrlock(rwlock: ptr<void>) -> i32
extern function pthread_rwlock_unlock(rwlock: ptr<void>) -> i32
extern function pthread_rwlock_destroy(rwlock: ptr<void>) -> i32

function rwlock_new() -> RwLock {
    let rw: RwLock = RwLock { readers: 0, writer: false, _opaque: [] }
    pthread_rwlock_init(&rw._opaque as ptr<void>, null)
    return rw
}

function rwlock_rdlock(rw: ptr<RwLock>) -> void {
    pthread_rwlock_rdlock(&rw._opaque as ptr<void>)
    rw.readers = rw.readers + 1
}

function rwlock_wrlock(rw: ptr<RwLock>) -> void {
    pthread_rwlock_wrlock(&rw._opaque as ptr<void>)
    rw.writer = true
}

function rwlock_unlock(rw: ptr<RwLock>) -> void {
    if rw.writer {
        rw.writer = false
    } else {
        rw.readers = rw.readers - 1
    }
    pthread_rwlock_unlock(&rw._opaque as ptr<void>)
}

function rwlock_destroy(rw: ptr<RwLock>) -> void {
    pthread_rwlock_destroy(&rw._opaque as ptr<void>)
}

# =============================================================================
# Semaphore
# =============================================================================

struct Semaphore {
    count: i32
}

function semaphore_new(initial: i32) -> Semaphore {
    return Semaphore { count: initial }
}

# =============================================================================
# Channel (Go-style communication)
# =============================================================================

struct Channel_i32 {
    buffer: ptr<i32>,
    capacity: i32,
    size: i32,
    head: i32,
    tail: i32,
    closed: bool,
    _lock: array<u8, 64>
}

extern function malloc(size: i64) -> ptr<void>

function channel_i32_new(cap: i32) -> Channel_i32 {
    let buf: ptr<i32> = malloc(cap * 4) as ptr<i32>
    let ch: Channel_i32 = Channel_i32 {
        buffer: buf,
        capacity: cap,
        size: 0,
        head: 0,
        tail: 0,
        closed: false,
        _lock: []
    }
    pthread_mutex_init(&ch._lock as ptr<void>, null)
    return ch
}

function channel_i32_is_empty(ch: Channel_i32) -> bool {
    return ch.size == 0
}

function channel_i32_is_full(ch: Channel_i32) -> bool {
    return ch.size >= ch.capacity
}

function channel_i32_is_closed(ch: Channel_i32) -> bool {
    return ch.closed
}

function channel_i32_len(ch: Channel_i32) -> i32 {
    return ch.size
}

# =============================================================================
# Atomic Operations
# =============================================================================

struct AtomicI32 {
    value: i32
}

struct AtomicI64 {
    value: i64
}

struct AtomicBool {
    value: bool
}

function atomic_i32_new(val: i32) -> AtomicI32 {
    return AtomicI32 { value: val }
}

function atomic_i64_new(val: i64) -> AtomicI64 {
    return AtomicI64 { value: val }
}

function atomic_bool_new(val: bool) -> AtomicBool {
    return AtomicBool { value: val }
}

# Atomic load/store (would map to __atomic builtins in C)
extern function __atomic_load_n(ptr: ptr<i32>, memorder: i32) -> i32
extern function __atomic_store_n(ptr: ptr<i32>, val: i32, memorder: i32) -> void
extern function __atomic_fetch_add(ptr: ptr<i32>, val: i32, memorder: i32) -> i32
extern function __atomic_fetch_sub(ptr: ptr<i32>, val: i32, memorder: i32) -> i32
extern function __atomic_compare_exchange_n(ptr: ptr<i32>, expected: ptr<i32>, desired: i32, weak: bool, success_memorder: i32, failure_memorder: i32) -> bool

# 64-bit atomics
extern function __atomic_load_n_i64(ptr: ptr<i64>, memorder: i32) -> i64
extern function __atomic_store_n_i64(ptr: ptr<i64>, val: i64, memorder: i32) -> void
extern function __atomic_fetch_add_i64(ptr: ptr<i64>, val: i64, memorder: i32) -> i64
extern function __atomic_fetch_sub_i64(ptr: ptr<i64>, val: i64, memorder: i32) -> i64
extern function __atomic_compare_exchange_n_i64(ptr: ptr<i64>, expected: ptr<i64>, desired: i64, weak: bool, success_memorder: i32, failure_memorder: i32) -> bool

# Bool atomics
extern function __atomic_load_n_bool(ptr: ptr<bool>, memorder: i32) -> bool
extern function __atomic_store_n_bool(ptr: ptr<bool>, val: bool, memorder: i32) -> void
extern function __atomic_compare_exchange_n_bool(ptr: ptr<bool>, expected: ptr<bool>, desired: bool, weak: bool, success_memorder: i32, failure_memorder: i32) -> bool

function atomic_i32_load(a: ptr<AtomicI32>, memorder: i32) -> i32 {
    return __atomic_load_n(&a.value, memorder)
}

function atomic_i32_store(a: ptr<AtomicI32>, val: i32, memorder: i32) -> void {
    __atomic_store_n(&a.value, val, memorder)
}

function atomic_i64_load(a: ptr<AtomicI64>, memorder: i32) -> i64 {
    return __atomic_load_n_i64(&a.value, memorder)
}

function atomic_i64_store(a: ptr<AtomicI64>, val: i64, memorder: i32) -> void {
    __atomic_store_n_i64(&a.value, val, memorder)
}

function atomic_bool_load(a: ptr<AtomicBool>, memorder: i32) -> bool {
    return __atomic_load_n_bool(&a.value, memorder)
}

function atomic_bool_store(a: ptr<AtomicBool>, val: bool, memorder: i32) -> void {
    __atomic_store_n_bool(&a.value, val, memorder)
}

# Memory ordering
const MEMORY_ORDER_RELAXED: i32 = 0
const MEMORY_ORDER_CONSUME: i32 = 1
const MEMORY_ORDER_ACQUIRE: i32 = 2
const MEMORY_ORDER_RELEASE: i32 = 3
const MEMORY_ORDER_ACQ_REL: i32 = 4
const MEMORY_ORDER_SEQ_CST: i32 = 5

# =============================================================================
# SpinLock (busy-wait lock)
# =============================================================================

struct SpinLock {
    _flag: AtomicBool
}

function spinlock_new() -> SpinLock {
    return SpinLock { _flag: atomic_bool_new(false) }
}

function spinlock_lock(sl: ptr<SpinLock>) -> void {
    # Spin until we acquire the lock via atomic compare-exchange
    let expected: bool = false
    while !__atomic_compare_exchange_n_bool(&sl._flag.value, &expected, true, false, MEMORY_ORDER_ACQUIRE, MEMORY_ORDER_RELAXED) {
        expected = false
    }
}

function spinlock_unlock(sl: ptr<SpinLock>) -> void {
    __atomic_store_n_bool(&sl._flag.value, false, MEMORY_ORDER_RELEASE)
}

function spinlock_is_locked(sl: ptr<SpinLock>) -> bool {
    return __atomic_load_n_bool(&sl._flag.value, MEMORY_ORDER_ACQUIRE)
}

# =============================================================================
# Once (run-once initialization)
# =============================================================================

struct Once {
    _done: AtomicBool,
    _lock: array<u8, 64>
}

function once_new() -> Once {
    let o: Once = Once { _done: atomic_bool_new(false), _lock: [] }
    pthread_mutex_init(&o._lock as ptr<void>, null)
    return o
}

function once_is_done(o: ptr<Once>) -> bool {
    return __atomic_load_n_bool(&o._done.value, MEMORY_ORDER_ACQUIRE)
}

# =============================================================================
# WaitGroup (barrier synchronization)
# =============================================================================

struct WaitGroup {
    _count: AtomicI32
}

function waitgroup_new() -> WaitGroup {
    return WaitGroup { _count: atomic_i32_new(0) }
}

function waitgroup_add(wg: ptr<WaitGroup>, delta: i32) -> void {
    __atomic_fetch_add(&wg._count.value, delta, MEMORY_ORDER_SEQ_CST)
}

function waitgroup_done(wg: ptr<WaitGroup>) -> void {
    __atomic_fetch_sub(&wg._count.value, 1, MEMORY_ORDER_SEQ_CST)
}

function waitgroup_count(wg: ptr<WaitGroup>) -> i32 {
    return __atomic_load_n(&wg._count.value, MEMORY_ORDER_SEQ_CST)
}
