# Real-Time Operating System (RTOS) and scheduler primitives.
#
# Provides deterministic task control, priority-based cooperative scheduling,
# semaphores, mutexes, and lock-free SPSC circular ring buffers.

extern {
    function calloc(n: i64, s: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

# Task Priorities
export const PRIO_IDLE: i32 = 0
export const PRIO_LOW: i32 = 1
export const PRIO_NORMAL: i32 = 2
export const PRIO_HIGH: i32 = 3
export const PRIO_REALTIME: i32 = 4

# Task States
export const TASK_STATE_READY: i32 = 0
export const TASK_STATE_RUNNING: i32 = 1
export const TASK_STATE_BLOCKED: i32 = 2
export const TASK_STATE_SUSPENDED: i32 = 3

# Task Control Block
export struct TaskControlBlock {
    id: i32
    priority: i32
    state: i32
    period_ticks: i64
    next_release_tick: i64
    run_count: i64
}

# RTOS Scheduler
const MAX_TASKS: i32 = 32

export struct RtosScheduler {
    current_tick: i64
    task_count: i32
    running_task_id: i32
    tasks: ptr<TaskControlBlock>
}

export function scheduler_new() -> RtosScheduler {
    let tasks_mem: ptr<TaskControlBlock> = calloc(MAX_TASKS as i64, 48) as ptr<TaskControlBlock>
    return RtosScheduler {
        current_tick: 0,
        task_count: 0,
        running_task_id: -1,
        tasks: tasks_mem
    }
}

export function scheduler_free(sched: ptr<RtosScheduler>) {
    if (sched.tasks as ptr<void>) != null {
        free(sched.tasks as ptr<void>)
        sched.tasks = null
    }
}

export function scheduler_add_task(
    sched: ptr<RtosScheduler>,
    id: i32,
    priority: i32,
    period_ticks: i64
) -> bool {
    if sched.task_count >= MAX_TASKS {
        return false
    }
    let idx: i32 = sched.task_count
    sched.tasks[idx] = TaskControlBlock {
        id: id,
        priority: priority,
        state: TASK_STATE_READY,
        period_ticks: period_ticks,
        next_release_tick: 0,
        run_count: 0
    }
    sched.task_count = sched.task_count + 1
    return true
}

export function scheduler_set_state(sched: ptr<RtosScheduler>, task_id: i32, state: i32) -> bool {
    let mut i: i32 = 0
    while i < sched.task_count {
        if sched.tasks[i].id == task_id {
            sched.tasks[i].state = state
            return true
        }
        i = i + 1
    }
    return false
}

# Advances scheduler by one tick and returns the task ID of the highest priority ready task.
# Returns -1 if no task is eligible.
export function scheduler_tick(sched: ptr<RtosScheduler>) -> i32 {
    sched.current_tick = sched.current_tick + 1
    let now: i64 = sched.current_tick

    let mut best_id: i32 = -1
    let mut best_prio: i32 = -1
    let mut best_idx: i32 = -1

    let mut i: i32 = 0
    while i < sched.task_count {
        if sched.tasks[i].state == TASK_STATE_READY {
            if sched.tasks[i].period_ticks == 0 or now >= sched.tasks[i].next_release_tick {
                if sched.tasks[i].priority > best_prio {
                    best_prio = sched.tasks[i].priority
                    best_id = sched.tasks[i].id
                    best_idx = i
                }
            }
        }
        i = i + 1
    }

    if best_idx >= 0 {
        sched.running_task_id = best_id
        sched.tasks[best_idx].run_count = sched.tasks[best_idx].run_count + 1
        if sched.tasks[best_idx].period_ticks > 0 {
            sched.tasks[best_idx].next_release_tick = now + sched.tasks[best_idx].period_ticks
        }
    } else {
        sched.running_task_id = -1
    }

    return sched.running_task_id
}

# RTOS Semaphore
export struct RtosSemaphore {
    count: i32
    max_count: i32
}

export function sem_new(initial: i32, max: i32) -> RtosSemaphore {
    return RtosSemaphore {
        count: initial,
        max_count: max
    }
}

export function sem_take(sem: ptr<RtosSemaphore>) -> bool {
    if sem.count > 0 {
        sem.count = sem.count - 1
        return true
    }
    return false
}

export function sem_give(sem: ptr<RtosSemaphore>) -> bool {
    if sem.count < sem.max_count {
        sem.count = sem.count + 1
        return true
    }
    return false
}

# RTOS Mutex
export struct RtosMutex {
    locked: bool
    owner_task_id: i32
}

export function mutex_new() -> RtosMutex {
    return RtosMutex {
        locked: false,
        owner_task_id: -1
    }
}

export function mutex_lock(mtx: ptr<RtosMutex>, task_id: i32) -> bool {
    if not mtx.locked {
        mtx.locked = true
        mtx.owner_task_id = task_id
        return true
    }
    if mtx.owner_task_id == task_id {
        return true
    }
    return false
}

export function mutex_unlock(mtx: ptr<RtosMutex>, task_id: i32) -> bool {
    if mtx.locked and mtx.owner_task_id == task_id {
        mtx.locked = false
        mtx.owner_task_id = -1
        return true
    }
    return false
}

# Lock-Free Single-Producer Single-Consumer (SPSC) Ring Buffer
export struct RtosRingBuffer {
    buffer: ptr<i32>
    capacity: u32
    mask: u32
    head: u32
    tail: u32
}

export function ring_buffer_new(capacity: u32) -> RtosRingBuffer {
    # Ensure capacity is a power of 2
    let mut cap: u32 = 1
    while cap < capacity {
        cap = cap << 1
    }
    let buf: ptr<i32> = calloc(cap as i64, 4) as ptr<i32>
    return RtosRingBuffer {
        buffer: buf,
        capacity: cap,
        mask: cap - 1,
        head: 0,
        tail: 0
    }
}

export function ring_buffer_free(rb: ptr<RtosRingBuffer>) {
    if (rb.buffer as ptr<void>) != null {
        free(rb.buffer as ptr<void>)
        rb.buffer = null
    }
}

export function ring_buffer_is_empty(rb: ptr<RtosRingBuffer>) -> bool {
    return rb.head == rb.tail
}

export function ring_buffer_is_full(rb: ptr<RtosRingBuffer>) -> bool {
    return ((rb.head + 1) & rb.mask) == (rb.tail & rb.mask)
}

export function ring_buffer_count(rb: ptr<RtosRingBuffer>) -> u32 {
    return (rb.head - rb.tail) & rb.mask
}

export function ring_buffer_push(rb: ptr<RtosRingBuffer>, item: i32) -> bool {
    if ring_buffer_is_full(rb) {
        return false
    }
    rb.buffer[rb.head & rb.mask] = item
    rb.head = rb.head + 1
    return true
}

export function ring_buffer_pop(rb: ptr<RtosRingBuffer>, out_val: ptr<i32>) -> bool {
    if ring_buffer_is_empty(rb) {
        return false
    }
    out_val[0] = rb.buffer[rb.tail & rb.mask]
    rb.tail = rb.tail + 1
    return true
}
