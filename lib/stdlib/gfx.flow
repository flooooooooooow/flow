# gfx: explicit native graphics API (macOS / Linux SDL2 / Windows)
#
# Backend: runtime/gfx_macos.m, runtime/gfx_linux.c, runtime/gfx_windows.c
#
# Frame loop helpers (#164):
#   gfx_frame_pump(g)  — poll + Esc/close; return false to quit
#   gfx_run(g, n)      — C loop calling user `flow_gfx_frame(ctx, frame) -> i32`
#                        (1 = continue, 0 = quit). Define that symbol in your
#                        program when using gfx_run.

struct Gfx {
    ctx: ptr<void>
}

# macOS key codes (NSEvent.keyCode)
const KEY_ESC: i32 = 53
const KEY_R: i32 = 15
const KEY_W: i32 = 13
const KEY_A: i32 = 0
const KEY_S: i32 = 1
const KEY_D: i32 = 2
const KEY_LEFT: i32 = 123
const KEY_RIGHT: i32 = 124
const KEY_DOWN: i32 = 125
const KEY_UP: i32 = 126

extern { function flow_gfx_init(w: i32, h: i32, title: string) -> ptr<void> }
extern { function flow_gfx_shutdown(ctx: ptr<void>) -> void }
extern { function flow_gfx_poll(ctx: ptr<void>) -> void }
extern { function flow_gfx_should_close(ctx: ptr<void>) -> i32 }
extern { function flow_gfx_key_down(ctx: ptr<void>, keycode: i32) -> i32 }
extern { function flow_gfx_clear(ctx: ptr<void>, r: u8, g: u8, b: u8) -> void }
extern { function flow_gfx_fill_rect(ctx: ptr<void>, x: i32, y: i32, w: i32, h: i32, r: u8, g: u8, b: u8) -> void }
extern { function flow_gfx_blit_rgb(ctx: ptr<void>, x: i32, y: i32, w: i32, h: i32, src: ptr<u8>) -> void }
extern { function flow_gfx_present(ctx: ptr<void>) -> void }
extern { function flow_gfx_run(ctx: ptr<void>, max_frames: i32) -> i32 }
extern { function flow_gfx_time_ms(ctx: ptr<void>) -> f64 }
extern { function flow_gfx_wait_frame(ctx: ptr<void>, target_fps: i32) -> void }
extern { function flow_gfx_mouse(ctx: ptr<void>, out: ptr<i32>) -> i32 }

export function gfx_open(w: i32, h: i32, title: string) -> Gfx {
    return Gfx { ctx: flow_gfx_init(w, h, title) }
}

export function gfx_close(g: Gfx) -> void {
    flow_gfx_shutdown(g.ctx)
}

export function gfx_poll(g: Gfx) -> void {
    flow_gfx_poll(g.ctx)
}

export function gfx_should_close(g: Gfx) -> bool {
    return flow_gfx_should_close(g.ctx) != 0
}

export function gfx_key_down(g: Gfx, keycode: i32) -> bool {
    return flow_gfx_key_down(g.ctx, keycode) != 0
}

export function gfx_clear(g: Gfx, r: i32, g2: i32, b: i32) -> void {
    flow_gfx_clear(g.ctx, r, g2, b)
}

export function gfx_fill_rect(g: Gfx, x: i32, y: i32, w: i32, h: i32, r: i32, g2: i32, b: i32) -> void {
    flow_gfx_fill_rect(g.ctx, x, y, w, h, r, g2, b)
}

# Blit a packed RGB8 buffer (w*h*3 bytes, row-major) at (x, y).
#
# Per-pixel fields — particle sands, software rasterizers, image filters —
# should build a buffer and blit it once per frame. A fill_rect per pixel is
# tens of thousands of calls a frame and will not keep up.
export function gfx_blit_rgb(g: Gfx, x: i32, y: i32, w: i32, h: i32, src: ptr<u8>) -> void {
    flow_gfx_blit_rgb(g.ctx, x, y, w, h, src)
}

export function gfx_present(g: Gfx) -> void {
    flow_gfx_present(g.ctx)
}

# Poll events; return false if the window should close or Esc is down.
export function gfx_frame_pump(g: Gfx) -> bool {
    gfx_poll(g)
    if gfx_should_close(g) {
        return false
    }
    if gfx_key_down(g, KEY_ESC) {
        return false
    }
    return true
}

# Run up to max_frames, calling user-defined flow_gfx_frame(ctx, frame) each
# tick. Returns the number of frames completed. Requires linking the gfx runtime.
export function gfx_run(g: Gfx, max_frames: i32) -> i32 {
    return flow_gfx_run(g.ctx, max_frames)
}

# Milliseconds since the window opened.
#
# The clock lives on the gfx ABI rather than in stdlib/time.flow because it has
# to mean the right thing in every build mode, and the backends disagree on
# purpose:
#
#   window (macOS/SDL)  real monotonic time
#   recorder            virtual — exactly one frame per present, so a recorded
#                       run is identical on every machine and does not burn
#                       real seconds sleeping
#   browser             performance.now()
#
# So the same source paces correctly live and records deterministically, with
# no environment checks in the demo.
export function gfx_time_ms(g: Gfx) -> f64 {
    return flow_gfx_time_ms(g.ctx)
}

# Sleep out the remainder of the current frame at target_fps.
#
# There is no vsync on the native paths, so without this a demo runs as fast as
# the machine allows and its speed becomes hardware-dependent. No-op in the
# recorder (which should run flat out) and in the browser (where present
# already awaits requestAnimationFrame).
export function gfx_wait_frame(g: Gfx, target_fps: i32) -> void {
    flow_gfx_wait_frame(g.ctx, target_fps)
}

# Pointer state for this frame.
#
# Coordinates are framebuffer pixels with y measured down from the top row,
# matching gfx_fill_rect and gfx_blit_rgb. Each backend converts into that
# convention: macOS inverts y because NSView is not flipped while buffer row 0
# is the top; SDL and the browser already agree; the recorder synthesises a
# scripted pointer so mouse-driven demos still record deterministically.
#
# `wheel` is a cumulative signed total, never reset by reading it. Diff it
# against your own previous value, the same way demos already track keys with
# a *_held bool. That keeps the runtime stateless and stops two readers in one
# frame from stealing each other's scroll.
#
# `inside` is 0 when the cursor is outside the framebuffer, and every field is
# 0 on a backend with no pointer, so a demo degrades instead of failing.
struct Mouse {
    x: i32,
    y: i32,
    left: i32,
    right: i32,
    middle: i32,
    wheel: i32,
    inside: i32
}

export function gfx_mouse(g: Gfx) -> Mouse {
    let buf: array<i32, 7> = [0, 0, 0, 0, 0, 0, 0]
    let p: ptr<i32> = buf
    flow_gfx_mouse(g.ctx, p)
    return Mouse {
        x: p[0],
        y: p[1],
        left: p[2],
        right: p[3],
        middle: p[4],
        wheel: p[5],
        inside: p[6]
    }
}

export function gfx_mouse_x(g: Gfx) -> i32 {
    return gfx_mouse(g).x
}

export function gfx_mouse_y(g: Gfx) -> i32 {
    return gfx_mouse(g).y
}

# button: 0 = left, 1 = right, 2 = middle
export function gfx_mouse_down(g: Gfx, button: i32) -> bool {
    let m: Mouse = gfx_mouse(g)
    if button == 0 { return m.left != 0 }
    if button == 1 { return m.right != 0 }
    if button == 2 { return m.middle != 0 }
    return false
}

# Cumulative scroll total. Diff against your own previous value.
export function gfx_mouse_wheel(g: Gfx) -> i32 {
    return gfx_mouse(g).wheel
}
