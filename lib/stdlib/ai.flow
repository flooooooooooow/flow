function ai_q_bucket(state: i32) -> i32 {
    if state >= 0 and state < AI_Q_BUCKETS { return state }
    return ai_hash_mix(state) % AI_Q_BUCKETS
}

# Zero the table and seed the shared RNG.
export function q_init(seed: u32) -> void {
    ai_seed(seed)
    let mut i: i32 = 0
    while i < AI_Q_BUCKETS * AI_Q_MAX_ACTIONS {
        ai_q_table[i] = 0.0
        i = i + 1
    }
}

export function q_value(state: i32, action: i32) -> f32 {
    let mut a: i32 = action
    if a < 0 { a = 0 }
    if a >= AI_Q_MAX_ACTIONS { a = AI_Q_MAX_ACTIONS - 1 }
    return ai_q_table[ai_q_bucket(state) * AI_Q_MAX_ACTIONS + a]
}

# Greedy action (ties break toward the lowest index).
export function q_best(state: i32, n_actions: i32) -> i32 {
    let mut n: i32 = n_actions
    if n < 1 { n = 1 }
    if n > AI_Q_MAX_ACTIONS { n = AI_Q_MAX_ACTIONS }
    let base: i32 = ai_q_bucket(state) * AI_Q_MAX_ACTIONS
    let mut best: i32 = 0
    let mut best_v: f32 = ai_q_table[base]
    let mut a: i32 = 1
    while a < n {
        if ai_q_table[base + a] > best_v {
            best_v = ai_q_table[base + a]
            best = a
        }
        a = a + 1
    }
    return best
}

# Epsilon-greedy action selection.
export function q_select(state: i32, n_actions: i32, epsilon: f32) -> i32 {
    if ai_rand_f32() < epsilon {
        return ai_rand_range(n_actions)
    }
    return q_best(state, n_actions)
}

function ai_q_max(state: i32, n_actions: i32) -> f32 {
    let mut n: i32 = n_actions
    if n < 1 { n = 1 }
    if n > AI_Q_MAX_ACTIONS { n = AI_Q_MAX_ACTIONS }
    let base: i32 = ai_q_bucket(state) * AI_Q_MAX_ACTIONS
    let mut best_v: f32 = ai_q_table[base]
    let mut a: i32 = 1
    while a < n {
        if ai_q_table[base + a] > best_v { best_v = ai_q_table[base + a] }
        a = a + 1
    }
    return best_v
}

# One Q-learning update: Q(s,a) += alpha * (r + gamma * max_a' Q(s',a') - Q(s,a))
export function q_update(s: i32, a: i32, r: f32, s_next: i32, n_actions: i32, alpha: f32, gamma: f32) -> void {
    let mut act: i32 = a
    if act < 0 { act = 0 }
    if act >= AI_Q_MAX_ACTIONS { act = AI_Q_MAX_ACTIONS - 1 }
    let idx: i32 = ai_q_bucket(s) * AI_Q_MAX_ACTIONS + act
    let target: f32 = r + gamma * ai_q_max(s_next, n_actions)
    ai_q_table[idx] = ai_q_table[idx] + alpha * (target - ai_q_table[idx])
}

# Terminal update: the target is just the reward (no bootstrap).
export function q_update_terminal(s: i32, a: i32, r: f32, alpha: f32) -> void {
    let mut act: i32 = a
    if act < 0 { act = 0 }
    if act >= AI_Q_MAX_ACTIONS { act = AI_Q_MAX_ACTIONS - 1 }
    let idx: i32 = ai_q_bucket(s) * AI_Q_MAX_ACTIONS + act
    ai_q_table[idx] = ai_q_table[idx] + alpha * (r - ai_q_table[idx])
}

# Linear epsilon decay: eps_start at step 0, eps_end at step >= total.
export function q_epsilon(step: i32, total: i32, eps_start: f32, eps_end: f32) -> f32 {
    if total <= 0 { return eps_end }
    if step >= total { return eps_end }
    if step < 0 { return eps_start }
    let t: f32 = (step as f32) / (total as f32)
    return eps_start + (eps_end - eps_start) * t
}

