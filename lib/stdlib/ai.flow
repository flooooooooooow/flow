# Flow stdlib: game-AI trainers.
#
# Three small trainer families for game agents, all storage in module statics
# (section 3.3.1), all randomness from one deterministic LCG:
#
#   1. Tabular Q-learning     q_init / q_select / q_update / q_update_terminal
#   2. Neuroevolution (GA)    ga_init / ga_fitness_set / ga_evolve
#   3. Tiny policy MLP        mlp_init / mlp_forward / mlp_reinforce / mlp_train_mse
#
# Capacity limits (fixed static budgets, see the consts below):
#   Q table:  AI_Q_BUCKETS states x AI_Q_MAX_ACTIONS actions.
#             States are caller-hashed i32s. States in [0, AI_Q_BUCKETS) map
#             to buckets 1:1 (no collisions); anything else is mixed with
#             ai_hash_mix and reduced mod AI_Q_BUCKETS (collisions possible).
#   GA:       up to AI_GA_MAX_POP genomes of up to AI_GA_MAX_DIM f32 genes.
#   MLP:      one hidden layer, up to AI_MLP_MAX_IN inputs, AI_MLP_MAX_HID
#             hidden units (tanh), AI_MLP_MAX_OUT outputs (linear logits).
#
# Demos: examples/ai/q_snake.flow, examples/ai/ga_flappy.flow,
#        examples/ai/policy_pong.flow. Tutorial: docs/tutorials/game-ai.md.

extern {
    function expf(x: f32) -> f32
}

# ============================================================================
# DETERMINISTIC RNG (LCG, same constants as the game demos)
# ============================================================================

let mut ai_rng_state: u32 = 2463534242

export function ai_seed(seed: u32) -> void {
    let mut s: u32 = seed
    if s == 0 { s = 2463534242 }
    ai_rng_state = s
}

function ai_rand_u32() -> u32 {
    ai_rng_state = ai_rng_state * 1664525 + 1013904223
    return ai_rng_state
}

# Uniform integer in [0, n). n <= 0 returns 0.
export function ai_rand_range(n: i32) -> i32 {
    if n <= 0 { return 0 }
    let r: u32 = ai_rand_u32()
    let mut v: i32 = ((r >> 8) as i32) % n
    if v < 0 { v = 0 - v }
    return v
}

# Uniform f32 in [0, 1).
export function ai_rand_f32() -> f32 {
    let r: u32 = ai_rand_u32()
    let v: i32 = ((r >> 9) & 0x7FFFFF) as i32
    return (v as f32) / 8388608.0
}

# Uniform f32 in [-1, 1).
export function ai_rand_signed() -> f32 {
    return 2.0 * ai_rand_f32() - 1.0
}

# Approximately normal (sum of three uniforms, rescaled to std ~1).
export function ai_rand_gauss() -> f32 {
    let s: f32 = ai_rand_f32() + ai_rand_f32() + ai_rand_f32()
    return (s - 1.5) * 2.0
}

# 32-bit integer mixing hash (fmix-style). Always returns a non-negative i32.
# Use it to fold game-state features into a Q-table state id.
export function ai_hash_mix(x: i32) -> i32 {
    let mut h: u32 = x as u32
    h = h ^ (h >> 16)
    h = h * 0x7feb352d
    h = h ^ (h >> 15)
    h = h * 0x846ca68b
    h = h ^ (h >> 16)
    return (h & 0x7FFFFFFF) as i32
}

function ai_abs_f32(x: f32) -> f32 {
    if x < 0.0 { return 0.0 - x }
    return x
}

function ai_tanh(x: f32) -> f32 {
    let mut v: f32 = x
    if v > 10.0 { v = 10.0 }
    if v < -10.0 { v = -10.0 }
    let e2: f32 = expf(2.0 * v)
    return (e2 - 1.0) / (e2 + 1.0)
}

