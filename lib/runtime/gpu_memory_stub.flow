# Flow runtime: GPU memory stub for non-Apple hosts (replaces gpu_memory_stub.c).
# Darwin still links runtime/gpu_metal.m.

@flow_api
export function flow_gpu_available() -> i32 {
    return 0
}

@flow_api
export function flow_gpu_backend_name() -> string {
    return "stub"
}

@flow_api
export function flow_gpu_alloc(size: i64, flags: i32) -> ptr<void> {
    return null
}

@flow_api
export function flow_gpu_free(buf: ptr<void>) -> void {
    return
}

@flow_api
export function flow_gpu_size(buf: ptr<void>) -> i64 {
    return 0
}

@flow_api
export function flow_gpu_flags(buf: ptr<void>) -> i32 {
    return 0
}

@flow_api
export function flow_gpu_host_ptr(buf: ptr<void>) -> ptr<void> {
    return null
}

@flow_api
export function flow_gpu_copy_h2d(dst_gpu: ptr<void>, src_host: ptr<void>, nbytes: i64) -> i32 {
    return -1
}

@flow_api
export function flow_gpu_copy_d2h(dst_host: ptr<void>, src_gpu: ptr<void>, nbytes: i64) -> i32 {
    return -1
}

@flow_api
export function flow_gpu_copy_d2d(dst_gpu: ptr<void>, src_gpu: ptr<void>, nbytes: i64) -> i32 {
    return -1
}

@flow_api
export function flow_gpu_sync() -> void {
    return
}

# Elementwise multiply kernels. Metal provides these on macOS; without a
# backend there is nothing to dispatch to, so report failure.
@flow_api
export function flow_gpu_mul_f32(out_gpu: ptr<void>, a_gpu: ptr<void>, b_gpu: ptr<void>, n: i64) -> i32 {
    return -1
}

@flow_api
export function flow_gpu_mul_backward_a_f32(grad_a_gpu: ptr<void>, grad_out_gpu: ptr<void>, b_gpu: ptr<void>, n: i64) -> i32 {
    return -1
}

@flow_api
export function flow_gpu_mul_backward_b_f32(grad_b_gpu: ptr<void>, grad_out_gpu: ptr<void>, a_gpu: ptr<void>, n: i64) -> i32 {
    return -1
}

# GPU graph executor (runtime/gpu_graph_exec.h). Metal provides it on
# macOS. Here new() returns null, which stdlib/gpu_graph_exec.flow
# reports as GPU_GRAPH_EXEC_ERR_UNAVAILABLE.
@flow_api
export function flow_gpu_graph_exec_new() -> ptr<void> {
    return null
}

@flow_api
export function flow_gpu_graph_exec_free(ex: ptr<void>) -> void {
    return
}

@flow_api
export function flow_gpu_graph_exec_error(ex: ptr<void>) -> string {
    return "no GPU graph backend on this host"
}

@flow_api
export function flow_gpu_graph_exec_add_buffer(ex: ptr<void>, physical: i32, bytes: i64) -> i32 {
    return -1
}

@flow_api
export function flow_gpu_graph_exec_add_texture(ex: ptr<void>, physical: i32, format: i32, width: i32, height: i32) -> i32 {
    return -1
}

@flow_api
export function flow_gpu_graph_exec_add_pass(ex: ptr<void>, kind: i32, source: string, entry: string, wg_x: i32, wg_y: i32, wg_z: i32, grid_x: i32, grid_y: i32, grid_z: i32, iterations: i32, barrier_before: i32) -> i32 {
    return -1
}

@flow_api
export function flow_gpu_graph_exec_bind(ex: ptr<void>, pass: i32, slot: i32, even_physical: i32, odd_physical: i32) -> i32 {
    return -1
}

@flow_api
export function flow_gpu_graph_exec_upload(ex: ptr<void>, physical: i32, src: ptr<void>, nbytes: i64) -> i32 {
    return -1
