    return -1
}

@flow_api
export function flow_gpu_graph_exec_readback(ex: ptr<void>, dst: ptr<void>, nbytes: i64) -> i32 {
    return -1
}

@flow_api
export function flow_gpu_graph_exec_stat(ex: ptr<void>, which: i32) -> i32 {
    return -1
