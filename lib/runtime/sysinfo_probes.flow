# Flow runtime: host / CPU probes.
#
# runtime/flow_rt_sysinfo.c is reduced to the syscalls (sysctlbyname, sysconf,
# uname) and the compile-time #if answers. The feature-token matching, the
# probe-order fallback chains, the core-count clamp, and the "unknown" /
# "Apple Silicon" defaults all live here.

extern {
    function calloc(count: i64, size: i64) -> ptr<void>
    function flow_rt_online_cpus() -> i32
    function flow_rt_sysctl_string(key: string, buf: ptr<u8>, cap: i64) -> i32
    function flow_rt_sysctl_int(key: string, out: ptr<i32>) -> i32
    function flow_rt_uname_machine(buf: ptr<u8>, cap: i64) -> i32
    function flow_rt_host_facts() -> i32
}

const SYSINFO_SCRATCH: i64 = 1024
const SYSINFO_NAME: i64 = 256

# Bits of flow_rt_host_facts() — what the preprocessor knew at build time.
const FLOW_HOST_MACOS: i32 = 1
const FLOW_HOST_LINUX: i32 = 2
const FLOW_HOST_WINDOWS: i32 = 4
const FLOW_HOST_NEON: i32 = 8
const FLOW_HOST_ARM64: i32 = 16

function host_fact(bit: i32) -> i32 {
    if (flow_rt_host_facts() & bit) != 0 {
        return 1
    }
    return 0
}

# Scratch for feature-string lookups, reused across calls.
let mut scratch: ptr<u8> = null
# Stable storage behind current_cpu() / current_arch().
let mut cpu_name: ptr<u8> = null
let mut arch_name: ptr<u8> = null

function sys_len(s: ptr<u8>) -> i32 {
    let mut n: i32 = 0
    while s[n] != 0 {
        n = n + 1
    }
    return n
}

# strstr, over a NUL-terminated byte string.
function sys_contains(hay: ptr<u8>, needle: string) -> bool {
    let n: ptr<u8> = needle as ptr<u8>
    let nlen: i32 = sys_len(n)
    if nlen == 0 {
        return true
    }
    let hlen: i32 = sys_len(hay)
    let mut i: i32 = 0
    while i + nlen <= hlen {
        let mut j: i32 = 0
        while j < nlen and hay[i + j] == n[j] {
            j = j + 1
        }
        if j == nlen {
            return true
        }
        i = i + 1
    }
    return false
}

function sys_set(dst: ptr<u8>, text: string) -> void {
    let src: ptr<u8> = text as ptr<u8>
    let mut i: i32 = 0
    while src[i] != 0 {
        dst[i] = src[i]
        i = i + 1
    }
    dst[i] = 0
}

function sys_scratch() -> ptr<u8> {
    if scratch == null {
        scratch = calloc(SYSINFO_SCRATCH, 1) as ptr<u8>
    }
    return scratch
}

# 1 when the sysctl value for `key` contains `token`.
function sysctl_has(key: string, token: string) -> i32 {
    let buf: ptr<u8> = sys_scratch()
    if buf == null {
        return 0
    }
    if flow_rt_sysctl_string(key, buf, SYSINFO_SCRATCH) == 0 {
        return 0
    }
    if sys_contains(buf, token) {
        return 1
    }
    return 0
}

@flow_api
export function num_cores() -> i32 {
    let cores: i32 = flow_rt_online_cpus()
    if cores < 1 {
        return 1
    }
    return cores
}

@flow_api
export function os_is_linux() -> i32 {
    return host_fact(FLOW_HOST_LINUX)
}

@flow_api
export function os_is_windows() -> i32 {
    return host_fact(FLOW_HOST_WINDOWS)
}

@flow_api
export function os_is_macos() -> i32 {
    return host_fact(FLOW_HOST_MACOS)
}

@flow_api
export function has_sse4() -> i32 {
    let buf: ptr<u8> = sys_scratch()
    if buf == null {
        return 0
    }
    if flow_rt_sysctl_string("machdep.cpu.features", buf, SYSINFO_SCRATCH) == 0 {
        return 0
    }
    if sys_contains(buf, "SSE4.2") {
        return 1
    }
    if sys_contains(buf, "SSE4.1") {
        return 1
    }
    if sys_contains(buf, "SSE4") {
        return 1
    }
    return 0
}

@flow_api
export function has_avx() -> i32 {
    return sysctl_has("machdep.cpu.features", "AVX")
}

@flow_api
export function has_avx2() -> i32 {
    return sysctl_has("machdep.cpu.leaf7_features", "AVX2")
}

@flow_api
export function has_avx512f() -> i32 {
    return sysctl_has("machdep.cpu.leaf7_features", "AVX512F")
}

@flow_api
export function has_avx512_vnni() -> i32 {
    return sysctl_has("machdep.cpu.leaf7_features", "AVX512VNNI")
}

# Ask the host first; fall back to what the binary was compiled for.
@flow_api
export function has_neon() -> i32 {
    let probe: array<i32, 1> = [0]
    let out: ptr<i32> = probe
    if flow_rt_sysctl_int("hw.optional.neon", out) != 0 {
        if out[0] != 0 {
            return 1
        }
        return 0
    }
    return host_fact(FLOW_HOST_NEON)
}

@flow_api
export function is_apple_m1() -> i32 {
    return sysctl_has("machdep.cpu.brand_string", "Apple M1")
}

@flow_api
export function has_intel_amx() -> i32 {
    return sysctl_has("machdep.cpu.leaf7_features", "AMX")
}

# Brand string, then board model, then machine class. Apple Silicon without
# any of those still identifies itself; everything else is "unknown".
@flow_api
export function current_cpu() -> string {
    if cpu_name == null {
        cpu_name = calloc(SYSINFO_NAME, 1) as ptr<u8>
    }
    if cpu_name == null {
        return "unknown"
    }
    if flow_rt_sysctl_string("machdep.cpu.brand_string", cpu_name, SYSINFO_NAME) != 0 {
        return cpu_name as string
    }
    if flow_rt_sysctl_string("hw.model", cpu_name, SYSINFO_NAME) != 0 {
        return cpu_name as string
    }
    if flow_rt_sysctl_string("hw.machine", cpu_name, SYSINFO_NAME) != 0 {
        return cpu_name as string
    }
    if host_fact(FLOW_HOST_MACOS) != 0 and host_fact(FLOW_HOST_ARM64) != 0 {
        sys_set(cpu_name, "Apple Silicon")
        return cpu_name as string
    }
    sys_set(cpu_name, "unknown")
    return cpu_name as string
}

# hw.machine on Darwin, uname(2) elsewhere.
@flow_api
export function current_arch() -> string {
    if arch_name == null {
        arch_name = calloc(SYSINFO_NAME, 1) as ptr<u8>
    }
    if arch_name == null {
        return "unknown"
    }
    if flow_rt_sysctl_string("hw.machine", arch_name, SYSINFO_NAME) != 0 {
        return arch_name as string
    }
    if flow_rt_uname_machine(arch_name, SYSINFO_NAME) != 0 {
        return arch_name as string
    }
    sys_set(arch_name, "unknown")
    return arch_name as string
}
