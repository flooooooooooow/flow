# Flow runtime: netpoll microbench harness

extern {
    function flow_rt_monotonic_ns() -> i64
    function flow_netpoll_init() -> void
    function flow_netpoll_sleep_ms(ms: i32) -> void
}

@flow_api
export function flow_bench_netpoll_sleep_ns(n: i32) -> i64 {
    if n <= 0 {
        return 0
    }
    flow_netpoll_init()
    let t0: i64 = flow_rt_monotonic_ns()
    let mut i: i32 = 0
    while i < n {
        flow_netpoll_sleep_ms(0)
        i = i + 1
    }
    flow_netpoll_sleep_ms(1)
    let t1: i64 = flow_rt_monotonic_ns()
    return t1 - t0
}
