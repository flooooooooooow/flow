let mut tape_len: i32 = 0

# Bounds-checked accessors keep the exact semantics of the old C store:
# out-of-range get returns 0 (op), -1 (a/b), or 0.0 (val/grad); sets no-op.

function tape_get_op(i: i32) -> i32 {
    if i < 0 {
        return 0
    }
    if i >= FLOW_TAPE_MAX_NODES {
        return 0
    }
    return tape_op[i]
}

function tape_get_a(i: i32) -> i32 {
    if i < 0 {
        return -1
    }
    if i >= FLOW_TAPE_MAX_NODES {
        return -1
    }
    return tape_a[i]
}

function tape_get_b(i: i32) -> i32 {
    if i < 0 {
        return -1
    }
    if i >= FLOW_TAPE_MAX_NODES {
        return -1
    }
    return tape_b[i]
}

function tape_get_val(i: i32) -> f32 {
    if i < 0 {
        return 0.0
    }
    if i >= FLOW_TAPE_MAX_NODES {
        return 0.0
    }
    return tape_val[i]
}

function tape_get_grad(i: i32) -> f32 {
    if i < 0 {
        return 0.0
    }
    if i >= FLOW_TAPE_MAX_NODES {
        return 0.0
    }
    return tape_grad[i]
}

function tape_set_grad(i: i32, g: f32) -> void {
    if i < 0 {
        return
    }
    if i >= FLOW_TAPE_MAX_NODES {
        return
    }
    tape_grad[i] = g
}

function tape_add_grad(i: i32, d: f32) -> void {
    if i < 0 {
        return
    }
    if i >= FLOW_TAPE_MAX_NODES {
        return
    }
    tape_grad[i] = tape_grad[i] + d
}

function tape_set_node(i: i32, op: i32, a: i32, b: i32, val: f32) -> void {
    if i < 0 {
        return
    }
    if i >= FLOW_TAPE_MAX_NODES {
        return
    }
    tape_op[i] = op
    tape_a[i] = a
    tape_b[i] = b
    tape_val[i] = val
    tape_grad[i] = 0.0
}

function tape_zero_grads() -> void {
    let mut i: i32 = 0
    while i < FLOW_TAPE_MAX_NODES {
        tape_grad[i] = 0.0
        i = i + 1
    }
}

@flow_api
export function flow_tape_reset() -> void {
    tape_len = 0
    let mut i: i32 = 0
    while i < FLOW_TAPE_MAX_NODES {
        tape_op[i] = 0
        tape_a[i] = 0
        tape_b[i] = 0
        tape_val[i] = 0.0
        tape_grad[i] = 0.0
        i = i + 1
    }
}

function tape_push(op: i32, a: i32, b: i32, val: f32) -> i32 {
    let len: i32 = tape_len
    if len >= FLOW_TAPE_MAX_NODES {
        return -1
    }
    tape_set_node(len, op, a, b, val)
    tape_len = len + 1
    return len
}

@flow_api
export function flow_tape_track(value: f32) -> i32 {
    return tape_push(FLOW_TAPE_LEAF, -1, -1, value)
}

@flow_api
export function flow_tape_mul(a: i32, b: i32) -> i32 {
    let len: i32 = tape_len
    if a < 0 {
        return -1
    }
    if b < 0 {
        return -1
    }
    if a >= len {
        return -1
    }
    if b >= len {
        return -1
    }
    let v: f32 = tape_get_val(a) * tape_get_val(b)
    return tape_push(FLOW_TAPE_MUL, a, b, v)
}

@flow_api
export function flow_tape_add(a: i32, b: i32) -> i32 {
    let len: i32 = tape_len
    if a < 0 {
        return -1
    }
    if b < 0 {
        return -1
    }
    if a >= len {
        return -1
    }
    if b >= len {
        return -1
    }
    let v: f32 = tape_get_val(a) + tape_get_val(b)
    return tape_push(FLOW_TAPE_ADD, a, b, v)
}

@flow_api
export function flow_tape_backward(root: i32) -> void {
    let len: i32 = tape_len
    if root < 0 {
        return
    }
    if root >= len {
        return
    }
    tape_zero_grads()
    tape_set_grad(root, 1.0)
    let mut i: i32 = len - 1
    while i >= 0 {
        let g: f32 = tape_get_grad(i)
        if g != 0.0 {
            let op: i32 = tape_get_op(i)
            if op == FLOW_TAPE_MUL {
                let a: i32 = tape_get_a(i)
                let b: i32 = tape_get_b(i)
                tape_add_grad(a, g * tape_get_val(b))
                tape_add_grad(b, g * tape_get_val(a))
            } else {
                if op == FLOW_TAPE_ADD {
                    let a2: i32 = tape_get_a(i)
                    let b2: i32 = tape_get_b(i)
                    tape_add_grad(a2, g)
                    tape_add_grad(b2, g)
                }
            }
        }
        i = i - 1
    }
}

@flow_api
export function flow_tape_get_grad(idx: i32) -> f32 {
    return tape_get_grad(idx)
}

@flow_api
export function flow_tape_get_val(idx: i32) -> f32 {
    return tape_get_val(idx)
}
