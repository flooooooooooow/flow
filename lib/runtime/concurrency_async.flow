# Flow runtime: ThreadedAsync task table (logic + slot bookkeeping in Flow).
# Pthread trampoline / mutex / fn-pointer table: runtime/flow_rt_task_store.c

extern {
    function flow_rt_task_lock() -> void
    function flow_rt_task_unlock() -> void
    function flow_rt_task_set_fn(id: i32, fn: ptr<void>) -> void
    function flow_rt_task_get_fn(id: i32) -> ptr<void>
    function flow_rt_call_task_fn(fn: ptr<void>, arg: i32) -> i32
    function flow_rt_task_pthread_create(id: i32) -> i32
    function flow_rt_task_pthread_join(id: i32) -> i32
    function flow_rt_usleep(usec: i32) -> void
}

const FLOW_MAX_TASKS: i32 = 256

# Slot bookkeeping as module statics. These are NOT atomic: they are shared
# between the spawning thread and the worker thread, and are safe only
# because every read/write below sits between flow_rt_task_lock() and
# flow_rt_task_unlock() (a pthread mutex that stays in C). The function
# pointer table and pthread_t handles stay in C too: Flow statics cannot
# hold arrays of pointers or opaque pthread types.

