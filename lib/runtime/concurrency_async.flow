@flow_api
export function flow_task_register(task_id: i32, fn: ptr<void>) -> void {
    if task_id < 0 {
        return
    }
    if task_id >= FLOW_MAX_TASKS {
        return
    }
    flow_rt_task_lock()
    flow_rt_task_set_fn(task_id, fn)
    flow_rt_task_unlock()
}

@flow_api
export function flow_async_worker(task_id: i32) -> void {
    if task_id < 0 {
        return
    }
    if task_id >= FLOW_MAX_TASKS {
        return
    }
    flow_rt_task_lock()
    let fn: ptr<void> = flow_rt_task_get_fn(task_id)
    let arg: i32 = task_arg[task_id]
    flow_rt_task_unlock()

    let mut result: i32 = 0
    if fn != null {
        result = flow_rt_call_task_fn(fn, arg)
    } else {
        # Default stand-in matching SimulatedAsync: task_id * 10
        result = task_id * 10
    }

    flow_rt_task_lock()
    task_result[task_id] = result
    task_done[task_id] = 1
    flow_rt_task_unlock()
}

@flow_api
export function flow_async_spawn(task_id: i32, arg: i32) -> void {
    if task_id < 0 {
        return
    }
    if task_id >= FLOW_MAX_TASKS {
        return
    }
    flow_rt_task_lock()
    let spawned: i32 = task_spawned[task_id]
    let done: i32 = task_done[task_id]
    if spawned != 0 {
        if done == 0 {
            flow_rt_task_unlock()
            return
        }
    }
    task_arg[task_id] = arg
    task_done[task_id] = 0
    task_spawned[task_id] = 1
    task_result[task_id] = 0
    flow_rt_task_unlock()

    if flow_rt_task_pthread_create(task_id) != 0 {
        # Sync fallback
        flow_async_worker(task_id)
    }
}

@flow_api
export function flow_async_join(task_id: i32) -> i32 {
    if task_id < 0 {
        return 0
    }
    if task_id >= FLOW_MAX_TASKS {
        return 0
    }
    flow_rt_task_lock()
    let spawned: i32 = task_spawned[task_id]
    let done: i32 = task_done[task_id]
    flow_rt_task_unlock()

    if spawned != 0 {
        if done == 0 {
            let _: i32 = flow_rt_task_pthread_join(task_id)
        }
    } else {
        # join without spawn -> same formula as SimulatedAsync
        return task_id * 10
    }

    flow_rt_task_lock()
    let mut result: i32 = task_result[task_id]
    task_spawned[task_id] = 0
    flow_rt_task_unlock()
    return result
}

@flow_api
export function flow_async_delay(ms: i32) -> void {
    if ms > 0 {
        flow_rt_usleep(ms * 1000)
    }
}
