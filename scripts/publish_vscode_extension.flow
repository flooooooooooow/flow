# Package (and optionally publish) the FLOW VS Code / Cursor extension.
#
# Usage:
#   ./flow tool scripts/publish_vscode_extension.flow              # build .vsix
#   ./flow tool scripts/publish_vscode_extension.flow --publish    # vsce publish (needs VSCE_PAT)
#   ./flow tool scripts/publish_vscode_extension.flow --ovsx       # also Open VSX (needs OVSX_PAT)
#   ./flow tool scripts/publish_vscode_extension.flow --install    # install VSIX into Cursor + VS Code

import "tools/flow_cli/sys.flow"
import std.process { proc_argv, ProcCmd, ProcStrs, proc_args, proc_chdir }

function usage() {
    outln("# Package (and optionally publish) the FLOW VS Code / Cursor extension.")
    outln("#")
    outln("# Usage:")
    outln("#   ./flow tool scripts/publish_vscode_extension.flow              # build .vsix")
    outln("#   ./flow tool scripts/publish_vscode_extension.flow --publish    # vsce publish (needs VSCE_PAT)")
    outln("#   ./flow tool scripts/publish_vscode_extension.flow --ovsx       # also Open VSX (needs OVSX_PAT)")
    outln("#   ./flow tool scripts/publish_vscode_extension.flow --install    # install VSIX into Cursor + VS Code")
}

function step(argv: ptr<ProcStrs>) {
    check(run_argv(argv))
}

function with_args(base: ptr<ProcStrs>, more: string) -> ptr<ProcStrs> {
    let argv: ptr<ProcStrs> = sl_copy(base)
    sl_extend(argv, s_words(more))
    return argv
}

# The vsce command: the local @vscode/vsce, else a vsce on PATH, else npx
# fetching @vscode/vsce.
function vsce() -> ptr<ProcStrs> {
    let local: ptr<ProcStrs> = s_words("npx --no-install vsce")
    let probe: ptr<ProcCmd> = cmd(with_args(local, "--version"))
    cmd_quiet(probe)
    if run(probe) == 0 {
        return local
    }
    if have("vsce") {
        return sl_of1("vsce")
    }
    return s_words("npx --yes @vscode/vsce")
}

# The newest flow-language-*.vsix in the current directory (ls -t | head -1).
function newest_vsix(dir: string) -> string {
    let names: ptr<ProcStrs> = list_dir(dir)
    let mut best: string = ""
    let mut best_t: i64 = -1
    let mut i: i32 = 0
    while i < sl_len(names) {
        let n: string = sl_get(names, i)
        if s_starts(n, "flow-language-") and s_ends(n, ".vsix") {
            let t: i64 = mtime(dir + "/" + n)
            if t > best_t {
                best_t = t
                best = n
            }
        }
        i = i + 1
    }
    return best
}

function main() -> i32 {
    tool_only("scripts/publish_vscode_extension.flow")
    let root: string = abs_dir(env_or("FLOW_REPO_ROOT", cwd_logical()))
    env_unset("FLOW_REPO_ROOT")
    let ext: string = root + "/third_party/integrations/vscode/flow-language"
    if not proc_chdir(ext) {
        errln("cannot enter " + ext)
        cli_exit(1)
    }
    env_set("PWD", ext)

    let mut publish: bool = false
    let mut ovsx: bool = false
    let mut install: bool = false
    let args: ptr<ProcStrs> = proc_args()
    let mut i: i32 = 0
    while i < sl_len(args) {
        let a: string = sl_get(args, i)
        if s_eq(a, "--publish") {
            publish = true
        } elif s_eq(a, "--ovsx") {
            ovsx = true
        } elif s_eq(a, "--install") {
            install = true
        } elif s_eq(a, "-h") or s_eq(a, "--help") {
            usage()
            cli_exit(0)
        }
        i = i + 1
    }

    step(s_words("npm install --no-fund --no-audit"))
    step(s_words("npm run compile"))

    let vs: ptr<ProcStrs> = vsce()
    outln("Packaging…")
    step(with_args(vs, "package --no-dependencies"))
    let vsix: string = newest_vsix(ext)
    if s_len(vsix) == 0 {
        errln("error: no flow-language-*.vsix produced")
        cli_exit(1)
    }
    outln("Built " + ext + "/" + vsix)

    if install {
        if have("cursor") {
            let c: ptr<ProcStrs> = sl_of3("cursor", "--install-extension", ext + "/" + vsix)
            sl_push(c, "--force")
            step(c)
            outln("Installed into Cursor")
        } else {
            errln("warn: cursor CLI not found")
        }
        if have("code") {
            let v: ptr<ProcStrs> = sl_of3("code", "--install-extension", ext + "/" + vsix)
            sl_push(v, "--force")
            step(v)
            outln("Installed into VS Code")
        }
    }

    if publish {
        let pat: string = env("VSCE_PAT")
        if s_len(pat) == 0 {
            errln("error: set VSCE_PAT (Azure DevOps PAT with Marketplace Manage).")
            errln("See " + ext + "/PUBLISH.md")
            cli_exit(1)
        }
        outln("Publishing to VS Marketplace…")
        let p: ptr<ProcStrs> = with_args(vs, "publish --no-dependencies --pat")
        sl_push(p, pat)
        step(p)
    }

    if ovsx {
        let opat: string = env("OVSX_PAT")
        if s_len(opat) == 0 {
            errln("error: set OVSX_PAT for Open VSX.")
            cli_exit(1)
        }
        outln("Publishing to Open VSX…")
        let o: ptr<ProcStrs> = s_words("npx --yes ovsx publish")
        sl_push2(o, vsix, "--pat")
        sl_push(o, opat)
        step(o)
    }

    outln("Done.")
    return 0
}

# These programs change files, run builds and publish, so they run only
# as `./flow tool PATH.flow` (from build/flow-tools), never from a plain
# `flow run` such as the corpus checks do.
function tool_only(path: string) {
    if not s_contains(proc_argv(0), "/flow-tools/") {
        errln("run this with ./flow tool " + path)
        cli_exit(2)
    }
}
