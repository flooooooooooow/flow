# Prove that the default `./flow run` and `./flow compile` paths need no Python.
#
# Puts stub `python` and `python3` first on PATH. Each stub logs its arguments
# and exits 127. Then, from a clean compiler/build and build/, it builds flowc
# from the checked-in bootstrap C (through ensure_flowc, as a user's first
# `flow run` would) and runs a set of programs:
#
#   - a program with no imports, from the repository root and from another
#     working directory;
#   - a program whose exit status is its result (fibonacci, 55), through both
#     `flow run` and `flow compile`;
#   - programs that import stdlib modules;
#   - a project with its own flow.toml and an empty [dependencies] table;
#   - a project that declares a registry package, imports it
#     (`import json.lib`) and has nothing installed yet, so `flow run` must
#     install it, write flow.lock and resolve the import; then the same
#     project again, already installed;
#   - examples/ecosystem sqlite_demo and app_cache, whose registry packages
#     carry [native] C sources that `flow run` must compile, cache and link;
#   - `flow sync`, `flow add`, `flow pkg install`, `flow search`, `flow info`;
#   - `flow init`, `flow build`, `flow build-native`, `flow run-native`,
#     `flow publish --dry-run` and `flow clean` in a new project;
#   - a project with an unknown dependency, which must fail with the package
#     manager's message.
#
# Passes only when every program behaves as expected and no stub was called.
#
#   ./flow tool scripts/check_run_without_python.flow           # clean build first
#   ./flow tool scripts/check_run_without_python.flow --keep    # reuse compiler/build

import "tools/flow_cli/sys.flow"
import "scripts/check_lib.flow"
import std.process { proc_argv, ProcCmd, ProcResult, ProcStrs, proc_args, proc_input, proc_stdout, proc_stderr, PROC_CAPTURE, PROC_MERGE, PROC_NULL }

let mut ROOT: string = ""
let mut WORK: string = ""
let mut HERE: string = ""
let mut PASS: i32 = 0
let mut FAIL: i32 = 0

function in_dir(d: string) {
    HERE = d
}

# Run `argv` in HERE with stdout and stderr in WORK/out.txt; check the
# exit status against `want`.
function expect_env(want: i32, label: string, envs: ptr<ProcStrs>, argv: ptr<ProcStrs>) {
    let c: ptr<ProcCmd> = cmd(argv)
    cmd_cwd(c, HERE)
    cmd_env(c, "PWD", HERE)
    let mut i: i32 = 0
    while i + 1 < sl_len(envs) {
        cmd_env(c, sl_get(envs, i), sl_get(envs, i + 1))
        i = i + 2
    }
    proc_stdout(c, PROC_CAPTURE)
    proc_stderr(c, PROC_MERGE)
    let r: ptr<ProcResult> = run_result(c)
    let out_path: string = WORK + "/out.txt"
    let _w: bool = write_text(out_path, r.stdout)
    let rc: i32 = r.exit_code
    if rc == want {
        outln("PASS " + label + " (exit " + s_itoa(rc) + ")")
        PASS = PASS + 1
    } else {
        outln("FAIL " + label + " (exit " + s_itoa(rc) + ", want " + s_itoa(want) + ")")
        out(chk_prefix(chk_tail(r.stdout, 20), "     "))
        FAIL = FAIL + 1
    }
}

function expect_exit(want: i32, label: string, argv: ptr<ProcStrs>) {
    expect_env(want, label, sl_new(), argv)
}

function flow2(a: string, b: string) -> ptr<ProcStrs> {
    return sl_of3(ROOT + "/flow", a, b)
}

function last_out() -> string {
    return read_text(WORK + "/out.txt")
}

function check_line(ok: bool, pass_msg: string, fail_msg: string) {
    if ok {
        outln("PASS " + pass_msg)
        PASS = PASS + 1
    } else {
        outln("FAIL " + fail_msg)
        FAIL = FAIL + 1
    }
}

function put(p: string, text: string) {
    mkdir_p_or_exit(path_dirname(p))
    if not write_text(p, text) {
        errln("cannot write " + p)
        cli_exit(1)
    }
}

# Whether a C compiler finds <hdr>.
function have_header(hdr: string) -> bool {
    let c: ptr<ProcCmd> = cmd(s_words(env_or("CC", "cc") + " -x c -fsyntax-only -"))
    proc_input(c, "#include <" + hdr + ">\nint main(void){return 0;}\n")
    cmd_quiet(c)
    return run(c) == 0
}

# A line holding "Compiling native source " and, later, "/flow_sqlite.c".
function compiled_sqlite(text: string) -> bool {
    let lines: ptr<ProcStrs> = s_lines(text)
    let mut i: i32 = 0
    while i < sl_len(lines) {
        let ln: string = sl_get(lines, i)
        let at: i32 = s_find(ln, "Compiling native source ", 0)
        if at >= 0 and s_find(ln, "/flow_sqlite.c", at + 24) >= 0 {
            return true
        }
        i = i + 1
    }
    return false
}

function native_demos() {
    let mut have_libs: bool = true
    let hdrs: ptr<ProcStrs> = sl_of2("sqlite3.h", "curl/curl.h")
    let mut h: i32 = 0
    while h < sl_len(hdrs) {
        let hdr: string = sl_get(hdrs, h)
        if not have_header(hdr) {
            have_libs = false
            outln("SKIP [native] package demos: <" + hdr + "> not found (install libsqlite3-dev and libcurl4-openssl-dev)")
        }
        h = h + 1
    }
    if not have_libs {
        return
    }
    let demos: ptr<ProcStrs> = sl_of2("sqlite_demo", "app_cache")
    let mut d: i32 = 0
    while d < sl_len(demos) {
        let name: string = sl_get(demos, d)
        let dst: string = WORK + "/" + name
        if not chk_copy_tree(ROOT + "/examples/ecosystem/" + name, dst) {
            errln("cp: cannot copy examples/ecosystem/" + name)
            cli_exit(1)
        }
        rm_rf(dst + "/flow.lock")
        rm_rf(dst + "/flow_packages")
        rm_rf(dst + "/build")
        d = d + 1
    }
    expect_exit(0, "run examples/ecosystem/sqlite_demo ([native] sqlite)", sl_of3("./flow", "run", WORK + "/sqlite_demo/src/main.flow"))
    let sqlite_out: string = last_out()
    expect_exit(0, "run sqlite_demo again (cached native object)", sl_of3("./flow", "run", WORK + "/sqlite_demo/src/main.flow"))
    let sqlite_again: string = last_out()
    expect_exit(0, "run examples/ecosystem/app_cache ([native] sqlite and http)", sl_of3("./flow", "run", WORK + "/app_cache/src/main.flow"))
    let app_out: string = last_out()
    let ok: bool = chk_has_line(sqlite_out, "sum=42") and compiled_sqlite(sqlite_out) and chk_has_line(sqlite_again, "sum=42") and not s_contains(sqlite_again, "Compiling native source") and chk_has_line(app_out, "sum=84") and chk_has_line(app_out, "ok=1")
    check_line(ok, "[native] sources compiled once, cached and linked", "[native] package demos did not print the expected output")
}

function main() -> i32 {
    tool_only("scripts/check_run_without_python.flow")
    ROOT = chk_enter()
    let args: ptr<ProcStrs> = proc_args()
    let keep: bool = sl_len(args) > 0 and s_eq(sl_get(args, 0), "--keep")

    let tmpl: string = env_or("TMPDIR", "/tmp") + "/flow-nopy.XXXXXX"
    WORK = mktemp_dir(tmpl)
    if s_len(WORK) == 0 {
        errln("mktemp: cannot create " + tmpl)
        cli_exit(1)
    }
    on_exit_remove(WORK)

    let stub_dir: string = WORK + "/bin"
    let log: string = WORK + "/python-calls.log"
    chk_stub_python(stub_dir, log)
    env_unset("FLOW_HOST")
    env_unset("FLOWC_BIN")
    env_unset("FLOW_RUN_PYTHON")

    if not s_eq(which("python3"), stub_dir + "/python3") {
        errln("check_run_without_python: stub python3 is not first on PATH")
        cli_exit(1)
    }

    if not keep {
        rm_rf("compiler/build")
        rm_rf("build")
    }
    in_dir(ROOT)

    # Program with no imports.
    expect_exit(0, "run examples/basics/hello_world.flow", sl_of3("./flow", "run", "examples/basics/hello_world.flow"))
    in_dir(WORK)
    expect_exit(0, "run hello_world.flow from another directory", flow2("run", ROOT + "/examples/basics/hello_world.flow"))
    in_dir(ROOT)

    # Exit status carries the result.
    expect_exit(55, "run examples/basics/fibonacci.flow", sl_of3("./flow", "run", "examples/basics/fibonacci.flow"))
    expect_exit(0, "compile examples/basics/fibonacci.flow", sl_of3("./flow", "compile", "examples/basics/fibonacci.flow"))
    expect_exit(55, "execute build/fibonacci", sl_of1("./build/fibonacci"))

    # Programs that import stdlib modules.
    expect_exit(0, "run examples/basics/result_pipeline.flow (import stdlib/result)", sl_of3("./flow", "run", "examples/basics/result_pipeline.flow"))
    expect_exit(0, "run examples/dsp/pipeline.flow (import stdlib/dsp)", sl_of3("./flow", "run", "examples/dsp/pipeline.flow"))

    # The language suite on the flowc host.
    expect_env(0, "FLOW_HOST=flowc test-lang tests/lang/test_strings.flow", sl_of2("FLOW_HOST", "flowc"), sl_of3("./flow", "test-lang", "tests/lang/test_strings.flow"))

    # A standalone project with its own manifest and no dependencies.
    let empty: string = WORK + "/empty_deps"
    put(empty + "/flow.toml", "[package]\nname = \"empty_deps\"\nversion = \"0.1.0\"\nentry = \"src/main.flow\"\n\n[dependencies]\n\n[dev-dependencies]\n")
    put(empty + "/src/main.flow", "function main() -> i32 {\n    return 7\n}\n")
    expect_exit(7, "run project with empty [dependencies]", sl_of3("./flow", "run", empty + "/src/main.flow"))

    # A project that declares a registry package and imports it. Nothing is
    # installed yet: `flow run` has to install the package (the Flow package
    # manager, compiler/src/pkg.flow), write flow.lock, resolve `import
    # json.lib` from flow_packages/ in flowc, and run the program.
    let proj: string = WORK + "/registry_dep"
    put(proj + "/flow.toml", "[package]\nname = \"registry_dep\"\nversion = \"0.1.0\"\nentry = \"src/main.flow\"\n\n[dependencies]\njson = \"0.1.0\"\n\n[dev-dependencies]\n")
    put(proj + "/src/main.flow", "import json.lib { json_get_i32, json_validate }\n\nfunction main() -> i32 {\n    let doc: string = \"{\\\"answer\\\": 3}\"\n    if json_validate(doc) != 1 {\n        return 1\n    }\n    return json_get_i32(doc, \"answer\")\n}\n")
    expect_exit(3, "run project importing a registry package that is not installed (json)", sl_of3("./flow", "run", proj + "/src/main.flow"))

    let expected_lock: string = WORK + "/expected.lock"
    put(expected_lock, "{\n  \"version\": 1,\n  \"packages\": {\n    \"json\": {\n      \"version\": \"0.1.0\",\n      \"source\": \"registry\",\n      \"resolved\": {\n        \"path\": \"" + abs_dir_physical(ROOT) + "/registry/packages/json\"\n      }\n    }\n  }\n}\n")
    let dr: ptr<ProcStrs> = sl_of3("diff", "-r", ROOT + "/registry/packages/json")
    sl_push(dr, proj + "/flow_packages/json")
    let dc: ptr<ProcCmd> = cmd(dr)
    cmd_quiet_out(dc)
    let same_tree: bool = run(dc) == 0
    if same_bytes(expected_lock, proj + "/flow.lock") and same_tree {
        outln("PASS flow.lock and flow_packages/json written")
        PASS = PASS + 1
    } else {
        outln("FAIL flow.lock or flow_packages/json not as expected")
        out(chk_prefix(chk_diff(expected_lock, proj + "/flow.lock"), "     "))
        FAIL = FAIL + 1
    }

    # Second run: everything is installed and locked, so nothing is fetched.
    expect_exit(3, "run the same project again (already installed)", sl_of3("./flow", "run", proj + "/src/main.flow"))

    # Registry packages with [native] C sources (#991): sqlite links
    # native/flow_sqlite.c and -lsqlite3, http links native/flow_http.c and
    # -lcurl. `flow run` has to compile those sources and link them. The
    # demos are copied without flow.lock, so the run also installs the
    # packages.
    native_demos()

    # The package commands themselves.
    let proj2: string = WORK + "/pkg_cmds"
    mkdir_p_or_exit(proj2 + "/src")
    let _c: bool = copy_file(proj + "/flow.toml", proj2 + "/flow.toml")
    in_dir(proj2)
    expect_exit(0, "flow sync", sl_of2(ROOT + "/flow", "sync"))
    expect_exit(0, "flow add toml", flow2("add", "toml"))
    expect_exit(0, "flow pkg install", flow2("pkg", "install"))
    expect_exit(0, "flow search json", flow2("search", "json"))
    expect_exit(0, "flow info json", flow2("info", "json"))
    in_dir(ROOT)
    check_line(is_dir(proj2 + "/flow_packages/toml") and s_contains(read_text(proj2 + "/flow.lock"), "\"toml\""), "flow add installed and locked toml", "flow add did not install and lock toml")

    # The project commands: init, build, build-native, run-native, publish
    # --dry-run and clean (scripts/check_pkg_commands.flow checks their
    # output).
    let proj4: string = WORK + "/newproj"
    mkdir_p_or_exit(proj4)
    in_dir(proj4)
    expect_exit(0, "flow init", sl_of2(ROOT + "/flow", "init"))
    expect_exit(0, "flow build", sl_of2(ROOT + "/flow", "build"))
    expect_exit(0, "flow build-native", sl_of2(ROOT + "/flow", "build-native"))
    expect_exit(0, "flow run-native", sl_of2(ROOT + "/flow", "run-native"))
    let run_native_out: string = last_out()
    let pub_argv: ptr<ProcStrs> = flow2("publish", "--git")
    sl_push2(pub_argv, "https://example.com/newproj.git", "--dry-run")
    expect_exit(0, "flow publish --git URL --dry-run", pub_argv)
    let publish_out: string = last_out()
    let had_binary: bool = is_exec(proj4 + "/build/newproj")
    expect_exit(0, "flow clean", sl_of2(ROOT + "/flow", "clean"))
    in_dir(ROOT)
    let ok4: bool = is_file(proj4 + "/flow.toml") and is_file(proj4 + "/src/main.flow") and had_binary and not exists(proj4 + "/build") and s_contains(run_native_out, "Hello from newproj!") and s_contains(publish_out, "dry-run: index not written")
    check_line(ok4, "init scaffold, native build and run, publish dry run, clean", "project commands did not produce the expected files or output")

    # A dependency that does not exist fails with the package manager's
    # message.
    let proj3: string = WORK + "/unknown_dep"
    put(proj3 + "/flow.toml", replace_line(read_text(proj + "/flow.toml"), "json = \"0.1.0\"", "no_such_package = \"1.0.0\""))
    put(proj3 + "/src/main.flow", "function main() -> i32 {\n    return 0\n}\n")
    expect_exit(1, "run project with an unknown dependency fails", sl_of3("./flow", "run", proj3 + "/src/main.flow"))
    check_line(s_contains(last_out(), "Unknown dependency 'no_such_package'"), "unknown dependency is reported", "unknown dependency message missing")

    outln("")
    outln("programs: pass=" + s_itoa(PASS) + " fail=" + s_itoa(FAIL))
    if nonempty(log) {
        outln("python stubs were called:")
        out(chk_prefix(read_text(log), "  "))
        cli_exit(1)
    }
    outln("python stubs called: 0")
    if FAIL != 0 {
        cli_exit(1)
    }
    outln("check_run_without_python: PASS")
    cli_exit(0)
    return 0
}

# sed 's/^OLD$/NEW/'
function replace_line(text: string, old: string, new: string) -> string {
    let lines: ptr<ProcStrs> = s_split(text, 10)
    let n: i32 = sl_len(lines)
    let mut out_text: string = ""
    let mut i: i32 = 0
    while i < n {
        let mut ln: string = sl_get(lines, i)
        if s_eq(ln, old) {
            ln = new
        }
        out_text = out_text + ln
        if i < n - 1 {
            out_text = out_text + "\n"
        }
        i = i + 1
    }
    return out_text
}

# These programs change files, run builds and publish, so they run only
# as `./flow tool PATH.flow` (from build/flow-tools), never from a plain
# `flow run` such as the corpus checks do.
function tool_only(path: string) {
    if not s_contains(proc_argv(0), "/flow-tools/") {
        errln("run this with ./flow tool " + path)
        cli_exit(2)
    }
}
