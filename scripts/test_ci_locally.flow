# Run the main CI checks locally (without Docker/act).
#
#   ./flow tool scripts/test_ci_locally.flow
#
# Stops at the first failing step with its status.

import "tools/flow_cli/sys.flow"
import std.process { proc_argv, ProcCmd, ProcStrs, proc_chdir }

function section(title: string) {
    outln("")
    outln(C_BLUE + "=== " + title + " ===" + C_NC)
}

function step(argv: ptr<ProcStrs>) {
    check(run_argv(argv))
}

# ./flow test --tier N
function tier(n: string) -> ptr<ProcStrs> {
    let argv: ptr<ProcStrs> = sl_of3("./flow", "test", "--tier")
    sl_push(argv, n)
    return argv
}

# The first `n` lines of `text`.
function head_text(text: string, n: i32) -> string {
    let tp: ptr<u8> = text as ptr<u8>
    let len: i32 = s_len(text)
    let mut seen: i32 = 0
    let mut i: i32 = 0
    while i < len and seen < n {
        if tp[i] == 10 {
            seen = seen + 1
        }
        i = i + 1
    }
    return s_slice(text, 0, i)
}

function main() -> i32 {
    tool_only("scripts/test_ci_locally.flow")
    let root: string = env_or("FLOW_REPO_ROOT", cwd_logical())
    env_unset("FLOW_REPO_ROOT")
    if not proc_chdir(root) {
        cli_exit(1)
    }
    env_set("PWD", root)

    outln("🧪 Running CI tests locally...")
    outln("")

    # Check clang
    outln(C_BLUE + "Checking clang..." + C_NC)
    out(head_text(capture_raw(cmd(sl_of2("clang", "--version"))), 3))

    section("Running Tier 1 tests (transpile only)")
    step(tier("1"))

    section("Running Tier 2 tests (transpile + compile)")
    step(tier("2"))

    section("Running the script tests (tests/scripts)")
    step(sl_of2("./flow", "test-scripts"))

    section("Running example programs")
    step(sl_of3("./flow", "run", "examples/basics/hello_world.flow"))
    step(sl_of3("./flow", "compile", "examples/basics/fibonacci.flow"))

    section("Checking the bootstrap compiler")
    step(sl_of2("./compiler/scripts/bootstrap_from_c.sh", "--verify"))

    outln("")
    outln(C_GREEN + "✅ All CI checks passed locally!" + C_NC)
    return 0
}

# These programs change files, run builds and publish, so they run only
# as `./flow tool PATH.flow` (from build/flow-tools), never from a plain
# `flow run` such as the corpus checks do.
function tool_only(path: string) {
    if not s_contains(proc_argv(0), "/flow-tools/") {
        errln("run this with ./flow tool " + path)
        cli_exit(2)
    }
}
