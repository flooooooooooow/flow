# Compile the renderer ABI smoke tests (tests/abi) against the headers in
# demos/vulkan_abi. Compile only: the objects go to /tmp.
#
#   ./flow tool scripts/run_abi_tests.flow

import "tools/flow_cli/sys.flow"
import std.process { proc_argv, ProcStrs, proc_chdir }

function compile(src: string, obj: string) {
    let argv: ptr<ProcStrs> = sl_of3("clang", "-c", src)
    sl_push2(argv, "-o", obj)
    check(run_argv(argv))
}

function main() -> i32 {
    tool_only("scripts/run_abi_tests.flow")
    let root: string = env_or("FLOW_REPO_ROOT", cwd_logical())
    env_unset("FLOW_REPO_ROOT")
    if not proc_chdir(root) {
        cli_exit(1)
    }
    env_set("PWD", root)
    outln("Compiling ABI smoke tests...")
    compile("tests/abi/renderer_abi_smoke.c", "/tmp/renderer_abi_smoke.o")
    compile("tests/abi/vulkan_renderer_smoke.c", "/tmp/vulkan_renderer_smoke.o")
    outln("OK")
    return 0
}

# These programs change files, run builds and publish, so they run only
# as `./flow tool PATH.flow` (from build/flow-tools), never from a plain
# `flow run` such as the corpus checks do.
function tool_only(path: string) {
    if not s_contains(proc_argv(0), "/flow-tools/") {
        errln("run this with ./flow tool " + path)
        cli_exit(2)
    }
}
