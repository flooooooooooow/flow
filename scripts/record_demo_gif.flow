# Record a demo GIF of a Flow application (macOS screen capture through
# ffmpeg's avfoundation input), written to docs/assets/NAME.gif.
#
#   ./flow tool scripts/record_demo_gif.flow [output_name] [duration_seconds]

import "tools/flow_cli/sys.flow"
import std.process { proc_argv, ProcCmd, ProcStrs, proc_args }

function arg_or(args: ptr<ProcStrs>, i: i32, dflt: string) -> string {
    if sl_len(args) > i and s_len(sl_get(args, i)) > 0 {
        return sl_get(args, i)
    }
    return dflt
}

function main() -> i32 {
    tool_only("scripts/record_demo_gif.flow")
    let args: ptr<ProcStrs> = proc_args()
    let name: string = arg_or(args, 0, "tetris_demo")
    let duration: string = arg_or(args, 1, "10")
    let output_dir: string = "docs/assets"
    let tmp_video: string = "/tmp/" + name + ".mov"
    let output_gif: string = output_dir + "/" + name + ".gif"

    outln("🎬 Recording " + duration + "s demo...")
    outln("   Press Ctrl+C to stop early")
    outln("")

    # Record the screen with ffmpeg's avfoundation input (macOS). Device 1
    # is typically the main display.
    let rec: ptr<ProcStrs> = s_words("ffmpeg -y -f avfoundation -framerate 30 -i 1 -t")
    sl_push(rec, duration)
    sl_push2(rec, "-vf", "scale=640:-1")
    sl_push(rec, tmp_video)
    let rc: ptr<ProcCmd> = cmd(rec)
    cmd_quiet_err(rc)
    let _r: i32 = run(rc)

    outln("")
    outln("🎞️  Converting to GIF...")

    # Convert to GIF with a good-quality palette.
    let conv: ptr<ProcStrs> = sl_of3("ffmpeg", "-y", "-i")
    sl_push2(conv, tmp_video, "-vf")
    sl_push(conv, "fps=15,scale=480:-1:flags=lanczos,split[s0][s1];[s0]palettegen=max_colors=128[p];[s1][p]paletteuse=dither=bayer")
    sl_push(conv, output_gif)
    let cc: ptr<ProcCmd> = cmd(conv)
    cmd_quiet_err(cc)
    check(run(cc))

    rm_f(tmp_video)

    outln("✅ Saved to " + output_gif)
    return run_argv(sl_of3("ls", "-lh", output_gif))
}

# These programs change files, run builds and publish, so they run only
# as `./flow tool PATH.flow` (from build/flow-tools), never from a plain
# `flow run` such as the corpus checks do.
function tool_only(path: string) {
    if not s_contains(proc_argv(0), "/flow-tools/") {
        errln("run this with ./flow tool " + path)
        cli_exit(2)
    }
}
