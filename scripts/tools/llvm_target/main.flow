# Compile Flow, or LLVM IR, to an eBPF ELF object or a freestanding wasm32
# module.
#
# Run through the shims (the flow CLI runs them as `flow bpf` and
# `flow wasm32`):
#
#   scripts/bpf_target.sh IN.flow|IN.ll -o OUT.o [--target bpfel]
#       [--entry NAME --section SECTION] [--license TEXT] [-O 0|1|2|3]
#   scripts/wasm32_target.sh IN.flow|IN.ll -o OUT.wasm [--export NAME ...]
#       [-O|--opt-level O0|O1|O2|O3|Os|Oz]
#
# The first argument the shims pass selects the target. A Flow source is
# lowered to LLVM IR by `flow flow-to-llvm` (the flowc MLIR
# emitter and `flow mlir-lower`). For bpf the IR is checked against the
# verifier-hostile constructs the target rejects, given the BPF triple and
# data layout, and, with --entry/--section, the entry is placed in its ELF
# section next to a `license` section. clang with the LLVM BPF backend emits
# the object. For wasm32, clang links the IR into a module with no libc and
# no entry point, exporting the requested symbols (or everything) and the
# memory.
#
# This replaces src/flow/bpf_target.py and src/flow/wasm_compiler.py. The
# messages, exit codes and output files are theirs; compiler/scripts/
# parity_targets.sh holds the goldens. wasm32 also takes an .ll input
# (the Python module only exposed that as llvm_to_wasm).

import .text { ft_itoa, ft_out, ft_outln, ft_err, ft_errln, ft_eq, ft_len, ft_byte, ft_starts, ft_ends, ft_find, ft_contains, ft_slice, ft_from, ft_replace, ft_repr, ft_read_file, ft_write_file, ft_exists, ft_dirname, ft_list_new, ft_list_push, ft_list_len, ft_list_get, ft_list_sort, ft_set_new, ft_set_has, ft_set_add, StrList, StrSet }
import .proc { pr_quote, pr_run, pr_capture, pr_chomp, pr_cwd, pr_is_dir, pr_is_file, pr_mkdir_p }

extern {
    function malloc(size: i64) -> ptr<void>
    function getenv(name: string) -> string
}

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

function root() -> string {
    let r: string = getenv("FLOW_REPO_ROOT")
    if r as ptr<u8> == null or ft_len(r) == 0 {
        return pr_cwd()
    }
    return r
}

function env_or_empty(name: string) -> string {
    let v: string = getenv(name)
    if v as ptr<u8> == null {
        return ""
    }
    return v
}

# A fresh temporary directory, or "" when mktemp fails.
function make_temp_dir(prefix: string) -> string {
    let tmp: string = env_or_empty("TMPDIR")
    let mut base: string = "/tmp"
    if ft_len(tmp) > 0 {
        base = tmp
        if ft_ends(base, "/") {
            base = ft_slice(base, 0, ft_len(base) - 1)
        }
    }
    return pr_chomp(pr_capture("mktemp -d " + pr_quote(base + "/" + prefix + "XXXXXX") + " 2>/dev/null"))
}

function remove_tree(path: string) -> void {
    if ft_len(path) > 0 {
        let _r: i32 = pr_run("rm -rf " + pr_quote(path))
    }
}

# The file's text, or "" when it is missing.
function read_or_empty(path: string) -> string {
    let t: string = ft_read_file(path)
    if t as ptr<u8> == null {
        return ""
    }
    return t
}

# ---------------------------------------------------------------------------
# Python str helpers
# ---------------------------------------------------------------------------

# Python's str.isspace() for one ASCII byte, as \s and strip() see it.
function is_space(c: i32) -> bool {
    return c == 32 or (c >= 9 and c <= 13) or (c >= 28 and c <= 31)
}

function is_word(c: i32) -> bool {
    if c >= 128 {
        return true
    }
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
}

function is_digit(c: i32) -> bool {
    return c >= 48 and c <= 57
}

# str.strip()
function strip(s: string) -> string {
    let n: i32 = ft_len(s)
    let mut a: i32 = 0
    while a < n and is_space(ft_byte(s, a)) {
        a = a + 1
    }
    let mut b: i32 = n
    while b > a and is_space(ft_byte(s, b - 1)) {
        b = b - 1
    }
    return ft_slice(s, a, b)
}

# str.rstrip()
function rstrip(s: string) -> string {
    let mut b: i32 = ft_len(s)
    while b > 0 and is_space(ft_byte(s, b - 1)) {
        b = b - 1
    }
    return ft_slice(s, 0, b)
}

# Length of the line break at i (0 when none), as str.splitlines() counts
# them: \n, \r, \r\n, \v, \f, \x1c-\x1e, and the UTF-8 forms of U+0085,
# U+2028 and U+2029.
function line_break_len(s: string, i: i32, n: i32) -> i32 {
    let c: i32 = ft_byte(s, i)
    if c == 13 {
        if i + 1 < n and ft_byte(s, i + 1) == 10 {
            return 2
        }
        return 1
    }
    if c == 10 or c == 11 or c == 12 or c == 28 or c == 29 or c == 30 {
        return 1
    }
    if c == 194 and i + 1 < n and ft_byte(s, i + 1) == 133 {
        return 2
    }
    if c == 226 and i + 2 < n and ft_byte(s, i + 1) == 128 {
        let d: i32 = ft_byte(s, i + 2)
        if d == 168 or d == 169 {
            return 3
        }
    }
    return 0
}

# str.splitlines()
function splitlines(s: string) -> ptr<StrList> {
    let out: ptr<StrList> = ft_list_new()
    let n: i32 = ft_len(s)
    let mut start: i32 = 0
    let mut i: i32 = 0
    while i < n {
        let k: i32 = line_break_len(s, i, n)
        if k > 0 {
            ft_list_push(out, ft_slice(s, start, i))
            i = i + k
            start = i
        } else {
            i = i + 1
        }
    }
    if start < n {
        ft_list_push(out, ft_slice(s, start, n))
    }
    return out
}

function join_lines(lines: ptr<StrList>) -> string {
    let mut out: string = ""
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        out = out + ft_list_get(lines, i) + "\n"
        i = i + 1
    }
    return out
}

function hex2(v: i32) -> string {
    let digits: string = "0123456789ABCDEF"
    return ft_slice(digits, v / 16, v / 16 + 1) + ft_slice(digits, v % 16, v % 16 + 1)
}

# ---------------------------------------------------------------------------
# Command line (argparse's behaviour for the options these tools take)
# ---------------------------------------------------------------------------

struct Args {
    prog: string,
    input: string,
    output: string,
    target: string,
    entry: string,
    section: string,
    license: string,
    opt: string,
    exports: ptr<StrList>,
    error: string
}

function usage_error(a: ptr<Args>, usage: string, msg: string) -> i32 {
    ft_errln(usage)
    ft_errln(a.prog + ": error: " + msg)
    return 2
}

function choice_list(choices: ptr<StrList>) -> string {
    let mut out: string = ""
    let mut i: i32 = 0
    while i < ft_list_len(choices) {
        if i > 0 {
            out = out + ", "
        }
        out = out + ft_list_get(choices, i)
        i = i + 1
    }
    return out
}

# ---------------------------------------------------------------------------
# bpfel
# ---------------------------------------------------------------------------

const BPF_USAGE: string = "usage: flow bpf [-h] -o OUTPUT [--target {bpfel}] [--entry ENTRY] [--section SECTION] [--license LICENSE] [-O {0,1,2,3}] input"
const WASM_USAGE: string = "usage: flow wasm32 [-h] -o OUTPUT [--export EXPORT] [-O {O0,O1,O2,O3,Os,Oz}] input"

function bpf_forbidden_op(padded: string) -> string {
    let ops: ptr<StrList> = ft_list_new()
    ft_list_push(ops, " invoke ")
    ft_list_push(ops, " landingpad ")
    ft_list_push(ops, " resume ")
    ft_list_push(ops, " catchswitch ")
    ft_list_push(ops, " catchpad ")
    ft_list_push(ops, " cleanuppad ")
    let mut i: i32 = 0
    while i < ft_list_len(ops) {
        if ft_contains(padded, ft_list_get(ops, i)) {
            return strip(ft_list_get(ops, i))
        }
        i = i + 1
    }
    return ""
}

function bpf_forbidden_symbol(ir: string) -> string {
    let syms: ptr<StrList> = ft_list_new()
    ft_list_push(syms, "malloc")
    ft_list_push(syms, "calloc")
    ft_list_push(syms, "realloc")
    ft_list_push(syms, "free")
    ft_list_push(syms, "operator new")
    ft_list_push(syms, "_Znwm")
    ft_list_push(syms, "_Znam")
    ft_list_push(syms, "__cxa_throw")
    ft_list_push(syms, "__cxa_allocate_exception")
    ft_list_push(syms, "_Unwind_")
    let mut i: i32 = 0
    while i < ft_list_len(syms) {
        if ft_contains(ir, ft_list_get(syms, i)) {
            return ft_list_get(syms, i)
        }
        i = i + 1
    }
    return ""
}

# The first non-numeric count matched by
#   \balloca\s+[^,\n]+,\s+i\d+\s+([^\s,]+)
# scanning left to right as re.finditer does, or null when every count is
# a decimal literal.
function bpf_dynamic_alloca(ir: string) -> string {
    let n: i32 = ft_len(ir)
    let mut pos: i32 = 0
    while pos < n {
        let at: i32 = ft_find(ir, "alloca", pos)
        if at < 0 {
            return null as string
        }
        pos = at + 1
        if at > 0 and is_word(ft_byte(ir, at - 1)) {
            continue
        }
        let mut i: i32 = at + 6
        # \s+
        let ws_start: i32 = i
        while i < n and is_space(ft_byte(ir, i)) {
            i = i + 1
        }
        if i == ws_start {
            continue
        }
        # [^,\n]+ then ','
        let mut j: i32 = i
        while j < n and ft_byte(ir, j) != 44 and ft_byte(ir, j) != 10 {
            j = j + 1
        }
        if j >= n or ft_byte(ir, j) != 44 {
            continue
        }
        if j == i {
            # Give one whitespace character back to [^,\n]+ when it can
            # take it.
            if i - ws_start < 2 or ft_byte(ir, i - 1) == 10 {
                continue
            }
        }
        i = j + 1
        # \s+ i \d+ \s+
        let w2: i32 = i
        while i < n and is_space(ft_byte(ir, i)) {
            i = i + 1
        }
        if i == w2 or i >= n or ft_byte(ir, i) != 105 {
            continue
        }
        i = i + 1
        let d0: i32 = i
        while i < n and is_digit(ft_byte(ir, i)) {
            i = i + 1
        }
        if i == d0 {
            continue
        }
        let w3: i32 = i
        while i < n and is_space(ft_byte(ir, i)) {
            i = i + 1
        }
        if i == w3 {
            continue
        }
        # ([^\s,]+)
        let c0: i32 = i
        while i < n and is_space(ft_byte(ir, i)) == false and ft_byte(ir, i) != 44 {
            i = i + 1
        }
        if i == c0 {
            continue
        }
        let count: string = ft_slice(ir, c0, i)
        let mut k: i32 = 0
        while k < ft_len(count) {
            if is_digit(ft_byte(count, k)) == false {
                return count
            }
            k = k + 1
        }
        pos = i
    }
    return null as string
}

# validate_bpf_llvm_ir: "" when the IR is acceptable, else the message.
function bpf_validate(ir: string) -> string {
    let op: string = bpf_forbidden_op(" " + ir + " ")
    if ft_len(op) > 0 {
        return "bpfel does not support exception/unwind IR construct: " + op
    }
    let sym: string = bpf_forbidden_symbol(ir)
    if ft_len(sym) > 0 {
        return "bpfel cannot depend on userspace runtime symbol '" + sym + "'"
    }
    let count: string = bpf_dynamic_alloca(ir)
    if count as ptr<u8> != null {
        return "bpfel requires statically bounded stack allocation; found dynamic alloca count '" + count + "'"
    }
    return ""
}

function bpf_target_header(ir: string) -> string {
    let lines: ptr<StrList> = splitlines(ir)
    let out: ptr<StrList> = ft_list_new()
    ft_list_push(out, "target datalayout = \"e-m:e-p:64:64-i64:64-i128:128-n32:64-S128\"")
    ft_list_push(out, "target triple = \"bpfel\"")
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let line: string = ft_list_get(lines, i)
        if ft_starts(line, "target datalayout =") == false and ft_starts(line, "target triple =") == false {
            ft_list_push(out, line)
        }
        i = i + 1
    }
    return join_lines(out)
}

# The license as an LLVM c"..." body and its byte count with the NUL.
function llvm_c_string(value: string) -> string {
    let mut out: string = ""
    let n: i32 = ft_len(value)
    let mut i: i32 = 0
    while i < n {
        let b: i32 = ft_byte(value, i)
        if b >= 32 and b <= 126 and b != 34 and b != 92 {
            out = out + ft_slice(value, i, i + 1)
        } else {
            out = out + "\\" + hex2(b)
        }
        i = i + 1
    }
    return out + "\\00"
}

# with_bpf_program_metadata. Sets a.error and returns null on failure.
function bpf_program_metadata(ir: string, a: ptr<Args>) -> string {
    let lines: ptr<StrList> = splitlines(ir)
    let cands: ptr<StrList> = ft_list_new()
    ft_list_push(cands, "flow_export_" + a.entry)
    ft_list_push(cands, a.entry)
    let mut symbol: string = ""
    let mut c: i32 = 0
    while c < ft_list_len(cands) and ft_len(symbol) == 0 {
        let needle: string = "@" + ft_list_get(cands, c) + "("
        let mut i: i32 = 0
        while i < ft_list_len(lines) {
            let line: string = ft_list_get(lines, i)
            if ft_starts(line, "define ") and ft_contains(line, needle) {
                symbol = needle
                break
            }
            i = i + 1
        }
        c = c + 1
    }
    let out: ptr<StrList> = ft_list_new()
    let mut found: bool = false
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let mut line: string = ft_list_get(lines, i)
        if ft_len(symbol) > 0 and ft_starts(line, "define ") and ft_contains(line, symbol) {
            if found {
                a.error = "duplicate exported BPF entry '" + a.entry + "'"
                return null as string
            }
            let brace: i32 = ft_find(line, "{", 0)
            if brace < 0 {
                a.error = "cannot decorate multiline definition for BPF entry '" + a.entry + "'"
                return null as string
            }
            line = rstrip(ft_slice(line, 0, brace)) + " section \"" + a.section + "\" " + ft_from(line, brace)
            found = true
        }
        ft_list_push(out, line)
        i = i + 1
    }
    if found == false {
        a.error = "exported BPF entry '" + a.entry + "' not found; looked for @flow_export_" + a.entry + " or @" + a.entry
        return null as string
    }
    let size: i32 = ft_len(a.license) + 1
    ft_list_push(out, "@_flow_bpf_license = dso_local constant [" + ft_itoa(size) + " x i8] c\"" + llvm_c_string(a.license) + "\", section \"license\", align 1")
    return join_lines(out)
}

# The path of an executable on PATH, or "".
function which(name: string) -> string {
    return pr_chomp(pr_capture("command -v " + pr_quote(name) + " 2>/dev/null"))
}

# emit_bpf_object. Returns "" or the error message.
function bpf_emit_object(ir: string, a: ptr<Args>, work: string) -> string {
    let invalid: string = bpf_validate(ir)
    if ft_len(invalid) > 0 {
        return invalid
    }
    let mut targeted: string = bpf_target_header(ir)
    if ft_len(a.entry) > 0 {
        targeted = bpf_program_metadata(targeted, a)
        if targeted as ptr<u8> == null {
            return a.error
        }
    }
    let clang: string = which("clang")
    if ft_len(clang) == 0 {
        return "clang with the LLVM BPF backend is required"
    }
    let parent: string = ft_dirname(a.output)
    if ft_len(parent) > 0 {
        let _m: bool = pr_mkdir_p(parent)
    }
    let ll: string = work + "/targeted.ll"
    let _w: bool = ft_write_file(ll, targeted)
    let cmd: string = pr_quote(clang) + " -target bpfel -O" + a.opt + " -x ir -c -o " + pr_quote(a.output) + " - < " + pr_quote(ll) + " > " + pr_quote(work + "/clang.out") + " 2> " + pr_quote(work + "/clang.err")
    if pr_run(cmd) != 0 {
        let mut detail: string = strip(read_or_empty(work + "/clang.err"))
        if ft_len(detail) == 0 {
            detail = strip(read_or_empty(work + "/clang.out"))
        }
        return "bpfel object emission failed: " + detail
    }
    return ""
}

# Lower a Flow file to LLVM IR at `ll`. Returns "" or the process output
# pieces: the tool's stderr in `err_path`, stdout in `out_path`.
function lower_flow(src: string, ll: string, flags: string, work: string) -> i32 {
    let flow: string = root() + "/flow"
    let cmd: string = pr_quote(flow) + " flow-to-llvm" + flags + " " + pr_quote(src) + " " + pr_quote(ll) + " > " + pr_quote(work + "/lower.out") + " 2> " + pr_quote(work + "/lower.err")
    return pr_run(cmd)
}

function bpf_run(a: ptr<Args>) -> string {
    let has_entry: bool = ft_len(a.entry) > 0
    let has_section: bool = ft_len(a.section) > 0
    if has_entry != has_section {
        return "--entry and --section must be supplied together"
    }
    if ft_ends(a.input, ".flow") and ft_len(a.input) > 5 and ft_byte(a.input, ft_len(a.input) - 6) != 47 {
        if pr_is_file(a.input) == false {
            return "Flow source does not exist: " + a.input
        }
        let work: string = make_temp_dir("flow-bpf-")
        let ll: string = work + "/program.ll"
        if lower_flow(a.input, ll, " --optimize O" + a.opt, work) != 0 {
            let mut detail: string = strip(read_or_empty(work + "/lower.err"))
            if ft_len(detail) == 0 {
                detail = strip(read_or_empty(work + "/lower.out"))
            }
            remove_tree(work)
            return "Flow -> LLVM lowering failed for bpfel: " + detail
        }
        if pr_is_file(ll) == false {
            remove_tree(work)
            return "Flow LLVM lowering completed without producing LLVM IR"
        }
        let err: string = bpf_emit_object(read_or_empty(ll), a, work)
        remove_tree(work)
        return err
    }
    if ft_exists(a.input) == false {
        return "[Errno 2] No such file or directory: " + ft_repr(a.input)
    }
    if pr_is_dir(a.input) {
        return "[Errno 21] Is a directory: " + ft_repr(a.input)
    }
    let ir: string = ft_read_file(a.input)
    if ir as ptr<u8> == null {
        return "[Errno 13] Permission denied: " + ft_repr(a.input)
    }
    let work: string = make_temp_dir("flow-bpf-")
    let err: string = bpf_emit_object(ir, a, work)
    remove_tree(work)
    return err
}

# ---------------------------------------------------------------------------
# wasm32
# ---------------------------------------------------------------------------

function is_ident_start(c: i32) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 36 or c == 46 or c == 95
}

function is_ident_char(c: i32) -> bool {
    return is_ident_start(c) or is_digit(c) or c == 45
}

# _defined_llvm_functions: the names matched by
#   ^\s*define\b[^@]*@(?:"([^"]+)"|([A-Za-z$._][A-Za-z0-9$._-]*))\s*\(
# at every line start, sorted and without duplicates.
function wasm_defined_functions(ir: string) -> ptr<StrList> {
    let seen: ptr<StrSet> = ft_set_new()
    let out: ptr<StrList> = ft_list_new()
    let n: i32 = ft_len(ir)
    let mut ls: i32 = 0
    while ls < n {
        let mut i: i32 = ls
        while i < n and is_space(ft_byte(ir, i)) {
            i = i + 1
        }
        let mut name: string = null as string
        if ft_find(ir, "define", i) == i and (i + 6 >= n or is_word(ft_byte(ir, i + 6)) == false) {
            let at: i32 = ft_find(ir, "@", i + 6)
            if at >= 0 {
                let mut j: i32 = at + 1
                if j < n and ft_byte(ir, j) == 34 {
                    let close: i32 = ft_find(ir, "\"", j + 1)
                    if close > j + 1 {
                        name = ft_slice(ir, j + 1, close)
                        j = close + 1
                    }
                } elif j < n and is_ident_start(ft_byte(ir, j)) {
                    let s0: i32 = j
                    while j < n and is_ident_char(ft_byte(ir, j)) {
                        j = j + 1
                    }
                    name = ft_slice(ir, s0, j)
                }
                if name as ptr<u8> != null {
                    while j < n and is_space(ft_byte(ir, j)) {
                        j = j + 1
                    }
                    if j >= n or ft_byte(ir, j) != 40 {
                        name = null as string
                    }
                }
            }
        }
        if name as ptr<u8> != null and ft_set_has(seen, name) == false {
            ft_set_add(seen, name)
            ft_list_push(out, name)
        }
        # Next line start.
        let mut k: i32 = ls
        while k < n and ft_byte(ir, k) != 10 {
            k = k + 1
        }
        ls = k + 1
    }
    ft_list_sort(out)
    return out
}

function wasm_find_clang() -> string {
    let o1: string = env_or_empty("FLOW_WASM_CLANG")
    if ft_len(o1) > 0 {
        return o1
    }
    let o2: string = env_or_empty("CLANG")
    if ft_len(o2) > 0 {
        return o2
    }
    let llvm: string = env_or_empty("LLVM_PATH")
    if ft_len(llvm) > 0 and ft_exists(llvm + "/clang") {
        return llvm + "/clang"
    }
    return which("clang")
}

# llvm_to_wasm. Returns "" or the error message.
function wasm_link(ir: string, a: ptr<Args>, work: string) -> string {
    let parent: string = ft_dirname(a.output)
    if ft_len(parent) > 0 {
        let _m: bool = pr_mkdir_p(parent)
    }
    let nexp: i32 = ft_list_len(a.exports)
    if nexp > 0 {
        let defined: ptr<StrList> = wasm_defined_functions(ir)
        let mut missing: string = ""
        let mut i: i32 = 0
        while i < nexp {
            let name: string = ft_list_get(a.exports, i)
            let mut hit: bool = false
            let mut k: i32 = 0
            while k < ft_list_len(defined) {
                if ft_eq(ft_list_get(defined, k), name) {
                    hit = true
                }
                k = k + 1
            }
            if hit == false {
                if ft_len(missing) > 0 {
                    missing = missing + ", "
                }
                missing = missing + name
            }
            i = i + 1
        }
        if ft_len(missing) > 0 {
            let mut available: string = choice_list(defined)
            if ft_len(available) == 0 {
                available = "<none>"
            }
            return "requested WebAssembly export(s) are not defined in generated LLVM IR: " + missing + ". Defined functions: " + available
        }
    }
    let ll: string = work + "/module.ll"
    let _w: bool = ft_write_file(ll, ir)
    let clang: string = wasm_find_clang()
    if ft_len(clang) == 0 {
        return "clang not found. Install an LLVM toolchain or set FLOW_WASM_CLANG/LLVM_PATH."
    }
    let mut cmd: string = pr_quote(clang) + " --target=wasm32-unknown-unknown -x ir -" + a.opt + " -nostdlib " + pr_quote(ll) + " -Wl,--no-entry"
    if nexp > 0 {
        let mut i: i32 = 0
        while i < nexp {
            cmd = cmd + " " + pr_quote("-Wl,--export=" + ft_list_get(a.exports, i))
            i = i + 1
        }
    } else {
        cmd = cmd + " -Wl,--export-all"
    }
    cmd = cmd + " -Wl,--allow-undefined -Wl,--export-memory -o " + pr_quote(a.output)
    cmd = cmd + " > " + pr_quote(work + "/clang.out") + " 2> " + pr_quote(work + "/clang.err")
    if pr_run(cmd) != 0 {
        return "LLVM IR to WebAssembly compilation failed:\n" + strip(read_or_empty(work + "/clang.err"))
    }
    return ""
}

function wasm_lower_failure(detail: string, work: string) -> string {
    let mut out: string = detail
    let so: string = strip(read_or_empty(work + "/lower.out"))
    let se: string = strip(read_or_empty(work + "/lower.err"))
    let mut diag: string = ""
    if ft_len(so) > 0 {
        diag = "stdout:\n" + so
    }
    if ft_len(se) > 0 {
        if ft_len(diag) > 0 {
            diag = diag + "\n"
        }
        diag = diag + "stderr:\n" + se
    }
    if ft_len(diag) > 0 {
        out = out + "\n" + diag
    }
    return out
}

function wasm_run(a: ptr<Args>) -> string {
    if ft_exists(a.input) == false {
        return a.input
    }
    let work: string = make_temp_dir("flow_wasm_")
    let mut ir: string = ""
    if ft_ends(a.input, ".ll") {
        ir = read_or_empty(a.input)
    } else {
        let ll: string = work + "/program.ll"
        if lower_flow(a.input, ll, " --wasm32", work) != 0 {
            let msg: string = wasm_lower_failure("Flow to LLVM IR compilation failed", work)
            remove_tree(work)
            return msg
        }
        ir = read_or_empty(ll)
        if ft_len(strip(ir)) == 0 {
            let msg: string = wasm_lower_failure("Flow transpiler returned success but produced empty LLVM IR", work)
            remove_tree(work)
            return msg
        }
    }
    let err: string = wasm_link(ir, a, work)
    remove_tree(work)
    return err
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

# The value of an option at argv[i]: "--opt=value", "-Xvalue" for a short
# option, else argv[i + 1]. `used` is set to 2 when the next word is taken.
struct OptVal {
    value: string,
    used: i32
}

function option_value(argc: i32, argv: ptr<ptr<u8>>, i: i32, name: string, v: ptr<OptVal>) -> bool {
    let arg: string = argv[i] as string
    if ft_len(arg) > ft_len(name) and ft_starts(arg, name) {
        let rest: string = ft_from(arg, ft_len(name))
        if ft_starts(name, "--") {
            if ft_starts(rest, "=") == false {
                return false
            }
            v.value = ft_from(rest, 1)
        } else {
            v.value = rest
        }
        v.used = 1
        return true
    }
    if ft_eq(arg, name) == false {
        return false
    }
    if i + 1 >= argc {
        v.value = null
        v.used = 1
        return true
    }
    let next: string = argv[i + 1] as string
    if ft_starts(next, "-") and ft_len(next) > 1 {
        v.value = null
        v.used = 1
        return true
    }
    v.value = next
    v.used = 2
    return true
}

function main(argc: i32, argv: ptr<ptr<u8>>) -> i32 {
    if argc < 2 {
        ft_errln("usage: llvm_target bpf|wasm32 ARGS")
        return 2
    }
    let mode: string = argv[1] as string
    let is_bpf: bool = ft_eq(mode, "bpf")
    if is_bpf == false and ft_eq(mode, "wasm32") == false {
        ft_errln("llvm_target: unknown target " + mode)
        return 2
    }
    let a: ptr<Args> = malloc(128) as ptr<Args>
    a.input = null
    a.output = null
    a.target = "bpfel"
    a.entry = ""
    a.section = ""
    a.license = "GPL"
    a.exports = ft_list_new()
    a.error = ""
    let mut usage: string = WASM_USAGE
    if is_bpf {
        a.prog = "flow bpf"
        a.opt = "2"
        usage = BPF_USAGE
    } else {
        a.prog = "flow wasm32"
        a.opt = "O2"
    }
    let opt_choices: ptr<StrList> = ft_list_new()
    if is_bpf {
        ft_list_push(opt_choices, "0")
        ft_list_push(opt_choices, "1")
        ft_list_push(opt_choices, "2")
        ft_list_push(opt_choices, "3")
    } else {
        ft_list_push(opt_choices, "O0")
        ft_list_push(opt_choices, "O1")
        ft_list_push(opt_choices, "O2")
        ft_list_push(opt_choices, "O3")
        ft_list_push(opt_choices, "Os")
        ft_list_push(opt_choices, "Oz")
    }
    let mut opt_label: string = "-O/--opt-level"
    if is_bpf {
        opt_label = "-O"
    }
    let extras: ptr<StrList> = ft_list_new()
    let v: ptr<OptVal> = malloc(16) as ptr<OptVal>
    let mut i: i32 = 1 + 1
    while i < argc {
        let arg: string = argv[i] as string
        if ft_eq(arg, "-h") or ft_eq(arg, "--help") {
            ft_outln(usage)
            return 0
        }
        let mut matched: bool = false
        let mut label: string = ""
        let mut which_opt: i32 = 0
        if option_value(argc, argv, i, "--output", v) {
            matched = true
            label = "-o/--output"
            which_opt = 1
        } elif option_value(argc, argv, i, "-o", v) {
            matched = true
            label = "-o/--output"
            which_opt = 1
        } elif is_bpf == false and option_value(argc, argv, i, "--opt-level", v) {
            matched = true
            label = opt_label
            which_opt = 2
        } elif option_value(argc, argv, i, "-O", v) {
            matched = true
            label = opt_label
            which_opt = 2
        } elif is_bpf and option_value(argc, argv, i, "--target", v) {
            matched = true
            label = "--target"
            which_opt = 3
        } elif is_bpf and option_value(argc, argv, i, "--entry", v) {
            matched = true
            label = "--entry"
            which_opt = 4
        } elif is_bpf and option_value(argc, argv, i, "--section", v) {
            matched = true
            label = "--section"
            which_opt = 5
        } elif is_bpf and option_value(argc, argv, i, "--license", v) {
            matched = true
            label = "--license"
            which_opt = 6
        } elif is_bpf == false and option_value(argc, argv, i, "--export", v) {
            matched = true
            label = "--export"
            which_opt = 7
        }
        if matched {
            if v.value as ptr<u8> == null {
                return usage_error(a, usage, "argument " + label + ": expected one argument")
            }
            if which_opt == 1 {
                a.output = v.value
            } elif which_opt == 2 {
                let mut ok: bool = false
                let mut k: i32 = 0
                while k < ft_list_len(opt_choices) {
                    if ft_eq(ft_list_get(opt_choices, k), v.value) {
                        ok = true
                    }
                    k = k + 1
                }
                if ok == false {
                    return usage_error(a, usage, "argument " + label + ": invalid choice: " + ft_repr(v.value) + " (choose from " + choice_list(opt_choices) + ")")
                }
                a.opt = v.value
            } elif which_opt == 3 {
                if ft_eq(v.value, "bpfel") == false {
                    return usage_error(a, usage, "argument --target: invalid choice: " + ft_repr(v.value) + " (choose from bpfel)")
                }
                a.target = v.value
            } elif which_opt == 4 {
                a.entry = v.value
            } elif which_opt == 5 {
                a.section = v.value
            } elif which_opt == 6 {
                a.license = v.value
            } else {
                ft_list_push(a.exports, v.value)
            }
            i = i + v.used
            continue
        }
        if ft_starts(arg, "-") and ft_len(arg) > 1 {
            ft_list_push(extras, arg)
        } elif a.input as ptr<u8> == null {
            a.input = arg
        } else {
            ft_list_push(extras, arg)
        }
        i = i + 1
    }
    let mut required: string = ""
    if a.input as ptr<u8> == null {
        required = "input"
    }
    if a.output as ptr<u8> == null {
        if ft_len(required) > 0 {
            required = required + ", "
        }
        required = required + "-o/--output"
    }
    if ft_len(required) > 0 {
        return usage_error(a, usage, "the following arguments are required: " + required)
    }
    if ft_list_len(extras) > 0 {
        let mut words: string = ""
        let mut k: i32 = 0
        while k < ft_list_len(extras) {
            if k > 0 {
                words = words + " "
            }
            words = words + ft_list_get(extras, k)
            k = k + 1
        }
        return usage_error(a, usage, "unrecognized arguments: " + words)
    }
    let mut err: string = ""
    if is_bpf {
        err = bpf_run(a)
    } else {
        err = wasm_run(a)
    }
    if ft_len(err) > 0 {
        ft_errln("error: " + err)
        return 1
    }
    if is_bpf == false {
        ft_errln("Generated WebAssembly: " + a.output)
    }
    return 0
}
