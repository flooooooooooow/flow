# Build the Flow wiki static site into build/wiki.
#
# Run it as `./flow tool build_wiki` from anywhere in the repository; it
# works from the repository root. Steps, in the order the output depends on:
#
#   1. refresh docs/library/stdlib-api.md (tools.wiki_stdlib)
#   2. copy docs/, the markdown under examples/, and the extra pages
#   3. copy the flow-verify proof pages and index them
#   4. write the Euclid indexes, proof catalog, versions.json, releases.md,
#      example-status.md and wiki-nav.json (docs/nav.json is validated first)
#   5. build search-index.json from every page copied so far
#   6. copy the site shell, write tutorials/exercises.json, llms.txt and
#      proof-graph.json, then index the site with Pagefind (npx) unless
#      FLOW_WIKI_SKIP_PAGEFIND is set
#
# Copies go through cp(1) and directory listings through find(1), since
# Stage-A programs have no filesystem API beyond open/read/write. Directory
# order for search-index.json follows Python 3.12's Path.rglob, rebuilt from
# the per-directory order find reports.
#
# `build_wiki --pagefind` re-indexes an already built site (FLOW_WIKI_OUT,
# default build/wiki) with Pagefind; it skips cleanly without node or npx.
# `build_wiki --pagefind-stage INDEX DIR` only writes the HTML stubs Pagefind
# indexes.

import .text { ft_out, ft_outln, ft_err, ft_errln, ft_eq, ft_len, ft_at, ft_starts, ft_ends, ft_find, ft_contains, ft_find_byte, ft_rfind_byte, ft_slice, ft_from, ft_itoa, ft_replace, ft_exists, ft_read_file, ft_write_file, ft_basename, ft_dirname, ft_list_new, ft_list_push, ft_list_len, ft_list_get, ft_set_new, ft_set_add, ft_set_has, ft_map_new, ft_map_get, ft_map_put, StrList, StrSet, StrMap }
import .unicode { uc_decode, uc_len, uc_is_space, uc_strip, uc_lower_str }
import .json { json_parse, json_error, json_kind, json_str, json_get, json_first, json_next, json_len, json_quote, Json }
import .mdtext { md_collapse_ws }
import .proc { pr_quote, pr_run, pr_cwd, pr_mkdir_p, pr_is_dir, pr_is_file }
import .wiki_util { wb_new, wb_add, wb_line, wb_str, wb_len, wb_write, wu_dash, wu_arrow, wu_dot, wu_ellipsis, wu_read_text, wu_splitlines, wu_cp_prefix, wu_cp_count, wu_strip_set, wu_title, wu_stem, wu_sort, wu_lines_of, wu_today, wu_dump, wu_pad, wu_truthy, WBuf }
import .wiki_nav { wn_load, wn_validate, wn_dump_sections, wn_category_for }
import .wiki_stdlib { wsd_generate }
import .wiki_blocks { wk_new, wk_count, wk_code, wk_section, wk_title, wk_path, wk_error, wk_collect_file, WkBlocks }
import .repo { rp_enter_root }
import std.process { ProcCmd, ProcResult, proc_cmd, proc_arg, proc_stdout, proc_stderr, proc_timeout_ms, proc_run, proc_which, PROC_INHERIT }

extern {
    function malloc(size: i64) -> ptr<void>
    function strlen(s: string) -> i64
    function getenv(name: string) -> string
}

const OUT: string = "build/wiki"

# ---------------------------------------------------------------------------
# Rows of proof pages
# ---------------------------------------------------------------------------

struct Rows {
    rel: ptr<StrList>
    title: ptr<StrList>
    summary: ptr<StrList>
    wiki: ptr<StrList>
}

function rows_new() -> ptr<Rows> {
    let r: ptr<Rows> = malloc(32) as ptr<Rows>
    r[0].rel = ft_list_new()
    r[0].title = ft_list_new()
    r[0].summary = ft_list_new()
    r[0].wiki = ft_list_new()
    return r
}

function rows_len(r: ptr<Rows>) -> i32 {
    return ft_list_len(r[0].rel)
}

function rows_push(r: ptr<Rows>, rel: string, title: string, summary: string, wiki: string) -> void {
    ft_list_push(r[0].rel, rel)
    ft_list_push(r[0].title, title)
    ft_list_push(r[0].summary, summary)
    ft_list_push(r[0].wiki, wiki)
}

# ---------------------------------------------------------------------------
# Shell batches
# ---------------------------------------------------------------------------

function batch_run(b: ptr<WBuf>) -> void {
    if wb_len(b) == 0 {
        return
    }
    let _d: bool = pr_mkdir_p("build/wiki-tool")
    let script: string = "build/wiki-tool/batch.sh"
    let _w: bool = wb_write(script, b)
    let _r: i32 = pr_run("sh " + script)
}

# shutil.copytree with ignore_patterns(".*", "__pycache__", "*.pyc"),
# after removing an existing destination.
function add_copy_tree(b: ptr<WBuf>, src: string, dst: string) -> void {
    wb_line(b, "rm -rf " + pr_quote(dst))
    wb_line(b, "cp -RL " + pr_quote(src) + " " + pr_quote(dst))
    wb_line(b, "find " + pr_quote(dst) + " -mindepth 1 \\( -name '.*' -o -name '__pycache__' -o -name '*.pyc' \\) -prune -exec rm -rf {} +")
}

function add_copy_file(b: ptr<WBuf>, src: string, dst: string) -> void {
    wb_line(b, "cp -p " + pr_quote(src) + " " + pr_quote(dst))
}

function add_mkdir(b: ptr<WBuf>, dir: string) -> void {
    wb_line(b, "mkdir -p " + pr_quote(dir))
}

function has_hidden_part(rel: string) -> bool {
    let p: ptr<u8> = rel as ptr<u8>
    let mut i: i32 = 0
    while p[i] != 0 {
        if p[i] == 46 and (i == 0 or p[i - 1] == 47) {
            return true
        }
        i = i + 1
    }
    return false
}

# ---------------------------------------------------------------------------
# Copying docs and extras
# ---------------------------------------------------------------------------

function copy_docs(b: ptr<WBuf>) -> void {
    let items: ptr<StrList> = wu_lines_of("find docs -mindepth 1 -maxdepth 1 2>/dev/null")
    let mut i: i32 = 0
    while i < ft_list_len(items) {
        let item: string = ft_list_get(items, i)
        let name: string = ft_basename(item)
        if ft_eq(name, "playground") == false and ft_starts(name, ".") == false {
            let target: string = OUT + "/" + name
            if pr_is_dir(item) {
                add_copy_tree(b, item, target)
            } else {
                add_copy_file(b, item, target)
            }
        }
        i = i + 1
    }
    if pr_is_dir("examples") {
        let pages: ptr<StrList> = wu_lines_of("find examples -name '*.md' 2>/dev/null")
        wu_sort(pages, true)
        let made: ptr<StrSet> = ft_set_new()
        let mut k: i32 = 0
        while k < ft_list_len(pages) {
            let page: string = ft_list_get(pages, k)
            if has_hidden_part(page) == false {
                let dest: string = OUT + "/" + page
                let dir: string = ft_dirname(dest)
                if ft_set_has(made, dir) == false {
                    add_mkdir(b, dir)
                    ft_set_add(made, dir)
                }
                add_copy_file(b, page, dest)
            }
            k = k + 1
        }
    }
}

# `](...)` hrefs in ROADMAP.md, mapped to wiki paths.
function rewrite_href(href: string) -> string {
    let hash: i32 = ft_find_byte(href, 35, 0)
    let mut path: string = href
    let mut frag: string = ""
    if hash >= 0 {
        path = ft_slice(href, 0, hash)
        let rest: string = ft_from(href, hash + 1)
        if ft_len(rest) > 0 {
            frag = "#" + rest
        }
    }
    if ft_starts(path, "docs/") {
        let tail: string = ft_from(path, 5)
        return "../" + tail + frag
    }
    if ft_eq(path, "VISION.md") {
        return "../VISION.md" + frag
    }
    return href
}

function rewrite_repo_links(text: string) -> string {
    let p: ptr<u8> = text as ptr<u8>
    let b: ptr<WBuf> = wb_new()
    let n: i32 = ft_len(text)
    let mut start: i32 = 0
    let mut i: i32 = 0
    while i < n {
        if p[i] == 93 and p[i + 1] == 40 {
            let mut e: i32 = i + 2
            while p[e] != 0 and p[e] != 41 {
                e = e + 1
            }
            if p[e] == 41 and e > i + 2 {
                wb_add(b, ft_slice(text, start, i))
                wb_add(b, "](" + rewrite_href(ft_slice(text, i + 2, e)) + ")")
                start = e + 1
                i = e + 1
                continue
            }
        }
        i = i + 1
    }
    wb_add(b, ft_from(text, start))
    return wb_str(b)
}

function copy_extras(b: ptr<WBuf>) -> void {
    if ft_exists("README.md") {
        add_copy_file(b, "README.md", OUT + "/README.md")
    }
    if ft_exists("mkdocs.yml") {
        add_copy_file(b, "mkdocs.yml", OUT + "/mkdocs.yml")
    }
    if ft_exists("docs/grammar.ebnf") {
        add_copy_file(b, "docs/grammar.ebnf", OUT + "/grammar.ebnf")
    }
    if ft_exists("benchmarks/suite/RESULTS.md") {
        add_mkdir(b, OUT + "/project")
        add_copy_file(b, "benchmarks/suite/RESULTS.md", OUT + "/project/benchmark-results.md")
    }
    if ft_exists("docs/assets") {
        add_copy_tree(b, "docs/assets", OUT + "/assets")
    }
    if ft_exists("docs/playground") {
        add_copy_tree(b, "docs/playground", OUT + "/playground")
    }
}

function write_roadmap() -> void {
    if ft_exists("ROADMAP.md") {
        let _m: bool = pr_mkdir_p(OUT + "/project")
        let text: string = wu_read_text("ROADMAP.md")
        let _w: bool = ft_write_file(OUT + "/project/language-roadmap.md", rewrite_repo_links(text))
    }
}

# ---------------------------------------------------------------------------
# Proof pages
# ---------------------------------------------------------------------------

function proof_title(text: string) -> string {
    let lines: ptr<StrList> = wu_splitlines(text)
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let st: string = uc_strip(ft_list_get(lines, i))
        if ft_starts(st, "# ") {
            return uc_strip(ft_from(st, 2))
        }
        if ft_starts(st, "## ") and ft_contains(st, "Definition") == false and ft_contains(st, "Axiom") == false {
            return uc_strip(ft_from(st, 3))
        }
        i = i + 1
    }
    return ""
}

function proof_summary(text: string) -> string {
    let lines: ptr<StrList> = wu_splitlines(text)
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let st: string = uc_strip(ft_list_get(lines, i))
        if ft_starts(st, "*") and ft_ends(st, "*") and wu_cp_count(st) > 2 {
            return uc_strip(wu_strip_set(st, "*"))
        }
        i = i + 1
    }
    return ""
}

function sync_proofs_one(b: ptr<WBuf>, src: string, dst: string, prefix: string, rows: ptr<Rows>, made: ptr<StrSet>) -> void {
    if ft_exists(src) == false {
        return
    }
    let found: ptr<StrList> = wu_lines_of("find " + pr_quote(src) + " -name '*.proof.md' 2>/dev/null")
    wu_sort(found, true)
    let mut i: i32 = 0
    while i < ft_list_len(found) {
        let full: string = ft_list_get(found, i)
        let rel: string = ft_from(full, ft_len(src) + 1)
        let target: string = dst + "/" + rel
        let tdir: string = ft_dirname(target)
        if ft_set_has(made, tdir) == false {
            add_mkdir(b, tdir)
            ft_set_add(made, tdir)
        }
        add_copy_file(b, full, target)
        let name: string = ft_basename(full)
        let sdir: string = ft_dirname(full)
        let mut svg: string = sdir + "/" + ft_replace(name, ".proof.md", ".proof.svg")
        if ft_exists(svg) == false {
            svg = sdir + "/" + ft_slice(name, 0, ft_len(name) - 3) + ".svg"
        }
        if ft_exists(svg) {
            add_copy_file(b, svg, tdir + "/" + ft_basename(svg))
        }
        let text: string = wu_read_text(full)
        let mut title: string = proof_title(text)
        if ft_len(title) == 0 {
            title = rel
        }
        rows_push(rows, rel, title, proof_summary(text), "third-party/flow-verify/proofs/" + prefix + "/" + rel)
        i = i + 1
    }
}

# ---------------------------------------------------------------------------
# Groups, catalog and Euclid indexes
# ---------------------------------------------------------------------------

# Row indexes of each group are stored back to back in `members`, group
# `gi` starting at starts[gi].
struct Groups {
    keys: ptr<StrList>
    members: ptr<i32>
    starts: ptr<i32>
    counts: ptr<i32>
    n: i32
}

function group_key(rel: string) -> string {
    let slash: i32 = ft_find_byte(rel, 47, 0)
    if slash < 0 {
        return rel
    }
    let first: string = ft_slice(rel, 0, slash)
    let rest: string = ft_from(rel, slash + 1)
    let slash2: i32 = ft_find_byte(rest, 47, 0)
    let mut second: string = rest
    if slash2 >= 0 {
        second = ft_slice(rest, 0, slash2)
    }
    if ft_eq(first, "euclid") or ft_eq(first, "math") {
        return first + "/" + second
    }
    return first
}

function group_rows(rows: ptr<Rows>) -> ptr<Groups> {
    let n: i32 = rows_len(rows)
    let keys: ptr<StrList> = ft_list_new()
    let index: ptr<StrMap> = ft_map_new()
    let owner: ptr<i32> = malloc((n as i64) * 4 + 4) as ptr<i32>
    let mut i: i32 = 0
    while i < n {
        let key: string = group_key(ft_list_get(rows[0].rel, i))
        let mut gi: i32 = ft_map_get(index, key, -1)
        if gi < 0 {
            gi = ft_list_len(keys)
            ft_list_push(keys, key)
            ft_map_put(index, key, gi)
        }
        owner[i] = gi
        i = i + 1
    }
    let sorted_keys: ptr<StrList> = ft_list_new()
    let mut k: i32 = 0
    while k < ft_list_len(keys) {
        ft_list_push(sorted_keys, ft_list_get(keys, k))
        k = k + 1
    }
    wu_sort(sorted_keys, false)
    let ng: i32 = ft_list_len(sorted_keys)
    let g: ptr<Groups> = malloc(48) as ptr<Groups>
    g[0].keys = sorted_keys
    g[0].n = ng
    g[0].members = malloc((n as i64) * 4 + 4) as ptr<i32>
    g[0].starts = malloc((ng as i64) * 4 + 4) as ptr<i32>
    g[0].counts = malloc((ng as i64) * 4 + 4) as ptr<i32>
    let members: ptr<i32> = g[0].members
    let starts: ptr<i32> = g[0].starts
    let counts: ptr<i32> = g[0].counts
    let mut fill: i32 = 0
    let mut s: i32 = 0
    while s < ng {
        let orig: i32 = ft_map_get(index, ft_list_get(sorted_keys, s), -1)
        starts[s] = fill
        let mut c: i32 = 0
        let mut r: i32 = 0
        while r < n {
            if owner[r] == orig {
                members[fill] = r
                fill = fill + 1
                c = c + 1
            }
            r = r + 1
        }
        counts[s] = c
        s = s + 1
    }
    return g
}

function group_member(g: ptr<Groups>, gi: i32, k: i32) -> i32 {
    let members: ptr<i32> = g[0].members
    let starts: ptr<i32> = g[0].starts
    return members[starts[gi] + k]
}

function group_count(g: ptr<Groups>, gi: i32) -> i32 {
    let counts: ptr<i32> = g[0].counts
    return counts[gi]
}

# The digits of the first `prop-<digits>` in `s`, or "".
function prop_number(s: string) -> string {
    let mut at: i32 = ft_find(s, "prop-", 0)
    let p: ptr<u8> = s as ptr<u8>
    while at >= 0 {
        let mut e: i32 = at + 5
        while p[e] >= 48 and p[e] <= 57 {
            e = e + 1
        }
        if e > at + 5 {
            return ft_slice(s, at + 5, e)
        }
        at = ft_find(s, "prop-", at + 1)
    }
    return ""
}

function short_euclid_label(rel: string) -> string {
    let name: string = wu_stem(rel)
    let num: string = prop_number(name)
    if ft_len(num) > 0 {
        return "Prop " + num
    }
    return name
}

function book_of(group: string) -> string {
    let slash: i32 = ft_find_byte(group, 47, 0)
    let rest: string = ft_from(group, slash + 1)
    let slash2: i32 = ft_find_byte(rest, 47, 0)
    if slash2 >= 0 {
        return ft_slice(rest, 0, slash2)
    }
    return rest
}

function roman_of(book: string) -> string {
    if ft_eq(book, "book-i") {
        return "I"
    }
    if ft_eq(book, "book-ii") {
        return "II"
    }
    if ft_eq(book, "book-iii") {
        return "III"
    }
    if ft_eq(book, "book-iv") {
        return "IV"
    }
    if ft_eq(book, "book-v") {
        return "V"
    }
    if ft_eq(book, "book-vi") {
        return "VI"
    }
    return book
}

function escape_pipes(s: string) -> string {
    return ft_replace(s, "|", "\\|")
}

# Returns the nav items as a JSON array rendered at `level`.
function write_euclid_indexes(ex: ptr<Rows>, g: ptr<Groups>, level: i32, count_out: ptr<i32>) -> string {
    let dash: string = wu_dash()
    let nav: ptr<WBuf> = wb_new()
    let mut items: i32 = 0
    let mut gi: i32 = 0
    while gi < g[0].n {
        let group: string = ft_list_get(g[0].keys, gi)
        if ft_starts(group, "euclid/") {
            let book: string = book_of(group)
            let label: string = "Euclid Book " + roman_of(book)
            let index_path: string = "third-party/flow-verify/euclid-" + book + ".md"
            let cnt: i32 = group_count(g, gi)
            let b: ptr<WBuf> = wb_new()
            wb_line(b, "# " + label)
            wb_line(b, "")
            wb_line(b, "> **" + ft_itoa(cnt) + "** propositions from *Elements*, stepped proofs with numbered deductive traces.")
            wb_line(b, "")
            wb_line(b, "| # | Proposition |")
            wb_line(b, "|---|-------------|")
            let mut k: i32 = 0
            while k < cnt {
                let r: i32 = group_member(g, gi, k)
                let rel: string = ft_list_get(ex[0].rel, r)
                let prop: string = short_euclid_label(rel)
                let mut summ: string = ft_list_get(ex[0].summary, r)
                if ft_len(summ) == 0 {
                    summ = ft_list_get(ex[0].title, r)
                }
                let cut: string = escape_pipes(wu_cp_prefix(summ, 80))
                let link: string = "[" + prop + " " + dash + " " + cut + "](" + ft_list_get(ex[0].wiki, r) + ")"
                let mut num: string = prop_number(rel)
                if ft_len(num) == 0 {
                    num = dash
                }
                wb_line(b, "| " + num + " | " + link + " |")
                k = k + 1
            }
            let _m: bool = pr_mkdir_p(OUT + "/third-party/flow-verify")
            let _w: bool = wb_write(OUT + "/" + index_path, b)
            if items > 0 {
                wb_add(nav, ",\n")
            }
            wu_pad(nav, level + 1)
            wb_add(nav, "{\n")
            wu_pad(nav, level + 2)
            wb_add(nav, "\"label\": " + json_quote(label) + ",\n")
            wu_pad(nav, level + 2)
            wb_add(nav, "\"path\": " + json_quote(index_path) + ",\n")
            wu_pad(nav, level + 2)
            wb_add(nav, "\"badge\": " + json_quote(ft_itoa(cnt)) + "\n")
            wu_pad(nav, level + 1)
            wb_add(nav, "}")
            items = items + 1
        }
        gi = gi + 1
    }
    count_out[0] = items
    if items == 0 {
        return "[]"
    }
    let whole: ptr<WBuf> = wb_new()
    wb_add(whole, "[\n")
    wb_add(whole, wb_str(nav))
    wb_add(whole, "\n")
    wu_pad(whole, level)
    wb_add(whole, "]")
    return wb_str(whole)
}

function write_catalog(lib: ptr<Rows>, ex: ptr<Rows>, g: ptr<Groups>, today: string) -> void {
    let dash: string = wu_dash()
    let b: ptr<WBuf> = wb_new()
    wb_line(b, "# Proof Catalog")
    wb_line(b, "")
    wb_line(b, "> **" + ft_itoa(rows_len(lib)) + "** core modules " + wu_dot() + " **" + ft_itoa(rows_len(ex)) + "** extended proofs " + wu_dot() + " updated " + today)
    wb_line(b, "")
    wb_line(b, "Use the sidebar **Third-Party " + wu_arrow() + " flow-verify** section for direct book access.")
    wb_line(b, "")
    wb_line(b, "---")
    wb_line(b, "")
    wb_line(b, "## Core library")
    wb_line(b, "")
    wb_line(b, "| Module | Summary |")
    wb_line(b, "|--------|---------|")
    let mut i: i32 = 0
    while i < rows_len(lib) {
        let mut summ: string = ft_list_get(lib[0].summary, i)
        if ft_len(summ) == 0 {
            summ = dash
        }
        wb_line(b, "| [" + wu_stem(ft_list_get(lib[0].rel, i)) + "](" + ft_list_get(lib[0].wiki, i) + ") | " + escape_pipes(summ) + " |")
        i = i + 1
    }
    wb_line(b, "")
    wb_line(b, "---")
    wb_line(b, "")
    wb_line(b, "## Extended corpus")
    wb_line(b, "")
    let mut gi: i32 = 0
    while gi < g[0].n {
        let group: string = ft_list_get(g[0].keys, gi)
        let cnt: i32 = group_count(g, gi)
        let euclid: bool = ft_starts(group, "euclid/")
        if euclid {
            let book: string = book_of(group)
            let label: string = wu_title(ft_replace(book, "-", " "))
            wb_line(b, "### [" + label + "](third-party/flow-verify/euclid-" + book + ".md) (" + ft_itoa(cnt) + " proofs)")
        } else {
            let label2: string = wu_title(ft_replace(ft_replace(group, "/", " " + wu_arrow() + " "), "-", " "))
            wb_line(b, "### " + label2 + " (" + ft_itoa(cnt) + ")")
        }
        wb_line(b, "")
        wb_line(b, "| Proof | Summary |")
        wb_line(b, "|-------|---------|")
        let mut limit: i32 = cnt
        if euclid and limit > 20 {
            limit = 20
        }
        let mut k: i32 = 0
        while k < limit {
            let r: i32 = group_member(g, gi, k)
            let mut summ2: string = ft_list_get(ex[0].summary, r)
            if ft_len(summ2) == 0 {
                summ2 = dash
            }
            let rel: string = ft_list_get(ex[0].rel, r)
            let mut title: string = wu_stem(rel)
            if euclid {
                title = short_euclid_label(rel)
            }
            wb_line(b, "| [" + title + "](" + ft_list_get(ex[0].wiki, r) + ") | " + escape_pipes(summ2) + " |")
            k = k + 1
        }
        if euclid and cnt > 20 {
            wb_line(b, "| " + wu_ellipsis() + " | [" + ft_itoa(cnt) + " total " + dash + " see Euclid index](third-party/flow-verify/euclid-" + book_of(group) + ".md) |")
        }
        wb_line(b, "")
        gi = gi + 1
    }
    let _m: bool = pr_mkdir_p(OUT + "/third-party")
    let _w: bool = wb_write(OUT + "/third-party/flow-verify-catalog.md", b)
}

function proof_group_label(group: string, count: i32) -> string {
    let mut base: string = ""
    if ft_eq(group, "analysis") {
        base = "Analysis"
    } elif ft_eq(group, "circuits") {
        base = "Circuits"
    } elif ft_eq(group, "geometry") {
        base = "Geometry"
    } elif ft_eq(group, "math") {
        base = "Math"
    } elif ft_eq(group, "math/derived") {
        base = "Derived Math"
    } elif ft_eq(group, "systems") {
        base = "Systems"
    } elif ft_eq(group, "transforms") {
        base = "Transforms"
    } else {
        base = wu_title(ft_replace(ft_replace(group, "/", " " + wu_dot() + " "), "-", " "))
    }
    return base + " (" + ft_itoa(count) + ")"
}

# ---------------------------------------------------------------------------
# Versions and releases
# ---------------------------------------------------------------------------

struct Versions {
    ids: ptr<StrList>
    labels: ptr<StrList>
    dates: ptr<StrList>
    n: i32
}

function version_less_key(a: string, b: string) -> i32 {
    # Compare the ver_key tuples of two ids: -1, 0 or 1.
    let pa: ptr<StrList> = split_ver(a)
    let pb: ptr<StrList> = split_ver(b)
    let mut i: i32 = 0
    while i < ft_list_len(pa) and i < ft_list_len(pb) {
        let va: i64 = ver_int(ft_list_get(pa, i))
        let vb: i64 = ver_int(ft_list_get(pb, i))
        if va < vb {
            return -1
        }
        if va > vb {
            return 1
        }
        i = i + 1
    }
    if ft_list_len(pa) < ft_list_len(pb) {
        return -1
    }
    if ft_list_len(pa) > ft_list_len(pb) {
        return 1
    }
    return 0
}

function split_ver(id: string) -> ptr<StrList> {
    let parts: ptr<StrList> = ft_list_new()
    let p: ptr<u8> = id as ptr<u8>
    let mut start: i32 = 0
    let mut i: i32 = 0
    while true {
        if p[i] == 0 or p[i] == 46 or p[i] == 45 {
            ft_list_push(parts, ft_slice(id, start, i))
            if p[i] == 0 {
                break
            }
            start = i + 1
        }
        i = i + 1
    }
    return parts
}

function ver_int(part: string) -> i64 {
    let p: ptr<u8> = part as ptr<u8>
    if p[0] == 0 {
        return 0
    }
    let mut v: i64 = 0
    let mut i: i32 = 0
    while p[i] != 0 {
        if p[i] < 48 or p[i] > 57 {
            return 0
        }
        v = v * 10 + ((p[i] as i64) - 48)
        i = i + 1
    }
    return v
}

function parse_versions() -> ptr<Versions> {
    let v: ptr<Versions> = malloc(32) as ptr<Versions>
    v[0].ids = ft_list_new()
    v[0].labels = ft_list_new()
    v[0].dates = ft_list_new()
    v[0].n = 0
    let path: string = "docs/project/CHANGELOG.md"
    if ft_exists(path) == false {
        v[0].n = -1
        return v
    }
    let text: string = wu_read_text(path)
    let lines: ptr<StrList> = wu_splitlines(text)
    let seen: ptr<StrSet> = ft_set_new()
    let ids: ptr<StrList> = ft_list_new()
    let labels: ptr<StrList> = ft_list_new()
    let dates: ptr<StrList> = ft_list_new()
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let st: string = uc_strip(ft_list_get(lines, i))
        i = i + 1
        if ft_starts(st, "## [") == false {
            continue
        }
        let close: i32 = ft_find_byte(st, 93, 4)
        if close <= 4 {
            continue
        }
        let rest: string = ft_from(st, close + 1)
        let mut date: string = ""
        if ft_len(rest) > 0 {
            if ft_starts(rest, " - ") and ft_len(rest) > 3 {
                date = uc_strip(ft_from(rest, 3))
            } else {
                continue
            }
        }
        let ver: string = uc_strip(ft_slice(st, 4, close))
        if ft_eq(ver, "Unreleased") or ft_set_has(seen, ver) {
            continue
        }
        ft_set_add(seen, ver)
        ft_list_push(ids, ver)
        if ft_starts(ver, "v") {
            ft_list_push(labels, ver)
        } else {
            ft_list_push(labels, "v" + ver)
        }
        ft_list_push(dates, date)
    }
    # Stable sort, newest first (sorted(..., reverse=True) keeps ties in order).
    let n: i32 = ft_list_len(ids)
    let order: ptr<i32> = malloc((n as i64) * 4 + 4) as ptr<i32>
    let mut k: i32 = 0
    while k < n {
        order[k] = k
        k = k + 1
    }
    let mut a: i32 = 1
    while a < n {
        let cur: i32 = order[a]
        let mut j: i32 = a - 1
        while j >= 0 and version_less_key(ft_list_get(ids, order[j]), ft_list_get(ids, cur)) < 0 {
            order[j + 1] = order[j]
            j = j - 1
        }
        order[j + 1] = cur
        a = a + 1
    }
    k = 0
    while k < n {
        ft_list_push(v[0].ids, ft_list_get(ids, order[k]))
        ft_list_push(v[0].labels, ft_list_get(labels, order[k]))
        ft_list_push(v[0].dates, ft_list_get(dates, order[k]))
        k = k + 1
    }
    v[0].n = n
    return v
}

function write_versions_json(v: ptr<Versions>) -> void {
    let b: ptr<WBuf> = wb_new()
    if v[0].n < 0 {
        wb_add(b, "{\n  \"current\": \"0.7.0\",\n  \"versions\": [\n    {\n      \"id\": \"0.7.0\",\n      \"label\": \"v0.7.0\",\n      \"date\": \"\",\n      \"latest\": true,\n      \"archived\": true\n    }\n  ]\n}\n")
        let _w0: bool = wb_write(OUT + "/versions.json", b)
        return
    }
    let mut current: string = "0.7.0"
    if v[0].n > 0 {
        current = ft_list_get(v[0].ids, 0)
    }
    wb_add(b, "{\n  \"current\": " + json_quote(current) + ",\n  \"versions\": ")
    if v[0].n == 0 {
        wb_add(b, "[]")
    } else {
        wb_add(b, "[\n")
        let mut i: i32 = 0
        while i < v[0].n {
            if i > 0 {
                wb_add(b, ",\n")
            }
            let mut flag: string = "false"
            if i == 0 {
                flag = "true"
            }
            wb_add(b, "    {\n      \"id\": " + json_quote(ft_list_get(v[0].ids, i)) + ",\n      \"label\": " + json_quote(ft_list_get(v[0].labels, i)) + ",\n      \"date\": " + json_quote(ft_list_get(v[0].dates, i)) + ",\n      \"latest\": " + flag + ",\n      \"archived\": " + flag + "\n    }")
            i = i + 1
        }
        wb_add(b, "\n  ]")
    }
    wb_add(b, "\n}\n")
    let _w: bool = wb_write(OUT + "/versions.json", b)
}

function write_releases_index(v: ptr<Versions>) -> void {
    let dash: string = wu_dash()
    let b: ptr<WBuf> = wb_new()
    wb_line(b, "# Release History")
    wb_line(b, "")
    wb_line(b, "> **Source of truth:** [`project/CHANGELOG.md`](project/CHANGELOG.md) " + dash + " copied from `docs/project/CHANGELOG.md` on every wiki build. This page is generated by `./flow tool build_wiki`; do not edit it by hand.")
    wb_line(b, "")
    wb_line(b, "> Pick a version from the header dropdown, or jump to release notes below.")
    wb_line(b, "")
    wb_line(b, "| Version | Date | Status | Notes |")
    wb_line(b, "|---------|------|--------|-------|")
    let mut n: i32 = v[0].n
    let fallback: bool = n < 0
    if fallback {
        n = 1
    }
    let mut i: i32 = 0
    while i < n {
        let mut id: string = "0.7.0"
        let mut label: string = "v0.7.0"
        let mut date: string = ""
        if fallback == false {
            id = ft_list_get(v[0].ids, i)
            label = ft_list_get(v[0].labels, i)
            date = ft_list_get(v[0].dates, i)
        }
        let mut status: string = "snapshot TBD"
        if i == 0 {
            status = "**latest**"
        }
        let slug: string = ft_replace(uc_lower_str(id), ".", "-")
        if ft_len(date) == 0 {
            date = dash
        }
        wb_line(b, "| [" + label + "](project/CHANGELOG.md#v-" + slug + ") | " + date + " | " + status + " | [Full notes](project/CHANGELOG.md#v-" + slug + ") |")
        i = i + 1
    }
    wb_line(b, "")
    wb_line(b, "---")
    wb_line(b, "")
    wb_line(b, "## Release workflow")
    wb_line(b, "")
    wb_line(b, "1. Edit `docs/project/CHANGELOG.md` (add a `## [X.Y.Z] - YYYY-MM-DD` section).")
    wb_line(b, "2. Run `./flow tool build_wiki` " + dash + " copies the changelog and regenerates `versions.json` + this index.")
    wb_line(b, "3. Deploy with `./flow tool deploy_wiki` when ready to publish.")
    wb_line(b, "")
    wb_line(b, "See the [full changelog](project/CHANGELOG.md) for detailed release notes, security audits, and migration guides.")
    wb_line(b, "")
    wb_line(b, "Documentation archives per version are planned " + dash + " see [Wiki Roadmap](wiki-roadmap.md) Phase 4.")
    let _w: bool = wb_write(OUT + "/releases.md", b)
}

# ---------------------------------------------------------------------------
# Example status
# ---------------------------------------------------------------------------

function write_example_status() -> void {
    let path: string = "docs/generated/example-status.json"
    if ft_exists(path) == false {
        return
    }
    let j: ptr<Json> = json_parse(wu_read_text(path))
    if ft_len(json_error(j)) > 0 {
        return
    }
    let blocks: i32 = json_get(j, 0, "blocks")
    if blocks < 0 {
        return
    }
    let total: i32 = json_len(j, blocks)
    if total == 0 {
        return
    }
    let statuses: ptr<StrMap> = ft_map_new()
    let pages: ptr<StrList> = ft_list_new()
    let page_index: ptr<StrMap> = ft_map_new()
    let page_counts: ptr<StrMap> = ft_map_new()
    let mut blk: i32 = json_first(j, blocks)
    while blk >= 0 {
        let status: string = json_str(j, json_get(j, blk, "status"))
        let page: string = json_str(j, json_get(j, blk, "path"))
        ft_map_put(statuses, status, ft_map_get(statuses, status, 0) + 1)
        if ft_map_get(page_index, page, -1) < 0 {
            ft_map_put(page_index, page, ft_list_len(pages))
            ft_list_push(pages, page)
        }
        let key: string = page + "\n" + status
        ft_map_put(page_counts, key, ft_map_get(page_counts, key, 0) + 1)
        ft_map_put(page_counts, page + "\n", ft_map_get(page_counts, page + "\n", 0) + 1)
        blk = json_next(j, blk)
    }
    let verified: i32 = ft_map_get(statuses, "verified", 0)
    let expected: i32 = ft_map_get(statuses, "expected-error", 0)
    let b: ptr<WBuf> = wb_new()
    wb_line(b, "# Example status")
    wb_line(b, "")
    wb_line(b, "> Generated by `./flow tool build_wiki` from `docs/generated/example-status.json`, which `./flow tool doc_examples` writes. Do not edit by hand.")
    wb_line(b, "")
    wb_line(b, "Every ```` ```flow ```` block in the documentation is compiled in CI: parsed, type-checked in strict mode, lowered to C and run through clang. **" + ft_itoa(verified + expected) + " of " + ft_itoa(total) + "** are proven, either by compiling or by failing exactly as the page says they should. Each block carries its own result in the header above the code.")
    wb_line(b, "")
    wb_line(b, "| Result | Blocks | Meaning |")
    wb_line(b, "|---|---:|---|")
    wb_line(b, "| Compiles | " + ft_itoa(verified) + " | Builds from source to object code. |")
    wb_line(b, "| Rejected on purpose | " + ft_itoa(expected) + " | Tagged `expect-error`; the page is about what the compiler refuses. |")
    wb_line(b, "| Not compiled | " + ft_itoa(ft_map_get(statuses, "ignored", 0)) + " | Tagged `ignore=` with a written reason: notation, proposed syntax, or something outside the build. |")
    wb_line(b, "| Not compiling yet | " + ft_itoa(ft_map_get(statuses, "unverified", 0)) + " | Known debt. Recorded so it cannot grow. |")
    wb_line(b, "")
    wb_line(b, "## How it is enforced")
    wb_line(b, "")
    wb_line(b, "The ledger records the blocks that do not build today, keyed by a hash of each block's own text. Editing a block changes its key, so its exemption disappears and the new text has to compile. Existing debt is inherited; new and edited content is not. The `doc-examples` job fails on any block that does not build and is not in the ledger.")
    wb_line(b, "")
    # Pages with unverified blocks, most first; ties keep first-seen order.
    let np: i32 = ft_list_len(pages)
    let order: ptr<i32> = malloc((np as i64) * 4 + 4) as ptr<i32>
    let mut no: i32 = 0
    let mut pi: i32 = 0
    while pi < np {
        if ft_map_get(page_counts, ft_list_get(pages, pi) + "\nunverified", 0) > 0 {
            order[no] = pi
            no = no + 1
        }
        pi = pi + 1
    }
    let mut a: i32 = 1
    while a < no {
        let cur: i32 = order[a]
        let cu: i32 = ft_map_get(page_counts, ft_list_get(pages, cur) + "\nunverified", 0)
        let mut q: i32 = a - 1
        while q >= 0 and ft_map_get(page_counts, ft_list_get(pages, order[q]) + "\nunverified", 0) < cu {
            order[q + 1] = order[q]
            q = q - 1
        }
        order[q + 1] = cur
        a = a + 1
    }
    if no > 0 {
        wb_line(b, "## Pages with blocks that do not compile yet")
        wb_line(b, "")
        wb_line(b, "| Page | Not compiling | Total |")
        wb_line(b, "|---|---:|---:|")
        let mut r: i32 = 0
        while r < no {
            let pg: string = ft_list_get(pages, order[r])
            wb_line(b, "| `" + pg + "` | " + ft_itoa(ft_map_get(page_counts, pg + "\nunverified", 0)) + " | " + ft_itoa(ft_map_get(page_counts, pg + "\n", 0)) + " |")
            r = r + 1
        }
        wb_line(b, "")
    } else {
        wb_line(b, "## Outstanding")
        wb_line(b, "")
        wb_line(b, "Nothing. Every block is accounted for.")
        wb_line(b, "")
    }
    let _m: bool = pr_mkdir_p(OUT + "/project")
    let _w: bool = wb_write(OUT + "/project/example-status.md", b)
}

# ---------------------------------------------------------------------------
# Nav
# ---------------------------------------------------------------------------

function proofs_nav(ex: ptr<Rows>, g: ptr<Groups>, level: i32) -> string {
    let nav: ptr<WBuf> = wb_new()
    let mut items: i32 = 0
    let mut gi: i32 = 0
    while gi < g[0].n {
        let group: string = ft_list_get(g[0].keys, gi)
        if ft_starts(group, "euclid/") == false {
            if items > 0 {
                wb_add(nav, ",\n")
            }
            wu_pad(nav, level + 1)
            wb_add(nav, "{\n")
            wu_pad(nav, level + 2)
            wb_add(nav, "\"label\": " + json_quote(proof_group_label(group, group_count(g, gi))) + ",\n")
            wu_pad(nav, level + 2)
            wb_add(nav, "\"path\": \"third-party/flow-verify-catalog.md\"\n")
            wu_pad(nav, level + 1)
            wb_add(nav, "}")
            items = items + 1
        }
        gi = gi + 1
    }
    if items == 0 {
        return "[]"
    }
    let whole: ptr<WBuf> = wb_new()
    wb_add(whole, "[\n")
    wb_add(whole, wb_str(nav))
    wb_add(whole, "\n")
    wu_pad(whole, level)
    wb_add(whole, "]")
    return wb_str(whole)
}

# Returns false (after printing the error) when docs/nav.json disagrees
# with docs/.
function write_nav(manifest: ptr<Json>, euclid_items: string, proof_items: string) -> bool {
    let problems: ptr<StrList> = wn_validate(manifest, "docs", ".")
    let np: i32 = ft_list_len(problems)
    if np > 0 {
        let mut msg: string = "docs/nav.json does not match docs/:\n  "
        let mut i: i32 = 0
        while i < np and i < 20 {
            if i > 0 {
                msg = msg + "\n  "
            }
            msg = msg + ft_list_get(problems, i)
            i = i + 1
        }
        if np > 20 {
            msg = msg + "\n  ... and " + ft_itoa(np - 20) + " more"
        }
        ft_errln(msg)
        return false
    }
    let b: ptr<WBuf> = wb_new()
    wb_add(b, "{\n  \"default\": ")
    wu_dump(b, manifest, json_get(manifest, 0, "default"), 1)
    wb_add(b, ",\n  \"tabs\": ")
    wu_dump(b, manifest, json_get(manifest, 0, "tabs"), 1)
    wb_add(b, ",\n  \"sections\": ")
    wn_dump_sections(b, manifest, 1, euclid_items, proof_items)
    wb_add(b, "\n}\n")
    let _w: bool = wb_write(OUT + "/wiki-nav.json", b)
    return true
}

function page_category(manifest: ptr<Json>, wiki_path: string) -> string {
    let p: string = ft_replace(wiki_path, "\\", "/")
    if ft_contains(p, "flow-verify") or ft_ends(p, ".proof.md") {
        return "proof"
    }
    return wn_category_for(manifest, p)
}

# ---------------------------------------------------------------------------
# Search index
# ---------------------------------------------------------------------------

struct Tree {
    names: ptr<string>
    paths: ptr<string>
    first: ptr<i32>
    last: ptr<i32>
    next: ptr<i32>
    isdir: ptr<i32>
    count: i32
}

function tree_build(entries: ptr<StrList>, dirs: ptr<StrSet>) -> ptr<Tree> {
    let n: i32 = ft_list_len(entries)
    let t: ptr<Tree> = malloc(64) as ptr<Tree>
    t[0].names = malloc((n as i64) * 8 + 8) as ptr<string>
    t[0].paths = malloc((n as i64) * 8 + 8) as ptr<string>
    t[0].first = malloc((n as i64) * 4 + 4) as ptr<i32>
    t[0].last = malloc((n as i64) * 4 + 4) as ptr<i32>
    t[0].next = malloc((n as i64) * 4 + 4) as ptr<i32>
    t[0].isdir = malloc((n as i64) * 4 + 4) as ptr<i32>
    t[0].count = n
    let names: ptr<string> = t[0].names
    let paths: ptr<string> = t[0].paths
    let first: ptr<i32> = t[0].first
    let last: ptr<i32> = t[0].last
    let next: ptr<i32> = t[0].next
    let isdir: ptr<i32> = t[0].isdir
    let index: ptr<StrMap> = ft_map_new()
    let mut i: i32 = 0
    while i < n {
        let path: string = ft_list_get(entries, i)
        paths[i] = path
        names[i] = ft_basename(path)
        first[i] = -1
        last[i] = -1
        next[i] = -1
        isdir[i] = 0
        if ft_set_has(dirs, path) {
            isdir[i] = 1
        }
        ft_map_put(index, path, i)
        if i > 0 {
            let parent: i32 = ft_map_get(index, ft_dirname(path), -1)
            if parent >= 0 {
                if first[parent] < 0 {
                    first[parent] = i
                } else {
                    next[last[parent]] = i
                }
                last[parent] = i
            }
        }
        i = i + 1
    }
    return t
}

# Entry indexes of the *.md pages, in Path.rglob("*.md") order (Python 3.12):
# the root, then each directory Path.walk visits (pre-order) yields its
# subdirectories in scandir order; every starting point then contributes
# its matching entries in scandir order.
function rglob_md(t: ptr<Tree>) -> ptr<i32> {
    let n: i32 = t[0].count
    let first: ptr<i32> = t[0].first
    let next: ptr<i32> = t[0].next
    let isdir: ptr<i32> = t[0].isdir
    let names: ptr<string> = t[0].names
    let starts: ptr<i32> = malloc((n as i64) * 4 + 4) as ptr<i32>
    let mut nstarts: i32 = 0
    starts[nstarts] = 0
    nstarts = nstarts + 1
    let stack: ptr<i32> = malloc((n as i64) * 4 + 4) as ptr<i32>
    let mut sp: i32 = 0
    stack[sp] = 0
    sp = sp + 1
    let tmp: ptr<i32> = malloc((n as i64) * 4 + 4) as ptr<i32>
    while sp > 0 {
        sp = sp - 1
        let d: i32 = stack[sp]
        let mut nd: i32 = 0
        let mut c: i32 = first[d]
        while c >= 0 {
            if isdir[c] == 1 {
                starts[nstarts] = c
                nstarts = nstarts + 1
                tmp[nd] = c
                nd = nd + 1
            }
            c = next[c]
        }
        while nd > 0 {
            nd = nd - 1
            stack[sp] = tmp[nd]
            sp = sp + 1
        }
    }
    let out: ptr<i32> = malloc((n as i64) * 4 + 8) as ptr<i32>
    let mut o: i32 = 0
    let mut s: i32 = 0
    while s < nstarts {
        let mut c2: i32 = first[starts[s]]
        while c2 >= 0 {
            if ft_ends(names[c2], ".md") {
                out[o + 1] = c2
                o = o + 1
            }
            c2 = next[c2]
        }
        s = s + 1
    }
    out[0] = o
    return out
}

# Path.suffix == ".md"
function has_md_suffix(name: string) -> bool {
    let dot: i32 = ft_rfind_byte(name, 46)
    if dot <= 0 or dot == ft_len(name) - 1 {
        return false
    }
    return ft_eq(ft_from(name, dot), ".md")
}

# re.sub(r"[#*`\[\]()]", " ", text)
function blank_marks(text: string) -> string {
    let n: i32 = ft_len(text)
    let p: ptr<u8> = text as ptr<u8>
    let out: ptr<u8> = malloc((n + 1) as i64) as ptr<u8>
    let mut i: i32 = 0
    while i < n {
        let c: i32 = p[i] as i32
        if c == 35 or c == 42 or c == 96 or c == 91 or c == 93 or c == 40 or c == 41 {
            out[i] = 32
        } else {
            out[i] = c as u8
        }
        i = i + 1
    }
    out[n] = 0
    return out as string
}

function search_entry(b: ptr<WBuf>, count: i32, path: string, title: string, text: string, category: string) -> void {
    if count > 0 {
        wb_add(b, ",\n")
    }
    wb_add(b, "  {\n    \"path\": ")
    wb_add(b, json_quote(path))
    wb_add(b, ",\n    \"title\": ")
    wb_add(b, json_quote(title))
    wb_add(b, ",\n    \"text\": ")
    wb_add(b, json_quote(text))
    wb_add(b, ",\n    \"category\": ")
    wb_add(b, json_quote(category))
    wb_add(b, "\n  }")
}

function build_search_index(manifest: ptr<Json>, lib: ptr<Rows>, ex: ptr<Rows>) -> void {
    let entries: ptr<StrList> = wu_lines_of("find " + OUT)
    let dir_list: ptr<StrList> = wu_lines_of("find " + OUT + " -type d")
    let dirs: ptr<StrSet> = ft_set_new()
    let mut i: i32 = 0
    while i < ft_list_len(dir_list) {
        ft_set_add(dirs, ft_list_get(dir_list, i))
        i = i + 1
    }
    let t: ptr<Tree> = tree_build(entries, dirs)
    let pages: ptr<i32> = rglob_md(t)
    let paths: ptr<string> = t[0].paths
    let names: ptr<string> = t[0].names
    let b: ptr<WBuf> = wb_new()
    let mut count: i32 = 0
    let root_abs: string = pr_cwd() + "/" + OUT
    let mut k: i32 = 0
    while k < pages[0] {
        let idx: i32 = pages[k + 1]
        let full: string = paths[idx]
        let wiki_path: string = ft_from(full, ft_len(OUT) + 1)
        let abs_path: string = root_abs + "/" + wiki_path
        if ft_contains(abs_path, "flow-verify/proofs") == false and has_md_suffix(names[idx]) {
            let text: string = wu_read_text(full)
            let mut title: string = proof_title(text)
            if ft_len(title) == 0 {
                let lines: ptr<StrList> = wu_splitlines(text)
                let mut li: i32 = 0
                while li < ft_list_len(lines) {
                    let ln: string = ft_list_get(lines, li)
                    if ft_starts(ln, "# ") {
                        title = uc_strip(ft_from(ln, 2))
                        break
                    }
                    li = li + 1
                }
            }
            if ft_len(title) == 0 {
                title = wu_stem(wiki_path)
            }
            let body: string = wu_cp_prefix(md_collapse_ws(blank_marks(text)), 6000)
            search_entry(b, count, wiki_path, title, body, page_category(manifest, wiki_path))
            count = count + 1
        }
        k = k + 1
    }
    # No markdown file can be named tutorials/index.html, so the entry is
    # added whenever the page exists.
    if ft_exists(OUT + "/tutorials/index.html") {
        search_entry(b, count, "tutorials/index.html", "Interactive Tutorials", "Interactive browser tutorials concurrency memory arrays strings structs pointers functions control errors algorithms audio autodiff effects systems projects", "tutorial")
        count = count + 1
    }
    let mut pass: i32 = 0
    while pass < 2 {
        let mut rows: ptr<Rows> = lib
        if pass == 1 {
            rows = ex
        }
        let mut r: i32 = 0
        while r < rows_len(rows) {
            let wp: string = ft_list_get(rows[0].wiki, r)
            let ppath: string = OUT + "/" + wp
            if ft_exists(ppath) {
                let ptext: string = wu_read_text(ppath)
                let joined: string = ft_list_get(rows[0].summary, r) + " " + wu_cp_prefix(ptext, 1500)
                search_entry(b, count, wp, ft_list_get(rows[0].title, r), uc_strip(joined), "proof")
                count = count + 1
            }
            r = r + 1
        }
        pass = pass + 1
    }
    let whole: ptr<WBuf> = wb_new()
    if count == 0 {
        wb_add(whole, "[]")
    } else {
        wb_add(whole, "[\n")
        wb_add(whole, wb_str(b))
        wb_add(whole, "\n]")
    }
    let _w: bool = wb_write(OUT + "/search-index.json", whole)
}

# ---------------------------------------------------------------------------
# Site shell
# ---------------------------------------------------------------------------

function copy_site_shell(b: ptr<WBuf>) -> void {
    let names: ptr<StrList> = ft_list_new()
    ft_list_push(names, "index.html")
    ft_list_push(names, "wiki.css")
    ft_list_push(names, "wiki.js")
    ft_list_push(names, "grammar-viewer.js")
    ft_list_push(names, "flow-compile.js")
    ft_list_push(names, "flow-lang.js")
    ft_list_push(names, "flow-editor.js")
    ft_list_push(names, "tutorial-runner.js")
    ft_list_push(names, "tutorial-runner.css")
    ft_list_push(names, "proof-graph.html")
    let mut i: i32 = 0
    while i < ft_list_len(names) {
        let name: string = ft_list_get(names, i)
        if ft_exists("site/" + name) {
            add_copy_file(b, "site/" + name, OUT + "/" + name)
        }
        i = i + 1
    }
    if ft_exists("site/vendor") {
        add_copy_tree(b, "site/vendor", OUT + "/vendor")
    }
    if ft_exists("site/wasm") {
        add_copy_tree(b, "site/wasm", OUT + "/wasm")
    }
    if ft_exists("site/tutorials") {
        add_mkdir(b, OUT + "/tutorials")
        let items: ptr<StrList> = wu_lines_of("find site/tutorials -mindepth 1 -maxdepth 1 2>/dev/null")
        let mut k: i32 = 0
        while k < ft_list_len(items) {
            let item: string = ft_list_get(items, k)
            if pr_is_file(item) {
                add_copy_file(b, item, OUT + "/tutorials/" + ft_basename(item))
            }
            k = k + 1
        }
    }
}

# ---------------------------------------------------------------------------
# Tutorial exercises
# ---------------------------------------------------------------------------

function track_rank(track: string) -> i32 {
    let order: string = " beginner control functions pipelines structs arrays spans strings pointers memory errors intermediate concurrency algorithms systems effects-basics autodiff-basics ml-on-macbook audio-basics rt-audio advanced wasm evolution dynamics gfx-basics shaders game-ai domains projects "
    let at: i32 = ft_find(order, " " + track + " ", 0)
    if at < 0 {
        return 50
    }
    let p: ptr<u8> = order as ptr<u8>
    let mut rank: i32 = 0
    let mut i: i32 = 1
    while i <= at {
        if p[i] == 32 {
            rank = rank + 1
        }
        i = i + 1
    }
    return rank
}

# Returns false after printing when a tutorial has an invalid info string.
function build_tutorial_exercises(today: string) -> bool {
    let found: ptr<StrList> = wu_lines_of("find docs/tutorials -mindepth 1 -maxdepth 1 -name '*.md' 2>/dev/null")
    let rels: ptr<StrList> = ft_list_new()
    let mut i: i32 = 0
    while i < ft_list_len(found) {
        let rel: string = ft_list_get(found, i)
        if ft_eq(ft_basename(rel), "README.md") == false {
            ft_list_push(rels, rel)
        }
        i = i + 1
    }
    wu_sort(rels, false)
    let bl: ptr<WkBlocks> = wk_new()
    let mut f: i32 = 0
    while f < ft_list_len(rels) {
        let rel2: string = ft_list_get(rels, f)
        if wk_collect_file(bl, rel2, wu_read_text(rel2), "flow") == false {
            ft_errln(wk_error(bl))
            return false
        }
        f = f + 1
    }
    let n: i32 = wk_count(bl)
    let tracks: ptr<StrList> = ft_list_new()
    let nums: ptr<i32> = malloc((n as i64) * 4 + 4) as ptr<i32>
    let counts: ptr<StrMap> = ft_map_new()
    let mut k: i32 = 0
    while k < n {
        let track: string = wu_stem(wk_path(bl, k))
        let num: i32 = ft_map_get(counts, track, 0) + 1
        ft_map_put(counts, track, num)
        ft_list_push(tracks, track)
        nums[k] = num
        k = k + 1
    }
    let order: ptr<i32> = malloc((n as i64) * 4 + 4) as ptr<i32>
    let ranks: ptr<i32> = malloc((n as i64) * 4 + 4) as ptr<i32>
    k = 0
    while k < n {
        order[k] = k
        ranks[k] = track_rank(ft_list_get(tracks, k))
        k = k + 1
    }
    let mut a: i32 = 1
    while a < n {
        let cur: i32 = order[a]
        let mut q: i32 = a - 1
        while q >= 0 and (ranks[order[q]] > ranks[cur] or (ranks[order[q]] == ranks[cur] and nums[order[q]] > nums[cur])) {
            order[q + 1] = order[q]
            q = q - 1
        }
        order[q + 1] = cur
        a = a + 1
    }
    let dash: string = wu_dash()
    let b: ptr<WBuf> = wb_new()
    wb_add(b, "{\n  \"generated\": " + json_quote(today) + ",\n  \"lessons\": ")
    if n == 0 {
        wb_add(b, "[]")
    } else {
        wb_add(b, "[\n")
        let mut r: i32 = 0
        while r < n {
            let x: i32 = order[r]
            let track2: string = ft_list_get(tracks, x)
            let mut section: string = wk_section(bl, x)
            if section as ptr<u8> == null or ft_len(section) == 0 {
                section = wu_title(track2)
            }
            let mut title: string = wk_title(bl, x)
            if title as ptr<u8> == null or ft_len(title) == 0 {
                title = "Exercise"
            }
            if r > 0 {
                wb_add(b, ",\n")
            }
            wb_add(b, "    {\n      \"id\": " + json_quote(track2 + "-" + ft_itoa(nums[x])))
            wb_add(b, ",\n      \"track\": " + json_quote(track2))
            wb_add(b, ",\n      \"title\": " + json_quote(title))
            wb_add(b, ",\n      \"section\": " + json_quote(section))
            wb_add(b, ",\n      \"description\": " + json_quote(section + " " + dash + " edit and run in the browser."))
            wb_add(b, ",\n      \"code\": ")
            wb_add(b, json_quote(wk_code(bl, x)))
            wb_add(b, "\n    }")
            r = r + 1
        }
        wb_add(b, "\n  ]")
    }
    wb_add(b, "\n}\n")
    let _m: bool = pr_mkdir_p(OUT + "/tutorials")
    let _w: bool = wb_write(OUT + "/tutorials/exercises.json", b)
    return true
}

# ---------------------------------------------------------------------------
# llms.txt
# ---------------------------------------------------------------------------

function jtext(j: ptr<Json>, id: i32) -> string {
    if id < 0 {
        return "None"
    }
    if json_kind(j, id) == 4 {
        return json_str(j, id)
    }
    return "?"
}

function write_llms_txt(manifest: ptr<Json>) -> void {
    let b: ptr<WBuf> = wb_new()
    wb_line(b, "# Flow Programming Language Documentation")
    wb_line(b, "")
    wb_line(b, "> https://abhishek-shivakumar.com/transpile/")
    wb_line(b, "")
    let tabs: i32 = json_get(manifest, 0, "tabs")
    let mut current_tab: string = null as string
    let sections: i32 = json_get(manifest, 0, "sections")
    let mut s: i32 = json_first(manifest, sections)
    while s >= 0 {
        let items: i32 = json_get(manifest, s, "items")
        if wu_truthy(manifest, items) {
            let tab: string = jtext(manifest, json_get(manifest, s, "tab"))
            if current_tab as ptr<u8> == null or ft_eq(tab, current_tab) == false {
                current_tab = tab
                let mut label: string = tab
                let mut t: i32 = json_first(manifest, tabs)
                while t >= 0 {
                    if ft_eq(jtext(manifest, json_get(manifest, t, "id")), tab) {
                        label = jtext(manifest, json_get(manifest, t, "label"))
                    }
                    t = json_next(manifest, t)
                }
                wb_line(b, "## " + label)
                wb_line(b, "")
            }
            wb_line(b, "### " + jtext(manifest, json_get(manifest, s, "title")))
            let mut it: i32 = json_first(manifest, items)
            while it >= 0 {
                let pid: i32 = json_get(manifest, it, "path")
                if wu_truthy(manifest, pid) {
                    wb_line(b, "- [" + jtext(manifest, json_get(manifest, it, "label")) + "](" + jtext(manifest, pid) + ")")
                }
                it = json_next(manifest, it)
            }
            wb_line(b, "")
        }
        s = json_next(manifest, s)
    }
    wb_line(b, "Append `.md` to any doc path for raw markdown, e.g. `getting-started.md`.")
    let _w: bool = wb_write(OUT + "/llms.txt", b)
}

# ---------------------------------------------------------------------------
# Proof graph
# ---------------------------------------------------------------------------

struct Graph {
    ids: ptr<StrList>
    labels: ptr<StrList>
    groups: ptr<StrList>
    paths: ptr<StrList>
    index: ptr<StrMap>
    efrom: ptr<StrList>
    eto: ptr<StrList>
    eseen: ptr<StrSet>
}

function graph_new() -> ptr<Graph> {
    let g: ptr<Graph> = malloc(64) as ptr<Graph>
    g[0].ids = ft_list_new()
    g[0].labels = ft_list_new()
    g[0].groups = ft_list_new()
    g[0].paths = ft_list_new()
    g[0].index = ft_map_new()
    g[0].efrom = ft_list_new()
    g[0].eto = ft_list_new()
    g[0].eseen = ft_set_new()
    return g
}

function ensure_node(g: ptr<Graph>, id: string, label: string, group: string, path: string) -> void {
    let at: i32 = ft_map_get(g[0].index, id, -1)
    if at < 0 {
        ft_map_put(g[0].index, id, ft_list_len(g[0].ids))
        ft_list_push(g[0].ids, id)
        ft_list_push(g[0].labels, label)
        ft_list_push(g[0].groups, group)
        ft_list_push(g[0].paths, path)
        return
    }
    let plist: ptr<StrList> = g[0].paths
    let paths: ptr<string> = plist[0].items
    if path as ptr<u8> != null and paths[at] as ptr<u8> == null {
        paths[at] = path
    }
}

function proof_doc_path(prefix: string, rel: string) -> string {
    let proof_rel: string = ft_slice(rel, 0, ft_len(rel) - 5) + ".proof.md"
    let mut src_root: string = "lib/verify"
    if ft_eq(prefix, "lib") == false {
        src_root = "examples/verify"
    }
    if ft_exists(src_root + "/" + proof_rel) == false {
        return null as string
    }
    return "third-party/flow-verify/proofs/" + prefix + "/" + proof_rel
}

# Tokens of ^\s*import\s+(\S+) under re.MULTILINE.
function import_tokens(text: string) -> ptr<StrList> {
    let out: ptr<StrList> = ft_list_new()
    let p: ptr<u8> = text as ptr<u8>
    let n: i32 = ft_len(text)
    let mut pos: i32 = 0
    while pos < n {
        if pos == 0 or p[pos - 1] == 10 {
            let mut q: i32 = pos
            while p[q] != 0 and uc_is_space(uc_decode(p, q)) {
                q = q + uc_len(p[q] as i32)
            }
            if ft_at(text, q, "import") {
                let a: i32 = q + 6
                let mut w: i32 = a
                while p[w] != 0 and uc_is_space(uc_decode(p, w)) {
                    w = w + uc_len(p[w] as i32)
                }
                if w > a and p[w] != 0 {
                    let mut e: i32 = w
                    while p[e] != 0 and uc_is_space(uc_decode(p, e)) == false {
                        e = e + uc_len(p[e] as i32)
                    }
                    ft_list_push(out, ft_slice(text, w, e))
                    pos = e
                    continue
                }
            }
        }
        pos = pos + 1
    }
    return out
}

# Last component of a path, as Path(raw).name.
function path_name(raw: string) -> string {
    let mut e: i32 = ft_len(raw)
    let p: ptr<u8> = raw as ptr<u8>
    while e > 0 and p[e - 1] == 47 {
        e = e - 1
    }
    let trimmed: string = ft_slice(raw, 0, e)
    let name: string = ft_basename(trimmed)
    if ft_eq(name, ".") {
        return ""
    }
    return name
}

function name_stem(name: string) -> string {
    let dot: i32 = ft_rfind_byte(name, 46)
    if dot <= 0 or dot == ft_len(name) - 1 {
        return name
    }
    return ft_slice(name, 0, dot)
}

function add_edge(g: ptr<Graph>, src_id: string, dst_id: string) -> void {
    let key: string = src_id + "\n" + dst_id
    if ft_eq(src_id, dst_id) == false and ft_set_has(g[0].eseen, key) == false {
        ft_set_add(g[0].eseen, key)
        ft_list_push(g[0].efrom, src_id)
        ft_list_push(g[0].eto, dst_id)
    }
}

function graph_file(g: ptr<Graph>, root: string, id_prefix: string, group: string, include_all: bool) -> void {
    if ft_exists(root) == false {
        return
    }
    let found: ptr<StrList> = wu_lines_of("find " + pr_quote(root) + " -name '*.flow' 2>/dev/null")
    wu_sort(found, true)
    let mut i: i32 = 0
    while i < ft_list_len(found) {
        let full: string = ft_list_get(found, i)
        let rel: string = ft_from(full, ft_len(root) + 1)
        let tokens: ptr<StrList> = import_tokens(wu_read_text(full))
        if include_all or ft_list_len(tokens) > 0 {
            let node_id: string = id_prefix + "." + ft_replace(ft_slice(rel, 0, ft_len(rel) - 5), "/", ".")
            ensure_node(g, node_id, wu_stem(rel), group, proof_doc_path(group, rel))
            let dot: i32 = ft_rfind_byte(node_id, 46)
            let home: string = ft_slice(node_id, 0, dot)
            let mut k: i32 = 0
            while k < ft_list_len(tokens) {
                let token: string = uc_strip(ft_list_get(tokens, k))
                if ft_len(token) > 0 {
                    if ft_starts(token, "\"") {
                        let raw: string = wu_strip_set(token, "\"")
                        let tid: string = "external." + raw
                        ensure_node(g, tid, name_stem(path_name(raw)), "external", null as string)
                        add_edge(g, node_id, tid)
                    } elif ft_starts(token, ".") {
                        let after: string = ft_from(token, 1)
                        let sl: i32 = ft_find_byte(after, 47, 0)
                        let mut name: string = after
                        if sl >= 0 {
                            name = ft_slice(after, 0, sl)
                        }
                        if ft_len(name) > 0 {
                            let rid: string = home + "." + name
                            let mut rgroup: string = "examples"
                            let mut rprefix: string = "examples"
                            if ft_starts(rid, "verify.") {
                                rgroup = "lib"
                                rprefix = "verify"
                            }
                            let rrel: string = ft_replace(ft_from(rid, ft_len(rprefix) + 1), ".", "/") + ".flow"
                            ensure_node(g, rid, name, rgroup, proof_doc_path(rgroup, rrel))
                            add_edge(g, node_id, rid)
                        }
                    } else {
                        let sl2: i32 = ft_find_byte(token, 47, 0)
                        let mut base: string = token
                        if sl2 >= 0 {
                            base = ft_slice(token, 0, sl2)
                        }
                        let bdot: i32 = ft_rfind_byte(base, 46)
                        let blabel: string = ft_from(base, bdot + 1)
                        if ft_starts(base, "verify.") {
                            let brel: string = ft_replace(ft_from(base, 7), ".", "/") + ".flow"
                            ensure_node(g, base, blabel, "lib", proof_doc_path("lib", brel))
                        } else {
                            ensure_node(g, base, blabel, "external", null as string)
                        }
                        add_edge(g, node_id, base)
                    }
                }
                k = k + 1
            }
        }
        i = i + 1
    }
}

function pair_cmp(a1: string, a2: string, b1: string, b2: string) -> i32 {
    let c: i32 = ft_cmp_bytes(a1, b1)
    if c != 0 {
        return c
    }
    return ft_cmp_bytes(a2, b2)
}

function ft_cmp_bytes(a: string, b: string) -> i32 {
    let pa: ptr<u8> = a as ptr<u8>
    let pb: ptr<u8> = b as ptr<u8>
    let mut i: i32 = 0
    while pa[i] != 0 and pa[i] == pb[i] {
        i = i + 1
    }
    return (pa[i] as i32) - (pb[i] as i32)
}

# Stable insertion sort of indexes by (first, second).
function sort_pairs(firsts: ptr<StrList>, seconds: ptr<StrList>) -> ptr<i32> {
    let n: i32 = ft_list_len(firsts)
    let order: ptr<i32> = malloc((n as i64) * 4 + 4) as ptr<i32>
    let mut i: i32 = 0
    while i < n {
        order[i] = i
        i = i + 1
    }
    # Merge sort to stay fast on a few hundred entries.
    let tmp: ptr<i32> = malloc((n as i64) * 4 + 4) as ptr<i32>
    let mut width: i32 = 1
    while width < n {
        let mut lo: i32 = 0
        while lo < n {
            let mut mid: i32 = lo + width
            if mid > n {
                mid = n
            }
            let mut hi: i32 = lo + 2 * width
            if hi > n {
                hi = n
            }
            let mut ia: i32 = lo
            let mut ib: i32 = mid
            let mut o: i32 = lo
            while o < hi {
                let mut take_a: bool = ia < mid
                if ia < mid and ib < hi {
                    take_a = pair_cmp(ft_list_get(firsts, order[ia]), ft_list_get(seconds, order[ia]), ft_list_get(firsts, order[ib]), ft_list_get(seconds, order[ib])) <= 0
                }
                if take_a {
                    tmp[o] = order[ia]
                    ia = ia + 1
                } else {
                    tmp[o] = order[ib]
                    ib = ib + 1
                }
                o = o + 1
            }
            lo = lo + 2 * width
        }
        let mut c: i32 = 0
        while c < n {
            order[c] = tmp[c]
            c = c + 1
        }
        width = width * 2
    }
    return order
}

# Writes proof-graph.json; counts go to out[0] (nodes) and out[1] (edges).
function write_proof_graph(counts: ptr<i32>) -> void {
    let g: ptr<Graph> = graph_new()
    graph_file(g, "lib/verify", "verify", "lib", true)
    graph_file(g, "examples/verify", "examples", "examples", false)
    let nn: i32 = ft_list_len(g[0].ids)
    let ne: i32 = ft_list_len(g[0].efrom)
    let norder: ptr<i32> = sort_pairs(g[0].groups, g[0].ids)
    let eorder: ptr<i32> = sort_pairs(g[0].efrom, g[0].eto)
    let b: ptr<WBuf> = wb_new()
    wb_add(b, "{\n  \"nodes\": ")
    if nn == 0 {
        wb_add(b, "[]")
    } else {
        wb_add(b, "[\n")
        let mut i: i32 = 0
        while i < nn {
            let x: i32 = norder[i]
            if i > 0 {
                wb_add(b, ",\n")
            }
            wb_add(b, "    {\n      \"id\": " + json_quote(ft_list_get(g[0].ids, x)))
            wb_add(b, ",\n      \"label\": " + json_quote(ft_list_get(g[0].labels, x)))
            wb_add(b, ",\n      \"group\": " + json_quote(ft_list_get(g[0].groups, x)))
            let path: string = ft_list_get(g[0].paths, x)
            if path as ptr<u8> != null {
                wb_add(b, ",\n      \"path\": " + json_quote(path))
            }
            wb_add(b, "\n    }")
            i = i + 1
        }
        wb_add(b, "\n  ]")
    }
    wb_add(b, ",\n  \"edges\": ")
    if ne == 0 {
        wb_add(b, "[]")
    } else {
        wb_add(b, "[\n")
        let mut k: i32 = 0
        while k < ne {
            let y: i32 = eorder[k]
            if k > 0 {
                wb_add(b, ",\n")
            }
            wb_add(b, "    {\n      \"from\": " + json_quote(ft_list_get(g[0].efrom, y)) + ",\n      \"to\": " + json_quote(ft_list_get(g[0].eto, y)) + "\n    }")
            k = k + 1
        }
        wb_add(b, "\n  ]")
    }
    wb_add(b, "\n}\n")
    let _w: bool = wb_write(OUT + "/proof-graph.json", b)
    counts[0] = nn
    counts[1] = ne
}

# ---------------------------------------------------------------------------
# Pagefind
# ---------------------------------------------------------------------------

# Index the built site in `site` with Pagefind, for the search UI. Optional:
# it skips cleanly without node and npx, and a failed or stalled indexer
# leaves the local search-index.json as the fallback.
#
# Pagefind writes one fragment file per indexed page. The flow-verify proof
# corpus is over a thousand pages, which pushed the deployed site past 2900
# files and made the GitHub Pages publish step time out. Proofs stay on the
# site and stay in search-index.json (the fallback search still finds them
# by title); they are simply not full-text indexed (pagefind_stage).
function pagefind_index(site: string) -> i32 {
    let index: string = site + "/search-index.json"
    let src: string = site + "/_pagefind_src"
    let out_pf: string = site + "/pagefind"
    if ft_len(proc_which("node")) == 0 or ft_len(proc_which("npx")) == 0 {
        ft_outln("Pagefind skipped: node/npx not available (⌘K keeps using search-index.json)")
        return 0
    }
    if pr_is_file(index) == false {
        ft_outln("Pagefind skipped: " + index + " missing. Run ./flow tool build_wiki first.")
        return 0
    }
    ft_outln("Building Pagefind index from search-index.json…")
    let staged: i32 = pagefind_stage(index, src)
    if staged != 0 {
        let _c: i32 = pr_run("rm -rf " + pr_quote(src))
        return staged
    }
    # npx can stall on a slow or offline network: stop it after 180 s.
    let c: ptr<ProcCmd> = proc_cmd("npx")
    proc_arg(c, "--yes")
    proc_arg(c, "pagefind")
    proc_arg(c, "--site")
    proc_arg(c, src)
    proc_arg(c, "--output-path")
    proc_arg(c, out_pf)
    proc_stdout(c, PROC_INHERIT)
    proc_stderr(c, PROC_INHERIT)
    proc_timeout_ms(c, 180000)
    let r: ptr<ProcResult> = proc_run(c)
    let _rm: i32 = pr_run("rm -rf " + pr_quote(src))
    if r.timed_out {
        ft_errln("Pagefind timed out after 180s (search falls back to search-index.json)")
        return 0
    }
    if r.exit_code != 0 or ft_len(r.error) > 0 {
        ft_errln("Pagefind indexing failed; ⌘K will fall back to search-index.json")
        let _o: i32 = pr_run("rm -rf " + pr_quote(out_pf))
        return 0
    }
    ft_outln("Pagefind ready → " + out_pf)
    return 0
}

function run_pagefind(root_abs: string) -> void {
    let skip: string = getenv("FLOW_WIKI_SKIP_PAGEFIND")
    if skip as ptr<u8> != null and ft_len(skip) > 0 {
        ft_outln("Pagefind skipped: FLOW_WIKI_SKIP_PAGEFIND set")
        return
    }
    if pagefind_index(root_abs + "/" + OUT) != 0 {
        ft_errln("Pagefind step exited non-zero (search falls back to search-index.json)")
    }
}

# html.escape(s, quote=True)
function html_escape(s: string) -> string {
    let b: ptr<WBuf> = wb_new()
    let p: ptr<u8> = s as ptr<u8>
    let mut start: i32 = 0
    let mut i: i32 = 0
    while p[i] != 0 {
        let c: i32 = p[i] as i32
        let mut rep: string = null as string
        if c == 38 {
            rep = "&amp;"
        } elif c == 60 {
            rep = "&lt;"
        } elif c == 62 {
            rep = "&gt;"
        } elif c == 34 {
            rep = "&quot;"
        } elif c == 39 {
            rep = "&#x27;"
        }
        if rep as ptr<u8> != null {
            wb_add(b, ft_slice(s, start, i))
            wb_add(b, rep)
            start = i + 1
        }
        i = i + 1
    }
    wb_add(b, ft_from(s, start))
    return wb_str(b)
}

function sget(j: ptr<Json>, obj: i32, key: string) -> string {
    let id: i32 = json_get(j, obj, key)
    if wu_truthy(j, id) == false or json_kind(j, id) != 4 {
        return ""
    }
    return json_str(j, id)
}

# The HTML stubs Pagefind indexes, one per search-index.json entry.
function pagefind_stage(index_path: string, src: string) -> i32 {
    let text: string = wu_read_text(index_path)
    if text as ptr<u8> == null {
        ft_errln("build_wiki: cannot read " + index_path)
        return 1
    }
    let j: ptr<Json> = json_parse(text)
    if ft_len(json_error(j)) > 0 {
        ft_errln("build_wiki: " + index_path + ": " + json_error(j))
        return 1
    }
    let _r: i32 = pr_run("rm -rf " + pr_quote(src) + " && mkdir -p " + pr_quote(src))
    let made: ptr<StrSet> = ft_set_new()
    let total: i32 = json_len(j, 0)
    let mut skipped: i32 = 0
    let mut e: i32 = json_first(j, 0)
    while e >= 0 {
        let rel: string = sget(j, e, "path")
        if ft_len(rel) > 0 {
            if ft_starts(rel, "third-party/flow-verify/proofs/") {
                skipped = skipped + 1
            } else {
                let mut title: string = sget(j, e, "title")
                if ft_len(title) == 0 {
                    title = rel
                }
                let mut category: string = sget(j, e, "category")
                if ft_len(category) == 0 {
                    category = "guide"
                }
                let body: string = sget(j, e, "text")
                let out_path: string = src + "/" + rel + ".html"
                let dir: string = ft_dirname(out_path)
                if ft_set_has(made, dir) == false {
                    let _mk: bool = pr_mkdir_p(dir)
                    ft_set_add(made, dir)
                }
                let t: string = html_escape(title)
                let c: string = html_escape(category)
                let page: ptr<WBuf> = wb_new()
                wb_add(page, "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>" + t + "</title>\n</head>\n<body>\n<h1>" + t + "</h1>\n<p data-pagefind-meta=\"category:" + c + "\" data-pagefind-filter=\"category:" + c + "\">" + c + "</p>\n<main>")
                wb_add(page, html_escape(body))
                wb_add(page, "</main>\n</body>\n</html>\n")
                let _w: bool = wb_write(out_path, page)
            }
        }
        e = json_next(j, e)
    }
    ft_outln("  staged " + ft_itoa(total - skipped) + " HTML stubs (" + ft_itoa(skipped) + " proof pages left to the fallback index) " + wu_arrow() + " " + src)
    return 0
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

function main(argc: i32, argv: ptr<string>) -> i32 {
    if argc == 4 and ft_eq(argv[1], "--pagefind-stage") {
        return pagefind_stage(argv[2], argv[3])
    }
    if rp_enter_root() == false {
        ft_errln("build_wiki: cannot enter the repository root")
        return 1
    }
    if argc == 2 and ft_eq(argv[1], "--pagefind") {
        let site: string = getenv("FLOW_WIKI_OUT")
        if site as ptr<u8> != null and ft_len(site) > 0 {
            return pagefind_index(site)
        }
        return pagefind_index(pr_cwd() + "/" + OUT)
    }
    let root_abs: string = pr_cwd()
    let today: string = wu_today()
    let _clean: i32 = pr_run("rm -rf " + OUT + " && mkdir -p " + OUT)

    let _gen: i32 = wsd_generate(root_abs)

    let copies: ptr<WBuf> = wb_new()
    copy_docs(copies)
    copy_extras(copies)
    batch_run(copies)
    write_roadmap()

    let proofs: ptr<WBuf> = wb_new()
    let pdir: string = OUT + "/third-party/flow-verify/proofs"
    wb_line(proofs, "rm -rf " + pdir)
    add_mkdir(proofs, pdir + "/lib")
    add_mkdir(proofs, pdir + "/examples")
    let made: ptr<StrSet> = ft_set_new()
    let lib: ptr<Rows> = rows_new()
    let ex: ptr<Rows> = rows_new()
    sync_proofs_one(proofs, "lib/verify", pdir + "/lib", "lib", lib, made)
    sync_proofs_one(proofs, "examples/verify", pdir + "/examples", "examples", ex, made)
    batch_run(proofs)

    let groups: ptr<Groups> = group_rows(ex)
    let euclid_count: ptr<i32> = malloc(4) as ptr<i32>
    euclid_count[0] = 0
    let euclid_items: string = write_euclid_indexes(ex, groups, 3, euclid_count)
    let versions: ptr<Versions> = parse_versions()
    write_catalog(lib, ex, groups, today)
    write_versions_json(versions)
    write_releases_index(versions)
    write_example_status()

    let manifest: ptr<Json> = wn_load("docs/nav.json")
    if manifest == null {
        ft_errln("build_wiki: docs/nav.json is not valid JSON")
        return 1
    }
    if write_nav(manifest, euclid_items, proofs_nav(ex, groups, 3)) == false {
        return 1
    }
    build_search_index(manifest, lib, ex)
    let shell: ptr<WBuf> = wb_new()
    copy_site_shell(shell)
    batch_run(shell)
    if build_tutorial_exercises(today) == false {
        return 1
    }
    write_llms_txt(manifest)
    let gcounts: ptr<i32> = malloc(8) as ptr<i32>
    write_proof_graph(gcounts)
    run_pagefind(root_abs)

    let total: i32 = rows_len(lib) + rows_len(ex)
    let mut pf_note: string = " " + wu_dot() + " Pagefind skipped (local search-index.json)"
    if ft_exists(OUT + "/pagefind/pagefind.js") {
        pf_note = " " + wu_dot() + " Pagefind index"
    }
    ft_outln("Wiki built " + wu_arrow() + " " + root_abs + "/" + OUT)
    ft_outln("  " + ft_itoa(total) + " proofs " + wu_dot() + " " + ft_itoa(euclid_count[0]) + " Euclid books " + wu_dot() + " nav + search index generated" + pf_note)
    ft_outln("  proof-graph.json: " + ft_itoa(gcounts[0]) + " nodes " + wu_dot() + " " + ft_itoa(gcounts[1]) + " edges")
    return 0
}
