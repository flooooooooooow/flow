# Encode recorded PPM frames into an animated GIF.
#
# Run it as `./flow tool frames_to_gif`:
#
#   flow tool frames_to_gif <frame-dir> <out.gif> [--fps 20] [--stride 2] [--width 480]
#
# Used by `flow record --gif`, which passes --fps/--stride/--width straight
# through, and by `flow tool shader_record`. The frames come from
# runtime/gfx_record.c + lib/runtime/gfx_record.flow (frame_*.ppm, binary
# P6). Every --stride-th frame is kept and scaled down to --width with
# nearest neighbour. One palette serves the whole clip: per-frame palettes
# force full-frame rewrites and inflate the file several times over. It is
# sampled across the clip rather than from frame 0, because a simulation
# often starts near-uniform and only earns its colours later. The palette is
# median cut to 256 colours, frames are Floyd-Steinberg dithered onto it,
# and the GIF loops forever with disposal 2 and a delay of
# max(20, round(1000 / fps)) ms. The encoder is lib/stdlib/gif.flow, through
# scripts/tools/lib/gifclip.flow.

import .text { ft_outln, ft_errln, ft_eq, ft_len, ft_itoa, ft_repr, ft_starts, ft_slice, ft_from, ft_byte, ft_basename, ft_dirname, ft_ends, ft_split_lines, ft_list_new, ft_list_push, ft_list_len, ft_list_get, ft_list_sort, StrList }
import .proc { pr_quote, pr_capture, pr_mkdir_p }
import .gifclip { gc_frames_new, gc_frames_push, gc_frames_get, gc_read_ppm, gc_resize_nearest, gc_clip_palette, gc_write_gif, GcFrames }

extern {
    function exit(code: i32) -> void
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function atoi(s: string) -> i32
    function fopen(path: string, mode: string) -> ptr<void>
    function fseek(fp: ptr<void>, offset: i64, whence: i32) -> i32
    function ftell(fp: ptr<void>) -> i64
    function fclose(fp: ptr<void>) -> i32
}

const PROG: string = "flow tool frames_to_gif"
const USAGE: string = "usage: flow tool frames_to_gif [-h] [--fps FPS] [--stride STRIDE]\n                               [--width WIDTH]\n                               frame_dir out"

function help_text() -> string {
    return USAGE + "\n\npositional arguments:\n  frame_dir\n  out\n\noptions:\n  -h, --help       show this help message and exit\n  --fps FPS\n  --stride STRIDE  keep every Nth frame\n  --width WIDTH    downscale to this width"
}

function arg_error(msg: string) -> void {
    ft_errln(USAGE)
    ft_errln(PROG + ": error: " + msg)
    exit(2)
}

function die(msg: string) -> void {
    ft_errln(msg)
    exit(1)
}

# int() as argparse applies it: optional sign, digits, surrounding blanks.
function is_int(s: string) -> bool {
    let n: i32 = ft_len(s)
    let mut i: i32 = 0
    while i < n and (ft_byte(s, i) == 32 or ft_byte(s, i) == 9) {
        i = i + 1
    }
    if i < n and (ft_byte(s, i) == 45 or ft_byte(s, i) == 43) {
        i = i + 1
    }
    let start: i32 = i
    while i < n and ft_byte(s, i) >= 48 and ft_byte(s, i) <= 57 {
        i = i + 1
    }
    if i == start {
        return false
    }
    while i < n and (ft_byte(s, i) == 32 or ft_byte(s, i) == 9) {
        i = i + 1
    }
    return i == n
}

function int_arg(v: string, name: string) -> i32 {
    if is_int(v) == false {
        arg_error("argument " + name + ": invalid int value: " + ft_repr(v))
    }
    return atoi(v)
}

# A negative number such as -5, which argparse takes as a value.
function is_negative_number(s: string) -> bool {
    if ft_starts(s, "-") == false or ft_len(s) < 2 {
        return false
    }
    let mut i: i32 = 1
    let mut digits: i32 = 0
    while i < ft_len(s) {
        let c: i32 = ft_byte(s, i)
        if c >= 48 and c <= 57 {
            digits = digits + 1
        } elif c != 46 {
            return false
        }
        i = i + 1
    }
    return digits > 0
}

# The long option `a` names, allowing argparse's unique prefixes; or null.
function long_option(a: string) -> string {
    let opts: ptr<StrList> = ft_list_new()
    ft_list_push(opts, "--help")
    ft_list_push(opts, "--fps")
    ft_list_push(opts, "--stride")
    ft_list_push(opts, "--width")
    let mut hit: string = null as string
    let mut count: i32 = 0
    let mut i: i32 = 0
    while i < ft_list_len(opts) {
        let o: string = ft_list_get(opts, i)
        if ft_eq(o, a) {
            return o
        }
        if ft_len(a) > 2 and ft_starts(o, a) {
            hit = o
            count = count + 1
        }
        i = i + 1
    }
    if count == 1 {
        return hit
    }
    if count > 1 {
        arg_error("ambiguous option: " + a + " could match --fps, --stride, --width")
    }
    return null as string
}

# str(Path(p)): repeated and trailing slashes and "." parts dropped.
function path_str(p: string) -> string {
    if ft_len(p) == 0 {
        return "."
    }
    let parts: ptr<StrList> = ft_list_new()
    let mut cur: string = ""
    let mut i: i32 = 0
    while i <= ft_len(p) {
        if i == ft_len(p) or ft_byte(p, i) == 47 {
            if ft_len(cur) > 0 and ft_eq(cur, ".") == false {
                ft_list_push(parts, cur)
            }
            cur = ""
        } else {
            cur = cur + ft_slice(p, i, i + 1)
        }
        i = i + 1
    }
    let mut out: string = ""
    if ft_starts(p, "/") {
        out = "/"
    }
    let mut k: i32 = 0
    while k < ft_list_len(parts) {
        if k > 0 {
            out = out + "/"
        }
        out = out + ft_list_get(parts, k)
        k = k + 1
    }
    if ft_len(out) == 0 {
        return "."
    }
    return out
}

# Python's round() for a non-negative double: halves go to the even side.
function round_half_even(v: f64) -> i32 {
    let fl: i32 = v as i32
    let diff: f64 = v - (fl as f64)
    if diff > 0.5 {
        return fl + 1
    }
    if diff == 0.5 and (fl % 2) != 0 {
        return fl + 1
    }
    return fl
}

# f"{bytes / 1024:.0f}": the quotient is exact, so a tie rounds to even.
function kb_text(bytes: i64) -> string {
    let mut q: i64 = bytes / 1024
    let r: i64 = bytes % 1024
    if r > 512 or (r == 512 and (q % 2) != 0) {
        q = q + 1
    }
    return ft_itoa(q as i32)
}

function file_size(path: string) -> i64 {
    let fp: ptr<void> = fopen(path, "rb")
    if fp == null {
        return 0
    }
    let _s: i32 = fseek(fp, 0, 2)
    let v: i64 = ftell(fp)
    fclose(fp)
    return v
}

# frame_*.ppm directly inside `dir`, sorted by name.
function list_frames(dir: string) -> ptr<StrList> {
    let names: ptr<StrList> = ft_list_new()
    let listing: string = pr_capture("find " + pr_quote(dir + "/") + " -mindepth 1 -maxdepth 1 -name 'frame_*.ppm' 2>/dev/null")
    let lines: ptr<StrList> = ft_split_lines(listing)
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let line: string = ft_list_get(lines, i)
        if ft_len(line) > 0 {
            ft_list_push(names, ft_basename(line))
        }
        i = i + 1
    }
    ft_list_sort(names)
    let out: ptr<StrList> = ft_list_new()
    let base: string = path_str(dir)
    let mut k: i32 = 0
    while k < ft_list_len(names) {
        ft_list_push(out, base + "/" + ft_list_get(names, k))
        k = k + 1
    }
    return out
}

function main(argc: i32, argv: ptr<ptr<u8>>) -> i32 {
    let mut fps: i32 = 20
    let mut stride: i32 = 2
    let mut width: i32 = 480
    let pos: ptr<StrList> = ft_list_new()
    let extra: ptr<StrList> = ft_list_new()
    let mut only_pos: bool = false
    let mut i: i32 = 1
    while i < argc {
        let a: string = argv[i] as string
        if only_pos == false and ft_eq(a, "--") {
            only_pos = true
            i = i + 1
            continue
        }
        if only_pos or ft_starts(a, "-") == false or ft_eq(a, "-") or is_negative_number(a) {
            if ft_list_len(pos) < 2 {
                ft_list_push(pos, a)
            } else {
                ft_list_push(extra, a)
            }
            i = i + 1
            continue
        }
        if ft_eq(a, "-h") {
            ft_outln(help_text())
            return 0
        }
        let mut name: string = a
        let mut value: string = null as string
        let eq: i32 = ft_find_eq(a)
        if ft_starts(a, "--") and eq > 0 {
            name = ft_slice(a, 0, eq)
            value = ft_from(a, eq + 1)
        }
        let opt: string = long_option(name)
        if opt as ptr<u8> == null {
            ft_list_push(extra, a)
            i = i + 1
            continue
        }
        if ft_eq(opt, "--help") {
            ft_outln(help_text())
            return 0
        }
        if value as ptr<u8> == null {
            if i + 1 >= argc {
                arg_error("argument " + opt + ": expected one argument")
            }
            let nxt: string = argv[i + 1] as string
            if ft_starts(nxt, "-") and ft_eq(nxt, "-") == false and is_negative_number(nxt) == false {
                arg_error("argument " + opt + ": expected one argument")
            }
            value = nxt
            i = i + 1
        }
        if ft_eq(opt, "--fps") {
            fps = int_arg(value, opt)
        } elif ft_eq(opt, "--stride") {
            stride = int_arg(value, opt)
        } else {
            width = int_arg(value, opt)
        }
        i = i + 1
    }
    if ft_list_len(pos) == 0 {
        arg_error("the following arguments are required: frame_dir, out")
    }
    if ft_list_len(pos) == 1 {
        arg_error("the following arguments are required: out")
    }
    if ft_list_len(extra) > 0 {
        let mut msg: string = "unrecognized arguments:"
        let mut k: i32 = 0
        while k < ft_list_len(extra) {
            msg = msg + " " + ft_list_get(extra, k)
            k = k + 1
        }
        arg_error(msg)
    }
    let frame_dir: string = ft_list_get(pos, 0)
    let out_arg: string = ft_list_get(pos, 1)

    let paths: ptr<StrList> = list_frames(frame_dir)
    if ft_list_len(paths) == 0 {
        die("frames_to_gif: no frames in " + frame_dir)
    }
    let mut step: i32 = stride
    if step < 1 {
        step = 1
    }

    let frames: ptr<GcFrames> = gc_frames_new()
    let wh: ptr<i32> = malloc(8) as ptr<i32>
    let mut k: i32 = 0
    while k < ft_list_len(paths) {
        let path: string = ft_list_get(paths, k)
        let px: ptr<u8> = gc_read_ppm(path, wh)
        if px == null {
            die("frames_to_gif: cannot read " + path + " as a binary PPM")
        }
        let mut img: ptr<u8> = px
        let mut w: i32 = wh[0]
        let mut h: i32 = wh[1]
        if width != 0 and w > width {
            if width < 0 {
                die("frames_to_gif: --width must be positive, got " + ft_itoa(width))
            }
            let nh: i32 = round_half_even(((h as f64) * (width as f64)) / (w as f64))
            if nh < 1 {
                die("frames_to_gif: " + path + " is too flat to scale to width " + ft_itoa(width))
            }
            img = gc_resize_nearest(px, w, h, width, nh)
            free(px as ptr<void>)
            w = width
            h = nh
        }
        if frames[0].len == 0 {
            frames[0].w = w
            frames[0].h = h
        } elif w != frames[0].w or h != frames[0].h {
            die("frames_to_gif: " + path + " is " + ft_itoa(wh[0]) + "x" + ft_itoa(wh[1]) + ", unlike the first frame")
        }
        gc_frames_push(frames, img)
        k = k + step
    }

    let pal: ptr<u8> = malloc(768) as ptr<u8>
    let ncolors: i32 = gc_clip_palette(frames, 256, pal)

    let out: string = path_str(out_arg)
    let parent: string = ft_dirname(out)
    if ft_len(parent) > 0 {
        let _m: bool = pr_mkdir_p(parent)
    }
    let mut f: i32 = fps
    if f < 1 {
        f = 1
    }
    let mut delay: i32 = round_half_even(1000.0 / (f as f64))
    if delay < 20 {
        delay = 20
    }
    if gc_write_gif(out, frames, pal, ncolors, true, delay, 2) != 0 {
        die("frames_to_gif: cannot write " + out)
    }
    ft_outln(out + ": " + ft_itoa(frames[0].len) + " frames, " + ft_itoa(frames[0].w) + "x" + ft_itoa(frames[0].h) + ", " + kb_text(file_size(out)) + " KB")
    return 0
}

function ft_find_eq(s: string) -> i32 {
    let mut i: i32 = 0
    while i < ft_len(s) {
        if ft_byte(s, i) == 61 {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}
