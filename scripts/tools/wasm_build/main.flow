# Compile Flow programs to runnable WebAssembly pages, one at a time or as
# the site/wasm gallery.
#
# Run through the shims:
#
#   scripts/wasm_build.sh program.flow [--out DIR] [--backend c|mlir] ...
#   scripts/build_wasm_gallery.sh [--only NAME ...] [--category ID] [--list]
#
# The first argument the shims pass selects the mode: `build`, `gallery`, or
# `gallery-one` (one gallery target, run in parallel by the gallery through
# xargs -P). The shims set FLOW_REPO_ROOT, WASM_BUILD_PYTHON (the python3 the
# transpiler runs under), WASM_BUILD_BIN (this executable) and the emscripten
# environment the Homebrew toolchain needs.
#
# Flow sources go to C, or through MLIR to LLVM IR, with the Python-hosted
# compiler (python3 -m flow.transpiler), as before the port. emcc links the
# result, gfx programs against runtime/gfx_wasm.c. Page text lives in
# scripts/tools/wasm_build/assets. Those files store the em dash, the en
# dash and curly quotes as @MDASH@, @NDASH@, @LDQUO@ and @RDQUO@, which this
# program expands, so the pages come out byte for byte as they did.

import .text { ft_out, ft_outln, ft_err, ft_errln, ft_eq, ft_len, ft_itoa, ft_read_file, ft_write_file, ft_exists, ft_starts, ft_ends, ft_at, ft_find, ft_contains, ft_slice, ft_from, ft_replace, ft_repr, ft_rfind_byte, ft_list_new, ft_list_push, ft_list_len, ft_list_get, ft_list_sort, StrList }
import .proc { pr_quote, pr_run, pr_capture, pr_chomp, pr_cwd, pr_is_dir, pr_is_file, pr_mkdir_p }
import .unicode { uc_decode, uc_len, uc_is_space, uc_is_word, uc_lower_str, uc_strip, uc_count }
import .mdtext { md_splitlines }
import .json { json_quote }
import .bench { bn_now }

extern {
    function malloc(size: i64) -> ptr<void>
    function getenv(name: string) -> string
    function chdir(path: string) -> i32
    function fopen(path: string, mode: string) -> ptr<void>
    function fclose(fp: ptr<void>) -> i32
    function fseek(fp: ptr<void>, offset: i64, whence: i32) -> i32
    function ftell(fp: ptr<void>) -> i64
}

# ---------------------------------------------------------------------------
# Environment and paths
# ---------------------------------------------------------------------------

function root() -> string {
    let r: string = getenv("FLOW_REPO_ROOT")
    if r == null or ft_len(r) == 0 {
        return pr_cwd()
    }
    return r
}

function python() -> string {
    let py: string = getenv("WASM_BUILD_PYTHON")
    if py == null or ft_len(py) == 0 {
        return "python3"
    }
    return py
}

function asset(name: string) -> string {
    let text: string = ft_read_file(root() + "/scripts/tools/wasm_build/assets/" + name)
    if text == null {
        ft_errln("wasm_build: missing asset " + name)
        return ""
    }
    return expand_marks(text)
}

function utf8_3(a: i32, b: i32, c: i32) -> string {
    let buf: ptr<u8> = malloc(4) as ptr<u8>
    buf[0] = a as u8
    buf[1] = b as u8
    buf[2] = c as u8
    buf[3] = 0
    return buf as string
}

function mdash() -> string {
    return utf8_3(226, 128, 148)
}

function expand_marks(text: string) -> string {
    if ft_contains(text, "@") == false {
        return text
    }
    let mut t: string = ft_replace(text, "@MDASH@", mdash())
    t = ft_replace(t, "@NDASH@", utf8_3(226, 128, 147))
    t = ft_replace(t, "@LDQUO@", utf8_3(226, 128, 156))
    t = ft_replace(t, "@RDQUO@", utf8_3(226, 128, 157))
    return t
}

# str(PurePosixPath(s)): drop empty and "." parts and a trailing slash.
function pnorm(s: string) -> string {
    if ft_len(s) == 0 {
        return "."
    }
    let parts: ptr<StrList> = split_on(s, 47)
    let mut acc: string = ""
    let mut first: bool = true
    let mut k: i32 = 0
    while k < ft_list_len(parts) {
        let part: string = ft_list_get(parts, k)
        if ft_len(part) > 0 and ft_eq(part, ".") == false {
            if first == false {
                acc = acc + "/"
            }
            acc = acc + part
            first = false
        }
        k = k + 1
    }
    if ft_starts(s, "/") {
        return "/" + acc
    }
    if ft_len(acc) == 0 {
        return "."
    }
    return acc
}

function split_on(s: string, ch: i32) -> ptr<StrList> {
    let out: ptr<StrList> = ft_list_new()
    let sp: ptr<u8> = s as ptr<u8>
    let mut start: i32 = 0
    let mut i: i32 = 0
    while sp[i] != 0 {
        if (sp[i] as i32) == ch {
            ft_list_push(out, ft_slice(s, start, i))
            start = i + 1
        }
        i = i + 1
    }
    ft_list_push(out, ft_from(s, start))
    return out
}

# os.path.normpath for an absolute path: resolve "." and "..".
function abs_norm(path: string) -> string {
    let parts: ptr<StrList> = split_on(path, 47)
    let keep: ptr<StrList> = ft_list_new()
    let mut k: i32 = 0
    while k < ft_list_len(parts) {
        let part: string = ft_list_get(parts, k)
        if ft_eq(part, "..") {
            if ft_list_len(keep) > 0 {
                keep[0].len = keep[0].len - 1
            }
        } elif ft_len(part) > 0 and ft_eq(part, ".") == false {
            ft_list_push(keep, part)
        }
        k = k + 1
    }
    let mut joined: string = ""
    k = 0
    while k < ft_list_len(keep) {
        joined = joined + "/" + ft_list_get(keep, k)
        k = k + 1
    }
    if ft_len(joined) == 0 {
        return "/"
    }
    return joined
}

# Path.resolve(): absolute, with symlinks resolved along the longest prefix
# that exists (getcwd reports the physical directory).
function resolve_path(path: string) -> string {
    let mut absol: string = path
    if ft_starts(path, "/") == false {
        absol = pr_cwd() + "/" + path
    }
    absol = abs_norm(absol)
    let here: string = pr_cwd()
    let mut head: string = absol
    let mut tail: string = ""
    while ft_len(head) > 1 {
        if pr_is_dir(head) and chdir(head) == 0 {
            let physical: string = pr_cwd()
            let _b: i32 = chdir(here)
            if ft_eq(physical, "/") {
                return "/" + tail
            }
            if ft_len(tail) == 0 {
                return physical
            }
            return physical + "/" + tail
        }
        let slash: i32 = ft_rfind_byte(head, 47)
        let leaf: string = ft_from(head, slash + 1)
        if ft_len(tail) == 0 {
            tail = leaf
        } else {
            tail = leaf + "/" + tail
        }
        head = ft_slice(head, 0, slash)
        if ft_len(head) == 0 {
            head = "/"
        }
    }
    return absol
}

function path_name(path: string) -> string {
    let slash: i32 = ft_rfind_byte(path, 47)
    return ft_from(path, slash + 1)
}

# PurePath.stem
function path_stem(path: string) -> string {
    let leaf: string = path_name(path)
    let dot: i32 = ft_rfind_byte(leaf, 46)
    if dot <= 0 or dot == ft_len(leaf) - 1 {
        return leaf
    }
    return ft_slice(leaf, 0, dot)
}

function path_suffix_lower(path: string) -> string {
    let leaf: string = path_name(path)
    let dot: i32 = ft_rfind_byte(leaf, 46)
    if dot <= 0 or dot == ft_len(leaf) - 1 {
        return ""
    }
    return uc_lower_str(ft_from(leaf, dot))
}

# Path.with_suffix(new) for a path whose leaf has a suffix.
function with_suffix(path: string, suffix: string) -> string {
    let slash: i32 = ft_rfind_byte(path, 47)
    let dot: i32 = ft_rfind_byte(path, 46)
    if dot > slash + 1 {
        return ft_slice(path, 0, dot) + suffix
    }
    return path + suffix
}

function parent_dir(path: string) -> string {
    let slash: i32 = ft_rfind_byte(path, 47)
    if slash < 0 {
        return "."
    }
    if slash == 0 {
        return "/"
    }
    return ft_slice(path, 0, slash)
}

function file_size(path: string) -> i32 {
    let fp: ptr<void> = fopen(path, "rb")
    if fp == null {
        return -1
    }
    let _s: i32 = fseek(fp, 0, 2)
    let size: i64 = ftell(fp)
    let _c: i32 = fclose(fp)
    return size as i32
}

function rel_to_root(path: string) -> string {
    let r: string = root()
    if ft_starts(path, r + "/") {
        return ft_from(path, ft_len(r) + 1)
    }
    return null
}

# ---------------------------------------------------------------------------
# Text helpers
# ---------------------------------------------------------------------------

function html_escape(s: string) -> string {
    let mut t: string = ft_replace(s, "&", "&amp;")
    t = ft_replace(t, "<", "&lt;")
    t = ft_replace(t, ">", "&gt;")
    return ft_replace(t, "\"", "&quot;")
}

# The first `limit` code points of `s`.
function head_chars(s: string, limit: i32) -> string {
    let hp: ptr<u8> = s as ptr<u8>
    let mut count: i32 = 0
    let mut i: i32 = 0
    while hp[i] != 0 {
        if ((hp[i] as i32) & 192) != 128 {
            if count == limit {
                return ft_slice(s, 0, i)
            }
            count = count + 1
        }
        i = i + 1
    }
    return s
}

function pad_right(s: string, width: i32) -> string {
    let mut padded: string = s
    let mut n: i32 = uc_count(s)
    while n < width {
        padded = padded + " "
        n = n + 1
    }
    return padded
}

function pad_left(s: string, width: i32) -> string {
    let mut padded: string = s
    let mut n: i32 = uc_count(s)
    while n < width {
        padded = " " + padded
        n = n + 1
    }
    return padded
}

function lstrip_char(s: string, ch: i32) -> string {
    let lp: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    while lp[i] != 0 and (lp[i] as i32) == ch {
        i = i + 1
    }
    return ft_from(s, i)
}

function rstrip_char(s: string, ch: i32) -> string {
    let rp: ptr<u8> = s as ptr<u8>
    let mut n: i32 = ft_len(s)
    while n > 0 and (rp[n - 1] as i32) == ch {
        n = n - 1
    }
    return ft_slice(s, 0, n)
}

function join_with(items: ptr<StrList>, sep: string) -> string {
    let mut joined: string = ""
    let mut k: i32 = 0
    while k < ft_list_len(items) {
        if k > 0 {
            joined = joined + sep
        }
        joined = joined + ft_list_get(items, k)
        k = k + 1
    }
    return joined
}

# Replace each @@key@@ in one pass; inserted text is never rescanned.
function fill(template: string, keys: ptr<StrList>, vals: ptr<StrList>) -> string {
    let mut filled: string = ""
    let mut pos: i32 = 0
    while true {
        let open: i32 = ft_find(template, "@@", pos)
        if open < 0 {
            break
        }
        let close: i32 = ft_find(template, "@@", open + 2)
        if close < 0 {
            break
        }
        let key: string = ft_slice(template, open + 2, close)
        let mut hit: i32 = -1
        let mut k: i32 = 0
        while k < ft_list_len(keys) {
            if ft_eq(ft_list_get(keys, k), key) {
                hit = k
            }
            k = k + 1
        }
        if hit < 0 {
            filled = filled + ft_slice(template, pos, close)
            pos = close
        } else {
            filled = filled + ft_slice(template, pos, open) + ft_list_get(vals, hit)
            pos = close + 2
        }
    }
    return filled + ft_from(template, pos)
}

function is_digit(c: i32) -> bool {
    return c >= 48 and c <= 57
}

function is_ident_start(c: i32) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
}

# Unicode \w at byte offset `at`: byte length of the char, or 0.
function word_at(wp: ptr<u8>, at: i32) -> i32 {
    let c: i32 = wp[at] as i32
    if c == 0 {
        return 0
    }
    if uc_is_word(uc_decode(wp, at)) {
        return uc_len(c)
    }
    return 0
}

function space_at(sp: ptr<u8>, at: i32) -> i32 {
    let c: i32 = sp[at] as i32
    if c == 0 {
        return 0
    }
    if uc_is_space(uc_decode(sp, at)) {
        return uc_len(c)
    }
    return 0
}

function skip_space(sp: ptr<u8>, at: i32) -> i32 {
    let mut q: i32 = at
    let mut w: i32 = space_at(sp, q)
    while w > 0 {
        q = q + w
        w = space_at(sp, q)
    }
    return q
}

# True when the code point ending just before `at` is a word character.
function word_before(bp: ptr<u8>, at: i32) -> bool {
    if at == 0 {
        return false
    }
    let mut q: i32 = at - 1
    while q > 0 and ((bp[q] as i32) & 192) == 128 {
        q = q - 1
    }
    return uc_is_word(uc_decode(bp, q))
}

# Python int() for a decimal literal; ok[0] says whether it parsed.
function py_int(s: string, ok: ptr<i32>) -> i32 {
    let t: string = uc_strip(s)
    let ip: ptr<u8> = t as ptr<u8>
    let mut i: i32 = 0
    let mut neg: bool = false
    if ip[0] == 43 or ip[0] == 45 {
        neg = ip[0] == 45
        i = 1
    }
    let mut v: i32 = 0
    let mut digits: i32 = 0
    let mut last_us: bool = false
    while ip[i] != 0 {
        let c: i32 = ip[i] as i32
        if is_digit(c) {
            v = v * 10 + (c - 48)
            digits = digits + 1
            last_us = false
        } elif c == 95 and digits > 0 and last_us == false {
            last_us = true
        } else {
            ok[0] = 0
            return 0
        }
        i = i + 1
    }
    if digits == 0 or last_us {
        ok[0] = 0
        return 0
    }
    ok[0] = 1
    if neg {
        return 0 - v
    }
    return v
}

# f"{n / d:.{places}f}" for d a power of two (the quotient is exact), with
# round-half-to-even like Python's formatter.
function fixed_div(n: i32, d: i32, places: i32) -> string {
    let mut scale: i64 = 1
    let mut k: i32 = 0
    while k < places {
        scale = scale * 10
        k = k + 1
    }
    let num: i64 = (n as i64) * scale
    let mut q: i64 = num / (d as i64)
    let r: i64 = num % (d as i64)
    if r * 2 > (d as i64) or (r * 2 == (d as i64) and q % 2 == 1) {
        q = q + 1
    }
    let whole: i64 = q / scale
    let mut text: string = ft_itoa(whole as i32)
    if places > 0 {
        let frac: i64 = q % scale
        let mut fs: string = ft_itoa(frac as i32)
        while ft_len(fs) < places {
            fs = "0" + fs
        }
        text = text + "." + fs
    }
    return text
}

# round(x, 1) printed as a Python float.
function tenths(x: f64) -> string {
    let t: i32 = (x * 10.0 + 0.5) as i32
    return ft_itoa(t / 10) + "." + ft_itoa(t % 10)
}

# ---------------------------------------------------------------------------
# Subprocesses
# ---------------------------------------------------------------------------

struct Proc {
    code: i32
    out: string
    err: string
}

# Run `cmd` through /bin/sh from the repository root, capturing both streams.
function run_capture(cmd: string, prefix_env: string) -> ptr<Proc> {
    let dir: string = pr_chomp(pr_capture("mktemp -d 2>/dev/null || mktemp -d -t wasmbuild"))
    let o_path: string = dir + "/out"
    let e_path: string = dir + "/err"
    let code: i32 = pr_run("cd " + pr_quote(root()) + " && " + prefix_env + cmd + " >" + pr_quote(o_path) + " 2>" + pr_quote(e_path))
    let pr: ptr<Proc> = malloc(24) as ptr<Proc>
    pr[0].code = code
    pr[0].out = ft_read_file(o_path)
    pr[0].err = ft_read_file(e_path)
    if pr[0].out == null {
        pr[0].out = ""
    }
    if pr[0].err == null {
        pr[0].err = ""
    }
    let _rm: i32 = pr_run("rm -rf " + pr_quote(dir))
    return pr
}

# The last line of (stderr or stdout).strip(), or `fallback`.
function last_detail(pr: ptr<Proc>, fallback: string) -> string {
    let mut text: string = pr[0].err
    if ft_len(text) == 0 {
        text = pr[0].out
    }
    let lines: ptr<StrList> = md_splitlines(uc_strip(text))
    if ft_list_len(lines) == 0 {
        return fallback
    }
    return ft_list_get(lines, ft_list_len(lines) - 1)
}

function have_emcc() -> bool {
    return pr_run("command -v emcc >/dev/null 2>&1 && emcc -v >/dev/null 2>&1") == 0
}

# ---------------------------------------------------------------------------
# Build state
# ---------------------------------------------------------------------------

struct Build {
    program: string
    out_dir: string
    name: string
    title: string
    opt: string
    timeout: i32
    keep_c: bool
    backend: string
    preload: ptr<StrList>
    link: ptr<StrList>
    initial_memory: string
    asyncify: i32
    emcc_flags: ptr<StrList>
    extra_c: ptr<StrList>
    extra_flow_runtime: ptr<StrList>
    extra_html: string
    threads: bool
    workers: i32
    error: string
    # results
    gfx: bool
    rel: string
    wasm_bytes: i32
    js_bytes: i32
    data_bytes: i32
    seconds: f64
}

function build_new() -> ptr<Build> {
    let b: ptr<Build> = malloc(256) as ptr<Build>
    b[0].program = ""
    b[0].out_dir = ""
    b[0].name = ""
    b[0].title = ""
    b[0].opt = "-O2"
    b[0].timeout = 600
    b[0].keep_c = false
    b[0].backend = "c"
    b[0].preload = ft_list_new()
    b[0].link = ft_list_new()
    b[0].initial_memory = "32MB"
    b[0].asyncify = 32768
    b[0].emcc_flags = ft_list_new()
    b[0].extra_c = ft_list_new()
    b[0].extra_flow_runtime = ft_list_new()
    b[0].extra_html = ""
    b[0].threads = false
    b[0].workers = 8
    b[0].error = null
    b[0].gfx = false
    b[0].rel = ""
    b[0].wasm_bytes = 0
    b[0].js_bytes = 0
    b[0].data_bytes = -1
    b[0].seconds = 0.0
    return b
}

function fail(b: ptr<Build>, msg: string) -> bool {
    b[0].error = msg
    return false
}

# resolve_backend(): explicit value, else FLOW_CPU_BACKEND, else "c".
function resolve_backend(explicit: string, errs: ptr<StrList>) -> string {
    let mut mode: string = explicit
    if mode == null or ft_len(mode) == 0 {
        mode = getenv("FLOW_CPU_BACKEND")
        if mode == null or ft_len(mode) == 0 {
            mode = "c"
        }
    }
    mode = uc_lower_str(uc_strip(mode))
    if ft_eq(mode, "c") == false and ft_eq(mode, "mlir") == false {
        ft_list_push(errs, "unknown backend " + ft_repr(mode) + " (expected c|mlir)")
    }
    return mode
}

# ---------------------------------------------------------------------------
# Flow to C / LLVM IR
# ---------------------------------------------------------------------------

function flow_to_c(b: ptr<Build>, program: string, c_out: string, library: bool) -> string {
    let _m: bool = pr_mkdir_p(parent_dir(c_out))
    let mut cmd: string = pr_quote(python()) + " -m flow.transpiler " + pr_quote(program) + " --c"
    if library {
        cmd = cmd + " --library"
    }
    cmd = cmd + " --lenient -o " + pr_quote(c_out)
    let pr: ptr<Proc> = run_capture(cmd, "")
    if pr[0].code != 0 or ft_exists(c_out) == false {
        let _f: bool = fail(b, "flow->c: " + last_detail(pr, "transpiler failed"))
        return null
    }
    return ft_read_file(c_out)
}

function flow_to_llvm_ir(b: ptr<Build>, program: string, ll_out: string) -> string {
    let _m: bool = pr_mkdir_p(parent_dir(ll_out))
    let mut pypath: string = root() + "/src"
    let old: string = getenv("PYTHONPATH")
    if old != null and ft_len(old) > 0 {
        pypath = pypath + ":" + old
    }
    let cmd: string = pr_quote(python()) + " -m flow.transpiler " + pr_quote(program) + " --mlir --llvm --wasm32 --lenient -o " + pr_quote(ll_out)
    let pr: ptr<Proc> = run_capture(cmd, "PYTHONPATH=" + pr_quote(pypath) + " ")
    if pr[0].code != 0 or ft_exists(ll_out) == false or file_size(ll_out) <= 0 {
        let _f: bool = fail(b, "flow->mlir->llvm: " + last_detail(pr, "transpiler failed"))
        return null
    }
    return ft_read_file(ll_out)
}

function uses_gfx_flow_source(src: string) -> bool {
    return ft_contains(src, "import \"stdlib/gfx.flow\"") or ft_contains(src, "import \"stdlib/gfx") or ft_contains(src, "flow_gfx_") or ft_contains(src, "gfx_init") or ft_contains(src, "gfx_present")
}

# ---------------------------------------------------------------------------
# Browser stubs for host-only externs (assets/extern_stubs.tsv)
# ---------------------------------------------------------------------------

# re.search(rf"\b{sym}\s*\(", src)
function sym_referenced(src: string, sym: string) -> bool {
    let rp: ptr<u8> = src as ptr<u8>
    let slen: i32 = ft_len(sym)
    let mut at: i32 = ft_find(src, sym, 0)
    while at >= 0 {
        if word_before(rp, at) == false {
            let q: i32 = skip_space(rp, at + slen)
            if rp[q] == 40 {
                return true
            }
        }
        at = ft_find(src, sym, at + 1)
    }
    return false
}

# re.search(rf"(?<![\w(])\b{sym}\s*\([^;]*\)\s*{{", src)
function sym_defined(src: string, sym: string) -> bool {
    let dp: ptr<u8> = src as ptr<u8>
    let slen: i32 = ft_len(sym)
    let mut at: i32 = ft_find(src, sym, 0)
    while at >= 0 {
        let prev_paren: bool = at > 0 and dp[at - 1] == 40
        if word_before(dp, at) == false and prev_paren == false {
            let q: i32 = skip_space(dp, at + slen)
            if dp[q] == 40 {
                let mut k: i32 = q + 1
                while dp[k] != 0 and dp[k] != 59 {
                    if dp[k] == 41 {
                        let after: i32 = skip_space(dp, k + 1)
                        if dp[after] == 123 {
                            return true
                        }
                    }
                    k = k + 1
                }
            }
        }
        at = ft_find(src, sym, at + 1)
    }
    return false
}

function append_extern_stubs(src: string) -> string {
    let table: ptr<StrList> = md_splitlines(asset("extern_stubs.tsv"))
    let missing: ptr<StrList> = ft_list_new()
    let mut k: i32 = 0
    while k < ft_list_len(table) {
        let row: string = ft_list_get(table, k)
        let tab: i32 = ft_find(row, "\t", 0)
        let sym: string = ft_slice(row, 0, tab)
        if sym_referenced(src, sym) and sym_defined(src, sym) == false {
            ft_list_push(missing, ft_from(row, tab + 1))
        }
        k = k + 1
    }
    if ft_list_len(missing) == 0 {
        return src
    }
    let block: ptr<StrList> = ft_list_new()
    ft_list_push(block, "")
    ft_list_push(block, "/* Browser stubs for host-only externs (see EXTERN_STUBS). */")
    ft_list_push(block, "#include <emscripten/emscripten.h>")
    k = 0
    while k < ft_list_len(missing) {
        ft_list_push(block, ft_list_get(missing, k))
        k = k + 1
    }
    return src + "\n" + join_with(block, "\n") + "\n"
}

# ---------------------------------------------------------------------------
# emcc
# ---------------------------------------------------------------------------

function emcc_command(b: ptr<Build>, input_file: string, out_js: string, gfx: bool) -> string {
    let args: ptr<StrList> = ft_list_new()
    ft_list_push(args, "emcc")
    ft_list_push(args, input_file)
    if gfx {
        ft_list_push(args, root() + "/runtime/gfx_wasm.c")
    }
    let links: ptr<StrList> = b[0].link
    let mut k: i32 = 0
    while k < ft_list_len(links) {
        let lp: string = ft_list_get(links, k)
        let sfx: string = path_suffix_lower(lp)
        if ft_eq(sfx, ".m") == false and ft_eq(sfx, ".mm") == false and ft_eq(sfx, ".metal") == false {
            ft_list_push(args, resolve_path(lp))
        }
        k = k + 1
    }
    ft_list_push(args, b[0].opt)
    if gfx {
        ft_list_push(args, "-sASYNCIFY=1")
        ft_list_push(args, "-sASYNCIFY_STACK_SIZE=" + ft_itoa(b[0].asyncify))
    }
    ft_list_push(args, "-o")
    ft_list_push(args, out_js)
    ft_list_push(args, "-sINITIAL_MEMORY=" + b[0].initial_memory)
    ft_list_push(args, "-sMODULARIZE=1")
    if b[0].threads {
        ft_list_push(args, "-sENVIRONMENT=web,worker")
        ft_list_push(args, "-sEXPORT_NAME=createFlowThreaded")
        ft_list_push(args, "-pthread")
        ft_list_push(args, "-sPTHREAD_POOL_SIZE=" + ft_itoa(b[0].workers + 1))
        ft_list_push(args, "-sPROXY_TO_PTHREAD")
        ft_list_push(args, "-DFLOW_PAR_WORKERS=" + ft_itoa(b[0].workers))
        ft_list_push(args, "-sEXIT_RUNTIME=1")
    } else {
        ft_list_push(args, "-sENVIRONMENT=web")
        ft_list_push(args, "-sALLOW_MEMORY_GROWTH=1")
        ft_list_push(args, "-sSTACK_SIZE=16MB")
        ft_list_push(args, "-sEXPORT_NAME=createFlowModule")
        ft_list_push(args, "-sINVOKE_RUN=0")
        ft_list_push(args, "-sEXIT_RUNTIME=0")
        ft_list_push(args, "-sEXPORTED_RUNTIME_METHODS=callMain,ccall")
        ft_list_push(args, "-sEXPORTED_FUNCTIONS=_main,_malloc,_free")
    }
    ft_list_push(args, "-Wno-implicit-function-declaration")
    ft_list_push(args, "-lm")
    let pre: ptr<StrList> = b[0].preload
    if ft_list_len(pre) > 0 {
        ft_list_push(args, "-sFORCE_FILESYSTEM=1")
        k = 0
        while k < ft_list_len(pre) {
            ft_list_push(args, "--preload-file")
            ft_list_push(args, ft_list_get(pre, k))
            k = k + 1
        }
    }
    let flags: ptr<StrList> = b[0].emcc_flags
    k = 0
    while k < ft_list_len(flags) {
        ft_list_push(args, ft_list_get(flags, k))
        k = k + 1
    }
    let mut cmdline: string = ""
    k = 0
    while k < ft_list_len(args) {
        if k > 0 {
            cmdline = cmdline + " "
        }
        cmdline = cmdline + pr_quote(ft_list_get(args, k))
        k = k + 1
    }
    return cmdline
}

# re.sub(r"\S*emscripten_temp_\S+?[:\s]", "", line)
function strip_emscripten_temp(line: string) -> string {
    let tp: ptr<u8> = line as ptr<u8>
    let n: i32 = ft_len(line)
    let marker: string = "emscripten_temp_"
    let mut kept: string = ""
    let mut copied: i32 = 0
    let mut pos: i32 = 0
    while pos <= n {
        # Try a match starting at `pos`: \S* then the marker, greedy, so the
        # last marker in the run that can still finish wins.
        let mut run_end: i32 = pos
        while run_end < n and space_at(tp, run_end) == 0 {
            run_end = run_end + uc_len(tp[run_end] as i32)
        }
        let mut match_end: i32 = -1
        let mut occ: i32 = ft_find(line, marker, pos)
        let occs: ptr<StrList> = ft_list_new()
        while occ >= 0 and occ + 16 <= run_end {
            ft_list_push(occs, ft_itoa(occ))
            occ = ft_find(line, marker, occ + 1)
        }
        let mut oi: i32 = ft_list_len(occs) - 1
        while oi >= 0 and match_end < 0 {
            let okp: ptr<i32> = malloc(4) as ptr<i32>
            let o: i32 = py_int(ft_list_get(occs, oi), okp)
            let body: i32 = o + 16
            if body < run_end {
                let mut j: i32 = body + uc_len(tp[body] as i32)
                while j < run_end and tp[j] != 58 {
                    j = j + uc_len(tp[j] as i32)
                }
                if j < run_end {
                    match_end = j + 1
                } elif j < n {
                    match_end = j + space_at(tp, j)
                }
            }
            oi = oi - 1
        }
        if match_end >= 0 {
            kept = kept + ft_slice(line, copied, pos)
            copied = match_end
            pos = match_end
        } else {
            if pos == n {
                break
            }
            pos = pos + uc_len(tp[pos] as i32)
        }
    }
    return kept + ft_from(line, copied)
}

# re.sub(r"\s*\[-W[a-z-]+\]", "", line)
function strip_warning_tags(line: string) -> string {
    let wp: ptr<u8> = line as ptr<u8>
    let mut kept: string = ""
    let mut copied: i32 = 0
    let mut i: i32 = 0
    let n: i32 = ft_len(line)
    while i < n {
        # A match starts at the first char of a whitespace run (or at "[").
        let ws_end: i32 = skip_space(wp, i)
        let mut matched: i32 = -1
        if ft_at(line, ws_end, "[-W") {
            let mut j: i32 = ws_end + 3
            while (wp[j] >= 97 and wp[j] <= 122) or wp[j] == 45 {
                j = j + 1
            }
            if j > ws_end + 3 and wp[j] == 93 {
                matched = j + 1
            }
        }
        if matched >= 0 {
            kept = kept + ft_slice(line, copied, i)
            copied = matched
            i = matched
        } else {
            i = i + uc_len(wp[i] as i32)
        }
    }
    return kept + ft_from(line, copied)
}

function tidy(line: string) -> string {
    let mut t: string = strip_emscripten_temp(line)
    t = ft_replace(t, root() + "/", "")
    let mut pre: i32 = -1
    if ft_starts(t, "emcc:") {
        pre = 5
    } elif ft_starts(t, "wasm-ld:") {
        pre = 8
    } elif ft_starts(t, "clang:") {
        pre = 6
    }
    if pre >= 0 {
        let tp: ptr<u8> = t as ptr<u8>
        t = ft_from(t, skip_space(tp, pre))
    }
    t = strip_warning_tags(t)
    return uc_strip(t)
}

# The symbol in `undefined (?:exported )?symbol:?\s*"?([\w.$]+)`, or null.
function undefined_symbol(line: string) -> string {
    let up: ptr<u8> = line as ptr<u8>
    let mut at: i32 = ft_find(line, "undefined ", 0)
    while at >= 0 {
        let mut starts: ptr<StrList> = ft_list_new()
        let a: i32 = at + 10
        if ft_at(line, a, "exported symbol") {
            ft_list_push(starts, ft_itoa(a + 15))
        }
        if ft_at(line, a, "symbol") {
            ft_list_push(starts, ft_itoa(a + 6))
        }
        let mut si: i32 = 0
        while si < ft_list_len(starts) {
            let okp: ptr<i32> = malloc(4) as ptr<i32>
            let s0: i32 = py_int(ft_list_get(starts, si), okp)
            # :? then \s* then "? then the run; try the greedy choices first.
            let mut colon: i32 = 1
            while colon >= 0 {
                let mut q: i32 = s0
                let mut go: bool = true
                if colon == 1 {
                    if up[q] == 58 {
                        q = q + 1
                    } else {
                        go = false
                    }
                }
                if go {
                    let ws_end: i32 = skip_space(up, q)
                    let mut w: i32 = ws_end
                    while w >= q {
                        let mut quote: i32 = 1
                        while quote >= 0 {
                            let mut r: i32 = w
                            let mut ok2: bool = true
                            if quote == 1 {
                                if up[r] == 34 {
                                    r = r + 1
                                } else {
                                    ok2 = false
                                }
                            }
                            if ok2 {
                                let mut e: i32 = r
                                let mut step: i32 = sym_char(up, e)
                                while step > 0 {
                                    e = e + step
                                    step = sym_char(up, e)
                                }
                                if e > r {
                                    return ft_slice(line, r, e)
                                }
                            }
                            quote = quote - 1
                        }
                        if w == q {
                            break
                        }
                        w = w - 1
                    }
                }
                colon = colon - 1
            }
            si = si + 1
        }
        at = ft_find(line, "undefined ", at + 1)
    }
    return null
}

function sym_char(sp: ptr<u8>, at: i32) -> i32 {
    if sp[at] == 46 or sp[at] == 36 {
        return 1
    }
    return word_at(sp, at)
}

function first_error(text: string) -> string {
    let raw: ptr<StrList> = md_splitlines(text)
    let lines: ptr<StrList> = ft_list_new()
    let mut k: i32 = 0
    while k < ft_list_len(raw) {
        let ln: string = uc_strip(ft_list_get(raw, k))
        if ft_len(ln) > 0 {
            ft_list_push(lines, ln)
        }
        k = k + 1
    }
    k = 0
    while k < ft_list_len(lines) {
        let hit: string = undefined_symbol(ft_list_get(lines, k))
        if hit != null {
            return "undefined symbol " + lstrip_char(hit, 95)
        }
        k = k + 1
    }
    k = 0
    while k < ft_list_len(lines) {
        if ft_contains(uc_lower_str(ft_list_get(lines, k)), "error:") {
            return head_chars(tidy(ft_list_get(lines, k)), 200)
        }
        k = k + 1
    }
    if ft_list_len(lines) == 0 {
        return head_chars(tidy("unknown error"), 200)
    }
    return head_chars(tidy(ft_list_get(lines, ft_list_len(lines) - 1)), 200)
}

function compile_wasm(b: ptr<Build>, input_file: string, out_js: string, gfx: bool) -> bool {
    let _m: bool = pr_mkdir_p(parent_dir(out_js))
    let cmd: string = emcc_command(b, input_file, out_js, gfx)
    if b[0].timeout <= 0 {
        return fail(b, "emcc: timed out after " + ft_itoa(b[0].timeout) + "s")
    }
    # perl's alarm stands in for subprocess.run(timeout=...): SIGALRM is 142.
    let pr: ptr<Proc> = run_capture("perl -e 'alarm shift; exec @ARGV or exit 127' " + ft_itoa(b[0].timeout) + " " + cmd, "")
    if pr[0].code == 142 {
        return fail(b, "emcc: timed out after " + ft_itoa(b[0].timeout) + "s")
    }
    if pr[0].code != 0 {
        let mut text: string = pr[0].err
        if ft_len(text) == 0 {
            text = pr[0].out
        }
        return fail(b, "emcc: " + first_error(text))
    }
    if ft_exists(with_suffix(out_js, ".wasm")) == false {
        return fail(b, "emcc: no .wasm emitted")
    }
    if ft_list_len(b[0].preload) > 0 and ft_exists(with_suffix(out_js, ".data")) == false {
        return fail(b, "emcc: --preload requested but no .data package emitted")
    }
    return true
}

# ---------------------------------------------------------------------------
# HTML host page
# ---------------------------------------------------------------------------

# gfx_open(W, H, ...) with literal numbers, else named i32 constants.
function canvas_size(src: string, wh: ptr<i32>) -> void {
    let cp: ptr<u8> = src as ptr<u8>
    let mut at: i32 = ft_find(src, "gfx_open", 0)
    while at >= 0 {
        let mut q: i32 = skip_space(cp, at + 8)
        if cp[q] == 40 {
            q = skip_space(cp, q + 1)
            let d1: i32 = q
            while is_digit(cp[q] as i32) {
                q = q + 1
            }
            if q > d1 {
                let e1: i32 = q
                q = skip_space(cp, q)
                if cp[q] == 44 {
                    q = skip_space(cp, q + 1)
                    let d2: i32 = q
                    while is_digit(cp[q] as i32) {
                        q = q + 1
                    }
                    if q > d2 {
                        wh[0] = parse_digits(ft_slice(src, d1, e1))
                        wh[1] = parse_digits(ft_slice(src, d2, q))
                        return
                    }
                }
            }
        }
        at = ft_find(src, "gfx_open", at + 1)
    }
    at = ft_find(src, "gfx_open", 0)
    while at >= 0 {
        let mut q2: i32 = skip_space(cp, at + 8)
        if cp[q2] == 40 {
            q2 = skip_space(cp, q2 + 1)
            let i1: i32 = q2
            q2 = ident_end(cp, q2)
            if q2 > i1 {
                let ie1: i32 = q2
                q2 = skip_space(cp, q2)
                if cp[q2] == 44 {
                    q2 = skip_space(cp, q2 + 1)
                    let i2: i32 = q2
                    q2 = ident_end(cp, q2)
                    if q2 > i2 {
                        let w: i32 = const_value(src, ft_slice(src, i1, ie1))
                        let h: i32 = const_value(src, ft_slice(src, i2, q2))
                        if w != 0 and h != 0 {
                            wh[0] = w
                            wh[1] = h
                            return
                        }
                        wh[0] = 800
                        wh[1] = 600
                        return
                    }
                }
            }
        }
        at = ft_find(src, "gfx_open", at + 1)
    }
    wh[0] = 800
    wh[1] = 600
}

function parse_digits(s: string) -> i32 {
    let okp: ptr<i32> = malloc(4) as ptr<i32>
    return py_int(s, okp)
}

# [A-Za-z_][\w]* starting at `at`; returns the end (== at when none).
function ident_end(ip: ptr<u8>, at: i32) -> i32 {
    if is_ident_start(ip[at] as i32) == false {
        return at
    }
    let mut q: i32 = at + 1
    let mut w: i32 = word_at(ip, q)
    while w > 0 {
        q = q + w
        w = word_at(ip, q)
    }
    return q
}

# re.search(r"const\s+NAME\s*:\s*i32\s*=\s*(\d+)"), or 0.
function const_value(src: string, name: string) -> i32 {
    let vp: ptr<u8> = src as ptr<u8>
    let mut at: i32 = ft_find(src, "const", 0)
    while at >= 0 {
        let q0: i32 = at + 5
        let q1: i32 = skip_space(vp, q0)
        if q1 > q0 and ft_at(src, q1, name) {
            let mut q: i32 = skip_space(vp, q1 + ft_len(name))
            if vp[q] == 58 {
                q = skip_space(vp, q + 1)
                if ft_at(src, q, "i32") {
                    q = skip_space(vp, q + 3)
                    if vp[q] == 61 {
                        q = skip_space(vp, q + 1)
                        let d: i32 = q
                        while is_digit(vp[q] as i32) {
                            q = q + 1
                        }
                        if q > d {
                            return parse_digits(ft_slice(src, d, q))
                        }
                    }
                }
            }
        }
        at = ft_find(src, "const", at + 1)
    }
    return 0
}

function key_hints(src: string) -> string {
    let lines: ptr<StrList> = md_splitlines(src)
    let picked: ptr<StrList> = ft_list_new()
    let mut grabbing: bool = false
    let mut k: i32 = 0
    while k < ft_list_len(lines) and k < 60 {
        let line: string = ft_list_get(lines, k)
        if ft_starts(line, "#") == false {
            if grabbing {
                break
            }
        } else {
            let body: string = uc_strip(lstrip_char(line, 35))
            let low: string = uc_lower_str(body)
            if ft_starts(low, "controls") or ft_starts(low, "keys") or ft_starts(low, "parameters / keys") {
                grabbing = true
            } elif grabbing {
                if ft_len(body) == 0 {
                    break
                }
                ft_list_push(picked, body)
            }
        }
        k = k + 1
    }
    if ft_list_len(picked) == 0 {
        return "Arrows or WASD move, Space acts, P pauses, R restarts, Esc quits."
    }
    let first8: ptr<StrList> = ft_list_new()
    k = 0
    while k < ft_list_len(picked) and k < 8 {
        ft_list_push(first8, ft_list_get(picked, k))
        k = k + 1
    }
    return ft_replace(html_escape(join_with(first8, " &middot; ")), "&amp;middot;", "&middot;")
}

function write_page(b: ptr<Build>, gfx: bool, src: string, source_url: string) -> void {
    let mut body: string = ""
    let mut script: string = ""
    if gfx {
        let wh: ptr<i32> = malloc(8) as ptr<i32>
        canvas_size(src, wh)
        body = ft_replace(asset("gfx_body.txt"), "__W__", ft_itoa(wh[0]))
        body = ft_replace(body, "__H__", ft_itoa(wh[1]))
        body = ft_replace(body, "__TITLE__", html_escape(b[0].title))
        body = ft_replace(body, "__KEYS__", key_hints(src))
        script = ft_replace(asset("gfx_script.txt"), "__NAME__", b[0].name)
    } elif b[0].threads {
        body = asset("threads_body.txt")
        script = ft_replace(asset("threads_script.txt"), "__NAME__", b[0].name)
    } else {
        body = asset("console_body.txt")
        script = ft_replace(asset("console_script.txt"), "__NAME__", b[0].name)
    }
    let mut pipe: string = "C &rarr; WebAssembly"
    if ft_eq(b[0].backend, "mlir") {
        pipe = "MLIR &rarr; LLVM &rarr; WebAssembly"
    }
    let mut coi: string = ""
    if b[0].threads {
        coi = "<script src=\"coi-serviceworker.js\"></script>\n"
    }
    let mut kind: string = "console"
    if gfx {
        kind = "gfx canvas backend"
    } elif b[0].threads {
        kind = "console &middot; pthreads over SharedArrayBuffer"
    }
    let keys: ptr<StrList> = ft_list_new()
    let vals: ptr<StrList> = ft_list_new()
    ft_list_push(keys, "title")
    ft_list_push(vals, html_escape(b[0].title))
    ft_list_push(keys, "coi")
    ft_list_push(vals, coi)
    ft_list_push(keys, "css")
    ft_list_push(vals, asset("page_css.txt"))
    ft_list_push(keys, "pipe")
    ft_list_push(vals, pipe)
    ft_list_push(keys, "kind")
    ft_list_push(vals, kind)
    ft_list_push(keys, "source_url")
    ft_list_push(vals, html_escape(source_url))
    ft_list_push(keys, "extra_html")
    ft_list_push(vals, b[0].extra_html)
    ft_list_push(keys, "body")
    ft_list_push(vals, body)
    ft_list_push(keys, "script")
    ft_list_push(vals, script)
    let _w: bool = ft_write_file(b[0].out_dir + "/index.html", fill(asset("page.html"), keys, vals))
}

# ---------------------------------------------------------------------------
# One build
# ---------------------------------------------------------------------------

function list_has_resolved(items: ptr<StrList>, path: string) -> bool {
    let want: string = resolve_path(path)
    let mut k: i32 = 0
    while k < ft_list_len(items) {
        if ft_eq(resolve_path(ft_list_get(items, k)), want) {
            return true
        }
        k = k + 1
    }
    return false
}

function build(b: ptr<Build>) -> bool {
    let program: string = resolve_path(b[0].program)
    b[0].program = program
    if ft_exists(program) == false {
        return fail(b, "no such file: " + program)
    }
    let errs: ptr<StrList> = ft_list_new()
    b[0].backend = resolve_backend(b[0].backend, errs)
    if ft_list_len(errs) > 0 {
        return fail(b, ft_list_get(errs, 0))
    }
    let is_mlir: bool = ft_eq(b[0].backend, "mlir")
    if b[0].threads and is_mlir {
        return fail(b, "threads mode requires the C backend")
    }
    if ft_list_len(b[0].extra_flow_runtime) > 0 and is_mlir {
        return fail(b, "extra_flow_runtime requires the C backend")
    }
    if ft_len(b[0].name) == 0 {
        b[0].name = path_stem(program)
    }
    if ft_len(b[0].title) == 0 {
        b[0].title = ft_replace(ft_replace(b[0].name, "_gfx", ""), "_", " ")
    }
    let out_dir: string = resolve_path(b[0].out_dir)
    b[0].out_dir = out_dir
    let _m: bool = pr_mkdir_p(out_dir)
    let flow_source: string = ft_read_file(program)

    if have_emcc() == false {
        return fail(b, "emcc not on PATH (see docs/language/wasm.md)")
    }

    let mut k: i32 = 0
    while k < ft_list_len(b[0].extra_c) {
        let c: string = ft_list_get(b[0].extra_c, k)
        if ft_starts(c, "/") {
            ft_list_push(b[0].link, pnorm(c))
        } else {
            ft_list_push(b[0].link, root() + "/" + pnorm(c))
        }
        k = k + 1
    }

    let name: string = b[0].name
    let artifacts: ptr<StrList> = ft_list_new()
    let mut gfx: bool = false
    let mut compile_input: string = ""
    if is_mlir {
        let ir_file: string = out_dir + "/" + name + ".ll"
        let ir_text: string = flow_to_llvm_ir(b, program, ir_file)
        if ir_text == null {
            return false
        }
        gfx = ft_contains(ir_text, "flow_gfx_init") or uses_gfx_flow_source(flow_source)
        compile_input = ir_file
        ft_list_push(artifacts, ir_file)
    } else {
        let c_file: string = out_dir + "/" + name + ".c"
        let c_raw: string = flow_to_c(b, program, c_file, false)
        if c_raw == null {
            return false
        }
        let c_source: string = append_extern_stubs(c_raw)
        let _cw: bool = ft_write_file(c_file, c_source)
        gfx = ft_contains(c_source, "flow_gfx_init")
        compile_input = c_file
        ft_list_push(artifacts, c_file)
        if b[0].threads {
            let lib_c: string = out_dir + "/" + name + "_parallel_lib.c"
            if flow_to_c(b, root() + "/lib/runtime/concurrency_parallel.flow", lib_c, true) == null {
                return false
            }
            ft_list_push(artifacts, lib_c)
            let adds: ptr<StrList> = ft_list_new()
            ft_list_push(adds, lib_c)
            ft_list_push(adds, root() + "/runtime/flow_rt_parallel.c")
            ft_list_push(adds, root() + "/runtime/flow_rt_support.c")
            k = 0
            while k < ft_list_len(adds) {
                if list_has_resolved(b[0].link, ft_list_get(adds, k)) == false {
                    ft_list_push(b[0].link, ft_list_get(adds, k))
                }
                k = k + 1
            }
        }
        k = 0
        while k < ft_list_len(b[0].extra_flow_runtime) {
            let mut mod_path: string = pnorm(ft_list_get(b[0].extra_flow_runtime, k))
            if ft_starts(mod_path, "/") == false {
                mod_path = root() + "/" + mod_path
            }
            let mod_c: string = out_dir + "/" + name + "_" + path_stem(mod_path) + "_lib.c"
            if flow_to_c(b, mod_path, mod_c, true) == null {
                return false
            }
            ft_list_push(artifacts, mod_c)
            if list_has_resolved(b[0].link, mod_c) == false {
                ft_list_push(b[0].link, mod_c)
            }
            k = k + 1
        }
    }

    let started: f64 = bn_now()
    let out_js: string = out_dir + "/" + name + ".js"
    if compile_wasm(b, compile_input, out_js, gfx) == false {
        return false
    }
    b[0].seconds = bn_now() - started

    if b[0].threads {
        let _c: i32 = pr_run("cp " + pr_quote(root() + "/wasm/crossing_assets/coi-serviceworker.js") + " " + pr_quote(out_dir + "/coi-serviceworker.js"))
    }

    let rel: string = rel_to_root(program)
    let mut source_url: string = program
    if rel != null {
        b[0].rel = rel
        source_url = "https://github.com/flooooooooooow/flow/blob/main/" + rel
    } else {
        b[0].rel = path_name(program)
    }
    b[0].gfx = gfx
    write_page(b, gfx, flow_source, source_url)
    if b[0].keep_c == false {
        k = 0
        while k < ft_list_len(artifacts) {
            let _r: i32 = pr_run("rm -f " + pr_quote(ft_list_get(artifacts, k)))
            k = k + 1
        }
    }
    b[0].wasm_bytes = file_size(with_suffix(out_js, ".wasm"))
    b[0].js_bytes = file_size(out_js)
    b[0].data_bytes = file_size(with_suffix(out_js, ".data"))
    return true
}

# ---------------------------------------------------------------------------
# JSON
# ---------------------------------------------------------------------------

function json_str_list(items: ptr<StrList>, indent: string) -> string {
    if ft_list_len(items) == 0 {
        return "[]"
    }
    let mut js: string = "[\n"
    let mut k: i32 = 0
    while k < ft_list_len(items) {
        js = js + indent + "  " + json_quote(ft_list_get(items, k))
        if k + 1 < ft_list_len(items) {
            js = js + ","
        }
        js = js + "\n"
        k = k + 1
    }
    return js + indent + "]"
}

function json_bool(v: bool) -> string {
    if v {
        return "true"
    }
    return "false"
}

# ---------------------------------------------------------------------------
# Argument parsing (argparse semantics)
# ---------------------------------------------------------------------------

struct Parse {
    error: string
    help: bool
}

function usage_of(help: string) -> string {
    let cut: i32 = ft_find(help, "\n\n", 0)
    return ft_slice(help, 0, cut + 1)
}

# argparse's allow_abbrev lookup. Returns the option, "" when unknown, or
# "?message" for an ambiguous prefix.
function match_option(opts: ptr<StrList>, name: string) -> string {
    let mut k: i32 = 0
    while k < ft_list_len(opts) {
        if ft_eq(ft_list_get(opts, k), name) {
            return name
        }
        k = k + 1
    }
    if ft_starts(name, "--") == false {
        return ""
    }
    let hits: ptr<StrList> = ft_list_new()
    k = 0
    while k < ft_list_len(opts) {
        if ft_starts(ft_list_get(opts, k), name) {
            ft_list_push(hits, ft_list_get(opts, k))
        }
        k = k + 1
    }
    if ft_list_len(hits) == 1 {
        return ft_list_get(hits, 0)
    }
    if ft_list_len(hits) > 1 {
        return "?ambiguous option: " + name + " could match " + join_with(hits, ", ")
    }
    return ""
}

# argparse treats "-x" (not a negative number) as an option string.
function looks_like_option(arg: string) -> bool {
    if ft_starts(arg, "-") == false or ft_len(arg) < 2 {
        return false
    }
    let okp: ptr<i32> = malloc(4) as ptr<i32>
    let ap: ptr<u8> = arg as ptr<u8>
    if is_digit(ap[1] as i32) or (ap[1] == 46 and is_digit(ap[2] as i32)) {
        return false
    }
    return true
}

# ---------------------------------------------------------------------------
# wasm_build.sh
# ---------------------------------------------------------------------------

function build_error(msg: string) -> i32 {
    ft_err(usage_of(asset("build_help.txt")) + "wasm_build.sh: error: " + msg + "\n")
    return 2
}

function build_main(argc: i32, argv: ptr<string>) -> i32 {
    let opts: ptr<StrList> = ft_list_new()
    ft_list_push(opts, "--help")
    ft_list_push(opts, "--out")
    ft_list_push(opts, "--name")
    ft_list_push(opts, "--title")
    ft_list_push(opts, "--backend")
    ft_list_push(opts, "--preload")
    ft_list_push(opts, "--link")
    ft_list_push(opts, "--initial-memory")
    ft_list_push(opts, "--asyncify-stack-size")
    ft_list_push(opts, "--emcc-flag")
    ft_list_push(opts, "--threads")
    ft_list_push(opts, "--workers")
    ft_list_push(opts, "--timeout")
    ft_list_push(opts, "--keep-c")
    ft_list_push(opts, "--json")

    let b: ptr<Build> = build_new()
    let mut backend_arg: string = null
    let mut out_arg: string = ""
    let mut json: bool = false
    let positionals: ptr<StrList> = ft_list_new()
    let extras: ptr<StrList> = ft_list_new()
    let mut rest_positional: bool = false
    let mut i: i32 = 2
    while i < argc {
        let arg: string = argv[i]
        if rest_positional or looks_like_option(arg) == false {
            ft_list_push(positionals, arg)
            i = i + 1
            continue
        }
        if ft_eq(arg, "--") {
            rest_positional = true
            i = i + 1
            continue
        }
        let mut opt: string = arg
        let mut value: string = null
        if ft_starts(arg, "--") {
            let eq: i32 = ft_find(arg, "=", 0)
            if eq >= 0 {
                opt = ft_slice(arg, 0, eq)
                value = ft_from(arg, eq + 1)
            }
            opt = match_option(opts, opt)
            if ft_starts(opt, "?") {
                return build_error(ft_from(opt, 1))
            }
        } elif ft_eq(arg, "-h") {
            opt = "--help"
        } elif ft_starts(arg, "-O") {
            opt = "-O"
            if ft_len(arg) > 2 {
                value = ft_from(arg, 2)
            }
        } elif ft_starts(arg, "-h") {
            return build_error("argument -h/--help: ignored explicit argument " + ft_repr(ft_from(arg, 2)))
        } else {
            opt = ""
        }
        if ft_len(opt) == 0 {
            ft_list_push(extras, arg)
            i = i + 1
            continue
        }
        let flag: bool = ft_eq(opt, "--help") or ft_eq(opt, "--threads") or ft_eq(opt, "--keep-c") or ft_eq(opt, "--json")
        if flag {
            if value != null {
                let mut shown: string = opt
                if ft_eq(opt, "--help") {
                    shown = "-h/--help"
                }
                return build_error("argument " + shown + ": ignored explicit argument " + ft_repr(value))
            }
            if ft_eq(opt, "--help") {
                ft_out(asset("build_help.txt"))
                return 0
            }
            if ft_eq(opt, "--threads") {
                b[0].threads = true
            } elif ft_eq(opt, "--keep-c") {
                b[0].keep_c = true
            } else {
                json = true
            }
            i = i + 1
            continue
        }
        if value == null {
            if i + 1 >= argc or looks_like_option(argv[i + 1]) {
                let mut shown2: string = opt
                if ft_eq(opt, "-O") {
                    shown2 = "-O"
                }
                return build_error("argument " + shown2 + ": expected one argument")
            }
            value = argv[i + 1]
            i = i + 1
        }
        let okp: ptr<i32> = malloc(4) as ptr<i32>
        if ft_eq(opt, "--out") {
            out_arg = value
        } elif ft_eq(opt, "--name") {
            b[0].name = value
        } elif ft_eq(opt, "--title") {
            b[0].title = value
        } elif ft_eq(opt, "--backend") {
            if ft_eq(value, "c") == false and ft_eq(value, "mlir") == false {
                return build_error("argument --backend: invalid choice: " + ft_repr(value) + " (choose from c, mlir)")
            }
            backend_arg = value
        } elif ft_eq(opt, "--preload") {
            ft_list_push(b[0].preload, value)
        } elif ft_eq(opt, "--link") {
            ft_list_push(b[0].link, pnorm(value))
        } elif ft_eq(opt, "--initial-memory") {
            b[0].initial_memory = value
        } elif ft_eq(opt, "--asyncify-stack-size") {
            b[0].asyncify = py_int(value, okp)
            if okp[0] == 0 {
                return build_error("argument --asyncify-stack-size: invalid int value: " + ft_repr(value))
            }
        } elif ft_eq(opt, "-O") {
            if ft_starts(value, "-O") {
                b[0].opt = value
            } else {
                b[0].opt = "-O" + value
            }
        } elif ft_eq(opt, "--emcc-flag") {
            ft_list_push(b[0].emcc_flags, value)
        } elif ft_eq(opt, "--workers") {
            b[0].workers = py_int(value, okp)
            if okp[0] == 0 {
                return build_error("argument --workers: invalid int value: " + ft_repr(value))
            }
        } elif ft_eq(opt, "--timeout") {
            b[0].timeout = py_int(value, okp)
            if okp[0] == 0 {
                return build_error("argument --timeout: invalid int value: " + ft_repr(value))
            }
        }
        i = i + 1
    }
    if ft_list_len(positionals) == 0 {
        return build_error("the following arguments are required: program")
    }
    let mut k: i32 = 1
    while k < ft_list_len(positionals) {
        ft_list_push(extras, ft_list_get(positionals, k))
        k = k + 1
    }
    if ft_list_len(extras) > 0 {
        return build_error("unrecognized arguments: " + join_with(extras, " "))
    }

    let program: string = ft_list_get(positionals, 0)
    let mut shown_out: string = ""
    if ft_len(out_arg) > 0 {
        shown_out = pnorm(out_arg)
    } else {
        shown_out = root() + "/build/wasm/" + path_stem(pnorm(program))
    }
    b[0].program = pnorm(program)
    b[0].out_dir = shown_out

    let errs: ptr<StrList> = ft_list_new()
    b[0].backend = resolve_backend(backend_arg, errs)
    if ft_list_len(errs) > 0 {
        ft_errln("error: " + ft_list_get(errs, 0))
        return 1
    }
    if build(b) == false {
        ft_errln("error: " + b[0].error)
        return 1
    }

    if json {
        let mut js: string = "{\n"
        js = js + "  \"name\": " + json_quote(b[0].name) + ",\n"
        js = js + "  \"title\": " + json_quote(b[0].title) + ",\n"
        js = js + "  \"source\": " + json_quote(b[0].rel) + ",\n"
        js = js + "  \"backend\": " + json_quote(b[0].backend) + ",\n"
        js = js + "  \"gfx\": " + json_bool(b[0].gfx) + ",\n"
        js = js + "  \"wasm_bytes\": " + ft_itoa(b[0].wasm_bytes) + ",\n"
        js = js + "  \"js_bytes\": " + ft_itoa(b[0].js_bytes) + ",\n"
        js = js + "  \"seconds\": " + tenths(b[0].seconds) + ",\n"
        js = js + "  \"out\": " + json_quote(b[0].out_dir) + ",\n"
        js = js + "  \"preload\": " + json_str_list(b[0].preload, "  ") + ",\n"
        js = js + "  \"link\": " + json_str_list(b[0].link, "  ")
        if b[0].data_bytes >= 0 {
            js = js + ",\n  \"data_bytes\": " + ft_itoa(b[0].data_bytes)
        }
        ft_outln(js + "\n}")
        return 0
    }
    let mut kind: string = "console"
    if b[0].gfx {
        kind = "gfx canvas"
    }
    ft_outln("built " + b[0].name + " (" + kind + ", backend=" + b[0].backend + ") in " + tenths(b[0].seconds) + "s")
    ft_outln("  wasm " + fixed_div(b[0].wasm_bytes, 1024, 0) + " KB  js " + fixed_div(b[0].js_bytes, 1024, 0) + " KB")
    if b[0].data_bytes > 0 {
        ft_outln("  data " + fixed_div(b[0].data_bytes, 1024, 0) + " KB  (preload " + join_with(b[0].preload, ", ") + ")")
    }
    if ft_list_len(b[0].link) > 0 {
        ft_outln("  link " + join_with(b[0].link, " "))
    }
    ft_outln("  page " + shown_out + "/index.html")
    ft_outln("  serve: python3 -m http.server -d " + shown_out)
    return 0
}

# ---------------------------------------------------------------------------
# Gallery: categories, per-example extras, titles
# ---------------------------------------------------------------------------

function category_ids() -> ptr<StrList> {
    let ids: ptr<StrList> = ft_list_new()
    ft_list_push(ids, "games")
    ft_list_push(ids, "morphogenesis")
    ft_list_push(ids, "basics")
    ft_list_push(ids, "language")
    ft_list_push(ids, "numerics")
    ft_list_push(ids, "learning")
    ft_list_push(ids, "systems")
    return ids
}

function category_title(id: string) -> string {
    if ft_eq(id, "games") { return "Games" }
    if ft_eq(id, "morphogenesis") { return "Morphogenesis" }
    if ft_eq(id, "basics") { return "Basics" }
    if ft_eq(id, "language") { return "Language and compilers" }
    if ft_eq(id, "numerics") { return "Numerics and dynamics" }
    if ft_eq(id, "learning") { return "Learning" }
    return "Systems and data"
}

function category_blurb(id: string) -> string {
    if ft_eq(id, "games") {
        return "The same sources docs/demos/games.md records as GIFs, running live on the gfx canvas backend."
    }
    if ft_eq(id, "morphogenesis") {
        return "Reaction-diffusion, growth and cellular automata fields. Number keys switch presets, R reseeds, P pauses."
    }
    if ft_eq(id, "basics") {
        return "Pure computation. No graphics, no host services: the program runs and prints into the page."
    }
    if ft_eq(id, "language") {
        return "Generics, traits, enums, effect rows, and Flow tools written in Flow. Output goes to the page."
    }
    if ft_eq(id, "numerics") {
        return "Solvers, optimisers, linear algebra and control theory. The ones that reach a native BLAS do not link here."
    }
    if ft_eq(id, "learning") {
        return "Small models and agents. The Metal and tape-runtime variants need host services that are not linked here."
    }
    return "Allocators, hash tables, hashing, parsers, file formats. Anything asking the OS about itself stops at the link step."
}

# "folder:pattern" globs, then explicit files, for a category.
function category_globs(id: string) -> ptr<StrList> {
    let g: ptr<StrList> = ft_list_new()
    if ft_eq(id, "games") {
        ft_list_push(g, "examples/games:*_gfx.flow")
    } elif ft_eq(id, "morphogenesis") {
        ft_list_push(g, "examples/morphogenesis:*.flow")
    } elif ft_eq(id, "basics") {
        ft_list_push(g, "examples/basics:*.flow")
    } elif ft_eq(id, "language") {
        ft_list_push(g, "examples/generics_traits:*.flow")
        ft_list_push(g, "examples/compilers:*.flow")
        ft_list_push(g, "examples/effects:*.flow")
    } elif ft_eq(id, "numerics") {
        ft_list_push(g, "examples/numerical:*.flow")
        ft_list_push(g, "examples/dynamics:*.flow")
        ft_list_push(g, "examples/linalg:*.flow")
        ft_list_push(g, "examples/stats:*.flow")
        ft_list_push(g, "examples/physics:*.flow")
    } elif ft_eq(id, "learning") {
        ft_list_push(g, "examples/ml:*.flow")
        ft_list_push(g, "examples/ai:*.flow")
    } else {
        ft_list_push(g, "examples/systems:*.flow")
        ft_list_push(g, "examples/crypto:*.flow")
        ft_list_push(g, "examples/data:*.flow")
        ft_list_push(g, "examples/graphics:*.flow")
    }
    return g
}

function category_files(id: string) -> ptr<StrList> {
    let f: ptr<StrList> = ft_list_new()
    if ft_eq(id, "basics") {
        ft_list_push(f, "examples/wasm/hello_wasm.flow")
        ft_list_push(f, "examples/wasm/parallel_scaling.flow")
        ft_list_push(f, "examples/wasm/parallel_sum.flow")
    }
    return f
}

# PAGE_EXTRAS: fills the build knobs for `name` and returns the card note.
function apply_extras(b: ptr<Build>, name: string) -> string {
    let support: string = root() + "/runtime/flow_rt_support.c"
    if ft_eq(name, "tiny_pointers") {
        ft_list_push(b[0].link, support)
        b[0].extra_html = asset("tiny_pointers_card.txt")
    } elif ft_eq(name, "digits_mlp") {
        ft_list_push(b[0].link, support)
    } elif ft_eq(name, "digits_mlp_parallel") {
        b[0].threads = true
        b[0].workers = 8
        b[0].initial_memory = "128MB"
    } elif ft_eq(name, "parallel_sum") or ft_eq(name, "parallel_scaling") {
        b[0].threads = true
        b[0].workers = 8
    } elif ft_eq(name, "tape_mul") {
        ft_list_push(b[0].extra_flow_runtime, "lib/runtime/tape.flow")
    } elif ft_eq(name, "blas_demo") or ft_eq(name, "lu_decomposition") {
        ft_list_push(b[0].extra_c, "runtime/blas_wasm.c")
    } elif ft_eq(name, "async_primitives") {
        ft_list_push(b[0].extra_c, "runtime/fiber_wasm.c")
        ft_list_push(b[0].extra_c, "runtime/flow_rt_fiber_async.c")
        ft_list_push(b[0].extra_flow_runtime, "lib/runtime/fiber_async.flow")
        ft_list_push(b[0].emcc_flags, "-sASYNCIFY=1")
        ft_list_push(b[0].emcc_flags, "-sASYNCIFY_STACK_SIZE=65536")
    } elif ft_eq(name, "runtime_sha256") {
        ft_list_push(b[0].extra_c, "runtime/crypto_wasm.c")
        ft_list_push(b[0].extra_flow_runtime, "lib/runtime/crypto.flow")
        return "SHA-256 runs Flow's own implementation (lib/runtime/crypto.flow), same code as native; only the random bytes come from the browser's WebCrypto CSPRNG (crypto.getRandomValues) instead of the native OS kernel."
    } elif ft_eq(name, "digits_mlp_metal") {
        ft_list_push(b[0].link, support)
        return "The Metal GPU is CPU-emulated on wasm: buffers are plain memory and flow_gpu_mul_f32 runs an elementwise CPU loop, so the relu-gate correctness check runs and passes, but the 'gpu ms' timing rows measure a CPU loop, not a GPU dispatch."
    }
    return ""
}

function special_title(name: string) -> string {
    let pairs: string = "2048=2048|lightsout=Lights Out|connect4=Connect Four|maze chase=Maze Chase|lane racer=Lane Racer|missile=Missile Command|invaders=Space Invaders|hanoi=Tower of Hanoi|match3=Match-3|dla=DLA|wfc growth=WFC Growth|lsystem plant=L-System Plant|lsystem tree=L-System Tree|cyclic ca=Cyclic CA|hexagonal ca=Hexagonal CA|gcd=GCD|hello wasm=Hello WASM|blas demo=BLAS Demo|lu decomposition=LU Decomposition|lu decomposition pedagogical=LU Decomposition (pedagogical)|digits mlp=Digits MLP|digits mlp metal=Digits MLP (Metal)|digits mlp parallel=Digits MLP (parallel)|ga flappy=GA Flappy|ga control=GA Control|ga dsys namespaced=GA Dsys (namespaced)|ga dsys syntax=GA Dsys Syntax|ga full analysis=GA Full Analysis|ga wfc coupled=GA + WFC Coupled|q snake=Q-Snake|wfc demo=WFC Demo|nn layers=NN Layers|mlir tensor bench=MLIR Tensor Bench|sha256=SHA-256|runtime sha256=Runtime SHA-256|csv parser=CSV Parser|gif writer=GIF Writer|lsp ordering port=LSP Ordering Port|oop counter=OOP Counter|oop person=OOP Person|flowlm charlm=FlowLM Char-LM|ode solver=ODE Solver|regression gd=Regression (GD)"
    let entries: ptr<StrList> = split_on(pairs, 124)
    let mut k: i32 = 0
    while k < ft_list_len(entries) {
        let entry: string = ft_list_get(entries, k)
        let eq: i32 = ft_find(entry, "=", 0)
        if ft_eq(ft_slice(entry, 0, eq), name) {
            return ft_from(entry, eq + 1)
        }
        k = k + 1
    }
    return null
}

# str.capitalize() for ASCII words.
function capitalize(word: string) -> string {
    let lowered: string = uc_lower_str(word)
    let cp: ptr<u8> = lowered as ptr<u8>
    if cp[0] >= 97 and cp[0] <= 122 {
        let buf: ptr<u8> = malloc((ft_len(lowered) + 1) as i64) as ptr<u8>
        let mut k: i32 = 0
        while cp[k] != 0 {
            buf[k] = cp[k]
            k = k + 1
        }
        buf[k] = 0
        buf[0] = (cp[0] - 32) as u8
        return buf as string
    }
    return lowered
}

function pretty_title(stem: string) -> string {
    let name: string = uc_strip(ft_replace(ft_replace(stem, "_gfx", ""), "_", " "))
    let special: string = special_title(name)
    if special != null {
        return special
    }
    let tp: ptr<u8> = name as ptr<u8>
    let words: ptr<StrList> = ft_list_new()
    let mut i: i32 = 0
    let n: i32 = ft_len(name)
    while i < n {
        while i < n and space_at(tp, i) > 0 {
            i = i + space_at(tp, i)
        }
        let start: i32 = i
        while i < n and space_at(tp, i) == 0 {
            i = i + uc_len(tp[i] as i32)
        }
        if i > start {
            ft_list_push(words, capitalize(ft_slice(name, start, i)))
        }
    }
    return join_with(words, " ")
}

function one_line_summary(src: string) -> string {
    let lines: ptr<StrList> = md_splitlines(src)
    let mut k: i32 = 0
    while k < ft_list_len(lines) and k < 40 {
        let line: string = ft_list_get(lines, k)
        if ft_starts(line, "#") == false {
            break
        }
        let mut body: string = uc_strip(lstrip_char(line, 35))
        let low: string = uc_lower_str(body)
        let skip: bool = ft_len(body) == 0 or ft_starts(low, "run:") or ft_starts(low, "controls") or ft_starts(low, "build") or ft_starts(low, "usage")
        if skip == false {
            # re.sub(r"^[A-Z0-9 \-]+:\s*", "", body, count=1)
            let bp: ptr<u8> = body as ptr<u8>
            let mut q: i32 = 0
            while (bp[q] >= 65 and bp[q] <= 90) or is_digit(bp[q] as i32) or bp[q] == 32 or bp[q] == 45 {
                q = q + 1
            }
            if q > 0 and bp[q] == 58 {
                body = ft_from(body, skip_space(bp, q + 1))
            }
            if uc_count(body) > 12 {
                return rstrip_char(body, 46)
            }
        }
        k = k + 1
    }
    return ""
}

# Sorted matches of `folder/pattern` (a shell glob skips dotfiles as glob does).
function glob_sorted(folder: string, pattern: string) -> ptr<StrList> {
    let dir: string = root() + "/" + folder
    let listing: string = pr_capture("cd " + pr_quote(dir) + " 2>/dev/null && for f in " + pattern + "; do [ -e \"$f\" ] && printf '%s\\n' \"$f\"; done")
    let names: ptr<StrList> = md_splitlines(listing)
    let found: ptr<StrList> = ft_list_new()
    let mut k: i32 = 0
    while k < ft_list_len(names) {
        ft_list_push(found, ft_list_get(names, k))
        k = k + 1
    }
    ft_list_sort(found)
    let out: ptr<StrList> = ft_list_new()
    k = 0
    while k < ft_list_len(found) {
        ft_list_push(out, folder + "/" + ft_list_get(found, k))
        k = k + 1
    }
    return out
}

# Targets as "category\tname\ttitle\trelpath" rows.
function collect(cats: ptr<StrList>) -> ptr<StrList> {
    let targets: ptr<StrList> = ft_list_new()
    let mut ci: i32 = 0
    while ci < ft_list_len(cats) {
        let cat: string = ft_list_get(cats, ci)
        let paths: ptr<StrList> = ft_list_new()
        let globs: ptr<StrList> = category_globs(cat)
        let mut gi: i32 = 0
        while gi < ft_list_len(globs) {
            let spec: string = ft_list_get(globs, gi)
            let colon: i32 = ft_find(spec, ":", 0)
            let hits: ptr<StrList> = glob_sorted(ft_slice(spec, 0, colon), ft_from(spec, colon + 1))
            let mut h: i32 = 0
            while h < ft_list_len(hits) {
                ft_list_push(paths, ft_list_get(hits, h))
                h = h + 1
            }
            gi = gi + 1
        }
        let files: ptr<StrList> = category_files(cat)
        gi = 0
        while gi < ft_list_len(files) {
            if ft_exists(root() + "/" + ft_list_get(files, gi)) {
                ft_list_push(paths, ft_list_get(files, gi))
            }
            gi = gi + 1
        }
        let mut pi: i32 = 0
        while pi < ft_list_len(paths) {
            let relp: string = ft_list_get(paths, pi)
            let stem: string = path_stem(relp)
            ft_list_push(targets, cat + "\t" + stem + "\t" + pretty_title(stem) + "\t" + relp)
            pi = pi + 1
        }
        ci = ci + 1
    }
    return targets
}

function field(row: string, idx: i32) -> string {
    let parts: ptr<StrList> = split_on(row, 9)
    return ft_list_get(parts, idx)
}

# ---------------------------------------------------------------------------
# Gallery: one target (run in parallel by xargs)
# ---------------------------------------------------------------------------

function kb(n: i32) -> string {
    if n < 1048576 {
        return fixed_div(n, 1024, 0) + " KB"
    }
    return fixed_div(n, 1048576, 1) + " MB"
}

# Record file: one "key\tvalue" per line, in manifest order.
function gallery_one(argc: i32, argv: ptr<string>) -> i32 {
    let job: string = ft_read_file(argv[2])
    let jl: ptr<StrList> = md_splitlines(job)
    let out_root: string = ft_list_get(jl, 0)
    let opt: string = ft_list_get(jl, 1)
    let okp: ptr<i32> = malloc(4) as ptr<i32>
    let timeout: i32 = py_int(ft_list_get(jl, 2), okp)
    let row: string = ft_list_get(jl, 3)
    let cat: string = field(row, 0)
    let name: string = field(row, 1)
    let title: string = field(row, 2)
    let relp: string = field(row, 3)

    let b: ptr<Build> = build_new()
    let note: string = apply_extras(b, name)
    let mut rec: string = "name\t" + name + "\ntitle\t" + title + "\ncategory\t" + cat + "\nsource\t" + relp + "\n"
    let summary: string = one_line_summary(ft_read_file(root() + "/" + relp))
    rec = rec + "summary\t" + ft_replace(summary, "\n", " ") + "\n"
    if b[0].threads {
        rec = rec + "threads\ttrue\n"
    }
    if ft_len(note) > 0 {
        rec = rec + "note\t" + note + "\n"
    }
    let out_dir: string = out_root + "/" + name
    b[0].program = root() + "/" + relp
    b[0].out_dir = out_dir
    b[0].name = name
    b[0].title = title
    b[0].opt = opt
    b[0].timeout = timeout
    if build(b) == false {
        let _r: i32 = pr_run("rm -rf " + pr_quote(out_dir))
        rec = rec + "status\tfailed\nerror\t" + b[0].error + "\n"
        let _w: bool = ft_write_file(argv[2] + ".rec", rec)
        ft_outln("  FAIL  " + pad_right(name, 24) + " " + b[0].error)
        return 0
    }
    let total: i32 = b[0].wasm_bytes + b[0].js_bytes
    rec = rec + "status\tok\ngfx\t" + json_bool(b[0].gfx) + "\nwasm_bytes\t" + ft_itoa(b[0].wasm_bytes) + "\njs_bytes\t" + ft_itoa(b[0].js_bytes) + "\ntotal_bytes\t" + ft_itoa(total) + "\npage\t" + name + "/index.html\n"
    let _w2: bool = ft_write_file(argv[2] + ".rec", rec)
    ft_outln("  ok    " + pad_right(name, 24) + " " + pad_left(kb(total), 8))
    return 0
}

function rec_get(rec: ptr<StrList>, key: string) -> string {
    let mut k: i32 = 0
    while k < ft_list_len(rec) {
        let line: string = ft_list_get(rec, k)
        if ft_starts(line, key + "\t") {
            return ft_from(line, ft_len(key) + 1)
        }
        k = k + 1
    }
    return null
}

function rec_int(rec: ptr<StrList>, key: string) -> i32 {
    let v: string = rec_get(rec, key)
    if v == null {
        return 0
    }
    return parse_digits(v)
}

function is_ok(rec: ptr<StrList>) -> bool {
    return ft_eq(rec_get(rec, "status"), "ok")
}

function record_json(rec: ptr<StrList>) -> string {
    let ints: string = "|wasm_bytes|js_bytes|total_bytes|"
    let mut js: string = "    {\n"
    let mut k: i32 = 0
    while k < ft_list_len(rec) {
        let line: string = ft_list_get(rec, k)
        let tab: i32 = ft_find(line, "\t", 0)
        let key: string = ft_slice(line, 0, tab)
        let val: string = ft_from(line, tab + 1)
        js = js + "      " + json_quote(key) + ": "
        if ft_eq(key, "threads") or ft_eq(key, "gfx") or ft_contains(ints, "|" + key + "|") {
            js = js + val
        } else {
            js = js + json_quote(val)
        }
        if k + 1 < ft_list_len(rec) {
            js = js + ","
        }
        js = js + "\n"
        k = k + 1
    }
    return js + "    }"
}

# Sort key: category order, then name.
function rec_sort_key(rec: ptr<StrList>) -> string {
    let ids: ptr<StrList> = category_ids()
    let cat: string = rec_get(rec, "category")
    let mut idx: i32 = 99
    let mut k: i32 = 0
    while k < ft_list_len(ids) {
        if ft_eq(ft_list_get(ids, k), cat) {
            idx = k
        }
        k = k + 1
    }
    let mut ks: string = ft_itoa(idx)
    if idx < 10 {
        ks = "0" + ks
    }
    return ks + "\t" + rec_get(rec, "name")
}

# ---------------------------------------------------------------------------
# Gallery page
# ---------------------------------------------------------------------------

function render_gallery(recs: ptr<StrList>, out_path: string) -> void {
    let ids: ptr<StrList> = category_ids()
    let sections: ptr<StrList> = ft_list_new()
    let mut ci: i32 = 0
    while ci < ft_list_len(ids) {
        let cat: string = ft_list_get(ids, ci)
        # Card order: ok first, then by title. Keys hold the record index.
        let keys: ptr<StrList> = ft_list_new()
        let mut ok_count: i32 = 0
        let mut rows: i32 = 0
        let mut k: i32 = 0
        while k < ft_list_len(recs) {
            let rec: ptr<StrList> = md_splitlines(ft_list_get(recs, k))
            if ft_eq(rec_get(rec, "category"), cat) {
                rows = rows + 1
                let mut flag: string = "1"
                if is_ok(rec) {
                    ok_count = ok_count + 1
                    flag = "0"
                }
                let mut idxs: string = ft_itoa(k)
                while ft_len(idxs) < 6 {
                    idxs = "0" + idxs
                }
                ft_list_push(keys, flag + "\t" + rec_get(rec, "title") + "\t" + idxs)
            }
            k = k + 1
        }
        if rows > 0 {
            ft_list_sort(keys)
            let cards: ptr<StrList> = ft_list_new()
            k = 0
            while k < ft_list_len(keys) {
                let key: string = ft_list_get(keys, k)
                let ridx: i32 = parse_digits(ft_from(key, ft_rfind_byte(key, 9) + 1))
                let rec2: ptr<StrList> = md_splitlines(ft_list_get(recs, ridx))
                ft_list_push(cards, card_html(rec2))
                k = k + 1
            }
            let mut sec: string = "    <h2>" + html_escape(category_title(cat)) + "\n"
            sec = sec + "      <span class=\"count\">" + ft_itoa(ok_count) + " of " + ft_itoa(rows) + " running</span></h2>\n"
            sec = sec + "    <p class=\"blurb\">" + html_escape(category_blurb(cat)) + "</p>\n"
            sec = sec + "    <div class=\"grid\">\n" + join_with(cards, "\n") + "\n    </div>"
            ft_list_push(sections, sec)
        }
        ci = ci + 1
    }
    let status_rows: ptr<StrList> = md_splitlines(asset("status_rows.tsv"))
    let status: ptr<StrList> = ft_list_new()
    let mut si: i32 = 0
    while si < ft_list_len(status_rows) {
        let srow: string = ft_list_get(status_rows, si)
        let mut tr: string = "      <tr><td>" + html_escape(field(srow, 0)) + "</td>\n"
        tr = tr + "        <td class=\"state " + field(srow, 1) + "\">" + html_escape(field(srow, 2)) + "</td>\n"
        tr = tr + "        <td>" + html_escape(field(srow, 3)) + "</td></tr>"
        ft_list_push(status, tr)
        si = si + 1
    }
    let mut total_ok: i32 = 0
    let mut total_bytes: i32 = 0
    let mut r: i32 = 0
    while r < ft_list_len(recs) {
        let rec3: ptr<StrList> = md_splitlines(ft_list_get(recs, r))
        if is_ok(rec3) {
            total_ok = total_ok + 1
            total_bytes = total_bytes + rec_int(rec3, "total_bytes")
        }
        r = r + 1
    }
    let tkeys: ptr<StrList> = ft_list_new()
    let tvals: ptr<StrList> = ft_list_new()
    ft_list_push(tkeys, "css")
    ft_list_push(tvals, asset("gallery_css.txt"))
    ft_list_push(tkeys, "total_ok")
    ft_list_push(tvals, ft_itoa(total_ok))
    ft_list_push(tkeys, "sections")
    ft_list_push(tvals, join_with(sections, "\n"))
    ft_list_push(tkeys, "status")
    ft_list_push(tvals, join_with(status, "\n"))
    ft_list_push(tkeys, "total_kb")
    ft_list_push(tvals, kb(total_bytes))
    ft_list_push(tkeys, "js")
    ft_list_push(tvals, asset("gallery_js.txt"))
    let _w: bool = ft_write_file(out_path, fill(asset("gallery.html"), tkeys, tvals))
}

function card_html(rec: ptr<StrList>) -> string {
    let src: string = "https://github.com/flooooooooooow/flow/blob/main/" + rec_get(rec, "source")
    let title: string = html_escape(rec_get(rec, "title"))
    let summary: string = html_escape(rec_get(rec, "summary"))
    if is_ok(rec) {
        let mut kind: string = "console"
        if ft_eq(rec_get(rec, "gfx"), "true") {
            kind = "canvas"
        }
        let mut tags: string = "<span class=\"tag\">" + kind + "</span>"
        if rec_get(rec, "threads") != null {
            tags = tags + " <span class=\"tag\">threads</span>"
        }
        let mut note: string = ""
        if rec_get(rec, "note") != null {
            note = "<div class=\"degrade\">" + html_escape(rec_get(rec, "note")) + "</div>"
        }
        let mut c: string = "      <div class=\"card\">\n"
        c = c + "        <h3>" + title + "</h3>\n"
        c = c + "        <p>" + summary + "</p>\n"
        c = c + "        " + note + "\n"
        c = c + "        <div class=\"row\">\n"
        c = c + "          <button data-run=\"" + html_escape(rec_get(rec, "page")) + "\" data-title=\"" + title + "\">Run</button>\n"
        c = c + "          " + tags + "\n"
        c = c + "          <span>" + kb(rec_int(rec, "total_bytes")) + "</span>\n"
        c = c + "          <a href=\"" + html_escape(src) + "\">source</a>\n"
        c = c + "        </div>\n"
        return c + "      </div>"
    }
    let mut f: string = "      <div class=\"card failed\">\n"
    f = f + "        <h3>" + title + "</h3>\n"
    f = f + "        <p>" + summary + "</p>\n"
    f = f + "        <div class=\"why\">does not build: " + html_escape(rec_get(rec, "error")) + "</div>\n"
    f = f + "        <div class=\"row\"><a href=\"" + html_escape(src) + "\">source</a></div>\n"
    return f + "      </div>"
}

# ---------------------------------------------------------------------------
# build_wasm_gallery.sh
# ---------------------------------------------------------------------------

function gallery_error(msg: string) -> i32 {
    ft_err(usage_of(asset("gallery_help.txt")) + "build_wasm_gallery.sh: error: " + msg + "\n")
    return 2
}

function gallery_main(argc: i32, argv: ptr<string>) -> i32 {
    let opts: ptr<StrList> = ft_list_new()
    ft_list_push(opts, "--help")
    ft_list_push(opts, "--out")
    ft_list_push(opts, "--category")
    ft_list_push(opts, "--only")
    ft_list_push(opts, "--list")
    ft_list_push(opts, "--jobs")
    ft_list_push(opts, "--timeout")

    let mut out_arg: string = root() + "/site/wasm"
    let cats_wanted: ptr<StrList> = ft_list_new()
    let mut only: ptr<StrList> = ft_list_new()
    let mut list_only: bool = false
    let mut jobs: i32 = 4
    let mut opt: string = "-O2"
    let mut timeout: i32 = 600
    let extras: ptr<StrList> = ft_list_new()
    let okp: ptr<i32> = malloc(4) as ptr<i32>
    let mut i: i32 = 2
    while i < argc {
        let arg: string = argv[i]
        if looks_like_option(arg) == false {
            ft_list_push(extras, arg)
            i = i + 1
            continue
        }
        let mut name: string = arg
        let mut value: string = null
        if ft_starts(arg, "--") {
            let eq: i32 = ft_find(arg, "=", 0)
            if eq >= 0 {
                name = ft_slice(arg, 0, eq)
                value = ft_from(arg, eq + 1)
            }
            name = match_option(opts, name)
            if ft_starts(name, "?") {
                return gallery_error(ft_from(name, 1))
            }
        } elif ft_eq(arg, "-h") {
            name = "--help"
        } elif ft_starts(arg, "-j") {
            name = "--jobs"
            if ft_len(arg) > 2 {
                value = ft_from(arg, 2)
            }
        } elif ft_starts(arg, "-O") {
            name = "-O"
            if ft_len(arg) > 2 {
                value = ft_from(arg, 2)
            }
        } else {
            name = ""
        }
        if ft_len(name) == 0 {
            ft_list_push(extras, arg)
            i = i + 1
            continue
        }
        if ft_eq(name, "--help") or ft_eq(name, "--list") {
            if value != null {
                let mut shown: string = name
                if ft_eq(name, "--help") {
                    shown = "-h/--help"
                }
                return gallery_error("argument " + shown + ": ignored explicit argument " + ft_repr(value))
            }
            if ft_eq(name, "--help") {
                ft_out(asset("gallery_help.txt"))
                return 0
            }
            list_only = true
            i = i + 1
            continue
        }
        if ft_eq(name, "--only") {
            # nargs="*": everything up to the next option; the last use wins.
            only = ft_list_new()
            if value != null {
                ft_list_push(only, value)
            } else {
                while i + 1 < argc and looks_like_option(argv[i + 1]) == false {
                    ft_list_push(only, argv[i + 1])
                    i = i + 1
                }
            }
            i = i + 1
            continue
        }
        if value == null {
            if i + 1 >= argc or looks_like_option(argv[i + 1]) {
                let mut shown2: string = name
                if ft_eq(name, "--jobs") {
                    shown2 = "-j/--jobs"
                }
                return gallery_error("argument " + shown2 + ": expected one argument")
            }
            value = argv[i + 1]
            i = i + 1
        }
        if ft_eq(name, "--out") {
            out_arg = value
        } elif ft_eq(name, "--category") {
            ft_list_push(cats_wanted, value)
        } elif ft_eq(name, "--jobs") {
            jobs = py_int(value, okp)
            if okp[0] == 0 {
                return gallery_error("argument -j/--jobs: invalid int value: " + ft_repr(value))
            }
        } elif ft_eq(name, "-O") {
            opt = value
        } elif ft_eq(name, "--timeout") {
            timeout = py_int(value, okp)
            if okp[0] == 0 {
                return gallery_error("argument --timeout: invalid int value: " + ft_repr(value))
            }
        }
        i = i + 1
    }
    if ft_list_len(extras) > 0 {
        return gallery_error("unrecognized arguments: " + join_with(extras, " "))
    }

    let ids: ptr<StrList> = category_ids()
    let cats: ptr<StrList> = ft_list_new()
    let mut k: i32 = 0
    while k < ft_list_len(ids) {
        let cid: string = ft_list_get(ids, k)
        let mut keep: bool = ft_list_len(cats_wanted) == 0
        let mut w: i32 = 0
        while w < ft_list_len(cats_wanted) {
            if ft_eq(ft_list_get(cats_wanted, w), cid) {
                keep = true
            }
            w = w + 1
        }
        if keep {
            ft_list_push(cats, cid)
        }
        k = k + 1
    }
    let all_targets: ptr<StrList> = collect(cats)
    let targets: ptr<StrList> = ft_list_new()
    k = 0
    while k < ft_list_len(all_targets) {
        let row: string = ft_list_get(all_targets, k)
        let mut want: bool = ft_list_len(only) == 0
        let mut w2: i32 = 0
        while w2 < ft_list_len(only) {
            if ft_eq(ft_list_get(only, w2), field(row, 1)) {
                want = true
            }
            w2 = w2 + 1
        }
        if want {
            ft_list_push(targets, row)
        }
        k = k + 1
    }

    if list_only {
        k = 0
        while k < ft_list_len(targets) {
            let row2: string = ft_list_get(targets, k)
            ft_outln(pad_left(field(row2, 0), 14) + "  " + field(row2, 1))
            k = k + 1
        }
        ft_outln(ft_itoa(ft_list_len(targets)) + " targets")
        return 0
    }
    if ft_list_len(targets) == 0 {
        ft_errln("no targets matched")
        return 1
    }
    if have_emcc() == false {
        ft_errln("error: emcc not on PATH (see docs/language/wasm.md)")
        return 1
    }
    let out_root: string = resolve_path(out_arg)
    let _m: bool = pr_mkdir_p(out_root)

    ft_outln("building " + ft_itoa(ft_list_len(targets)) + " examples into " + out_root)
    let started: f64 = bn_now()

    # One job file per target; xargs -P runs them `jobs` at a time, each
    # through this same executable in gallery-one mode.
    let work: string = pr_chomp(pr_capture("mktemp -d 2>/dev/null || mktemp -d -t wasmgallery"))
    let job_list: ptr<StrList> = ft_list_new()
    k = 0
    while k < ft_list_len(targets) {
        let mut jn: string = ft_itoa(k)
        while ft_len(jn) < 4 {
            jn = "0" + jn
        }
        let job_path: string = work + "/job" + jn
        let _jw: bool = ft_write_file(job_path, out_root + "\n" + opt + "\n" + ft_itoa(timeout) + "\n" + ft_list_get(targets, k) + "\n")
        ft_list_push(job_list, job_path)
        k = k + 1
    }
    let _lw: bool = ft_write_file(work + "/jobs", join_with(job_list, "\n") + "\n")
    let self_bin: string = getenv("WASM_BUILD_BIN")
    let _x: i32 = pr_run("xargs -P " + ft_itoa(jobs) + " -n 1 " + pr_quote(self_bin) + " gallery-one < " + pr_quote(work + "/jobs"))

    let recs: ptr<StrList> = ft_list_new()
    let sort_keys: ptr<StrList> = ft_list_new()
    k = 0
    while k < ft_list_len(job_list) {
        let text: string = ft_read_file(ft_list_get(job_list, k) + ".rec")
        if text != null {
            let rec: ptr<StrList> = md_splitlines(text)
            ft_list_push(sort_keys, rec_sort_key(rec) + "\t" + ft_itoa(ft_list_len(recs)))
            ft_list_push(recs, text)
        }
        k = k + 1
    }
    let _rm: i32 = pr_run("rm -rf " + pr_quote(work))
    ft_list_sort(sort_keys)
    let ordered: ptr<StrList> = ft_list_new()
    k = 0
    while k < ft_list_len(sort_keys) {
        let sk: string = ft_list_get(sort_keys, k)
        ft_list_push(ordered, ft_list_get(recs, parse_digits(ft_from(sk, ft_rfind_byte(sk, 9) + 1))))
        k = k + 1
    }

    let mut ok_n: i32 = 0
    let mut total: i32 = 0
    let live: ptr<StrList> = ft_list_new()
    k = 0
    while k < ft_list_len(ordered) {
        let rec4: ptr<StrList> = md_splitlines(ft_list_get(ordered, k))
        if is_ok(rec4) {
            ok_n = ok_n + 1
            total = total + rec_int(rec4, "total_bytes")
            ft_list_push(live, rec_get(rec4, "name"))
        }
        k = k + 1
    }
    if ft_list_len(only) == 0 and ft_list_len(cats_wanted) == 0 {
        let dirs: ptr<StrList> = md_splitlines(pr_capture("cd " + pr_quote(out_root) + " && for d in * .[!.]* ..?*; do [ -d \"$d\" ] && printf '%s\\n' \"$d\"; done"))
        k = 0
        while k < ft_list_len(dirs) {
            if ft_list_has_str(live, ft_list_get(dirs, k)) == false {
                let _d: i32 = pr_run("rm -rf " + pr_quote(out_root + "/" + ft_list_get(dirs, k)))
            }
            k = k + 1
        }
    }

    let mut man: string = "{\n  \"generated_by\": \"scripts/build_wasm_gallery.sh\",\n"
    man = man + "  \"examples\": " + ft_itoa(ft_list_len(ordered)) + ",\n"
    man = man + "  \"built\": " + ft_itoa(ok_n) + ",\n"
    man = man + "  \"failed\": " + ft_itoa(ft_list_len(ordered) - ok_n) + ",\n"
    man = man + "  \"total_bytes\": " + ft_itoa(total) + ",\n"
    man = man + "  \"categories\": [\n"
    k = 0
    while k < ft_list_len(ids) {
        let cid2: string = ft_list_get(ids, k)
        man = man + "    {\n      \"id\": " + json_quote(cid2) + ",\n      \"title\": " + json_quote(category_title(cid2)) + ",\n      \"blurb\": " + json_quote(category_blurb(cid2)) + "\n    }"
        if k + 1 < ft_list_len(ids) {
            man = man + ","
        }
        man = man + "\n"
        k = k + 1
    }
    man = man + "  ],\n  \"entries\": [\n"
    k = 0
    while k < ft_list_len(ordered) {
        man = man + record_json(md_splitlines(ft_list_get(ordered, k)))
        if k + 1 < ft_list_len(ordered) {
            man = man + ","
        }
        man = man + "\n"
        k = k + 1
    }
    man = man + "  ]\n}\n"
    let _mw: bool = ft_write_file(out_root + "/manifest.json", man)
    render_gallery(ordered, out_root + "/index.html")

    let elapsed: f64 = bn_now() - started
    let secs: i32 = (elapsed + 0.5) as i32
    ft_outln("\n" + ft_itoa(ok_n) + " built, " + ft_itoa(ft_list_len(ordered) - ok_n) + " failed in " + ft_itoa(secs) + "s")
    ft_outln("  gallery  " + out_root + "/index.html")
    ft_outln("  manifest " + out_root + "/manifest.json")
    ft_outln("  serve    python3 -m http.server -d " + parent_dir(out_root))
    return 0
}

function ft_list_has_str(items: ptr<StrList>, s: string) -> bool {
    let mut k: i32 = 0
    while k < ft_list_len(items) {
        if ft_eq(ft_list_get(items, k), s) {
            return true
        }
        k = k + 1
    }
    return false
}

function main(argc: i32, argv: ptr<string>) -> i32 {
    if argc < 2 {
        ft_errln("wasm_build: run through scripts/wasm_build.sh or scripts/build_wasm_gallery.sh")
        return 2
    }
    let mode: string = argv[1]
    if ft_eq(mode, "build") {
        return build_main(argc, argv)
    }
    if ft_eq(mode, "gallery") {
        return gallery_main(argc, argv)
    }
    if ft_eq(mode, "gallery-one") {
        return gallery_one(argc, argv)
    }
    ft_errln("wasm_build: unknown mode " + mode)
    return 2
}
