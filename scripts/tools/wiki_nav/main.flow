# Check docs/nav.json against docs/, the way the wiki build does.
#
# Run through scripts/wiki_nav.sh from the repository root:
#
#   wiki_nav.sh                         summary; exit 1 on any problem
#   wiki_nav.sh --problems              one problem per line
#   wiki_nav.sh --pages                 every page under docs/ that counts
#   wiki_nav.sh --listed                every path the sidebar points at
#   wiki_nav.sh --category PATH         search category for a page
#   wiki_nav.sh --sections [--fill KEY LABEL PATH]...
#                                       the built sidebar sections, with the
#                                       generated ones filled in
#
# --manifest FILE and --docs DIR point it at another manifest or tree.

import .text { ft_out, ft_outln, ft_err, ft_errln, ft_eq, ft_len, ft_itoa, ft_list_new, ft_list_push, ft_list_len, ft_list_get, ft_set_has, ft_dirname, StrList, StrSet }
import .json { json_get, json_len, json_quote, Json }
import .wiki_util { wb_new, wb_add, wb_str, wu_sort, WBuf }
import .wiki_nav { wn_load, wn_validate, wn_doc_pages, wn_nav_paths, wn_nav_path_count, wn_dump_sections, wn_category_for }

extern {
    function getenv(name: string) -> string
}

function fill_json(labels: ptr<StrList>, paths: ptr<StrList>) -> string {
    if ft_list_len(labels) == 0 {
        return "[]"
    }
    let b: ptr<WBuf> = wb_new()
    wb_add(b, "[\n")
    let mut i: i32 = 0
    while i < ft_list_len(labels) {
        if i > 0 {
            wb_add(b, ",\n")
        }
        wb_add(b, "      {\n        \"label\": " + json_quote(ft_list_get(labels, i)) + ",\n        \"path\": " + json_quote(ft_list_get(paths, i)) + "\n      }")
        i = i + 1
    }
    wb_add(b, "\n    ]")
    return wb_str(b)
}

function main(argc: i32, argv: ptr<string>) -> i32 {
    let mut manifest: string = "docs/nav.json"
    let mut docs: string = "docs"
    let mut mode: string = "summary"
    let mut category_path: string = ""
    let eu_labels: ptr<StrList> = ft_list_new()
    let eu_paths: ptr<StrList> = ft_list_new()
    let pr_labels: ptr<StrList> = ft_list_new()
    let pr_paths: ptr<StrList> = ft_list_new()
    let mut i: i32 = 1
    while i < argc {
        let arg: string = argv[i]
        if ft_eq(arg, "--manifest") and i + 1 < argc {
            manifest = argv[i + 1]
            i = i + 1
        } elif ft_eq(arg, "--docs") and i + 1 < argc {
            docs = argv[i + 1]
            i = i + 1
        } elif ft_eq(arg, "--problems") or ft_eq(arg, "--pages") or ft_eq(arg, "--listed") or ft_eq(arg, "--sections") {
            mode = arg
        } elif ft_eq(arg, "--category") and i + 1 < argc {
            mode = arg
            category_path = argv[i + 1]
            i = i + 1
        } elif ft_eq(arg, "--fill") and i + 3 < argc {
            if ft_eq(argv[i + 1], "euclid") {
                ft_list_push(eu_labels, argv[i + 2])
                ft_list_push(eu_paths, argv[i + 3])
            } else {
                ft_list_push(pr_labels, argv[i + 2])
                ft_list_push(pr_paths, argv[i + 3])
            }
            i = i + 3
        } else {
            ft_errln("wiki_nav: unknown argument: " + arg)
            return 2
        }
        i = i + 1
    }
    let mut parent: string = ft_dirname(docs)
    if ft_len(parent) == 0 {
        parent = "."
    }

    if ft_eq(mode, "--pages") {
        let pages: ptr<StrList> = wn_doc_pages(docs)
        let mut k: i32 = 0
        while k < ft_list_len(pages) {
            ft_outln(ft_list_get(pages, k))
            k = k + 1
        }
        return 0
    }

    let nav: ptr<Json> = wn_load(manifest)
    if nav == null {
        ft_errln("wiki_nav: cannot read " + manifest + " as JSON")
        return 1
    }

    if ft_eq(mode, "--category") {
        ft_outln(wn_category_for(nav, category_path))
        return 0
    }
    if ft_eq(mode, "--listed") {
        let listed: ptr<StrSet> = wn_nav_paths(nav)
        let all_pages: ptr<StrList> = ft_list_new()
        let keys: ptr<string> = listed[0].keys
        let mut s: i32 = 0
        while s < listed[0].cap {
            if keys[s] != null {
                ft_list_push(all_pages, keys[s])
            }
            s = s + 1
        }
        wu_sort(all_pages, false)
        let mut q: i32 = 0
        while q < ft_list_len(all_pages) {
            ft_outln(ft_list_get(all_pages, q))
            q = q + 1
        }
        return 0
    }
    if ft_eq(mode, "--sections") {
        let sb: ptr<WBuf> = wb_new()
        wn_dump_sections(sb, nav, 0, fill_json(eu_labels, eu_paths), fill_json(pr_labels, pr_paths))
        wb_add(sb, "\n")
        ft_out(wb_str(sb))
        return 0
    }

    let problems: ptr<StrList> = wn_validate(nav, docs, parent)
    if ft_eq(mode, "--problems") {
        let mut r: i32 = 0
        while r < ft_list_len(problems) {
            ft_outln(ft_list_get(problems, r))
            r = r + 1
        }
        if ft_list_len(problems) > 0 {
            return 1
        }
        return 0
    }

    let unlisted: i32 = json_get(nav, 0, "unlisted")
    let mut n_unlisted: i32 = 0
    if unlisted >= 0 {
        n_unlisted = json_len(nav, unlisted)
    }
    ft_outln("nav sections   : " + ft_itoa(json_len(nav, json_get(nav, 0, "sections"))))
    ft_outln("nav entries    : " + ft_itoa(wn_nav_path_count(nav)))
    ft_outln("docs pages     : " + ft_itoa(ft_list_len(wn_doc_pages(docs))))
    ft_outln("unlisted       : " + ft_itoa(n_unlisted))
    let np: i32 = ft_list_len(problems)
    if np > 0 {
        ft_outln("\n" + ft_itoa(np) + " problem(s):")
        let mut t: i32 = 0
        while t < np and t < 60 {
            ft_outln("  " + ft_list_get(problems, t))
            t = t + 1
        }
        if np > 60 {
            ft_outln("  ... and " + ft_itoa(np - 60) + " more")
        }
        return 1
    }
    ft_outln("\nnav is consistent with docs/")
    return 0
}
