# Keep the root Makefile a thin wrapper around the public ./flow CLI (#974).
#
# Run it as `./flow tool makefile_contract` from anywhere in the
# repository; it works from the repository root.
# Every build, run and test target must delegate to $(FLOW); the Makefile
# must not grow its own compiler pipeline, a hard-coded LLVM path, or a
# second hand-written test list.

import .text { ft_outln, ft_errln, ft_contains, ft_read_file }
import .repo { rp_enter_root }

const MAKEFILE: string = "Makefile"

function require(text: string, needle: string) -> i32 {
    if ft_contains(text, needle) {
        return 0
    }
    ft_errln("makefile-contract: Makefile must contain `" + needle + "`")
    return 1
}

function forbid(text: string, needle: string, why: string) -> i32 {
    if ft_contains(text, needle) == false {
        return 0
    }
    ft_errln("makefile-contract: Makefile contains `" + needle + "`: " + why)
    return 1
}

function main(argc: i32, argv: ptr<string>) -> i32 {
    if rp_enter_root() == false {
        ft_errln("makefile-contract: cannot enter the repository root")
        return 1
    }
    let text: string = ft_read_file(MAKEFILE)
    if text as ptr<u8> == null {
        ft_errln("makefile-contract: cannot read " + MAKEFILE)
        return 1
    }
    let mut errors: i32 = 0
    errors = errors + require(text, "$(FLOW) run")
    errors = errors + require(text, "$(FLOW) compile")
    errors = errors + require(text, "$(FLOW) mlir")
    errors = errors + require(text, "$(FLOW) gfx")
    errors = errors + require(text, "$(FLOW) test --compiler --strict --tier2")
    errors = errors + require(text, "$(FLOW) setup")
    errors = errors + require(text, "$(FLOW) clean")
    errors = errors + require(text, "test-stdlib: test")
    errors = errors + forbid(text, "flow.transpiler", "the Python compiler is gone; delegate to ./flow")
    errors = errors + forbid(text, "flow-to-mlir", "a second MLIR pipeline; delegate to ./flow mlir")
    errors = errors + forbid(text, "/opt/homebrew/opt/llvm", "the toolchain is found by ./flow, not hard-coded")
    errors = errors + forbid(text, "mlir-opt", "a second build pipeline; delegate to ./flow")
    errors = errors + forbid(text, "tests/test_simple.flow", "a second test list; ./flow test owns it")
    errors = errors + forbid(text, "tests/test_control.flow", "a second test list; ./flow test owns it")
    errors = errors + forbid(text, "python3", "new tooling is Flow")
    if errors > 0 {
        return 1
    }
    ft_outln("makefile-contract: Makefile delegates to ./flow")
    return 0
}
