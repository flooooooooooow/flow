# Backpressure and claim tests for the Jules dispatcher
# (scripts/tools/jules_dispatch, run as scripts/dispatch_uncovered_jules.sh).
#
# Each case runs the dispatcher in a scratch directory with fake `gh` and
# `jules` commands on PATH, then checks stdout, the decision log and whether
# a session was opened or an issue claimed.
#
# Usage: ./flow tool scripts/tools/jules_dispatch/test.flow

import "tools/flow_cli/sys.flow"
import "scripts/tools/lib/testrun.flow"
import std.process { ProcCmd, ProcStrs, proc_arg }

function fake_gh() -> string {
    return "set -eu\n" +
        "if [ \"$1 $2\" = \"pr list\" ]; then\n" +
        "    printf '%s\\n' \"${FAKE_PRS_JSON:-[]}\"\n" +
        "    exit 0\n" +
        "fi\n" +
        "if [ \"$1 $2\" = \"issue list\" ]; then\n" +
        "    printf '%s\\n' \"${FAKE_ISSUES_JSON:-[]}\"\n" +
        "    exit 0\n" +
        "fi\n" +
        "if [ \"$1 $2\" = \"run list\" ]; then\n" +
        "    printf '%s\\n' \"${FAKE_MAIN_CI_JSON:-[]}\"\n" +
        "    exit 0\n" +
        "fi\n" +
        "if [ \"$1 $2\" = \"issue comment\" ]; then\n" +
        "    printf '%s\\n' \"$*\" >> \"$" + "{FAKE_CLAIM_MARKER}\"\n" +
        "    exit 0\n" +
        "fi\n" +
        "echo \"unexpected gh invocation: $*\" >&2\n" +
        "exit 2\n"
}

function fake_jules() -> string {
    return "set -eu\n" +
        "if [ \"$1 $2 $3\" = \"remote list --session\" ]; then\n" +
        "    printf '%b' \"${FAKE_JULES_LIST:-}\"\n" +
        "    exit 0\n" +
        "fi\n" +
        "if [ \"$1 $2\" = \"remote new\" ]; then\n" +
        "    cat >/dev/null\n" +
        "    : > \"$" + "{FAKE_NEW_MARKER}\"\n" +
        "    printf 'ID: 12345\\nURL: https://jules.example/session/12345\\n'\n" +
        "    exit 0\n" +
        "fi\n" +
        "echo \"unexpected jules invocation: $*\" >&2\n" +
        "exit 2\n"
}

let mut TOOL: string = ""
let mut WORK: string = ""
let mut FAKE_BIN: string = ""
let mut PASS: i32 = 0
let mut FAIL: i32 = 0
let mut CASE: string = ""
let mut CASE_DIR: string = ""

# Run the dispatcher for case `name` with `extra` VAR=VALUE settings on top
# of the defaults. False after reporting when it exits nonzero.
function run_case(name: string, issues: string, prs: string, extra: ptr<ProcStrs>) -> bool {
    CASE = name
    CASE_DIR = WORK + "/" + name
    let _m: bool = mkdir_p(CASE_DIR)
    let vars: ptr<ProcStrs> = sl_new()
    sl_push2(vars, "PATH=" + FAKE_BIN + ":" + env("PATH"), "FAKE_ISSUES_JSON=" + issues)
    sl_push2(vars, "FAKE_PRS_JSON=" + prs, "FAKE_JULES_LIST=")
    sl_push2(vars, "FAKE_MAIN_CI_JSON=[]", "FAKE_NEW_MARKER=" + CASE_DIR + "/new-session")
    sl_push2(vars, "FAKE_CLAIM_MARKER=" + CASE_DIR + "/claim", "JULES_DISPATCH_NO_SLEEP=1")
    sl_push2(vars, "JULES_MAX_ACTIVE=8", "JULES_MAX_AGENT_PRS=12")
    sl_extend(vars, extra)
    let c: ptr<ProcCmd> = cmd(sl_of1(TOOL))
    tr_cmd_cd(c, CASE_DIR)
    tr_cmd_env_list(c, vars)
    let rc: i32 = tr_run_cmd_files(c, CASE_DIR + "/stdout", CASE_DIR + "/stderr")
    if rc != 0 {
        outln("FAIL " + CASE + ": exit " + s_itoa(rc))
        out(read_text(CASE_DIR + "/stderr"))
        FAIL = FAIL + 1
        return false
    }
    let log: string = CASE_DIR + "/jules_dispatch_decisions.jsonl"
    if not exists(log) {
        let _t: bool = write_text(log, "")
    }
    return true
}

function check(what: string, ok: bool) -> bool {
    if ok {
        return true
    }
    outln("FAIL " + CASE + ": " + what)
    FAIL = FAIL + 1
    return false
}

function has_out(s: string) -> bool {
    return s_contains(read_text(CASE_DIR + "/stdout"), s)
}

function has_decision(s: string) -> bool {
    return s_contains(read_text(CASE_DIR + "/jules_dispatch_decisions.jsonl"), s)
}

function opened() -> bool {
    return exists(CASE_DIR + "/new-session")
}

function claimed() -> bool {
    return exists(CASE_DIR + "/claim")
}

function done_case() {
    outln("ok " + CASE)
    PASS = PASS + 1
}

function issue(n: string, title: string) -> string {
    return "{\"number\":" + n + ",\"title\":\"" + title + "\",\"body\":\"repro\",\"labels\":[]}"
}

function pr(n: string, title: string, body: string, head: string) -> string {
    return "{\"number\":" + n + ",\"title\":\"" + title + "\",\"body\":\"" + body + "\",\"headRefName\":\"" + head + "\",\"isDraft\":false}"
}

function main() -> i32 {
    let _root: string = tr_enter_root()
    # Build the tool once, outside the per-case timing.
    let tc: ptr<ProcCmd> = cmd(sl_of3("./flow", "tool", "--path"))
    proc_arg(tc, "jules_dispatch")
    TOOL = capture(tc)
    if last_status() != 0 {
        cli_exit(last_status())
    }
    WORK = mktemp_dir_default()
    if s_len(WORK) == 0 {
        cli_exit(1)
    }
    on_exit_remove(WORK)
    FAKE_BIN = WORK + "/bin"
    let _b: bool = mkdir_p(FAKE_BIN)
    tr_stub(FAKE_BIN, "gh", fake_gh())
    tr_stub(FAKE_BIN, "jules", fake_jules())
    let fix: string = "Fix compiler regression"

    # The open agent PR limit applies backpressure.
    if run_case("agent_pr_limit", "[" + issue("42", fix) + "]", "[" + pr("7", "Other work", "Created automatically by Jules https://jules.google.com/task/7", "jules/work") + "]", sl_of1("JULES_MAX_AGENT_PRS=1")) {
        if check("backpressure message", has_out("Backpressure: agent PR WIP limit reached")) and check("no session opened", not opened()) and check("backpressure decision", has_decision("\"decision\":\"backpressure\"")) {
            done_case()
        }
    }

    # An open PR for the issue prevents a duplicate dispatch.
    if run_case("open_pr_for_issue", "[" + issue("42", fix) + "]", "[" + pr("7", fix, "Closes #42", "fix/42") + "]", sl_new()) {
        if check("no session opened", not opened()) and check("deferred decision", has_decision("\"decision\":\"deferred\"")) and check("overlap reason", has_decision("overlaps open PR #7")) {
            done_case()
        }
    }

    # Stale local dispatch state is not a permanent claim.
    let _s: bool = mkdir_p(WORK + "/stale_state")
    let _w: bool = write_text(WORK + "/stale_state/jules_dispatch_state.json", "{\"dispatched\": {\"42\": {\"issue\": 42, \"title\": \"Fix compiler regression\", \"session\": \"old\", \"url\": \"\"}}, \"failed\": {}}\n")
    if run_case("stale_state", "[" + issue("42", fix) + "]", "[]", sl_new()) {
        if check("session opened", opened()) and check("issue claimed", claimed()) and check("dispatched decision", has_decision("\"decision\":\"dispatched\"")) {
            done_case()
        }
    }

    # The live session limit stops new work.
    if run_case("live_session_limit", "[" + issue("42", fix) + "]", "[]", sl_of2("FAKE_JULES_LIST=flooooooooooow/flow issue #99 running\\n", "JULES_MAX_ACTIVE=1")) {
        if check("backpressure message", has_out("Backpressure: active Jules session limit reached")) and check("no session opened", not opened()) and check("backpressure decision", has_decision("\"decision\":\"backpressure\"")) {
            done_case()
        }
    }

    # Red main CI pauses cleanup work and keeps repair work.
    let issues: string = "[" + issue("41", "Cleanup unused imports") + "," + issue("42", "Fix CI regression in compiler") + "]"
    if run_case("red_main_ci", issues, "[]", sl_of1("FAKE_MAIN_CI_JSON=[{\"status\": \"completed\", \"conclusion\": \"failure\"}]")) {
        if check("backpressure message", has_out("Backpressure: main CI is red")) and check("repair session opened", opened()) and check("cleanup deferred", has_decision("\"issue\":41,\"decision\":\"deferred\"")) and check("pause reason", has_decision("main CI is red; low-priority work paused")) and check("repair dispatched", has_decision("\"issue\":42,\"decision\":\"dispatched\"")) {
            done_case()
        }
    }

    outln("jules_dispatch tests: pass=" + s_itoa(PASS) + " fail=" + s_itoa(FAIL))
    tr_exit(FAIL)
    return 0
}
