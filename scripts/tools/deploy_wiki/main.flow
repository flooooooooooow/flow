# Build the Flow wiki locally. VPS deploy is disabled; docs ship via GitHub
# Pages.
#
#   flow tool deploy_wiki
#
# CI: .github/workflows/wiki.yml publishes to GitHub Pages at
#   https://flooooooooooow.github.io/flow/
#
# The legacy VPS deploy remains behind FLOW_WIKI_VPS=1 for emergencies only.
# It packs build/wiki into a tarball, uploads it with scp and unpacks it into
# /var/www/transpile on the host.
#
#   WIKI_SSH_HOST       host (default 93.127.202.196)
#   WIKI_SSH_USER       user (default root)
#   WIKI_SSH_PASSWORD   password; AISSH_HOSTINGER_PWD is read too. With a
#                       password the upload needs sshpass. Without one, ssh
#                       uses your keys.

import .text { ft_out, ft_outln, ft_err, ft_errln, ft_eq, ft_len, ft_itoa, ft_slice, ft_from, ft_find_byte, ft_exists, ft_split_lines, ft_list_new, ft_list_push, ft_list_len, ft_list_get, StrList }
import .repo { rp_root }
import std.process { ProcCmd, ProcResult, proc_cmd, proc_arg, proc_env, proc_stdin, proc_stdout, proc_stderr, proc_run, proc_which, proc_getenv, PROC_INHERIT, PROC_CAPTURE, PROC_NULL }

const REMOTE_DIR: string = "/var/www/transpile"
const PAGES_URL: string = "https://flooooooooooow.github.io/flow/"

struct Ssh {
    host: string
    user: string
    password: string
}

extern {
    function malloc(size: i64) -> ptr<void>
}

# `tr -d '[:space:]'`
function strip_space(s: string) -> string {
    let p: ptr<u8> = s as ptr<u8>
    let mut out: string = ""
    let mut start: i32 = 0
    let mut i: i32 = 0
    while p[i] != 0 {
        let c: i32 = p[i] as i32
        if c == 32 or (c >= 9 and c <= 13) {
            out = out + ft_slice(s, start, i)
            start = i + 1
        }
        i = i + 1
    }
    return out + ft_from(s, start)
}

function env_or(name: string, dflt: string) -> string {
    let v: string = proc_getenv(name)
    if ft_len(v) == 0 {
        return dflt
    }
    return v
}

function status_of(r: ptr<ProcResult>) -> i32 {
    if ft_len(r.error) > 0 {
        return 127
    }
    if r.exit_code < 0 {
        return 128 - r.exit_code
    }
    return r.exit_code
}

# Run with every stream passed through; the exit status.
function run_passthrough(c: ptr<ProcCmd>) -> i32 {
    proc_stdin(c, PROC_INHERIT)
    proc_stdout(c, PROC_INHERIT)
    proc_stderr(c, PROC_INHERIT)
    return status_of(proc_run(c))
}

# The ssh or scp command for this host: sshpass -e when a password is set.
function remote_cmd(s: ptr<Ssh>, prog: string) -> ptr<ProcCmd> {
    let mut c: ptr<ProcCmd> = proc_cmd(prog)
    if ft_len(s.password) > 0 {
        c = proc_cmd("sshpass")
        proc_arg(c, "-e")
        proc_arg(c, prog)
        proc_env(c, "SSHPASS", s.password)
    }
    proc_arg(c, "-o")
    proc_arg(c, "StrictHostKeyChecking=no")
    proc_arg(c, "-o")
    proc_arg(c, "UserKnownHostsFile=/dev/null")
    proc_arg(c, "-o")
    proc_arg(c, "ConnectTimeout=30")
    if ft_len(s.password) > 0 {
        proc_arg(c, "-o")
        proc_arg(c, "PreferredAuthentications=password")
        proc_arg(c, "-o")
        proc_arg(c, "PubkeyAuthentication=no")
    } else {
        proc_arg(c, "-o")
        proc_arg(c, "BatchMode=yes")
    }
    return c
}

function manual_deploy(s: ptr<Ssh>, tarball: string) -> void {
    ft_outln("")
    ft_outln("Manual deploy (run from your terminal):")
    ft_outln("  scp " + tarball + " " + s.user + "@" + s.host + ":/tmp/flow-wiki.tgz")
    ft_outln("  ssh " + s.user + "@" + s.host + " 'mkdir -p " + REMOTE_DIR + " && find " + REMOTE_DIR + " -mindepth 1 -delete && tar xzf /tmp/flow-wiki.tgz -C " + REMOTE_DIR + " && rm /tmp/flow-wiki.tgz'")
    ft_outln("")
    ft_outln("Then open https://abhishek-shivakumar.com/transpile/")
}

# Total size of the files under `dir` in MB, one decimal, as
# `find -type f -exec wc -c {} + | awk '... printf "%.1f", s / 1048576'`.
function size_mb(dir: string) -> string {
    let c: ptr<ProcCmd> = proc_cmd("find")
    proc_arg(c, dir)
    proc_arg(c, "-type")
    proc_arg(c, "f")
    proc_arg(c, "-exec")
    proc_arg(c, "wc")
    proc_arg(c, "-c")
    proc_arg(c, "{}")
    proc_arg(c, "+")
    proc_stderr(c, PROC_INHERIT)
    let r: ptr<ProcResult> = proc_run(c)
    let lines: ptr<StrList> = ft_split_lines(r.stdout)
    let mut total: i64 = 0
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let line: string = ft_list_get(lines, i)
        let p: ptr<u8> = line as ptr<u8>
        let mut k: i32 = 0
        while p[k] == 32 or p[k] == 9 {
            k = k + 1
        }
        let mut n: i64 = 0
        while p[k] >= 48 and p[k] <= 57 {
            n = n * 10 + ((p[k] as i64) - 48)
            k = k + 1
        }
        while p[k] == 32 or p[k] == 9 {
            k = k + 1
        }
        if ft_eq(ft_from(line, k), "total") == false {
            total = total + n
        }
        i = i + 1
    }
    let tenths: i64 = (total * 10 + 524288) / 1048576
    return ft_itoa((tenths / 10) as i32) + "." + ft_itoa((tenths % 10) as i32)
}

function main() -> i32 {
    let root: string = rp_root()
    let build: string = root + "/build/wiki"

    let vps_raw: string = strip_space(proc_getenv("FLOW_WIKI_VPS"))
    let vps: bool = ft_eq(vps_raw, "1") or ft_eq(vps_raw, "true") or ft_eq(vps_raw, "yes")
    let s: ptr<Ssh> = malloc(24) as ptr<Ssh>
    s.host = env_or("WIKI_SSH_HOST", "93.127.202.196")
    s.user = env_or("WIKI_SSH_USER", "root")
    s.password = env_or("WIKI_SSH_PASSWORD", proc_getenv("AISSH_HOSTINGER_PWD"))
    if vps {
        # Check the upload tools before spending time on the build.
        if ft_len(s.password) > 0 and ft_len(proc_which("sshpass")) == 0 {
            ft_errln("A password is set (WIKI_SSH_PASSWORD or AISSH_HOSTINGER_PWD) but sshpass is not installed.")
            ft_errln("Install sshpass, or unset the password to use SSH key authentication.")
            return 1
        }
    }

    let b: ptr<ProcCmd> = proc_cmd(root + "/flow")
    proc_arg(b, "tool")
    proc_arg(b, "build_wiki")
    let brc: i32 = run_passthrough(b)
    if brc != 0 {
        return brc
    }

    if ft_exists(build) == false {
        ft_errln("Build directory missing")
        return 1
    }

    if vps == false {
        ft_outln("Wiki built → " + build)
        ft_outln("VPS deploy disabled. Docs publish via GitHub Pages:")
        ft_outln("  " + PAGES_URL)
        ft_outln("Preview locally:  ./flow tool wiki_browser serve build/wiki 8777")
        ft_outln("Emergency VPS:    FLOW_WIKI_VPS=1 ./flow tool deploy_wiki")
        return 0
    }

    let tarball: string = root + "/build/flow-wiki-deploy.tgz"
    let mut pf_note: string = " (no Pagefind, local search only)"
    if ft_exists(build + "/pagefind/pagefind.js") {
        pf_note = " incl. Pagefind"
    }
    ft_outln("Packaging wiki (" + size_mb(build) + " MB" + pf_note + ") → " + tarball)
    let t: ptr<ProcCmd> = proc_cmd("tar")
    proc_arg(t, "czf")
    proc_arg(t, tarball)
    proc_arg(t, "-C")
    proc_arg(t, build)
    proc_arg(t, ".")
    let trc: i32 = run_passthrough(t)
    if trc != 0 {
        return trc
    }

    ft_outln("Testing SSH to " + s.host + "…")
    let ping: ptr<ProcCmd> = remote_cmd(s, "ssh")
    proc_arg(ping, s.user + "@" + s.host)
    proc_arg(ping, "echo connected")
    proc_stdout(ping, PROC_NULL)
    proc_stderr(ping, PROC_CAPTURE)
    let pr: ptr<ProcResult> = proc_run(ping)
    if status_of(pr) != 0 {
        let mut err: string = pr.stderr
        let mut n: i32 = ft_len(err)
        let ep: ptr<u8> = err as ptr<u8>
        while n > 0 and ep[n - 1] == 10 {
            n = n - 1
        }
        err = ft_slice(err, 0, n)
        if ft_len(err) == 0 {
            err = "ssh failed"
        }
        ft_errln("")
        ft_errln("❌ SSH unreachable: " + err)
        manual_deploy(s, tarball)
        return 1
    }

    ft_outln("Uploading to " + s.host + ":" + REMOTE_DIR + " …")
    let up: ptr<ProcCmd> = remote_cmd(s, "scp")
    proc_arg(up, tarball)
    proc_arg(up, s.user + "@" + s.host + ":/tmp/flow-wiki.tgz")
    if run_passthrough(up) != 0 {
        return 1
    }

    let extract: string = "mkdir -p " + REMOTE_DIR + " && find " + REMOTE_DIR + " -mindepth 1 -delete && tar xzf /tmp/flow-wiki.tgz -C " + REMOTE_DIR + " && rm /tmp/flow-wiki.tgz && echo deployed && wc -c " + REMOTE_DIR + "/index.html"
    let ex: ptr<ProcCmd> = remote_cmd(s, "ssh")
    proc_arg(ex, s.user + "@" + s.host)
    proc_arg(ex, extract)
    let rc: i32 = run_passthrough(ex)
    if rc != 0 {
        return rc
    }

    ft_outln("✅ Live → https://abhishek-shivakumar.com/flow/")
    ft_outln("   also → https://abhishek-shivakumar.com/transpile/")
    return 0
}
