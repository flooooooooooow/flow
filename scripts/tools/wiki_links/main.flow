# Validate internal links in the built wiki under build/wiki.
#
# Run through scripts/check_wiki_links.sh after scripts/build_wiki.sh. The
# shim lists the tree with find(1), since Flow cannot read directories:
#
#   build/wiki-links/entries.txt   every path under build/wiki, find order
#   build/wiki-links/dirs.txt      the directories among them
#
# Pages are visited in the order Python 3.12's Path.rglob("*.md") yields
# them, rebuilt from the per-directory order find reports, so the report
# lists broken links in the same order the Python checker did.

import .text { ft_out, ft_outln, ft_err, ft_errln, ft_eq, ft_len, ft_itoa, ft_read_file, ft_exists, ft_starts, ft_ends, ft_slice, ft_from, ft_find_byte, ft_split_lines, ft_normpath, ft_dirname, ft_basename, ft_list_new, ft_list_push, ft_list_len, ft_list_get, ft_set_new, ft_set_add, ft_set_has, ft_map_new, ft_map_get, ft_map_put, StrList, StrSet, StrMap }
import .unicode { uc_strip }

extern {
    function malloc(size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
    function getcwd(buf: ptr<i8>, size: i64) -> ptr<i8>
}

const WIKI_REL: string = "build/wiki"
const ENTRIES: string = "build/wiki-links/entries.txt"
const DIRS: string = "build/wiki-links/dirs.txt"

function cwd() -> string {
    let buf: ptr<i8> = malloc(4096) as ptr<i8>
    let got: ptr<i8> = getcwd(buf, 4096)
    if got == null {
        return "."
    }
    return buf as string
}

# Repo paths that are intentionally linked from docs but not mirrored into
# the wiki.
function has_repo_prefix(s: string) -> bool {
    return ft_starts(s, "examples/") or ft_starts(s, "benchmarks/") or ft_starts(s, "compiler/") or ft_starts(s, "runtime/") or ft_starts(s, "lib/") or ft_starts(s, "src/") or ft_starts(s, "tests/") or ft_starts(s, "plugins/") or ft_starts(s, "scripts/") or ft_starts(s, "registry/")
}

function is_under(path: string, root: string) -> bool {
    return ft_eq(path, root) or ft_starts(path, root + "/")
}

# (base / rel) resolved lexically. An absolute `rel` replaces the base.
function resolve_under(base: string, rel: string) -> string {
    if ft_starts(rel, "/") {
        return ft_normpath(rel)
    }
    return ft_normpath(base + "/" + rel)
}

function has_md_suffix(path: string) -> bool {
    # Path.suffix is ".md" only when the final name is more than ".md".
    let name: string = ft_basename(path)
    return ft_ends(name, ".md") and ft_len(name) > 3
}

# True when the link is fine: it resolves to something that exists, or is a
# kind of link this checker skips.
function link_ok(root: string, wiki: string, source: string, raw: string) -> bool {
    let hash: i32 = ft_find_byte(raw, 35, 0)
    let mut href: string = raw
    if hash >= 0 {
        href = ft_slice(raw, 0, hash)
    }
    href = uc_strip(href)
    if ft_len(href) == 0 or ft_starts(href, "http://") or ft_starts(href, "https://") or ft_starts(href, "mailto:") or ft_starts(href, "#") {
        return true
    }
    if ft_ends(href, ".html") {
        return true
    }

    let parent: string = ft_dirname(source)
    let mut base: string = wiki
    if ft_len(parent) > 0 {
        base = wiki + "/" + parent
    }
    let relative: string = resolve_under(base, href)
    if is_under(relative, wiki) and ft_exists(relative) {
        return true
    }

    # Repo-root docs/ links still appear in some project pages before rewrite.
    if ft_starts(href, "docs/") {
        let stripped: string = resolve_under(wiki, ft_from(href, 5))
        if is_under(stripped, wiki) {
            return ft_exists(stripped)
        }
    }

    let absolute: string = resolve_under(wiki, href)
    if is_under(absolute, wiki) and ft_exists(absolute) {
        return true
    }

    # Repo-root links to real tracked files outside the wiki tree.
    if has_repo_prefix(href) or ft_eq(href, "VISION.md") or ft_eq(href, "ROADMAP.md") {
        let repo_target: string = resolve_under(root, href)
        if is_under(repo_target, root) and ft_exists(repo_target) {
            return true
        }
    }

    # A page copied out of the repo (examples/**/README.md) links to its
    # siblings by bare name. wiki.js sends every non-.md file under a source
    # directory to GitHub, so the file has to exist in the repo.
    if has_repo_prefix(source) {
        let mut sbase: string = root
        if ft_len(parent) > 0 {
            sbase = root + "/" + parent
        }
        let sibling: string = resolve_under(sbase, href)
        if is_under(sibling, root) and ft_exists(sibling) and has_md_suffix(sibling) == false {
            return true
        }
    }

    if is_under(absolute, wiki) {
        return false
    }
    return true
}

# LINK_RE = \[[^\]]+\]\(([^)]+)\), every non-overlapping match in order.
function find_links(text: string) -> ptr<StrList> {
    let out: ptr<StrList> = ft_list_new()
    let p: ptr<u8> = text as ptr<u8>
    let n: i32 = ft_len(text)
    let mut i: i32 = 0
    while i < n {
        if p[i] != 91 {
            i = i + 1
            continue
        }
        let close: i32 = ft_find_byte(text, 93, i + 1)
        if close < 0 {
            break
        }
        if close == i + 1 or p[close + 1] != 40 {
            i = i + 1
            continue
        }
        let end: i32 = ft_find_byte(text, 41, close + 2)
        if end < 0 {
            break
        }
        if end == close + 2 {
            i = i + 1
            continue
        }
        ft_list_push(out, ft_slice(text, close + 2, end))
        i = end + 1
    }
    return out
}

# ---------------------------------------------------------------------------
# Python 3.12 Path.rglob("*.md") order
# ---------------------------------------------------------------------------

struct Tree {
    names: ptr<string>
    paths: ptr<string>
    first: ptr<i32>
    last: ptr<i32>
    next: ptr<i32>
    isdir: ptr<i32>
    count: i32
}

function tree_build(entries: ptr<StrList>, dirs: ptr<StrSet>) -> ptr<Tree> {
    let n: i32 = ft_list_len(entries)
    let t: ptr<Tree> = malloc(64) as ptr<Tree>
    t[0].names = malloc((n as i64) * 8 + 8) as ptr<string>
    t[0].paths = malloc((n as i64) * 8 + 8) as ptr<string>
    t[0].first = malloc((n as i64) * 4 + 4) as ptr<i32>
    t[0].last = malloc((n as i64) * 4 + 4) as ptr<i32>
    t[0].next = malloc((n as i64) * 4 + 4) as ptr<i32>
    t[0].isdir = malloc((n as i64) * 4 + 4) as ptr<i32>
    t[0].count = n
    let names: ptr<string> = t[0].names
    let paths: ptr<string> = t[0].paths
    let first: ptr<i32> = t[0].first
    let last: ptr<i32> = t[0].last
    let next: ptr<i32> = t[0].next
    let isdir: ptr<i32> = t[0].isdir
    let index: ptr<StrMap> = ft_map_new()
    let mut i: i32 = 0
    while i < n {
        let path: string = ft_list_get(entries, i)
        paths[i] = path
        names[i] = ft_basename(path)
        first[i] = -1
        last[i] = -1
        next[i] = -1
        isdir[i] = 0
        if ft_set_has(dirs, path) {
            isdir[i] = 1
        }
        ft_map_put(index, path, i)
        if i > 0 {
            let parent: i32 = ft_map_get(index, ft_dirname(path), -1)
            if parent >= 0 {
                if first[parent] < 0 {
                    first[parent] = i
                } else {
                    next[last[parent]] = i
                }
                last[parent] = i
            }
        }
        i = i + 1
    }
    return t
}

# Entry indexes of the *.md pages, in rglob order.
function rglob_md(t: ptr<Tree>) -> ptr<i32> {
    let n: i32 = t[0].count
    let first: ptr<i32> = t[0].first
    let next: ptr<i32> = t[0].next
    let isdir: ptr<i32> = t[0].isdir
    let names: ptr<string> = t[0].names

    # _iterate_directories: the root, then every directory Path.walk visits
    # yields its subdirectories in scandir order. walk is a pre-order DFS.
    let starts: ptr<i32> = malloc((n as i64) * 4 + 4) as ptr<i32>
    let mut nstarts: i32 = 0
    starts[nstarts] = 0
    nstarts = nstarts + 1
    let stack: ptr<i32> = malloc((n as i64) * 4 + 4) as ptr<i32>
    let mut sp: i32 = 0
    stack[sp] = 0
    sp = sp + 1
    let tmp: ptr<i32> = malloc((n as i64) * 4 + 4) as ptr<i32>
    while sp > 0 {
        sp = sp - 1
        let d: i32 = stack[sp]
        let mut nd: i32 = 0
        let mut c: i32 = first[d]
        while c >= 0 {
            if isdir[c] == 1 {
                starts[nstarts] = c
                nstarts = nstarts + 1
                tmp[nd] = c
                nd = nd + 1
            }
            c = next[c]
        }
        while nd > 0 {
            nd = nd - 1
            stack[sp] = tmp[nd]
            sp = sp + 1
        }
    }

    # _WildcardSelector: each starting point's entries in scandir order.
    let out: ptr<i32> = malloc((n as i64) * 4 + 8) as ptr<i32>
    let mut o: i32 = 0
    let mut s: i32 = 0
    while s < nstarts {
        let mut c2: i32 = first[starts[s]]
        while c2 >= 0 {
            if ft_ends(names[c2], ".md") {
                out[o + 1] = c2
                o = o + 1
            }
            c2 = next[c2]
        }
        s = s + 1
    }
    out[0] = o
    return out
}

function main() -> i32 {
    let root: string = cwd()
    let wiki: string = root + "/" + WIKI_REL
    if ft_exists(wiki) == false {
        ft_errln("Run scripts/build_wiki.sh first")
        return 1
    }
    let entries_text: string = ft_read_file(ENTRIES)
    let dirs_text: string = ft_read_file(DIRS)
    if entries_text == null or dirs_text == null {
        ft_errln("check_wiki_links: missing " + ENTRIES + "; run scripts/check_wiki_links.sh")
        return 1
    }
    let entries: ptr<StrList> = ft_split_lines(entries_text)
    let dir_list: ptr<StrList> = ft_split_lines(dirs_text)
    let dirs: ptr<StrSet> = ft_set_new()
    let mut i: i32 = 0
    while i < ft_list_len(dir_list) {
        ft_set_add(dirs, ft_list_get(dir_list, i))
        i = i + 1
    }
    if ft_list_len(entries) == 0 or ft_eq(ft_list_get(entries, 0), WIKI_REL) == false {
        ft_errln("check_wiki_links: " + ENTRIES + " must start with " + WIKI_REL)
        return 1
    }

    let t: ptr<Tree> = tree_build(entries, dirs)
    let pages: ptr<i32> = rglob_md(t)
    let paths: ptr<string> = t[0].paths
    let prefix_len: i32 = ft_len(WIKI_REL) + 1

    let errors: ptr<StrList> = ft_list_new()
    let mut k: i32 = 0
    while k < pages[0] {
        let full: string = paths[pages[k + 1]]
        let rel: string = ft_from(full, prefix_len)
        if ft_eq(rel, "README.md") or ft_eq(rel, "mkdocs.yml") {
            k = k + 1
            continue
        }
        let text: string = ft_read_file(full)
        if text != null {
            let links: ptr<StrList> = find_links(text)
            let mut li: i32 = 0
            while li < ft_list_len(links) {
                let href: string = ft_list_get(links, li)
                if link_ok(root, wiki, rel, href) == false {
                    ft_list_push(errors, rel + ": broken link → " + href)
                }
                li = li + 1
            }
        }
        k = k + 1
    }

    let nerr: i32 = ft_list_len(errors)
    if nerr > 0 {
        ft_errln("Found " + ft_itoa(nerr) + " broken link(s):")
        let mut e: i32 = 0
        while e < nerr and e < 40 {
            ft_errln("  " + ft_list_get(errors, e))
            e = e + 1
        }
        if nerr > 40 {
            ft_errln("  … and " + ft_itoa(nerr - 40) + " more")
        }
        return 1
    }
    ft_outln("Wiki links OK")
    return 0
}
