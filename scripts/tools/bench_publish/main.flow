# Benchmark harness for the published Flow results.
#
# Compiles and runs the programs under benchmarks/publish/ in Flow, C, Rust
# and Python, then writes benchmarks/RESULTS.md. Run through
# benchmarks/run_publish.sh:
#
#   run_publish.sh            full run, writes RESULTS.md
#   run_publish.sh --quick    1 repetition, no report
#   run_publish.sh --reps N
#
# Method:
# - Each program times only its workload with a monotonic clock and prints
#   "result <value>" and "seconds <t>". Compile and process startup time are
#   excluded from the reported numbers.
# - Each program runs once as a warmup, then a fixed number of timed
#   repetitions (default 5). The median is reported, with min and max.
# - Flow-generated C and hand-written C are compiled by the same clang with
#   the same flags.
# - Results are checked for agreement across languages before the report is
#   written.

import .text { ft_out, ft_outln, ft_err, ft_errln, ft_eq, ft_len, ft_read_file, ft_write_file, ft_starts, ft_find, ft_slice, ft_from, ft_join, ft_split_lines, ft_list_new, ft_list_push, ft_list_len, ft_list_get, ft_ljust, StrList }
import .proc { pr_quote, pr_capture, pr_chomp, pr_mkdir_p }
import .bench { bn_now, bn_fixed, bn_median, bn_min, bn_max, bn_run, bn_code, bn_out, bn_wall, bn_result, bn_seconds, bn_has_seconds, bn_parse_float, bn_strip, BenchRun }

extern {
    function malloc(size: i64) -> ptr<void>
    function getenv(name: string) -> string
    function setenv(name: string, value: string, overwrite: i32) -> i32
    function chdir(path: string) -> i32
    function exit(code: i32) -> void
    function atoi(s: string) -> i32
}

const NB: i32 = 5
const NL: i32 = 4
# measurement order, as the Python dict held them
const L_C: i32 = 0
const L_FLOW: i32 = 1
const L_PY: i32 = 2
const L_RUST: i32 = 3

struct Data {
    secs: ptr<ptr<f64>>
    results: ptr<string>
    reps: i32
    t_c: ptr<f64>
    t_transpile: ptr<f64>
    t_clang: ptr<f64>
    t_rust: ptr<f64>
}

function root() -> string {
    let r: string = getenv("FLOW_REPO_ROOT")
    if r as ptr<u8> == null or ft_len(r) == 0 {
        return "."
    }
    return r
}

function bench(i: i32) -> string {
    if i == 0 {
        return "fib"
    }
    if i == 1 {
        return "nbody"
    }
    if i == 2 {
        return "matmul"
    }
    if i == 3 {
        return "spectral"
    }
    return "mandelbrot"
}

function description(i: i32) -> string {
    if i == 0 {
        return "Naive recursive Fibonacci, fib(35). Function call overhead."
    }
    if i == 1 {
        return "Outer solar system, 5 bodies, 1,000,000 steps (Benchmarks Game)."
    }
    if i == 2 {
        return "Dense matrix multiply, naive triple loop, 300x300 doubles."
    }
    if i == 3 {
        return "Spectral norm, N=500, 10 power iterations (Benchmarks Game)."
    }
    return "Mandelbrot membership count, 400x400 grid, 100 iterations."
}

function lang_key(l: i32) -> string {
    if l == L_C {
        return "c"
    }
    if l == L_FLOW {
        return "flow"
    }
    if l == L_PY {
        return "python"
    }
    return "rust"
}

function lang_name(l: i32) -> string {
    if l == L_C {
        return "C"
    }
    if l == L_FLOW {
        return "Flow"
    }
    if l == L_PY {
        return "Python"
    }
    return "Rust"
}

function pub_dir() -> string {
    return ft_join(root(), "benchmarks/publish")
}

function build_dir() -> string {
    return pub_dir() + "/build"
}

function argv_of(items: string) -> ptr<StrList> {
    # space-separated, no quoting needed: every piece is a flag or an
    # absolute path without spaces checked by the caller
    let out: ptr<StrList> = ft_list_new()
    let p: ptr<u8> = items as ptr<u8>
    let mut start: i32 = 0
    let mut i: i32 = 0
    let n: i32 = ft_len(items)
    while i <= n {
        if i == n or p[i] == 9 {
            if i > start {
                ft_list_push(out, ft_slice(items, start, i))
            }
            start = i + 1
        }
        i = i + 1
    }
    return out
}

# subprocess.run(check=True) timed from spawn to exit. Arguments are
# separated by tabs so paths with spaces survive.
function timed(args: string) -> f64 {
    let argv: ptr<StrList> = argv_of(args)
    let r: ptr<BenchRun> = bn_run(argv)
    if bn_code(r) != 0 {
        ft_errln("run_publish: command failed (" + bn_fixed(bn_code(r) as f64, 0) + "): " + ft_list_get(argv, 0))
        exit(1)
    }
    return bn_wall(r)
}

function compile_all(d: ptr<Data>, have_rust: bool) -> void {
    let _m: bool = pr_mkdir_p(build_dir())
    let tc: ptr<f64> = d[0].t_c
    let tt: ptr<f64> = d[0].t_transpile
    let tl: ptr<f64> = d[0].t_clang
    let tr: ptr<f64> = d[0].t_rust
    let mut b: i32 = 0
    while b < NB {
        let name: string = bench(b)
        let bd: string = build_dir()
        tc[b] = timed("clang\t-O3\t-march=native\t-lm\t" + pub_dir() + "/c/" + name + ".c\t-o\t" + bd + "/" + name + "_c")
        let gen_c: string = bd + "/" + name + "_flow.c"
        tt[b] = timed(root() + "/compiler/scripts/flowc_emit.sh\t--lenient\t" + pub_dir() + "/flow/" + name + ".flow\t" + gen_c)
        tl[b] = timed("clang\t-O3\t-march=native\t-lm\t" + gen_c + "\t-o\t" + bd + "/" + name + "_flow")
        if have_rust {
            tr[b] = timed("rustc\t-C\topt-level=3\t-C\ttarget-cpu=native\t" + pub_dir() + "/rust/" + name + ".rs\t-o\t" + bd + "/" + name + "_rust")
        }
        b = b + 1
    }
}

function command_for(b: i32, l: i32) -> string {
    let name: string = bench(b)
    if l == L_PY {
        return "python3\t" + pub_dir() + "/python/" + name + ".py"
    }
    if l == L_C {
        return build_dir() + "/" + name + "_c"
    }
    if l == L_FLOW {
        return build_dir() + "/" + name + "_flow"
    }
    return build_dir() + "/" + name + "_rust"
}

function run_once(cmd: string, slot: ptr<f64>, result: ptr<string>) -> void {
    let argv: ptr<StrList> = argv_of(cmd)
    let r: ptr<BenchRun> = bn_run(argv)
    if bn_code(r) != 0 {
        ft_errln("run_publish: command failed (" + bn_fixed(bn_code(r) as f64, 0) + "): " + ft_list_get(argv, 0))
        exit(1)
    }
    if bn_result(r) as ptr<u8> == null or bn_has_seconds(r) == false {
        ft_errln("bad output from " + ft_list_get(argv, 0) + ": " + bn_out(r))
        exit(1)
    }
    slot[0] = bn_seconds(r)
    result[0] = bn_result(r)
}

function measure(d: ptr<Data>, have_rust: bool) -> void {
    let scratch: ptr<f64> = malloc(8) as ptr<f64>
    let res: ptr<string> = malloc(8) as ptr<string>
    let mut b: i32 = 0
    while b < NB {
        let mut l: i32 = 0
        while l < NL {
            if l != L_RUST or have_rust {
                ft_outln("  " + bench(b) + " / " + lang_key(l) + " ...")
                let cmd: string = command_for(b, l)
                run_once(cmd, scratch, res)
                let xs: ptr<f64> = malloc(((d[0].reps + 1) as i64) * 8) as ptr<f64>
                let mut k: i32 = 0
                while k < d[0].reps {
                    run_once(cmd, scratch, res)
                    xs[k] = scratch[0]
                    k = k + 1
                }
                let all_secs: ptr<ptr<f64>> = d[0].secs
                let all_res: ptr<string> = d[0].results
                all_secs[b * NL + l] = xs
                all_res[b * NL + l] = res[0]
            }
            l = l + 1
        }
        b = b + 1
    }
}

function abs_f(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 - x
    }
    return x
}

function results_agree(d: ptr<Data>, b: i32, have_rust: bool) -> bool {
    let reff: f64 = bn_parse_float(d[0].results[b * NL + L_C])
    let mut denom: f64 = abs_f(reff)
    if denom < 0.000000000001 {
        denom = 0.000000000001
    }
    let mut l: i32 = 1
    while l < NL {
        if l != L_RUST or have_rust {
            let f: f64 = bn_parse_float(d[0].results[b * NL + l])
            if abs_f(f - reff) / denom > 0.000001 {
                return false
            }
        }
        l = l + 1
    }
    return true
}

function out_or_unknown(cmd: string) -> string {
    let s: string = bn_strip(pr_capture(cmd + " 2>/dev/null || echo __unknown__"))
    if ft_eq(s, "__unknown__") or ft_len(s) == 0 {
        return "unknown"
    }
    return s
}

function first_line(s: string) -> string {
    let lines: ptr<StrList> = ft_split_lines(s)
    if ft_list_len(lines) == 0 {
        return ""
    }
    return ft_list_get(lines, 0)
}

function median_of(d: ptr<Data>, b: i32, l: i32) -> f64 {
    return bn_median(d[0].secs[b * NL + l], d[0].reps)
}

function write_report(d: ptr<Data>, have_rust: bool, path: string) -> void {
    # environment
    let system: string = pr_chomp(pr_capture("uname -s"))
    let mut cpu: string = "Unknown CPU"
    let mut ncpu: string = "1"
    let mut mem_gb: string = "0"
    if ft_eq(system, "Darwin") {
        cpu = out_or_unknown("sysctl -n machdep.cpu.brand_string")
        let nc: string = out_or_unknown("sysctl -n hw.ncpu")
        if ft_eq(nc, "unknown") == false {
            ncpu = nc
        }
        let mem: string = out_or_unknown("sysctl -n hw.memsize")
        if ft_eq(mem, "unknown") == false {
            mem_gb = bn_fixed(((bn_parse_float(mem) / 1073741824.0) as i64) as f64, 0)
        }
    } elif ft_eq(system, "Linux") {
        let model: string = out_or_unknown("grep -m1 'model name' /proc/cpuinfo | cut -d: -f2-")
        if ft_eq(model, "unknown") == false {
            cpu = model
        }
        ncpu = out_or_unknown("getconf _NPROCESSORS_ONLN")
        let kb: string = out_or_unknown("awk '/MemTotal/ {print $2; exit}' /proc/meminfo")
        if ft_eq(kb, "unknown") == false {
            mem_gb = bn_fixed(((bn_parse_float(kb) / 1048576.0) as i64) as f64, 0)
        }
    }
    let mut clang_v: string = out_or_unknown("clang --version")
    if ft_eq(clang_v, "unknown") == false {
        clang_v = first_line(clang_v)
    }
    let python_v: string = out_or_unknown("python3 --version")
    let mut rust_v: string = "not installed"
    if have_rust {
        rust_v = out_or_unknown("rustc --version")
    }
    let today: string = pr_chomp(pr_capture("date +%Y-%m-%d"))

    let order: ptr<i32> = malloc(16) as ptr<i32>
    let mut n: i32 = 0
    order[n] = L_FLOW
    n = n + 1
    order[n] = L_C
    n = n + 1
    if have_rust {
        order[n] = L_RUST
        n = n + 1
    }
    order[n] = L_PY
    n = n + 1

    let mut o: string = "# Flow benchmark results\n\n"
    o = o + "Date: " + today + "\n\n"
    o = o + "Flow compiles to C. The comparison that matters is Flow against\n"
    o = o + "hand-written C built by the same clang with the same flags. Rust and\n"
    o = o + "plain CPython run the same algorithms at the same sizes for context.\n\n"
    o = o + "## Summary\n\n"
    let mut header: string = "| Benchmark | "
    let mut i: i32 = 0
    while i < n {
        if i > 0 {
            header = header + " | "
        }
        header = header + lang_name(order[i]) + " median (s)"
        i = i + 1
    }
    o = o + header + " | Flow / C |\n"
    let mut sep: string = "|"
    i = 0
    while i < n + 2 {
        sep = sep + "---|"
        i = i + 1
    }
    o = o + sep + "\n"
    let mut b: i32 = 0
    while b < NB {
        let ratio: f64 = median_of(d, b, L_FLOW) / median_of(d, b, L_C)
        let mut row: string = "| " + bench(b) + " | "
        i = 0
        while i < n {
            if i > 0 {
                row = row + " | "
            }
            row = row + bn_fixed(median_of(d, b, order[i]), 4)
            i = i + 1
        }
        o = o + row + " | " + bn_fixed(ratio, 2) + "x |\n"
        b = b + 1
    }
    o = o + "\n"
    o = o + "Flow / C below 1.00x means the Flow binary was faster on that run.\n"
    o = o + "Differences within a few percent are run-to-run noise.\n\n"
    o = o + ft_read_file_or(ft_join(root(), "scripts/tools/bench_publish/notes.md"))
    o = o + "## Benchmarks\n\n"
    b = 0
    while b < NB {
        o = o + "### " + bench(b) + "\n\n" + description(b) + "\n\n"
        o = o + "| Language | Median (s) | Min (s) | Max (s) | Result |\n"
        o = o + "|---|---|---|---|---|\n"
        i = 0
        while i < n {
            let l: i32 = order[i]
            let xs: ptr<f64> = d[0].secs[b * NL + l]
            o = o + "| " + lang_name(l) + " | " + bn_fixed(bn_median(xs, d[0].reps), 4) + " | " + bn_fixed(bn_min(xs, d[0].reps), 4) + " | " + bn_fixed(bn_max(xs, d[0].reps), 4) + " | " + d[0].results[b * NL + l] + " |\n"
            i = i + 1
        }
        o = o + "\n"
        b = b + 1
    }
    o = o + "## Compile time\n\n"
    o = o + "Measured once per benchmark. Compile time is excluded from every\n"
    o = o + "workload number.\n\n"
    if have_rust {
        o = o + "| Benchmark | Flow transpile (s) | clang on generated C (s) | clang on hand C (s) | rustc (s) |\n"
        o = o + "|---|---|---|---|---|\n"
    } else {
        o = o + "| Benchmark | Flow transpile (s) | clang on generated C (s) | clang on hand C (s) |\n"
        o = o + "|---|---|---|---|\n"
    }
    b = 0
    while b < NB {
        let mut row2: string = "| " + bench(b) + " | " + bn_fixed(d[0].t_transpile[b], 2) + " | " + bn_fixed(d[0].t_clang[b], 2) + " | " + bn_fixed(d[0].t_c[b], 2)
        if have_rust {
            row2 = row2 + " | " + bn_fixed(d[0].t_rust[b], 2)
        }
        o = o + row2 + " |\n"
        b = b + 1
    }
    o = o + "\n## Method\n\n"
    o = o + "- Each program times only its workload with a monotonic clock and\n"
    o = o + "  prints the elapsed seconds itself. Compiler time, transpile time,\n"
    o = o + "  and process startup are excluded.\n"
    o = o + "- One warmup run, then " + bn_fixed(d[0].reps as f64, 0) + " timed repetitions per program.\n"
    o = o + "  Median, min, and max of the timed repetitions are reported.\n"
    o = o + "- Identical algorithms, data sizes, and double precision floats in\n"
    o = o + "  every language. Sources live in benchmarks/publish/.\n"
    o = o + "- Flow-generated C and hand-written C are compiled by the same\n"
    o = o + "  clang with the same flags: `-O3 -march=native`.\n"
    o = o + "  `-ffast-math` is not used.\n"
    if have_rust {
        o = o + "- Rust: `rustc -C opt-level=3 -C target-cpu=native`, one source file per\n"
        o = o + "  benchmark, compiled directly with rustc.\n"
    }
    o = o + "- Python is plain CPython without numpy.\n"
    o = o + "- Result values are printed by every program and checked for\n"
    o = o + "  agreement across languages before this report is written.\n"
    o = o + "- The machine was otherwise idle.\n\n"
    o = o + "## Environment\n\n"
    o = o + "- CPU: " + cpu + ", " + ncpu + " cores, " + mem_gb + " GB RAM\n"
    o = o + "- C compiler: " + clang_v + "\n"
    o = o + "- Python: " + python_v + "\n"
    o = o + "- Rust: " + rust_v + "\n\n"
    o = o + "## Reproduce\n\n"
    o = o + "```bash\n./benchmarks/run_publish.sh\n```\n\n"
    o = o + "This regenerates benchmarks/RESULTS.md in place. A full run takes\n"
    o = o + "a few minutes; most of that is the Python repetitions.\n"
    if ft_write_file(path, o) == false {
        ft_errln("run_publish: cannot write " + path)
        exit(1)
    }
    ft_outln("wrote " + path)
}

function ft_read_file_or(path: string) -> string {
    let t: string = ft_read_file(path)
    if t as ptr<u8> == null {
        return ""
    }
    return t
}

function main(argc: i32, argv: ptr<ptr<u8>>) -> i32 {
    let mut quick: bool = false
    let mut reps: i32 = 5
    let mut i: i32 = 1
    while i < argc {
        let a: string = argv[i] as string
        if ft_eq(a, "--quick") {
            quick = true
        } elif ft_eq(a, "--reps") and i + 1 < argc {
            reps = atoi(argv[i + 1] as string)
            i = i + 1
        } elif ft_starts(a, "--reps=") {
            reps = atoi(ft_from(a, 7))
        } elif ft_eq(a, "-h") or ft_eq(a, "--help") {
            ft_outln("usage: run_publish.sh [-h] [--quick] [--reps REPS]")
            return 0
        } else {
            ft_errln("usage: run_publish.sh [-h] [--quick] [--reps REPS]")
            ft_errln("run_publish.sh: error: unrecognized arguments: " + a)
            return 2
        }
        i = i + 1
    }
    if quick {
        reps = 1
    }
    let _c: i32 = chdir(root())

    let have_rust: bool = ft_len(pr_chomp(pr_capture("command -v rustc"))) > 0
    if have_rust == false {
        ft_outln("rustc not found; skipping Rust")
    }

    let d: ptr<Data> = malloc(64) as ptr<Data>
    d[0].reps = reps
    d[0].secs = malloc(((NB * NL) as i64) * 8) as ptr<ptr<f64>>
    d[0].results = malloc(((NB * NL) as i64) * 8) as ptr<string>
    d[0].t_c = malloc((NB as i64) * 8) as ptr<f64>
    d[0].t_transpile = malloc((NB as i64) * 8) as ptr<f64>
    d[0].t_clang = malloc((NB as i64) * 8) as ptr<f64>
    d[0].t_rust = malloc((NB as i64) * 8) as ptr<f64>

    ft_outln("compiling ...")
    compile_all(d, have_rust)
    ft_outln("running (" + bn_fixed(reps as f64, 0) + " reps + 1 warmup each) ...")
    measure(d, have_rust)

    let mut ok: bool = true
    let mut b: i32 = 0
    while b < NB {
        if results_agree(d, b, have_rust) == false {
            ok = false
            let mut line: string = "RESULT MISMATCH in " + bench(b) + ": "
            let mut l: i32 = 0
            while l < NL {
                if l != L_RUST or have_rust {
                    if l > 0 {
                        line = line + ", "
                    }
                    line = line + lang_key(l) + "=" + d[0].results[b * NL + l]
                }
                l = l + 1
            }
            ft_outln(line)
        }
        b = b + 1
    }
    if ok == false {
        return 1
    }
    ft_outln("all results agree across languages")

    if quick {
        b = 0
        while b < NB {
            let mut l2: i32 = 0
            while l2 < NL {
                if l2 != L_RUST or have_rust {
                    let xs: ptr<f64> = d[0].secs[b * NL + l2]
                    ft_outln(ft_ljust(bench(b), 12) + " " + ft_ljust(lang_key(l2), 8) + " " + bn_fixed(xs[0], 4) + "s result=" + d[0].results[b * NL + l2])
                }
                l2 = l2 + 1
            }
            b = b + 1
        }
        return 0
    }
    write_report(d, have_rust, ft_join(root(), "benchmarks/RESULTS.md"))
    return 0
}
