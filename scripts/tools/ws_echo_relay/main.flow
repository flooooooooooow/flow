# A WebSocket echo relay for the WASM sockets demo.
#
# A browser cannot open a TCP socket. It can open a WebSocket, which is an
# HTTP request that upgrades into a framed, bidirectional byte stream.
# Emscripten bridges BSD sockets onto exactly that: `connect(fd,
# 127.0.0.1:9505)` inside a WASM module opens `ws://127.0.0.1:9505/`, and
# every `send`/`recv` becomes a binary WebSocket frame.
#
# So a Flow program calling the ordinary socket API reaches this relay,
# which sends every frame straight back. Nothing here is Flow-specific; any
# WebSocket echo server works. It is in the tree so the demo has no
# dependencies.
#
#     ./flow tool ws_echo_relay --port 9505
#
# Also speaks plain TCP echo on --tcp-port, so the same Flow program can be
# run natively against the same relay for comparison.
#
# The handshake is RFC 6455 section 4.2.2: the reply carries
# base64(SHA-1(Sec-WebSocket-Key + GUID)). Frames from the client are masked;
# frames back are not. Each connection is served by its own forked child.

import .text { ft_out, ft_outln, ft_err, ft_errln, ft_eq, ft_len, ft_itoa, ft_starts, ft_from, ft_slice, ft_ascii_lower }
import .net { nt_listen, nt_wait_readable, nt_accept, nt_peer_new, nt_peer_ip, nt_peer_port, nt_nodelay, nt_write_all, nt_write_str, nt_read, nt_read_exact, nt_close, nt_fork, nt_exit, nt_reap }
import .digest { dg_base64, dg_sha1 }

extern {
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function strtol(s: string, end: ptr<void>, base: i32) -> i64
}

const OP_TEXT: i32 = 1
const OP_BINARY: i32 = 2
const OP_CLOSE: i32 = 8
const OP_PING: i32 = 9
const OP_PONG: i32 = 10

const MAX_HEAD: i32 = 65536

# ---------------------------------------------------------------------------
# Byte helpers
# ---------------------------------------------------------------------------

# Python's repr() of a bytes object.
function bytes_repr(p: ptr<u8>, n: i64) -> string {
    let mut has_sq: bool = false
    let mut has_dq: bool = false
    let mut i: i64 = 0
    while i < n {
        if p[i] == 39 {
            has_sq = true
        }
        if p[i] == 34 {
            has_dq = true
        }
        i = i + 1
    }
    let mut quote: i32 = 39
    if has_sq and has_dq == false {
        quote = 34
    }
    let hex: ptr<u8> = "0123456789abcdef" as ptr<u8>
    let out: ptr<u8> = malloc(n * 4 + 4) as ptr<u8>
    let mut o: i64 = 0
    out[o] = 98
    out[o + 1] = quote as u8
    o = o + 2
    i = 0
    while i < n {
        let c: i32 = p[i] as i32
        if c == quote or c == 92 {
            out[o] = 92
            out[o + 1] = c as u8
            o = o + 2
        } elif c == 9 {
            out[o] = 92
            out[o + 1] = 116
            o = o + 2
        } elif c == 10 {
            out[o] = 92
            out[o + 1] = 110
            o = o + 2
        } elif c == 13 {
            out[o] = 92
            out[o + 1] = 114
            o = o + 2
        } elif c < 32 or c >= 127 {
            out[o] = 92
            out[o + 1] = 120
            out[o + 2] = hex[c / 16]
            out[o + 3] = hex[c % 16]
            o = o + 4
        } else {
            out[o] = c as u8
            o = o + 1
        }
        i = i + 1
    }
    out[o] = quote as u8
    out[o + 1] = 0
    return out as string
}

# Python's str.strip() for text decoded as latin-1.
function is_py_space(c: i32) -> bool {
    return c == 32 or (c >= 9 and c <= 13) or (c >= 28 and c <= 31) or c == 133 or c == 160
}

function py_strip(s: string) -> string {
    let p: ptr<u8> = s as ptr<u8>
    let mut a: i32 = 0
    let mut b: i32 = ft_len(s)
    while a < b and is_py_space(p[a] as i32) {
        a = a + 1
    }
    while b > a and is_py_space(p[b - 1] as i32) {
        b = b - 1
    }
    return ft_slice(s, a, b)
}

# ---------------------------------------------------------------------------
# Handshake
# ---------------------------------------------------------------------------

# Value of header `name` (lower case) in the request head, or "" when it is
# absent. A later duplicate replaces an earlier one.
function header_value(head: string, name: string) -> string {
    let p: ptr<u8> = head as ptr<u8>
    let n: i32 = ft_len(head)
    let mut value: string = ""
    let mut found: bool = false
    let mut i: i32 = 0
    let mut first: bool = true
    while i <= n {
        let mut j: i32 = i
        while j + 1 < n and (p[j] != 13 or p[j + 1] != 10) {
            j = j + 1
        }
        if j + 1 >= n {
            j = n
        }
        if first == false {
            let line: string = ft_slice(head, i, j)
            let lp: ptr<u8> = line as ptr<u8>
            let mut c: i32 = 0
            let ll: i32 = ft_len(line)
            while c < ll and lp[c] != 58 {
                c = c + 1
            }
            if c < ll {
                let key: string = ft_ascii_lower(py_strip(ft_slice(line, 0, c)))
                if ft_eq(key, name) {
                    value = py_strip(ft_from(line, c + 1))
                    found = true
                }
            }
        }
        first = false
        i = j + 2
    }
    if found == false {
        return ""
    }
    return value
}

# Read the request head, up to the blank line. Returns null when the peer
# closes first or the head passes 64 KiB. Bytes after the blank line are
# dropped, as the relay has always done.
function read_head(fd: i32) -> string {
    let cap: i64 = (MAX_HEAD + 8192) as i64
    let buf: ptr<u8> = malloc(cap + 1) as ptr<u8>
    let mut len: i64 = 0
    while true {
        let mut k: i64 = 0
        let mut end: i64 = -1
        while k + 3 < len {
            if buf[k] == 13 and buf[k + 1] == 10 and buf[k + 2] == 13 and buf[k + 3] == 10 {
                end = k
                break
            }
            k = k + 1
        }
        if end >= 0 {
            buf[end] = 0
            return buf as string
        }
        let got: i64 = nt_read(fd, buf + len, 4096)
        if got <= 0 {
            return null as string
        }
        len = len + got
        if len > (MAX_HEAD as i64) {
            return null as string
        }
    }
    return null as string
}

function handshake(fd: i32) -> bool {
    let head: string = read_head(fd)
    let mut key: string = ""
    let mut offered: string = ""
    if head as ptr<u8> != null {
        key = header_value(head, "sec-websocket-key")
        offered = header_value(head, "sec-websocket-protocol")
    }
    if ft_len(key) == 0 {
        let _w: bool = nt_write_str(fd, "HTTP/1.1 400 Bad Request\r\n\r\n")
        return false
    }
    let joined: string = key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
    let accept: string = dg_base64(dg_sha1(joined as ptr<u8>, ft_len(joined) as i64), 20)
    let mut resp: string = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + accept + "\r\n"
    # Emscripten's socket bridge asks for the "binary" subprotocol and
    # expects it echoed back, otherwise the browser rejects the handshake.
    let mut first_wanted: string = ""
    let mut has_binary: bool = false
    let op: ptr<u8> = offered as ptr<u8>
    let on: i32 = ft_len(offered)
    let mut s: i32 = 0
    while s <= on {
        let mut e: i32 = s
        while e < on and op[e] != 44 {
            e = e + 1
        }
        let item: string = py_strip(ft_slice(offered, s, e))
        if ft_len(item) > 0 {
            if ft_len(first_wanted) == 0 {
                first_wanted = item
            }
            if ft_eq(item, "binary") {
                has_binary = true
            }
        }
        s = e + 1
    }
    if has_binary {
        resp = resp + "Sec-WebSocket-Protocol: binary\r\n"
    } elif ft_len(first_wanted) > 0 {
        resp = resp + "Sec-WebSocket-Protocol: " + first_wanted + "\r\n"
    }
    return nt_write_str(fd, resp + "\r\n")
}

# ---------------------------------------------------------------------------
# Frames
# ---------------------------------------------------------------------------

struct Frame {
    opcode: i32
    len: i64
    data: ptr<u8>
}

# Read one frame and unmask it. Null when the peer goes away mid-frame.
function read_frame(fd: i32) -> ptr<Frame> {
    let hdr: ptr<u8> = malloc(16) as ptr<u8>
    if nt_read_exact(fd, hdr, 2) == false {
        return null
    }
    let opcode: i32 = (hdr[0] as i32) & 15
    let masked: bool = ((hdr[1] as i32) & 128) != 0
    let mut length: i64 = ((hdr[1] as i32) & 127) as i64
    if length == 126 {
        if nt_read_exact(fd, hdr, 2) == false {
            return null
        }
        length = ((hdr[0] as i64) << 8) | (hdr[1] as i64)
    } elif length == 127 {
        if nt_read_exact(fd, hdr, 8) == false {
            return null
        }
        length = 0
        let mut b: i32 = 0
        while b < 8 {
            length = (length << 8) | (hdr[b] as i64)
            b = b + 1
        }
        if length < 0 or length > 2147483647 {
            return null
        }
    }
    let mask: ptr<u8> = malloc(4) as ptr<u8>
    if masked {
        if nt_read_exact(fd, mask, 4) == false {
            return null
        }
    }
    let data: ptr<u8> = malloc(length + 1) as ptr<u8>
    if data == null {
        return null
    }
    if length > 0 {
        if nt_read_exact(fd, data, length) == false {
            free(data as ptr<void>)
            return null
        }
    }
    if masked {
        let mut i: i64 = 0
        while i < length {
            data[i] = ((data[i] as i32) ^ (mask[i % 4] as i32)) as u8
            i = i + 1
        }
    }
    let f: ptr<Frame> = malloc(24) as ptr<Frame>
    f[0].opcode = opcode
    f[0].len = length
    f[0].data = data
    return f
}

# Server-to-client frames are never masked.
function write_frame(fd: i32, opcode: i32, data: ptr<u8>, length: i64) -> bool {
    let out: ptr<u8> = malloc(length + 10) as ptr<u8>
    out[0] = (128 | opcode) as u8
    let mut h: i64 = 2
    if length < 126 {
        out[1] = length as u8
    } elif length < 65536 {
        out[1] = 126
        out[2] = ((length >> 8) & 255) as u8
        out[3] = (length & 255) as u8
        h = 4
    } else {
        out[1] = 127
        let mut b: i64 = 0
        while b < 8 {
            out[2 + b] = ((length >> ((7 - b) * 8)) & 255) as u8
            b = b + 1
        }
        h = 10
    }
    let mut i: i64 = 0
    while i < length {
        out[h + i] = data[i]
        i = i + 1
    }
    let ok: bool = nt_write_all(fd, out, h + length)
    free(out as ptr<void>)
    return ok
}

# ---------------------------------------------------------------------------
# Clients
# ---------------------------------------------------------------------------

function serve_ws_client(fd: i32, addr: string, verbose: bool) -> void {
    if handshake(fd) {
        if verbose {
            ft_outln("[ws] " + addr + " upgraded")
        }
        while true {
            let f: ptr<Frame> = read_frame(fd)
            if f == null {
                break
            }
            let opcode: i32 = f[0].opcode
            if opcode == OP_CLOSE {
                let _c: bool = write_frame(fd, OP_CLOSE, f[0].data, 0)
                break
            }
            if opcode == OP_PING {
                if write_frame(fd, OP_PONG, f[0].data, f[0].len) == false {
                    break
                }
                continue
            }
            if opcode == OP_PONG {
                free(f[0].data as ptr<void>)
                continue
            }
            if verbose {
                let mut shown: i64 = f[0].len
                if shown > 48 {
                    shown = 48
                }
                ft_outln("[ws] " + addr + " echo " + ft_itoa(f[0].len as i32) + " bytes: " + bytes_repr(f[0].data, shown))
            }
            let mut back: i32 = OP_BINARY
            if opcode == OP_TEXT {
                back = OP_TEXT
            }
            let ok: bool = write_frame(fd, back, f[0].data, f[0].len)
            free(f[0].data as ptr<void>)
            if ok == false {
                break
            }
        }
    }
    nt_close(fd)
    if verbose {
        ft_outln("[ws] " + addr + " closed")
    }
}

# Plain TCP echo, so the same Flow program can be run natively.
function serve_tcp_client(fd: i32, addr: string, verbose: bool) -> void {
    let buf: ptr<u8> = malloc(65536) as ptr<u8>
    while true {
        let got: i64 = nt_read(fd, buf, 65536)
        if got <= 0 {
            break
        }
        if verbose {
            ft_outln("[tcp] " + addr + " echo " + ft_itoa(got as i32) + " bytes")
        }
        if nt_write_all(fd, buf, got) == false {
            break
        }
    }
    nt_close(fd)
}

# ---------------------------------------------------------------------------
# Command line
# ---------------------------------------------------------------------------

function usage() -> string {
    return "usage: ws_echo_relay [-h] [--port PORT] [--tcp-port TCP_PORT] [-v]\n"
}

function help_text() -> string {
    return usage() + "\nA WebSocket echo relay for the WASM sockets demo. Echoes every WebSocket\nframe on --port, and plain TCP bytes on --tcp-port when given, so the same\nFlow program can run in the browser and natively against one relay.\n\noptions:\n  -h, --help           show this help message and exit\n  --port PORT          WebSocket port\n  --tcp-port TCP_PORT  plain TCP echo port (0 disables)\n  -v, --verbose\n"
}

function arg_error(msg: string) -> i32 {
    ft_err(usage())
    ft_errln("ws_echo_relay: error: " + msg)
    return 2
}

# The long option `arg` names, allowing unique prefixes as argparse does, or
# "" when it names none. "?" marks an ambiguous prefix.
function long_option(arg: string) -> string {
    let names: ptr<string> = malloc(4 * 8) as ptr<string>
    names[0] = "--port"
    names[1] = "--tcp-port"
    names[2] = "--verbose"
    names[3] = "--help"
    let mut hit: string = ""
    let mut hits: i32 = 0
    let mut i: i32 = 0
    while i < 4 {
        if ft_eq(arg, names[i]) {
            return names[i]
        }
        if ft_starts(names[i], arg) {
            hit = names[i]
            hits = hits + 1
        }
        i = i + 1
    }
    if hits == 1 {
        return hit
    }
    if hits > 1 {
        return "?"
    }
    return ""
}

# argparse's int(): optional sign, digits, surrounding spaces. -1 when the
# text is not an integer (ports are never negative here).
function parse_int(s: string) -> i64 {
    let t: string = py_strip(s)
    let p: ptr<u8> = t as ptr<u8>
    let n: i32 = ft_len(t)
    let mut i: i32 = 0
    if n > 0 and (p[0] == 43 or p[0] == 45) {
        i = 1
    }
    if i >= n {
        return -99999999
    }
    while i < n {
        if p[i] < 48 or p[i] > 57 {
            return -99999999
        }
        i = i + 1
    }
    return strtol(t, null, 10)
}

function main(argc: i32, argv: ptr<string>) -> i32 {
    let mut port: i64 = 9505
    let mut tcp_port: i64 = 0
    let mut verbose: bool = false
    let mut i: i32 = 1
    while i < argc {
        let arg: string = argv[i]
        let mut name: string = arg
        let mut value: string = null as string
        if ft_starts(arg, "--") {
            let mut eq: i32 = 0
            let ap: ptr<u8> = arg as ptr<u8>
            while ap[eq] != 0 and ap[eq] != 61 {
                eq = eq + 1
            }
            if ap[eq] == 61 {
                value = ft_from(arg, eq + 1)
                name = ft_slice(arg, 0, eq)
            }
            let full: string = long_option(name)
            if ft_eq(full, "?") {
                return arg_error("ambiguous option: " + name)
            }
            if ft_len(full) > 0 {
                name = full
            }
        }
        if ft_eq(name, "-h") or ft_eq(name, "--help") {
            ft_out(help_text())
            return 0
        } elif ft_eq(name, "-v") or ft_eq(name, "--verbose") {
            if value as ptr<u8> != null {
                return arg_error("argument -v/--verbose: ignored explicit argument '" + value + "'")
            }
            verbose = true
        } elif ft_eq(name, "--port") or ft_eq(name, "--tcp-port") {
            if value as ptr<u8> == null {
                if i + 1 >= argc {
                    if ft_eq(name, "--port") {
                        return arg_error("argument --port: expected one argument")
                    }
                    return arg_error("argument --tcp-port: expected one argument")
                }
                i = i + 1
                value = argv[i]
            }
            let v: i64 = parse_int(value)
            if v == -99999999 {
                return arg_error("argument " + name + ": invalid int value: '" + value + "'")
            }
            if ft_eq(name, "--port") {
                port = v
            } else {
                tcp_port = v
            }
        } else {
            return arg_error("unrecognized arguments: " + arg)
        }
        i = i + 1
    }

    let fds: ptr<i32> = malloc(8) as ptr<i32>
    let kinds: ptr<i32> = malloc(8) as ptr<i32>
    let mut nfds: i32 = 0
    if tcp_port != 0 {
        let tfd: i32 = nt_listen("ws_echo_relay", "127.0.0.1", tcp_port as i32, 16)
        if tfd < 0 {
            return 1
        }
        ft_outln("TCP echo relay on 127.0.0.1:" + ft_itoa(tcp_port as i32))
        fds[nfds] = tfd
        kinds[nfds] = 1
        nfds = nfds + 1
    }
    let wfd: i32 = nt_listen("ws_echo_relay", "127.0.0.1", port as i32, 16)
    if wfd < 0 {
        return 1
    }
    ft_outln("WebSocket echo relay on 127.0.0.1:" + ft_itoa(port as i32))
    fds[nfds] = wfd
    kinds[nfds] = 0
    nfds = nfds + 1

    let peer: ptr<u8> = nt_peer_new()
    while true {
        nt_reap()
        let ready: i32 = nt_wait_readable(fds, nfds, 500)
        if ready < 0 {
            continue
        }
        let conn: i32 = nt_accept(fds[ready], peer)
        if conn < 0 {
            continue
        }
        nt_nodelay(conn)
        let addr: string = "('" + nt_peer_ip(peer) + "', " + ft_itoa(nt_peer_port(peer)) + ")"
        let pid: i32 = nt_fork()
        if pid == 0 {
            let mut k: i32 = 0
            while k < nfds {
                nt_close(fds[k])
                k = k + 1
            }
            if kinds[ready] == 1 {
                serve_tcp_client(conn, addr, verbose)
            } else {
                serve_ws_client(conn, addr, verbose)
            }
            nt_exit(0)
        }
        nt_close(conn)
    }
    return 0
}
