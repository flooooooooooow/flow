# Build docs/demos/shaders.md from the canonical FSL gallery sources.
#
# The gallery page is generated so adding or removing a
# `shader fill photoreal_*` entry cannot drift away from the Wiki. Material
# section comments in shader_photoreal_materials.flow become gallery groups,
# and every fill gets a GIF tile pointing at docs/demos/shaders/<fill>.gif.
#
# Run through scripts/build_shader_gallery.sh from the repository root:
#
#   build_shader_gallery.sh                  rewrite shaders.md
#   build_shader_gallery.sh --check          exit 1 if shaders.md is stale
#   build_shader_gallery.sh --check-assets   require every referenced GIF
#
# Output is byte-identical to the Python script this replaces. The two line
# patterns it used are matched by hand below:
#   FILL:    ^\s*shader\s+fill\s+(photoreal_[A-Za-z0-9_]+)\s*\{
#   HEADING: ^#\s+([A-Z][A-Za-z0-9 &/+\-]{1,52})\s*$

import .text { ft_outln, ft_errln, ft_eq, ft_len, ft_itoa, ft_repr, ft_at, ft_slice, ft_from, ft_read_file, ft_write_file, ft_exists, ft_ascii_lower, ft_list_new, ft_list_push, ft_list_len, ft_list_get, ft_list_has, StrList }
import .unicode { uc_decode, uc_len, uc_is_space }
import .mdtext { md_splitlines, md_split_ws }
import .demogen { dg_html_escape, dg_flags }

extern {
    function malloc(size: i64) -> ptr<void>
}

const PROG: string = "build_shader_gallery.sh"
const SCENES: string = "examples/gpu/shader_photoreal.flow"
const MATERIALS: string = "examples/gpu/shader_photoreal_materials.flow"
const OUTPUT: string = "docs/demos/shaders.md"
const SCENE_CAT: string = "Scene studies"

struct Demos {
    names: ptr<StrList>
    titles: ptr<StrList>
    cats: ptr<StrList>
    files: ptr<StrList>
}

function usage_line() -> string {
    return "usage: build_shader_gallery.sh [-h] [--check] [--check-assets]\n"
}

function help_text() -> string {
    return usage_line() + "\noptions:\n  -h, --help      show this help message and exit\n  --check         fail if shaders.md is stale\n  --check-assets  require every referenced GIF\n"
}

# Byte length of the whitespace character at `at`, or 0.
function ws_len(p: ptr<u8>, at: i32) -> i32 {
    let c: i32 = p[at] as i32
    if c == 0 {
        return 0
    }
    if uc_is_space(uc_decode(p, at)) {
        return uc_len(c)
    }
    return 0
}

function skip_ws(p: ptr<u8>, at: i32) -> i32 {
    let mut q: i32 = at
    let mut w: i32 = ws_len(p, q)
    while w > 0 {
        q = q + w
        w = ws_len(p, q)
    }
    return q
}

function is_name_char(c: i32) -> bool {
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
}

# FILL pattern: the fill name, or null.
function fill_name(line: string) -> string {
    let p: ptr<u8> = line as ptr<u8>
    let mut q: i32 = skip_ws(p, 0)
    if ft_at(line, q, "shader") == false {
        return null
    }
    let a: i32 = q + 6
    q = skip_ws(p, a)
    if q == a or ft_at(line, q, "fill") == false {
        return null
    }
    let b: i32 = q + 4
    q = skip_ws(p, b)
    if q == b or ft_at(line, q, "photoreal_") == false {
        return null
    }
    let start: i32 = q
    let mut e: i32 = q + 10
    while is_name_char(p[e] as i32) {
        e = e + 1
    }
    if e == q + 10 {
        return null
    }
    let after: i32 = skip_ws(p, e)
    if p[after] != 123 {
        return null
    }
    return ft_slice(line, start, e)
}

function is_head_char(c: i32) -> bool {
    return (is_name_char(c) and c != 95) or c == 32 or c == 38 or c == 47 or c == 43 or c == 45
}

# HEADING pattern, stripped group 1, or null.
function heading(line: string) -> string {
    let p: ptr<u8> = line as ptr<u8>
    if p[0] != 35 {
        return null
    }
    let w1: i32 = skip_ws(p, 1)
    if w1 == 1 {
        return null
    }
    let cap: i32 = p[w1] as i32
    if cap < 65 or cap > 90 {
        return null
    }
    let t: i32 = w1 + 1
    # k: run of class characters after the capital; m: end of the last
    # non-whitespace character after it.
    let mut k: i32 = 0
    while is_head_char(p[t + k] as i32) {
        k = k + 1
    }
    let n: i32 = ft_len(line)
    let mut m: i32 = 0
    let mut i: i32 = t
    while i < n {
        let w: i32 = ws_len(p, i)
        if w > 0 {
            i = i + w
        } else {
            let c: i32 = p[i] as i32
            i = i + uc_len(c)
            m = i - t
        }
    }
    let mut hi: i32 = k
    if hi > 52 {
        hi = 52
    }
    let mut lo: i32 = m
    if lo < 1 {
        lo = 1
    }
    if m > k or lo > hi {
        return null
    }
    return ft_slice(line, w1, t + m)
}

function capitalize(w: string) -> string {
    let low: string = ft_ascii_lower(w)
    let p: ptr<u8> = low as ptr<u8>
    if p[0] >= 97 and p[0] <= 122 {
        p[0] = (p[0] as i32 - 32) as u8
    }
    return low
}

function human_title(name: string) -> string {
    let mut text: string = ft_from(name, 0)
    if ft_at(name, 0, "photoreal_") {
        text = ft_from(name, 10)
    }
    let p: ptr<u8> = text as ptr<u8>
    let mut i: i32 = 0
    while p[i] != 0 {
        if p[i] == 95 {
            p[i] = 32
        }
        i = i + 1
    }
    let words: ptr<StrList> = md_split_ws(text)
    let mut out: string = ""
    let mut wi: i32 = 0
    while wi < ft_list_len(words) {
        let word: string = ft_list_get(words, wi)
        let lw: string = ft_ascii_lower(word)
        if wi > 0 {
            out = out + " "
        }
        if ft_eq(lw, "abs") {
            out = out + "ABS"
        } elif ft_eq(lw, "pbr") {
            out = out + "PBR"
        } else {
            out = out + capitalize(word)
        }
        wi = wi + 1
    }
    return out
}

function add_demo(d: ptr<Demos>, name: string, cat: string, file: string) -> void {
    ft_list_push(d[0].names, name)
    ft_list_push(d[0].titles, human_title(name))
    ft_list_push(d[0].cats, cat)
    ft_list_push(d[0].files, file)
}

function parse_file(d: ptr<Demos>, path: string, headings: bool) -> bool {
    let text: string = ft_read_file(path)
    if text == null {
        return false
    }
    let lines: ptr<StrList> = md_splitlines(text)
    let mut category: string = "Materials"
    if headings == false {
        category = SCENE_CAT
    }
    let mut li: i32 = 0
    while li < ft_list_len(lines) {
        let line: string = ft_list_get(lines, li)
        let mut handled: bool = false
        if headings {
            let hd: string = heading(line)
            if hd != null {
                category = hd
                handled = true
            }
        }
        if handled == false {
            let nm: string = fill_name(line)
            if nm != null {
                add_demo(d, nm, category, ft_from(path, 13))
            }
        }
        li = li + 1
    }
    return true
}

# re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
function slug(text: string) -> string {
    let low: string = ft_ascii_lower(text)
    let p: ptr<u8> = low as ptr<u8>
    let n: i32 = ft_len(low)
    let buf: ptr<u8> = malloc((n + 1) as i64) as ptr<u8>
    let mut o: i32 = 0
    let mut i: i32 = 0
    let mut in_run: bool = false
    while i < n {
        let c: i32 = p[i] as i32
        if (c >= 97 and c <= 122) or (c >= 48 and c <= 57) {
            buf[o] = c as u8
            o = o + 1
            in_run = false
        } else {
            if in_run == false {
                buf[o] = 45
                o = o + 1
                in_run = true
            }
            # A multi-byte character is one non-matching character.
            i = i + uc_len(c) - 1
        }
        i = i + 1
    }
    let mut a: i32 = 0
    while a < o and buf[a] == 45 {
        a = a + 1
    }
    let mut b: i32 = o
    while b > a and buf[b - 1] == 45 {
        b = b - 1
    }
    buf[b] = 0
    return ft_from(buf as string, a)
}

function tile(d: ptr<Demos>, i: i32, featured: bool) -> string {
    let mut cls: string = "demo-tile"
    if featured {
        cls = "demo-tile demo-tile-featured"
    }
    let name: string = ft_list_get(d[0].names, i)
    let file: string = ft_list_get(d[0].files, i)
    let title: string = dg_html_escape(ft_list_get(d[0].titles, i))
    let category: string = dg_html_escape(ft_list_get(d[0].cats, i))
    let src: string = dg_html_escape("../../examples/gpu/" + file)
    let gif: string = dg_html_escape("./shaders/" + name + ".gif")
    let command: string = dg_html_escape("./flow shader examples/gpu/" + file + " --name " + name)
    let mut s: string = "<figure class=\"" + cls + "\">\n"
    s = s + "  <a class=\"demo-tile-media\" href=\"" + src + "\" aria-label=\"Open " + title + " source\">\n"
    s = s + "    <img src=\"" + gif + "\" alt=\"" + title + " rendered by Flow FSL\" loading=\"lazy\">\n"
    s = s + "  </a>\n"
    s = s + "  <figcaption>\n"
    s = s + "    <div class=\"demo-tile-title\"><strong>" + title + "</strong><span class=\"demo-badge\">" + category + "</span></div>\n"
    s = s + "    <code class=\"demo-run\">" + command + "</code>\n"
    s = s + "    <div class=\"demo-actions\"><a href=\"" + src + "\">Source</a><a href=\"../language/shaders.md\">FSL guide</a></div>\n"
    s = s + "  </figcaption>\n"
    s = s + "</figure>"
    return s
}

function build_page(d: ptr<Demos>) -> string {
    let total: i32 = ft_list_len(d[0].names)
    let categories: ptr<StrList> = ft_list_new()
    let mut i: i32 = 0
    while i < total {
        let cat: string = ft_list_get(d[0].cats, i)
        if ft_eq(cat, SCENE_CAT) == false and ft_list_has(categories, cat) == false {
            ft_list_push(categories, cat)
        }
        i = i + 1
    }
    let mut out: string = "# Photoreal FSL Gallery\n\n"
    out = out + "64 shaders, recorded from the real Flow Shader Language → Metal pipeline. \n"
    out = out + "These are not mock-ups or screenshots reconstructed in another renderer: each GIF is \n"
    out = out + "captured offscreen from the generated Metal fragment shader with deterministic time.\n\n"
    out = out + "<div class=\"demo-gallery-summary\">\n"
    out = out + "  <span><strong>64</strong> runnable shaders</span>\n"
    out = out + "  <span><strong>4</strong> ray-marched scenes</span>\n"
    out = out + "  <span><strong>60</strong> material studies</span>\n"
    out = out + "  <span><strong>0</strong> external textures</span>\n"
    out = out + "</div>\n\n"
    out = out + "```bash\n"
    out = out + "./flow shader examples/gpu/shader_photoreal.flow\n"
    out = out + "./flow shader examples/gpu/shader_photoreal_materials.flow --name photoreal_gold\n"
    out = out + "./scripts/record_shader_gallery.sh --group photoreal\n"
    out = out + "```\n\n"
    out = out + "## Scene studies\n\n"
    out = out + "The large studies exercise SDF composition, finite-difference normals, soft shadows, \n"
    out = out + "ambient occlusion, Fresnel response, reflection/refraction and procedural environments.\n\n"
    out = out + "<div class=\"demo-feature-grid\">\n"
    i = 0
    while i < total {
        if ft_eq(ft_list_get(d[0].cats, i), SCENE_CAT) {
            out = out + tile(d, i, true) + "\n"
        }
        i = i + 1
    }
    out = out + "</div>\n\n## Material library\n\n"
    out = out + "<nav class=\"demo-chip-row\" aria-label=\"Material categories\">\n"
    let mut ci: i32 = 0
    while ci < ft_list_len(categories) {
        let c1: string = ft_list_get(categories, ci)
        out = out + "  <a class=\"demo-chip\" href=\"#" + slug(c1) + "\">" + dg_html_escape(c1) + "</a>\n"
        ci = ci + 1
    }
    out = out + "</nav>\n\n"
    ci = 0
    while ci < ft_list_len(categories) {
        let c2: string = ft_list_get(categories, ci)
        let mut group: i32 = 0
        i = 0
        while i < total {
            if ft_eq(ft_list_get(d[0].cats, i), c2) {
                group = group + 1
            }
            i = i + 1
        }
        out = out + "### " + c2 + "\n\n"
        out = out + "<p class=\"demo-section-meta\">" + ft_itoa(group) + " runnable studies</p>\n\n"
        out = out + "<div class=\"demo-tile-grid\">\n"
        i = 0
        while i < total {
            if ft_eq(ft_list_get(d[0].cats, i), c2) {
                out = out + tile(d, i, false) + "\n"
            }
            i = i + 1
        }
        out = out + "</div>\n\n"
        ci = ci + 1
    }
    out = out + "## Recording contract\n\n"
    out = out + "`scripts/record_shader_gallery.sh` compiles the same FSL files used by `./flow shader`, \n"
    out = out + "renders them with `runtime/shader_record_metal.m`, and passes the resulting PPM frames \n"
    out = out + "through the shared GIF encoder. Capture time is `frame / fps`, so animations do not \n"
    out = out + "depend on wall-clock scheduling. The recorder requires macOS with an exposed Metal device.\n\n"
    out = out + "Related: [all galleries](overview.md) · [FSL language guide](../language/shaders.md) · \n"
    out = out + "[GPU examples](../../examples/gpu/) · [how recordings are produced](README.md)\n"
    return out
}

function main(argc: i32, argv: ptr<string>) -> i32 {
    let flags: ptr<StrList> = ft_list_new()
    ft_list_push(flags, "--check")
    ft_list_push(flags, "--check-assets")
    let on: ptr<i32> = malloc(8) as ptr<i32>
    on[0] = 0
    on[1] = 0
    let rc: i32 = dg_flags(argc, argv, flags, on, PROG, usage_line(), help_text())
    if rc >= 0 {
        return rc
    }

    let d: ptr<Demos> = malloc(32) as ptr<Demos>
    d[0].names = ft_list_new()
    d[0].titles = ft_list_new()
    d[0].cats = ft_list_new()
    d[0].files = ft_list_new()
    if parse_file(d, SCENES, false) == false {
        ft_errln("FileNotFoundError: [Errno 2] No such file or directory: " + ft_repr(SCENES))
        return 1
    }
    if parse_file(d, MATERIALS, true) == false {
        ft_errln("FileNotFoundError: [Errno 2] No such file or directory: " + ft_repr(MATERIALS))
        return 1
    }
    let total: i32 = ft_list_len(d[0].names)
    let uniq: ptr<StrList> = ft_list_new()
    let mut i: i32 = 0
    while i < total {
        if ft_list_has(uniq, ft_list_get(d[0].names, i)) == false {
            ft_list_push(uniq, ft_list_get(d[0].names, i))
        }
        i = i + 1
    }
    if total != 64 or ft_list_len(uniq) != 64 {
        ft_errln("shader gallery contract violated: expected 64 unique entries, got " + ft_itoa(total) + " entries / " + ft_itoa(ft_list_len(uniq)) + " unique")
        return 1
    }

    if on[1] == 1 {
        let mut missing: string = ""
        let mut nmiss: i32 = 0
        i = 0
        while i < total {
            let nm: string = ft_list_get(d[0].names, i)
            if ft_exists("docs/demos/shaders/" + nm + ".gif") == false {
                if nmiss > 0 {
                    missing = missing + ", "
                }
                missing = missing + nm
                nmiss = nmiss + 1
            }
            i = i + 1
        }
        if nmiss > 0 {
            ft_errln("missing shader GIFs: " + missing)
            return 1
        }
    }

    let generated: string = build_page(d)
    if on[0] == 1 {
        let mut current: string = ft_read_file(OUTPUT)
        if current == null {
            current = ""
        }
        if ft_eq(current, generated) == false {
            ft_errln("docs/demos/shaders.md is stale; run scripts/build_shader_gallery.sh")
            return 1
        }
        ft_outln("shader gallery page is current")
        return 0
    }
    if ft_write_file(OUTPUT, generated) == false {
        ft_errln("build_shader_gallery: cannot write " + OUTPUT)
        return 1
    }
    ft_outln("wrote " + OUTPUT + " with " + ft_itoa(total) + " demos")
    return 0
}
