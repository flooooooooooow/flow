# Sync open ROADMAP.md items to GitHub issues.
#
# Source of truth: ROADMAP.md. Open items are any of:
#
#   * a table row with a cell containing the U+1F532 square or "partial"
#   * an unchecked checklist line (- [ ] ...)
#   * a numbered "<square> **Title** ..." line under What's Next
#   * the curated known_gap() list (prose gaps in Current State)
#
# For every open item a stable slug is derived. The slug maps to a GitHub
# issue (label `roadmap`) and a line in docs/project/issues-checklist.md:
#
#   - [ ] #NNN [roadmap:<slug>] <title> <url>
#
# When an item is marked done in ROADMAP.md, its issue is closed and the
# checklist line flips to - [x].
#
# Run it as `./flow tool roadmap_sync` from anywhere in the repository; it
# works from the repository root and needs gh (authenticated):
#
#   flow tool roadmap_sync [--roadmap ROADMAP.md]
#       [--checklist docs/project/issues-checklist.md]
#       [--repo owner/name] [--dry-run] [--verbose]
#
# A run goes through three phases and calls gh (std.process) in between.
# Their files live in build/roadmap-sync/:
#
#   args    validate arguments and learn the repository
#   plan    read issues.json (`gh issue list`), report, and write plan.txt
#           (the gh calls to make) plus one body-N.md per new issue
#   apply   read created.txt (numbers of the new issues) and rewrite the
#           checklist
#
# `--phase args|plan|apply` runs one phase alone. Every phase recomputes the
# plan from the same inputs, so the phases agree.

import .text { ft_out, ft_outln, ft_err, ft_errln, ft_eq, ft_len, ft_itoa, ft_read_file, ft_write_file, ft_exists, ft_starts, ft_ends, ft_at, ft_find, ft_slice, ft_from, ft_find_byte, ft_split_lines, ft_list_new, ft_list_push, ft_list_len, ft_list_get, ft_list_sort, ft_set_new, ft_set_add, ft_set_has, ft_map_new, ft_map_get, ft_map_put, StrList, StrSet, StrMap }
import .unicode { uc_decode, uc_len, uc_prev, uc_is_space, uc_strip, uc_lower_str }
import .mdtext { md_splitlines, md_collapse_ws }
import .repo { rp_enter_root }
import std.process { ProcCmd, ProcResult, proc_cmd, proc_arg, proc_stdout, proc_stderr, proc_run, PROC_NULL, PROC_CAPTURE }
import .json { json_parse, json_error, json_get, json_kind, json_str, json_first, json_next, json_int, json_is_int, json_kind_string, json_kind_array, json_kind_object, Json }

extern {
    function malloc(size: i64) -> ptr<void>
    function opendir(path: string) -> ptr<void>
    function closedir(d: ptr<void>) -> i32
}

const PROG: string = "flow tool roadmap_sync"
const WORK: string = "build/roadmap-sync"
const LABEL: string = "roadmap"

# Known gaps from Current State. They are not structured rows or checkboxes,
# so they are curated here. Remove one once resolved so the item is treated
# as done.
const GAP_N: i32 = 2

function known_gap(i: i32) -> string {
    if i == 0 {
        return "MLIR backend not exercised against new chained AST shapes"
    }
    return "Three older effects demos transpile but do not link (capability parameter style)"
}

# ---------------------------------------------------------------------------
# Text cleaning
# ---------------------------------------------------------------------------

# `([^`]*)` -> \1
function strip_code(s: string) -> string {
    let p: ptr<u8> = s as ptr<u8>
    let n: i32 = ft_len(s)
    let mut out: string = ""
    let mut copied: i32 = 0
    let mut i: i32 = 0
    while i < n {
        if p[i] == 96 {
            let close: i32 = ft_find_byte(s, 96, i + 1)
            if close < 0 {
                break
            }
            out = out + ft_slice(s, copied, i) + ft_slice(s, i + 1, close)
            copied = close + 1
            i = close + 1
        } else {
            i = i + 1
        }
    }
    return out + ft_from(s, copied)
}

# \[([^\]]+)\]\([^)]*\) -> \1
function strip_links(s: string) -> string {
    let p: ptr<u8> = s as ptr<u8>
    let n: i32 = ft_len(s)
    let mut out: string = ""
    let mut copied: i32 = 0
    let mut i: i32 = 0
    while i < n {
        if p[i] == 91 {
            let close: i32 = ft_find_byte(s, 93, i + 1)
            if close < 0 {
                break
            }
            if close > i + 1 and p[close + 1] == 40 {
                let end: i32 = ft_find_byte(s, 41, close + 2)
                if end < 0 {
                    break
                }
                out = out + ft_slice(s, copied, i) + ft_slice(s, i + 1, close)
                copied = end + 1
                i = end + 1
                continue
            }
        }
        i = i + 1
    }
    return out + ft_from(s, copied)
}

function rstrip_pipes(s: string) -> string {
    let p: ptr<u8> = s as ptr<u8>
    let mut e: i32 = ft_len(s)
    while e > 0 and p[e - 1] == 124 {
        e = e - 1
    }
    return ft_slice(s, 0, e)
}

function clean_text(s: string) -> string {
    let t: string = uc_strip(md_collapse_ws(strip_links(strip_code(s))))
    return uc_strip(rstrip_pipes(t))
}

function is_slug_char(c: i32) -> bool {
    return (c >= 97 and c <= 122) or (c >= 48 and c <= 57)
}

function slugify(title: string) -> string {
    let s: string = uc_lower_str(clean_text(title))
    let p: ptr<u8> = s as ptr<u8>
    let n: i32 = ft_len(s)
    let buf: ptr<u8> = malloc((n + 1) as i64) as ptr<u8>
    let mut o: i32 = 0
    let mut i: i32 = 0
    while i < n {
        if is_slug_char(p[i] as i32) {
            buf[o] = p[i]
            o = o + 1
            i = i + 1
        } else {
            while i < n and is_slug_char(p[i] as i32) == false {
                i = i + 1
            }
            buf[o] = 45
            o = o + 1
        }
    }
    buf[o] = 0
    let bp: ptr<u8> = buf as ptr<u8>
    let mut a: i32 = 0
    while a < o and bp[a] == 45 {
        a = a + 1
    }
    let mut b: i32 = o
    while b > a and bp[b - 1] == 45 {
        b = b - 1
    }
    if b == a {
        return "untitled"
    }
    return ft_slice(buf as string, a, b)
}

function normalize_repo(repo: string) -> string {
    let mut r: string = repo
    if ft_starts(r, "https://github.com/") {
        r = ft_from(r, 19)
    }
    if ft_ends(r, ".git") {
        r = ft_slice(r, 0, ft_len(r) - 4)
    }
    return r
}

# U+1F532 (the open-item square), as its four UTF-8 bytes.
function square_at(s: string, at: i32) -> bool {
    let p: ptr<u8> = s as ptr<u8>
    return p[at] == 240 and p[at + 1] == 159 and p[at + 2] == 148 and p[at + 3] == 178
}

function has_square(s: string) -> bool {
    let n: i32 = ft_len(s)
    let mut i: i32 = 0
    while i + 4 <= n {
        if square_at(s, i) {
            return true
        }
        i = i + 1
    }
    return false
}

function is_open_status(status: string) -> bool {
    return has_square(status) or ft_find(uc_lower_str(status), "partial", 0) >= 0
}

# ---------------------------------------------------------------------------
# Open items
# ---------------------------------------------------------------------------

struct Items {
    slugs: ptr<StrList>
    titles: ptr<StrList>
    sections: ptr<StrList>
    extras: ptr<StrList>
    index: ptr<StrMap>
}

function items_new() -> ptr<Items> {
    let it: ptr<Items> = malloc(48) as ptr<Items>
    it[0].slugs = ft_list_new()
    it[0].titles = ft_list_new()
    it[0].sections = ft_list_new()
    it[0].extras = ft_list_new()
    it[0].index = ft_map_new()
    return it
}

function items_add(it: ptr<Items>, title: string, extra: string, section: string) -> void {
    let slug: string = slugify(title)
    if ft_map_get(it[0].index, slug, -1) >= 0 {
        return
    }
    ft_map_put(it[0].index, slug, ft_list_len(it[0].slugs))
    ft_list_push(it[0].slugs, slug)
    ft_list_push(it[0].titles, clean_text(title))
    ft_list_push(it[0].sections, section)
    ft_list_push(it[0].extras, clean_text(extra))
}

# ^#{2,4}\s+(.+)$ on a stripped line; returns the title or null.
function header_title(line: string) -> string {
    let p: ptr<u8> = line as ptr<u8>
    let mut k: i32 = 0
    while p[k] == 35 {
        k = k + 1
    }
    if k < 2 or k > 4 {
        return null as string
    }
    if p[k] == 0 or uc_is_space(uc_decode(p, k)) == false {
        return null as string
    }
    let n: i32 = ft_len(line)
    let mut w: i32 = k
    while w < n and uc_is_space(uc_decode(p, w)) {
        w = w + uc_len(p[w] as i32)
    }
    if w >= n {
        return null as string
    }
    return ft_from(line, w)
}

# ^\|[\s\-:]+\|?$
function is_table_sep(line: string) -> bool {
    let p: ptr<u8> = line as ptr<u8>
    if p[0] != 124 {
        return false
    }
    let n: i32 = ft_len(line)
    let mut i: i32 = 1
    while i < n {
        let cp: i32 = uc_decode(p, i)
        if cp == 45 or cp == 58 or uc_is_space(cp) {
            i = i + uc_len(p[i] as i32)
        } else {
            break
        }
    }
    if i == 1 {
        return false
    }
    if i < n and p[i] == 124 {
        i = i + 1
    }
    return i == n
}

# ^- \[ \]\s+(.+)$ ; returns the text or null.
function checkbox_text(line: string) -> string {
    if ft_starts(line, "- [ ]") == false {
        return null as string
    }
    let p: ptr<u8> = line as ptr<u8>
    let n: i32 = ft_len(line)
    if n <= 5 or uc_is_space(uc_decode(p, 5)) == false {
        return null as string
    }
    let mut w: i32 = 5
    while w < n and uc_is_space(uc_decode(p, w)) {
        w = w + uc_len(p[w] as i32)
    }
    if w >= n {
        return null as string
    }
    return ft_from(line, w)
}

function is_digit(c: i32) -> bool {
    return c >= 48 and c <= 57
}

# ^(\d+\.)\s+<U+1F532>\s+(.*)$ ; returns group 2 or null.
function numbered_open(line: string) -> string {
    let p: ptr<u8> = line as ptr<u8>
    let n: i32 = ft_len(line)
    let mut i: i32 = 0
    while i < n and is_digit(p[i] as i32) {
        i = i + 1
    }
    if i == 0 or p[i] != 46 {
        return null as string
    }
    i = i + 1
    if i >= n or uc_is_space(uc_decode(p, i)) == false {
        return null as string
    }
    while i < n and uc_is_space(uc_decode(p, i)) {
        i = i + uc_len(p[i] as i32)
    }
    if i + 4 > n or square_at(line, i) == false {
        return null as string
    }
    i = i + 4
    if i >= n or uc_is_space(uc_decode(p, i)) == false {
        return null as string
    }
    while i < n and uc_is_space(uc_decode(p, i)) {
        i = i + uc_len(p[i] as i32)
    }
    return ft_from(line, i)
}

# Is `at` the start of a hyphen or a U+2013 dash? Returns its byte length,
# or 0.
function dash_len(s: string, at: i32) -> i32 {
    let p: ptr<u8> = s as ptr<u8>
    if p[at] == 45 {
        return 1
    }
    if p[at] == 226 and p[at + 1] == 128 and p[at + 2] == 147 {
        return 3
    }
    return 0
}

function skip_space(s: string, at: i32) -> i32 {
    let p: ptr<u8> = s as ptr<u8>
    let n: i32 = ft_len(s)
    let mut i: i32 = at
    while i < n and uc_is_space(uc_decode(p, i)) {
        i = i + uc_len(p[i] as i32)
    }
    return i
}

function add_numbered(it: ptr<Items>, rest: string, section: string) -> void {
    let p: ptr<u8> = rest as ptr<u8>
    let n: i32 = ft_len(rest)
    # ^\*\*(.+?)\*\*\s*[-<U+2013>]?\s*(.*)$
    if ft_starts(rest, "**") {
        let mut k: i32 = 3
        while k + 2 <= n {
            if p[k] == 42 and p[k + 1] == 42 {
                let title: string = ft_slice(rest, 2, k)
                let mut j: i32 = skip_space(rest, k + 2)
                j = j + dash_len(rest, j)
                j = skip_space(rest, j)
                items_add(it, title, ft_from(rest, j), section)
                return
            }
            k = k + 1
        }
    }
    # re.split(r"\s+[-<U+2013>]\s+", rest, maxsplit=1)
    let mut i: i32 = 0
    while i < n {
        if uc_is_space(uc_decode(p, i)) {
            let ws_end: i32 = skip_space(rest, i)
            let d: i32 = dash_len(rest, ws_end)
            if d > 0 and ws_end + d < n and uc_is_space(uc_decode(p, ws_end + d)) {
                let after: i32 = skip_space(rest, ws_end + d)
                items_add(it, ft_slice(rest, 0, i), ft_from(rest, after), section)
                return
            }
            i = ws_end
        } else {
            i = i + uc_len(p[i] as i32)
        }
    }
    items_add(it, rest, "", section)
}

# Python str.strip("|"), then split("|") with each cell stripped.
function table_cells(line: string) -> ptr<StrList> {
    let p: ptr<u8> = line as ptr<u8>
    let mut a: i32 = 0
    let mut b: i32 = ft_len(line)
    while a < b and p[a] == 124 {
        a = a + 1
    }
    while b > a and p[b - 1] == 124 {
        b = b - 1
    }
    let inner: string = ft_slice(line, a, b)
    let out: ptr<StrList> = ft_list_new()
    let ip: ptr<u8> = inner as ptr<u8>
    let n: i32 = ft_len(inner)
    let mut start: i32 = 0
    let mut i: i32 = 0
    while i <= n {
        if i == n or ip[i] == 124 {
            ft_list_push(out, uc_strip(ft_slice(inner, start, i)))
            start = i + 1
        }
        i = i + 1
    }
    return out
}

function extract_open_items(roadmap: string) -> ptr<Items> {
    let it: ptr<Items> = items_new()
    let mut section: string = ""
    let lines: ptr<StrList> = md_splitlines(roadmap)
    let mut li: i32 = 0
    while li < ft_list_len(lines) {
        let line: string = uc_strip(ft_list_get(lines, li))
        li = li + 1
        let h: string = header_title(line)
        if h as ptr<u8> != null {
            section = uc_strip(h)
            continue
        }
        if ft_starts(line, "|") and is_table_sep(line) == false {
            let cells: ptr<StrList> = table_cells(line)
            let mut open: bool = false
            let mut ci: i32 = 0
            while ci < ft_list_len(cells) {
                if is_open_status(ft_list_get(cells, ci)) {
                    open = true
                }
                ci = ci + 1
            }
            if open {
                let mut extra: string = ""
                if ft_list_len(cells) > 2 {
                    extra = ft_list_get(cells, 2)
                }
                items_add(it, ft_list_get(cells, 0), extra, section)
            }
            continue
        }
        let cb: string = checkbox_text(line)
        if cb as ptr<u8> != null {
            items_add(it, cb, "", section)
            continue
        }
        let rest: string = numbered_open(line)
        if rest as ptr<u8> != null {
            add_numbered(it, uc_strip(rest), section)
        }
    }
    let mut g: i32 = 0
    while g < GAP_N {
        items_add(it, known_gap(g), "", "Current State (known gaps)")
        g = g + 1
    }
    return it
}

# Indexes of the items, sorted by slug.
function sorted_order(it: ptr<Items>) -> ptr<StrList> {
    let slugs: ptr<StrList> = ft_list_new()
    let mut i: i32 = 0
    while i < ft_list_len(it[0].slugs) {
        ft_list_push(slugs, ft_list_get(it[0].slugs, i))
        i = i + 1
    }
    ft_list_sort(slugs)
    return slugs
}

function item_title(it: ptr<Items>, slug: string) -> string {
    return ft_list_get(it[0].titles, ft_map_get(it[0].index, slug, 0))
}

function item_section(it: ptr<Items>, slug: string) -> string {
    return ft_list_get(it[0].sections, ft_map_get(it[0].index, slug, 0))
}

function item_extra(it: ptr<Items>, slug: string) -> string {
    return ft_list_get(it[0].extras, ft_map_get(it[0].index, slug, 0))
}

function has_item(it: ptr<Items>, slug: string) -> bool {
    return ft_map_get(it[0].index, slug, -1) >= 0
}

# ---------------------------------------------------------------------------
# Checklist and GitHub issues: ordered slug -> (number, checked/title)
# ---------------------------------------------------------------------------

struct Records {
    slugs: ptr<StrList>
    numbers: ptr<i32>
    flags: ptr<i32>
    texts: ptr<StrList>
    alive: ptr<i32>
    index: ptr<StrMap>
    cap: i32
}

function recs_new() -> ptr<Records> {
    let r: ptr<Records> = malloc(64) as ptr<Records>
    r[0].slugs = ft_list_new()
    r[0].texts = ft_list_new()
    r[0].numbers = malloc(4 * 4096) as ptr<i32>
    r[0].flags = malloc(4 * 4096) as ptr<i32>
    r[0].alive = malloc(4 * 4096) as ptr<i32>
    r[0].index = ft_map_new()
    r[0].cap = 4096
    return r
}

# dict assignment: an existing key keeps its position and takes the new value.
function recs_put(r: ptr<Records>, slug: string, number: i32, flag: i32, text: string) -> void {
    let existing: i32 = ft_map_get(r[0].index, slug, -1)
    let numbers: ptr<i32> = r[0].numbers
    let flags: ptr<i32> = r[0].flags
    let alive: ptr<i32> = r[0].alive
    if existing >= 0 {
        numbers[existing] = number
        flags[existing] = flag
        alive[existing] = 1
        let tl: ptr<StrList> = r[0].texts
        let items: ptr<string> = tl[0].items
        items[existing] = text
        return
    }
    let i: i32 = ft_list_len(r[0].slugs)
    ft_map_put(r[0].index, slug, i)
    ft_list_push(r[0].slugs, slug)
    ft_list_push(r[0].texts, text)
    numbers[i] = number
    flags[i] = flag
    alive[i] = 1
}

function recs_find(r: ptr<Records>, slug: string) -> i32 {
    let i: i32 = ft_map_get(r[0].index, slug, -1)
    if i < 0 {
        return -1
    }
    let alive: ptr<i32> = r[0].alive
    if alive[i] == 0 {
        return -1
    }
    return i
}

function recs_len(r: ptr<Records>) -> i32 {
    return ft_list_len(r[0].slugs)
}

function recs_number(r: ptr<Records>, i: i32) -> i32 {
    let numbers: ptr<i32> = r[0].numbers
    return numbers[i]
}

function recs_flag(r: ptr<Records>, i: i32) -> i32 {
    let flags: ptr<i32> = r[0].flags
    return flags[i]
}

function recs_alive(r: ptr<Records>, i: i32) -> bool {
    let alive: ptr<i32> = r[0].alive
    return alive[i] == 1
}

# dict.pop: removes the key; re-adding later appends at the end.
function recs_pop(r: ptr<Records>, slug: string) -> void {
    let i: i32 = ft_map_get(r[0].index, slug, -1)
    if i >= 0 {
        let alive: ptr<i32> = r[0].alive
        alive[i] = 0
        ft_map_put(r[0].index, slug, -1)
    }
}

function recs_count_alive(r: ptr<Records>) -> i32 {
    let mut n: i32 = 0
    let mut i: i32 = 0
    while i < recs_len(r) {
        if recs_alive(r, i) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

function is_slug_or_dash(c: i32) -> bool {
    return is_slug_char(c) or c == 45
}

# ^- \[([ xX])\]\s+#(\d+)\s+\[roadmap:([a-z0-9-]+)\] on a stripped line.
# Returns the slug and fills out[0] = checked, out[1] = number; null if no match.
function checklist_entry(line: string, out: ptr<i32>) -> string {
    let p: ptr<u8> = line as ptr<u8>
    let n: i32 = ft_len(line)
    if n < 6 or p[0] != 45 or p[1] != 32 or p[2] != 91 or p[4] != 93 {
        return null as string
    }
    let mark: i32 = p[3] as i32
    if mark != 32 and mark != 120 and mark != 88 {
        return null as string
    }
    let mut i: i32 = 5
    if i >= n or uc_is_space(uc_decode(p, i)) == false {
        return null as string
    }
    i = skip_space(line, i)
    if p[i] != 35 {
        return null as string
    }
    i = i + 1
    let ds: i32 = i
    let mut num: i32 = 0
    while i < n and is_digit(p[i] as i32) {
        num = num * 10 + (p[i] as i32) - 48
        i = i + 1
    }
    if i == ds {
        return null as string
    }
    if i >= n or uc_is_space(uc_decode(p, i)) == false {
        return null as string
    }
    i = skip_space(line, i)
    if ft_at(line, i, "[roadmap:") == false {
        return null as string
    }
    i = i + 9
    let ss: i32 = i
    while i < n and is_slug_or_dash(p[i] as i32) {
        i = i + 1
    }
    if i == ss or p[i] != 93 {
        return null as string
    }
    out[0] = 0
    if mark != 32 {
        out[0] = 1
    }
    out[1] = num
    return ft_slice(line, ss, i)
}

function parse_checklist(text: string) -> ptr<Records> {
    let r: ptr<Records> = recs_new()
    let lines: ptr<StrList> = md_splitlines(text)
    let out: ptr<i32> = malloc(8) as ptr<i32>
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let raw: string = ft_list_get(lines, i)
        let slug: string = checklist_entry(uc_strip(raw), out)
        if slug as ptr<u8> != null {
            recs_put(r, slug, out[1], out[0], raw)
        }
        i = i + 1
    }
    return r
}

# ROADMAP-SYNC:[ ]+([a-z0-9-]+)
function sync_marker(body: string) -> string {
    let p: ptr<u8> = body as ptr<u8>
    let mut at: i32 = ft_find(body, "ROADMAP-SYNC:", 0)
    while at >= 0 {
        let mut i: i32 = at + 13
        while p[i] == 32 {
            i = i + 1
        }
        if i > at + 13 {
            let s: i32 = i
            while is_slug_or_dash(p[i] as i32) {
                i = i + 1
            }
            if i > s {
                return ft_slice(body, s, i)
            }
        }
        at = ft_find(body, "ROADMAP-SYNC:", at + 1)
    }
    return null as string
}

function find_existing_issues(warn: bool) -> ptr<Records> {
    let r: ptr<Records> = recs_new()
    let status: string = ft_read_file(WORK + "/issues.status")
    if status as ptr<u8> != null and ft_starts(status, "0") == false {
        let err: string = ft_read_file(WORK + "/issues.err")
        let mut msg: string = ""
        if err as ptr<u8> != null {
            msg = uc_strip(err)
        }
        if warn {
            ft_errln("warning: gh issue list failed: " + msg)
        }
        return r
    }
    let text: string = ft_read_file(WORK + "/issues.json")
    if text as ptr<u8> == null {
        return r
    }
    let j: ptr<Json> = json_parse(text)
    if ft_len(json_error(j)) > 0 or json_kind(j, 0) != json_kind_array() {
        return r
    }
    let mut c: i32 = json_first(j, 0)
    while c >= 0 {
        let body_node: i32 = json_get(j, c, "body")
        let mut body: string = ""
        if body_node >= 0 and json_kind(j, body_node) == json_kind_string() {
            body = json_str(j, body_node)
        }
        let slug: string = sync_marker(body)
        if slug as ptr<u8> != null {
            let title_node: i32 = json_get(j, c, "title")
            let mut title: string = ""
            if title_node >= 0 and json_kind(j, title_node) == json_kind_string() {
                title = json_str(j, title_node)
            }
            let num: i32 = json_int(j, json_get(j, c, "number")) as i32
            recs_put(r, slug, num, 0, title)
        }
        c = json_next(j, c)
    }
    return r
}

# ---------------------------------------------------------------------------
# Title similarity
# ---------------------------------------------------------------------------

# set(re.findall("[a-z0-9]+", clean_text(s) minus a leading "[roadmap] ", lowered))
function token_set(s: string) -> ptr<StrList> {
    let mut t: string = clean_text(s)
    if ft_starts(t, "[roadmap]") {
        let p: ptr<u8> = t as ptr<u8>
        if p[9] != 0 and uc_is_space(uc_decode(p, 9)) {
            t = ft_from(t, skip_space(t, 9))
        }
    }
    let low: string = uc_lower_str(t)
    let lp: ptr<u8> = low as ptr<u8>
    let n: i32 = ft_len(low)
    let toks: ptr<StrList> = ft_list_new()
    let mut i: i32 = 0
    while i < n {
        if is_slug_char(lp[i] as i32) {
            let s0: i32 = i
            while i < n and is_slug_char(lp[i] as i32) {
                i = i + 1
            }
            ft_list_push(toks, ft_slice(low, s0, i))
        } else {
            i = i + 1
        }
    }
    let out: ptr<StrList> = ft_list_new()
    let seen: ptr<StrSet> = ft_set_new()
    let mut k: i32 = 0
    while k < ft_list_len(toks) {
        if ft_set_has(seen, ft_list_get(toks, k)) == false {
            ft_set_add(seen, ft_list_get(toks, k))
            ft_list_push(out, ft_list_get(toks, k))
        }
        k = k + 1
    }
    return out
}

# similarity as overlap / min(len): writes numerator and denominator.
function similarity(a: string, b: string, out: ptr<i32>) -> void {
    let ta: ptr<StrList> = token_set(a)
    let tb: ptr<StrList> = token_set(b)
    out[0] = 0
    out[1] = 1
    if ft_list_len(ta) == 0 or ft_list_len(tb) == 0 {
        return
    }
    let sb: ptr<StrSet> = ft_set_new()
    let mut i: i32 = 0
    while i < ft_list_len(tb) {
        ft_set_add(sb, ft_list_get(tb, i))
        i = i + 1
    }
    let mut overlap: i32 = 0
    i = 0
    while i < ft_list_len(ta) {
        if ft_set_has(sb, ft_list_get(ta, i)) {
            overlap = overlap + 1
        }
        i = i + 1
    }
    let mut m: i32 = ft_list_len(ta)
    if ft_list_len(tb) < m {
        m = ft_list_len(tb)
    }
    out[0] = overlap
    out[1] = m
}

# ---------------------------------------------------------------------------
# Plan
# ---------------------------------------------------------------------------

struct Plan {
    items: ptr<Items>
    order: ptr<StrList>
    checklist: ptr<Records>
    issues: ptr<Records>
    create: ptr<StrList>
    adopt_slugs: ptr<StrList>
    adopt_numbers: ptr<i32>
    adopt_n: i32
    close: ptr<i32>
    close_n: i32
}

# `warn`: report a failed gh issue list (only the first phase does).
function make_plan(roadmap_text: string, checklist_text: string, warn: bool) -> ptr<Plan> {
    let pl: ptr<Plan> = malloc(96) as ptr<Plan>
    let it: ptr<Items> = extract_open_items(roadmap_text)
    pl[0].items = it
    pl[0].order = sorted_order(it)
    pl[0].checklist = parse_checklist(checklist_text)
    pl[0].issues = find_existing_issues(warn)
    pl[0].create = ft_list_new()
    pl[0].adopt_slugs = ft_list_new()
    pl[0].adopt_numbers = malloc(4 * 4096) as ptr<i32>
    pl[0].adopt_n = 0
    let checklist: ptr<Records> = pl[0].checklist
    let issues: ptr<Records> = pl[0].issues
    let matched: ptr<StrSet> = ft_set_new()
    let sim: ptr<i32> = malloc(8) as ptr<i32>
    let order: ptr<StrList> = pl[0].order
    let mut oi: i32 = 0
    while oi < ft_list_len(order) {
        let slug: string = ft_list_get(order, oi)
        oi = oi + 1
        if recs_find(checklist, slug) >= 0 or recs_find(issues, slug) >= 0 {
            ft_set_add(matched, slug)
            continue
        }
        # Closest unmatched existing issue by title, strictly best first.
        let title: string = item_title(it, slug)
        let mut best: i32 = -1
        let mut best_num: i32 = 0
        let mut best_den: i32 = 1
        let mut k: i32 = 0
        while k < recs_len(issues) {
            let cand: string = ft_list_get(issues[0].slugs, k)
            if recs_alive(issues, k) and ft_set_has(matched, cand) == false {
                similarity(title, ft_list_get(issues[0].texts, k), sim)
                if best < 0 or (sim[0] as i64) * (best_den as i64) > (best_num as i64) * (sim[1] as i64) {
                    best = k
                    best_num = sim[0]
                    best_den = sim[1]
                }
            }
            k = k + 1
        }
        if best >= 0 and best_num * 10 >= best_den * 6 {
            let adopt_numbers: ptr<i32> = pl[0].adopt_numbers
            ft_list_push(pl[0].adopt_slugs, slug)
            adopt_numbers[pl[0].adopt_n] = recs_number(issues, best)
            pl[0].adopt_n = pl[0].adopt_n + 1
            ft_set_add(matched, ft_list_get(issues[0].slugs, best))
            ft_set_add(matched, slug)
        } else {
            ft_list_push(pl[0].create, slug)
        }
    }

    # Items that went away or were resolved: close their issue.
    let nums: ptr<i32> = malloc(4 * 8192) as ptr<i32>
    let mut nn: i32 = 0
    let mut c: i32 = 0
    while c < recs_len(checklist) {
        if recs_alive(checklist, c) and has_item(it, ft_list_get(checklist[0].slugs, c)) == false and recs_flag(checklist, c) == 0 {
            nums[nn] = recs_number(checklist, c)
            nn = nn + 1
        }
        c = c + 1
    }
    c = 0
    while c < recs_len(issues) {
        if recs_alive(issues, c) and has_item(it, ft_list_get(issues[0].slugs, c)) == false {
            nums[nn] = recs_number(issues, c)
            nn = nn + 1
        }
        c = c + 1
    }
    # sorted(set(...))
    let mut a: i32 = 0
    while a < nn {
        let mut b: i32 = a + 1
        while b < nn {
            if nums[b] < nums[a] {
                let t: i32 = nums[a]
                nums[a] = nums[b]
                nums[b] = t
            }
            b = b + 1
        }
        a = a + 1
    }
    let uniq: ptr<i32> = malloc(4 * 8192) as ptr<i32>
    let mut un: i32 = 0
    a = 0
    while a < nn {
        if un == 0 or uniq[un - 1] != nums[a] {
            uniq[un] = nums[a]
            un = un + 1
        }
        a = a + 1
    }
    pl[0].close = uniq
    pl[0].close_n = un
    return pl
}

function checklist_line(slug: string, number: i32, title: string, url: string) -> string {
    return "- [ ] #" + ft_itoa(number) + " [roadmap:" + slug + "] " + title + " " + url
}

# ---------------------------------------------------------------------------
# Arguments
# ---------------------------------------------------------------------------

struct Args {
    roadmap: string
    checklist: string
    repo: string
    dry_run: bool
    verbose: bool
    phase: string
}

function usage() -> string {
    return "usage: " + PROG + " [-h] [--roadmap ROADMAP] [--checklist CHECKLIST]\n                               [--repo REPO] [--dry-run] [--verbose]\n"
}

function arg_error(msg: string) -> i32 {
    ft_err(usage() + PROG + ": error: " + msg + "\n")
    return 2
}

function opt_name(i: i32) -> string {
    if i == 0 { return "--help" }
    if i == 1 { return "--roadmap" }
    if i == 2 { return "--checklist" }
    if i == 3 { return "--repo" }
    if i == 4 { return "--dry-run" }
    if i == 5 { return "--verbose" }
    return "--phase"
}

function parse_args(argc: i32, argv: ptr<string>, a: ptr<Args>) -> i32 {
    a[0].roadmap = "ROADMAP.md"
    a[0].checklist = "docs/project/issues-checklist.md"
    a[0].repo = "flooooooooooow/flow"
    a[0].dry_run = false
    a[0].verbose = false
    a[0].phase = "run"
    let unknown: ptr<StrList> = ft_list_new()
    let mut i: i32 = 1
    while i < argc {
        let arg: string = argv[i]
        if ft_eq(arg, "-h") {
            return 3
        }
        if ft_starts(arg, "--") == false or ft_len(arg) <= 2 {
            ft_list_push(unknown, arg)
            i = i + 1
            continue
        }
        let eq: i32 = ft_find_byte(arg, 61, 0)
        let mut name: string = arg
        let mut inline_val: string = null as string
        if eq > 0 {
            name = ft_slice(arg, 0, eq)
            inline_val = ft_from(arg, eq + 1)
        }
        let mut which: i32 = -1
        let mut k: i32 = 0
        while k < 7 {
            if ft_eq(opt_name(k), name) {
                which = k
            }
            k = k + 1
        }
        if which < 0 {
            let mut hits: string = ""
            let mut nh: i32 = 0
            k = 0
            while k < 6 {
                if ft_starts(opt_name(k), name) {
                    if nh > 0 {
                        hits = hits + ", "
                    }
                    hits = hits + opt_name(k)
                    nh = nh + 1
                    which = k
                }
                k = k + 1
            }
            if nh > 1 {
                return arg_error("ambiguous option: " + name + " could match " + hits)
            }
        }
        if which < 0 {
            ft_list_push(unknown, arg)
            i = i + 1
            continue
        }
        if which == 0 {
            return 3
        }
        if which == 4 or which == 5 {
            if inline_val as ptr<u8> != null {
                return arg_error("argument " + opt_name(which) + ": ignored explicit argument '" + inline_val + "'")
            }
            if which == 4 { a[0].dry_run = true }
            if which == 5 { a[0].verbose = true }
            i = i + 1
            continue
        }
        let mut value: string = inline_val
        if value as ptr<u8> == null {
            if i + 1 >= argc or (ft_starts(argv[i + 1], "-") and ft_len(argv[i + 1]) > 1) {
                return arg_error("argument " + opt_name(which) + ": expected one argument")
            }
            value = argv[i + 1]
            i = i + 1
        }
        if which == 1 { a[0].roadmap = value }
        if which == 2 { a[0].checklist = value }
        if which == 3 { a[0].repo = value }
        if which == 6 { a[0].phase = value }
        i = i + 1
    }
    if ft_list_len(unknown) > 0 {
        let mut joined: string = ""
        let mut u: i32 = 0
        while u < ft_list_len(unknown) {
            if u > 0 {
                joined = joined + " "
            }
            joined = joined + ft_list_get(unknown, u)
            u = u + 1
        }
        return arg_error("unrecognized arguments: " + joined)
    }
    return 0
}

# Path.is_file(): exists and is not a directory.
function is_file(path: string) -> bool {
    if ft_exists(path) == false {
        return false
    }
    let d: ptr<void> = opendir(path)
    if d != null {
        let _c: i32 = closedir(d)
        return false
    }
    return true
}

# ---------------------------------------------------------------------------
# Phases
# ---------------------------------------------------------------------------

function issue_body(a: ptr<Args>, it: ptr<Items>, slug: string) -> string {
    let mut body: string = "Automatically mirrored from [ROADMAP.md](" + a[0].roadmap + ").\n\n"
    body = body + "**Section:** " + item_section(it, slug) + "\n\n"
    body = body + "**Task:** " + item_title(it, slug) + "\n"
    if ft_len(item_extra(it, slug)) > 0 {
        body = body + "\n" + item_extra(it, slug) + "\n"
    }
    return body + "\nROADMAP-SYNC: " + slug
}

# Slug of the first existing issue with this number, or "None".
function old_slug_for(issues: ptr<Records>, number: i32) -> string {
    let mut k: i32 = 0
    while k < recs_len(issues) {
        if recs_alive(issues, k) and recs_number(issues, k) == number {
            return ft_list_get(issues[0].slugs, k)
        }
        k = k + 1
    }
    return "None"
}

function phase_plan(a: ptr<Args>, repo: string) -> i32 {
    let pl: ptr<Plan> = make_plan(ft_read_file(a[0].roadmap), ft_read_file(a[0].checklist), true)
    let it: ptr<Items> = pl[0].items
    if a[0].verbose or a[0].dry_run {
        ft_outln("Open items in ROADMAP: " + ft_itoa(ft_list_len(pl[0].order)))
        ft_outln("Already tracked in checklist: " + ft_itoa(recs_count_alive(pl[0].checklist)))
        ft_outln("Found on GitHub with roadmap label: " + ft_itoa(recs_count_alive(pl[0].issues)))
        ft_outln("To create: " + ft_itoa(ft_list_len(pl[0].create)))
        ft_outln("To adopt (reworded): " + ft_itoa(pl[0].adopt_n))
        ft_outln("To close (done): " + ft_itoa(pl[0].close_n))
    }
    let adopt_numbers: ptr<i32> = pl[0].adopt_numbers
    let close: ptr<i32> = pl[0].close
    if a[0].dry_run {
        let mut i: i32 = 0
        while i < ft_list_len(pl[0].create) {
            let slug: string = ft_list_get(pl[0].create, i)
            ft_outln("  would create: #" + slug + " :: " + item_title(it, slug) + " [" + item_section(it, slug) + "]")
            i = i + 1
        }
        i = 0
        while i < pl[0].adopt_n {
            ft_outln("  would adopt #" + ft_itoa(adopt_numbers[i]) + " for: " + ft_list_get(pl[0].adopt_slugs, i))
            i = i + 1
        }
        i = 0
        while i < pl[0].close_n {
            ft_outln("  would close: #" + ft_itoa(close[i]))
            i = i + 1
        }
        let _w: bool = ft_write_file(WORK + "/plan.txt", "dry-run\n")
        return 0
    }

    # The gh calls, one per line, tab-separated, for the shim to run in order.
    let mut plan: string = "repo\t" + repo + "\n"
    if a[0].verbose {
        plan = plan + "verbose\n"
    }
    let issues: ptr<Records> = pl[0].issues
    let mut i2: i32 = 0
    while i2 < pl[0].adopt_n {
        let slug2: string = ft_list_get(pl[0].adopt_slugs, i2)
        plan = plan + "adopt\t" + ft_itoa(adopt_numbers[i2]) + "\t" + slug2 + "\t" + old_slug_for(issues, adopt_numbers[i2]) + "\t" + item_title(it, slug2) + "\n"
        i2 = i2 + 1
    }
    i2 = 0
    while i2 < ft_list_len(pl[0].create) {
        let slug3: string = ft_list_get(pl[0].create, i2)
        let body_path: string = WORK + "/body-" + ft_itoa(i2) + ".md"
        if ft_write_file(body_path, issue_body(a, it, slug3)) == false {
            ft_errln(PROG + ": cannot write " + body_path)
            return 1
        }
        plan = plan + "create\t" + slug3 + "\t" + body_path + "\t" + item_title(it, slug3) + "\n"
        i2 = i2 + 1
    }
    i2 = 0
    while i2 < pl[0].close_n {
        plan = plan + "close\t" + ft_itoa(close[i2]) + "\n"
        i2 = i2 + 1
    }
    if ft_write_file(WORK + "/plan.txt", plan) == false {
        ft_errln(PROG + ": cannot write " + WORK + "/plan.txt")
        return 1
    }
    return 0
}

# Parse the roadmap slug out of a "#N [roadmap:slug] ..." checklist tail.
function tail_slug(tail: string) -> string {
    let at: i32 = ft_find(tail, "[roadmap:", 0)
    let p: ptr<u8> = tail as ptr<u8>
    let mut i: i32 = at + 9
    while is_slug_or_dash(p[i] as i32) {
        i = i + 1
    }
    return ft_slice(tail, at + 9, i)
}

# ^- \[([ xX])\]\s+(#\d+\s+\[roadmap:[a-z0-9-]+\].*)$ ; returns group 2 or null.
function checklist_tail(line: string) -> string {
    let out: ptr<i32> = malloc(8) as ptr<i32>
    if checklist_entry(line, out) as ptr<u8> == null {
        return null as string
    }
    let t: i32 = skip_space(line, 5)
    let tail: string = ft_from(line, t)
    # `.*` stops at a line break; stripped checklist lines have none.
    return tail
}

function phase_apply(a: ptr<Args>, repo: string) -> i32 {
    let checklist_text: string = ft_read_file(a[0].checklist)
    let pl: ptr<Plan> = make_plan(ft_read_file(a[0].roadmap), checklist_text, false)
    let it: ptr<Items> = pl[0].items
    let checklist: ptr<Records> = pl[0].checklist
    let issues: ptr<Records> = pl[0].issues
    let adopt_numbers: ptr<i32> = pl[0].adopt_numbers

    # Adopted items take over their issue number under the new slug.
    let old_to_new: ptr<StrMap> = ft_map_new()
    let new_slugs: ptr<StrSet> = ft_set_new()
    let adopted_new: ptr<StrList> = ft_list_new()
    let adopted_old: ptr<StrList> = ft_list_new()
    let mut i: i32 = 0
    while i < pl[0].adopt_n {
        let new_slug: string = ft_list_get(pl[0].adopt_slugs, i)
        let num: i32 = adopt_numbers[i]
        let old: string = old_slug_for(issues, num)
        let url: string = "https://github.com/" + repo + "/issues/" + ft_itoa(num)
        recs_put(checklist, new_slug, num, 0, checklist_line(new_slug, num, item_title(it, new_slug), url))
        if ft_eq(old, "None") == false and ft_eq(old, new_slug) == false {
            recs_pop(checklist, old)
            ft_list_push(adopted_old, old)
            ft_list_push(adopted_new, new_slug)
            ft_set_add(new_slugs, new_slug)
        }
        i = i + 1
    }

    # Lines for created issues, from the shim's record of what gh returned.
    let created: ptr<StrList> = ft_list_new()
    let created_text: string = ft_read_file(WORK + "/created.txt")
    if created_text as ptr<u8> != null {
        let rows: ptr<StrList> = ft_split_lines(created_text)
        let mut r: i32 = 0
        while r < ft_list_len(rows) {
            let row: string = ft_list_get(rows, r)
            let t1: i32 = ft_find_byte(row, 9, 0)
            let t2: i32 = ft_find_byte(row, 9, t1 + 1)
            if t1 > 0 and t2 > t1 {
                let slug: string = ft_slice(row, 0, t1)
                let num2: i32 = parse_int(ft_slice(row, t1 + 1, t2))
                let url2: string = ft_from(row, t2 + 1)
                let line: string = checklist_line(slug, num2, item_title(it, slug), url2)
                ft_list_push(created, line)
                recs_put(checklist, slug, num2, 0, line)
            }
            r = r + 1
        }
    }

    let output: ptr<StrList> = ft_list_new()
    let emitted: ptr<StrSet> = ft_set_new()
    let lines: ptr<StrList> = md_splitlines(checklist_text)
    let mut li: i32 = 0
    while li < ft_list_len(lines) {
        let line2: string = ft_list_get(lines, li)
        let tail: string = checklist_tail(uc_strip(line2))
        if tail as ptr<u8> != null {
            let slug2: string = tail_slug(tail)
            let mut replaced: bool = false
            let mut k: i32 = 0
            while k < ft_list_len(adopted_old) {
                if replaced == false and ft_eq(ft_list_get(adopted_old, k), slug2) {
                    let ns: string = ft_list_get(adopted_new, k)
                    let idx: i32 = recs_find(checklist, ns)
                    ft_list_push(output, ft_list_get(checklist[0].texts, idx))
                    ft_set_add(emitted, ns)
                    replaced = true
                }
                k = k + 1
            }
            if replaced == false {
                let mut mark: string = " "
                if has_item(it, slug2) == false {
                    mark = "x"
                }
                ft_list_push(output, "- [" + mark + "] " + tail)
            }
        } else {
            ft_list_push(output, line2)
        }
        li = li + 1
    }
    let mut c: i32 = 0
    while c < ft_list_len(created) {
        ft_list_push(output, ft_list_get(created, c))
        c = c + 1
    }
    let mut s: i32 = 0
    while s < recs_len(checklist) {
        let slug3: string = ft_list_get(checklist[0].slugs, s)
        if recs_alive(checklist, s) and ft_set_has(new_slugs, slug3) and ft_set_has(emitted, slug3) == false {
            ft_list_push(output, ft_list_get(checklist[0].texts, s))
        }
        s = s + 1
    }
    let mut text: string = ""
    let mut o: i32 = 0
    while o < ft_list_len(output) {
        if o > 0 {
            text = text + "\n"
        }
        text = text + ft_list_get(output, o)
        o = o + 1
    }
    if ft_write_file(a[0].checklist, text + "\n") == false {
        ft_errln(PROG + ": cannot write " + a[0].checklist)
        return 1
    }
    return 0
}

function parse_int(s: string) -> i32 {
    let p: ptr<u8> = s as ptr<u8>
    let mut n: i32 = 0
    let mut i: i32 = 0
    while is_digit(p[i] as i32) {
        n = n * 10 + (p[i] as i32) - 48
        i = i + 1
    }
    return n
}

# ---------------------------------------------------------------------------
# gh
# ---------------------------------------------------------------------------

const LABEL_COLOR: string = "5319E7"
const LABEL_DESC: string = "Open ROADMAP.md item synced by ./flow tool roadmap_sync"

# Byte 1, the separator between gh_cmd's arguments. (A "\x01" literal
# would reach the C output as is, where a hex escape runs on into a
# following a-f.)
function sp() -> string {
    let b: ptr<u8> = malloc(2) as ptr<u8>
    b[0] = 1
    b[1] = 0
    return b as string
}

# A gh command; `args` holds its arguments separated by sp().
function gh_cmd(args: string) -> ptr<ProcCmd> {
    let c: ptr<ProcCmd> = proc_cmd("gh")
    let mut start: i32 = 0
    let mut at: i32 = ft_find_byte(args, 1, 0)
    while at >= 0 {
        proc_arg(c, ft_slice(args, start, at))
        start = at + 1
        at = ft_find_byte(args, 1, start)
    }
    proc_arg(c, ft_from(args, start))
    return c
}

function gh_status(r: ptr<ProcResult>) -> i32 {
    if ft_len(r.error) > 0 {
        return 127
    }
    if r.exit_code < 0 {
        return 128 - r.exit_code
    }
    return r.exit_code
}

# `$(...)`: drop trailing newlines.
function chomp_nl(s: string) -> string {
    let mut n: i32 = ft_len(s)
    let p: ptr<u8> = s as ptr<u8>
    while n > 0 and p[n - 1] == 10 {
        n = n - 1
    }
    return ft_slice(s, 0, n)
}

# Run gh with stdout discarded; on failure print its stderr. False when it
# failed, which ends the run.
function run_gh_quiet(c: ptr<ProcCmd>) -> bool {
    proc_stdout(c, PROC_NULL)
    proc_stderr(c, PROC_CAPTURE)
    let r: ptr<ProcResult> = proc_run(c)
    if gh_status(r) != 0 {
        ft_errln(chomp_nl(r.stderr))
        return false
    }
    return true
}

# Run gh for its stdout (trailing newlines dropped); on failure print its
# stderr and return null.
function gh_output(c: ptr<ProcCmd>) -> string {
    proc_stdout(c, PROC_CAPTURE)
    proc_stderr(c, PROC_CAPTURE)
    let r: ptr<ProcResult> = proc_run(c)
    if gh_status(r) != 0 {
        ft_err(r.stderr)
        return null as string
    }
    return chomp_nl(r.stdout)
}

# Every "ROADMAP-SYNC: <slug>" in `body` pointed at `slug`, as
# sed -E "s/ROADMAP-SYNC: [a-z0-9-]+/ROADMAP-SYNC: $slug/g".
function retarget_marker(body: string, slug: string) -> string {
    let mut out: string = ""
    let mut from: i32 = 0
    let mut at: i32 = ft_find(body, "ROADMAP-SYNC: ", 0)
    let p: ptr<u8> = body as ptr<u8>
    while at >= 0 {
        let s: i32 = at + 14
        let mut e: i32 = s
        while is_slug_or_dash(p[e] as i32) {
            e = e + 1
        }
        if e > s {
            out = out + ft_slice(body, from, at) + "ROADMAP-SYNC: " + slug
            from = e
            at = ft_find(body, "ROADMAP-SYNC: ", e)
        } else {
            at = ft_find(body, "ROADMAP-SYNC: ", at + 1)
        }
    }
    return out + ft_from(body, from)
}

# The issue number in a gh issue create URL (".../issues/123"), or "0".
function issue_number_of(out: string) -> string {
    let mut at: i32 = ft_find(out, "issues/", 0)
    let p: ptr<u8> = out as ptr<u8>
    while at >= 0 {
        let s: i32 = at + 7
        let mut e: i32 = s
        while is_digit(p[e] as i32) {
            e = e + 1
        }
        if e > s {
            return ft_slice(out, s, e)
        }
        at = ft_find(out, "issues/", at + 1)
    }
    return "0"
}

# Field `k` (0..4) of a tab-separated plan row. The last field keeps any
# tabs, as `read -r kind a b c d` does.
function field(row: string, k: i32) -> string {
    let mut start: i32 = 0
    let mut f: i32 = 0
    while f < k {
        let t: i32 = ft_find_byte(row, 9, start)
        if t < 0 {
            return ""
        }
        start = t + 1
        f = f + 1
    }
    if k == 4 {
        return ft_from(row, start)
    }
    let t2: i32 = ft_find_byte(row, 9, start)
    if t2 < 0 {
        return ft_from(row, start)
    }
    return ft_slice(row, start, t2)
}

# `gh issue list` for every roadmap issue, left in WORK for the plan phase.
function list_issues(repo: string) -> void {
    let c: ptr<ProcCmd> = gh_cmd("issue" + sp() + "list" + sp() + "--repo" + sp() + repo + sp() + "--label" + sp() + LABEL + sp() + "--state" + sp() + "all" + sp() + "--limit" + sp() + "500" + sp() + "--json" + sp() + "number,title,body")
    proc_stdout(c, PROC_CAPTURE)
    proc_stderr(c, PROC_CAPTURE)
    let r: ptr<ProcResult> = proc_run(c)
    let _j: bool = ft_write_file(WORK + "/issues.json", r.stdout)
    let _e: bool = ft_write_file(WORK + "/issues.err", r.stderr)
    let _s: bool = ft_write_file(WORK + "/issues.status", ft_itoa(gh_status(r)) + "\n")
}

# Carry out plan.txt with gh. Returns 0, or 1 after a failed call.
function run_plan(repo: string) -> i32 {
    let rows: ptr<StrList> = ft_split_lines(ft_read_file(WORK + "/plan.txt"))
    let mut verbose: bool = false
    let mut v: i32 = 0
    while v < ft_list_len(rows) {
        if ft_eq(ft_list_get(rows, v), "verbose") {
            verbose = true
        }
        v = v + 1
    }
    let lc: ptr<ProcCmd> = gh_cmd("label" + sp() + "create" + sp() + LABEL + sp() + "--repo" + sp() + repo + sp() + "--color" + sp() + LABEL_COLOR + sp() + "--description" + sp() + LABEL_DESC)
    proc_stdout(lc, PROC_NULL)
    proc_stderr(lc, PROC_NULL)
    let _l: ptr<ProcResult> = proc_run(lc)
    let mut created: string = ""
    let _z: bool = ft_write_file(WORK + "/created.txt", "")
    let mut i: i32 = 0
    while i < ft_list_len(rows) {
        let row: string = ft_list_get(rows, i)
        let kind: string = field(row, 0)
        let a: string = field(row, 1)
        let b: string = field(row, 2)
        let c: string = field(row, 3)
        let d: string = field(row, 4)
        if ft_eq(kind, "adopt") {
            # a=number b=new slug c=old slug d=title
            if run_gh_quiet(gh_cmd("issue" + sp() + "edit" + sp() + a + sp() + "--repo" + sp() + repo + sp() + "--title" + sp() + "[roadmap] " + d)) == false {
                return 1
            }
            let body: string = gh_output(gh_cmd("issue" + sp() + "view" + sp() + a + sp() + "--repo" + sp() + repo + sp() + "--json" + sp() + "body" + sp() + "--jq" + sp() + ".body"))
            if body as ptr<u8> == null {
                return 1
            }
            let nb: string = chomp_nl(retarget_marker(body, b))
            if run_gh_quiet(gh_cmd("issue" + sp() + "edit" + sp() + a + sp() + "--repo" + sp() + repo + sp() + "--body" + sp() + nb)) == false {
                return 1
            }
            if verbose {
                ft_outln("adopted #" + a + " as '" + d + "' (was slug '" + c + "')")
            }
        } elif ft_eq(kind, "create") {
            # a=slug b=body file c=title
            let out: string = gh_output(gh_cmd("issue" + sp() + "create" + sp() + "--repo" + sp() + repo + sp() + "--label" + sp() + LABEL + sp() + "--title" + sp() + "[roadmap] " + c + sp() + "--body-file" + sp() + b))
            if out as ptr<u8> == null {
                return 1
            }
            let number: string = issue_number_of(out)
            if verbose {
                ft_outln("created #" + number + ": " + c)
            }
            created = created + a + "\t" + number + "\t" + out + "\n"
            let _w: bool = ft_write_file(WORK + "/created.txt", created)
        } elif ft_eq(kind, "close") {
            if verbose {
                ft_outln("closing #" + a)
            }
            if run_gh_quiet(gh_cmd("issue" + sp() + "close" + sp() + a + sp() + "--repo" + sp() + repo)) == false {
                return 1
            }
        }
        i = i + 1
    }
    return 0
}

# A whole sync: arguments, gh issue list, plan, the gh calls, apply.
function run_all(a: ptr<Args>, repo: string) -> i32 {
    let rm: ptr<ProcCmd> = proc_cmd("rm")
    proc_arg(rm, "-rf")
    proc_arg(rm, WORK)
    let _rm: ptr<ProcResult> = proc_run(rm)
    let mk: ptr<ProcCmd> = proc_cmd("mkdir")
    proc_arg(mk, "-p")
    proc_arg(mk, WORK)
    let _mk: ptr<ProcResult> = proc_run(mk)
    if is_file(a[0].roadmap) == false {
        ft_errln("ROADMAP file not found: " + a[0].roadmap)
        return 1
    }
    if is_file(a[0].checklist) == false {
        ft_errln("Checklist file not found: " + a[0].checklist)
        return 1
    }
    list_issues(repo)
    let rc: i32 = phase_plan(a, repo)
    if rc != 0 {
        return rc
    }
    let plan: string = ft_read_file(WORK + "/plan.txt")
    if plan as ptr<u8> != null and ft_starts(plan, "dry-run\n") {
        return 0
    }
    let rc2: i32 = run_plan(repo)
    if rc2 != 0 {
        return rc2
    }
    return phase_apply(a, repo)
}

function main(argc: i32, argv: ptr<string>) -> i32 {
    if rp_enter_root() == false {
        ft_errln(PROG + ": cannot enter the repository root")
        return 1
    }
    let a: ptr<Args> = malloc(64) as ptr<Args>
    let rc: i32 = parse_args(argc, argv, a)
    if rc == 3 {
        ft_out(usage() + "\nSync open ROADMAP.md items to GitHub issues.\n\noptions:\n  -h, --help            show this help message and exit\n  --roadmap ROADMAP\n  --checklist CHECKLIST\n  --repo REPO\n  --dry-run             show what would change without touching GitHub or files\n  --verbose\n")
        return 0
    }
    if rc != 0 {
        return rc
    }
    let repo: string = normalize_repo(a[0].repo)
    if ft_eq(a[0].phase, "run") {
        return run_all(a, repo)
    }
    if ft_eq(a[0].phase, "args") {
        if is_file(a[0].roadmap) == false {
            ft_errln("ROADMAP file not found: " + a[0].roadmap)
            return 1
        }
        if is_file(a[0].checklist) == false {
            ft_errln("Checklist file not found: " + a[0].checklist)
            return 1
        }
        ft_outln(repo)
        return 0
    }
    if ft_eq(a[0].phase, "plan") {
        return phase_plan(a, repo)
    }
    if ft_eq(a[0].phase, "apply") {
        return phase_apply(a, repo)
    }
    ft_errln(PROG + ": unknown phase " + a[0].phase)
    return 2
}
