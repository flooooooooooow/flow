# Dependency sync check for `flow run`, written in Flow.
#
# Usage: pkg_sync </absolute/path/to/program.flow>
#
# Answers one question before a program is compiled: does the project that
# contains this program need `flow sync` to install anything? It mirrors
# FlowPackageManager.sync_for_program in src/flow/package.py:
#
#   - no flow.toml above the program          -> nothing to do
#   - flow.toml with an empty [dependencies]   -> nothing to do
#   - flow.lock present and every dependency
#     directory present under flow_packages/  -> nothing to do
#   - anything else                            -> an install is needed
#
# Exit status:
#   0  nothing to do
#   3  an install is needed, or the manifest uses TOML this reader does not
#      parse (dotted dependency keys, multi-line values). The driver then
#      hands the program to the full package manager, so those projects
#      behave exactly as before.
#   2  usage error

extern {
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function strlen(s: string) -> i64
    function strcmp(a: string, b: string) -> i32
    function fopen(path: string, mode: string) -> ptr<void>
    function fclose(fp: ptr<void>) -> i32
    function fread(buf: ptr<u8>, size: i64, count: i64, fp: ptr<void>) -> i32
    function access(path: string, mode: i32) -> i32
    function puts(s: string) -> i32
}

const EXIT_IN_SYNC: i32 = 0
const EXIT_USAGE: i32 = 2
const EXIT_NEEDS_SYNC: i32 = 3
const READ_CAP: i32 = 1048576
const MAX_DEPS: i32 = 256

function concat(a: string, b: string) -> string {
    let na: i32 = strlen(a) as i32
    let nb: i32 = strlen(b) as i32
    let out: ptr<u8> = malloc((na + nb + 1) as i64) as ptr<u8>
    let pa: ptr<u8> = a as ptr<u8>
    let pb: ptr<u8> = b as ptr<u8>
    let mut i: i32 = 0
    while i < na {
        out[i] = pa[i]
        i = i + 1
    }
    let mut j: i32 = 0
    while j < nb {
        out[na + j] = pb[j]
        j = j + 1
    }
    out[na + nb] = 0
    return out as string
}

# Copy bytes [start, end) of s into a new string.
function slice(s: string, start: i32, end: i32) -> string {
    let n: i32 = end - start
    let out: ptr<u8> = malloc((n + 1) as i64) as ptr<u8>
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    while i < n {
        out[i] = p[start + i]
        i = i + 1
    }
    out[n] = 0
    return out as string
}

function file_exists(path: string) -> bool {
    return access(path, 0) == 0
}

function is_regular_readable(path: string) -> bool {
    let fp: ptr<void> = fopen(path, "rb")
    if fp == null {
        return false
    }
    let _c: i32 = fclose(fp)
    return true
}

function read_whole_file(path: string) -> string {
    let fp: ptr<void> = fopen(path, "rb")
    if fp == null {
        return ""
    }
    let buf: ptr<u8> = malloc(READ_CAP as i64) as ptr<u8>
    let n: i32 = fread(buf, 1, (READ_CAP - 1) as i64, fp)
    let _c: i32 = fclose(fp)
    if n < 0 {
        buf[0] = 0
        return buf as string
    }
    buf[n] = 0
    return buf as string
}

# Directory part of an absolute path ("/a/b/c" -> "/a/b", "/a" -> "/").
function parent_dir(path: string) -> string {
    let p: ptr<u8> = path as ptr<u8>
    let n: i32 = strlen(path) as i32
    let mut i: i32 = n - 1
    while i > 0 {
        if p[i] == 47 {
            return slice(path, 0, i)
        }
        i = i - 1
    }
    return "/"
}

function join_path(dir: string, name: string) -> string {
    if strcmp(dir, "/") == 0 {
        return concat("/", name)
    }
    return concat(concat(dir, "/"), name)
}

function is_space(c: i32) -> bool {
    return c == 32 or c == 9 or c == 13
}

function is_bare_key_char(c: i32) -> bool {
    if c >= 97 and c <= 122 { return true }
    if c >= 65 and c <= 90 { return true }
    if c >= 48 and c <= 57 { return true }
    return c == 95 or c == 45
}

# True when bytes [start, end) of s equal word exactly.
function span_eq(s: string, start: i32, end: i32, word: string) -> bool {
    let n: i32 = strlen(word) as i32
    if end - start != n {
        return false
    }
    let p: ptr<u8> = s as ptr<u8>
    let w: ptr<u8> = word as ptr<u8>
    let mut i: i32 = 0
    while i < n {
        if p[start + i] != w[i] {
            return false
        }
        i = i + 1
    }
    return true
}

function span_starts_with(s: string, start: i32, end: i32, word: string) -> bool {
    let n: i32 = strlen(word) as i32
    if end - start < n {
        return false
    }
    return span_eq(s, start, start + n, word)
}

# True when bytes [start, end) hold three of the same quote byte in a row,
# the opening of a TOML multi-line string (34 is a double quote, 39 single).
function span_has_triple_quote(s: string, start: i32, end: i32) -> bool {
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = start
    while i + 3 <= end {
        let c: i32 = p[i] as i32
        if (c == 34 or c == 39) and p[i + 1] as i32 == c and p[i + 2] as i32 == c {
            return true
        }
        i = i + 1
    }
    return false
}

function span_has_byte(s: string, start: i32, end: i32, c: i32) -> bool {
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = start
    while i < end {
        if p[i] as i32 == c {
            return true
        }
        i = i + 1
    }
    return false
}

# Collect the keys of the top-level [dependencies] table into names.
# Returns the number of keys, or -1 when the manifest uses a form this
# reader leaves to the full TOML parser.
function dependency_names(src: string, names: ptr<string>) -> i32 {
    let p: ptr<u8> = src as ptr<u8>
    let n: i32 = strlen(src) as i32
    let mut count: i32 = 0
    # 0 = root table, 1 = [dependencies], 2 = some other table
    let mut state: i32 = 0
    let mut pos: i32 = 0
    while pos < n {
        let mut eol: i32 = pos
        while eol < n and p[eol] != 10 {
            eol = eol + 1
        }
        let mut s: i32 = pos
        while s < eol and is_space(p[s] as i32) {
            s = s + 1
        }
        let mut e: i32 = eol
        while e > s and is_space(p[e - 1] as i32) {
            e = e - 1
        }
        pos = eol + 1

        if s == e or p[s] == 35 {
            continue
        }
        # A multi-line string could hide a line that looks like a header.
        if span_has_triple_quote(src, s, e) {
            return -1
        }
        if p[s] == 91 {
            if span_starts_with(src, s, e, "[[") {
                state = 2
                continue
            }
            let mut hs: i32 = s + 1
            while hs < e and is_space(p[hs] as i32) {
                hs = hs + 1
            }
            let mut he: i32 = hs
            while he < e and p[he] != 93 {
                he = he + 1
            }
            if he >= e {
                return -1
            }
            while he > hs and is_space(p[he - 1] as i32) {
                he = he - 1
            }
            if span_eq(src, hs, he, "dependencies") {
                state = 1
                continue
            }
            # [dependencies.name] or a quoted header: leave to the full parser.
            if span_starts_with(src, hs, he, "dependencies") or span_starts_with(src, hs, he, "\"dependencies") {
                return -1
            }
            state = 2
            continue
        }
        if state == 0 {
            if span_starts_with(src, s, e, "dependencies") or span_starts_with(src, s, e, "\"dependencies") {
                return -1
            }
            continue
        }
        if state == 2 {
            continue
        }

        # state == 1: a `name = spec` line inside [dependencies].
        let mut ks: i32 = s
        let mut ke: i32 = s
        let mut k: i32 = s
        if p[s] == 34 {
            ks = s + 1
            k = ks
            while k < e and p[k] != 34 and p[k] != 92 {
                k = k + 1
            }
            if k >= e or p[k] == 92 {
                return -1
            }
            ke = k
            k = k + 1
        } else {
            while k < e and is_bare_key_char(p[k] as i32) {
                k = k + 1
            }
            ke = k
        }
        if ke == ks {
            return -1
        }
        while k < e and is_space(p[k] as i32) {
            k = k + 1
        }
        if k >= e or p[k] != 61 {
            return -1
        }
        k = k + 1
        while k < e and is_space(p[k] as i32) {
            k = k + 1
        }
        if k >= e {
            return -1
        }
        if p[k] == 91 {
            return -1
        }
        if p[k] == 123 and span_has_byte(src, k, e, 125) == false {
            return -1
        }
        if count >= MAX_DEPS {
            return -1
        }
        names[count] = slice(src, ks, ke)
        count = count + 1
    }
    return count
}

function find_flow_toml(start_dir: string) -> string {
    let mut dir: string = start_dir
    while 1 == 1 {
        let candidate: string = join_path(dir, "flow.toml")
        if is_regular_readable(candidate) {
            return candidate
        }
        if strcmp(dir, "/") == 0 {
            return ""
        }
        dir = parent_dir(dir)
    }
    return ""
}

function main(argc: i32, argv: ptr<ptr<u8>>) -> i32 {
    if argc < 2 {
        puts("usage: pkg_sync <program.flow>")
        return EXIT_USAGE
    }
    let program: string = argv[1] as string
    let pp: ptr<u8> = program as ptr<u8>
    if pp[0] != 47 {
        # The driver passes a resolved absolute path. Anything else goes to
        # the full package manager, which resolves it itself.
        return EXIT_NEEDS_SYNC
    }
    let toml_path: string = find_flow_toml(parent_dir(program))
    if strlen(toml_path) == 0 {
        return EXIT_IN_SYNC
    }
    let project_dir: string = parent_dir(toml_path)
    let src: string = read_whole_file(toml_path)
    let names: ptr<string> = malloc((MAX_DEPS as i64) * 8) as ptr<string>
    let count: i32 = dependency_names(src, names)
    if count < 0 {
        return EXIT_NEEDS_SYNC
    }
    if count == 0 {
        return EXIT_IN_SYNC
    }
    if file_exists(join_path(project_dir, "flow.lock")) == false {
        return EXIT_NEEDS_SYNC
    }
    let packages_dir: string = join_path(project_dir, "flow_packages")
    let mut i: i32 = 0
    while i < count {
        if file_exists(join_path(packages_dir, names[i])) == false {
            return EXIT_NEEDS_SYNC
        }
        i = i + 1
    }
    return EXIT_IN_SYNC
}
