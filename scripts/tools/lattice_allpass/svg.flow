# @module tools.lattice_allpass.svg
# @means  A small SVG plotting layer: figures, axes with linear or log
#         scales, ticks, grids, lines, bars, markers, arrows, legends,
#         heatmaps and colorbars.
#
# Units are points (72 per inch), so a figure declared as 13 x 10 inches is
# 936 x 720 pt, the size matplotlib's SVG backend would give it. Heatmaps are
# embedded as paletted PNG images (stored deflate blocks, CRC-32, Adler-32,
# base64) so a spectrogram stays one element instead of 100k rectangles.

import .text { ft_len, ft_itoa }

extern {
    function malloc(size: i64) -> ptr<void>
    function calloc(n: i64, size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
    function memcpy(dst: ptr<u8>, src: ptr<u8>, n: i64) -> ptr<u8>
    function strlen(s: string) -> i64
    function snprintf(buf: ptr<i8>, size: i64, fmt: string, value: f64) -> i32
    function fopen(path: string, mode: string) -> ptr<void>
    function fclose(fp: ptr<void>) -> i32
    function fwrite(buf: ptr<u8>, size: i64, count: i64, fp: ptr<void>) -> i64
    function log10(x: f64) -> f64
    function pow(x: f64, y: f64) -> f64
    function floor(x: f64) -> f64
    function ceil(x: f64) -> f64
    function fabs(x: f64) -> f64
    function sqrt(x: f64) -> f64
    function atan2(y: f64, x: f64) -> f64
    function cos(x: f64) -> f64
    function sin(x: f64) -> f64
}

# ---- growable byte buffer ----

export struct SvgBuf {
    data: ptr<u8>
    len: i64
    cap: i64
}

export function sb_new() -> ptr<SvgBuf> {
    let b: ptr<SvgBuf> = malloc(24) as ptr<SvgBuf>
    b[0].cap = 65536
    b[0].len = 0
    b[0].data = malloc(65536) as ptr<u8>
    return b
}

function sb_reserve(b: ptr<SvgBuf>, extra: i64) -> void {
    if b[0].len + extra + 1 > b[0].cap {
        let mut nc: i64 = b[0].cap * 2
        while b[0].len + extra + 1 > nc {
            nc = nc * 2
        }
        b[0].data = realloc(b[0].data as ptr<void>, nc) as ptr<u8>
        b[0].cap = nc
    }
}

export function sb_add(b: ptr<SvgBuf>, s: string) -> void {
    let n: i64 = strlen(s)
    sb_reserve(b, n)
    let d: ptr<u8> = b[0].data
    let _m: ptr<u8> = memcpy(&d[b[0].len as i32] as ptr<u8>, s as ptr<u8>, n)
    b[0].len = b[0].len + n
}

export function sb_byte(b: ptr<SvgBuf>, c: i32) -> void {
    sb_reserve(b, 1)
    let d: ptr<u8> = b[0].data
    d[b[0].len as i32] = c as u8
    b[0].len = b[0].len + 1
}

export function sb_write(b: ptr<SvgBuf>, path: string) -> bool {
    let fp: ptr<void> = fopen(path, "wb")
    if fp == null {
        return false
    }
    let w: i64 = fwrite(b[0].data, 1, b[0].len, fp)
    let _c: i32 = fclose(fp)
    return w == b[0].len
}

# ---- number and text formatting ----

export function fmtf(fmt: string, v: f64) -> string {
    let buf: ptr<i8> = malloc(64) as ptr<i8>
    let _n: i32 = snprintf(buf, 64, fmt, v)
    return buf as string
}

# Coordinates: two decimals, trailing zeros dropped.
export function sv_num(v: f64) -> string {
    let s: string = fmtf("%.2f", v)
    let p: ptr<u8> = s as ptr<u8>
    let mut n: i32 = ft_len(s)
    while n > 0 and p[n - 1] == 48 {
        n = n - 1
    }
    if n > 0 and p[n - 1] == 46 {
        n = n - 1
    }
    p[n] = 0
    if n == 2 and p[0] == 45 and p[1] == 48 {
        return "0"
    }
    return s
}

# XML text escaping.
export function sv_esc(s: string) -> string {
    let p: ptr<u8> = s as ptr<u8>
    let n: i32 = ft_len(s)
    let b: ptr<SvgBuf> = sb_new()
    let mut i: i32 = 0
    while i < n {
        let c: i32 = p[i] as i32
        if c == 38 {
            sb_add(b, "&amp;")
        } elif c == 60 {
            sb_add(b, "&lt;")
        } elif c == 62 {
            sb_add(b, "&gt;")
        } else {
            sb_byte(b, c)
        }
        i = i + 1
    }
    sb_byte(b, 0)
    return b[0].data as string
}

# Tick label with a proper minus sign, as matplotlib draws it.
function tick_minus(s: string) -> string {
    let p: ptr<u8> = s as ptr<u8>
    if p[0] == 45 {
        let rest: string = (&p[1]) as string
        if ft_len(rest) > 0 {
            return "−" + rest
        }
    }
    return s
}

# ---- colormaps ----

export struct Cmap {
    rgb: ptr<u8>
}

function hexv(c: u8) -> i32 {
    if c >= 48 and c <= 57 {
        return (c - 48) as i32
    }
    return (c - 55) as i32
}

export function cmap_from_hex(h: string) -> Cmap {
    let p: ptr<u8> = h as ptr<u8>
    let rgb: ptr<u8> = malloc(768) as ptr<u8>
    let mut i: i32 = 0
    while i < 768 {
        rgb[i] = (hexv(p[2 * i]) * 16 + hexv(p[2 * i + 1])) as u8
        i = i + 1
    }
    return Cmap { rgb: rgb }
}

export function cmap_named(name: string) -> Cmap {
    let p: ptr<u8> = name as ptr<u8>
    if p[0] == 109 {
        return cmap_from_hex(cmap_hex_magma())
    }
    if p[0] == 116 {
        return cmap_from_hex(cmap_hex_twilight_shifted())
    }
    if p[0] == 82 {
        return cmap_from_hex(cmap_hex_rdylbu_r())
    }
    if p[0] == 118 {
        return cmap_from_hex(cmap_hex_viridis())
    }
    return cmap_from_hex(cmap_hex_plasma())
}

# Colormap.__call__(t): index int(t * 256), clipped to [0, 255].
export function cmap_index(t: f64) -> i32 {
    if t != t {
        return 0
    }
    let mut i: i32 = (t * 256.0) as i32
    if t < 0.0 {
        i = 0
    }
    if i < 0 {
        i = 0
    }
    if i > 255 {
        i = 255
    }
    return i
}

function hex2(v: i32) -> string {
    let digits: string = "0123456789abcdef"
    let d: ptr<u8> = digits as ptr<u8>
    let out: ptr<u8> = malloc(3) as ptr<u8>
    out[0] = d[(v >> 4) & 15]
    out[1] = d[v & 15]
    out[2] = 0
    return out as string
}

export function cmap_color(c: Cmap, t: f64) -> string {
    let i: i32 = cmap_index(t)
    let rgb: ptr<u8> = c.rgb
    return "#" + hex2(rgb[3 * i] as i32) + hex2(rgb[3 * i + 1] as i32) + hex2(rgb[3 * i + 2] as i32)
}

# ---- PNG (paletted, stored deflate) and base64 ----

function crc_table() -> ptr<u32> {
    let t: ptr<u32> = malloc(1024) as ptr<u32>
    let mut n: i32 = 0
    while n < 256 {
        let mut c: u32 = n as u32
        let mut k: i32 = 0
        while k < 8 {
            if (c & 1) == 1 {
                c = 0xEDB88320 ^ (c >> 1)
            } else {
                c = c >> 1
            }
            k = k + 1
        }
        t[n] = c
        n = n + 1
    }
    return t
}

function crc32(t: ptr<u32>, d: ptr<u8>, start: i64, n: i64) -> u32 {
    let mut c: u32 = 0xFFFFFFFF
    let mut i: i64 = 0
    while i < n {
        let byte: u32 = d[(start + i) as i32] as u32
        c = t[((c ^ byte) & 255) as i32] ^ (c >> 8)
        i = i + 1
    }
    return c ^ 0xFFFFFFFF
}

function be32(b: ptr<SvgBuf>, v: u32) -> void {
    sb_byte(b, ((v >> 24) & 255) as i32)
    sb_byte(b, ((v >> 16) & 255) as i32)
    sb_byte(b, ((v >> 8) & 255) as i32)
    sb_byte(b, (v & 255) as i32)
}

# One chunk: length, type, payload, CRC over type + payload.
function png_chunk(b: ptr<SvgBuf>, crc: ptr<u32>, kind: string, payload: ptr<u8>, n: i64) -> void {
    be32(b, n as u32)
    let start: i64 = b[0].len
    sb_add(b, kind)
    sb_reserve(b, n)
    if n > 0 {
        let d: ptr<u8> = b[0].data
        let _m: ptr<u8> = memcpy(&d[b[0].len as i32] as ptr<u8>, payload, n)
        b[0].len = b[0].len + n
    }
    be32(b, crc32(crc, b[0].data, start, n + 4))
}

# PNG bytes for a w x h image of palette indices (row 0 on top).
export function png_indexed(w: i32, h: i32, idx: ptr<u8>, pal: Cmap) -> ptr<SvgBuf> {
    let crc: ptr<u32> = crc_table()
    let b: ptr<SvgBuf> = sb_new()
    let sig: array<i32, 8> = [137, 80, 78, 71, 13, 10, 26, 10]
    let mut i: i32 = 0
    while i < 8 {
        sb_byte(b, sig[i])
        i = i + 1
    }
    let ihdr: ptr<u8> = calloc(13, 1) as ptr<u8>
    ihdr[0] = ((w >> 24) & 255) as u8
    ihdr[1] = ((w >> 16) & 255) as u8
    ihdr[2] = ((w >> 8) & 255) as u8
    ihdr[3] = (w & 255) as u8
    ihdr[4] = ((h >> 24) & 255) as u8
    ihdr[5] = ((h >> 16) & 255) as u8
    ihdr[6] = ((h >> 8) & 255) as u8
    ihdr[7] = (h & 255) as u8
    ihdr[8] = 8
    ihdr[9] = 3
    png_chunk(b, crc, "IHDR", ihdr, 13)
    png_chunk(b, crc, "PLTE", pal.rgb, 768)

    # Raw scanlines: filter byte 0 then the row.
    let row: i64 = (w + 1) as i64
    let raw_n: i64 = row * (h as i64)
    let raw: ptr<u8> = malloc(raw_n) as ptr<u8>
    let mut y: i32 = 0
    while y < h {
        raw[(y as i64 * row) as i32] = 0
        let mut x: i32 = 0
        while x < w {
            raw[(y as i64 * row + 1 + x as i64) as i32] = idx[y * w + x]
            x = x + 1
        }
        y = y + 1
    }
    # zlib stream of stored blocks.
    let nblocks: i64 = (raw_n + 65534) / 65535
    let z_n: i64 = 2 + raw_n + 5 * nblocks + 4
    let z: ptr<u8> = malloc(z_n) as ptr<u8>
    z[0] = 0x78
    z[1] = 0x01
    let mut at: i64 = 2
    let mut off: i64 = 0
    while off < raw_n {
        let mut len: i64 = raw_n - off
        if len > 65535 {
            len = 65535
        }
        let mut final: u8 = 0
        if off + len == raw_n {
            final = 1
        }
        z[at as i32] = final
        z[(at + 1) as i32] = (len & 255) as u8
        z[(at + 2) as i32] = ((len >> 8) & 255) as u8
        z[(at + 3) as i32] = ((len ^ 0xFFFF) & 255) as u8
        z[(at + 4) as i32] = (((len ^ 0xFFFF) >> 8) & 255) as u8
        at = at + 5
        let _m: ptr<u8> = memcpy(&z[at as i32] as ptr<u8>, &raw[off as i32] as ptr<u8>, len)
        at = at + len
        off = off + len
    }
    let mut s1: u32 = 1
    let mut s2: u32 = 0
    let mut j: i64 = 0
    while j < raw_n {
        s1 = (s1 + (raw[j as i32] as u32)) % 65521
        s2 = (s2 + s1) % 65521
        j = j + 1
    }
    let adler: u32 = (s2 << 16) | s1
    z[at as i32] = ((adler >> 24) & 255) as u8
    z[(at + 1) as i32] = ((adler >> 16) & 255) as u8
    z[(at + 2) as i32] = ((adler >> 8) & 255) as u8
    z[(at + 3) as i32] = (adler & 255) as u8
    at = at + 4
    png_chunk(b, crc, "IDAT", z, at)
    png_chunk(b, crc, "IEND", null, 0)
    return b
}

export function base64(d: ptr<u8>, n: i64) -> string {
    let alpha: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let a: ptr<u8> = alpha as ptr<u8>
    let out_n: i64 = ((n + 2) / 3) * 4
    let o: ptr<u8> = malloc(out_n + 1) as ptr<u8>
    let mut i: i64 = 0
    let mut at: i64 = 0
    while i < n {
        let b0: i32 = d[i as i32] as i32
        let mut b1: i32 = 0
        let mut b2: i32 = 0
        if i + 1 < n {
            b1 = d[(i + 1) as i32] as i32
        }
        if i + 2 < n {
            b2 = d[(i + 2) as i32] as i32
        }
        o[at as i32] = a[b0 >> 2]
        o[(at + 1) as i32] = a[((b0 & 3) << 4) | (b1 >> 4)]
        if i + 1 < n {
            o[(at + 2) as i32] = a[((b1 & 15) << 2) | (b2 >> 6)]
        } else {
            o[(at + 2) as i32] = 61
        }
        if i + 2 < n {
            o[(at + 3) as i32] = a[b2 & 63]
        } else {
            o[(at + 3) as i32] = 61
        }
        at = at + 4
        i = i + 3
    }
    o[at as i32] = 0
    return o as string
}

export function png_data_uri(w: i32, h: i32, idx: ptr<u8>, pal: Cmap) -> string {
    let png: ptr<SvgBuf> = png_indexed(w, h, idx, pal)
    return "data:image/png;base64," + base64(png[0].data, png[0].len)
}

# ---- figure ----

export struct Fig {
    b: ptr<SvgBuf>
    w: f64
    h: f64
    clips: i32
}

export function fig_new(w_in: f64, h_in: f64, face: string) -> ptr<Fig> {
    let f: ptr<Fig> = malloc(40) as ptr<Fig>
    f[0].b = sb_new()
    f[0].w = w_in * 72.0
    f[0].h = h_in * 72.0
    f[0].clips = 0
    let b: ptr<SvgBuf> = f[0].b
    sb_add(b, "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n")
    sb_add(b, "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" + sv_num(f[0].w) + "pt\" height=\"" + sv_num(f[0].h) + "pt\" viewBox=\"0 0 " + sv_num(f[0].w) + " " + sv_num(f[0].h) + "\" font-family=\"DejaVu Sans, Helvetica, Arial, sans-serif\">\n")
    sb_add(b, "<rect x=\"0\" y=\"0\" width=\"" + sv_num(f[0].w) + "\" height=\"" + sv_num(f[0].h) + "\" fill=\"" + face + "\"/>\n")
    return f
}

export function fig_add(f: ptr<Fig>, s: string) -> void {
    sb_add(f[0].b, s)
}

# Text at figure coordinates in points. anchor: start | middle | end.
export function fig_text_at(f: ptr<Fig>, x: f64, y: f64, s: string, size: f64, anchor: string, color: string, weight: string, style: string, rotate: f64) -> void {
    let mut t: string = "<text x=\"" + sv_num(x) + "\" y=\"" + sv_num(y) + "\" font-size=\"" + sv_num(size) + "\" text-anchor=\"" + anchor + "\" fill=\"" + color + "\""
    if ft_len(weight) > 0 {
        t = t + " font-weight=\"" + weight + "\""
    }
    if ft_len(style) > 0 {
        t = t + " font-style=\"" + style + "\""
    }
    if rotate != 0.0 {
        t = t + " transform=\"rotate(" + sv_num(rotate) + " " + sv_num(x) + " " + sv_num(y) + ")\""
    }
    fig_add(f, t + ">" + sv_esc(s) + "</text>\n")
}

# Figure-fraction text (x from the left, y from the bottom), like fig.text.
export function fig_text(f: ptr<Fig>, fx: f64, fy: f64, s: string, size: f64, color: string, weight: string, style: string) -> void {
    fig_text_at(f, fx * f[0].w, (1.0 - fy) * f[0].h + size * 0.35, s, size, "middle", color, weight, style, 0.0)
}

export function fig_suptitle(f: ptr<Fig>, s: string, size: f64) -> void {
    fig_text_at(f, f[0].w / 2.0, size * 1.6, s, size, "middle", "#000000", "bold", "", 0.0)
}

export function fig_save(f: ptr<Fig>, path: string) -> bool {
    sb_add(f[0].b, "</svg>\n")
    return sb_write(f[0].b, path)
}

# ---- axes ----

export struct Ax {
    f: ptr<Fig>
    x: f64
    y: f64
    w: f64
    h: f64
    x0: f64
    x1: f64
    y0: f64
    y1: f64
    xlog: bool
    ylog: bool
    clip: i32
    hide_xlabels: bool
    xt_n: i32
    xt_pos: ptr<f64>
    xt_lab: ptr<string>
    xt_rot: f64
    nleg: i32
    leg_label: ptr<string>
    leg_color: ptr<string>
    leg_kind: ptr<i32>
    leg_dash: ptr<string>
    leg_alpha: ptr<f64>
}

export function ax_new(f: ptr<Fig>, x: f64, y: f64, w: f64, h: f64) -> ptr<Ax> {
    let a: ptr<Ax> = calloc(1, 256) as ptr<Ax>
    a[0].f = f
    a[0].x = x
    a[0].y = y
    a[0].w = w
    a[0].h = h
    a[0].x0 = 0.0
    a[0].x1 = 1.0
    a[0].y0 = 0.0
    a[0].y1 = 1.0
    a[0].xlog = false
    a[0].ylog = false
    a[0].hide_xlabels = false
    a[0].xt_n = 0
    a[0].xt_rot = 0.0
    a[0].nleg = 0
    a[0].leg_label = malloc(8 * 16) as ptr<string>
    a[0].leg_color = malloc(8 * 16) as ptr<string>
    a[0].leg_kind = malloc(4 * 16) as ptr<i32>
    a[0].leg_dash = malloc(8 * 16) as ptr<string>
    a[0].leg_alpha = malloc(8 * 16) as ptr<f64>
    let c: i32 = f[0].clips + 1
    f[0].clips = c
    a[0].clip = c
    return a
}

export function ax_lim(a: ptr<Ax>, x0: f64, x1: f64, y0: f64, y1: f64) -> void {
    a[0].x0 = x0
    a[0].x1 = x1
    a[0].y0 = y0
    a[0].y1 = y1
}

export function ax_xlog(a: ptr<Ax>) -> void {
    a[0].xlog = true
}

function tr(v: f64, lg: bool) -> f64 {
    if lg {
        if v <= 0.0 {
            return -1000.0
        }
        return log10(v)
    }
    return v
}

export function ax_px(a: ptr<Ax>, v: f64) -> f64 {
    let lg: bool = a[0].xlog
    let t0: f64 = tr(a[0].x0, lg)
    let t1: f64 = tr(a[0].x1, lg)
    return a[0].x + (tr(v, lg) - t0) / (t1 - t0) * a[0].w
}

export function ax_py(a: ptr<Ax>, v: f64) -> f64 {
    let lg: bool = a[0].ylog
    let t0: f64 = tr(a[0].y0, lg)
    let t1: f64 = tr(a[0].y1, lg)
    return a[0].y + a[0].h - (tr(v, lg) - t0) / (t1 - t0) * a[0].h
}

# Data limits padded by matplotlib's default 5% margin.
export function pad_lo(lo: f64, hi: f64, lg: bool) -> f64 {
    if lg {
        let a: f64 = log10(lo)
        let b: f64 = log10(hi)
        return pow(10.0, a - 0.05 * (b - a))
    }
    if hi == lo {
        return lo - 0.05 * fabs(lo) - 0.05
    }
    return lo - 0.05 * (hi - lo)
}

export function pad_hi(lo: f64, hi: f64, lg: bool) -> f64 {
    if lg {
        let a: f64 = log10(lo)
        let b: f64 = log10(hi)
        return pow(10.0, b + 0.05 * (b - a))
    }
    if hi == lo {
        return hi + 0.05 * fabs(hi) + 0.05
    }
    return hi + 0.05 * (hi - lo)
}

# Set x/y limits from data with margins; returns via the axes.
export function ax_autoscale(a: ptr<Ax>, xmin: f64, xmax: f64, ymin: f64, ymax: f64) -> void {
    a[0].x0 = pad_lo(xmin, xmax, a[0].xlog)
    a[0].x1 = pad_hi(xmin, xmax, a[0].xlog)
    a[0].y0 = pad_lo(ymin, ymax, a[0].ylog)
    a[0].y1 = pad_hi(ymin, ymax, a[0].ylog)
}

export function ax_xticks(a: ptr<Ax>, n: i32, pos: ptr<f64>, labels: ptr<string>, rot: f64) -> void {
    a[0].xt_n = n
    a[0].xt_pos = pos
    a[0].xt_lab = labels
    a[0].xt_rot = rot
}

# ---- ticks ----

# Nice linear step (1, 2, 2.5, 5, 10 times a power of ten) giving at most
# `nbins` intervals over [lo, hi].
function nice_step(lo: f64, hi: f64, nbins: i32) -> f64 {
    let span: f64 = hi - lo
    if span <= 0.0 {
        return 1.0
    }
    let raw: f64 = span / (nbins as f64)
    let mag: f64 = pow(10.0, floor(log10(raw)))
    let steps: array<f64, 5> = [1.0, 2.0, 2.5, 5.0, 10.0]
    let mut i: i32 = 0
    while i < 5 {
        let s: f64 = steps[i] * mag
        if s >= raw * 0.999999 {
            return s
        }
        i = i + 1
    }
    return 10.0 * mag
}

function step_decimals(step: f64) -> i32 {
    let e: f64 = floor(log10(step) + 1e-9)
    let mut d: i32 = 0
    if e < 0.0 {
        d = (0.0 - e) as i32
    }
    let m: f64 = step / pow(10.0, e)
    if fabs(m - 2.5) < 1e-6 {
        d = d + 1
    }
    return d
}

function fixed_fmt(d: i32) -> string {
    if d <= 0 {
        return "%.0f"
    }
    return "%." + ft_itoa(d) + "f"
}

function lin_label(v: f64, d: i32) -> string {
    let mut x: f64 = v
    if fabs(x) < 1e-12 {
        x = 0.0
    }
    return tick_minus(fmtf(fixed_fmt(d), x))
}

function pow10_label(e: i32) -> string {
    return "10<tspan dy=\"-5\" font-size=\"70%\">" + tick_minus(ft_itoa(e)) + "</tspan>"
}

function line_el(x0: f64, y0: f64, x1: f64, y1: f64, color: string, lw: f64, extra: string) -> string {
    return "<line x1=\"" + sv_num(x0) + "\" y1=\"" + sv_num(y0) + "\" x2=\"" + sv_num(x1) + "\" y2=\"" + sv_num(y1) + "\" stroke=\"" + color + "\" stroke-width=\"" + sv_num(lw) + "\"" + extra + "/>\n"
}

function grid_attr(alpha: f64) -> string {
    return " stroke-opacity=\"" + sv_num(alpha) + "\""
}

# Tick marks, labels and optional grid for one axes. grid: 0 none, 1 both
# axes, 2 x only, 3 y only. Minor log gridlines are drawn with `minor`.
export function ax_axes(a: ptr<Ax>, grid: i32, grid_alpha: f64, minor: bool, face: string) -> void {
    let f: ptr<Fig> = a[0].f
    let ax: f64 = a[0].x
    let ay: f64 = a[0].y
    let aw: f64 = a[0].w
    let ah: f64 = a[0].h
    fig_add(f, "<rect x=\"" + sv_num(ax) + "\" y=\"" + sv_num(ay) + "\" width=\"" + sv_num(aw) + "\" height=\"" + sv_num(ah) + "\" fill=\"" + face + "\"/>\n")
    fig_add(f, "<clipPath id=\"c" + ft_itoa(a[0].clip) + "\"><rect x=\"" + sv_num(ax) + "\" y=\"" + sv_num(ay) + "\" width=\"" + sv_num(aw) + "\" height=\"" + sv_num(ah) + "\"/></clipPath>\n")
    let gx: bool = grid == 1 or grid == 2
    let gy: bool = grid == 1 or grid == 3
    let bottom: f64 = ay + ah
    let tick_len: f64 = 3.5

    # x axis
    if a[0].xt_n > 0 {
        let mut i: i32 = 0
        while i < a[0].xt_n {
            let pos: ptr<f64> = a[0].xt_pos
            let lab: ptr<string> = a[0].xt_lab
            let px: f64 = ax_px(a, pos[i])
            fig_add(f, line_el(px, bottom, px, bottom + tick_len, "#000000", 0.8, ""))
            if gx {
                fig_add(f, line_el(px, ay, px, bottom, "#b0b0b0", 0.8, grid_attr(grid_alpha)))
            }
            if a[0].hide_xlabels == false {
                if a[0].xt_rot != 0.0 {
                    fig_text_at(f, px + 3.0, bottom + 14.0, lab[i], 10.0, "end", "#000000", "", "", 0.0 - a[0].xt_rot)
                } else {
                    fig_text_at(f, px, bottom + 16.0, lab[i], 10.0, "middle", "#000000", "", "", 0.0)
                }
            }
            i = i + 1
        }
    } elif a[0].xlog {
        let e0: i32 = floor(log10(a[0].x0)) as i32
        let e1: i32 = ceil(log10(a[0].x1)) as i32
        let mut e: i32 = e0
        while e <= e1 {
            let mut m: i32 = 1
            while m <= 9 {
                let v: f64 = (m as f64) * pow(10.0, e as f64)
                if v >= a[0].x0 * 0.999999 and v <= a[0].x1 * 1.000001 {
                    let px: f64 = ax_px(a, v)
                    if m == 1 {
                        fig_add(f, line_el(px, bottom, px, bottom + tick_len, "#000000", 0.8, ""))
                        if gx {
                            fig_add(f, line_el(px, ay, px, bottom, "#b0b0b0", 0.8, grid_attr(grid_alpha)))
                        }
                        if a[0].hide_xlabels == false {
                            fig_add(f, "<text x=\"" + sv_num(px) + "\" y=\"" + sv_num(bottom + 16.0) + "\" font-size=\"10\" text-anchor=\"middle\">" + pow10_label(e) + "</text>\n")
                        }
                    } else {
                        fig_add(f, line_el(px, bottom, px, bottom + 2.0, "#000000", 0.6, ""))
                        if gx and minor {
                            fig_add(f, line_el(px, ay, px, bottom, "#b0b0b0", 0.6, grid_attr(grid_alpha)))
                        }
                    }
                }
                m = m + 1
            }
            e = e + 1
        }
    } else {
        let nb: i32 = clamp_bins(aw / 38.0)
        let step: f64 = nice_step(a[0].x0, a[0].x1, nb)
        let d: i32 = step_decimals(step)
        let mut v: f64 = ceil(a[0].x0 / step - 1e-9) * step
        while v <= a[0].x1 + step * 1e-9 {
            let px: f64 = ax_px(a, v)
            fig_add(f, line_el(px, bottom, px, bottom + tick_len, "#000000", 0.8, ""))
            if gx {
                fig_add(f, line_el(px, ay, px, bottom, "#b0b0b0", 0.8, grid_attr(grid_alpha)))
            }
            if a[0].hide_xlabels == false {
                fig_text_at(f, px, bottom + 16.0, lin_label(v, d), 10.0, "middle", "#000000", "", "", 0.0)
            }
            v = v + step
        }
    }

    # y axis
    if a[0].ylog {
        let e0: i32 = floor(log10(a[0].y0)) as i32
        let e1: i32 = ceil(log10(a[0].y1)) as i32
        let mut e: i32 = e0
        while e <= e1 {
            let v: f64 = pow(10.0, e as f64)
            if v >= a[0].y0 * 0.999999 and v <= a[0].y1 * 1.000001 {
                let py: f64 = ax_py(a, v)
                fig_add(f, line_el(ax - tick_len, py, ax, py, "#000000", 0.8, ""))
                if gy {
                    fig_add(f, line_el(ax, py, ax + aw, py, "#b0b0b0", 0.8, grid_attr(grid_alpha)))
                }
                fig_add(f, "<text x=\"" + sv_num(ax - 6.0) + "\" y=\"" + sv_num(py + 3.5) + "\" font-size=\"10\" text-anchor=\"end\">" + pow10_label(e) + "</text>\n")
            }
            e = e + 1
        }
    } else {
        let nb: i32 = clamp_bins(ah / 26.0)
        let step: f64 = nice_step(a[0].y0, a[0].y1, nb)
        let d: i32 = step_decimals(step)
        let mut v: f64 = ceil(a[0].y0 / step - 1e-9) * step
        while v <= a[0].y1 + step * 1e-9 {
            let py: f64 = ax_py(a, v)
            fig_add(f, line_el(ax - tick_len, py, ax, py, "#000000", 0.8, ""))
            if gy {
                fig_add(f, line_el(ax, py, ax + aw, py, "#b0b0b0", 0.8, grid_attr(grid_alpha)))
            }
            fig_text_at(f, ax - 6.0, py + 3.5, lin_label(v, d), 10.0, "end", "#000000", "", "", 0.0)
            v = v + step
        }
    }
}

function clamp_bins(v: f64) -> i32 {
    let mut n: i32 = v as i32
    if n < 3 {
        n = 3
    }
    if n > 9 {
        n = 9
    }
    return n
}

# Spines, drawn last so they sit above the data.
export function ax_frame(a: ptr<Ax>) -> void {
    fig_add(a[0].f, "<rect x=\"" + sv_num(a[0].x) + "\" y=\"" + sv_num(a[0].y) + "\" width=\"" + sv_num(a[0].w) + "\" height=\"" + sv_num(a[0].h) + "\" fill=\"none\" stroke=\"#000000\" stroke-width=\"0.8\"/>\n")
}

export function ax_title(a: ptr<Ax>, s: string, bold: bool) -> void {
    let mut weight: string = ""
    if bold {
        weight = "bold"
    }
    fig_text_at(a[0].f, a[0].x + a[0].w / 2.0, a[0].y - 7.0, s, 12.0, "middle", "#000000", weight, "", 0.0)
}

export function ax_xlabel(a: ptr<Ax>, s: string) -> void {
    let mut dy: f64 = 32.0
    if a[0].xt_rot != 0.0 {
        dy = 44.0
    }
    fig_text_at(a[0].f, a[0].x + a[0].w / 2.0, a[0].y + a[0].h + dy, s, 10.0, "middle", "#000000", "", "", 0.0)
}

export function ax_ylabel(a: ptr<Ax>, s: string, offset: f64) -> void {
    let x: f64 = a[0].x - offset
    let y: f64 = a[0].y + a[0].h / 2.0
    fig_text_at(a[0].f, x, y, s, 10.0, "middle", "#000000", "", "", -90.0)
}

function clip_open(a: ptr<Ax>) -> string {
    return "<g clip-path=\"url(#c" + ft_itoa(a[0].clip) + ")\">\n"
}

function dash_attr(dash: string) -> string {
    let p: ptr<u8> = dash as ptr<u8>
    if ft_len(dash) == 0 or p[0] == 45 and ft_len(dash) == 1 {
        return ""
    }
    if p[0] == 45 and p[1] == 45 {
        return " stroke-dasharray=\"3.7,1.6\""
    }
    if p[0] == 58 {
        return " stroke-dasharray=\"1,1.65\""
    }
    return ""
}

# Line series. dash: "-" solid, "--" dashed, ":" dotted. Dense series are
# reduced to the per-column minimum and maximum, which draws the same ink.
export function ax_plot(a: ptr<Ax>, xs: ptr<f64>, ys: ptr<f64>, n: i32, color: string, lw: f64, dash: string, alpha: f64) -> void {
    let f: ptr<Fig> = a[0].f
    let b: ptr<SvgBuf> = f[0].b
    sb_add(b, clip_open(a))
    sb_add(b, "<polyline fill=\"none\" stroke=\"" + color + "\" stroke-width=\"" + sv_num(lw) + "\" stroke-linejoin=\"round\" stroke-linecap=\"square\"" + dash_attr(dash))
    if alpha < 1.0 {
        sb_add(b, " stroke-opacity=\"" + sv_num(alpha) + "\"")
    }
    sb_add(b, " points=\"")
    let cols: f64 = a[0].w * 2.0
    if (n as f64) > cols * 3.0 {
        let mut i: i32 = 0
        let mut cur: i32 = -1000000
        let mut lo: f64 = 0.0
        let mut hi: f64 = 0.0
        let mut lo_first: bool = true
        let mut cx: f64 = 0.0
        while i <= n {
            let mut col: i32 = -2000000
            if i < n {
                col = (ax_px(a, xs[i]) * 2.0) as i32
            }
            if col != cur {
                if cur != -1000000 {
                    if lo_first {
                        sb_add(b, sv_num(cx) + "," + sv_num(ax_py(a, lo)) + " " + sv_num(cx) + "," + sv_num(ax_py(a, hi)) + " ")
                    } else {
                        sb_add(b, sv_num(cx) + "," + sv_num(ax_py(a, hi)) + " " + sv_num(cx) + "," + sv_num(ax_py(a, lo)) + " ")
                    }
                }
                if i < n {
                    cur = col
                    lo = ys[i]
                    hi = ys[i]
                    lo_first = true
                    cx = ax_px(a, xs[i])
                }
            } else {
                if ys[i] < lo {
                    lo = ys[i]
                    lo_first = false
                }
                if ys[i] > hi {
                    hi = ys[i]
                    lo_first = true
                }
            }
            i = i + 1
        }
    } else {
        let mut i: i32 = 0
        while i < n {
            sb_add(b, sv_num(ax_px(a, xs[i])) + "," + sv_num(ax_py(a, ys[i])) + " ")
            i = i + 1
        }
    }
    sb_add(b, "\"/>\n</g>\n")
}

export function ax_hline(a: ptr<Ax>, y: f64, color: string, lw: f64, dash: string, alpha: f64) -> void {
    let py: f64 = ax_py(a, y)
    let mut extra: string = dash_attr(dash)
    if alpha < 1.0 {
        extra = extra + " stroke-opacity=\"" + sv_num(alpha) + "\""
    }
    fig_add(a[0].f, clip_open(a) + line_el(a[0].x, py, a[0].x + a[0].w, py, color, lw, extra) + "</g>\n")
}

# Markers: kind 0 circle, 1 x. `size` is the marker diameter in points.
export function ax_markers(a: ptr<Ax>, xs: ptr<f64>, ys: ptr<f64>, n: i32, kind: i32, size: f64, color: string) -> void {
    let f: ptr<Fig> = a[0].f
    let r: f64 = size / 2.0
    fig_add(f, clip_open(a))
    let mut i: i32 = 0
    while i < n {
        let px: f64 = ax_px(a, xs[i])
        let py: f64 = ax_py(a, ys[i])
        if kind == 0 {
            fig_add(f, "<circle cx=\"" + sv_num(px) + "\" cy=\"" + sv_num(py) + "\" r=\"" + sv_num(r) + "\" fill=\"" + color + "\" stroke=\"" + color + "\"/>\n")
        } else {
            fig_add(f, line_el(px - r, py - r, px + r, py + r, color, 1.5, ""))
            fig_add(f, line_el(px - r, py + r, px + r, py - r, color, 1.5, ""))
        }
        i = i + 1
    }
    fig_add(f, "</g>\n")
}

export function ax_bar(a: ptr<Ax>, xc: f64, width: f64, height: f64, color: string, edge: string) -> void {
    let x0: f64 = ax_px(a, xc - width / 2.0)
    let x1: f64 = ax_px(a, xc + width / 2.0)
    let y0: f64 = ax_py(a, 0.0)
    let y1: f64 = ax_py(a, height)
    let mut top: f64 = y1
    let mut hh: f64 = y0 - y1
    if hh < 0.0 {
        top = y0
        hh = 0.0 - hh
    }
    let mut stroke: string = ""
    if ft_len(edge) > 0 {
        stroke = " stroke=\"" + edge + "\" stroke-width=\"1\""
    }
    fig_add(a[0].f, clip_open(a) + "<rect x=\"" + sv_num(x0) + "\" y=\"" + sv_num(top) + "\" width=\"" + sv_num(x1 - x0) + "\" height=\"" + sv_num(hh) + "\" fill=\"" + color + "\"" + stroke + "/>\n</g>\n")
}

export function ax_text(a: ptr<Ax>, xd: f64, yd: f64, s: string, size: f64, anchor: string, color: string, weight: string) -> void {
    fig_text_at(a[0].f, ax_px(a, xd), ax_py(a, yd) + size * 0.35, s, size, anchor, color, weight, "", 0.0)
}

# Text in axes fractions from the top-left, like transform=ax.transAxes
# with va="top".
export function ax_text_frac(a: ptr<Ax>, fx: f64, fy: f64, s: string, size: f64) -> void {
    fig_text_at(a[0].f, a[0].x + fx * a[0].w, a[0].y + (1.0 - fy) * a[0].h + size, s, size, "start", "#000000", "", "", 0.0)
}

# Arrow from (x0, y0) to (x1, y1) in data units with a filled head.
export function ax_arrow(a: ptr<Ax>, x0: f64, y0: f64, x1: f64, y1: f64, color: string, lw: f64, head: f64) -> void {
    let px0: f64 = ax_px(a, x0)
    let py0: f64 = ax_py(a, y0)
    let px1: f64 = ax_px(a, x1)
    let py1: f64 = ax_py(a, y1)
    let ang: f64 = atan2(py1 - py0, px1 - px0)
    let hl: f64 = head * 1.5
    let bx: f64 = px1 - hl * cos(ang)
    let by: f64 = py1 - hl * sin(ang)
    let lx: f64 = bx + head * 0.5 * sin(ang)
    let ly: f64 = by - head * 0.5 * cos(ang)
    let rx: f64 = bx - head * 0.5 * sin(ang)
    let ry: f64 = by + head * 0.5 * cos(ang)
    let f: ptr<Fig> = a[0].f
    fig_add(f, line_el(px0, py0, bx, by, color, lw, ""))
    fig_add(f, "<polygon points=\"" + sv_num(px1) + "," + sv_num(py1) + " " + sv_num(lx) + "," + sv_num(ly) + " " + sv_num(rx) + "," + sv_num(ry) + "\" fill=\"" + color + "\"/>\n")
}

# Rounded box in data units.
export function ax_rbox(a: ptr<Ax>, x: f64, y: f64, w: f64, h: f64, fill: string, alpha: f64, radius: f64) -> void {
    let px0: f64 = ax_px(a, x)
    let px1: f64 = ax_px(a, x + w)
    let py0: f64 = ax_py(a, y + h)
    let py1: f64 = ax_py(a, y)
    fig_add(a[0].f, "<rect x=\"" + sv_num(px0) + "\" y=\"" + sv_num(py0) + "\" width=\"" + sv_num(px1 - px0) + "\" height=\"" + sv_num(py1 - py0) + "\" rx=\"" + sv_num(radius) + "\" fill=\"" + fill + "\" fill-opacity=\"" + sv_num(alpha) + "\" stroke=\"#ffffff\" stroke-width=\"1.5\"/>\n")
}

# Image covering the data extent [ex0, ex1] x [ey0, ey1].
export function ax_image(a: ptr<Ax>, uri: string, ex0: f64, ex1: f64, ey0: f64, ey1: f64) -> void {
    let px0: f64 = ax_px(a, ex0)
    let px1: f64 = ax_px(a, ex1)
    let py0: f64 = ax_py(a, ey1)
    let py1: f64 = ax_py(a, ey0)
    let fg: ptr<Fig> = a[0].f
    let b: ptr<SvgBuf> = fg[0].b
    sb_add(b, clip_open(a))
    sb_add(b, "<image x=\"" + sv_num(px0) + "\" y=\"" + sv_num(py0) + "\" width=\"" + sv_num(px1 - px0) + "\" height=\"" + sv_num(py1 - py0) + "\" preserveAspectRatio=\"none\" style=\"image-rendering:pixelated\" href=\"")
    sb_add(b, uri)
    sb_add(b, "\"/>\n</g>\n")
}

# Heatmap of a rows x cols matrix (row 0 at the bottom, like origin="lower").
# norm: 0 linear vmin..vmax, 1 two-slope around `center`.
export function heat_uri(m: ptr<f64>, rows: i32, cols: i32, cm: Cmap, vmin: f64, vmax: f64, norm: i32, center: f64) -> string {
    let idx: ptr<u8> = malloc((rows * cols) as i64) as ptr<u8>
    let mut r: i32 = 0
    while r < rows {
        let mut c: i32 = 0
        while c < cols {
            let v: f64 = m[r * cols + c]
            let mut t: f64 = 0.0
            if norm == 1 {
                if v < center {
                    t = 0.5 * (v - vmin) / (center - vmin)
                } else {
                    t = 0.5 + 0.5 * (v - center) / (vmax - center)
                }
            } else {
                t = (v - vmin) / (vmax - vmin)
            }
            idx[(rows - 1 - r) * cols + c] = cmap_index(t) as u8
            c = c + 1
        }
        r = r + 1
    }
    return png_data_uri(cols, rows, idx, cm)
}

# Vertical colorbar in the box (x, y, w, h) with ticks on the right.
export function colorbar(f: ptr<Fig>, x: f64, y: f64, w: f64, h: f64, cm: Cmap, vmin: f64, vmax: f64, label: string) -> void {
    let idx: ptr<u8> = malloc(256) as ptr<u8>
    let mut i: i32 = 0
    while i < 256 {
        idx[i] = (255 - i) as u8
        i = i + 1
    }
    let a: ptr<Ax> = ax_new(f, x, y, w, h)
    ax_lim(a, 0.0, 1.0, vmin, vmax)
    ax_image(a, png_data_uri(1, 256, idx, cm), 0.0, 1.0, vmin, vmax)
    let nb: i32 = clamp_bins(h / 26.0)
    let step: f64 = nice_step(vmin, vmax, nb)
    let d: i32 = step_decimals(step)
    let mut v: f64 = ceil(vmin / step - 1e-9) * step
    while v <= vmax + step * 1e-9 {
        let py: f64 = ax_py(a, v)
        fig_add(f, line_el(x + w, py, x + w + 3.5, py, "#000000", 0.8, ""))
        fig_text_at(f, x + w + 6.0, py + 3.5, lin_label(v, d), 10.0, "start", "#000000", "", "", 0.0)
        v = v + step
    }
    ax_frame(a)
    fig_text_at(f, x + w + 46.0, y + h / 2.0, label, 10.0, "middle", "#000000", "", "", -90.0)
}

# ---- legend ----

# kind: 0 line, 1 patch, 2 line with circle marker.
export function ax_leg_add(a: ptr<Ax>, label: string, color: string, kind: i32, dash: string, alpha: f64) -> void {
    let i: i32 = a[0].nleg
    let l: ptr<string> = a[0].leg_label
    let c: ptr<string> = a[0].leg_color
    let k: ptr<i32> = a[0].leg_kind
    let d: ptr<string> = a[0].leg_dash
    let al: ptr<f64> = a[0].leg_alpha
    l[i] = label
    c[i] = color
    k[i] = kind
    d[i] = dash
    al[i] = alpha
    a[0].nleg = i + 1
}

# loc: 0 upper right, 1 upper left, 2 lower right, 3 lower left, 4 center right.
export function ax_legend(a: ptr<Ax>, loc: i32, size: f64, text_w: f64) -> void {
    let n: i32 = a[0].nleg
    if n == 0 {
        return
    }
    let f: ptr<Fig> = a[0].f
    let row: f64 = size * 1.45
    let bw: f64 = text_w + size * 4.2
    let bh: f64 = row * (n as f64) + size * 0.7
    let pad: f64 = 6.0
    let mut bx: f64 = a[0].x + a[0].w - bw - pad
    let mut by: f64 = a[0].y + pad
    if loc == 1 or loc == 3 {
        bx = a[0].x + pad
    }
    if loc == 2 or loc == 3 {
        by = a[0].y + a[0].h - bh - pad
    }
    if loc == 4 {
        by = a[0].y + (a[0].h - bh) / 2.0
    }
    fig_add(f, "<rect x=\"" + sv_num(bx) + "\" y=\"" + sv_num(by) + "\" width=\"" + sv_num(bw) + "\" height=\"" + sv_num(bh) + "\" rx=\"3\" fill=\"#ffffff\" fill-opacity=\"0.8\" stroke=\"#cccccc\" stroke-width=\"0.8\"/>\n")
    let labels: ptr<string> = a[0].leg_label
    let colors: ptr<string> = a[0].leg_color
    let kinds: ptr<i32> = a[0].leg_kind
    let dashes: ptr<string> = a[0].leg_dash
    let alphas: ptr<f64> = a[0].leg_alpha
    let mut i: i32 = 0
    while i < n {
        let cy: f64 = by + size * 0.35 + row * (i as f64) + row / 2.0
        let hx: f64 = bx + size * 0.5
        if kinds[i] == 1 {
            fig_add(f, "<rect x=\"" + sv_num(hx) + "\" y=\"" + sv_num(cy - size * 0.35) + "\" width=\"" + sv_num(size * 2.0) + "\" height=\"" + sv_num(size * 0.7) + "\" fill=\"" + colors[i] + "\"/>\n")
        } elif kinds[i] == 3 {
            fig_add(f, "<circle cx=\"" + sv_num(hx + size) + "\" cy=\"" + sv_num(cy) + "\" r=\"4.5\" fill=\"" + colors[i] + "\"/>\n")
        } elif kinds[i] == 4 {
            fig_add(f, line_el(hx + size - 4.5, cy - 4.5, hx + size + 4.5, cy + 4.5, colors[i], 1.5, ""))
            fig_add(f, line_el(hx + size - 4.5, cy + 4.5, hx + size + 4.5, cy - 4.5, colors[i], 1.5, ""))
        } else {
            let mut extra: string = dash_attr(dashes[i])
            if alphas[i] < 1.0 {
                extra = extra + " stroke-opacity=\"" + sv_num(alphas[i]) + "\""
            }
            fig_add(f, line_el(hx, cy, hx + size * 2.0, cy, colors[i], 1.5, extra))
            if kinds[i] == 2 {
                fig_add(f, "<circle cx=\"" + sv_num(hx + size) + "\" cy=\"" + sv_num(cy) + "\" r=\"3.5\" fill=\"" + colors[i] + "\"/>\n")
            }
        }
        fig_text_at(f, hx + size * 2.8, cy + size * 0.35, labels[i], size, "start", "#000000", "", "", 0.0)
        i = i + 1
    }
}

