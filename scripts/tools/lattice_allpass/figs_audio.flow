# @module tools.lattice_allpass.figs_audio
# @means  The seven figures of the audio demo: Bode/pole-zero/group delay,
#         impulse and step response, waveforms, RMS envelope,
#         spectrograms, modulation proof and phase difference.

import "../lattice_allpass/dsp.flow"
import "../lattice_allpass/svg.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function calloc(n: i64, size: i64) -> ptr<void>
    function sin(x: f64) -> f64
    function cos(x: f64) -> f64
    function atan2(y: f64, x: f64) -> f64
    function sqrt(x: f64) -> f64
    function log10(x: f64) -> f64
    function floor(x: f64) -> f64
    function fabs(x: f64) -> f64
}

# ---- array helpers ----

export function arr_min(d: ptr<f64>, n: i32) -> f64 {
    let mut m: f64 = d[0]
    let mut i: i32 = 1
    while i < n {
        if d[i] < m {
            m = d[i]
        }
        i = i + 1
    }
    return m
}

export function arr_max(d: ptr<f64>, n: i32) -> f64 {
    let mut m: f64 = d[0]
    let mut i: i32 = 1
    while i < n {
        if d[i] > m {
            m = d[i]
        }
        i = i + 1
    }
    return m
}

# The axes box of cell (row, col) in a rows x cols grid inside the figure
# margins (points). Height ratios are equal.
export function grid_ax(f: ptr<Fig>, rows: i32, cols: i32, row: i32, col: i32, left: f64, right: f64, top: f64, bottom: f64, wgap: f64, hgap: f64) -> ptr<Ax> {
    let fw: f64 = f[0].w
    let fh: f64 = f[0].h
    let cw: f64 = (fw - left - right - wgap * ((cols - 1) as f64)) / (cols as f64)
    let ch: f64 = (fh - top - bottom - hgap * ((rows - 1) as f64)) / (rows as f64)
    let x: f64 = left + (col as f64) * (cw + wgap)
    let y: f64 = top + (row as f64) * (ch + hgap)
    return ax_new(f, x, y, cw, ch)
}

# numpy.unwrap for a phase vector, in place.
export function unwrap(p: ptr<f64>, n: i32) -> void {
    let pi: f64 = la_pi()
    let two_pi: f64 = 2.0 * la_pi()
    let mut corr: f64 = 0.0
    let mut prev: f64 = p[0]
    let mut i: i32 = 1
    while i < n {
        let dd: f64 = p[i] - prev
        let xm: f64 = dd + pi
        let mut ddmod: f64 = xm - floor(xm / two_pi) * two_pi - pi
        if ddmod == 0.0 - pi and dd > 0.0 {
            ddmod = pi
        }
        let mut pc: f64 = ddmod - dd
        if fabs(dd) < pi {
            pc = 0.0
        }
        corr = corr + pc
        prev = p[i]
        p[i] = p[i] + corr
        i = i + 1
    }
}

# numpy.gradient(f, x) with second-order interior differences and
# first-order edges.
export function gradient(fv: ptr<f64>, x: ptr<f64>, n: i32, out: ptr<f64>) -> void {
    out[0] = (fv[1] - fv[0]) / (x[1] - x[0])
    out[n - 1] = (fv[n - 1] - fv[n - 2]) / (x[n - 1] - x[n - 2])
    let mut i: i32 = 1
    while i < n - 1 {
        let hd: f64 = x[i] - x[i - 1]
        let hs: f64 = x[i + 1] - x[i]
        out[i] = (hs * hs * fv[i + 1] + (hd * hd - hs * hs) * fv[i] - hd * hd * fv[i - 1]) / (hs * hd * (hd + hs))
        i = i + 1
    }
}

# In-place radix-2 FFT of n complex values.
export function fft(re: ptr<f64>, im: ptr<f64>, n: i32) -> void {
    let mut j: i32 = 0
    let mut i: i32 = 1
    while i < n {
        let mut bit: i32 = n >> 1
        while (j & bit) != 0 {
            j = j ^ bit
            bit = bit >> 1
        }
        j = j ^ bit
        if i < j {
            let tr: f64 = re[i]
            re[i] = re[j]
            re[j] = tr
            let ti: f64 = im[i]
            im[i] = im[j]
            im[j] = ti
        }
        i = i + 1
    }
    let mut len: i32 = 2
    while len <= n {
        let ang: f64 = -2.0 * la_pi() / (len as f64)
        let mut s: i32 = 0
        while s < n {
            let mut k: i32 = 0
            while k < len / 2 {
                let wr: f64 = cos(ang * (k as f64))
                let wi: f64 = sin(ang * (k as f64))
                let a: i32 = s + k
                let b: i32 = s + k + len / 2
                let xr: f64 = re[b] * wr - im[b] * wi
                let xi: f64 = re[b] * wi + im[b] * wr
                re[b] = re[a] - xr
                im[b] = im[a] - xi
                re[a] = re[a] + xr
                im[a] = im[a] + xi
                k = k + 1
            }
            s = s + len
        }
        len = len * 2
    }
}

# ---- figure 1: Bode, phase, group delay, pole-zero ----

export function fig_dsp_bode(k: ptr<f64>, order: i32, path: string) -> bool {
    let nw: i32 = 2048
    let w: Vec = linspace(0.0, la_pi(), nw)
    let wd: ptr<f64> = w.data
    let freqs: ptr<f64> = calloc(nw as i64, 8) as ptr<f64>
    let mag: ptr<f64> = calloc(nw as i64, 8) as ptr<f64>
    let ph: ptr<f64> = calloc(nw as i64, 8) as ptr<f64>
    let gd: ptr<f64> = calloc(nw as i64, 8) as ptr<f64>
    let mut i: i32 = 0
    while i < nw {
        # z^-1 = e^{-jw}
        let zr: f64 = cos(wd[i])
        let zi: f64 = 0.0 - sin(wd[i])
        let mut hr: f64 = 1.0
        let mut hi: f64 = 0.0
        let mut s: i32 = 0
        while s < order {
            let nr: f64 = k[s] + zr
            let ni: f64 = zi
            let dr: f64 = 1.0 + k[s] * zr
            let di: f64 = k[s] * zi
            let den: f64 = dr * dr + di * di
            let qr: f64 = (nr * dr + ni * di) / den
            let qi: f64 = (ni * dr - nr * di) / den
            let tr: f64 = hr * qr - hi * qi
            hi = hr * qi + hi * qr
            hr = tr
            s = s + 1
        }
        freqs[i] = wd[i] * la_fs() / (2.0 * la_pi())
        mag[i] = 20.0 * log10(sqrt(hr * hr + hi * hi) + 1e-15)
        ph[i] = atan2(hi, hr)
        i = i + 1
    }
    unwrap(ph, nw)
    gradient(ph, wd, nw, gd)
    let deg: ptr<f64> = calloc(nw as i64, 8) as ptr<f64>
    let gms: ptr<f64> = calloc(nw as i64, 8) as ptr<f64>
    i = 0
    while i < nw {
        deg[i] = ph[i] * 180.0 / la_pi()
        gms[i] = (0.0 - gd[i]) / la_fs() * 1000.0
        i = i + 1
    }
    let n1: i32 = nw - 1
    let fx: ptr<f64> = &freqs[1] as ptr<f64>

    let f: ptr<Fig> = fig_new(13.0, 10.0, "#ffffff")
    fig_suptitle(f, "DSP Characterization: Schur-Lattice All-Pass", 14.0)

    let a0: ptr<Ax> = grid_ax(f, 2, 2, 0, 0, 72.0, 24.0, 58.0, 50.0, 84.0, 72.0)
    ax_xlog(a0)
    ax_autoscale(a0, fx[0], fx[n1 - 1], -0.2, 0.2)
    a0[0].y0 = -0.2
    a0[0].y1 = 0.2
    ax_axes(a0, 1, 0.3, true, "#ffffff")
    ax_plot(a0, fx, &mag[1] as ptr<f64>, n1, "#d62728", 1.8, "-", 1.0)
    ax_hline(a0, 0.0, "#000000", 1.5, "--", 0.5)
    ax_frame(a0)
    ax_title(a0, "Bode magnitude: |H(f)| ≡ 0 dB", false)
    ax_xlabel(a0, "Frequency (Hz)")
    ax_ylabel(a0, "Magnitude (dB)", 46.0)

    let a1: ptr<Ax> = grid_ax(f, 2, 2, 0, 1, 72.0, 24.0, 58.0, 50.0, 84.0, 72.0)
    ax_xlog(a1)
    let dy: ptr<f64> = &deg[1] as ptr<f64>
    ax_autoscale(a1, fx[0], fx[n1 - 1], arr_min(dy, n1), arr_max(dy, n1))
    ax_axes(a1, 1, 0.3, true, "#ffffff")
    ax_plot(a1, fx, dy, n1, "#2ca02c", 1.8, "-", 1.0)
    ax_frame(a1)
    ax_title(a1, "Bode phase: frequency-dependent delay", false)
    ax_xlabel(a1, "Frequency (Hz)")
    ax_ylabel(a1, "Phase (degrees)", 46.0)

    let a2: ptr<Ax> = grid_ax(f, 2, 2, 1, 0, 72.0, 24.0, 58.0, 50.0, 84.0, 72.0)
    ax_xlog(a2)
    let gy: ptr<f64> = &gms[1] as ptr<f64>
    ax_autoscale(a2, fx[0], fx[n1 - 1], arr_min(gy, n1), arr_max(gy, n1))
    ax_axes(a2, 1, 0.3, true, "#ffffff")
    ax_plot(a2, fx, gy, n1, "#9467bd", 1.8, "-", 1.0)
    ax_frame(a2)
    ax_title(a2, "Group delay τ_g(f)", false)
    ax_xlabel(a2, "Frequency (Hz)")
    ax_ylabel(a2, "Group delay (ms)", 46.0)

    # Pole-zero map: square axes centred in its cell (set_aspect("equal")).
    let cell: ptr<Ax> = grid_ax(f, 2, 2, 1, 1, 72.0, 24.0, 58.0, 50.0, 84.0, 72.0)
    let mut side: f64 = cell[0].w
    if cell[0].h < side {
        side = cell[0].h
    }
    let a3: ptr<Ax> = ax_new(f, cell[0].x + (cell[0].w - side) / 2.0, cell[0].y + (cell[0].h - side) / 2.0, side, side)
    ax_lim(a3, -1.3, 1.3, -1.3, 1.3)
    ax_axes(a3, 1, 0.3, false, "#ffffff")
    let th: Vec = linspace(0.0, 2.0 * la_pi(), 256)
    let cx: ptr<f64> = calloc(256, 8) as ptr<f64>
    let cy: ptr<f64> = calloc(256, 8) as ptr<f64>
    let thd: ptr<f64> = th.data
    i = 0
    while i < 256 {
        cx[i] = cos(thd[i])
        cy[i] = sin(thd[i])
        i = i + 1
    }
    ax_plot(a3, cx, cy, 256, "#000000", 1.0, "--", 0.25)
    let zx: ptr<f64> = calloc(16, 8) as ptr<f64>
    let px: ptr<f64> = calloc(16, 8) as ptr<f64>
    let zeros_y: ptr<f64> = calloc(16, 8) as ptr<f64>
    i = 0
    while i < order {
        zx[i] = -1.0 / k[i]
        px[i] = 0.0 - k[i]
        i = i + 1
    }
    ax_markers(a3, zx, zeros_y, order, 0, sqrt(80.0), "#1f77b4")
    ax_markers(a3, px, zeros_y, order, 1, sqrt(80.0), "#ff7f0e")
    ax_leg_add(a3, "zeros", "#1f77b4", 3, "", 1.0)
    ax_leg_add(a3, "poles", "#ff7f0e", 4, "", 1.0)
    ax_legend(a3, 0, 10.0, 34.0)
    ax_frame(a3)
    ax_title(a3, "Pole-zero map (cascade sections)", false)
    return fig_save(f, path)
}

# ---- figure 2: impulse and step ----

export function fig_dsp_impulse(k: ptr<f64>, order: i32, path: string) -> bool {
    let n: i32 = 256
    let h: Vec = impulse_response(k, order, n)
    let hd: ptr<f64> = h.data
    let xs: ptr<f64> = calloc(n as i64, 8) as ptr<f64>
    let step: ptr<f64> = calloc(n as i64, 8) as ptr<f64>
    let mut acc: f64 = 0.0
    let mut i: i32 = 0
    while i < n {
        xs[i] = i as f64
        acc = acc + hd[i]
        step[i] = acc
        i = i + 1
    }
    let f: ptr<Fig> = fig_new(12.0, 4.0, "#ffffff")
    fig_suptitle(f, "Time-domain DSP verification", 12.0)
    let a0: ptr<Ax> = grid_ax(f, 1, 2, 0, 0, 56.0, 20.0, 56.0, 46.0, 60.0, 0.0)
    let mut lo: f64 = arr_min(hd, n)
    if lo > 0.0 {
        lo = 0.0
    }
    ax_autoscale(a0, 0.0, (n - 1) as f64, lo, arr_max(hd, n))
    ax_axes(a0, 1, 0.3, false, "#ffffff")
    let seg: ptr<f64> = calloc(2, 8) as ptr<f64>
    let segx: ptr<f64> = calloc(2, 8) as ptr<f64>
    i = 0
    while i < n {
        segx[0] = xs[i]
        segx[1] = xs[i]
        seg[0] = 0.0
        seg[1] = hd[i]
        ax_plot(a0, segx, seg, 2, "#7b3294", 1.5, "-", 1.0)
        i = i + 1
    }
    ax_markers(a0, xs, hd, n, 0, 6.0, "#7b3294")
    ax_frame(a0)
    ax_title(a0, "Impulse response h[n]", false)
    ax_xlabel(a0, "n")

    let a1: ptr<Ax> = grid_ax(f, 1, 2, 0, 1, 56.0, 20.0, 56.0, 46.0, 60.0, 0.0)
    let mut hi1: f64 = arr_max(step, n)
    if hi1 < 1.0 {
        hi1 = 1.0
    }
    ax_autoscale(a1, 0.0, (n - 1) as f64, arr_min(step, n), hi1)
    ax_axes(a1, 1, 0.3, false, "#ffffff")
    ax_plot(a1, xs, step, n, "#17becf", 1.5, "-", 1.0)
    ax_hline(a1, 1.0, "#000000", 1.5, ":", 0.5)
    ax_frame(a1)
    ax_title(a1, "Step response (all-pass → unit magnitude)", false)
    ax_xlabel(a1, "n")
    return fig_save(f, path)
}

# ---- audio figures ----

function time_axis(n: i32) -> ptr<f64> {
    let t: ptr<f64> = calloc(n as i64, 8) as ptr<f64>
    let mut i: i32 = 0
    while i < n {
        t[i] = (i as f64) / la_fs()
        i = i + 1
    }
    return t
}

function series_ax(a: ptr<Ax>, x0: f64, x1: f64, y: ptr<f64>, n: i32) -> void {
    ax_autoscale(a, x0, x1, arr_min(y, n), arr_max(y, n))
}

export function fig_audio_waveforms(x: Vec, ys: Vec, ym: Vec, path: string) -> bool {
    let n: i32 = (1.2 * la_fs()) as i32
    let t: ptr<f64> = time_axis(n)
    let f: ptr<Fig> = fig_new(13.0, 8.0, "#ffffff")
    fig_suptitle(f, "Audio Through All-Pass: Input vs Static vs Modulated", 12.0)
    let names: array<string, 3> = ["Input", "Static AP", "Modulated AP"]
    let colors: array<string, 3> = ["#333333", "#1b9e77", "#d95f02"]
    let mut r: i32 = 0
    while r < 3 {
        let mut d: ptr<f64> = x.data
        if r == 1 {
            d = ys.data
        }
        if r == 2 {
            d = ym.data
        }
        let a: ptr<Ax> = grid_ax(f, 3, 1, r, 0, 64.0, 20.0, 40.0, 46.0, 0.0, 14.0)
        series_ax(a, t[0], t[n - 1], d, n)
        if r < 2 {
            a[0].hide_xlabels = true
        }
        ax_axes(a, 1, 0.3, false, "#ffffff")
        ax_plot(a, t, d, n, colors[r], 0.8, "-", 1.0)
        ax_frame(a)
        ax_ylabel(a, names[r], 46.0)
        if r == 2 {
            ax_xlabel(a, "Time (s)")
        }
        r = r + 1
    }
    return fig_save(f, path)
}

export function fig_audio_rms(x: Vec, ys: Vec, ym: Vec, path: string) -> bool {
    let win: i32 = (0.02 * la_fs()) as i32
    let n: i32 = x.n
    let t: ptr<f64> = time_axis(n)
    let ri: Vec = sliding_rms(x, win)
    let rs: Vec = sliding_rms(ys, win)
    let rm: Vec = sliding_rms(ym, win)
    let f: ptr<Fig> = fig_new(12.0, 4.0, "#ffffff")
    let a: ptr<Ax> = grid_ax(f, 1, 1, 0, 0, 64.0, 16.0, 30.0, 46.0, 0.0, 0.0)
    let mut lo: f64 = arr_min(ri.data, n)
    let mut hi: f64 = arr_max(ri.data, n)
    let others: array<ptr<f64>, 2> = [rs.data, rm.data]
    let mut o: i32 = 0
    while o < 2 {
        let m0: f64 = arr_min(others[o], n)
        let m1: f64 = arr_max(others[o], n)
        if m0 < lo {
            lo = m0
        }
        if m1 > hi {
            hi = m1
        }
        o = o + 1
    }
    ax_autoscale(a, t[0], t[n - 1], lo, hi)
    ax_axes(a, 1, 0.3, false, "#ffffff")
    ax_plot(a, t, ri.data, n, "#333333", 1.2, "-", 1.0)
    ax_plot(a, t, rs.data, n, "#1b9e77", 1.2, "-", 0.85)
    ax_plot(a, t, rm.data, n, "#d95f02", 1.2, "-", 0.85)
    ax_leg_add(a, "Input RMS", "#333333", 0, "-", 1.0)
    ax_leg_add(a, "Static all-pass RMS", "#1b9e77", 0, "-", 0.85)
    ax_leg_add(a, "Modulated all-pass RMS", "#d95f02", 0, "-", 0.85)
    ax_legend(a, 0, 10.0, 130.0)
    ax_frame(a)
    ax_title(a, "All-pass preserves energy envelope (RMS tracks)", false)
    ax_xlabel(a, "Time (s)")
    ax_ylabel(a, "RMS amplitude", 50.0)
    return fig_save(f, path)
}

# matplotlib specgram(NFFT=1024, noverlap=768, Hann window, PSD in dB) as a
# (513 x cols) matrix, row 0 = 0 Hz. Returns the column count via cols[0].
function specgram_db(x: Vec, cols: ptr<i32>) -> ptr<f64> {
    let nfft: i32 = 1024
    let hop: i32 = 256
    let nseg: i32 = (x.n - (nfft - hop)) / hop
    let nf: i32 = nfft / 2 + 1
    let win: ptr<f64> = calloc(nfft as i64, 8) as ptr<f64>
    let mut wsum: f64 = 0.0
    let mut i: i32 = 0
    while i < nfft {
        win[i] = 0.5 - 0.5 * cos(2.0 * la_pi() * (i as f64) / ((nfft - 1) as f64))
        wsum = wsum + win[i] * win[i]
        i = i + 1
    }
    let out: ptr<f64> = calloc((nf * nseg) as i64, 8) as ptr<f64>
    let re: ptr<f64> = calloc(nfft as i64, 8) as ptr<f64>
    let im: ptr<f64> = calloc(nfft as i64, 8) as ptr<f64>
    let xd: ptr<f64> = x.data
    let mut s: i32 = 0
    while s < nseg {
        i = 0
        while i < nfft {
            re[i] = xd[s * hop + i] * win[i]
            im[i] = 0.0
            i = i + 1
        }
        fft(re, im, nfft)
        let mut b: i32 = 0
        while b < nf {
            let mut p: f64 = re[b] * re[b] + im[b] * im[b]
            if b > 0 and b < nf - 1 {
                p = p * 2.0
            }
            p = p / la_fs() / wsum
            out[b * nseg + s] = 10.0 * log10(p)
            b = b + 1
        }
        s = s + 1
    }
    cols[0] = nseg
    return out
}

# 2x2 max-pool so the embedded image stays small.
function pool2(m: ptr<f64>, rows: i32, cols: i32, out_rows: ptr<i32>, out_cols: ptr<i32>) -> ptr<f64> {
    let r2: i32 = (rows + 1) / 2
    let c2: i32 = (cols + 1) / 2
    let o: ptr<f64> = calloc((r2 * c2) as i64, 8) as ptr<f64>
    let mut r: i32 = 0
    while r < r2 {
        let mut c: i32 = 0
        while c < c2 {
            let mut best: f64 = m[(2 * r) * cols + 2 * c]
            let mut dr: i32 = 0
            while dr < 2 {
                let mut dc: i32 = 0
                while dc < 2 {
                    let rr: i32 = 2 * r + dr
                    let cc: i32 = 2 * c + dc
                    if rr < rows and cc < cols {
                        let v: f64 = m[rr * cols + cc]
                        if v > best {
                            best = v
                        }
                    }
                    dc = dc + 1
                }
                dr = dr + 1
            }
            o[r * c2 + c] = best
            c = c + 1
        }
        r = r + 1
    }
    out_rows[0] = r2
    out_cols[0] = c2
    return o
}

export function fig_audio_spectrograms(x: Vec, ys: Vec, ym: Vec, path: string) -> bool {
    let f: ptr<Fig> = fig_new(15.0, 4.0, "#ffffff")
    fig_suptitle(f, "Spectral content preserved: phase sculpting under modulation", 12.0)
    let titles: array<string, 3> = ["Input spectrogram", "Static all-pass", "Modulated all-pass (2 Hz k LFO)"]
    let cm: Cmap = cmap_named("magma")
    let mut p: i32 = 0
    while p < 3 {
        let mut sig: Vec = x
        if p == 1 {
            sig = ys
        }
        if p == 2 {
            sig = ym
        }
        let cols: ptr<i32> = calloc(1, 4) as ptr<i32>
        let m: ptr<f64> = specgram_db(sig, cols)
        let nseg: i32 = cols[0]
        let rows: i32 = 513
        let vmin: f64 = arr_min(m, rows * nseg)
        let vmax: f64 = arr_max(m, rows * nseg)
        let pr: ptr<i32> = calloc(1, 4) as ptr<i32>
        let pc: ptr<i32> = calloc(1, 4) as ptr<i32>
        let pooled: ptr<f64> = pool2(m, rows, nseg, pr, pc)
        let pad: f64 = 256.0 / la_fs() / 2.0
        let t0: f64 = 512.0 / la_fs()
        let t1: f64 = t0 + ((nseg - 1) as f64) * 256.0 / la_fs()
        let a: ptr<Ax> = grid_ax(f, 1, 3, 0, p, 64.0, 16.0, 44.0, 46.0, 72.0, 0.0)
        ax_lim(a, t0 - pad, t1 + pad, 0.0, 24000.0)
        ax_axes(a, 0, 0.3, false, "#ffffff")
        ax_image(a, heat_uri(pooled, pr[0], pc[0], cm, vmin, vmax, 0, 0.0), t0 - pad, t1 + pad, 0.0, 24000.0)
        ax_frame(a)
        ax_title(a, titles[p], false)
        ax_ylabel(a, "Hz", 46.0)
        if p == 2 {
            ax_xlabel(a, "Time (s)")
        }
        p = p + 1
    }
    return fig_save(f, path)
}

# Lag (samples) of the peak of correlate(seg_y, seg_x, "full").
function xcorr_lag(y: ptr<f64>, x: ptr<f64>, n: i32) -> i32 {
    let mut best: f64 = 0.0
    let mut best_lag: i32 = 0
    let mut first: bool = true
    let mut lag: i32 = 0 - (n - 1)
    while lag <= n - 1 {
        let mut s: f64 = 0.0
        let mut i: i32 = 0
        if lag < 0 {
            i = 0 - lag
        }
        let mut end: i32 = n
        if lag > 0 {
            end = n - lag
        }
        while i < end {
            s = s + y[i + lag] * x[i]
            i = i + 1
        }
        if first or s > best {
            best = s
            best_lag = lag
            first = false
        }
        lag = lag + 1
    }
    return best_lag
}

export function fig_audio_modulation(x: Vec, ym: Vec, k: ptr<f64>, order: i32, path: string) -> bool {
    let block: i32 = (0.05 * la_fs()) as i32
    let nb: i32 = (x.n - block + block - 1) / block
    let lags: ptr<f64> = calloc(nb as i64, 8) as ptr<f64>
    let times: ptr<f64> = calloc(nb as i64, 8) as ptr<f64>
    let xd: ptr<f64> = x.data
    let yd: ptr<f64> = ym.data
    let mut b: i32 = 0
    let mut start: i32 = 0
    while start < x.n - block {
        let lag: i32 = xcorr_lag(&yd[start] as ptr<f64>, &xd[start] as ptr<f64>, block)
        lags[b] = (lag as f64) / la_fs() * 1000.0
        times[b] = (start as f64) / la_fs()
        b = b + 1
        start = start + block
    }
    let phases: Vec = linspace(0.31, 4.65, order)
    let ph: ptr<f64> = phases.data
    let ds: i32 = (la_fs() / 200.0) as i32
    let nk: i32 = (x.n + ds - 1) / ds
    let kt: ptr<f64> = calloc(nk as i64, 8) as ptr<f64>
    let kv: ptr<f64> = calloc(nk as i64, 8) as ptr<f64>
    let mut j: i32 = 0
    while j < nk {
        let tt: f64 = ((j * ds) as f64) / la_fs()
        kt[j] = tt
        kv[j] = clip_k(k[0] + 0.15 * sin(2.0 * la_pi() * 2.0 * tt + ph[0]))
        j = j + 1
    }
    let f: ptr<Fig> = fig_new(12.0, 6.0, "#ffffff")
    let tmax: f64 = ((x.n - 1) as f64) / la_fs()
    let a0: ptr<Ax> = grid_ax(f, 2, 1, 0, 0, 64.0, 16.0, 30.0, 46.0, 0.0, 34.0)
    ax_autoscale(a0, 0.0, tmax, arr_min(lags, b), arr_max(lags, b))
    let a1: ptr<Ax> = grid_ax(f, 2, 1, 1, 0, 64.0, 16.0, 30.0, 46.0, 0.0, 34.0)
    ax_autoscale(a1, 0.0, tmax, arr_min(kv, nk), arr_max(kv, nk))
    a0[0].hide_xlabels = true
    ax_axes(a0, 1, 0.3, false, "#ffffff")
    ax_plot(a0, times, lags, b, "#7570b3", 1.5, "-", 1.0)
    ax_frame(a0)
    ax_ylabel(a0, "Cross-corr lag (ms)", 46.0)
    ax_title(a0, "Modulation moves phase delay in real time", false)
    ax_axes(a1, 1, 0.3, false, "#ffffff")
    ax_plot(a1, kt, kv, nk, "#e7298a", 1.2, "-", 1.0)
    ax_frame(a1)
    ax_xlabel(a1, "Time (s)")
    ax_ylabel(a1, "k₁(t)", 46.0)
    ax_title(a1, "Reflection LFO (2 Hz) driving phase engine", false)
    return fig_save(f, path)
}

export function fig_audio_difference(x: Vec, ys: Vec, ym: Vec, path: string) -> bool {
    let n: i32 = (0.8 * la_fs()) as i32
    let t: ptr<f64> = time_axis(n)
    let ds: ptr<f64> = calloc(n as i64, 8) as ptr<f64>
    let dm: ptr<f64> = calloc(n as i64, 8) as ptr<f64>
    let xd: ptr<f64> = x.data
    let sd: ptr<f64> = ys.data
    let md: ptr<f64> = ym.data
    let mut i: i32 = 0
    while i < n {
        ds[i] = sd[i] - xd[i]
        dm[i] = md[i] - xd[i]
        i = i + 1
    }
    let f: ptr<Fig> = fig_new(12.0, 5.0, "#ffffff")
    let a0: ptr<Ax> = grid_ax(f, 2, 1, 0, 0, 64.0, 16.0, 30.0, 46.0, 0.0, 34.0)
    let a1: ptr<Ax> = grid_ax(f, 2, 1, 1, 0, 64.0, 16.0, 30.0, 46.0, 0.0, 34.0)
    series_ax(a0, t[0], t[n - 1], ds, n)
    series_ax(a1, t[0], t[n - 1], dm, n)
    a0[0].hide_xlabels = true
    ax_axes(a0, 1, 0.3, false, "#ffffff")
    ax_plot(a0, t, ds, n, "#1b9e77", 0.7, "-", 1.0)
    ax_frame(a0)
    ax_ylabel(a0, "y − x", 46.0)
    ax_title(a0, "Static: difference waveform (phase offset, gain unchanged)", false)
    ax_axes(a1, 1, 0.3, false, "#ffffff")
    ax_plot(a1, t, dm, n, "#d95f02", 0.7, "-", 1.0)
    ax_frame(a1)
    ax_ylabel(a1, "y − x", 46.0)
    ax_xlabel(a1, "Time (s)")
    ax_title(a1, "Modulated: difference evolves as k(t) moves", false)
    return fig_save(f, path)
}
