# Schur-lattice all-pass demo and verification plots.
#
#   tools/audio/lattice_allpass_audio_demo.sh [--no-open]
#   tools/audio/plot_lattice_allpass.sh [--no-open] [--skip-lean]
#
# `demo` pushes a synthetic test signal through the lattice all-pass of
# lib/stdlib/audio/lattice_allpass.flow, statically and with a 2 Hz LFO on
# the reflections, writes three 16-bit mono WAV files and seven SVG figures,
# and prints the reflections and RMS figures.
#
# `plot` builds the formal proofs (lake build), runs the Flow verification
# programs, draws the hero figure and the verification dashboard, then runs
# `demo`. It exits 1 unless the proofs, the verifier and the Flow demo all
# pass.
#
# On macOS both open their key outputs with open(1) unless --no-open is
# given or FLOW_NO_OPEN=1 is set.

import "figs_plot.flow"
import .text { ft_out, ft_outln, ft_err, ft_errln, ft_eq, ft_len, ft_starts, ft_ends, ft_read_file, ft_write_file, ft_split_lines, ft_list_new, ft_list_push, ft_list_len, ft_list_get, ft_list_sort, StrList }
import .proc { pr_quote, pr_run, pr_cwd, pr_mkdir_p, pr_is_dir }

extern {
    function malloc(size: i64) -> ptr<void>
    function calloc(n: i64, size: i64) -> ptr<void>
    function getenv(name: string) -> string
    function sqrt(x: f64) -> f64
    function access(path: string, mode: i32) -> i32
    function atoi(s: string) -> i32
}

struct Paths {
    root: string
    out_dir: string
    audio_dir: string
    fig_dir: string
}

function paths() -> Paths {
    let root: string = pr_cwd()
    # LATTICE_ALLPASS_OUT redirects every output (tests use a temp dir).
    let mut out: string = getenv("LATTICE_ALLPASS_OUT")
    if out as ptr<u8> == null or ft_len(out) == 0 {
        out = root
    }
    return Paths {
        root: root,
        out_dir: out + "/build/plots/schur_lattice_allpass",
        audio_dir: out + "/build/audio/lattice_allpass",
        fig_dir: out + "/docs/research/schur_lattice_allpass/figures"
    }
}

function is_macos() -> bool {
    return pr_run("test \"$(uname -s)\" = Darwin") == 0
}

function should_open(no_open: bool) -> bool {
    if no_open {
        return false
    }
    let env: string = getenv("FLOW_NO_OPEN")
    if env as ptr<u8> != null and ft_eq(env, "1") {
        return false
    }
    return is_macos()
}

function open_files(files: ptr<StrList>) -> void {
    let mut cmd: string = "open"
    let mut i: i32 = 0
    while i < ft_list_len(files) {
        cmd = cmd + " " + pr_quote(ft_list_get(files, i))
        i = i + 1
    }
    let _r: i32 = pr_run(cmd)
}

# numpy's str() of a small float64 array: up to 8 decimals, trailing zeros
# trimmed, every entry padded to a common width.
function np_array_str(v: ptr<f64>, n: i32) -> string {
    let ints: ptr<string> = malloc((n * 8) as i64) as ptr<string>
    let fracs: ptr<string> = malloc((n * 8) as i64) as ptr<string>
    let mut wi: i32 = 0
    let mut wf: i32 = 0
    let mut i: i32 = 0
    while i < n {
        let s: string = fmtf("%.8f", v[i])
        let p: ptr<u8> = s as ptr<u8>
        let mut len: i32 = ft_len(s)
        while len > 0 and p[len - 1] == 48 {
            len = len - 1
        }
        p[len] = 0
        let mut dot: i32 = 0
        while p[dot] != 46 {
            dot = dot + 1
        }
        p[dot] = 0
        ints[i] = s
        fracs[i] = (&p[dot + 1]) as string
        if ft_len(ints[i]) > wi {
            wi = ft_len(ints[i])
        }
        if ft_len(fracs[i]) > wf {
            wf = ft_len(fracs[i])
        }
        i = i + 1
    }
    let mut out: string = "["
    i = 0
    while i < n {
        if i > 0 {
            out = out + " "
        }
        let mut s: string = ints[i]
        while ft_len(s) < wi {
            s = " " + s
        }
        let mut fr: string = fracs[i]
        while ft_len(fr) < wf {
            fr = fr + " "
        }
        out = out + s + "." + fr
        i = i + 1
    }
    return out + "]"
}

function copy_file(src: string, dst: string) -> bool {
    return pr_run("cp " + pr_quote(src) + " " + pr_quote(dst)) == 0
}

# Sorted names in `dir` starting with `prefix` and ending with `suffix`.
function list_dir(dir: string, prefix: string, suffix: string) -> ptr<StrList> {
    let out: ptr<StrList> = ft_list_new()
    let tmp: string = dir + "/.list.tmp"
    let _r: i32 = pr_run("ls -1 " + pr_quote(dir) + " > " + pr_quote(tmp) + " 2>/dev/null")
    let text: string = ft_read_file(tmp)
    let _d: i32 = pr_run("rm -f " + pr_quote(tmp))
    if text as ptr<u8> == null {
        return out
    }
    let lines: ptr<StrList> = ft_split_lines(text)
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let name: string = ft_list_get(lines, i)
        if ft_len(name) > 0 and ft_starts(name, prefix) and ft_ends(name, suffix) and ft_eq(name, ".list.tmp") == false {
            ft_list_push(out, name)
        }
        i = i + 1
    }
    ft_list_sort(out)
    return out
}

function design_k(k: ptr<f64>) -> i32 {
    let poles: array<f64, 4> = [0.5, 0.4, 0.3, 0.2]
    let a: ptr<f64> = calloc(16, 8) as ptr<f64>
    let order: i32 = denom_from_poles(poles, 4, a)
    step_down(a, order, k)
    return order
}

# ---- demo ----

function run_demo(no_open: bool) -> i32 {
    let p: Paths = paths()
    let k: ptr<f64> = calloc(16, 8) as ptr<f64>
    let order: i32 = design_k(k)
    ft_outln("Schur reflections k = " + np_array_str(k, order))

    if pr_mkdir_p(p.out_dir) == false {
        ft_errln("lattice_allpass: cannot create " + p.out_dir)
        return 1
    }
    let d1: bool = fig_dsp_bode(k, order, p.out_dir + "/dsp_bode_pz_groupdelay.svg")
    let d2: bool = fig_dsp_impulse(k, order, p.out_dir + "/dsp_impulse_step.svg")

    let x: Vec = make_test_audio(3.0)
    let ys: Vec = process_block(x, k, order, 0.0, 0.0)
    let ym: Vec = process_block(x, k, order, 0.15, 2.0)

    if pr_mkdir_p(p.audio_dir) == false {
        ft_errln("lattice_allpass: cannot create " + p.audio_dir)
        return 1
    }
    let w1: bool = write_wav(p.audio_dir + "/input.wav", x, 48000)
    let w2: bool = write_wav(p.audio_dir + "/output_static_allpass.wav", ys, 48000)
    let w3: bool = write_wav(p.audio_dir + "/output_modulated_allpass.wav", ym, 48000)
    if w1 == false or w2 == false or w3 == false {
        ft_errln("lattice_allpass: cannot write WAV files in " + p.audio_dir)
        return 1
    }

    let rin: f64 = rms(x)
    let rst: f64 = rms(ys)
    let rmd: f64 = rms(ym)
    ft_outln("RMS  in=" + fmtf("%.4f", rin) + "  static=" + fmtf("%.4f", rst) + "  mod=" + fmtf("%.4f", rmd))
    ft_outln("RMS ratio static=" + fmtf("%.4f", rst / rin) + "  mod=" + fmtf("%.4f", rmd / rin))

    let a1: bool = fig_audio_waveforms(x, ys, ym, p.out_dir + "/audio_waveforms.svg")
    let a2: bool = fig_audio_rms(x, ys, ym, p.out_dir + "/audio_rms_envelope.svg")
    let a3: bool = fig_audio_spectrograms(x, ys, ym, p.out_dir + "/audio_spectrograms.svg")
    let a4: bool = fig_audio_modulation(x, ym, k, order, p.out_dir + "/audio_modulation_proof.svg")
    let a5: bool = fig_audio_difference(x, ys, ym, p.out_dir + "/audio_phase_difference.svg")
    if (d1 and d2 and a1 and a2 and a3 and a4 and a5) == false {
        ft_errln("lattice_allpass: cannot write figures in " + p.out_dir)
        return 1
    }

    # copy_outputs(): dsp_* and audio_* figures into the paper's figures/.
    let _m: bool = pr_mkdir_p(p.fig_dir)
    let dsp: ptr<StrList> = list_dir(p.out_dir, "dsp_", ".svg")
    let aud: ptr<StrList> = list_dir(p.out_dir, "audio_", ".svg")
    let mut i: i32 = 0
    while i < ft_list_len(dsp) {
        let _c: bool = copy_file(p.out_dir + "/" + ft_list_get(dsp, i), p.fig_dir + "/" + ft_list_get(dsp, i))
        i = i + 1
    }
    i = 0
    while i < ft_list_len(aud) {
        let _c: bool = copy_file(p.out_dir + "/" + ft_list_get(aud, i), p.fig_dir + "/" + ft_list_get(aud, i))
        i = i + 1
    }

    ft_outln("\nWAV files: " + p.audio_dir + "/")
    let wavs: ptr<StrList> = list_dir(p.audio_dir, "", ".wav")
    i = 0
    while i < ft_list_len(wavs) {
        ft_outln("  " + p.audio_dir + "/" + ft_list_get(wavs, i))
        i = i + 1
    }
    ft_outln("\nDSP + audio plots: " + p.out_dir + "/")
    i = 0
    while i < ft_list_len(dsp) {
        ft_outln("  " + p.out_dir + "/" + ft_list_get(dsp, i))
        i = i + 1
    }
    i = 0
    while i < ft_list_len(aud) {
        ft_outln("  " + p.out_dir + "/" + ft_list_get(aud, i))
        i = i + 1
    }

    if should_open(no_open) {
        let key: ptr<StrList> = ft_list_new()
        ft_list_push(key, p.out_dir + "/dsp_bode_pz_groupdelay.svg")
        ft_list_push(key, p.out_dir + "/audio_waveforms.svg")
        ft_list_push(key, p.out_dir + "/audio_modulation_proof.svg")
        open_files(key)
        let wav: ptr<StrList> = ft_list_new()
        ft_list_push(wav, p.audio_dir + "/output_modulated_allpass.wav")
        open_files(wav)
    }
    return 0
}

# ---- plot ----

# Run `cmd` in `dir`, capturing stdout (stderr too when `both`) and the
# exit status.
function run_capture(cmd: string, dir: string, both: bool, out: ptr<string>) -> i32 {
    let tmp: string = pr_cwd() + "/build/plots/.lattice_allpass_cmd.out"
    let _m: bool = pr_mkdir_p(pr_cwd() + "/build/plots")
    let mut redir: string = " > " + pr_quote(tmp) + " 2>/dev/null"
    if both {
        redir = " > " + pr_quote(tmp) + " 2>&1"
    }
    let mut full: string = cmd + redir
    if ft_len(dir) > 0 {
        full = "cd " + pr_quote(dir) + " && " + full
    }
    let rc: i32 = pr_run("(" + full + ")")
    let text: string = ft_read_file(tmp)
    let _d: i32 = pr_run("rm -f " + pr_quote(tmp))
    if text as ptr<u8> == null {
        out[0] = ""
    } else {
        out[0] = text
    }
    return rc
}

function run_plot(no_open: bool, skip_lean: bool) -> i32 {
    let p: Paths = paths()
    let formal: string = p.root + "/formal/SchurLatticeAllpass"
    let flow: string = p.root + "/flow"
    let mut lean_ok: bool = false
    let mut verify_ok: bool = false
    let mut demo_ok: bool = false
    let fd: ptr<FlowDemo> = flow_demo_new()
    let out: ptr<string> = malloc(8) as ptr<string>

    if pr_is_dir(formal) and skip_lean == false {
        ft_outln("$ lake build")
        let rc: i32 = run_capture("lake build", formal, true, out)
        lean_ok = rc == 0
        if lean_ok == false {
            ft_err(out[0])
            ft_errln("")
        }
    }

    if access(flow, 0) == 0 {
        let verify: string = p.root + "/lib/verify/SchurLattice.flow"
        let demo: string = p.root + "/examples/audio/lattice_allpass_demo.flow"
        ft_outln("$ " + flow + " run " + verify)
        let rc1: i32 = run_capture(pr_quote(flow) + " run " + pr_quote(verify), "", false, out)
        verify_ok = rc1 == 0
        ft_outln(out[0])
        ft_outln("$ " + flow + " run " + demo)
        let rc2: i32 = run_capture(pr_quote(flow) + " run " + pr_quote(demo), "", false, out)
        demo_ok = rc2 == 0
        ft_outln(out[0])
        parse_flow_demo(out[0], fd)
    }

    let k: ptr<f64> = calloc(16, 8) as ptr<f64>
    let a: ptr<f64> = calloc(16, 8) as ptr<f64>
    let poles: array<f64, 4> = [0.5, 0.4, 0.3, 0.2]
    let order0: i32 = denom_from_poles(poles, 4, a)
    step_down(a, order0, k)
    let mut order: i32 = order0
    if fd[0].nk > 0 {
        let fk: ptr<f64> = fd[0].k
        let mut i: i32 = 0
        while i < fd[0].nk {
            k[i] = fk[i]
            i = i + 1
        }
        order = fd[0].nk
    }

    if pr_mkdir_p(p.out_dir) == false {
        ft_errln("lattice_allpass: cannot create " + p.out_dir)
        return 1
    }
    let novel: string = p.out_dir + "/schur_lattice_novel_demo.svg"
    let overview: string = p.out_dir + "/schur_lattice_allpass_overview.svg"
    let ok1: bool = fig_novel_demo(k, order, a, order0, novel)
    let ok2: bool = fig_overview(k, order, fd, lean_ok, skip_lean, verify_ok, demo_ok, overview)
    if ok1 == false or ok2 == false {
        ft_errln("lattice_allpass: cannot write figures in " + p.out_dir)
        return 1
    }

    # copy_figures(): every SVG in the build directory.
    let _m: bool = pr_mkdir_p(p.fig_dir)
    let svgs: ptr<StrList> = list_dir(p.out_dir, "", ".svg")
    let mut i: i32 = 0
    while i < ft_list_len(svgs) {
        let _c: bool = copy_file(p.out_dir + "/" + ft_list_get(svgs, i), p.fig_dir + "/" + ft_list_get(svgs, i))
        i = i + 1
    }

    # run_audio_demo()
    let _d: i32 = run_demo(no_open)

    ft_outln("\nWrote plots to " + p.out_dir + "/")
    let all: ptr<StrList> = list_dir(p.out_dir, "", ".svg")
    i = 0
    while i < ft_list_len(all) {
        ft_outln("  " + p.out_dir + "/" + ft_list_get(all, i))
        i = i + 1
    }
    ft_outln("Copied to " + p.fig_dir + "/")

    if should_open(no_open) {
        let key: ptr<StrList> = ft_list_new()
        ft_list_push(key, novel)
        ft_list_push(key, overview)
        open_files(key)
    }
    if lean_ok and verify_ok and demo_ok {
        return 0
    }
    return 1
}

function usage() -> void {
    ft_errln("usage: lattice_allpass demo [--no-open]")
    ft_errln("       lattice_allpass plot [--no-open] [--skip-lean]")
    ft_errln("       lattice_allpass normals SEED N")
}

function main(argc: i32, argv: ptr<ptr<u8>>) -> i32 {
    if argc < 2 {
        usage()
        return 2
    }
    let mode: string = argv[1] as string
    let mut no_open: bool = false
    let mut skip_lean: bool = false
    let mut i: i32 = 2
    if ft_eq(mode, "normals") {
        i = argc
    }
    while i < argc {
        let a: string = argv[i] as string
        if ft_eq(a, "--no-open") {
            no_open = true
        } elif ft_eq(a, "--skip-lean") {
            skip_lean = true
        } elif ft_eq(a, "-h") or ft_eq(a, "--help") {
            usage()
            return 0
        } else {
            ft_errln("lattice_allpass: unknown argument: " + a)
            usage()
            return 2
        }
        i = i + 1
    }
    if ft_eq(mode, "demo") {
        return run_demo(no_open)
    }
    if ft_eq(mode, "normals") {
        # normals SEED N: numpy default_rng(SEED).standard_normal(N), %.17g.
        if argc != 4 {
            usage()
            return 2
        }
        let r: ptr<NpRng> = np_default_rng(atoi(argv[2] as string) as u32)
        let n: i32 = atoi(argv[3] as string)
        let mut j: i32 = 0
        while j < n {
            ft_outln(fmtf("%.17g", np_standard_normal(r)))
            j = j + 1
        }
        return 0
    }
    if ft_eq(mode, "plot") {
        return run_plot(no_open, skip_lean)
    }
    usage()
    return 2
}
