# @module tools.lattice_allpass.rng
# @means  numpy's default_rng(seed).standard_normal(), bit for bit.
#
# The test signal's hi-hat bursts were drawn from numpy.random.default_rng
# with small integer seeds. This module reproduces that stream so the Flow
# demo writes the same samples: SeedSequence entropy mixing, the PCG64
# (XSL-RR 128/64) generator, and the 256-layer ziggurat normal sampler with
# numpy's own tables.

extern {
    function malloc(size: i64) -> ptr<void>
    function log1p(x: f64) -> f64
    function exp(x: f64) -> f64
}

function zig_nor_r() -> f64 {
    return 3.6541528853610087963519472518
}

function zig_nor_inv_r() -> f64 {
    return 0.27366123732975827203338247596
}

# PCG64 state: 128-bit state and increment as (hi, lo) halves, plus the
# ziggurat tables.
export struct NpRng {
    s_hi: u64
    s_lo: u64
    i_hi: u64
    i_lo: u64
    ki: ptr<u64>
    wi: ptr<f64>
    fi: ptr<f64>
}

# ---- SeedSequence (numpy/random/bit_generator.pyx) ----

function ss_hashmix(value: u32, hc: ptr<u32>) -> u32 {
    let mut v: u32 = value ^ hc[0]
    hc[0] = hc[0] * 0x931e8875
    v = v * hc[0]
    v = v ^ (v >> 16)
    return v
}

function ss_mix(x: u32, y: u32) -> u32 {
    let mut r: u32 = (0xca01f9dd * x) - (0x4973f715 * y)
    r = r ^ (r >> 16)
    return r
}

# SeedSequence(seed).generate_state(8, uint32) for a seed below 2**32.
function ss_generate_state(seed: u32, out: ptr<u32>) -> void {
    let pool: ptr<u32> = malloc(16) as ptr<u32>
    let hc: ptr<u32> = malloc(4) as ptr<u32>
    hc[0] = 0x43b0d7e5
    let mut i: i32 = 0
    while i < 4 {
        if i == 0 {
            pool[i] = ss_hashmix(seed, hc)
        } else {
            pool[i] = ss_hashmix(0, hc)
        }
        i = i + 1
    }
    let mut src: i32 = 0
    while src < 4 {
        let mut dst: i32 = 0
        while dst < 4 {
            if src != dst {
                pool[dst] = ss_mix(pool[dst], ss_hashmix(pool[src], hc))
            }
            dst = dst + 1
        }
        src = src + 1
    }
    let mut hb: u32 = 0x8b51f9dd
    i = 0
    while i < 8 {
        let mut v: u32 = pool[i % 4]
        v = v ^ hb
        hb = hb * 0x58f38ded
        v = v * hb
        v = v ^ (v >> 16)
        out[i] = v
        i = i + 1
    }
}

# ---- 128-bit arithmetic ----

# High 64 bits of a 64x64 product.
function mul_hi64(a: u64, b: u64) -> u64 {
    let mask: u64 = 0xFFFFFFFF
    let a_lo: u64 = a & mask
    let a_hi: u64 = a >> 32
    let b_lo: u64 = b & mask
    let b_hi: u64 = b >> 32
    let p0: u64 = a_lo * b_lo
    let p1: u64 = a_lo * b_hi
    let p2: u64 = a_hi * b_lo
    let p3: u64 = a_hi * b_hi
    let mid: u64 = (p0 >> 32) + (p1 & mask) + (p2 & mask)
    return p3 + (p1 >> 32) + (p2 >> 32) + (mid >> 32)
}

# state = state * MULT + inc (mod 2**128)
function pcg_step(r: ptr<NpRng>) -> void {
    let m_hi: u64 = 0x2360ED051FC65DA4
    let m_lo: u64 = 0x4385DF649FCCF645
    let s_hi: u64 = r[0].s_hi
    let s_lo: u64 = r[0].s_lo
    let lo: u64 = s_lo * m_lo
    let hi: u64 = mul_hi64(s_lo, m_lo) + s_hi * m_lo + s_lo * m_hi
    let lo2: u64 = lo + r[0].i_lo
    let mut carry: u64 = 0
    if lo2 < lo {
        carry = 1
    }
    r[0].s_lo = lo2
    r[0].s_hi = hi + r[0].i_hi + carry
}

function state_add(r: ptr<NpRng>, a_hi: u64, a_lo: u64) -> void {
    let lo: u64 = r[0].s_lo + a_lo
    let mut carry: u64 = 0
    if lo < a_lo {
        carry = 1
    }
    r[0].s_lo = lo
    r[0].s_hi = r[0].s_hi + a_hi + carry
}

export function np_rng_next_u64(r: ptr<NpRng>) -> u64 {
    pcg_step(r)
    let x: u64 = r[0].s_hi ^ r[0].s_lo
    let rot: u64 = r[0].s_hi >> 58
    if rot == 0 {
        return x
    }
    return (x >> rot) | (x << (64 - rot))
}

export function np_rng_next_double(r: ptr<NpRng>) -> f64 {
    let v: u64 = np_rng_next_u64(r) >> 11
    return (v as f64) * (1.0 / 9007199254740992.0)
}

function hex_digit(c: u8) -> u64 {
    if c >= 48 and c <= 57 {
        return (c - 48) as u64
    }
    return (c - 55) as u64
}

function parse_hex_table(s: string) -> ptr<u64> {
    let p: ptr<u8> = s as ptr<u8>
    let t: ptr<u64> = malloc(2048) as ptr<u64>
    let mut i: i32 = 0
    while i < 256 {
        let mut v: u64 = 0
        let mut d: i32 = 0
        while d < 16 {
            v = (v << 4) | hex_digit(p[i * 16 + d])
            d = d + 1
        }
        t[i] = v
        i = i + 1
    }
    return t
}

# numpy.random.default_rng(seed) for 0 <= seed < 2**32.
export function np_default_rng(seed: u32) -> ptr<NpRng> {
    let r: ptr<NpRng> = malloc(64) as ptr<NpRng>
    let w: ptr<u32> = malloc(32) as ptr<u32>
    ss_generate_state(seed, w)
    let init_hi: u64 = (w[0] as u64) | ((w[1] as u64) << 32)
    let init_lo: u64 = (w[2] as u64) | ((w[3] as u64) << 32)
    let seq_hi: u64 = (w[4] as u64) | ((w[5] as u64) << 32)
    let seq_lo: u64 = (w[6] as u64) | ((w[7] as u64) << 32)
    r[0].s_hi = 0
    r[0].s_lo = 0
    r[0].i_hi = (seq_hi << 1) | (seq_lo >> 63)
    r[0].i_lo = (seq_lo << 1) | 1
    pcg_step(r)
    state_add(r, init_hi, init_lo)
    pcg_step(r)
    r[0].ki = parse_hex_table(zig_ki_hex())
    r[0].wi = parse_hex_table(zig_wi_hex()) as ptr<f64>
    r[0].fi = parse_hex_table(zig_fi_hex()) as ptr<f64>
    return r
}

# Generator.standard_normal() for one float64 draw.
export function np_standard_normal(r: ptr<NpRng>) -> f64 {
    let ki: ptr<u64> = r[0].ki
    let wi: ptr<f64> = r[0].wi
    let fi: ptr<f64> = r[0].fi
    while true {
        let mut rr: u64 = np_rng_next_u64(r)
        let idx: i32 = (rr & 0xff) as i32
        rr = rr >> 8
        let sign: u64 = rr & 1
        let rabs: u64 = (rr >> 1) & 0x000fffffffffffff
        let mut x: f64 = (rabs as f64) * wi[idx]
        if sign == 1 {
            x = 0.0 - x
        }
        if rabs < ki[idx] {
            return x
        }
        if idx == 0 {
            while true {
                let xx: f64 = (0.0 - zig_nor_inv_r()) * log1p(0.0 - np_rng_next_double(r))
                let yy: f64 = 0.0 - log1p(0.0 - np_rng_next_double(r))
                if yy + yy > xx * xx {
                    if ((rabs >> 8) & 1) == 1 {
                        return 0.0 - (zig_nor_r() + xx)
                    }
                    return zig_nor_r() + xx
                }
            }
        } else {
            let f: f64 = (fi[idx - 1] - fi[idx]) * np_rng_next_double(r) + fi[idx]
            if f < exp(-0.5 * x * x) {
                return x
            }
        }
    }
    return 0.0
}

