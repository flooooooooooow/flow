# Keep the Wiki's Demos tab aligned with docs/demos/catalog.json.
#
# Run it as `./flow tool demo_nav` from anywhere in the repository; it works
# from the repository root:
#
#   flow tool demo_nav           rewrite the demo sections of docs/nav.json
#   flow tool demo_nav --check   exit 1 if they are stale
#
# docs/nav.json is re-serialised the way json.dumps(indent=2,
# ensure_ascii=False) writes it, so output is byte-identical to the Python
# script this replaces. Numbers keep their source spelling, which matches
# Python for every number written in canonical form.

import .text { ft_outln, ft_errln, ft_eq, ft_len, ft_repr, ft_read_file, ft_write_file, ft_list_new, ft_list_push, ft_list_len, ft_list_get, StrList }
import .json { json_parse, json_error, json_get, json_kind, json_str, json_key, json_first, json_next, json_len, json_kind_string, json_kind_object, json_kind_array, Json }
import .demogen { dg_flags, dg_json_quote, dg_json_dump, dg_indent }
import .repo { rp_enter_root }

extern {
    function malloc(size: i64) -> ptr<void>
}

const PROG: string = "flow tool demo_nav"
const NAV: string = "docs/nav.json"
const CATALOG: string = "docs/demos/catalog.json"

function usage_line() -> string {
    return "usage: flow tool demo_nav [-h] [--check]\n"
}

function help_text() -> string {
    return usage_line() + "\noptions:\n  -h, --help  show this help message and exit\n  --check\n"
}

function label_for(id: string) -> string {
    if ft_eq(id, "shaders") { return "Photoreal FSL" }
    if ft_eq(id, "games") { return "Games" }
    if ft_eq(id, "morphogenesis") { return "Morphogenesis" }
    if ft_eq(id, "neuro") { return "Neurons & Networks" }
    if ft_eq(id, "social") { return "Opinion Dynamics" }
    if ft_eq(id, "threed") { return "3D" }
    if ft_eq(id, "evoleco") { return "Evolutionary Biology" }
    if ft_eq(id, "planet") { return "Planets" }
    if ft_eq(id, "procgen") { return "Procedural Generation" }
    if ft_eq(id, "numerical") { return "Numerical Methods" }
    if ft_eq(id, "evolution") { return "Evolution Suite" }
    if ft_eq(id, "wasm") { return "WebAssembly" }
    return null as string
}

# Render an object from parallel lists of keys and already-encoded values.
function render_obj(keys: ptr<StrList>, vals: ptr<StrList>, level: i32) -> string {
    if ft_list_len(keys) == 0 {
        return "{}"
    }
    let inner: string = dg_indent(level + 1)
    let mut out: string = "{\n"
    let mut i: i32 = 0
    while i < ft_list_len(keys) {
        if i > 0 {
            out = out + ",\n"
        }
        out = out + inner + dg_json_quote(ft_list_get(keys, i)) + ": " + ft_list_get(vals, i)
        i = i + 1
    }
    return out + "\n" + dg_indent(level) + "}"
}

function render_arr(vals: ptr<StrList>, level: i32) -> string {
    if ft_list_len(vals) == 0 {
        return "[]"
    }
    let inner: string = dg_indent(level + 1)
    let mut out: string = "[\n"
    let mut i: i32 = 0
    while i < ft_list_len(vals) {
        if i > 0 {
            out = out + ",\n"
        }
        out = out + inner + ft_list_get(vals, i)
        i = i + 1
    }
    return out + "\n" + dg_indent(level) + "]"
}

# {"label": ..., "path": ..., ["external": true]} at `level`.
function link(label: string, path: string, external: bool, level: i32) -> string {
    let keys: ptr<StrList> = ft_list_new()
    let vals: ptr<StrList> = ft_list_new()
    ft_list_push(keys, "label")
    ft_list_push(vals, dg_json_quote(label))
    ft_list_push(keys, "path")
    ft_list_push(vals, dg_json_quote(path))
    if external {
        ft_list_push(keys, "external")
        ft_list_push(vals, "true")
    }
    return render_obj(keys, vals, level)
}

# Dump object `id`, replacing the members named in `okeys` with the encoded
# `ovals` and appending the ones it lacks, as dict assignment does.
function dump_override(j: ptr<Json>, id: i32, level: i32, okeys: ptr<StrList>, ovals: ptr<StrList>) -> string {
    let keys: ptr<StrList> = ft_list_new()
    let vals: ptr<StrList> = ft_list_new()
    let used: ptr<i32> = malloc(64) as ptr<i32>
    let mut u: i32 = 0
    while u < ft_list_len(okeys) {
        used[u] = 0
        u = u + 1
    }
    let mut c: i32 = json_first(j, id)
    while c >= 0 {
        let k: string = json_key(j, c)
        let mut v: string = null as string
        u = 0
        while u < ft_list_len(okeys) {
            if ft_eq(ft_list_get(okeys, u), k) {
                v = ft_list_get(ovals, u)
                used[u] = 1
            }
            u = u + 1
        }
        if v as ptr<u8> == null {
            v = dg_json_dump(j, c, level + 1)
        }
        ft_list_push(keys, k)
        ft_list_push(vals, v)
        c = json_next(j, c)
    }
    u = 0
    while u < ft_list_len(okeys) {
        if used[u] == 0 {
            ft_list_push(keys, ft_list_get(okeys, u))
            ft_list_push(vals, ft_list_get(ovals, u))
        }
        u = u + 1
    }
    return render_obj(keys, vals, level)
}

# section.get(name) == value for an object member holding a string.
function has_str(j: ptr<Json>, id: i32, name: string, value: string) -> bool {
    if json_kind(j, id) != json_kind_object() {
        return false
    }
    let m: i32 = json_get(j, id, name)
    if m < 0 or json_kind(j, m) != json_kind_string() {
        return false
    }
    return ft_eq(json_str(j, m), value)
}

struct Catalog {
    cj: ptr<Json>
    ids: ptr<StrList>
    nodes: ptr<i32>
    err: string
}

function key_error(k: string) -> string {
    return "KeyError: " + ft_repr(k)
}

# nav_item(by_id[id]) encoded at `level`, or null with cat.err set.
function nav_item(cat: ptr<Catalog>, id: string, level: i32) -> string {
    let cj: ptr<Json> = cat[0].cj
    let mut node: i32 = -1
    let mut i: i32 = 0
    while i < ft_list_len(cat[0].ids) {
        if ft_eq(ft_list_get(cat[0].ids, i), id) {
            node = i
        }
        i = i + 1
    }
    if node < 0 {
        cat[0].err = key_error(id)
        return null as string
    }
    let nodes: ptr<i32> = cat[0].nodes
    let nid: i32 = nodes[node]
    let title: i32 = json_get(cj, nid, "title")
    if title < 0 {
        cat[0].err = key_error("title")
        return null as string
    }
    let page: i32 = json_get(cj, nid, "page")
    if page < 0 {
        cat[0].err = key_error("page")
        return null as string
    }
    let keys: ptr<StrList> = ft_list_new()
    let vals: ptr<StrList> = ft_list_new()
    ft_list_push(keys, "label")
    let lab: string = label_for(id)
    if lab as ptr<u8> != null {
        ft_list_push(vals, dg_json_quote(lab))
    } else {
        ft_list_push(vals, dg_json_dump(cj, title, level + 1))
    }
    ft_list_push(keys, "path")
    ft_list_push(vals, dg_json_quote("demos/" + json_str(cj, page)))
    return render_obj(keys, vals, level)
}

# A section built from catalog ids; null on a missing key.
function catalog_section(cat: ptr<Catalog>, sid: string, title: string, ids: ptr<StrList>, extra: string, level: i32) -> string {
    let items: ptr<StrList> = ft_list_new()
    let mut i: i32 = 0
    while i < ft_list_len(ids) {
        let it: string = nav_item(cat, ft_list_get(ids, i), level + 2)
        if it as ptr<u8> == null {
            return null as string
        }
        ft_list_push(items, it)
        i = i + 1
    }
    if extra as ptr<u8> != null {
        ft_list_push(items, extra)
    }
    let keys: ptr<StrList> = ft_list_new()
    let vals: ptr<StrList> = ft_list_new()
    ft_list_push(keys, "id")
    ft_list_push(vals, dg_json_quote(sid))
    ft_list_push(keys, "tab")
    ft_list_push(vals, dg_json_quote("gallery"))
    ft_list_push(keys, "title")
    ft_list_push(vals, dg_json_quote(title))
    ft_list_push(keys, "items")
    ft_list_push(vals, render_arr(items, level + 1))
    return render_obj(keys, vals, level)
}

# The four Demos-tab sections at `level`, or null with cat.err set.
function build_sections(cat: ptr<Catalog>, level: i32) -> ptr<StrList> {
    let out: ptr<StrList> = ft_list_new()
    let show: ptr<StrList> = ft_list_new()
    ft_list_push(show, link("Demo Showcase", "demos/overview.md", false, level + 2))
    ft_list_push(show, link("Solve It the Flow Way", "examples/flow_way/README.md", false, level + 2))
    let k0: ptr<StrList> = ft_list_new()
    let v0: ptr<StrList> = ft_list_new()
    ft_list_push(k0, "id")
    ft_list_push(v0, dg_json_quote("gallery-showcase"))
    ft_list_push(k0, "tab")
    ft_list_push(v0, dg_json_quote("gallery"))
    ft_list_push(k0, "title")
    ft_list_push(v0, dg_json_quote("Showcase"))
    ft_list_push(k0, "items")
    ft_list_push(v0, render_arr(show, level + 1))
    ft_list_push(out, render_obj(k0, v0, level))

    let r: ptr<StrList> = ft_list_new()
    ft_list_push(r, "shaders")
    ft_list_push(r, "threed")
    ft_list_push(r, "planet")
    ft_list_push(r, "procgen")
    let s1: string = catalog_section(cat, "gallery-rendering", "Rendering & generation", r, null as string, level)
    if s1 as ptr<u8> == null {
        return null
    }
    ft_list_push(out, s1)

    let sy: ptr<StrList> = ft_list_new()
    ft_list_push(sy, "morphogenesis")
    ft_list_push(sy, "neuro")
    ft_list_push(sy, "social")
    ft_list_push(sy, "evoleco")
    ft_list_push(sy, "evolution")
    ft_list_push(sy, "numerical")
    let s2: string = catalog_section(cat, "gallery-systems", "Systems through time", sy, null as string, level)
    if s2 as ptr<u8> == null {
        return null
    }
    ft_list_push(out, s2)

    let ia: ptr<StrList> = ft_list_new()
    ft_list_push(ia, "games")
    ft_list_push(ia, "wasm")
    let live: string = link("Live WASM demos", "wasm/index.html", true, level + 2)
    let s3: string = catalog_section(cat, "gallery-interactive", "Interactive", ia, live, level)
    if s3 as ptr<u8> == null {
        return null
    }
    ft_list_push(out, s3)
    return out
}

function start_items(level: i32) -> string {
    let items: ptr<StrList> = ft_list_new()
    ft_list_push(items, link("Demo Showcase", "demos/overview.md", false, level + 1))
    ft_list_push(items, link("Photoreal FSL", "demos/shaders.md", false, level + 1))
    ft_list_push(items, link("Games", "demos/games.md", false, level + 1))
    ft_list_push(items, link("Morphogenesis", "demos/morphogenesis.md", false, level + 1))
    ft_list_push(items, link("Live WASM demos", "wasm/index.html", true, level + 1))
    return render_arr(items, level)
}

function render_tabs(j: ptr<Json>, tabs: i32) -> string {
    if json_kind(j, tabs) != json_kind_array() {
        return dg_json_dump(j, tabs, 1)
    }
    let vals: ptr<StrList> = ft_list_new()
    let mut done: bool = false
    let mut c: i32 = json_first(j, tabs)
    while c >= 0 {
        if done == false and has_str(j, c, "id", "gallery") {
            let ok: ptr<StrList> = ft_list_new()
            let ov: ptr<StrList> = ft_list_new()
            ft_list_push(ok, "label")
            ft_list_push(ov, dg_json_quote("Demos"))
            ft_list_push(vals, dump_override(j, c, 2, ok, ov))
            done = true
        } else {
            ft_list_push(vals, dg_json_dump(j, c, 2))
        }
        c = json_next(j, c)
    }
    return render_arr(vals, 1)
}

# The rewritten sections array, or null with cat.err set.
function render_sections(j: ptr<Json>, sections: i32, cat: ptr<Catalog>) -> string {
    let kept: ptr<StrList> = ft_list_new()
    let mut insert_at: i32 = -1
    let mut idx: i32 = 0
    let mut started: bool = false
    let mut c: i32 = json_first(j, sections)
    while c >= 0 {
        # The first start-galleries section is rewritten even when it is a
        # gallery section that is about to be dropped.
        let is_start: bool = started == false and has_str(j, c, "id", "start-galleries")
        if is_start {
            started = true
        }
        if has_str(j, c, "tab", "gallery") {
            if insert_at < 0 {
                insert_at = idx
            }
        } elif is_start {
            let ok: ptr<StrList> = ft_list_new()
            let ov: ptr<StrList> = ft_list_new()
            ft_list_push(ok, "title")
            ft_list_push(ov, dg_json_quote("Popular demos"))
            ft_list_push(ok, "items")
            ft_list_push(ov, start_items(3))
            ft_list_push(kept, dump_override(j, c, 2, ok, ov))
        } else {
            ft_list_push(kept, dg_json_dump(j, c, 2))
        }
        idx = idx + 1
        c = json_next(j, c)
    }
    if insert_at < 0 {
        insert_at = 1
    }
    let built: ptr<StrList> = build_sections(cat, 2)
    if built == null {
        return null as string
    }
    let all: ptr<StrList> = ft_list_new()
    let mut i: i32 = 0
    let mut inserted: bool = false
    while i < ft_list_len(kept) {
        if i == insert_at {
            let mut b: i32 = 0
            while b < ft_list_len(built) {
                ft_list_push(all, ft_list_get(built, b))
                b = b + 1
            }
            inserted = true
        }
        ft_list_push(all, ft_list_get(kept, i))
        i = i + 1
    }
    if inserted == false {
        let mut b2: i32 = 0
        while b2 < ft_list_len(built) {
            ft_list_push(all, ft_list_get(built, b2))
            b2 = b2 + 1
        }
    }
    return render_arr(all, 1)
}

function load(path: string) -> ptr<Json> {
    let text: string = ft_read_file(path)
    if text as ptr<u8> == null {
        ft_errln("FileNotFoundError: [Errno 2] No such file or directory: " + ft_repr(path))
        return null
    }
    let j: ptr<Json> = json_parse(text)
    if ft_len(json_error(j)) > 0 {
        ft_errln("json.decoder.JSONDecodeError: " + json_error(j))
        return null
    }
    return j
}

# The expected docs/nav.json text, or null after reporting an error.
function rendered() -> string {
    let j: ptr<Json> = load(NAV)
    if j == null {
        return null as string
    }
    let cj: ptr<Json> = load(CATALOG)
    if cj == null {
        return null as string
    }
    let sections: i32 = json_get(j, 0, "sections")
    if sections < 0 {
        ft_errln(key_error("sections"))
        return null as string
    }
    let coll: i32 = json_get(cj, 0, "collections")
    if coll < 0 {
        ft_errln(key_error("collections"))
        return null as string
    }
    let cat: ptr<Catalog> = malloc(32) as ptr<Catalog>
    cat[0].cj = cj
    cat[0].ids = ft_list_new()
    let nodes: ptr<i32> = malloc((json_len(cj, coll) as i64) * 4 + 4) as ptr<i32>
    cat[0].nodes = nodes
    cat[0].err = null
    let mut c: i32 = json_first(cj, coll)
    while c >= 0 {
        let idn: i32 = json_get(cj, c, "id")
        if idn < 0 {
            ft_errln(key_error("id"))
            return null as string
        }
        ft_list_push(cat[0].ids, json_str(cj, idn))
        nodes[ft_list_len(cat[0].ids) - 1] = c
        c = json_next(cj, c)
    }

    let keys: ptr<StrList> = ft_list_new()
    let vals: ptr<StrList> = ft_list_new()
    let mut m: i32 = json_first(j, 0)
    while m >= 0 {
        let k: string = json_key(j, m)
        ft_list_push(keys, k)
        if ft_eq(k, "tabs") {
            ft_list_push(vals, render_tabs(j, m))
        } elif m == sections {
            let sv: string = render_sections(j, m, cat)
            if sv as ptr<u8> == null {
                ft_errln(cat[0].err)
                return null as string
            }
            ft_list_push(vals, sv)
        } else {
            ft_list_push(vals, dg_json_dump(j, m, 1))
        }
        m = json_next(j, m)
    }
    return render_obj(keys, vals, 0) + "\n"
}

function main(argc: i32, argv: ptr<string>) -> i32 {
    if rp_enter_root() == false {
        ft_errln("demo_nav: cannot enter the repository root")
        return 1
    }
    let flags: ptr<StrList> = ft_list_new()
    ft_list_push(flags, "--check")
    let on: ptr<i32> = malloc(8) as ptr<i32>
    on[0] = 0
    let rc: i32 = dg_flags(argc, argv, flags, on, PROG, usage_line(), help_text())
    if rc >= 0 {
        return rc
    }
    let expected: string = rendered()
    if expected as ptr<u8> == null {
        return 1
    }
    if on[0] == 1 {
        let current: string = ft_read_file(NAV)
        if current as ptr<u8> == null or ft_eq(current, expected) == false {
            ft_errln("docs/nav.json demo sections are stale; run ./flow tool demo_nav")
            return 1
        }
        ft_outln("demo navigation is current")
        return 0
    }
    if ft_write_file(NAV, expected) == false {
        ft_errln("sync_demo_nav: cannot write " + NAV)
        return 1
    }
    ft_outln("updated docs/nav.json demo navigation")
    return 0
}
