extern {
    function strlen(s: string) -> i64
    function strcmp(a: string, b: string) -> i32
    function strncmp(a: string, b: string, n: i64) -> i32
    function malloc(size: i64) -> ptr<void>
    function write(fd: i32, buf: string, n: i64) -> i64
    function snprintf(buf: ptr<i8>, size: i64, fmt: string, value: i32) -> i32
    function atoi(s: string) -> i32
}

export function js_outln(s: string) {
    let _w: i64 = write(1, s + "\n", strlen(s) + 1)
}

export function js_errln(s: string) {
    let _w: i64 = write(2, s + "\n", strlen(s) + 1)
}

export function js_starts(s: string, prefix: string) -> bool {
    return strncmp(s, prefix, strlen(prefix)) == 0
}

export function js_from(s: string, start: i32) -> string {
    let n: i32 = strlen(s) as i32
    let out: ptr<u8> = malloc((n - start + 1) as i64) as ptr<u8>
    let src: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    while start + i < n {
        out[i] = src[start + i]
        i = i + 1
    }
    out[i] = 0
    return out as string
}

export function js_slice(s: string, start: i32, end: i32) -> string {
    let out: ptr<u8> = malloc((end - start + 1) as i64) as ptr<u8>
    let src: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    while start + i < end {
        out[i] = src[start + i]
        i = i + 1
    }
    out[i] = 0
    return out as string
}

export function js_itoa(n: i32) -> string {
    let out: ptr<i8> = malloc(32) as ptr<i8>
    let _n: i32 = snprintf(out, 32, "%d", n)
    return out as string
}
