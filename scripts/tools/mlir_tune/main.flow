import .text { ft_out, ft_outln, ft_errln, ft_eq, ft_len, ft_starts, ft_from }

function transform_of(op: string, tiles: string) -> string {
    return "module attributes {transform.with_named_sequence} {\n" +
           "  transform.named_sequence @__transform_main(%arg0: !transform.any_op {transform.readonly}) {\n" +
           "    %matmul = transform.structured.match ops[\"" + op + "\"] in %arg0 : (!transform.any_op) -> !transform.any_op\n" +
           "    %tiled_linalg_op, %loops:3 = transform.structured.tile_using_for %matmul [" + tiles + "] : (!transform.any_op) -> (!transform.any_op, !transform.any_op, !transform.any_op, !transform.any_op)\n" +
           "    transform.yield\n" +
           "  }\n" +
           "}\n"
}

function main(argc: i32, argv: ptr<ptr<u8>>) -> i32 {
    let mut i: i32 = 1
    let mut tiles: string = "64, 64, 64"
    let mut op: string = "linalg.matmul"
    
    while i < argc {
        let a: string = argv[i] as string
        if ft_starts(a, "--tiles=") {
            tiles = ft_from(a, 8)
        } elif ft_starts(a, "--op=") {
            op = ft_from(a, 5)
        }
        i = i + 1
    }
    ft_outln(transform_of(op, tiles))
    return 0
}
