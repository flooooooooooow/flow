import .text { ft_outln, ft_errln, ft_len, ft_starts, ft_from, ft_byte }

function ft_digit(v: i32) -> bool {
    return v >= 48 and v <= 57
}

function valid_tiles(s: string) -> bool {
    let n: i32 = ft_len(s)
    let mut i: i32 = 0
    let mut values: i32 = 0
    while i < n {
        while i < n and (ft_byte(s, i) == 32 or ft_byte(s, i) == 9) {
            i = i + 1
        }
        if i >= n or values >= 3 {
            return false
        }
        let mut value: i32 = 0
        let mut digits: i32 = 0
        while i < n and ft_digit(ft_byte(s, i)) {
            value = value * 10 + ft_byte(s, i) - 48
            digits = digits + 1
            i = i + 1
        }
        if digits == 0 or value <= 0 or value > 4096 {
            return false
        }
        values = values + 1
        while i < n and (ft_byte(s, i) == 32 or ft_byte(s, i) == 9) {
            i = i + 1
        }
        if i == n {
            return values > 0
        }
        if ft_byte(s, i) != 44 {
            return false
        }
        i = i + 1
    }
    return false
}

function transform_of(op: string, tiles: string) -> string {
    return "module attributes {transform.with_named_sequence} {\n" +
           "  transform.named_sequence @__transform_main(%arg0: !transform.any_op {transform.readonly}) {\n" +
           "    %matmul = transform.structured.match ops[\"" + op + "\"] in %arg0 : (!transform.any_op) -> !transform.any_op\n" +
           "    %tiled_linalg_op, %loops:3 = transform.structured.tile_using_for %matmul [" + tiles + "] : (!transform.any_op) -> (!transform.any_op, !transform.any_op, !transform.any_op, !transform.any_op)\n" +
           "    transform.yield\n" +
           "  }\n" +
           "}\n"
}

function main(argc: i32, argv: ptr<ptr<u8>>) -> i32 {
    let mut i: i32 = 1
    let mut tiles: string = "64, 64, 64"
    let mut op: string = "linalg.matmul"
    
    while i < argc {
        let a: string = argv[i] as string
        if ft_starts(a, "--tiles=") {
            tiles = ft_from(a, 8)
        } elif ft_starts(a, "--op=") {
            op = ft_from(a, 5)
        }
        i = i + 1
    }
    if ft_len(op) == 0 {
        ft_errln("mlir_tune: --op must not be empty")
        return 2
    }
    if not valid_tiles(tiles) {
        ft_errln("mlir_tune: --tiles expects one to three positive integers")
        return 2
    }
    ft_outln(transform_of(op, tiles))
    return 0
}
