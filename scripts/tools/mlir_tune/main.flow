import .text { ft_outln, ft_errln, ft_len, ft_starts, ft_from, ft_byte, ft_eq }

function ft_digit(v: i32) -> bool {
    return v >= 48 and v <= 57
}

function valid_tiles(s: string) -> bool {
    let n: i32 = ft_len(s)
    let mut i: i32 = 0
    let mut values: i32 = 0
    while i < n {
        while i < n and (ft_byte(s, i) == 32 or ft_byte(s, i) == 9) {
            i = i + 1
        }
        if i >= n or values >= 3 {
            return false
        }
        let mut value: i32 = 0
        let mut digits: i32 = 0
        while i < n and ft_digit(ft_byte(s, i)) {
            if value > 409 or (value == 409 and ft_byte(s, i) > 54) {
                return false
            }
            value = value * 10 + ft_byte(s, i) - 48
            digits = digits + 1
            i = i + 1
        }
        if digits == 0 or value <= 0 or value > 4096 {
            return false
        }
        values = values + 1
        while i < n and (ft_byte(s, i) == 32 or ft_byte(s, i) == 9) {
            i = i + 1
        }
        if i == n {
            return values > 0
        }
        if ft_byte(s, i) != 44 {
            return false
        }
        i = i + 1
    }
    return false
}

function valid_target(s: string) -> bool {
    return ft_eq(s, "cpu") or ft_eq(s, "gpu") or
           ft_eq(s, "nvptx") or ft_eq(s, "amdgpu")
}

function valid_strategy(s: string) -> bool {
    return ft_eq(s, "tile") or ft_eq(s, "vector") or
           ft_eq(s, "interchange") or ft_eq(s, "fuse") or
           ft_eq(s, "hierarchical_tile") or ft_eq(s, "hierarchical_vector")
}

function valid_permutation(s: string) -> bool {
    return ft_eq(s, "0,1,2") or ft_eq(s, "0,2,1") or
           ft_eq(s, "1,0,2") or ft_eq(s, "1,2,0") or
           ft_eq(s, "2,0,1") or ft_eq(s, "2,1,0")
}

function transform_of(op: string, fuse_with: string, tiles: string, permutation: string, inner_tiles: string, target: string, strategy: string) -> string {
    let mut action: string = "    %tiled_linalg_op, %loops:3 = transform.structured.tile_using_for %matmul tile_sizes [" + tiles + "] : (!transform.any_op) -> (!transform.any_op, !transform.any_op, !transform.any_op, !transform.any_op)\n"
    if ft_eq(strategy, "vector") {
        action = "    %vectorized = transform.structured.vectorize %matmul vector_sizes [" + tiles + "] : (!transform.any_op) -> !transform.any_op\n"
    } elif ft_eq(strategy, "interchange") {
        action = "    %interchanged = transform.structured.interchange %matmul iterator_interchange = [" + permutation + "] : (!transform.any_op) -> !transform.any_op\n"
    } elif ft_eq(strategy, "fuse") {
        action = "    %producer = transform.structured.match ops{[\"" + fuse_with + "\"]} in %arg0 : (!transform.any_op) -> !transform.any_op\n" +
                 "    %fused = transform.structured.fuse_into_containing_op %producer into %matmul : (!transform.any_op, !transform.any_op) -> !transform.any_op\n"
    } elif ft_eq(strategy, "hierarchical_tile") {
        action = "    %outer, %outer_loops:3 = transform.structured.tile_using_for %matmul tile_sizes [" + tiles + "] : (!transform.any_op) -> (!transform.any_op, !transform.any_op, !transform.any_op, !transform.any_op)\n" +
                 "    %inner, %inner_loops:3 = transform.structured.tile_using_for %outer tile_sizes [" + inner_tiles + "] : (!transform.any_op) -> (!transform.any_op, !transform.any_op, !transform.any_op, !transform.any_op)\n"
    } elif ft_eq(strategy, "hierarchical_vector") {
        action = "    %outer, %outer_loops:3 = transform.structured.tile_using_for %matmul tile_sizes [" + tiles + "] : (!transform.any_op) -> (!transform.any_op, !transform.any_op, !transform.any_op, !transform.any_op)\n" +
                 "    %vectorized = transform.structured.vectorize %outer vector_sizes [" + inner_tiles + "] : (!transform.any_op) -> !transform.any_op\n"
    }
    return "module attributes {transform.with_named_sequence, flow.tune_target = \"" + target + "\", flow.tune_strategy = \"" + strategy + "\"} {\n" +
           "  transform.named_sequence @__transform_main(%arg0: !transform.any_op {transform.readonly}) {\n" +
           "    %matmul = transform.structured.match ops{[\"" + op + "\"]} in %arg0 : (!transform.any_op) -> !transform.any_op\n" +
           action +
           "    transform.yield\n" +
           "  }\n" +
           "}\n"
}

function main(argc: i32, argv: ptr<ptr<u8>>) -> i32 {
    let mut i: i32 = 1
    let mut tiles: string = "64, 64, 64"
    let mut op: string = "linalg.matmul"
    let mut target: string = "cpu"
    let mut strategy: string = "tile"
    let mut permutation: string = "0,1,2"
    let mut fuse_with: string = "linalg.generic"
    let mut inner_tiles: string = "8,8,8"
    
    while i < argc {
        let a: string = argv[i] as string
        if ft_starts(a, "--tiles=") {
            tiles = ft_from(a, 8)
        } elif ft_eq(a, "--tiles") {
            ft_errln("mlir_tune: --tiles requires a value")
            return 2
        } elif ft_starts(a, "--op=") {
            op = ft_from(a, 5)
        } elif ft_eq(a, "--op") {
            ft_errln("mlir_tune: --op requires a value")
            return 2
        } elif ft_starts(a, "--target=") {
            target = ft_from(a, 9)
        } elif ft_eq(a, "--target") {
            ft_errln("mlir_tune: --target requires a value")
            return 2
        } elif ft_starts(a, "--strategy=") {
            strategy = ft_from(a, 11)
        } elif ft_eq(a, "--strategy") {
            ft_errln("mlir_tune: --strategy requires a value")
            return 2
        } elif ft_starts(a, "--permutation=") {
            permutation = ft_from(a, 14)
        } elif ft_eq(a, "--permutation") {
            ft_errln("mlir_tune: --permutation requires a value")
            return 2
        } elif ft_starts(a, "--fuse-with=") {
            fuse_with = ft_from(a, 12)
        } elif ft_eq(a, "--fuse-with") {
            ft_errln("mlir_tune: --fuse-with requires a value")
            return 2
        } elif ft_starts(a, "--inner-tiles=") {
            inner_tiles = ft_from(a, 14)
        } elif ft_eq(a, "--inner-tiles") {
            ft_errln("mlir_tune: --inner-tiles requires a value")
            return 2
        }
        i = i + 1
    }
    if ft_len(op) == 0 {
        ft_errln("mlir_tune: --op must not be empty")
        return 2
    }
    if not valid_tiles(tiles) {
        ft_errln("mlir_tune: --tiles expects one to three positive integers")
        return 2
    }
    if not valid_tiles(inner_tiles) {
        ft_errln("mlir_tune: --inner-tiles expects one to three positive integers")
        return 2
    }
    if not valid_target(target) {
        ft_errln("mlir_tune: --target must be one of 'cpu', 'gpu', 'nvptx', 'amdgpu'")
        return 2
    }
    if not valid_strategy(strategy) {
        ft_errln("mlir_tune: --strategy must be one of 'tile', 'vector', 'interchange', 'fuse', 'hierarchical_tile', 'hierarchical_vector'")
        return 2
    }
    if ft_eq(strategy, "interchange") and not valid_permutation(permutation) {
        ft_errln("mlir_tune: --permutation must be a permutation of 0,1,2")
        return 2
    }
    if ft_eq(strategy, "fuse") and ft_len(fuse_with) == 0 {
        ft_errln("mlir_tune: --fuse-with must not be empty")
        return 2
    }
    ft_outln(transform_of(op, fuse_with, tiles, permutation, inner_tiles, target, strategy))
    return 0
}
