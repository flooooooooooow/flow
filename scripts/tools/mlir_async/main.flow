import .text { at_outln, at_errln, at_starts, at_from, at_itoa, at_eq }

function target_id(s: string) -> i32 {
    if at_eq(s, "gpu") { return 1 }
    if at_eq(s, "nvptx") { return 2 }
    if at_eq(s, "amdgpu") { return 3 }
    return -1
}

function async_engine(s: string) -> string {
    if at_eq(s, "gpu") { return "gpu.async" }
    if at_eq(s, "amdgpu") { return "amdgpu.async" }
    return "nvgpu.device_async_copy"
}

function async_module(stages: i32, buffers: i32, op: string, target: string) -> string {
    let mut out: string = "module attributes {flow.async_buffers = " + at_itoa(buffers) + ", flow.async_target = \"" + target + "\", flow.async_copy_engine = \"" + async_engine(target) + "\"} {\n"
    out = out + "  func.func @flow_async_pipeline() -> !async.token {\n"
    let mut i: i32 = 0
    let mut previous: string = ""
    while i < stages {
        let name: string = "%stage" + at_itoa(i)
        if i == 0 {
            out = out + "    " + name + " = async.execute {\n"
        } else {
            out = out + "    " + name + " = async.execute [" + previous + "] {\n"
        }
        out = out + "      // async.copy stage " + at_itoa(i) + " for " + op + "\n"
        out = out + "      async.yield\n"
        out = out + "    } : !async.token\n"
        previous = name
        i = i + 1
    }
    out = out + "    func.return " + previous + " : !async.token\n  }\n}\n"
    return out
}

function nvgpu_module(stages: i32, buffers: i32, op: string) -> string {
    let mut out: string = "module attributes {flow.async_buffers = " + at_itoa(buffers) + ", flow.async_target = \"nvptx\", flow.async_copy_engine = \"nvgpu.device_async_copy\"} {\n"
    out = out + "  func.func @flow_async_pipeline() -> !nvgpu.device.async.token {\n"
    out = out + "    %c0 = arith.constant 0 : index\n"
    let mut i: i32 = 0
    while i < stages {
        out = out + "    // async.copy stage " + at_itoa(i) + " for " + op + "\n"
        out = out + "    %src" + at_itoa(i) + " = memref.alloc() : memref<16xf32>\n"
        out = out + "    %dst" + at_itoa(i) + " = memref.alloc() : memref<16xf32, 3>\n"
        out = out + "    %copy" + at_itoa(i) + " = nvgpu.device_async_copy %src" + at_itoa(i) + "[%c0], %dst" + at_itoa(i) + "[%c0], 16 : memref<16xf32> to memref<16xf32, 3>\n"
        out = out + "    %group" + at_itoa(i) + " = nvgpu.device_async_create_group %copy" + at_itoa(i) + "\n"
        i = i + 1
    }
    i = 0
    while i < stages {
        out = out + "    nvgpu.device_async_wait %group" + at_itoa(i) + "\n"
        i = i + 1
    }
    out = out + "    func.return %group" + at_itoa(stages - 1) + " : !nvgpu.device.async.token\n  }\n}\n"
    return out
}

function main(argc: i32, argv: ptr<ptr<u8>>) -> i32 {
    let mut stages: i32 = 2
    let mut buffers: i32 = 2
    let mut op: string = "linalg.matmul"
    let mut target: string = ""
    let mut i: i32 = 1
    while i < argc {
        let arg: string = argv[i] as string
        if at_starts(arg, "--stages=") {
            stages = atoi(at_from(arg, 9))
        } elif at_starts(arg, "--buffers=") {
            buffers = atoi(at_from(arg, 10))
        } elif at_starts(arg, "--op=") {
            op = at_from(arg, 5)
        } elif at_starts(arg, "--target=") {
            target = at_from(arg, 9)
        }
        i = i + 1
    }
    if stages < 1 or stages > 32 or buffers < 2 or buffers > 16 {
        at_errln("mlir_async: stages must be 1..32 and buffers must be 2..16")
        return 2
    }
    if target_id(target) < 0 {
        at_errln("mlir_async: --target is required and must be one of 'gpu', 'nvptx', 'amdgpu'")
        return 2
    }
    if at_eq(target, "nvptx") {
        at_outln(nvgpu_module(stages, buffers, op))
    } else {
        at_outln(async_module(stages, buffers, op, target))
    }
    return 0
}
