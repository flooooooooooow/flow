# Resolve the discovery map's backtick path references against tracked files.
# The report records source evidence and keeps support status unverified.
#
# ./flow tool feature_evidence                  flow.feature-evidence.v1 JSON
# ./flow tool feature_evidence --roles          ROLE/BACKEND/GAP TSV rows
# ./flow tool feature_evidence --check          exit 1 on any role gap
# ./flow tool feature_evidence --map PATH       read an alternate map
#
# A resolved path proves only that an anchor exists. Role rows say which of
# the map's own columns an anchor came from; they do not claim the feature
# works, that a backend is exercised, or that a family is adoption-eligible.
import .text { ft_outln, ft_errln, ft_eq, ft_out, ft_itoa, ft_read_file, ft_exists, ft_len, ft_byte, ft_slice, ft_find, ft_ends, ft_starts, ft_basename, ft_split_lines, ft_list_new, ft_list_push, ft_list_len, ft_list_get, ft_list_has, ft_list_sort, StrList }
import .repo { rp_enter_root, rp_git_ls, rp_capture, rp_argv2, rp_status }
import .json { json_quote }

const MAP: string = "docs/project/idiom-modernization/FEATURE-SURFACES.md"

# The map's columns after the family name, in order.
const ROLE_IMPLEMENTATION: i32 = 0
const ROLE_SEMANTICS: i32 = 1
const ROLE_TEACHING: i32 = 2
const ROLE_COUNT: i32 = 3

function trim(s: string) -> string {
    let mut a: i32 = 0
    let mut b: i32 = ft_len(s)
    while a < b and (ft_byte(s, a) == 32 or ft_byte(s, a) == 9 or ft_byte(s, a) == 10 or ft_byte(s, a) == 13) { a = a + 1 }
    while b > a and (ft_byte(s, b - 1) == 32 or ft_byte(s, b - 1) == 9 or ft_byte(s, b - 1) == 10 or ft_byte(s, b - 1) == 13) { b = b - 1 }
    return ft_slice(s, a, b)
}

function is_table_row(s: string) -> bool {
    return ft_len(s) > 0 and ft_byte(s, 0) == 124
}

function cells(row: string) -> ptr<StrList> {
    let out: ptr<StrList> = ft_list_new()
    let mut start: i32 = 1
    let mut i: i32 = 1
    while i < ft_len(row) {
        if ft_byte(row, i) == 124 {
            ft_list_push(out, trim(ft_slice(row, start, i)))
            start = i + 1
        }
        i = i + 1
    }
    return out
}

function add_refs(cell: string, refs: ptr<StrList>) {
    let mut i: i32 = 0
    while i < ft_len(cell) {
        if ft_byte(cell, i) == 96 {
            let start: i32 = i + 1
            let mut end: i32 = start
            while end < ft_len(cell) and ft_byte(cell, end) != 96 { end = end + 1 }
            if end < ft_len(cell) {
                let raw: string = trim(ft_slice(cell, start, end))
                # Cells may name several files in one code span.
                let mut p: i32 = 0
                let mut q: i32 = 0
                while q <= ft_len(raw) {
                    if q == ft_len(raw) or ft_byte(raw, q) == 32 or ft_byte(raw, q) == 44 {
                        if q > p {
                            let path: string = trim(ft_slice(raw, p, q))
                            if ft_len(path) > 0 and not ft_list_has(refs, path) { ft_list_push(refs, path) }
                        }
                        p = q + 1
                    }
                    q = q + 1
                }
                i = end
            }
        }
        i = i + 1
    }
}

function resolved(path: string, tracked: ptr<StrList>) -> string {
    if ft_list_has(tracked, path) { return path }
    # A reference ending in "/" names a directory prefix. Report the prefix
    # itself, never an arbitrary member file, or one file would appear to
    # speak for the whole directory.
    if ft_ends(path, "/") {
        let mut d: i32 = 0
        while d < ft_list_len(tracked) {
            if ft_starts(ft_list_get(tracked, d), path) { return path }
            d = d + 1
        }
        return ""
    }
    let star: i32 = ft_find(path, "*", 0)
    let mut prefix: string = path
    let mut suffix: string = ""
    if star >= 0 {
        prefix = ft_slice(path, 0, star)
        suffix = ft_slice(path, star + 1, ft_len(path))
    }
    let mut i: i32 = 0
    while i < ft_list_len(tracked) {
        let candidate: string = ft_list_get(tracked, i)
        if ft_ends(candidate, "/" + path) { return candidate }
        if star >= 0 and ft_starts(candidate, prefix) and ft_ends(candidate, suffix) { return candidate }
        if star >= 0 and ft_find(prefix, "/", 0) < 0 and ft_starts(ft_basename(candidate), prefix) and ft_ends(candidate, suffix) { return candidate }
        i = i + 1
    }
    return ""
}

function emit_refs(refs: ptr<StrList>, tracked: ptr<StrList>, missing: bool) -> string {
    let out: ptr<StrList> = ft_list_new()
    let mut i: i32 = 0
    while i < ft_list_len(refs) {
        let p: string = ft_list_get(refs, i)
        let found: string = resolved(p, tracked)
        if (missing and ft_len(found) == 0) or (not missing and ft_len(found) > 0) { ft_list_push(out, p) }
        i = i + 1
    }
    ft_list_sort(out)
    let mut s: string = "["
    i = 0
    while i < ft_list_len(out) {
        if i > 0 { s = s + "," }
        s = s + json_quote(ft_list_get(out, i))
        i = i + 1
    }
    return s + "]"
}

# ---------------------------------------------------------------------------
# role coverage
# ---------------------------------------------------------------------------

function role_name(r: i32) -> string {
    if r == ROLE_IMPLEMENTATION { return "implementation" }
    if r == ROLE_SEMANTICS { return "semantics_or_negative" }
    return "teaching"
}

# Tracked paths an anchor cell resolves to, deduplicated.
function cell_paths(cell: string, tracked: ptr<StrList>, out: ptr<StrList>) {
    let refs: ptr<StrList> = ft_list_new()
    add_refs(cell, refs)
    let mut i: i32 = 0
    while i < ft_list_len(refs) {
        let found: string = resolved(ft_list_get(refs, i), tracked)
        if ft_len(found) > 0 and not ft_list_has(out, found) { ft_list_push(out, found) }
        i = i + 1
    }
}

# Which independent backend an implementation anchor belongs to, or "" when
# the path is not a backend emitter. Most specific name first.
function backend_of(path: string) -> string {
    if ft_find(path, "gpu", 0) >= 0 or ft_find(path, "shader", 0) >= 0 { return "gpu" }
    if ft_find(path, "wasm", 0) >= 0 { return "wasm" }
    if ft_find(path, "mlir", 0) >= 0 { return "mlir" }
    if ft_find(path, "cgen", 0) >= 0 { return "c" }
    return ""
}

# Print one family's ROLE rows, BACKEND rows and GAP rows. Returns the number
# of roles that resolved to no tracked anchor.
function role_rows(name: string, cs: ptr<StrList>, tracked: ptr<StrList>) -> i32 {
    let mut gaps: i32 = 0
    let targets: ptr<StrList> = ft_list_new()
    let mut r: i32 = 0
    while r < ROLE_COUNT {
        let paths: ptr<StrList> = ft_list_new()
        cell_paths(ft_list_get(cs, r + 1), tracked, paths)
        ft_list_sort(paths)
        if ft_list_len(paths) == 0 {
            ft_outln("GAP\t" + name + "\t" + role_name(r))
            gaps = gaps + 1
        }
        let mut i: i32 = 0
        while i < ft_list_len(paths) {
            let path: string = ft_list_get(paths, i)
            ft_outln("ROLE\t" + name + "\t" + role_name(r) + "\t" + path)
            if r == ROLE_IMPLEMENTATION {
                let target: string = backend_of(path)
                if ft_len(target) > 0 and not ft_list_has(targets, target) {
                    ft_list_push(targets, target)
                    ft_outln("BACKEND\t" + name + "\t" + target)
                }
            }
            i = i + 1
        }
        r = r + 1
    }
    return gaps
}

# Every table row of the map, as the role report sees it.
function role_report(text: string, tracked: ptr<StrList>) -> i32 {
    let lines: ptr<StrList> = ft_split_lines(text)
    let mut families: i32 = 0
    let mut gaps: i32 = 0
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let row: string = ft_list_get(lines, i)
        if is_table_row(row) {
            let cs: ptr<StrList> = cells(row)
            if ft_list_len(cs) == 4 {
                let name: string = ft_list_get(cs, 0)
                if name != "Feature family" and ft_len(name) > 0 and ft_byte(name, 0) != 45 {
                    gaps = gaps + role_rows(name, cs, tracked)
                    families = families + 1
                }
            }
        }
        i = i + 1
    }
    if families == 0 {
        ft_errln("feature_evidence: no feature rows found")
        return -1
    }
    if gaps > 0 {
        ft_errln("feature_evidence: " + ft_itoa(gaps) + " unresolved roles across " + ft_itoa(families) + " families")
    }
    return gaps
}

function usage() {
    ft_outln("usage: ./flow tool feature_evidence [--roles | --check] [--map PATH]")
}

function main(argc: i32, argv: ptr<string>) -> i32 {
    let mut roles: bool = false
    let mut check: bool = false
    let mut map: string = MAP
    let mut a: i32 = 1
    while a < argc {
        if ft_eq(argv[a], "--roles") {
            roles = true
        } elif ft_eq(argv[a], "--check") {
            check = true
        } elif ft_eq(argv[a], "--map") {
            if a + 1 >= argc { usage(); return 2 }
            map = argv[a + 1]
            a = a + 1
        } elif ft_eq(argv[a], "--help") or ft_eq(argv[a], "-h") {
            usage()
            return 0
        } else {
            ft_errln("unknown option: " + argv[a])
            return 2
        }
        a = a + 1
    }
    if rp_enter_root() == false { ft_errln("feature_evidence: cannot enter repository root"); return 1 }
    if not ft_exists(map) { ft_errln("feature_evidence: cannot read " + map); return 1 }
    let text: string = ft_read_file(map)
    if ft_len(text) == 0 { ft_errln("feature_evidence: cannot read " + map); return 1 }
    let tracked: ptr<StrList> = rp_git_ls(ft_list_new())
    if tracked as ptr<u8> == null { ft_errln("feature_evidence: git ls-files failed"); return 1 }
    if roles or check {
        let gaps: i32 = role_report(text, tracked)
        if gaps < 0 { return 1 }
        if check and gaps > 0 { return 1 }
        return 0
    }
    let lines: ptr<StrList> = ft_split_lines(text)
    let rev_args: ptr<StrList> = ft_list_new()
    ft_list_push(rev_args, "git")
    ft_list_push(rev_args, "rev-parse")
    ft_list_push(rev_args, "HEAD")
    let revision: string = trim(rp_capture(rev_args))
    if rp_status() != 0 { ft_errln("feature_evidence: cannot read git revision"); return 1 }
    let status_args: ptr<StrList> = ft_list_new()
    ft_list_push(status_args, "git")
    ft_list_push(status_args, "status")
    ft_list_push(status_args, "--porcelain")
    let worktree: string = rp_capture(status_args)
    if rp_status() != 0 { ft_errln("feature_evidence: cannot read worktree status"); return 1 }
    let mut clean: string = "false"
    if ft_len(trim(worktree)) == 0 { clean = "true" }
    ft_outln("{\"schema\":\"flow.feature-evidence.v1\",\"revision\":" + json_quote(revision) + ",\"worktree_clean\":" + clean + ",\"source\":" + json_quote(map) + ",\"support_status\":\"unverified\",\"features\":[")
    let mut emitted: i32 = 0
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let row: string = ft_list_get(lines, i)
        if is_table_row(row) {
            let cs: ptr<StrList> = cells(row)
            if ft_list_len(cs) == 4 {
                let name: string = ft_list_get(cs, 0)
                if name != "Feature family" and ft_len(name) > 0 and ft_byte(name, 0) != 45 {
                    let refs: ptr<StrList> = ft_list_new()
                    add_refs(ft_list_get(cs, 1), refs)
                    add_refs(ft_list_get(cs, 2), refs)
                    add_refs(ft_list_get(cs, 3), refs)
                    if emitted > 0 { ft_outln(",") }
                    ft_out("{\"family\":" + json_quote(name) + ",\"references\":[")
                    let mut j: i32 = 0
                    while j < ft_list_len(refs) {
                        if j > 0 { ft_out(",") }
                        let p: string = ft_list_get(refs, j)
                        let found: string = resolved(p, tracked)
                        ft_out("{\"path\":" + json_quote(p) + ",\"resolved_path\":" + (if ft_len(found) > 0 { json_quote(found) } else { "null" }) + ",\"tracked\":" + (if ft_len(found) > 0 { "true" } else { "false" }) + "}")
                        j = j + 1
                    }
                    ft_out("],\"missing_references\":" + emit_refs(refs, tracked, true) + ",\"implementation_status\":\"unverified\"}")
                    emitted = emitted + 1
                }
            }
        }
        i = i + 1
    }
    ft_outln("]}")
    if emitted == 0 { ft_errln("feature_evidence: no feature rows found"); return 1 }
    return 0
}
