# Cross-dimensional benchmark harness: runs the workloads under
# benchmarks/cross_harness in Flow, their CPython twins under
# benchmarks/baselines/python/cross_harness when python3 is available, and
# their native C twins under benchmarks/baselines/native/cross_harness. It
# writes one JSON file of timings and can compare it with an earlier one.
#
# Memory-suite commands run with FLOW_MEM_PROFILE=1 and
# FLOW_MEM_PROFILE_OUT pointing at a temp file so the #740 runtime
# profiler can fill allocations, heap_bytes, peak_live_heap, temp_bytes,
# copies and peak RSS without rewriting the workload sources. Runtime
# rows leave the profiler off so flow_vs_native is not the wrapper tax.
#
# Run it as `./flow tool bench_harness`, which passes the repository root
# in FLOW_REPO_ROOT.
#
#   flow tool bench_harness [--smoke] [--baseline OLD.json] [--out OUT.json] [--cleanup]
#
# --smoke runs 3 repetitions instead of 10. --baseline compares every
# workload's Flow median with the same workload in OLD.json and exits 1 on a
# regression. --cleanup removes build/benchmarks after the run.
#
# Test modes, one pure function each:
#
#   --percentile P X...          linear-interpolated percentile of X
#   --eval-regression OLD NEW    regression status of two workload objects
#   --eval-tax FILE              flow_vs_native status of each row (ok/tax/no_native)
#   --check-runtime-natives      exit 1 if a runtime workload has no native .c twin
#   --system-info                the "system" object as JSON
#   --now-us                     wall clock in microseconds (for the standardized bench)
#
# Regression policy: an OS or CPU change skips the comparison
# (skipped_env_mismatch), so does a workload whose runs failed
# (skipped_unresolved_correctness). A missing median gives no_data. Faster or
# equal is pass, up to 5% slower is pass_within_margin, beyond that is
# regression.

import .text { ft_out, ft_outln, ft_errln, ft_eq, ft_len, ft_read_file, ft_write_file, ft_exists, ft_starts, ft_ends, ft_slice, ft_from, ft_join, ft_split_lines, ft_list_new, ft_list_push, ft_list_len, ft_list_get, StrList }
import .json { json_parse, json_error, json_get, json_str, json_kind, json_first, json_next, json_quote, json_kind_object, json_kind_number, json_kind_string, json_kind_array, json_kind_null, Json }
import .proc { pr_quote, pr_run, pr_capture, pr_chomp, pr_mkdir_p, pr_is_dir, pr_resolve }
import .bench { bn_fixed, bn_py_repr, bn_median, bn_min, bn_run, bn_code, bn_out, bn_wall, bn_parse_float, bn_strip, BenchRun }

extern {
    function malloc(size: i64) -> ptr<void>
    function getenv(name: string) -> string
    function setenv(name: string, value: string, overwrite: i32) -> i32
    function chdir(path: string) -> i32
    function clock_gettime(clk: i32, ts: ptr<i64>) -> i32
    function localtime_r(t: ptr<i64>, tm: ptr<u8>) -> ptr<u8>
    function strftime(buf: ptr<u8>, n: i64, fmt: string, tm: ptr<u8>) -> i64
    function atoi(s: string) -> i32
}

const TIME_NONE: i32 = 0
const TIME_GNU: i32 = 1
const TIME_BSD: i32 = 2

function root() -> string {
    let r: string = getenv("FLOW_REPO_ROOT")
    if r as ptr<u8> == null or ft_len(r) == 0 {
        return "."
    }
    return r
}

function usage() -> string {
    return "usage: flow tool bench_harness [-h] [--smoke] [--baseline BASELINE] [--out OUT] [--cleanup]\n       flow tool bench_harness --check-runtime-natives\n       flow tool bench_harness --eval-tax FILE"
}

# ---------------------------------------------------------------------------
# Pure functions
# ---------------------------------------------------------------------------

function sorted_copy(xs: ptr<f64>, n: i32) -> ptr<f64> {
    let s: ptr<f64> = malloc(((n + 1) as i64) * 8) as ptr<f64>
    let mut i: i32 = 0
    while i < n {
        s[i] = xs[i]
        i = i + 1
    }
    i = 1
    while i < n {
        let v: f64 = s[i]
        let mut j: i32 = i - 1
        while j >= 0 and s[j] > v {
            s[j + 1] = s[j]
            j = j - 1
        }
        s[j + 1] = v
        i = i + 1
    }
    return s
}

# Linear interpolation between the two closest ranks, as numpy's default.
function percentile(xs: ptr<f64>, n: i32, p: f64) -> f64 {
    if n == 0 {
        return 0.0
    }
    let s: ptr<f64> = sorted_copy(xs, n)
    let k: f64 = ((n - 1) as f64) * p
    let f: i32 = k as i32
    let mut c: i32 = f + 1
    if c > n - 1 {
        c = n - 1
    }
    if f == c {
        return s[f]
    }
    return s[f] * ((c as f64) - k) + s[c] * (k - (f as f64))
}

function sqrt_f(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0
    }
    let mut g: f64 = x
    if g < 1.0 {
        g = 1.0
    }
    let mut i: i32 = 0
    while i < 200 {
        let next: f64 = 0.5 * (g + x / g)
        if next == g {
            break
        }
        g = next
        i = i + 1
    }
    return g
}

# statistics.stdev: sample standard deviation.
function stdev(xs: ptr<f64>, n: i32) -> f64 {
    if n < 2 {
        return 0.0
    }
    let mut sum: f64 = 0.0
    let mut i: i32 = 0
    while i < n {
        sum = sum + xs[i]
        i = i + 1
    }
    let mean: f64 = sum / (n as f64)
    let mut ss: f64 = 0.0
    i = 0
    while i < n {
        let d: f64 = xs[i] - mean
        ss = ss + d * d
        i = i + 1
    }
    return sqrt_f(ss / ((n - 1) as f64))
}

# The regression policy on plain values. A median of 0 means none recorded.
function regression_status(old_os: string, old_cpu: string, new_os: string, new_cpu: string, new_parity: string, old_median: f64, new_median: f64) -> string {
    if ft_eq(old_os, new_os) == false or ft_eq(old_cpu, new_cpu) == false {
        return "skipped_env_mismatch"
    }
    if ft_eq(new_parity, "verified") == false {
        return "skipped_unresolved_correctness"
    }
    if new_median == 0.0 or old_median == 0.0 {
        return "no_data"
    }
    if new_median <= old_median {
        return "pass"
    }
    let margin: f64 = old_median * 0.05
    if new_median - old_median <= margin {
        return "pass_within_margin"
    }
    return "regression"
}

# ---------------------------------------------------------------------------
# JSON access
# ---------------------------------------------------------------------------

function member_str(j: ptr<Json>, id: i32, name: string) -> string {
    let m: i32 = json_get(j, id, name)
    if m < 0 {
        return ""
    }
    if json_kind(j, m) == json_kind_string() or json_kind(j, m) == json_kind_number() {
        return json_str(j, m)
    }
    return ""
}

# flow_metrics.median as written, or null when absent.
function median_text(j: ptr<Json>, id: i32) -> string {
    let fm: i32 = json_get(j, id, "flow_metrics")
    let m: i32 = json_get(j, fm, "median")
    if m < 0 or json_kind(j, m) != json_kind_number() {
        return null as string
    }
    return json_str(j, m)
}

function median_of_node(j: ptr<Json>, id: i32) -> f64 {
    let t: string = median_text(j, id)
    if t as ptr<u8> == null {
        return 0.0
    }
    return bn_parse_float(t)
}

function evaluate_nodes(oj: ptr<Json>, oid: i32, nj: ptr<Json>, nid: i32) -> string {
    return regression_status(member_str(oj, oid, "os"), member_str(oj, oid, "cpu"),
        member_str(nj, nid, "os"), member_str(nj, nid, "cpu"),
        member_str(nj, nid, "semantic_parity_status"),
        median_of_node(oj, oid), median_of_node(nj, nid))
}

function load_json(path: string) -> ptr<Json> {
    let text: string = ft_read_file(path)
    if text as ptr<u8> == null {
        ft_errln("run_benchmarks: cannot read " + path)
        return null
    }
    let j: ptr<Json> = json_parse(text)
    if ft_len(json_error(j)) > 0 {
        ft_errln("run_benchmarks: " + path + ": " + json_error(j))
        return null
    }
    return j
}

# ---------------------------------------------------------------------------
# System information
# ---------------------------------------------------------------------------

function capture_or(cmd: string, fallback: string) -> string {
    let s: string = bn_strip(pr_capture(cmd + " 2>/dev/null"))
    if ft_len(s) == 0 {
        return fallback
    }
    return s
}

function flow_version() -> string {
    let text: string = ft_read_file(ft_join(root(), "VERSION"))
    if text as ptr<u8> == null {
        return "unknown"
    }
    let v: string = bn_strip(text)
    if ft_len(v) == 0 {
        return "unknown"
    }
    return v
}

# python3 that runs. A stub that exits non-zero counts as absent.
function python_available() -> bool {
    return pr_run("python3 --version >/dev/null 2>&1") == 0
}

function python_version() -> string {
    if python_available() == false {
        return "unknown"
    }
    let v: string = capture_or("python3 --version 2>&1", "unknown")
    if ft_starts(v, "Python ") {
        return ft_from(v, 7)
    }
    return v
}

# platform.processor(), falling back to the machine name.
function cpu_name() -> string {
    let p: string = capture_or("uname -p", "")
    if ft_len(p) == 0 or ft_eq(p, "unknown") {
        return capture_or("uname -m", "unknown")
    }
    return p
}

function git_sha() -> string {
    return capture_or("cd " + pr_quote(root()) + " && git rev-parse HEAD", "unknown")
}

function threads() -> string {
    let t: string = capture_or("getconf _NPROCESSORS_ONLN", "")
    if ft_len(t) == 0 {
        return "null"
    }
    return t
}

struct SysInfo {
    os: string
    cpu: string
    arch: string
    git_sha: string
    python_version: string
    flow_version: string
    threads: string
}

function system_info() -> ptr<SysInfo> {
    let s: ptr<SysInfo> = malloc(64) as ptr<SysInfo>
    s[0].os = capture_or("uname -s", "unknown")
    s[0].cpu = cpu_name()
    s[0].arch = capture_or("uname -m", "unknown")
    s[0].git_sha = git_sha()
    s[0].python_version = python_version()
    s[0].flow_version = flow_version()
    s[0].threads = threads()
    return s
}

function system_json(s: ptr<SysInfo>, ind: string) -> string {
    let mut o: string = "{\n"
    o = o + ind + "  \"os\": " + json_quote(s[0].os) + ",\n"
    o = o + ind + "  \"cpu\": " + json_quote(s[0].cpu) + ",\n"
    o = o + ind + "  \"arch\": " + json_quote(s[0].arch) + ",\n"
    o = o + ind + "  \"git_sha\": " + json_quote(s[0].git_sha) + ",\n"
    o = o + ind + "  \"python_version\": " + json_quote(s[0].python_version) + ",\n"
    o = o + ind + "  \"flow_version\": " + json_quote(s[0].flow_version) + ",\n"
    o = o + ind + "  \"threads\": " + s[0].threads + "\n"
    return o + ind + "}"
}

# Wall clock in whole microseconds since the epoch, for shell timing.
function now_us() -> string {
    let ts: ptr<i64> = malloc(16) as ptr<i64>
    let _c: i32 = clock_gettime(0, ts)
    let us: i64 = ts[0] * 1000000 + ts[1] / 1000
    return bn_fixed(us as f64, 0)
}

# datetime.now().isoformat(): local time with microseconds.
function iso_now() -> string {
    let ts: ptr<i64> = malloc(16) as ptr<i64>
    let _c: i32 = clock_gettime(0, ts)
    let tm: ptr<u8> = malloc(128) as ptr<u8>
    let _l: ptr<u8> = localtime_r(ts, tm)
    let buf: ptr<u8> = malloc(64) as ptr<u8>
    let _n: i64 = strftime(buf, 64, "%Y-%m-%dT%H:%M:%S", tm)
    let usec: i64 = ts[1] / 1000
    if usec == 0 {
        return buf as string
    }
    let mut us: string = bn_fixed(usec as f64, 0)
    while ft_len(us) < 6 {
        us = "0" + us
    }
    return (buf as string) + "." + us
}

# ---------------------------------------------------------------------------
# Running workloads
# ---------------------------------------------------------------------------

# Which /usr/bin/time can report peak RSS: GNU (-v, kilobytes) or BSD (-l,
# bytes).
function time_flavour() -> i32 {
    if ft_exists("/usr/bin/time") == false {
        return TIME_NONE
    }
    if pr_run("/usr/bin/time -v true >/dev/null 2>&1") == 0 {
        return TIME_GNU
    }
    if pr_run("/usr/bin/time -l true >/dev/null 2>&1") == 0 {
        return TIME_BSD
    }
    return TIME_NONE
}

function digits_prefix(s: string) -> string {
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    while p[i] >= 48 and p[i] <= 57 {
        i = i + 1
    }
    return ft_slice(s, 0, i)
}

# Peak RSS in kilobytes from a /usr/bin/time report, 0 when absent.
function peak_rss_kb(report: string, flavour: i32) -> f64 {
    if report as ptr<u8> == null {
        return 0.0
    }
    let lines: ptr<StrList> = ft_split_lines(report)
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let line: string = bn_strip(ft_list_get(lines, i))
        if flavour == TIME_GNU and ft_starts(line, "Maximum resident set size") {
            let colon: i32 = ft_len(line)
            let mut k: i32 = 0
            let p: ptr<u8> = line as ptr<u8>
            while k < colon and p[k] != 58 {
                k = k + 1
            }
            let v: string = digits_prefix(bn_strip(ft_from(line, k + 1)))
            if ft_len(v) == 0 {
                return 0.0
            }
            return bn_parse_float(v)
        }
        if flavour == TIME_BSD and ft_ends(line, "maximum resident set size") {
            let v2: string = digits_prefix(line)
            if ft_len(v2) == 0 {
                return 0.0
            }
            return ((bn_parse_float(v2) / 1024.0) as i64) as f64
        }
        i = i + 1
    }
    return 0.0
}

# The integer after "name:" on a line of the program's stdout, as the
# workloads report allocations and copies.
function counter(out: string, name: string) -> f64 {
    let lines: ptr<StrList> = ft_split_lines(out)
    let mut v: f64 = 0.0
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let line: string = ft_list_get(lines, i)
        if ft_starts(line, name + ":") {
            let t: string = bn_strip(ft_from(line, ft_len(name) + 1))
            let d: string = digits_prefix(t)
            if ft_len(d) > 0 and ft_len(d) == ft_len(t) {
                v = bn_parse_float(d)
            }
        }
        i = i + 1
    }
    return v
}

struct Metrics {
    times: ptr<f64>
    rss: ptr<f64>
    allocs: ptr<f64>
    copies: ptr<f64>
    heap_bytes: ptr<f64>
    peak_live: ptr<f64>
    temp_bytes: ptr<f64>
    n: i32
    failed: bool
}

function run_in(cwd: string, argv: ptr<StrList>) -> ptr<BenchRun> {
    let here: string = pr_resolve(".")
    let _c: i32 = chdir(cwd)
    let r: ptr<BenchRun> = bn_run(argv)
    let _b: i32 = chdir(here)
    return r
}

function measure(cmd: ptr<StrList>, repeats: i32, memory: bool, flavour: i32, cwd: string) -> ptr<Metrics> {
    let m: ptr<Metrics> = malloc(128) as ptr<Metrics>
    m[0].times = malloc(((repeats + 1) as i64) * 8) as ptr<f64>
    m[0].rss = malloc(((repeats + 1) as i64) * 8) as ptr<f64>
    m[0].allocs = malloc(((repeats + 1) as i64) * 8) as ptr<f64>
    m[0].copies = malloc(((repeats + 1) as i64) * 8) as ptr<f64>
    m[0].heap_bytes = malloc(((repeats + 1) as i64) * 8) as ptr<f64>
    m[0].peak_live = malloc(((repeats + 1) as i64) * 8) as ptr<f64>
    m[0].temp_bytes = malloc(((repeats + 1) as i64) * 8) as ptr<f64>
    m[0].n = repeats
    m[0].failed = false
    let report: string = ft_join(root(), "build/benchmarks/time_out.txt")
    let mem_out: string = ft_join(root(), "build/benchmarks/mem_profile.txt")
    let full: ptr<StrList> = ft_list_new()
    if memory and flavour != TIME_NONE {
        ft_list_push(full, "/usr/bin/time")
        if flavour == TIME_GNU {
            ft_list_push(full, "-v")
        } else {
            ft_list_push(full, "-l")
        }
        ft_list_push(full, "-o")
        ft_list_push(full, report)
    }
    let mut a: i32 = 0
    while a < ft_list_len(cmd) {
        ft_list_push(full, ft_list_get(cmd, a))
        a = a + 1
    }
    let times: ptr<f64> = m[0].times
    let rss: ptr<f64> = m[0].rss
    let allocs: ptr<f64> = m[0].allocs
    let copies: ptr<f64> = m[0].copies
    let heap_bytes: ptr<f64> = m[0].heap_bytes
    let peak_live: ptr<f64> = m[0].peak_live
    let temp_bytes: ptr<f64> = m[0].temp_bytes
    let mut k: i32 = 0
    while k < repeats {
        let _rm0: i32 = pr_run("rm -f " + pr_quote(mem_out))
        if memory {
            let _e1: i32 = setenv("FLOW_MEM_PROFILE", "1", 1)
            let _e2: i32 = setenv("FLOW_MEM_PROFILE_OUT", mem_out, 1)
        } else {
            let _e3: i32 = setenv("FLOW_MEM_PROFILE", "", 1)
            let _e4: i32 = setenv("FLOW_MEM_PROFILE_OUT", "", 1)
        }
        let r: ptr<BenchRun> = run_in(cwd, full)
        if memory {
            let _e5: i32 = setenv("FLOW_MEM_PROFILE", "", 1)
            let _e6: i32 = setenv("FLOW_MEM_PROFILE_OUT", "", 1)
        }
        if bn_code(r) != 0 {
            m[0].failed = true
        }
        times[k] = bn_wall(r)
        rss[k] = 0.0
        if memory and flavour != TIME_NONE {
            rss[k] = peak_rss_kb(ft_read_file(report), flavour)
            let _rm: i32 = pr_run("rm -f " + pr_quote(report))
        }
        let prof: string = ft_read_file(mem_out)
        allocs[k] = counter(bn_out(r), "allocations")
        copies[k] = counter(bn_out(r), "copies")
        heap_bytes[k] = 0.0
        peak_live[k] = 0.0
        temp_bytes[k] = 0.0
        if prof as ptr<u8> != null and ft_len(prof) > 0 {
            let pa: f64 = counter(prof, "allocations")
            let pc: f64 = counter(prof, "copies")
            if pa > 0.0 or pc > 0.0 or counter(prof, "heap_bytes") > 0.0 {
                allocs[k] = pa
                copies[k] = pc
            }
            heap_bytes[k] = counter(prof, "heap_bytes")
            peak_live[k] = counter(prof, "peak_live_heap")
            temp_bytes[k] = counter(prof, "temp_bytes")
            if rss[k] == 0.0 {
                rss[k] = counter(prof, "peak_rss_kb")
            }
        }
        k = k + 1
    }
    return m
}

# statistics.median of integer samples: an int for an odd count, a float
# (the mean of the middle two) for an even one.
function int_median_json(xs: ptr<f64>, n: i32) -> string {
    let med: f64 = bn_median(xs, n)
    if n % 2 == 1 {
        return bn_fixed(med, 0)
    }
    return bn_py_repr(med)
}

function metrics_json(m: ptr<Metrics>, memory: bool, ind: string) -> string {
    if m == null {
        return "{}"
    }
    let n: i32 = m[0].n
    let mut o: string = "{\n"
    o = o + ind + "  \"median\": " + bn_py_repr(bn_median(m[0].times, n)) + ",\n"
    o = o + ind + "  \"min\": " + bn_py_repr(bn_min(m[0].times, n)) + ",\n"
    o = o + ind + "  \"p95\": " + bn_py_repr(percentile(m[0].times, n, 0.95)) + ",\n"
    o = o + ind + "  \"dispersion\": " + bn_py_repr(stdev(m[0].times, n)) + ",\n"
    o = o + ind + "  \"allocations\": " + int_median_json(m[0].allocs, n) + ",\n"
    o = o + ind + "  \"copies\": " + int_median_json(m[0].copies, n) + ",\n"
    o = o + ind + "  \"heap_bytes\": " + int_median_json(m[0].heap_bytes, n) + ",\n"
    o = o + ind + "  \"peak_live_heap\": " + int_median_json(m[0].peak_live, n) + ",\n"
    o = o + ind + "  \"temp_bytes\": " + int_median_json(m[0].temp_bytes, n)
    if memory or bn_median(m[0].rss, n) > 0.0 {
        o = o + ",\n" + ind + "  \"median_rss_kb\": " + int_median_json(m[0].rss, n)
    }
    return o + "\n" + ind + "}"
}

function join_plain(argv: ptr<StrList>) -> string {
    if argv == null {
        return "null"
    }
    let mut out: string = ""
    let mut i: i32 = 0
    while i < ft_list_len(argv) {
        if i > 0 {
            out = out + " "
        }
        out = out + ft_list_get(argv, i)
        i = i + 1
    }
    return json_quote(out)
}

function bool_json(b: bool) -> string {
    if b {
        return "true"
    }
    return "false"
}

# One workload: warm up when asked, time each available command, and return
# its JSON object at list indentation.
function ratio_text(numer: f64, denom: f64) -> string {
    if numer <= 0.0 or denom <= 0.0 {
        return "null"
    }
    return bn_py_repr(numer / denom)
}

function attribution_json(flow: ptr<Metrics>, python: ptr<Metrics>, native: ptr<Metrics>, ind: string) -> string {
    let mut fm: f64 = 0.0
    let mut pm: f64 = 0.0
    let mut nm: f64 = 0.0
    if flow != null {
        fm = bn_median(flow[0].times, flow[0].n)
    }
    if python != null {
        pm = bn_median(python[0].times, python[0].n)
    }
    if native != null {
        nm = bn_median(native[0].times, native[0].n)
    }
    return "{\n"
        + ind + "  \"flow_vs_python\": " + ratio_text(fm, pm) + ",\n"
        + ind + "  \"flow_vs_native\": " + ratio_text(fm, nm) + ",\n"
        + ind + "  \"python_vs_native\": " + ratio_text(pm, nm) + "\n"
        + ind + "}"
}

function run_benchmark(sys: ptr<SysInfo>, workload: string, flow_cmd: ptr<StrList>, py_cmd: ptr<StrList>, native_cmd: ptr<StrList>, repeats: i32, warm: bool, memory: bool, flavour: i32, cwd: string) -> string {
    if warm {
        if flow_cmd != null {
            let _w1: ptr<BenchRun> = run_in(cwd, flow_cmd)
        }
        if py_cmd != null {
            let _w2: ptr<BenchRun> = run_in(cwd, py_cmd)
        }
        if native_cmd != null {
            let _w3: ptr<BenchRun> = run_in(cwd, native_cmd)
        }
    }
    let mut fm: ptr<Metrics> = null
    let mut pm: ptr<Metrics> = null
    let mut nm: ptr<Metrics> = null
    let mut parity: string = "verified"
    if flow_cmd != null {
        fm = measure(flow_cmd, repeats, memory, flavour, cwd)
        if fm[0].failed {
            parity = "unresolved"
        }
    }
    if py_cmd != null {
        pm = measure(py_cmd, repeats, memory, flavour, cwd)
        if pm[0].failed {
            parity = "unresolved"
        }
    }
    if native_cmd != null {
        nm = measure(native_cmd, repeats, memory, flavour, cwd)
        if nm[0].failed {
            parity = "unresolved"
        }
    }
    let ind: string = "      "
    let mut o: string = "    {\n"
    o = o + ind + "\"workload_id\": " + json_quote(workload) + ",\n"
    o = o + ind + "\"semantic_parity_status\": " + json_quote(parity) + ",\n"
    o = o + ind + "\"flow_command\": " + join_plain(flow_cmd) + ",\n"
    o = o + ind + "\"python_command\": " + join_plain(py_cmd) + ",\n"
    o = o + ind + "\"native_command\": " + join_plain(native_cmd) + ",\n"
    o = o + ind + "\"compiler_version\": " + json_quote(sys[0].flow_version) + ",\n"
    o = o + ind + "\"interpreter_version\": " + json_quote(sys[0].python_version) + ",\n"
    o = o + ind + "\"backend\": \"c\",\n"
    o = o + ind + "\"blas_lapack_identity\": \"none\",\n"
    o = o + ind + "\"thread_counts\": " + sys[0].threads + ",\n"
    o = o + ind + "\"cpu\": " + json_quote(sys[0].cpu) + ",\n"
    o = o + ind + "\"os\": " + json_quote(sys[0].os) + ",\n"
    o = o + ind + "\"warm_mode\": " + bool_json(warm) + ",\n"
    o = o + ind + "\"repeats\": " + bn_fixed(repeats as f64, 0) + ",\n"
    o = o + ind + "\"flow_metrics\": " + metrics_json(fm, memory, ind) + ",\n"
    o = o + ind + "\"python_metrics\": " + metrics_json(pm, memory, ind) + ",\n"
    o = o + ind + "\"native_metrics\": " + metrics_json(nm, memory, ind) + ",\n"
    o = o + ind + "\"attribution\": " + attribution_json(fm, pm, nm, ind) + "\n"
    return o + "    }"
}

# Names in `dir` (sorted by ls), optionally only those ending in `suffix`.
function list_dir(dir: string, suffix: string) -> ptr<StrList> {
    let out: ptr<StrList> = ft_list_new()
    if pr_is_dir(dir) == false {
        return out
    }
    let lines: ptr<StrList> = ft_split_lines(pr_capture("ls -1 " + pr_quote(dir) + " 2>/dev/null"))
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let name: string = ft_list_get(lines, i)
        if ft_len(suffix) == 0 or ft_ends(name, suffix) {
            ft_list_push(out, name)
        }
        i = i + 1
    }
    return out
}

function first_with(dir: string, suffix: string) -> string {
    let names: ptr<StrList> = list_dir(dir, suffix)
    if ft_list_len(names) == 0 {
        return null as string
    }
    return dir + "/" + ft_list_get(names, 0)
}

# flowc_emit to C, then clang -O3, as `flow compile` would.
function compile_flow(flow_path: string, bin_path: string) -> bool {
    let gen_c: string = bin_path + ".c"
    let log_o: string = bin_path + ".out"
    let log_e: string = bin_path + ".err"
    let emit: string = pr_quote(ft_join(root(), "flow")) + " tool " + pr_quote(ft_join(root(), "compiler/scripts/flowc_emit.flow"))
    let redirect: string = " >" + pr_quote(log_o) + " 2>" + pr_quote(log_e)
    if pr_run(emit + " --lenient " + pr_quote(flow_path) + " " + pr_quote(gen_c) + redirect) != 0 {
        ft_outln("Compilation to C failed for " + flow_path + ":\n" + ft_read_file(log_o) + "\n" + ft_read_file(log_e))
        return false
    }
    if pr_run("clang -O3 -march=native -lm " + pr_quote(gen_c) + " -o " + pr_quote(bin_path) + redirect) != 0 {
        ft_outln("Clang compilation failed for " + gen_c + ":\n" + ft_read_file(log_o) + "\n" + ft_read_file(log_e))
        return false
    }
    let _rm: i32 = pr_run("rm -f " + pr_quote(log_o) + " " + pr_quote(log_e))
    return true
}

# Native baselines compile with the same backend flags as generated Flow C.
function compile_native(c_path: string, bin_path: string) -> bool {
    let log_o: string = bin_path + ".out"
    let log_e: string = bin_path + ".err"
    let redirect: string = " >" + pr_quote(log_o) + " 2>" + pr_quote(log_e)
    if pr_run("clang -O3 -march=native -lm " + pr_quote(c_path) + " -o " + pr_quote(bin_path) + redirect) != 0 {
        ft_outln("Clang compilation failed for " + c_path + ":\n" + ft_read_file(log_o) + "\n" + ft_read_file(log_e))
        return false
    }
    let _rm: i32 = pr_run("rm -f " + pr_quote(log_o) + " " + pr_quote(log_e))
    return true
}

function suite_name(i: i32) -> string {
    if i == 0 {
        return "cold"
    }
    if i == 1 {
        return "runtime"
    }
    if i == 2 {
        return "compiler"
    }
    return "memory"
}

function discover(sys: ptr<SysInfo>, smoke: bool, have_py: bool, flavour: i32, out: ptr<StrList>) -> void {
    let harness: string = ft_join(root(), "benchmarks/cross_harness")
    if pr_is_dir(harness) == false {
        return
    }
    let twins: string = ft_join(root(), "benchmarks/baselines/python/cross_harness")
    let natives: string = ft_join(root(), "benchmarks/baselines/native/cross_harness")
    let build: string = ft_join(root(), "build/benchmarks")
    let _m: bool = pr_mkdir_p(build)
    let mut repeats: i32 = 10
    if smoke {
        repeats = 3
    }
    let mut s: i32 = 0
    while s < 4 {
        let suite: string = suite_name(s)
        let sdir: string = harness + "/" + suite
        let names: ptr<StrList> = list_dir(sdir, "")
        let mut i: i32 = 0
        while i < ft_list_len(names) {
            let name: string = ft_list_get(names, i)
            let d: string = sdir + "/" + name
            if pr_is_dir(d) {
                let workload: string = suite + "_" + name
                let memory: bool = ft_eq(suite, "memory")
                let warm: bool = ft_eq(suite, "cold") == false
                let mut flow_cmd: ptr<StrList> = null
                let mut py_cmd: ptr<StrList> = null
                let mut native_cmd: ptr<StrList> = null
                let mut skip: bool = false
                let flow_file: string = first_with(d, ".flow")
                if flow_file as ptr<u8> != null {
                    flow_cmd = ft_list_new()
                    if ft_eq(suite, "cold") or ft_eq(suite, "compiler") {
                        ft_list_push(flow_cmd, ft_join(root(), "flow"))
                        ft_list_push(flow_cmd, "run")
                        ft_list_push(flow_cmd, "--json")
                        ft_list_push(flow_cmd, flow_file)
                    } else {
                        let bin: string = build + "/" + workload
                        if compile_flow(flow_file, bin) {
                            ft_list_push(flow_cmd, bin)
                        } else {
                            ft_outln("Skipping " + workload + " due to compilation error")
                            skip = true
                        }
                    }
                }
                let py_file: string = first_with(twins + "/" + suite + "/" + name, ".py")
                if py_file as ptr<u8> != null and have_py {
                    py_cmd = ft_list_new()
                    ft_list_push(py_cmd, "python3")
                    ft_list_push(py_cmd, py_file)
                }
                let native_file: string = first_with(natives + "/" + suite + "/" + name, ".c")
                if native_file as ptr<u8> != null {
                    let native_bin: string = build + "/" + workload + "_native"
                    if compile_native(native_file, native_bin) {
                        native_cmd = ft_list_new()
                        ft_list_push(native_cmd, native_bin)
                    } else {
                        ft_outln("Skipping " + workload + " native baseline due to compilation error")
                    }
                }
                if skip == false and (flow_cmd != null or py_cmd != null or native_cmd != null) {
                    ft_list_push(out, run_benchmark(sys, workload, flow_cmd, py_cmd, native_cmd, repeats, warm, memory, flavour, d))
                }
            }
            i = i + 1
        }
        s = s + 1
    }
}

# ---------------------------------------------------------------------------
# Baseline comparison
# ---------------------------------------------------------------------------

function find_workload(j: ptr<Json>, workload: string) -> i32 {
    let list: i32 = json_get(j, 0, "benchmarks")
    if list < 0 or json_kind(j, list) != json_kind_array() {
        return -1
    }
    let mut c: i32 = json_first(j, list)
    while c >= 0 {
        if ft_eq(member_str(j, c, "workload_id"), workload) {
            return c
        }
        c = json_next(j, c)
    }
    return -1
}

function median_repr(j: ptr<Json>, id: i32) -> string {
    let t: string = median_text(j, id)
    if t as ptr<u8> == null {
        return "None"
    }
    return bn_py_repr(bn_parse_float(t))
}

# Prints each workload's status; true when any regressed.
function compare(old_j: ptr<Json>, new_j: ptr<Json>) -> bool {
    let mut failed: bool = false
    let list: i32 = json_get(new_j, 0, "benchmarks")
    let mut c: i32 = json_first(new_j, list)
    while c >= 0 {
        let workload: string = member_str(new_j, c, "workload_id")
        let o: i32 = find_workload(old_j, workload)
        if o >= 0 {
            let status: string = evaluate_nodes(old_j, o, new_j, c)
            ft_outln(workload + ": " + status)
            if ft_eq(status, "regression") {
                ft_outln("  Regression found! Old median: " + median_repr(old_j, o) + ", New median: " + median_repr(new_j, c))
                failed = true
            }
        }
        c = json_next(new_j, c)
    }
    return failed
}

# ---------------------------------------------------------------------------
# Test modes
# ---------------------------------------------------------------------------

function test_percentile(argc: i32, argv: ptr<ptr<u8>>, start: i32) -> i32 {
    if start >= argc {
        ft_errln("run_benchmarks: --percentile needs P and values")
        return 2
    }
    let p: f64 = bn_parse_float(argv[start] as string)
    let n: i32 = argc - start - 1
    let xs: ptr<f64> = malloc(((n + 1) as i64) * 8) as ptr<f64>
    let mut i: i32 = 0
    while i < n {
        xs[i] = bn_parse_float(argv[start + 1 + i] as string)
        i = i + 1
    }
    ft_outln(bn_py_repr(percentile(xs, n, p)))
    return 0
}

function test_regression(old_path: string, new_path: string) -> i32 {
    let oj: ptr<Json> = load_json(old_path)
    let nj: ptr<Json> = load_json(new_path)
    if oj == null or nj == null {
        return 2
    }
    ft_outln(evaluate_nodes(oj, 0, nj, 0))
    return 0
}

# Every runtime/*.flow workload must have a matching native .c twin (#745).
function check_runtime_natives() -> i32 {
    let harness: string = ft_join(root(), "benchmarks/cross_harness/runtime")
    let natives: string = ft_join(root(), "benchmarks/baselines/native/cross_harness/runtime")
    let names: ptr<StrList> = list_dir(harness, "")
    let mut missing: i32 = 0
    let mut i: i32 = 0
    while i < ft_list_len(names) {
        let name: string = ft_list_get(names, i)
        let d: string = harness + "/" + name
        if pr_is_dir(d) {
            if first_with(d, ".flow") as ptr<u8> != null {
                if first_with(natives + "/" + name, ".c") as ptr<u8> == null {
                    ft_errln("missing native twin: runtime/" + name)
                    missing = missing + 1
                } else {
                    ft_outln("runtime_" + name + ": native")
                }
            }
        }
        i = i + 1
    }
    if missing > 0 {
        return 1
    }
    ft_outln("runtime natives: complete")
    return 0
}

# Classify each row's flow_vs_native ratio. >1.05 is a Flow tax.
function eval_tax(path: string) -> i32 {
    let j: ptr<Json> = load_json(path)
    if j == null {
        return 2
    }
    let list: i32 = json_get(j, 0, "benchmarks")
    if list < 0 or json_kind(j, list) != json_kind_array() {
        ft_errln("run_benchmarks: " + path + " has no benchmarks array")
        return 2
    }
    let mut c: i32 = json_first(j, list)
    while c >= 0 {
        let workload: string = member_str(j, c, "workload_id")
        let attr: i32 = json_get(j, c, "attribution")
        let ratio: i32 = json_get(j, attr, "flow_vs_native")
        if attr < 0 or ratio < 0 or json_kind(j, ratio) == json_kind_null() {
            ft_outln(workload + ": no_native")
        } else {
            let v: f64 = bn_parse_float(json_str(j, ratio))
            if v > 1.05 {
                ft_outln(workload + ": tax")
            } else {
                ft_outln(workload + ": ok")
            }
        }
        c = json_next(j, c)
    }
    return 0
}

# ---------------------------------------------------------------------------

function main(argc: i32, argv: ptr<ptr<u8>>) -> i32 {
    let mut smoke: bool = false
    let mut cleanup: bool = false
    let mut baseline: string = null as string
    let mut out_path: string = "benchmark_schema.json"
    let mut i: i32 = 1
    while i < argc {
        let a: string = argv[i] as string
        if ft_eq(a, "--percentile") {
            return test_percentile(argc, argv, i + 1)
        } elif ft_eq(a, "--eval-regression") and i + 2 < argc {
            return test_regression(argv[i + 1] as string, argv[i + 2] as string)
        } elif ft_eq(a, "--eval-tax") and i + 1 < argc {
            return eval_tax(argv[i + 1] as string)
        } elif ft_eq(a, "--check-runtime-natives") {
            return check_runtime_natives()
        } elif ft_eq(a, "--now-us") {
            ft_outln(now_us())
            return 0
        } elif ft_eq(a, "--system-info") {
            ft_outln(system_json(system_info(), ""))
            return 0
        } elif ft_eq(a, "--smoke") {
            smoke = true
        } elif ft_eq(a, "--cleanup") {
            cleanup = true
        } elif ft_eq(a, "--baseline") and i + 1 < argc {
            baseline = argv[i + 1] as string
            i = i + 1
        } elif ft_starts(a, "--baseline=") {
            baseline = ft_from(a, 11)
        } elif ft_eq(a, "--out") and i + 1 < argc {
            out_path = argv[i + 1] as string
            i = i + 1
        } elif ft_starts(a, "--out=") {
            out_path = ft_from(a, 6)
        } elif ft_eq(a, "-h") or ft_eq(a, "--help") {
            ft_outln(usage())
            return 0
        } else {
            ft_errln(usage())
            ft_errln("flow tool bench_harness: error: unrecognized arguments: " + a)
            return 2
        }
        i = i + 1
    }

    if smoke {
        ft_outln("Running benchmarks (smoke=True)...")
    } else {
        ft_outln("Running benchmarks (smoke=False)...")
    }
    let sys: ptr<SysInfo> = system_info()
    let have_py: bool = python_available()
    if have_py == false {
        ft_outln("python3 not found; skipping the Python subjects")
    }
    let flavour: i32 = time_flavour()
    let items: ptr<StrList> = ft_list_new()
    discover(sys, smoke, have_py, flavour, items)

    if ft_list_len(items) == 0 {
        ft_outln("No benchmarks found. Create some in benchmarks/cross_harness/")
        let mut repeats: i32 = 10
        if smoke {
            repeats = 3
        }
        let fc: ptr<StrList> = ft_list_new()
        ft_list_push(fc, "echo")
        ft_list_push(fc, "flow_mock")
        let pc: ptr<StrList> = ft_list_new()
        ft_list_push(pc, "echo")
        ft_list_push(pc, "python_mock")
        ft_list_push(items, run_benchmark(sys, "mock_workload", fc, pc, null, repeats, true, false, flavour, "."))
    }

    let mut doc: string = "{\n  \"timestamp\": " + json_quote(iso_now()) + ",\n"
    doc = doc + "  \"system\": " + system_json(sys, "  ") + ",\n"
    doc = doc + "  \"benchmarks\": [\n"
    let mut k: i32 = 0
    while k < ft_list_len(items) {
        doc = doc + ft_list_get(items, k)
        if k + 1 < ft_list_len(items) {
            doc = doc + ",\n"
        } else {
            doc = doc + "\n"
        }
        k = k + 1
    }
    doc = doc + "  ]\n}"

    let mut regressed: bool = false
    if baseline as ptr<u8> != null {
        if ft_exists(baseline) {
            let old_j: ptr<Json> = load_json(baseline)
            if old_j == null {
                return 2
            }
            let new_j: ptr<Json> = json_parse(doc)
            if ft_len(json_error(new_j)) > 0 {
                ft_errln("run_benchmarks: internal JSON error: " + json_error(new_j))
                return 2
            }
            regressed = compare(old_j, new_j)
        } else {
            ft_outln("Baseline file " + baseline + " not found.")
        }
    }

    if ft_write_file(out_path, doc) == false {
        ft_errln("run_benchmarks: cannot write " + out_path)
        return 1
    }
    ft_outln("Wrote benchmark results to " + out_path)

    if cleanup {
        let _rm: i32 = pr_run("rm -rf " + pr_quote(ft_join(root(), "build/benchmarks")))
        ft_outln("Removed build/benchmarks")
    }
    if regressed {
        return 1
    }
    return 0
}
