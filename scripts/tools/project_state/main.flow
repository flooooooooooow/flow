# Reject duplicate mutable project-state documents at the repository root.
#
# Run through scripts/check_project_state_sources.sh from the repository
# root. Each root file below is a short compatibility pointer: it must stay
# small and must name the canonical or archived document it replaced, so a
# second source of truth cannot grow back in its place.

import .text { ft_outln, ft_errln, ft_contains, ft_read_file, ft_exists, ft_split_lines, ft_list_len, ft_itoa }

const MAX_POINTER_LINES: i32 = 12

# One pointer. Returns the number of errors it reported.
function check_pointer(pointer: string, canonical: string) -> i32 {
    if ft_exists(pointer) == false {
        ft_errln("project-state: missing compatibility pointer: " + pointer)
        return 1
    }
    if ft_exists(canonical) == false {
        ft_errln("project-state: missing canonical/archive document: " + canonical)
        return 1
    }
    let text: string = ft_read_file(pointer)
    if text as ptr<u8> == null {
        ft_errln("project-state: cannot read " + pointer)
        return 1
    }
    let mut errors: i32 = 0
    if ft_contains(text, canonical) == false {
        ft_errln("project-state: " + pointer + " must point to " + canonical + "; do not restore a second source of truth")
        errors = errors + 1
    }
    let lines: i32 = ft_list_len(ft_split_lines(text))
    if lines > MAX_POINTER_LINES {
        ft_errln("project-state: " + pointer + " has " + ft_itoa(lines) + " lines; compatibility pointers must stay <= " + ft_itoa(MAX_POINTER_LINES))
        errors = errors + 1
    }
    return errors
}

function main(argc: i32, argv: ptr<string>) -> i32 {
    let mut errors: i32 = 0
    errors = errors + check_pointer("Questions.md", "docs/project/Questions.md")
    errors = errors + check_pointer("ROADMAP-1.0.md", "docs/project/archive/ROADMAP-1.0.md")
    errors = errors + check_pointer("RELEASE-1.0.md", "docs/project/archive/RELEASE-1.0.md")
    if errors > 0 {
        return 1
    }
    ft_outln("project-state: canonical sources OK")
    return 0
}
