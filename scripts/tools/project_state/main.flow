# Ensure canonical project-state documents exist and prevent duplicate or
# misplaced documents at the repository root.
#
# Run it as `./flow tool project_state` from anywhere in the repository.
# Root files are reserved for durable entry points and contracts.
# Superseded roadmaps, release checklists, and working trackers belong in docs/project/.

import .text { ft_outln, ft_errln, ft_exists }
import .repo { rp_enter_root }

function check_canonical_exists(path: string) -> i32 {
    if ft_exists(path) == false {
        ft_errln("project-state: missing canonical document: " + path)
        return 1
    }
    return 0
}

function check_forbidden_root(file: string, canonical: string) -> i32 {
    if ft_exists(file) {
        ft_errln("project-state: " + file + " must not sit at root; use canonical " + canonical)
        return 1
    }
    return 0
}

function main(argc: i32, argv: ptr<string>) -> i32 {
    if rp_enter_root() == false {
        ft_errln("project-state: cannot enter the repository root")
        return 1
    }
    let mut errors: i32 = 0
    errors = errors + check_canonical_exists("docs/project/Questions.md")
    errors = errors + check_canonical_exists("docs/project/archive/ROADMAP-1.0.md")
    errors = errors + check_canonical_exists("docs/project/archive/RELEASE-1.0.md")
    errors = errors + check_canonical_exists("licenses/LICENSE-1.x-MIT")

    errors = errors + check_forbidden_root("Questions.md", "docs/project/Questions.md")
    errors = errors + check_forbidden_root("ROADMAP-1.0.md", "docs/project/archive/ROADMAP-1.0.md")
    errors = errors + check_forbidden_root("RELEASE-1.0.md", "docs/project/archive/RELEASE-1.0.md")
    errors = errors + check_forbidden_root("LICENSE-1.x-MIT", "licenses/LICENSE-1.x-MIT")

    if errors > 0 {
        return 1
    }
    ft_outln("project-state: canonical sources OK")
    return 0
}
