# Gradient code generation for a scalar f32 Flow function, by reverse mode
# over a static tape. A prototype: it handles a small subset of Flow.
#
#   flow tool grad c    <file.flow> <function>   C program: value + gradients
#   flow tool grad flow <file.flow> <function>   Flow module: Grad_<f>, grad_<f>
#
# Supported inside the differentiated function:
#   f32 literals, parameters, let-bound locals, + - * /, unary -,
#   sin cos exp log sqrt sigmoid.
# The Flow mode also inlines calls to other functions in the same file.
#
# lib/stdlib/nn_xor_loss_clean_grad.flow and nn_xor_loss_params_grad.flow
# are generated by the Flow mode.

import .text { ft_out, ft_outln, ft_err, ft_errln, ft_eq, ft_len, ft_itoa, ft_read_file, ft_ends, ft_find_byte, ft_list_new, ft_list_push, ft_list_len, ft_list_get, StrList }

extern {
    function malloc(size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
    function strlen(s: string) -> i64
}

# Token kinds
const T_EOF: i32 = 0
const T_IDENT: i32 = 1
const T_NUMBER: i32 = 2
const T_PUNCT: i32 = 3
const T_STRING: i32 = 4

# Expression kinds
const E_LIT: i32 = 1
const E_VAR: i32 = 2
const E_UNARY: i32 = 3
const E_BINARY: i32 = 4
const E_CALL: i32 = 5
const E_OTHER: i32 = 6

# Statement kinds
const S_LET: i32 = 1
const S_RETURN: i32 = 2
const S_OTHER: i32 = 3

# Tape ops. OP_VAR carries the parameter index in `a`.
const OP_CONST: i32 = 0
const OP_ADD: i32 = 1
const OP_SUB: i32 = 2
const OP_MUL: i32 = 3
const OP_DIV: i32 = 4
const OP_NEG: i32 = 5
const OP_SIN: i32 = 6
const OP_COS: i32 = 7
const OP_EXP: i32 = 8
const OP_LOG: i32 = 9
const OP_SQRT: i32 = 10
const OP_SIGMOID: i32 = 11
const OP_VAR: i32 = 1000

struct Src {
    # tokens
    tkind: ptr<i32>
    ttext: ptr<string>
    tnl: ptr<i32>
    nt: i32
    tcap: i32
    pos: i32
    # expressions
    ekind: ptr<i32>
    etext: ptr<string>
    ea: ptr<i32>
    eb: ptr<i32>
    eargs: ptr<i32>
    enargs: ptr<i32>
    ne: i32
    ecap: i32
    # flat argument lists
    args: ptr<i32>
    nargs: i32
    argcap: i32
    # statements
    skind: ptr<i32>
    sname: ptr<string>
    sexpr: ptr<i32>
    ns: i32
    scap: i32
    # functions
    fname: ptr<string>
    fret: ptr<string>
    fpstart: ptr<i32>
    fpcount: ptr<i32>
    fsstart: ptr<i32>
    fscount: ptr<i32>
    nf: i32
    fcap: i32
    # flat parameter names
    pnames: ptr<string>
    np: i32
    pcap: i32
    err: string
}

struct Tape {
    op: ptr<i32>
    na: ptr<i32>
    nb: ptr<i32>
    konst: ptr<string>
    n: i32
    cap: i32
    # parameters of the differentiated function
    params: ptr<StrList>
    # let-bound locals, looked up from the end; restored by truncation
    lname: ptr<string>
    lnode: ptr<i32>
    nl: i32
    lcap: i32
    err: string
}

# ---------------------------------------------------------------------------
# Growable arrays
# ---------------------------------------------------------------------------

function grow_i32(p: ptr<i32>, cap: i32) -> ptr<i32> {
    return realloc(p as ptr<void>, (cap as i64) * 4) as ptr<i32>
}

function grow_str(p: ptr<string>, cap: i32) -> ptr<string> {
    return realloc(p as ptr<void>, (cap as i64) * 8) as ptr<string>
}

function new_i32(cap: i32) -> ptr<i32> {
    return malloc((cap as i64) * 4) as ptr<i32>
}

function new_str(cap: i32) -> ptr<string> {
    return malloc((cap as i64) * 8) as ptr<string>
}

# ---------------------------------------------------------------------------
# Lexer
# ---------------------------------------------------------------------------

function is_ident_start(c: i32) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 or c >= 128
}

function is_ident_char(c: i32) -> bool {
    return is_ident_start(c) or (c >= 48 and c <= 57)
}

function is_digit(c: i32) -> bool {
    return c >= 48 and c <= 57
}

function add_token(s: ptr<Src>, kind: i32, text: string, nl: bool) -> void {
    if s[0].nt == s[0].tcap {
        s[0].tcap = s[0].tcap * 2
        s[0].tkind = grow_i32(s[0].tkind, s[0].tcap)
        s[0].ttext = grow_str(s[0].ttext, s[0].tcap)
        s[0].tnl = grow_i32(s[0].tnl, s[0].tcap)
    }
    let k: ptr<i32> = s[0].tkind
    let t: ptr<string> = s[0].ttext
    let l: ptr<i32> = s[0].tnl
    k[s[0].nt] = kind
    t[s[0].nt] = text
    if nl {
        l[s[0].nt] = 1
    } else {
        l[s[0].nt] = 0
    }
    s[0].nt = s[0].nt + 1
}

function slice(src: ptr<u8>, start: i32, end: i32) -> string {
    let n: i32 = end - start
    let out: ptr<u8> = malloc((n + 1) as i64) as ptr<u8>
    let mut i: i32 = 0
    while i < n {
        out[i] = src[start + i]
        i = i + 1
    }
    out[n] = 0
    return out as string
}

function lex(s: ptr<Src>, text: string) -> void {
    let p: ptr<u8> = text as ptr<u8>
    let n: i32 = strlen(text) as i32
    let mut i: i32 = 0
    let mut nl: bool = true
    while i < n {
        let c: i32 = p[i] as i32
        if c == 10 {
            nl = true
            i = i + 1
        } elif c == 32 or c == 9 or c == 13 {
            i = i + 1
        } elif c == 35 {
            while i < n and p[i] != 10 {
                i = i + 1
            }
        } elif c == 34 {
            let start: i32 = i
            i = i + 1
            while i < n and p[i] != 34 {
                if p[i] == 92 {
                    i = i + 1
                }
                i = i + 1
            }
            i = i + 1
            add_token(s, T_STRING, slice(p, start, i), nl)
            nl = false
        } elif is_digit(c) or (c == 46 and i + 1 < n and is_digit(p[i + 1] as i32)) {
            let start2: i32 = i
            while i < n and (is_digit(p[i] as i32) or p[i] == 46 or p[i] == 95) {
                if p[i] == 46 and i + 1 < n and p[i + 1] == 46 {
                    break
                }
                i = i + 1
            }
            if i < n and (p[i] == 101 or p[i] == 69) {
                let mut j: i32 = i + 1
                if j < n and (p[j] == 43 or p[j] == 45) {
                    j = j + 1
                }
                if j < n and is_digit(p[j] as i32) {
                    i = j
                    while i < n and is_digit(p[i] as i32) {
                        i = i + 1
                    }
                }
            }
            add_token(s, T_NUMBER, slice(p, start2, i), nl)
            nl = false
        } elif is_ident_start(c) {
            let start3: i32 = i
            while i < n and is_ident_char(p[i] as i32) {
                i = i + 1
            }
            add_token(s, T_IDENT, slice(p, start3, i), nl)
            nl = false
        } else {
            let mut len: i32 = 1
            if i + 1 < n {
                let d: i32 = p[i + 1] as i32
                if (c == 45 and d == 62) or (c == 61 and d == 61) or (c == 33 and d == 61) or (c == 60 and d == 61) or (c == 62 and d == 61) or (c == 38 and d == 38) or (c == 124 and d == 124) or (c == 124 and d == 62) or (c == 46 and d == 46) {
                    len = 2
                }
            }
            add_token(s, T_PUNCT, slice(p, i, i + len), nl)
            nl = false
            i = i + len
        }
    }
    add_token(s, T_EOF, "", true)
}

# ---------------------------------------------------------------------------
# Parser
# ---------------------------------------------------------------------------

function tk(s: ptr<Src>) -> i32 {
    let k: ptr<i32> = s[0].tkind
    return k[s[0].pos]
}

function tt(s: ptr<Src>) -> string {
    let t: ptr<string> = s[0].ttext
    return t[s[0].pos]
}

function tnl(s: ptr<Src>) -> bool {
    let l: ptr<i32> = s[0].tnl
    return l[s[0].pos] != 0
}

function is_punct(s: ptr<Src>, text: string) -> bool {
    return tk(s) == T_PUNCT and ft_eq(tt(s), text)
}

function is_word(s: ptr<Src>, text: string) -> bool {
    return tk(s) == T_IDENT and ft_eq(tt(s), text)
}

function advance(s: ptr<Src>) -> void {
    if tk(s) != T_EOF {
        s[0].pos = s[0].pos + 1
    }
}

function parse_fail(s: ptr<Src>, msg: string) -> i32 {
    if ft_len(s[0].err) == 0 {
        s[0].err = msg
    }
    return -1
}

function new_expr(s: ptr<Src>, kind: i32, text: string, a: i32, b: i32) -> i32 {
    if s[0].ne == s[0].ecap {
        s[0].ecap = s[0].ecap * 2
        s[0].ekind = grow_i32(s[0].ekind, s[0].ecap)
        s[0].etext = grow_str(s[0].etext, s[0].ecap)
        s[0].ea = grow_i32(s[0].ea, s[0].ecap)
        s[0].eb = grow_i32(s[0].eb, s[0].ecap)
        s[0].eargs = grow_i32(s[0].eargs, s[0].ecap)
        s[0].enargs = grow_i32(s[0].enargs, s[0].ecap)
    }
    let i: i32 = s[0].ne
    let k: ptr<i32> = s[0].ekind
    let t: ptr<string> = s[0].etext
    let aa: ptr<i32> = s[0].ea
    let bb: ptr<i32> = s[0].eb
    let ag: ptr<i32> = s[0].eargs
    let an: ptr<i32> = s[0].enargs
    k[i] = kind
    t[i] = text
    aa[i] = a
    bb[i] = b
    ag[i] = 0
    an[i] = 0
    s[0].ne = i + 1
    return i
}

function push_arg(s: ptr<Src>, e: i32) -> void {
    if s[0].nargs == s[0].argcap {
        s[0].argcap = s[0].argcap * 2
        s[0].args = grow_i32(s[0].args, s[0].argcap)
    }
    let a: ptr<i32> = s[0].args
    a[s[0].nargs] = e
    s[0].nargs = s[0].nargs + 1
}

# Skip a balanced bracket group starting at an opening token.
function skip_group(s: ptr<Src>) -> void {
    let mut depth: i32 = 0
    while tk(s) != T_EOF {
        if is_punct(s, "(") or is_punct(s, "[") or is_punct(s, "{") {
            depth = depth + 1
        } elif is_punct(s, ")") or is_punct(s, "]") or is_punct(s, "}") {
            depth = depth - 1
            if depth == 0 {
                advance(s)
                return
            }
        }
        advance(s)
    }
}

function parse_primary(s: ptr<Src>, in_parens: bool) -> i32 {
    if tk(s) == T_NUMBER {
        let lit: string = tt(s)
        advance(s)
        return new_expr(s, E_LIT, lit, 0, 0)
    }
    if is_punct(s, "(") {
        advance(s)
        let inner: i32 = parse_expr(s, true)
        if inner < 0 {
            return -1
        }
        if is_punct(s, ")") == false {
            return parse_fail(s, "expected )")
        }
        advance(s)
        return inner
    }
    if tk(s) == T_IDENT {
        let name: string = tt(s)
        advance(s)
        if is_punct(s, "(") and tnl(s) == false {
            advance(s)
            let first: i32 = s[0].nargs
            # Collect into a temporary list first: nested calls also push.
            let tmp: ptr<i32> = new_i32(64)
            let mut count: i32 = 0
            while is_punct(s, ")") == false {
                let arg: i32 = parse_expr(s, true)
                if arg < 0 {
                    return -1
                }
                if count < 64 {
                    tmp[count] = arg
                }
                count = count + 1
                if is_punct(s, ",") {
                    advance(s)
                } elif is_punct(s, ")") == false {
                    return parse_fail(s, "expected , or )")
                }
            }
            advance(s)
            let start: i32 = s[0].nargs
            let mut k: i32 = 0
            while k < count {
                push_arg(s, tmp[k])
                k = k + 1
            }
            let call: i32 = new_expr(s, E_CALL, name, 0, 0)
            let ag: ptr<i32> = s[0].eargs
            let an: ptr<i32> = s[0].enargs
            ag[call] = start
            an[call] = count
            return call
        }
        if ft_eq(name, "true") or ft_eq(name, "false") {
            return new_expr(s, E_LIT, name, 0, 0)
        }
        return new_expr(s, E_VAR, name, 0, 0)
    }
    if tk(s) == T_STRING {
        let st: string = tt(s)
        advance(s)
        return new_expr(s, E_LIT, st, 0, 0)
    }
    return parse_fail(s, "unexpected token " + tt(s))
}

function parse_postfix(s: ptr<Src>, in_parens: bool) -> i32 {
    let mut e: i32 = parse_primary(s, in_parens)
    while e >= 0 and (is_punct(s, ".") or is_punct(s, "[")) {
        if is_punct(s, ".") {
            advance(s)
            advance(s)
            e = new_expr(s, E_OTHER, "MemberAccess", e, 0)
        } else {
            skip_group(s)
            e = new_expr(s, E_OTHER, "IndexAccess", e, 0)
        }
    }
    return e
}

function parse_unary(s: ptr<Src>, in_parens: bool) -> i32 {
    if is_punct(s, "-") or is_punct(s, "!") or is_word(s, "not") {
        let op: string = tt(s)
        advance(s)
        let operand: i32 = parse_unary(s, in_parens)
        if operand < 0 {
            return -1
        }
        return new_expr(s, E_UNARY, op, operand, 0)
    }
    let e: i32 = parse_postfix(s, in_parens)
    if e >= 0 and is_word(s, "as") {
        advance(s)
        advance(s)
        return new_expr(s, E_OTHER, "Cast", e, 0)
    }
    return e
}

function binary_prec(s: ptr<Src>) -> i32 {
    if tk(s) == T_IDENT {
        if ft_eq(tt(s), "or") {
            return 1
        }
        if ft_eq(tt(s), "and") {
            return 2
        }
        return 0
    }
    if tk(s) != T_PUNCT {
        return 0
    }
    let t: string = tt(s)
    if ft_eq(t, "||") {
        return 1
    }
    if ft_eq(t, "&&") {
        return 2
    }
    if ft_eq(t, "==") or ft_eq(t, "!=") or ft_eq(t, "<") or ft_eq(t, ">") or ft_eq(t, "<=") or ft_eq(t, ">=") {
        return 3
    }
    if ft_eq(t, "+") or ft_eq(t, "-") {
        return 4
    }
    if ft_eq(t, "*") or ft_eq(t, "/") or ft_eq(t, "%") {
        return 5
    }
    return 0
}

# Precedence climbing, left-associative. Outside parentheses an operator
# must sit on the same line as its left operand.
function parse_binary(s: ptr<Src>, min_prec: i32, in_parens: bool) -> i32 {
    let mut left: i32 = parse_unary(s, in_parens)
    while left >= 0 {
        let prec: i32 = binary_prec(s)
        if prec == 0 or prec < min_prec {
            break
        }
        if tnl(s) and in_parens == false {
            break
        }
        let op: string = tt(s)
        advance(s)
        let right: i32 = parse_binary(s, prec + 1, in_parens)
        if right < 0 {
            return -1
        }
        left = new_expr(s, E_BINARY, op, left, right)
    }
    return left
}

function parse_expr(s: ptr<Src>, in_parens: bool) -> i32 {
    return parse_binary(s, 1, in_parens)
}

function new_stmt(s: ptr<Src>, kind: i32, name: string, e: i32) -> void {
    if s[0].ns == s[0].scap {
        s[0].scap = s[0].scap * 2
        s[0].skind = grow_i32(s[0].skind, s[0].scap)
        s[0].sname = grow_str(s[0].sname, s[0].scap)
        s[0].sexpr = grow_i32(s[0].sexpr, s[0].scap)
    }
    let k: ptr<i32> = s[0].skind
    let nm: ptr<string> = s[0].sname
    let ex: ptr<i32> = s[0].sexpr
    k[s[0].ns] = kind
    nm[s[0].ns] = name
    ex[s[0].ns] = e
    s[0].ns = s[0].ns + 1
}

# Skip to the end of an unsupported statement: the rest of its line plus
# any bracket group it opens.
function skip_statement(s: ptr<Src>) -> void {
    advance(s)
    while tk(s) != T_EOF and tnl(s) == false and is_punct(s, "}") == false {
        if is_punct(s, "(") or is_punct(s, "[") or is_punct(s, "{") {
            skip_group(s)
        } else {
            advance(s)
        }
    }
    # `} else {` style continuations
    while is_word(s, "else") or is_word(s, "elif") {
        advance(s)
        while tk(s) != T_EOF and is_punct(s, "{") == false {
            advance(s)
        }
        skip_group(s)
    }
}

function statement_class(word: string) -> string {
    if ft_eq(word, "if") {
        return "IfStatement"
    }
    if ft_eq(word, "while") {
        return "WhileStatement"
    }
    if ft_eq(word, "for") {
        return "ForStatement"
    }
    if ft_eq(word, "defer") {
        return "DeferStatement"
    }
    if ft_eq(word, "break") {
        return "BreakStatement"
    }
    if ft_eq(word, "continue") {
        return "ContinueStatement"
    }
    if ft_eq(word, "match") {
        return "MatchStatement"
    }
    return "ExpressionStatement"
}

# Parse `{ ... }` statements. The cursor is on the opening brace.
function parse_body(s: ptr<Src>) -> i32 {
    advance(s)
    while tk(s) != T_EOF and is_punct(s, "}") == false {
        if is_word(s, "let") or is_word(s, "var") or is_word(s, "const") {
            advance(s)
            if is_word(s, "mut") {
                advance(s)
            }
            let name: string = tt(s)
            advance(s)
            if is_punct(s, ":") {
                advance(s)
                while tk(s) != T_EOF and is_punct(s, "=") == false and tnl(s) == false {
                    if is_punct(s, "<") or is_punct(s, "[") or is_punct(s, "(") {
                        skip_type_group(s)
                    } else {
                        advance(s)
                    }
                }
            }
            if is_punct(s, "=") {
                advance(s)
                let init: i32 = parse_expr(s, false)
                if init < 0 {
                    return -1
                }
                new_stmt(s, S_LET, name, init)
            } else {
                new_stmt(s, S_LET, name, -1)
            }
        } elif is_word(s, "return") {
            advance(s)
            if tnl(s) or is_punct(s, "}") {
                new_stmt(s, S_RETURN, "", -1)
            } else {
                let value: i32 = parse_expr(s, false)
                if value < 0 {
                    return -1
                }
                new_stmt(s, S_RETURN, "", value)
            }
        } else {
            let word: string = tt(s)
            let mut cls: string = statement_class(word)
            if tk(s) == T_IDENT {
                let save: i32 = s[0].pos
                advance(s)
                if is_punct(s, "=") or is_punct(s, "+=") or is_punct(s, "-=") {
                    cls = "Assignment"
                }
                s[0].pos = save
            }
            new_stmt(s, S_OTHER, cls, -1)
            skip_statement(s)
        }
        if is_punct(s, ";") {
            advance(s)
        }
    }
    if is_punct(s, "}") == false {
        return parse_fail(s, "unterminated function body")
    }
    advance(s)
    return 0
}

# Skip a type argument or array group: <...>, [...] or (...).
function skip_type_group(s: ptr<Src>) -> void {
    let mut depth: i32 = 0
    while tk(s) != T_EOF {
        if is_punct(s, "<") or is_punct(s, "[") or is_punct(s, "(") {
            depth = depth + 1
        } elif is_punct(s, ">") or is_punct(s, "]") or is_punct(s, ")") {
            depth = depth - 1
            if depth == 0 {
                advance(s)
                return
            }
        } elif is_punct(s, "->") {
            # never inside a type group we care about
            depth = depth
        }
        advance(s)
    }
}

function add_param(s: ptr<Src>, name: string) -> void {
    if s[0].np == s[0].pcap {
        s[0].pcap = s[0].pcap * 2
        s[0].pnames = grow_str(s[0].pnames, s[0].pcap)
    }
    let p: ptr<string> = s[0].pnames
    p[s[0].np] = name
    s[0].np = s[0].np + 1
}

# Parse one `function` declaration; the cursor is on the keyword.
function parse_function(s: ptr<Src>) -> i32 {
    advance(s)
    let name: string = tt(s)
    advance(s)
    if is_punct(s, "<") {
        skip_type_group(s)
    }
    if is_punct(s, "(") == false {
        return parse_fail(s, "expected ( after function " + name)
    }
    advance(s)
    let pstart: i32 = s[0].np
    while tk(s) != T_EOF and is_punct(s, ")") == false {
        if is_word(s, "mut") {
            advance(s)
        }
        add_param(s, tt(s))
        advance(s)
        if is_punct(s, ":") {
            advance(s)
        }
        while tk(s) != T_EOF and is_punct(s, ",") == false and is_punct(s, ")") == false {
            if is_punct(s, "<") or is_punct(s, "[") or is_punct(s, "(") {
                skip_type_group(s)
            } else {
                advance(s)
            }
        }
        if is_punct(s, ",") {
            advance(s)
        }
    }
    advance(s)
    let mut ret: string = "void"
    if is_punct(s, "->") {
        advance(s)
        ret = tt(s)
    }
    while tk(s) != T_EOF and is_punct(s, "{") == false {
        if is_punct(s, "<") or is_punct(s, "[") or is_punct(s, "(") {
            skip_type_group(s)
        } else {
            advance(s)
        }
    }
    if s[0].nf == s[0].fcap {
        s[0].fcap = s[0].fcap * 2
        s[0].fname = grow_str(s[0].fname, s[0].fcap)
        s[0].fret = grow_str(s[0].fret, s[0].fcap)
        s[0].fpstart = grow_i32(s[0].fpstart, s[0].fcap)
        s[0].fpcount = grow_i32(s[0].fpcount, s[0].fcap)
        s[0].fsstart = grow_i32(s[0].fsstart, s[0].fcap)
        s[0].fscount = grow_i32(s[0].fscount, s[0].fcap)
    }
    let f: i32 = s[0].nf
    let fnm: ptr<string> = s[0].fname
    let frt: ptr<string> = s[0].fret
    let fps: ptr<i32> = s[0].fpstart
    let fpc: ptr<i32> = s[0].fpcount
    let fss: ptr<i32> = s[0].fsstart
    let fsc: ptr<i32> = s[0].fscount
    fnm[f] = name
    frt[f] = ret
    fps[f] = pstart
    fpc[f] = s[0].np - pstart
    fss[f] = s[0].ns
    s[0].nf = f + 1
    if parse_body(s) < 0 {
        return -1
    }
    fsc[f] = s[0].ns - fss[f]
    return f
}

function parse_source(text: string) -> ptr<Src> {
    let s: ptr<Src> = malloc(512) as ptr<Src>
    s[0].tcap = 256
    s[0].nt = 0
    s[0].tkind = new_i32(256)
    s[0].ttext = new_str(256)
    s[0].tnl = new_i32(256)
    s[0].pos = 0
    s[0].ecap = 256
    s[0].ne = 0
    s[0].ekind = new_i32(256)
    s[0].etext = new_str(256)
    s[0].ea = new_i32(256)
    s[0].eb = new_i32(256)
    s[0].eargs = new_i32(256)
    s[0].enargs = new_i32(256)
    s[0].argcap = 256
    s[0].nargs = 0
    s[0].args = new_i32(256)
    s[0].scap = 64
    s[0].ns = 0
    s[0].skind = new_i32(64)
    s[0].sname = new_str(64)
    s[0].sexpr = new_i32(64)
    s[0].fcap = 16
    s[0].nf = 0
    s[0].fname = new_str(16)
    s[0].fret = new_str(16)
    s[0].fpstart = new_i32(16)
    s[0].fpcount = new_i32(16)
    s[0].fsstart = new_i32(16)
    s[0].fscount = new_i32(16)
    s[0].pcap = 64
    s[0].np = 0
    s[0].pnames = new_str(64)
    s[0].err = ""
    lex(s, text)
    # Only top-level functions matter; everything else is skipped by
    # bracket depth.
    while tk(s) != T_EOF and ft_len(s[0].err) == 0 {
        if is_word(s, "function") {
            let _f: i32 = parse_function(s)
        } elif is_punct(s, "(") or is_punct(s, "[") or is_punct(s, "{") {
            skip_group(s)
        } else {
            advance(s)
        }
    }
    return s
}

# The last top-level function named `name`, as a dict built from the
# declarations would hold, or -1.
function find_function(s: ptr<Src>, name: string) -> i32 {
    let fnm: ptr<string> = s[0].fname
    let mut found: i32 = -1
    let mut i: i32 = 0
    while i < s[0].nf {
        if ft_eq(fnm[i], name) {
            found = i
        }
        i = i + 1
    }
    return found
}

function first_function(s: ptr<Src>, name: string) -> i32 {
    let fnm: ptr<string> = s[0].fname
    let mut i: i32 = 0
    while i < s[0].nf {
        if ft_eq(fnm[i], name) {
            return i
        }
        i = i + 1
    }
    return -1
}

# ---------------------------------------------------------------------------
# Tape construction
# ---------------------------------------------------------------------------

function tape_new(params: ptr<StrList>) -> ptr<Tape> {
    let t: ptr<Tape> = malloc(256) as ptr<Tape>
    t[0].cap = 256
    t[0].n = 0
    t[0].op = new_i32(256)
    t[0].na = new_i32(256)
    t[0].nb = new_i32(256)
    t[0].konst = new_str(256)
    t[0].params = params
    t[0].lcap = 64
    t[0].nl = 0
    t[0].lname = new_str(64)
    t[0].lnode = new_i32(64)
    t[0].err = ""
    return t
}

function tape_add(t: ptr<Tape>, op: i32, a: i32, b: i32, k: string) -> i32 {
    if t[0].n == t[0].cap {
        t[0].cap = t[0].cap * 2
        t[0].op = grow_i32(t[0].op, t[0].cap)
        t[0].na = grow_i32(t[0].na, t[0].cap)
        t[0].nb = grow_i32(t[0].nb, t[0].cap)
        t[0].konst = grow_str(t[0].konst, t[0].cap)
    }
    let i: i32 = t[0].n
    let ops: ptr<i32> = t[0].op
    let aa: ptr<i32> = t[0].na
    let bb: ptr<i32> = t[0].nb
    let ks: ptr<string> = t[0].konst
    ops[i] = op
    aa[i] = a
    bb[i] = b
    ks[i] = k
    t[0].n = i + 1
    return i
}

function tape_fail(t: ptr<Tape>, msg: string) -> i32 {
    if ft_len(t[0].err) == 0 {
        t[0].err = msg
    }
    return -1
}

function bind_local(t: ptr<Tape>, name: string, node: i32) -> void {
    if t[0].nl == t[0].lcap {
        t[0].lcap = t[0].lcap * 2
        t[0].lname = grow_str(t[0].lname, t[0].lcap)
        t[0].lnode = grow_i32(t[0].lnode, t[0].lcap)
    }
    let ln: ptr<string> = t[0].lname
    let lv: ptr<i32> = t[0].lnode
    ln[t[0].nl] = name
    lv[t[0].nl] = node
    t[0].nl = t[0].nl + 1
}

function lookup_local(t: ptr<Tape>, name: string) -> i32 {
    let ln: ptr<string> = t[0].lname
    let lv: ptr<i32> = t[0].lnode
    let mut i: i32 = t[0].nl - 1
    while i >= 0 {
        if ft_eq(ln[i], name) {
            return lv[i]
        }
        i = i - 1
    }
    return -1
}

function param_index(t: ptr<Tape>, name: string) -> i32 {
    let mut i: i32 = 0
    while i < ft_list_len(t[0].params) {
        if ft_eq(ft_list_get(t[0].params, i), name) {
            return i
        }
        i = i + 1
    }
    return -1
}

function builtin_op(name: string) -> i32 {
    if ft_eq(name, "sin") {
        return OP_SIN
    }
    if ft_eq(name, "cos") {
        return OP_COS
    }
    if ft_eq(name, "exp") {
        return OP_EXP
    }
    if ft_eq(name, "log") {
        return OP_LOG
    }
    if ft_eq(name, "sqrt") {
        return OP_SQRT
    }
    if ft_eq(name, "sigmoid") {
        return OP_SIGMOID
    }
    return -1
}

function has_byte(s: string, ch: i32) -> bool {
    return ft_find_byte(s, ch, 0) >= 0
}

# Python's Literal type for a numeric token: f32 when it has a fraction or
# an exponent.
function is_f32_literal(text: string) -> bool {
    return has_byte(text, 46) or has_byte(text, 101) or has_byte(text, 69)
}

function expr_class(s: ptr<Src>, e: i32) -> string {
    let k: ptr<i32> = s[0].ekind
    let t: ptr<string> = s[0].etext
    if k[e] == E_LIT {
        return "Literal"
    }
    if k[e] == E_OTHER {
        return t[e]
    }
    return "Expression"
}

# mode 0 = C (single-arg builtins only), 1 = Flow (inlines user functions).
function emit_expr(s: ptr<Src>, t: ptr<Tape>, e: i32, mode: i32) -> i32 {
    if ft_len(t[0].err) > 0 {
        return -1
    }
    let k: ptr<i32> = s[0].ekind
    let tx: ptr<string> = s[0].etext
    let aa: ptr<i32> = s[0].ea
    let bb: ptr<i32> = s[0].eb
    let kind: i32 = k[e]
    if kind == E_LIT {
        let v: string = tx[e]
        if is_f32_literal(v) == false {
            if mode == 0 {
                return tape_fail(t, "Prototype supports only f32 literals")
            }
            return tape_fail(t, "Only f32 literals supported")
        }
        if mode == 0 and ft_ends(v, "f") == false {
            return tape_add(t, OP_CONST, -1, -1, v + "f")
        }
        return tape_add(t, OP_CONST, -1, -1, v)
    }
    if kind == E_VAR {
        let name: string = tx[e]
        let local: i32 = lookup_local(t, name)
        if local >= 0 {
            return local
        }
        let pi: i32 = param_index(t, name)
        if pi < 0 {
            return tape_fail(t, "Unknown variable " + name)
        }
        return tape_add(t, OP_VAR + pi, -1, -1, "")
    }
    if kind == E_UNARY {
        if ft_eq(tx[e], "-") == false {
            if mode == 0 {
                return tape_fail(t, "Unsupported unary op: " + tx[e])
            }
            return tape_fail(t, "Unsupported unary op " + tx[e])
        }
        let x: i32 = emit_expr(s, t, aa[e], mode)
        if x < 0 {
            return -1
        }
        return tape_add(t, OP_NEG, x, -1, "")
    }
    if kind == E_BINARY {
        let a: i32 = emit_expr(s, t, aa[e], mode)
        if a < 0 {
            return -1
        }
        let b: i32 = emit_expr(s, t, bb[e], mode)
        if b < 0 {
            return -1
        }
        let op: string = tx[e]
        if ft_eq(op, "+") {
            return tape_add(t, OP_ADD, a, b, "")
        }
        if ft_eq(op, "-") {
            return tape_add(t, OP_SUB, a, b, "")
        }
        if ft_eq(op, "*") {
            return tape_add(t, OP_MUL, a, b, "")
        }
        if ft_eq(op, "/") {
            return tape_add(t, OP_DIV, a, b, "")
        }
        if mode == 0 {
            return tape_fail(t, "Unsupported binary op: " + op)
        }
        return tape_fail(t, "Unsupported binary op " + op)
    }
    if kind == E_CALL {
        let name2: string = tx[e]
        let ag: ptr<i32> = s[0].eargs
        let an: ptr<i32> = s[0].enargs
        let args: ptr<i32> = s[0].args
        let nargs: i32 = an[e]
        let bop: i32 = builtin_op(name2)
        if mode == 0 {
            if nargs != 1 {
                return tape_fail(t, "Only single-arg calls supported")
            }
            let x0: i32 = emit_expr(s, t, args[ag[e]], mode)
            if x0 < 0 {
                return -1
            }
            if bop < 0 {
                return tape_fail(t, "Unsupported call: " + name2)
            }
            return tape_add(t, bop, x0, -1, "")
        }
        if bop >= 0 {
            if nargs != 1 {
                return tape_fail(t, "Built-in " + name2 + " requires exactly 1 argument")
            }
            let x1: i32 = emit_expr(s, t, args[ag[e]], mode)
            if x1 < 0 {
                return -1
            }
            return tape_add(t, bop, x1, -1, "")
        }
        let f: i32 = find_function(s, name2)
        if f < 0 {
            return tape_fail(t, "Unknown function: " + name2)
        }
        let fpc: ptr<i32> = s[0].fpcount
        if nargs != fpc[f] {
            return tape_fail(t, "Argument count mismatch for " + name2)
        }
        return inline_call(s, t, f, ag[e], nargs)
    }
    if mode == 0 {
        return tape_fail(t, "Unsupported expression node: " + expr_class(s, e))
    }
    return tape_fail(t, "Unsupported expression node " + expr_class(s, e))
}

function inline_call(s: ptr<Src>, t: ptr<Tape>, f: i32, arg0: i32, nargs: i32) -> i32 {
    let saved: i32 = t[0].nl
    let fps: ptr<i32> = s[0].fpstart
    let pn: ptr<string> = s[0].pnames
    let args: ptr<i32> = s[0].args
    let fnm: ptr<string> = s[0].fname
    let mut i: i32 = 0
    while i < nargs {
        let v: i32 = emit_expr(s, t, args[arg0 + i], 1)
        if v < 0 {
            return -1
        }
        bind_local(t, pn[fps[f] + i], v)
        i = i + 1
    }
    let fss: ptr<i32> = s[0].fsstart
    let fsc: ptr<i32> = s[0].fscount
    let sk: ptr<i32> = s[0].skind
    let sn: ptr<string> = s[0].sname
    let se: ptr<i32> = s[0].sexpr
    let mut out: i32 = -1
    let mut j: i32 = fss[f]
    while j < fss[f] + fsc[f] {
        if sk[j] == S_LET {
            if se[j] < 0 {
                return tape_fail(t, "let initializer required in " + fnm[f])
            }
            let v2: i32 = emit_expr(s, t, se[j], 1)
            if v2 < 0 {
                return -1
            }
            bind_local(t, sn[j], v2)
        } elif sk[j] == S_RETURN {
            if se[j] < 0 {
                return tape_fail(t, "return value required in " + fnm[f])
            }
            out = emit_expr(s, t, se[j], 1)
            if out < 0 {
                return -1
            }
            break
        }
        j = j + 1
    }
    t[0].nl = saved
    if out < 0 {
        return tape_fail(t, "No return in " + fnm[f])
    }
    return out
}

# Emit the differentiated function's body; returns the output node.
function emit_body(s: ptr<Src>, t: ptr<Tape>, f: i32, mode: i32) -> i32 {
    let fss: ptr<i32> = s[0].fsstart
    let fsc: ptr<i32> = s[0].fscount
    let sk: ptr<i32> = s[0].skind
    let sn: ptr<string> = s[0].sname
    let se: ptr<i32> = s[0].sexpr
    let mut out: i32 = -1
    let mut j: i32 = fss[f]
    while j < fss[f] + fsc[f] {
        if sk[j] == S_LET {
            if se[j] < 0 {
                if mode == 0 {
                    return tape_fail(t, "Prototype requires let initializers")
                }
                return tape_fail(t, "let initializer required")
            }
            let v: i32 = emit_expr(s, t, se[j], mode)
            if v < 0 {
                return -1
            }
            bind_local(t, sn[j], v)
        } elif sk[j] == S_RETURN {
            if se[j] < 0 {
                if mode == 0 {
                    return tape_fail(t, "Prototype requires return value")
                }
                return tape_fail(t, "return value required")
            }
            out = emit_expr(s, t, se[j], mode)
            if out < 0 {
                return -1
            }
        } else {
            if mode == 0 {
                return tape_fail(t, "Unsupported statement in prototype: " + sn[j])
            }
            return tape_fail(t, "Unsupported statement " + sn[j])
        }
        j = j + 1
    }
    if out < 0 {
        if mode == 0 {
            return tape_fail(t, "No return found")
        }
        return tape_fail(t, "No return")
    }
    return out
}

# ---------------------------------------------------------------------------
# C output (the retired flow_grad_c.py)
# ---------------------------------------------------------------------------

function gen_c(t: ptr<Tape>, out_idx: i32) -> void {
    let params: ptr<StrList> = t[0].params
    let ops: ptr<i32> = t[0].op
    let aa: ptr<i32> = t[0].na
    let bb: ptr<i32> = t[0].nb
    let ks: ptr<string> = t[0].konst
    let n: i32 = t[0].n
    let np: i32 = ft_list_len(params)

    ft_outln("#include <math.h>")
    ft_outln("#include <stdio.h>")
    ft_outln("#include <stdlib.h>")
    ft_outln("")
    ft_outln("typedef struct { int op; int a; int b; float val; float adj; } Node;")
    ft_outln("")
    ft_outln("#define N " + ft_itoa(n))
    ft_outln("#define NV " + ft_itoa(np))
    ft_outln("")
    ft_outln("static inline float sigmoidf(float x) { return 1.0f / (1.0f + expf(-x)); }")
    ft_outln("int main(int argc, char** argv) {")
    ft_outln("  if (argc != NV + 1) {")
    ft_outln("    fprintf(stderr, \"usage: %s\", argv[0]);")
    ft_outln("    for (int i=0;i<NV;i++) fprintf(stderr, \" x%d\", i);")
    ft_outln("    fprintf(stderr, \"\\n\");")
    ft_outln("    return 2;")
    ft_outln("  }")
    ft_outln("  float x[NV];")
    let mut i: i32 = 0
    while i < np {
        ft_outln("  x[" + ft_itoa(i) + "] = (float)atof(argv[" + ft_itoa(i + 1) + "]);")
        i = i + 1
    }
    ft_outln("  Node t[N];")
    i = 0
    while i < n {
        let mut v: string = "0.0f"
        if ops[i] == OP_CONST {
            v = ks[i]
        }
        let si: string = ft_itoa(i)
        ft_outln("  t[" + si + "].op = " + ft_itoa(ops[i]) + "; t[" + si + "].a = " + ft_itoa(aa[i]) + "; t[" + si + "].b = " + ft_itoa(bb[i]) + "; t[" + si + "].val = " + v + "; t[" + si + "].adj = 0.0f;")
        i = i + 1
    }
    ft_outln("\n  // forward")
    ft_outln("  for (int i=0;i<N;i++) {")
    ft_outln("    int op = t[i].op;")
    ft_outln("    if (op >= 1000) { t[i].val = x[op-1000]; continue; }")
    ft_outln("    switch (op) {")
    ft_outln("      case 0: /* const */ break;")
    ft_outln("      case 1: t[i].val = t[t[i].a].val + t[t[i].b].val; break;")
    ft_outln("      case 2: t[i].val = t[t[i].a].val - t[t[i].b].val; break;")
    ft_outln("      case 3: t[i].val = t[t[i].a].val * t[t[i].b].val; break;")
    ft_outln("      case 4: t[i].val = t[t[i].a].val / t[t[i].b].val; break;")
    ft_outln("      case 5: t[i].val = -t[t[i].a].val; break;")
    ft_outln("      case 6: t[i].val = sinf(t[t[i].a].val); break;")
    ft_outln("      case 7: t[i].val = cosf(t[t[i].a].val); break;")
    ft_outln("      case 8: t[i].val = expf(t[t[i].a].val); break;")
    ft_outln("      case 9: t[i].val = logf(t[t[i].a].val); break;")
    ft_outln("      case 10: t[i].val = sqrtf(t[t[i].a].val); break;")
    ft_outln("      case 11: t[i].val = sigmoidf(t[t[i].a].val); break;")
    ft_outln("      default: fprintf(stderr, \"bad op %d\\n\", op); return 3;")
    ft_outln("    }")
    ft_outln("  }")
    ft_outln("\n  // backward")
    ft_outln("  t[" + ft_itoa(out_idx) + "].adj = 1.0f;")
    ft_outln("  float g[NV]; for (int i=0;i<NV;i++) g[i]=0.0f;")
    ft_outln("  for (int i=N-1;i>=0;i--) {")
    ft_outln("    int op = t[i].op;")
    ft_outln("    float adj = t[i].adj;")
    ft_outln("    if (op >= 1000) { g[op-1000] += adj; continue; }")
    ft_outln("    switch (op) {")
    ft_outln("      case 0: break;")
    ft_outln("      case 1: t[t[i].a].adj += adj; t[t[i].b].adj += adj; break;")
    ft_outln("      case 2: t[t[i].a].adj += adj; t[t[i].b].adj -= adj; break;")
    ft_outln("      case 3: t[t[i].a].adj += adj * t[t[i].b].val; t[t[i].b].adj += adj * t[t[i].a].val; break;")
    ft_outln("      case 4: {")
    ft_outln("        float a = t[t[i].a].val; float b = t[t[i].b].val;")
    ft_outln("        t[t[i].a].adj += adj * (1.0f/b);")
    ft_outln("        t[t[i].b].adj += adj * (-a/(b*b));")
    ft_outln("        break; }")
    ft_outln("      case 5: t[t[i].a].adj += -adj; break;")
    ft_outln("      case 6: t[t[i].a].adj += adj * cosf(t[t[i].a].val); break;")
    ft_outln("      case 7: t[t[i].a].adj += adj * (-sinf(t[t[i].a].val)); break;")
    ft_outln("      case 8: t[t[i].a].adj += adj * expf(t[t[i].a].val); break;")
    ft_outln("      case 9: t[t[i].a].adj += adj * (1.0f / t[t[i].a].val); break;")
    ft_outln("      case 10: t[t[i].a].adj += adj * (0.5f / sqrtf(t[t[i].a].val)); break;")
    ft_outln("      case 11: {")
    ft_outln("        float y = t[i].val; /* sigmoid(x) */")
    ft_outln("        t[t[i].a].adj += adj * (y * (1.0f - y));")
    ft_outln("        break; }")
    ft_outln("      default: break;")
    ft_outln("    }")
    ft_outln("  }")
    ft_outln("\n  printf(\"value = %.7g\\n\", t[" + ft_itoa(out_idx) + "].val);")
    i = 0
    while i < np {
        ft_outln("  printf(\"d/d" + ft_list_get(params, i) + " = %.7g\\n\", g[" + ft_itoa(i) + "]);")
        i = i + 1
    }
    ft_outln("  return 0;")
    ft_outln("}")
}

# ---------------------------------------------------------------------------
# Flow output (the retired flow_grad_flow.py)
# ---------------------------------------------------------------------------

function tv(i: i32) -> string {
    return "t" + ft_itoa(i)
}

function op_name(op: i32) -> string {
    if op == OP_SIN {
        return "sin"
    }
    if op == OP_COS {
        return "cos"
    }
    if op == OP_EXP {
        return "exp"
    }
    if op == OP_LOG {
        return "log"
    }
    return "sqrt"
}

function join_plus(l: ptr<StrList>) -> string {
    if ft_list_len(l) == 0 {
        return "0.0"
    }
    let mut out: string = ft_list_get(l, 0)
    let mut i: i32 = 1
    while i < ft_list_len(l) {
        out = out + " + " + ft_list_get(l, i)
        i = i + 1
    }
    return out
}

function gen_flow(t: ptr<Tape>, fname: string, out_idx: i32) -> string {
    let params: ptr<StrList> = t[0].params
    let ops: ptr<i32> = t[0].op
    let aa: ptr<i32> = t[0].na
    let bb: ptr<i32> = t[0].nb
    let ks: ptr<string> = t[0].konst
    let n: i32 = t[0].n
    let np: i32 = ft_list_len(params)

    let vals: ptr<string> = new_str(n + 1)
    let mut i: i32 = 0
    while i < n {
        let op: i32 = ops[i]
        if op == OP_CONST {
            vals[i] = ks[i]
        } elif op >= OP_VAR {
            vals[i] = ft_list_get(params, op - OP_VAR)
        } elif op == OP_ADD {
            vals[i] = "(" + tv(aa[i]) + " + " + tv(bb[i]) + ")"
        } elif op == OP_SUB {
            vals[i] = "(" + tv(aa[i]) + " - " + tv(bb[i]) + ")"
        } elif op == OP_MUL {
            vals[i] = "(" + tv(aa[i]) + " * " + tv(bb[i]) + ")"
        } elif op == OP_DIV {
            vals[i] = "(" + tv(aa[i]) + " / " + tv(bb[i]) + ")"
        } elif op == OP_NEG {
            vals[i] = "(-1.0 * " + tv(aa[i]) + ")"
        } elif op == OP_SIGMOID {
            vals[i] = "(1.0 / (1.0 + exp(-1.0 * " + tv(aa[i]) + ")))"
        } else {
            vals[i] = op_name(op) + "(" + tv(aa[i]) + ")"
        }
        i = i + 1
    }

    # Reverse-mode adjoints: contributions per node, propagated high to low.
    let contrib: ptr<ptr<StrList>> = malloc(((n + 1) as i64) * 8) as ptr<ptr<StrList>>
    i = 0
    while i < n {
        contrib[i] = ft_list_new()
        i = i + 1
    }
    ft_list_push(contrib[out_idx], "1.0")
    i = n - 1
    while i >= 0 {
        let op2: i32 = ops[i]
        let ai: string = join_plus(contrib[i])
        let skip: bool = ft_eq(ai, "0.0") or op2 == OP_CONST or op2 >= OP_VAR
        if skip == false {
            let a: i32 = aa[i]
            let b: i32 = bb[i]
            let pa: string = "(" + ai + ")"
            if op2 == OP_ADD {
                ft_list_push(contrib[a], pa)
                ft_list_push(contrib[b], pa)
            } elif op2 == OP_SUB {
                ft_list_push(contrib[a], pa)
                ft_list_push(contrib[b], "(-1.0 * " + pa + ")")
            } elif op2 == OP_MUL {
                ft_list_push(contrib[a], pa + " * " + tv(b))
                ft_list_push(contrib[b], pa + " * " + tv(a))
            } elif op2 == OP_DIV {
                ft_list_push(contrib[a], pa + " * (1.0 / " + tv(b) + ")")
                ft_list_push(contrib[b], pa + " * (-1.0 * " + tv(a) + " / (" + tv(b) + " * " + tv(b) + "))")
            } elif op2 == OP_NEG {
                ft_list_push(contrib[a], "(-1.0 * " + pa + ")")
            } elif op2 == OP_SIN {
                ft_list_push(contrib[a], pa + " * cos(" + tv(a) + ")")
            } elif op2 == OP_COS {
                ft_list_push(contrib[a], pa + " * (-1.0 * sin(" + tv(a) + "))")
            } elif op2 == OP_EXP {
                ft_list_push(contrib[a], pa + " * exp(" + tv(a) + ")")
            } elif op2 == OP_LOG {
                ft_list_push(contrib[a], pa + " * (1.0 / " + tv(a) + ")")
            } elif op2 == OP_SQRT {
                ft_list_push(contrib[a], pa + " * (0.5 / sqrt(" + tv(a) + "))")
            } elif op2 == OP_SIGMOID {
                ft_list_push(contrib[a], pa + " * (" + tv(i) + " * (1.0 - " + tv(i) + "))")
            }
        }
        i = i - 1
    }

    let sname: string = "Grad_" + fname
    let gname: string = "grad_" + fname
    let mut out: string = "struct " + sname + " {\n"
    out = out + "    value: f32,\n"
    i = 0
    while i < np {
        out = out + "    d_" + ft_list_get(params, i) + ": f32,\n"
        i = i + 1
    }
    out = out + "}\n\n"

    let mut sig: string = ""
    i = 0
    while i < np {
        if i > 0 {
            sig = sig + ", "
        }
        sig = sig + ft_list_get(params, i) + ": f32"
        i = i + 1
    }
    out = out + "function " + gname + "(" + sig + ") -> " + sname + " {\n"
    i = 0
    while i < n {
        out = out + "    let " + tv(i) + ": f32 = " + vals[i] + "\n"
        i = i + 1
    }
    out = out + "\n    # reverse-mode adjoints\n"
    i = n - 1
    while i >= 0 {
        out = out + "    let adj" + ft_itoa(i) + ": f32 = " + join_plus(contrib[i]) + "\n"
        i = i - 1
    }
    out = out + "\n"
    let mut p: i32 = 0
    while p < np {
        let mut sum: string = ""
        i = 0
        while i < n {
            if ops[i] == OP_VAR + p {
                if ft_len(sum) > 0 {
                    sum = sum + " + "
                }
                sum = sum + "adj" + ft_itoa(i)
            }
            i = i + 1
        }
        if ft_len(sum) == 0 {
            sum = "0.0"
        }
        out = out + "    let d_" + ft_list_get(params, p) + ": f32 = " + sum + "\n"
        p = p + 1
    }
    out = out + "\n    return " + sname + " {\n"
    out = out + "        value: " + tv(out_idx) + ",\n"
    i = 0
    while i < np {
        let pn: string = ft_list_get(params, i)
        out = out + "        d_" + pn + ": d_" + pn + ",\n"
        i = i + 1
    }
    out = out + "    }\n}\n\n"
    out = out + "function " + gname + "_get(g: " + sname + ", idx: i32) -> f32 {\n"
    i = 0
    while i < np {
        out = out + "    if idx == " + ft_itoa(i) + " { return g.d_" + ft_list_get(params, i) + " }\n"
        i = i + 1
    }
    out = out + "    return 0.0\n}\n"
    return out
}

# ---------------------------------------------------------------------------
# Entry
# ---------------------------------------------------------------------------

function die(msg: string) -> i32 {
    ft_errln(msg)
    return 1
}

function main(argc: i32, argv: ptr<ptr<u8>>) -> i32 {
    if argc != 4 {
        ft_errln("usage: flow tool grad {c|flow} <file.flow> <function_name>")
        return 2
    }
    let mode_arg: string = argv[1] as string
    let mut mode: i32 = -1
    if ft_eq(mode_arg, "c") {
        mode = 0
    } elif ft_eq(mode_arg, "flow") {
        mode = 1
    }
    if mode < 0 {
        ft_errln("usage: flow tool grad {c|flow} <file.flow> <function_name>")
        return 2
    }
    let path: string = argv[2] as string
    let fn_name: string = argv[3] as string
    let text: string = ft_read_file(path)
    if text as ptr<u8> == null {
        return die("cannot read " + path)
    }
    let s: ptr<Src> = parse_source(text)
    if ft_len(s[0].err) > 0 {
        return die(path + ": " + s[0].err)
    }

    let mut f: i32 = -1
    if mode == 0 {
        f = first_function(s, fn_name)
    } else {
        f = find_function(s, fn_name)
    }
    if f < 0 {
        return die("Function " + fn_name + " not found")
    }
    let frt: ptr<string> = s[0].fret
    if mode == 1 and ft_eq(frt[f], "f32") == false {
        return die("Prototype expects f32 return")
    }
    let fps: ptr<i32> = s[0].fpstart
    let fpc: ptr<i32> = s[0].fpcount
    let pn: ptr<string> = s[0].pnames
    let params: ptr<StrList> = ft_list_new()
    let mut i: i32 = 0
    while i < fpc[f] {
        ft_list_push(params, pn[fps[f] + i])
        i = i + 1
    }
    if mode == 0 and ft_list_len(params) == 0 {
        return die("Need at least 1 parameter")
    }

    let t: ptr<Tape> = tape_new(params)
    let out_idx: i32 = emit_body(s, t, f, mode)
    if out_idx < 0 {
        return die(t[0].err)
    }
    if mode == 0 {
        gen_c(t, out_idx)
    } else {
        let fnm: ptr<string> = s[0].fname
        ft_out(gen_flow(t, fnm[f], out_idx))
    }
    return 0
}
