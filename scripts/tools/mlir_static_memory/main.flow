# Emit a static scratchpad plan as MLIR memref views.
#
# This is the MLIR-facing consumer of compiler/src/static_memory.flow. The
# planner owns the lifetime and offset calculation. This tool only serializes
# the resulting arena and views.

import "compiler/src/static_memory.flow"
import "scripts/tools/mlir_tune/text.flow"

function parse_num(s: string) -> i32 {
    let mut n: i32 = 0
    let mut i: i32 = 0
    while s[i] != 0 {
        if s[i] < 48 or s[i] > 57 {
            return -1
        }
        n = n * 10 + (s[i] - 48)
        i = i + 1
    }
    return n
}

function parse_csv3(s: string, out: ptr<i32>) -> i32 {
    let first: i32 = ft_find_byte(s, 44, 0)
    if first < 1 { return 0 }
    let second: i32 = ft_find_byte(s, 44, first + 1)
    if second <= first + 1 { return 0 }
    out[0] = parse_num(ft_slice(s, 0, first))
    out[1] = parse_num(ft_slice(s, first + 1, second))
    out[2] = parse_num(ft_from(s, second + 1))
    if out[0] < 0 or out[1] < 0 or out[2] < 0 {
        return 0
    }
    return 3
}

function emit_view(out: string, arena: i32, index: i32, offset: i32, size: i32) -> string {
    return out + "    %buf" + ft_itoa(index) + " = memref.subview %arena[" +
        ft_itoa(offset) + "][" + ft_itoa(size) + "][1] : memref<" +
        ft_itoa(arena) + "xi8> to memref<" + ft_itoa(size) +
        "xi8, strided<[1], offset: " + ft_itoa(offset) + ">>\n"
}

function emit_module(items: array<StaticBuffer, 64>, plan: StaticMemoryPlan, target: string, space: string) -> string {
    let mut out: string = "module attributes {flow.static_arena_bytes = " +
        ft_itoa(plan.arena_size) + ", flow.static_buffer_count = " +
        ft_itoa(plan.count) + ", flow.static_memory_target = \"" + target +
        "\", flow.static_memory_space = \"" + space + "\"} {\n  func.func @flow_static_buffers() {\n"
    out = out + "    %arena = memref.alloca() : memref<" +
        ft_itoa(plan.arena_size) + "xi8>\n"
    let mut i: i32 = 0
    while i < plan.count {
        out = emit_view(out, plan.arena_size, i, plan.offsets[i], items[i].size)
        i = i + 1
    }
    out = out + "    return\n  }\n}\n"
    return out
}

function main(argc: i32, argv: ptr<ptr<u8>>) -> i32 {
    let mut sizes: array<i32, 3> = [64, 32, 48]
    let mut target: string = "cpu"
    let mut space: string = "stack"
    let mut i: i32 = 1
    while i < argc {
        let arg: string = argv[i] as string
        if ft_starts(arg, "--sizes=") {
            if parse_csv3(ft_from(arg, 8), &sizes[0]) != 3 {
                ft_errln("mlir_static_memory: --sizes expects a,b,c")
                return 2
            }
        } elif ft_starts(arg, "--target=") {
            target = ft_from(arg, 9)
        } elif ft_starts(arg, "--memory-space=") {
            space = ft_from(arg, 15)
        }
        i = i + 1
    }
    if sizes[0] <= 0 or sizes[1] <= 0 or sizes[2] <= 0 {
        ft_errln("mlir_static_memory: sizes must be positive")
        return 2
    }
    if not ft_eq(target, "cpu") and not ft_eq(target, "gpu") and
       not ft_eq(target, "nvptx") and not ft_eq(target, "amdgpu") {
        ft_errln("mlir_static_memory: --target must be one of 'cpu', 'gpu', 'nvptx', 'amdgpu'")
        return 2
    }
    if not ft_eq(space, "stack") and not ft_eq(space, "shared") {
        ft_errln("mlir_static_memory: --memory-space must be 'stack' or 'shared'")
        return 2
    }
    if ft_eq(space, "shared") and ft_eq(target, "cpu") {
        ft_errln("mlir_static_memory: shared memory requires a GPU target")
        return 2
    }
    let mut items: array<StaticBuffer, 64> = []
    items[0] = StaticBuffer { size: sizes[0], start: 0, end: 2, alignment: 16 }
    items[1] = StaticBuffer { size: sizes[1], start: 3, end: 5, alignment: 16 }
    items[2] = StaticBuffer { size: sizes[2], start: 1, end: 4, alignment: 16 }
    let plan: StaticMemoryPlan = flowc_static_memory_plan(items, 3, 16)
    ft_outln(emit_module(items, plan, target, space))
    return 0
}
