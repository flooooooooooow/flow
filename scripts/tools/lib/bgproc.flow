# @module tools.bgproc
# @means  Background processes, binary files and a raw TCP client for the
#         test runners under tests/tools (the parts std.process does not
#         cover: a server left running while the runner drives it, a child
#         whose stdin the runner writes over time, bytes with NULs in them).
#
# Like tools/flow_cli/sys.flow, which the runners also import, the POSIX
# calls live in a C shim with private names, so no prototype clashes with
# the system headers. The shim spells C strings as char arrays because
# @cEmbed text cannot hold a double quote (#1089).

@cEmbed("#include <errno.h>
#include <fcntl.h>
#include <signal.h>
#include <poll.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <arpa/inet.h>
#include <unistd.h>
static const char bgp_devnull[] = {'/', 'd', 'e', 'v', '/', 'n', 'u', 'l', 'l', 0};
static int32_t bgp_spawn(const char **argv, const char *cwd, int32_t want_pipe, const char *out_path, const char *err_path, int32_t *in_fd) {
  int fds[2] = {-1, -1};
  if (want_pipe && pipe(fds) != 0) { return -1; }
  pid_t pid = fork();
  if (pid < 0) { return -1; }
  if (pid == 0) {
    if (cwd != 0 && cwd[0] != 0 && chdir(cwd) != 0) { _exit(127); }
    int in = want_pipe ? fds[0] : open(bgp_devnull, O_RDONLY);
    int out = open(out_path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    int err = open(err_path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (in < 0 || out < 0 || err < 0) { _exit(127); }
    dup2(in, 0); dup2(out, 1); dup2(err, 2);
    if (want_pipe) { close(fds[1]); }
    signal(SIGPIPE, SIG_DFL);
    execvp(argv[0], (char *const *)argv);
    _exit(127);
  }
  if (want_pipe) { close(fds[0]); *in_fd = fds[1]; } else { *in_fd = -1; }
  return (int32_t)pid;
}
static int32_t bgp_status_code(int st) {
  if (WIFSIGNALED(st)) { return 128 + WTERMSIG(st); }
  return WEXITSTATUS(st);
}
static int32_t bgp_wait(int32_t pid) {
  int st = 0;
  while (waitpid((pid_t)pid, &st, 0) < 0) { if (errno != EINTR) { return -1; } }
  return bgp_status_code(st);
}
static int32_t bgp_poll_exit(int32_t pid) {
  int st = 0;
  pid_t w = waitpid((pid_t)pid, &st, WNOHANG);
  if (w == 0) { return -1; }
  if (w < 0) { return -2; }
  return bgp_status_code(st);
}
static int32_t bgp_kill(int32_t pid, int32_t sig) { return kill((pid_t)pid, sig) == 0 ? 0 : -1; }
static void bgp_ignore_sigpipe(void) { signal(SIGPIPE, SIG_IGN); }
static int64_t bgp_write_fd(int32_t fd, uint8_t *buf, int64_t n) {
  int64_t off = 0;
  while (off < n) {
    ssize_t w = write(fd, buf + off, (size_t)(n - off));
    if (w < 0) { if (errno == EINTR) { continue; } return -1; }
    off += (int64_t)w;
  }
  return off;
}
static void bgp_close(int32_t fd) { if (fd >= 0) { close(fd); } }
static int32_t bgp_symlink(const char *target, const char *path) { return symlink(target, path) == 0 ? 0 : -1; }
static int32_t bgp_write_file(const char *p, uint8_t *buf, int64_t n) {
  int fd = open(p, O_WRONLY | O_CREAT | O_TRUNC, 0644);
  if (fd < 0) { return -1; }
  int64_t w = bgp_write_fd(fd, buf, n);
  close(fd);
  return w == n ? 0 : -1;
}
static uint8_t *bgp_tcp_exchange(int32_t port, uint8_t *req, int64_t n, int32_t timeout_ms, int64_t *len) {
  *len = -1;
  int fd = socket(AF_INET, SOCK_STREAM, 0);
  if (fd < 0) { return 0; }
  struct sockaddr_in a;
  memset(&a, 0, sizeof a);
  a.sin_family = AF_INET;
  a.sin_port = htons((uint16_t)port);
  a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
  if (connect(fd, (struct sockaddr *)&a, sizeof a) != 0) { close(fd); return 0; }
  if (bgp_write_fd(fd, req, n) < 0) { close(fd); return 0; }
  size_t cap = 65536, got = 0; uint8_t *buf = (uint8_t *)malloc(cap + 1);
  for (;;) {
    struct pollfd p; p.fd = fd; p.events = POLLIN; p.revents = 0;
    int r = poll(&p, 1, timeout_ms);
    if (r < 0 && errno == EINTR) { continue; }
    if (r <= 0) { break; }
    if (got == cap) { cap *= 2; buf = (uint8_t *)realloc(buf, cap + 1); }
    ssize_t k = read(fd, buf + got, cap - got);
    if (k < 0 && errno == EINTR) { continue; }
    if (k <= 0) { break; }
    got += (size_t)k;
  }
  close(fd);
  buf[got] = 0;
  *len = (int64_t)got;
  return buf;
}
")

extern {
    function bgp_spawn(argv: ptr<string>, cwd: string, want_pipe: i32, out_path: string, err_path: string, in_fd: ptr<i32>) -> i32
    function bgp_wait(pid: i32) -> i32
    function bgp_poll_exit(pid: i32) -> i32
    function bgp_kill(pid: i32, sig: i32) -> i32
    function bgp_ignore_sigpipe() -> void
    function bgp_write_fd(fd: i32, buf: ptr<u8>, n: i64) -> i64
    function bgp_close(fd: i32) -> void
    function bgp_symlink(target: string, path: string) -> i32
    function bgp_write_file(p: string, buf: ptr<u8>, n: i64) -> i32
    function bgp_tcp_exchange(port: i32, req: ptr<u8>, n: i64, timeout_ms: i32, len: ptr<i64>) -> ptr<u8>
    function malloc(size: i64) -> ptr<void>
}

# A child started in the background. `stdin_fd` is the write end of its
# stdin pipe, or -1 when its stdin is /dev/null.
export struct BgProc {
    pid: i32,
    stdin_fd: i32
}

# Start `argv` (NULL-terminated, as ProcStrs.items) in `cwd` ("" for this
# directory) with stdout and stderr written to files. With `pipe_stdin` the
# caller writes the child's stdin through bg_write; otherwise it reads
# /dev/null. pid is -1 when the child could not be started.
export function bg_start(argv: ptr<string>, cwd: string, pipe_stdin: bool, out_path: string, err_path: string) -> BgProc {
    let fd: ptr<i32> = malloc(4) as ptr<i32>
    fd[0] = 0 - 1
    let mut want: i32 = 0
    if pipe_stdin {
        want = 1
    }
    let pid: i32 = bgp_spawn(argv, cwd, want, out_path, err_path, fd)
    return BgProc { pid: pid, stdin_fd: fd[0] }
}

# Write `n` bytes to fd; false when the reader has gone.
export function bg_write(fd: i32, data: ptr<u8>, n: i64) -> bool {
    return bgp_write_fd(fd, data, n) == n
}

export function bg_close(fd: i32) {
    bgp_close(fd)
}

# ln -s target path
export function bg_symlink(target: string, path: string) -> bool {
    return bgp_symlink(target, path) == 0
}

# Wait for the child; its status as a shell reports it (128 + N for signal N).
export function bg_wait(pid: i32) -> i32 {
    return bgp_wait(pid)
}

# The child's status when it has exited, -1 while it runs, -2 when there is
# no such child.
export function bg_poll(pid: i32) -> i32 {
    return bgp_poll_exit(pid)
}

# kill(2); true when the signal was sent.
export function bg_kill(pid: i32, sig: i32) -> bool {
    return bgp_kill(pid, sig) == 0
}

# A write to a closed pipe or socket fails with EPIPE instead of killing
# this program.
export function bg_ignore_sigpipe() {
    bgp_ignore_sigpipe()
}

# Write `n` bytes, NULs included, to a new file at `p`.
export function bg_write_file(p: string, data: ptr<u8>, n: i64) -> bool {
    return bgp_write_file(p, data, n) == 0
}

# Received bytes; len is -1 when the connection failed.
export struct BgBytes {
    data: ptr<u8>,
    len: i64
}

# Connect to 127.0.0.1:port, send `n` bytes and read until the peer closes
# (or nothing arrives for `timeout_ms`).
export function bg_tcp_exchange(port: i32, req: ptr<u8>, n: i64, timeout_ms: i32) -> BgBytes {
    let lp: ptr<i64> = malloc(8) as ptr<i64>
    let d: ptr<u8> = bgp_tcp_exchange(port, req, n, timeout_ms, lp)
    return BgBytes { data: d, len: lp[0] }
}
