# @module tools.wiki_stdlib
# @means  Generate docs/library/stdlib-api.md from lib/stdlib/*.flow export
#         signatures, attaching the `#` comment block above each export.
#
# Shared by scripts/tools/gen_stdlib_docs (standalone) and
# scripts/tools/build_wiki (which refreshes the page before every build).
# The scanners below follow the Python regexes the original script used,
# under re.MULTILINE, including their backtracking.

import .text { ft_out, ft_outln, ft_len, ft_eq, ft_at, ft_slice, ft_from, ft_itoa, ft_starts, ft_contains, ft_replace, ft_list_new, ft_list_push, ft_list_len, ft_list_get, StrList }
import .unicode { uc_decode, uc_len, uc_is_space, uc_is_word, uc_strip }
import .proc { pr_quote, pr_mkdir_p }
import .wiki_util { wb_new, wb_add, wb_line, wb_write, wu_read_text, wu_splitlines, wu_lstrip_set, wu_sort, wu_lines_of, wu_today, wu_ellipsis, WBuf }

extern {
    function malloc(size: i64) -> ptr<void>
    function strlen(s: string) -> i64
}

# End of a run of Unicode whitespace starting at `at`.
function sd_ws(p: ptr<u8>, at: i32) -> i32 {
    let mut q: i32 = at
    while p[q] != 0 and uc_is_space(uc_decode(p, q)) {
        q = q + uc_len(p[q] as i32)
    }
    return q
}

# End of a run of \w characters starting at `at`.
function sd_word(p: ptr<u8>, at: i32) -> i32 {
    let mut q: i32 = at
    while p[q] != 0 and uc_is_word(uc_decode(p, q)) {
        q = q + uc_len(p[q] as i32)
    }
    return q
}

# `^export\s+<kw>\s+` at line start `at`; returns the offset after it or -1.
function sd_head(src: string, p: ptr<u8>, at: i32, kw: string) -> i32 {
    if ft_at(src, at, "export") == false {
        return -1
    }
    let a: i32 = at + 6
    let b: i32 = sd_ws(p, a)
    if b == a or ft_at(src, b, kw) == false {
        return -1
    }
    let c: i32 = b + ft_len(kw)
    let d: i32 = sd_ws(p, c)
    if d == c {
        return -1
    }
    return d
}

struct SdFn {
    name: string
    params: string
    ret: string
    doc: string
}

struct SdInfo {
    doc: string
    structs: ptr<StrList>
    traits: ptr<StrList>
    effects: ptr<StrList>
    caps: ptr<StrList>
    const_names: ptr<StrList>
    const_types: ptr<StrList>
    fns: ptr<SdFn>
    nfns: i32
    capfns: i32
}

# findall for ^export\s+<kw>\s+(\w+) (with an optional \s*\{ tail).
function sd_names(src: string, kw: string, need_brace: bool) -> ptr<StrList> {
    let out: ptr<StrList> = ft_list_new()
    let p: ptr<u8> = src as ptr<u8>
    let n: i32 = ft_len(src)
    let mut pos: i32 = 0
    let mut done_to: i32 = 0
    while pos < n {
        if pos >= done_to and (pos == 0 or p[pos - 1] == 10) {
            let h: i32 = sd_head(src, p, pos, kw)
            if h >= 0 {
                let e: i32 = sd_word(p, h)
                if e > h {
                    if need_brace {
                        let q: i32 = sd_ws(p, e)
                        if p[q] == 123 {
                            ft_list_push(out, ft_slice(src, h, e))
                            done_to = q + 1
                        }
                    } else {
                        ft_list_push(out, ft_slice(src, h, e))
                        done_to = e
                    }
                }
            }
        }
        pos = pos + 1
    }
    return out
}

# Contiguous `#` comment lines immediately above byte offset `start`.
function sd_preceding(src: string, start: i32) -> string {
    let p: ptr<u8> = src as ptr<u8>
    let mut e: i32 = start
    while e > 0 and p[e - 1] == 10 {
        e = e - 1
    }
    if e == 0 {
        return ""
    }
    let lines: ptr<StrList> = wu_splitlines(ft_slice(src, 0, e))
    let mut i: i32 = ft_list_len(lines) - 1
    while i >= 0 and ft_len(uc_strip(ft_list_get(lines, i))) == 0 {
        i = i - 1
    }
    let block: ptr<StrList> = ft_list_new()
    while i >= 0 {
        let st: string = uc_strip(ft_list_get(lines, i))
        if ft_starts(st, "#") {
            ft_list_push(block, uc_strip(wu_lstrip_set(st, "# ")))
            i = i - 1
            continue
        }
        break
    }
    let mut joined: string = ""
    let mut taken: i32 = 0
    let mut k: i32 = ft_list_len(block) - 1
    while k >= 0 and taken < 4 {
        let piece: string = ft_list_get(block, k)
        if ft_len(piece) > 0 and sd_only_rules(piece) == false {
            if taken > 0 {
                joined = joined + " "
            }
            joined = joined + piece
            taken = taken + 1
        }
        k = k - 1
    }
    return uc_strip(joined)
}

# set(b) <= {"=", "-", "#"}
function sd_only_rules(s: string) -> bool {
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    while p[i] != 0 {
        if p[i] != 61 and p[i] != 45 and p[i] != 35 {
            return false
        }
        i = i + 1
    }
    return true
}

function sd_leading_doc(src: string) -> string {
    let lines: ptr<StrList> = wu_splitlines(src)
    let got: ptr<StrList> = ft_list_new()
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let line: string = ft_list_get(lines, i)
        if ft_starts(line, "#") {
            ft_list_push(got, uc_strip(wu_lstrip_set(line, "# ")))
        } elif ft_len(uc_strip(line)) == 0 {
            if ft_list_len(got) > 0 {
                break
            }
        } else {
            break
        }
        i = i + 1
    }
    let mut joined: string = ""
    let mut k: i32 = 0
    while k < ft_list_len(got) and k < 3 {
        if k > 0 {
            joined = joined + " "
        }
        joined = joined + ft_list_get(got, k)
        k = k + 1
    }
    return uc_strip(joined)
}

function sd_push_fn(info: ptr<SdInfo>, name: string, params: string, ret: string, doc: string) -> void {
    if info[0].nfns == info[0].capfns {
        let nc: i32 = info[0].capfns * 2
        let grown: ptr<SdFn> = malloc((nc as i64) * 32) as ptr<SdFn>
        let old: ptr<SdFn> = info[0].fns
        let mut i: i32 = 0
        while i < info[0].nfns {
            grown[i].name = old[i].name
            grown[i].params = old[i].params
            grown[i].ret = old[i].ret
            grown[i].doc = old[i].doc
            i = i + 1
        }
        info[0].fns = grown
        info[0].capfns = nc
    }
    let fns: ptr<SdFn> = info[0].fns
    let at: i32 = info[0].nfns
    fns[at].name = name
    fns[at].params = params
    fns[at].ret = ret
    fns[at].doc = doc
    info[0].nfns = at + 1
}

# FN_RE = ^export\s+function\s+(\w+)\s*(\([^;{]*\))\s*(?:->\s*([^{\n]+))?
function sd_functions(src: string, info: ptr<SdInfo>) -> void {
    let p: ptr<u8> = src as ptr<u8>
    let n: i32 = ft_len(src)
    let mut pos: i32 = 0
    let mut done_to: i32 = 0
    while pos < n {
        if pos >= done_to and (pos == 0 or p[pos - 1] == 10) {
            let h: i32 = sd_head(src, p, pos, "function")
            if h >= 0 {
                let e: i32 = sd_word(p, h)
                let q: i32 = sd_ws(p, e)
                if e > h and p[q] == 40 {
                    let mut stop: i32 = q + 1
                    let mut close: i32 = -1
                    while p[stop] != 0 and p[stop] != 59 and p[stop] != 123 {
                        if p[stop] == 41 {
                            close = stop
                        }
                        stop = stop + 1
                    }
                    if close >= 0 {
                        let name: string = ft_slice(src, h, e)
                        let params: string = uc_strip(ft_slice(src, q, close + 1))
                        let after: i32 = sd_ws(p, close + 1)
                        let mut end: i32 = after
                        let mut ret: string = "void"
                        if ft_at(src, after, "->") {
                            let a: i32 = after + 2
                            let b: i32 = sd_ws(p, a)
                            let mut g3: i32 = -1
                            if p[b] != 0 and p[b] != 123 {
                                g3 = b
                            } else {
                                let mut t: i32 = b
                                while t > a and g3 < 0 {
                                    t = sd_prev(p, t)
                                    if p[t] != 10 {
                                        g3 = t
                                    }
                                }
                            }
                            if g3 >= 0 {
                                let mut ge: i32 = g3
                                while p[ge] != 0 and p[ge] != 123 and p[ge] != 10 {
                                    ge = ge + 1
                                }
                                ret = uc_strip(ft_slice(src, g3, ge))
                                end = ge
                            }
                        }
                        let doc: string = sd_preceding(src, pos)
                        sd_push_fn(info, name, params, ret, doc)
                        done_to = end
                    }
                }
            }
        }
        pos = pos + 1
    }
}

# Start of the UTF-8 character before `at`.
function sd_prev(p: ptr<u8>, at: i32) -> i32 {
    let mut q: i32 = at - 1
    while q > 0 and ((p[q] as i32) >= 128 and (p[q] as i32) < 192) {
        q = q - 1
    }
    return q
}

# CONST_RE = ^export\s+const\s+(\w+)\s*:\s*([^=]+)=
function sd_consts(src: string, info: ptr<SdInfo>) -> void {
    let p: ptr<u8> = src as ptr<u8>
    let n: i32 = ft_len(src)
    let mut pos: i32 = 0
    let mut done_to: i32 = 0
    while pos < n {
        if pos >= done_to and (pos == 0 or p[pos - 1] == 10) {
            let h: i32 = sd_head(src, p, pos, "const")
            if h >= 0 {
                let e: i32 = sd_word(p, h)
                let q: i32 = sd_ws(p, e)
                if e > h and p[q] == 58 {
                    let a: i32 = q + 1
                    let b: i32 = sd_ws(p, a)
                    let mut g: i32 = -1
                    if p[b] != 0 and p[b] != 61 {
                        g = b
                    } elif p[b] == 61 and b > a {
                        g = sd_prev(p, b)
                    }
                    if g >= 0 {
                        let mut eq: i32 = g
                        while p[eq] != 0 and p[eq] != 61 {
                            eq = eq + 1
                        }
                        if p[eq] == 61 {
                            ft_list_push(info[0].const_names, ft_slice(src, h, e))
                            ft_list_push(info[0].const_types, uc_strip(ft_slice(src, g, eq)))
                            done_to = eq + 1
                        }
                    }
                }
            }
        }
        pos = pos + 1
    }
}

function sd_extract(src: string) -> ptr<SdInfo> {
    let info: ptr<SdInfo> = malloc(96) as ptr<SdInfo>
    info[0].doc = sd_leading_doc(src)
    info[0].structs = sd_names(src, "struct", true)
    info[0].traits = sd_names(src, "trait", false)
    info[0].effects = sd_names(src, "effect", false)
    info[0].caps = sd_names(src, "capability", false)
    info[0].const_names = ft_list_new()
    info[0].const_types = ft_list_new()
    info[0].fns = malloc(32 * 16) as ptr<SdFn>
    info[0].nfns = 0
    info[0].capfns = 16
    sd_functions(src, info)
    sd_consts(src, info)
    return info
}

function sd_ticked(items: ptr<StrList>) -> string {
    let mut joined: string = ""
    let mut i: i32 = 0
    while i < ft_list_len(items) {
        if i > 0 {
            joined = joined + ", "
        }
        joined = joined + "`" + ft_list_get(items, i) + "`"
        i = i + 1
    }
    return joined
}

# Write docs/library/stdlib-api.md under `root` and print the Python
# script's "Wrote ..." line. Returns 0 on success.
export function wsd_generate(root: string) -> i32 {
    let stdlib: string = root + "/lib/stdlib"
    let found: ptr<StrList> = wu_lines_of("find " + pr_quote(stdlib) + " -name '*.flow' 2>/dev/null")
    let files: ptr<StrList> = ft_list_new()
    let root_has_test: bool = ft_contains("/" + root + "/", "/test/")
    let mut i: i32 = 0
    while i < ft_list_len(found) {
        let full: string = ft_list_get(found, i)
        let rel: string = ft_from(full, ft_len(stdlib) + 1)
        let wrapped: string = "/" + rel + "/"
        let base_name: string = ft_slice(rel, sd_last_slash(rel) + 1, ft_len(rel))
        if ft_eq(base_name, ".DS_Store") == false and ft_contains(wrapped, "/test/") == false and root_has_test == false {
            ft_list_push(files, rel)
        }
        i = i + 1
    }
    wu_sort(files, true)
    # An undocumented function gets a plain hyphen.
    let dash: string = "-"
    let b: ptr<WBuf> = wb_new()
    wb_line(b, "# Standard Library API (generated)")
    wb_line(b, "")
    wb_line(b, "> Auto-generated from `lib/stdlib/` on " + wu_today() + " by `scripts/gen_stdlib_docs.sh`. Per-function docs come from `#` comments immediately above each `export function`.")
    wb_line(b, "")
    wb_line(b, "**" + ft_itoa(ft_list_len(files)) + "** modules scanned.")
    wb_line(b, "")
    wb_line(b, "## Modules")
    wb_line(b, "")
    let mut f: i32 = 0
    while f < ft_list_len(files) {
        let relp: string = ft_list_get(files, f)
        let src: string = wu_read_text(stdlib + "/" + relp)
        let info: ptr<SdInfo> = sd_extract(src)
        wb_line(b, "### `" + relp + "`")
        wb_line(b, "")
        if ft_len(info[0].doc) > 0 {
            wb_line(b, info[0].doc)
            wb_line(b, "")
        }
        if ft_list_len(info[0].effects) > 0 {
            wb_line(b, "**Effects:** " + sd_ticked(info[0].effects))
            wb_line(b, "")
        }
        if ft_list_len(info[0].caps) > 0 {
            wb_line(b, "**Capabilities:** " + sd_ticked(info[0].caps))
            wb_line(b, "")
        }
        if ft_list_len(info[0].traits) > 0 {
            wb_line(b, "**Traits:** " + sd_ticked(info[0].traits))
            wb_line(b, "")
        }
        if ft_list_len(info[0].structs) > 0 {
            wb_line(b, "**Structs:** " + sd_ticked(info[0].structs))
            wb_line(b, "")
        }
        let nconst: i32 = ft_list_len(info[0].const_names)
        if nconst > 0 {
            wb_line(b, "**Constants:**")
            wb_line(b, "")
            let mut c: i32 = 0
            while c < nconst and c < 40 {
                wb_line(b, "- `" + ft_list_get(info[0].const_names, c) + ": " + ft_list_get(info[0].const_types, c) + "`")
                c = c + 1
            }
            wb_line(b, "")
        }
        let nf: i32 = info[0].nfns
        if nf > 0 {
            wb_line(b, "**Functions:**")
            wb_line(b, "")
            wb_line(b, "| Name | Signature | Docs |")
            wb_line(b, "|------|-----------|------|")
            let fns: ptr<SdFn> = info[0].fns
            let mut k: i32 = 0
            while k < nf and k < 80 {
                let sig: string = ft_replace(fns[k].params + " -> " + fns[k].ret, "|", "\\|")
                let mut cell: string = fns[k].doc
                if ft_len(cell) == 0 {
                    cell = dash
                }
                wb_line(b, "| `" + fns[k].name + "` | `" + sig + "` | " + ft_replace(cell, "|", "\\|") + " |")
                k = k + 1
            }
            if nf > 80 {
                wb_line(b, "| " + wu_ellipsis() + " | " + ft_itoa(nf - 80) + " more | |")
            }
            wb_line(b, "")
        }
        if ft_list_len(info[0].structs) == 0 and nf == 0 and ft_list_len(info[0].traits) == 0 and nconst == 0 and ft_list_len(info[0].effects) == 0 and ft_list_len(info[0].caps) == 0 {
            wb_line(b, "*No `export` items found (internal / extern-only module).*")
            wb_line(b, "")
        }
        f = f + 1
    }
    let out_dir: string = root + "/docs/library"
    let _mk: bool = pr_mkdir_p(out_dir)
    let out_path: string = out_dir + "/stdlib-api.md"
    if wb_write(out_path, b) == false {
        return 1
    }
    ft_outln("Wrote " + out_path + " (" + ft_itoa(ft_list_len(files)) + " modules)")
    return 0
}

function sd_last_slash(s: string) -> i32 {
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = ft_len(s) - 1
    while i >= 0 {
        if p[i] == 47 {
            return i
        }
        i = i - 1
    }
    return -1
}
