# @module tools.digest
# @means  SHA-1 and base64 for the repository tools.
#
# The WebSocket handshake (RFC 6455, section 4.2.2) answers a client key with
# base64(SHA-1(key + GUID)). Both are written out here on bytes. SHA-1 words
# are held in i64 and masked to 32 bits after every step.

extern {
    function malloc(size: i64) -> ptr<void>
    function strlen(s: string) -> i64
}

const MASK32: i64 = 4294967295

function dg_rotl(x: i64, n: i64) -> i64 {
    return ((x << n) | (x >> (32 - n))) & MASK32
}

# SHA-1 of `n` bytes at `data`. Returns the 20-byte digest.
export function dg_sha1(data: ptr<u8>, n: i64) -> ptr<u8> {
    # Padded message: data, 0x80, zeros, then the bit length as 8 bytes.
    let total: i64 = ((n + 8) / 64 + 1) * 64
    let msg: ptr<u8> = malloc(total) as ptr<u8>
    let mut i: i64 = 0
    while i < total {
        msg[i] = 0
        i = i + 1
    }
    i = 0
    while i < n {
        msg[i] = data[i]
        i = i + 1
    }
    msg[n] = 128
    let bits: i64 = n * 8
    let mut k: i64 = 0
    while k < 8 {
        msg[total - 1 - k] = ((bits >> (k * 8)) & 255) as u8
        k = k + 1
    }

    let mut h0: i64 = 1732584193
    let mut h1: i64 = 4023233417
    let mut h2: i64 = 2562383102
    let mut h3: i64 = 271733878
    let mut h4: i64 = 3285377520
    let w: ptr<i64> = malloc(80 * 8) as ptr<i64>

    let mut off: i64 = 0
    while off < total {
        let mut t: i64 = 0
        while t < 16 {
            let b: i64 = off + t * 4
            w[t] = ((msg[b] as i64) << 24) | ((msg[b + 1] as i64) << 16) | ((msg[b + 2] as i64) << 8) | (msg[b + 3] as i64)
            t = t + 1
        }
        while t < 80 {
            w[t] = dg_rotl(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1)
            t = t + 1
        }
        let mut a: i64 = h0
        let mut b2: i64 = h1
        let mut c: i64 = h2
        let mut d: i64 = h3
        let mut e: i64 = h4
        t = 0
        while t < 80 {
            let mut f: i64 = 0
            let mut kk: i64 = 0
            if t < 20 {
                f = (b2 & c) | ((~b2 & MASK32) & d)
                kk = 1518500249
            } elif t < 40 {
                f = b2 ^ c ^ d
                kk = 1859775393
            } elif t < 60 {
                f = (b2 & c) | (b2 & d) | (c & d)
                kk = 2400959708
            } else {
                f = b2 ^ c ^ d
                kk = 3395469782
            }
            let tmp: i64 = (dg_rotl(a, 5) + f + e + kk + w[t]) & MASK32
            e = d
            d = c
            c = dg_rotl(b2, 30)
            b2 = a
            a = tmp
            t = t + 1
        }
        h0 = (h0 + a) & MASK32
        h1 = (h1 + b2) & MASK32
        h2 = (h2 + c) & MASK32
        h3 = (h3 + d) & MASK32
        h4 = (h4 + e) & MASK32
        off = off + 64
    }

    let out: ptr<u8> = malloc(20) as ptr<u8>
    let hs: ptr<i64> = malloc(5 * 8) as ptr<i64>
    hs[0] = h0
    hs[1] = h1
    hs[2] = h2
    hs[3] = h3
    hs[4] = h4
    let mut j: i32 = 0
    while j < 5 {
        out[j * 4] = ((hs[j] >> 24) & 255) as u8
        out[j * 4 + 1] = ((hs[j] >> 16) & 255) as u8
        out[j * 4 + 2] = ((hs[j] >> 8) & 255) as u8
        out[j * 4 + 3] = (hs[j] & 255) as u8
        j = j + 1
    }
    return out
}

# Lower-case hex of `n` bytes.
export function dg_hex(data: ptr<u8>, n: i64) -> string {
    let digits: ptr<u8> = "0123456789abcdef" as ptr<u8>
    let out: ptr<u8> = malloc(n * 2 + 1) as ptr<u8>
    let mut i: i64 = 0
    while i < n {
        let v: i32 = data[i] as i32
        out[i * 2] = digits[v / 16]
        out[i * 2 + 1] = digits[v % 16]
        i = i + 1
    }
    out[n * 2] = 0
    return out as string
}

# Standard base64 (RFC 4648 alphabet, with = padding) of `n` bytes.
export function dg_base64(data: ptr<u8>, n: i64) -> string {
    let abc: ptr<u8> = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" as ptr<u8>
    let out: ptr<u8> = malloc(((n + 2) / 3) * 4 + 1) as ptr<u8>
    let mut i: i64 = 0
    let mut o: i64 = 0
    while i < n {
        let b0: i64 = data[i] as i64
        let mut b1: i64 = 0
        let mut b2: i64 = 0
        if i + 1 < n {
            b1 = data[i + 1] as i64
        }
        if i + 2 < n {
            b2 = data[i + 2] as i64
        }
        let v: i64 = (b0 << 16) | (b1 << 8) | b2
        out[o] = abc[(v >> 18) & 63]
        out[o + 1] = abc[(v >> 12) & 63]
        if i + 1 < n {
            out[o + 2] = abc[(v >> 6) & 63]
        } else {
            out[o + 2] = 61
        }
        if i + 2 < n {
            out[o + 3] = abc[v & 63]
        } else {
            out[o + 3] = 61
        }
        i = i + 3
        o = o + 4
    }
    out[o] = 0
    return out as string
}

# base64(SHA-1(s)) for a NUL-terminated string.
export function dg_sha1_base64(s: string) -> string {
    let n: i64 = strlen(s)
    return dg_base64(dg_sha1(s as ptr<u8>, n), 20)
}
