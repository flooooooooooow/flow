# @module tools.wiki_util
# @means  Helpers for the wiki build tools: a growable byte buffer, text
#         reading the way Python's read_text() does it, pathlib ordering,
#         and json.dumps(indent=2) output.
#
# Used by scripts/tools/build_wiki, scripts/tools/wiki_nav and
# scripts/tools/gen_stdlib_docs.

import .text { ft_len, ft_eq, ft_slice, ft_from, ft_read_file, ft_list_new, ft_list_push, ft_list_len, ft_list_get, ft_rfind_byte, ft_basename, StrList }
import .unicode { uc_decode, uc_len, uc_is_space, uc_prev }
import .json { json_kind, json_str, json_key, json_first, json_next, json_len, json_quote, json_pyrepr, Json }
import .proc { pr_capture, pr_quote }

extern {
    function malloc(size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
    function strlen(s: string) -> i64
    function fopen(path: string, mode: string) -> ptr<void>
    function fclose(fp: ptr<void>) -> i32
    function fwrite(buf: ptr<u8>, size: i64, count: i64, fp: ptr<void>) -> i64
}

# ---------------------------------------------------------------------------
# Buffer
# ---------------------------------------------------------------------------

struct WBuf {
    data: ptr<u8>
    len: i32
    cap: i32
}

export function wb_new() -> ptr<WBuf> {
    let b: ptr<WBuf> = malloc(16) as ptr<WBuf>
    b[0].data = malloc(4096) as ptr<u8>
    b[0].len = 0
    b[0].cap = 4096
    let d: ptr<u8> = b[0].data
    d[0] = 0
    return b
}

export function wb_add(b: ptr<WBuf>, piece: string) -> void {
    let add: i32 = strlen(piece) as i32
    if b[0].len + add + 1 > b[0].cap {
        let mut nc: i32 = b[0].cap * 2
        while b[0].len + add + 1 > nc {
            nc = nc * 2
        }
        b[0].data = realloc(b[0].data as ptr<void>, nc as i64) as ptr<u8>
        b[0].cap = nc
    }
    let d: ptr<u8> = b[0].data
    let src: ptr<u8> = piece as ptr<u8>
    let base: i32 = b[0].len
    let mut i: i32 = 0
    while i < add {
        d[base + i] = src[i]
        i = i + 1
    }
    b[0].len = base + add
    d[b[0].len] = 0
}

# Append a line and a '\n'.
export function wb_line(b: ptr<WBuf>, piece: string) -> void {
    wb_add(b, piece)
    wb_add(b, "\n")
}

export function wb_str(b: ptr<WBuf>) -> string {
    return b[0].data as string
}

export function wb_len(b: ptr<WBuf>) -> i32 {
    return b[0].len
}

export function wb_write(path: string, b: ptr<WBuf>) -> bool {
    let fp: ptr<void> = fopen(path, "wb")
    if fp == null {
        return false
    }
    let wrote: i64 = fwrite(b[0].data, 1, b[0].len as i64, fp)
    let _c: i32 = fclose(fp)
    return wrote == (b[0].len as i64)
}

# ---------------------------------------------------------------------------
# Characters that must not appear literally in tool sources
# ---------------------------------------------------------------------------

function utf8_of(cp: i32) -> string {
    let o: ptr<u8> = malloc(5) as ptr<u8>
    if cp < 128 {
        o[0] = cp as u8
        o[1] = 0
    } elif cp < 2048 {
        o[0] = (192 + cp / 64) as u8
        o[1] = (128 + cp % 64) as u8
        o[2] = 0
    } else {
        o[0] = (224 + cp / 4096) as u8
        o[1] = (128 + (cp / 64) % 64) as u8
        o[2] = (128 + cp % 64) as u8
        o[3] = 0
    }
    return o as string
}

# U+2014, the placeholder the generated tables use for an empty cell.
export function wu_dash() -> string {
    return utf8_of(8212)
}

# U+2192 RIGHTWARDS ARROW
export function wu_arrow() -> string {
    return utf8_of(8594)
}

# U+00B7 MIDDLE DOT
export function wu_dot() -> string {
    return utf8_of(183)
}

# U+2026 HORIZONTAL ELLIPSIS
export function wu_ellipsis() -> string {
    return utf8_of(8230)
}

# ---------------------------------------------------------------------------
# Reading text
# ---------------------------------------------------------------------------

# Length of the valid UTF-8 sequence at `i`, or 0 when invalid; `bad[0]`
# then holds the maximal-subpart length Python's decoder replaces.
function wu_seq_len(p: ptr<u8>, i: i32, bad: ptr<i32>) -> i32 {
    let c: i32 = p[i] as i32
    if c < 128 {
        return 1
    }
    let mut need: i32 = 0
    let mut lo: i32 = 128
    let mut hi: i32 = 191
    if c >= 194 and c <= 223 {
        need = 1
    } elif c == 224 {
        need = 2
        lo = 160
    } elif c >= 225 and c <= 236 {
        need = 2
    } elif c == 237 {
        need = 2
        hi = 159
    } elif c >= 238 and c <= 239 {
        need = 2
    } elif c == 240 {
        need = 3
        lo = 144
    } elif c >= 241 and c <= 243 {
        need = 3
    } elif c == 244 {
        need = 3
        hi = 143
    } else {
        bad[0] = 1
        return 0
    }
    let mut k: i32 = 1
    while k <= need {
        let d: i32 = p[i + k] as i32
        let mut ok: bool = d >= 128 and d <= 191
        if k == 1 {
            ok = d >= lo and d <= hi
        }
        if ok == false {
            bad[0] = k
            return 0
        }
        k = k + 1
    }
    return need + 1
}

# Decode with errors="replace" (U+FFFD per maximal subpart) and translate
# \r\n and \r to \n, as Path.read_text() does.
export function wu_clean_text(raw: string) -> string {
    let p: ptr<u8> = raw as ptr<u8>
    let n: i32 = strlen(raw) as i32
    let out: ptr<u8> = malloc((n * 3 + 1) as i64) as ptr<u8>
    let bad: ptr<i32> = malloc(4) as ptr<i32>
    let mut o: i32 = 0
    let mut i: i32 = 0
    while i < n {
        let c: i32 = p[i] as i32
        if c == 13 {
            out[o] = 10
            o = o + 1
            i = i + 1
            if p[i] == 10 {
                i = i + 1
            }
            continue
        }
        let l: i32 = wu_seq_len(p, i, bad)
        if l == 0 {
            out[o] = 239
            out[o + 1] = 191
            out[o + 2] = 189
            o = o + 3
            i = i + bad[0]
        } else {
            let mut k: i32 = 0
            while k < l {
                out[o] = p[i + k]
                o = o + 1
                k = k + 1
            }
            i = i + l
        }
    }
    out[o] = 0
    return out as string
}

# Path.read_text(encoding="utf-8", errors="replace"); null when unreadable.
export function wu_read_text(path: string) -> string {
    let raw: string = ft_read_file(path)
    if raw as ptr<u8> == null {
        return null as string
    }
    return wu_clean_text(raw)
}

# str.splitlines()
export function wu_splitlines(s: string) -> ptr<StrList> {
    let out: ptr<StrList> = ft_list_new()
    let p: ptr<u8> = s as ptr<u8>
    let n: i32 = strlen(s) as i32
    let mut start: i32 = 0
    let mut i: i32 = 0
    while i < n {
        let cp: i32 = uc_decode(p, i)
        let step: i32 = uc_len(p[i] as i32)
        let is_break: bool = cp == 10 or cp == 13 or cp == 11 or cp == 12 or (cp >= 28 and cp <= 30) or cp == 133 or cp == 8232 or cp == 8233
        if is_break {
            ft_list_push(out, ft_slice(s, start, i))
            let mut nx: i32 = i + step
            if cp == 13 and p[nx] == 10 {
                nx = nx + 1
            }
            start = nx
            i = nx
        } else {
            i = i + step
        }
    }
    if start < n {
        ft_list_push(out, ft_slice(s, start, n))
    }
    return out
}

# Byte offset of the first `count` code points (the whole string if shorter).
export function wu_cp_prefix(s: string, count: i32) -> string {
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    let mut k: i32 = 0
    while p[i] != 0 and k < count {
        i = i + uc_len(p[i] as i32)
        k = k + 1
    }
    return ft_slice(s, 0, i)
}

export function wu_cp_count(s: string) -> i32 {
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    let mut k: i32 = 0
    while p[i] != 0 {
        i = i + uc_len(p[i] as i32)
        k = k + 1
    }
    return k
}

# str.lstrip(chars) for an ASCII set.
export function wu_lstrip_set(s: string, chars: string) -> string {
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    while p[i] != 0 and wu_in_set(p[i] as i32, chars) {
        i = i + 1
    }
    return ft_from(s, i)
}

# str.strip(chars) for an ASCII set.
export function wu_strip_set(s: string, chars: string) -> string {
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    while p[i] != 0 and wu_in_set(p[i] as i32, chars) {
        i = i + 1
    }
    let mut e: i32 = strlen(s) as i32
    while e > i and wu_in_set(p[e - 1] as i32, chars) {
        e = e - 1
    }
    return ft_slice(s, i, e)
}

function wu_in_set(c: i32, chars: string) -> bool {
    let q: ptr<u8> = chars as ptr<u8>
    let mut i: i32 = 0
    while q[i] != 0 {
        if (q[i] as i32) == c {
            return true
        }
        i = i + 1
    }
    return false
}

# str.title() for ASCII letters; every other character is uncased.
export function wu_title(s: string) -> string {
    let p: ptr<u8> = s as ptr<u8>
    let n: i32 = strlen(s) as i32
    let out: ptr<u8> = malloc((n + 1) as i64) as ptr<u8>
    let mut prev_cased: bool = false
    let mut i: i32 = 0
    while i < n {
        let c: i32 = p[i] as i32
        let upper: bool = c >= 65 and c <= 90
        let lower: bool = c >= 97 and c <= 122
        if upper or lower {
            if prev_cased {
                if upper {
                    out[i] = (c + 32) as u8
                } else {
                    out[i] = c as u8
                }
            } else {
                if lower {
                    out[i] = (c - 32) as u8
                } else {
                    out[i] = c as u8
                }
            }
            prev_cased = true
        } else {
            out[i] = c as u8
            prev_cased = false
        }
        i = i + 1
    }
    out[n] = 0
    return out as string
}

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Path.stem of the final component.
export function wu_stem(path: string) -> string {
    let mut end: i32 = strlen(path) as i32
    let p: ptr<u8> = path as ptr<u8>
    while end > 1 and p[end - 1] == 47 {
        end = end - 1
    }
    let trimmed: string = ft_slice(path, 0, end)
    let name: string = ft_basename(trimmed)
    let dot: i32 = ft_rfind_byte(name, 46)
    if dot <= 0 or dot == (strlen(name) as i32) - 1 {
        return name
    }
    return ft_slice(name, 0, dot)
}

# Order of pathlib paths: component lists compared, so '/' sorts first.
export function wu_path_cmp(a: string, b: string) -> i32 {
    let pa: ptr<u8> = a as ptr<u8>
    let pb: ptr<u8> = b as ptr<u8>
    let mut i: i32 = 0
    while true {
        let ca: i32 = pa[i] as i32
        let cb: i32 = pb[i] as i32
        if ca == 0 and cb == 0 {
            return 0
        }
        if ca == 0 {
            return -1
        }
        if cb == 0 {
            return 1
        }
        let mut ka: i32 = ca
        let mut kb: i32 = cb
        if ka == 47 {
            ka = 0
        }
        if kb == 47 {
            kb = 0
        }
        if ka != kb {
            return ka - kb
        }
        i = i + 1
    }
    return 0
}

# Byte order (Python str order for UTF-8) when `paths` is false, else the
# pathlib order above. Stable merge sort.
export function wu_sort(l: ptr<StrList>, paths: bool) -> void {
    let n: i32 = ft_list_len(l)
    if n < 2 {
        return
    }
    let mut src: ptr<string> = l[0].items
    let mut dst: ptr<string> = malloc((n as i64) * 8) as ptr<string>
    let mut width: i32 = 1
    while width < n {
        let mut lo: i32 = 0
        while lo < n {
            let mut mid: i32 = lo + width
            if mid > n {
                mid = n
            }
            let mut hi: i32 = lo + 2 * width
            if hi > n {
                hi = n
            }
            let mut ia: i32 = lo
            let mut ib: i32 = mid
            let mut o: i32 = lo
            while o < hi {
                let mut take_a: bool = false
                if ia < mid {
                    if ib >= hi {
                        take_a = true
                    } else {
                        let mut r: i32 = 0
                        if paths {
                            r = wu_path_cmp(src[ia], src[ib])
                        } else {
                            r = wu_byte_cmp(src[ia], src[ib])
                        }
                        take_a = r <= 0
                    }
                }
                if take_a {
                    dst[o] = src[ia]
                    ia = ia + 1
                } else {
                    dst[o] = src[ib]
                    ib = ib + 1
                }
                o = o + 1
            }
            lo = lo + 2 * width
        }
        let t: ptr<string> = src
        src = dst
        dst = t
        width = width * 2
    }
    l[0].items = src
}

export function wu_byte_cmp(a: string, b: string) -> i32 {
    let pa: ptr<u8> = a as ptr<u8>
    let pb: ptr<u8> = b as ptr<u8>
    let mut i: i32 = 0
    while pa[i] != 0 and pa[i] == pb[i] {
        i = i + 1
    }
    return (pa[i] as i32) - (pb[i] as i32)
}

# Lines printed by a shell command (find, date, ...).
export function wu_lines_of(cmd: string) -> ptr<StrList> {
    let text: string = pr_capture(cmd)
    let out: ptr<StrList> = ft_list_new()
    let p: ptr<u8> = text as ptr<u8>
    let n: i32 = strlen(text) as i32
    let mut start: i32 = 0
    let mut i: i32 = 0
    while i < n {
        if p[i] == 10 {
            if i > start {
                ft_list_push(out, ft_slice(text, start, i))
            }
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        ft_list_push(out, ft_slice(text, start, n))
    }
    return out
}

# date.today().isoformat()
export function wu_today() -> string {
    let got: ptr<StrList> = wu_lines_of("date +%Y-%m-%d")
    if ft_list_len(got) == 0 {
        return "1970-01-01"
    }
    return ft_list_get(got, 0)
}

# ---------------------------------------------------------------------------
# json.dumps(value, indent=2) of a parsed value
# ---------------------------------------------------------------------------

export function wu_pad(b: ptr<WBuf>, level: i32) -> void {
    let mut i: i32 = 0
    while i < level {
        wb_add(b, "  ")
        i = i + 1
    }
}

export function wu_dump(b: ptr<WBuf>, j: ptr<Json>, id: i32, level: i32) -> void {
    let kind: i32 = json_kind(j, id)
    if kind == 0 {
        wb_add(b, "null")
    } elif kind == 1 {
        wb_add(b, "false")
    } elif kind == 2 {
        wb_add(b, "true")
    } elif kind == 3 {
        wb_add(b, json_pyrepr(j, id))
    } elif kind == 4 {
        wb_add(b, json_quote(json_str(j, id)))
    } elif kind == 5 {
        if json_len(j, id) == 0 {
            wb_add(b, "[]")
            return
        }
        wb_add(b, "[\n")
        let mut c: i32 = json_first(j, id)
        let mut first: bool = true
        while c >= 0 {
            if first == false {
                wb_add(b, ",\n")
            }
            first = false
            wu_pad(b, level + 1)
            wu_dump(b, j, c, level + 1)
            c = json_next(j, c)
        }
        wb_add(b, "\n")
        wu_pad(b, level)
        wb_add(b, "]")
    } else {
        if json_len(j, id) == 0 {
            wb_add(b, "{}")
            return
        }
        wb_add(b, "{\n")
        let mut m: i32 = json_first(j, id)
        let mut firstm: bool = true
        while m >= 0 {
            if firstm == false {
                wb_add(b, ",\n")
            }
            firstm = false
            wu_pad(b, level + 1)
            wb_add(b, json_quote(json_key(j, m)))
            wb_add(b, ": ")
            wu_dump(b, j, m, level + 1)
            m = json_next(j, m)
        }
        wb_add(b, "\n")
        wu_pad(b, level)
        wb_add(b, "}")
    }
}

# Python truthiness of a parsed value.
export function wu_truthy(j: ptr<Json>, id: i32) -> bool {
    if id < 0 {
        return false
    }
    let kind: i32 = json_kind(j, id)
    if kind == 0 or kind == 1 {
        return false
    }
    if kind == 2 {
        return true
    }
    if kind == 4 {
        return ft_len(json_str(j, id)) > 0
    }
    if kind == 5 or kind == 6 {
        return json_len(j, id) > 0
    }
    return ft_eq(json_pyrepr(j, id), "0") == false and ft_eq(json_pyrepr(j, id), "0.0") == false
}
