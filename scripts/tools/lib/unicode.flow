# str.lower() over a whole UTF-8 string.
export function uc_lower_str(s: string) -> string {
    let p: ptr<u8> = s as ptr<u8>
    let n: i32 = strlen(s) as i32
    let buf: ptr<u8> = malloc((n * 2 + 8) as i64) as ptr<u8>
    let mut i: i32 = 0
    let mut o: i32 = 0
    while i < n {
        let cp: i32 = uc_decode(p, i)
        i = i + uc_len(p[i] as i32)
        if cp == 304 {
            o = uc_put(buf, o, 105)
            o = uc_put(buf, o, 775)
        } else {
            o = uc_put(buf, o, uc_lower(cp))
        }
    }
    buf[o] = 0
    return buf as string
}

# str.strip() with no arguments.
export function uc_strip(s: string) -> string {
    let p: ptr<u8> = s as ptr<u8>
    let n: i32 = strlen(s) as i32
    let mut a: i32 = 0
    while a < n and uc_is_space(uc_decode(p, a)) {
        a = a + uc_len(p[a] as i32)
    }
    let mut b: i32 = n
    while b > a {
        let q: i32 = uc_prev(p, b)
        if uc_is_space(uc_decode(p, q)) == false {
            break
        }
        b = q
    }
    let out: ptr<u8> = malloc((b - a + 1) as i64) as ptr<u8>
    let mut k: i32 = 0
    while k < b - a {
        out[k] = p[a + k]
        k = k + 1
    }
    out[b - a] = 0
    return out as string
}

# Number of code points in a UTF-8 string.
export function uc_count(s: string) -> i32 {
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    let mut n: i32 = 0
    while p[i] != 0 {
        i = i + uc_len(p[i] as i32)
        n = n + 1
    }
    return n
}

# Decode a UTF-8 string into a code point array; returns the length.
export function uc_to_cps(s: string, out: ptr<i32>) -> i32 {
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    let mut n: i32 = 0
    while p[i] != 0 {
        out[n] = uc_decode(p, i)
        i = i + uc_len(p[i] as i32)
        n = n + 1
    }
    return n
}
