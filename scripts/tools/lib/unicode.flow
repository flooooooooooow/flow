# @module tools.unicode
# @means  The Unicode character classes Python's str methods and re use,
#         for tools that must match their output exactly.
#
# Tables generated from the Unicode 15.0.0 character database, the version
# Python 3.12 ships. uc_is_word is str.isalnum() or '_', which is what re's
# \w and \b use for str patterns. uc_lower is str.lower() for code points that
# lower to a single code point; U+0130 is the one exception and is handled in
# uc_lower_str. uc_is_space is str.isspace(), also re's \s.
#
# Do not edit the tables by hand. Regenerate them from the Unicode data files
# for a newer Unicode version, keeping the same range layout.

extern {
    function malloc(size: i64) -> ptr<void>
    function strlen(s: string) -> i64
}

# Byte length of the UTF-8 sequence that starts with lead byte `c`.
export function uc_len(c: i32) -> i32 {
    if c >= 240 { return 4 }
    if c >= 224 { return 3 }
    if c >= 192 { return 2 }
    return 1
}

# Code point of the UTF-8 sequence at byte `at`.
export function uc_decode(p: ptr<u8>, at: i32) -> i32 {
    let c: i32 = p[at] as i32
    if c >= 240 {
        return (c % 8) * 262144 + ((p[at + 1] as i32) % 64) * 4096 + ((p[at + 2] as i32) % 64) * 64 + (p[at + 3] as i32) % 64
    }
    if c >= 224 {
        return (c % 16) * 4096 + ((p[at + 1] as i32) % 64) * 64 + (p[at + 2] as i32) % 64
    }
    if c >= 192 {
        return (c % 32) * 64 + (p[at + 1] as i32) % 64
    }
    return c
}

# Byte offset of the code point that ends just before `at`.
export function uc_prev(p: ptr<u8>, at: i32) -> i32 {
    let mut i: i32 = at - 1
    while i > 0 and (p[i] as i32) >= 128 and (p[i] as i32) < 192 {
        i = i - 1
    }
    return i
}

# Write code point `cp` as UTF-8 at buf[o]; returns the new offset.
export function uc_put(buf: ptr<u8>, o: i32, cp: i32) -> i32 {
    if cp < 128 {
        buf[o] = cp as u8
        return o + 1
    }
    if cp < 2048 {
        buf[o] = (192 + cp / 64) as u8
        buf[o + 1] = (128 + cp % 64) as u8
        return o + 2
    }
    if cp < 65536 {
        buf[o] = (224 + cp / 4096) as u8
        buf[o + 1] = (128 + (cp / 64) % 64) as u8
        buf[o + 2] = (128 + cp % 64) as u8
        return o + 3
    }
    buf[o] = (240 + cp / 262144) as u8
    buf[o + 1] = (128 + (cp / 4096) % 64) as u8
    buf[o + 2] = (128 + (cp / 64) % 64) as u8
    buf[o + 3] = (128 + cp % 64) as u8
    return o + 4
}

# str.isspace(); also what re's \s matches in a str pattern.
export function uc_is_space(c: i32) -> bool {
    return c == 9 or c == 10 or c == 11 or c == 12 or c == 13 or c == 28 or c == 29 or c == 30
        or c == 31 or c == 32 or c == 133 or c == 160 or c == 5760 or c == 8192
        or c == 8193 or c == 8194 or c == 8195 or c == 8196 or c == 8197 or c == 8198
        or c == 8199 or c == 8200 or c == 8201 or c == 8202 or c == 8232 or c == 8233
        or c == 8239 or c == 8287 or c == 12288
}

