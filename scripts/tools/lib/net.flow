# @module tools.net
# @means  IPv4 TCP sockets and child processes for the repository's servers.
#
# Flow has no socket API in the tools yet, so this wraps libc through extern.
# The C headers are not included, so the few layouts and constants that
# differ between the BSDs (macOS) and Linux are chosen at run time from
# uname(3): struct sockaddr_in starts with a length byte on the BSDs, and
# SOL_SOCKET / SO_REUSEADDR have different values.
#
# Servers here fork one child per connection and reap them with
# nt_reap(). A peer that goes away shows up as a failed write, never as
# SIGPIPE: accepted sockets get SO_NOSIGPIPE on the BSDs and writes pass
# MSG_NOSIGNAL on Linux. (signal(3) cannot be declared here: its handler is
# a function pointer, which an extern cannot spell, and the C headers the
# generated code includes already declare it.)

import .text { ft_eq, ft_len, ft_itoa, ft_list_len, ft_list_get, StrList }
import .bench { bn_now }

extern {
    function malloc(size: i64) -> ptr<void>
    function uname(buf: ptr<u8>) -> i32
    function socket(domain: i32, kind: i32, proto: i32) -> i32
    function setsockopt(fd: i32, level: i32, name: i32, val: ptr<i32>, len: i32) -> i32
    function bind(fd: i32, addr: ptr<u8>, len: i32) -> i32
    function listen(fd: i32, backlog: i32) -> i32
    function accept(fd: i32, addr: ptr<u8>, len: ptr<i32>) -> i32
    function poll(fds: ptr<u8>, n: i32, timeout: i32) -> i32
    function inet_pton(af: i32, src: string, dst: ptr<u8>) -> i32
    function perror(s: string) -> void
    function send(fd: i32, buf: ptr<u8>, n: i64, flags: i32) -> i64
    function write(fd: i32, buf: string, n: i64) -> i64
    function read(fd: i32, buf: ptr<u8>, n: i64) -> i64
    function close(fd: i32) -> i32
    function fork() -> i32
    function dup2(a: i32, b: i32) -> i32
    function open(path: string, flags: i32) -> i32
    function creat(path: string, mode: i32) -> i32
    function execvp(file: string, argv: ptr<string>) -> i32
    function waitpid(pid: i32, status: ptr<i32>, options: i32) -> i32
    function _exit(code: i32) -> void
    function kill(pid: i32, sig: i32) -> i32
    function setpgid(pid: i32, pgid: i32) -> i32
    function chdir(path: string) -> i32
    function usleep(us: i32) -> i32
}

const AF_INET: i32 = 2
const SOCK_STREAM: i32 = 1
const IPPROTO_TCP: i32 = 6
const TCP_NODELAY: i32 = 1
const POLLIN: i32 = 1
const WNOHANG: i32 = 1
const SIGKILL: i32 = 9

# True on macOS and the other BSDs, false on Linux.
export function nt_is_bsd() -> bool {
    let buf: ptr<u8> = malloc(4096) as ptr<u8>
    buf[0] = 0
    let _u: i32 = uname(buf)
    return ft_eq(buf as string, "Linux") == false
}

# A 16-byte struct sockaddr_in for a dotted IPv4 address, or null when the
# address does not parse. "localhost" means 127.0.0.1.
export function nt_sockaddr(ip: string, port: i32) -> ptr<u8> {
    let sa: ptr<u8> = malloc(16) as ptr<u8>
    let mut i: i32 = 0
    while i < 16 {
        sa[i] = 0
        i = i + 1
    }
    if nt_is_bsd() {
        sa[0] = 16
        sa[1] = AF_INET as u8
    } else {
        sa[0] = AF_INET as u8
        sa[1] = 0
    }
    sa[2] = ((port >> 8) & 255) as u8
    sa[3] = (port & 255) as u8
    let mut host: string = ip
    if ft_eq(host, "localhost") {
        host = "127.0.0.1"
    }
    if inet_pton(AF_INET, host, sa + 4) != 1 {
        return null
    }
    return sa
}

# Listening socket on ip:port with SO_REUSEADDR, or -1 after printing why
# (prefixed with `who`) to stderr.
export function nt_listen(who: string, ip: string, port: i32, backlog: i32) -> i32 {
    let sa: ptr<u8> = nt_sockaddr(ip, port)
    if sa == null {
        let _w: i64 = write(2, who + ": cannot use address " + ip + "\n", ft_len(who + ": cannot use address " + ip + "\n") as i64)
        return -1
    }
    let fd: i32 = socket(AF_INET, SOCK_STREAM, 0)
    if fd < 0 {
        perror(who + ": socket")
        return -1
    }
    let one: ptr<i32> = malloc(4) as ptr<i32>
    one[0] = 1
    if nt_is_bsd() {
        let _o: i32 = setsockopt(fd, 65535, 4, one, 4)
    } else {
        let _o2: i32 = setsockopt(fd, 1, 2, one, 4)
    }
    if bind(fd, sa, 16) != 0 {
        perror(who + ": bind " + ip + ":" + ft_itoa(port))
        let _c: i32 = close(fd)
        return -1
    }
    if listen(fd, backlog) != 0 {
        perror(who + ": listen")
        let _c2: i32 = close(fd)
        return -1
    }
    return fd
}

# Wait up to `timeout_ms` for one of `n` listening sockets to be readable.
# Returns the index of the first ready one, or -1.
export function nt_wait_readable(fds: ptr<i32>, n: i32, timeout_ms: i32) -> i32 {
    let pfd: ptr<u8> = malloc((n * 8) as i64) as ptr<u8>
    let pi: ptr<i32> = pfd as ptr<i32>
    let mut i: i32 = 0
    while i < n {
        pi[i * 2] = fds[i]
        # events = POLLIN, revents = 0 (two little-endian i16 fields)
        pi[i * 2 + 1] = POLLIN
        i = i + 1
    }
    let got: i32 = poll(pfd, n, timeout_ms)
    if got <= 0 {
        return -1
    }
    i = 0
    while i < n {
        let rev: i32 = (pfd[i * 8 + 6] as i32) | ((pfd[i * 8 + 7] as i32) << 8)
        if rev != 0 {
            return i
        }
        i = i + 1
    }
    return -1
}

# Accept one connection. `peer` (16 bytes, from nt_peer_new) receives the
# client's address. Returns the connected fd or -1.
export function nt_accept(lfd: i32, peer: ptr<u8>) -> i32 {
    let len: ptr<i32> = malloc(4) as ptr<i32>
    len[0] = 16
    let fd: i32 = accept(lfd, peer, len)
    if fd >= 0 and nt_is_bsd() {
        # SO_NOSIGPIPE
        let one: ptr<i32> = malloc(4) as ptr<i32>
        one[0] = 1
        let _o: i32 = setsockopt(fd, 65535, 4130, one, 4)
    }
    return fd
}

export function nt_peer_new() -> ptr<u8> {
    return malloc(16) as ptr<u8>
}

# Dotted IPv4 address of a sockaddr_in.
export function nt_peer_ip(peer: ptr<u8>) -> string {
    return ft_itoa(peer[4] as i32) + "." + ft_itoa(peer[5] as i32) + "." + ft_itoa(peer[6] as i32) + "." + ft_itoa(peer[7] as i32)
}

export function nt_peer_port(peer: ptr<u8>) -> i32 {
    return ((peer[2] as i32) << 8) | (peer[3] as i32)
}

export function nt_nodelay(fd: i32) -> void {
    let one: ptr<i32> = malloc(4) as ptr<i32>
    one[0] = 1
    let _o: i32 = setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, one, 4)
}

# Write all `n` bytes. False when the peer has gone.
export function nt_write_all(fd: i32, data: ptr<u8>, n: i64) -> bool {
    let mut flags: i32 = 16384
    if nt_is_bsd() {
        flags = 0
    }
    let mut off: i64 = 0
    while off < n {
        let w: i64 = send(fd, data + off, n - off, flags)
        if w <= 0 {
            return false
        }
        off = off + w
    }
    return true
}

export function nt_write_str(fd: i32, s: string) -> bool {
    return nt_write_all(fd, s as ptr<u8>, ft_len(s) as i64)
}

# One read(2): bytes read, 0 at end of stream, negative on error.
export function nt_read(fd: i32, buf: ptr<u8>, n: i64) -> i64 {
    return read(fd, buf, n)
}

# Read exactly `n` bytes into `buf`. False on a short read.
export function nt_read_exact(fd: i32, buf: ptr<u8>, n: i64) -> bool {
    let mut got: i64 = 0
    while got < n {
        let r: i64 = read(fd, buf + got, n - got)
        if r <= 0 {
            return false
        }
        got = got + r
    }
    return true
}

export function nt_close(fd: i32) -> void {
    let _c: i32 = close(fd)
}

export function nt_fork() -> i32 {
    return fork()
}

export function nt_exit(code: i32) -> void {
    _exit(code)
}

# Collect every child that has finished, without blocking.
export function nt_reap() -> void {
    let st: ptr<i32> = malloc(4) as ptr<i32>
    while waitpid(-1, st, WNOHANG) > 0 {
    }
}

# ---------------------------------------------------------------------------
# Child processes with a time limit
# ---------------------------------------------------------------------------

# Exit status as Python's subprocess reports it: the exit code, or minus
# the signal number when the child was killed.
function nt_status_code(st: i32) -> i32 {
    if (st & 127) != 0 {
        return 0 - (st & 127)
    }
    return (st >> 8) & 255
}

# Run argv in `cwd` with stdin from /dev/null and stdout / stderr written to
# the files `out_path` / `err_path`. The child leads its own process group,
# and the whole group is killed when it outlives `timeout` seconds.
# Returns the exit status (negative for a signal), 127 when the program could
# not be started, or -1000 on timeout.
export function nt_run_timed(argv: ptr<StrList>, cwd: string, timeout: f64, out_path: string, err_path: string) -> i32 {
    let n: i32 = ft_list_len(argv)
    let args: ptr<string> = malloc(((n + 1) * 8) as i64) as ptr<string>
    let mut i: i32 = 0
    while i < n {
        args[i] = ft_list_get(argv, i)
        i = i + 1
    }
    args[n] = null
    let pid: i32 = fork()
    if pid < 0 {
        return 127
    }
    if pid == 0 {
        let _g: i32 = setpgid(0, 0)
        if chdir(cwd) != 0 {
            _exit(127)
        }
        let nul: i32 = open("/dev/null", 0)
        let fo: i32 = creat(out_path, 420)
        let fe: i32 = creat(err_path, 420)
        if nul < 0 or fo < 0 or fe < 0 {
            _exit(127)
        }
        let _d0: i32 = dup2(nul, 0)
        let _d1: i32 = dup2(fo, 1)
        let _d2: i32 = dup2(fe, 2)
        let _x: i32 = execvp(args[0], args)
        _exit(127)
    }
    let _g2: i32 = setpgid(pid, pid)
    let st: ptr<i32> = malloc(4) as ptr<i32>
    st[0] = 0
    let deadline: f64 = bn_now() + timeout
    while true {
        let w: i32 = waitpid(pid, st, WNOHANG)
        if w == pid {
            return nt_status_code(st[0])
        }
        if w < 0 {
            return 127
        }
        if bn_now() >= deadline {
            let _k1: i32 = kill(0 - pid, SIGKILL)
            let _k2: i32 = kill(pid, SIGKILL)
            let _w2: i32 = waitpid(pid, st, 0)
            return -1000
        }
        let _s: i32 = usleep(2000)
    }
    return 127
}
