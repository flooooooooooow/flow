# Flow challenge checker: confirm a submission uses the language forms a
# challenge requires, then compile and run it.
#
# Run it as `./flow tool challenge_check` from anywhere:
#
#   flow tool challenge_check list
#   flow tool challenge_check check F01 path/to/answer.flow [--syntax-only] [--timeout N]
#   flow tool challenge_check scan file.flow...    syntax verdict of every challenge per file
#   flow tool challenge_check self-test            unit checks for the matcher and stripper
#
# The shim passes the repository root in FLOW_REPO_ROOT. Rules live in
# challenges/flow-specific/catalog.json as Python-syntax regular
# expressions, matched with re.MULTILINE | re.DOTALL semantics by
# lib/stdlib/regex.flow (std.regex).

import .text { ft_out, ft_outln, ft_err, ft_errln, ft_eq, ft_len, ft_itoa, ft_read_file, ft_exists, ft_starts, ft_ends, ft_find_byte, ft_rfind_byte, ft_slice, ft_from, ft_basename, ft_normpath, ft_join, ft_list_new, ft_list_push, ft_list_len, ft_list_get, ft_contains, StrList }
import .json { json_parse, json_error, json_get, json_kind, json_str, json_first, json_next, json_int, json_key, json_kind_string, json_kind_true, json_kind_object, Json }
import std.regex { rx_compile, rx_error, rx_test_cps, rx_decode, rx_py_flags, Regex }

extern {
    function malloc(size: i64) -> ptr<void>
    function getenv(name: string) -> string
    function getcwd(buf: ptr<u8>, size: i64) -> ptr<u8>
    function opendir(path: string) -> ptr<void>
    function closedir(d: ptr<void>) -> i32
    function fork() -> i32
    function execvp(file: string, argv: ptr<string>) -> i32
    function waitpid(pid: i32, status: ptr<i32>, options: i32) -> i32
    function kill(pid: i32, sig: i32) -> i32
    function usleep(us: u32) -> i32
    function chdir(path: string) -> i32
    function setenv(name: string, value: string, overwrite: i32) -> i32
    function _exit(code: i32) -> void
    function atoi(s: string) -> i32
}

const PROG: string = "flow tool challenge_check"
const CATALOG_REL: string = "challenges/flow-specific/catalog.json"
const USAGE: string = "usage: flow tool challenge_check [-h] {list,check,scan,self-test} ..."
const CHECK_USAGE: string = "usage: flow tool challenge_check check [-h] [--syntax-only] [--timeout TIMEOUT] challenge_id submission"

struct Catalog {
    j: ptr<Json>
    # One entry per catalog item, in file order.
    nodes: ptr<i32>
    ids: ptr<string>
    count: i32
}

function repo_root() -> string {
    let r: string = getenv("FLOW_REPO_ROOT")
    if r as ptr<u8> == null or ft_len(r) == 0 {
        return "."
    }
    return r
}

function usage_error(message: string) -> i32 {
    ft_errln(USAGE)
    ft_errln(PROG + ": error: " + message)
    return 2
}

function check_usage_error(message: string) -> i32 {
    ft_errln(CHECK_USAGE)
    ft_errln(PROG + " check: error: " + message)
    return 2
}

# ---------------------------------------------------------------------------
# Text helpers
# ---------------------------------------------------------------------------

function ascii_upper(s: string) -> string {
    let n: i32 = ft_len(s)
    let out: ptr<u8> = malloc((n + 1) as i64) as ptr<u8>
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    while i < n {
        let c: i32 = p[i] as i32
        if c >= 97 and c <= 122 {
            out[i] = (c - 32) as u8
        } else {
            out[i] = c as u8
        }
        i = i + 1
    }
    out[n] = 0
    return out as string
}

# Length in code points, which is what Python's format padding counts.
function cp_len(s: string) -> i32 {
    let p: ptr<u8> = s as ptr<u8>
    let mut n: i32 = 0
    let mut i: i32 = 0
    while p[i] != 0 {
        if ((p[i] as i32) & 192) != 128 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

function pad_right(s: string, width: i32) -> string {
    let mut out: string = s
    let mut n: i32 = cp_len(s)
    while n < width {
        out = out + " "
        n = n + 1
    }
    return out
}

function pad_left(s: string, width: i32) -> string {
    let mut out: string = s
    let mut n: i32 = cp_len(s)
    while n < width {
        out = " " + out
        n = n + 1
    }
    return out
}

function repeat_star(n: i64) -> string {
    let mut out: string = ""
    let mut i: i64 = 0
    while i < n {
        out = out + "*"
        i = i + 1
    }
    return out
}

# Remove # comments without treating # inside a string as a comment.
function strip_flow_comments(source: string) -> string {
    let n: i32 = ft_len(source)
    let src: ptr<u8> = source as ptr<u8>
    let out: ptr<u8> = malloc((n + 1) as i64) as ptr<u8>
    let mut o: i32 = 0
    let mut in_string: bool = false
    let mut escaped: bool = false
    let mut in_comment: bool = false
    let mut i: i32 = 0
    while i < n {
        let c: i32 = src[i] as i32
        i = i + 1
        if c == 10 {
            out[o] = 10
            o = o + 1
            escaped = false
            in_comment = false
            continue
        }
        if in_comment {
            continue
        }
        if in_string {
            out[o] = c as u8
            o = o + 1
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 34 {
                in_string = false
            }
            continue
        }
        if c == 34 {
            in_string = true
            out[o] = 34
            o = o + 1
            continue
        }
        if c == 35 {
            in_comment = true
            continue
        }
        out[o] = c as u8
        o = o + 1
    }
    out[o] = 0
    return out as string
}

# ---------------------------------------------------------------------------
# Catalog
# ---------------------------------------------------------------------------

function load_catalog() -> ptr<Catalog> {
    let path: string = ft_join(repo_root(), CATALOG_REL)
    let text: string = ft_read_file(path)
    if text as ptr<u8> == null {
        ft_errln(PROG + ": cannot read " + path)
        return null
    }
    let j: ptr<Json> = json_parse(text)
    if ft_len(json_error(j)) > 0 {
        ft_errln(PROG + ": " + path + ": " + json_error(j))
        return null
    }
    let items: i32 = json_get(j, 0, "challenges")
    let cat: ptr<Catalog> = malloc(64) as ptr<Catalog>
    cat[0].j = j
    cat[0].count = 0
    cat[0].nodes = malloc(4 * 1024) as ptr<i32>
    cat[0].ids = malloc(8 * 1024) as ptr<string>
    let nodes: ptr<i32> = cat[0].nodes
    let ids: ptr<string> = cat[0].ids
    let mut c: i32 = json_first(j, items)
    while c >= 0 and cat[0].count < 1024 {
        nodes[cat[0].count] = c
        ids[cat[0].count] = ascii_upper(json_str(j, json_get(j, c, "id")))
        cat[0].count = cat[0].count + 1
        c = json_next(j, c)
    }
    return cat
}

# The catalog node for an upper-case id, or -1. As with a Python dict built
# from the list, the last duplicate wins.
function catalog_find(cat: ptr<Catalog>, id: string) -> i32 {
    let nodes: ptr<i32> = cat[0].nodes
    let ids: ptr<string> = cat[0].ids
    let mut found: i32 = -1
    let mut i: i32 = 0
    while i < cat[0].count {
        if ft_eq(ids[i], id) {
            found = nodes[i]
        }
        i = i + 1
    }
    return found
}

function get_str(j: ptr<Json>, obj: i32, key: string) -> string {
    return json_str(j, json_get(j, obj, key))
}

function list_challenges(cat: ptr<Catalog>) -> i32 {
    let j: ptr<Json> = cat[0].j
    let ids: ptr<string> = cat[0].ids
    let mut i: i32 = 0
    while i < cat[0].count {
        # Dict order: first appearance of each id, showing the last value.
        let mut seen: bool = false
        let mut k: i32 = 0
        while k < i {
            if ft_eq(ids[k], ids[i]) {
                seen = true
            }
            k = k + 1
        }
        if not seen {
            let item: i32 = catalog_find(cat, ids[i])
            let level: string = repeat_star(json_int(j, json_get(j, item, "difficulty")))
            ft_outln(pad_left(get_str(j, item, "id"), 3) + "  " + pad_right(level, 5) + "  " + pad_right(get_str(j, item, "track"), 18) + "  " + get_str(j, item, "title"))
        }
        i = i + 1
    }
    return 0
}

# ---------------------------------------------------------------------------
# Pattern checks
# ---------------------------------------------------------------------------

function rule_matches(j: ptr<Json>, rule: i32, code: ptr<i32>, code_len: i32, bad: ptr<i32>) -> bool {
    let pattern: string = get_str(j, rule, "pattern")
    let rx: ptr<Regex> = rx_compile(pattern, rx_py_flags())
    if ft_len(rx_error(rx)) > 0 {
        ft_errln(PROG + ": bad pattern " + pattern + ": " + rx_error(rx))
        bad[0] = 1
        return false
    }
    return rx_test_cps(rx, code, code_len)
}

# Failure messages for one challenge, in the catalog's rule order.
function check_patterns(j: ptr<Json>, challenge: i32, source: string, bad: ptr<i32>) -> ptr<StrList> {
    let code: string = strip_flow_comments(source)
    let lenp: ptr<i32> = malloc(4) as ptr<i32>
    let cps: ptr<i32> = rx_decode(code, lenp)
    let n: i32 = lenp[0]
    let failures: ptr<StrList> = ft_list_new()

    let req: i32 = json_get(j, challenge, "required")
    if req >= 0 {
        let mut r: i32 = json_first(j, req)
        while r >= 0 {
            if not rule_matches(j, r, cps, n, bad) {
                ft_list_push(failures, "missing required syntax: " + get_str(j, r, "label"))
            }
            r = json_next(j, r)
        }
    }

    let any: i32 = json_get(j, challenge, "required_any")
    if any >= 0 {
        let mut g: i32 = json_first(j, any)
        while g >= 0 {
            let rules: i32 = json_get(j, g, "rules")
            let mut hit: bool = false
            let mut r2: i32 = json_first(j, rules)
            while r2 >= 0 and not hit {
                if rule_matches(j, r2, cps, n, bad) {
                    hit = true
                }
                r2 = json_next(j, r2)
            }
            if not hit {
                let mut choices: string = ""
                let mut r3: i32 = json_first(j, rules)
                while r3 >= 0 {
                    if ft_len(choices) > 0 {
                        choices = choices + ", "
                    }
                    choices = choices + get_str(j, r3, "label")
                    r3 = json_next(j, r3)
                }
                ft_list_push(failures, "missing one of: " + choices)
            }
            g = json_next(j, g)
        }
    }

    let forb: i32 = json_get(j, challenge, "forbidden")
    if forb >= 0 {
        let mut f: i32 = json_first(j, forb)
        while f >= 0 {
            if rule_matches(j, f, cps, n, bad) {
                ft_list_push(failures, "forbidden shortcut found: " + get_str(j, f, "label"))
            }
            f = json_next(j, f)
        }
    }
    return failures
}

# ---------------------------------------------------------------------------
# Running a submission
# ---------------------------------------------------------------------------

function format_part(part: string, submission: string) -> string {
    let mut out: string = ""
    let mut pos: i32 = 0
    let n: i32 = ft_len(part)
    while pos < n {
        let open: i32 = ft_find_byte(part, 123, pos)
        if open < 0 {
            break
        }
        let tail: string = ft_from(part, open)
        if ft_starts(tail, "{submission}") {
            out = out + ft_slice(part, pos, open) + submission
            pos = open + 12
        } else {
            out = out + ft_slice(part, pos, open + 1)
            pos = open + 1
        }
    }
    return out + ft_from(part, pos)
}

function run_submission(j: ptr<Json>, challenge: i32, submission: string, timeout: i32) -> i32 {
    let runner: i32 = json_get(j, challenge, "runner")
    let argc: i32 = 0
    let argv: ptr<string> = malloc(8 * 64) as ptr<string>
    let mut n: i32 = 0
    let mut shown: string = ""
    let mut p: i32 = json_first(j, runner)
    while p >= 0 and n < 63 {
        let part: string = format_part(json_str(j, p), submission)
        argv[n] = part
        if n > 0 {
            shown = shown + " "
        }
        shown = shown + part
        n = n + 1
        p = json_next(j, p)
    }
    argv[n] = null
    ft_outln("run: " + shown)

    let host_id: i32 = json_get(j, challenge, "host")
    let env_id: i32 = json_get(j, challenge, "env")

    let pid: i32 = fork()
    if pid == 0 {
        let _c: i32 = chdir(repo_root())
        if host_id >= 0 and json_kind(j, host_id) == json_kind_string() and ft_len(json_str(j, host_id)) > 0 {
            let _h: i32 = setenv("FLOW_HOST", json_str(j, host_id), 1)
        }
        if env_id >= 0 and json_kind(j, env_id) == json_kind_object() {
            let mut e: i32 = json_first(j, env_id)
            while e >= 0 {
                let _s: i32 = setenv(json_key(j, e), json_str(j, e), 1)
                e = json_next(j, e)
            }
        }
        let _x: i32 = execvp(argv[0], argv)
        ft_errln(PROG + ": cannot run " + argv[0])
        _exit(127)
    }
    if pid < 0 {
        ft_errln(PROG + ": fork failed")
        return 1
    }

    let status: ptr<i32> = malloc(4) as ptr<i32>
    status[0] = 0
    # Poll every 10 ms and count the waits: time(3) has no prototype under
    # Stage-A's headers, so the elapsed time is tallied instead.
    let limit_ms: i64 = (timeout as i64) * 1000
    let mut waited_ms: i64 = 0
    while true {
        let got: i32 = waitpid(pid, status, 1)
        if got == pid {
            break
        }
        if waited_ms >= limit_ms {
            let _k: i32 = kill(pid, 9)
            let _w: i32 = waitpid(pid, status, 0)
            ft_errln("FAIL: execution exceeded " + ft_itoa(timeout) + " seconds")
            return 1
        }
        let _u: i32 = usleep(10000)
        waited_ms = waited_ms + 10
    }

    let st: i32 = status[0]
    let mut rc: i32 = 0
    if (st & 127) == 0 {
        rc = (st >> 8) & 255
    } else {
        rc = 0 - (st & 127)
    }
    if rc != 0 {
        ft_errln("FAIL: program returned " + ft_itoa(rc))
        return 1
    }
    ft_outln("PASS: required syntax found and program returned zero")
    return 0
}


# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

function current_dir() -> string {
    let buf: ptr<u8> = malloc(4096) as ptr<u8>
    let _g: ptr<u8> = getcwd(buf, 4096)
    return buf as string
}

# Path.resolve(): an absolute path with the directory's symlinks resolved.
# getcwd() reports the physical directory, so the parent is resolved by
# visiting it. realpath(3) cannot be declared under Stage-A because its
# prototype clashes with stdlib.h.
function resolve_path(arg: string) -> string {
    let mut abs: string = arg
    if ft_starts(arg, "/") == false {
        abs = current_dir() + "/" + arg
    }
    abs = ft_normpath(abs)
    let slash: i32 = ft_rfind_byte(abs, 47)
    let parent: string = ft_slice(abs, 0, slash)
    let name: string = ft_from(abs, slash + 1)
    let here: string = current_dir()
    if ft_len(parent) > 0 and chdir(parent) == 0 {
        let physical: string = current_dir()
        let _back: i32 = chdir(here)
        if ft_eq(physical, "/") {
            return "/" + name
        }
        return physical + "/" + name
    }
    return abs
}

function is_file(path: string) -> bool {
    if not ft_exists(path) {
        return false
    }
    let d: ptr<void> = opendir(path)
    if d != null {
        let _c: i32 = closedir(d)
        return false
    }
    return true
}

# Path.suffix
function path_suffix(path: string) -> string {
    let name: string = ft_basename(path)
    let dot: i32 = ft_rfind_byte(name, 46)
    if dot <= 0 or dot == ft_len(name) - 1 {
        return ""
    }
    return ft_from(name, dot)
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

function is_digits(s: string) -> bool {
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    if p[0] == 45 or p[0] == 43 {
        i = 1
    }
    if p[i] == 0 {
        return false
    }
    while p[i] != 0 {
        if p[i] < 48 or p[i] > 57 {
            return false
        }
        i = i + 1
    }
    return true
}

function cmd_check(cat: ptr<Catalog>, argc: i32, argv: ptr<ptr<u8>>) -> i32 {
    let mut syntax_only: bool = false
    let mut timeout: i32 = 60
    let mut challenge_arg: string = null as string
    let mut submission_arg: string = null as string
    let mut i: i32 = 2
    while i < argc {
        let a: string = argv[i] as string
        if ft_eq(a, "-h") or ft_eq(a, "--help") {
            ft_outln(CHECK_USAGE)
            return 0
        }
        if ft_eq(a, "--syntax-only") {
            syntax_only = true
        } elif ft_eq(a, "--timeout") {
            if i + 1 >= argc {
                return check_usage_error("argument --timeout: expected one argument")
            }
            i = i + 1
            let v: string = argv[i] as string
            if not is_digits(v) {
                return check_usage_error("argument --timeout: invalid int value: '" + v + "'")
            }
            timeout = atoi(v)
        } elif ft_starts(a, "--timeout=") {
            let v2: string = ft_from(a, 10)
            if not is_digits(v2) {
                return check_usage_error("argument --timeout: invalid int value: '" + v2 + "'")
            }
            timeout = atoi(v2)
        } elif ft_starts(a, "-") and ft_len(a) > 1 and not is_digits(a) {
            return usage_error("unrecognized arguments: " + a)
        } elif challenge_arg as ptr<u8> == null {
            challenge_arg = a
        } elif submission_arg as ptr<u8> == null {
            submission_arg = a
        } else {
            return usage_error("unrecognized arguments: " + a)
        }
        i = i + 1
    }
    if challenge_arg as ptr<u8> == null {
        return check_usage_error("the following arguments are required: challenge_id, submission")
    }
    if submission_arg as ptr<u8> == null {
        return check_usage_error("the following arguments are required: submission")
    }

    let j: ptr<Json> = cat[0].j
    let challenge_id: string = ascii_upper(challenge_arg)
    let challenge: i32 = catalog_find(cat, challenge_id)
    if challenge < 0 {
        return usage_error("unknown challenge id: " + challenge_id)
    }
    let submission: string = resolve_path(submission_arg)
    if not is_file(submission) {
        return usage_error("submission does not exist: " + submission)
    }
    if not ft_eq(path_suffix(submission), ".flow") {
        return usage_error("submission must have a .flow suffix")
    }

    let source: string = ft_read_file(submission)
    let bad: ptr<i32> = malloc(4) as ptr<i32>
    bad[0] = 0
    let failures: ptr<StrList> = check_patterns(j, challenge, source, bad)
    if bad[0] != 0 {
        return 1
    }
    if ft_list_len(failures) > 0 {
        let mut k: i32 = 0
        while k < ft_list_len(failures) {
            ft_errln("FAIL: " + ft_list_get(failures, k))
            k = k + 1
        }
        return 1
    }

    ft_outln("syntax: " + challenge_id + " " + get_str(j, challenge, "title") + " passed")
    let so: i32 = json_get(j, challenge, "syntax_only")
    if syntax_only or (so >= 0 and json_kind(j, so) == json_kind_true()) {
        ft_outln("PASS: syntax check complete")
        return 0
    }
    return run_submission(j, challenge, submission, timeout)
}

# For each file, one line per challenge: "<id>\t<file>\t<failures joined by | >"
# with "ok" when the syntax check passes. Used to hold this checker to the
# retired Python checker's verdicts over a whole corpus.
function cmd_scan(cat: ptr<Catalog>, argc: i32, argv: ptr<ptr<u8>>) -> i32 {
    let j: ptr<Json> = cat[0].j
    let ids: ptr<string> = cat[0].ids
    let bad: ptr<i32> = malloc(4) as ptr<i32>
    bad[0] = 0
    let mut i: i32 = 2
    while i < argc {
        let path: string = argv[i] as string
        let source: string = ft_read_file(path)
        if source as ptr<u8> == null {
            ft_errln(PROG + ": cannot read " + path)
            return 1
        }
        let mut c: i32 = 0
        while c < cat[0].count {
            let item: i32 = catalog_find(cat, ids[c])
            let failures: ptr<StrList> = check_patterns(j, item, source, bad)
            let mut verdict: string = "ok"
            if ft_list_len(failures) > 0 {
                verdict = ""
                let mut k: i32 = 0
                while k < ft_list_len(failures) {
                    if k > 0 {
                        verdict = verdict + " | "
                    }
                    verdict = verdict + ft_list_get(failures, k)
                    k = k + 1
                }
            }
            ft_outln(ids[c] + "\t" + path + "\t" + verdict)
            c = c + 1
        }
        i = i + 1
    }
    if bad[0] != 0 {
        return 1
    }
    return 0
}

function tally(ok: bool, name: string, failed: ptr<i32>) -> void {
    if ok {
        return
    }
    ft_errln("self-test FAIL: " + name)
    failed[0] = failed[0] + 1
}

# The cases from the retired test_check.py, plus the recorded CPython
# verdicts in regex_cases.json.
function cmd_self_test() -> i32 {
    let failed: ptr<i32> = malloc(4) as ptr<i32>
    failed[0] = 0
    let bad: ptr<i32> = malloc(4) as ptr<i32>
    bad[0] = 0

    # test_comment_text_does_not_satisfy_rule
    let c1: ptr<Json> = json_parse("{\"required\": [{\"label\": \"pipeline\", \"pattern\": \"\\\\|>\"}]}")
    let f1: ptr<StrList> = check_patterns(c1, 0, "# use |> here\nreturn 0\n", bad)
    tally(ft_list_len(f1) == 1 and ft_eq(ft_list_get(f1, 0), "missing required syntax: pipeline"), "comment text does not satisfy rule", failed)

    # test_hash_inside_string_is_retained
    let stripped: string = strip_flow_comments("println(\"# signal\") # real comment\nreturn 0\n")
    tally(ft_contains(stripped, "\"# signal\""), "hash inside string is retained", failed)
    tally(ft_contains(stripped, "real comment") == false, "comment after string is removed", failed)

    # test_forbidden_text_in_comment_does_not_fail
    let c3: ptr<Json> = json_parse("{\"required\": [{\"label\": \"match\", \"pattern\": \"\\\\bmatch\\\\b\"}], \"forbidden\": [{\"label\": \"shortcut\", \"pattern\": \"\\\\bwhile\\\\b\"}]}")
    let f3: ptr<StrList> = check_patterns(c3, 0, "match value { default { return 0 } } # never use while\n", bad)
    tally(ft_list_len(f3) == 0, "forbidden text in comment does not fail", failed)

    let path: string = ft_join(repo_root(), "scripts/tools/challenge_check/regex_cases.json")
    let text: string = ft_read_file(path)
    if text as ptr<u8> == null {
        ft_errln("self-test FAIL: cannot read " + path)
        return 1
    }
    let j: ptr<Json> = json_parse(text)
    let cases: i32 = json_get(j, 0, "cases")
    let mut total: i32 = 0
    let mut c: i32 = json_first(j, cases)
    while c >= 0 {
        let pattern: string = get_str(j, c, "pattern")
        let rx: ptr<Regex> = rx_compile(pattern, rx_py_flags())
        let lenp: ptr<i32> = malloc(4) as ptr<i32>
        let t: string = get_str(j, c, "text")
        let cps: ptr<i32> = rx_decode(t, lenp)
        let got: bool = rx_test_cps(rx, cps, lenp[0])
        let want: bool = json_kind(j, json_get(j, c, "match")) == json_kind_true()
        tally(ft_len(rx_error(rx)) == 0 and got == want, "re.search(" + pattern + ")", failed)
        total = total + 1
        c = json_next(j, c)
    }
    if failed[0] > 0 {
        ft_errln("self-test: " + ft_itoa(failed[0]) + " failed")
        return 1
    }
    ft_outln("self-test: 4 checker cases and " + ft_itoa(total) + " regex cases passed")
    return 0
}

function main(argc: i32, argv: ptr<ptr<u8>>) -> i32 {
    let mut cmd: string = "list"
    if argc >= 2 {
        cmd = argv[1] as string
    }
    if ft_eq(cmd, "-h") or ft_eq(cmd, "--help") {
        ft_outln(USAGE)
        return 0
    }
    if ft_eq(cmd, "self-test") {
        return cmd_self_test()
    }
    let known: bool = ft_eq(cmd, "list") or ft_eq(cmd, "check") or ft_eq(cmd, "scan")
    if known == false {
        return usage_error("argument command: invalid choice: '" + cmd + "' (choose from 'list', 'check', 'scan', 'self-test')")
    }
    let cat: ptr<Catalog> = load_catalog()
    if cat == null {
        return 1
    }
    if ft_eq(cmd, "list") {
        return list_challenges(cat)
    }
    if ft_eq(cmd, "scan") {
        return cmd_scan(cat, argc, argv)
    }
    return cmd_check(cat, argc, argv)
}
