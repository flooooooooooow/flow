# @module tools.wiki_browser.net
# @means  IPv4 loopback TCP over libc sockets, for the CDP client and the
#         static file server.
#
# struct sockaddr_in is built by hand. BSD systems (macOS) lead with a
# length byte and a one-byte family; Linux has a two-byte family. uname(3)
# tells them apart. poll(2) gives every read a timeout.

import .bench { bn_now }

extern {
    function malloc(size: i64) -> ptr<void>
    function socket(domain: i32, kind: i32, proto: i32) -> i32
    function connect(fd: i32, addr: ptr<u8>, len: i32) -> i32
    function bind(fd: i32, addr: ptr<u8>, len: i32) -> i32
    function listen(fd: i32, backlog: i32) -> i32
    function accept(fd: i32, addr: ptr<u8>, len: ptr<i32>) -> i32
    function getsockname(fd: i32, addr: ptr<u8>, len: ptr<i32>) -> i32
    function setsockopt(fd: i32, level: i32, name: i32, val: ptr<i32>, len: i32) -> i32
    function send(fd: i32, buf: ptr<u8>, n: i64, flags: i32) -> i64
    function recv(fd: i32, buf: ptr<u8>, n: i64, flags: i32) -> i64
    function close(fd: i32) -> i32
    function poll(fds: ptr<i32>, n: i32, timeout: i32) -> i32
    function uname(buf: ptr<u8>) -> i32
    function usleep(us: i32) -> i32
}

# True on macOS and the BSDs, where sockaddr starts with sin_len.
export function nt_is_bsd() -> bool {
    let buf: ptr<u8> = malloc(8192) as ptr<u8>
    buf[0] = 0
    let _u: i32 = uname(buf)
    # "Darwin", "FreeBSD", "OpenBSD", "NetBSD", "DragonFly"; Linux is "L".
    return buf[0] == 68 or buf[0] == 70 or buf[0] == 79 or buf[0] == 78
}

function nt_sockaddr(bsd: bool, a: i32, b: i32, c: i32, d: i32, port: i32) -> ptr<u8> {
    let sa: ptr<u8> = malloc(16) as ptr<u8>
    let mut i: i32 = 0
    while i < 16 {
        sa[i] = 0
        i = i + 1
    }
    if bsd {
        sa[0] = 16
        sa[1] = 2
    } else {
        sa[0] = 2
        sa[1] = 0
    }
    sa[2] = ((port >> 8) & 255) as u8
    sa[3] = (port & 255) as u8
    sa[4] = a as u8
    sa[5] = b as u8
    sa[6] = c as u8
    sa[7] = d as u8
    return sa
}

# Monotonic enough for timeouts: wall-clock milliseconds.
export function nt_now_ms() -> i64 {
    return (bn_now() * 1000.0) as i64
}

export function nt_sleep_ms(ms: i32) -> void {
    let _s: i32 = usleep(ms * 1000)
}

# Connect to 127.0.0.1:port. Returns the fd, or -1.
export function nt_connect_local(port: i32) -> i32 {
    let fd: i32 = socket(2, 1, 0)
    if fd < 0 {
        return -1
    }
    let sa: ptr<u8> = nt_sockaddr(nt_is_bsd(), 127, 0, 0, 1, port)
    if connect(fd, sa, 16) != 0 {
        let _c: i32 = close(fd)
        return -1
    }
    return fd
}

# Listen on 127.0.0.1:port (0 picks a free port). Returns the fd, or -1.
export function nt_listen_local(port: i32) -> i32 {
    let bsd: bool = nt_is_bsd()
    let fd: i32 = socket(2, 1, 0)
    if fd < 0 {
        return -1
    }
    let one: ptr<i32> = malloc(4) as ptr<i32>
    one[0] = 1
    # SOL_SOCKET / SO_REUSEADDR differ between BSD and Linux.
    if bsd {
        let _o: i32 = setsockopt(fd, 65535, 4, one, 4)
    } else {
        let _o2: i32 = setsockopt(fd, 1, 2, one, 4)
    }
    let sa: ptr<u8> = nt_sockaddr(bsd, 127, 0, 0, 1, port)
    if bind(fd, sa, 16) != 0 {
        let _c: i32 = close(fd)
        return -1
    }
    if listen(fd, 64) != 0 {
        let _c2: i32 = close(fd)
        return -1
    }
    return fd
}

# The local port a socket is bound to.
export function nt_local_port(fd: i32) -> i32 {
    let sa: ptr<u8> = malloc(128) as ptr<u8>
    let len: ptr<i32> = malloc(4) as ptr<i32>
    len[0] = 128
    if getsockname(fd, sa, len) != 0 {
        return -1
    }
    return ((sa[2] as i32) << 8) | (sa[3] as i32)
}

# A free loopback port, found by binding port 0 and releasing it.
export function nt_free_port() -> i32 {
    let fd: i32 = nt_listen_local(0)
    if fd < 0 {
        return -1
    }
    let port: i32 = nt_local_port(fd)
    let _c: i32 = close(fd)
    return port
}

export function nt_accept(fd: i32) -> i32 {
    let sa: ptr<u8> = malloc(128) as ptr<u8>
    let len: ptr<i32> = malloc(4) as ptr<i32>
    len[0] = 128
    return accept(fd, sa, len)
}

export function nt_close(fd: i32) -> void {
    let _c: i32 = close(fd)
}

# Write all `n` bytes. False when the peer has gone.
export function nt_send_all(fd: i32, buf: ptr<u8>, n: i64) -> bool {
    let mut off: i64 = 0
    while off < n {
        let w: i64 = send(fd, &buf[off], n - off, 0)
        if w <= 0 {
            return false
        }
        off = off + w
    }
    return true
}

export function nt_send_str(fd: i32, s: string, n: i32) -> bool {
    return nt_send_all(fd, s as ptr<u8>, n as i64)
}

# Wait up to `ms` for `fd` to become readable (or hung up).
export function nt_readable(fd: i32, ms: i32) -> bool {
    let pfd: ptr<i32> = malloc(8) as ptr<i32>
    pfd[0] = fd
    # events = POLLIN in the low half, revents = 0 in the high half.
    pfd[1] = 1
    let mut wait: i32 = ms
    if wait < 0 {
        wait = 0
    }
    return poll(pfd, 1, wait) > 0
}

# One recv(2). 0 means the peer closed; negative is an error.
export function nt_recv(fd: i32, buf: ptr<u8>, n: i64) -> i64 {
    return recv(fd, buf, n, 0)
}
