# @module tools.wiki_browser.cdp
# @means  Drive headless Chrome through the Chrome DevTools Protocol.
#
# cdp_start launches Chrome with a private profile and a free debugging
# port, reads the browser's WebSocket URL from /json/version, and connects.
# Each cdp_new_page opens a page in a fresh browser context (as Playwright's
# browser.new_page does) and attaches a flat session to it. Console errors,
# uncaught exceptions and error log entries are collected per page, and
# lifecycle events drive the navigation waits. cdp_stop closes Chrome,
# kills only the PID this process started, and deletes the profile.

import .text { ft_len, ft_eq, ft_find, ft_slice, ft_from, ft_itoa, ft_starts, ft_ends, ft_contains, ft_errln, ft_exists, ft_write_file, ft_list_new, ft_list_push, ft_list_len, ft_list_get, StrList }
import .proc { pr_quote, pr_run, pr_capture, pr_chomp }
import .json { json_parse, json_error, json_get, json_kind, json_str, json_first, json_next, json_quote, json_kind_string, Json }
import .net
import .ws

extern {
    function malloc(size: i64) -> ptr<void>
    function getenv(name: string) -> string
    function kill(pid: i32, sig: i32) -> i32
}

struct Cdp {
    ws: ptr<Ws>
    next_id: i32
    pid: i32
    port: i32
    profile: string
    state_file: string
    ctx: string
    target: string
    session: string
    loader: string
    dcl_loader: string
    idle_loader: string
    errors: ptr<StrList>
    timed_out: bool
    same_doc_navs: i32
}

# ---------------------------------------------------------------------------
# Finding and launching Chrome
# ---------------------------------------------------------------------------

function on_path(name: string) -> string {
    return pr_chomp(pr_capture("command -v " + pr_quote(name) + " 2>/dev/null"))
}

# $CHROME, then the macOS app bundles, then the usual names on PATH.
export function cdp_find_chrome() -> string {
    let env: string = getenv("CHROME")
    if env as ptr<u8> != null and ft_len(env) > 0 {
        return env
    }
    let mac: string = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
    if ft_exists(mac) {
        return mac
    }
    let mac2: string = "/Applications/Chromium.app/Contents/MacOS/Chromium"
    if ft_exists(mac2) {
        return mac2
    }
    let names: ptr<StrList> = ft_list_new()
    ft_list_push(names, "chromium")
    ft_list_push(names, "chromium-browser")
    ft_list_push(names, "google-chrome")
    ft_list_push(names, "google-chrome-stable")
    ft_list_push(names, "chrome")
    ft_list_push(names, "chrome-headless-shell")
    let mut i: i32 = 0
    while i < ft_list_len(names) {
        let p: string = on_path(ft_list_get(names, i))
        if ft_len(p) > 0 {
            return p
        }
        i = i + 1
    }
    return ""
}

# Body of an HTTP GET to 127.0.0.1:port, or null.
export function cdp_http_get(port: i32, path: string) -> string {
    let fd: i32 = nt_connect_local(port)
    if fd < 0 {
        return null as string
    }
    let req: string = "GET " + path + " HTTP/1.1\r\nHost: 127.0.0.1:" + ft_itoa(port) + "\r\nConnection: close\r\n\r\n"
    if nt_send_str(fd, req, ft_len(req)) == false {
        nt_close(fd)
        return null as string
    }
    let cap: i32 = 1048576
    let buf: ptr<u8> = malloc((cap + 1) as i64) as ptr<u8>
    let mut len: i32 = 0
    let deadline: i64 = nt_now_ms() + 5000
    let mut want: i32 = -1
    while len < cap {
        if want >= 0 and len >= want {
            break
        }
        let left: i64 = deadline - nt_now_ms()
        if left <= 0 or nt_readable(fd, left as i32) == false {
            break
        }
        let got: i64 = nt_recv(fd, &buf[len], (cap - len) as i64)
        if got <= 0 {
            break
        }
        len = len + (got as i32)
        buf[len] = 0
        if want < 0 {
            let he: i32 = ft_find(buf as string, "\r\n\r\n", 0)
            if he >= 0 {
                let head: string = ft_slice(buf as string, 0, he)
                let cl: i32 = ft_find(head, "Content-Length: ", 0)
                if cl >= 0 {
                    let mut n: i32 = 0
                    let hp: ptr<u8> = head as ptr<u8>
                    let mut k: i32 = cl + 16
                    while hp[k] >= 48 and hp[k] <= 57 {
                        n = n * 10 + ((hp[k] as i32) - 48)
                        k = k + 1
                    }
                    want = he + 4 + n
                }
            }
        }
    }
    buf[len] = 0
    nt_close(fd)
    let he2: i32 = ft_find(buf as string, "\r\n\r\n", 0)
    if he2 < 0 {
        return null as string
    }
    return ft_from(buf as string, he2 + 4)
}

function write_state(c: ptr<Cdp>) -> void {
    if ft_len(c[0].state_file) > 0 {
        let _w: bool = ft_write_file(c[0].state_file, ft_itoa(c[0].pid) + "\n" + c[0].profile + "\n")
    }
}

# Launch headless Chrome and connect to it. Returns null (after printing
# the reason) when Chrome cannot be found or does not answer.
export function cdp_start(tag: string) -> ptr<Cdp> {
    let chrome: string = cdp_find_chrome()
    if ft_len(chrome) == 0 {
        ft_errln(tag + ": no Chrome or Chromium found; set CHROME to its executable")
        return null
    }
    let c: ptr<Cdp> = malloc(160) as ptr<Cdp>
    c[0].ws = null
    c[0].next_id = 1
    c[0].pid = 0
    c[0].ctx = ""
    c[0].target = ""
    c[0].session = ""
    c[0].loader = ""
    c[0].dcl_loader = ""
    c[0].idle_loader = ""
    c[0].errors = ft_list_new()
    c[0].timed_out = false
    c[0].same_doc_navs = 0
    let sf: string = getenv("FLOW_WIKI_BROWSER_STATE")
    if sf as ptr<u8> == null {
        c[0].state_file = ""
    } else {
        c[0].state_file = sf
    }

    let mut tmp: string = getenv("TMPDIR")
    if tmp as ptr<u8> == null or ft_len(tmp) == 0 {
        tmp = "/tmp"
    }
    c[0].profile = pr_chomp(pr_capture("mktemp -d " + pr_quote(tmp + "/flow-wiki-browser.XXXXXX")))
    if ft_len(c[0].profile) == 0 {
        ft_errln(tag + ": could not create a Chrome profile directory")
        return null
    }
    c[0].port = nt_free_port()
    if c[0].port <= 0 {
        ft_errln(tag + ": no free port for Chrome")
        cdp_remove_profile(c)
        return null
    }
    let cmd: string = pr_quote(chrome) +
        " --headless=new" +
        " --remote-debugging-port=" + ft_itoa(c[0].port) +
        " --remote-debugging-address=127.0.0.1" +
        " --user-data-dir=" + pr_quote(c[0].profile) +
        " --no-first-run --no-default-browser-check" +
        " --disable-background-networking --disable-component-update" +
        " --disable-extensions --disable-sync --disable-default-apps" +
        " --use-mock-keychain --password-store=basic" +
        " --hide-scrollbars --mute-audio" +
        " about:blank </dev/null >/dev/null 2>&1 & echo $!"
    let pid_text: string = pr_chomp(pr_capture(cmd))
    let mut pid: i32 = 0
    let pp: ptr<u8> = pid_text as ptr<u8>
    let mut k: i32 = 0
    while pp[k] >= 48 and pp[k] <= 57 {
        pid = pid * 10 + ((pp[k] as i32) - 48)
        k = k + 1
    }
    c[0].pid = pid
    if pid <= 0 {
        ft_errln(tag + ": could not start " + chrome)
        cdp_remove_profile(c)
        return null
    }
    write_state(c)

    # Wait for the DevTools endpoint.
    let deadline: i64 = nt_now_ms() + 30000
    let mut ws_url: string = ""
    while nt_now_ms() < deadline and ft_len(ws_url) == 0 {
        let body: string = cdp_http_get(c[0].port, "/json/version")
        if body as ptr<u8> != null {
            let j: ptr<Json> = json_parse(body)
            if ft_len(json_error(j)) == 0 {
                let u: i32 = json_get(j, 0, "webSocketDebuggerUrl")
                if u >= 0 {
                    ws_url = json_str(j, u)
                }
            }
        }
        if ft_len(ws_url) == 0 {
            if kill(pid, 0) != 0 {
                break
            }
            nt_sleep_ms(100)
        }
    }
    if ft_len(ws_url) == 0 {
        ft_errln(tag + ": Chrome did not open its DevTools endpoint")
        cdp_stop(c)
        return null
    }
    # ws://127.0.0.1:PORT/devtools/browser/ID
    let slash: i32 = ft_find(ws_url, "/devtools/", 0)
    c[0].ws = ws_connect(c[0].port, ft_from(ws_url, slash))
    if c[0].ws == null {
        ft_errln(tag + ": WebSocket handshake with Chrome failed")
        cdp_stop(c)
        return null
    }
    return c
}

function cdp_remove_profile(c: ptr<Cdp>) -> void {
    let p: string = c[0].profile
    if ft_len(p) > 0 and ft_contains(p, "/flow-wiki-browser.") {
        let _r: i32 = pr_run("rm -rf " + pr_quote(p))
    }
}

# Close Chrome, then make sure the PID this process started is gone and
# delete its profile.
export function cdp_stop(c: ptr<Cdp>) -> void {
    if c[0].ws != null and ws_closed(c[0].ws) == false {
        let _s: bool = cdp_send(c, "Browser.close", "{}", false) > 0
        let _m: string = ws_recv(c[0].ws, 2000)
        ws_close(c[0].ws)
    }
    let pid: i32 = c[0].pid
    if pid > 0 {
        let deadline: i64 = nt_now_ms() + 5000
        while nt_now_ms() < deadline and kill(pid, 0) == 0 {
            nt_sleep_ms(50)
        }
        if kill(pid, 0) == 0 {
            let _t: i32 = kill(pid, 15)
            nt_sleep_ms(500)
        }
        if kill(pid, 0) == 0 {
            let _k: i32 = kill(pid, 9)
            nt_sleep_ms(200)
        }
    }
    cdp_remove_profile(c)
    if ft_len(c[0].state_file) > 0 {
        let _e: bool = ft_write_file(c[0].state_file, "")
    }
}

# ---------------------------------------------------------------------------
# Messages
# ---------------------------------------------------------------------------

# Send a command; returns its id (0 when the socket is gone).
export function cdp_send(c: ptr<Cdp>, method: string, params: string, on_page: bool) -> i32 {
    let id: i32 = c[0].next_id
    c[0].next_id = id + 1
    let mut msg: string = "{\"id\":" + ft_itoa(id) + ",\"method\":" + json_quote(method) + ",\"params\":" + params
    if on_page {
        msg = msg + ",\"sessionId\":" + json_quote(c[0].session)
    }
    msg = msg + "}"
    if ws_send_text(c[0].ws, msg) == false {
        return 0
    }
    return id
}

function str_at(j: ptr<Json>, obj: i32, name: string) -> string {
    let n: i32 = json_get(j, obj, name)
    if n < 0 or json_kind(j, n) != json_kind_string() {
        return ""
    }
    return json_str(j, n)
}

# Playwright's text for a console message: the arguments joined by spaces.
function console_text(j: ptr<Json>, args: i32) -> string {
    let mut out: string = ""
    let mut a: i32 = json_first(j, args)
    let mut first: bool = true
    while a >= 0 {
        let v: i32 = json_get(j, a, "value")
        let mut piece: string = ""
        if v >= 0 and json_kind(j, v) == json_kind_string() {
            piece = json_str(j, v)
        } else {
            piece = str_at(j, a, "description")
            if ft_len(piece) == 0 {
                piece = str_at(j, a, "subtype")
            }
            if ft_len(piece) == 0 {
                piece = str_at(j, a, "type")
            }
        }
        if first == false {
            out = out + " "
        }
        out = out + piece
        first = false
        a = json_next(j, a)
    }
    return out
}

# Playwright's str() of a page error: the message without the error
# class name and without the stack.
function exception_message(j: ptr<Json>, det: i32) -> string {
    let ex: i32 = json_get(j, det, "exception")
    let mut text: string = str_at(j, ex, "description")
    if ft_len(text) == 0 {
        let v: i32 = json_get(j, ex, "value")
        if v >= 0 {
            return json_str(j, v)
        }
        return str_at(j, det, "text")
    }
    let at: i32 = ft_find(text, "\n    at ", 0)
    if at >= 0 {
        text = ft_slice(text, 0, at)
    }
    let cls: string = str_at(j, ex, "className")
    if ft_len(cls) > 0 and ft_starts(text, cls + ": ") {
        text = ft_from(text, ft_len(cls) + 2)
    } elif ft_eq(text, cls) {
        text = ""
    }
    return text
}

function handle_event(c: ptr<Cdp>, j: ptr<Json>) -> void {
    let method: string = str_at(j, 0, "method")
    if ft_len(method) == 0 {
        return
    }
    if ft_eq(str_at(j, 0, "sessionId"), c[0].session) == false {
        return
    }
    let params: i32 = json_get(j, 0, "params")
    if ft_eq(method, "Page.lifecycleEvent") {
        if ft_eq(str_at(j, params, "frameId"), c[0].target) == false {
            return
        }
        let name: string = str_at(j, params, "name")
        let loader: string = str_at(j, params, "loaderId")
        if ft_eq(name, "init") {
            c[0].loader = loader
        } elif ft_eq(name, "DOMContentLoaded") {
            c[0].dcl_loader = loader
        } elif ft_eq(name, "networkIdle") {
            c[0].idle_loader = loader
        }
    } elif ft_eq(method, "Page.navigatedWithinDocument") {
        if ft_eq(str_at(j, params, "frameId"), c[0].target) {
            c[0].same_doc_navs = c[0].same_doc_navs + 1
        }
    } elif ft_eq(method, "Runtime.consoleAPICalled") {
        if ft_eq(str_at(j, params, "type"), "error") {
            ft_list_push(c[0].errors, console_text(j, json_get(j, params, "args")))
        }
    } elif ft_eq(method, "Runtime.exceptionThrown") {
        let det: i32 = json_get(j, params, "exceptionDetails")
        ft_list_push(c[0].errors, exception_message(j, det))
    } elif ft_eq(method, "Log.entryAdded") {
        let entry: i32 = json_get(j, params, "entry")
        # Full Chrome asks for /favicon.ico on its own; the headless shell
        # Playwright drives does not, so that 404 is not the page's error.
        let auto_icon: bool = ft_eq(str_at(j, entry, "source"), "network") and ft_ends(str_at(j, entry, "url"), "/favicon.ico")
        if auto_icon == false and ft_eq(str_at(j, entry, "level"), "error") and ft_eq(str_at(j, entry, "source"), "worker") == false {
            ft_list_push(c[0].errors, str_at(j, entry, "text"))
        }
    }
}

# Read and dispatch one message. Returns it parsed, or null on timeout.
function pump(c: ptr<Cdp>, timeout_ms: i32) -> ptr<Json> {
    let text: string = ws_recv(c[0].ws, timeout_ms)
    if text as ptr<u8> == null {
        return null
    }
    let j: ptr<Json> = json_parse(text)
    if ft_len(json_error(j)) > 0 {
        return null
    }
    handle_event(c, j)
    return j
}

# Send a command and wait up to 30 s for its reply, dispatching events on
# the way. Returns the reply (check "error"), or null.
export function cdp_call(c: ptr<Cdp>, method: string, params: string, on_page: bool) -> ptr<Json> {
    let id: i32 = cdp_send(c, method, params, on_page)
    if id == 0 {
        return null
    }
    let deadline: i64 = nt_now_ms() + 30000
    while nt_now_ms() < deadline {
        let j: ptr<Json> = pump(c, (deadline - nt_now_ms()) as i32)
        if j == null {
            if ws_closed(c[0].ws) {
                return null
            }
        } else {
            let idn: i32 = json_get(j, 0, "id")
            if idn >= 0 and ft_eq(json_str(j, idn), ft_itoa(id)) {
                return j
            }
        }
    }
    c[0].timed_out = true
    return null
}

# The error message of a reply, or "" when it succeeded.
export function cdp_reply_error(j: ptr<Json>) -> string {
    if j == null {
        return "no reply"
    }
    let e: i32 = json_get(j, 0, "error")
    if e < 0 {
        return ""
    }
    return str_at(j, e, "message")
}

function result_str(j: ptr<Json>, name: string) -> string {
    return str_at(j, json_get(j, 0, "result"), name)
}

# Process events for `ms` milliseconds (Playwright's wait_for_timeout).
export function cdp_sleep(c: ptr<Cdp>, ms: i32) -> void {
    let deadline: i64 = nt_now_ms() + (ms as i64)
    while nt_now_ms() < deadline {
        let _j: ptr<Json> = pump(c, (deadline - nt_now_ms()) as i32)
    }
}

# ---------------------------------------------------------------------------
# Pages
# ---------------------------------------------------------------------------

# Open a 1440x1000 page in a fresh browser context. False on failure.
export function cdp_new_page(c: ptr<Cdp>) -> bool {
    let r1: ptr<Json> = cdp_call(c, "Target.createBrowserContext", "{\"disposeOnDetach\":true}", false)
    if ft_len(cdp_reply_error(r1)) > 0 {
        return false
    }
    c[0].ctx = result_str(r1, "browserContextId")
    let r2: ptr<Json> = cdp_call(c, "Target.createTarget", "{\"url\":\"about:blank\",\"browserContextId\":" + json_quote(c[0].ctx) + "}", false)
    if ft_len(cdp_reply_error(r2)) > 0 {
        return false
    }
    c[0].target = result_str(r2, "targetId")
    let r3: ptr<Json> = cdp_call(c, "Target.attachToTarget", "{\"targetId\":" + json_quote(c[0].target) + ",\"flatten\":true}", false)
    if ft_len(cdp_reply_error(r3)) > 0 {
        return false
    }
    c[0].session = result_str(r3, "sessionId")
    c[0].errors = ft_list_new()
    c[0].loader = ""
    c[0].dcl_loader = ""
    c[0].idle_loader = ""
    let setup: ptr<StrList> = ft_list_new()
    ft_list_push(setup, "Page.enable")
    ft_list_push(setup, "Runtime.enable")
    ft_list_push(setup, "Log.enable")
    let mut i: i32 = 0
    while i < ft_list_len(setup) {
        if ft_len(cdp_reply_error(cdp_call(c, ft_list_get(setup, i), "{}", true))) > 0 {
            return false
        }
        i = i + 1
    }
    if ft_len(cdp_reply_error(cdp_call(c, "Page.setLifecycleEventsEnabled", "{\"enabled\":true}", true))) > 0 {
        return false
    }
    let metrics: string = "{\"width\":1440,\"height\":1000,\"deviceScaleFactor\":1,\"mobile\":false,\"screenWidth\":1440,\"screenHeight\":1000}"
    return ft_len(cdp_reply_error(cdp_call(c, "Emulation.setDeviceMetricsOverride", metrics, true))) == 0
}

export function cdp_close_page(c: ptr<Cdp>) -> void {
    let _a: ptr<Json> = cdp_call(c, "Target.closeTarget", "{\"targetId\":" + json_quote(c[0].target) + "}", false)
    let _b: ptr<Json> = cdp_call(c, "Target.disposeBrowserContext", "{\"browserContextId\":" + json_quote(c[0].ctx) + "}", false)
    c[0].session = ""
}

# Errors seen on the current page so far.
export function cdp_errors(c: ptr<Cdp>) -> ptr<StrList> {
    return c[0].errors
}

# Wait for DOMContentLoaded (idle false) or network idle (idle true) of
# document `loader`.
function wait_loader(c: ptr<Cdp>, loader: string, idle: bool, deadline: i64) -> bool {
    while nt_now_ms() < deadline {
        if idle and ft_eq(c[0].idle_loader, loader) {
            return true
        }
        if idle == false and ft_eq(c[0].dcl_loader, loader) {
            return true
        }
        let j: ptr<Json> = pump(c, (deadline - nt_now_ms()) as i32)
        if j == null and ws_closed(c[0].ws) {
            return false
        }
    }
    return false
}

# page.goto(url, wait_until=...). A same-document (hash) navigation
# waits only for Page.navigatedWithinDocument, as in Playwright. Returns ""
# or an error message.
export function cdp_goto(c: ptr<Cdp>, url: string, idle: bool) -> string {
    let navs_before: i32 = c[0].same_doc_navs
    let r: ptr<Json> = cdp_call(c, "Page.navigate", "{\"url\":" + json_quote(url) + "}", true)
    let err: string = cdp_reply_error(r)
    if ft_len(err) > 0 {
        return err
    }
    let nav_err: string = result_str(r, "errorText")
    if ft_len(nav_err) > 0 {
        return nav_err + " at " + url
    }
    let loader: string = result_str(r, "loaderId")
    if ft_len(loader) == 0 {
        let deadline: i64 = nt_now_ms() + 30000
        while nt_now_ms() < deadline and c[0].same_doc_navs == navs_before {
            let j: ptr<Json> = pump(c, (deadline - nt_now_ms()) as i32)
            if j == null and ws_closed(c[0].ws) {
                return "browser closed"
            }
        }
        if c[0].same_doc_navs == navs_before {
            return "Timeout 30000ms exceeded navigating to " + url
        }
        return ""
    }
    if wait_loader(c, loader, idle, nt_now_ms() + 30000) == false {
        return "Timeout 30000ms exceeded navigating to " + url
    }
    return ""
}

# page.reload(wait_until=...). Returns "" or an error message.
export function cdp_reload(c: ptr<Cdp>, idle: bool) -> string {
    let old: string = c[0].loader
    let r: ptr<Json> = cdp_call(c, "Page.reload", "{}", true)
    let err: string = cdp_reply_error(r)
    if ft_len(err) > 0 {
        return err
    }
    let deadline: i64 = nt_now_ms() + 30000
    while nt_now_ms() < deadline and ft_eq(c[0].loader, old) {
        let j: ptr<Json> = pump(c, (deadline - nt_now_ms()) as i32)
        if j == null and ws_closed(c[0].ws) {
            return "browser closed"
        }
    }
    if wait_loader(c, c[0].loader, idle, deadline) == false {
        return "Timeout 30000ms exceeded reloading"
    }
    return ""
}

# Evaluate `expr` and return the reply. The value is read with
# cdp_value; an exception is reported by cdp_eval_error.
export function cdp_eval(c: ptr<Cdp>, expr: string) -> ptr<Json> {
    return cdp_call(c, "Runtime.evaluate", "{\"expression\":" + json_quote(expr) + ",\"returnByValue\":true,\"awaitPromise\":true}", true)
}

export function cdp_eval_error(j: ptr<Json>) -> string {
    let err: string = cdp_reply_error(j)
    if ft_len(err) > 0 {
        return err
    }
    let res: i32 = json_get(j, 0, "result")
    let det: i32 = json_get(j, res, "exceptionDetails")
    if det < 0 {
        return ""
    }
    let ex: i32 = json_get(j, det, "exception")
    let d: string = str_at(j, ex, "description")
    if ft_len(d) > 0 {
        return d
    }
    return str_at(j, det, "text")
}

# Node id of result.result.value, or -1 (undefined).
export function cdp_value(j: ptr<Json>) -> i32 {
    let res: i32 = json_get(j, 0, "result")
    let inner: i32 = json_get(j, res, "result")
    return json_get(j, inner, "value")
}

export function cdp_mouse(c: ptr<Cdp>, kind: string, x: i32, y: i32, dy: i32) -> void {
    let mut p: string = "{\"type\":" + json_quote(kind) + ",\"x\":" + ft_itoa(x) + ",\"y\":" + ft_itoa(y)
    if ft_eq(kind, "mouseWheel") {
        p = p + ",\"deltaX\":0,\"deltaY\":" + ft_itoa(dy)
    }
    let _r: ptr<Json> = cdp_call(c, "Input.dispatchMouseEvent", p + "}", true)
}
