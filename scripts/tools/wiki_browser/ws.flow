# @module tools.wiki_browser.ws
# @means  A minimal RFC 6455 WebSocket client over plain ws://.
#
# Enough for the Chrome DevTools Protocol: the opening handshake with a
# checked Sec-WebSocket-Accept, masked client text frames, reading text
# frames with fragmentation, answering ping with pong, and close.

import .text { ft_len, ft_find, ft_slice, ft_ascii_lower, ft_starts, ft_itoa }
import .net

extern {
    function malloc(size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
    function rand() -> i32
    function srand(seed: i32) -> void
    function getpid() -> i32
}

struct Ws {
    fd: i32
    buf: ptr<u8>
    pos: i32
    len: i32
    cap: i32
    msg: ptr<u8>
    mlen: i32
    mcap: i32
    closed: bool
    err: string
}

# ---------------------------------------------------------------------------
# SHA-1 and base64, for the handshake key
# ---------------------------------------------------------------------------

function u32(x: i64) -> i64 {
    return x & 4294967295
}

function rotl(x: i64, n: i64) -> i64 {
    return u32((x << n) | (x >> (32 - n)))
}

# SHA-1 of the first `n` bytes of `data`; 20 bytes.
function sha1(data: ptr<u8>, n: i32) -> ptr<u8> {
    let total: i32 = ((n + 8) / 64 + 1) * 64
    let m: ptr<u8> = malloc(total as i64) as ptr<u8>
    let mut i: i32 = 0
    while i < total {
        if i < n {
            m[i] = data[i]
        } else {
            m[i] = 0
        }
        i = i + 1
    }
    m[n] = 128
    let bits: i64 = (n as i64) * 8
    let mut k: i32 = 0
    while k < 8 {
        m[total - 1 - k] = ((bits >> ((k * 8) as i64)) & 255) as u8
        k = k + 1
    }
    let mut h0: i64 = 1732584193
    let mut h1: i64 = 4023233417
    let mut h2: i64 = 2562383102
    let mut h3: i64 = 271733878
    let mut h4: i64 = 3285377520
    let w: ptr<i64> = malloc(80 * 8) as ptr<i64>
    let mut off: i32 = 0
    while off < total {
        let mut t: i32 = 0
        while t < 16 {
            let b: i32 = off + t * 4
            w[t] = ((m[b] as i64) << 24) | ((m[b + 1] as i64) << 16) | ((m[b + 2] as i64) << 8) | (m[b + 3] as i64)
            t = t + 1
        }
        while t < 80 {
            w[t] = rotl(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1)
            t = t + 1
        }
        let mut a: i64 = h0
        let mut b2: i64 = h1
        let mut c: i64 = h2
        let mut d: i64 = h3
        let mut e: i64 = h4
        t = 0
        while t < 80 {
            let mut f: i64 = 0
            let mut kk: i64 = 0
            if t < 20 {
                f = (b2 & c) | ((b2 ^ 4294967295) & d)
                kk = 1518500249
            } elif t < 40 {
                f = b2 ^ c ^ d
                kk = 1859775393
            } elif t < 60 {
                f = (b2 & c) | (b2 & d) | (c & d)
                kk = 2400959708
            } else {
                f = b2 ^ c ^ d
                kk = 3395469782
            }
            let tmp: i64 = u32(rotl(a, 5) + f + e + kk + w[t])
            e = d
            d = c
            c = rotl(b2, 30)
            b2 = a
            a = tmp
            t = t + 1
        }
        h0 = u32(h0 + a)
        h1 = u32(h1 + b2)
        h2 = u32(h2 + c)
        h3 = u32(h3 + d)
        h4 = u32(h4 + e)
        off = off + 64
    }
    let out: ptr<u8> = malloc(20) as ptr<u8>
    let hs: ptr<i64> = malloc(5 * 8) as ptr<i64>
    hs[0] = h0
    hs[1] = h1
    hs[2] = h2
    hs[3] = h3
    hs[4] = h4
    let mut q: i32 = 0
    while q < 5 {
        out[q * 4] = ((hs[q] >> 24) & 255) as u8
        out[q * 4 + 1] = ((hs[q] >> 16) & 255) as u8
        out[q * 4 + 2] = ((hs[q] >> 8) & 255) as u8
        out[q * 4 + 3] = (hs[q] & 255) as u8
        q = q + 1
    }
    return out
}

function base64(data: ptr<u8>, n: i32) -> string {
    let tbl: ptr<u8> = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" as ptr<u8>
    let out: ptr<u8> = malloc(((n + 2) / 3 * 4 + 1) as i64) as ptr<u8>
    let mut i: i32 = 0
    let mut o: i32 = 0
    while i < n {
        let b0: i32 = data[i] as i32
        let mut b1: i32 = 0
        let mut b2: i32 = 0
        if i + 1 < n {
            b1 = data[i + 1] as i32
        }
        if i + 2 < n {
            b2 = data[i + 2] as i32
        }
        out[o] = tbl[b0 >> 2]
        out[o + 1] = tbl[((b0 & 3) << 4) | (b1 >> 4)]
        if i + 1 < n {
            out[o + 2] = tbl[((b1 & 15) << 2) | (b2 >> 6)]
        } else {
            out[o + 2] = 61
        }
        if i + 2 < n {
            out[o + 3] = tbl[b2 & 63]
        } else {
            out[o + 3] = 61
        }
        o = o + 4
        i = i + 3
    }
    out[o] = 0
    return out as string
}

# Sec-WebSocket-Accept for a client key (RFC 6455 section 4.2.2).
export function ws_accept_for(key: string) -> string {
    let s: string = key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
    return base64(sha1(s as ptr<u8>, ft_len(s)), 20)
}

# ---------------------------------------------------------------------------
# Buffered reading
# ---------------------------------------------------------------------------

# Make at least `need` unread bytes available, reading until `deadline`
# (milliseconds from nt_now_ms). False on timeout or close.
function ws_fill(w: ptr<Ws>, need: i32, deadline: i64) -> bool {
    while w[0].len - w[0].pos < need {
        if w[0].pos > 0 {
            # Compact the buffer before reading more.
            let rest: i32 = w[0].len - w[0].pos
            let b: ptr<u8> = w[0].buf
            let mut i: i32 = 0
            while i < rest {
                b[i] = b[w[0].pos + i]
                i = i + 1
            }
            w[0].len = rest
            w[0].pos = 0
        }
        if w[0].cap - w[0].len < 65536 {
            let nc: i32 = w[0].cap * 2 + 65536
            w[0].buf = realloc(w[0].buf as ptr<void>, nc as i64) as ptr<u8>
            w[0].cap = nc
        }
        let left: i64 = deadline - nt_now_ms()
        if left <= 0 {
            return false
        }
        if nt_readable(w[0].fd, left as i32) == false {
            return false
        }
        let b2: ptr<u8> = w[0].buf
        let got: i64 = nt_recv(w[0].fd, &b2[w[0].len], (w[0].cap - w[0].len) as i64)
        if got <= 0 {
            w[0].closed = true
            w[0].err = "connection closed"
            return false
        }
        w[0].len = w[0].len + (got as i32)
    }
    return true
}

function ws_byte(w: ptr<Ws>, at: i32) -> i32 {
    let b: ptr<u8> = w[0].buf
    return b[w[0].pos + at] as i32
}

# ---------------------------------------------------------------------------
# Connect
# ---------------------------------------------------------------------------

# Open ws://127.0.0.1:<port><path>. Returns null on failure.
export function ws_connect(port: i32, path: string) -> ptr<Ws> {
    let fd: i32 = nt_connect_local(port)
    if fd < 0 {
        return null
    }
    let w: ptr<Ws> = malloc(128) as ptr<Ws>
    w[0].fd = fd
    w[0].cap = 262144
    w[0].buf = malloc(262144) as ptr<u8>
    w[0].pos = 0
    w[0].len = 0
    w[0].mcap = 262144
    w[0].msg = malloc(262144) as ptr<u8>
    w[0].mlen = 0
    w[0].closed = false
    w[0].err = ""

    srand(getpid() + (nt_now_ms() % 1000000) as i32)
    let raw: ptr<u8> = malloc(16) as ptr<u8>
    let mut i: i32 = 0
    while i < 16 {
        raw[i] = (rand() & 255) as u8
        i = i + 1
    }
    let key: string = base64(raw, 16)
    let req: string = "GET " + path + " HTTP/1.1\r\n" +
        "Host: 127.0.0.1:" + ft_itoa(port) + "\r\n" +
        "Upgrade: websocket\r\n" +
        "Connection: Upgrade\r\n" +
        "Sec-WebSocket-Key: " + key + "\r\n" +
        "Sec-WebSocket-Version: 13\r\n\r\n"
    if nt_send_str(fd, req, ft_len(req)) == false {
        nt_close(fd)
        return null
    }

    # Read the response head.
    let deadline: i64 = nt_now_ms() + 10000
    let mut head_end: i32 = -1
    while head_end < 0 {
        if ws_fill(w, w[0].len - w[0].pos + 1, deadline) == false {
            nt_close(fd)
            return null
        }
        let b: ptr<u8> = w[0].buf
        b[w[0].len] = 0
        head_end = ft_find(b as string, "\r\n\r\n", 0)
    }
    let head: string = ft_ascii_lower(ft_slice(w[0].buf as string, 0, head_end))
    w[0].pos = head_end + 4
    if ft_starts(head, "http/1.1 101") == false {
        nt_close(fd)
        return null
    }
    let want: string = "sec-websocket-accept: " + ft_ascii_lower(ws_accept_for(key))
    if ft_find(head, want, 0) < 0 {
        nt_close(fd)
        return null
    }
    return w
}

# ---------------------------------------------------------------------------
# Frames
# ---------------------------------------------------------------------------

function ws_send_frame(w: ptr<Ws>, opcode: i32, data: ptr<u8>, n: i64) -> bool {
    let frame: ptr<u8> = malloc(n + 16) as ptr<u8>
    frame[0] = (128 | opcode) as u8
    let mut o: i32 = 2
    if n < 126 {
        frame[1] = (128 | (n as i32)) as u8
    } elif n < 65536 {
        frame[1] = 254
        frame[2] = ((n >> 8) & 255) as u8
        frame[3] = (n & 255) as u8
        o = 4
    } else {
        frame[1] = 255
        let mut k: i32 = 0
        while k < 8 {
            frame[2 + k] = ((n >> ((56 - k * 8) as i64)) & 255) as u8
            k = k + 1
        }
        o = 10
    }
    let mask: ptr<u8> = &frame[o]
    let mut i: i32 = 0
    while i < 4 {
        mask[i] = (rand() & 255) as u8
        i = i + 1
    }
    o = o + 4
    let mut j: i64 = 0
    while j < n {
        frame[(o as i64) + j] = ((data[j] as i32) ^ (mask[(j % 4) as i32] as i32)) as u8
        j = j + 1
    }
    return nt_send_all(w[0].fd, frame, (o as i64) + n)
}

export function ws_send_text(w: ptr<Ws>, text: string) -> bool {
    return ws_send_frame(w, 1, text as ptr<u8>, ft_len(text) as i64)
}

function ws_msg_append(w: ptr<Ws>, src: ptr<u8>, n: i32) -> void {
    if w[0].mlen + n + 1 > w[0].mcap {
        let mut nc: i32 = w[0].mcap * 2
        while nc < w[0].mlen + n + 1 {
            nc = nc * 2
        }
        w[0].msg = realloc(w[0].msg as ptr<void>, nc as i64) as ptr<u8>
        w[0].mcap = nc
    }
    let m: ptr<u8> = w[0].msg
    let mut i: i32 = 0
    while i < n {
        m[w[0].mlen + i] = src[i]
        i = i + 1
    }
    w[0].mlen = w[0].mlen + n
}

# The next complete text message, or null when `timeout_ms` passes first or
# the connection closes (ws_closed tells which). Pings are answered.
export function ws_recv(w: ptr<Ws>, timeout_ms: i32) -> string {
    let deadline: i64 = nt_now_ms() + (timeout_ms as i64)
    while true {
        if w[0].closed {
            return null as string
        }
        if ws_fill(w, 2, deadline) == false {
            return null as string
        }
        let b0: i32 = ws_byte(w, 0)
        let b1: i32 = ws_byte(w, 1)
        let fin: bool = (b0 & 128) != 0
        let op: i32 = b0 & 15
        let masked: bool = (b1 & 128) != 0
        let mut plen: i64 = (b1 & 127) as i64
        let mut hdr: i32 = 2
        if plen == 126 {
            if ws_fill(w, 4, deadline) == false {
                return null as string
            }
            plen = ((ws_byte(w, 2) << 8) | ws_byte(w, 3)) as i64
            hdr = 4
        } elif plen == 127 {
            if ws_fill(w, 10, deadline) == false {
                return null as string
            }
            plen = 0
            let mut k: i32 = 0
            while k < 8 {
                plen = (plen << 8) | (ws_byte(w, 2 + k) as i64)
                k = k + 1
            }
            hdr = 10
        }
        if masked {
            hdr = hdr + 4
        }
        if plen > 1073741824 {
            w[0].closed = true
            w[0].err = "frame too large"
            return null as string
        }
        let total: i32 = hdr + (plen as i32)
        if ws_fill(w, total, deadline) == false {
            return null as string
        }
        let base: ptr<u8> = w[0].buf
        let payload: ptr<u8> = &base[w[0].pos + hdr]
        if masked {
            let mk: ptr<u8> = &base[w[0].pos + hdr - 4]
            let mut q: i32 = 0
            while q < (plen as i32) {
                payload[q] = ((payload[q] as i32) ^ (mk[q % 4] as i32)) as u8
                q = q + 1
            }
        }
        w[0].pos = w[0].pos + total
        if op == 8 {
            let _c: bool = ws_send_frame(w, 8, payload, 0)
            w[0].closed = true
            w[0].err = "closed by peer"
            return null as string
        }
        if op == 9 {
            let _p: bool = ws_send_frame(w, 10, payload, plen)
        } elif op == 10 {
            let _n: i32 = 0
        } else {
            if op == 1 or op == 2 {
                w[0].mlen = 0
            }
            ws_msg_append(w, payload, plen as i32)
            if fin {
                let m: ptr<u8> = w[0].msg
                m[w[0].mlen] = 0
                let out: ptr<u8> = malloc((w[0].mlen + 1) as i64) as ptr<u8>
                let mut z: i32 = 0
                while z <= w[0].mlen {
                    out[z] = m[z]
                    z = z + 1
                }
                w[0].mlen = 0
                return out as string
            }
        }
    }
    return null as string
}

export function ws_closed(w: ptr<Ws>) -> bool {
    return w[0].closed
}

export function ws_close(w: ptr<Ws>) -> void {
    if w[0].closed == false {
        let empty: ptr<u8> = malloc(1) as ptr<u8>
        let _c: bool = ws_send_frame(w, 8, empty, 0)
        w[0].closed = true
    }
    nt_close(w[0].fd)
}
