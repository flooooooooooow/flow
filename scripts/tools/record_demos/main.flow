# Record docs/demos/*.gif by running the real Flow programs headlessly.
#
# Run through scripts/record_demos.sh from anywhere:
#
#   scripts/record_demos.sh            # all demos
#   scripts/record_demos.sh lorenz     # one demo
#   scripts/record_demos.sh --group morphogenesis
#   scripts/record_demos.sh --group neuro
#   scripts/record_demos.sh --group evoleco
#   scripts/record_demos.sh --group planet
#   scripts/record_demos.sh --group procgen
#   scripts/record_demos.sh --group numerical
#   scripts/record_demos.sh --check    # list every GIF, fail if one is missing
#
# Each demo is compiled with `./flow record`, which links the program against
# runtime/gfx_record.c instead of a windowing backend. The program then draws
# into an off-screen buffer and writes every presented frame as a PPM, so the
# resulting GIF is genuine output from the compiled Flow program rather than a
# re-creation of it. No display is required, which means this also works in
# CI.
#
# Naming contract: every game in examples/games/ has a GIF at
# docs/demos/games/<name>.gif, every example in examples/morphogenesis/ has
# one at docs/demos/morphogenesis/<name>.gif, every example in
# examples/neuro/ has one at docs/demos/neuro/<name>.gif, every example in
# examples/evoleco/ has one at docs/demos/evoleco/<name>.gif, every example
# in examples/planet/ has one at docs/demos/planet/<name>.gif, every example
# in examples/procgen/ has one at docs/demos/procgen/<name>.gif, and
# numerical clips live at docs/demos/numerical/<name>.gif. The three
# original demos (lorenz, tetris, 2048) also keep their GIFs directly in
# docs/demos/; tetris.gif and 2048.gif are copied into docs/demos/games/ so
# the games directory is complete.
#
# Interactive demos are driven by `flow record --keys`, a list of
# `first-last:keycode` windows over frame numbers (see runtime/gfx_record.c).
# Because the recorder and every game are fully deterministic (fixed RNG
# seeds, frame-counted input), several of the longer scripts below were
# derived by simulating the game's exact integer logic offline and searching
# for input that plays well; the frame windows encode that play.
#
# The GIF side is scripts/tools/lib/gifclip.flow: optional crop to the drawn
# area, Lanczos or nearest-neighbour scaling, one median-cut palette for the
# whole clip, no dithering, disposal 1 so only changed pixels are stored.

import .text { ft_out, ft_outln, ft_errln, ft_err, ft_eq, ft_len, ft_itoa, ft_repr, ft_starts, ft_ends, ft_slice, ft_from, ft_byte, ft_find_byte, ft_rjust, ft_ljust, ft_read_file, ft_exists, ft_split_lines, ft_list_new, ft_list_push, ft_list_len, ft_list_get, ft_list_has, ft_list_sort, ft_list_sorted_unique, StrList }
import .proc { pr_quote, pr_run, pr_capture, pr_chomp, pr_resolve, pr_mkdir_p }
import .gifclip { gc_frames_new, gc_frames_push, gc_frames_get, gc_read_ppm, gc_crop, gc_resize_nearest, gc_resize_lanczos, gc_clip_palette, gc_write_gif, GcFrames }

extern {
    function getenv(name: string) -> string
    function exit(code: i32) -> void
    function malloc(size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function atoi(s: string) -> i32
    function strcmp(a: string, b: string) -> i32
    function fopen(path: string, mode: string) -> ptr<void>
    function fseek(fp: ptr<void>, offset: i64, whence: i32) -> i32
    function ftell(fp: ptr<void>) -> i64
    function fclose(fp: ptr<void>) -> i32
}

# macOS virtual keycodes, matching lib/stdlib/gfx.flow.
const KEY_LEFT: i32 = 123
const KEY_RIGHT: i32 = 124
const KEY_DOWN: i32 = 125
const KEY_UP: i32 = 126
const KEY_SPACE: i32 = 49
const KEY_F: i32 = 3       # minesweeper: flag
const KEY_N: i32 = 45      # chetris: skip chess move

# ---------------------------------------------------------------------------
# Input scripts
# ---------------------------------------------------------------------------

# A key held from `frame` for `length` frames.
function hold(frame: i32, key: i32, length: i32) -> string {
    return ft_itoa(frame) + "-" + ft_itoa(frame + length - 1) + ":" + ft_itoa(key)
}

function span(a: i32, b: i32, key: i32) -> string {
    return ft_itoa(a) + "-" + ft_itoa(b) + ":" + ft_itoa(key)
}

function join(parts: ptr<StrList>) -> string {
    let mut out: string = ""
    let mut i: i32 = 0
    while i < ft_list_len(parts) {
        if i > 0 {
            out = out + ","
        }
        out = out + ft_list_get(parts, i)
        i = i + 1
    }
    return out
}

# Builds an edge-press schedule while tracking the current frame. Games do
# edge detection, so each press is its own 2-frame window with a gap before
# the next one.
struct Tapper {
    frame: i32
    gap: i32
    presses: ptr<StrList>
}

function tapper(frame: i32, gap: i32) -> ptr<Tapper> {
    let t: ptr<Tapper> = malloc(24) as ptr<Tapper>
    t[0].frame = frame
    t[0].gap = gap
    t[0].presses = ft_list_new()
    return t
}

# The key a letter names: L R D U for the arrows, S for space, N for the
# chetris skip key.
function key_of(c: i32) -> i32 {
    if c == 76 {
        return KEY_LEFT
    }
    if c == 82 {
        return KEY_RIGHT
    }
    if c == 68 {
        return KEY_DOWN
    }
    if c == 85 {
        return KEY_UP
    }
    if c == 78 {
        return KEY_N
    }
    return KEY_SPACE
}

# One press per letter of `keys`, `gap` frames apart.
function tap(t: ptr<Tapper>, keys: string) -> void {
    let mut i: i32 = 0
    while i < ft_len(keys) {
        ft_list_push(t[0].presses, hold(t[0].frame, key_of(ft_byte(keys, i)), 2))
        t[0].frame = t[0].frame + t[0].gap
        i = i + 1
    }
}

function tap_wait(t: ptr<Tapper>, frames: i32) -> void {
    t[0].frame = t[0].frame + frames
}

function tapper_keys(t: ptr<Tapper>) -> string {
    return join(t[0].presses)
}

# `s` repeated `n` times.
function times(s: string, n: i32) -> string {
    let mut out: string = ""
    let mut i: i32 = 0
    while i < n {
        out = out + s
        i = i + 1
    }
    return out
}

# A scripted playthrough: nudge sideways, rotate, then hard-drop.
#
# The natural fall delay is 48 frames per cell, far too slow to watch, so the
# demo leans on hard drops to keep pieces landing every couple of seconds.
function tetris_script() -> string {
    # (key, repeats) per piece, then a hard drop.
    let moves: string = "L2U1R3U1L3R1U2L4R2U1L1"
    let parts: ptr<StrList> = ft_list_new()
    let mut frame: i32 = 12
    let mut i: i32 = 0
    while i < ft_len(moves) {
        let key: i32 = key_of(ft_byte(moves, i))
        let repeats: i32 = ft_byte(moves, i + 1) - 48
        let mut r: i32 = 0
        while r < repeats {
            ft_list_push(parts, hold(frame, key, 3))
            frame = frame + 7  # gap so the game's edge detection sees a fresh press
            r = r + 1
        }
        ft_list_push(parts, hold(frame, KEY_SPACE, 3))
        frame = frame + 12
        i = i + 2
    }
    return join(parts)
}

function g2048_script() -> string {
    let keys: string = "LDRDLURDLDRULDRD"
    let parts: ptr<StrList> = ft_list_new()
    let mut frame: i32 = 10
    let mut i: i32 = 0
    while i < ft_len(keys) {
        ft_list_push(parts, hold(frame, key_of(ft_byte(keys, i)), 3))
        frame = frame + 14
        i = i + 1
    }
    return join(parts)
}

