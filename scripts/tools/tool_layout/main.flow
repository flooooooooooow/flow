# Keep one implementation per repository tool.
#
# A tool lives under tools/NAME or scripts/tools/NAME, never both: the two
# copies drift, and `flow tool NAME` would pick one silently. Run it as
# `./flow tool tool_layout` from anywhere in the repository. It prints
# "tool-layout: no mirrored tool directories" and exits 0, or names every
# directory found under both on stderr and exits 1.

import .text { ft_outln, ft_errln, ft_eq, ft_len, ft_basename, ft_list_new, ft_list_push, ft_list_len, ft_list_get, ft_list_sort, StrList }
import .repo { rp_enter_root, rp_lines, rp_argv3 }

extern {
    function access(path: string, mode: i32) -> i32
}

# Names of the directories directly under `dir`, sorted by bytes; empty when
# `dir` does not exist.
function child_dirs(dir: string) -> ptr<StrList> {
    let out: ptr<StrList> = ft_list_new()
    if access(dir, 0) != 0 {
        return out
    }
    let argv: ptr<StrList> = rp_argv3("find", dir, "-mindepth")
    ft_list_push(argv, "1")
    ft_list_push(argv, "-maxdepth")
    ft_list_push(argv, "1")
    ft_list_push(argv, "-type")
    ft_list_push(argv, "d")
    let lines: ptr<StrList> = rp_lines(argv)
    if lines == null {
        return out
    }
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        if ft_len(ft_list_get(lines, i)) > 0 {
            ft_list_push(out, ft_basename(ft_list_get(lines, i)))
        }
        i = i + 1
    }
    ft_list_sort(out)
    return out
}

function main() -> i32 {
    if rp_enter_root() == false {
        ft_errln("tool-layout: cannot enter the repository root")
        return 1
    }
    let a: ptr<StrList> = child_dirs("tools")
    let b: ptr<StrList> = child_dirs("scripts/tools")
    let mut found: i32 = 0
    let mut i: i32 = 0
    while i < ft_list_len(a) {
        let name: string = ft_list_get(a, i)
        let mut j: i32 = 0
        let mut both: bool = false
        while j < ft_list_len(b) {
            if ft_eq(ft_list_get(b, j), name) {
                both = true
            }
            j = j + 1
        }
        if both {
            ft_errln("tool-layout: '" + name + "' exists under both tools/ and scripts/tools/; choose one canonical implementation and keep scripts/ as thin automation")
            found = found + 1
        }
        i = i + 1
    }
    if found == 0 {
        ft_outln("tool-layout: no mirrored tool directories")
        return 0
    }
    return 1
}
