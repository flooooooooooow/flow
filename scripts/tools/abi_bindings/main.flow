# Generate C and Flow bindings from a .abi file.
#
# Run through scripts/gen_abi_bindings.sh:
#
#   gen_abi_bindings.sh demos/vulkan_abi/renderer.abi [--out-dir DIR]
#
# Each non-blank, non-comment line of the .abi file is a signature
#
#   fn name(arg: type, ...) -> type
#
# and becomes a prototype in <stem>.h and an extern in <stem>.flow, written
# next to the .abi file unless --out-dir says otherwise. Types are Flow
# scalars, ptr<T> or cptr<T> (a const pointer on the C side).
#
# Output and messages match the Python script this replaces. The signature
# is matched by hand; the pattern was
#   fn\s+([A-Za-z_][A-Za-z0-9_]*)\s*\((.*)\)\s*->\s*([^\s]+)\s*$

import .text { ft_out, ft_err, ft_errln, ft_eq, ft_len, ft_starts, ft_ends, ft_at, ft_find, ft_rfind_byte, ft_slice, ft_from, ft_replace, ft_read_file, ft_write_file, ft_exists, ft_list_new, ft_list_push, ft_list_len, ft_list_get, StrList }
import .unicode { uc_decode, uc_len, uc_is_space, uc_strip }
import .mdtext { md_splitlines }
import .proc { pr_mkdir_p, pr_is_dir }

extern {
    function malloc(size: i64) -> ptr<void>
}

const PROG: string = "gen_abi_bindings.sh"
const TOOL: string = "scripts/gen_abi_bindings.sh"

function usage_line() -> string {
    return "usage: gen_abi_bindings.sh [-h] [--out-dir OUT_DIR] abi_file\n"
}

function help_text() -> string {
    return usage_line() + "\nGenerate C and Flow bindings from a .abi file.\n\npositional arguments:\n  abi_file           Path to .abi file\n\noptions:\n  -h, --help         show this help message and exit\n  --out-dir OUT_DIR  Output directory (defaults to ABI file directory)\n"
}

function usage_error(msg: string) -> i32 {
    ft_err(usage_line() + PROG + ": error: " + msg + "\n")
    return 2
}

# str(Path(s)): repeated slashes collapse, "." parts and a trailing slash go.
function path_str(s: string) -> string {
    if ft_len(s) == 0 {
        return "."
    }
    let parts: ptr<StrList> = ft_list_new()
    let mut start: i32 = 0
    let n: i32 = ft_len(s)
    let mut i: i32 = 0
    while i <= n {
        if i == n or ft_at(s, i, "/") {
            let part: string = ft_slice(s, start, i)
            if ft_len(part) > 0 and ft_eq(part, ".") == false {
                ft_list_push(parts, part)
            }
            start = i + 1
        }
        i = i + 1
    }
    let mut out: string = ""
    if ft_starts(s, "/") {
        out = "/"
        if ft_starts(s, "//") and ft_starts(s, "///") == false {
            out = "//"
        }
    }
    let mut k: i32 = 0
    while k < ft_list_len(parts) {
        if k > 0 {
            out = out + "/"
        }
        out = out + ft_list_get(parts, k)
        k = k + 1
    }
    if ft_len(out) == 0 {
        return "."
    }
    return out
}

# Path(s).parent, for a string already in path_str form.
function path_parent(p: string) -> string {
    let slash: i32 = ft_rfind_byte(p, 47)
    if slash < 0 {
        return "."
    }
    if slash == 0 {
        return "/"
    }
    if slash == 1 and ft_starts(p, "//") {
        return "//"
    }
    return ft_slice(p, 0, slash)
}

# Path(name).with_suffix(suffix).name
function with_suffix(name: string, suffix: string) -> string {
    let dot: i32 = ft_rfind_byte(name, 46)
    if dot > 0 and dot < ft_len(name) - 1 {
        return ft_slice(name, 0, dot) + suffix
    }
    return name + suffix
}

function map_c(t: string) -> string {
    if ft_eq(t, "i32") { return "int32_t" }
    if ft_eq(t, "u8") { return "uint8_t" }
    if ft_eq(t, "u16") { return "uint16_t" }
    if ft_eq(t, "f32") { return "float" }
    if ft_eq(t, "f64") { return "double" }
    if ft_eq(t, "bool") { return "bool" }
    if ft_eq(t, "string") { return "const char*" }
    if ft_eq(t, "void") { return "void" }
    return t
}

function map_flow(t: string) -> string {
    if ft_eq(t, "bool") { return "i32" }
    return t
}

function c_type(raw: string) -> string {
    let t: string = uc_strip(raw)
    if ft_starts(t, "cptr<") and ft_ends(t, ">") and ft_len(t) >= 6 {
        return "const " + map_c(uc_strip(ft_slice(t, 5, ft_len(t) - 1))) + "*"
    }
    if ft_starts(t, "ptr<") and ft_ends(t, ">") and ft_len(t) >= 5 {
        return map_c(uc_strip(ft_slice(t, 4, ft_len(t) - 1))) + "*"
    }
    return map_c(t)
}

function flow_type(raw: string) -> string {
    let t: string = uc_strip(raw)
    if ft_starts(t, "cptr<") and ft_ends(t, ">") and ft_len(t) >= 6 {
        return "ptr<" + map_flow(uc_strip(ft_slice(t, 5, ft_len(t) - 1))) + ">"
    }
    if ft_starts(t, "ptr<") and ft_ends(t, ">") and ft_len(t) >= 5 {
        return "ptr<" + map_flow(uc_strip(ft_slice(t, 4, ft_len(t) - 1))) + ">"
    }
    return map_flow(t)
}

function ws_len(p: ptr<u8>, at: i32) -> i32 {
    let c: i32 = p[at] as i32
    if c == 0 {
        return 0
    }
    if uc_is_space(uc_decode(p, at)) {
        return uc_len(c)
    }
    return 0
}

function skip_ws(p: ptr<u8>, at: i32) -> i32 {
    let mut q: i32 = at
    let mut w: i32 = ws_len(p, q)
    while w > 0 {
        q = q + w
        w = ws_len(p, q)
    }
    return q
}

function is_ident(c: i32, first: bool) -> bool {
    if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 {
        return true
    }
    return first == false and c >= 48 and c <= 57
}

# \s*->\s*([^\s]+)\s*$ from `at` to the end. Returns the start of the
# return type, or -1; its end goes to rt_end[0].
function tail_match(line: string, at: i32, rt_end: ptr<i32>) -> i32 {
    let p: ptr<u8> = line as ptr<u8>
    let mut q: i32 = skip_ws(p, at)
    if ft_at(line, q, "->") == false {
        return -1
    }
    q = skip_ws(p, q + 2)
    let rs: i32 = q
    while p[q] != 0 and ws_len(p, q) == 0 {
        q = q + uc_len(p[q] as i32)
    }
    if q == rs {
        return -1
    }
    let re: i32 = q
    q = skip_ws(p, q)
    if p[q] != 0 {
        return -1
    }
    rt_end[0] = re
    return rs
}

struct Sig {
    name: string
    argn: ptr<StrList>
    argt: ptr<StrList>
    ret: string
    error: string
}

# parse_signature(): null when the line does not match; `error` set on a
# malformed argument.
function parse_signature(line: string) -> ptr<Sig> {
    let p: ptr<u8> = line as ptr<u8>
    if ft_at(line, 0, "fn") == false {
        return null
    }
    let ns: i32 = skip_ws(p, 2)
    if ns == 2 or is_ident(p[ns] as i32, true) == false {
        return null
    }
    let mut ne: i32 = ns + 1
    while is_ident(p[ne] as i32, false) {
        ne = ne + 1
    }
    let lp: i32 = skip_ws(p, ne)
    if p[lp] != 40 {
        return null
    }
    # (.*) is greedy: try each ')' from the right.
    let rt_end: ptr<i32> = malloc(8) as ptr<i32>
    let mut close: i32 = ft_len(line) - 1
    let mut rs: i32 = -1
    while close > lp {
        if p[close] == 41 {
            rs = tail_match(line, close + 1, rt_end)
            if rs >= 0 {
                break
            }
        }
        close = close - 1
    }
    if rs < 0 {
        return null
    }
    let sg: ptr<Sig> = malloc(48) as ptr<Sig>
    sg[0].name = ft_slice(line, ns, ne)
    sg[0].ret = ft_slice(line, rs, rt_end[0])
    sg[0].argn = ft_list_new()
    sg[0].argt = ft_list_new()
    sg[0].error = null
    let args_raw: string = uc_strip(ft_slice(line, lp + 1, close))
    if ft_len(args_raw) == 0 {
        return sg
    }
    let mut start: i32 = 0
    let n: i32 = ft_len(args_raw)
    let mut i: i32 = 0
    while i <= n {
        if i == n or ft_at(args_raw, i, ",") {
            let part: string = uc_strip(ft_slice(args_raw, start, i))
            if ft_len(part) > 0 {
                let colon: i32 = ft_find(part, ":", 0)
                if colon < 0 or ft_find(part, ":", colon + 1) >= 0 {
                    sg[0].error = "Invalid arg: " + part
                    return sg
                }
                ft_list_push(sg[0].argn, uc_strip(ft_slice(part, 0, colon)))
                ft_list_push(sg[0].argt, uc_strip(ft_from(part, colon + 1)))
            }
            start = i + 1
        }
        i = i + 1
    }
    return sg
}

function ascii_upper(s: string) -> string {
    let p: ptr<u8> = s as ptr<u8>
    let n: i32 = ft_len(s)
    let out: ptr<u8> = malloc((n + 1) as i64) as ptr<u8>
    let mut i: i32 = 0
    while i < n {
        let c: i32 = p[i] as i32
        if c >= 97 and c <= 122 {
            out[i] = (c - 32) as u8
        } else {
            out[i] = c as u8
        }
        i = i + 1
    }
    out[n] = 0
    return out as string
}

function c_header(sigs: ptr<ptr<Sig>>, count: i32, header_name: string) -> string {
    let guard: string = ft_replace(ascii_upper(header_name), ".", "_")
    let mut out: string = "// Auto-generated by " + TOOL + ". Do not edit by hand.\n"
    out = out + "#ifndef " + guard + "\n#define " + guard + "\n\n"
    out = out + "#include <stdint.h>\n#include <stdbool.h>\n\n"
    out = out + "#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n"
    let mut i: i32 = 0
    while i < count {
        let sg: ptr<Sig> = sigs[i]
        let mut args_c: string = ""
        let mut a: i32 = 0
        while a < ft_list_len(sg[0].argn) {
            if a > 0 {
                args_c = args_c + ", "
            }
            args_c = args_c + c_type(ft_list_get(sg[0].argt, a)) + " " + ft_list_get(sg[0].argn, a)
            a = a + 1
        }
        if a == 0 {
            args_c = "void"
        }
        out = out + c_type(sg[0].ret) + " " + sg[0].name + "(" + args_c + ");\n"
        i = i + 1
    }
    out = out + "\n#ifdef __cplusplus\n}\n#endif\n\n#endif // " + guard + "\n"
    return out
}

function flow_bindings(sigs: ptr<ptr<Sig>>, count: i32) -> string {
    let mut out: string = "# Auto-generated by " + TOOL + ". Do not edit by hand.\nextern {\n"
    let mut i: i32 = 0
    while i < count {
        let sg: ptr<Sig> = sigs[i]
        let mut args_f: string = ""
        let mut a: i32 = 0
        while a < ft_list_len(sg[0].argn) {
            if a > 0 {
                args_f = args_f + ", "
            }
            args_f = args_f + ft_list_get(sg[0].argn, a) + ": " + flow_type(ft_list_get(sg[0].argt, a))
            a = a + 1
        }
        out = out + "    function " + sg[0].name + "(" + args_f + ") -> " + flow_type(sg[0].ret) + "\n"
        i = i + 1
    }
    return out + "}\n"
}

# argparse prefix matching for the two long options.
function long_opt(name: string) -> string {
    if ft_eq(name, "--help") or ft_eq(name, "--out-dir") {
        return name
    }
    let h: bool = ft_starts("--help", name)
    let o: bool = ft_starts("--out-dir", name)
    if h and o {
        return "?"
    }
    if h {
        return "--help"
    }
    if o {
        return "--out-dir"
    }
    return ""
}

function main(argc: i32, argv: ptr<string>) -> i32 {
    let mut abi_arg: string = null as string
    let mut out_arg: string = null as string
    let extras: ptr<StrList> = ft_list_new()
    let mut only_pos: bool = false
    let mut i: i32 = 1
    while i < argc {
        let arg: string = argv[i]
        if only_pos == false and ft_eq(arg, "--") {
            only_pos = true
        } elif only_pos == false and ft_eq(arg, "-h") {
            ft_out(help_text())
            return 0
        } elif only_pos == false and ft_starts(arg, "--") {
            let eq: i32 = ft_find(arg, "=", 0)
            let mut name: string = arg
            let mut value: string = null as string
            if eq >= 0 {
                name = ft_slice(arg, 0, eq)
                value = ft_from(arg, eq + 1)
            }
            let full: string = long_opt(name)
            if ft_eq(full, "?") {
                return usage_error("ambiguous option: " + name + " could match --help, --out-dir")
            }
            if ft_eq(full, "--help") {
                if value as ptr<u8> != null {
                    return usage_error("argument -h/--help: ignored explicit argument '" + value + "'")
                }
                ft_out(help_text())
                return 0
            }
            if ft_eq(full, "--out-dir") {
                if value as ptr<u8> == null {
                    if i + 1 >= argc or (ft_starts(argv[i + 1], "-") and ft_len(argv[i + 1]) > 1) {
                        return usage_error("argument --out-dir: expected one argument")
                    }
                    value = argv[i + 1]
                    i = i + 1
                }
                out_arg = value
            } else {
                ft_list_push(extras, arg)
            }
        } elif only_pos == false and ft_starts(arg, "-") and ft_len(arg) > 1 {
            ft_list_push(extras, arg)
        } elif abi_arg as ptr<u8> == null {
            abi_arg = arg
        } else {
            ft_list_push(extras, arg)
        }
        i = i + 1
    }
    if abi_arg as ptr<u8> == null {
        return usage_error("the following arguments are required: abi_file")
    }
    if ft_list_len(extras) > 0 {
        let mut msg: string = "unrecognized arguments:"
        let mut k: i32 = 0
        while k < ft_list_len(extras) {
            msg = msg + " " + ft_list_get(extras, k)
            k = k + 1
        }
        return usage_error(msg)
    }

    let abi_path: string = path_str(abi_arg)
    if ft_exists(abi_path) == false {
        ft_errln("ABI file not found: " + abi_path)
        return 1
    }
    let mut out_dir: string = path_parent(abi_path)
    if out_arg as ptr<u8> != null and ft_len(out_arg) > 0 {
        out_dir = path_str(out_arg)
    }
    if pr_is_dir(out_dir) == false {
        if pr_mkdir_p(out_dir) == false {
            ft_errln("FileExistsError: [Errno 17] File exists: '" + out_dir + "'")
            return 1
        }
    }

    let text: string = ft_read_file(abi_path)
    if text as ptr<u8> == null or pr_is_dir(abi_path) {
        ft_errln("IsADirectoryError: [Errno 21] Is a directory: '" + abi_path + "'")
        return 1
    }
    let lines: ptr<StrList> = md_splitlines(text)
    let sigs: ptr<ptr<Sig>> = malloc((ft_list_len(lines) as i64) * 8 + 8) as ptr<ptr<Sig>>
    let mut count: i32 = 0
    let mut li: i32 = 0
    while li < ft_list_len(lines) {
        let raw: string = ft_list_get(lines, li)
        let line: string = uc_strip(raw)
        if ft_len(line) > 0 and ft_starts(line, "#") == false {
            let sg: ptr<Sig> = parse_signature(line)
            if sg == null {
                ft_errln("Invalid ABI line: " + raw)
                return 1
            }
            if sg[0].error as ptr<u8> != null {
                ft_errln("ValueError: " + sg[0].error)
                return 1
            }
            sigs[count] = sg
            count = count + 1
        }
        li = li + 1
    }

    let base: string = ft_from(abi_path, ft_rfind_byte(abi_path, 47) + 1)
    let header_name: string = with_suffix(base, ".h")
    let flow_name: string = with_suffix(base, ".flow")
    if ft_write_file(out_dir + "/" + header_name, c_header(sigs, count, header_name)) == false {
        ft_errln("gen_abi_bindings: cannot write " + out_dir + "/" + header_name)
        return 1
    }
    if ft_write_file(out_dir + "/" + flow_name, flow_bindings(sigs, count)) == false {
        ft_errln("gen_abi_bindings: cannot write " + out_dir + "/" + flow_name)
        return 1
    }
    return 0
}
