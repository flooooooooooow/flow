# Minimal Flow to C to WASM hello (issue #121).
# Uses emcc when present; exits 0 with a skip message otherwise (CI-safe).
#
# Usage (from the repository root):
#   ./flow tool scripts/build_wasm_hello.flow
#   python3 -m http.server 8765 --directory build/wasm_hello
#
# FLOW_WASM_FROM_FLOW=1 compiles examples/basics/hello_world.flow through
# flowc instead of the checked-in harness (wasm/hello_harness.c).

import "tools/flow_cli/sys.flow"
import std.process { proc_argv, ProcCmd, ProcStrs, proc_chdir }

# The page that loads hello.js.
function html() -> string {
    let mut h: string = ""
    h = h + "<!DOCTYPE html>\n"
    h = h + "<html lang=\"en\">\n"
    h = h + "<head>\n"
    h = h + "  <meta charset=\"UTF-8\" />\n"
    h = h + "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n"
    h = h + "  <title>Flow WASM hello</title>\n"
    h = h + "  <style>\n"
    h = h + "    body { font-family: ui-monospace, monospace; max-width: 40rem; margin: 2rem auto; padding: 0 1rem; }\n"
    h = h + "    #out { background: #111; color: #9f9; padding: 1rem; min-height: 4rem; white-space: pre-wrap; }\n"
    h = h + "  </style>\n"
    h = h + "</head>\n"
    h = h + "<body>\n"
    h = h + "  <h1>Flow → C → WASM</h1>\n"
    h = h + "  <p>Smoke artifact from <code>./flow tool scripts/build_wasm_hello.flow</code>.</p>\n"
    h = h + "  <pre id=\"out\">Loading…</pre>\n"
    h = h + "  <script>\n"
    h = h + "    var Module = {\n"
    h = h + "      print: function (t) {\n"
    h = h + "        var el = document.getElementById('out');\n"
    h = h + "        el.textContent = (el.textContent === 'Loading…' ? '' : el.textContent) + t + '\\n';\n"
    h = h + "      },\n"
    h = h + "      printErr: function (t) {\n"
    h = h + "        document.getElementById('out').textContent += 'ERR: ' + t + '\\n';\n"
    h = h + "      },\n"
    h = h + "      onRuntimeInitialized: function () {\n"
    h = h + "        var el = document.getElementById('out');\n"
    h = h + "        if (el.textContent === 'Loading…') el.textContent = '';\n"
    h = h + "        el.textContent += '(runtime ready; main already ran if auto-run)\\n';\n"
    h = h + "      }\n"
    h = h + "    };\n"
    h = h + "  </script>\n"
    h = h + "  <script src=\"hello.js\"></script>\n"
    h = h + "</body>\n"
    h = h + "</html>\n"
    return h
}

function main() -> i32 {
    tool_only("scripts/build_wasm_hello.flow")
    let root: string = abs_dir(env_or("FLOW_REPO_ROOT", cwd_logical()))
    env_unset("FLOW_REPO_ROOT")
    if not proc_chdir(root) {
        cli_exit(1)
    }
    env_set("PWD", root)

    let out_dir: string = "build/wasm_hello"
    let harness: string = "wasm/hello_harness.c"
    let mut src: string = harness

    if not have("emcc") {
        outln("skip: emcc not found: install Emscripten (emsdk) to build WASM locally")
        outln("  docs: docs/language/wasm.md")
        outln("  hint: source ./emsdk_env.sh from an emsdk install (needs Python ≥ 3.10)")
        return 0
    }

    # A broken Homebrew emscripten (wrong Python) still provides an `emcc`
    # shim: probe it and skip cleanly so CI and local runs do not fail hard.
    let probe: ptr<ProcCmd> = cmd(sl_of2("emcc", "-v"))
    cmd_quiet(probe)
    if run(probe) != 0 {
        outln("skip: emcc present but broken (often brew emscripten + old Python).")
        outln("  Prefer emsdk: https://emscripten.org/docs/getting_started/downloads.html")
        outln("  docs: docs/language/wasm.md")
        return 0
    }

    mkdir_p_or_exit(out_dir)

    # Default: the checked-in harness (prints). Optional: real Flow to C
    # with FLOW_WASM_FROM_FLOW=1.
    if s_eq(env_or("FLOW_WASM_FROM_FLOW", "0"), "1") and is_exec("./flow") and is_file("examples/basics/hello_world.flow") {
        let fc: ptr<ProcCmd> = cmd(sl_of3("./flow", "compile", "examples/basics/hello_world.flow"))
        cmd_quiet(fc)
        if run(fc) == 0 and is_file("build/hello_world.c") {
            src = "build/hello_world.c"
            outln("using Flow-transpiled C: " + src)
        } else {
            errln("warn: Flow transpile failed; falling back to harness")
        }
    }

    if s_eq(src, harness) {
        if not is_file(harness) {
            errln("error: missing harness " + harness)
            return 1
        }
        outln("using checked-in harness: " + harness)
    }

    outln("emcc → " + out_dir + "/hello.{js,wasm}")
    let em: ptr<ProcStrs> = sl_of3("emcc", src, "-o")
    sl_push2(em, out_dir + "/hello.js", "-O1")
    sl_push2(em, "-s", "WASM=1")
    sl_push2(em, "-s", "EXPORTED_FUNCTIONS=['_main']")
    sl_push2(em, "-s", "EXPORTED_RUNTIME_METHODS=['ccall','cwrap']")
    sl_push2(em, "-s", "MODULARIZE=0")
    check(run_argv(em))

    if not write_text(out_dir + "/hello.html", html()) {
        errln("cannot write " + out_dir + "/hello.html")
        return 1
    }

    outln("ok: wrote " + out_dir + "/hello.js " + out_dir + "/hello.wasm " + out_dir + "/hello.html")
    outln("serve: python3 -m http.server 8765 --directory " + out_dir)
    outln("open:  http://localhost:8765/hello.html")
    return 0
}

# These programs change files, run builds and publish, so they run only
# as `./flow tool PATH.flow` (from build/flow-tools), never from a plain
# `flow run` such as the corpus checks do.
function tool_only(path: string) {
    if not s_contains(proc_argv(0), "/flow-tools/") {
        errln("run this with ./flow tool " + path)
        cli_exit(2)
    }
}
