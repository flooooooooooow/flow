# Benchmarks for docs/library/tiny-pointers.md, section Benchmarks.
#
# The tiny-pointers demo is parameterized by n: every table geometry, load
# and op count is a constant proportional to n. This program re-derives the
# constants at a few sizes (n = 2^14 .. 2^16), compiles each variant to a
# native binary with flowc (-O2), runs it (best of 3, exit 0 = PASS),
# and prints the per-phase wall-clock times the binary reports itself.
#
#   ./flow tool scripts/bench_tiny_pointers.flow

@cEmbed("#include <stdio.h>
#include <stdlib.h>
static const char *tp_fmt2(double v) {
  char *b = (char *)malloc(64);
  snprintf(b, 64, \"%.2f\", v);
  return b;
}
static double tp_atof(const char *s) { return strtod(s, 0); }
")

import "tools/flow_cli/sys.flow"
import "scripts/check_lib.flow"
import std.process { proc_argv, ProcCmd, ProcStrs, proc_chdir }

extern {
    function tp_fmt2(v: f64) -> string
    function tp_atof(s: string) -> f64
}

function log2i(n: i32) -> i32 {
    let mut v: i32 = n
    let mut lg: i32 = 0
    while v > 1 {
        v = v / 2
        lg = lg + 1
    }
    return lg
}

# One n-proportional constant: the declaration as it stands in the demo and
# its value at size n (BASE * n / 65536).
function sub(src: string, decl: string, value: i32) -> string {
    let key: string = decl
    if not s_contains(src, key) {
        errln("AssertionError: missing const line: " + key)
        cli_exit(1)
    }
    let eq: i32 = s_find(key, "= ", 0)
    return s_replace(src, key, s_slice(key, 0, eq) + "= " + s_itoa(value))
}

function scaled(base: i32, n: i32) -> i32 {
    return ((base as i64 * n as i64) / 65536) as i32
}

# Re-derive the n-proportional constants of the demo at a given size.
function scale_src(src0: string, n: i32) -> string {
    let mut s: string = src0
    s = sub(s, "const N_SLOTS: i32 = 65536", n)
    s = sub(s, "const LOG_N: i32 = 16", log2i(n))
    let names: ptr<ProcStrs> = s_words("MAX_LIVE:49152 P_SLOTS:57344 P_BUCKETS:1792 S_SLOTS:8192 S_BUCKETS:1024 REG_SIZE:131072 V_MAX_LIVE:49152 R_MAX_LIVE:49152 RH_CAP:131072 CHURN_OPS:30000 R_CHURN_OPS:20000 RR_N:16384 RR_CHURN:8000 BST_N:16384 BST_STORM:20000 VD_MAX_KEYS:49152 KD_MAX_KEYS:49152 RV_LOAD:30000 RV_CHURN:20000 RV_DRAIN:26000 RV_RELOAD:25000 RL_KEYS:12288 RL_CHURN:4000 RL_ARENA_B:2048 RL3_KEYS:12288 RL3_CHURN:3000 RL3_ARENA_B:512 RL3_P2_B:512 RL3_POOL_WORDS:524288 ST_M:8192 ST_NB:4096")
    let mut i: i32 = 0
    while i < sl_len(names) {
        let pair: string = sl_get(names, i)
        let colon: i32 = s_find_byte(pair, 58, 0)
        let base: string = s_from(pair, colon + 1)
        s = sub(s, "const " + s_slice(pair, 0, colon) + ": i32 = " + base, scaled(s_atoi(base, 0), n))
        i = i + 1
    }
    s = sub(s, "const ST_B: i32 = 8", 8)
    s = sub(s, "const ST_EXT: i32 = 32768", scaled(32768, n))
    s = sub(s, "const ST_BINS: i32 = 2048", scaled(2048, n))
    s = sub(s, "const ST_Q_BITS: i32 = 11", log2i(scaled(2048, n)))
    s = sub(s, "const ST_CHURN: i32 = 6000", scaled(6000, n))
    s = sub(s, "const ST_QUERIES: i32 = 16384", scaled(16384, n))
    return s
}

function is_digit(c: i32) -> bool {
    return c >= 48 and c <= 57
}

# sed -nE 's/^  Phase ([0-9]+[a-z]*) .*: +([0-9.]+) ms$/\1 \2/p': the phase
# key (1..17, "8b" is 17) and its time, or key 0 when the line is no match.
function phase_key(line: string) -> i32 {
    if not s_starts(line, "  Phase ") or not s_ends(line, " ms") {
        return 0
    }
    let mut i: i32 = 8
    let n: i32 = s_len(line)
    while i < n and is_digit(s_byte(line, i)) {
        i = i + 1
    }
    if i == 8 {
        return 0
    }
    let digits: string = s_slice(line, 8, i)
    while i < n and s_byte(line, i) >= 97 and s_byte(line, i) <= 122 {
        i = i + 1
    }
    let id: string = s_slice(line, 8, i)
    if i >= n or s_byte(line, i) != 32 {
        return 0
    }
    let num: string = phase_time(line)
    if s_len(num) == 0 {
        return 0
    }
    # The ": " the time follows must come after the id and its space.
    let colon: i32 = s_len(line) - 3 - s_len(num)
    let mut j: i32 = colon
    while j > 0 and s_byte(line, j - 1) == 32 {
        j = j - 1
    }
    if j == colon or j - 1 < i + 1 or s_byte(line, j - 1) != 58 {
        return 0
    }
    if s_eq(id, "8b") {
        return 17
    }
    return s_atoi(digits, 0)
}

# The [0-9.]+ before the closing " ms".
function phase_time(line: string) -> string {
    let end: i32 = s_len(line) - 3
    let mut i: i32 = end
    while i > 0 and (is_digit(s_byte(line, i - 1)) or s_byte(line, i - 1) == 46) {
        i = i - 1
    }
    return s_slice(line, i, end)
}

function pad_right(s: string, n: i32) -> string {
    let mut out: string = s
    while s_len(out) < n {
        out = out + " "
    }
    return out
}

function pad_left(s: string, n: i32) -> string {
    let mut out: string = s
    while s_len(out) < n {
        out = " " + out
    }
    return out
}

# The best (lowest) time per phase over three runs, as "%.2f" strings.
function best_times(work: string, size: string) -> ptr<ProcStrs> {
    let best: ptr<f64> = malloc(18 * 8) as ptr<f64>
    let seen: ptr<i32> = malloc(18 * 4) as ptr<i32>
    let mut k: i32 = 0
    while k < 18 {
        best[k] = 0.0
        seen[k] = 0
        k = k + 1
    }
    let mut r: i32 = 1
    while r <= 3 {
        let lines: ptr<ProcStrs> = s_lines(read_text(work + "/out_" + size + "_" + s_itoa(r) + ".txt"))
        let mut i: i32 = 0
        while i < sl_len(lines) {
            let ln: string = sl_get(lines, i)
            let key: i32 = phase_key(ln)
            if key > 0 and key < 18 {
                let t: f64 = tp_atof(phase_time(ln))
                if seen[key] == 0 or t < best[key] {
                    best[key] = t
                    seen[key] = 1
                }
            }
            i = i + 1
        }
        r = r + 1
    }
    let out_l: ptr<ProcStrs> = sl_new()
    let mut text: string = ""
    let mut p: i32 = 1
    while p <= 17 {
        let v: string = tp_fmt2(best[p])
        sl_push(out_l, v)
        text = text + s_itoa(p) + " " + v + "\n"
        p = p + 1
    }
    let _w: bool = write_text(work + "/best_" + size + ".txt", text)
    return out_l
}

function print_coverage_map() {
    outln("")
    outln("Abstract-claim coverage  (arXiv:2111.12800 → phase · doc section)")
    outln("──────────────────────────────────────────────────────────────────")
    outln("  pointer results:")
    outln("    · fixed-size Θ(log log log n + log k) bits   → Theorem 1 (Phases 1-4)")
    outln("    · variable-size Θ(log k) expected bits       → Theorem 2 (Phases 5-6)")
    outln("  applications:")
    outln("    ① relaxed retrieval nv + O(n log⁽ʳ⁾ n), O(1)-expected hints, O(r) insert/delete")
    outln("        → Theorem 6 (Phases 7-8, 8b)  ·  §6.2")
    outln("    ② succinct rotation-based BSTs               → Theorem 7 (Phases 9-10)  ·  §6.3")
    outln("    ③ stable fixed-capacity dicts, 1 + o(1)      → Theorem 8 (Phases 3-4)  ·  §6.4")
    outln("    ④ arbitrary-size values, log⁽ʳ⁾ n + O(log j) → Theorem 9 (Phases 11/12/14/15)  ·  §6.5")
    outln("        (deep dive: docs/library/tiny-pointers-variable-values.md)")
    outln("    ⑤ optimal internal-memory stash O(n log ε⁻¹) → Theorem 10 (Phase 16)  ·  §6.6")
    outln("  (Theorems 3-5 are lower bounds / intermediate steps, not constructions.)")
    outln("  full theorem table: docs/library/tiny-pointers.md")
    outln("──────────────────────────────────────────────────────────────────")
    outln("")
}

function first_line(text: string) -> string {
    let nl: i32 = s_find_byte(text, 10, 0)
    if nl < 0 {
        return text
    }
    return s_slice(text, 0, nl)
}

function main() -> i32 {
    tool_only("scripts/bench_tiny_pointers.flow")
    let root: string = abs_dir(env_or("FLOW_REPO_ROOT", cwd_logical()))
    env_unset("FLOW_REPO_ROOT")
    let src_path: string = root + "/examples/systems/tiny_pointers.flow"
    let work: string = env_or("TMPDIR", "/tmp") + "/flow-tp-bench"
    mkdir_p_or_exit(work)
    let src: string = read_text(src_path)
    let sizes: ptr<ProcStrs> = s_words("16384 32768 65536")
    let phases: ptr<ProcStrs> = sl_new()
    sl_push2(phases, "1 bulk load", "2 dynamic churn")
    sl_push2(phases, "3 stability churn", "4 stable dict")
    sl_push2(phases, "5 natural load", "6 adversarial + tail")
    sl_push2(phases, "7 retrieval load", "8 churn + rebuild")
    sl_push2(phases, "9 AVL build", "10 rotation storm")
    sl_push2(phases, "11 variable-value dict", "12 variable-key+value")
    sl_push2(phases, "13 lower bounds", "14 deamortized resize")
    sl_push2(phases, "15 r-levels chain", "16 optimal stash")
    sl_push(phases, "8b r-tradeoff")

    # best[s] holds the 17 phase times of size s.
    let best: ptr<ptr<ProcStrs>> = malloc(3 * 8) as ptr<ptr<ProcStrs>>
    let mut si: i32 = 0
    while si < sl_len(sizes) {
        let size: string = sl_get(sizes, si)
        let variant: string = work + "/tiny_pointers_" + size + ".flow"
        let _v: bool = write_text(variant, scale_src(src, s_atoi(size, 0)))
        let cc: ptr<ProcCmd> = cmd(sl_of3(root + "/flow", "compile", variant))
        cmd_env(cc, "FLOW_CFLAGS", "-O2")
        cmd_quiet(cc)
        check(run(cc))
        let bin: string = root + "/build/tiny_pointers_" + size
        let mut r: i32 = 1
        while r <= 3 {
            let out_path: string = work + "/out_" + size + "_" + s_itoa(r) + ".txt"
            if run_to_file(cmd(sl_of1(bin)), out_path, true) != 0 {
                outln("size " + size + " run " + s_itoa(r) + ": binary failed")
                cli_exit(1)
            }
            if not s_contains(read_text(out_path), "PASS:") {
                outln("size " + size + " run " + s_itoa(r) + ": no PASS")
                cli_exit(1)
            }
            r = r + 1
        }
        best[si] = best_times(work, size)
        si = si + 1
    }

    outln("tiny-pointers wall-clock (CLOCK_MONOTONIC, native -O2 binary, best of 3 runs)")
    let sw: ptr<ProcCmd> = cmd(sl_of2("sw_vers", "-productVersion"))
    cmd_quiet_err(sw)
    let mut machine: string = ""
    if have("sw_vers") {
        machine = capture(sw)
    }
    outln("  machine: " + uname_s() + " " + uname_m() + " " + machine)
    outln("  compiler: " + first_line(capture(cmd(sl_of2("clang", "--version")))))
    let mut hdr: string = pad_right("phase", 22)
    si = 0
    while si < sl_len(sizes) {
        hdr = hdr + " " + pad_left("n=2^" + s_itoa(log2i(s_atoi(sl_get(sizes, si), 0))), 9)
        si = si + 1
    }
    outln(hdr)
    let mut p: i32 = 0
    while p < 17 {
        let mut row: string = pad_right(sl_get(phases, p), 22)
        si = 0
        while si < sl_len(sizes) {
            row = row + " " + pad_left(sl_get(best[si], p), 9)
            si = si + 1
        }
        outln(row)
        p = p + 1
    }
    let mut total: string = pad_right("total", 22)
    si = 0
    while si < sl_len(sizes) {
        let mut sum: f64 = 0.0
        let mut q: i32 = 0
        while q < 17 {
            sum = sum + tp_atof(sl_get(best[si], q))
            q = q + 1
        }
        total = total + " " + pad_left(tp_fmt2(sum), 9)
        si = si + 1
    }
    outln(total)

    # The paper's abstract promises two pointer results and five
    # applications; this map links each to the bench row(s) that measure it
    # and to its doc section: the same table as the 'Abstract-claim
    # coverage' sections of docs/library/tiny-pointers.md and
    # tiny-pointers-variable-values.md, and as the map the demo prints at the
    # top of its own run output.
    print_coverage_map()
    return 0
}

# These programs change files, run builds and publish, so they run only
# as `./flow tool PATH.flow` (from build/flow-tools), never from a plain
# `flow run` such as the corpus checks do.
function tool_only(path: string) {
    if not s_contains(proc_argv(0), "/flow-tools/") {
        errln("run this with ./flow tool " + path)
        cli_exit(2)
    }
}
