# Compile Flow GPU kernels through SPIR-V to MSL or a native Metal library.
#
#   ./flow tool scripts/compile_spirv_metal.flow IN.flow|IN.spv [-o OUT]
#       [--msl-only] [--sdk SDK] [--spirv-cross-arg ARG ...]
#
# A Flow source goes through `flow mlir --mlir-gpu --emit-spirv`; an .spv is
# used as is. SPIRV-Cross lowers the SPIR-V to Metal Shading Language
# (--msl-only stops there), then xcrun metal and metallib build the library.
# OUT defaults to build/<stem>.metallib, or build/<stem>.metal with
# --msl-only. The steps are `flow mlir-spirv` (tools/flow_cli/mlir_tools.flow).

import "tools/flow_cli/sys.flow"
import std.process { proc_argv, ProcCmd, ProcResult, ProcStrs, proc_args, proc_stderr, PROC_CAPTURE }

let USAGE: string = "usage: ./flow tool scripts/compile_spirv_metal.flow IN.flow|IN.spv [-o OUT] [--msl-only] [--sdk SDK] [--spirv-cross-arg ARG]"

function usage() {
    errln(USAGE)
    cli_exit(2)
}

function fail(msg: string) {
    errln("Metal compilation failed: " + msg)
    cli_exit(1)
}

# One step of `flow mlir-spirv`, its stderr kept for the
# failure message (stdout passes through).
function spirv_step(root: string, args: ptr<ProcStrs>) {
    let argv: ptr<ProcStrs> = sl_of2(root + "/flow", "mlir-spirv")
    sl_extend(argv, args)
    let c: ptr<ProcCmd> = cmd(argv)
    proc_stderr(c, PROC_CAPTURE)
    let r: ptr<ProcResult> = run_result(c)
    if r.exit_code != 0 {
        fail(s_chomp_all(r.stderr))
    }
}

function main() -> i32 {
    tool_only("scripts/compile_spirv_metal.flow")
    let root: string = abs_dir_physical(env_or("FLOW_REPO_ROOT", cwd_logical()))
    env_unset("FLOW_REPO_ROOT")
    let args: ptr<ProcStrs> = proc_args()
    let mut input: string = ""
    let mut output: string = ""
    let mut msl_only: bool = false
    let mut sdk: string = "macosx"
    let cross_args: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(args) {
        let a: string = sl_get(args, i)
        if s_eq(a, "-o") or s_eq(a, "--output") {
            output = sl_get(args, i + 1)
            i = i + 1
        } elif s_eq(a, "--msl-only") {
            msl_only = true
        } elif s_eq(a, "--sdk") {
            sdk = sl_get(args, i + 1)
            i = i + 1
        } elif s_eq(a, "--spirv-cross-arg") {
            sl_push(cross_args, sl_get(args, i + 1))
            i = i + 1
        } elif s_starts(a, "-") {
            usage()
        } else {
            if s_len(input) > 0 {
                usage()
            }
            input = a
        }
        i = i + 1
    }
    if s_len(input) == 0 {
        usage()
    }
    if not exists(input) {
        errln("compile_spirv_metal: error: input does not exist: " + input)
        cli_exit(2)
    }
    let base: string = path_basename(input)
    let mut stem: string = base
    let dot: i32 = s_rfind_byte(base, 46)
    if dot >= 0 {
        stem = s_slice(base, 0, dot)
    }
    if s_len(output) == 0 {
        if msl_only {
            output = root + "/build/" + stem + ".metal"
        } else {
            output = root + "/build/" + stem + ".metallib"
        }
    }
    mkdir_p_or_exit(path_dirname(output))

    let work: string = mktemp_dir(env_or("TMPDIR", "/tmp") + "/flow-spirv-metal.XXXXXX")
    if s_len(work) == 0 {
        cli_exit(1)
    }
    on_exit_remove(work)

    let mut spv: string = input
    if not s_ends(input, ".spv") and not s_ends(input, ".SPV") {
        spv = work + "/" + stem + ".spv"
        let fa: ptr<ProcStrs> = sl_of3(root + "/flow", "mlir", input)
        sl_push2(fa, "--mlir-gpu", "--emit-spirv")
        sl_push2(fa, "--spirv-out", spv)
        let fc: ptr<ProcCmd> = cmd(fa)
        cmd_env(fc, "FLOW_BUILD_ROOT", work)
        let log: string = work + "/flow.log"
        if run_to_file(fc, log, true) != 0 {
            fail("Flow -> SPIR-V compilation failed:\n" + s_chomp_all(read_text(log)))
        }
    }

    if msl_only {
        let m: ptr<ProcStrs> = sl_of3("msl", spv, output)
        sl_extend(m, cross_args)
        spirv_step(root, m)
    } else {
        let metal: string = work + "/" + stem + ".metal"
        let m2: ptr<ProcStrs> = sl_of3("msl", spv, metal)
        sl_extend(m2, cross_args)
        spirv_step(root, m2)
        let lib: ptr<ProcStrs> = sl_of3("metallib", metal, output)
        sl_push(lib, sdk)
        spirv_step(root, lib)
    }
    outln("Generated Metal artifact: " + output)
    cli_exit(0)
    return 0
}

# These programs change files, run builds and publish, so they run only
# as `./flow tool PATH.flow` (from build/flow-tools), never from a plain
# `flow run` such as the corpus checks do.
function tool_only(path: string) {
    if not s_contains(proc_argv(0), "/flow-tools/") {
        errln("run this with ./flow tool " + path)
        cli_exit(2)
    }
}
