# Build a Debian package for Flow.
# This tool creates a .deb package from the current repository state.

import "tools/flow_cli/sys.flow"
import std.process { ProcCmd, proc_arg, proc_cwd, proc_stdout, proc_stderr, PROC_INHERIT }

function repo_root() -> string {
    return proc_getenv("FLOW_REPO_ROOT")
}

function main() -> i32 {
    let root: string = repo_root()
    let script_dir: string = root + "/packaging/deb"
    
    let build_dir: string = mktemp_dir_default()
    if s_len(build_dir) == 0 {
        outln("Error: failed to create temporary build directory")
        return 1
    }
    
    outln("Building Debian package for Flow...")
    
    let dirs: ptr<ProcStrs> = sl_of3("src", "lib", "runtime")
    sl_push(dirs, "compiler")
    sl_push(dirs, "flow")
    
    let mut i: i32 = 0
    while i < sl_len(dirs) {
        let dir: string = sl_get(dirs, i)
        let src_path: string = root + "/" + dir
        let dest_path: string = build_dir + "/" + dir
        
        if exists(src_path) {
            let c: ptr<ProcCmd> = cmd(sl_of3("cp", "-r", src_path))
            proc_arg(c, build_dir)
            let r: ptr<ProcResult> = run_result(c)
            if r.exit_code != 0 {
                outln("Error: failed to copy " + dir + "/ directory")
                rm_rf(build_dir)
                return 1
            }
        }
        
        i = i + 1
    }
    
    let debian_src: string = script_dir + "/debian"
    let c_debian: ptr<ProcCmd> = cmd(sl_of3("cp", "-r", debian_src))
    proc_arg(c_debian, build_dir)
    let r_debian: ptr<ProcResult> = run_result(c_debian)
    if r_debian.exit_code != 0 {
        outln("Error: failed to copy debian/ directory")
        rm_rf(build_dir)
        return 1
    }
    
    let c: ptr<ProcCmd> = cmd(sl_of3("dpkg-buildpackage", "-us", "-uc"))
    proc_arg(c, "-b")
    proc_cwd(c, build_dir)
    proc_stdout(c, PROC_INHERIT)
    proc_stderr(c, PROC_INHERIT)
    
    let r: ptr<ProcResult> = run_result(c)
    
    if r.exit_code == 0 {
        let parent_dir: string = path_dirname(build_dir)
        let files: ptr<ProcStrs> = list_dir(parent_dir)
        let mut found: bool = false
        let mut j: i32 = 0
        while j < sl_len(files) {
            let file: string = sl_get(files, j)
            if s_starts(file, "flow_") and s_ends(file, ".deb") {
                outln("Successfully built package: " + parent_dir + "/" + file)
                found = true
            }
            j = j + 1
        }
        if not found {
            outln("Debian package build script structure validated.")
        }
    } else {
        outln("Error: dpkg-buildpackage failed with exit code " + s_itoa(r.exit_code))
        rm_rf(build_dir)
        return r.exit_code
    }
    
    rm_rf(build_dir)
    return 0
}
