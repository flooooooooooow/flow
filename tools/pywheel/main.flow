# @module tools.pywheel
# @means  `flow python`: generate a CPython extension package from a Flow
#         program. Port of src/flow/python_generator.py and the --python
#         path of src/flow/transpiler.py.
#
# The program and its imports are parsed with the flowc front end (through
# the language server's analysis and import resolution, which follow the
# rules of the Python module resolver). Export inference, the ABI checks,
# the @python(name=, doc=, exclude=) overrides, the diagnostics and the
# generated C wrappers match the Python generator. The Flow program's own C
# comes from flowc (compiler/scripts/flowc_emit.sh), as it did there.
#
# Usage (flow-driver runs this):
#   flow-pywheel PROGRAM MODULE VERSION MODE OUT_DIR WORK_DIR REPO_ROOT
#     MODULE   Python module name, "" for the program's file name
#     MODE     "source" writes OUT_DIR/MODULE_ext.c and prints its path;
#              "package" writes MODULE_ext.c, setup.py and pyproject.toml
#              into WORK_DIR/pkg for the wheel build the driver runs.
# Exit status 0 on success, 1 on any error (as the Python generator).

import "tools/hostlib/text.flow"
import "tools/lsp/text.flow"
import "tools/lsp/analyze.flow"
import "tools/lsp/imports.flow"
import "compiler/src/ast.flow"
import "compiler/src/token.flow"
import "compiler/src/lexer.flow"

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function system(cmd: string) -> i32
}

# ── Output ──────────────────────────────────────────────────────

function out(s: string) {
    let line: string = t_cat(s, "\n")
    t_write_fd(1, line as ptr<u8>, t_len(line))
}

function err(s: string) {
    let line: string = t_cat(s, "\n")
    t_write_fd(2, line as ptr<u8>, t_len(line))
}

# ── Declarations ────────────────────────────────────────────────

# A function as the Python generator saw it after module resolution,
# monomorphization and the @only filter. ptypes and ret are Python type
# names (the parser's mangled forms: ptr_i32, array_4_i32, Foo_i32).
struct Fn {
    name: string,
    pnames: TList,
    ptypes: TList,
    ret: string,
    attrs: TList,
    generic: bool,
    tparams: TList,
    mi: i32,
    node: i32
}

struct Field {
    name: string,
    typ: string
}

struct St {
    name: string,
    fnames: TList,
    ftypes: TList
}

struct Module {
    path: string,
    a: ptr<Analysis>,
    is_root: bool,
    loaded: bool
}

struct Prog {
    mods: PList,
    stack: TList,
    fns: PList,
    structs: PList,
    alias_names: TList,
    alias_types: TList,
    n_effects: i32,
    n_caps: i32,
    error: string,
    crash_struct: string,
    pr: Project
}

function fn_at(l: ptr<PList>, i: i32) -> ptr<Fn> {
    return pl_get(l, i) as ptr<Fn>
}

function st_at(l: ptr<PList>, i: i32) -> ptr<St> {
    return pl_get(l, i) as ptr<St>
}

function mod_at(l: ptr<PList>, i: i32) -> ptr<Module> {
    return pl_get(l, i) as ptr<Module>
}

# ── Python type names ───────────────────────────────────────────

# Substitution for a type parameter name, or "" when none.
function tmap_get(keys: ptr<TList>, vals: ptr<TList>, name: string) -> string {
    if keys == null {
        return ""
    }
    let i: i32 = tl_index(keys, name)
    if i < 0 {
        return ""
    }
    return tl_get(vals, i)
}

# The name the Python parser gives a type: ptr<T> is ptr_T, array<T, N> is
# array_N_T, span<T> and &[T] are span_const_T (span_mut_T for mut),
# Name<A, B> is Name_A_B, (A, B) -> R is fn_A_B__R.
function py_type(a: ptr<Analysis>, ty: i32, keys: ptr<TList>, vals: ptr<TList>) -> string {
    if ty == AST_NONE or ty < 0 {
        return "void"
    }
    let n: AstNode = a.arena.nodes[ty]
    let name: string = t_span(a.src, n.name_start, n.name_end)
    if n.ival == 0 - 1 or n.ival == 0 - 2 {
        # Function pointer: fn_<params>__<ret> (cfn_ for cfn).
        let mut tb: TBuf = tb_new()
        if n.ival == 0 - 2 {
            tb_puts(&tb, "cfn_")
        } else {
            tb_puts(&tb, "fn_")
        }
        let mut c: i32 = n.a
        let mut first: bool = true
        while c != AST_NONE {
            if not first {
                tb_puts(&tb, "_")
            }
            first = false
            tb_puts(&tb, py_type(a, c, keys, vals))
            c = a.arena.nodes[c].next
        }
        tb_puts(&tb, "__")
        tb_puts(&tb, py_type(a, n.b, keys, vals))
        return tb.data as string
    }
    if t_len(name) == 0 {
        # [T; N], [T], &[T], &mut [T]
        let inner: string = py_type(a, n.a, keys, vals)
        if n.c == AST_TYPE_FIXED_ARRAY {
            return t_cat(t_cat3("array_", t_int(n.ival), "_"), inner)
        }
        if n.c == AST_TYPE_SPAN_MUTABLE {
            return t_cat("span_mut_", inner)
        }
        return t_cat("span_const_", inner)
    }
    if n.a == AST_NONE {
        let sub: string = tmap_get(keys, vals, name)
        if t_len(sub) > 0 {
            return sub
        }
        return name
    }
    let inner: string = py_type(a, n.a, keys, vals)
    if t_eq(name, "ptr") {
        return t_cat("ptr_", inner)
    }
    if t_eq(name, "array") {
        if n.ival > 0 {
            return t_cat(t_cat3("array_", t_int(n.ival), "_"), inner)
        }
        return t_cat("array_", inner)
    }
    if t_eq(name, "span") {
        if n.c == AST_TYPE_SPAN_MUTABLE {
            return t_cat("span_mut_", inner)
        }
        return t_cat("span_const_", inner)
    }
    let mut tb: TBuf = tb_new()
    tb_puts(&tb, name)
    let mut c: i32 = n.a
    while c != AST_NONE {
        tb_puts(&tb, "_")
        tb_puts(&tb, py_type(a, c, keys, vals))
        c = a.arena.nodes[c].next
    }
    return tb.data as string
}

# A type argument in a monomorphized function name
# (MonomorphRequest._type_to_str): a plain name as is, anything else in the
# N-length encoding P__N<len>_<name>__S<size>__E<elem>__T<n>_<args>.
function mono_str(a: ptr<Analysis>, ty: i32) -> string {
    let n: AstNode = a.arena.nodes[ty]
    let name: string = t_span(a.src, n.name_start, n.name_end)
    if t_len(name) > 0 and n.a == AST_NONE and n.ival >= 0 {
        return name
    }
    let pyname: string = py_type(a, ty, null, null)
    let mut parts: TList = tl_new()
    let is_ptr: bool = t_eq(name, "ptr")
    if is_ptr {
        tl_push(&parts, "P")
    }
    tl_push(&parts, t_cat3("N", t_int(t_len(pyname)), t_cat("_", pyname)))
    let is_array: bool = t_eq(name, "array") or (t_len(name) == 0 and n.c == AST_TYPE_FIXED_ARRAY)
    if is_array and n.ival > 0 {
        tl_push(&parts, t_cat("S", t_int(n.ival)))
    }
    let has_elem: bool = is_ptr or is_array or t_eq(name, "span") or t_len(name) == 0
    if has_elem and n.a != AST_NONE {
        tl_push(&parts, t_cat("E", mono_str(a, n.a)))
    } elif t_len(name) > 0 and n.a != AST_NONE {
        let mut args: TList = tl_new()
        let mut c: i32 = n.a
        while c != AST_NONE {
            tl_push(&args, mono_str(a, c))
            c = a.arena.nodes[c].next
        }
        tl_push(&parts, t_cat3("T", t_int(args.len), t_cat("_", join(&args, "_"))))
    }
    return join(&parts, "__")
}

# ── Attributes ──────────────────────────────────────────────────

# Attributes written before each top-level `function`, keyed by the byte
# offset of the function's name. The flowc parser skips attributes, so they
# are read from the tokens: @name, or @name(arg, key=value, ...), stored as
# the Python parser stores them: "name" or "name(a,key=value)" with string
# quotes removed.
struct AttrMap {
    offsets: TList,
    lists: PList
}

function attrs_for(m: ptr<AttrMap>, name_start: i32) -> ptr<TList> {
    let i: i32 = tl_index(&m.offsets, t_int(name_start))
    if i < 0 {
        let empty: ptr<TList> = calloc(1, 16) as ptr<TList>
        empty[0] = tl_new()
        return empty
    }
    return pl_get(&m.lists, i) as ptr<TList>
}

function tok_text(src: ptr<u8>, t: Token) -> string {
    return t_span(src, t.start, t.end)
}

function unquote(s: string) -> string {
    let mut v: string = s
    while t_len(v) > 0 and t_at(v, 0) == 34 {
        v = t_from(v, 1)
    }
    while t_len(v) > 0 and t_at(v, t_len(v) - 1) == 34 {
        v = t_sub(v, 0, t_len(v) - 1)
    }
    while t_len(v) > 0 and t_at(v, 0) == 39 {
        v = t_from(v, 1)
    }
    while t_len(v) > 0 and t_at(v, t_len(v) - 1) == 39 {
        v = t_sub(v, 0, t_len(v) - 1)
    }
    return v
}

function scan_attrs(src: ptr<u8>, n: i32) -> AttrMap {
    let mut m: AttrMap = AttrMap { offsets: tl_new(), lists: pl_new() }
    let mut lex: Lexer = flowc_lexer_new(src, n)
    let mut pending: TList = tl_new()
    let mut depth: i32 = 0
    let mut t: Token = flowc_lexer_next(&lex)
    while t.kind != TOK_EOF {
        if t.kind == TOK_LBRACE {
            depth = depth + 1
            t = flowc_lexer_next(&lex)
        } elif t.kind == TOK_RBRACE {
            depth = depth - 1
            t = flowc_lexer_next(&lex)
        } elif depth == 0 and t.kind == TOK_AT {
            t = flowc_lexer_next(&lex)
            if t.kind != TOK_IDENT and t.kind != TOK_KEYWORD {
                continue
            }
            let aname: string = tok_text(src, t)
            t = flowc_lexer_next(&lex)
            if t.kind != TOK_LPAREN {
                tl_push(&pending, aname)
                continue
            }
            t = flowc_lexer_next(&lex)
            let mut args: TList = tl_new()
            let mut cur: string = ""
            let mut pd: i32 = 1
            while t.kind != TOK_EOF and pd > 0 {
                if t.kind == TOK_LPAREN {
                    pd = pd + 1
                    cur = t_cat(cur, "(")
                } elif t.kind == TOK_RPAREN {
                    pd = pd - 1
                    if pd > 0 {
                        cur = t_cat(cur, ")")
                    }
                } elif t.kind == TOK_COMMA and pd == 1 {
                    tl_push(&args, cur)
                    cur = ""
                } elif t.kind == TOK_EQ {
                    cur = t_cat(cur, "=")
                } elif t.kind == TOK_STRING {
                    cur = t_cat(cur, unquote(tok_text(src, t)))
                } else {
                    cur = t_cat(cur, tok_text(src, t))
                }
                t = flowc_lexer_next(&lex)
            }
            if t_len(cur) > 0 or args.len > 0 {
                tl_push(&args, cur)
            }
            if t_eq(aname, "cInclude") or t_eq(aname, "cImport") or t_eq(aname, "cEmbed") {
                if args.len == 1 {
                    continue
                }
            }
            tl_push(&pending, t_cat(aname, t_cat3("(", join(&args, ","), ")")))
        } elif depth == 0 and t.kind == TOK_KEYWORD and flowc_token_is_kw(t, KW_FUNCTION) == 1 {
            t = flowc_lexer_next(&lex)
            if t.kind == TOK_IDENT {
                let keep: ptr<TList> = calloc(1, 16) as ptr<TList>
                keep[0] = pending
                tl_push(&m.offsets, t_int(t.start))
                pl_push(&m.lists, keep as ptr<u8>)
            }
            pending = tl_new()
        } elif depth == 0 and t.kind == TOK_KEYWORD and not t_eq(tok_text(src, t), "export") and not t_eq(tok_text(src, t), "inline") {
            pending = tl_new()
            t = flowc_lexer_next(&lex)
        } else {
            t = flowc_lexer_next(&lex)
        }
    }
    return m
}

# transpiler._parse_decorator: "name(a, b)" -> name and its arguments.
function deco_name(attr: string) -> string {
    let p: i32 = t_find_char(attr, 40)
    if p >= 0 and t_ends_with(attr, ")") {
        return t_sub(attr, 0, p)
    }
    return attr
}

function deco_args(attr: string) -> TList {
    let mut out_l: TList = tl_new()
    let p: i32 = t_find_char(attr, 40)
    if p < 0 or not t_ends_with(attr, ")") {
        return out_l
    }
    let rest: string = t_sub(attr, p + 1, t_len(attr) - 1)
    let n: i32 = t_len(rest)
    let mut start: i32 = 0
    let mut i: i32 = 0
    while i <= n {
        if i == n or t_at(rest, i) == 44 {
            let piece: string = t_strip(t_sub(rest, start, i))
            if t_len(piece) > 0 {
                tl_push(&out_l, piece)
            }
            start = i + 1
        }
        i = i + 1
    }
    return out_l
}

# get_python_attrs: keys and values of every @python(...) argument.
struct PyAttrs {
    keys: TList,
    vals: TList
}

function py_attrs(attrs: ptr<TList>) -> PyAttrs {
    let mut r: PyAttrs = PyAttrs { keys: tl_new(), vals: tl_new() }
    let mut i: i32 = 0
    while i < attrs.len {
        let attr: string = tl_get(attrs, i)
        if t_eq(deco_name(attr), "python") {
            let args: TList = deco_args(attr)
            let mut k: i32 = 0
            while k < args.len {
                let arg: string = tl_get(&args, k)
                let eq: i32 = t_find_char(arg, 61)
                if eq >= 0 {
                    let key: string = t_strip(t_sub(arg, 0, eq))
                    let val: string = unquote(t_strip(t_from(arg, eq + 1)))
                    py_put(&r, key, val)
                } elif t_eq(t_strip(arg), "exclude") {
                    py_put(&r, "exclude", "true")
                }
                k = k + 1
            }
        }
        i = i + 1
    }
    return r
}

function py_put(r: ptr<PyAttrs>, key: string, val: string) {
    let i: i32 = tl_index(&r.keys, key)
    if i >= 0 {
        tl_set(&r.vals, i, val)
    } else {
        tl_push(&r.keys, key)
        tl_push(&r.vals, val)
    }
}

function py_get(r: ptr<PyAttrs>, key: string, fallback: string) -> string {
    let i: i32 = tl_index(&r.keys, key)
    if i < 0 {
        return fallback
    }
    return tl_get(&r.vals, i)
}

# transpiler._function_allowed for the MLIR path's active modes
# {compile, mlir}: a function guarded by @only/@guard or a mode attribute
# stays only when one of its modes is active.
function allowed(attrs: ptr<TList>) -> bool {
    let mut guarded: bool = false
    let mut ok: bool = false
    let mut i: i32 = 0
    while i < attrs.len {
        let attr: string = tl_get(attrs, i)
        let name: string = deco_name(attr)
        if t_eq(name, "only") or t_eq(name, "guard") {
            guarded = true
            let args: TList = deco_args(attr)
            let mut k: i32 = 0
            while k < args.len {
                let m: string = tl_get(&args, k)
                if t_eq(m, "compile") or t_eq(m, "mlir") {
                    ok = true
                }
                k = k + 1
            }
        } elif t_eq(name, "hot") or t_eq(name, "jit") or t_eq(name, "compile") or t_eq(name, "interp") or t_eq(name, "mlir") or t_eq(name, "c") {
            guarded = true
            if t_eq(name, "compile") or t_eq(name, "mlir") {
                ok = true
            }
        }
        i = i + 1
    }
    if not guarded {
        return true
    }
    return ok
}

# ── Module resolution ───────────────────────────────────────────

# Type parameter names of a generic function: the `<T, U: Trait>` between
# its name and its parameter list.
function type_params(a: ptr<Analysis>, fnid: i32) -> TList {
    let mut l: TList = tl_new()
    let src: ptr<u8> = a.src
    let mut i: i32 = a.arena.nodes[fnid].name_end
    while (src[i] as i32) == 32 {
        i = i + 1
    }
    if (src[i] as i32) != 60 {
        return l
    }
    i = i + 1
    let mut depth: i32 = 1
    let mut cur: TBuf = tb_new()
    let mut skipping: bool = false
    while depth > 0 and (src[i] as i32) != 0 {
        let c: i32 = src[i] as i32
        if c == 60 {
            depth = depth + 1
        } elif c == 62 {
            depth = depth - 1
        }
        if depth == 1 and c == 44 {
            tl_push(&l, t_strip(tb_str(&cur)))
            tb_clear(&cur)
            skipping = false
        } elif depth == 1 and c == 58 {
            skipping = true
        } elif depth >= 1 and not skipping {
            tb_putc(&cur, c)
        }
        i = i + 1
    }
    let last: string = t_strip(tb_str(&cur))
    if t_len(last) > 0 {
        tl_push(&l, last)
    }
    return l
}

function add_fn(pg: ptr<Prog>, mi: i32, a: ptr<Analysis>, id: i32, am: ptr<AttrMap>, is_root: bool) {
    let name: string = name_of(a, id)
    if t_eq(name, "main") and not is_root {
        return
    }
    let f: ptr<Fn> = calloc(1, 256) as ptr<Fn>
    f.name = name
    f.pnames = tl_new()
    f.ptypes = tl_new()
    f.attrs = attrs_for(am, a.arena.nodes[id].name_start)[0]
    f.generic = a.arena.nodes[id].ival > 0
    f.tparams = tl_new()
    if f.generic {
        f.tparams = type_params(a, id)
    }
    f.mi = mi
    f.node = id
    let mut p: i32 = a.arena.nodes[id].a
    while p != AST_NONE {
        tl_push(&f.pnames, name_of(a, p))
        tl_push(&f.ptypes, py_type(a, a.arena.nodes[p].a, null, null))
        p = a.arena.nodes[p].next
    }
    f.ret = py_type(a, a.arena.nodes[id].b, null, null)
    pl_push(&pg.fns, f as ptr<u8>)
}

function add_item(pg: ptr<Prog>, mi: i32, a: ptr<Analysis>, item: i32, am: ptr<AttrMap>, is_root: bool) {
    let k: i32 = a.arena.nodes[item].kind
    if k == AST_EXPORT {
        let inner: i32 = a.arena.nodes[item].a
        if a.arena.nodes[item].ival == 0 and inner != AST_NONE {
            add_item(pg, mi, a, inner, am, is_root)
        }
        return
    }
    if k == AST_FN {
        add_fn(pg, mi, a, item, am, is_root)
    } elif k == AST_EXTERN {
        let mut f: i32 = a.arena.nodes[item].a
        while f != AST_NONE {
            if a.arena.nodes[f].kind == AST_FN {
                add_fn(pg, mi, a, f, am, is_root)
            }
            f = a.arena.nodes[f].next
        }
    } elif k == AST_STRUCT {
        if a.arena.nodes[item].b != AST_NONE {
            # Generic struct: only its instantiations are declarations.
            return
        }
        let s: ptr<St> = calloc(1, 128) as ptr<St>
        s.name = name_of(a, item)
        s.fnames = tl_new()
        s.ftypes = tl_new()
        let mut fl: i32 = a.arena.nodes[item].a
        while fl != AST_NONE {
            if a.arena.nodes[fl].kind == AST_FIELD {
                tl_push(&s.fnames, name_of(a, fl))
                tl_push(&s.ftypes, py_type(a, a.arena.nodes[fl].a, null, null))
            }
            fl = a.arena.nodes[fl].next
        }
        pl_push(&pg.structs, s as ptr<u8>)
    } elif k == AST_TYPE_ALIAS {
        if a.arena.nodes[item].a != AST_NONE {
            tl_push(&pg.alias_names, name_of(a, item))
            tl_push(&pg.alias_types, py_type(a, a.arena.nodes[item].a, null, null))
        }
    } elif k == AST_EFFECT {
        pg.n_effects = pg.n_effects + 1
    } elif k == AST_CAPABILITY {
        pg.n_caps = pg.n_caps + 1
    }
}

# The records the Python parser synthesized for anonymous fork blocks
# (`src |> { a = f, b = g }`): private structs __ForkRecord_N, one per
# distinct field signature in the module, ahead of its declarations.
function add_fork_records(pg: ptr<Prog>, a: ptr<Analysis>) {
    let mut found: TList = tl_new()
    let mut n: i32 = 0
    while n < a.arena.len {
        let nd_: AstNode = a.arena.nodes[n]
        if nd_.kind == AST_PIPE_BLOCK and nd_.ival == PIPE_BLOCK_FORK and nd_.name_end <= nd_.name_start {
            tl_push(&found, t_int(n))
        }
        n = n + 1
    }
    sort_by_start(a, &found)
    let mut sigs: TList = tl_new()
    let mut q: i32 = 0
    while q < found.len {
        let id: i32 = atoi_s(tl_get(&found, q))
        let mut tb: TBuf = tb_new()
        let mut f: i32 = a.arena.nodes[id].b
        while f != AST_NONE {
            tb_puts(&tb, name_of(a, f))
            tb_putc(&tb, 61)
            let v: i32 = a.arena.nodes[f].a
            if v != AST_NONE {
                tb_puts(&tb, t_strip(t_span(a.src, a.arena.nodes[v].start, a.arena.nodes[v].end)))
            }
            tb_putc(&tb, 59)
            f = a.arena.nodes[f].next
        }
        let sig: string = tb_str(&tb)
        if tl_index(&sigs, sig) < 0 {
            let s: ptr<St> = calloc(1, 128) as ptr<St>
            s.name = t_cat("__ForkRecord_", t_int(sigs.len))
            s.fnames = tl_new()
            s.ftypes = tl_new()
            pl_push(&pg.structs, s as ptr<u8>)
            tl_push(&sigs, sig)
        }
        q = q + 1
    }
}

# ModuleResolver._resolve_recursive: imports first (depth first, each
# module once), then the module's own declarations.
function resolve_module(pg: ptr<Prog>, path: string, is_root: bool) -> bool {
    if tl_index(&pg.stack, path) >= 0 {
        return true
    }
    let mut i: i32 = 0
    while i < pg.mods.len {
        let mm: ptr<Module> = mod_at(&pg.mods, i)
        if t_eq(mm.path, path) {
            return true
        }
        i = i + 1
    }
    if not is_file(path) {
        pg.error = t_cat("Module file not found: ", path)
        return false
    }
    tl_push(&pg.stack, path)
    let a: ptr<Analysis> = analyze_text(t_read_file(path), false)
    if a.raw_failed or not a.parsed {
        pg.error = t_cat3(path, ":", t_cat3(t_int(a.err_line + 1), ":", t_cat3(t_int(a.err_col + 1), ": ", a.err_msg)))
        return false
    }
    let m: ptr<Module> = calloc(1, 64) as ptr<Module>
    m.path = path
    m.a = a
    m.is_root = is_root
    pl_push(&pg.mods, m as ptr<u8>)
    let mi: i32 = pg.mods.len - 1
    let base: string = dirname(path)
    let mut k: i32 = 0
    while k < a.imports.len {
        let id: i32 = atoi_s(tl_get(&a.imports, k))
        let dep: string = resolve_import(a, id, base, &pg.pr)
        if t_len(dep) == 0 {
            let mut raw: string = name_of(a, id)
            if t_starts_with(raw, "\"") {
                raw = t_sub(raw, 1, t_len(raw) - 1)
            }
            pg.error = t_cat3("Could not resolve import '", raw, "'")
            return false
        }
        if not resolve_module(pg, dep, false) {
            return false
        }
        k = k + 1
    }
    add_fork_records(pg, a)
    let am: AttrMap = scan_attrs(a.src, a.nsrc)
    let mut item: i32 = a.arena.nodes[a.root].a
    while item != AST_NONE {
        add_item(pg, mi, a, item, &am, is_root)
        item = a.arena.nodes[item].next
    }
    pg.stack.len = pg.stack.len - 1
    return true
}

# ── Monomorphization ────────────────────────────────────────────

# Explicit instantiations `name<T, ...>(...)` of generic functions inside
# the concrete functions become specialized functions ahead of every other
# declaration, in the order the Python monomorphizer generates them (its
# worklist pops the last request first). Generic definitions are dropped.
function monomorphize(pg: ptr<Prog>) {
    let mut gen: PList = pl_new()
    let mut concrete: TList = tl_new()
    let mut rest: PList = pl_new()
    let mut i: i32 = 0
    while i < pg.fns.len {
        let f: ptr<Fn> = fn_at(&pg.fns, i)
        if f.generic {
            pl_push(&gen, f as ptr<u8>)
        } else {
            tl_push(&concrete, f.name)
            pl_push(&rest, f as ptr<u8>)
        }
        i = i + 1
    }
    let mut req_names: TList = tl_new()
    let mut reqs: PList = pl_new()
    if gen.len > 0 {
        let mut r: i32 = 0
        while r < rest.len {
            let f: ptr<Fn> = fn_at(&rest, r)
            let fm: ptr<Module> = mod_at(&pg.mods, f.mi)
            let a: ptr<Analysis> = fm.a
            let fs: i32 = a.arena.nodes[f.node].start
            let fe: i32 = a.arena.nodes[f.node].end
            # Calls with type arguments, in source order.
            let mut found: TList = tl_new()
            let mut n: i32 = 0
            while n < a.arena.len {
                let nd_: AstNode = a.arena.nodes[n]
                if nd_.kind == AST_CALL and nd_.b != AST_NONE and nd_.start >= fs and nd_.start < fe {
                    tl_push(&found, t_int(n))
                }
                n = n + 1
            }
            sort_by_start(a, &found)
            let mut q: i32 = 0
            while q < found.len {
                let cid: i32 = atoi_s(tl_get(&found, q))
                let cname: string = name_of(a, cid)
                let g: ptr<Fn> = find_generic(&gen, cname)
                if g != null {
                    let mut keys: TList = tl_new()
                    let mut vals: TList = tl_new()
                    let mut enc: TList = tl_new()
                    let mut ta: i32 = a.arena.nodes[cid].b
                    let mut ti: i32 = 0
                    while ta != AST_NONE {
                        if ti < g.tparams.len {
                            tl_push(&keys, tl_get(&g.tparams, ti))
                            tl_push(&vals, py_type(a, ta, null, null))
                        }
                        tl_push(&enc, mono_str(a, ta))
                        ti = ti + 1
                        ta = a.arena.nodes[ta].next
                    }
                    let mangled: string = t_cat3(cname, "_", join(&enc, "_"))
                    if tl_index(&req_names, mangled) < 0 {
                        tl_push(&req_names, mangled)
                        pl_push(&reqs, specialize(pg, g, mangled, &keys, &vals) as ptr<u8>)
                    }
                }
                q = q + 1
            }
            r = r + 1
        }
    }
    let mut result: PList = pl_new()
    let mut k: i32 = reqs.len - 1
    while k >= 0 {
        let s: ptr<Fn> = fn_at(&reqs, k)
        if tl_index(&concrete, s.name) < 0 {
            pl_push(&result, s as ptr<u8>)
        }
        k = k - 1
    }
    let mut j: i32 = 0
    while j < rest.len {
        pl_push(&result, pl_get(&rest, j))
        j = j + 1
    }
    pg.fns = result
}

function sort_by_start(a: ptr<Analysis>, l: ptr<TList>) {
    let mut i: i32 = 1
    while i < l.len {
        let cur: string = tl_get(l, i)
        let cs: i32 = a.arena.nodes[atoi_s(cur)].start
        let mut j: i32 = i - 1
        while j >= 0 and a.arena.nodes[atoi_s(tl_get(l, j))].start > cs {
            tl_set(l, j + 1, tl_get(l, j))
            j = j - 1
        }
        tl_set(l, j + 1, cur)
        i = i + 1
    }
}

function find_generic(gen: ptr<PList>, name: string) -> ptr<Fn> {
    let mut i: i32 = 0
    while i < gen.len {
        let g: ptr<Fn> = fn_at(gen, i)
        if t_eq(g.name, name) {
            return g
        }
        i = i + 1
    }
    return null
}

function specialize(pg: ptr<Prog>, g: ptr<Fn>, mangled: string, keys: ptr<TList>, vals: ptr<TList>) -> ptr<Fn> {
    let gm: ptr<Module> = mod_at(&pg.mods, g.mi)
    let a: ptr<Analysis> = gm.a
    let f: ptr<Fn> = calloc(1, 256) as ptr<Fn>
    f.name = mangled
    f.pnames = tl_new()
    f.ptypes = tl_new()
    f.attrs = tl_new()
    let mut i: i32 = 0
    while i < g.attrs.len {
        tl_push(&f.attrs, tl_get(&g.attrs, i))
        i = i + 1
    }
    if tl_index(&f.attrs, "monomorphized") < 0 {
        tl_push(&f.attrs, "monomorphized")
    }
    f.generic = false
    f.tparams = tl_new()
    f.mi = g.mi
    f.node = g.node
    let mut p: i32 = a.arena.nodes[g.node].a
    while p != AST_NONE {
        tl_push(&f.pnames, name_of(a, p))
        tl_push(&f.ptypes, py_type(a, a.arena.nodes[p].a, keys, vals))
        p = a.arena.nodes[p].next
    }
    f.ret = py_type(a, a.arena.nodes[g.node].b, keys, vals)
    return f
}

# ── ABI compatibility ───────────────────────────────────────────

function abi_known(t: string) -> bool {
    return t_eq(t, "i32") or t_eq(t, "i64") or t_eq(t, "u32") or t_eq(t, "u64") or t_eq(t, "f32") or t_eq(t, "f64") or t_eq(t, "bool") or t_eq(t, "string") or t_eq(t, "void")
}

function abi_ctype(t: string) -> string {
    if t_eq(t, "i32") { return "int32_t" }
    if t_eq(t, "i64") { return "int64_t" }
    if t_eq(t, "u32") { return "uint32_t" }
    if t_eq(t, "u64") { return "uint64_t" }
    if t_eq(t, "f32") { return "float" }
    if t_eq(t, "f64") { return "double" }
    if t_eq(t, "bool") { return "int" }
    if t_eq(t, "string") { return "const char*" }
    return "void"
}

function abi_format(t: string) -> string {
    if t_eq(t, "i32") { return "i" }
    if t_eq(t, "i64") { return "L" }
    if t_eq(t, "u32") { return "I" }
    if t_eq(t, "u64") { return "K" }
    if t_eq(t, "f32") { return "f" }
    if t_eq(t, "f64") { return "d" }
    if t_eq(t, "bool") { return "p" }
    if t_eq(t, "string") { return "s" }
    return ""
}

function abi_to_py(t: string, v: string) -> string {
    if t_eq(t, "i32") { return t_cat3("PyLong_FromLong(", v, ")") }
    if t_eq(t, "i64") { return t_cat3("PyLong_FromLongLong(", v, ")") }
    if t_eq(t, "u32") { return t_cat3("PyLong_FromUnsignedLong(", v, ")") }
    if t_eq(t, "u64") { return t_cat3("PyLong_FromUnsignedLongLong(", v, ")") }
    if t_eq(t, "f32") { return t_cat3("PyFloat_FromDouble((double)", v, ")") }
    if t_eq(t, "f64") { return t_cat3("PyFloat_FromDouble(", v, ")") }
    if t_eq(t, "bool") { return t_cat3("PyBool_FromLong(", v, ")") }
    if t_eq(t, "string") { return t_cat3("PyUnicode_FromString(", v, ")") }
    return "Py_None"
}

function find_struct(pg: ptr<Prog>, name: string) -> ptr<St> {
    let mut i: i32 = 0
    while i < pg.structs.len {
        let s: ptr<St> = st_at(&pg.structs, i)
        if t_eq(s.name, name) {
            return s
        }
        i = i + 1
    }
    return null
}

# _resolve_type_alias: follow `type X = Y` (and distinct types) to the base.
function resolve_alias(pg: ptr<Prog>, t: string) -> string {
    let mut cur: string = t
    let mut seen: TList = tl_new()
    while tl_index(&pg.alias_names, cur) >= 0 {
        if tl_index(&seen, cur) >= 0 {
            return cur
        }
        tl_push(&seen, cur)
        cur = tl_get(&pg.alias_types, tl_index(&pg.alias_names, cur))
    }
    return cur
}

# is_abi_compatible: "" when the type crosses the boundary, else the reason.
# The type names are the parser's mangled forms, so pointers and arrays
# (ptr_i32, array_4_i32) are unknown types, as on the Python generator.
function abi_reason(pg: ptr<Prog>, t: string) -> string {
    let base: string = resolve_alias(pg, t)
    if abi_known(base) {
        return ""
    }
    let s: ptr<St> = find_struct(pg, base)
    if s != null {
        if s.fnames.len > 0 {
            # The Python generator stopped here: it unpacked each field as a
            # (name, type) pair, and a struct field is not one.
            if t_len(pg.crash_struct) == 0 {
                pg.crash_struct = base
            }
            return ""
        }
        let mut i: i32 = 0
        while i < s.fnames.len {
            let r: string = abi_reason(pg, tl_get(&s.ftypes, i))
            if t_len(r) > 0 {
                return t_cat3("Struct field '", tl_get(&s.fnames, i), t_cat("' not compatible: ", r))
            }
            i = i + 1
        }
        return ""
    }
    return t_cat3("Unknown type '", base, "'")
}

# ── Export inference ────────────────────────────────────────────

struct Export {
    name: string,
    py_name: string,
    kind: string,
    doc: string,
    f: ptr<Fn>
}

struct Diag {
    symbol: string,
    kind: string,
    reason: string
}

function diag(l: ptr<PList>, symbol: string, kind: string, reason: string) {
    let d: ptr<Diag> = calloc(1, 32) as ptr<Diag>
    d.symbol = symbol
    d.kind = kind
    d.reason = reason
    pl_push(l, d as ptr<u8>)
}

function infer_exports(pg: ptr<Prog>, exports: ptr<PList>, diags: ptr<PList>) {
    let mut i: i32 = 0
    while i < pg.fns.len {
        let f: ptr<Fn> = fn_at(&pg.fns, i)
        i = i + 1
        let mut pa: PyAttrs = py_attrs(&f.attrs)
        if t_eq(py_get(&pa, "exclude", ""), "true") {
            diag(diags, f.name, "excluded", "Excluded by @python(exclude=true)")
            continue
        }
        if t_starts_with(f.name, "_") {
            diag(diags, f.name, "excluded", "Private symbol (starts with underscore)")
            continue
        }
        let rr: string = abi_reason(pg, f.ret)
        if t_len(pg.crash_struct) > 0 {
            return
        }
        if t_len(rr) > 0 {
            diag(diags, f.name, "excluded", t_cat("Return type not ABI-compatible: ", rr))
            continue
        }
        let mut params_ok: bool = true
        let mut k: i32 = 0
        while k < f.ptypes.len {
            let pr_: string = abi_reason(pg, tl_get(&f.ptypes, k))
            if t_len(pg.crash_struct) > 0 {
                return
            }
            if t_len(pr_) > 0 {
                diag(diags, f.name, "excluded", t_cat3("Parameter '", tl_get(&f.pnames, k), t_cat("' not ABI-compatible: ", pr_)))
                params_ok = false
                break
            }
            k = k + 1
        }
        if not params_ok {
            continue
        }
        if t_eq(f.name, "main") {
            diag(diags, f.name, "excluded", "Entry point 'main' not exported")
            continue
        }
        let e: ptr<Export> = calloc(1, 48) as ptr<Export>
        e.name = f.name
        e.py_name = py_get(&pa, "name", f.name)
        e.kind = "function"
        e.doc = py_get(&pa, "doc", "")
        e.f = f
        pl_push(exports, e as ptr<u8>)
        diag(diags, f.name, "exported", "Public function with ABI-compatible signature")
    }
    let mut s: i32 = 0
    while s < pg.structs.len {
        let st: ptr<St> = st_at(&pg.structs, s)
        s = s + 1
        if t_starts_with(st.name, "_") {
            diag(diags, st.name, "excluded", "Private struct")
            continue
        }
        let r: string = abi_reason(pg, st.name)
        if t_len(pg.crash_struct) > 0 {
            return
        }
        if t_len(r) == 0 {
            let e: ptr<Export> = calloc(1, 48) as ptr<Export>
            e.name = st.name
            e.py_name = st.name
            e.kind = "struct"
            e.doc = ""
            e.f = null
            pl_push(exports, e as ptr<u8>)
            diag(diags, st.name, "exported", "Public struct with ABI-compatible fields")
        } else {
            diag(diags, st.name, "excluded", t_cat("Struct not ABI-compatible: ", r))
        }
    }
}

function print_diagnostics(module_name: string, diags: ptr<PList>) {
    let bar: string = "============================================================"
    out(t_cat("\n", bar))
    out(t_cat("Python Export Analysis: ", module_name))
    out(t_cat(bar, "\n"))
    let mut exported: TList = tl_new()
    let mut excluded: TList = tl_new()
    let mut i: i32 = 0
    while i < diags.len {
        let d: ptr<Diag> = pl_get(diags, i) as ptr<Diag>
        let line: string = t_cat3("   ", d.symbol, t_cat(": ", d.reason))
        if t_eq(d.kind, "exported") {
            tl_push(&exported, line)
        } elif t_eq(d.kind, "excluded") {
            tl_push(&excluded, line)
        }
        i = i + 1
    }
    out(t_cat3("✅ Exported (", t_int(exported.len), " symbols):"))
    let mut k: i32 = 0
    while k < exported.len {
        out(tl_get(&exported, k))
        k = k + 1
    }
    out(t_cat3("\n⚠️  Excluded (", t_int(excluded.len), " symbols):"))
    k = 0
    while k < excluded.len {
        out(tl_get(&excluded, k))
        k = k + 1
    }
    out("")
}

# ── C generation ────────────────────────────────────────────────

function is_word_byte(c: i32) -> bool {
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
}

# re.search(r"\b" + name + r"\s*\(", c_code)
function c_calls(code: string, name: string) -> bool {
    let n: i32 = t_len(name)
    let total: i32 = t_len(code)
    let mut at: i32 = t_find_from(code, name, 0)
    while at >= 0 {
        let before_ok: bool = at == 0 or not is_word_byte(t_at(code, at - 1))
        if before_ok {
            let mut j: i32 = at + n
            while j < total and (t_at(code, j) == 32 or t_at(code, j) == 9 or t_at(code, j) == 10 or t_at(code, j) == 13 or t_at(code, j) == 12 or t_at(code, j) == 11) {
                j = j + 1
            }
            if j < total and t_at(code, j) == 40 {
                return true
            }
        }
        at = t_find_from(code, name, at + 1)
    }
    return false
}

function strip_chars(s: string, drop: i32, repl: string) -> string {
    let mut tb: TBuf = tb_new()
    let n: i32 = t_len(s)
    let mut i: i32 = 0
    while i < n {
        let c: i32 = t_at(s, i)
        if c == drop {
            tb_puts(&tb, repl)
        } else {
            tb_putc(&tb, c)
        }
        i = i + 1
    }
    return tb.data as string
}

# c_symbol_for: the C name flowc gave the function. An overloaded function
# carries its parameter types (twice_i32); the name defined in the C wins.
function c_symbol_for(f: ptr<Fn>, code: string) -> string {
    let mut mangled: string = f.name
    if f.ptypes.len > 0 {
        let mut parts: TList = tl_new()
        let mut i: i32 = 0
        while i < f.ptypes.len {
            let t0: string = tl_get(&f.ptypes, i)
            let t1: string = strip_chars(t0, 60, "_")
            let t2: string = strip_chars(t1, 62, "")
            tl_push(&parts, strip_chars(t2, 44, "_"))
            i = i + 1
        }
        mangled = t_cat3(f.name, "_", join(&parts, "_"))
    }
    if t_len(code) > 0 {
        if c_calls(code, mangled) {
            return mangled
        }
        if c_calls(code, f.name) {
            return f.name
        }
    }
    return f.name
}

function function_wrapper(e: ptr<Export>, code: string) -> string {
    let f: ptr<Fn> = e.f
    let mut fmt: TBuf = tb_new()
    let mut arg_names: TList = tl_new()
    let mut c_args: TList = tl_new()
    let mut parse_vars: TList = tl_new()
    let mut i: i32 = 0
    while i < f.ptypes.len {
        let t: string = tl_get(&f.ptypes, i)
        let pn: string = tl_get(&f.pnames, i)
        if abi_known(t) {
            tb_puts(&fmt, abi_format(t))
            tl_push(&arg_names, pn)
            tl_push(&parse_vars, t_cat3("    ", abi_ctype(t), t_cat3(" ", pn, ";")))
            tl_push(&c_args, t_cat("&", pn))
        } else {
            tb_puts(&fmt, "O")
            tl_push(&arg_names, pn)
            tl_push(&parse_vars, t_cat3("    PyObject* ", pn, "_obj;"))
            tl_push(&c_args, t_cat3("&", pn, "_obj"))
        }
        i = i + 1
    }
    let mut ret_conv: string = "    Py_RETURN_NONE;"
    let mut ret_decl: string = ""
    let mut call_prefix: string = "    "
    if not t_eq(f.ret, "void") and abi_known(f.ret) {
        ret_conv = t_cat3("    return ", abi_to_py(f.ret, "result"), ";")
        ret_decl = t_cat3("    ", abi_ctype(f.ret), " result = ")
        call_prefix = ""
    }
    let mangled: string = c_symbol_for(f, code)
    let mut tb: TBuf = tb_new()
    tb_puts(&tb, "\nstatic PyObject* py_")
    tb_puts(&tb, e.py_name)
    tb_puts(&tb, "(PyObject* self, PyObject* args) {\n")
    tb_puts(&tb, join(&parse_vars, "\n"))
    tb_puts(&tb, "\n    \n    if (!PyArg_ParseTuple(args, \"")
    tb_puts(&tb, tb_str(&fmt))
    tb_puts(&tb, "\", ")
    tb_puts(&tb, join(&c_args, ", "))
    tb_puts(&tb, ")) {\n        return NULL;\n    }\n    \n")
    tb_puts(&tb, ret_decl)
    tb_puts(&tb, call_prefix)
    tb_puts(&tb, mangled)
    tb_puts(&tb, "(")
    tb_puts(&tb, join(&arg_names, ", "))
    tb_puts(&tb, ");\n")
    tb_puts(&tb, ret_conv)
    tb_puts(&tb, "\n}\n")
    return tb.data as string
}

function extension_source(module_name: string, exports: ptr<PList>, code: string) -> string {
    let mut parts: TList = tl_new()
    tl_push(&parts, t_cat3("/* Auto-generated Python bindings for ", module_name, " */\n#define PY_SSIZE_T_CLEAN\n#include <Python.h>\n#include <stdint.h>\n\n/* Forward declarations for Flow functions */\n"))
    tl_push(&parts, "")
    tl_push(&parts, "/* ===== Flow compiled code ===== */")
    tl_push(&parts, code)
    tl_push(&parts, "")
    tl_push(&parts, "/* ===== Python wrappers ===== */")
    let mut i: i32 = 0
    while i < exports.len {
        let e: ptr<Export> = pl_get(exports, i) as ptr<Export>
        if t_eq(e.kind, "function") {
            tl_push(&parts, function_wrapper(e, code))
        }
        i = i + 1
    }
    i = 0
    while i < exports.len {
        let e: ptr<Export> = pl_get(exports, i) as ptr<Export>
        if t_eq(e.kind, "struct") {
            tl_push(&parts, t_cat3("\n/* Struct ", e.name, " is exposed as a dictionary */\n"))
        }
        i = i + 1
    }
    let mut methods: TList = tl_new()
    i = 0
    while i < exports.len {
        let e: ptr<Export> = pl_get(exports, i) as ptr<Export>
        if t_eq(e.kind, "function") {
            let mut doc: string = e.doc
            if t_len(doc) == 0 {
                doc = t_cat(e.name, " function")
            }
            tl_push(&methods, t_cat3("    {\"", e.py_name, t_cat3("\", py_", e.py_name, t_cat3(", METH_VARARGS, \"", doc, "\"},"))))
        }
        i = i + 1
    }
    tl_push(&parts, t_cat3("\nstatic PyMethodDef ", module_name, t_cat3("_methods[] = {\n", join(&methods, "\n"), "\n    {NULL, NULL, 0, NULL}\n};\n")))
    let mut mi: TBuf = tb_new()
    tb_puts(&mi, "\nstatic struct PyModuleDef ")
    tb_puts(&mi, module_name)
    tb_puts(&mi, "_module = {\n    PyModuleDef_HEAD_INIT,\n    \"")
    tb_puts(&mi, module_name)
    tb_puts(&mi, "\",\n    \"Flow-generated module: ")
    tb_puts(&mi, module_name)
    tb_puts(&mi, "\",\n    -1,\n    ")
    tb_puts(&mi, module_name)
    tb_puts(&mi, "_methods\n};\n\nPyMODINIT_FUNC PyInit_")
    tb_puts(&mi, module_name)
    tb_puts(&mi, "(void) {\n    return PyModule_Create(&")
    tb_puts(&mi, module_name)
    tb_puts(&mi, "_module);\n}\n")
    tl_push(&parts, tb_str(&mi))
    return join(&parts, "\n")
}

function setup_py(m: string, version: string) -> string {
    let mut tb: TBuf = tb_new()
    tb_puts(&tb, "#!/usr/bin/env python3\nfrom setuptools import setup, Extension\n\n")
    tb_puts(&tb, m)
    tb_puts(&tb, "_ext = Extension(\n    '")
    tb_puts(&tb, m)
    tb_puts(&tb, "',\n    sources=['")
    tb_puts(&tb, m)
    tb_puts(&tb, "_ext.c'],\n    extra_compile_args=['-O2', '-Wall'],\n)\n\nsetup(\n    name='")
    tb_puts(&tb, m)
    tb_puts(&tb, "',\n    version='")
    tb_puts(&tb, version)
    tb_puts(&tb, "',\n    description='Flow-generated Python extension',\n    ext_modules=[")
    tb_puts(&tb, m)
    tb_puts(&tb, "_ext],\n    python_requires='>=3.8',\n)\n")
    return tb.data as string
}

function pyproject_toml(m: string, version: string) -> string {
    let mut tb: TBuf = tb_new()
    tb_puts(&tb, "[build-system]\nrequires = [\"setuptools>=45\", \"wheel\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[project]\nname = \"")
    tb_puts(&tb, m)
    tb_puts(&tb, "\"\nversion = \"")
    tb_puts(&tb, version)
    tb_puts(&tb, "\"\ndescription = \"Flow-generated Python extension\"\nrequires-python = \">=3.8\"\n")
    return tb.data as string
}

# ── Entry ───────────────────────────────────────────────────────

# Path(p).stem with "-" and "." made "_".
function default_module_name(program: string) -> string {
    let mut stem: string = basename(program)
    let dot: i32 = last_dot(stem)
    if dot > 0 {
        stem = t_sub(stem, 0, dot)
    }
    return strip_chars(strip_chars(stem, 45, "_"), 46, "_")
}

function last_dot(s: string) -> i32 {
    let mut i: i32 = t_len(s) - 1
    while i >= 0 {
        if t_at(s, i) == 46 {
            return i
        }
        i = i - 1
    }
    return -1
}

function main(argc: i32, argv: ptr<string>) -> i32 {
    if argc != 8 {
        err("usage: flow-pywheel PROGRAM MODULE VERSION source|package OUT_DIR WORK_DIR REPO_ROOT")
        return 2
    }
    let program: string = argv[1]
    let mut module_name: string = argv[2]
    let version: string = argv[3]
    let mode: string = argv[4]
    let out_dir: string = argv[5]
    let work_dir: string = argv[6]
    let repo: string = argv[7]
    if not t_file_exists(program) {
        err(t_cat3("Error: File '", program, "' not found"))
        return 1
    }
    if t_len(module_name) == 0 {
        module_name = default_module_name(program)
    }

    err("Resolving modules...")
    let root_path: string = real(program)
    let pg: ptr<Prog> = calloc(1, 256) as ptr<Prog>
    pg.mods = pl_new()
    pg.stack = tl_new()
    pg.fns = pl_new()
    pg.structs = pl_new()
    pg.alias_names = tl_new()
    pg.alias_types = tl_new()
    pg.n_effects = 0
    pg.n_caps = 0
    pg.error = ""
    pg.crash_struct = ""
    pg.pr = load_project(root_path, repo)
    if not resolve_module(pg, root_path, true) {
        err(t_cat("Error resolving modules: ", pg.error))
        return 1
    }

    # The program's C, from flowc. Type errors stop here, as the Python
    # generator's strict type check did.
    let stem: string = default_module_name(program)
    let c_path: string = t_cat3(work_dir, "/", t_cat(stem, ".c"))
    let cmd: string = t_cat3(t_shq(t_cat(repo, "/compiler/scripts/flowc_emit.sh")), " --strict ", t_cat3(t_shq(root_path), " ", t_cat(t_shq(c_path), " >&2")))
    if system(cmd) != 0 or not t_file_exists(c_path) {
        err(t_cat("Python generation error: flowc could not compile ", program))
        return 1
    }

    monomorphize(pg)
    let mut kept: PList = pl_new()
    let mut i: i32 = 0
    while i < pg.fns.len {
        let f: ptr<Fn> = fn_at(&pg.fns, i)
        if allowed(&f.attrs) {
            pl_push(&kept, f as ptr<u8>)
        }
        i = i + 1
    }
    pg.fns = kept
    err(t_cat3("Parsed ", t_int(pg.fns.len), t_cat3(" functions, ", t_int(pg.structs.len), t_cat3(" structs, ", t_int(pg.n_effects), t_cat3(" effects, ", t_int(pg.n_caps), " capabilities")))))

    let mut exports: PList = pl_new()
    let mut diags: PList = pl_new()
    infer_exports(pg, &exports, &diags)
    if t_len(pg.crash_struct) > 0 {
        err(t_cat3("Python generation error: struct '", pg.crash_struct, "' cannot cross the Python boundary. flow python exports functions over i32, i64, u32, u64, f32, f64, bool and string."))
        return 1
    }
    print_diagnostics(module_name, &diags)

    let code: string = t_read_file(c_path)
    let ext: string = extension_source(module_name, &exports, code)
    let ext_name: string = t_cat(module_name, "_ext.c")
    if t_eq(mode, "package") {
        let pkg: string = t_cat(work_dir, "/pkg")
        system(t_cat("mkdir -p ", t_shq(pkg)))
        if not t_write_file(t_cat3(pkg, "/", ext_name), ext) {
            err(t_cat("Python generation error: cannot write ", pkg))
            return 1
        }
        t_write_file(t_cat(pkg, "/setup.py"), setup_py(module_name, version))
        t_write_file(t_cat(pkg, "/pyproject.toml"), pyproject_toml(module_name, version))
        return 0
    }
    system(t_cat("mkdir -p ", t_shq(out_dir)))
    let ext_path: string = t_cat3(out_dir, "/", ext_name)
    if not t_write_file(ext_path, ext) {
        err(t_cat("Python generation error: cannot write ", ext_path))
        return 1
    }
    out(t_cat("✅ Generated: ", ext_path))
    return 0
}
