# Python ratchet, written in Flow.
#
# Flow is moving off Python. New code is written in Flow. This program
# keeps the amount of Python in the repository from growing:
#
#   1. Every tracked .py file must already be listed in baseline.txt.
#   2. The total line count of tracked .py files must not exceed the
#      total recorded in baseline.txt.
#
# Deleting or shrinking Python always passes. `--update` tightens the
# baseline to the current tree. It drops files that no longer exist and
# lowers the line total. It never adds a file and never raises the total.
#
# scripts/python_ratchet.sh runs git and leaves the sorted file list in
# build/python-ratchet/current.txt, because Flow cannot spawn processes
# yet. Everything else happens here.
#
# Exit codes: 0 pass, 1 ratchet violated, 2 missing or unreadable input.

extern {
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function strlen(s: string) -> i64
    function strcmp(a: string, b: string) -> i32
    function fopen(path: string, mode: string) -> ptr<void>
    function fclose(fp: ptr<void>) -> i32
    function fread(buf: ptr<u8>, size: i64, count: i64, fp: ptr<void>) -> i32
    function fwrite(buf: ptr<u8>, size: i64, count: i64, fp: ptr<void>) -> i32
    function snprintf(buf: ptr<i8>, size: i64, fmt: string, value: i32) -> i32
}

const BASELINE: string = "tools/python_ratchet/baseline.txt"
const CURRENT: string = "build/python-ratchet/current.txt"
const MODE_FILE: string = "build/python-ratchet/mode.txt"
const READ_CAP: i32 = 4194304
const MAX_LINES: i32 = 65536

function i32_str(n: i32) -> string {
    let buf: ptr<i8> = malloc(48) as ptr<i8>
    let _n: i32 = snprintf(buf, 48, "%d", n)
    return buf as string
}

# Returns "" when the file is missing. The caller decides whether that is fatal.
function read_whole_file(path: string) -> string {
    let fp: ptr<void> = fopen(path, "rb")
    if fp == null {
        return ""
    }
    let buf: ptr<u8> = malloc(READ_CAP as i64) as ptr<u8>
    let n: i32 = fread(buf, 1, READ_CAP - 1, fp)
    let _c: i32 = fclose(fp)
    if n < 0 {
        buf[0] = 0
        return buf as string
    }
    buf[n] = 0
    return buf as string
}

function write_whole_file(path: string, text: string) -> i32 {
    let fp: ptr<void> = fopen(path, "wb")
    if fp == null {
        return 1
    }
    let n: i32 = strlen(text) as i32
    let wrote: i32 = fwrite(text as ptr<u8>, 1, n, fp)
    let _c: i32 = fclose(fp)
    if wrote != n {
        return 1
    }
    return 0
}

function count_file_lines(path: string) -> i32 {
    let fp: ptr<void> = fopen(path, "rb")
    if fp == null {
        return 0
    }
    let chunk: ptr<u8> = malloc(4096) as ptr<u8>
    let mut lines: i32 = 0
    let mut last: i32 = 10
    let mut n: i32 = fread(chunk, 1, 4096, fp)
    while n > 0 {
        let mut i: i32 = 0
        while i < n {
            let ch: i32 = chunk[i] as i32
            if ch == 10 {
                lines = lines + 1
            }
            last = ch
            i = i + 1
        }
        n = fread(chunk, 1, 4096, fp)
    }
    let _c: i32 = fclose(fp)
    free(chunk)
    if last != 10 {
        lines = lines + 1
    }
    return lines
}

# Splits `text` in place at newlines. Writes the start offset of each
# non-empty line into `starts` and returns how many there are.
function split_lines(text: string, starts: ptr<i32>) -> i32 {
    let p: ptr<u8> = text as ptr<u8>
    let n: i32 = strlen(text) as i32
    let mut count: i32 = 0
    let mut line_start: i32 = 0
    let mut i: i32 = 0
    while i <= n {
        let ch: i32 = p[i] as i32
        if ch == 10 or ch == 13 or ch == 0 {
            p[i] = 0
            if i > line_start and count < MAX_LINES {
                starts[count] = line_start
                count = count + 1
            }
            line_start = i + 1
        }
        i = i + 1
    }
    return count
}

# Copies the NUL-terminated line at `off` into its own string.
function line_at(text: string, off: i32) -> string {
    let p: ptr<u8> = text as ptr<u8>
    let mut len: i32 = 0
    while p[off + len] != 0 {
        len = len + 1
    }
    let out: ptr<u8> = malloc((len + 1) as i64) as ptr<u8>
    let mut i: i32 = 0
    while i < len {
        out[i] = p[off + i]
        i = i + 1
    }
    out[len] = 0
    return out as string
}

function starts_with(s: string, prefix: string) -> bool {
    let n: i64 = strlen(prefix)
    if strlen(s) < n {
        return false
    }
    let sp: ptr<u8> = s as ptr<u8>
    let pp: ptr<u8> = prefix as ptr<u8>
    let mut i: i64 = 0
    while i < n {
        if sp[i as i32] != pp[i as i32] {
            return false
        }
        i = i + 1
    }
    return true
}

function main() -> i32 {
    let mode_text: string = read_whole_file(MODE_FILE)
    let update: bool = starts_with(mode_text, "update")

    let base_text: string = read_whole_file(BASELINE)
    let cur_text: string = read_whole_file(CURRENT)
    if strlen(base_text) == 0 {
        println("python-ratchet: cannot read " + BASELINE)
        return 2
    }

    let base_starts: ptr<i32> = malloc((MAX_LINES * 4) as i64) as ptr<i32>
    let cur_starts: ptr<i32> = malloc((MAX_LINES * 4) as i64) as ptr<i32>
    let base_n: i32 = split_lines(base_text, base_starts)
    let cur_n: i32 = split_lines(cur_text, cur_starts)

    # First baseline line is "total <lines>". The rest is the sorted file list.
    let header: string = line_at(base_text, base_starts[0])
    if starts_with(header, "total ") == false {
        println("python-ratchet: first line of " + BASELINE + " must be 'total <lines>'")
        return 2
    }
    let hp: ptr<u8> = header as ptr<u8>
    let mut allowed_total: i32 = 0
    let mut d: i32 = 6
    while hp[d] >= 48 and hp[d] <= 57 {
        allowed_total = allowed_total * 10 + (hp[d] as i32 - 48)
        d = d + 1
    }

    # Both lists are byte-sorted (LC_ALL=C), so one merge walk finds
    # new files and files that have gone.
    let mut new_files: i32 = 0
    let mut gone_files: i32 = 0
    let mut kept: string = ""
    let mut bi: i32 = 1
    let mut ci: i32 = 0
    while bi < base_n or ci < cur_n {
        let mut order: i32 = 0
        if bi >= base_n {
            order = 1
        } else {
            if ci >= cur_n {
                order = -1
            } else {
                let bs: string = line_at(base_text, base_starts[bi])
                let cs: string = line_at(cur_text, cur_starts[ci])
                order = strcmp(bs, cs)
            }
        }
        if order == 0 {
            kept = kept + line_at(cur_text, cur_starts[ci]) + "\n"
            bi = bi + 1
            ci = ci + 1
        } else {
            if order < 0 {
                gone_files = gone_files + 1
                bi = bi + 1
            } else {
                println("  new Python file: " + line_at(cur_text, cur_starts[ci]))
                new_files = new_files + 1
                ci = ci + 1
            }
        }
    }

    let mut total: i32 = 0
    let mut k: i32 = 0
    while k < cur_n {
        total = total + count_file_lines(line_at(cur_text, cur_starts[k]))
        k = k + 1
    }

    let msg: string = "python-ratchet: " + i32_str(cur_n) + " Python files, " + i32_str(total) + " lines (limit " + i32_str(allowed_total) + ")"
    println(msg)

    if update {
        let mut new_total: i32 = allowed_total
        if total < new_total {
            new_total = total
        }
        let body: string = "total " + i32_str(new_total) + "\n" + kept
        if write_whole_file(BASELINE, body) != 0 {
            println("python-ratchet: cannot write " + BASELINE)
            return 2
        }
        let msg: string = "python-ratchet: baseline tightened, dropped " + i32_str(gone_files) + " files, limit now " + i32_str(new_total)
        println(msg)
        if new_files > 0 {
            println("python-ratchet: the new files above were not added. Write them in Flow.")
            return 1
        }
        return 0
    }

    let mut failed: bool = false
    if new_files > 0 {
        let msg: string = "python-ratchet: FAIL. " + i32_str(new_files) + " new Python file(s). New code is written in Flow."
        println(msg)
        failed = true
    }
    if total > allowed_total {
        let msg: string = "python-ratchet: FAIL. Python grew by " + i32_str(total - allowed_total) + " lines. Port the change to Flow or remove Python elsewhere."
        println(msg)
        failed = true
    }
    if gone_files > 0 or total < allowed_total {
        println("python-ratchet: Python shrank. Run scripts/python_ratchet.sh --update to lock it in.")
    }
    if failed {
        println("python-ratchet: see AGENTS.md, section 'Flow first'.")
        return 1
    }
    println("python-ratchet: PASS")
    return 0
}
