# @module tools.hostlib.text
# @means  Small string and I/O helpers shared by the native host tools
#         (flow repl, flow lsp): a growable byte buffer, span helpers,
#         whole-file and whole-stream reads, and shell capture.

extern {
    function malloc(size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function memcpy(dst: ptr<void>, src: ptr<void>, n: i64) -> ptr<void>
    function strlen(s: string) -> i64
    function strcmp(a: string, b: string) -> i32
    function snprintf(buf: ptr<u8>, n: i64, fmt: string, ...) -> i32
    function fopen(path: string, mode: string) -> ptr<void>
    function fclose(fp: ptr<void>) -> i32
    function fread(buf: ptr<u8>, size: i64, n: i64, fp: ptr<void>) -> i64
    function fwrite(buf: ptr<u8>, size: i64, n: i64, fp: ptr<void>) -> i64
    function popen(cmd: string, mode: string) -> ptr<void>
    function pclose(fp: ptr<void>) -> i32
    function read(fd: i32, buf: ptr<u8>, n: i64) -> i64
    function write(fd: i32, buf: string, n: i64) -> i64
    function getenv(name: string) -> string
}

# ── Growable buffer ─────────────────────────────────────────────

export struct TBuf {
    data: ptr<u8>,
    len: i32,
    cap: i32
}

export function tb_new() -> TBuf {
    let cap: i32 = 256
    let d: ptr<u8> = malloc(cap as i64) as ptr<u8>
    d[0] = 0
    return TBuf { data: d, len: 0, cap: cap }
}

export function tb_reserve(b: ptr<TBuf>, extra: i32) {
    let need: i32 = b.len + extra + 1
    if need <= b.cap {
        return
    }
    let mut nc: i32 = b.cap * 2
    while nc < need {
        nc = nc * 2
    }
    b.data = realloc(b.data as ptr<void>, nc as i64) as ptr<u8>
    b.cap = nc
}

export function tb_putc(b: ptr<TBuf>, c: i32) {
    tb_reserve(b, 1)
    let d: ptr<u8> = b.data
    d[b.len] = c as u8
    b.len = b.len + 1
    d[b.len] = 0
}

export function tb_put_span(b: ptr<TBuf>, src: ptr<u8>, start: i32, end: i32) {
    if end <= start {
        return
    }
    let n: i32 = end - start
    tb_reserve(b, n)
    let d: ptr<u8> = b.data
    memcpy((d + b.len) as ptr<void>, (src + start) as ptr<void>, n as i64)
    b.len = b.len + n
    d[b.len] = 0
}

export function tb_puts(b: ptr<TBuf>, s: string) {
    let n: i32 = strlen(s) as i32
    tb_put_span(b, s as ptr<u8>, 0, n)
}

export function tb_put_int(b: ptr<TBuf>, v: i32) {
    let tmp: ptr<u8> = malloc(32) as ptr<u8>
    snprintf(tmp, 32, "%d", v)
    tb_puts(b, tmp as string)
    free(tmp as ptr<void>)
}

export function tb_clear(b: ptr<TBuf>) {
    b.len = 0
    let d: ptr<u8> = b.data
    d[0] = 0
}

# Copy of the current contents as a fresh NUL-terminated string.
export function tb_str(b: ptr<TBuf>) -> string {
    return t_span(b.data, 0, b.len)
}

# ── Strings ─────────────────────────────────────────────────────

export function t_span(src: ptr<u8>, start: i32, end: i32) -> string {
    let mut n: i32 = end - start
    if n < 0 {
        n = 0
    }
    let out: ptr<u8> = malloc((n + 1) as i64) as ptr<u8>
    if n > 0 {
        memcpy(out as ptr<void>, (src + start) as ptr<void>, n as i64)
    }
    out[n] = 0
    return out as string
}

export function t_dup(s: string) -> string {
    return t_span(s as ptr<u8>, 0, strlen(s) as i32)
}

export function t_len(s: string) -> i32 {
    return strlen(s) as i32
}

export function t_eq(a: string, b: string) -> bool {
    return strcmp(a, b) == 0
}

export function t_at(s: string, i: i32) -> i32 {
    let p: ptr<u8> = s as ptr<u8>
    return p[i] as i32
}

export function t_is_space(c: i32) -> bool {
    return c == 32 or c == 9 or c == 10 or c == 13
}

export function t_is_digit(c: i32) -> bool {
    return c >= 48 and c <= 57
}

export function t_is_ident_start(c: i32) -> bool {
    if c >= 97 and c <= 122 {
        return true
    }
    if c >= 65 and c <= 90 {
        return true
    }
    return c == 95
}

export function t_is_ident_char(c: i32) -> bool {
    return t_is_ident_start(c) or t_is_digit(c)
}

# Python str.isalnum() for ASCII, plus underscore: the LSP word rule.
export function t_is_word_char(c: i32) -> bool {
    return t_is_ident_char(c)
}

export function t_starts_with(s: string, prefix: string) -> bool {
    let n: i32 = t_len(prefix)
    if t_len(s) < n {
        return false
    }
    let mut i: i32 = 0
    while i < n {
        if t_at(s, i) != t_at(prefix, i) {
            return false
        }
        i = i + 1
    }
    return true
}

export function t_ends_with(s: string, suffix: string) -> bool {
    let sl: i32 = t_len(s)
    let ul: i32 = t_len(suffix)
    if sl < ul {
        return false
    }
    let mut i: i32 = 0
    while i < ul {
        if t_at(s, sl - ul + i) != t_at(suffix, i) {
            return false
        }
        i = i + 1
    }
    return true
}

# Index of needle in s at or after from, or -1.
export function t_find_from(s: string, needle: string, from: i32) -> i32 {
    let sl: i32 = t_len(s)
    let nl: i32 = t_len(needle)
    let mut i: i32 = from
    if i < 0 {
        i = 0
    }
    while i + nl <= sl {
        let mut j: i32 = 0
        while j < nl and t_at(s, i + j) == t_at(needle, j) {
            j = j + 1
        }
        if j == nl {
            return i
        }
        i = i + 1
    }
    return -1
}

export function t_find(s: string, needle: string) -> i32 {
    return t_find_from(s, needle, 0)
}

export function t_contains(s: string, needle: string) -> bool {
    return t_find(s, needle) >= 0
}

export function t_find_char(s: string, c: i32) -> i32 {
    let n: i32 = t_len(s)
    let mut i: i32 = 0
    while i < n {
        if t_at(s, i) == c {
            return i
        }
        i = i + 1
    }
    return -1
}

export function t_count_char(s: string, c: i32) -> i32 {
    let n: i32 = t_len(s)
    let mut i: i32 = 0
    let mut k: i32 = 0
    while i < n {
        if t_at(s, i) == c {
            k = k + 1
        }
        i = i + 1
    }
    return k
}

export function t_sub(s: string, start: i32, end: i32) -> string {
    let n: i32 = t_len(s)
    let mut a: i32 = start
    let mut b: i32 = end
    if a < 0 {
        a = 0
    }
    if b > n {
        b = n
    }
    return t_span(s as ptr<u8>, a, b)
}

export function t_from(s: string, start: i32) -> string {
    return t_sub(s, start, t_len(s))
}

export function t_strip(s: string) -> string {
    let n: i32 = t_len(s)
    let mut a: i32 = 0
    let mut b: i32 = n
    while a < b and t_is_space(t_at(s, a)) {
        a = a + 1
    }
    while b > a and t_is_space(t_at(s, b - 1)) {
        b = b - 1
    }
    return t_span(s as ptr<u8>, a, b)
}

export function t_rstrip(s: string) -> string {
    let mut b: i32 = t_len(s)
    while b > 0 and t_is_space(t_at(s, b - 1)) {
        b = b - 1
    }
    return t_span(s as ptr<u8>, 0, b)
}

export function t_lower(s: string) -> string {
    let n: i32 = t_len(s)
    let out: ptr<u8> = malloc((n + 1) as i64) as ptr<u8>
    let mut i: i32 = 0
    while i < n {
        let mut c: i32 = t_at(s, i)
        if c >= 65 and c <= 90 {
            c = c + 32
        }
        out[i] = c as u8
        i = i + 1
    }
    out[n] = 0
    return out as string
}

export function t_int(v: i32) -> string {
    let tmp: ptr<u8> = malloc(32) as ptr<u8>
    snprintf(tmp, 32, "%d", v)
    return tmp as string
}

export function t_cat(a: string, b: string) -> string {
    let mut tb: TBuf = tb_new()
    tb_puts(&tb, a)
    tb_puts(&tb, b)
    return tb.data as string
}

export function t_cat3(a: string, b: string, c: string) -> string {
    let mut tb: TBuf = tb_new()
    tb_puts(&tb, a)
    tb_puts(&tb, b)
    tb_puts(&tb, c)
    return tb.data as string
}

# ── String lists ────────────────────────────────────────────────

export struct TList {
    items: ptr<ptr<u8>>,
    len: i32,
    cap: i32
}

export function tl_new() -> TList {
    return TList { items: malloc(8 * 16) as ptr<ptr<u8>>, len: 0, cap: 16 }
}

export function tl_push(l: ptr<TList>, s: string) {
    if l.len >= l.cap {
        l.cap = l.cap * 2
        l.items = realloc(l.items as ptr<void>, (8 * l.cap) as i64) as ptr<ptr<u8>>
    }
    let it: ptr<ptr<u8>> = l.items
    it[l.len] = s as ptr<u8>
    l.len = l.len + 1
}

export function tl_get(l: ptr<TList>, i: i32) -> string {
    let it: ptr<ptr<u8>> = l.items
    return it[i] as string
}

export function tl_set(l: ptr<TList>, i: i32, s: string) {
    let it: ptr<ptr<u8>> = l.items
    it[i] = s as ptr<u8>
}

export function tl_index(l: ptr<TList>, s: string) -> i32 {
    let mut i: i32 = 0
    while i < l.len {
        if t_eq(tl_get(l, i), s) {
            return i
        }
        i = i + 1
    }
    return -1
}

# Split on '\n' (Python str.split('\n'): n newlines give n + 1 rows).
export function t_split_lines(s: string) -> TList {
    let mut l: TList = tl_new()
    let n: i32 = t_len(s)
    let p: ptr<u8> = s as ptr<u8>
    let mut start: i32 = 0
    let mut i: i32 = 0
    while i < n {
        if p[i] == 10 {
            tl_push(&l, t_span(p, start, i))
            start = i + 1
        }
        i = i + 1
    }
    tl_push(&l, t_span(p, start, n))
    return l
}

# ── Files, streams, processes ───────────────────────────────────

# Whole file as a string, or "" with ok = false when unreadable.
export function t_read_file(path: string) -> string {
    let fp: ptr<void> = fopen(path, "rb")
    if fp == null {
        return ""
    }
    let mut tb: TBuf = tb_new()
    let chunk: ptr<u8> = malloc(65536) as ptr<u8>
    let mut n: i64 = fread(chunk, 1, 65536, fp)
    while n > 0 {
        tb_put_span(&tb, chunk, 0, n as i32)
        n = fread(chunk, 1, 65536, fp)
    }
    fclose(fp)
    free(chunk as ptr<void>)
    return tb.data as string
}

export function t_file_exists(path: string) -> bool {
    let fp: ptr<void> = fopen(path, "rb")
    if fp == null {
        return false
    }
    fclose(fp)
    return true
}

export function t_write_file(path: string, text: string) -> bool {
    let fp: ptr<void> = fopen(path, "wb")
    if fp == null {
        return false
    }
    let n: i64 = strlen(text)
    if n > 0 {
        fwrite(text as ptr<u8>, 1, n, fp)
    }
    fclose(fp)
    return true
}

export struct TProc {
    out: string,
    status: i32
}

# Run a shell command, capture stdout (and stderr when the command
# redirects it), and return the raw wait status from pclose.
export function t_run(cmd: string) -> TProc {
    let fp: ptr<void> = popen(cmd, "r")
    if fp == null {
        return TProc { out: "", status: -1 }
    }
    let mut tb: TBuf = tb_new()
    let chunk: ptr<u8> = malloc(65536) as ptr<u8>
    let mut n: i64 = fread(chunk, 1, 65536, fp)
    while n > 0 {
        tb_put_span(&tb, chunk, 0, n as i32)
        n = fread(chunk, 1, 65536, fp)
    }
    free(chunk as ptr<void>)
    let st: i32 = pclose(fp)
    return TProc { out: tb.data as string, status: st }
}

# Single-quote a string for /bin/sh.
export function t_shq(s: string) -> string {
    let mut tb: TBuf = tb_new()
    tb_putc(&tb, 39)
    let n: i32 = t_len(s)
    let mut i: i32 = 0
    while i < n {
        let c: i32 = t_at(s, i)
        if c == 39 {
            tb_puts(&tb, "'\\''")
        } else {
            tb_putc(&tb, c)
        }
        i = i + 1
    }
    tb_putc(&tb, 39)
    return tb.data as string
}

export function t_env(name: string, fallback: string) -> string {
    let v: string = getenv(name)
    if v == null {
        return fallback
    }
    if t_len(v) == 0 {
        return fallback
    }
    return v
}

# Write raw bytes to a file descriptor, retrying short writes.
export function t_write_fd(fd: i32, data: ptr<u8>, n: i32) {
    let mut off: i32 = 0
    while off < n {
        let w: i64 = write(fd, (data + off) as string, (n - off) as i64)
        if w <= 0 {
            return
        }
        off = off + (w as i32)
    }
}

# ── Buffered stdin ──────────────────────────────────────────────

export struct TReader {
    buf: ptr<u8>,
    len: i32,
    pos: i32,
    cap: i32,
    eof: bool
}

export function tr_new() -> TReader {
    let cap: i32 = 65536
    return TReader { buf: malloc(cap as i64) as ptr<u8>, len: 0, pos: 0, cap: cap, eof: false }
}

# Refill when drained. Returns false at end of input.
export function tr_fill(r: ptr<TReader>) -> bool {
    if r.pos < r.len {
        return true
    }
    if r.eof {
        return false
    }
    let n: i64 = read(0, r.buf, r.cap as i64)
    if n <= 0 {
        r.eof = true
        return false
    }
    r.len = n as i32
    r.pos = 0
    return true
}

# Next byte, or -1 at end of input.
export function tr_getc(r: ptr<TReader>) -> i32 {
    if not tr_fill(r) {
        return -1
    }
    let b: ptr<u8> = r.buf
    let c: i32 = b[r.pos] as i32
    r.pos = r.pos + 1
    return c
}

# One line without its trailing '\n'. ok = false at end of input with
# nothing read (Python input() raising EOFError).
export struct TLine {
    text: string,
    ok: bool
}

export function tr_line(r: ptr<TReader>) -> TLine {
    let mut tb: TBuf = tb_new()
    let mut c: i32 = tr_getc(r)
    if c < 0 {
        return TLine { text: "", ok: false }
    }
    while c >= 0 and c != 10 {
        tb_putc(&tb, c)
        c = tr_getc(r)
    }
    return TLine { text: tb.data as string, ok: true }
}
