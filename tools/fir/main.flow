# @module tools.fir
# @means  `flow fir-g`: the FIR-G program graph report, written in Flow.
#
# Builds the columnar program graph for a program (tools/fir/lower.flow on
# the flowc front end), runs the CPU analyses and optimisation candidates
# (tools/fir/graph.flow) and prints the text or JSON report, with the same
# options, output and exit codes as src/flow/fir_cli.py.
#
# The Python tool could also run the analyses in bulk on NumPy or MLX. Flow
# has neither, so this is the Python tool on a machine without them: the
# results are the CPU results, `--device numpy|mlx` stops with "NumPy not
# available" / "MLX not available", `--bench` reports bulk=n/a, and
# `--calibrate` records that bulk never wins (auto stays on cpu).
#
# The launcher (the flow CLI, tools/flow_cli) passes FLOW_ROOT, the repository root, which
# locates lib/stdlib when the program has no flow.toml of its own.

import "tools/hostlib/text.flow"
import "tools/lsp/json.flow"
import "tools/fir/graph.flow"
import "tools/fir/lower.flow"
import "compiler/src/ast.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function exit(code: i32)
    function getenv(name: string) -> string
    function snprintf(buf: ptr<u8>, n: i64, fmt: string, ...) -> i32
    function fputs(s: string, fp: ptr<void>) -> i32
    function fflush(fp: ptr<void>) -> i32
    function mkdir(path: string, mode: i32) -> i32
    function gettimeofday(tv: ptr<i64>, tz: ptr<void>) -> i32
    function strtol(s: string, end: ptr<ptr<u8>>, base: i32) -> i64
    function strtod(s: string, end: ptr<void>) -> f64
}

const NEVER_BULK: i32 = 1000000000

const USAGE: string = "usage: flow fir-g [-h] [--json] [--device {cpu,numpy,mlx,auto}] [--bench]\n                  [--calibrate] [--thresholds THRESHOLDS] [--opts]\n                  [--apply PASSES] [program]\n"

function help_text() -> string {
    let mut tb: TBuf = tb_new()
    tb_puts(&tb, USAGE)
    tb_puts(&tb, "\nFlow FIR-G: program graph + CPU/MLX analyses\n\n")
    tb_puts(&tb, "positional arguments:\n")
    tb_puts(&tb, "  program               .flow source file (optional with --calibrate alone)\n\n")
    tb_puts(&tb, "options:\n")
    tb_puts(&tb, "  -h, --help            show this help message and exit\n")
    tb_puts(&tb, "  --json                machine-readable report\n")
    tb_puts(&tb, "  --device {cpu,numpy,mlx,auto}\n")
    tb_puts(&tb, "                        analysis device (default: cpu). auto uses measured\n")
    tb_puts(&tb, "                        thresholds (uncalibrated → cpu)\n")
    tb_puts(&tb, "  --bench               print rough CPU vs bulk wall times for this program\n")
    tb_puts(&tb, "  --calibrate           sweep synthetic graph sizes, measure break-even, save\n")
    tb_puts(&tb, "                        thresholds\n")
    tb_puts(&tb, "  --thresholds THRESHOLDS\n")
    tb_puts(&tb, "                        path to fir_g_route.json (default:\n")
    tb_puts(&tb, "                        $FLOW_FIR_G_THRESHOLDS or\n")
    tb_puts(&tb, "                        ~/.cache/flow/fir_g_route.json)\n")
    tb_puts(&tb, "  --opts                list deterministic optimisation candidates (dead_elim\n")
    tb_puts(&tb, "                        / inline)\n")
    tb_puts(&tb, "  --apply PASSES        apply optimisation passes and report the rewritten\n")
    tb_puts(&tb, "                        graph. PASSES is a comma list from\n")
    tb_puts(&tb, "                        {dead_elim, const_fold, all}.\n")
    tb_puts(&tb, "                        With --opts, candidates reflect the post-pass graph\n")
    return tb.data as string
}

function out(s: string) {
    t_write_fd(1, s as ptr<u8>, t_len(s))
}

function err(s: string) {
    t_write_fd(2, s as ptr<u8>, t_len(s))
}

function arg_error(msg: string) {
    err(USAGE)
    err(t_cat3("flow fir-g: error: ", msg, "\n"))
    exit(2)
}

# ── Number formatting as Python prints it ───────────────────────

function fmt_score(x: f64) -> string {
    # Scores are round(x, 4) (or 10.0 + ops): Python's repr is the 4-decimal
    # text with trailing zeros dropped, keeping one digit after the point.
    let buf: ptr<u8> = calloc(64, 1) as ptr<u8>
    let _n: i32 = snprintf(buf, 64, "%.4f", x)
    let s: string = buf as string
    let mut end: i32 = t_len(s)
    while end > 0 and t_at(s, end - 1) == 48 {
        end = end - 1
    }
    if end > 0 and t_at(s, end - 1) == 46 {
        end = end + 1
    }
    return t_sub(s, 0, end)
}

# Shortest round-trip repr of a timing, as Python's float repr.
function fmt_float(x: f64) -> string {
    let buf: ptr<u8> = calloc(64, 1) as ptr<u8>
    let mut prec: i32 = 1
    while prec <= 17 {
        let _n: i32 = snprintf(buf, 64, "%.*g", prec, x)
        if strtod(buf as string, null) == x {
            break
        }
        prec = prec + 1
    }
    let s: string = buf as string
    if t_find_char(s, 46) < 0 and t_find_char(s, 101) < 0 {
        return t_cat(s, ".0")
    }
    return s
}

function fmt_ms3(x: f64) -> string {
    let buf: ptr<u8> = calloc(64, 1) as ptr<u8>
    let _n: i32 = snprintf(buf, 64, "%.3f", x)
    return buf as string
}

function hex4(v: i32) -> string {
    let buf: ptr<u8> = calloc(32, 1) as ptr<u8>
    let _n: i32 = snprintf(buf, 32, "%04x", v)
    return buf as string
}

function py_bool(b: bool) -> string {
    if b {
        return "True"
    }
    return "False"
}

function json_bool(b: bool) -> string {
    if b {
        return "true"
    }
    return "false"
}

# json.dumps string with ensure_ascii.
function jq(s: string) -> string {
    let mut tb: TBuf = tb_new()
    jw_escape(&tb, s)
    return tb.data as string
}

# Python repr of a str (single quotes unless the text has one).
function py_repr(s: string) -> string {
    return t_cat3("'", s, "'")
}

# ── Timing ──────────────────────────────────────────────────────

function now_ms() -> f64 {
    let tv: ptr<i64> = calloc(2, 8) as ptr<i64>
    let _r: i32 = gettimeofday(tv, null)
    let ms: f64 = (tv[0] as f64) * 1000.0 + (tv[1] as f64) / 1000.0
    free(tv as ptr<void>)
    return ms
}

# ── Report ──────────────────────────────────────────────────────

struct Report {
    summary: string,
    edge_caller: TList,
    edge_callee: TList,
    edge_weight: IVec,
    names: TList,
    effects: IVec,
    pure: IVec,
    reachable: TList,
    dead: TList,
    num_call_ops: i32,
    live: ptr<i32>
}

function sort_strings(l: ptr<TList>) {
    let mut i: i32 = 1
    while i < l.len {
        let cur: string = tl_get(l, i)
        let mut j: i32 = i - 1
        while j >= 0 and strcmp_s(tl_get(l, j), cur) > 0 {
            tl_set(l, j + 1, tl_get(l, j))
            j = j - 1
        }
        tl_set(l, j + 1, cur)
        i = i + 1
    }
}

function analyse(g: ptr<FirG>) -> Report {
    fg_propagate_effects(g)
    let live: ptr<i32> = fg_reachable(g)
    let nf: i32 = fg_num_funcs(g)
    let mut r: Report = Report {
        summary: fg_summary(g),
        edge_caller: tl_new(),
        edge_callee: tl_new(),
        edge_weight: iv_new(),
        names: tl_new(),
        effects: iv_new(),
        pure: iv_new(),
        reachable: tl_new(),
        dead: tl_new(),
        num_call_ops: fg_num_call_ops(g),
        live: live
    }
    # Edge weights keyed by (caller name, callee name), first-seen order.
    let mut keys: SMap = sm_new()
    let mut f: i32 = 0
    while f < nf {
        let caller: string = fg_func_name(g, f)
        let lo: i32 = iv_get(&g.call_row_offsets, f)
        let hi: i32 = iv_get(&g.call_row_offsets, f + 1)
        let mut ei: i32 = lo
        while ei < hi {
            let callee: string = fg_func_name(g, iv_get(&g.call_columns, ei))
            let key: string = t_cat3(caller, "\n", callee)
            let at: i32 = sm_get(&keys, key)
            if at < 0 {
                sm_put(&keys, key, r.edge_weight.len)
                tl_push(&r.edge_caller, caller)
                tl_push(&r.edge_callee, callee)
                iv_push(&r.edge_weight, 1)
            } else {
                iv_set(&r.edge_weight, at, iv_get(&r.edge_weight, at) + 1)
            }
            ei = ei + 1
        }
        f = f + 1
    }
    # effects / pure are dicts by name: first position, last value.
    let mut seen: SMap = sm_new()
    f = 0
    while f < nf {
        let name: string = fg_func_name(g, f)
        let at: i32 = sm_get(&seen, name)
        let bits: i32 = iv_get(&g.func_effect_bits, f)
        let mut pv: i32 = 0
        if fg_is_pure(g, f) {
            pv = 1
        }
        if at < 0 {
            sm_put(&seen, name, r.names.len)
            tl_push(&r.names, name)
            iv_push(&r.effects, bits)
            iv_push(&r.pure, pv)
        } else {
            iv_set(&r.effects, at, bits)
            iv_set(&r.pure, at, pv)
        }
        if live[f] != 0 {
            tl_push(&r.reachable, name)
        } else {
            tl_push(&r.dead, name)
        }
        f = f + 1
    }
    sort_strings(&r.reachable)
    return r
}

function join_names(l: ptr<TList>) -> string {
    if l.len == 0 {
        return "(none)"
    }
    let mut tb: TBuf = tb_new()
    let mut i: i32 = 0
    while i < l.len {
        if i > 0 {
            tb_puts(&tb, ", ")
        }
        tb_puts(&tb, tl_get(l, i))
        i = i + 1
    }
    return tb.data as string
}

struct Extra {
    device_requested: string,
    device_chosen: string,
    has_bulk: bool,
    bulk_backend: string,
    bulk_ms: f64,
    has_opts: bool,
    cands: CandList,
    has_bench: bool,
    bench_cpu_ms: f64,
    has_apply: bool,
    has_dead: bool,
    applied_dead: TList,
    has_fold: bool,
    applied_folded: i32
}

function by_kind_order(c: ptr<CandList>) -> IVec {
    # Kinds in first-seen order over the sorted list, with counts.
    let mut order: IVec = iv_new()
    let mut dead: i32 = 0
    let mut inl: i32 = 0
    let mut i: i32 = 0
    while i < c.len {
        let k: i32 = cl_get(c, i).kind
        if k == KIND_DEAD {
            if dead == 0 and inl == 0 {
                iv_push(&order, KIND_DEAD)
            } elif dead == 0 {
                iv_push(&order, KIND_DEAD)
            }
            dead = dead + 1
        } else {
            if inl == 0 {
                iv_push(&order, KIND_INLINE)
            }
            inl = inl + 1
        }
        i = i + 1
    }
    iv_push(&order, dead)
    iv_push(&order, inl)
    return order
}

function by_kind_count(order: ptr<IVec>, k: i32) -> i32 {
    let n: i32 = order.len
    if k == KIND_DEAD {
        return iv_get(order, n - 2)
    }
    return iv_get(order, n - 1)
}

function text_report(r: ptr<Report>, x: ptr<Extra>) -> string {
    let mut tb: TBuf = tb_new()
    tb_puts(&tb, r.summary)
    tb_puts(&tb, "\ncall ops: ")
    tb_put_int(&tb, r.num_call_ops)
    tb_puts(&tb, "\nreachable: ")
    tb_puts(&tb, join_names(&r.reachable))
    tb_puts(&tb, "\ndead: ")
    tb_puts(&tb, join_names(&r.dead))
    if x.has_apply {
        tb_puts(&tb, "\napplied:")
        if x.has_fold {
            tb_puts(&tb, " const_fold folded=")
            tb_put_int(&tb, x.applied_folded)
            if x.has_dead {
                tb_puts(&tb, ";")
            }
        }
        if x.has_dead {
            tb_puts(&tb, " dead_elim removed=")
            tb_put_int(&tb, x.applied_dead.len)
            if x.applied_dead.len > 0 {
                tb_puts(&tb, " (")
                tb_puts(&tb, join_names(&x.applied_dead))
                tb_puts(&tb, ")")
            }
        }
    }
    tb_puts(&tb, "\ncall graph:")
    let mut i: i32 = 0
    while i < r.edge_weight.len {
        tb_puts(&tb, "\n  ")
        tb_puts(&tb, tl_get(&r.edge_caller, i))
        tb_puts(&tb, " -> ")
        tb_puts(&tb, tl_get(&r.edge_callee, i))
        tb_puts(&tb, "  (op ")
        tb_put_int(&tb, iv_get(&r.edge_weight, i))
        tb_puts(&tb, ")")
        i = i + 1
    }
    tb_puts(&tb, "\neffects / pure:")
    i = 0
    while i < r.names.len {
        tb_puts(&tb, "\n  ")
        tb_puts(&tb, tl_get(&r.names, i))
        tb_puts(&tb, ": effects=0x")
        tb_puts(&tb, hex4(iv_get(&r.effects, i)))
        tb_puts(&tb, " pure=")
        tb_puts(&tb, py_bool(iv_get(&r.pure, i) != 0))
        i = i + 1
    }
    tb_puts(&tb, "\ndevice: requested=")
    tb_puts(&tb, x.device_requested)
    tb_puts(&tb, " chosen=")
    tb_puts(&tb, x.device_chosen)
    if x.has_bulk {
        tb_puts(&tb, "\nbulk check (")
        tb_puts(&tb, x.bulk_backend)
        tb_puts(&tb, "): effects_match=True reach_match=True (")
        tb_puts(&tb, fmt_ms3(x.bulk_ms))
        tb_puts(&tb, " ms)")
    }
    if x.has_opts {
        let c: ptr<CandList> = &x.cands
        let mut order: IVec = by_kind_order(c)
        tb_puts(&tb, "\nopt candidates: total=")
        tb_put_int(&tb, c.len)
        tb_puts(&tb, " by_kind={")
        let nk: i32 = order.len - 2
        let mut k: i32 = 0
        while k < nk {
            if k > 0 {
                tb_puts(&tb, ", ")
            }
            let kind: i32 = iv_get(&order, k)
            tb_puts(&tb, py_repr(cand_kind_name(kind)))
            tb_puts(&tb, ": ")
            tb_put_int(&tb, by_kind_count(&order, kind))
            k = k + 1
        }
        tb_puts(&tb, "}")
        let mut ci: i32 = 0
        while ci < c.len and ci < 12 {
            let cd: Cand = cl_get(c, ci)
            tb_puts(&tb, "\n  [")
            tb_puts(&tb, cand_kind_name(cd.kind))
            tb_puts(&tb, "] ")
            tb_puts(&tb, cd.target)
            tb_puts(&tb, " score=")
            tb_puts(&tb, fmt_score(cd.score))
            tb_puts(&tb, " (")
            tb_puts(&tb, cd.reason)
            tb_puts(&tb, ")")
            if cd.kind == KIND_INLINE and t_len(cd.caller) > 0 {
                tb_puts(&tb, " caller=")
                tb_puts(&tb, cd.caller)
            }
            ci = ci + 1
        }
    }
    tb_puts(&tb, "\n")
    if x.has_bench {
        tb_puts(&tb, "bench: cpu=")
        tb_puts(&tb, fmt_ms3(x.bench_cpu_ms))
        tb_puts(&tb, " ms, bulk=n/a\n")
    }
    return tb.data as string
}

function json_str_list(tb: ptr<TBuf>, l: ptr<TList>, ind: string) {
    if l.len == 0 {
        tb_puts(tb, "[]")
        return
    }
    tb_puts(tb, "[")
    let mut i: i32 = 0
    while i < l.len {
        if i > 0 {
            tb_puts(tb, ",")
        }
        tb_puts(tb, "\n")
        tb_puts(tb, ind)
        tb_puts(tb, "  ")
        tb_puts(tb, jq(tl_get(l, i)))
        i = i + 1
    }
    tb_puts(tb, "\n")
    tb_puts(tb, ind)
    tb_puts(tb, "]")
}

function json_report(r: ptr<Report>, x: ptr<Extra>) -> string {
    let mut tb: TBuf = tb_new()
    tb_puts(&tb, "{\n  \"summary\": ")
    tb_puts(&tb, jq(r.summary))
    tb_puts(&tb, ",\n  \"call_edges\": ")
    if r.edge_weight.len == 0 {
        tb_puts(&tb, "[]")
    } else {
        tb_puts(&tb, "[")
        let mut i: i32 = 0
        while i < r.edge_weight.len {
            if i > 0 {
                tb_puts(&tb, ",")
            }
            tb_puts(&tb, "\n    {\n      \"caller\": ")
            tb_puts(&tb, jq(tl_get(&r.edge_caller, i)))
            tb_puts(&tb, ",\n      \"callee\": ")
            tb_puts(&tb, jq(tl_get(&r.edge_callee, i)))
            tb_puts(&tb, ",\n      \"op\": ")
            tb_put_int(&tb, iv_get(&r.edge_weight, i))
            tb_puts(&tb, "\n    }")
            i = i + 1
        }
        tb_puts(&tb, "\n  ]")
    }
    tb_puts(&tb, ",\n  \"effects\": ")
    if r.names.len == 0 {
        tb_puts(&tb, "{}")
    } else {
        tb_puts(&tb, "{")
        let mut i: i32 = 0
        while i < r.names.len {
            if i > 0 {
                tb_puts(&tb, ",")
            }
            tb_puts(&tb, "\n    ")
            tb_puts(&tb, jq(tl_get(&r.names, i)))
            tb_puts(&tb, ": ")
            tb_put_int(&tb, iv_get(&r.effects, i))
            i = i + 1
        }
        tb_puts(&tb, "\n  }")
    }
    tb_puts(&tb, ",\n  \"pure\": ")
    if r.names.len == 0 {
        tb_puts(&tb, "{}")
    } else {
        tb_puts(&tb, "{")
        let mut i: i32 = 0
        while i < r.names.len {
            if i > 0 {
                tb_puts(&tb, ",")
            }
            tb_puts(&tb, "\n    ")
            tb_puts(&tb, jq(tl_get(&r.names, i)))
            tb_puts(&tb, ": ")
            tb_puts(&tb, json_bool(iv_get(&r.pure, i) != 0))
            i = i + 1
        }
        tb_puts(&tb, "\n  }")
    }
    tb_puts(&tb, ",\n  \"reachable\": ")
    json_str_list(&tb, &r.reachable, "  ")
    tb_puts(&tb, ",\n  \"dead\": ")
    json_str_list(&tb, &r.dead, "  ")
    if x.has_apply {
        tb_puts(&tb, ",\n  \"applied\": {")
        if x.has_fold {
            tb_puts(&tb, "\"const_fold\": ")
            tb_put_int(&tb, x.applied_folded)
            if x.has_dead {
                tb_puts(&tb, ", ")
            }
        }
        if x.has_dead {
            tb_puts(&tb, "\"dead_elim\": ")
            json_str_list(&tb, &x.applied_dead, "    ")
        }
        tb_puts(&tb, "}")
    }
    tb_puts(&tb, ",\n  \"num_call_ops\": ")
    tb_put_int(&tb, r.num_call_ops)
    tb_puts(&tb, ",\n  \"device_requested\": ")
    tb_puts(&tb, jq(x.device_requested))
    tb_puts(&tb, ",\n  \"device_chosen\": ")
    tb_puts(&tb, jq(x.device_chosen))
    if x.has_bulk {
        tb_puts(&tb, ",\n  \"bulk_backend\": ")
        tb_puts(&tb, jq(x.bulk_backend))
        tb_puts(&tb, ",\n  \"bulk_ms\": ")
        tb_puts(&tb, fmt_float(x.bulk_ms))
        tb_puts(&tb, ",\n  \"bulk_effects_match\": true,\n  \"bulk_reach_match\": true")
    }
    if x.has_opts {
        let c: ptr<CandList> = &x.cands
        let mut order: IVec = by_kind_order(c)
        tb_puts(&tb, ",\n  \"opt_candidates\": {\n    \"total\": ")
        tb_put_int(&tb, c.len)
        tb_puts(&tb, ",\n    \"by_kind\": ")
        let nk: i32 = order.len - 2
        if nk == 0 {
            tb_puts(&tb, "{}")
        } else {
            tb_puts(&tb, "{")
            let mut k: i32 = 0
            while k < nk {
                if k > 0 {
                    tb_puts(&tb, ",")
                }
                let kind: i32 = iv_get(&order, k)
                tb_puts(&tb, "\n      ")
                tb_puts(&tb, jq(cand_kind_name(kind)))
                tb_puts(&tb, ": ")
                tb_put_int(&tb, by_kind_count(&order, kind))
                k = k + 1
            }
            tb_puts(&tb, "\n    }")
        }
        tb_puts(&tb, ",\n    \"top\": ")
        if c.len == 0 {
            tb_puts(&tb, "[]")
        } else {
            tb_puts(&tb, "[")
            let mut ci: i32 = 0
            while ci < c.len and ci < 32 {
                let cd: Cand = cl_get(c, ci)
                if ci > 0 {
                    tb_puts(&tb, ",")
                }
                tb_puts(&tb, "\n      {\n        \"kind\": ")
                tb_puts(&tb, jq(cand_kind_name(cd.kind)))
                tb_puts(&tb, ",\n        \"target\": ")
                tb_puts(&tb, jq(cd.target))
                tb_puts(&tb, ",\n        \"score\": ")
                tb_puts(&tb, fmt_score(cd.score))
                tb_puts(&tb, ",\n        \"reason\": ")
                tb_puts(&tb, jq(cd.reason))
                if cd.kind == KIND_INLINE {
                    tb_puts(&tb, ",\n        \"caller\": ")
                    tb_puts(&tb, jq(cd.caller))
                    tb_puts(&tb, ",\n        \"callsite_op\": ")
                    tb_put_int(&tb, cd.callsite_op)
                    tb_puts(&tb, ",\n        \"callee_ops\": ")
                    tb_put_int(&tb, cd.callee_ops)
                    tb_puts(&tb, ",\n        \"call_sites\": ")
                    tb_put_int(&tb, cd.call_sites)
                } else {
                    tb_puts(&tb, ",\n        \"caller\": null,\n        \"callsite_op\": null,\n        \"callee_ops\": ")
                    tb_put_int(&tb, cd.callee_ops)
                    tb_puts(&tb, ",\n        \"call_sites\": null")
                }
                tb_puts(&tb, "\n      }")
                ci = ci + 1
            }
            tb_puts(&tb, "\n    ]")
        }
        tb_puts(&tb, "\n  }")
    }
    if x.has_bench {
        tb_puts(&tb, ",\n  \"bench_cpu_ms\": ")
        tb_puts(&tb, fmt_float(x.bench_cpu_ms))
        tb_puts(&tb, ",\n  \"bench_bulk_ms\": null,\n  \"bench_bulk_name\": null")
    }
    tb_puts(&tb, "\n}\n")
    return tb.data as string
}

# ── Debug dump (FIR_G_DUMP=1): the graph op by op ───────────────

function dump_graph(g: ptr<FirG>) {
    let mut tb: TBuf = tb_new()
    let nf: i32 = fg_num_funcs(g)
    let mut f: i32 = 0
    while f < nf {
        tb_puts(&tb, "F ")
        tb_put_int(&tb, f)
        tb_puts(&tb, " ")
        tb_puts(&tb, fg_func_name(g, f))
        tb_puts(&tb, " ext=")
        tb_put_int(&tb, iv_get(&g.func_is_extern, f))
        tb_puts(&tb, " eff=")
        let buf: ptr<u8> = calloc(32, 1) as ptr<u8>
        let _n: i32 = snprintf(buf, 32, "%x", iv_get(&g.func_effect_bits, f))
        tb_puts(&tb, buf as string)
        tb_puts(&tb, " fb=")
        tb_put_int(&tb, iv_get(&g.func_first_block, f))
        tb_puts(&tb, " nb=")
        tb_put_int(&tb, iv_get(&g.func_block_count, f))
        tb_puts(&tb, "\n")
        f = f + 1
    }
    let mut b: i32 = 0
    while b < g.block_function.len {
        tb_puts(&tb, "B ")
        tb_put_int(&tb, b)
        tb_puts(&tb, " f=")
        tb_put_int(&tb, iv_get(&g.block_function, b))
        tb_puts(&tb, " n=")
        tb_put_int(&tb, iv_get(&g.block_op_count, b))
        tb_puts(&tb, "\n")
        b = b + 1
    }
    let mut o: i32 = 0
    while o < fg_num_ops(g) {
        tb_puts(&tb, "O ")
        tb_put_int(&tb, o)
        tb_puts(&tb, " op=")
        tb_put_int(&tb, iv_get(&g.op_opcode, o))
        tb_puts(&tb, " f=")
        tb_put_int(&tb, iv_get(&g.op_function, o))
        tb_puts(&tb, " b=")
        tb_put_int(&tb, iv_get(&g.op_block, o))
        tb_puts(&tb, " callee=")
        tb_put_int(&tb, iv_get(&g.op_callee, o))
        tb_puts(&tb, "\n")
        o = o + 1
    }
    tb_puts(&tb, "T")
    let mut t: i32 = 0
    while t < g.type_name.len {
        tb_puts(&tb, " ")
        tb_puts(&tb, tl_get(&g.type_name, t))
        t = t + 1
    }
    tb_puts(&tb, "\n")
    out(tb.data as string)
}

# ── Thresholds (fir_route.py) ───────────────────────────────────

function home_dir() -> string {
    return t_env("HOME", "")
}

function default_thresholds_path() -> string {
    let env: string = t_env("FLOW_FIR_G_THRESHOLDS", "")
    if t_len(env) > 0 {
        return py_path(env)
    }
    let xdg: string = t_env("XDG_CACHE_HOME", "")
    if t_len(xdg) > 0 {
        return py_path(t_cat(xdg, "/flow/fir_g_route.json"))
    }
    return py_path(t_cat(home_dir(), "/.cache/flow/fir_g_route.json"))
}

# str(pathlib.Path(p)): collapse repeated slashes and `.` segments, drop a
# trailing slash.
function py_path(p: string) -> string {
    if t_len(p) == 0 {
        return "."
    }
    let abs: bool = t_at(p, 0) == 47
    let mut parts: TList = tl_new()
    let n: i32 = t_len(p)
    let mut s: i32 = 0
    let mut i: i32 = 0
    while i <= n {
        if i == n or t_at(p, i) == 47 {
            let seg: string = t_sub(p, s, i)
            if t_len(seg) > 0 and not t_eq(seg, ".") {
                tl_push(&parts, seg)
            }
            s = i + 1
        }
        i = i + 1
    }
    let mut tb: TBuf = tb_new()
    if abs {
        tb_putc(&tb, 47)
    }
    i = 0
    while i < parts.len {
        if i > 0 {
            tb_putc(&tb, 47)
        }
        tb_puts(&tb, tl_get(&parts, i))
        i = i + 1
    }
    if tb.len == 0 {
        return "."
    }
    return tb.data as string
}

function mkdir_p(path: string) {
    let n: i32 = t_len(path)
    let mut i: i32 = 1
    while i <= n {
        if i == n or t_at(path, i) == 47 {
            let _r: i32 = mkdir(t_sub(path, 0, i), 493)
        }
        i = i + 1
    }
}

struct Thresholds {
    ok: bool,
    bulk_backend: string,
    min_funcs: i64,
    min_edges: i64
}

# Python int() of a JSON value: numbers truncate, strings must be integer
# text, booleans are 0/1, anything else fails.
function json_int(d: ptr<JDoc>, id: i32, okp: ptr<i32>) -> i64 {
    let k: i32 = jkind(d, id)
    if k == J_NUM {
        return strtod(jraw(d, id), null) as i64
    }
    if k == J_TRUE {
        return 1
    }
    if k == J_FALSE {
        return 0
    }
    if k == J_STR {
        let s: string = t_strip(jstr(d, id))
        let n: i32 = t_len(s)
        let mut i: i32 = 0
        if n > 0 and (t_at(s, 0) == 45 or t_at(s, 0) == 43) {
            i = 1
        }
        if i >= n {
            okp[0] = 0
            return 0
        }
        while i < n {
            let c: i32 = t_at(s, i)
            if c != 95 and (c < 48 or c > 57) {
                okp[0] = 0
                return 0
            }
            i = i + 1
        }
        return strtol(s, null, 10)
    }
    okp[0] = 0
    return 0
}

function json_pystr(d: ptr<JDoc>, id: i32) -> string {
    let k: i32 = jkind(d, id)
    if k == J_STR {
        return jstr(d, id)
    }
    if k == J_TRUE {
        return "True"
    }
    if k == J_FALSE {
        return "False"
    }
    if k == J_NULL {
        return "None"
    }
    return jraw(d, id)
}

function load_thresholds(path: string) -> Thresholds {
    let none: Thresholds = Thresholds { ok: false, bulk_backend: "", min_funcs: 0, min_edges: 0 }
    if not path_is_file(path) {
        return none
    }
    let text: string = t_read_file(path)
    let mut d: JDoc = json_parse(text as ptr<u8>, t_len(text))
    if d.err != 0 or jkind(&d, d.root) != J_OBJ {
        return none
    }
    let bb: i32 = jget(&d, d.root, "bulk_backend")
    let mf: i32 = jget(&d, d.root, "min_funcs")
    if bb == J_NONE or mf == J_NONE {
        return none
    }
    let okv: ptr<i32> = calloc(1, 4) as ptr<i32>
    okv[0] = 1
    let min_funcs: i64 = json_int(&d, mf, okv)
    let mut min_edges: i64 = min_funcs
    let me: i32 = jget(&d, d.root, "min_edges")
    if me != J_NONE {
        min_edges = json_int(&d, me, okv)
    }
    if okv[0] == 0 {
        return none
    }
    return Thresholds { ok: true, bulk_backend: json_pystr(&d, bb), min_funcs: min_funcs, min_edges: min_edges }
}

function host_tag() -> string {
    let sys: string = t_strip(t_run("uname -s 2>/dev/null").out)
    let mach: string = t_strip(t_run("uname -m 2>/dev/null").out)
    return t_cat(t_cat3(sys, "-", mach), "-mlx=False-np=False")
}

function thresholds_json(host: string) -> string {
    let mut tb: TBuf = tb_new()
    tb_puts(&tb, "{\n  \"bulk_backend\": \"cpu\",\n  \"min_funcs\": 1000000000,\n  \"min_edges\": 1000000000,\n  \"host\": ")
    tb_puts(&tb, jq(host))
    tb_puts(&tb, ",\n  \"samples\": []")
    return tb.data as string
}

# ── CLI ─────────────────────────────────────────────────────────

struct Args {
    program: string,
    has_program: bool,
    json: bool,
    device: string,
    bench: bool,
    calibrate: bool,
    thresholds: string,
    has_thresholds: bool,
    opts: bool,
    apply: string,
    has_apply: bool
}


# The long option `a` names, allowing argparse's unique prefixes; "" when
# none matches, "?" when several do.
function match_long(a: string) -> string {
    let mut names: TList = tl_new()
    tl_push(&names, "--help")
    tl_push(&names, "--json")
    tl_push(&names, "--device")
    tl_push(&names, "--bench")
    tl_push(&names, "--calibrate")
    tl_push(&names, "--thresholds")
    tl_push(&names, "--opts")
    tl_push(&names, "--apply")
    let mut found: string = ""
    let mut count: i32 = 0
    let mut i: i32 = 0
    while i < names.len {
        let nm: string = tl_get(&names, i)
        if t_eq(nm, a) {
            return nm
        }
        if t_starts_with(nm, a) {
            found = nm
            count = count + 1
        }
        i = i + 1
    }
    if count == 1 {
        return found
    }
    if count > 1 {
        return "?"
    }
    return ""
}

function is_negative_number(a: string) -> bool {
    if t_len(a) < 2 or t_at(a, 0) != 45 {
        return false
    }
    let mut i: i32 = 1
    let mut digits: i32 = 0
    while i < t_len(a) {
        let c: i32 = t_at(a, i)
        if c >= 48 and c <= 57 {
            digits = digits + 1
        } elif c != 46 {
            return false
        }
        i = i + 1
    }
    return digits > 0
}

function check_device(v: string) {
    if t_eq(v, "cpu") or t_eq(v, "numpy") or t_eq(v, "mlx") or t_eq(v, "auto") {
        return
    }
    arg_error(t_cat3("argument --device: invalid choice: ", py_repr(v), " (choose from cpu, numpy, mlx, auto)"))
}

# True when the comma-separated --apply value names `pass` or `all`.
function apply_wants(v: string, pass: string) -> bool {
    let n: i32 = t_len(v)
    let mut s: i32 = 0
    let mut i: i32 = 0
    while i <= n {
        if i == n or t_at(v, i) == 44 {
            let p: string = t_sub(v, s, i)
            s = i + 1
            if t_eq(p, pass) or t_eq(p, "all") {
                return true
            }
        }
        i = i + 1
    }
    return false
}

function check_apply(v: string) {
    let n: i32 = t_len(v)
    let mut s: i32 = 0
    let mut i: i32 = 0
    while i <= n {
        if i == n or t_at(v, i) == 44 {
            let p: string = t_sub(v, s, i)
            s = i + 1
            if not t_eq(p, "dead_elim") and not t_eq(p, "const_fold") and not t_eq(p, "all") {
                arg_error(t_cat3("argument --apply: invalid choice: ", py_repr(p), " (choose from dead_elim, const_fold, all)"))
            }
        }
        i = i + 1
    }
}

function parse_args(argv: ptr<TList>) -> Args {
    let mut a: Args = Args {
        program: "", has_program: false, json: false, device: "cpu", bench: false,
        calibrate: false, thresholds: "", has_thresholds: false, opts: false,
        apply: "", has_apply: false
    }
    let mut extras: TList = tl_new()
    let mut only_pos: bool = false
    let mut i: i32 = 0
    while i < argv.len {
        let s: string = tl_get(argv, i)
        i = i + 1
        if not only_pos and t_eq(s, "--") {
            only_pos = true
            continue
        }
        let is_opt: bool = not only_pos and t_len(s) > 1 and t_at(s, 0) == 45 and not is_negative_number(s)
        if not is_opt {
            if a.has_program {
                tl_push(&extras, s)
            } else {
                a.program = s
                a.has_program = true
            }
            continue
        }
        if t_eq(s, "-h") {
            out(help_text())
            exit(0)
        }
        let mut name: string = s
        let mut value: string = ""
        let mut has_value: bool = false
        let eq: i32 = t_find_char(s, 61)
        if t_starts_with(s, "--") and eq > 0 {
            name = t_sub(s, 0, eq)
            value = t_from(s, eq + 1)
            has_value = true
        }
        let opt: string = match_long(name)
        if t_eq(opt, "?") {
            arg_error(t_cat3("ambiguous option: ", name, ""))
        }
        if t_len(opt) == 0 {
            tl_push(&extras, s)
            continue
        }
        if t_eq(opt, "--help") {
            out(help_text())
            exit(0)
        }
        if t_eq(opt, "--device") or t_eq(opt, "--thresholds") or t_eq(opt, "--apply") {
            if not has_value {
                let nxt_ok: bool = i < argv.len and not (t_len(tl_get(argv, i)) > 1 and t_at(tl_get(argv, i), 0) == 45 and not is_negative_number(tl_get(argv, i)))
                if not nxt_ok {
                    arg_error(t_cat3("argument ", opt, ": expected one argument"))
                }
                value = tl_get(argv, i)
                i = i + 1
            }
            if t_eq(opt, "--device") {
                check_device(value)
                a.device = value
            } elif t_eq(opt, "--apply") {
                check_apply(value)
                a.apply = value
                a.has_apply = true
            } else {
                a.thresholds = value
                a.has_thresholds = true
            }
            continue
        }
        if has_value {
            arg_error(t_cat(t_cat3("argument ", opt, ": ignored explicit argument "), py_repr(value)))
        }
        if t_eq(opt, "--json") {
            a.json = true
        } elif t_eq(opt, "--bench") {
            a.bench = true
        } elif t_eq(opt, "--calibrate") {
            a.calibrate = true
        } elif t_eq(opt, "--opts") {
            a.opts = true
        }
    }
    if extras.len > 0 {
        let mut tb: TBuf = tb_new()
        tb_puts(&tb, "unrecognized arguments:")
        let mut k: i32 = 0
        while k < extras.len {
            tb_puts(&tb, " ")
            tb_puts(&tb, tl_get(&extras, k))
            k = k + 1
        }
        arg_error(tb.data as string)
    }
    return a
}

function run_calibrate(a: ptr<Args>) {
    let mut path: string = default_thresholds_path()
    if a.has_thresholds {
        path = py_path(a.thresholds)
    }
    let host: string = host_tag()
    mkdir_p(path_dirname(path))
    if not t_write_file(path, t_cat(thresholds_json(host), "\n}\n")) {
        err(t_cat3("error: could not write ", path, "\n"))
        exit(1)
    }
    if a.json {
        out(t_cat(thresholds_json(host), t_cat3(",\n  \"saved_to\": ", jq(path), "\n}\n")))
    } else {
        out(t_cat3("calibrated routing → ", path, "\n"))
        out("  bulk_backend=cpu min_funcs=1000000000 min_edges=1000000000\n")
        out("  (bulk never beat CPU in sweep; auto stays on cpu)\n")
    }
}

export function main(argc: i32, argp: ptr<ptr<u8>>) -> i32 {
    let mut argv: TList = tl_new()
    let mut ai: i32 = 1
    while ai < argc {
        tl_push(&argv, argp[ai] as string)
        ai = ai + 1
    }
    let mut a: Args = parse_args(&argv)
    if a.calibrate {
        run_calibrate(&a)
        if not a.has_program {
            return 0
        }
    }
    if not a.has_program {
        arg_error("program is required unless using --calibrate alone")
    }
    if not path_exists(a.program) {
        err(t_cat3("error: no such file: ", py_path(a.program), "\n"))
        return 1
    }
    let flow_root: string = t_env("FLOW_ROOT", ".")
    let ld: ptr<Loader> = load_program(a.program, flow_root)
    if t_len(ld.err) > 0 {
        err(t_cat(ld.err, "\n"))
        return 1
    }
    let g: ptr<FirG> = graphify(ld)
    let mut g2: ptr<FirG> = g
    let mut r: Report = analyse(g)
    let mut x: Extra = Extra {
        device_requested: a.device, device_chosen: "cpu", has_bulk: false, bulk_backend: "",
        bulk_ms: 0.0, has_opts: false, cands: CandList { items: null, len: 0, cap: 0 },
        has_bench: false, bench_cpu_ms: 0.0, has_apply: false, has_dead: false, applied_dead: tl_new(),
        has_fold: false, applied_folded: 0
    }
    if a.has_apply {
        x.has_apply = true
        x.has_fold = apply_wants(a.apply, "const_fold")
        x.has_dead = apply_wants(a.apply, "dead_elim")
        if x.has_fold {
            x.applied_folded = fg_apply_const_fold(g)
        }
        if x.has_dead {
            let comp: FirCompact = fg_apply_dead_elim(g)
            x.applied_dead = comp.removed
            g2 = comp.g
        }
        r = analyse(g2)
    }
    if t_len(t_env("FIR_G_DUMP", "")) > 0 {
        dump_graph(g2)
        return 0
    }
    # Routing (fir_route.choose_analysis_backend) with no NumPy and no MLX.
    if t_eq(a.device, "numpy") {
        err("RuntimeError: NumPy not available\n")
        return 1
    }
    if t_eq(a.device, "mlx") {
        err("RuntimeError: MLX not available\n")
        return 1
    }
    if t_eq(a.device, "auto") {
        let mut tpath: string = default_thresholds_path()
        if a.has_thresholds {
            tpath = py_path(a.thresholds)
        }
        let th: Thresholds = load_thresholds(tpath)
        if th.ok and th.min_funcs < (NEVER_BULK as i64) {
            let nf: i64 = fg_num_funcs(g2) as i64
            let ne: i64 = fg_num_edges(g2) as i64
            if nf >= th.min_funcs or ne >= th.min_edges {
                let be: string = th.bulk_backend
                if t_eq(be, "mlx") or t_eq(be, "numpy") or t_eq(be, "cpu") {
                    x.device_chosen = "cpu"
                } else {
                    x.device_chosen = be
                }
            }
        }
        if not t_eq(x.device_chosen, "cpu") {
            let low: string = t_lower(x.device_chosen)
            if t_eq(low, "cpu") {
                # resolve_backend lowercases: the bulk check runs on the CPU.
                let t0: f64 = now_ms()
                let t1: f64 = now_ms()
                x.has_bulk = true
                x.bulk_backend = "cpu"
                x.bulk_ms = t1 - t0
            } elif t_eq(low, "auto") {
                err("RuntimeError: bulk backends require NumPy to build adjacency\n")
                return 1
            } else {
                err(t_cat3("ValueError: unknown device: ", x.device_chosen, "\n"))
                return 1
            }
        }
    }
    if a.opts {
        x.has_opts = true
        x.cands = discover_candidates(g2, r.live)
    }
    if a.bench {
        # break_even_hint: the CPU analyses, five times, on a fresh copy of
        # the effect bits each time.
        let nf: i32 = fg_num_funcs(g2)
        let saved: ptr<i32> = calloc((nf + 1) as i64, 4) as ptr<i32>
        let bits: ptr<i32> = g2.func_effect_bits.data
        let mut k: i32 = 0
        while k < nf {
            saved[k] = bits[k]
            k = k + 1
        }
        let t0: f64 = now_ms()
        let mut rep: i32 = 0
        while rep < 5 {
            fg_propagate_effects(g2)
            let _live: ptr<i32> = fg_reachable(g2)
            k = 0
            while k < nf {
                bits[k] = saved[k]
                k = k + 1
            }
            rep = rep + 1
        }
        x.has_bench = true
        x.bench_cpu_ms = (now_ms() - t0) / 5.0
    }
    if a.json {
        out(json_report(&r, &x))
    } else {
        out(text_report(&r, &x))
    }
    return 0
}
