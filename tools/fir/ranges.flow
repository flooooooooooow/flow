# @module tools.fir.ranges
# @means  `sum(a..b step s)` the way the Python parser lowers it
#         (src/flow/range_sums.py): literal bounds fold to one constant, any
#         other range becomes a call to a generated helper, and a module that
#         makes such a call carries the helper functions. fir-g needs this
#         because the fold leaves no call and the helpers are functions in
#         the graph.

import "tools/hostlib/text.flow"
import "compiler/src/ast.flow"
import "compiler/src/token.flow"

export const RANGE_SUM_HELPER: string = "\nfunction __flow_sum_range(start: i32, limit: i32, step: i32) -> i32 {\n    if step == 0 {\n        return 0\n    }\n    let mut count: i32 = 0\n    if step > 0 {\n        if start >= limit {\n            return 0\n        }\n        count = (limit - start + step - 1) / step\n    } else {\n        if start <= limit {\n            return 0\n        }\n        count = (start - limit + (0 - step) - 1) / (0 - step)\n    }\n    let endpoints: i32 = 2 * start + (count - 1) * step\n    if count % 2 == 0 {\n        return (count / 2) * endpoints\n    }\n    return count * (endpoints / 2)\n}\n"

export const RANGE_SET_HELPER: string = "\nfunction __flow_range_gcd(a: i64, b: i64) -> i64 {\n    let mut x: i64 = a\n    let mut y: i64 = b\n    if x < 0 { x = 0 - x }\n    if y < 0 { y = 0 - y }\n    while y != 0 {\n        let t: i64 = x % y\n        x = y\n        y = t\n    }\n    return x\n}\n\nfunction __flow_range_modinv(a: i64, m: i64) -> i64 {\n    if m <= 1 {\n        return 0\n    }\n    let mut old_r: i64 = a % m\n    if old_r < 0 {\n        old_r = old_r + m\n    }\n    let mut r: i64 = m\n    let mut old_s: i64 = 1\n    let mut s: i64 = 0\n    while r != 0 {\n        let q: i64 = old_r / r\n        let next_r: i64 = old_r - q * r\n        old_r = r\n        r = next_r\n        let next_s: i64 = old_s - q * s\n        old_s = s\n        s = next_s\n    }\n    let mut inv: i64 = old_s % m\n    if inv < 0 {\n        inv = inv + m\n    }\n    return inv\n}\n\nfunction __flow_range_count(start: i64, limit: i64, stride: i64) -> i64 {\n    if stride == 0 {\n        return 0\n    }\n    if stride > 0 {\n        if start >= limit {\n            return 0\n        }\n        return (limit - start + stride - 1) / stride\n    }\n    let up: i64 = 0 - stride\n    if start <= limit {\n        return 0\n    }\n    return (start - limit + up - 1) / up\n}\n\nfunction __flow_progression_sum(first: i64, count: i64, stride: i64) -> i64 {\n    if count <= 0 {\n        return 0\n    }\n    let endpoints: i64 = 2 * first + (count - 1) * stride\n    if count % 2 == 0 {\n        return (count / 2) * endpoints\n    }\n    return count * (endpoints / 2)\n}\n\nfunction __flow_sum_range_isect(sa: i32, ea: i32, pa: i32, sb: i32, eb: i32, pb: i32) -> i32 {\n    let count_a: i64 = __flow_range_count(sa as i64, ea as i64, pa as i64)\n    let count_b: i64 = __flow_range_count(sb as i64, eb as i64, pb as i64)\n    if count_a <= 0 {\n        return 0\n    }\n    if count_b <= 0 {\n        return 0\n    }\n\n    let mut first_a: i64 = sa as i64\n    let mut step_a: i64 = pa as i64\n    if step_a < 0 {\n        first_a = first_a + (count_a - 1) * step_a\n        step_a = 0 - step_a\n    }\n    let mut first_b: i64 = sb as i64\n    let mut step_b: i64 = pb as i64\n    if step_b < 0 {\n        first_b = first_b + (count_b - 1) * step_b\n        step_b = 0 - step_b\n    }\n\n    let common: i64 = __flow_range_gcd(step_a, step_b)\n    let offset: i64 = first_b - first_a\n    if offset % common != 0 {\n        return 0\n    }\n\n    let modulus: i64 = step_b / common\n    let step: i64 = step_a * modulus\n    let mut index: i64 = 0\n    if modulus > 1 {\n        let inverse: i64 = __flow_range_modinv((step_a / common) % modulus, modulus)\n        let mut scaled: i64 = (offset / common) % modulus\n        if scaled < 0 {\n            scaled = scaled + modulus\n        }\n        index = (scaled * inverse) % modulus\n    }\n    let mut value: i64 = first_a + index * step_a\n\n    let mut low: i64 = first_a\n    if first_b > low {\n        low = first_b\n    }\n    let mut high: i64 = first_a + (count_a - 1) * step_a\n    let last_b: i64 = first_b + (count_b - 1) * step_b\n    if last_b < high {\n        high = last_b\n    }\n\n    if value < low {\n        let gap: i64 = low - value\n        value = value + ((gap + step - 1) / step) * step\n    }\n    if value > high {\n        return 0\n    }\n\n    let count: i64 = (high - value) / step + 1\n    return __flow_progression_sum(value, count, step) as i32\n}\n\nfunction __flow_sum_range_union(sa: i32, ea: i32, pa: i32, sb: i32, eb: i32, pb: i32) -> i32 {\n    let only_a: i32 = __flow_sum_range(sa, ea, pa)\n    let only_b: i32 = __flow_sum_range(sb, eb, pb)\n    let both: i32 = __flow_sum_range_isect(sa, ea, pa, sb, eb, pb)\n    return only_a + only_b - both\n}\n"

# 1 when `e` is an integer literal (or `-` over one) the Python parser can
# fold, with its value in out[0].
function literal_int(arena: AstArena, src: ptr<u8>, e: i32, out: ptr<i64>) -> bool {
    if e == AST_NONE {
        return false
    }
    let k: i32 = arena.nodes[e].kind
    if k == AST_UNARY and arena.nodes[e].ival == TOK_MINUS {
        if literal_int(arena, src, arena.nodes[e].a, out) {
            out[0] = 0 - out[0]
            return true
        }
        return false
    }
    if k != AST_INT {
        return false
    }
    let s: i32 = arena.nodes[e].name_start
    let en: i32 = arena.nodes[e].name_end
    # int("007", 0) is an error in Python: a decimal with a leading zero
    # is not foldable.
    if en - s > 1 and (src[s] as i32) == 48 {
        let c1: i32 = src[s + 1] as i32
        if c1 != 120 and c1 != 88 {
            let mut allz: bool = true
            let mut i: i32 = s
            while i < en {
                if (src[i] as i32) != 48 and (src[i] as i32) != 95 {
                    allz = false
                }
                i = i + 1
            }
            if not allz {
                return false
            }
        }
    }
    out[0] = arena.nodes[e].ival as i64
    return true
}

function arg_at(arena: AstArena, first: i32, n: i32) -> i32 {
    let mut a: i32 = first
    let mut i: i32 = 0
    while i < n and a != AST_NONE {
        a = arena.nodes[a].next
        i = i + 1
    }
    return a
}

# How the Python parser lowers range-sum call `call` (AST_CALL `sum` with
# ival 2, 3 or 4): 0 not a range sum, 1 folded to a literal, 2 a call to
# __flow_sum_range, 3 a call to the union/intersection helper, -1 a literal
# range with step 0 (a syntax error).
export function range_sum_kind(arena: AstArena, src: ptr<u8>, call: i32) -> i32 {
    if arena.nodes[call].kind != AST_CALL {
        return 0
    }
    let form: i32 = arena.nodes[call].ival
    if form < 2 or form > 4 {
        return 0
    }
    let ns: i32 = arena.nodes[call].name_start
    let ne: i32 = arena.nodes[call].name_end
    if ne - ns != 3 or (src[ns] as i32) != 115 or (src[ns + 1] as i32) != 117 or (src[ns + 2] as i32) != 109 {
        return 0
    }
    let args: i32 = arena.nodes[call].a
    let mut nranges: i32 = 2
    if form == 2 {
        nranges = 1
    }
    let mut helper: i32 = 3
    if form == 2 {
        helper = 2
    }
    # Ranges fold left to right: the first one with a runtime bound makes
    # the whole sum a helper call; a literal range with step 0 before that
    # is an error.
    let v: ptr<i64> = calloc(1, 8) as ptr<i64>
    let mut r: i32 = 0
    while r < nranges {
        let a_ok: bool = literal_int(arena, src, arg_at(arena, args, r * 3), v)
        let b_ok: bool = literal_int(arena, src, arg_at(arena, args, r * 3 + 1), v)
        let s_ok: bool = literal_int(arena, src, arg_at(arena, args, r * 3 + 2), v)
        if not (a_ok and b_ok and s_ok) {
            return helper
        }
        if v[0] == 0 {
            return -1
        }
        r = r + 1
    }
    return 1
}

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
}

# The helpers a module needs: 0 none, 1 the sum helper, 2 the set helpers
# (which include it); -1 on a zero-step literal range.
export function range_helpers_in(arena: AstArena, src: ptr<u8>) -> i32 {
    let mut need: i32 = 0
    let mut i: i32 = 0
    while i < arena.len {
        let k: i32 = range_sum_kind(arena, src, i)
        if k == -1 {
            return -1
        }
        if k == 3 {
            need = 2
        } elif k == 2 and need == 0 {
            need = 1
        }
        i = i + 1
    }
    return need
}
