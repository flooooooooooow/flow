# @module tools.fir.graph
# @means  FIR-G, the columnar program graph behind `flow fir-g`: dense
#         function, block, op and value ids, a CSR call graph, and the CPU
#         analyses (effect propagation, reachability, purity) and the
#         optimisation candidates. Port of src/flow/fir_g.py,
#         fir_analysis.py and fir_opts.py; the propagation and reachability
#         loops are the ones in compiler/src/fir_analysis.flow.

import "tools/hostlib/text.flow"
import "compiler/src/fir_analysis.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

export const OP_CONST: i32 = 1
export const OP_PARAM: i32 = 2
export const OP_LOAD: i32 = 3
export const OP_STORE: i32 = 4
export const OP_BINOP: i32 = 5
export const OP_UNOP: i32 = 6
export const OP_CALL: i32 = 7
export const OP_RET: i32 = 8
export const OP_BR: i32 = 9
export const OP_COND_BR: i32 = 10
export const OP_ALLOCA: i32 = 12
export const OP_EFFECT: i32 = 15
export const OP_OTHER: i32 = 255

# op_aux operator codes for BINOP/UNOP (mapped from the token ids by the
# lowerer, so this file stays free of the front-end token enum).
export const AUX_ADD: i32 = 1
export const AUX_SUB: i32 = 2
export const AUX_MUL: i32 = 3
export const AUX_DIV: i32 = 4
export const AUX_MOD: i32 = 5
export const AUX_NEG: i32 = 6
export const AUX_PARAM_BASE: i32 = 1000

export const EFF_WRITES_MEMORY: i32 = 2
export const EFF_ALLOCATES: i32 = 4
export const EFF_IO: i32 = 8
export const EFF_FFI: i32 = 16
export const EFF_GPU: i32 = 256
export const EFF_UNKNOWN: i32 = 32768

# ── Growable i32 vector ─────────────────────────────────────────

export struct IVec {
    data: ptr<i32>,
    len: i32,
    cap: i32
}

export function iv_new() -> IVec {
    let cap: i32 = 16
    return IVec { data: malloc((cap * 4) as i64) as ptr<i32>, len: 0, cap: cap }
}

export function iv_push(v: ptr<IVec>, x: i32) {
    if v.len >= v.cap {
        v.cap = v.cap * 2
        v.data = realloc(v.data as ptr<void>, (v.cap as i64) * 4) as ptr<i32>
    }
    let d: ptr<i32> = v.data
    d[v.len] = x
    v.len = v.len + 1
}

export function iv_get(v: ptr<IVec>, i: i32) -> i32 {
    let d: ptr<i32> = v.data
    return d[i]
}

export function iv_set(v: ptr<IVec>, i: i32, x: i32) {
    let d: ptr<i32> = v.data
    d[i] = x
}

# ── String to id map (open addressing) ──────────────────────────

export struct SMap {
    keys: ptr<ptr<u8>>,
    vals: ptr<i32>,
    cap: i32,
    n: i32
}

export function sm_new() -> SMap {
    let cap: i32 = 64
    return SMap {
        keys: calloc(cap as i64, 8) as ptr<ptr<u8>>,
        vals: calloc(cap as i64, 4) as ptr<i32>,
        cap: cap,
        n: 0
    }
}

function sm_hash(s: string) -> i32 {
    let p: ptr<u8> = s as ptr<u8>
    let mut h: i32 = 5381
    let mut i: i32 = 0
    while p[i] != 0 {
        h = (h * 33 + (p[i] as i32)) & 1073741823
        i = i + 1
    }
    return h
}

function sm_slot(m: ptr<SMap>, s: string) -> i32 {
    let mut i: i32 = sm_hash(s) % m.cap
    let ks: ptr<ptr<u8>> = m.keys
    while ks[i] != null {
        if t_eq(ks[i] as string, s) {
            return i
        }
        i = (i + 1) % m.cap
    }
    return i
}

# Value for `s`, or -1.
export function sm_get(m: ptr<SMap>, s: string) -> i32 {
    let i: i32 = sm_slot(m, s)
    let ks: ptr<ptr<u8>> = m.keys
    if ks[i] == null {
        return -1
    }
    let vs: ptr<i32> = m.vals
    return vs[i]
}

export function sm_put(m: ptr<SMap>, s: string, v: i32) {
    if (m.n + 1) * 2 > m.cap {
        let oldk: ptr<ptr<u8>> = m.keys
        let oldv: ptr<i32> = m.vals
        let oldc: i32 = m.cap
        m.cap = oldc * 2
        m.keys = calloc(m.cap as i64, 8) as ptr<ptr<u8>>
        m.vals = calloc(m.cap as i64, 4) as ptr<i32>
        m.n = 0
        let mut j: i32 = 0
        while j < oldc {
            if oldk[j] != null {
                sm_put(m, oldk[j] as string, oldv[j])
            }
            j = j + 1
        }
    }
    let i: i32 = sm_slot(m, s)
    let ks: ptr<ptr<u8>> = m.keys
    let vs: ptr<i32> = m.vals
    if ks[i] == null {
        ks[i] = s as ptr<u8>
        m.n = m.n + 1
    }
    vs[i] = v
}

# ── The graph ───────────────────────────────────────────────────

export struct FirG {
    func_name: TList,
    func_first_block: IVec,
    func_block_count: IVec,
    func_effect_bits: IVec,
    func_is_extern: IVec,
    block_function: IVec,
    block_first_op: IVec,
    block_op_count: IVec,
    op_opcode: IVec,
    op_function: IVec,
    op_block: IVec,
    op_result_begin: IVec,
    op_callee: IVec,
    op_operand_count: IVec,
    op_edge_begin: IVec,
    op_edge_count: IVec,
    op_operands: IVec,
    op_target0: IVec,
    op_target1: IVec,
    op_aux: IVec,
    op_const: IVec,
    const_pool: TList,
    num_operands: i32,
    num_values: i32,
    type_name: TList,
    func_by_name: SMap,
    type_by_name: SMap,
    call_row_offsets: IVec,
    call_columns: IVec,
    call_edge_sites: IVec
}

export function fg_new() -> ptr<FirG> {
    let g: ptr<FirG> = calloc(1, 1024) as ptr<FirG>
    g.func_name = tl_new()
    g.func_first_block = iv_new()
    g.func_block_count = iv_new()
    g.func_effect_bits = iv_new()
    g.func_is_extern = iv_new()
    g.block_function = iv_new()
    g.block_first_op = iv_new()
    g.block_op_count = iv_new()
    g.op_opcode = iv_new()
    g.op_function = iv_new()
    g.op_block = iv_new()
    g.op_result_begin = iv_new()
    g.op_callee = iv_new()
    g.op_operand_count = iv_new()
    g.op_edge_begin = iv_new()
    g.op_edge_count = iv_new()
    g.op_operands = iv_new()
    g.op_target0 = iv_new()
    g.op_target1 = iv_new()
    g.op_aux = iv_new()
    g.op_const = iv_new()
    g.const_pool = tl_new()
    g.num_operands = 0
    g.num_values = 0
    g.type_name = tl_new()
    g.func_by_name = sm_new()
    g.type_by_name = sm_new()
    g.call_row_offsets = iv_new()
    g.call_columns = iv_new()
    g.call_edge_sites = iv_new()
    return g
}

export function fg_num_funcs(g: ptr<FirG>) -> i32 {
    return g.func_name.len
}

export function fg_num_ops(g: ptr<FirG>) -> i32 {
    return g.op_opcode.len
}

export function fg_func_name(g: ptr<FirG>, f: i32) -> string {
    return tl_get(&g.func_name, f)
}

export function fg_intern_type(g: ptr<FirG>, name: string) -> i32 {
    let tid: i32 = sm_get(&g.type_by_name, name)
    if tid >= 0 {
        return tid
    }
    let nt: i32 = g.type_name.len
    tl_push(&g.type_name, name)
    sm_put(&g.type_by_name, name, nt)
    return nt
}

export function fg_add_function(g: ptr<FirG>, name: string, is_extern: bool, effect_bits: i32) -> i32 {
    let fid: i32 = g.func_name.len
    tl_push(&g.func_name, name)
    iv_push(&g.func_first_block, 0)
    iv_push(&g.func_block_count, 0)
    iv_push(&g.func_effect_bits, effect_bits)
    if is_extern {
        iv_push(&g.func_is_extern, 1)
    } else {
        iv_push(&g.func_is_extern, 0)
    }
    sm_put(&g.func_by_name, name, fid)
    return fid
}

export function fg_add_block(g: ptr<FirG>, fid: i32) -> i32 {
    let bid: i32 = g.block_function.len
    iv_push(&g.block_function, fid)
    iv_push(&g.block_first_op, g.op_opcode.len)
    iv_push(&g.block_op_count, 0)
    if iv_get(&g.func_block_count, fid) == 0 {
        iv_set(&g.func_first_block, fid, bid)
    }
    iv_set(&g.func_block_count, fid, iv_get(&g.func_block_count, fid) + 1)
    return bid
}

# Append an op with `n_operands` operand edges and `n_results` result
# values. Returns the op id; its first result value is fg_result(g, op).
export function fg_add_op(g: ptr<FirG>, opcode: i32, fid: i32, bid: i32, n_operands: i32, n_results: i32, callee: i32) -> i32 {
    let op: i32 = g.op_opcode.len
    g.num_operands = g.num_operands + n_operands
    iv_push(&g.op_operand_count, n_operands)
    iv_push(&g.op_result_begin, g.num_values)
    g.num_values = g.num_values + n_results
    iv_push(&g.op_edge_begin, g.op_operands.len)
    iv_push(&g.op_edge_count, 0)
    iv_push(&g.op_target0, -1)
    iv_push(&g.op_target1, -1)
    iv_push(&g.op_aux, 0)
    iv_push(&g.op_const, 0)
    iv_push(&g.op_opcode, opcode)
    iv_push(&g.op_function, fid)
    iv_push(&g.op_block, bid)
    iv_push(&g.op_callee, callee)
    if iv_get(&g.block_op_count, bid) == 0 {
        iv_set(&g.block_first_op, bid, op)
    }
    iv_set(&g.block_op_count, bid, iv_get(&g.block_op_count, bid) + 1)
    return op
}

export function fg_result(g: ptr<FirG>, op: i32) -> i32 {
    return iv_get(&g.op_result_begin, op)
}

# Real SSA operand edges. `op_operand_count` stays the declared arity for
# parity with the Python graph; edges are what passes match on.
export function fg_add_operand(g: ptr<FirG>, op: i32, v: i32) {
    iv_push(&g.op_operands, v)
    iv_set(&g.op_edge_count, op, iv_get(&g.op_edge_count, op) + 1)
}

export function fg_op_noperands(g: ptr<FirG>, op: i32) -> i32 {
    return iv_get(&g.op_edge_count, op)
}

# Explicit CFG successors for branch terminators. Operand edges remain SSA
# value edges, so block ids never get confused with values.
export function fg_set_branch_targets(g: ptr<FirG>, op: i32, target0: i32, target1: i32) {
    iv_set(&g.op_target0, op, target0)
    iv_set(&g.op_target1, op, target1)
}

export function fg_branch_target0(g: ptr<FirG>, op: i32) -> i32 {
    return iv_get(&g.op_target0, op)
}

export function fg_branch_target1(g: ptr<FirG>, op: i32) -> i32 {
    return iv_get(&g.op_target1, op)
}

export function fg_operand(g: ptr<FirG>, op: i32, i: i32) -> i32 {
    return iv_get(&g.op_operands, iv_get(&g.op_edge_begin, op) + i)
}

# Drop an op's operand edges in place (used by const_fold when it rewrites
# an op to a CONST). The flat entries stay but are unreferenced.
export function fg_op_clear_operands(g: ptr<FirG>, op: i32) {
    iv_set(&g.op_edge_count, op, 0)
}

# Operator token for BINOP/UNOP (TOK_*); 0 for other ops.
export function fg_op_set_aux(g: ptr<FirG>, op: i32, aux: i32) {
    iv_set(&g.op_aux, op, aux)
}

export function fg_op_aux(g: ptr<FirG>, op: i32) -> i32 {
    return iv_get(&g.op_aux, op)
}

# CONST literal text, interned in const_pool. op_const stores index + 1.
export function fg_op_set_const(g: ptr<FirG>, op: i32, text: string) {
    tl_push(&g.const_pool, text)
    iv_set(&g.op_const, op, g.const_pool.len)
}

export function fg_op_const_text(g: ptr<FirG>, op: i32) -> string {
    let i: i32 = iv_get(&g.op_const, op)
    if i == 0 {
        return ""
    }
    return tl_get(&g.const_pool, i - 1)
}

# The op that produced value `v`, or -1 (values are result_begin + slot;
# ops here produce at most one result).
export function fg_value_op(g: ptr<FirG>, v: i32) -> i32 {
    let mut op: i32 = 0
    let n: i32 = fg_num_ops(g)
    while op < n {
        if iv_get(&g.op_result_begin, op) <= v and v < iv_get(&g.op_result_begin, op) + fg_op_nresults(g, op) {
            return op
        }
        op = op + 1
    }
    return -1
}

export function fg_or_effect(g: ptr<FirG>, fid: i32, bits: i32) {
    iv_set(&g.func_effect_bits, fid, iv_get(&g.func_effect_bits, fid) | bits)
}

export function fg_build_call_graph_csr(g: ptr<FirG>) {
    let nf: i32 = fg_num_funcs(g)
    # Count edges per caller, then fill in op order.
    let counts: ptr<i32> = calloc((nf + 1) as i64, 4) as ptr<i32>
    let nops: i32 = fg_num_ops(g)
    let mut op: i32 = 0
    while op < nops {
        if iv_get(&g.op_opcode, op) == OP_CALL and iv_get(&g.op_callee, op) >= 0 {
            let caller: i32 = iv_get(&g.op_function, op)
            counts[caller] = counts[caller] + 1
        }
        op = op + 1
    }
    g.call_row_offsets = iv_new()
    iv_push(&g.call_row_offsets, 0)
    let mut f: i32 = 0
    let mut acc: i32 = 0
    while f < nf {
        acc = acc + counts[f]
        iv_push(&g.call_row_offsets, acc)
        f = f + 1
    }
    let fill: ptr<i32> = calloc((nf + 1) as i64, 4) as ptr<i32>
    let cols: ptr<i32> = calloc((acc + 1) as i64, 4) as ptr<i32>
    let sites: ptr<i32> = calloc((acc + 1) as i64, 4) as ptr<i32>
    op = 0
    while op < nops {
        if iv_get(&g.op_opcode, op) == OP_CALL and iv_get(&g.op_callee, op) >= 0 {
            let caller: i32 = iv_get(&g.op_function, op)
            let at: i32 = iv_get(&g.call_row_offsets, caller) + fill[caller]
            cols[at] = iv_get(&g.op_callee, op)
            sites[at] = op
            fill[caller] = fill[caller] + 1
        }
        op = op + 1
    }
    g.call_columns = IVec { data: cols, len: acc, cap: acc + 1 }
    g.call_edge_sites = IVec { data: sites, len: acc, cap: acc + 1 }
    free(counts as ptr<void>)
    free(fill as ptr<void>)
}

export function fg_num_edges(g: ptr<FirG>) -> i32 {
    return g.call_columns.len
}

export function fg_summary(g: ptr<FirG>) -> string {
    let mut tb: TBuf = tb_new()
    tb_puts(&tb, "FIR-G: funcs=")
    tb_put_int(&tb, fg_num_funcs(g))
    tb_puts(&tb, " blocks=")
    tb_put_int(&tb, g.block_function.len)
    tb_puts(&tb, " ops=")
    tb_put_int(&tb, fg_num_ops(g))
    tb_puts(&tb, " values=")
    tb_put_int(&tb, g.num_values)
    tb_puts(&tb, " operands=")
    tb_put_int(&tb, g.num_operands)
    tb_puts(&tb, " types=")
    tb_put_int(&tb, g.type_name.len)
    return tb.data as string
}

# ── Analyses ────────────────────────────────────────────────────

export function fg_propagate_effects(g: ptr<FirG>) {
    let _iters: i32 = flowc_propagate_effects(
        g.func_effect_bits.data,
        g.call_row_offsets.data,
        g.call_columns.data,
        fg_num_funcs(g),
        64
    )
}

# Reachability from `main` (or function 0 when there is no main). Returns a
# per-function 0/1 array.
export function fg_reachable(g: ptr<FirG>) -> ptr<i32> {
    let nf: i32 = fg_num_funcs(g)
    let visited: ptr<i32> = calloc((nf + 1) as i64, 4) as ptr<i32>
    let roots: ptr<i32> = calloc(1, 4) as ptr<i32>
    let mut nroots: i32 = 0
    let m: i32 = sm_get(&g.func_by_name, "main")
    if m >= 0 {
        roots[0] = m
        nroots = 1
    } elif nf > 0 {
        roots[0] = 0
        nroots = 1
    }
    let _n: i32 = flowc_reachable_functions(
        g.call_row_offsets.data,
        g.call_columns.data,
        roots,
        nroots,
        nf,
        visited
    )
    return visited
}

export function fg_is_pure(g: ptr<FirG>, f: i32) -> bool {
    return flowc_is_pure(iv_get(&g.func_effect_bits, f)) == 1
}

export function fg_num_call_ops(g: ptr<FirG>) -> i32 {
    return flowc_count_call_ops(g.op_opcode.data, fg_num_ops(g))
}

export function fg_func_op_count(g: ptr<FirG>, fid: i32) -> i32 {
    let first: i32 = iv_get(&g.func_first_block, fid)
    let nb: i32 = iv_get(&g.func_block_count, fid)
    let mut total: i32 = 0
    let mut b: i32 = first
    while b < first + nb {
        total = total + iv_get(&g.block_op_count, b)
        b = b + 1
    }
    return total
}

# ── Optimisation candidates (fir_opts.py) ───────────────────────

export const KIND_DEAD: i32 = 0
export const KIND_INLINE: i32 = 1

export struct Cand {
    kind: i32,
    target: string,
    score: f64,
    reason: string,
    caller: string,
    callsite_op: i32,
    callee_ops: i32,
    call_sites: i32
}

export struct CandList {
    items: ptr<Cand>,
    len: i32,
    cap: i32
}

function cl_push(l: ptr<CandList>, c: Cand) {
    if l.len >= l.cap {
        l.cap = l.cap * 2
        l.items = realloc(l.items as ptr<void>, (l.cap as i64) * 64) as ptr<Cand>
    }
    let it: ptr<Cand> = l.items
    it[l.len] = c
    l.len = l.len + 1
}

export function cl_get(l: ptr<CandList>, i: i32) -> Cand {
    let it: ptr<Cand> = l.items
    return it[i]
}

# Python's round(x, 4) for the scores here: nearest 1e-4, ties to even on
# the exact double, which is what printf's "%.4f" does.
extern {
    function snprintf(buf: ptr<u8>, n: i64, fmt: string, ...) -> i32
    function strtod(s: string, end: ptr<void>) -> f64
}

function round4(x: f64) -> f64 {
    let buf: ptr<u8> = malloc(64) as ptr<u8>
    let _n: i32 = snprintf(buf, 64, "%.4f", x)
    let v: f64 = strtod(buf as string, null)
    free(buf as ptr<void>)
    return v
}

function kind_name(k: i32) -> string {
    if k == KIND_DEAD {
        return "dead_elim"
    }
    return "inline"
}

function sort_op(c: Cand) -> i32 {
    # Python sorts on `callsite_op or -1`: None and op 0 both count as -1.
    if c.callsite_op <= 0 {
        return -1
    }
    return c.callsite_op
}

# a sorts before b under (-score, kind, target, callsite_op or -1).
function cand_before(a: Cand, b: Cand) -> bool {
    if a.score != b.score {
        return a.score > b.score
    }
    let c: i32 = strcmp_s(kind_name(a.kind), kind_name(b.kind))
    if c != 0 {
        return c < 0
    }
    let d: i32 = strcmp_s(a.target, b.target)
    if d != 0 {
        return d < 0
    }
    return sort_op(a) < sort_op(b)
}

extern {
    function strcmp(a: string, b: string) -> i32
}

export function strcmp_s(a: string, b: string) -> i32 {
    return strcmp(a, b)
}

export function discover_candidates(g: ptr<FirG>, live: ptr<i32>) -> CandList {
    let mut out: CandList = CandList { items: malloc(64 * 16) as ptr<Cand>, len: 0, cap: 16 }
    let nf: i32 = fg_num_funcs(g)
    let mut f: i32 = 0
    while f < nf {
        let name: string = fg_func_name(g, f)
        if live[f] == 0 and not t_eq(name, "main") {
            let ops: i32 = fg_func_op_count(g, f)
            cl_push(&out, Cand {
                kind: KIND_DEAD,
                target: name,
                score: 10.0 + (ops as f64),
                reason: "unreachable from roots",
                caller: "",
                callsite_op: -1,
                callee_ops: ops,
                call_sites: -1
            })
        }
        f = f + 1
    }
    # Call sites per callee, callees in order of their first call (Python
    # dict insertion order).
    let nops: i32 = fg_num_ops(g)
    let site_count: ptr<i32> = calloc((nf + 1) as i64, 4) as ptr<i32>
    let mut order: IVec = iv_new()
    let mut op: i32 = 0
    while op < nops {
        if iv_get(&g.op_opcode, op) == OP_CALL {
            let cal: i32 = iv_get(&g.op_callee, op)
            if cal >= 0 {
                if site_count[cal] == 0 {
                    iv_push(&order, cal)
                }
                site_count[cal] = site_count[cal] + 1
            }
        }
        op = op + 1
    }
    let mut oi: i32 = 0
    while oi < order.len {
        let cal: i32 = iv_get(&order, oi)
        oi = oi + 1
        if live[cal] == 0 {
            continue
        }
        if iv_get(&g.func_is_extern, cal) != 0 {
            continue
        }
        let ops: i32 = fg_func_op_count(g, cal)
        if ops <= 0 or ops > 16 {
            continue
        }
        let name: string = fg_func_name(g, cal)
        # purity_flags is a dict by name: a later function of the same name
        # decides it.
        let is_pure: bool = fg_is_pure(g, sm_get(&g.func_by_name, name))
        let n_sites: i32 = site_count[cal]
        let mut score: f64 = ((16 - ops + 1) as f64) / (n_sites as f64)
        if n_sites == 1 {
            score = score * 2.0
        }
        if is_pure {
            score = score * 1.5
        }
        score = round4(score)
        let mut tb: TBuf = tb_new()
        tb_puts(&tb, "callee_ops=")
        tb_put_int(&tb, ops)
        tb_puts(&tb, " sites=")
        tb_put_int(&tb, n_sites)
        if is_pure {
            tb_puts(&tb, " pure=True")
        } else {
            tb_puts(&tb, " pure=False")
        }
        let reason: string = tb.data as string
        op = 0
        while op < nops {
            if iv_get(&g.op_opcode, op) == OP_CALL and iv_get(&g.op_callee, op) == cal {
                cl_push(&out, Cand {
                    kind: KIND_INLINE,
                    target: name,
                    score: score,
                    reason: reason,
                    caller: fg_func_name(g, iv_get(&g.op_function, op)),
                    callsite_op: op,
                    callee_ops: ops,
                    call_sites: n_sites
                })
            }
            op = op + 1
        }
    }
    # Stable insertion sort (Python's sort is stable).
    let it: ptr<Cand> = out.items
    let mut i: i32 = 1
    while i < out.len {
        let cur: Cand = it[i]
        let mut j: i32 = i - 1
        while j >= 0 and cand_before(cur, it[j]) {
            it[j + 1] = it[j]
            j = j - 1
        }
        it[j + 1] = cur
        i = i + 1
    }
    return out
}

export function cand_kind_name(k: i32) -> string {
    return kind_name(k)
}

# ── Transforms ──────────────────────────────────────────────────

export struct FirCompact {
    g: ptr<FirG>,
    removed: TList
}

# Result count of op `op` in `g`, from the result_begin prefix sums.
function fg_op_nresults(g: ptr<FirG>, op: i32) -> i32 {
    let begin: i32 = iv_get(&g.op_result_begin, op)
    if op + 1 < fg_num_ops(g) {
        return iv_get(&g.op_result_begin, op + 1) - begin
    }
    return g.num_values - begin
}

struct FirDce {
    g: ptr<FirG>,
    removed_ops: i32
}

struct FirInline {
    g: ptr<FirG>,
    inlined: i32
}

# The first inliner is deliberately limited to a pure, single-block expression
# function.  Such a body has parameters, CONST/BINOP/UNOP nodes, and one RET.
# Rebuilding the graph keeps SSA ids dense and leaves branches, stores, and
# effects on the trusted non-inlined path.
function fg_inlineable_call(g: ptr<FirG>, call: i32) -> i32 {
    if iv_get(&g.op_opcode, call) != OP_CALL {
        return 0
    }
    let cal: i32 = iv_get(&g.op_callee, call)
    if cal < 0 or cal >= fg_num_funcs(g) or cal == iv_get(&g.op_function, call) {
        return 0
    }
    if iv_get(&g.func_is_extern, cal) != 0 or not fg_is_pure(g, cal) {
        return 0
    }
    if iv_get(&g.func_block_count, cal) != 1 {
        return 0
    }
    let bid: i32 = iv_get(&g.func_first_block, cal)
    let mut params: i32 = 0
    let mut returns: i32 = 0
    let mut ret_edges: i32 = 0
    let mut op: i32 = 0
    while op < fg_num_ops(g) {
        if iv_get(&g.op_block, op) == bid {
            let code: i32 = iv_get(&g.op_opcode, op)
            if code == OP_PARAM {
                params = params + 1
            } elif code == OP_RET {
                returns = returns + 1
                ret_edges = iv_get(&g.op_edge_count, op)
            } elif code == OP_LOAD {
                if iv_get(&g.op_aux, op) < AUX_PARAM_BASE {
                    return 0
                }
            } elif code != OP_CONST and code != OP_BINOP and code != OP_UNOP {
                return 0
            }
        }
        op = op + 1
    }
    if returns != 1 or ret_edges != 1 {
        return 0
    }
    if iv_get(&g.op_edge_count, call) != params {
        return 0
    }
    return 1
}

function fg_inline_copy_meta(src: ptr<FirG>, sop: i32, dst: ptr<FirG>, dop: i32) {
    iv_set(&dst.op_aux, dop, iv_get(&src.op_aux, sop))
    if iv_get(&src.op_const, sop) != 0 {
        fg_op_set_const(dst, dop, fg_op_const_text(src, sop))
    }
}

# Apply all safe trivial inline sites in one graph rebuild.  The callee body
# is copied at the call site and its return value replaces the CALL result.
export function fg_apply_inline(g: ptr<FirG>) -> FirInline {
    let ng: ptr<FirG> = fg_new()
    let nf: i32 = fg_num_funcs(g)
    let mut f: i32 = 0
    while f < nf {
        let _fid: i32 = fg_add_function(ng, fg_func_name(g, f), iv_get(&g.func_is_extern, f) != 0, iv_get(&g.func_effect_bits, f))
        f = f + 1
    }
    let mut b: i32 = 0
    while b < g.block_function.len {
        let _bid: i32 = fg_add_block(ng, iv_get(&g.block_function, b))
        b = b + 1
    }
    let mut t: i32 = 0
    while t < g.type_name.len {
        let _tid: i32 = fg_intern_type(ng, tl_get(&g.type_name, t))
        t = t + 1
    }
    let vmap: ptr<i32> = calloc((g.num_values + 1) as i64, 4) as ptr<i32>
    let mut inlined: i32 = 0
    let mut op: i32 = 0
    while op < fg_num_ops(g) {
        let code: i32 = iv_get(&g.op_opcode, op)
        if code == OP_CALL and fg_inlineable_call(g, op) == 1 {
            let cal: i32 = iv_get(&g.op_callee, op)
            let cbid: i32 = iv_get(&g.func_first_block, cal)
            let local: ptr<i32> = calloc((g.num_values + 1) as i64, 4) as ptr<i32>
            let mut param: i32 = 0
            let mut cop: i32 = 0
            while cop < fg_num_ops(g) {
                if iv_get(&g.op_block, cop) == cbid {
                    let ccode: i32 = iv_get(&g.op_opcode, cop)
                    if ccode == OP_PARAM {
                        let arg: i32 = fg_operand(g, op, param)
                        local[fg_result(g, cop)] = vmap[arg] + 0
                        param = param + 1
                    } elif ccode == OP_LOAD and iv_get(&g.op_aux, cop) >= AUX_PARAM_BASE {
                        let pi: i32 = iv_get(&g.op_aux, cop) - AUX_PARAM_BASE
                        if pi < 0 or pi >= iv_get(&g.op_edge_count, op) {
                            local[fg_result(g, cop)] = 0
                        } else {
                            local[fg_result(g, cop)] = vmap[fg_operand(g, op, pi)]
                        }
                    }
                }
                cop = cop + 1
            }
            let returned: ptr<i32> = calloc(1, 4) as ptr<i32>
            cop = 0
            while cop < fg_num_ops(g) {
                if iv_get(&g.op_block, cop) == cbid {
                    let ccode: i32 = iv_get(&g.op_opcode, cop)
                    if ccode == OP_RET {
                        returned[0] = local[fg_operand(g, cop, 0)]
                    } elif ccode != OP_PARAM and not (ccode == OP_LOAD and iv_get(&g.op_aux, cop) >= AUX_PARAM_BASE) {
                        let nres: i32 = fg_op_nresults(g, cop)
                        let ne: i32 = iv_get(&g.op_edge_count, cop)
                        let nop: i32 = fg_add_op(ng, ccode, iv_get(&g.op_function, op), iv_get(&g.op_block, op), iv_get(&g.op_operand_count, cop), nres, -1)
                        fg_set_branch_targets(ng, nop, fg_branch_target0(g, cop), fg_branch_target1(g, cop))
                        fg_inline_copy_meta(g, cop, ng, nop)
                        let mut e: i32 = 0
                        while e < ne {
                            let oldv: i32 = fg_operand(g, cop, e)
                            let mapped: i32 = local[oldv] - 1
                            if mapped < 0 {
                                # The precondition above excludes malformed
                                # bodies. Keep a harmless load if one appears.
                                fg_add_operand(ng, nop, 0)
                            } else {
                                fg_add_operand(ng, nop, mapped)
                            }
                            e = e + 1
                        }
                        if nres > 0 {
                            local[fg_result(g, cop)] = fg_result(ng, nop) + 1
                        }
                    }
                }
                cop = cop + 1
            }
            let retv: i32 = returned[0] - 1
            if retv >= 0 {
                vmap[fg_result(g, op)] = retv + 1
                inlined = inlined + 1
            }
            free(returned as ptr<void>)
            free(local as ptr<void>)
        } else {
            let nres: i32 = fg_op_nresults(g, op)
            let ne: i32 = iv_get(&g.op_edge_count, op)
            let nop: i32 = fg_add_op(ng, code, iv_get(&g.op_function, op), iv_get(&g.op_block, op), iv_get(&g.op_operand_count, op), nres, iv_get(&g.op_callee, op))
            fg_set_branch_targets(ng, nop, fg_branch_target0(g, op), fg_branch_target1(g, op))
            fg_inline_copy_meta(g, op, ng, nop)
            let mut e: i32 = 0
            while e < ne {
                let mapped: i32 = vmap[fg_operand(g, op, e)] - 1
                if mapped >= 0 {
                    fg_add_operand(ng, nop, mapped)
                } else {
                    fg_add_operand(ng, nop, 0)
                }
                e = e + 1
            }
            if nres > 0 {
                vmap[fg_result(g, op)] = fg_result(ng, nop) + 1
            }
        }
        op = op + 1
    }
    fg_build_call_graph_csr(ng)
    free(vmap as ptr<void>)
    return FirInline { g: ng, inlined: inlined }
}

# Rebuild `g` keeping only the functions marked in `keep` (1/0 per function
# id) and, when `keep_op` is non-null, only the ops it marks. Order is
# preserved. Function ids, block ids, op ids and value ids are renumbered
# densely; call targets and operand edges are remapped and the CSR call
# graph is rebuilt. Returns the new graph and the dropped function names.
export function fg_compact2(g: ptr<FirG>, keep: ptr<i32>, keep_op: ptr<i32>) -> FirCompact {
    let nf: i32 = fg_num_funcs(g)
    let remap: ptr<i32> = calloc((nf + 1) as i64, 4)
    let ng: ptr<FirG> = fg_new()
    let mut out: FirCompact = FirCompact { g: ng, removed: tl_new() }
    # Pass 1: kept functions in order, so op_callee remaps resolve even for
    # forward references.
    let mut f: i32 = 0
    while f < nf {
        if keep[f] != 0 {
            remap[f] = fg_add_function(ng, fg_func_name(g, f), iv_get(&g.func_is_extern, f) != 0, iv_get(&g.func_effect_bits, f)) + 1
        } else {
            tl_push(&out.removed, fg_func_name(g, f))
        }
        f = f + 1
    }
    # Pass 2: blocks. A function's blocks are contiguous in the block table,
    # but a block's ops are not contiguous in the op table (the lowerer
    # interleaves nested control flow), so ops are bucketed by op_block.
    let nb_total: i32 = g.block_function.len
    let bremap: ptr<i32> = calloc((nb_total + 1) as i64, 4)
    f = 0
    while f < nf {
        if keep[f] != 0 {
            let nfid: i32 = remap[f] - 1
            let first_b: i32 = iv_get(&g.func_first_block, f)
            let nb: i32 = iv_get(&g.func_block_count, f)
            let mut b: i32 = 0
            while b < nb {
                bremap[first_b + b] = fg_add_block(ng, nfid) + 1
                b = b + 1
            }
        }
        f = f + 1
    }
    # Pass 3: ops in global order, keeping each block's op order. Operand
    # edges are remapped through vmap (old value id + 1 -> new value id);
    # producers are always emitted before their consumers, so every operand
    # of a kept op already has a new id.
    let vmap: ptr<i32> = calloc((g.num_values + 1) as i64, 4)
    let mut op: i32 = 0
    let nops: i32 = fg_num_ops(g)
    while op < nops {
        let of: i32 = iv_get(&g.op_function, op)
        if of >= 0 and of < nf and keep[of] != 0 and (keep_op == null or keep_op[op] != 0) {
            let mut cal: i32 = iv_get(&g.op_callee, op)
            if cal >= 0 {
                cal = remap[cal] - 1
            }
            let nop: i32 = fg_add_op(ng, iv_get(&g.op_opcode, op), remap[of] - 1, bremap[iv_get(&g.op_block, op)] - 1, iv_get(&g.op_operand_count, op), fg_op_nresults(g, op), cal)
            let t0: i32 = fg_branch_target0(g, op)
            let t1: i32 = fg_branch_target1(g, op)
            let mut nt0: i32 = -1
            let mut nt1: i32 = -1
            if t0 >= 0 { nt0 = bremap[t0] - 1 }
            if t1 >= 0 { nt1 = bremap[t1] - 1 }
            fg_set_branch_targets(ng, nop, nt0, nt1)
            iv_set(&ng.op_aux, nop, iv_get(&g.op_aux, op))
            if iv_get(&g.op_const, op) != 0 {
                fg_op_set_const(ng, nop, fg_op_const_text(g, op))
            }
            let mut e: i32 = 0
            while e < iv_get(&g.op_edge_count, op) {
                let nv: i32 = vmap[fg_operand(g, op, e)] - 1
                if nv >= 0 {
                    fg_add_operand(ng, nop, nv)
                }
                e = e + 1
            }
            let mut r: i32 = 0
            while r < fg_op_nresults(g, op) {
                vmap[fg_result(g, op) + r] = fg_result(ng, nop) + r + 1
                r = r + 1
            }
        }
        op = op + 1
    }
    free(vmap as ptr<void>)
    # The type table is names only; copy it so interned names survive.
    let mut t: i32 = 0
    while t < g.type_name.len {
        let _tid: i32 = fg_intern_type(ng, tl_get(&g.type_name, t))
        t = t + 1
    }
    fg_build_call_graph_csr(ng)
    free(remap as ptr<void>)
    free(bremap as ptr<void>)
    return out
}

# Dead-function elimination: drop every function unreachable from the roots
# (`main`, or function 0 when there is no main). Returns the compacted graph
# and the removed names; the input graph is left untouched.
export function fg_apply_dead_elim(g: ptr<FirG>) -> FirCompact {
    let live: ptr<i32> = fg_reachable(g)
    let out: FirCompact = fg_compact2(g, live, null)
    free(live as ptr<void>)
    return out
}

# A result op with no side effects: safe to drop when its value is unused.
function fg_pure_op(code: i32) -> bool {
    return code == OP_CONST or code == OP_BINOP or code == OP_UNOP
}

# Dead-op elimination: drop pure result ops (CONST, BINOP, UNOP) whose
# values are never used as an operand, iterating until nothing else drops.
# CONSTs stranded by const_fold die here too.
export function fg_apply_dce(g: ptr<FirG>) -> FirDce {
    let nf: i32 = fg_num_funcs(g)
    let keep_f: ptr<i32> = calloc((nf + 1) as i64, 4)
    let mut i: i32 = 0
    while i < nf {
        keep_f[i] = 1
        i = i + 1
    }
    let mut cur: ptr<FirG> = g
    let mut total: i32 = 0
    let mut again: bool = true
    while again {
        again = false
        let used: ptr<i32> = calloc((cur.num_values + 1) as i64, 4)
        let keep: ptr<i32> = calloc((fg_num_ops(cur) + 1) as i64, 4)
        let mut op: i32 = 0
        let n: i32 = fg_num_ops(cur)
        while op < n {
            keep[op] = 1
            let mut e: i32 = 0
            while e < iv_get(&cur.op_edge_count, op) {
                used[fg_operand(cur, op, e)] = 1
                e = e + 1
            }
            op = op + 1
        }
        op = 0
        while op < n {
            if fg_pure_op(iv_get(&cur.op_opcode, op)) and fg_op_nresults(cur, op) > 0 and used[fg_result(cur, op)] == 0 {
                keep[op] = 0
                again = true
                total = total + 1
            }
            op = op + 1
        }
        if again {
            let comp: FirCompact = fg_compact2(cur, keep_f, keep)
            cur = comp.g
        }
        free(used as ptr<void>)
        free(keep as ptr<void>)
    }
    free(keep_f as ptr<void>)
    return FirDce { g: cur, removed_ops: total }
}

# Parse `text` as a decimal or boolean literal. Returns the value, with
# `ok` set to false for anything else (floats, hex, suffixed ints, names).
function fg_const_int(text: string, ok: ptr<bool>) -> i64 {
    ok[0] = false
    if t_eq(text, "true") {
        ok[0] = true
        return 1
    }
    if t_eq(text, "false") {
        ok[0] = true
        return 0
    }
    let n: i32 = t_len(text)
    let mut i: i32 = 0
    if n > 0 and t_at(text, 0) == 45 {
        i = 1
    }
    if i >= n {
        return 0
    }
    let mut v: i64 = 0
    while i < n {
        if not t_is_digit(t_at(text, i)) {
            return 0
        }
        v = v * 10 + ((t_at(text, i) - 48) as i64)
        i = i + 1
    }
    ok[0] = true
    if t_at(text, 0) == 45 {
        return 0 - v
    }
    return v
}

# Constant folding: rewrite BINOP/UNOP ops whose operands are all CONST
# integer or boolean literals to a CONST holding the folded value, in
# place. Returns the number of ops folded.
export function fg_apply_const_fold(g: ptr<FirG>) -> i32 {
    # value id -> producing op + 1
    let v2op: ptr<i32> = calloc((g.num_values + 1) as i64, 4)
    let nops: i32 = fg_num_ops(g)
    let mut op: i32 = 0
    while op < nops {
        let mut r: i32 = 0
        while r < fg_op_nresults(g, op) {
            v2op[fg_result(g, op) + r] = op + 1
            r = r + 1
        }
        op = op + 1
    }
    let mut folded: i32 = 0
    op = 0
    while op < nops {
        let code: i32 = iv_get(&g.op_opcode, op)
        let aux: i32 = iv_get(&g.op_aux, op)
        let ne: i32 = iv_get(&g.op_edge_count, op)
        let mut res: i64 = 0
        let mut ok: bool = false
        if code == OP_BINOP and ne == 2 and aux >= AUX_ADD and aux <= AUX_MOD {
            let o1: i32 = v2op[fg_operand(g, op, 0)] - 1
            let o2: i32 = v2op[fg_operand(g, op, 1)] - 1
            if o1 >= 0 and o2 >= 0 and iv_get(&g.op_opcode, o1) == OP_CONST and iv_get(&g.op_opcode, o2) == OP_CONST {
                let mut ok1: bool = false
                let mut ok2: bool = false
                let a: i64 = fg_const_int(fg_op_const_text(g, o1), &ok1)
                let b: i64 = fg_const_int(fg_op_const_text(g, o2), &ok2)
                if ok1 and ok2 {
                    ok = true
                    if aux == AUX_ADD {
                        res = a + b
                    } elif aux == AUX_SUB {
                        res = a - b
                    } elif aux == AUX_MUL {
                        res = a * b
                    } elif aux == AUX_DIV {
                        if b == 0 {
                            ok = false
                        } else {
                            res = a / b
                        }
                    } else {
                        if b == 0 {
                            ok = false
                        } else {
                            res = a % b
                        }
                    }
                }
            }
        } elif code == OP_UNOP and ne == 1 and aux == AUX_NEG {
            let o1: i32 = v2op[fg_operand(g, op, 0)] - 1
            if o1 >= 0 and iv_get(&g.op_opcode, o1) == OP_CONST {
                let mut ok1: bool = false
                let a: i64 = fg_const_int(fg_op_const_text(g, o1), &ok1)
                if ok1 {
                    ok = true
                    res = 0 - a
                }
            }
        }
        if ok {
            iv_set(&g.op_opcode, op, OP_CONST)
            iv_set(&g.op_aux, op, 0)
            fg_op_clear_operands(g, op)
            fg_op_set_const(g, op, t_int(res as i32))
            folded = folded + 1
        }
        op = op + 1
    }
    free(v2op as ptr<void>)
    return folded
}
