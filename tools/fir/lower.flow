# @module tools.fir.lower
# @means  Program to FIR-G: load the entry module and its imports in the
#         Python resolver's order (depth first, dependencies before the
#         importing module), parse each with the flowc front end, and lower
#         every function into blocks and ops the way src/flow/fir_graphify.py
#         lowered the Python AST. Where the two front ends shape a construct
#         differently (elif chains, method calls, string interpolation,
#         `dbg`), the lowering follows the Python shape so the graph, and so
#         every count and op id in the report, stays the same.

import "tools/hostlib/text.flow"
import "tools/fir/graph.flow"
import "tools/fir/mono.flow"
import "tools/fir/ranges.flow"
import "compiler/src/ast.flow"
import "compiler/src/token.flow"
import "compiler/src/parser.flow"
import "compiler/src/resolve.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function calloc(n: i64, size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
    function memcpy(dst: ptr<void>, src: ptr<void>, n: i64) -> ptr<void>
    function access(path: string, mode: i32) -> i32
    function getcwd(buf: ptr<u8>, size: i64) -> ptr<u8>
    function opendir(path: string) -> ptr<void>
    function closedir(d: ptr<void>) -> i32
}

# ── Paths ───────────────────────────────────────────────────────

export function path_exists(path: string) -> bool {
    return access(path, 0) == 0
}

export function path_is_dir(path: string) -> bool {
    let d: ptr<void> = opendir(path)
    if d == null {
        return false
    }
    closedir(d)
    return true
}

export function path_is_file(path: string) -> bool {
    return path_exists(path) and not path_is_dir(path)
}

# os.path.abspath: join with the working directory and normalise `.`,
# `..` and repeated slashes, without resolving symlinks.
export function path_real(path: string) -> string {
    let mut full: string = path
    if not t_starts_with(path, "/") {
        let buf: ptr<u8> = calloc(4097, 1) as ptr<u8>
        let _c: ptr<u8> = getcwd(buf, 4096)
        full = t_cat3(buf as string, "/", path)
    }
    let mut parts: TList = tl_new()
    let n: i32 = t_len(full)
    let mut s: i32 = 0
    let mut i: i32 = 0
    while i <= n {
        if i == n or t_at(full, i) == 47 {
            let seg: string = t_sub(full, s, i)
            if t_eq(seg, "..") {
                if parts.len > 0 {
                    parts.len = parts.len - 1
                }
            } elif t_len(seg) > 0 and not t_eq(seg, ".") {
                tl_push(&parts, seg)
            }
            s = i + 1
        }
        i = i + 1
    }
    let mut tb: TBuf = tb_new()
    if parts.len == 0 {
        return "/"
    }
    i = 0
    while i < parts.len {
        tb_putc(&tb, 47)
        tb_puts(&tb, tl_get(&parts, i))
        i = i + 1
    }
    return tb.data as string
}

export function path_dirname(path: string) -> string {
    let n: i32 = t_len(path)
    let mut i: i32 = n - 1
    while i >= 0 and t_at(path, i) != 47 {
        i = i - 1
    }
    if i < 0 {
        return "."
    }
    if i == 0 {
        return "/"
    }
    return t_sub(path, 0, i)
}

export function path_join(a: string, b: string) -> string {
    if t_len(a) == 0 {
        return b
    }
    if t_starts_with(b, "/") {
        return b
    }
    if t_ends_with(a, "/") {
        return t_cat(a, b)
    }
    return t_cat3(a, "/", b)
}

# ── Project config (flow.toml [paths] and [dependencies]) ───────

export struct Project {
    root: string,
    toml: string,
    has_toml: bool,
    stdlib: string,
    packages: string
}

function find_flow_toml(start_dir: string) -> string {
    let mut cur: string = path_real(start_dir)
    while true {
        let cand: string = path_join(cur, "flow.toml")
        if path_is_file(cand) {
            return cand
        }
        let parent: string = path_dirname(cur)
        if t_eq(parent, cur) {
            return ""
        }
        cur = parent
    }
    return ""
}

function toml_has_key(p: ptr<Project>, table: string, key: string) -> bool {
    if not p.has_toml {
        return false
    }
    let n: i32 = t_len(p.toml)
    return flowc_resolve_toml_declares(p.toml as ptr<u8>, n, table, key as ptr<u8>, 0, t_len(key)) == 1
}

function toml_str(p: ptr<Project>, table: string, key: string) -> string {
    if not p.has_toml {
        return ""
    }
    let out: ptr<u8> = calloc(4097, 1) as ptr<u8>
    let n: i32 = t_len(p.toml)
    let r: i32 = flowc_resolve_toml_string_value(p.toml as ptr<u8>, n, table, key as ptr<u8>, 0, t_len(key), out, 4096)
    if r < 0 {
        return ""
    }
    return out as string
}

export function project_load(entry: string, flow_root: string) -> Project {
    let tp: string = find_flow_toml(path_dirname(path_real(entry)))
    let mut p: Project = Project { root: flow_root, toml: "", has_toml: false, stdlib: "", packages: path_join(flow_root, "packages") }
    if t_len(tp) > 0 {
        p.root = path_dirname(tp)
        p.toml = t_read_file(tp)
        p.has_toml = true
    }
    let mut cand: string = path_join(p.root, "lib/stdlib")
    let sp: string = toml_str(&p, "paths", "stdlib")
    if t_len(sp) > 0 {
        cand = path_join(p.root, sp)
    }
    if path_is_dir(cand) {
        p.stdlib = cand
    } else {
        p.stdlib = path_join(flow_root, "lib/stdlib")
    }
    return p
}

# ── Modules and declarations ────────────────────────────────────

export struct Mod {
    path: string,
    src: ptr<u8>,
    nsrc: i32,
    arena: AstArena,
    root: i32
}

export const DECL_FN: i32 = 1
export const DECL_EXTERN_FN: i32 = 2
export const DECL_STRUCT: i32 = 3

# A declaration the graph can see. For a specialization of a generic
# function, node is the template and spec the request it came from.
export struct Decl {
    m: i32,
    node: i32,
    kind: i32,
    name: string,
    gpu: bool,
    generic: bool,
    spec: i32,
    nparams: i32,
    tparams: TList
}

export struct Loader {
    project: Project,
    mods: ptr<Mod>,
    nmods: i32,
    mods_cap: i32,
    loaded: TList,
    stack: TList,
    decls: ptr<Decl>,
    ndecls: i32,
    decls_cap: i32,
    err: string,
    mono: ptr<Mono>,
    fdecls: ptr<Decl>,
    nfdecls: i32
}

function ld_add_decl(ld: ptr<Loader>, d: Decl) {
    if ld.ndecls >= ld.decls_cap {
        ld.decls_cap = ld.decls_cap * 2
        ld.decls = realloc(ld.decls as ptr<void>, (ld.decls_cap as i64) * 96) as ptr<Decl>
    }
    let ds: ptr<Decl> = ld.decls
    ds[ld.ndecls] = d
    ld.ndecls = ld.ndecls + 1
}

export function ld_decl(ld: ptr<Loader>, i: i32) -> Decl {
    let ds: ptr<Decl> = ld.decls
    return ds[i]
}

export function ld_mod(ld: ptr<Loader>, i: i32) -> ptr<Mod> {
    let ms: ptr<Mod> = ld.mods
    return &ms[i]
}

function ld_add_mod(ld: ptr<Loader>, m: Mod) -> i32 {
    if ld.nmods >= ld.mods_cap {
        ld.mods_cap = ld.mods_cap * 2
        ld.mods = realloc(ld.mods as ptr<void>, (ld.mods_cap as i64) * 64) as ptr<Mod>
    }
    let ms: ptr<Mod> = ld.mods
    ms[ld.nmods] = m
    ld.nmods = ld.nmods + 1
    return ld.nmods - 1
}

function span_str(src: ptr<u8>, s: i32, e: i32) -> string {
    return t_span(src, s, e)
}

function node_name(m: ptr<Mod>, id: i32) -> string {
    return t_span(m.src, m.arena.nodes[id].name_start, m.arena.nodes[id].name_end)
}

# Python's module-path lookup: every prefix of `parts`, longest first,
# as root/p1/.../pk.flow.
function try_parts(root: string, parts: ptr<TList>, from: i32) -> string {
    let n: i32 = parts.len
    let mut k: i32 = n
    while k > from {
        let found: string = try_stems(root, parts, from, k)
        if t_len(found) > 0 {
            return found
        }
        k = k - 1
    }
    return ""
}

# _iter_flow_candidates: a claim-path segment `Nat/+` may live in its own
# file or in its domain's file `Nat.flow`; try every combination, the
# literal stem first.
function try_stems(base: string, parts: ptr<TList>, i: i32, k: i32) -> string {
    if i == k {
        let mut path: string = base
        if not t_ends_with(path, ".flow") {
            path = t_cat(path, ".flow")
        }
        if path_exists(path) {
            return path
        }
        return ""
    }
    let part: string = tl_get(parts, i)
    let r: string = try_stems(path_join(base, part), parts, i + 1, k)
    if t_len(r) > 0 {
        return r
    }
    let slash: i32 = t_find_char(part, 47)
    if slash > 0 {
        let domain: string = t_sub(part, 0, slash)
        if not t_eq(domain, part) {
            return try_stems(path_join(base, domain), parts, i + 1, k)
        }
    }
    return ""
}

function split_dots(s: string) -> TList {
    let mut l: TList = tl_new()
    let n: i32 = t_len(s)
    let mut start: i32 = 0
    let mut i: i32 = 0
    while i < n {
        if t_at(s, i) == 46 {
            tl_push(&l, t_sub(s, start, i))
            start = i + 1
        }
        i = i + 1
    }
    tl_push(&l, t_sub(s, start, n))
    return l
}

function resolve_import(ld: ptr<Loader>, m: ptr<Mod>, imp: i32) -> string {
    let form: i32 = m.arena.nodes[imp].ival
    let raw: string = node_name(m, imp)
    let base_dir: string = path_dirname(m.path)
    if form == 2 {
        # Legacy string import: "path" (quotes included in the span).
        let path: string = t_sub(raw, 1, t_len(raw) - 1)
        let mut file: string = path
        if not t_ends_with(file, ".flow") {
            file = t_cat(file, ".flow")
        }
        let mut c: string = path_join(base_dir, file)
        if path_exists(c) {
            return c
        }
        if t_starts_with(path, "stdlib/") {
            let mut st: string = t_from(path, 7)
            if not t_ends_with(st, ".flow") {
                st = t_cat(st, ".flow")
            }
            c = path_join(ld.project.stdlib, st)
            if path_exists(c) {
                return c
            }
        }
        c = path_join(ld.project.stdlib, file)
        if path_exists(c) {
            return c
        }
        c = path_join(ld.project.packages, file)
        if path_exists(c) {
            return c
        }
        c = path_join(ld.project.root, file)
        if path_exists(c) {
            return c
        }
        return ""
    }
    if t_starts_with(raw, ".") {
        let mut parts: TList = split_dots(t_from(raw, 1))
        return try_parts(base_dir, &parts, 0)
    }
    let mut parts: TList = split_dots(raw)
    let head: string = tl_get(&parts, 0)
    if t_eq(head, "std") {
        return try_parts(ld.project.stdlib, &parts, 1)
    }
    let pp: string = toml_str(&ld.project, "paths", head)
    if t_len(pp) > 0 {
        return try_parts(path_join(ld.project.root, pp), &parts, 1)
    }
    if toml_has_key(&ld.project, "dependencies", head) {
        let pkg: string = path_join(path_join(ld.project.root, "flow_packages"), head)
        let r: string = try_parts(path_join(pkg, "src"), &parts, 1)
        if t_len(r) > 0 {
            return r
        }
        return try_parts(pkg, &parts, 1)
    }
    if t_eq(head, "stdlib") {
        let r: string = try_parts(ld.project.stdlib, &parts, 1)
        if t_len(r) > 0 {
            return r
        }
    }
    let r2: string = try_parts(ld.project.stdlib, &parts, 0)
    if t_len(r2) > 0 {
        return r2
    }
    return try_parts(ld.project.root, &parts, 0)
}

# Attributes written before a top-level item: the `@name` and
# `@name(args)` words between the previous item and this one. Returns them
# as "name" / "name(a,b)" strings, as the Python parser records them.
function item_attributes(src: ptr<u8>, from: i32, upto: i32) -> TList {
    let mut attrs: TList = tl_new()
    let mut i: i32 = from
    while i < upto {
        let c: i32 = src[i] as i32
        if c == 35 {
            while i < upto and (src[i] as i32) != 10 {
                i = i + 1
            }
            continue
        }
        if c == 64 {
            i = i + 1
            let ns: i32 = i
            while i < upto and t_is_ident_char(src[i] as i32) {
                i = i + 1
            }
            let name: string = t_span(src, ns, i)
            let mut j: i32 = i
            while j < upto and ((src[j] as i32) == 32 or (src[j] as i32) == 9) {
                j = j + 1
            }
            if j < upto and (src[j] as i32) == 40 {
                # Arguments up to the matching ')', stripped and comma-joined.
                let mut tb: TBuf = tb_new()
                tb_puts(&tb, name)
                tb_putc(&tb, 40)
                let mut k: i32 = j + 1
                let mut first: bool = true
                let mut arg: TBuf = tb_new()
                while k < upto and (src[k] as i32) != 41 {
                    let ch: i32 = src[k] as i32
                    if ch == 44 {
                        if not first {
                            tb_putc(&tb, 44)
                        }
                        tb_puts(&tb, t_strip(arg.data as string))
                        first = false
                        arg = tb_new()
                    } elif ch != 34 {
                        tb_putc(&arg, ch)
                    }
                    k = k + 1
                }
                let last: string = t_strip(arg.data as string)
                if t_len(last) > 0 or not first {
                    if not first {
                        tb_putc(&tb, 44)
                    }
                    tb_puts(&tb, last)
                }
                tb_putc(&tb, 41)
                tl_push(&attrs, tb.data as string)
                i = k + 1
            } else {
                tl_push(&attrs, name)
            }
            continue
        }
        if c == 32 or c == 9 or c == 10 or c == 13 or c == 59 {
            i = i + 1
            continue
        }
        # Any other word (`export`, a module header) ends the run only when
        # it is not followed by more attributes; keep what came right before.
        if t_is_ident_char(c) {
            let ws: i32 = i
            while i < upto and t_is_ident_char(src[i] as i32) {
                i = i + 1
            }
            let w: string = t_span(src, ws, i)
            if not t_eq(w, "export") {
                attrs = tl_new()
            }
            continue
        }
        attrs = tl_new()
        i = i + 1
    }
    return attrs
}

function attr_name(a: string) -> string {
    let p: i32 = t_find_char(a, 40)
    if p < 0 {
        return a
    }
    return t_sub(a, 0, p)
}

# transpiler._function_allowed for the fir-g modes {compile, c}.
function fn_allowed(attrs: ptr<TList>) -> bool {
    let mut has_guard: bool = false
    let mut ok: bool = false
    let mut i: i32 = 0
    while i < attrs.len {
        let a: string = tl_get(attrs, i)
        let name: string = attr_name(a)
        if t_eq(name, "only") or t_eq(name, "guard") {
            has_guard = true
            let p: i32 = t_find_char(a, 40)
            if p >= 0 {
                let inner: string = t_sub(a, p + 1, t_len(a) - 1)
                let mut parts: TList = tl_new()
                let n: i32 = t_len(inner)
                let mut s: i32 = 0
                let mut k: i32 = 0
                while k <= n {
                    if k == n or t_at(inner, k) == 44 {
                        let w: string = t_strip(t_sub(inner, s, k))
                        if t_eq(w, "compile") or t_eq(w, "c") {
                            ok = true
                        }
                        s = k + 1
                    }
                    k = k + 1
                }
            }
        } elif t_eq(name, "compile") or t_eq(name, "c") {
            has_guard = true
            ok = true
        } elif t_eq(name, "hot") or t_eq(name, "jit") or t_eq(name, "interp") or t_eq(name, "mlir") {
            has_guard = true
        }
        i = i + 1
    }
    if not has_guard {
        return true
    }
    return ok
}

function has_attr(attrs: ptr<TList>, name: string) -> bool {
    return tl_index(attrs, name) >= 0
}

function read_module(ld: ptr<Loader>, path: string) -> i32 {
    return parse_module(ld, path, t_read_file(path))
}

function parse_module(ld: ptr<Loader>, path: string, text: string) -> i32 {
    let n: i32 = t_len(text)
    let cap: i32 = n * 4 + 65536
    let buf: ptr<u8> = calloc((cap + 1) as i64, 1) as ptr<u8>
    memcpy(buf as ptr<void>, text as ptr<void>, n as i64)
    let mut m: i32 = flowc_expand_stages_in_place(buf, n, cap, 15)
    if m < 0 {
        ld.err = t_cat3("error: could not expand ", path, "")
        return -1
    }
    buf[m] = 0
    let mut p: Parser = flowc_parser_new(buf, m, m + 65536)
    let root: i32 = flowc_parse_program(&p)
    if root < 0 or p.err != 0 {
        let mut t: Token = p.cur
        if p.err != 0 {
            t = p.err_tok
        }
        let mut tb: TBuf = tb_new()
        tb_puts(&tb, "error: ")
        tb_puts(&tb, path)
        tb_puts(&tb, ":")
        tb_put_int(&tb, t.line)
        tb_puts(&tb, ":")
        tb_put_int(&tb, t.col)
        tb_puts(&tb, ": parse error")
        ld.err = tb.data as string
        return -1
    }
    return ld_add_mod(ld, Mod { path: path, src: buf, nsrc: m, arena: p.arena, root: root })
}

function unwrap_export(m: ptr<Mod>, item: i32) -> i32 {
    if m.arena.nodes[item].kind == AST_EXPORT and m.arena.nodes[item].ival == 0 {
        let inner: i32 = m.arena.nodes[item].a
        if inner != AST_NONE {
            return inner
        }
    }
    return item
}

function load_rec(ld: ptr<Loader>, path: string, is_root: bool) -> bool {
    if tl_index(&ld.stack, path) >= 0 {
        return true
    }
    if tl_index(&ld.loaded, path) >= 0 {
        return true
    }
    tl_push(&ld.stack, path)
    let mi: i32 = read_module(ld, path)
    if mi < 0 {
        return false
    }
    # Imports first, in source order.
    let m0: ptr<Mod> = ld_mod(ld, mi)
    let mut item: i32 = m0.arena.nodes[m0.root].a
    while item != AST_NONE {
        let m: ptr<Mod> = ld_mod(ld, mi)
        let it: i32 = unwrap_export(m, item)
        if m.arena.nodes[it].kind == AST_IMPORT {
            let dep: string = resolve_import(ld, m, it)
            if t_len(dep) == 0 {
                ld.err = t_cat3("error: could not resolve import '", node_name(m, it), "'")
                return false
            }
            if not load_rec(ld, path_real(dep), false) {
                return false
            }
        }
        let m1: ptr<Mod> = ld_mod(ld, mi)
        item = m1.arena.nodes[item].next
    }
    # Then the declarations.
    let m: ptr<Mod> = ld_mod(ld, mi)
    let mut prev_end: i32 = 0
    item = m.arena.nodes[m.root].a
    while item != AST_NONE {
        let it: i32 = unwrap_export(m, item)
        let k: i32 = m.arena.nodes[it].kind
        if k == AST_FN {
            let name: string = node_name(m, it)
            let mut attrs: TList = item_attributes(m.src, prev_end, m.arena.nodes[item].start)
            let skip_main: bool = t_eq(name, "main") and not is_root
            if not skip_main and fn_allowed(&attrs) {
                let generic: bool = m.arena.nodes[it].ival > 0
                let mut tps: TList = tl_new()
                if generic {
                    tps = type_params_at(m.src, m.arena.nodes[it].name_end, m.nsrc)
                }
                ld_add_decl(ld, Decl { m: mi, node: it, kind: DECL_FN, name: name, gpu: has_attr(&attrs, "gpu"), generic: generic, spec: -1, nparams: tps.len, tparams: tps })
            }
        } elif k == AST_STRUCT {
            let mut np: i32 = 0
            let mut tp: i32 = m.arena.nodes[it].b
            while tp != AST_NONE {
                np = np + 1
                tp = m.arena.nodes[tp].next
            }
            ld_add_decl(ld, Decl { m: mi, node: it, kind: DECL_STRUCT, name: node_name(m, it), gpu: false, generic: np > 0, spec: -1, nparams: np, tparams: tl_new() })
        } elif k == AST_EXTERN {
            let mut f: i32 = m.arena.nodes[it].a
            while f != AST_NONE {
                if m.arena.nodes[f].kind == AST_FN {
                    let fname: string = node_name(m, f)
                    if not (t_eq(fname, "main") and not is_root) {
                        ld_add_decl(ld, Decl { m: mi, node: f, kind: DECL_EXTERN_FN, name: fname, gpu: false, generic: false, spec: -1, nparams: 0, tparams: tl_new() })
                    }
                }
                f = m.arena.nodes[f].next
            }
        }
        if m.arena.nodes[item].end > prev_end {
            prev_end = m.arena.nodes[item].end
        }
        item = m.arena.nodes[item].next
    }
    # A module that sums a runtime range carries the helper it calls
    # (range_sums.helper_declarations / set_helper_declarations).
    let need: i32 = range_helpers_needed(ld_mod(ld, mi))
    if need < 0 {
        ld.err = "error: sum(range) step must not be zero"
        return false
    }
    if need > 0 {
        let mut text: string = RANGE_SUM_HELPER
        if need == 2 {
            text = t_cat(RANGE_SUM_HELPER, RANGE_SET_HELPER)
        }
        let hm: i32 = parse_module(ld, t_cat(path, "#range-helpers"), text)
        if hm < 0 {
            return false
        }
        let hmod: ptr<Mod> = ld_mod(ld, hm)
        let mut h: i32 = hmod.arena.nodes[hmod.root].a
        while h != AST_NONE {
            if hmod.arena.nodes[h].kind == AST_FN {
                ld_add_decl(ld, Decl { m: hm, node: h, kind: DECL_FN, name: node_name(hmod, h), gpu: false, generic: false, spec: -1, nparams: 0, tparams: tl_new() })
            }
            h = hmod.arena.nodes[h].next
        }
    }
    tl_push(&ld.loaded, path)
    ld.stack.len = ld.stack.len - 1
    return true
}

export function load_program(entry: string, flow_root: string) -> ptr<Loader> {
    let ld: ptr<Loader> = calloc(1, 256) as ptr<Loader>
    ld.project = project_load(entry, flow_root)
    ld.mods_cap = 8
    ld.mods = calloc(8, 64) as ptr<Mod>
    ld.nmods = 0
    ld.loaded = tl_new()
    ld.stack = tl_new()
    ld.decls_cap = 64
    ld.decls = calloc(64, 96) as ptr<Decl>
    ld.ndecls = 0
    ld.err = ""
    ld.mono = mono_new()
    ld.fdecls = calloc(64, 96) as ptr<Decl>
    ld.nfdecls = 0
    if load_rec(ld, path_real(entry), true) {
        mono_run(ld)
    }
    return ld
}

# The type parameter names after a generic function's name: `<T, U: Bound>`.
function type_params_at(src: ptr<u8>, from: i32, n: i32) -> TList {
    let mut out: TList = tl_new()
    let mut i: i32 = from
    while i < n and ((src[i] as i32) == 32 or (src[i] as i32) == 9) {
        i = i + 1
    }
    if i >= n or (src[i] as i32) != 60 {
        return out
    }
    i = i + 1
    let mut depth: i32 = 1
    let mut after_colon: bool = false
    while i < n and depth > 0 {
        let c: i32 = src[i] as i32
        if c == 60 {
            depth = depth + 1
            i = i + 1
        } elif c == 62 {
            depth = depth - 1
            i = i + 1
        } elif c == 44 {
            after_colon = false
            i = i + 1
        } elif c == 58 {
            after_colon = true
            i = i + 1
        } elif t_is_ident_char(c) {
            let s: i32 = i
            while i < n and t_is_ident_char(src[i] as i32) {
                i = i + 1
            }
            if depth == 1 and not after_colon {
                tl_push(&out, t_span(src, s, i))
            }
        } else {
            i = i + 1
        }
    }
    return out
}

# ── Monomorphization over the loaded declarations ───────────────

function add_final(ld: ptr<Loader>, d: Decl) {
    let n: i32 = ld.nfdecls
    ld.fdecls = realloc(ld.fdecls as ptr<void>, ((n + 1) as i64) * 96) as ptr<Decl>
    let ds: ptr<Decl> = ld.fdecls
    ds[n] = d
    ld.nfdecls = n + 1
}

export function ld_fdecl(ld: ptr<Loader>, i: i32) -> Decl {
    let ds: ptr<Decl> = ld.fdecls
    return ds[i]
}

# The Python AST's name for a call: `f<A, B>(...)` is the parser-mangled
# `f_A_B`.
export function call_name(m: ptr<Mod>, call: i32) -> string {
    let name: string = node_name(m, call)
    if m.arena.nodes[call].kind != AST_CALL {
        return name
    }
    let rk: i32 = range_sum_kind(m.arena, m.src, call)
    if rk == 2 {
        return "__flow_sum_range"
    }
    if rk == 3 {
        if m.arena.nodes[call].ival == 3 {
            return "__flow_sum_range_union"
        }
        return "__flow_sum_range_isect"
    }
    let targs: i32 = m.arena.nodes[call].b
    if targs == AST_NONE {
        return name
    }
    let mut tb: TBuf = tb_new()
    tb_puts(&tb, name)
    let mut a: i32 = targs
    while a != AST_NONE {
        tb_putc(&tb, 95)
        let apt: ptr<PType> = pt_from_ast(m.arena, m.src, a)
        tb_puts(&tb, apt.name)
        a = m.arena.nodes[a].next
    }
    return tb.data as string
}

# monomorphize._expr_type for a call argument, or null.
function expr_ptype(m: ptr<Mod>, e: i32) -> ptr<PType> {
    let k: i32 = m.arena.nodes[e].kind
    if k == AST_INT {
        return pt_new("i32")
    }
    if k == AST_FLOAT {
        return pt_new("f32")
    }
    if k == AST_BOOL {
        return pt_new("bool")
    }
    if k == AST_STRING {
        if t_find(node_name(m, e), "${") >= 0 {
            return null
        }
        return pt_new("string")
    }
    if k == AST_IDENT and t_eq(node_name(m, e), "null") {
        let t: ptr<PType> = pt_new("ptr_void")
        t.is_ptr = true
        t.elem = pt_new("void")
        return t
    }
    if k == AST_STRUCT_LIT {
        return pt_new(node_name(m, e))
    }
    if k == AST_ARRAY_LIT {
        let first: i32 = m.arena.nodes[e].a
        if first != AST_NONE {
            let et: ptr<PType> = expr_ptype(m, first)
            if et != null {
                return pt_new(t_cat("array_", et.name))
            }
        }
        return null
    }
    if k == AST_CAST {
        return pt_from_ast(m.arena, m.src, m.arena.nodes[e].b)
    }
    return null
}

function is_method_call(m: ptr<Mod>, e: i32) -> bool {
    if m.arena.nodes[e].kind != AST_CALL {
        return false
    }
    return method_base(m, e) != AST_NONE
}

# _request_function_mono for one call.
function mono_scan_call(ld: ptr<Loader>, m: ptr<Mod>, call: i32, name: string) {
    let mo: ptr<Mono> = ld.mono
    let mut sargs: TMap = tm_new()
    let g: i32 = mono_match(mo, name, &sargs)
    if g < 0 {
        return
    }
    let tps: ptr<TList> = mono_gfn_tparams(mo, g)
    if tm_len(&sargs) > 0 {
        if tm_len(&sargs) == tps.len {
            let _r: i32 = mono_request(mo, g, sargs)
        }
        return
    }
    let args: i32 = m.arena.nodes[call].a
    if args == AST_NONE {
        return
    }
    # Zip the arguments with the template's parameters.
    let tdecl: Decl = ld_decl(ld, iv_get(&mo.gfn_decl, g))
    let tm: ptr<Mod> = ld_mod(ld, tdecl.m)
    let mut found: TMap = tm_new()
    let mut a: i32 = args
    let mut p: i32 = tm.arena.nodes[tdecl.node].a
    while a != AST_NONE and p != AST_NONE {
        let pt: ptr<PType> = pt_from_ast(tm.arena, tm.src, tm.arena.nodes[p].a)
        if tl_index(tps, pt.name) >= 0 and tm_get(&found, pt.name) == null {
            let conc: ptr<PType> = expr_ptype(m, a)
            if conc != null {
                tm_put(&found, pt.name, conc)
            }
        }
        a = m.arena.nodes[a].next
        p = tm.arena.nodes[p].next
    }
    if tm_len(&found) == tps.len {
        let mut ordered: TMap = tm_new()
        let mut i: i32 = 0
        while i < tps.len {
            tm_put(&ordered, tl_get(tps, i), tm_get(&found, tl_get(tps, i)))
            i = i + 1
        }
        let _r2: i32 = mono_request(mo, g, ordered)
    }
}

# _scan_expression.
function mono_scan_expr(ld: ptr<Loader>, m: ptr<Mod>, e: i32) {
    if e == AST_NONE {
        return
    }
    let k: i32 = m.arena.nodes[e].kind
    if k == AST_CALL {
        if is_method_call(m, e) or folded_sum(m, e) or pipe_stage_expr(m, e) {
            return
        }
        mono_scan_call(ld, m, e, call_name(m, e))
        let mut a: i32 = m.arena.nodes[e].a
        while a != AST_NONE {
            mono_scan_expr(ld, m, a)
            a = m.arena.nodes[a].next
        }
        return
    }
    if k == AST_UNARY {
        let op: i32 = m.arena.nodes[e].ival
        if op == KW_EXPECT {
            return
        }
        if op == KW_DBG {
            mono_scan_call(ld, m, e, "__flow_dbg")
        }
        mono_scan_expr(ld, m, m.arena.nodes[e].a)
        return
    }
    if k == AST_BINOP {
        mono_scan_expr(ld, m, m.arena.nodes[e].a)
        mono_scan_expr(ld, m, m.arena.nodes[e].b)
        return
    }
    if k == AST_STRUCT_LIT {
        let mut f: i32 = m.arena.nodes[e].a
        while f != AST_NONE {
            mono_scan_expr(ld, m, m.arena.nodes[f].a)
            f = m.arena.nodes[f].next
        }
        return
    }
    if k == AST_FIELD_ACCESS or k == AST_CAST {
        mono_scan_expr(ld, m, m.arena.nodes[e].a)
        return
    }
    if k == AST_INDEX {
        mono_scan_expr(ld, m, m.arena.nodes[e].a)
        mono_scan_expr(ld, m, m.arena.nodes[e].b)
        if m.arena.nodes[e].ival == 1 {
            mono_scan_expr(ld, m, m.arena.nodes[e].c)
        }
        return
    }
    if k == AST_ARRAY_LIT {
        let mut a: i32 = m.arena.nodes[e].a
        while a != AST_NONE {
            mono_scan_expr(ld, m, a)
            a = m.arena.nodes[a].next
        }
    }
}

# An expression statement the monomorphizer looks into: calls (not method
# calls), operators, field and index access, struct literals, casts,
# names and literals.
function listed_expr_stmt(m: ptr<Mod>, e: i32) -> bool {
    let k: i32 = m.arena.nodes[e].kind
    if k == AST_CALL {
        return not is_method_call(m, e) and not pipe_stage_expr(m, e)
    }
    if k == AST_UNARY {
        return m.arena.nodes[e].ival != KW_EXPECT
    }
    return k == AST_BINOP or k == AST_FIELD_ACCESS or k == AST_INDEX or k == AST_STRUCT_LIT or k == AST_CAST or k == AST_IDENT or k == AST_INT or k == AST_FLOAT or k == AST_STRING or k == AST_BOOL
}

function mono_scan_block(ld: ptr<Loader>, m: ptr<Mod>, block: i32) {
    if block == AST_NONE {
        return
    }
    let mut s: i32 = m.arena.nodes[block].a
    while s != AST_NONE {
        mono_scan_stmt(ld, m, s)
        s = m.arena.nodes[s].next
    }
}

function mono_scan_stmt(ld: ptr<Loader>, m: ptr<Mod>, s: i32) {
    let k: i32 = m.arena.nodes[s].kind
    if k == AST_LET {
        mono_scan_expr(ld, m, m.arena.nodes[s].b)
    } elif k == AST_RETURN {
        mono_scan_expr(ld, m, m.arena.nodes[s].a)
    } elif k == AST_ASSIGN {
        mono_scan_expr(ld, m, m.arena.nodes[s].b)
    } elif k == AST_IF {
        mono_scan_expr(ld, m, m.arena.nodes[s].a)
        mono_scan_block(ld, m, m.arena.nodes[s].b)
        let mut cur: i32 = s
        let mut nx: i32 = elif_child(m, cur)
        while nx != AST_NONE {
            mono_scan_expr(ld, m, m.arena.nodes[nx].a)
            mono_scan_block(ld, m, m.arena.nodes[nx].b)
            cur = nx
            nx = elif_child(m, cur)
        }
        mono_scan_block(ld, m, m.arena.nodes[cur].c)
    } elif k == AST_WHILE {
        mono_scan_expr(ld, m, m.arena.nodes[s].a)
        mono_scan_block(ld, m, m.arena.nodes[s].b)
    } elif k == AST_FOR {
        mono_scan_expr(ld, m, m.arena.nodes[s].a)
        mono_scan_expr(ld, m, m.arena.nodes[s].b)
        mono_scan_block(ld, m, m.arena.nodes[s].c)
    } elif k == AST_UNARY {
        if m.arena.nodes[s].ival == KW_EXPECT {
            mono_scan_expr(ld, m, m.arena.nodes[s].a)
        }
    } elif k == AST_EXPR_STMT {
        let e: i32 = m.arena.nodes[s].a
        if listed_expr_stmt(m, e) {
            mono_scan_expr(ld, m, e)
        }
    }
}

# _substitute_*: walk a template body in substitution order and make the
# requests its `_T`-suffixed calls ask for.
function mono_subst_expr(ld: ptr<Loader>, m: ptr<Mod>, e: i32, map: ptr<TMap>) {
    if e == AST_NONE {
        return
    }
    let k: i32 = m.arena.nodes[e].kind
    if k == AST_CALL {
        if is_method_call(m, e) or folded_sum(m, e) or pipe_stage_expr(m, e) {
            return
        }
        let mut a: i32 = m.arena.nodes[e].a
        while a != AST_NONE {
            mono_subst_expr(ld, m, a, map)
            a = m.arena.nodes[a].next
        }
        let _n: string = mono_rename_call(ld.mono, call_name(m, e), map, true)
        return
    }
    if k == AST_UNARY {
        let op: i32 = m.arena.nodes[e].ival
        if op == KW_EXPECT {
            return
        }
        mono_subst_expr(ld, m, m.arena.nodes[e].a, map)
        if op == KW_DBG {
            let _d: string = mono_rename_call(ld.mono, "__flow_dbg", map, true)
        }
        return
    }
    if k == AST_BINOP {
        mono_subst_expr(ld, m, m.arena.nodes[e].a, map)
        mono_subst_expr(ld, m, m.arena.nodes[e].b, map)
        return
    }
    if k == AST_STRUCT_LIT {
        let mut f: i32 = m.arena.nodes[e].a
        while f != AST_NONE {
            mono_subst_expr(ld, m, m.arena.nodes[f].a, map)
            f = m.arena.nodes[f].next
        }
        return
    }
    if k == AST_FIELD_ACCESS or k == AST_CAST {
        mono_subst_expr(ld, m, m.arena.nodes[e].a, map)
        return
    }
    if k == AST_INDEX {
        mono_subst_expr(ld, m, m.arena.nodes[e].a, map)
        mono_subst_expr(ld, m, m.arena.nodes[e].b, map)
        if m.arena.nodes[e].ival == 1 {
            mono_subst_expr(ld, m, m.arena.nodes[e].c, map)
        }
        return
    }
    if k == AST_ARRAY_LIT {
        let mut a: i32 = m.arena.nodes[e].a
        while a != AST_NONE {
            mono_subst_expr(ld, m, a, map)
            a = m.arena.nodes[a].next
        }
    }
}

function mono_subst_block(ld: ptr<Loader>, m: ptr<Mod>, block: i32, map: ptr<TMap>) {
    if block == AST_NONE {
        return
    }
    let mut s: i32 = m.arena.nodes[block].a
    while s != AST_NONE {
        mono_subst_stmt(ld, m, s, map)
        s = m.arena.nodes[s].next
    }
}

function mono_subst_stmt(ld: ptr<Loader>, m: ptr<Mod>, s: i32, map: ptr<TMap>) {
    let k: i32 = m.arena.nodes[s].kind
    if k == AST_LET {
        mono_subst_expr(ld, m, m.arena.nodes[s].b, map)
    } elif k == AST_RETURN {
        mono_subst_expr(ld, m, m.arena.nodes[s].a, map)
    } elif k == AST_ASSIGN {
        mono_subst_expr(ld, m, m.arena.nodes[s].b, map)
        mono_subst_expr(ld, m, m.arena.nodes[s].a, map)
    } elif k == AST_IF {
        mono_subst_expr(ld, m, m.arena.nodes[s].a, map)
        mono_subst_block(ld, m, m.arena.nodes[s].b, map)
        let mut cur: i32 = s
        let mut nx: i32 = elif_child(m, cur)
        while nx != AST_NONE {
            mono_subst_expr(ld, m, m.arena.nodes[nx].a, map)
            mono_subst_block(ld, m, m.arena.nodes[nx].b, map)
            cur = nx
            nx = elif_child(m, cur)
        }
        mono_subst_block(ld, m, m.arena.nodes[cur].c, map)
    } elif k == AST_WHILE {
        mono_subst_expr(ld, m, m.arena.nodes[s].a, map)
        mono_subst_block(ld, m, m.arena.nodes[s].b, map)
    } elif k == AST_FOR {
        mono_subst_expr(ld, m, m.arena.nodes[s].a, map)
        mono_subst_expr(ld, m, m.arena.nodes[s].b, map)
        if m.arena.nodes[s].ival > 0 {
            mono_subst_expr(ld, m, m.arena.nodes[s].ival, map)
        }
        mono_subst_block(ld, m, m.arena.nodes[s].c, map)
    } elif k == AST_UNARY {
        if m.arena.nodes[s].ival == KW_EXPECT {
            mono_subst_expr(ld, m, m.arena.nodes[s].a, map)
        }
    } elif k == AST_EXPR_STMT {
        let e: i32 = m.arena.nodes[s].a
        if listed_expr_stmt(m, e) {
            mono_subst_expr(ld, m, e, map)
        }
    }
}

# Monomorphizer.monomorphize, down to the function declarations fir-g
# lowers: specializations first (generation order), then every
# non-generic function in declaration order.
function mono_run(ld: ptr<Loader>) {
    let mo: ptr<Mono> = ld.mono
    let mut i: i32 = 0
    while i < ld.ndecls {
        let d: Decl = ld_decl(ld, i)
        if d.kind == DECL_STRUCT and d.generic {
            mono_add_gstruct(mo, d.name, d.nparams)
        } elif d.kind == DECL_FN and d.generic {
            mono_add_gfn(mo, d.name, i, d.tparams)
        } elif d.kind == DECL_FN or d.kind == DECL_EXTERN_FN {
            sm_put(&mo.concrete, d.name, 1)
        }
        i = i + 1
    }
    i = 0
    while i < ld.ndecls {
        let d: Decl = ld_decl(ld, i)
        if d.kind == DECL_FN and not d.generic {
            let m: ptr<Mod> = ld_mod(ld, d.m)
            mono_scan_block(ld, m, m.arena.nodes[d.node].c)
        }
        i = i + 1
    }
    # The LIFO worklist of _generate_specializations.
    let mut pending: IVec = iv_new()
    i = 0
    while i < mo.req_names.len {
        iv_push(&pending, i)
        i = i + 1
    }
    let mut done: SMap = sm_new()
    while pending.len > 0 {
        let r: i32 = iv_get(&pending, pending.len - 1)
        pending.len = pending.len - 1
        let mangled: string = tl_get(&mo.req_names, r)
        if sm_get(&done, mangled) >= 0 {
            continue
        }
        let before: i32 = mo.req_names.len
        if sm_get(&mo.concrete, mangled) >= 0 {
            sm_put(&done, mangled, 1)
            continue
        }
        let g: i32 = iv_get(&mo.req_gfn, r)
        let tdecl: Decl = ld_decl(ld, iv_get(&mo.gfn_decl, g))
        let tm: ptr<Mod> = ld_mod(ld, tdecl.m)
        # Copy the map: new requests may move the request table.
        let rm: ptr<TMap> = mono_req_map(mo, r)
        let mut rmap: TMap = TMap { names: rm.names, types: rm.types, cap: rm.cap }
        mono_subst_block(ld, tm, tm.arena.nodes[tdecl.node].c, &rmap)
        sm_put(&done, mangled, 1)
        add_final(ld, Decl { m: tdecl.m, node: tdecl.node, kind: DECL_FN, name: mangled, gpu: tdecl.gpu, generic: false, spec: r, nparams: 0, tparams: tl_new() })
        let mut nr: i32 = before
        while nr < mo.req_names.len {
            iv_push(&pending, nr)
            nr = nr + 1
        }
    }
    i = 0
    while i < ld.ndecls {
        let d: Decl = ld_decl(ld, i)
        if d.kind == DECL_EXTERN_FN or (d.kind == DECL_FN and not d.generic) {
            add_final(ld, d)
        }
        i = i + 1
    }
}

# ── Python-only desugarings ─────────────────────────────────────

function range_helpers_needed(m: ptr<Mod>) -> i32 {
    return range_helpers_in(m.arena, m.src)
}

# A `sum(range)` whose bounds are literals: the Python parser folds it.
function folded_sum(m: ptr<Mod>, e: i32) -> bool {
    let k: i32 = range_sum_kind(m.arena, m.src, e)
    return k == 1 or k == -1
}

# The call is the stage right after `|>` (only whitespace between).
function after_pipe(m: ptr<Mod>, pos: i32) -> bool {
    let mut i: i32 = pos - 1
    while i >= 0 {
        let c: i32 = m.src[i] as i32
        if c != 32 and c != 9 and c != 10 and c != 13 {
            break
        }
        i = i - 1
    }
    return i >= 1 and (m.src[i] as i32) == 62 and (m.src[i - 1] as i32) == 124
}

# `|> sort ...`, `|> sortBy ...`, `|> order ...` and `|> find(...)`: the
# Python parser makes these a SortExpr or FindExpr, not a call.
function pipe_stage_expr(m: ptr<Mod>, e: i32) -> bool {
    if m.arena.nodes[e].kind != AST_CALL {
        return false
    }
    let name: string = node_name(m, e)
    let ns: i32 = m.arena.nodes[e].name_start
    if t_eq(name, "sort") or t_eq(name, "sortBy") or t_eq(name, "order") {
        return after_pipe(m, ns)
    }
    if t_eq(name, "find") and after_pipe(m, ns) {
        let mut j: i32 = m.arena.nodes[e].name_end
        while j < m.nsrc and ((m.src[j] as i32) == 32 or (m.src[j] as i32) == 9) {
            j = j + 1
        }
        return j < m.nsrc and (m.src[j] as i32) == 40
    }
    return false
}

# ── Lowering (fir_graphify.graphify) ────────────────────────────

struct Lower {
    g: ptr<FirG>,
    m: ptr<Mod>,
    fid: i32,
    i32_ty: i32,
    mo: ptr<Mono>,
    map: ptr<TMap>,
    params: ptr<SMap>
}

# The type name the Python AST holds after monomorphization: substituted
# in a specialization, generic structs renamed elsewhere.
function lw_type_name(lw: ptr<Lower>, ty: i32) -> string {
    let pt: ptr<PType> = pt_from_ast(lw.m.arena, lw.m.src, ty)
    if lw.map != null {
        return mono_subst_name(lw.mo, pt, lw.map)
    }
    return mono_rewrite_name(lw.mo, pt)
}

function lw_call_name(lw: ptr<Lower>, name: string) -> string {
    if lw.map != null {
        return mono_rename_call(lw.mo, name, lw.map, false)
    }
    return name
}

function is_io_call(name: string) -> bool {
    return t_eq(name, "print") or t_eq(name, "println") or t_eq(name, "printf") or t_eq(name, "puts") or t_eq(name, "fprintf") or t_eq(name, "fputs") or t_eq(name, "read") or t_eq(name, "write") or t_eq(name, "fopen") or t_eq(name, "fclose")
}

function is_alloc_call(name: string) -> bool {
    return t_eq(name, "malloc") or t_eq(name, "calloc") or t_eq(name, "realloc") or t_eq(name, "free") or t_eq(name, "alloc") or t_eq(name, "arena_alloc")
}

function op0(lw: ptr<Lower>, bid: i32, opcode: i32, nopd: i32) -> i32 {
    return fg_add_op(lw.g, opcode, lw.fid, bid, nopd, 0, -1)
}

# An op with one result value; returns the value id.
function op1(lw: ptr<Lower>, bid: i32, opcode: i32, nopd: i32, callee: i32) -> i32 {
    let op: i32 = fg_add_op(lw.g, opcode, lw.fid, bid, nopd, 1, callee)
    return fg_result(lw.g, op)
}

# A CONST result carrying its literal source text (the value for ints,
# bools and floats; the decoded span for strings; "null" for null).
function op_const(lw: ptr<Lower>, bid: i32, text: string) -> i32 {
    let op: i32 = fg_add_op(lw.g, OP_CONST, lw.fid, bid, 0, 1, -1)
    fg_op_set_const(lw.g, op, text)
    return fg_result(lw.g, op)
}

# A BINOP with real operand edges and an AUX_* operator code.
function op_binop(lw: ptr<Lower>, bid: i32, tok: i32, l: i32, r: i32) -> i32 {
    let op: i32 = fg_add_op(lw.g, OP_BINOP, lw.fid, bid, 2, 1, -1)
    fg_add_operand(lw.g, op, l)
    fg_add_operand(lw.g, op, r)
    fg_op_set_aux(lw.g, op, aux_code(tok))
    return fg_result(lw.g, op)
}

# A UNOP with a real operand edge and an AUX_* operator code.
function op_unop(lw: ptr<Lower>, bid: i32, tok: i32, v: i32) -> i32 {
    let op: i32 = fg_add_op(lw.g, OP_UNOP, lw.fid, bid, 1, 1, -1)
    fg_add_operand(lw.g, op, v)
    fg_op_set_aux(lw.g, op, aux_code_unary(tok))
    return fg_result(lw.g, op)
}

# Token id -> AUX_* code; 0 for operators const_fold does not handle.
function aux_code(tok: i32) -> i32 {
    if tok == TOK_PLUS { return AUX_ADD }
    if tok == TOK_MINUS { return AUX_SUB }
    if tok == TOK_STAR { return AUX_MUL }
    if tok == TOK_SLASH { return AUX_DIV }
    if tok == TOK_PERCENT { return AUX_MOD }
    return 0
}

# aux_code for unary ops; only unary minus folds.
function aux_code_unary(tok: i32) -> i32 {
    if tok == TOK_MINUS { return AUX_NEG }
    return 0
}

function lower_call(lw: ptr<Lower>, bid: i32, name0: string, args: i32) -> i32 {
    let mut n: i32 = 0
    let mut argvals: IVec = iv_new()
    let mut a: i32 = args
    while a != AST_NONE {
        let _v: i32 = lower_expr(lw, bid, a)
        iv_push(&argvals, _v)
        n = n + 1
        a = lw.m.arena.nodes[a].next
    }
    let name: string = lw_call_name(lw, name0)
    let callee: i32 = sm_get(&lw.g.func_by_name, name)
    if is_io_call(name) {
        fg_or_effect(lw.g, lw.fid, EFF_IO)
    }
    if is_alloc_call(name) {
        fg_or_effect(lw.g, lw.fid, EFF_ALLOCATES | EFF_WRITES_MEMORY)
    }
    let cop: i32 = fg_add_op(lw.g, OP_CALL, lw.fid, bid, n, 1, callee)
    let mut ai: i32 = 0
    while ai < argvals.len {
        fg_add_operand(lw.g, cop, iv_get(&argvals, ai))
        ai = ai + 1
    }
    let v: i32 = fg_result(lw.g, cop)
    if callee < 0 and not is_io_call(name) and not is_alloc_call(name) {
        fg_or_effect(lw.g, lw.fid, EFF_UNKNOWN)
    }
    return v
}

# The FIELD_ACCESS node a method call `recv.m(args)` was parsed from, or
# AST_NONE for a plain call: flowc folds the receiver into the arguments.
function method_base(m: ptr<Mod>, call: i32) -> i32 {
    let first: i32 = m.arena.nodes[call].a
    if first == AST_NONE {
        return AST_NONE
    }
    let ns: i32 = m.arena.nodes[call].name_start
    let mut i: i32 = call - 1
    while i >= 0 {
        if m.arena.nodes[i].kind == AST_FIELD_ACCESS and m.arena.nodes[i].name_start == ns and m.arena.nodes[i].a == first {
            return i
        }
        i = i - 1
    }
    return AST_NONE
}

# `"a ${b} c"`: the Python parser's left-associated `+` chain of string
# literals and the parsed `${...}` expressions.
function lower_string(lw: ptr<Lower>, bid: i32, id: i32) -> i32 {
    let m: ptr<Mod> = lw.m
    let s: i32 = m.arena.nodes[id].name_start + 1
    let e: i32 = m.arena.nodes[id].name_end - 1
    let text: string = t_span(m.src, s, e)
    let string_ty: i32 = fg_intern_type(lw.g, "string")
    if t_find(text, "${") < 0 {
        return op_const(lw, bid, text)
    }
    let n: i32 = t_len(text)
    let mut cursor: i32 = 0
    let mut i: i32 = 0
    let mut acc: i32 = -1
    let mut nparts: i32 = 0
    while i < n {
        if t_at(text, i) == 36 and i + 1 < n and t_at(text, i + 1) == 123 {
            if i > cursor {
                let v: i32 = op_const(lw, bid, t_sub(text, cursor, i))
                acc = join_part(lw, bid, acc, v)
                nparts = nparts + 1
            }
            let j: i32 = t_find_from(text, "}", i + 2)
            if j < 0 {
                return op1(lw, bid, OP_LOAD, 0, -1)
            }
            let inner: string = t_sub(text, i + 2, j)
            let v2: i32 = lower_source_expr(lw, bid, inner)
            acc = join_part(lw, bid, acc, v2)
            nparts = nparts + 1
            cursor = j + 1
            i = j + 1
        } else {
            i = i + 1
        }
    }
    if cursor < n {
        let v3: i32 = op_const(lw, bid, t_sub(text, cursor, n))
        acc = join_part(lw, bid, acc, v3)
        nparts = nparts + 1
    }
    let _st: i32 = string_ty
    return acc
}

function join_part(lw: ptr<Lower>, bid: i32, acc: i32, v: i32) -> i32 {
    if acc < 0 {
        return v
    }
    return op_binop(lw, bid, TOK_PLUS, acc, v)
}

# Parse `text` as an expression with the flowc parser and lower it.
function lower_source_expr(lw: ptr<Lower>, bid: i32, text: string) -> i32 {
    let wrapped: string = t_cat3("function __fir_interp() {\n let __fir_v = ", text, "\n}\n")
    let n: i32 = t_len(wrapped)
    let buf: ptr<u8> = calloc((n + 1) as i64, 1) as ptr<u8>
    memcpy(buf as ptr<void>, wrapped as ptr<void>, n as i64)
    let mut p: Parser = flowc_parser_new(buf, n, n * 8 + 4096)
    let root: i32 = flowc_parse_program(&p)
    if root < 0 or p.err != 0 {
        return op1(lw, bid, OP_LOAD, 0, -1)
    }
    let fnn: i32 = p.arena.nodes[root].a
    let body: i32 = p.arena.nodes[fnn].c
    let letn: i32 = p.arena.nodes[body].a
    let init: i32 = p.arena.nodes[letn].b
    let sub: Mod = Mod { path: lw.m.path, src: buf, nsrc: n, arena: p.arena, root: root }
    let saved: ptr<Mod> = lw.m
    lw.m = &sub
    let v: i32 = lower_expr(lw, bid, init)
    lw.m = saved
    return v
}

function lower_expr(lw: ptr<Lower>, bid: i32, id: i32) -> i32 {
    let m: ptr<Mod> = lw.m
    let k: i32 = m.arena.nodes[id].kind
    if k == AST_INT or k == AST_BOOL {
        if k == AST_INT {
            let _t: i32 = fg_intern_type(lw.g, "i32")
        } else {
            let _t2: i32 = fg_intern_type(lw.g, "bool")
        }
        return op_const(lw, bid, node_name(m, id))
    }
    if k == AST_FLOAT {
        let _t: i32 = fg_intern_type(lw.g, "f32")
        return op_const(lw, bid, node_name(m, id))
    }
    if k == AST_STRING {
        let _t: i32 = fg_intern_type(lw.g, "string")
        return lower_string(lw, bid, id)
    }
    if k == AST_IDENT {
        let name: string = node_name(m, id)
        if t_eq(name, "null") {
            let _t: i32 = fg_intern_type(lw.g, "ptr_void")
            return op_const(lw, bid, "null")
        }
        let pv: i32 = sm_get(lw.params, name)
        if pv >= 0 {
            let po: i32 = fg_add_op(lw.g, OP_LOAD, lw.fid, bid, 0, 1, -1)
            fg_op_set_aux(lw.g, po, AUX_PARAM_BASE + pv)
            return fg_result(lw.g, po)
        }
        return op1(lw, bid, OP_LOAD, 0, -1)
    }
    if k == AST_BINOP {
        let _l: i32 = lower_expr(lw, bid, m.arena.nodes[id].a)
        let _r: i32 = lower_expr(lw, bid, m.arena.nodes[id].b)
        return op_binop(lw, bid, m.arena.nodes[id].ival, _l, _r)
    }
    if k == AST_UNARY {
        let uop: i32 = m.arena.nodes[id].ival
        if uop == KW_DBG {
            # Python: FunctionCall("__flow_dbg", [operand]).
            return lower_call(lw, bid, "__flow_dbg", m.arena.nodes[id].a)
        }
        if uop == KW_EXPECT {
            return op1(lw, bid, OP_LOAD, 0, -1)
        }
        let _v: i32 = lower_expr(lw, bid, m.arena.nodes[id].a)
        return op_unop(lw, bid, uop, _v)
    }
    if k == AST_CALL {
        if folded_sum(m, id) {
            let _ti: i32 = fg_intern_type(lw.g, "i32")
            return op1(lw, bid, OP_CONST, 0, -1)
        }
        if pipe_stage_expr(m, id) {
            # `|> sort ...` / `|> find(...)`: a SortExpr / FindExpr.
            return op1(lw, bid, OP_LOAD, 0, -1)
        }
        let mb: i32 = method_base(m, id)
        let name: string = call_name(m, id)
        if mb != AST_NONE {
            # MethodCall: no operands, callee by method name.
            let callee: i32 = sm_get(&lw.g.func_by_name, name)
            return op1(lw, bid, OP_CALL, 0, callee)
        }
        return lower_call(lw, bid, name, m.arena.nodes[id].a)
    }
    return op1(lw, bid, OP_LOAD, 0, -1)
}

function lower_block(lw: ptr<Lower>, bid: i32, block: i32) -> i32 {
    if block == AST_NONE {
        return bid
    }
    let mut cur: i32 = bid
    let mut s: i32 = lw.m.arena.nodes[block].a
    while s != AST_NONE {
        if fg_block_terminated(lw.g, cur) == 1 {
            return cur
        }
        hoist_stmt(lw, cur, s)
        cur = lower_stmt(lw, cur, s)
        s = lw.m.arena.nodes[s].next
    }
    return cur
}

# ── Fork and choose blocks (fork_records.desugar_forks) ─────────
#
# The Python parser rewrites `src |> Rec { ... }` and
# `src |> choose sel { ... }` before anything else sees them: a source
# that is not a plain name, literal or field access is bound once in a
# `let` placed before the statement, and a choose becomes a temp plus a
# `match` that assigns it. Those hoisted statements are ops in the graph.

function trivial_source(m: ptr<Mod>, e: i32) -> bool {
    let k: i32 = m.arena.nodes[e].kind
    if k == AST_IDENT or k == AST_INT or k == AST_FLOAT or k == AST_BOOL {
        return true
    }
    if k == AST_STRING {
        return t_find(node_name(m, e), "${") < 0
    }
    if k == AST_FIELD_ACCESS {
        return trivial_source(m, m.arena.nodes[e].a)
    }
    return false
}

# `let __fork_src_N = source` (type auto).
function hoist_source(lw: ptr<Lower>, bid: i32, src: i32) {
    if trivial_source(lw.m, src) {
        return
    }
    let _x: i32 = lower_expr(lw, bid, src)
    let _t: i32 = fg_intern_type(lw.g, "auto")
    let _a: i32 = op1(lw, bid, OP_ALLOCA, 0, -1)
    let _st: i32 = op0(lw, bid, OP_STORE, 2)
    fg_add_operand(lw.g, _st, _a)
    fg_add_operand(lw.g, _st, _x)
}

function hoist_chain(lw: ptr<Lower>, bid: i32, first: i32) {
    let mut a: i32 = first
    while a != AST_NONE {
        hoist_expr(lw, bid, a)
        a = lw.m.arena.nodes[a].next
    }
}

function hoist_expr(lw: ptr<Lower>, bid: i32, e: i32) {
    if e == AST_NONE {
        return
    }
    let m: ptr<Mod> = lw.m
    let k: i32 = m.arena.nodes[e].kind
    if k == AST_PIPE_BLOCK {
        let kind: i32 = m.arena.nodes[e].ival
        let src: i32 = m.arena.nodes[e].a
        if kind == PIPE_BLOCK_FORK {
            hoist_expr(lw, bid, src)
            let mut f: i32 = m.arena.nodes[e].b
            while f != AST_NONE {
                hoist_expr(lw, bid, m.arena.nodes[f].a)
                f = m.arena.nodes[f].next
            }
            hoist_source(lw, bid, src)
        } elif kind == PIPE_BLOCK_CHOOSE {
            hoist_expr(lw, bid, m.arena.nodes[e].c)
            hoist_expr(lw, bid, src)
            hoist_source(lw, bid, src)
            let mut arm: i32 = m.arena.nodes[e].b
            while arm != AST_NONE {
                hoist_expr(lw, bid, m.arena.nodes[arm].b)
                arm = m.arena.nodes[arm].next
            }
            # The `match` that assigns the temp.
            let _mt: i32 = op1(lw, bid, OP_LOAD, 0, -1)
        }
        return
    }
    if k == AST_BINOP or k == AST_INDEX or k == AST_IF_EXPR {
        hoist_expr(lw, bid, m.arena.nodes[e].a)
        hoist_expr(lw, bid, m.arena.nodes[e].b)
        if k != AST_BINOP {
            hoist_expr(lw, bid, m.arena.nodes[e].c)
        }
        return
    }
    if k == AST_UNARY or k == AST_CAST or k == AST_FIELD_ACCESS or k == AST_TRY or k == AST_SORT_BY {
        hoist_expr(lw, bid, m.arena.nodes[e].a)
        return
    }
    if k == AST_CALL or k == AST_ARRAY_LIT or k == AST_VECTOR_LIT {
        hoist_chain(lw, bid, m.arena.nodes[e].a)
        return
    }
    if k == AST_STRUCT_LIT {
        let mut f: i32 = m.arena.nodes[e].a
        while f != AST_NONE {
            hoist_expr(lw, bid, m.arena.nodes[f].a)
            f = m.arena.nodes[f].next
        }
    }
}

function hoist_stmt(lw: ptr<Lower>, bid: i32, s: i32) {
    let m: ptr<Mod> = lw.m
    let k: i32 = m.arena.nodes[s].kind
    if k == AST_LET {
        hoist_expr(lw, bid, m.arena.nodes[s].b)
    } elif k == AST_RETURN or k == AST_EXPR_STMT or k == AST_MATCH {
        hoist_expr(lw, bid, m.arena.nodes[s].a)
    } elif k == AST_ASSIGN {
        hoist_expr(lw, bid, m.arena.nodes[s].b)
        hoist_expr(lw, bid, m.arena.nodes[s].a)
    } elif k == AST_IF {
        hoist_expr(lw, bid, m.arena.nodes[s].a)
        let mut nx: i32 = elif_child(m, s)
        while nx != AST_NONE {
            hoist_expr(lw, bid, m.arena.nodes[nx].a)
            nx = elif_child(m, nx)
        }
    } elif k == AST_WHILE {
        hoist_expr(lw, bid, m.arena.nodes[s].a)
    } elif k == AST_FOR {
        hoist_expr(lw, bid, m.arena.nodes[s].a)
        hoist_expr(lw, bid, m.arena.nodes[s].b)
        if m.arena.nodes[s].ival > 0 {
            hoist_expr(lw, bid, m.arena.nodes[s].ival)
        }
    } elif k == AST_UNARY {
        hoist_expr(lw, bid, m.arena.nodes[s].a)
    }
}

# A flowc `elif` is an else block holding one AST_IF, both spanning from
# the chain's own `if` keyword.
function elif_child(m: ptr<Mod>, ifn: i32) -> i32 {
    let eb: i32 = m.arena.nodes[ifn].c
    if eb == AST_NONE {
        return AST_NONE
    }
    if m.arena.nodes[eb].kind != AST_BLOCK {
        return AST_NONE
    }
    if m.arena.nodes[eb].start != m.arena.nodes[ifn].start {
        return AST_NONE
    }
    let inner: i32 = m.arena.nodes[eb].a
    if inner == AST_NONE or m.arena.nodes[inner].kind != AST_IF {
        return AST_NONE
    }
    if m.arena.nodes[inner].next != AST_NONE {
        return AST_NONE
    }
    return inner
}

function lower_stmt(lw: ptr<Lower>, bid: i32, s: i32) -> i32 {
    let m: ptr<Mod> = lw.m
    let k: i32 = m.arena.nodes[s].kind
    if k == AST_RETURN {
        let mut v: i32 = m.arena.nodes[s].a
        # `return void` is a bare return to the Python parser.
        if v != AST_NONE and m.arena.nodes[v].kind == AST_IDENT and t_eq(node_name(m, v), "void") {
            v = AST_NONE
        }
        if v != AST_NONE {
            let _x: i32 = lower_expr(lw, bid, v)
            let _o: i32 = op0(lw, bid, OP_RET, 1)
            fg_add_operand(lw.g, _o, _x)
        } else {
            let _o2: i32 = op0(lw, bid, OP_RET, 0)
        }
        return bid
    }
    if k == AST_LET {
        let init: i32 = m.arena.nodes[s].b
        if init != AST_NONE {
            let _x: i32 = lower_expr(lw, bid, init)
            let ty: i32 = m.arena.nodes[s].a
            let mut tname: string = "auto"
            if ty != AST_NONE {
                tname = lw_type_name(lw, ty)
            }
            let _t: i32 = fg_intern_type(lw.g, tname)
            let _a: i32 = op1(lw, bid, OP_ALLOCA, 0, -1)
            let _st: i32 = op0(lw, bid, OP_STORE, 2)
            fg_add_operand(lw.g, _st, _a)
            fg_add_operand(lw.g, _st, _x)
        }
        return bid
    }
    if k == AST_ASSIGN {
        let _x: i32 = lower_expr(lw, bid, m.arena.nodes[s].b)
        let _st: i32 = op0(lw, bid, OP_STORE, 0)
        fg_add_operand(lw.g, _st, _x)
        return bid
    }
    if k == AST_IF {
        let _c: i32 = lower_expr(lw, bid, m.arena.nodes[s].a)
        # Collect the elif chain before allocating blocks. Each false edge
        # gets a condition block, so a multi-block caller can follow the CFG.
        let mut elifs: IVec = iv_new()
        let mut cur: i32 = s
        let mut nx: i32 = elif_child(m, cur)
        while nx != AST_NONE {
            iv_push(&elifs, nx)
            cur = nx
            nx = elif_child(m, cur)
        }
        let else_blk: i32 = m.arena.nodes[cur].c
        let mut bodies: IVec = iv_new()
        let mut conds: IVec = iv_new()
        let first_body: i32 = fg_add_block(lw.g, lw.fid)
        iv_push(&bodies, first_body)
        let mut i: i32 = 0
        while i < elifs.len {
            let _cb: i32 = fg_add_block(lw.g, lw.fid)
            iv_push(&conds, _cb)
            let _bb: i32 = fg_add_block(lw.g, lw.fid)
            iv_push(&bodies, _bb)
            i = i + 1
        }
        let else_b: i32 = fg_add_block(lw.g, lw.fid)
        let join_b: i32 = fg_add_block(lw.g, lw.fid)
        let mut false_target: i32 = else_b
        if elifs.len > 0 {
            false_target = iv_get(&conds, 0)
        }
        let _br: i32 = op0(lw, bid, OP_COND_BR, 0)
        fg_add_operand(lw.g, _br, _c)
        fg_set_branch_targets(lw.g, _br, first_body, false_target)
        let mut then_end: i32 = lower_block(lw, first_body, m.arena.nodes[s].b)
        if fg_block_terminated(lw.g, then_end) == 0 {
            let _tb: i32 = op0(lw, then_end, OP_BR, 0)
            fg_set_branch_targets(lw.g, _tb, join_b, -1)
        }
        i = 0
        while i < elifs.len {
            let e: i32 = iv_get(&elifs, i)
            let cb: i32 = iv_get(&conds, i)
            let ec: i32 = lower_expr(lw, cb, m.arena.nodes[e].a)
            let mut next_false: i32 = else_b
            if i + 1 < elifs.len {
                next_false = iv_get(&conds, i + 1)
            }
            let _ebr: i32 = op0(lw, cb, OP_COND_BR, 0)
            fg_add_operand(lw.g, _ebr, ec)
            fg_set_branch_targets(lw.g, _ebr, iv_get(&bodies, i + 1), next_false)
            then_end = lower_block(lw, iv_get(&bodies, i + 1), m.arena.nodes[e].b)
            if fg_block_terminated(lw.g, then_end) == 0 {
                let _eb: i32 = op0(lw, then_end, OP_BR, 0)
                fg_set_branch_targets(lw.g, _eb, join_b, -1)
            }
            i = i + 1
        }
        let else_end: i32 = lower_block(lw, else_b, else_blk)
        if fg_block_terminated(lw.g, else_end) == 0 {
            let _xb: i32 = op0(lw, else_end, OP_BR, 0)
            fg_set_branch_targets(lw.g, _xb, join_b, -1)
        }
        return join_b
    }
    if k == AST_WHILE {
        let _c: i32 = lower_expr(lw, bid, m.arena.nodes[s].a)
        let body_b: i32 = fg_add_block(lw.g, lw.fid)
        let exit_b: i32 = fg_add_block(lw.g, lw.fid)
        let _br: i32 = op0(lw, bid, OP_COND_BR, 0)
        fg_add_operand(lw.g, _br, _c)
        fg_set_branch_targets(lw.g, _br, body_b, exit_b)
        let body_end: i32 = lower_block(lw, body_b, m.arena.nodes[s].b)
        if fg_block_terminated(lw.g, body_end) == 0 {
            let _back: i32 = op0(lw, body_end, OP_BR, 0)
            fg_set_branch_targets(lw.g, _back, bid, -1)
        }
        return exit_b
    }
    if k == AST_FOR {
        let body_b: i32 = fg_add_block(lw.g, lw.fid)
        let exit_b: i32 = fg_add_block(lw.g, lw.fid)
        let _br: i32 = op0(lw, bid, OP_BR, 0)
        fg_set_branch_targets(lw.g, _br, body_b, -1)
        let body_end: i32 = lower_block(lw, body_b, m.arena.nodes[s].c)
        if fg_block_terminated(lw.g, body_end) == 0 {
            let _exit: i32 = op0(lw, body_end, OP_BR, 0)
            fg_set_branch_targets(lw.g, _exit, exit_b, -1)
        }
        return exit_b
    }
    if k == AST_EXPR_STMT {
        let _x: i32 = lower_expr(lw, bid, m.arena.nodes[s].a)
        return bid
    }
    # Any other statement is one opaque value (the Python fallback).
    let _o: i32 = op1(lw, bid, OP_LOAD, 0, -1)
    return bid
}

export function graphify(ld: ptr<Loader>) -> ptr<FirG> {
    let g: ptr<FirG> = fg_new()
    let _void: i32 = fg_intern_type(g, "void")
    let i32_ty: i32 = fg_intern_type(g, "i32")
    let mut i: i32 = 0
    while i < ld.nfdecls {
        let d: Decl = ld_fdecl(ld, i)
        let is_extern: bool = d.kind == DECL_EXTERN_FN
        let mut eff: i32 = flowc_guess_effect_for_name(d.name, 0)
        if is_extern {
            eff = eff | EFF_FFI
        }
        if d.gpu {
            eff = eff | EFF_GPU
        }
        let _f: i32 = fg_add_function(g, d.name, is_extern, eff)
        i = i + 1
    }
    i = 0
    while i < ld.nfdecls {
        let d: Decl = ld_fdecl(ld, i)
        let fid: i32 = sm_get(&g.func_by_name, d.name)
        let m: ptr<Mod> = ld_mod(ld, d.m)
        let body: i32 = m.arena.nodes[d.node].c
        if d.kind == DECL_EXTERN_FN {
            let _b: i32 = fg_add_block(g, fid)
        } else {
            let bid: i32 = fg_add_block(g, fid)
            let mut map: ptr<TMap> = null
            if d.spec >= 0 {
                map = mono_req_map(ld.mono, d.spec)
            }
            let mut param_map: SMap = sm_new()
            let mut lw: Lower = Lower { g: g, m: m, fid: fid, i32_ty: i32_ty, mo: ld.mono, map: map, params: &param_map }
            let mut p: i32 = m.arena.nodes[d.node].a
            let mut param_index: i32 = 0
            while p != AST_NONE {
                let _t: i32 = fg_intern_type(g, lw_type_name(&lw, m.arena.nodes[p].a))
                let po: i32 = fg_add_op(g, OP_PARAM, fid, bid, 0, 1, -1)
                let _pr: i32 = po
                sm_put(&param_map, node_name(m, p), param_index)
                param_index = param_index + 1
                p = m.arena.nodes[p].next
            }
            let end_bid: i32 = lower_block(&lw, bid, body)
            if fg_block_terminated(g, end_bid) == 0 {
                let _r: i32 = fg_add_op(g, OP_RET, fid, end_bid, 0, 0, -1)
            }
        }
        i = i + 1
    }
    fg_build_call_graph_csr(g)
    return g
}
