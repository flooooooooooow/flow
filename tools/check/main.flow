# @module tools.check
# @means  `flow check`: lint .flow files against the conventions a project
#         declares in flow.toml, and with --idioms report idiom hints.
#         Replaces src/flow/check.py, conventions.py and idioms.py; the
#         output, JSON included, matches them byte for byte.
#
#   flow check [--idioms] [--format=text|json] [files...]
#
# Conventions: flow.toml is found by walking up from the working directory.
# Each [conventions].avoid entry has pattern, reason and workaround. A
# pattern with a regex metacharacter is searched as a Python regex (falling
# back to a case-insensitive substring when it does not compile), any other
# pattern as a case-insensitive substring. Warnings go to stderr.
#
# Idioms: each top-level function body is walked the way IdiomAdvisor did.
#   FIDIOM001  `let mut x` never reassigned by a plain `x = ...` / `x op= ...`
#   FIDIOM002  `return T { a: v.a, b: v.b }` rebuilding a single value v
# The Python walk read attributes that its AST lacked (`else_if` on an if
# statement, `branches` on a match) and dropped the whole file's hints when
# it reached one, so a file with an `if` or `match` statement in any
# reachable function body reports no idioms. That behaviour is kept. Only
# flow blocks are expanded before parse, as the Python parser did; hint
# positions are 0-based lines and columns, as Python printed them.
#
# With no file arguments every *.flow under the working directory is
# checked, in the order Python's Path.rglob gave (scandir order, directories
# breadth-first per level of the walk), skipping paths containing "build/"
# or ".freebuff/".

import "scripts/tools/lib/text.flow"
import "scripts/tools/lib/regex.flow"
import "compiler/src/pkg_json.flow"
import "compiler/src/ast.flow"
import "compiler/src/token.flow"
import "compiler/src/lexer.flow"
import "compiler/src/parser.flow"
import "compiler/src/flow_blocks.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function calloc(n: i64, size: i64) -> ptr<void>
    function memcpy(dst: ptr<u8>, src: ptr<u8>, n: i64) -> ptr<u8>
    function getcwd(buf: ptr<u8>, size: i64) -> ptr<u8>
    function opendir(path: string) -> ptr<void>
    function readdir(d: ptr<void>) -> ptr<u8>
    function closedir(d: ptr<void>) -> i32
    function readlink(path: string, buf: ptr<u8>, size: i64) -> i64
    function uname(buf: ptr<u8>) -> i32
    function open(path: string, flags: i32) -> i32
    function close(fd: i32) -> i32
    function dup(fd: i32) -> i32
    function dup2(a: i32, b: i32) -> i32
    function fflush(fp: ptr<void>) -> i32
}

struct Avoid {
    pattern: string,
    reason: string,
    workaround: string
}

struct Finding {
    rule: string,
    line: i32,
    col: i32,
    title: string,
    rationale: string,
    replacement: string,
    span_len: i32
}

# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

function list_of_ptrs_new(cap: i32) -> ptr<ptr<u8>> {
    return malloc((cap as i64) * 8) as ptr<ptr<u8>>
}

# Python str.lower() on ASCII letters; other bytes are kept.
function ascii_lower(s: string) -> string {
    return ft_ascii_lower(s)
}

# Strict UTF-8, as Path.read_text() decodes it.
function valid_utf8(p: ptr<u8>, n: i32) -> bool {
    let mut i: i32 = 0
    while i < n {
        let c: i32 = p[i] as i32
        if c < 128 {
            i = i + 1
        } else {
            let mut extra: i32 = 0
            let mut lo: i32 = 128
            let mut hi: i32 = 191
            if c >= 194 and c <= 223 {
                extra = 1
            } elif c >= 224 and c <= 239 {
                extra = 2
                if c == 224 { lo = 160 }
                if c == 237 { hi = 159 }
            } elif c >= 240 and c <= 244 {
                extra = 3
                if c == 240 { lo = 144 }
                if c == 244 { hi = 143 }
            } else {
                return false
            }
            if i + extra > n - 1 {
                return false
            }
            let b1: i32 = p[i + 1] as i32
            if b1 < lo or b1 > hi {
                return false
            }
            let mut k: i32 = 2
            while k <= extra {
                let b: i32 = p[i + k] as i32
                if b < 128 or b > 191 {
                    return false
                }
                k = k + 1
            }
            i = i + extra + 1
        }
    }
    return true
}

# Path.read_text(): the file as UTF-8 with universal newlines, or null when
# it cannot be read or decoded. Embedded NUL bytes end the text.
function read_text(path: string) -> string {
    let raw: string = ft_read_file(path)
    if raw == null {
        return null
    }
    let p: ptr<u8> = raw as ptr<u8>
    let n: i32 = ft_len(raw)
    if not valid_utf8(p, n) {
        return null
    }
    let buf: ptr<u8> = malloc((n as i64) + 1) as ptr<u8>
    let mut i: i32 = 0
    let mut o: i32 = 0
    while i < n {
        if p[i] == 13 {
            buf[o] = 10
            if p[i + 1] == 10 {
                i = i + 1
            }
        } else {
            buf[o] = p[i]
        }
        o = o + 1
        i = i + 1
    }
    buf[o] = 0
    return buf as string
}

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

function cwd() -> string {
    let buf: ptr<u8> = malloc(4096) as ptr<u8>
    if getcwd(buf, 4096) == null {
        return "."
    }
    return buf as string
}

# str(Path(a)) on POSIX: repeated slashes collapse, "." components and a
# trailing slash drop, a leading "//" (exactly two) is kept.
function pure_path(a: string) -> string {
    let n: i32 = ft_len(a)
    if n == 0 {
        return "."
    }
    let p: ptr<u8> = a as ptr<u8>
    let mut root: string = ""
    let mut i: i32 = 0
    if p[0] == 47 {
        root = "/"
        if n > 1 and p[1] == 47 and (n == 2 or p[2] != 47) {
            root = "//"
        }
        while i < n and p[i] == 47 {
            i = i + 1
        }
    }
    let parts: ptr<StrList> = ft_list_new()
    while i < n {
        let s: i32 = i
        while i < n and p[i] != 47 {
            i = i + 1
        }
        let part: string = ft_slice(a, s, i)
        if ft_len(part) > 0 and not ft_eq(part, ".") {
            ft_list_push(parts, part)
        }
        while i < n and p[i] == 47 {
            i = i + 1
        }
    }
    let mut out: string = root
    let mut k: i32 = 0
    while k < ft_list_len(parts) {
        if k > 0 {
            out = out + "/"
        }
        out = out + ft_list_get(parts, k)
        k = k + 1
    }
    if ft_len(out) == 0 {
        return "."
    }
    return out
}

function join_path(dir: string, name: string) -> string {
    if ft_ends(dir, "/") {
        return dir + name
    }
    return dir + "/" + name
}

# ---------------------------------------------------------------------------
# Directory walk: Path.cwd().rglob("*.flow") on CPython 3.12
# ---------------------------------------------------------------------------

# Offset of d_name in the struct dirent readdir(3) returns. flowc declares
# readdir itself, so macOS x86_64 links the 32-bit-inode variant.
function dirent_name_offset() -> i32 {
    let u: ptr<u8> = calloc(8192, 1) as ptr<u8>
    let _r: i32 = uname(u)
    let sys: string = u as string
    if ft_eq(sys, "Darwin") {
        # struct utsname has five 256-byte fields on Darwin; machine is last.
        let machine: string = (u + 1024) as string
        if ft_eq(machine, "x86_64") {
            return 8
        }
        return 21
    }
    return 19
}

# os.scandir(path) names in directory order, without "." and "..", or
# null when the directory cannot be opened.
function scandir_names(path: string, off: i32) -> ptr<StrList> {
    let d: ptr<void> = opendir(path)
    if d == null {
        return null
    }
    let out: ptr<StrList> = ft_list_new()
    let mut e: ptr<u8> = readdir(d)
    while e != null {
        let name: string = ft_slice((e + off) as string, 0, ft_len((e + off) as string))
        if not ft_eq(name, ".") and not ft_eq(name, "..") {
            ft_list_push(out, name)
        }
        e = readdir(d)
    }
    let _c: i32 = closedir(d)
    return out
}

# DirEntry.is_dir(follow_symlinks=False)
function is_real_dir(path: string) -> bool {
    let buf: ptr<u8> = malloc(8) as ptr<u8>
    if readlink(path, buf, 8) >= 0 {
        return false
    }
    let d: ptr<void> = opendir(path)
    if d == null {
        return false
    }
    let _c: i32 = closedir(d)
    return true
}

# fnmatch "*.flow", case sensitive.
function matches_flow(name: string) -> bool {
    return ft_ends(name, ".flow")
}

function rglob_flow(root: string) -> ptr<StrList> {
    let off: i32 = dirent_name_offset()
    # _iterate_directories: the root, then for each directory Path.walk
    # yields (top-down, depth first, children in scandir order), each of its
    # subdirectories.
    let starts: ptr<StrList> = ft_list_new()
    ft_list_push(starts, root)
    let stack: ptr<StrList> = ft_list_new()
    ft_list_push(stack, root)
    while ft_list_len(stack) > 0 {
        let top: i32 = ft_list_len(stack) - 1
        let dir: string = ft_list_get(stack, top)
        stack[0].len = top
        let names: ptr<StrList> = scandir_names(dir, off)
        if names != null {
            let dirs: ptr<StrList> = ft_list_new()
            let mut i: i32 = 0
            while i < ft_list_len(names) {
                let child: string = join_path(dir, ft_list_get(names, i))
                if is_real_dir(child) {
                    ft_list_push(dirs, child)
                }
                i = i + 1
            }
            i = 0
            while i < ft_list_len(dirs) {
                ft_list_push(starts, ft_list_get(dirs, i))
                i = i + 1
            }
            i = ft_list_len(dirs) - 1
            while i >= 0 {
                ft_list_push(stack, ft_list_get(dirs, i))
                i = i - 1
            }
        }
    }
    let out: ptr<StrList> = ft_list_new()
    let mut s: i32 = 0
    while s < ft_list_len(starts) {
        let dir: string = ft_list_get(starts, s)
        let names: ptr<StrList> = scandir_names(dir, off)
        if names != null {
            let mut i: i32 = 0
            while i < ft_list_len(names) {
                let name: string = ft_list_get(names, i)
                if matches_flow(name) {
                    ft_list_push(out, join_path(dir, name))
                }
                i = i + 1
            }
        }
        s = s + 1
    }
    return out
}

# ---------------------------------------------------------------------------
# flow.toml conventions
# ---------------------------------------------------------------------------

function find_flow_toml() -> string {
    # getcwd(3) is already the resolved (physical) path.
    let mut cur: string = cwd()
    while true {
        let cand: string = join_path(cur, "flow.toml")
        if ft_exists(cand) {
            return cand
        }
        if ft_eq(cur, "/") {
            return null
        }
        let slash: i32 = ft_rfind_byte(cur, 47)
        if slash <= 0 {
            cur = "/"
        } else {
            cur = ft_slice(cur, 0, slash)
        }
    }
    return null
}

# item.get(key, "") rendered the way an f-string renders it.
function field_text(d: ptr<JDoc>, obj: i32, key: string) -> string {
    let v: i32 = jd_get(d, obj, key)
    if v < 0 {
        return ""
    }
    if jd_is_str(d, v) {
        return jd_sval(d, v)
    }
    return jd_py_str_s(d, v)
}

# load_conventions(): the avoid list, empty when flow.toml is missing or
# does not parse.
function load_avoid(count: ptr<i32>) -> ptr<Avoid> {
    count[0] = 0
    let out: ptr<Avoid> = malloc(24 * 256) as ptr<Avoid>
    let path: string = find_flow_toml()
    if path == null {
        return out
    }
    let raw: string = ft_read_file(path)
    if raw == null {
        return out
    }
    if not valid_utf8(raw as ptr<u8>, ft_len(raw)) {
        return out
    }
    let d: ptr<JDoc> = jd_new()
    let root: i32 = jd_parse_toml(d, raw)
    if root < 0 {
        return out
    }
    let conv: i32 = jd_get(d, root, "conventions")
    if conv < 0 or jd_kind(d, conv) != JV_OBJ {
        return out
    }
    let avoid: i32 = jd_get(d, conv, "avoid")
    if avoid < 0 or jd_kind(d, avoid) != JV_ARR {
        return out
    }
    let mut item: i32 = jd_first(d, avoid)
    while item >= 0 and count[0] < 256 {
        if jd_is_obj(d, item) {
            let k: i32 = count[0]
            out[k].pattern = field_text(d, item, "pattern")
            out[k].reason = field_text(d, item, "reason")
            out[k].workaround = field_text(d, item, "workaround")
            count[0] = k + 1
        }
        item = jd_next(d, item)
    }
    return out
}

function has_regex_meta(p: string) -> bool {
    let meta: string = "[](){}.*+?^$|\\"
    let mut i: i32 = 0
    while i < ft_len(meta) {
        if ft_find_byte(p, ft_byte(meta, i), 0) >= 0 {
            return true
        }
        i = i + 1
    }
    return false
}

function matches_pattern(source: string, pattern: string) -> bool {
    if has_regex_meta(pattern) {
        let r: ptr<Regex> = rx_compile(pattern, 0)
        if ft_len(rx_error(r)) == 0 {
            return rx_search(r, source)
        }
    }
    return ft_contains(ascii_lower(source), ascii_lower(pattern))
}

# check_file(): warning lines for one file.
function check_file(path: string, avoid: ptr<Avoid>, n: i32) -> ptr<StrList> {
    let out: ptr<StrList> = ft_list_new()
    if n == 0 {
        return out
    }
    let source: string = read_text(path)
    if source == null {
        return out
    }
    let mut i: i32 = 0
    while i < n {
        let pat: string = avoid[i].pattern
        if ft_len(pat) > 0 and matches_pattern(source, pat) {
            let mut msg: string = path + ": avoid '" + pat + "'"
            if ft_len(avoid[i].reason) > 0 {
                msg = msg + " - " + avoid[i].reason
            }
            if ft_len(avoid[i].workaround) > 0 {
                msg = msg + " (workaround: " + avoid[i].workaround + ")"
            }
            ft_list_push(out, msg)
        }
        i = i + 1
    }
    return out
}

# ---------------------------------------------------------------------------
# Idioms
# ---------------------------------------------------------------------------

struct Walk {
    arena: AstArena,
    src: ptr<u8>,
    aborted: bool,
    mut_names: ptr<StrList>,
    mut_ids: ptr<i32>,
    mutated: ptr<StrList>,
    returns: ptr<i32>,
    nreturns: i32
}

function node_name(w: ptr<Walk>, id: i32) -> string {
    let s: i32 = w[0].arena.nodes[id].name_start
    let e: i32 = w[0].arena.nodes[id].name_end
    return ft_slice(w[0].src as string, s, e)
}

function list_index(l: ptr<StrList>, s: string) -> i32 {
    let mut i: i32 = 0
    while i < ft_list_len(l) {
        if ft_eq(ft_list_get(l, i), s) {
            return i
        }
        i = i + 1
    }
    return -1
}

function visit(w: ptr<Walk>, id: i32) {
    if id == AST_NONE or w[0].aborted {
        return
    }
    let k: i32 = w[0].arena.nodes[id].kind
    if k == AST_BLOCK {
        let mut c: i32 = w[0].arena.nodes[id].a
        while c != AST_NONE and not w[0].aborted {
            visit(w, c)
            c = w[0].arena.nodes[c].next
        }
    } elif k == AST_LET {
        if w[0].arena.nodes[id].ival == 1 {
            let name: string = node_name(w, id)
            let at: i32 = list_index(w[0].mut_names, name)
            if at >= 0 {
                w[0].mut_ids[at] = id
            } else {
                w[0].mut_ids[ft_list_len(w[0].mut_names)] = id
                ft_list_push(w[0].mut_names, name)
            }
        }
    } elif k == AST_ASSIGN {
        let lhs: i32 = w[0].arena.nodes[id].a
        if lhs != AST_NONE and w[0].arena.nodes[lhs].kind == AST_IDENT {
            ft_list_push(w[0].mutated, node_name(w, lhs))
        }
    } elif k == AST_RETURN {
        w[0].returns[w[0].nreturns] = id
        w[0].nreturns = w[0].nreturns + 1
    } elif k == AST_IF or k == AST_MATCH {
        w[0].aborted = true
    } elif k == AST_WHILE {
        visit(w, w[0].arena.nodes[id].b)
    } elif k == AST_FOR {
        visit(w, w[0].arena.nodes[id].c)
    } elif k == AST_HANDLE {
        visit(w, w[0].arena.nodes[id].a)
    } elif k == AST_LAYOUT {
        visit(w, w[0].arena.nodes[id].b)
    }
}

# ---------------------------------------------------------------------------
# Source positions as the Python lexer counted them
# ---------------------------------------------------------------------------
#
# The Python lexer matched `\#.*`, then `\n`, then `\s+`, then tokens, and
# counted a line only for a `\n` matched on its own: a whitespace run that
# starts with a space or tab swallows the newlines after it without counting
# them. Columns grew by len(text.expandtabs(4)) for every match, string
# literals included. Hint positions are those counts, 0-based, so they are
# reproduced here by walking the parsed text the same way.

# Code point at p[i]; its byte length goes to len_out[0].
function decode_at(p: ptr<u8>, i: i32, len_out: ptr<i32>) -> i32 {
    let c: i32 = p[i] as i32
    if c < 128 {
        len_out[0] = 1
        return c
    }
    if c >= 240 {
        len_out[0] = 4
        return ((c % 8) * 262144) + (((p[i + 1] as i32) % 64) * 4096) + (((p[i + 2] as i32) % 64) * 64) + ((p[i + 3] as i32) % 64)
    }
    if c >= 224 {
        len_out[0] = 3
        return ((c % 16) * 4096) + (((p[i + 1] as i32) % 64) * 64) + ((p[i + 2] as i32) % 64)
    }
    if c >= 192 {
        len_out[0] = 2
        return ((c % 32) * 64) + ((p[i + 1] as i32) % 64)
    }
    len_out[0] = 1
    return c
}

# Python's str.isspace / regex \s for a code point.
function py_space(cp: i32) -> bool {
    if cp == 32 or (cp >= 9 and cp <= 13) or (cp >= 28 and cp <= 31) {
        return true
    }
    if cp == 133 or cp == 160 or cp == 5760 or cp == 8232 or cp == 8233 or cp == 8239 or cp == 8287 or cp == 12288 {
        return true
    }
    return cp >= 8192 and cp <= 8202
}

# Tracks len(s.expandtabs(4)) over a run of code points.
struct Expand {
    total: i32,
    col: i32
}

function expand_add(e: ptr<Expand>, cp: i32) {
    if cp == 9 {
        let add: i32 = 4 - (e[0].col % 4)
        e[0].total = e[0].total + add
        e[0].col = e[0].col + add
    } elif cp == 10 or cp == 13 {
        e[0].total = e[0].total + 1
        e[0].col = 0
    } else {
        e[0].total = e[0].total + 1
        e[0].col = e[0].col + 1
    }
}

# Python lexer (line, column), both 1-based, of the token starting at `pos`.
function py_pos(p: ptr<u8>, pos: i32, out_line: ptr<i32>, out_col: ptr<i32>) {
    let mut line: i32 = 1
    let mut col: i32 = 1
    let mut i: i32 = 0
    let ln: ptr<i32> = malloc(4) as ptr<i32>
    let e: ptr<Expand> = malloc(8) as ptr<Expand>
    while i < pos and p[i] != 0 {
        let c: i32 = p[i] as i32
        if c == 35 {
            e[0].total = 0
            e[0].col = 0
            while p[i] != 0 and p[i] != 10 {
                let cp: i32 = decode_at(p, i, ln)
                expand_add(e, cp)
                i = i + ln[0]
            }
            col = col + e[0].total
        } elif c == 10 {
            line = line + 1
            col = 1
            i = i + 1
        } elif py_space(decode_at(p, i, ln)) {
            e[0].total = 0
            e[0].col = 0
            while p[i] != 0 {
                let cp: i32 = decode_at(p, i, ln)
                if not py_space(cp) {
                    break
                }
                expand_add(e, cp)
                i = i + ln[0]
            }
            col = col + e[0].total
        } elif c == 34 {
            # "(?:[^"\\]|\\.)*"  (`.` stops at a newline)
            let start: i32 = i
            e[0].total = 0
            e[0].col = 0
            expand_add(e, 34)
            i = i + 1
            let mut closed: bool = false
            while p[i] != 0 and not closed {
                if p[i] == 34 {
                    expand_add(e, 34)
                    i = i + 1
                    closed = true
                } elif p[i] == 92 and p[i + 1] != 0 and p[i + 1] != 10 {
                    expand_add(e, 92)
                    i = i + 1
                    let cp: i32 = decode_at(p, i, ln)
                    expand_add(e, cp)
                    i = i + ln[0]
                } elif p[i] == 92 {
                    # A backslash before a newline ends the match attempt.
                    break
                } else {
                    let cp: i32 = decode_at(p, i, ln)
                    expand_add(e, cp)
                    i = i + ln[0]
                }
            }
            if not closed {
                # No string token here; the lexer would have stopped.
                i = start + 1
                col = col + 1
            } else {
                col = col + e[0].total
            }
        } else {
            let _cp: i32 = decode_at(p, i, ln)
            i = i + ln[0]
            col = col + 1
        }
    }
    out_line[0] = line
    out_col[0] = col
}

function add_finding(out: ptr<Finding>, n: ptr<i32>, rule: string, w: ptr<Walk>, id: i32, title: string, rationale: string, replacement: string, span: i32) {
    let k: i32 = n[0]
    let pos: i32 = w[0].arena.nodes[id].start
    let pl: ptr<i32> = malloc(4) as ptr<i32>
    let pc: ptr<i32> = malloc(4) as ptr<i32>
    py_pos(w[0].src, pos, pl, pc)
    out[k].rule = rule
    # SourceLocation(max(0, line - 1), max(0, column - 1))
    out[k].line = pl[0] - 1
    out[k].col = pc[0] - 1
    out[k].title = title
    out[k].rationale = rationale
    out[k].replacement = replacement
    out[k].span_len = span
    n[0] = k + 1
}

# FIDIOM002: the base variable when every field is `base.<same name>`.
function redundant_base(w: ptr<Walk>, ret: i32) -> string {
    let v: i32 = w[0].arena.nodes[ret].a
    if v == AST_NONE or w[0].arena.nodes[v].kind != AST_STRUCT_LIT {
        return null
    }
    let mut f: i32 = w[0].arena.nodes[v].a
    if f == AST_NONE {
        return null
    }
    let mut base: string = null
    while f != AST_NONE {
        let fv: i32 = w[0].arena.nodes[f].a
        if fv == AST_NONE or w[0].arena.nodes[fv].kind != AST_FIELD_ACCESS {
            return null
        }
        let obj: i32 = w[0].arena.nodes[fv].a
        if obj == AST_NONE or w[0].arena.nodes[obj].kind != AST_IDENT {
            return null
        }
        if not ft_eq(node_name(w, fv), node_name(w, f)) {
            return null
        }
        let on: string = node_name(w, obj)
        if base == null {
            base = on
        } elif not ft_eq(base, on) {
            return null
        }
        f = w[0].arena.nodes[f].next
    }
    return base
}

# analyze_function for one function; false when the Python walk would have
# raised (the file then reports nothing).
function analyze_fn(w: ptr<Walk>, fnid: i32, out: ptr<Finding>, n: ptr<i32>) -> bool {
    let body: i32 = w[0].arena.nodes[fnid].c
    if body == AST_NONE {
        return true
    }
    w[0].mut_names = ft_list_new()
    w[0].mutated = ft_list_new()
    w[0].nreturns = 0
    visit(w, body)
    if w[0].aborted {
        return false
    }
    let mut i: i32 = 0
    while i < ft_list_len(w[0].mut_names) {
        let name: string = ft_list_get(w[0].mut_names, i)
        if list_index(w[0].mutated, name) < 0 and n[0] < 4096 {
            add_finding(out, n, "FIDIOM001", w, w[0].mut_ids[i], "Unnecessary 'mut' declaration",
                "Variable '" + name + "' is declared 'mut' but is never reassigned. Remove 'mut' to make it immutable.",
                "let " + name, 7)
        }
        i = i + 1
    }
    let mut r: i32 = 0
    while r < w[0].nreturns {
        let base: string = redundant_base(w, w[0].returns[r])
        if base != null and n[0] < 4096 {
            add_finding(out, n, "FIDIOM002", w, w[0].returns[r], "Redundant return shape",
                "Returning a struct literal identical to `" + base + "`. Return `" + base + "` directly.",
                "return " + base + ";", 6)
        }
        r = r + 1
    }
    return true
}

# Parser.parse() expands flow blocks when a line starts one.
function has_flow_blocks(code: string) -> bool {
    let r: ptr<Regex> = rx_compile("^\\s*flow\\s+\\w+\\s*\\{", 8)
    return rx_search(r, code)
}

# The idiom findings for one file's source, or -1 when the Python advisor
# would have given up on the file (parse error, flow expansion error, or an
# if/match statement in a function body).
function idiom_findings(code: string, out: ptr<Finding>) -> i32 {
    let n: i32 = ft_len(code)
    let cap: i32 = n * 4 + 65536
    let buf: ptr<u8> = calloc((cap + 1) as i64, 1) as ptr<u8>
    let _m: ptr<u8> = memcpy(buf, code as ptr<u8>, n as i64)
    # flowc prints expansion and parse diagnostics on stdout; hide them.
    let _f: i32 = fflush(null)
    let saved: i32 = dup(1)
    let devnull: i32 = open("/dev/null", 1)
    let _d: i32 = dup2(devnull, 1)
    let mut nsrc: i32 = n
    if has_flow_blocks(code) {
        nsrc = flowc_flow_blocks_expand_in_place(buf, n, cap)
    }
    let mut root: i32 = -1
    let mut err: i32 = 1
    let mut p: Parser = flowc_parser_new(buf, 0, 16)
    if nsrc >= 0 {
        buf[nsrc] = 0
        p = flowc_parser_new(buf, nsrc, nsrc + 4096)
        root = flowc_parse_program(&p)
        err = p.err
    }
    let _f2: i32 = fflush(null)
    let _d2: i32 = dup2(saved, 1)
    let _c1: i32 = close(saved)
    let _c2: i32 = close(devnull)
    if nsrc < 0 or root < 0 or err != 0 {
        return -1
    }
    let w: ptr<Walk> = calloc(1, 128) as ptr<Walk>
    w[0].arena = p.arena
    w[0].src = buf
    w[0].aborted = false
    w[0].mut_ids = calloc(65536, 4) as ptr<i32>
    w[0].returns = calloc(65536, 4) as ptr<i32>
    let count: ptr<i32> = calloc(1, 4) as ptr<i32>
    let mut item: i32 = p.arena.nodes[root].a
    while item != AST_NONE {
        let mut it: i32 = item
        if p.arena.nodes[it].kind == AST_EXPORT and p.arena.nodes[it].ival == 0 and p.arena.nodes[it].a != AST_NONE {
            it = p.arena.nodes[it].a
        }
        if p.arena.nodes[it].kind == AST_FN {
            if not analyze_fn(w, it, out, count) {
                return -1
            }
        }
        item = p.arena.nodes[item].next
    }
    return count[0]
}

function suppressed(lines: ptr<StrList>, line: i32, rule: string) -> bool {
    let tag: string = "# flow-idiom: allow " + rule
    let idx: i32 = line - 1
    if idx - 1 >= 0 and idx - 1 < ft_list_len(lines) {
        if ft_contains(ft_list_get(lines, idx - 1), tag) {
            return true
        }
    }
    if idx >= 0 and idx < ft_list_len(lines) {
        if ft_contains(ft_list_get(lines, idx), tag) {
            return true
        }
    }
    return false
}

# code.split('\n'), keeping a trailing empty piece.
function split_nl(code: string) -> ptr<StrList> {
    let out: ptr<StrList> = ft_list_new()
    let p: ptr<u8> = code as ptr<u8>
    let n: i32 = ft_len(code)
    let mut s: i32 = 0
    let mut i: i32 = 0
    while i < n {
        if p[i] == 10 {
            ft_list_push(out, ft_slice(code, s, i))
            s = i + 1
        }
        i = i + 1
    }
    ft_list_push(out, ft_slice(code, s, n))
    return out
}

function int_node(d: ptr<JDoc>, v: i32) -> i32 {
    return jd_add(d, JV_INT, ft_itoa(v), v as i64)
}

function finding_json(d: ptr<JDoc>, f: ptr<Finding>, file: string) -> i32 {
    let o: i32 = jd_obj(d)
    jd_set(d, o, "rule_id", jd_str(d, f[0].rule))
    jd_set(d, o, "severity", jd_str(d, "hint"))
    jd_set(d, o, "line", int_node(d, f[0].line))
    jd_set(d, o, "column", int_node(d, f[0].col))
    jd_set(d, o, "title", jd_str(d, f[0].title))
    jd_set(d, o, "rationale", jd_str(d, f[0].rationale))
    jd_set(d, o, "applicability", jd_str(d, "machine-applicable"))
    jd_set(d, o, "replacement", jd_str(d, f[0].replacement))
    jd_set(d, o, "span_len", int_node(d, f[0].span_len))
    jd_set(d, o, "file", jd_str(d, file))
    return o
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

function main(argc: i32, argv: ptr<string>) -> i32 {
    let mut check_idioms: bool = false
    let mut fmt: string = "text"
    let file_args: ptr<StrList> = ft_list_new()
    let mut i: i32 = 1
    while i < argc {
        let a: string = argv[i]
        if ft_eq(a, "--idioms") {
            check_idioms = true
        } elif ft_starts(a, "--format=") {
            # arg.split("=")[1]
            let rest: string = ft_from(a, 9)
            let eq: i32 = ft_find_byte(rest, 61, 0)
            if eq >= 0 {
                fmt = ft_slice(rest, 0, eq)
            } else {
                fmt = rest
            }
        } elif not ft_starts(a, "-") {
            ft_list_push(file_args, a)
        }
        i = i + 1
    }
    let json: bool = ft_eq(fmt, "json")
    let text: bool = ft_eq(fmt, "text")

    let nav: ptr<i32> = calloc(1, 4) as ptr<i32>
    let avoid: ptr<Avoid> = load_avoid(nav)
    let navoid: i32 = nav[0]
    if navoid == 0 and not check_idioms {
        ft_outln("No avoid patterns defined in flow.toml.")
        return 0
    }

    let mut files: ptr<StrList> = ft_list_new()
    if ft_list_len(file_args) > 0 {
        i = 0
        while i < ft_list_len(file_args) {
            ft_list_push(files, pure_path(ft_list_get(file_args, i)))
            i = i + 1
        }
    } else {
        let all: ptr<StrList> = rglob_flow(cwd())
        i = 0
        while i < ft_list_len(all) {
            let f: string = ft_list_get(all, i)
            if not ft_contains(f, "build/") and not ft_contains(f, ".freebuff/") {
                ft_list_push(files, f)
            }
            i = i + 1
        }
    }
    let nfiles: i32 = ft_list_len(files)
    if nfiles == 0 {
        ft_outln("No .flow files found.")
        return 0
    }

    let d: ptr<JDoc> = jd_new()
    let all_findings: i32 = jd_arr(d)
    let mut total: i32 = 0
    let found: ptr<Finding> = calloc(4096, 48) as ptr<Finding>
    i = 0
    while i < nfiles {
        let f: string = ft_list_get(files, i)
        if navoid > 0 {
            let warnings: ptr<StrList> = check_file(f, avoid, navoid)
            let mut k: i32 = 0
            while k < ft_list_len(warnings) {
                if text {
                    ft_errln(ft_list_get(warnings, k))
                }
                total = total + 1
                k = k + 1
            }
        }
        if check_idioms {
            let code: string = read_text(f)
            if code != null {
                let nf: i32 = idiom_findings(code, found)
                if nf > 0 {
                    let lines: ptr<StrList> = split_nl(code)
                    let mut k: i32 = 0
                    while k < nf {
                        let fd: ptr<Finding> = found + k
                        if not suppressed(lines, fd[0].line, fd[0].rule) {
                            if json {
                                jd_append(d, all_findings, finding_json(d, fd, f))
                            } else {
                                ft_outln(f + ":" + ft_itoa(fd[0].line) + ":" + ft_itoa(fd[0].col) + ": hint: [" + fd[0].rule + "] " + fd[0].title + " - " + fd[0].rationale)
                                ft_outln("  Suggested fix: " + fd[0].replacement)
                            }
                            total = total + 1
                        }
                        k = k + 1
                    }
                }
            }
        }
        i = i + 1
    }

    if json {
        let sb: ptr<SBuf> = sb_new()
        jd_dump_json(d, all_findings, sb, 0)
        ft_outln(sb_str(sb))
        if total > 0 {
            return 1
        }
        return 0
    }
    if total == 0 {
        if navoid > 0 and not check_idioms {
            ft_outln("Checked " + ft_itoa(nfiles) + " files. No convention violations found.")
        } else {
            ft_outln("Checked " + ft_itoa(nfiles) + " files. No violations or idiom suggestions found.")
        }
        return 0
    }
    ft_errln("\n" + ft_itoa(total) + " warning(s)/suggestion(s) in " + ft_itoa(nfiles) + " files.")
    return 1
}
