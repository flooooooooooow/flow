# Compile bench, written in Flow.
#
# #735 asks for a machine-readable view of compile-to-result cost: flowc
# emit, the C toolchain, and the program run, for tiny/medium/large
# programs. When the compiler under test understands FLOWC_PROFILE=json
# it also reports per-phase timings (parse, import resolution, typecheck,
# monomorphize, lowering, codegen, incremental_cache).
#
#   ./flow tool compile_bench                 three stock programs, 5 reps
#   ./flow tool compile_bench --repeat 3 prog.flow ...
#   ./flow tool compile_bench --host          current compiler/src via flowc_host
#   ./flow tool compile_bench --compiler PATH
#
# The default compiler is the bootstrap binary, rebuilt from the
# checked-in bootstrap C when missing or older. Output is one JSON object
# per program plus, after the stock set, a summary that names the top
# fixed and scaling costs. Fields: program, loc, emit_ms, cc_ms, run_ms,
# total_ms, cold_total_ms, warm_total_ms, reps, loc_per_emit_s, and when
# present profile (the [flow-profile] object) plus phase_*_ms. Stock runs
# also print a Tier-1 matrix row and >10% bottleneck follow-ups.
#
# Exit codes: 0 pass, 1 a stage failed, 2 bad arguments or setup.

import std.process { ProcCmd, ProcResult, ProcStrs, proc_cmd, proc_arg, proc_env, proc_run, proc_argc, proc_argv, proc_getenv, proc_strs_new, proc_strs_push, proc_strs_len, proc_strs_get, PROC_NULL }
import "tools/flow_cli/sys.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function snprintf(buf: ptr<i8>, size: i64, fmt: string, ...) -> i32
}

function i64_str(v: i64) -> string {
    let b: ptr<i8> = malloc(32) as ptr<i8>
    let _n: i32 = snprintf(b, 32, "%lld", v)
    return b as string
}

function count_lines(path: string) -> i64 {
    let text: string = read_text(path)
    let mut lines: i64 = 0
    let mut i: i32 = 0
    let n: i32 = s_len(text)
    while i < n {
        if s_byte(text, i) == 10 {
            lines = lines + 1
        }
        i = i + 1
    }
    return lines
}

# Split "NAME=VALUE" and set it on the command.
function env_kv(c: ptr<ProcCmd>, kv: string) {
    let mut e: i32 = 0
    while e < s_len(kv) and s_byte(kv, e) != 61 {
        e = e + 1
    }
    proc_env(c, s_slice(kv, 0, e), s_from(kv, e + 1))
}

function extract_profile(err: string) -> string {
    let marker: string = "[flow-profile] "
    let i: i32 = s_find(err, marker, 0)
    if i < 0 {
        return ""
    }
    let start: i32 = i + s_len(marker)
    let mut end: i32 = s_find(err, "\n", start)
    if end < 0 {
        end = s_len(err)
    }
    return s_slice(err, start, end)
}

function phase_ms(profile: string, name: string) -> i64 {
    if s_len(profile) == 0 {
        return 0 - 1
    }
    let key: string = "\"name\": \"" + name + "\", \"ms\": "
    let i: i32 = s_find(profile, key, 0)
    if i < 0 {
        return 0 - 1
    }
    let p: i32 = i + s_len(key)
    return s_atoi(s_from(profile, p), 0) as i64
}

# Run argv with env pairs applied; elapsed ms, or -1 on nonzero exit.
function timed_ms(argv: ptr<ProcStrs>, env: ptr<ProcStrs>) -> i64 {
    return timed_ms_rc(argv, env, true)
}

# `strict`=false measures the run even when the program exits nonzero: a
# benchmark's main may return its result.
function timed_ms_rc(argv: ptr<ProcStrs>, env: ptr<ProcStrs>, strict: bool) -> i64 {
    let c: ptr<ProcCmd> = cmd(argv)
    let mut i: i32 = 0
    while i < proc_strs_len(env) {
        env_kv(c, proc_strs_get(env, i))
        i = i + 1
    }
    cmd_quiet(c)
    let r: ptr<ProcResult> = proc_run(c)
    if r.timed_out or s_len(r.error) > 0 or (strict and r.exit_code != 0) {
        return 0 - 1
    }
    return r.elapsed_ms
}

# Like timed_ms, but captures stderr so a [flow-profile] line can be read.
function timed_emit(argv: ptr<ProcStrs>, env: ptr<ProcStrs>, err_path: string) -> i64 {
    let c: ptr<ProcCmd> = cmd(argv)
    let mut i: i32 = 0
    while i < proc_strs_len(env) {
        env_kv(c, proc_strs_get(env, i))
        i = i + 1
    }
    cmd_quiet_out(c)
    cmd_capture_err(c)
    let r: ptr<ProcResult> = proc_run(c)
    let _w: bool = write_text(err_path, r.stderr)
    if r.timed_out or s_len(r.error) > 0 or r.exit_code != 0 {
        return 0 - 1
    }
    return r.elapsed_ms
}

# Linked optimization issue for a phase that is a >10% bottleneck (#735).
function followup_issue(name: string) -> string {
    if s_eq(name, "parse") or s_eq(name, "import_resolution") or s_eq(name, "incremental_cache") or s_eq(name, "source_read") or s_eq(name, "typecheck") or s_eq(name, "monomorphize") {
        return "#736"
    }
    if s_eq(name, "codegen") or s_eq(name, "lowering") or s_eq(name, "emit") {
        return "#729"
    }
    if s_eq(name, "cc") or s_eq(name, "external_compile") {
        return "#728"
    }
    if s_eq(name, "startup") or s_eq(name, "run") or s_eq(name, "process_launch") {
        return "#746"
    }
    if s_eq(name, "mlir") or s_eq(name, "jit") {
        return "#748"
    }
    return ""
}

function append_phase(line: string, profile: string, name: string) -> string {
    let ms: i64 = phase_ms(profile, name)
    if ms < 0 {
        return line
    }
    return line + ", \"phase_" + name + "_ms\": " + i64_str(ms)
}

function resolve_host(root: string) -> string {
    let a: ptr<ProcStrs> = proc_strs_new()
    proc_strs_push(a, root + "/flow")
    proc_strs_push(a, "tool")
    proc_strs_push(a, "compiler/scripts/flowc_host.flow")
    let c: ptr<ProcCmd> = cmd(a)
    let out: string = capture(c)
    if last_status() != 0 {
        errln("compile_bench: flowc_host failed")
        return ""
    }
    return out
}

function main() -> i32 {
    let root: string = proc_getenv("FLOW_REPO_ROOT")
    let work: string = root + "/build/compile_bench"
    let mut repeat: i32 = 5
    let mut want_host: bool = false
    let mut compiler: string = ""
    let progs: ptr<ProcStrs> = proc_strs_new()
    let mut stock: bool = true

    let mut i: i32 = 1
    while i < proc_argc() {
        let a: string = proc_argv(i)
        if s_eq(a, "--repeat") {
            i = i + 1
            if i >= proc_argc() {
                errln("compile_bench: --repeat needs a count")
                return 2
            }
            repeat = s_atoi(proc_argv(i), 0)
            if repeat < 1 {
                errln("compile_bench: --repeat must be >= 1")
                return 2
            }
        } elif s_eq(a, "--host") {
            want_host = true
        } elif s_eq(a, "--compiler") {
            i = i + 1
            if i >= proc_argc() {
                errln("compile_bench: --compiler needs a path")
                return 2
            }
            compiler = proc_argv(i)
        } else {
            proc_strs_push(progs, a)
            stock = false
        }
        i = i + 1
    }
    if proc_strs_len(progs) == 0 {
        proc_strs_push(progs, "examples/basics/hello_world.flow")
        proc_strs_push(progs, "examples/basics/fibonacci.flow")
        proc_strs_push(progs, "compiler/src/main.flow")
        stock = true
    }

    if not mkdir_p(work) {
        errln("compile_bench: could not create " + work)
        return 2
    }

    let mut boot: string = compiler
    if s_len(boot) == 0 and want_host {
        boot = resolve_host(root)
        if s_len(boot) == 0 {
            return 2
        }
    }
    if s_len(boot) == 0 {
        # The Stage-A compiler under test: the checked-in bootstrap C, rebuilt
        # when the binary is missing or older than it.
        boot = work + "/flowc_bootstrap"
        let bootsrc: string = root + "/compiler/bootstrap/flowc_stage_a.c"
        if not exists(boot) or newer(bootsrc, boot) {
            let cb: ptr<ProcCmd> = proc_cmd("cc")
            proc_arg(cb, "-O2")
            proc_arg(cb, "-o")
            proc_arg(cb, boot)
            proc_arg(cb, bootsrc)
            proc_arg(cb, "-lm")
            let br: ptr<ProcResult> = proc_run(cb)
            if br.exit_code != 0 {
                errln("compile_bench: cc could not build flowc_bootstrap")
                errln(br.stderr)
                return 2
            }
        }
    }

    let out_c: string = work + "/p.c"
    let out_bin: string = work + "/p"
    let err_path: string = work + "/emit.err"
    let no_env: ptr<ProcStrs> = proc_strs_new()

    let cc_a: ptr<ProcStrs> = proc_strs_new()
    proc_strs_push(cc_a, "cc")
    proc_strs_push(cc_a, "-O2")
    proc_strs_push(cc_a, "-o")
    proc_strs_push(cc_a, out_bin)
    proc_strs_push(cc_a, out_c)
    proc_strs_push(cc_a, "-lm")

    let names: ptr<ProcStrs> = proc_strs_new()
    let locs: ptr<ProcStrs> = proc_strs_new()
    let totals: ptr<ProcStrs> = proc_strs_new()
    let emits: ptr<ProcStrs> = proc_strs_new()
    let ccs: ptr<ProcStrs> = proc_strs_new()
    let parses: ptr<ProcStrs> = proc_strs_new()
    let tcs: ptr<ProcStrs> = proc_strs_new()
    let gens: ptr<ProcStrs> = proc_strs_new()
    let startups: ptr<ProcStrs> = proc_strs_new()
    let imports: ptr<ProcStrs> = proc_strs_new()
    let monos: ptr<ProcStrs> = proc_strs_new()
    let lows: ptr<ProcStrs> = proc_strs_new()
    let caches: ptr<ProcStrs> = proc_strs_new()

    let mut rc: i32 = 0
    i = 0
    while i < proc_strs_len(progs) {
        let p: string = proc_strs_get(progs, i)
        i = i + 1
        let mut path: string = p
        if s_byte(p, 0) != 47 {
            path = root + "/" + p
        }
        if not is_file(path) {
            errln("compile_bench: no such program " + path)
            rc = 1
            continue
        }
        let loc: i64 = count_lines(path)
        let emit_env2: ptr<ProcStrs> = proc_strs_new()
        proc_strs_push(emit_env2, "FLOWC_BUNDLE=1")
        proc_strs_push(emit_env2, "FLOWC_DIR=" + root)
        proc_strs_push(emit_env2, "FLOWC_OUT=" + out_c)
        proc_strs_push(emit_env2, "FLOWC_IN=" + path)
        proc_strs_push(emit_env2, "FLOWC_PROFILE=json")
        let emit_a: ptr<ProcStrs> = argv_to_strs(boot)
        let run_a: ptr<ProcStrs> = argv_to_strs(out_bin)

        let mut emit_min: i64 = 0 - 1
        let mut cc_min: i64 = 0 - 1
        let mut run_min: i64 = 0 - 1
        let mut cold_emit: i64 = 0 - 1
        let mut cold_cc: i64 = 0 - 1
        let mut cold_run: i64 = 0 - 1
        let mut warm_profile: string = ""
        let mut cold_profile: string = ""
        let mut r: i32 = 0
        while r < repeat {
            let e: i64 = timed_emit(emit_a, emit_env2, err_path)
            let prof: string = extract_profile(read_text(err_path))
            if e >= 0 {
                if cold_emit < 0 {
                    cold_emit = e
                    cold_profile = prof
                }
                if emit_min < 0 or e < emit_min {
                    emit_min = e
                    warm_profile = prof
                }
            }
            let ct: i64 = timed_ms(cc_a, no_env)
            if ct >= 0 {
                if cold_cc < 0 {
                    cold_cc = ct
                }
                if cc_min < 0 or ct < cc_min {
                    cc_min = ct
                }
            }
            let rn: i64 = timed_ms_rc(run_a, no_env, false)
            if rn >= 0 {
                if cold_run < 0 {
                    cold_run = rn
                }
                if run_min < 0 or rn < run_min {
                    run_min = rn
                }
            }
            r = r + 1
        }
        if emit_min < 0 {
            errln("compile_bench: flowc emit failed for " + path)
            rc = 1
        } elif cc_min < 0 {
            errln("compile_bench: cc failed for " + path)
            rc = 1
        }
        let mut total: i64 = emit_min + cc_min
        if run_min >= 0 {
            total = total + run_min
        }
        let mut cold_total: i64 = cold_emit + cold_cc
        if cold_run >= 0 {
            cold_total = cold_total + cold_run
        }
        let mut line: string = "{\"program\": \"" + p + "\", \"loc\": " + i64_str(loc)
        line = line + ", \"emit_ms\": " + i64_str(emit_min)
        line = line + ", \"cc_ms\": " + i64_str(cc_min)
        line = line + ", \"run_ms\": " + i64_str(run_min)
        line = line + ", \"total_ms\": " + i64_str(total)
        line = line + ", \"cold_total_ms\": " + i64_str(cold_total)
        line = line + ", \"warm_total_ms\": " + i64_str(total)
        line = line + ", \"reps\": " + i64_str(repeat as i64)
        if loc > 0 and emit_min > 0 {
            line = line + ", \"loc_per_emit_s\": " + i64_str((loc * 1000) / emit_min)
        }
        if s_len(warm_profile) > 0 {
            line = line + ", \"profile\": " + warm_profile
            line = append_phase(line, warm_profile, "startup")
            line = append_phase(line, warm_profile, "source_read")
            line = append_phase(line, warm_profile, "parse")
            line = append_phase(line, warm_profile, "import_resolution")
            line = append_phase(line, warm_profile, "typecheck")
            line = append_phase(line, warm_profile, "monomorphize")
            line = append_phase(line, warm_profile, "lowering")
            line = append_phase(line, warm_profile, "codegen")
            line = append_phase(line, warm_profile, "incremental_cache")
        }
        if s_len(cold_profile) > 0 and not s_eq(cold_profile, warm_profile) {
            line = line + ", \"cold_profile\": " + cold_profile
        }
        line = line + "}"
        outln(line)

        proc_strs_push(names, p)
        proc_strs_push(locs, i64_str(loc))
        proc_strs_push(totals, i64_str(total))
        proc_strs_push(emits, i64_str(emit_min))
        proc_strs_push(ccs, i64_str(cc_min))
        proc_strs_push(parses, i64_str(phase_ms(warm_profile, "parse")))
        proc_strs_push(tcs, i64_str(phase_ms(warm_profile, "typecheck")))
        proc_strs_push(gens, i64_str(phase_ms(warm_profile, "codegen")))
        proc_strs_push(startups, i64_str(phase_ms(warm_profile, "startup")))
        proc_strs_push(imports, i64_str(phase_ms(warm_profile, "import_resolution")))
        proc_strs_push(monos, i64_str(phase_ms(warm_profile, "monomorphize")))
        proc_strs_push(lows, i64_str(phase_ms(warm_profile, "lowering")))
        proc_strs_push(caches, i64_str(phase_ms(warm_profile, "incremental_cache")))
    }

    if proc_strs_len(names) >= 1 {
        print_summary(names, locs, totals, emits, ccs, parses, tcs, gens, startups, imports, monos, lows, caches)
    }
    return rc
}

function s_to_i64(s: string) -> i64 {
    return s_atoi(s, 0) as i64
}

function abs_i64(v: i64) -> i64 {
    if v < 0 {
        return 0 - v
    }
    return v
}

function bottleneck_item(program: string, phase: string, ms: i64, total: i64, of: string) -> string {
    if ms < 0 or total <= 0 {
        return ""
    }
    let pct: i64 = (ms * 100) / total
    if pct < 10 {
        return ""
    }
    let issue: string = followup_issue(phase)
    return "{\"program\": \"" + program + "\", \"phase\": \"" + phase + "\", \"ms\": " + i64_str(ms) + ", \"pct\": " + i64_str(pct) + ", \"of\": \"" + of + "\", \"followup\": \"" + issue + "\"}"
}

function append_bottleneck(list: string, item: string) -> string {
    if s_len(item) == 0 {
        return list
    }
    if s_len(list) > 0 {
        return list + ", " + item
    }
    return item
}

function tier1_slot(os: string, arch: string) -> string {
    let linux: bool = s_eq(os, "Linux") or s_eq(os, "linux")
    let darwin: bool = s_eq(os, "Darwin") or s_eq(os, "darwin")
    let x64: bool = s_eq(arch, "x86_64") or s_eq(arch, "amd64")
    let arm: bool = s_eq(arch, "arm64") or s_eq(arch, "aarch64")
    if linux and x64 {
        return "linux-x86_64"
    }
    if darwin and arm {
        return "macos-arm64"
    }
    return "other"
}

# Name the phase whose time changes least vs most with program size.
function print_summary(
    names: ptr<ProcStrs>,
    locs: ptr<ProcStrs>,
    totals: ptr<ProcStrs>,
    emits: ptr<ProcStrs>,
    ccs: ptr<ProcStrs>,
    parses: ptr<ProcStrs>,
    tcs: ptr<ProcStrs>,
    gens: ptr<ProcStrs>,
    startups: ptr<ProcStrs>,
    imports: ptr<ProcStrs>,
    monos: ptr<ProcStrs>,
    lows: ptr<ProcStrs>,
    caches: ptr<ProcStrs>
) {
    let n: i32 = proc_strs_len(names)
    let last: i32 = n - 1
    let loc0: i64 = s_to_i64(proc_strs_get(locs, 0))
    let locn: i64 = s_to_i64(proc_strs_get(locs, last))
    let mut dloc: i64 = locn - loc0
    if dloc < 1 {
        dloc = 1
    }

    let keys: ptr<ProcStrs> = proc_strs_new()
    let tiny: ptr<ProcStrs> = proc_strs_new()
    let large: ptr<ProcStrs> = proc_strs_new()
    proc_strs_push(keys, "total")
    proc_strs_push(tiny, proc_strs_get(totals, 0))
    proc_strs_push(large, proc_strs_get(totals, last))
    proc_strs_push(keys, "emit")
    proc_strs_push(tiny, proc_strs_get(emits, 0))
    proc_strs_push(large, proc_strs_get(emits, last))
    proc_strs_push(keys, "cc")
    proc_strs_push(tiny, proc_strs_get(ccs, 0))
    proc_strs_push(large, proc_strs_get(ccs, last))
    proc_strs_push(keys, "parse")
    proc_strs_push(tiny, proc_strs_get(parses, 0))
    proc_strs_push(large, proc_strs_get(parses, last))
    proc_strs_push(keys, "typecheck")
    proc_strs_push(tiny, proc_strs_get(tcs, 0))
    proc_strs_push(large, proc_strs_get(tcs, last))
    proc_strs_push(keys, "codegen")
    proc_strs_push(tiny, proc_strs_get(gens, 0))
    proc_strs_push(large, proc_strs_get(gens, last))
    proc_strs_push(keys, "startup")
    proc_strs_push(tiny, proc_strs_get(startups, 0))
    proc_strs_push(large, proc_strs_get(startups, last))
    proc_strs_push(keys, "import_resolution")
    proc_strs_push(tiny, proc_strs_get(imports, 0))
    proc_strs_push(large, proc_strs_get(imports, last))
    proc_strs_push(keys, "monomorphize")
    proc_strs_push(tiny, proc_strs_get(monos, 0))
    proc_strs_push(large, proc_strs_get(monos, last))
    proc_strs_push(keys, "lowering")
    proc_strs_push(tiny, proc_strs_get(lows, 0))
    proc_strs_push(large, proc_strs_get(lows, last))
    proc_strs_push(keys, "incremental_cache")
    proc_strs_push(tiny, proc_strs_get(caches, 0))
    proc_strs_push(large, proc_strs_get(caches, last))

    let mut top_fixed: string = "cc"
    let mut top_scale: string = "emit"
    let mut best_rel: i64 = 1000000
    let mut best_delta: i64 = 0 - 1
    let mut k: i32 = 0
    while k < proc_strs_len(keys) {
        let a: i64 = s_to_i64(proc_strs_get(tiny, k))
        let b: i64 = s_to_i64(proc_strs_get(large, k))
        if a >= 0 and b >= 0 {
            let mut mx: i64 = b
            if a > mx {
                mx = a
            }
            if mx > 0 {
                let rel: i64 = (abs_i64(b - a) * 1000) / mx
                if rel < best_rel {
                    best_rel = rel
                    top_fixed = proc_strs_get(keys, k)
                }
            }
            let delta: i64 = (b - a) * 1000 / dloc
            if delta > best_delta {
                best_delta = delta
                top_scale = proc_strs_get(keys, k)
            }
        }
        k = k + 1
    }

    let os: string = uname_s()
    let arch: string = uname_m()
    let slot: string = tier1_slot(os, arch)
    let mut tier1: string = "false"
    if not s_eq(slot, "other") {
        tier1 = "true"
    }

    let hello: string = proc_strs_get(names, 0)
    let large_name: string = proc_strs_get(names, last)
    let hello_total: i64 = s_to_i64(proc_strs_get(totals, 0))
    let large_total: i64 = s_to_i64(proc_strs_get(totals, last))
    let hello_emit: i64 = s_to_i64(proc_strs_get(emits, 0))
    let large_emit: i64 = s_to_i64(proc_strs_get(emits, last))

    let mut bottlenecks: string = ""
    bottlenecks = append_bottleneck(bottlenecks, bottleneck_item(hello, "cc", s_to_i64(proc_strs_get(ccs, 0)), hello_total, "compile_to_result"))
    bottlenecks = append_bottleneck(bottlenecks, bottleneck_item(hello, "emit", hello_emit, hello_total, "compile_to_result"))
    bottlenecks = append_bottleneck(bottlenecks, bottleneck_item(hello, "import_resolution", s_to_i64(proc_strs_get(imports, 0)), hello_emit, "emit"))
    bottlenecks = append_bottleneck(bottlenecks, bottleneck_item(hello, "parse", s_to_i64(proc_strs_get(parses, 0)), hello_emit, "emit"))
    bottlenecks = append_bottleneck(bottlenecks, bottleneck_item(hello, "codegen", s_to_i64(proc_strs_get(gens, 0)), hello_emit, "emit"))
    bottlenecks = append_bottleneck(bottlenecks, bottleneck_item(hello, "incremental_cache", s_to_i64(proc_strs_get(caches, 0)), hello_emit, "emit"))
    bottlenecks = append_bottleneck(bottlenecks, bottleneck_item(large_name, "cc", s_to_i64(proc_strs_get(ccs, last)), large_total, "compile_to_result"))
    bottlenecks = append_bottleneck(bottlenecks, bottleneck_item(large_name, "emit", large_emit, large_total, "compile_to_result"))
    bottlenecks = append_bottleneck(bottlenecks, bottleneck_item(large_name, "codegen", s_to_i64(proc_strs_get(gens, last)), large_emit, "emit"))
    bottlenecks = append_bottleneck(bottlenecks, bottleneck_item(large_name, "typecheck", s_to_i64(proc_strs_get(tcs, last)), large_emit, "emit"))
    bottlenecks = append_bottleneck(bottlenecks, bottleneck_item(large_name, "monomorphize", s_to_i64(proc_strs_get(monos, last)), large_emit, "emit"))
    bottlenecks = append_bottleneck(bottlenecks, bottleneck_item(large_name, "lowering", s_to_i64(proc_strs_get(lows, last)), large_emit, "emit"))
    bottlenecks = append_bottleneck(bottlenecks, bottleneck_item(large_name, "incremental_cache", s_to_i64(proc_strs_get(caches, last)), large_emit, "emit"))

    let mut line: string = "{\"summary\": true"
    line = line + ", \"hello_program\": \"" + hello + "\""
    line = line + ", \"hello_total_ms\": " + proc_strs_get(totals, 0)
    line = line + ", \"large_program\": \"" + large_name + "\""
    line = line + ", \"large_total_ms\": " + proc_strs_get(totals, last)
    line = line + ", \"top_fixed\": \"" + top_fixed + "\""
    line = line + ", \"top_scaling\": \"" + top_scale + "\""
    line = line + ", \"os\": \"" + os + "\""
    line = line + ", \"arch\": \"" + arch + "\""
    line = line + ", \"tier1_slot\": \"" + slot + "\""
    line = line + ", \"tier1\": " + tier1
    line = line + ", \"bottlenecks\": [" + bottlenecks + "]"
    line = line + ", \"schema\": \"flow-compile-profile/1\"}"
    outln(line)

    let mut matrix: string = "{\"matrix\": true, \"schema\": \"flow-compile-profile-matrix/1\""
    matrix = matrix + ", \"os\": \"" + os + "\", \"arch\": \"" + arch + "\""
    matrix = matrix + ", \"tier1_slot\": \"" + slot + "\", \"tier1\": " + tier1
    matrix = matrix + ", \"sizes\": [\"tiny\", \"medium\", \"large\"]"
    matrix = matrix + ", \"tiny\": \"" + hello + "\", \"tiny_total_ms\": " + proc_strs_get(totals, 0)
    if n >= 2 {
        matrix = matrix + ", \"medium\": \"" + proc_strs_get(names, 1) + "\", \"medium_total_ms\": " + proc_strs_get(totals, 1)
    }
    matrix = matrix + ", \"large\": \"" + large_name + "\", \"large_total_ms\": " + proc_strs_get(totals, last)
    matrix = matrix + ", \"top_fixed\": \"" + top_fixed + "\", \"top_scaling\": \"" + top_scale + "\""
    matrix = matrix + ", \"bottlenecks\": [" + bottlenecks + "]"
    matrix = matrix + ", \"notes\": \"Live source is ./flow tool compile_bench. Do not compare stored timings across machines as regressions (#727).\"}"
    outln(matrix)
}

function argv_to_strs(a: string) -> ptr<ProcStrs> {
    let v: ptr<ProcStrs> = proc_strs_new()
    proc_strs_push(v, a)
    return v
}
