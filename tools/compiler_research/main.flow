# Experimental compiler research runner; Part of #1668.
# Execute: ./flow tool compiler_research
# Prints a deterministic JSON decision; does not modify production codegen.

import "tools/compiler_research/contracts.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>)
    function printf(fmt: string, ...) -> i32
}

function main() -> i32 {
    let nodes: ptr<OptNode> = malloc(5 * sizeof<OptNode>()) as ptr<OptNode>
    let proposals: ptr<OptProposal> = malloc(3 * sizeof<OptProposal>()) as ptr<OptProposal>

    nodes[0] = opt_node(OPT_VAR, OPT_I32, -1, -1, 0, 0)
    nodes[1] = opt_node(OPT_CONST, OPT_I32, -1, -1, 0, 0)
    nodes[2] = opt_node(OPT_ADD, OPT_I32, 0, 1, 0, 0)
    nodes[3] = opt_node(OPT_CONST, OPT_I32, -1, -1, 1, 0)
    nodes[4] = opt_node(OPT_MUL, OPT_I32, 2, 3, 0, 0)

    proposals[0] = opt_proposal(20, 4, 2, OPT_MUL_ONE, 3, 3, 0)
    proposals[1] = opt_proposal(10, 4, 0, OPT_MUL_ONE, 1, 3, 0)
    proposals[2] = opt_proposal(30, 4, 4, OPT_KEEP, 8, 3, 0)

    let result: OptSelection = opt_extract(nodes, 5, 4, proposals, 3, 10, 1, 4096)
    printf("{\"schema\":1,\"source_root\":4,\"selected_root\":%d,\"candidate_id\":%d,\"rule\":%d,\"estimated_cost\":%lld,\"accepted\":%d,\"rejected\":%d,\"validation\":\"local-i32-rule\"}\n",
        result.selected_root, result.selected_id, result.selected_rule,
        result.estimated_cost, result.accepted, result.rejected)

    free(nodes as ptr<void>)
    free(proposals as ptr<void>)
    if result.selected_root != 2 or result.accepted != 2 or result.rejected != 1 {
        return 1
    }
    return 0
}
