# @module tools.run
# @means  Compile and run one Flow program in a single process, with an
#         optional JSON envelope (#400). `./flow run --json`, `--keep DIR`
#         and FLOW_RUN_DIRECT=1 come here; plain `./flow run` is the
#         driver's own runner.
#
#   flow run PROG.flow [--backend c|mlir|auto] [--json] [--keep DIR]
#                      [--lenient] [--extra-cflags "FLAGS"]
#   flow run PROG.flow --predict       print the cost model's backend
#
# The C path is flowc (compiler/scripts/flowc_emit.sh), then clang (or cc),
# then the program. `--backend=mlir` runs the MLIR JIT of the Python host
# (python3 -m flow.transpiler --jit), which is where the MLIR backend lives.
# `--backend=auto` compiles with C: the runner this replaces meant to ask the
# cost model, but its call always failed and fell back to C, and C it stays
# until the MLIR path is native. `--predict` prints what the cost model says.
#
# --json prints {stdout, stderr, exit_code, timing{transpile_s, compile_s,
# run_s, total_s}} (and `error` when a step failed) instead of passing the
# program's output through.

import "scripts/tools/lib/text.flow"
import "scripts/tools/lib/proc.flow"
import "scripts/tools/lib/json.flow"
import "compiler/src/ast.flow"
import "compiler/src/token.flow"
import "compiler/src/parser.flow"
import "compiler/src/field_dsl.flow"
import "compiler/src/dynamics_dsl.flow"
import "compiler/src/flow_blocks.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function calloc(n: i64, size: i64) -> ptr<void>
    function memcpy(dst: ptr<void>, src: ptr<void>, n: i64) -> ptr<void>
    function getenv(name: string) -> string
    function gettimeofday(tv: ptr<i64>, tz: ptr<void>) -> i32
    function strtol(s: string, end: ptr<void>, base: i32) -> i64
}

# Microseconds since the epoch. tv_usec is 32 bits on macOS and 64 on Linux;
# either way it is below 2^32 and the upper half of its slot is zero.
function now_us() -> i64 {
    let tv: ptr<i64> = calloc(4, 8) as ptr<i64>
    let _g: i32 = gettimeofday(tv, null)
    return tv[0] * 1000000 + (tv[1] & 4294967295)
}

# round(seconds, 4) as Python prints the float.
function secs(us: i64) -> string {
    let mut tenk: i64 = (us + 50) / 100
    if tenk < 0 {
        tenk = 0
    }
    let whole: i64 = tenk / 10000
    let mut frac: string = ft_itoa((tenk % 10000) as i32)
    while ft_len(frac) < 4 {
        frac = "0" + frac
    }
    while ft_len(frac) > 1 and ft_ends(frac, "0") {
        frac = ft_slice(frac, 0, ft_len(frac) - 1)
    }
    return ft_itoa(whole as i32) + "." + frac
}

struct Envelope {
    stdout: string,
    stderr: string,
    exit_code: i32,
    transpile: string,
    compile: string,
    run: string,
    error: string
}

function emit_json(e: ptr<Envelope>, t0: i64) {
    let mut out: string = "{\n  \"stdout\": " + json_quote(e.stdout) + ",\n  \"stderr\": " + json_quote(e.stderr)
    out = out + ",\n  \"exit_code\": " + ft_itoa(e.exit_code) + ",\n  \"timing\": {\n    \"transpile_s\": " + e.transpile
    out = out + ",\n    \"compile_s\": " + e.compile + ",\n    \"run_s\": " + e.run
    out = out + ",\n    \"total_s\": " + secs(now_us() - t0) + "\n  }"
    if e.error != null and ft_len(e.error) > 0 {
        out = out + ",\n  \"error\": " + json_quote(e.error)
    }
    ft_outln(out + "\n}")
}

function envelope(stdout: string, stderr: string, code: i32) -> ptr<Envelope> {
    let e: ptr<Envelope> = calloc(1, 64) as ptr<Envelope>
    e.stdout = stdout
    e.stderr = stderr
    e.exit_code = code
    e.transpile = "0"
    e.compile = "0"
    e.run = "0"
    e.error = null
    return e
}

function read0(path: string) -> string {
    let s: string = ft_read_file(path)
    if s == null {
        return ""
    }
    return s
}

# s.strip()
function strip(s: string) -> string {
    let p: ptr<u8> = s as ptr<u8>
    let n: i32 = ft_len(s)
    let mut a: i32 = 0
    while a < n and ft_is_ascii_space(p[a] as i32) {
        a = a + 1
    }
    let mut b: i32 = n
    while b > a and ft_is_ascii_space(p[b - 1] as i32) {
        b = b - 1
    }
    return ft_slice(s, a, b)
}

# Exit status of a `system` call as subprocess reports it: negative for a
# death by signal.
function run_status(cmd: string) -> i32 {
    let rc: i32 = pr_run(cmd)
    if rc > 128 {
        return 128 - rc
    }
    return rc
}

# ---------------------------------------------------------------------------
# Cost model: C or MLIR for a program (#400 crossover study)
# ---------------------------------------------------------------------------

struct Cost {
    iters: i64,
    max_depth: i32,
    depth: i32,
    binops: i32,
    unsupported: bool,
    src: ptr<u8>
}

function int_literal(src: ptr<u8>, arena: AstArena, id: i32, out: ptr<i64>) -> bool {
    if id == AST_NONE or arena.nodes[id].kind != AST_INT {
        return false
    }
    out[0] = arena.nodes[id].ival as i64
    return true
}

function ipow(b: i64, e: i32) -> i64 {
    let mut r: i64 = 1
    let mut i: i32 = 0
    while i < e {
        r = r * b
        i = i + 1
    }
    return r
}

# Visit one node and its children (a, b, c) and the rest of its chain.
function cost_visit(c: ptr<Cost>, arena: AstArena, first: i32) {
    let mut id: i32 = first
    while id != AST_NONE {
        let k: i32 = arena.nodes[id].kind
        if k == AST_MATCH {
            c.unsupported = true
        }
        if k == AST_FOR {
            c.depth = c.depth + 1
            if c.depth > c.max_depth {
                c.max_depth = c.depth
            }
            let mut bound: i64 = 100
            let hi: ptr<i64> = calloc(1, 8) as ptr<i64>
            let lo: ptr<i64> = calloc(1, 8) as ptr<i64>
            if int_literal(c.src, arena, arena.nodes[id].b, hi) {
                let mut start: i64 = 0
                if int_literal(c.src, arena, arena.nodes[id].a, lo) {
                    start = lo[0]
                }
                bound = hi[0] - start
            }
            c.iters = c.iters + ipow(bound, c.depth)
            let body: i32 = arena.nodes[id].c
            if body != AST_NONE {
                cost_visit(c, arena, arena.nodes[body].a)
            }
            c.depth = c.depth - 1
        } else {
            if k == AST_BINOP {
                c.binops = c.binops + 1
            }
            cost_visit(c, arena, arena.nodes[id].a)
            cost_visit(c, arena, arena.nodes[id].b)
            cost_visit(c, arena, arena.nodes[id].c)
        }
        id = arena.nodes[id].next
    }
}

function predict(path: string) -> string {
    let text: string = ft_read_file(path)
    if text == null {
        return "c"
    }
    let n: i32 = ft_len(text)
    let cap: i32 = n * 2 + 65536
    let buf: ptr<u8> = calloc((cap + 1) as i64, 1) as ptr<u8>
    memcpy(buf as ptr<void>, text as ptr<void>, n as i64)
    let mut m: i32 = flowc_field_expand_in_place(buf, n, cap)
    if m >= 0 {
        m = flowc_dynamics_expand_in_place(buf, m, cap)
    }
    if m >= 0 {
        m = flowc_flow_blocks_expand_in_place(buf, m, cap)
    }
    if m < 0 {
        return "c"
    }
    buf[m] = 0
    let mut p: Parser = flowc_parser_new(buf, m, m + 4096)
    let root: i32 = flowc_parse_program(&p)
    if root < 0 or p.err != 0 {
        return "c"
    }
    let c: ptr<Cost> = calloc(1, 48) as ptr<Cost>
    c.src = buf
    let mut it: i32 = p.arena.nodes[root].a
    while it != AST_NONE {
        let mut d: i32 = it
        if p.arena.nodes[d].kind == AST_EXPORT and p.arena.nodes[d].ival == 0 and p.arena.nodes[d].a != AST_NONE {
            d = p.arena.nodes[d].a
        }
        if p.arena.nodes[d].kind == AST_FN and p.arena.nodes[d].c != AST_NONE {
            cost_visit(c, p.arena, p.arena.nodes[p.arena.nodes[d].c].a)
        }
        it = p.arena.nodes[it].next
    }
    if c.unsupported {
        return "c"
    }
    if c.iters > 50000 or (c.max_depth > 1 and c.iters > 5000) or c.binops > 100 {
        return "mlir"
    }
    return "c"
}

# ---------------------------------------------------------------------------
# Command line
# ---------------------------------------------------------------------------

function usage() -> string {
    return "usage: flow run [-h] [--backend {c,mlir,auto}] [--json] [--keep KEEP] [--lenient] [--extra-cflags EXTRA_CFLAGS] [--predict] input"
}

function fail_usage(msg: string) -> i32 {
    ft_errln(usage())
    ft_errln("flow run: error: " + msg)
    return 2
}

function main(argc: i32, argv: ptr<string>) -> i32 {
    let repo: string = getenv("FLOW_ROOT")
    if repo == null or ft_len(repo) == 0 {
        ft_errln("flow run: FLOW_ROOT is not set")
        return 2
    }
    let mut input: string = null
    let mut backend: string = "c"
    let mut as_json: bool = false
    let mut keep: string = null
    let mut lenient: bool = false
    let mut extra: string = ""
    let mut do_predict: bool = false
    let mut i: i32 = 1
    while i < argc {
        let a: string = argv[i]
        if ft_eq(a, "--json") {
            as_json = true
        } elif ft_eq(a, "--lenient") {
            lenient = true
        } elif ft_eq(a, "--predict") {
            do_predict = true
        } elif ft_starts(a, "--backend=") {
            backend = ft_from(a, 10)
        } elif ft_eq(a, "--backend") and i + 1 < argc {
            backend = argv[i + 1]
            i = i + 1
        } elif ft_starts(a, "--keep=") {
            keep = ft_from(a, 7)
        } elif ft_eq(a, "--keep") and i + 1 < argc {
            keep = argv[i + 1]
            i = i + 1
        } elif ft_starts(a, "--extra-cflags=") {
            extra = ft_from(a, 15)
        } elif ft_eq(a, "--extra-cflags") and i + 1 < argc {
            extra = argv[i + 1]
            i = i + 1
        } elif ft_eq(a, "-h") or ft_eq(a, "--help") {
            ft_outln(usage())
            return 0
        } elif ft_starts(a, "-") == false and input == null {
            input = a
        } else {
            return fail_usage("unrecognized arguments: " + a)
        }
        i = i + 1
    }
    if input == null {
        return fail_usage("the following arguments are required: input")
    }
    if ft_eq(backend, "c") == false and ft_eq(backend, "mlir") == false and ft_eq(backend, "auto") == false {
        return fail_usage("argument --backend: invalid choice: " + ft_repr(backend) + " (choose from 'c', 'mlir', 'auto')")
    }
    let path: string = pr_resolve(input)
    if pr_is_file(path) == false {
        ft_errln("Error: " + path + " not found")
        return 1
    }
    if do_predict {
        ft_outln(predict(path))
        return 0
    }
    let base: string = ft_stem(path)
    let mut out_dir: string = ""
    if keep != null {
        let _m: bool = pr_mkdir_p(keep)
        out_dir = keep
    } else {
        out_dir = pr_chomp(pr_capture("d=\"${TMPDIR:-/tmp}\"; mktemp -d \"${d%/}/flow_run_XXXXXX\""))
    }
    let c_path: string = out_dir + "/" + base + ".c"
    let exe: string = out_dir + "/" + base
    let outf: string = out_dir + "/.flow_run_stdout"
    let errf: string = out_dir + "/.flow_run_stderr"
    if ft_eq(backend, "auto") {
        backend = "c"
    }
    let t0: i64 = now_us()
    let mut t1: i64 = t0
    let mut t2: i64 = t0
    let mut rc: i32 = 0
    if ft_eq(backend, "c") {
        let mut emit: string = pr_quote(repo + "/compiler/scripts/flowc_emit.sh")
        if lenient {
            emit = emit + " --lenient"
        }
        emit = emit + " " + pr_quote(path) + " " + pr_quote(c_path) + " >" + pr_quote(outf) + " 2>" + pr_quote(errf)
        if pr_run(emit) != 0 {
            let mut msg: string = strip(read0(errf))
            if ft_len(msg) == 0 {
                msg = strip(read0(outf))
            }
            if as_json {
                let e: ptr<Envelope> = envelope("", "", 1)
                e.error = "transpile failed: " + msg
                emit_json(e, t0)
            } else {
                ft_errln("Transpile failed:\n" + msg)
            }
            if keep == null {
                let _r: i32 = pr_run("rm -rf " + pr_quote(out_dir))
            }
            return 1
        }
        t1 = now_us()
        let mut cc: string = "clang"
        if pr_run("command -v clang >/dev/null 2>&1") != 0 {
            cc = "cc"
            if pr_run("command -v cc >/dev/null 2>&1") != 0 {
                if as_json {
                    let e2: ptr<Envelope> = envelope("", "", 1)
                    e2.error = "clang not found"
                    emit_json(e2, t0)
                } else {
                    ft_errln("Error: clang not found")
                }
                return 1
            }
        }
        let mut build: string = cc + " -std=c11 -D_DEFAULT_SOURCE " + pr_quote("-I" + repo + "/runtime") + " -O2 -Wno-everything -lm"
        if ft_contains(pr_capture("uname -s"), "Linux") {
            build = build + " -fveclib=libmvec"
        }
        if ft_len(strip(extra)) > 0 {
            build = build + " " + extra
        }
        build = build + " " + pr_quote(c_path) + " -o " + pr_quote(exe) + " >" + pr_quote(outf) + " 2>" + pr_quote(errf)
        if pr_run(build) != 0 {
            let cmsg: string = strip(read0(errf))
            if as_json {
                let e3: ptr<Envelope> = envelope("", "", 1)
                e3.error = "compile failed: " + cmsg
                emit_json(e3, t0)
            } else {
                ft_errln("Compile failed:\n" + cmsg)
            }
            if keep == null {
                let _r2: i32 = pr_run("rm -rf " + pr_quote(out_dir))
            }
            return 1
        }
        t2 = now_us()
        # The program runs in its own subshell. dash applies a command's
        # redirections in the shell itself, so its "Segmentation fault"
        # report would land in the captured stderr; this way it goes to the
        # outer shell's stderr, which is /dev/null.
        rc = run_status("exec 2>/dev/null; (exec " + pr_quote(exe) + " >" + pr_quote(outf) + " 2>" + pr_quote(errf) + "); exit $?")
    } else {
        # The MLIR JIT compiles and runs in one step.
        t1 = now_us()
        t2 = t1
        let mut jit: string = "PYTHONPATH=" + pr_quote(repo + "/src") + "${PYTHONPATH:+:$PYTHONPATH} python3 -m flow.transpiler " + pr_quote(path) + " --jit"
        if lenient {
            jit = jit + " --lenient"
        }
        rc = run_status(jit + " >" + pr_quote(outf) + " 2>" + pr_quote(errf))
    }
    let t3: i64 = now_us()
    let stdout: string = read0(outf)
    let stderr: string = read0(errf)
    if as_json {
        let e4: ptr<Envelope> = envelope(stdout, stderr, rc)
        e4.transpile = secs(t1 - t0)
        e4.compile = secs(t2 - t1)
        e4.run = secs(t3 - t2)
        emit_json(e4, t0)
    } else {
        ft_out(stdout)
        ft_err(stderr)
    }
    if keep == null {
        let _r3: i32 = pr_run("rm -rf " + pr_quote(out_dir))
    } else {
        let _r4: i32 = pr_run("rm -f " + pr_quote(outf) + " " + pr_quote(errf))
    }
    if rc < 0 {
        return 256 + rc
    }
    return rc
}
