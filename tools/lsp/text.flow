# @module tools.lsp.text
# @means  Line and word helpers for the language server: pointer lists,
#         UTF-8 aware columns (LSP positions count code points here, as
#         the Python server did), and the small pattern matchers the
#         Python server wrote as regular expressions.

import "tools/hostlib/text.flow"

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
}

# ── Pointer lists ───────────────────────────────────────────────

export struct PList {
    items: ptr<ptr<u8>>,
    len: i32,
    cap: i32
}

export function pl_new() -> PList {
    return PList { items: calloc(16, 8) as ptr<ptr<u8>>, len: 0, cap: 16 }
}

export function pl_push(l: ptr<PList>, p: ptr<u8>) {
    if l.len >= l.cap {
        l.cap = l.cap * 2
        l.items = realloc(l.items as ptr<void>, (8 * l.cap) as i64) as ptr<ptr<u8>>
    }
    let it: ptr<ptr<u8>> = l.items
    it[l.len] = p
    l.len = l.len + 1
}

export function pl_get(l: ptr<PList>, i: i32) -> ptr<u8> {
    let it: ptr<ptr<u8>> = l.items
    return it[i]
}

export function pl_set(l: ptr<PList>, i: i32, p: ptr<u8>) {
    let it: ptr<ptr<u8>> = l.items
    it[i] = p
}

export function pl_remove(l: ptr<PList>, i: i32) {
    let it: ptr<ptr<u8>> = l.items
    let mut k: i32 = i
    while k + 1 < l.len {
        it[k] = it[k + 1]
        k = k + 1
    }
    l.len = l.len - 1
}

# ── Characters and columns ──────────────────────────────────────

export function is_word(c: i32) -> bool {
    return t_is_ident_char(c)
}

# Code points in row[0..b) (LSP character offset of byte b).
export function ucol(row: string, b: i32) -> i32 {
    let p: ptr<u8> = row as ptr<u8>
    let n: i32 = t_len(row)
    let mut lim: i32 = b
    if lim > n {
        lim = n
    }
    let mut i: i32 = 0
    let mut k: i32 = 0
    while i < lim {
        let c: i32 = p[i] as i32
        if c < 128 or c >= 192 {
            k = k + 1
        }
        i = i + 1
    }
    return k + (b - lim)
}

# Byte offset of code point cp in row (past the end counts on in bytes).
export function ubyte(row: string, cp: i32) -> i32 {
    let p: ptr<u8> = row as ptr<u8>
    let n: i32 = t_len(row)
    let mut i: i32 = 0
    let mut k: i32 = 0
    while i < n and k < cp {
        i = i + 1
        while i < n and (p[i] as i32) >= 128 and (p[i] as i32) < 192 {
            i = i + 1
        }
        k = k + 1
    }
    return i + (cp - k)
}

# Code point length of a string.
export function ulen(s: string) -> i32 {
    return ucol(s, t_len(s))
}

export function row_at(rows: ptr<TList>, i: i32) -> string {
    if i < 0 or i >= rows.len {
        return ""
    }
    return tl_get(rows, i)
}

# ── Matchers ────────────────────────────────────────────────────

export function skip_ws(s: string, i: i32) -> i32 {
    let n: i32 = t_len(s)
    let mut k: i32 = i
    while k < n and t_is_space(t_at(s, k)) {
        k = k + 1
    }
    return k
}

# s[i..] starts with word w followed by a non-word char (or end).
export function word_at(s: string, i: i32, w: string) -> bool {
    let n: i32 = t_len(s)
    let wl: i32 = t_len(w)
    if i + wl > n {
        return false
    }
    let mut k: i32 = 0
    while k < wl {
        if t_at(s, i + k) != t_at(w, k) {
            return false
        }
        k = k + 1
    }
    if i + wl < n and is_word(t_at(s, i + wl)) {
        return false
    }
    return true
}

export function prefix_at(s: string, i: i32, w: string) -> bool {
    let n: i32 = t_len(s)
    let wl: i32 = t_len(w)
    if i + wl > n {
        return false
    }
    let mut k: i32 = 0
    while k < wl {
        if t_at(s, i + k) != t_at(w, k) {
            return false
        }
        k = k + 1
    }
    return true
}

# Byte offset of the first `\bname\b` in s at or after from, or -1.
export function find_word_from(s: string, name: string, from: i32) -> i32 {
    let n: i32 = t_len(s)
    let nl: i32 = t_len(name)
    if nl == 0 {
        return -1
    }
    let mut i: i32 = from
    while i + nl <= n {
        if (i == 0 or not is_word(t_at(s, i - 1))) and word_at(s, i, name) {
            return i
        }
        i = i + 1
    }
    return -1
}

export function find_word(s: string, name: string) -> i32 {
    return find_word_from(s, name, 0)
}

# `\bname\s*:` -> byte offset of name, or -1.
export function find_name_colon(s: string, name: string) -> i32 {
    let mut from: i32 = 0
    while true {
        let i: i32 = find_word_from(s, name, from)
        if i < 0 {
            return -1
        }
        let j: i32 = skip_ws(s, i + t_len(name))
        if j < t_len(s) and t_at(s, j) == 58 {
            return i
        }
        from = i + 1
    }
    return -1
}

# `^\s*(?:export\s+)?(?:inline\s+)?kind\s+name\b`. Returns the byte
# offset of `kind`, or -1.
export function match_decl(row: string, kind: string, name: string) -> i32 {
    let mut i: i32 = skip_ws(row, 0)
    if word_at(row, i, "export") {
        let j: i32 = skip_ws(row, i + 6)
        if j > i + 6 {
            i = j
        }
    }
    if word_at(row, i, "inline") {
        let j: i32 = skip_ws(row, i + 6)
        if j > i + 6 {
            i = j
        }
    }
    if not word_at(row, i, kind) {
        return -1
    }
    let k: i32 = i + t_len(kind)
    let j: i32 = skip_ws(row, k)
    if j == k {
        return -1
    }
    if not prefix_at(row, j, name) {
        return -1
    }
    let e: i32 = j + t_len(name)
    if e < t_len(row) and is_word(t_at(row, e)) {
        return -1
    }
    # Python's \b after a name ending in a non-word char (claim paths such
    # as `Nat/+`) needs a word char next; treat that as a match anyway.
    return i
}

# 0-based line of `kind name` (Python _find_decl_line), or 0.
export function find_decl_line(rows: ptr<TList>, kind: string, name: string) -> i32 {
    let mut i: i32 = 0
    while i < rows.len {
        if match_decl(tl_get(rows, i), kind, name) >= 0 {
            return i
        }
        i = i + 1
    }
    i = 0
    while i < rows.len {
        let row: string = tl_get(rows, i)
        if find_word(row, kind) >= 0 and t_contains(row, name) {
            return i
        }
        i = i + 1
    }
    return 0
}

# `^\s*let\s+(?:mut\s+)?name\b` (anchored) or `\blet\s+(?:mut\s+)?name\b`.
function let_at(row: string, i: i32, name: string) -> bool {
    if not word_at(row, i, "let") {
        return false
    }
    let mut j: i32 = skip_ws(row, i + 3)
    if j == i + 3 {
        return false
    }
    if word_at(row, j, "mut") {
        let k: i32 = skip_ws(row, j + 3)
        if k > j + 3 and word_at(row, k, name) {
            return true
        }
    }
    return word_at(row, j, name)
}

export function find_let_line(rows: ptr<TList>, name: string, start: i32) -> i32 {
    let mut i: i32 = start
    if i < 0 {
        i = 0
    }
    while i < rows.len {
        let row: string = tl_get(rows, i)
        if let_at(row, skip_ws(row, 0), name) {
            return i
        }
        i = i + 1
    }
    i = 0
    while i < rows.len {
        let row: string = tl_get(rows, i)
        let mut from: i32 = 0
        let mut at: i32 = find_word_from(row, "let", from)
        while at >= 0 {
            if let_at(row, at, name) {
                return i
            }
            from = at + 1
            at = find_word_from(row, "let", from)
        }
        i = i + 1
    }
    if start < 0 {
        return 0
    }
    return start
}

export function find_for_line(rows: ptr<TList>, name: string, start: i32) -> i32 {
    let mut i: i32 = start
    if i < 0 {
        i = 0
    }
    while i < rows.len {
        let row: string = tl_get(rows, i)
        let j: i32 = skip_ws(row, 0)
        if word_at(row, j, "for") {
            let k: i32 = skip_ws(row, j + 3)
            if k > j + 3 and word_at(row, k, name) {
                return i
            }
        }
        i = i + 1
    }
    if start < 0 {
        return 0
    }
    return start
}

function is_modifier_line(stripped: string) -> bool {
    if t_eq(stripped, "export") or t_eq(stripped, "inline") {
        return true
    }
    if t_eq(stripped, "always_inline") or t_eq(stripped, "noinline") {
        return true
    }
    # `@attr` alone on its line.
    let n: i32 = t_len(stripped)
    if n >= 2 and t_at(stripped, 0) == 64 and t_is_ident_start(t_at(stripped, 1)) {
        let mut i: i32 = 2
        while i < n and is_word(t_at(stripped, i)) {
            i = i + 1
        }
        return i == n
    }
    return false
}

function starts_hash(s: string) -> bool {
    return t_len(s) > 0 and t_at(s, 0) == 35
}

# Consecutive `#` comments above a declaration (Python _doc_comment_above).
export function doc_comment_above(rows: ptr<TList>, decl_line: i32) -> string {
    if decl_line < 0 or rows.len == 0 {
        return ""
    }
    let mut i: i32 = decl_line - 1
    while i >= 0 {
        let stripped: string = t_strip(tl_get(rows, i))
        if t_len(stripped) == 0 or is_modifier_line(stripped) {
            i = i - 1
        } else {
            break
        }
    }
    if i < 0 {
        return ""
    }
    if not starts_hash(t_strip(tl_get(rows, i))) {
        return ""
    }
    let block_end: i32 = i
    while i >= 0 {
        let stripped: string = t_strip(tl_get(rows, i))
        if starts_hash(stripped) {
            i = i - 1
        } elif t_len(stripped) == 0 {
            let mut j: i32 = i - 1
            while j >= 0 and t_len(t_strip(tl_get(rows, j))) == 0 {
                j = j - 1
            }
            if j >= 0 and starts_hash(t_strip(tl_get(rows, j))) {
                i = i - 1
            } else {
                break
            }
        } else {
            break
        }
    }
    let block_start: i32 = i + 1
    let mut docs: TList = tl_new()
    let mut k: i32 = block_start
    while k <= block_end {
        let stripped: string = t_strip(tl_get(rows, k))
        if starts_hash(stripped) {
            let mut body: string = t_from(stripped, 1)
            if t_len(body) > 0 and t_at(body, 0) == 32 {
                body = t_from(body, 1)
            }
            tl_push(&docs, body)
        } elif t_len(stripped) == 0 {
            tl_push(&docs, "")
        }
        k = k + 1
    }
    let mut a: i32 = 0
    let mut b: i32 = docs.len
    while a < b and t_len(tl_get(&docs, a)) == 0 {
        a = a + 1
    }
    while b > a and t_len(tl_get(&docs, b - 1)) == 0 {
        b = b - 1
    }
    let mut tb: TBuf = tb_new()
    let mut m: i32 = a
    while m < b {
        if m > a {
            tb_putc(&tb, 10)
        }
        tb_puts(&tb, tl_get(&docs, m))
        m = m + 1
    }
    return tb.data as string
}

export function join(l: ptr<TList>, sep: string) -> string {
    let mut tb: TBuf = tb_new()
    let mut i: i32 = 0
    while i < l.len {
        if i > 0 {
            tb_puts(&tb, sep)
        }
        tb_puts(&tb, tl_get(l, i))
        i = i + 1
    }
    return tb.data as string
}

# Identifier-or-dot run ending at byte i (the completion prefix).
export function ident_run_before(row: string, i: i32, dots: bool) -> i32 {
    let mut s: i32 = i
    while s > 0 {
        let c: i32 = t_at(row, s - 1)
        if is_word(c) or (dots and c == 46) {
            s = s - 1
        } else {
            break
        }
    }
    return s
}

export function ident_run_after(row: string, i: i32) -> i32 {
    let n: i32 = t_len(row)
    let mut e: i32 = i
    while e < n and is_word(t_at(row, e)) {
        e = e + 1
    }
    return e
}

export function lower(s: string) -> string {
    return t_lower(s)
}
