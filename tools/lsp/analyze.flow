# @module tools.lsp.analyze
# @means  Document analysis for the language server. Parses a buffer with
#         the flowc front end (compiler/src/parser.flow, after Field DSL
#         expansion) and indexes top-level symbols with their `#` doc
#         comments, plus parameters, locals and loop variables, the way
#         src/flow/lsp_server.py did with the Python parser. Files flowc
#         cannot parse fall back to a line scan for declarations.

import "tools/hostlib/text.flow"
import "tools/lsp/text.flow"
import "compiler/src/ast.flow"
import "compiler/src/token.flow"
import "compiler/src/parser.flow"
import "compiler/src/field_dsl.flow"

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function memcpy(dst: ptr<void>, src: ptr<void>, n: i64) -> ptr<void>
}

# A top-level declaration. Unused list fields stay empty.
#   pnames/ptypes  function or theorem parameters
#   fnames/ftypes  struct fields
#   items          enum variants, trait methods, effect operations,
#                  capability effects
#   tstr           const type, type alias base
# has_end is false for kinds whose range the Python server left to the
# `column + len(name)` default.
export struct Sym {
    name: string,
    kind: string,
    line: i32,
    column: i32,
    end_line: i32,
    end_column: i32,
    has_end: bool,
    doc: string,
    exported: bool,
    pnames: TList,
    ptypes: TList,
    ret: string,
    fnames: TList,
    ftypes: TList,
    items: TList,
    tstr: string,
    uri: string,
    imported: bool,
    stdlib_path: string
}

# A parameter, local or loop variable, in declaration order.
export struct Bind {
    name: string,
    kind: string,
    typ: string,
    line: i32,
    column: i32,
    end_column: i32,
    mutable: bool,
    container: string,
    detail: string,
    typed: bool,
    init: i32
}

# Result of analysing one buffer.
#   parsed   flowc parsed it (symbols come from the AST)
#   src      the parsed text (Field DSL expanded), NUL-terminated
#   arena    the AST when parsed
#   imports  AST_IMPORT node ids, in order
export struct Analysis {
    syms: PList,
    binds: PList,
    parsed: bool,
    src: ptr<u8>,
    nsrc: i32,
    root: i32,
    arena: AstArena,
    err_line: i32,
    err_col: i32,
    err_msg: string,
    imports: TList,
    raw_failed: bool
}

export function sym_new(name: string, kind: string) -> ptr<Sym> {
    let s: ptr<Sym> = calloc(1, 512) as ptr<Sym>
    s.name = name
    s.kind = kind
    s.line = 0
    s.column = 0
    s.end_line = 0
    s.end_column = 0
    s.has_end = false
    s.doc = ""
    s.exported = false
    s.pnames = tl_new()
    s.ptypes = tl_new()
    s.ret = "void"
    s.fnames = tl_new()
    s.ftypes = tl_new()
    s.items = tl_new()
    s.tstr = "unknown"
    s.uri = ""
    s.imported = false
    s.stdlib_path = ""
    return s
}

export function sym_copy(s: ptr<Sym>) -> ptr<Sym> {
    let c: ptr<Sym> = calloc(1, 512) as ptr<Sym>
    memcpy(c as ptr<void>, s as ptr<void>, 512)
    return c
}

export function sym_at(l: ptr<PList>, i: i32) -> ptr<Sym> {
    return pl_get(l, i) as ptr<Sym>
}

export function bind_at(l: ptr<PList>, i: i32) -> ptr<Bind> {
    return pl_get(l, i) as ptr<Bind>
}

export function sym_find(l: ptr<PList>, name: string) -> ptr<Sym> {
    let mut i: i32 = 0
    while i < l.len {
        let s: ptr<Sym> = sym_at(l, i)
        if t_eq(s.name, name) {
            return s
        }
        i = i + 1
    }
    return null
}

# Python dict assignment: replace in place, else append.
export function sym_put(l: ptr<PList>, s: ptr<Sym>) {
    let mut i: i32 = 0
    while i < l.len {
        let cur: ptr<Sym> = sym_at(l, i)
        if t_eq(cur.name, s.name) {
            pl_set(l, i, s as ptr<u8>)
            return
        }
        i = i + 1
    }
    pl_push(l, s as ptr<u8>)
}

# ── AST helpers ─────────────────────────────────────────────────

export function nd(a: ptr<Analysis>, id: i32) -> AstNode {
    return a.arena.nodes[id]
}

export function name_of(a: ptr<Analysis>, id: i32) -> string {
    return t_span(a.src, a.arena.nodes[id].name_start, a.arena.nodes[id].name_end)
}

# Type text in the Python server's _type_to_str style: ptr<T>, array<T>,
# vec<T>, Name<Args>, or the bare name.
export function type_str(a: ptr<Analysis>, ty: i32) -> string {
    if ty == AST_NONE or ty < 0 {
        return "unknown"
    }
    let n: AstNode = a.arena.nodes[ty]
    if n.kind != AST_TYPE {
        return "unknown"
    }
    let name: string = t_span(a.src, n.name_start, n.name_end)
    if t_len(name) == 0 {
        # Function types and other unnamed forms: the source text.
        let text: string = t_strip(t_span(a.src, n.start, n.end))
        if t_len(text) == 0 {
            return "unknown"
        }
        return text
    }
    if n.a == AST_NONE {
        return name
    }
    if t_eq(name, "array") or t_eq(name, "vec") or t_eq(name, "ptr") {
        return t_cat(t_cat3(name, "<", type_str(a, n.a)), ">")
    }
    let mut tb: TBuf = tb_new()
    tb_puts(&tb, name)
    tb_putc(&tb, 60)
    let mut c: i32 = n.a
    let mut first: bool = true
    while c != AST_NONE {
        if not first {
            tb_puts(&tb, ", ")
        }
        first = false
        tb_puts(&tb, type_str(a, c))
        c = a.arena.nodes[c].next
    }
    tb_putc(&tb, 62)
    return tb.data as string
}

# 0-based line of byte offset pos in src.
export function line_of(src: ptr<u8>, pos: i32) -> i32 {
    let mut line: i32 = 0
    let mut i: i32 = 0
    while i < pos and (src[i] as i32) != 0 {
        if (src[i] as i32) == 10 {
            line = line + 1
        }
        i = i + 1
    }
    return line
}

# Is the text just before byte pos (on its line) the word `export`?
function preceded_by_export(src: ptr<u8>, pos: i32) -> bool {
    let mut i: i32 = pos - 1
    while i >= 0 and ((src[i] as i32) == 32 or (src[i] as i32) == 9) {
        i = i - 1
    }
    if i < 5 {
        return false
    }
    let w: string = "export"
    let mut k: i32 = 0
    while k < 6 {
        if (src[i - 5 + k] as i32) != t_at(w, k) {
            return false
        }
        k = k + 1
    }
    return i - 6 < 0 or not is_word(src[i - 6] as i32)
}

# ── Bindings ────────────────────────────────────────────────────

function push_bind(a: ptr<Analysis>, name: string, kind: string, typ: string, line: i32, col: i32, mutable: bool, container: string, detail: string, rows: ptr<TList>) -> ptr<Bind> {
    let b: ptr<Bind> = calloc(1, 256) as ptr<Bind>
    let row: string = row_at(rows, line)
    b.name = name
    b.kind = kind
    b.typ = typ
    b.line = line
    b.column = ucol(row, col)
    b.end_column = b.column + ulen(name)
    b.mutable = mutable
    b.container = container
    b.detail = detail
    b.typed = false
    b.init = AST_NONE
    pl_push(&a.binds, b as ptr<u8>)
    return b
}

function collect_params(a: ptr<Analysis>, params: i32, rows: ptr<TList>, decl_line: i32, window: i32, container: string) {
    let mut p: i32 = params
    let mut sig_end: i32 = decl_line + window
    if sig_end > rows.len {
        sig_end = rows.len
    }
    while p != AST_NONE {
        let pname: string = name_of(a, p)
        let mut line: i32 = decl_line
        let mut col: i32 = 0
        let mut i: i32 = decl_line
        while i < sig_end {
            let at: i32 = find_name_colon(tl_get(rows, i), pname)
            if at >= 0 {
                line = i
                col = at
                break
            }
            i = i + 1
        }
        push_bind(a, pname, "parameter", type_str(a, a.arena.nodes[p].a), line, col, false, container, "", rows)
        p = a.arena.nodes[p].next
    }
}

function walk_block(a: ptr<Analysis>, block: i32, rows: ptr<TList>, container: string, search_from: i32) -> i32 {
    let mut cursor: i32 = search_from
    if block == AST_NONE {
        return cursor
    }
    let mut st: i32 = a.arena.nodes[block].a
    while st != AST_NONE {
        let k: i32 = a.arena.nodes[st].kind
        if k == AST_LET {
            let name: string = name_of(a, st)
            let line: i32 = find_let_line(rows, name, cursor)
            let row: string = row_at(rows, line)
            let mut col: i32 = find_word(row, name)
            if col < 0 {
                col = 0
            }
            let ty: i32 = a.arena.nodes[st].a
            let mut typ: string = "unknown"
            if ty != AST_NONE {
                typ = type_str(a, ty)
            }
            let b: ptr<Bind> = push_bind(a, name, "variable", typ, line, col, a.arena.nodes[st].ival == 1, container, "", rows)
            if ty == AST_NONE {
                b.init = a.arena.nodes[st].b
            }
            if line > cursor {
                cursor = line
            }
        } elif k == AST_FOR {
            let name: string = name_of(a, st)
            let line: i32 = find_for_line(rows, name, cursor)
            let row: string = row_at(rows, line)
            let mut col: i32 = find_word(row, name)
            if col < 0 {
                col = 0
            }
            push_bind(a, name, "variable", "i32", line, col, false, container, "for-loop variable", rows)
            if line > cursor {
                cursor = line
            }
            cursor = walk_block(a, a.arena.nodes[st].c, rows, container, cursor)
        } elif k == AST_IF {
            cursor = walk_if(a, st, rows, container, cursor)
        } elif k == AST_WHILE {
            cursor = walk_block(a, a.arena.nodes[st].b, rows, container, cursor)
        }
        st = a.arena.nodes[st].next
    }
    return cursor
}

# then block, then every elif (a nested AST_IF alone in the else block),
# then the final else.
function walk_if(a: ptr<Analysis>, st: i32, rows: ptr<TList>, container: string, from: i32) -> i32 {
    let mut cursor: i32 = walk_block(a, a.arena.nodes[st].b, rows, container, from)
    let els: i32 = a.arena.nodes[st].c
    if els == AST_NONE {
        return cursor
    }
    let first: i32 = a.arena.nodes[els].a
    if first != AST_NONE and a.arena.nodes[first].kind == AST_IF and a.arena.nodes[first].next == AST_NONE and a.arena.nodes[first].start == a.arena.nodes[els].start {
        return walk_if(a, first, rows, container, cursor)
    }
    return walk_block(a, els, rows, container, cursor)
}

# ── Symbols from the AST ────────────────────────────────────────

# Column of the `kind` keyword on the declaration line (Python used the
# parser's location column there).
function kw_col(rows: ptr<TList>, line: i32, kind: string, name: string) -> i32 {
    let at: i32 = match_decl(row_at(rows, line), kind, name)
    if at < 0 {
        return 0
    }
    return at
}

function fn_symbol(a: ptr<Analysis>, fnid: i32, exported: bool, rows: ptr<TList>, with_binds: bool) {
    let name: string = name_of(a, fnid)
    let line: i32 = find_decl_line(rows, "function", name)
    let s: ptr<Sym> = sym_new(name, "function")
    let row: string = row_at(rows, line)
    let col: i32 = kw_col(rows, line, "function", name)
    s.line = line
    s.column = ucol(row, col)
    s.end_line = line
    let nat: i32 = find_word_from(row, name, col)
    if nat >= 0 {
        s.end_column = ucol(row, nat + t_len(name))
    } else {
        s.end_column = s.column + ulen(name)
    }
    s.has_end = true
    s.doc = doc_comment_above(rows, line)
    s.exported = exported
    let mut p: i32 = a.arena.nodes[fnid].a
    while p != AST_NONE {
        tl_push(&s.pnames, name_of(a, p))
        tl_push(&s.ptypes, type_str(a, a.arena.nodes[p].a))
        p = a.arena.nodes[p].next
    }
    if a.arena.nodes[fnid].b != AST_NONE {
        s.ret = type_str(a, a.arena.nodes[fnid].b)
    } else {
        s.ret = "unknown"
    }
    sym_put(&a.syms, s)
    if with_binds {
        collect_params(a, a.arena.nodes[fnid].a, rows, line, 40, name)
        walk_block(a, a.arena.nodes[fnid].c, rows, name, line)
    }
}

function struct_symbol(a: ptr<Analysis>, id: i32, exported: bool, rows: ptr<TList>) {
    let name: string = name_of(a, id)
    let line: i32 = find_decl_line(rows, "struct", name)
    let s: ptr<Sym> = sym_new(name, "struct")
    let row: string = row_at(rows, line)
    let col: i32 = kw_col(rows, line, "struct", name)
    s.line = line
    s.column = ucol(row, col)
    s.end_line = line
    let nat: i32 = find_word_from(row, name, col)
    if nat >= 0 {
        s.end_column = ucol(row, nat + t_len(name))
    } else {
        s.end_column = s.column + ulen(name)
    }
    s.has_end = true
    s.doc = doc_comment_above(rows, line)
    s.exported = exported
    let mut f: i32 = a.arena.nodes[id].a
    while f != AST_NONE {
        if a.arena.nodes[f].kind == AST_FIELD {
            tl_push(&s.fnames, name_of(a, f))
            tl_push(&s.ftypes, type_str(a, a.arena.nodes[f].a))
        }
        f = a.arena.nodes[f].next
    }
    sym_put(&a.syms, s)
}

function simple_symbol(a: ptr<Analysis>, name: string, kind: string, keyword: string, exported: bool, rows: ptr<TList>) -> ptr<Sym> {
    let line: i32 = find_decl_line(rows, keyword, name)
    let s: ptr<Sym> = sym_new(name, kind)
    s.line = line
    s.column = 0
    s.doc = doc_comment_above(rows, line)
    s.exported = exported
    return s
}

# `name(...)` entries and `effect X` lines inside a brace-skipped
# effect / capability / trait body.
function body_items(text: string, kind: string, s: ptr<Sym>) {
    let open: i32 = t_find_char(text, 123)
    if open < 0 {
        return
    }
    let n: i32 = t_len(text)
    let mut i: i32 = open + 1
    let mut depth: i32 = 1
    let mut at_start: bool = true
    while i < n and depth > 0 {
        let c: i32 = t_at(text, i)
        if c == 35 {
            while i < n and t_at(text, i) != 10 {
                i = i + 1
            }
        } elif c == 123 or c == 40 {
            depth = depth + 1
            i = i + 1
        } elif c == 125 or c == 41 {
            depth = depth - 1
            i = i + 1
        } elif c == 10 or c == 44 or c == 59 {
            at_start = true
            i = i + 1
        } elif t_is_space(c) {
            i = i + 1
        } elif depth == 1 and at_start and t_is_ident_start(c) {
            let e: i32 = ident_run_after(text, i)
            let word: string = t_sub(text, i, e)
            at_start = false
            if t_eq(kind, "capability") {
                if t_eq(word, "effect") {
                    let j: i32 = skip_ws(text, e)
                    let k: i32 = ident_run_after(text, j)
                    tl_push(&s.items, t_sub(text, j, k))
                }
                i = e
            } elif t_eq(kind, "trait") {
                if t_eq(word, "function") {
                    let j: i32 = skip_ws(text, e)
                    let k: i32 = ident_run_after(text, j)
                    tl_push(&s.items, t_sub(text, j, k))
                }
                i = e
            } else {
                # effect operation: name(p: T, q: U) -> R
                let j: i32 = skip_ws(text, e)
                if j < n and t_at(text, j) == 40 {
                    let mut names: TList = tl_new()
                    let mut q: i32 = j + 1
                    let mut pd: i32 = 1
                    let mut want: bool = true
                    while q < n and pd > 0 {
                        let d: i32 = t_at(text, q)
                        if d == 40 or d == 60 or d == 91 {
                            pd = pd + 1
                            q = q + 1
                        } elif d == 41 or d == 62 or d == 93 {
                            pd = pd - 1
                            q = q + 1
                        } elif d == 44 and pd == 1 {
                            want = true
                            q = q + 1
                        } elif want and pd == 1 and t_is_ident_start(d) {
                            let qe: i32 = ident_run_after(text, q)
                            tl_push(&names, t_sub(text, q, qe))
                            want = false
                            q = qe
                        } else {
                            q = q + 1
                        }
                    }
                    tl_push(&s.items, t_cat(t_cat3(word, "(", join(&names, ", ")), ")"))
                    i = q
                } else {
                    i = e
                }
            }
        } else {
            at_start = false
            i = i + 1
        }
    }
}

# effect / capability / trait written as a brace-skipped statement.
function stmt_symbol(a: ptr<Analysis>, id: i32, rows: ptr<TList>) {
    let n: AstNode = a.arena.nodes[id]
    let text: string = t_span(a.src, n.start, n.end)
    let mut i: i32 = skip_ws(text, 0)
    let mut kind: string = ""
    if word_at(text, i, "effect") {
        kind = "effect"
    } elif word_at(text, i, "capability") {
        kind = "capability"
    } elif word_at(text, i, "trait") {
        kind = "trait"
    } else {
        return
    }
    i = skip_ws(text, i + t_len(kind))
    let e: i32 = ident_run_after(text, i)
    if e == i {
        return
    }
    let name: string = t_sub(text, i, e)
    let s: ptr<Sym> = simple_symbol(a, name, kind, kind, true, rows)
    if t_eq(kind, "trait") {
        s.exported = preceded_by_export(a.src, n.start)
    }
    body_items(text, kind, s)
    sym_put(&a.syms, s)
}

function item_symbols(a: ptr<Analysis>, item: i32, rows: ptr<TList>, exported: bool, with_binds: bool) {
    let k: i32 = a.arena.nodes[item].kind
    if k == AST_EXPORT {
        let inner: i32 = a.arena.nodes[item].a
        if a.arena.nodes[item].ival == 0 and inner != AST_NONE {
            item_symbols(a, inner, rows, true, with_binds)
        }
        return
    }
    if k == AST_FN {
        fn_symbol(a, item, exported, rows, with_binds)
    } elif k == AST_STRUCT {
        struct_symbol(a, item, exported, rows)
    } elif k == AST_ENUM {
        let name: string = name_of(a, item)
        let s: ptr<Sym> = simple_symbol(a, name, "enum", "enum", exported or preceded_by_export(a.src, a.arena.nodes[item].start), rows)
        let mut v: i32 = a.arena.nodes[item].a
        while v != AST_NONE {
            tl_push(&s.items, name_of(a, v))
            v = a.arena.nodes[v].next
        }
        sym_put(&a.syms, s)
    } elif k == AST_CONST {
        let name: string = name_of(a, item)
        let s: ptr<Sym> = simple_symbol(a, name, "const", "const", a.arena.nodes[item].ival == 1, rows)
        s.tstr = type_str(a, a.arena.nodes[item].a)
        sym_put(&a.syms, s)
    } elif k == AST_TYPE_ALIAS {
        if a.arena.nodes[item].a != AST_NONE {
            let name: string = name_of(a, item)
            let s: ptr<Sym> = simple_symbol(a, name, "type", "type", exported or preceded_by_export(a.src, a.arena.nodes[item].start), rows)
            if s.line == 0 {
                let mut i: i32 = 0
                while i < rows.len {
                    let row: string = tl_get(rows, i)
                    let at: i32 = find_word(row, "type")
                    if at >= 0 {
                        let j: i32 = skip_ws(row, at + 4)
                        if j > at + 4 and word_at(row, j, name) {
                            s.line = i
                            s.doc = doc_comment_above(rows, i)
                            break
                        }
                    }
                    i = i + 1
                }
            }
            s.tstr = type_str(a, a.arena.nodes[item].a)
            sym_put(&a.syms, s)
        }
    } elif k == AST_THEOREM {
        let name: string = name_of(a, item)
        let s: ptr<Sym> = simple_symbol(a, name, "theorem", "theorem", a.arena.nodes[item].ival == 1, rows)
        let mut p: i32 = a.arena.nodes[item].a
        while p != AST_NONE {
            tl_push(&s.pnames, name_of(a, p))
            tl_push(&s.ptypes, type_str(a, a.arena.nodes[p].a))
            p = a.arena.nodes[p].next
        }
        sym_put(&a.syms, s)
        if with_binds {
            collect_params(a, a.arena.nodes[item].a, rows, s.line, 20, name)
        }
    } elif k == AST_EFFECT or k == AST_CAPABILITY {
        let name: string = name_of(a, item)
        let mut kind: string = "effect"
        if k == AST_CAPABILITY {
            kind = "capability"
        }
        let s: ptr<Sym> = simple_symbol(a, name, kind, kind, true, rows)
        body_items(t_span(a.src, a.arena.nodes[item].start, a.arena.nodes[item].end), kind, s)
        sym_put(&a.syms, s)
    } elif k == AST_EXPR_STMT {
        stmt_symbol(a, item, rows)
    } elif k == AST_IMPORT {
        tl_push(&a.imports, t_int(item))
    }
}

# ── Fallback line scan ──────────────────────────────────────────

# `^\s*(export\s+)?(inline\s+)?(function|struct|enum|trait|theorem)\s+NAME`
function scan_symbols(a: ptr<Analysis>, rows: ptr<TList>, exported_only: bool) {
    let kinds: array<string, 5> = ["function", "struct", "enum", "trait", "theorem"]
    let mut idx: i32 = 0
    while idx < rows.len {
        let row: string = tl_get(rows, idx)
        let mut i: i32 = skip_ws(row, 0)
        let mut exp: bool = false
        if word_at(row, i, "export") {
            let j: i32 = skip_ws(row, i + 6)
            if j > i + 6 {
                i = j
                exp = true
            }
        }
        if word_at(row, i, "inline") {
            let j: i32 = skip_ws(row, i + 6)
            if j > i + 6 {
                i = j
            }
        }
        let mut kind: string = ""
        let mut ki: i32 = 0
        while ki < 5 {
            if word_at(row, i, kinds[ki]) {
                kind = kinds[ki]
            }
            ki = ki + 1
        }
        if t_len(kind) > 0 and (exp or not exported_only) {
            let j: i32 = skip_ws(row, i + t_len(kind))
            if j > i + t_len(kind) and j < t_len(row) and t_is_ident_start(t_at(row, j)) {
                let mut e: i32 = j
                while e < t_len(row) {
                    let c: i32 = t_at(row, e)
                    if is_word(c) or c == 47 or c == 46 or c == 43 or c == 45 {
                        e = e + 1
                    } else {
                        break
                    }
                }
                let name: string = t_sub(row, j, e)
                let s: ptr<Sym> = sym_new(name, kind)
                s.line = idx
                s.doc = doc_comment_above(rows, idx)
                s.exported = exp
                if t_eq(kind, "struct") {
                    scan_struct_fields(rows, idx, s)
                }
                sym_put(&a.syms, s)
            }
        }
        idx = idx + 1
    }
}

# `name: type` pairs in the next 40 lines of a struct (regex fallback).
function scan_struct_fields(rows: ptr<TList>, start: i32, s: ptr<Sym>) {
    let mut i: i32 = start
    while i < start + 40 and i < rows.len {
        let row: string = tl_get(rows, i)
        let n: i32 = t_len(row)
        let mut k: i32 = 0
        while k < n {
            if t_is_ident_start(t_at(row, k)) and (k == 0 or not is_word(t_at(row, k - 1))) {
                let e: i32 = ident_run_after(row, k)
                let j: i32 = skip_ws(row, e)
                if j < n and t_at(row, j) == 58 {
                    let m: i32 = skip_ws(row, j + 1)
                    if m < n and t_is_ident_start(t_at(row, m)) {
                        let mut me: i32 = m
                        while me < n and (is_word(t_at(row, me)) or t_at(row, me) == 60 or t_at(row, me) == 62) {
                            me = me + 1
                        }
                        let fname: string = t_sub(row, k, e)
                        if not (t_eq(fname, "struct") or t_eq(fname, "function") or t_eq(fname, "enum") or t_eq(fname, "trait")) {
                            tl_push(&s.fnames, fname)
                            tl_push(&s.ftypes, t_sub(row, m, me))
                        }
                        k = me
                    } else {
                        k = e
                    }
                } else {
                    k = e
                }
            } else {
                k = k + 1
            }
        }
        if i > start and t_at(t_strip(row), 0) == 125 {
            break
        }
        i = i + 1
    }
}

# ── Entry point ─────────────────────────────────────────────────

# Parse `text` and index it. exported_only keeps only exported
# declarations and skips bindings (the stdlib index).
export function analyze_text(text: string, exported_only: bool) -> ptr<Analysis> {
    let a: ptr<Analysis> = calloc(1, 512) as ptr<Analysis>
    a.syms = pl_new()
    a.binds = pl_new()
    a.imports = tl_new()
    a.parsed = false
    a.raw_failed = false
    a.root = AST_NONE
    a.err_line = 0
    a.err_col = 0
    a.err_msg = ""
    let n: i32 = t_len(text)
    let cap: i32 = n * 2 + 65536
    let buf: ptr<u8> = calloc((cap + 1) as i64, 1) as ptr<u8>
    memcpy(buf as ptr<void>, text as ptr<void>, n as i64)
    let mut nsrc: i32 = flowc_field_expand_in_place(buf, n, cap)
    if nsrc < 0 {
        memcpy(buf as ptr<void>, text as ptr<void>, n as i64)
        buf[n] = 0
        nsrc = n
    }
    buf[nsrc] = 0
    a.src = buf
    a.nsrc = nsrc
    # Declaration lines are looked up in the text as written, as in Python.
    let mut rows: TList = t_split_lines(text)
    let mut p: Parser = flowc_parser_new(buf, nsrc, nsrc + 4096)
    let mut root: i32 = flowc_parse_program(&p)
    a.arena = p.arena
    if root < 0 or p.err != 0 {
        let mut t: Token = p.cur
        if p.err != 0 {
            t = p.err_tok
        }
        a.err_line = t.line - 1
        a.err_col = t.col - 1
        a.err_msg = parse_error_text(buf, t)
        a.raw_failed = true
        flowc_parser_free(p)
        # Mid-edit recovery: `return p.` parses as `return p._flow_incomplete`
        # so the rest of the buffer still yields symbols and bindings. The
        # parse error above is still reported.
        let fixed: string = recover_incomplete(buf as string)
        root = -1
        if not t_eq(fixed, buf as string) {
            let fl: i32 = t_len(fixed)
            let mut p2: Parser = flowc_parser_new(fixed as ptr<u8>, fl, fl + 4096)
            let r2: i32 = flowc_parse_program(&p2)
            if r2 >= 0 and p2.err == 0 {
                root = r2
                a.arena = p2.arena
                a.src = fixed as ptr<u8>
                a.nsrc = fl
            } else {
                flowc_parser_free(p2)
            }
        }
        if root < 0 {
            a.arena = flowc_ast_new(1)
            scan_symbols(a, &rows, exported_only)
            return a
        }
    }
    a.parsed = true
    a.root = root
    let mut item: i32 = a.arena.nodes[root].a
    while item != AST_NONE {
        item_symbols(a, item, &rows, false, not exported_only)
        item = a.arena.nodes[item].next
    }
    if exported_only {
        let mut keep: PList = pl_new()
        let mut i: i32 = 0
        while i < a.syms.len {
            let s: ptr<Sym> = sym_at(&a.syms, i)
            if s.exported or t_eq(s.kind, "effect") {
                pl_push(&keep, s as ptr<u8>)
            }
            i = i + 1
        }
        a.syms = keep
    }
    return a
}

# Append `_flow_incomplete` to every line ending in `ident.` (Python
# _recover_incomplete_syntax).
function recover_incomplete(text: string) -> string {
    let rows: TList = t_split_lines(text)
    let mut tb: TBuf = tb_new()
    let mut i: i32 = 0
    while i < rows.len {
        if i > 0 {
            tb_putc(&tb, 10)
        }
        let row: string = tl_get(&rows, i)
        let r: string = t_rstrip(row)
        let mut hit: bool = false
        let n: i32 = t_len(r)
        if n >= 2 and t_at(r, n - 1) == 46 {
            let mut k: i32 = n - 1
            while k > 0 and t_is_space(t_at(r, k - 1)) {
                k = k - 1
            }
            let st: i32 = ident_run_before(r, k, false)
            if st < k {
                let mut s0: i32 = st
                while s0 < k and not t_is_ident_start(t_at(r, s0)) {
                    s0 = s0 + 1
                }
                hit = s0 < k
            }
        }
        if hit {
            tb_puts(&tb, r)
            tb_puts(&tb, "_flow_incomplete")
        } else {
            tb_puts(&tb, row)
        }
        i = i + 1
    }
    return tb.data as string
}

function tok_kind_name(kind: i32) -> string {
    if kind == TOK_EOF {
        return "end of file"
    }
    if kind == TOK_IDENT {
        return "identifier"
    }
    if kind == TOK_KEYWORD {
        return "keyword"
    }
    if kind == TOK_INT {
        return "integer"
    }
    if kind == TOK_FLOAT {
        return "float"
    }
    if kind == TOK_STRING {
        return "string"
    }
    return "token"
}

# flowc's parse error, as `parse error: unexpected <kind> '<text>'`.
function parse_error_text(src: ptr<u8>, t: Token) -> string {
    let mut n: i32 = t.end - t.start
    if n > 32 {
        n = 32
    }
    let mut i: i32 = 0
    while i < n {
        if (src[t.start + i] as i32) == 10 {
            n = i
        }
        i = i + 1
    }
    let mut tb: TBuf = tb_new()
    if t.kind == TOK_EOF {
        tb_puts(&tb, "parse error: unexpected end of file")
        return tb.data as string
    }
    tb_puts(&tb, "parse error: unexpected ")
    tb_puts(&tb, tok_kind_name(t.kind))
    tb_puts(&tb, " '")
    tb_put_span(&tb, src, t.start, t.start + n)
    tb_puts(&tb, "'")
    if t.kind == TOK_KEYWORD {
        tb_puts(&tb, " (a reserved word cannot be used as a name)")
    }
    return tb.data as string
}
