    tl_push(out, "f64")
    tl_push(out, "false")
    tl_push(out, "for")
    tl_push(out, "function")
    tl_push(out, "handle")
    tl_push(out, "i128")
    tl_push(out, "i16")
    tl_push(out, "i32")
    tl_push(out, "i64")
    tl_push(out, "i8")
    tl_push(out, "if")
    tl_push(out, "impl")
    tl_push(out, "import")
    tl_push(out, "in")
    tl_push(out, "let")
    tl_push(out, "match")
    tl_push(out, "module")
    tl_push(out, "mut")
