export function builtin_function_doc(name: string) -> string {
    if t_eq(name, "print") {
        return "Print a value to stdout."
    }
    if t_eq(name, "printf") {
        return "Print formatted output (C-style format string)."
    }
    if t_eq(name, "sqrt") {
        return "Square root of x (\342\210\232x)."
    }
    if t_eq(name, "sin") {
        return "Sine of x (radians)."
    }
    if t_eq(name, "cos") {
        return "Cosine of x (radians)."
    }
    if t_eq(name, "tan") {
        return "Tangent of x (radians)."
    }
    if t_eq(name, "asin") {
        return "Arcsine of x; result in radians."
    }
    if t_eq(name, "acos") {
        return "Arccosine of x; result in radians."
    }
    if t_eq(name, "atan") {
        return "Arctangent of x; result in radians."
    }
    if t_eq(name, "atan2") {
        return "Arctangent of y/x using both signs for the quadrant."
    }
    if t_eq(name, "exp") {
        return "Exponential e^x."
    }
    if t_eq(name, "log") {
        return "Natural logarithm (ln x)."
    }
    if t_eq(name, "log10") {
        return "Base-10 logarithm of x."
    }
    if t_eq(name, "log2") {
        return "Base-2 logarithm of x."
    }
    if t_eq(name, "pow") {
        return "Raise x to the power y (x^y)."
    }
    if t_eq(name, "abs") {
        return "Absolute value |x| for integers."
    }
    if t_eq(name, "fabs") {
        return "Absolute value |x| for floating-point."
    }
    if t_eq(name, "floor") {
        return "Greatest integer \342\211\244 x (as f64)."
    }
    if t_eq(name, "ceil") {
        return "Smallest integer \342\211\245 x (as f64)."
    }
    if t_eq(name, "round") {
        return "Nearest integer to x (as f64)."
    }
    if t_eq(name, "trunc") {
        return "Truncate fractional part toward zero."
    }
    if t_eq(name, "fmod") {
        return "Floating-point remainder of x/y."
    }
    if t_eq(name, "min") {
        return "Return the smaller of a and b."
    }
    if t_eq(name, "max") {
        return "Return the larger of a and b."
    }
    if t_eq(name, "sinh") {
        return "Hyperbolic sine of x."
    }
    if t_eq(name, "cosh") {
        return "Hyperbolic cosine of x."
    }
    if t_eq(name, "tanh") {
        return "Hyperbolic tangent of x."
    }
    if t_eq(name, "hypot") {
        return "Euclidean norm \342\210\232(x\302\262 + y\302\262) without overflow."
    }
    return ""
}

