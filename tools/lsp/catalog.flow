# dynamics_completion_items(""): every dynamics snippet and keyword.
# Five strings per item: label, kind, detail, insertText ("\001" when
# the item has none) and documentation.
export function dynamics_completion_table(out: ptr<TList>) {
    tl_push(out, "dynamics")
    tl_push(out, "9")
    tl_push(out, "dynamics namespace block")
    tl_push(out, "dynamics {\n    $0\n}")
    tl_push(out, "**`dynamics { ... }`** - namespace block for the dynamics DSL.\n\nBody uses bare `dsys` / `horizon` / `sense` / `ga evolve` / \342\200\246 lines.\nLine prefix alternative: `dyn.horizon \342\200\246` / `dynamics.sense on \342\200\246`.")
    tl_push(out, "dyn.")
    tl_push(out, "9")
    tl_push(out, "dynamics prefix")
    tl_push(out, "dyn.")
    tl_push(out, "**`dyn.`** - short namespace prefix for dynamics DSL constructs (`dyn.dsys`, `dyn.horizon`, `dyn.sense`, `dyn.ga`, `dyn.closed`, `dyn.analyze`, `dyn.wfc`).")
    tl_push(out, "dyn.dsys")
    tl_push(out, "15")
    tl_push(out, "dynamics DSL")
    tl_push(out, "dyn.dsys ${1:plant} {\n    ${2|discrete,continuous|}\n    dt ${3:0.1}\n    n ${4:2} m ${5:1} p ${6:1}\n    A ${7:1.0 0.1 0.0 1.0}\n    B ${8:0.0 0.1}\n    C ${9:1.0 0.0}\n}")
    tl_push(out, "**`dsys`** - declare a linear plant (dynamics DSL).\n\n```flow\ndyn.dsys plant {\n    discrete   # or continuous\n    dt 0.1\n    n 2 m 1 p 1\n    A 1.0 0.1 0.0 1.0\n    B 0.0 0.1\n    C 1.0 0.0\n}\n```\nPrefixed form: `dyn.dsys` / `dynamics.dsys`. See docs/language/dynamics-dsl.md.")
    tl_push(out, "dyn.horizon")
    tl_push(out, "15")
    tl_push(out, "dynamics DSL")
    tl_push(out, "dyn.horizon ${1:rollout} finite ${2:50}")
    tl_push(out, "**`horizon`** - name a finite or infinite analysis horizon.\n\n```flow\ndyn.horizon rollout finite 50\ndyn.horizon asymptotic infinite gamma 0.99\n```")
    tl_push(out, "dyn.sense")
    tl_push(out, "15")
    tl_push(out, "dynamics DSL")
    tl_push(out, "dyn.sense on ${1:plant} {\n    controllable -> ${2:plant_ok}\n    spectral -> ${3:rho_open}\n    $0\n}")
    tl_push(out, "**`sense on`** - open-loop analysis bindings.\n\n```flow\ndyn.sense on plant {\n    controllable -> plant_ok\n    spectral -> rho_open\n    gramian finite rollout trace -> wc_fin\n}\n```")
    tl_push(out, "dyn.ga evolve")
    tl_push(out, "15")
    tl_push(out, "dynamics DSL")
    tl_push(out, "dyn.ga evolve on ${1:plant} over ${2:rollout} -> ${3:k1} ${4:k2} {\n    population ${5:12}\n    generations ${6:30}\n    mutation ${7:0.3}\n}")
    tl_push(out, "**`ga evolve`** - genetic search for state-feedback gains.\n\n```flow\ndyn.ga evolve on plant over rollout -> k1 k2 {\n    population 12\n    generations 30\n    mutation 0.3\n}\n```")
    tl_push(out, "dyn.closed")
    tl_push(out, "15")
    tl_push(out, "dynamics DSL")
    tl_push(out, "dyn.closed ${1:plant} with ${2:k1} ${3:k2} {\n    spectral -> ${4:rho_cl}\n    energy over ${5:rollout} -> ${6:E_cl}\n    stable -> ${7:stable_cl}\n}")
    tl_push(out, "**`closed`** - certify closed-loop `A - B K`.\n\n```flow\ndyn.closed plant with k1 k2 {\n    spectral -> rho_cl\n    energy over rollout -> E_cl\n    stable -> stable_cl\n}\n```")
    tl_push(out, "dyn.analyze")
    tl_push(out, "15")
    tl_push(out, "dynamics DSL")
    tl_push(out, "dyn.analyze ${1:plant} ga ${2:k1} ${3:k2} over ${4:rollout} -> ${5:report} {\n    full\n}")
    tl_push(out, "**`analyze`** - one-shot GA + controllability + Gramian report.\n\n```flow\ndyn.analyze plant ga k1 k2 over rollout -> report { full }\n```\nBinds a `GAAnalysisReport` and assigns `k1`/`k2`.")
    tl_push(out, "dyn.wfc field")
    tl_push(out, "15")
    tl_push(out, "dynamics DSL")
    tl_push(out, "dyn.wfc field ${1:layout} {\n    size ${2:4} ${3:4}\n    tiles ${4:3}\n    seed ${5:7}\n}")
    tl_push(out, "**`wfc field`** - Wave Function Collapse field (experimental coupling).\n\n```flow\ndyn.wfc field layout { size 4 4  tiles 3  seed 7 }\n```")
    tl_push(out, "dsys")
    tl_push(out, "15")
    tl_push(out, "dynamics DSL")
    tl_push(out, "dsys ${1:plant} {\n    discrete\n    dt 0.1\n    n 2 m 1 p 1\n    A 1.0 0.1 0.0 1.0\n    B 0.0 0.1\n    C 1.0 0.0\n}")
    tl_push(out, "**`dsys`** - declare a linear plant (dynamics DSL).\n\n```flow\ndyn.dsys plant {\n    discrete   # or continuous\n    dt 0.1\n    n 2 m 1 p 1\n    A 1.0 0.1 0.0 1.0\n    B 0.0 0.1\n    C 1.0 0.0\n}\n```\nPrefixed form: `dyn.dsys` / `dynamics.dsys`. See docs/language/dynamics-dsl.md.")
    tl_push(out, "horizon")
    tl_push(out, "15")
    tl_push(out, "dynamics DSL")
    tl_push(out, "horizon ${1:rollout} finite ${2:50}")
    tl_push(out, "**`horizon`** - name a finite or infinite analysis horizon.\n\n```flow\ndyn.horizon rollout finite 50\ndyn.horizon asymptotic infinite gamma 0.99\n```")
    tl_push(out, "sense on")
    tl_push(out, "15")
    tl_push(out, "dynamics DSL")
    tl_push(out, "sense on ${1:plant} {\n    controllable -> ${2:plant_ok}\n    spectral -> ${3:rho_open}\n}")
    tl_push(out, "**`sense on`** - open-loop analysis bindings.\n\n```flow\ndyn.sense on plant {\n    controllable -> plant_ok\n    spectral -> rho_open\n    gramian finite rollout trace -> wc_fin\n}\n```")
    tl_push(out, "ga evolve")
    tl_push(out, "15")
    tl_push(out, "dynamics DSL")
    tl_push(out, "ga evolve on ${1:plant} over ${2:rollout} -> ${3:k1} ${4:k2} {\n    population 12\n    generations 30\n    mutation 0.3\n}")
    tl_push(out, "**`ga evolve`** - genetic search for state-feedback gains.\n\n```flow\ndyn.ga evolve on plant over rollout -> k1 k2 {\n    population 12\n    generations 30\n    mutation 0.3\n}\n```")
    tl_push(out, "closed")
    tl_push(out, "15")
    tl_push(out, "dynamics DSL")
    tl_push(out, "closed ${1:plant} with ${2:k1} ${3:k2} {\n    spectral -> ${4:rho_cl}\n    stable -> ${5:stable_cl}\n}")
    tl_push(out, "**`closed`** - certify closed-loop `A - B K`.\n\n```flow\ndyn.closed plant with k1 k2 {\n    spectral -> rho_cl\n    energy over rollout -> E_cl\n    stable -> stable_cl\n}\n```")
    tl_push(out, "analyze")
    tl_push(out, "15")
    tl_push(out, "dynamics DSL")
    tl_push(out, "analyze ${1:plant} ga ${2:k1} ${3:k2} over ${4:rollout} -> ${5:report} {\n    full\n}")
    tl_push(out, "**`analyze`** - one-shot GA + controllability + Gramian report.\n\n```flow\ndyn.analyze plant ga k1 k2 over rollout -> report { full }\n```\nBinds a `GAAnalysisReport` and assigns `k1`/`k2`.")
    tl_push(out, "controllable")
    tl_push(out, "14")
    tl_push(out, "sense binding")
    tl_push(out, "\001")
    tl_push(out, "`controllable -> name` - bind `i32` 1 if rank(ctrb)==n (sense block).")
    tl_push(out, "spectral")
    tl_push(out, "14")
    tl_push(out, "sense/closed binding")
    tl_push(out, "\001")
    tl_push(out, "`spectral -> name` - bind spectral radius `f64` (sense/closed).")
    tl_push(out, "gramian finite")
    tl_push(out, "14")
    tl_push(out, "sense Gramian binding")
    tl_push(out, "\001")
    tl_push(out, "`gramian finite HZ trace -> name` / `gramian infinite HZ trace -> name` - bind controllability Gramian trace (sense block).")
    tl_push(out, "gramian infinite")
    tl_push(out, "14")
    tl_push(out, "sense Gramian binding")
    tl_push(out, "\001")
    tl_push(out, "`gramian finite HZ trace -> name` / `gramian infinite HZ trace -> name` - bind controllability Gramian trace (sense block).")
    tl_push(out, "stable")
    tl_push(out, "14")
    tl_push(out, "closed-loop stability binding")
    tl_push(out, "\001")
    tl_push(out, "`stable -> name` - bind `i32` 1 if closed-loop |\316\273|_max < 1.")
    tl_push(out, "energy over")
    tl_push(out, "14")
    tl_push(out, "closed-loop energy binding")
    tl_push(out, "\001")
    tl_push(out, "`energy over HZ -> name` - bind trajectory energy over a horizon (closed).")
    tl_push(out, "population")
    tl_push(out, "14")
    tl_push(out, "GA setting")
    tl_push(out, "\001")
    tl_push(out, "GA population size (default 8).")
    tl_push(out, "generations")
    tl_push(out, "14")
    tl_push(out, "GA setting")
    tl_push(out, "\001")
    tl_push(out, "GA generations (default 20, max 32).")
    tl_push(out, "mutation")
    tl_push(out, "14")
    tl_push(out, "GA setting")
    tl_push(out, "\001")
    tl_push(out, "GA mutation rate (default 0.3).")
    tl_push(out, "discrete")
    tl_push(out, "14")
    tl_push(out, "dsys mode")
    tl_push(out, "\001")
    tl_push(out, "Plant is discrete-time: `x[k+1] = A x[k] + B u[k]`.")
    tl_push(out, "continuous")
    tl_push(out, "14")
    tl_push(out, "dsys mode")
    tl_push(out, "\001")
    tl_push(out, "Plant is continuous-time; Euler-discretized at `dt` before analysis.")
    tl_push(out, "full")
    tl_push(out, "14")
    tl_push(out, "analyze report mode")
    tl_push(out, "\001")
    tl_push(out, "")
}

# ordering_completion_items(""): every ordering snippet and keyword.
# Five strings per item: label, kind, detail, insertText ("\001" when
# the item has none) and documentation.
export function ordering_completion_table(out: ptr<TList>) {
    tl_push(out, "sort")
    tl_push(out, "15")
    tl_push(out, "Declarative ascending sort")
    tl_push(out, "${1:xs} |> sort")
    tl_push(out, "**`sort`** - declarative ordering (Phase 1).\n\n```flow\nxs |> sort\nxs |> sort descending\nxs |> sort by .score\nxs |> sortBy [desc .score, asc .name]\n```\nIn-place on `array<T, N>`. See docs/language/ordering.md.")
    tl_push(out, "sortBy")
    tl_push(out, "15")
    tl_push(out, "Multi-key declarative sort")
    tl_push(out, "${1:xs} |> sortBy [${2|asc,desc|} .${3:score}, ${4|asc,desc|} .${5:name}]")
    tl_push(out, "**`sortBy`** - multi-key ordering alias for `sort by [...]`.\n\n```flow\nxs |> sortBy [asc .score, asc .name]\n```")
    tl_push(out, "sort by")
    tl_push(out, "15")
    tl_push(out, "Sort by one field")
    tl_push(out, "${1:xs} |> sort by .${2:field}")
    tl_push(out, "**`sort`** - declarative ordering (Phase 1).\n\n```flow\nxs |> sort\nxs |> sort descending\nxs |> sort by .score\nxs |> sortBy [desc .score, asc .name]\n```\nIn-place on `array<T, N>`. See docs/language/ordering.md.")
    tl_push(out, "sort descending")
    tl_push(out, "15")
    tl_push(out, "Declarative descending sort")
    tl_push(out, "${1:xs} |> sort descending")
    tl_push(out, "**`sort`** - declarative ordering (Phase 1).\n\n```flow\nxs |> sort\nxs |> sort descending\nxs |> sort by .score\nxs |> sortBy [desc .score, asc .name]\n```\nIn-place on `array<T, N>`. See docs/language/ordering.md.")
    tl_push(out, "asc")
    tl_push(out, "15")
    tl_push(out, "Ascending sort key")
    tl_push(out, "asc .${1:field}")
    tl_push(out, "`asc .field` - ascending key in a sort key list.")
    tl_push(out, "desc")
    tl_push(out, "15")
    tl_push(out, "Descending sort key")
    tl_push(out, "desc .${1:field}")
    tl_push(out, "`desc .field` - descending key in a sort key list.")
    tl_push(out, "unique")
    tl_push(out, "14")
    tl_push(out, "ordering")
    tl_push(out, "\001")
    tl_push(out, "`sort unique` - sort then compact adjacent duplicates (prefix; N unchanged).")
    tl_push(out, "entropy")
    tl_push(out, "14")
    tl_push(out, "ordering")
    tl_push(out, "\001")
    tl_push(out, "`with entropy` / `with entropy(seed: N)` - allow randomized strategies (parsed; Phase 2).")
    tl_push(out, "order")
    tl_push(out, "14")
    tl_push(out, "ordering")
    tl_push(out, "\001")
    tl_push(out, "`order` - declarative ordering head (same family as `sort`).")
}

