# @module tools.project_test
# @means  `flow test` in a Flow project: discover, compile and run the
#         project's tests. Replaces src/flow/project_test_runner.py.
#
# A project test is either a native `test "name" { ... }` block or a
# standalone program whose `main()` returns zero on success. Native blocks
# run one at a time: the file is copied to a hidden wrapper where every test
# header becomes a function and a generated main() calls the selected one.
# Only the header text changes, so line numbers in test bodies stay put.
#
# Sibling goldens: foo.expected, foo.expected-stderr, foo.exitcode for a
# program; foo.<slug>.expected (and so on) for a named test, where <slug> is
# the one `flow test --list` implies.
#
# Programs are compiled by the same driver as `flow compile` and the binary
# runs directly, so compiler chatter never reaches the goldens. The runner
# forks and execs each step itself, with a timeout.
#
# The launcher passes FLOW_TEST_DRIVER (the flow command) and FLOW_TEST_BUILD_DIR
# (where `flow compile` leaves binaries).

import "tools/hostlib/text.flow"
import "tools/hostlib/sys.flow"

# mkstemps and mkdtemp take char* in glibc's stdlib.h and live in unistd.h
# on macOS. A prototype from Flow types clashes with the first, so the tool
# calls them through these wrappers.
@cEmbed("#ifdef __APPLE__
int mkstemps(char *, int);
char *mkdtemp(char *);
#endif
static inline int32_t flow_mkstemps(uint8_t *t, int32_t n) { return mkstemps((char *)t, n); }
static inline uint8_t *flow_mkdtemp(uint8_t *t) { return (uint8_t *)mkdtemp((char *)t); }
")

extern {
    function printf(fmt: string, ...) -> i32
    function fflush(fp: ptr<void>) -> i32
    function snprintf(buf: ptr<u8>, n: i64, fmt: string, ...) -> i32
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function strcmp(a: string, b: string) -> i32
    function strtod(s: string, end: ptr<ptr<u8>>) -> f64
    function readlink(path: string, buf: ptr<u8>, size: i64) -> i64
    function getcwd(buf: ptr<u8>, size: i64) -> ptr<u8>
    function opendir(path: string) -> ptr<void>
    function closedir(d: ptr<void>) -> i32
    function remove(path: string) -> i32
    function flow_mkstemps(template: ptr<u8>, suffixlen: i32) -> i32
    function flow_mkdtemp(template: ptr<u8>) -> ptr<u8>
    function close(fd: i32) -> i32
    function fork() -> i32
    function execvp(file: string, argv: ptr<string>) -> i32
    function waitpid(pid: i32, status: ptr<i32>, options: i32) -> i32
    function kill(pid: i32, sig: i32) -> i32
    function usleep(us: i32) -> i32
    function _exit(code: i32) -> void
    function chdir(path: string) -> i32
    function setenv(name: string, value: string, overwrite: i32) -> i32
    function fopen(path: string, mode: string) -> ptr<void>
    function open(path: string, flags: i32) -> i32
    function dup2(a: i32, b: i32) -> i32
    function clock_gettime(clk: i32, ts: ptr<i64>) -> i32
    function exit(code: i32) -> void
}

# ── Output ──────────────────────────────────────────────────────

function out(s: string) {
    printf("%s", s)
}

function outln(s: string) {
    printf("%s\n", s)
}

function errln(s: string) {
    fflush(null)
    let line: string = s + "\n"
    t_write_fd(2, line as ptr<u8>, t_len(line))
}

function fmt_f3(x: f64) -> string {
    let buf: ptr<u8> = malloc(64) as ptr<u8>
    snprintf(buf, 64, "%.3f", x)
    return buf as string
}

# Python's format(x, "g").
function fmt_g(x: f64) -> string {
    let buf: ptr<u8> = malloc(64) as ptr<u8>
    snprintf(buf, 64, "%g", x)
    return buf as string
}

# Python's \s for ASCII text.
function is_ws(c: i32) -> bool {
    if c == 32 {
        return true
    }
    if c >= 9 and c <= 13 {
        return true
    }
    return c >= 28 and c <= 31
}

function is_alnum(c: i32) -> bool {
    if c >= 48 and c <= 57 {
        return true
    }
    if c >= 65 and c <= 90 {
        return true
    }
    return c >= 97 and c <= 122
}

# Python's repr() of a str with printable ASCII content.
function py_repr(s: string) -> string {
    let mut quote: i32 = 39
    if t_find_char(s, 39) >= 0 and t_find_char(s, 34) < 0 {
        quote = 34
    }
    let mut tb: TBuf = tb_new()
    tb_putc(&tb, quote)
    let n: i32 = t_len(s)
    let mut i: i32 = 0
    while i < n {
        let c: i32 = t_at(s, i)
        if c == 92 {
            tb_puts(&tb, "\\\\")
        } elif c == quote {
            tb_putc(&tb, 92)
            tb_putc(&tb, c)
        } elif c == 10 {
            tb_puts(&tb, "\\n")
        } elif c == 13 {
            tb_puts(&tb, "\\r")
        } elif c == 9 {
            tb_puts(&tb, "\\t")
        } elif c < 32 or c == 127 {
            let buf: ptr<u8> = malloc(8) as ptr<u8>
            snprintf(buf, 8, "\\x%02x", c)
            tb_puts(&tb, buf as string)
        } else {
            tb_putc(&tb, c)
        }
        i = i + 1
    }
    tb_putc(&tb, quote)
    return tb_str(&tb)
}

# str.splitlines() for the separators ASCII output can hold.
function split_lines(s: string) -> TList {
    let mut l: TList = tl_new()
    let n: i32 = t_len(s)
    let mut start: i32 = 0
    let mut i: i32 = 0
    while i < n {
        let c: i32 = t_at(s, i)
        if c == 10 or c == 11 or c == 12 or (c >= 28 and c <= 30) {
            tl_push(&l, t_sub(s, start, i))
            start = i + 1
        } elif c == 13 {
            tl_push(&l, t_sub(s, start, i))
            if i + 1 < n and t_at(s, i + 1) == 10 {
                i = i + 1
            }
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        tl_push(&l, t_sub(s, start, n))
    }
    return l
}

function rstrip_nl(s: string) -> string {
    let mut end: i32 = t_len(s)
    while end > 0 and t_at(s, end - 1) == 10 {
        end = end - 1
    }
    return t_sub(s, 0, end)
}

# print("\n".join("    " + line for line in text.rstrip("\n").splitlines()))
function print_indented(text: string) {
    let lines: TList = split_lines(rstrip_nl(text))
    let mut tb: TBuf = tb_new()
    let mut i: i32 = 0
    while i < lines.len {
        if i > 0 {
            tb_putc(&tb, 10)
        }
        tb_puts(&tb, "    ")
        tb_puts(&tb, tl_get(&lines, i))
        i = i + 1
    }
    outln(tb_str(&tb))
}

function sort_list(l: ptr<TList>) {
    let mut i: i32 = 1
    while i < l.len {
        let v: string = tl_get(l, i)
        let mut j: i32 = i - 1
        while j >= 0 and strcmp(tl_get(l, j), v) > 0 {
            tl_set(l, j + 1, tl_get(l, j))
            j = j - 1
        }
        tl_set(l, j + 1, v)
        i = i + 1
    }
}

# ── Paths ───────────────────────────────────────────────────────
function find_project_root(start: string) -> string {
    let mut current: string = resolve(start)
    if is_file(current) {
        current = dirname(current)
    }
    let mut c: string = current
    while true {
        if is_file(join_path(c, "flow.toml")) {
            return c
        }
        if t_eq(c, "/") {
            break
        }
        c = dirname(c)
    }
    return current
}

# ── flow.toml [test] ────────────────────────────────────────────

# One [test] value: kind is "str", "array", "num", "other" or "" (absent).
struct TomlVal {
    kind: string,
    text: string,
    items: TList
}

struct TestConfig {
    paths: TomlVal,
    backend: TomlVal,
    timeout: TomlVal
}

function toml_absent() -> TomlVal {
    return TomlVal { kind: "", text: "", items: tl_new() }
}

# Strip a trailing comment outside strings.
function strip_comment(s: string) -> string {
    let n: i32 = t_len(s)
    let mut quote: i32 = 0
    let mut i: i32 = 0
    while i < n {
        let c: i32 = t_at(s, i)
        if quote != 0 {
            if c == 92 and quote == 34 {
                i = i + 1
            } elif c == quote {
                quote = 0
            }
        } elif c == 34 or c == 39 {
            quote = c
        } elif c == 35 {
            return t_sub(s, 0, i)
        }
        i = i + 1
    }
    return s
}

# Parse one TOML string at s[i] (quote char there). Returns the decoded
# text; *end receives the index after the closing quote.
function toml_string(s: string, i: i32, end: ptr<i32>) -> string {
    let q: i32 = t_at(s, i)
    let n: i32 = t_len(s)
    let mut tb: TBuf = tb_new()
    let mut j: i32 = i + 1
    while j < n and t_at(s, j) != q {
        let c: i32 = t_at(s, j)
        if c == 92 and q == 34 and j + 1 < n {
            let e: i32 = t_at(s, j + 1)
            if e == 110 {
                tb_putc(&tb, 10)
            } elif e == 116 {
                tb_putc(&tb, 9)
            } elif e == 114 {
                tb_putc(&tb, 13)
            } else {
                tb_putc(&tb, e)
            }
            j = j + 2
        } else {
            tb_putc(&tb, c)
            j = j + 1
        }
    }
    end[0] = j + 1
    return tb_str(&tb)
}

function toml_value(raw: string) -> TomlVal {
    let v: string = t_strip(raw)
    let mut r: TomlVal = toml_absent()
    if t_len(v) == 0 {
        return r
    }
    let c: i32 = t_at(v, 0)
    let endp: ptr<i32> = malloc(4) as ptr<i32>
    if c == 34 or c == 39 {
        r.kind = "str"
        r.text = toml_string(v, 0, endp)
        return r
    }
    if c == 91 {
        r.kind = "array"
        let n: i32 = t_len(v)
        let mut i: i32 = 1
        while i < n {
            let d: i32 = t_at(v, i)
            if d == 34 or d == 39 {
                tl_push(&r.items, toml_string(v, i, endp))
                i = endp[0]
            } elif d == 93 {
                break
            } elif d == 44 or is_ws(d) {
                i = i + 1
            } else {
                let mut j: i32 = i
                while j < n and t_at(v, j) != 44 and t_at(v, j) != 93 and not is_ws(t_at(v, j)) {
                    j = j + 1
                }
                tl_push(&r.items, t_sub(v, i, j))
                i = j
            }
        }
        return r
    }
    if (c >= 48 and c <= 57) or c == 43 or c == 45 {
        r.kind = "num"
        r.text = v
        return r
    }
    r.kind = "other"
    r.text = v
    return r
}

function load_test_config(root: string) -> TestConfig {
    let mut cfg: TestConfig = TestConfig { paths: toml_absent(), backend: toml_absent(), timeout: toml_absent() }
    let path: string = join_path(root, "flow.toml")
    if not is_file(path) {
        return cfg
    }
    let lines: TList = split_lines(universal(t_read_file(path)))
    let mut in_test: bool = false
    let mut i: i32 = 0
    while i < lines.len {
        let line: string = t_strip(strip_comment(tl_get(&lines, i)))
        i = i + 1
        if t_len(line) == 0 {
            continue
        }
        if t_starts_with(line, "[") {
            in_test = t_eq(line, "[test]")
            continue
        }
        if not in_test {
            continue
        }
        let eq: i32 = t_find_char(line, 61)
        if eq < 0 {
            continue
        }
        let mut key: string = t_strip(t_sub(line, 0, eq))
        if t_len(key) >= 2 and (t_at(key, 0) == 34 or t_at(key, 0) == 39) {
            key = t_sub(key, 1, t_len(key) - 1)
        }
        let mut value: string = t_from(line, eq + 1)
        # A multi-line array runs to its closing bracket.
        if t_starts_with(t_strip(value), "[") {
            while t_find_char(value, 93) < 0 and i < lines.len {
                value = value + " " + strip_comment(tl_get(&lines, i))
                i = i + 1
            }
        }
        let parsed: TomlVal = toml_value(value)
        if t_eq(key, "paths") {
            cfg.paths = parsed
        } elif t_eq(key, "backend") {
            cfg.backend = parsed
        } elif t_eq(key, "timeout") {
            cfg.timeout = parsed
        }
    }
    return cfg
}

# ── Native tests ────────────────────────────────────────────────

# One `test "name" {` header: [start, end) is the text a match covers,
# indent_end the end of the leading blanks.
struct Header {
    start: i32,
    indent_end: i32,
    end: i32,
    raw: string
}

struct Headers {
    items: ptr<Header>,
    len: i32
}

# Where the next line starts at or after i, or -1.
function next_line(s: string, i: i32) -> i32 {
    let n: i32 = t_len(s)
    let mut j: i32 = i
    while j < n {
        if t_at(s, j) == 10 {
            return j + 1
        }
        j = j + 1
    }
    return -1
}

# (?m)^([ \t]*)test\s+"((?:[^"\\]|\\.)*)"\s*\{ at line start ls, or -1.
function match_header(s: string, ls: i32, h: ptr<Header>) -> bool {
    let n: i32 = t_len(s)
    let mut i: i32 = ls
    while i < n and (t_at(s, i) == 32 or t_at(s, i) == 9) {
        i = i + 1
    }
    let indent_end: i32 = i
    if i + 4 > n or not t_eq(t_sub(s, i, i + 4), "test") {
        return false
    }
    i = i + 4
    let ws_start: i32 = i
    while i < n and is_ws(t_at(s, i)) {
        i = i + 1
    }
    if i == ws_start or i >= n or t_at(s, i) != 34 {
        return false
    }
    i = i + 1
    let name_start: i32 = i
    while true {
        if i >= n {
            return false
        }
        let c: i32 = t_at(s, i)
        if c == 34 {
            break
        }
        if c == 92 {
            if i + 1 >= n or t_at(s, i + 1) == 10 {
                return false
            }
            i = i + 2
        } else {
            i = i + 1
        }
    }
    let name_end: i32 = i
    i = i + 1
    while i < n and is_ws(t_at(s, i)) {
        i = i + 1
    }
    if i >= n or t_at(s, i) != 123 {
        return false
    }
    h.start = ls
    h.indent_end = indent_end
    h.end = i + 1
    h.raw = t_sub(s, name_start, name_end)
    return true
}

function find_headers(s: string) -> Headers {
    let mut cap: i32 = 16
    let mut items: ptr<Header> = malloc((cap as i64) * 64) as ptr<Header>
    let mut len: i32 = 0
    let mut pos: i32 = 0
    let mut h: Header = Header { start: 0, indent_end: 0, end: 0, raw: "" }
    while pos >= 0 and pos <= t_len(s) {
        if match_header(s, pos, &h) {
            if len >= cap {
                let bigger: ptr<Header> = malloc(((cap * 2) as i64) * 64) as ptr<Header>
                let mut k: i32 = 0
                while k < len {
                    bigger[k] = items[k]
                    k = k + 1
                }
                items = bigger
                cap = cap * 2
            }
            items[len] = h
            len = len + 1
            pos = next_line(s, h.end)
        } else {
            pos = next_line(s, pos)
        }
    }
    return Headers { items: items, len: len }
}

function hex_val(c: i32) -> i32 {
    if c >= 48 and c <= 57 {
        return c - 48
    }
    if c >= 97 and c <= 102 {
        return c - 87
    }
    if c >= 65 and c <= 70 {
        return c - 55
    }
    return -1
}

function put_utf8(tb: ptr<TBuf>, cp: i32) {
    if cp < 128 {
        tb_putc(tb, cp)
    } elif cp < 2048 {
        tb_putc(tb, 192 | (cp >> 6))
        tb_putc(tb, 128 | (cp & 63))
    } elif cp < 65536 {
        tb_putc(tb, 224 | (cp >> 12))
        tb_putc(tb, 128 | ((cp >> 6) & 63))
        tb_putc(tb, 128 | (cp & 63))
    } else {
        tb_putc(tb, 240 | (cp >> 18))
        tb_putc(tb, 128 | ((cp >> 12) & 63))
        tb_putc(tb, 128 | ((cp >> 6) & 63))
        tb_putc(tb, 128 | (cp & 63))
    }
}

# json.loads('"' + raw + '"'), or raw when that fails.
function decode_name(raw: string) -> string {
    let n: i32 = t_len(raw)
    let mut tb: TBuf = tb_new()
    let mut i: i32 = 0
    while i < n {
        let c: i32 = t_at(raw, i)
        if c < 32 {
            return raw
        }
        if c != 92 {
            tb_putc(&tb, c)
            i = i + 1
            continue
        }
        if i + 1 >= n {
            return raw
        }
        let e: i32 = t_at(raw, i + 1)
        if e == 34 or e == 92 or e == 47 {
            tb_putc(&tb, e)
        } elif e == 98 {
            tb_putc(&tb, 8)
        } elif e == 102 {
            tb_putc(&tb, 12)
        } elif e == 110 {
            tb_putc(&tb, 10)
        } elif e == 114 {
            tb_putc(&tb, 13)
        } elif e == 116 {
            tb_putc(&tb, 9)
        } elif e == 117 {
            if i + 6 > n {
                return raw
            }
            let mut cp: i32 = 0
            let mut k: i32 = 2
            while k < 6 {
                let h: i32 = hex_val(t_at(raw, i + k))
                if h < 0 {
                    return raw
                }
                cp = cp * 16 + h
                k = k + 1
            }
            put_utf8(&tb, cp)
            i = i + 4
        } else {
            return raw
        }
        i = i + 2
    }
    return tb_str(&tb)
}

# re.sub(r"[^A-Za-z0-9]+", "_", text).strip("_").lower() or "case".
function slug(text: string) -> string {
    let mut tb: TBuf = tb_new()
    let n: i32 = t_len(text)
    let mut in_run: bool = false
    let mut i: i32 = 0
    while i < n {
        let c: i32 = t_at(text, i)
        if is_alnum(c) {
            if in_run and tb.len > 0 {
                tb_putc(&tb, 95)
            }
            in_run = false
            if c >= 65 and c <= 90 {
                tb_putc(&tb, c + 32)
            } else {
                tb_putc(&tb, c)
            }
        } else {
            in_run = true
        }
        i = i + 1
    }
    let r: string = tb_str(&tb)
    if t_len(r) == 0 {
        return "case"
    }
    return r
}

struct Natives {
    names: TList,
    slugs: TList,
    fnames: TList,
    headers: Headers
}

function native_tests(source: string) -> Natives {
    let hs: Headers = find_headers(source)
    let mut r: Natives = Natives { names: tl_new(), slugs: tl_new(), fnames: tl_new(), headers: hs }
    let mut used_slugs: TList = tl_new()
    let mut i: i32 = 0
    while i < hs.len {
        let h: Header = hs.items[i]
        let name: string = decode_name(h.raw)
        let base: string = slug(name)
        let mut occurrence: i32 = 1
        let mut k: i32 = 0
        while k < used_slugs.len {
            if t_eq(tl_get(&used_slugs, k), base) {
                occurrence = occurrence + 1
            }
            k = k + 1
        }
        tl_push(&used_slugs, base)
        let mut s: string = base
        if occurrence > 1 {
            s = base + "_" + t_int(occurrence)
        }
        tl_push(&r.names, name)
        tl_push(&r.slugs, s)
        tl_push(&r.fnames, "__flow_test_" + t_int(i) + "_" + s)
        i = i + 1
    }
    return r
}

# (?m)^\s*function\s+main\s*\( anywhere in the text.
function has_main(s: string) -> bool {
    let mut pos: i32 = 0
    while pos >= 0 {
        if match_main(s, pos, false) >= 0 {
            return true
        }
        pos = next_line(s, pos)
    }
    return false
}

# Match `function\s+main\s*\(` after the blanks at line start ls; the
# blanks are [ \t] when tab_only, else \s. Returns the match end or -1.
function match_main(s: string, ls: i32, tab_only: bool) -> i32 {
    let n: i32 = t_len(s)
    let mut i: i32 = ls
    while i < n {
        let c: i32 = t_at(s, i)
        if tab_only {
            if c != 32 and c != 9 {
                break
            }
        } elif not is_ws(c) {
            break
        }
        i = i + 1
    }
    if i + 8 > n or not t_eq(t_sub(s, i, i + 8), "function") {
        return -1
    }
    i = i + 8
    let ws: i32 = i
    while i < n and is_ws(t_at(s, i)) {
        i = i + 1
    }
    if i == ws or i + 4 > n or not t_eq(t_sub(s, i, i + 4), "main") {
        return -1
    }
    i = i + 4
    while i < n and is_ws(t_at(s, i)) {
        i = i + 1
    }
    if i >= n or t_at(s, i) != 40 {
        return -1
    }
    return i + 1
}

# Every test header becomes a void function; main() is renamed; a new
# main() calls the selected test.
function rewrite_native(source: string, nt: ptr<Natives>, selected: i32) -> string {
    let mut tb: TBuf = tb_new()
    let mut pos: i32 = 0
    let mut i: i32 = 0
    while i < nt.headers.len {
        let h: Header = nt.headers.items[i]
        tb_puts(&tb, t_sub(source, pos, h.start))
        tb_puts(&tb, t_sub(source, h.start, h.indent_end))
        tb_puts(&tb, "function " + tl_get(&nt.fnames, i) + "() -> void {")
        pos = h.end
        i = i + 1
    }
    tb_puts(&tb, t_from(source, pos))
    let mut text: string = tb_str(&tb)

    let mut lp: i32 = 0
    while lp >= 0 {
        let m: i32 = match_main(text, lp, true)
        if m >= 0 {
            let mut ie: i32 = lp
            while t_at(text, ie) == 32 or t_at(text, ie) == 9 {
                ie = ie + 1
            }
            text = t_sub(text, 0, ie) + "function __flow_test_original_main(" + t_from(text, m)
            break
        }
        lp = next_line(text, lp)
    }
    return text + "\n\n# Generated by flow test; not written back to the project.\n" + "function main() -> i32 {\n" + "    " + tl_get(&nt.fnames, selected) + "()\n" + "    return 0\n" + "}\n"
}

# ── Discovery ───────────────────────────────────────────────────

function excluded_part(p: string) -> bool {
    return t_eq(p, ".git") or t_eq(p, ".flow-audio-test") or t_eq(p, ".flow-test") or t_eq(p, "build") or t_eq(p, "flow_packages") or t_eq(p, "wip") or t_eq(p, "__pycache__")
}

function discover(targets: ptr<TList>) -> TList {
    let mut found: TList = tl_new()
    let mut t: i32 = 0
    while t < targets.len {
        let target: string = resolve(tl_get(targets, t))
        t = t + 1
        if is_file(target) {
            if t_ends_with(target, ".flow") and t_len(stem(target)) < t_len(basename(target)) {
                if tl_index(&found, target) < 0 {
                    tl_push(&found, target)
                }
            }
            continue
        }
        if not is_dir(target) {
            continue
        }
        let listing: TProc = t_run("find " + t_shq(target) + " -name '*.flow' ! -type d 2>/dev/null")
        let rows: TList = t_split_lines(listing.out)
        let mut k: i32 = 0
        while k < rows.len {
            let path: string = tl_get(&rows, k)
            k = k + 1
            if t_len(path) == 0 {
                continue
            }
            let rel: string = relative(path, target)
            let parts: TList = split_on(rel, 47)
            let mut skip: bool = false
            let mut q: i32 = 0
            while q < parts.len {
                if excluded_part(tl_get(&parts, q)) {
                    skip = true
                }
                q = q + 1
            }
            let name: string = basename(path)
            if skip or t_starts_with(name, "_") or t_starts_with(name, ".flow_test_") {
                continue
            }
            let r: string = resolve(path)
            if tl_index(&found, r) < 0 {
                tl_push(&found, r)
            }
        }
    }
    sort_list(&found)
    return found
}

# ── Filters ─────────────────────────────────────────────────────

# fnmatch.fnmatchcase over bytes.
function glob_match(pat: string, pi: i32, s: string, si: i32) -> bool {
    let pn: i32 = t_len(pat)
    let sn: i32 = t_len(s)
    let mut p: i32 = pi
    let mut i: i32 = si
    while p < pn {
        let c: i32 = t_at(pat, p)
        if c == 42 {
            while p < pn and t_at(pat, p) == 42 {
                p = p + 1
            }
            if p == pn {
                return true
            }
            let mut k: i32 = i
            while k <= sn {
                if glob_match(pat, p, s, k) {
                    return true
                }
                k = k + 1
            }
            return false
        }
        if c == 63 {
            if i >= sn {
                return false
            }
            p = p + 1
            i = i + 1
            continue
        }
        if c == 91 {
            # Find the closing bracket; none means a literal '['.
            let mut j: i32 = p + 1
            if j < pn and t_at(pat, j) == 33 {
                j = j + 1
            }
            if j < pn and t_at(pat, j) == 93 {
                j = j + 1
            }
            while j < pn and t_at(pat, j) != 93 {
                j = j + 1
            }
            if j < pn {
                if i >= sn {
                    return false
                }
                let ch: i32 = t_at(s, i)
                let mut k: i32 = p + 1
                let mut negate: bool = false
                if t_at(pat, k) == 33 {
                    negate = true
                    k = k + 1
                }
                let mut hit: bool = false
                let mut first: bool = true
                while k < j {
                    let a: i32 = t_at(pat, k)
                    if k + 2 < j and t_at(pat, k + 1) == 45 {
                        let b: i32 = t_at(pat, k + 2)
                        if ch >= a and ch <= b {
                            hit = true
                        }
                        k = k + 3
                    } else {
                        if ch == a {
                            hit = true
                        }
                        k = k + 1
                    }
                    first = false
                }
                if hit == negate {
                    return false
                }
                p = j + 1
                i = i + 1
                continue
            }
        }
        if i >= sn or t_at(s, i) != c {
            return false
        }
        p = p + 1
        i = i + 1
    }
    return i == sn
}

function matches_filter(case_id: string, pattern: string) -> bool {
    if t_len(pattern) == 0 {
        return true
    }
    if t_find_char(pattern, 42) >= 0 or t_find_char(pattern, 63) >= 0 or t_find_char(pattern, 91) >= 0 {
        return glob_match(pattern, 0, case_id, 0)
    }
    return t_contains(t_lower(case_id), t_lower(pattern))
}

# ── Processes ───────────────────────────────────────────────────

struct Opts {
    filter: string,
    has_filter: bool,
    list: bool,
    backend: string,
    sanitize: string,
    profile: string,
    host: string,
    timeout: f64,
    fail_fast: bool,
    keep: bool,
    verbose: bool,
    paths: TList
}

struct Result {
    passed: bool,
    duration: f64,
    phase: string,
    message: string,
    stdout: string,
    stderr: string
}

struct Ctx {
    driver: string,
    build_dir: string,
    scratch: string
}

function fail_result(phase: string, message: string, started: f64) -> Result {
    return Result { passed: false, duration: now() - started, phase: phase, message: message, stdout: "", stderr: "" }
}

# int(text.strip()) for the forms an .exitcode file uses; ok false when not
# an integer.
function parse_int(text: string, ok: ptr<bool>) -> i32 {
    let n: i32 = t_len(text)
    let mut i: i32 = 0
    let mut neg: bool = false
    ok[0] = false
    if i < n and (t_at(text, i) == 43 or t_at(text, i) == 45) {
        neg = t_at(text, i) == 45
        i = i + 1
    }
    if i >= n {
        return 0
    }
    let mut v: i32 = 0
    let mut prev_digit: bool = false
    while i < n {
        let c: i32 = t_at(text, i)
        if c >= 48 and c <= 57 {
            v = v * 10 + (c - 48)
            prev_digit = true
        } elif c == 95 and prev_digit and i + 1 < n and t_at(text, i + 1) >= 48 and t_at(text, i + 1) <= 57 {
            prev_digit = false
        } else {
            return 0
        }
        i = i + 1
    }
    ok[0] = true
    if neg {
        return 0 - v
    }
    return v
}

# None when the golden is absent or equal, else the mismatch message.
function compare_golden(actual: string, path: string, label: string) -> string {
    if not is_file(path) {
        return ""
    }
    let expected: string = universal(t_read_file(path))
    if t_eq(actual, expected) {
        return ""
    }
    return label + " mismatch against " + path + "\n--- expected (" + t_int(char_len(expected)) + " bytes)\n+++ actual   (" + t_int(char_len(actual)) + " bytes)"
}

function remove_quiet(path: string) {
    remove(path)
}

function run_case(ctx: ptr<Ctx>, o: ptr<Opts>, source: string, backend: string, nt: ptr<Natives>, native: i32) -> Result {
    let started: f64 = now()
    let text: string = universal(t_read_file(source))
    let mut temp: string = ""
    let mut program: string = source
    let r: Result = run_case_inner(ctx, o, source, backend, nt, native, text, started, &temp, &program)
    if t_len(temp) > 0 and not o.keep and t_file_exists(temp) {
        remove_quiet(temp)
    }
    if not o.keep and not t_eq(program, source) {
        let generated: string = join_path(ctx.build_dir, stem(program))
        remove_quiet(generated)
        remove_quiet(generated + ".c")
        remove_quiet(generated + ".ll")
    }
    return r
}

function run_case_inner(ctx: ptr<Ctx>, o: ptr<Opts>, source: string, backend: string, nt: ptr<Natives>, native: i32, text: string, started: f64, temp: ptr<string>, program: ptr<string>) -> Result {
    if native >= 0 {
        let rewritten: string = rewrite_native(text, nt, native)
        let tmpl: string = dirname(source) + "/.flow_test_" + stem(source) + "_" + t_int(native) + "_XXXXXXXX.flow"
        let buf: ptr<u8> = t_dup(tmpl) as ptr<u8>
        let fd: i32 = flow_mkstemps(buf, 5)
        if fd < 0 {
            return Result { passed: false, duration: 0.0, phase: "runner", message: "cannot create a test wrapper in " + dirname(source), stdout: "", stderr: "" }
        }
        close(fd)
        temp[0] = buf as string
        t_write_file(temp[0], rewritten)
        program[0] = temp[0]
    }

    let mut cmd: TList = tl_new()
    tl_push(&cmd, ctx.driver)
    tl_push(&cmd, "compile")
    tl_push(&cmd, program[0])
    tl_push(&cmd, "--backend=" + backend)
    if t_len(o.sanitize) > 0 {
        tl_push(&cmd, "--sanitize=" + o.sanitize)
    }
    if t_len(o.profile) > 0 {
        tl_push(&cmd, "--profile=" + o.profile)
    }
    let out_path: string = ctx.scratch + "/out"
    let err_path: string = ctx.scratch + "/err"
    let compiled: Proc = spawn(&cmd, "", o.host, out_path, err_path, o.timeout)
    if compiled.timed_out {
        return fail_result("compile", "compile timed out after " + fmt_g(o.timeout) + "s", started)
    }
    let executable: string = join_path(ctx.build_dir, stem(program[0]))
    if compiled.code != 0 or not is_file(executable) {
        let mut r: Result = fail_result("compile", "compiler exited " + t_int(compiled.code), started)
        r.stdout = universal(t_read_file(out_path))
        r.stderr = universal(t_read_file(err_path))
        return r
    }

    let mut run: TList = tl_new()
    tl_push(&run, executable)
    let ran: Proc = spawn(&run, dirname(source), "", out_path, err_path, o.timeout)
    let stdout_text: string = universal(t_read_file(out_path))
    let stderr_text: string = universal(t_read_file(err_path))
    if ran.timed_out {
        let mut r: Result = fail_result("run", "test timed out after " + fmt_g(o.timeout) + "s", started)
        r.stdout = stdout_text
        r.stderr = stderr_text
        return r
    }

    let mut base: string = strip_suffix(source)
    if native >= 0 {
        base = base + "." + tl_get(&nt.slugs, native)
    }
    let mut wanted: i32 = 0
    let exit_path: string = base + ".exitcode"
    if is_file(exit_path) {
        let raw: string = t_strip(universal(t_read_file(exit_path)))
        let ok: ptr<bool> = malloc(1) as ptr<bool>
        wanted = parse_int(raw, ok)
        if not ok[0] {
            return Result { passed: false, duration: 0.0, phase: "runner", message: "invalid exit code in " + exit_path + ": " + py_repr(raw), stdout: "", stderr: "" }
        }
    }
    let mut errors: TList = tl_new()
    if ran.code != wanted {
        tl_push(&errors, "exit code " + t_int(ran.code) + ", expected " + t_int(wanted))
    }
    let so: string = compare_golden(stdout_text, base + ".expected", "stdout")
    let se: string = compare_golden(stderr_text, base + ".expected-stderr", "stderr")
    if t_len(so) > 0 {
        tl_push(&errors, so)
    }
    if t_len(se) > 0 {
        tl_push(&errors, se)
    }
    let mut tb: TBuf = tb_new()
    let mut k: i32 = 0
    while k < errors.len {
        if k > 0 {
            tb_puts(&tb, "; ")
        }
        tb_puts(&tb, tl_get(&errors, k))
        k = k + 1
    }
    return Result { passed: errors.len == 0, duration: now() - started, phase: "run", message: tb_str(&tb), stdout: stdout_text, stderr: stderr_text }
}

# ── Arguments ───────────────────────────────────────────────────

function usage() -> string {
    return "usage: flow test [-h] [--filter FILTER] [--list] [--backend {c,mlir,all}]\n                 [--sanitize SANITIZE] [--profile {safety,flight}]\n                 [--host {flowc,python,auto}] [--timeout TIMEOUT]\n                 [--fail-fast] [--keep] [-v]\n                 [paths ...]\n"
}

function print_help() {
    out(usage())
    out("\nDiscover, compile and run tests in the current Flow project.\n\npositional arguments:\n  paths                 test files/directories; defaults to [test].paths or\n                        tests/\n\n")
    out("options:\n  -h, --help            show this help message and exit\n  --filter FILTER, -f FILTER\n                        substring or glob matched against file::test name\n  --list                list discovered cases without compiling\n  --backend {c,mlir,all}\n")
    out("  --sanitize SANITIZE   ub, asan, tsan, or a comma-separated combination\n  --profile {safety,flight}\n  --host {flowc,python,auto}\n                        override FLOW_HOST for compilation\n  --timeout TIMEOUT     per compile/run timeout in seconds\n  --fail-fast\n  --keep                keep generated native-test wrappers/artifacts\n  -v, --verbose\n")
}

function arg_error(msg: string) {
    fflush(null)
    let text: string = usage() + "flow test: error: " + msg + "\n"
    t_write_fd(2, text as ptr<u8>, t_len(text))
    exit(2)
}

function long_names() -> TList {
    let mut l: TList = tl_new()
    tl_push(&l, "--help")
    tl_push(&l, "--filter")
    tl_push(&l, "--list")
    tl_push(&l, "--backend")
    tl_push(&l, "--sanitize")
    tl_push(&l, "--profile")
    tl_push(&l, "--host")
    tl_push(&l, "--timeout")
    tl_push(&l, "--fail-fast")
    tl_push(&l, "--keep")
    tl_push(&l, "--verbose")
    return l
}

# argparse's name for an option in messages.
function display_name(opt: string) -> string {
    if t_eq(opt, "--filter") {
        return "--filter/-f"
    }
    if t_eq(opt, "--verbose") {
        return "-v/--verbose"
    }
    if t_eq(opt, "--help") {
        return "-h/--help"
    }
    return opt
}

function takes_value(opt: string) -> bool {
    return t_eq(opt, "--filter") or t_eq(opt, "--backend") or t_eq(opt, "--sanitize") or t_eq(opt, "--profile") or t_eq(opt, "--host") or t_eq(opt, "--timeout")
}

# Does a value look like a negative number (argparse lets those through)?
function negative_number(s: string) -> bool {
    if not t_starts_with(s, "-") or t_len(s) < 2 {
        return false
    }
    let mut i: i32 = 1
    let mut dot: bool = false
    while i < t_len(s) {
        let c: i32 = t_at(s, i)
        if c == 46 and not dot {
            dot = true
        } elif c < 48 or c > 57 {
            return false
        }
        i = i + 1
    }
    return true
}

function choice_check(opt: string, v: string, choices: string, shown: string) {
    let parts: TList = split_on(choices, 44)
    if tl_index(&parts, v) < 0 {
        arg_error("argument " + opt + ": invalid choice: " + py_repr(v) + " (choose from " + shown + ")")
    }
}

# float(text) as Python parses it; ok false when it is not a float.
function parse_float(text: string, ok: ptr<bool>) -> f64 {
    let s: string = t_strip(text)
    ok[0] = false
    if t_len(s) == 0 {
        return 0.0
    }
    let endp: ptr<ptr<u8>> = malloc(8) as ptr<ptr<u8>>
    let v: f64 = strtod(s, endp)
    let used: i64 = (endp[0] as i64) - (s as ptr<u8> as i64)
    if used != (t_len(s) as i64) {
        return 0.0
    }
    let low: string = t_lower(s)
    if t_starts_with(low, "0x") or t_starts_with(low, "-0x") or t_starts_with(low, "+0x") {
        return 0.0
    }
    ok[0] = true
    return v
}

function apply_option(o: ptr<Opts>, opt: string, v: string) {
    if t_eq(opt, "--filter") {
        o.filter = v
        o.has_filter = true
    } elif t_eq(opt, "--backend") {
        choice_check(opt, v, "c,mlir,all", "c, mlir, all")
        o.backend = v
    } elif t_eq(opt, "--sanitize") {
        o.sanitize = v
    } elif t_eq(opt, "--profile") {
        choice_check(opt, v, "safety,flight", "safety, flight")
        o.profile = v
    } elif t_eq(opt, "--host") {
        choice_check(opt, v, "flowc,python,auto", "flowc, python, auto")
        o.host = v
    } elif t_eq(opt, "--timeout") {
        let ok: ptr<bool> = malloc(1) as ptr<bool>
        let t: f64 = parse_float(v, ok)
        if not ok[0] {
            arg_error("argument --timeout: invalid float value: " + py_repr(v))
        }
        o.timeout = t
    }
}

function apply_flag(o: ptr<Opts>, opt: string) {
    if t_eq(opt, "--help") {
        print_help()
        fflush(null)
        exit(0)
    } elif t_eq(opt, "--list") {
        o.list = true
    } elif t_eq(opt, "--fail-fast") {
        o.fail_fast = true
    } elif t_eq(opt, "--keep") {
        o.keep = true
    } elif t_eq(opt, "--verbose") {
        o.verbose = true
    }
}

function parse_args(argc: i32, argv: ptr<string>, o: ptr<Opts>) {
    let names: TList = long_names()
    let mut unknown: TList = tl_new()
    let mut rest: bool = false
    let mut i: i32 = 1
    while i < argc {
        let arg: string = argv[i]
        i = i + 1
        if rest or not t_starts_with(arg, "-") or t_eq(arg, "-") or negative_number(arg) {
            tl_push(&o.paths, arg)
            continue
        }
        if t_eq(arg, "--") {
            rest = true
            continue
        }
        let mut opt: string = ""
        let mut inline_value: string = ""
        let mut has_inline: bool = false
        if t_starts_with(arg, "--") {
            let mut name: string = arg
            let eq: i32 = t_find_char(arg, 61)
            if eq >= 0 {
                name = t_sub(arg, 0, eq)
                inline_value = t_from(arg, eq + 1)
                has_inline = true
            }
            if tl_index(&names, name) >= 0 {
                opt = name
            } else {
                let mut hits: TList = tl_new()
                let mut k: i32 = 0
                while k < names.len {
                    if t_starts_with(tl_get(&names, k), name) {
                        tl_push(&hits, tl_get(&names, k))
                    }
                    k = k + 1
                }
                if hits.len == 1 {
                    opt = tl_get(&hits, 0)
                } elif hits.len > 1 {
                    let mut tb: TBuf = tb_new()
                    let mut q: i32 = 0
                    while q < hits.len {
                        if q > 0 {
                            tb_puts(&tb, ", ")
                        }
                        tb_puts(&tb, tl_get(&hits, q))
                        q = q + 1
                    }
                    arg_error("ambiguous option: " + name + " could match " + tb_str(&tb))
                }
            }
        } else {
            let flag: string = t_sub(arg, 0, 2)
            if t_eq(flag, "-h") {
                opt = "--help"
            } elif t_eq(flag, "-v") {
                opt = "--verbose"
            } elif t_eq(flag, "-f") {
                opt = "--filter"
            }
            if t_len(opt) > 0 and t_len(arg) > 2 {
                if takes_value(opt) {
                    inline_value = t_from(arg, 2)
                    has_inline = true
                } else {
                    opt = ""
                }
            }
        }
        if t_len(opt) == 0 {
            tl_push(&unknown, arg)
            continue
        }
        if takes_value(opt) {
            if has_inline {
                apply_option(o, opt, inline_value)
            } else {
                if i >= argc or (t_starts_with(argv[i], "-") and not t_eq(argv[i], "-") and not negative_number(argv[i])) {
                    arg_error("argument " + display_name(opt) + ": expected one argument")
                }
                apply_option(o, opt, argv[i])
                i = i + 1
            }
        } else {
            if has_inline {
                arg_error("argument " + display_name(opt) + ": ignored explicit argument " + py_repr(inline_value))
            }
            apply_flag(o, opt)
        }
    }
    if unknown.len > 0 {
        let mut tb: TBuf = tb_new()
        let mut q: i32 = 0
        while q < unknown.len {
            if q > 0 {
                tb_putc(&tb, 32)
            }
            tb_puts(&tb, tl_get(&unknown, q))
            q = q + 1
        }
        arg_error("unrecognized arguments: " + tb_str(&tb))
    }
}

# ── Main ────────────────────────────────────────────────────────

function fatal(msg: string) -> i32 {
    errln("flow test: " + msg)
    return 2
}

function main(argc: i32, argv: ptr<string>) -> i32 {
    let root: string = find_project_root(cwd())
    let cfg: TestConfig = load_test_config(root)

    let mut default_backend: string = "c"
    if t_len(cfg.backend.kind) > 0 {
        default_backend = cfg.backend.text
    }
    let mut default_timeout: f64 = 30.0
    if t_len(cfg.timeout.kind) > 0 {
        let ok: ptr<bool> = malloc(1) as ptr<bool>
        default_timeout = parse_float(cfg.timeout.text, ok)
        if not ok[0] {
            return fatal("could not convert string to float: " + py_repr(cfg.timeout.text))
        }
    }

    let mut o: Opts = Opts { filter: "", has_filter: false, list: false, backend: default_backend, sanitize: "", profile: "", host: "", timeout: default_timeout, fail_fast: false, keep: false, verbose: false, paths: tl_new() }
    parse_args(argc, argv, &o)

    let mut backends: TList = tl_new()
    if t_eq(o.backend, "all") {
        tl_push(&backends, "c")
        tl_push(&backends, "mlir")
    } elif t_eq(o.backend, "c") or t_eq(o.backend, "mlir") {
        tl_push(&backends, o.backend)
    } else {
        return fatal("unknown backend " + py_repr(o.backend) + "; expected c, mlir, or all")
    }

    let mut targets: TList = tl_new()
    let mut k: i32 = 0
    while k < o.paths.len {
        tl_push(&targets, join_path(root, tl_get(&o.paths, k)))
        k = k + 1
    }
    if targets.len == 0 {
        if t_eq(cfg.paths.kind, "str") {
            tl_push(&targets, resolve(join_path(root, cfg.paths.text)))
        } elif t_eq(cfg.paths.kind, "array") {
            let mut q: i32 = 0
            while q < cfg.paths.items.len {
                tl_push(&targets, resolve(join_path(root, tl_get(&cfg.paths.items, q))))
                q = q + 1
            }
        } elif t_len(cfg.paths.kind) == 0 {
            tl_push(&targets, resolve(join_path(root, "tests")))
        } else {
            return fatal("[test].paths must be a string or array of strings")
        }
    }
    let files: TList = discover(&targets)

    # Cases: parallel lists; native is the test index or -1.
    let mut c_source: TList = tl_new()
    let mut c_display: TList = tl_new()
    let mut c_backend: TList = tl_new()
    let mut c_native: TList = tl_new()
    let mut c_file: TList = tl_new()
    let nts: ptr<Natives> = malloc(((files.len + 1) as i64) * 256) as ptr<Natives>
    let mut f: i32 = 0
    while f < files.len {
        let path: string = tl_get(&files, f)
        let source: string = universal(t_read_file(path))
        nts[f] = native_tests(source)
        let rel: string = relative(path, root)
        let count: i32 = nts[f].names.len
        let mut b: i32 = 0
        if count > 0 {
            while b < backends.len {
                let mut j: i32 = 0
                while j < count {
                    let display: string = rel + "::" + tl_get(&nts[f].names, j)
                    if matches_filter(display, o.filter) {
                        tl_push(&c_source, path)
                        tl_push(&c_display, display)
                        tl_push(&c_backend, tl_get(&backends, b))
                        tl_push(&c_native, t_int(j))
                        tl_push(&c_file, t_int(f))
                    }
                    j = j + 1
                }
                b = b + 1
            }
        } elif has_main(source) {
            while b < backends.len {
                if matches_filter(rel, o.filter) {
                    tl_push(&c_source, path)
                    tl_push(&c_display, rel)
                    tl_push(&c_backend, tl_get(&backends, b))
                    tl_push(&c_native, "-1")
                    tl_push(&c_file, t_int(f))
                }
                b = b + 1
            }
        }
        f = f + 1
    }
    let total: i32 = c_source.len

    if total == 0 {
        let mut tb: TBuf = tb_new()
        let mut q: i32 = 0
        while q < targets.len {
            if q > 0 {
                tb_puts(&tb, ", ")
            }
            tb_puts(&tb, relative(tl_get(&targets, q), root))
            q = q + 1
        }
        return fatal("no runnable tests found (" + tb_str(&tb) + ")")
    }

    if o.list {
        let mut q: i32 = 0
        while q < total {
            let mut line: string = tl_get(&c_display, q)
            if backends.len > 1 {
                line = line + " [" + tl_get(&c_backend, q) + "]"
            }
            outln(line)
            q = q + 1
        }
        outln("\n" + t_int(total) + " test case(s)")
        return 0
    }

    let mut backend_text: string = tl_get(&backends, 0)
    if backends.len > 1 {
        backend_text = backend_text + "," + tl_get(&backends, 1)
    }
    outln("running " + t_int(total) + " tests (backend=" + backend_text + ")")

    let scratch_tmpl: string = t_env("TMPDIR", "/tmp")
    let sbuf: ptr<u8> = t_dup(scratch_tmpl + "/flow-test.XXXXXX") as ptr<u8>
    if flow_mkdtemp(sbuf) == null {
        return fatal("cannot create a scratch directory")
    }
    let mut ctx: Ctx = Ctx { driver: resolve(t_env("FLOW_TEST_DRIVER", "flow")), build_dir: resolve(t_env("FLOW_TEST_BUILD_DIR", "build")), scratch: sbuf as string }

    let mut failures: i32 = 0
    let mut passed: i32 = 0
    let started: f64 = now()
    let mut q: i32 = 0
    while q < total {
        let mut label: string = tl_get(&c_display, q)
        if backends.len > 1 {
            label = label + " [" + tl_get(&c_backend, q) + "]"
        }
        out("test " + label + " ... ")
        fflush(null)
        let fi: i32 = parse_int(tl_get(&c_file, q), malloc(1) as ptr<bool>)
        let ni: i32 = parse_int(tl_get(&c_native, q), malloc(1) as ptr<bool>)
        let r: Result = run_case(&ctx, &o, tl_get(&c_source, q), tl_get(&c_backend, q), &nts[fi], ni)
        q = q + 1
        if r.passed {
            passed = passed + 1
            outln("ok (" + fmt_f3(r.duration) + "s)")
            if o.verbose {
                if t_len(r.stdout) > 0 {
                    outln("  stdout:")
                    print_indented(r.stdout)
                }
                if t_len(r.stderr) > 0 {
                    outln("  stderr:")
                    print_indented(r.stderr)
                }
            }
            continue
        }
        failures = failures + 1
        outln("FAILED (" + r.phase + ", " + fmt_f3(r.duration) + "s)")
        if t_len(r.message) > 0 {
            outln("  " + replace_nl(r.message))
        }
        if t_len(r.stdout) > 0 {
            outln("  stdout:")
            print_indented(r.stdout)
        }
        if t_len(r.stderr) > 0 {
            outln("  stderr:")
            print_indented(r.stderr)
        }
        if o.fail_fast {
            break
        }
    }
    t_run("rm -rf " + t_shq(ctx.scratch))

    let elapsed: f64 = now() - started
    let ran: i32 = passed + failures
    let mut status: string = "ok"
    if failures > 0 {
        status = "FAILED"
    }
    outln("\ntest result: " + status + ". " + t_int(passed) + " passed; " + t_int(failures) + " failed; " + t_int(total - ran) + " not run; finished in " + fmt_f3(elapsed) + "s")
    fflush(null)
    if failures == 0 {
        return 0
    }
    return 1
}

function replace_nl(s: string) -> string {
    let mut tb: TBuf = tb_new()
    let n: i32 = t_len(s)
    let mut i: i32 = 0
    while i < n {
        let c: i32 = t_at(s, i)
        if c == 10 {
            tb_puts(&tb, "\n  ")
        } else {
            tb_putc(&tb, c)
        }
        i = i + 1
    }
    return tb_str(&tb)
}
