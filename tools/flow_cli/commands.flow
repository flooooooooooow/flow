# @module tools.flow_cli.commands
# @means  The smaller `flow` commands: doc and know (proof tooling), fmt,
#         explain, examples, python, wasm, playground, install, repl, ml,
#         and the launchers for the Flow tools (check, lsp, dap, fir-g,
#         gpu, analyze).

import "tools/flow_cli/sys.flow"
import "tools/flow_cli/toolchain.flow"
import "tools/flow_cli/flowc_build.flow"
import "tools/flow_cli/build.flow"
import "tools/flow_cli/tool.flow"
import "tools/flow_cli/mlir_tools.flow"
import std.process { ProcCmd, ProcResult, ProcStrs, proc_arg }

# ---------------------------------------------------------------------------
# Proof tooling: flow doc proof|bundle|basic-bundle|geometry-bundle|kernel,
# flow know (compiler/src/proof_doc.flow)
# ---------------------------------------------------------------------------

# The flowc proof tools with these NAME=value settings, rooted at the
# repository. Status.
function flow_proof_flowc(envs: ptr<ProcStrs>) -> i32 {
    let driver: string = flow_resolve_flowc()
    if s_len(driver) == 0 {
        return 1
    }
    let c: ptr<ProcCmd> = cmd(sl_of1(driver))
    cmd_env(c, "FLOWC_PROOF_DOC", "1")
    cmd_env(c, "FLOWC_PROOF_ROOT", root())
    apply_envs(c, envs)
    return run(c)
}

# a < b with '/' ordered before every other byte (the driver's
# `tr '/' '\001' | LC_ALL=C sort | tr '\001' '/'`).
function path_order_less(a: string, b: string) -> bool {
    let n: i32 = s_len(a)
    let m: i32 = s_len(b)
    let mut i: i32 = 0
    while i < n and i < m {
        let mut x: i32 = s_byte(a, i)
        let mut y: i32 = s_byte(b, i)
        if x == 47 {
            x = 1
        }
        if y == 47 {
            y = 1
        }
        if x != y {
            return x < y
        }
        i = i + 1
    }
    return n < m
}

function sort_paths(l: ptr<ProcStrs>) {
    let n: i32 = sl_len(l)
    let mut i: i32 = 1
    while i < n {
        let cur: string = l.items[i]
        let mut j: i32 = i
        while j > 0 and path_order_less(cur, l.items[j - 1]) {
            l.items[j] = l.items[j - 1]
            j = j - 1
        }
        l.items[j] = cur
        i = i + 1
    }
}

function flow_proof_list_dir(dir: string, recursive: bool) -> ptr<ProcStrs> {
    let f: ptr<ProcStrs> = sl_of1("find")
    sl_push(f, dir)
    if not recursive {
        sl_push2(f, "-maxdepth", "1")
    }
    sl_push2(f, "-name", "*.flow")
    sl_push2(f, "-type", "f")
    let lines: ptr<ProcStrs> = s_lines(capture(cmd(f)))
    sort_paths(lines)
    return lines
}

export function flow_doc_proof(args: ptr<ProcStrs>) -> i32 {
    let mut path: string = ""
    let mut recursive: bool = false
    let mut out_dir: string = ""
    let n: i32 = sl_len(args)
    let mut i: i32 = 0
    while i < n {
        let a: string = sl_get(args, i)
        if s_eq(a, "-r") or s_eq(a, "--recursive") {
            recursive = true
        } elif s_eq(a, "-o") or s_eq(a, "--output-dir") {
            i = i + 1
            out_dir = sl_get(args, i)
        } elif s_starts(a, "--output-dir=") {
            out_dir = s_from(a, 13)
        } else {
            path = a
        }
        i = i + 1
    }
    if s_len(path) == 0 {
        error("Usage: flow doc proof <file.flow|directory> [-r] [-o DIR]")
        return 1
    }
    if not exists(path) {
        errln("Error: path not found: " + path)
        return 1
    }
    if is_file(path) {
        return flow_proof_flowc(sl_of2("FLOWC_IN=" + path, "FLOWC_PROOF_OUT=" + out_dir))
    }
    while s_len(path) > 1 and s_ends(path, "/") {
        path = s_slice(path, 0, s_len(path) - 1)
    }
    let list: string = mktemp_file_default()
    let files: ptr<ProcStrs> = flow_proof_list_dir(path, recursive)
    let mut body: string = ""
    let mut k: i32 = 0
    while k < sl_len(files) {
        body = body + sl_get(files, k) + "\n"
        k = k + 1
    }
    let _w: bool = write_text(list, body)
    let rc: i32 = flow_proof_flowc(sl_of2("FLOWC_PROOF_LIST=" + list, "FLOWC_PROOF_TREE=1"))
    rm_f(list)
    return rc
}

# A LaTeX engine on PATH or in /Library/TeX/texbin; "" when missing.
function flow_latex_engine(name: string) -> string {
    let p: string = which(name)
    if s_len(p) > 0 {
        return p
    }
    if is_exec("/Library/TeX/texbin/" + name) {
        return "/Library/TeX/texbin/" + name
    }
    return ""
}

export function flow_doc_bundle(which_book: string, args: ptr<ProcStrs>) -> i32 {
    let mut out_dir: string = root() + "/build/proofs"
    let n: i32 = sl_len(args)
    let mut i: i32 = 0
    while i < n {
        let a: string = sl_get(args, i)
        if s_eq(a, "-o") or s_eq(a, "--output-dir") {
            i = i + 1
            out_dir = sl_get(args, i)
        } elif s_starts(a, "--output-dir=") {
            out_dir = s_from(a, 13)
        }
        i = i + 1
    }
    let mut stem: string = ""
    if s_eq(which_book, "book") {
        stem = "flow-proof-book"
    } elif s_eq(which_book, "basic") {
        stem = "basic-proofs-side-by-side"
    } elif s_eq(which_book, "geometry") {
        stem = "geometry-proofs-side-by-side"
    }
    if flow_proof_flowc(sl_of2("FLOWC_PROOF_BOOK=" + which_book, "FLOWC_PROOF_OUT=" + out_dir)) != 0 {
        return 1
    }
    let abs: string = abs_dir(out_dir)
    rm_f(out_dir + "/" + stem + ".pdf")
    let engines: ptr<ProcStrs> = sl_of3("pdflatex", "xelatex", "tectonic")
    let mut k: i32 = 0
    while k < 3 {
        let name: string = sl_get(engines, k)
        k = k + 1
        let engine: string = flow_latex_engine(name)
        if s_len(engine) == 0 {
            continue
        }
        if s_eq(name, "tectonic") {
            let c: ptr<ProcCmd> = cmd(sl_of3(engine, "--outdir", abs))
            proc_arg(c, abs + "/" + stem + ".tex")
            cmd_cwd(c, abs)
            cmd_quiet(c)
            let _r: i32 = run(c)
        } else {
            let mut pass: i32 = 0
            while pass < 2 {
                let c2: ptr<ProcCmd> = cmd(sl_of3(engine, "-interaction=nonstopmode", stem + ".tex"))
                cmd_cwd(c2, abs)
                cmd_quiet(c2)
                let _r2: i32 = run(c2)
                pass = pass + 1
            }
        }
        if is_file(out_dir + "/" + stem + ".pdf") {
            outln("Wrote " + out_dir + "/" + stem + ".pdf")
            return 0
        }
    }
    errln("Could not compile PDF. Install pdflatex, xelatex, or tectonic.")
    return 1
}

export function flow_doc_kernel(args: ptr<ProcStrs>) -> i32 {
    let mut path: string = ""
    let mut out_file: string = ""
    let mut plot: string = ""
    let mut params: string = ""
    let n: i32 = sl_len(args)
    let mut i: i32 = 0
    while i < n {
        let a: string = sl_get(args, i)
        if s_eq(a, "-p") or s_eq(a, "--param") {
            i = i + 1
            params = params + sl_get(args, i) + "\n"
        } elif s_starts(a, "--param=") {
            params = params + s_from(a, 8) + "\n"
        } elif s_eq(a, "--plot") {
            i = i + 1
            plot = sl_get(args, i)
        } elif s_starts(a, "--plot=") {
            plot = s_from(a, 7)
        } elif s_eq(a, "-o") or s_eq(a, "--output") {
            i = i + 1
            out_file = sl_get(args, i)
        } elif s_starts(a, "--output=") {
            out_file = s_from(a, 9)
        } else {
            path = a
        }
        i = i + 1
    }
    if s_len(path) == 0 {
        error("Usage: flow doc kernel <file.flow> [--param n=0] [--plot out.dot]")
        return 1
    }
    let envs: ptr<ProcStrs> = sl_of3("FLOWC_PROOF_KERNEL=1", "FLOWC_IN=" + path, "FLOWC_KERNEL_OUT=" + out_file)
    sl_push2(envs, "FLOWC_KERNEL_PARAMS=" + params, "FLOWC_KERNEL_PLOT=" + plot)
    if flow_proof_flowc(envs) != 0 {
        return 1
    }
    if s_ends(plot, ".png") or s_ends(plot, ".pdf") or s_ends(plot, ".svg") {
        if have("dot") {
            let d: ptr<ProcStrs> = sl_of3("dot", "-T" + path_ext(plot), "-o")
            sl_push2(d, plot, path_drop_ext(plot) + ".dot")
            let rc: i32 = run_argv(d)
            if rc == 0 {
                outln("Wrote " + plot)
            }
            return rc
        }
    }
    return 0
}

export function flow_know(args: ptr<ProcStrs>) -> i32 {
    let mut query: string = ""
    let mut lint: i32 = 0
    let mut i: i32 = 0
    while i < sl_len(args) {
        let a: string = sl_get(args, i)
        if s_eq(a, "--lint-duplicates") {
            lint = 1
        } elif s_eq(a, "-h") or s_eq(a, "--help") {
            query = ""
            lint = 2
        } else {
            query = a
        }
        i = i + 1
    }
    if lint == 1 {
        return flow_proof_flowc(sl_of1("FLOWC_KNOW_LINT=1"))
    }
    if s_len(query) == 0 {
        outln("usage: flow know [-h] [--lint-duplicates] [path]")
        outln("")
        outln("Look up a Flow Claim Path, e.g. Nat/+.zero-right or verify.Nat/+.zero-right")
        return 1
    }
    return flow_proof_flowc(sl_of1("FLOWC_KNOW=" + query))
}

export function cmd_doc(args: ptr<ProcStrs>) -> i32 {
    let sub: string = sl_get(args, 0)
    let rest: ptr<ProcStrs> = sl_tail(args, 1)
    if s_eq(sub, "proof") {
        return flow_doc_proof(rest)
    } elif s_eq(sub, "bundle") {
        return flow_doc_bundle("book", rest)
    } elif s_eq(sub, "basic-bundle") {
        return flow_doc_bundle("basic", rest)
    } elif s_eq(sub, "geometry-bundle") {
        return flow_doc_bundle("geometry", rest)
    } elif s_eq(sub, "kernel") {
        return flow_doc_kernel(rest)
    }
    error("Usage: flow doc proof <file|dir> [-r]  |  flow doc bundle|basic-bundle|geometry-bundle  |  flow doc kernel <file.flow> [--param n=0] [--plot out.dot]")
    return 1
}

# ---------------------------------------------------------------------------
# fmt, explain
# ---------------------------------------------------------------------------

export function cmd_fmt(args0: ptr<ProcStrs>) -> i32 {
    let mut args: ptr<ProcStrs> = args0
    let mut fmt_check: bool = false
    if s_eq(sl_get(args, 0), "--check") {
        fmt_check = true
        args = sl_tail(args, 1)
    }
    if sl_len(args) == 0 {
        error("Usage: flow fmt [--check] <files...>")
        return 1
    }
    let driver: string = flow_resolve_flowc()
    if s_len(driver) == 0 {
        return 1
    }
    let mut rc: i32 = 0
    let mut i: i32 = 0
    while i < sl_len(args) {
        let f: string = sl_get(args, i)
        i = i + 1
        if not is_file(f) {
            error("flow fmt: no such file: " + f)
            rc = 1
            continue
        }
        let tmp: string = mktemp_file(env_or("TMPDIR", "/tmp") + "/flow_fmt.XXXXXX")
        let c: ptr<ProcCmd> = cmd(sl_of1(driver))
        cmd_env(c, "FLOWC_BACKEND", "fmt")
        cmd_env(c, "FLOWC_IN", f)
        cmd_env(c, "FLOWC_OUT", tmp)
        if run_out_to_err(c) != 0 {
            error("flow fmt: " + f + " does not parse; left unchanged")
            rc = 1
        } elif not same_bytes(f, tmp) {
            if fmt_check {
                outln("Would reformat " + f)
                rc = 1
            } else {
                let _cp: bool = copy_file(tmp, f)
            }
        }
        rm_f(tmp)
    }
    return rc
}

export function cmd_explain(args: ptr<ProcStrs>) -> i32 {
    let program: string = sl_get(args, 0)
    require_flow_file(program)
    let rest: ptr<ProcStrs> = sl_tail(args, 1)
    let flowc: string = flow_flowc_main()
    if s_len(flowc) == 0 {
        cli_exit(1)
    }
    let dir: string = mktemp_dir_default()
    let argv: ptr<ProcStrs> = sl_copy(rest)
    sl_push2(argv, program, dir + "/out.c")
    let envs: ptr<ProcStrs> = sl_of3("FLOWC_BIN=" + flowc, "FLOWC_EXPLAIN=1", "FLOWC_EXPLAIN_SOURCE=" + program)
    # The emitter's own messages were captured with the child's output:
    # stderr is printed to stdout and stdout to stderr, as below.
    sink_push(SINK_BUF, SINK_BUF)
    let call: ptr<EmitCall> = flowc_emit_call(root(), argv, envs)
    let plan_out: string = sink_pop()
    let plan_err: string = sink_err()
    if call.rc != 0 {
        out(plan_err)
        errs(plan_out)
        rm_rf(dir)
        return call.rc
    }
    let c: ptr<ProcCmd> = call.cmd
    cmd_capture_out(c)
    cmd_capture_err(c)
    let r: ptr<ProcResult> = run_result(c)
    out(r.stderr)
    if r.exit_code != 0 {
        errs(r.stdout)
    }
    rm_rf(dir)
    return r.exit_code
}

# ---------------------------------------------------------------------------
# examples
# ---------------------------------------------------------------------------

# sed -n 's/^entry[[:space:]]*=[[:space:]]*"\([^"]*\)"/\1/p' | head -n 1
function toml_entry(manifest: string) -> string {
    let lines: ptr<ProcStrs> = s_lines(read_text(manifest))
    let mut i: i32 = 0
    while i < sl_len(lines) {
        let l: string = sl_get(lines, i)
        i = i + 1
        if not s_starts(l, "entry") {
            continue
        }
        let mut j: i32 = 5
        let n: i32 = s_len(l)
        while j < n and (s_byte(l, j) == 32 or s_byte(l, j) == 9) {
            j = j + 1
        }
        if j >= n or s_byte(l, j) != 61 {
            continue
        }
        j = j + 1
        while j < n and (s_byte(l, j) == 32 or s_byte(l, j) == 9) {
            j = j + 1
        }
        if j >= n or s_byte(l, j) != 34 {
            continue
        }
        let close: i32 = s_find_byte(l, 34, j + 1)
        if close < 0 {
            continue
        }
        return s_slice(l, j + 1, close) + s_from(l, close + 1)
    }
    return ""
}

# printf "  %-20s %s\n"
function pad20(s: string) -> string {
    let mut r: string = s
    while s_len(r) < 20 {
        r = r + " "
    }
    return r
}

export function list_examples() -> i32 {
    let project_examples: string = cwd_physical() + "/examples"
    let rows: ptr<ProcStrs> = sl_new()
    if is_dir(project_examples) {
        let f: ptr<ProcStrs> = sl_of3("find", project_examples, "-mindepth")
        sl_push2(f, "2", "-maxdepth")
        sl_push2(f, "2", "-name")
        sl_push2(f, "flow.toml", "-print")
        let fc: ptr<ProcCmd> = cmd(f)
        cmd_quiet_err(fc)
        let manifests: ptr<ProcStrs> = s_lines(capture(fc))
        let mut i: i32 = 0
        while i < sl_len(manifests) {
            let m: string = sl_get(manifests, i)
            i = i + 1
            if s_len(m) == 0 {
                continue
            }
            let dir: string = path_dirname(m)
            let name: string = path_basename(dir)
            let mut entry: string = toml_entry(m)
            if s_len(entry) == 0 {
                entry = "src/main.flow"
            }
            if s_starts(entry, "build/") {
                continue
            }
            if not is_file(dir + "/" + entry) {
                continue
            }
            sl_push(rows, name + "\t" + entry)
        }
    }
    if sl_len(rows) > 0 {
        outln("Project examples")
        outln("----------------")
        sl_sort(rows, true)
        let mut k: i32 = 0
        while k < sl_len(rows) {
            let row: string = sl_get(rows, k)
            let tab: i32 = s_find_byte(row, 9, 0)
            outln("  " + pad20(s_slice(row, 0, tab)) + " " + s_from(row, tab + 1))
            k = k + 1
        }
        outln("")
        outln("Run: flow examples run <name>")
        return 0
    }
    info("Available FLOW programs:")
    outln("")
    outln("📚 Examples (standard programs):")
    list_programs_with_desc(root() + "/examples")
    outln("🧪 Tests (compiler/language demos):")
    list_programs_with_desc(root() + "/tests")
    return 0
}

function list_programs_with_desc(dir: string) {
    let c: ptr<ProcCmd> = cmd(sl_of3("find", dir, "-name"))
    proc_arg(c, "*.flow")
    let progs: ptr<ProcStrs> = s_lines(capture(c))
    let mut i: i32 = 0
    while i < sl_len(progs) {
        let p: string = sl_get(progs, i)
        i = i + 1
        outln("  📄 " + strip_root_prefix(p))
        let first: string = head_lines(p, 1)
        let mut desc: string = s_chomp_all(first)
        if s_starts(desc, "#") {
            let mut j: i32 = 1
            while j < s_len(desc) and s_byte(desc, j) == 32 {
                j = j + 1
            }
            desc = s_from(desc, j)
        }
        outln("     " + desc)
        outln("")
    }
}

function strip_root_prefix(p: string) -> string {
    let prefix: string = root() + "/"
    if s_starts(p, prefix) {
        return s_from(p, s_len(prefix))
    }
    return p
}

export function run_project_example(name: string) -> i32 {
    let project_examples: string = cwd_physical() + "/examples"
    if s_len(name) == 0 {
        error("Usage: flow examples run <name>")
        let _l: i32 = list_examples()
        cli_exit(1)
    }
    let example_dir: string = project_examples + "/" + name
    if not is_file(example_dir + "/flow.toml") {
        error("Example not found: " + name)
        info("Run 'flow examples' to list available project examples.")
        cli_exit(1)
    }
    let mut entry: string = toml_entry(example_dir + "/flow.toml")
    if s_len(entry) == 0 {
        entry = "src/main.flow"
    }
    if not is_file(example_dir + "/" + entry) {
        error("Example entry not found: " + example_dir + "/" + entry)
        cli_exit(1)
    }
    info("Running project example '" + name + "'...")
    let c: ptr<ProcCmd> = cmd(sl_of3(root() + "/flow", "run", entry))
    cmd_cwd(c, example_dir)
    return run(c)
}

# ---------------------------------------------------------------------------
# python
# ---------------------------------------------------------------------------

export function cmd_python(args: ptr<ProcStrs>) -> i32 {
    let program: string = sl_get(args, 0)
    if s_len(program) == 0 {
        error("Usage: flow python <program.flow> [--name NAME] [--version VER] [--source]")
        cli_exit(1)
    }
    require_flow_file(program)
    let mut py_name: string = ""
    let mut py_version: string = "0.1.0"
    let mut source_only: bool = false
    let n: i32 = sl_len(args)
    let mut i: i32 = 1
    while i < n {
        let a: string = sl_get(args, i)
        if s_eq(a, "--name") {
            py_name = sl_get(args, i + 1)
            i = i + 2
        } elif s_eq(a, "--version") {
            py_version = sl_get(args, i + 1)
            i = i + 2
        } elif s_eq(a, "--source") {
            source_only = true
            i = i + 1
        } else {
            i = i + 1
        }
    }
    info("Generating Python package from " + program + "...")
    let bin: string = flow_native_tool("pywheel")
    if s_len(bin) == 0 {
        cli_exit(1)
    }
    let py_out: string = "dist"
    let work: string = mktemp_dir(env_or("TMPDIR", "/tmp") + "/flow-pywheel.XXXXXX")
    on_exit_remove(work)
    let mut mode: string = "package"
    if source_only {
        mode = "source"
    }
    let pw: ptr<ProcStrs> = sl_of3(bin, program, py_name)
    sl_push2(pw, py_version, mode)
    sl_push2(pw, py_out, work)
    sl_push(pw, root())
    let rc: i32 = run_argv(pw)
    if rc != 0 {
        cli_exit(rc)
    }
    if source_only {
        cli_exit(0)
    }
    let names: ptr<ProcStrs> = list_dir(work + "/pkg")
    sl_sort(names, false)
    let mut py_ext: string = ""
    let mut k: i32 = 0
    while k < sl_len(names) {
        if s_ends(sl_get(names, k), "_ext.c") and s_len(py_ext) == 0 {
            py_ext = sl_get(names, k)
        }
        k = k + 1
    }
    let py_module: string = s_slice(py_ext, 0, s_len(py_ext) - 6)
    mkdir_p_or_exit(py_out)
    let out_abs: string = abs_dir(py_out)
    let pip: ptr<ProcStrs> = sl_of3(env_or("FLOW_PYTHON", "python3"), "-m", "pip")
    sl_push2(pip, "wheel", ".")
    sl_push2(pip, "-w", out_abs)
    let pc: ptr<ProcCmd> = cmd(pip)
    cmd_cwd(pc, work + "/pkg")
    cmd_quiet_out(pc)
    let prc: i32 = run_err_to_file(pc, work + "/pip.log")
    if prc == 0 {
        let wheels: ptr<ProcStrs> = list_dir(py_out)
        sl_sort(wheels, false)
        let mut wheel: string = ""
        let mut w: i32 = 0
        while w < sl_len(wheels) {
            let nm: string = sl_get(wheels, w)
            if s_starts(nm, py_module) and s_ends(nm, ".whl") and s_len(wheel) == 0 {
                wheel = py_out + "/" + nm
            }
            w = w + 1
        }
        if s_len(wheel) > 0 {
            outln("✅ Built wheel: " + wheel)
            outln("   Install with: pip install " + wheel)
            cli_exit(0)
        }
        outln("⚠️  Wheel build failed: No wheel file produced")
    } else {
        outln("⚠️  Wheel build failed: Wheel build failed:")
        out(read_text(work + "/pip.log"))
        outln("")
    }
    outln("   Falling back to source-only output...")
    let _c: bool = copy_file(work + "/pkg/" + py_ext, py_out + "/" + py_ext)
    outln("   Generated: " + py_out + "/" + py_ext)
    return 0
}

# ---------------------------------------------------------------------------
# wasm, playground
# ---------------------------------------------------------------------------

export function cmd_wasm(args0: ptr<ProcStrs>) -> i32 {
    if not env_isset("EMSDK_PYTHON") or s_len(env("EMSDK_PYTHON")) == 0 {
        if is_exec("/opt/homebrew/bin/python3.14") {
            env_set("EMSDK_PYTHON", "/opt/homebrew/bin/python3.14")
        }
    }
    if s_len(env("EM_LLVM_ROOT")) == 0 and is_dir("/opt/homebrew/opt/emscripten/libexec/llvm/bin") {
        env_set("EM_LLVM_ROOT", "/opt/homebrew/opt/emscripten/libexec/llvm/bin")
    }
    if s_len(env("EM_BINARYEN_ROOT")) == 0 and is_dir("/opt/homebrew/opt/emscripten/libexec/binaryen") {
        env_set("EM_BINARYEN_ROOT", "/opt/homebrew/opt/emscripten/libexec/binaryen")
    }
    let mut threads: bool = false
    let mut workers: string = "8"
    let mut fs: string = ""
    let preload: ptr<ProcStrs> = sl_new()
    let link: ptr<ProcStrs> = sl_new()
    let mut backend: string = ""
    let args: ptr<ProcStrs> = sl_new()
    let n: i32 = sl_len(args0)
    let mut i: i32 = 0
    while i < n {
        let a: string = sl_get(args0, i)
        if s_eq(a, "--threads") {
            threads = true
        } elif s_eq(a, "--workers") {
            i = i + 1
            workers = sl_get(args0, i)
            if s_len(workers) == 0 {
                workers = "8"
            }
        } elif s_eq(a, "--fs") {
            i = i + 1
            fs = sl_get(args0, i)
            if s_len(fs) == 0 {
                fs = "memfs"
            }
        } elif s_eq(a, "--preload") {
            i = i + 1
            sl_push2(preload, "--preload", sl_get(args0, i))
        } elif s_eq(a, "--link") {
            i = i + 1
            sl_push2(link, "--link", sl_get(args0, i))
        } elif s_starts(a, "--backend=") {
            backend = s_from(a, 10)
            sl_push(args, a)
        } elif s_eq(a, "--backend") {
            i = i + 1
            backend = sl_get(args0, i)
            sl_push2(args, "--backend", backend)
        } else {
            sl_push(args, a)
        }
        i = i + 1
    }
    if s_len(backend) == 0 {
        backend = flow_cpu_backend()
        if s_len(backend) == 0 {
            cli_exit(1)
        }
    }
    let first: string = sl_get(args, 0)
    if s_len(first) == 0 or s_eq(first, "--help") {
        error("Usage: flow wasm <program.flow> [--out DIR] [--legacy]")
        info("                 [--backend=c|mlir] [--link PATH] [--preload DIR@/MOUNT]")
        info("                 [--threads [--workers N]] [--fs memfs|idbfs]")
        info("Writes .wasm + .js + a runnable index.html.")
        info("gfx programs get a canvas page; others print into the page.")
        info("Requires emcc (Emscripten). See docs/language/wasm.md")
        info("Whole gallery: ./flow tool wasm_build gallery")
        cli_exit(1)
    }
    if s_eq(first, "--legacy") {
        let rest: ptr<ProcStrs> = sl_tail(args, 1)
        require_flow_file(sl_get(rest, 0))
        cli_exit(run_argv(tool_argv("flow_to_wasm", rest)))
    }
    require_flow_file(first)
    if not have("emcc") {
        error("emcc not on PATH: install emsdk to emit .wasm")
        info("  docs: docs/language/wasm.md")
        cli_exit(1)
    }
    if s_len(fs) > 0 {
        if s_eq(backend, "mlir") {
            error("--fs currently requires --backend=c (MEMFS/IDBFS crossings are C-only)")
            info("  For MLIR, use --preload HOST@/mount without --fs (FORCE_FILESYSTEM)")
            cli_exit(1)
        }
        info("Flow → C → WASM with a " + fs + " filesystem (see docs/language/wasm-crossings.md)")
        let c: ptr<ProcStrs> = tool_argv("wasm_crossings", sl_of2("fs", first))
        sl_push2(c, "--fs", fs)
        sl_extend(c, preload)
        if run_argv(c) != 0 {
            error("Filesystem WASM build failed")
            cli_exit(1)
        }
        cli_exit(0)
    }
    if threads {
        if s_eq(backend, "mlir") {
            error("--threads currently requires --backend=c")
            cli_exit(1)
        }
        info("Flow → C → threaded WASM (see docs/language/wasm-crossings.md)")
        let t: ptr<ProcStrs> = tool_argv("wasm_crossings", sl_of2("threads", first))
        sl_push2(t, "--workers", workers)
        if run_argv(t) != 0 {
            error("Threaded WASM build failed")
            cli_exit(1)
        }
        cli_exit(0)
    }
    if s_eq(backend, "mlir") {
        info("Flow → MLIR → LLVM → WASM (see docs/language/wasm.md)")
    } else {
        info("Flow → C → WASM (see docs/language/wasm.md)")
    }
    let b: ptr<ProcStrs> = tool_argv("wasm_build", sl_of1("build"))
    sl_extend(b, args)
    sl_extend(b, preload)
    sl_extend(b, link)
    if run_argv(b) != 0 {
        error("WASM build failed")
        cli_exit(1)
    }
    return 0
}

export function cmd_playground(port_arg: string) -> i32 {
    let mut port: string = port_arg
    if s_len(port) == 0 {
        port = "8765"
    }
    info("Starting playground compile server on 127.0.0.1:" + port)
    info("UI: docs/playground/index.html  (or wiki /flow/ playground)")
    info("Click: Run (native local)")
    info("Docs: docs/language/debugging.md · docs/language/wasm.md")
    if have("open") {
        let c: ptr<ProcCmd> = cmd(sl_of2("open", root() + "/docs/playground/index.html"))
        cmd_quiet_err(c)
        let _r: i32 = run(c)
    }
    return run_argv(tool_argv("playground_server", sl_of2("--port", port)))
}

# ---------------------------------------------------------------------------
# install / setup
# ---------------------------------------------------------------------------

export function install_deps() -> i32 {
    info("Installing FLOW dependencies...")
    resolve_llvm_path()
    if not is_exec(llvm_path() + "/mlir-opt") {
        info("Installing LLVM...")
        if have("brew") {
            check(run_argv(sl_of3("brew", "install", "llvm")))
            resolve_llvm_path()
            env_set("LLVM_PATH", llvm_path())
            env_set("PATH", llvm_path() + ":" + env("PATH"))
        } else {
            error("Please install LLVM manually")
            cli_exit(1)
        }
    }
    success("Dependencies installed!")
    return 0
}

export function cmd_install(second: string) -> i32 {
    if is_file("flow.toml") or s_eq(second, "--deps") {
        return flow_pkg_native(sl_of1("sync"))
    } elif s_eq(second, "--tools") {
        return install_deps()
    }
    info("No flow.toml here: installing compiler tools (LLVM).")
    info("For package deps: cd <project> && ./flow install   or  ./flow pkg install")
    return install_deps()
}

# ---------------------------------------------------------------------------
# repl
# ---------------------------------------------------------------------------

export function cmd_repl() -> i32 {
    let bin: string = flow_native_tool("repl")
    if s_len(bin) == 0 {
        cli_exit(1)
    }
    let driver: string = flow_resolve_flowc()
    if s_len(driver) == 0 {
        cli_exit(1)
    }
    let dir: string = mktemp_dir(env_or("TMPDIR", "/tmp") + "/flow-repl.XXXXXX")
    on_exit_remove(dir)
    let mut abs_driver: string = driver
    if not is_abs(driver) {
        abs_driver = root() + "/" + driver
    }
    abs_driver = abs_dir(path_dirname(abs_driver)) + "/" + path_basename(abs_driver)
    let c: ptr<ProcCmd> = cmd(sl_of1(bin))
    cmd_env(c, "FLOW_ROOT", root())
    cmd_env(c, "FLOW_REPL_DIR", dir)
    cmd_env(c, "FLOWC_BIN", abs_driver)
    cmd_env(c, "FLOW_VERSION", flow_canonical_version())
    return run(c)
}

# ---------------------------------------------------------------------------
# ml
# ---------------------------------------------------------------------------

export function cmd_ml(args: ptr<ProcStrs>) -> i32 {
    let mut sub: string = sl_get(args, 0)
    if s_len(sub) == 0 {
        sub = "run"
    }
    if s_eq(sub, "run") or s_eq(sub, "jit") or s_eq(sub, "bench") {
        let mut program: string = sl_get(args, 1)
        if s_len(program) == 0 {
            program = root() + "/examples/ml/mlir_tensor_bench.flow"
        }
        require_flow_file(program)
        check_deps()
        check_mlir_deps()
        info("MLIR ML (" + sub + "): " + program)
        if s_eq(sub, "bench") {
            check(generate_mlir(sl_of1(program)))
            let name: string = path_stem(program, ".flow")
            let b: string = build_root() + "/" + name
            if mlir_lower_and_link(b + ".mlir", b + "_mlir.o", b + "_mlir", "3") != 0 {
                cli_exit(1)
            }
            info("Running benchmark...")
            return run_argv(sl_of3("/usr/bin/time", "-p", b + "_mlir"))
        }
        return run_flow_jit(program)
    }
    if s_eq(sub, "test") {
        check_deps()
        info("Running ML tensor tests...")
        let tests: ptr<ProcStrs> = s_words("tests/stdlib/test_tensor.flow tests/stdlib/test_ml_autograd.flow tests/stdlib/test_matmul_backward.flow tests/stdlib/test_ml_nn.flow tests/stdlib/test_dense_backward.flow tests/stdlib/test_mlp2_backward.flow tests/stdlib/test_ml_opt.flow examples/ml/models/mlp_xor.flow examples/ml/models/mlp_xor_adam.flow")
        let mut i: i32 = 0
        while i < sl_len(tests) {
            let t: string = root() + "/" + sl_get(tests, i)
            i = i + 1
            if not is_file(t) {
                continue
            }
            info("  " + t)
            let errf: string = root() + "/build/.flowc_err"
            sink_push(SINK_NULL, SINK_BUF)
            let rc: i32 = flowc_emit_to_c(t, root() + "/build/" + path_stem(t, ".flow") + ".c")
            let _o: string = sink_pop()
            let _w: bool = write_text(errf, sink_err())
            if rc != 0 {
                error("Failed: " + t)
                errs(read_text(errf))
                cli_exit(1)
            }
            success("  ✓ " + path_basename(t))
        }
        if have(llvm_path() + "/mlir-opt") or have("mlir-opt") {
            check_mlir_deps()
            let jits: ptr<ProcStrs> = s_words("test_tensor test_ml_autograd test_matmul_backward test_dense_backward test_dense_create_only test_backward_a_from_layer test_mlp2_backward")
            let mut k: i32 = 0
            while k < sl_len(jits) {
                let nm: string = sl_get(jits, k)
                k = k + 1
                info("  MLIR JIT smoke: " + nm)
                check(run_flow_jit(root() + "/tests/stdlib/" + nm + ".flow"))
            }
            info("  MLIR AOT smoke: mlir_tensor_bench")
            sink_push(SINK_NULL, SINK_FD)
            let g: i32 = generate_mlir(sl_of1(root() + "/examples/ml/mlir_tensor_bench.flow"))
            let _s: string = sink_pop()
            check(g)
            let br: string = build_root() + "/mlir_tensor_bench"
            if mlir_lower_and_link(br + ".mlir", br + "_mlir.o", br + "_mlir", "3") != 0 {
                cli_exit(1)
            }
            info("  MLIR GPU smoke: gpu_kernels")
            sink_push(SINK_NULL, SINK_NULL)
            let grc: i32 = flow_emit_mlir(sl_of3("--gpu", root() + "/lib/stdlib/gpu_kernels.flow", build_root() + "/gpu_kernels.mlir"))
            let _go: string = sink_pop()
            if grc != 0 {
                error("GPU MLIR generation failed")
                cli_exit(1)
            }
            info("  MLIR SPIR-V smoke: gpu_kernels (best-effort)")
            sink_push(SINK_NULL, SINK_NULL)
            let src: i32 = mlir_spirv(sl_of3("spirv", build_root() + "/gpu_kernels.mlir", build_root() + "/gpu_kernels.spv"))
            let _so: string = sink_pop()
            if src == 0 {
                success("  SPIR-V lowering ok")
            } else {
                warning("  SPIR-V lowering WIP (GPU MLIR codegen ok)")
            }
        } else {
            warning("Skipping MLIR JIT (install llvm: brew install llvm)")
        }
        success("ML tests passed")
        return 0
    }
    error("Usage: flow ml [run|jit|bench|test] [program.flow]")
    cli_exit(1)
    return 1
}

# ---------------------------------------------------------------------------
# Launchers for the Flow tools
# ---------------------------------------------------------------------------

# exec TOOL ARGS with FLOW_ROOT set (the physical root) when `with_root`.
function exec_tool(bin: string, args: ptr<ProcStrs>, with_root: bool) -> i32 {
    if with_root {
        env_set("FLOW_ROOT", abs_dir_physical(root()))
    }
    let argv: ptr<ProcStrs> = sl_of1(bin)
    sl_extend(argv, args)
    return exec_argv(argv)
}

export function cmd_check(args: ptr<ProcStrs>) -> i32 {
    let bin: string = flow_native_tool("check")
    if s_len(bin) == 0 {
        return 1
    }
    if s_eq(sl_get(args, 0), "--build") {
        outln(bin)
        return 0
    }
    return exec_tool(bin, args, false)
}

export function cmd_lsp(args: ptr<ProcStrs>) -> i32 {
    let bin: string = flow_native_tool("lsp")
    if s_len(bin) == 0 {
        return 1
    }
    if s_eq(sl_get(args, 0), "--build") {
        outln(bin)
        return 0
    }
    return exec_tool(bin, args, true)
}

export function cmd_project_test(args: ptr<ProcStrs>) -> i32 {
    let bin: string = flow_native_tool("project_test")
    if s_len(bin) == 0 {
        return 2
    }
    return exec_tool(bin, args, false)
}

export function cmd_dap(args: ptr<ProcStrs>) -> i32 {
    let program: string = sl_get(args, 0)
    if s_len(program) == 0 {
        error("Usage: flow dap <program.flow>")
        info("IDE: VS Code FLOW debugger type (lldb-dap). CLI opens ./flow debug.")
        return 1
    }
    require_flow_file(program)
    if is_tty(0) {
        return exec_argv(sl_of3(root() + "/flow", "debug", program))
    }
    let bin: string = flow_native_tool("dap")
    if s_len(bin) == 0 {
        return 1
    }
    return exec_tool(bin, sl_new(), true)
}

export function cmd_fir(args: ptr<ProcStrs>) -> i32 {
    let first: string = sl_get(args, 0)
    if s_len(first) == 0 {
        error("Usage: flow fir-g <program.flow> [--json] [--device=…] [--bench] [--opts]")
        info("       flow fir-g --calibrate [--thresholds PATH] [--json]")
        info("Docs: docs/project/fir-g.md")
        return 1
    }
    if s_ends(first, ".flow") {
        require_flow_file(first)
    } elif not s_starts(first, "--") {
        error("Usage: flow fir-g <program.flow> […]  or  flow fir-g --calibrate")
        return 1
    }
    check_deps()
    let bin: string = flow_native_tool("fir")
    if s_len(bin) == 0 {
        return 1
    }
    return exec_tool(bin, args, true)
}

export function cmd_gpu(args0: ptr<ProcStrs>) -> i32 {
    if s_eq(sl_get(args0, 0), "test") {
        let bin: string = flow_native_tool("gpu_test")
        if s_len(bin) == 0 {
            return 1
        }
        return exec_tool(bin, sl_tail(args0, 1), true)
    }
    if s_eq(sl_get(args0, 0), "--build") {
        let b: string = flow_native_tool("gpu")
        if s_len(b) == 0 {
            return 1
        }
        outln(b)
        return 0
    }
    let mut lang: string = "metal"
    let args: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(args0) {
        let a: string = sl_get(args0, i)
        if s_eq(a, "--wgsl") {
            lang = "wgsl"
        } elif s_eq(a, "--metal") {
            lang = "metal"
        } else {
            sl_push(args, a)
        }
        i = i + 1
    }
    let program: string = sl_get(args, 0)
    if s_len(program) == 0 {
        error("Usage: flow gpu <program.flow> [--wgsl]")
        return 1
    }
    require_flow_file(program)
    check_deps()
    info("Generating GPU shaders from " + program + " (" + lang + ")...")
    let bin: string = flow_native_tool("gpu")
    if s_len(bin) == 0 {
        return 1
    }
    let mut out_dir: string = root() + "/build/gpu"
    if s_eq(lang, "wgsl") {
        out_dir = root() + "/build/wgsl"
    }
    let ta: ptr<ProcStrs> = sl_of2("--lang", lang)
    sl_push2(ta, "--out", out_dir)
    sl_push(ta, program)
    return exec_tool(bin, ta, true)
}

export function cmd_analyze(args: ptr<ProcStrs>) -> i32 {
    let first: string = sl_get(args, 0)
    if s_len(first) == 0 {
        error("Usage: flow analyze <file.c|file.flow> [--standard=misra-c-2024|cert-c]")
        info("                  [--wcet] [--stack-depth] [--budget N] [--fail-on-violation]")
        return 1
    }
    let bin: string = flow_native_tool("analyze")
    if s_len(bin) == 0 {
        return 1
    }
    let mut mode: string = "misra"
    if s_ends(first, ".flow") or s_eq(first, "--wcet") or s_eq(first, "--stack-depth") {
        mode = "wcet"
    }
    let ta: ptr<ProcStrs> = sl_of1(mode)
    sl_extend(ta, args)
    return exec_tool(bin, ta, false)
}
