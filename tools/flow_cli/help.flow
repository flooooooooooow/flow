# @module tools.flow_cli.help
# @means  `flow help`: the command summary.

import "tools/flow_cli/sys.flow"

# `flow version`. ./flow tool sync_version keeps the version strings in this
# file in step with VERSION.
export const FLOW_VERSION_LINE: string = "Flow 2.0.0"

export function show_help() {
    outln("Flow Programming Language v2.0.0")
    outln("")
    outln("Usage: flow [OPTIONS] <program.flow>")
    outln("")
    outln("Options:")
    outln("  run <program> [--backend=c|mlir] [--sanitize=ub,asan,tsan] [--profile=safety]")
    outln("                    Compile and run program")
    outln("  compile <program> [--backend=c|mlir] [--sanitize=...] [--profile=safety] [--show-flags]")
    outln("                    Compile program only; --show-flags prints clang flags")
    outln("  show-flags [--profile=safety] [--sanitize=...]  Print clang CFLAGS for current profile")
    outln("  analyze <file.c> [--standard=misra-c-2024|cert-c] [--fail-on-violation]")
    outln("                    Scan generated C for MISRA/CERT patterns (#277)")
    outln("  Compiler: flowc (compiler/src); FLOWC_BIN=<path> picks a flowc binary")
    outln("  CPU backend: FLOW_CPU_BACKEND=c|mlir or --backend= (default c; mlir needs LLVM)")
    outln("  C flags: -std=c11 -Wall -Wextra (MISRA Phase 0); FLOW_PROFILE=safety adds -Werror")
    outln("  Sanitizers: FLOW_UBSAN=1 FLOW_ASAN=1 FLOW_TSAN=1 or FLOW_SANITIZE=ub,asan,tsan")
    outln("  audio <program> [--mlir]   Compile and run with audio backend")
    outln("  compile-audio <program> [--mlir]  Compile with audio backend")
    outln("  debug <program> [--break N|--break main] [--no-launch]  Debug build (+ optional LLDB/GDB)")
    outln("  window <program>  Run with SDL2 window backend")
    outln("  gfx <program>     Run with native FLOW gfx backend (macOS/Linux/Windows via SDL2)")
    outln("  record <program> [--frames N] [--skip N] [--out DIR] [--gif [PATH]] [--keys SPEC] [--mouse SPEC]")
    outln("                   [--fps N] [--stride N] [--width PX]")
    outln("                    Run a gfx program headless; write PPM frames, or a GIF with --gif")
    outln("  shader <program>  Run fill-shader demo (Metal window on macOS; --emit-only, --wgsl; see docs/language/shaders.md)")
    outln("  demo vulkan [basic|advanced]  Vulkan triangle / scene demos (macOS + MoltenVK)")
    outln("  demo vulkan-flow [basic|advanced|2048|tetris|snake|pong|breakout|layout|layout-dsl]")
    outln("  demo ui-layout[|-window]  UI layout demos (SDL2 for -window)")
    outln("  Compat aliases (same as demo …): vulkan-demo[-basic|-advanced], vulkan-2048,")
    outln("    vulkan-tetris, vulkan-snake, vulkan-pong, vulkan-breakout,")
    outln("    vulkan-layout[-dsl], ui-layout[-window]")
    outln("  mlir <program> [flags]  Generate MLIR (pass --optimize / --opt-level / --no-*)")
    outln("  mlir-run <program> Compile via MLIR and run")
    outln("  fir-g <program>    Dump FIR-G graph + analyses; --calibrate / --opts")
    outln("  jit <program>      JIT compile and run (fastest)")
    outln("  ml [run|jit|bench|test] [program]  MLIR-first ML workloads (tensors, matmul)")
    outln("  gpu <program>      Generate @gpu compute kernels as Metal sources")
    outln("  shader <program>   Run fill-shader demo (Metal; macOS)")
    outln("  explain <program>  Print the compilation plan for every declarative")
    outln("                    construct: implementations considered, their costs,")
    outln("                    the choice, and what each rejected candidate failed")
    outln("                    (flowc with FLOWC_EXPLAIN=1)")
    outln("  transpile <program> [args...]  Run the Python MLIR transpiler (advanced flags)")
    outln("  fmt [--check] <files...>  Format FLOW source files in place")
    outln("                    (--check: list files that would change, exit 1)")
    outln("")
    outln("Testing:")
    outln("  test [flags]      Run FLOW tests (flowc + clang validate)")
    outln("                    --strict    Fail on type errors")
    outln("                    --lenient   Warnings only (default)")
    outln("                    --tier1     Transpile only (fast)")
    outln("                    --tier2     Transpile + clang (default)")
    outln("                    --verbose   Show error details")
    outln("                    --sanitize=ub,asan,tsan  Enable sanitizers for compile/run tests")
    outln("  test-strict       Shortcut for: test --strict")
    outln("  test-runtime      Run runtime tests (compile + execute)")
    outln("  test-lang         Run tests/lang/ language tests (strict flowc + compile + execute)")
    outln("                    --timeout=SECONDS  Per-program limit for test-runtime and test-lang")
    outln("                    (default 120, or FLOW_TEST_TIMEOUT); a timeout is a failure")
    outln("  test-mlir         Run MLIR verification (requires LLVM)")
    outln("  test-scripts      Run the Flow tests in tests/scripts")
    outln("  test-interop      Run interop runtime tests")
    outln("  test-gpu          Run GPU feature + codegen tests")
    outln("  test-matmul       Run matmul optimization demo + print assembly")
    outln("  test-all          Run FLOW + Python tests")
    outln("")
    outln("Project / packages:")
    outln("  init [name]       Initialize a new project (flow.toml)")
    outln("  add <package>     Add dependency (name, name@^1.0, --git, --path)")
    outln("  patch <file.flow>  Compile and run a corpus patch smoke harness")
    outln("  sync [--program FILE]  Synchronize the nearest project's dependencies")
    outln("  pkg install       Install flow.toml dependencies → flow_packages/")
    outln("  search [query]    Search the Flow package registry")
    outln("  info <package>    Show package versions / source")
    outln("  publish           Register package in local registry/index.json")
    outln("  build             Build the project")
    outln("  build-native      Build with native sources (uses flow.toml)")
    outln("  run-native        Build and run with native sources")
    outln("  clean             Clean build artifacts")
    outln("  install           Install project deps if flow.toml exists; else LLVM tools")
    outln("  setup             Install LLVM / compiler tooling")
    outln("  python <program>  Generate Python package (wheel)")
    outln("  wasm <program> [--backend=c|mlir] [--preload DIR@/MOUNT] [--link PATH]")
    outln("                    [--threads] [--fs memfs|idbfs] [--out DIR]")
    outln("                    Compile to WebAssembly + a runnable page")
    outln("  wasm32 <in.flow|in.ll> -o OUT.wasm [--export NAME] [-O O0..Oz]")
    outln("                    Freestanding wasm32 module through MLIR (no libc)")
    outln("  bpf <in.flow|in.ll> -o OUT.o [--entry NAME --section SEC] [-O 0..3]")
    outln("                    eBPF ELF object (bpfel) through MLIR")
    outln("  tool NAME|PATH.flow [args]  Build and run a repository Flow program")
    outln("                    (scripts/tools/NAME, tools/NAME, or a .flow path)")
    outln("  repl              Start interactive REPL")
    outln("  lsp               Start the language server on stdio")
    outln("  examples          List project examples (or compiler examples outside a project)")
    outln("  examples run NAME Run a packaged project example from the current root")
    outln("  playground        Start native-local compile API + open playground docs")
    outln("  dap <file>        Debug Adapter (IDE) / opens flow debug on TTY")
    outln("  version           Print Flow version (2.0.0)")
    outln("  help              Show this help")
    outln("")
    outln("Environment:")
    outln("  FLOWC_PERMISSIVE_EFFECTS=1  Compile with legacy zero defaults")
    outln("  FLOW_PERMISSIVE_EFFECTS=1   Run with legacy zero/no-op defaults")
    outln("  FLOW_CPU_BACKEND=c|mlir  Select CPU codegen (default c; same as --backend)")
    outln("  FLOWC_BIN=<path>       flowc binary for the C path (default: built from compiler/bootstrap)")
    outln("")
    outln("Examples:")
    outln("  flow run examples/fibonacci.flow")
    outln("  flow run --backend=mlir examples/basics/hello_world.flow")
    outln("  flow compile examples/loops.flow")
    outln("  flow test --strict --verbose")
    outln("  flow test-runtime --verbose")
    outln("  flow test-interop")
    outln("  flow test-gpu --verbose")
    outln("  flow test-matmul [--no-asm] [--no-mlir]")
}
