# @module tools.flow_cli.sys
# @means  Strings, lists, the environment, files and processes for the
#         `flow` command line (tools/flow_cli). Processes go through
#         std.process; the file calls that need a platform struct (stat,
#         uname, readdir) are a short C shim below.
#
# The CLI replaces a bash driver and keeps its behaviour, so a few helpers
# copy shell semantics on purpose: `env_or` is `${X:-default}`, `capture`
# drops trailing newlines as `$(...)` does, and exit statuses are the
# shell's (128 + N for a child killed by signal N).
#
# The shim includes the POSIX headers itself. It spells C strings as char
# arrays because @cEmbed text cannot hold a double quote (#1089). Nothing in this program may
# declare a POSIX function through `extern` with Flow types, or the C
# prototypes would clash; that is why this module does not import
# scripts/tools/lib/text.flow, whose `write` does.

@cEmbed("#include <errno.h>
#include <dirent.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <sys/utsname.h>
#include <unistd.h>
static const char flow_cli_empty[] = {0};
static const char flow_cli_rb[] = {'r', 'b', 0};
static const char flow_cli_wb[] = {'w', 'b', 0};
static const char flow_cli_ab[] = {'a', 'b', 0};
static int32_t flow_cli_kind(const char *p) {
  struct stat st;
  if (stat(p, &st) != 0) { return 0; }
  if (S_ISREG(st.st_mode)) { return 1; }
  if (S_ISDIR(st.st_mode)) { return 2; }
  return 3;
}
static int32_t flow_cli_is_link(const char *p) {
  struct stat st;
  if (lstat(p, &st) != 0) { return 0; }
  return S_ISLNK(st.st_mode) ? 1 : 0;
}
static int32_t flow_cli_lexists(const char *p) {
  struct stat st;
  return lstat(p, &st) == 0 ? 1 : 0;
}
static int64_t flow_cli_mtime_ns(const char *p) {
  struct stat st;
  if (stat(p, &st) != 0) { return -1; }
#if defined(__APPLE__)
  return (int64_t)st.st_mtimespec.tv_sec * 1000000000LL + (int64_t)st.st_mtimespec.tv_nsec;
#else
  return (int64_t)st.st_mtim.tv_sec * 1000000000LL + (int64_t)st.st_mtim.tv_nsec;
#endif
}
static int64_t flow_cli_size(const char *p) {
  struct stat st;
  if (stat(p, &st) != 0) { return -1; }
  return (int64_t)st.st_size;
}
static int32_t flow_cli_access(const char *p, int32_t mode) { return access(p, mode) == 0 ? 1 : 0; }
static int32_t flow_cli_mkdir(const char *p) {
  if (mkdir(p, 0777) == 0) { return 0; }
  if (errno == EEXIST) { struct stat st; if (stat(p, &st) == 0 && S_ISDIR(st.st_mode)) { return 0; } }
  return -1;
}
static int32_t flow_cli_rmdir(const char *p) { return rmdir(p) == 0 ? 0 : -1; }
static int32_t flow_cli_unlink(const char *p) { return unlink(p) == 0 ? 0 : -1; }
static int32_t flow_cli_rename(const char *a, const char *b) { return rename(a, b) == 0 ? 0 : -1; }
static int32_t flow_cli_chmod(const char *p, int32_t mode) { return chmod(p, (mode_t)mode) == 0 ? 0 : -1; }
static int32_t flow_cli_umask_mode(void) { mode_t m = umask(0); umask(m); return (int32_t)m; }
static const char *flow_cli_mkdtemp(const char *tmpl) {
  size_t n = strlen(tmpl); char *b = (char *)malloc(n + 1); memcpy(b, tmpl, n + 1);
  if (mkdtemp(b) == 0) { free(b); return 0; }
  return b;
}
static const char *flow_cli_mkstemp(const char *tmpl) {
  size_t n = strlen(tmpl); char *b = (char *)malloc(n + 1); memcpy(b, tmpl, n + 1);
  int fd = mkstemp(b);
  if (fd < 0) { free(b); return 0; }
  close(fd);
  return b;
}
static const char *flow_cli_uname(int32_t which) {
  static struct utsname u; static int loaded = 0;
  if (!loaded) { if (uname(&u) != 0) { return flow_cli_empty; } loaded = 1; }
  return which == 0 ? u.sysname : u.machine;
}
static int32_t flow_cli_isatty(int32_t fd) { return isatty(fd) ? 1 : 0; }
static int64_t flow_cli_write(int32_t fd, uint8_t *buf, int64_t n) {
  int64_t off = 0;
  while (off < n) {
    ssize_t w = write(fd, buf + off, (size_t)(n - off));
    if (w < 0) { if (errno == EINTR) { continue; } return -1; }
    off += (int64_t)w;
  }
  return off;
}
static int32_t flow_cli_execvp(const char **argv) { execvp(argv[0], (char *const *)argv); return errno; }
static const char *flow_cli_strerror(int32_t e) { return strerror(e); }
static void *flow_cli_opendir(const char *p) { return (void *)opendir(p); }
static const char *flow_cli_readdir(void *d) {
  struct dirent *e = readdir((DIR *)d);
  return e == 0 ? 0 : e->d_name;
}
static void flow_cli_closedir(void *d) { closedir((DIR *)d); }
static uint8_t *flow_cli_read_bytes(const char *p, int64_t *len) {
  FILE *fp = fopen(p, flow_cli_rb);
  *len = -1;
  if (fp == 0) { return 0; }
  size_t cap = 65536, n = 0; uint8_t *buf = (uint8_t *)malloc(cap + 1);
  for (;;) {
    size_t got = fread(buf + n, 1, cap - n, fp); n += got;
    if (got == 0) { break; }
    if (n == cap) { cap *= 2; buf = (uint8_t *)realloc(buf, cap + 1); }
  }
  fclose(fp); buf[n] = 0; *len = (int64_t)n;
  return buf;
}
static int32_t flow_cli_write_bytes(const char *p, uint8_t *buf, int64_t n, int32_t append) {
  FILE *fp = fopen(p, append ? flow_cli_ab : flow_cli_wb);
  if (fp == 0) { return -1; }
  size_t w = n > 0 ? fwrite(buf, 1, (size_t)n, fp) : 0;
  fclose(fp);
  return (int64_t)w == n ? 0 : -1;
}
static const char *flow_cli_realpath(const char *p) {
  char *r = realpath(p, 0);
  return r;
}
static void flow_cli_exit(int32_t code) { exit(code); }
")

import std.process { ProcCmd, ProcResult, ProcStrs, proc_cmd, proc_arg, proc_env, proc_cwd, proc_stdin, proc_stdout, proc_stderr, proc_run, proc_getenv, proc_has_env, proc_setenv, proc_unsetenv, proc_getcwd, proc_which, proc_strs_new, proc_strs_push, proc_strs_len, proc_strs_get, proc_pid, PROC_CAPTURE, PROC_INHERIT, PROC_NULL, PROC_MERGE }

extern {
    function flow_cli_kind(p: string) -> i32
    function flow_cli_is_link(p: string) -> i32
    function flow_cli_lexists(p: string) -> i32
    function flow_cli_mtime_ns(p: string) -> i64
    function flow_cli_size(p: string) -> i64
    function flow_cli_access(p: string, mode: i32) -> i32
    function flow_cli_mkdir(p: string) -> i32
    function flow_cli_rmdir(p: string) -> i32
    function flow_cli_unlink(p: string) -> i32
    function flow_cli_rename(a: string, b: string) -> i32
    function flow_cli_chmod(p: string, mode: i32) -> i32
    function flow_cli_umask_mode() -> i32
    function flow_cli_mkdtemp(tmpl: string) -> string
    function flow_cli_mkstemp(tmpl: string) -> string
    function flow_cli_uname(which: i32) -> string
    function flow_cli_isatty(fd: i32) -> i32
    function flow_cli_write(fd: i32, buf: ptr<u8>, n: i64) -> i64
    function flow_cli_execvp(argv: ptr<string>) -> i32
    function flow_cli_strerror(e: i32) -> string
    function flow_cli_opendir(p: string) -> ptr<void>
    function flow_cli_readdir(d: ptr<void>) -> string
    function flow_cli_closedir(d: ptr<void>) -> void
    function flow_cli_read_bytes(p: string, len: ptr<i64>) -> ptr<u8>
    function flow_cli_write_bytes(p: string, buf: ptr<u8>, n: i64, append: i32) -> i32
    function flow_cli_realpath(p: string) -> string
    function flow_cli_exit(code: i32) -> void
    function malloc(size: i64) -> ptr<void>
    function strlen(s: string) -> i64
    function strcmp(a: string, b: string) -> i32
    function strncmp(a: string, b: string, n: i64) -> i32
}

# ---------------------------------------------------------------------------
# Strings
# ---------------------------------------------------------------------------

export function s_len(s: string) -> i32 {
    if (s as ptr<u8>) == null {
        return 0
    }
    return strlen(s) as i32
}

export function s_eq(a: string, b: string) -> bool {
    return strcmp(a, b) == 0
}

export function s_empty(s: string) -> bool {
    return s_len(s) == 0
}

export function s_starts(s: string, prefix: string) -> bool {
    return strncmp(s, prefix, strlen(prefix)) == 0
}

export function s_ends(s: string, suffix: string) -> bool {
    let n: i32 = s_len(s)
    let m: i32 = s_len(suffix)
    if m > n {
        return false
    }
    return strcmp(s_from(s, n - m), suffix) == 0
}

export function s_byte(s: string, i: i32) -> i32 {
    let p: ptr<u8> = s as ptr<u8>
    return p[i] as i32
}

# Bytes [start, end) as a new string.
export function s_slice(s: string, start: i32, end: i32) -> string {
    let n: i32 = s_len(s)
    let mut a: i32 = start
    let mut b: i32 = end
    if a < 0 {
        a = 0
    }
    if b > n {
        b = n
    }
    if b < a {
        b = a
    }
    let out: ptr<u8> = malloc((b - a + 1) as i64) as ptr<u8>
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    while i < b - a {
        out[i] = p[a + i]
        i = i + 1
    }
    out[b - a] = 0
    return out as string
}

export function s_from(s: string, start: i32) -> string {
    return s_slice(s, start, s_len(s))
}

export function s_find(hay: string, needle: string, from: i32) -> i32 {
    let n: i32 = s_len(hay)
    let m: i32 = s_len(needle)
    let h: ptr<u8> = hay as ptr<u8>
    let q: ptr<u8> = needle as ptr<u8>
    let mut i: i32 = from
    while i + m <= n {
        let mut j: i32 = 0
        while j < m and h[i + j] == q[j] {
            j = j + 1
        }
        if j == m {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

export function s_contains(hay: string, needle: string) -> bool {
    return s_find(hay, needle, 0) >= 0
}

export function s_find_byte(s: string, ch: i32, from: i32) -> i32 {
    let n: i32 = s_len(s)
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = from
    while i < n {
        if p[i] as i32 == ch {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

export function s_rfind_byte(s: string, ch: i32) -> i32 {
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = s_len(s) - 1
    while i >= 0 {
        if p[i] as i32 == ch {
            return i
        }
        i = i - 1
    }
    return 0 - 1
}

export function s_itoa(n: i32) -> string {
    if n == 0 {
        return "0"
    }
    let mut v: i64 = n as i64
    let neg: bool = v < 0
    if neg {
        v = 0 - v
    }
    let buf: ptr<u8> = malloc(24) as ptr<u8>
    let mut i: i32 = 22
    buf[23] = 0
    while v > 0 {
        buf[i] = (48 + (v % 10)) as u8
        v = v / 10
        i = i - 1
    }
    if neg {
        buf[i] = 45
        i = i - 1
    }
    return ((buf as i64 + (i + 1) as i64) as ptr<u8>) as string
}

# Decimal integer at the start of `s` (optional sign); `dflt` when there is
# none.
export function s_atoi(s: string, dflt: i32) -> i32 {
    let n: i32 = s_len(s)
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    let mut neg: bool = false
    if i < n and (p[i] == 45 or p[i] == 43) {
        neg = p[i] == 45
        i = i + 1
    }
    if i >= n or p[i] < 48 or p[i] > 57 {
        return dflt
    }
    let mut v: i32 = 0
    while i < n and p[i] >= 48 and p[i] <= 57 {
        v = v * 10 + (p[i] as i32 - 48)
        i = i + 1
    }
    if neg {
        return 0 - v
    }
    return v
}

# True when `s` is one or more ASCII digits.
export function s_is_digits(s: string) -> bool {
    let n: i32 = s_len(s)
    if n == 0 {
        return false
    }
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    while i < n {
        if p[i] < 48 or p[i] > 57 {
            return false
        }
        i = i + 1
    }
    return true
}

export function s_replace(s: string, old: string, new: string) -> string {
    let m: i32 = s_len(old)
    if m == 0 {
        return s
    }
    let mut out: string = ""
    let mut pos: i32 = 0
    while true {
        let at: i32 = s_find(s, old, pos)
        if at < 0 {
            break
        }
        out = out + s_slice(s, pos, at) + new
        pos = at + m
    }
    return out + s_from(s, pos)
}

export function s_is_space(c: i32) -> bool {
    return c == 32 or c == 9 or c == 10 or c == 13 or c == 11 or c == 12
}

# `$(...)`: drop every trailing newline.
export function s_chomp_all(s: string) -> string {
    let mut n: i32 = s_len(s)
    let p: ptr<u8> = s as ptr<u8>
    while n > 0 and p[n - 1] == 10 {
        n = n - 1
    }
    return s_slice(s, 0, n)
}

# Strip all whitespace, as `tr -d '[:space:]'`.
export function s_strip_all_space(s: string) -> string {
    let n: i32 = s_len(s)
    let p: ptr<u8> = s as ptr<u8>
    let out: ptr<u8> = malloc((n + 1) as i64) as ptr<u8>
    let mut j: i32 = 0
    let mut i: i32 = 0
    while i < n {
        if not s_is_space(p[i] as i32) {
            out[j] = p[i]
            j = j + 1
        }
        i = i + 1
    }
    out[j] = 0
    return out as string
}

export function s_lower(s: string) -> string {
    let n: i32 = s_len(s)
    let p: ptr<u8> = s as ptr<u8>
    let out: ptr<u8> = malloc((n + 1) as i64) as ptr<u8>
    let mut i: i32 = 0
    while i < n {
        let c: u8 = p[i]
        if c >= 65 and c <= 90 {
            out[i] = c + 32
        } else {
            out[i] = c
        }
        i = i + 1
    }
    out[n] = 0
    return out as string
}

# Split on byte `sep`, keeping empty fields.
export function s_split(s: string, sep: i32) -> ptr<ProcStrs> {
    let l: ptr<ProcStrs> = proc_strs_new()
    let n: i32 = s_len(s)
    let p: ptr<u8> = s as ptr<u8>
    let mut start: i32 = 0
    let mut i: i32 = 0
    while i < n {
        if p[i] as i32 == sep {
            proc_strs_push(l, s_slice(s, start, i))
            start = i + 1
        }
        i = i + 1
    }
    proc_strs_push(l, s_slice(s, start, n))
    return l
}

# Lines of `text`, without a final empty line; "" gives no lines.
export function s_lines(text: string) -> ptr<ProcStrs> {
    let l: ptr<ProcStrs> = proc_strs_new()
    let n: i32 = s_len(text)
    let p: ptr<u8> = text as ptr<u8>
    let mut start: i32 = 0
    let mut i: i32 = 0
    while i < n {
        if p[i] == 10 {
            proc_strs_push(l, s_slice(text, start, i))
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        proc_strs_push(l, s_slice(text, start, n))
    }
    return l
}

# Unquoted shell word splitting: fields separated by blanks and newlines.
export function s_words(s: string) -> ptr<ProcStrs> {
    let l: ptr<ProcStrs> = proc_strs_new()
    let n: i32 = s_len(s)
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    while i < n {
        while i < n and (p[i] == 32 or p[i] == 9 or p[i] == 10) {
            i = i + 1
        }
        let start: i32 = i
        while i < n and not (p[i] == 32 or p[i] == 9 or p[i] == 10) {
            i = i + 1
        }
        if i > start {
            proc_strs_push(l, s_slice(s, start, i))
        }
    }
    return l
}

# ---------------------------------------------------------------------------
# String lists (ProcStrs doubles as an argv)
# ---------------------------------------------------------------------------

export function sl_new() -> ptr<ProcStrs> {
    return proc_strs_new()
}

export function sl_of1(a: string) -> ptr<ProcStrs> {
    let l: ptr<ProcStrs> = proc_strs_new()
    proc_strs_push(l, a)
    return l
}

export function sl_of2(a: string, b: string) -> ptr<ProcStrs> {
    let l: ptr<ProcStrs> = sl_of1(a)
    proc_strs_push(l, b)
    return l
}

export function sl_of3(a: string, b: string, c: string) -> ptr<ProcStrs> {
    let l: ptr<ProcStrs> = sl_of2(a, b)
    proc_strs_push(l, c)
    return l
}

export function sl_push(l: ptr<ProcStrs>, s: string) {
    proc_strs_push(l, s)
}

export function sl_push2(l: ptr<ProcStrs>, a: string, b: string) {
    proc_strs_push(l, a)
    proc_strs_push(l, b)
}

export function sl_len(l: ptr<ProcStrs>) -> i32 {
    return proc_strs_len(l)
}

export function sl_get(l: ptr<ProcStrs>, i: i32) -> string {
    return proc_strs_get(l, i)
}

export function sl_extend(l: ptr<ProcStrs>, more: ptr<ProcStrs>) {
    let mut i: i32 = 0
    while i < proc_strs_len(more) {
        proc_strs_push(l, proc_strs_get(more, i))
        i = i + 1
    }
}

export function sl_copy(l: ptr<ProcStrs>) -> ptr<ProcStrs> {
    let c: ptr<ProcStrs> = proc_strs_new()
    sl_extend(c, l)
    return c
}

# Elements [from, len).
export function sl_tail(l: ptr<ProcStrs>, from: i32) -> ptr<ProcStrs> {
    let c: ptr<ProcStrs> = proc_strs_new()
    let mut i: i32 = from
    while i < proc_strs_len(l) {
        proc_strs_push(c, proc_strs_get(l, i))
        i = i + 1
    }
    return c
}

# "${arr[*]}": the elements joined with single spaces.
export function sl_join(l: ptr<ProcStrs>, sep: string) -> string {
    let mut out: string = ""
    let mut i: i32 = 0
    while i < proc_strs_len(l) {
        if i > 0 {
            out = out + sep
        }
        out = out + proc_strs_get(l, i)
        i = i + 1
    }
    return out
}

export function sl_has(l: ptr<ProcStrs>, s: string) -> bool {
    let mut i: i32 = 0
    while i < proc_strs_len(l) {
        if s_eq(proc_strs_get(l, i), s) {
            return true
        }
        i = i + 1
    }
    return false
}

# Sort in place by bytes (LC_ALL=C sort), or case-folded when `fold`.
export function sl_sort(l: ptr<ProcStrs>, fold: bool) {
    let n: i32 = proc_strs_len(l)
    let mut i: i32 = 1
    while i < n {
        let cur: string = l.items[i]
        let mut j: i32 = i
        while j > 0 and sl_before(cur, l.items[j - 1], fold) {
            l.items[j] = l.items[j - 1]
            j = j - 1
        }
        l.items[j] = cur
        i = i + 1
    }
}

function sl_before(a: string, b: string, fold: bool) -> bool {
    if fold {
        let c: i32 = strcmp(s_lower(a), s_lower(b))
        if c != 0 {
            return c < 0
        }
    }
    return strcmp(a, b) < 0
}

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

# Redirection of this program's own output, for the places the driver
# captured a shell function (`x=$(f 2>&1)`, `f >/dev/null 2>&1`). Child
# processes started while a redirection is active follow it (see `run`).
#   stdout: SINK_FD (write to fd 1), SINK_BUF (the capture), SINK_NULL
#   stderr: SINK_FD (fd 2), SINK_SAME (wherever stdout goes: 2>&1),
#           SINK_NULL, SINK_BUF (a separate capture)
export const SINK_FD: i32 = 0
export const SINK_SAME: i32 = 1
export const SINK_NULL: i32 = 2
export const SINK_BUF: i32 = 3

export struct Sink {
    out_mode: i32,
    err_mode: i32,
    out_buf: string,
    err_buf: string,
    prev: ptr<Sink>
}

let mut SINK: ptr<Sink> = null

# Fields of SINK are read through a local copy of the pointer (#1078).

# Start a redirection. Pop it with sink_pop, which returns what stdout
# captured (sink_err holds a separate stderr capture).
export function sink_push(out_mode: i32, err_mode: i32) {
    let s: ptr<Sink> = malloc(48) as ptr<Sink>
    s.out_mode = out_mode
    s.err_mode = err_mode
    s.out_buf = ""
    s.err_buf = ""
    s.prev = SINK
    SINK = s
}

let mut SINK_LAST_ERR: ptr<u8> = null

export function sink_pop() -> string {
    let s: ptr<Sink> = SINK
    if s == null {
        return ""
    }
    SINK = s.prev
    SINK_LAST_ERR = s.err_buf as ptr<u8>
    return s.out_buf
}

# The stderr captured by the redirection sink_pop just ended.
export function sink_err() -> string {
    if SINK_LAST_ERR == null {
        return ""
    }
    return SINK_LAST_ERR as string
}

function sink_out_mode() -> i32 {
    if SINK == null {
        return SINK_FD
    }
    let s: ptr<Sink> = SINK
    return s.out_mode
}

function sink_err_mode() -> i32 {
    if SINK == null {
        return SINK_FD
    }
    let s: ptr<Sink> = SINK
    return s.err_mode
}

function write_out_raw(s: string) {
    let m: i32 = sink_out_mode()
    if m == SINK_BUF {
        let k: ptr<Sink> = SINK
        k.out_buf = k.out_buf + s
    } elif m == SINK_FD {
        let _w: i64 = flow_cli_write(1, s as ptr<u8>, s_len(s) as i64)
    }
}

export function out(s: string) {
    write_out_raw(s)
}

export function outln(s: string) {
    out(s + "\n")
}

export function errs(s: string) {
    let m: i32 = sink_err_mode()
    if m == SINK_SAME {
        write_out_raw(s)
    } elif m == SINK_BUF {
        let k: ptr<Sink> = SINK
        k.err_buf = k.err_buf + s
    } elif m == SINK_FD {
        let _w: i64 = flow_cli_write(2, s as ptr<u8>, s_len(s) as i64)
    }
}

export function errln(s: string) {
    errs(s + "\n")
}

# `echo` to stdout (fd 1) or stderr (fd 2).
export function echo_fd(fd: i32, s: string) {
    if fd == 2 {
        errln(s)
    } else {
        outln(s)
    }
}

export const C_RED: string = "\x1b[0;31m"
export const C_GREEN: string = "\x1b[0;32m"
export const C_BLUE: string = "\x1b[0;34m"
export const C_YELLOW: string = "\x1b[1;33m"
export const C_NC: string = "\x1b[0m"

# The driver's print_info, print_success, print_error and print_warning,
# to stdout; the _to forms pick the stream.
export function info_to(fd: i32, s: string) {
    echo_fd(fd, C_BLUE + "ℹ️  " + s + C_NC)
}

export function success_to(fd: i32, s: string) {
    echo_fd(fd, C_GREEN + "✅ " + s + C_NC)
}

export function error_to(fd: i32, s: string) {
    echo_fd(fd, C_RED + "❌ " + s + C_NC)
}

export function warning_to(fd: i32, s: string) {
    echo_fd(fd, C_YELLOW + "⚠️  " + s + C_NC)
}

export function info(s: string) {
    info_to(1, s)
}

export function success(s: string) {
    success_to(1, s)
}

export function error(s: string) {
    error_to(1, s)
}

export function warning(s: string) {
    warning_to(1, s)
}

# ---------------------------------------------------------------------------
# Exit and cleanup
# ---------------------------------------------------------------------------

# Directories removed when the CLI exits through cli_exit (the driver's
# `trap 'rm -rf ...' EXIT`).
let mut CLEANUP: ptr<ProcStrs> = null

export function on_exit_remove(path: string) {
    if CLEANUP == null {
        CLEANUP = proc_strs_new()
    }
    proc_strs_push(CLEANUP, path)
}

export function cli_exit(code: i32) {
    if CLEANUP != null {
        let mut i: i32 = 0
        while i < proc_strs_len(CLEANUP) {
            rm_rf(proc_strs_get(CLEANUP, i))
            i = i + 1
        }
    }
    flow_cli_exit(code)
}

# `set -e`: stop with the status of a failed step.
export function check(rc: i32) {
    if rc != 0 {
        cli_exit(rc)
    }
}

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

# $NAME, "" when unset.
export function env(name: string) -> string {
    return proc_getenv(name)
}

export function env_isset(name: string) -> bool {
    return proc_has_env(name)
}

# ${NAME:-dflt}
export function env_or(name: string, dflt: string) -> string {
    let v: string = proc_getenv(name)
    if s_len(v) == 0 {
        return dflt
    }
    return v
}

# `export NAME=value`
export function env_set(name: string, value: string) {
    let _s: bool = proc_setenv(name, value)
}

export function env_unset(name: string) {
    let _u: bool = proc_unsetenv(name)
}

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

export function is_abs(p: string) -> bool {
    return s_starts(p, "/")
}

# POSIX dirname(1).
export function path_dirname(p: string) -> string {
    let mut s: string = p
    while s_len(s) > 1 and s_ends(s, "/") {
        s = s_slice(s, 0, s_len(s) - 1)
    }
    let i: i32 = s_rfind_byte(s, 47)
    if i < 0 {
        return "."
    }
    let mut d: string = s_slice(s, 0, i)
    while s_len(d) > 1 and s_ends(d, "/") {
        d = s_slice(d, 0, s_len(d) - 1)
    }
    if s_len(d) == 0 {
        return "/"
    }
    return d
}

# POSIX basename(1).
export function path_basename(p: string) -> string {
    let mut s: string = p
    while s_len(s) > 1 and s_ends(s, "/") {
        s = s_slice(s, 0, s_len(s) - 1)
    }
    let i: i32 = s_rfind_byte(s, 47)
    if i < 0 or s_eq(s, "/") {
        return s
    }
    return s_from(s, i + 1)
}

# basename(1) with a suffix: "$(basename "$p" .flow)".
export function path_stem(p: string, suffix: string) -> string {
    let b: string = path_basename(p)
    if s_ends(b, suffix) and s_len(b) > s_len(suffix) {
        return s_slice(b, 0, s_len(b) - s_len(suffix))
    }
    return b
}

# ${p%.*}: drop the last extension.
export function path_drop_ext(p: string) -> string {
    let dot: i32 = s_rfind_byte(p, 46)
    if dot < 0 {
        return p
    }
    return s_slice(p, 0, dot)
}

# ${p##*.}
export function path_ext(p: string) -> string {
    let dot: i32 = s_rfind_byte(p, 46)
    if dot < 0 {
        return p
    }
    return s_from(p, dot + 1)
}

# Lexical normalisation of an absolute path, as `cd` does it in logical
# mode: "." and empty segments go, ".." drops the segment before it.
export function path_norm_abs(p: string) -> string {
    let parts: ptr<ProcStrs> = s_split(p, 47)
    let keep: ptr<ProcStrs> = proc_strs_new()
    let mut i: i32 = 0
    while i < proc_strs_len(parts) {
        let seg: string = proc_strs_get(parts, i)
        if s_eq(seg, "..") {
            if proc_strs_len(keep) > 0 {
                keep.len = keep.len - 1
                keep.items[keep.len] = null as string
            }
        } elif s_len(seg) > 0 and not s_eq(seg, ".") {
            proc_strs_push(keep, seg)
        }
        i = i + 1
    }
    if proc_strs_len(keep) == 0 {
        return "/"
    }
    return "/" + sl_join(keep, "/")
}

# The shell's logical working directory ($PWD when it names ".").
export function cwd_logical() -> string {
    let pwd: string = env("PWD")
    let phys: string = proc_getcwd()
    if is_abs(pwd) {
        let a: string = flow_cli_realpath(pwd)
        if (a as ptr<u8>) != null and s_eq(a, phys) {
            return pwd
        }
    }
    return phys
}

export function cwd_physical() -> string {
    return proc_getcwd()
}

# "$(cd "$d" && pwd)", or "" when `d` is not a directory.
export function abs_dir(d: string) -> string {
    if not is_dir(d) {
        return ""
    }
    if is_abs(d) {
        return path_norm_abs(d)
    }
    return path_norm_abs(cwd_logical() + "/" + d)
}

# "$(cd -P "$d" && pwd)" (and `pwd -P`), or "" when `d` is not a directory.
export function abs_dir_physical(d: string) -> string {
    if not is_dir(d) {
        return ""
    }
    let r: string = flow_cli_realpath(d)
    if (r as ptr<u8>) == null {
        return ""
    }
    return r
}

# "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
export function abs_file(p: string) -> string {
    return abs_dir(path_dirname(p)) + "/" + path_basename(p)
}

export function abs_file_physical(p: string) -> string {
    return abs_dir_physical(path_dirname(p)) + "/" + path_basename(p)
}

# ---------------------------------------------------------------------------
# Files
# ---------------------------------------------------------------------------

export function is_file(p: string) -> bool {
    return flow_cli_kind(p) == 1
}

export function is_dir(p: string) -> bool {
    return flow_cli_kind(p) == 2
}

export function exists(p: string) -> bool {
    return flow_cli_kind(p) != 0
}

export function is_link(p: string) -> bool {
    return flow_cli_is_link(p) == 1
}

# [ -x p ]
export function is_exec(p: string) -> bool {
    return flow_cli_access(p, 1) == 1
}

# [ -w p ]
export function is_writable(p: string) -> bool {
    return flow_cli_access(p, 2) == 1
}

# [ -s p ]: exists and is not empty.
export function nonempty(p: string) -> bool {
    return flow_cli_size(p) > 0
}

export function mtime(p: string) -> i64 {
    return flow_cli_mtime_ns(p)
}

# [ a -nt b ]: a exists and b does not, or a is newer.
export function newer(a: string, b: string) -> bool {
    let ma: i64 = flow_cli_mtime_ns(a)
    if ma < 0 {
        return false
    }
    let mb: i64 = flow_cli_mtime_ns(b)
    if mb < 0 {
        return true
    }
    return ma > mb
}

# mkdir -p; true on success.
export function mkdir_p(p: string) -> bool {
    if is_dir(p) {
        return true
    }
    let parent: string = path_dirname(p)
    if not s_eq(parent, p) and not is_dir(parent) {
        if not mkdir_p(parent) {
            return false
        }
    }
    return flow_cli_mkdir(p) == 0
}

# mkdir -p that reports like the shell and stops on failure (set -e).
export function mkdir_p_or_exit(p: string) {
    if not mkdir_p(p) {
        errln("mkdir: " + p + ": cannot create directory")
        cli_exit(1)
    }
}

export function rm_f(p: string) {
    let _u: i32 = flow_cli_unlink(p)
}

# rm -rf: does not follow symlinks into directories.
export function rm_rf(p: string) {
    if flow_cli_lexists(p) == 0 {
        return
    }
    if is_link(p) or not is_dir(p) {
        let _u: i32 = flow_cli_unlink(p)
        return
    }
    let names: ptr<ProcStrs> = list_dir(p)
    let mut i: i32 = 0
    while i < proc_strs_len(names) {
        rm_rf(p + "/" + proc_strs_get(names, i))
        i = i + 1
    }
    let _r: i32 = flow_cli_rmdir(p)
}

# mv -f a b (same file system).
export function move_file(a: string, b: string) -> bool {
    return flow_cli_rename(a, b) == 0
}

# Directory entries without "." and "..", unsorted (readdir order).
export function list_dir(p: string) -> ptr<ProcStrs> {
    let l: ptr<ProcStrs> = proc_strs_new()
    let d: ptr<void> = flow_cli_opendir(p)
    if d == null {
        return l
    }
    while true {
        let name: string = flow_cli_readdir(d)
        if (name as ptr<u8>) == null {
            break
        }
        if not s_eq(name, ".") and not s_eq(name, "..") {
            proc_strs_push(l, name + "")
        }
    }
    flow_cli_closedir(d)
    return l
}

# "dir"/*"suffix" as the shell expands it: sorted, full paths.
export function glob_suffix(dir: string, suffix: string) -> ptr<ProcStrs> {
    let names: ptr<ProcStrs> = list_dir(dir)
    let keep: ptr<ProcStrs> = proc_strs_new()
    let mut i: i32 = 0
    while i < proc_strs_len(names) {
        let n: string = proc_strs_get(names, i)
        if s_ends(n, suffix) and not s_starts(n, ".") {
            proc_strs_push(keep, n)
        }
        i = i + 1
    }
    sl_sort(keep, false)
    let out: ptr<ProcStrs> = proc_strs_new()
    let mut j: i32 = 0
    while j < proc_strs_len(keep) {
        proc_strs_push(out, dir + "/" + proc_strs_get(keep, j))
        j = j + 1
    }
    return out
}

# mktemp -d TEMPLATE (ending in X's); "" on failure.
export function mktemp_dir(template: string) -> string {
    let r: string = flow_cli_mkdtemp(template)
    if (r as ptr<u8>) == null {
        return ""
    }
    return r
}

# mktemp TEMPLATE; "" on failure.
export function mktemp_file(template: string) -> string {
    let r: string = flow_cli_mkstemp(template)
    if (r as ptr<u8>) == null {
        return ""
    }
    return r
}

# The directory mktemp uses without a template: $TMPDIR or /tmp.
export function tmp_base() -> string {
    let mut t: string = env_or("TMPDIR", "/tmp")
    while s_len(t) > 1 and s_ends(t, "/") {
        t = s_slice(t, 0, s_len(t) - 1)
    }
    return t
}

# `mktemp -d` with no arguments.
export function mktemp_dir_default() -> string {
    return mktemp_dir(tmp_base() + "/tmp.XXXXXXXXXX")
}

# `mktemp` with no arguments.
export function mktemp_file_default() -> string {
    return mktemp_file(tmp_base() + "/tmp.XXXXXXXXXX")
}

export struct Bytes {
    data: ptr<u8>,
    len: i64
}

# The whole file; len is -1 when it cannot be read.
export function read_bytes(p: string) -> Bytes {
    let lp: ptr<i64> = malloc(8) as ptr<i64>
    let d: ptr<u8> = flow_cli_read_bytes(p, lp)
    return Bytes { data: d, len: lp[0] }
}

# The file as text, or "" when it cannot be read.
export function read_text(p: string) -> string {
    let b: Bytes = read_bytes(p)
    if b.len < 0 {
        return ""
    }
    return b.data as string
}

export function write_text(p: string, text: string) -> bool {
    return flow_cli_write_bytes(p, text as ptr<u8>, s_len(text) as i64, 0) == 0
}

export function append_text(p: string, text: string) -> bool {
    return flow_cli_write_bytes(p, text as ptr<u8>, s_len(text) as i64, 1) == 0
}

# cp a b (contents only).
export function copy_file(a: string, b: string) -> bool {
    let d: Bytes = read_bytes(a)
    if d.len < 0 {
        return false
    }
    return flow_cli_write_bytes(b, d.data, d.len, 0) == 0
}

# cmp -s a b
export function same_bytes(a: string, b: string) -> bool {
    let x: Bytes = read_bytes(a)
    let y: Bytes = read_bytes(b)
    if x.len < 0 or y.len < 0 or x.len != y.len {
        return false
    }
    let mut i: i64 = 0
    while i < x.len {
        if x.data[i] != y.data[i] {
            return false
        }
        i = i + 1
    }
    return true
}

# The first `n` lines of a file (`head -n N`), each with its newline.
export function head_lines(p: string, n: i32) -> string {
    let text: string = read_text(p)
    let tp: ptr<u8> = text as ptr<u8>
    let len: i32 = s_len(text)
    let mut seen: i32 = 0
    let mut i: i32 = 0
    while i < len and seen < n {
        if tp[i] == 10 {
            seen = seen + 1
        }
        i = i + 1
    }
    return s_slice(text, 0, i)
}

export function set_mode(p: string, mode: i32) -> bool {
    return flow_cli_chmod(p, mode) == 0
}

# ---------------------------------------------------------------------------
# Host
# ---------------------------------------------------------------------------

# uname -s
export function uname_s() -> string {
    return flow_cli_uname(0)
}

# uname -m
export function uname_m() -> string {
    return flow_cli_uname(1)
}

# [ -t fd ]
export function is_tty(fd: i32) -> bool {
    return flow_cli_isatty(fd) == 1
}

# `command -v name`: the path, or "" when there is none.
export function which(name: string) -> string {
    let p: string = proc_which(name)
    if s_len(p) == 0 or is_dir(p) {
        return ""
    }
    return p
}

export function have(name: string) -> bool {
    return s_len(which(name)) > 0
}

# ---------------------------------------------------------------------------
# Processes
# ---------------------------------------------------------------------------

# A command from an argv list, connected like a shell command: stdin,
# stdout and stderr are this program's.
export function cmd(argv: ptr<ProcStrs>) -> ptr<ProcCmd> {
    let c: ptr<ProcCmd> = proc_cmd(proc_strs_get(argv, 0))
    let mut i: i32 = 1
    while i < proc_strs_len(argv) {
        proc_arg(c, proc_strs_get(argv, i))
        i = i + 1
    }
    proc_stdin(c, PROC_INHERIT)
    proc_stdout(c, PROC_INHERIT)
    proc_stderr(c, PROC_INHERIT)
    return c
}

# `NAME=value cmd`
export function cmd_env(c: ptr<ProcCmd>, name: string, value: string) {
    proc_env(c, name, value)
}

export function cmd_cwd(c: ptr<ProcCmd>, dir: string) {
    proc_cwd(c, dir)
}

# >/dev/null, 2>/dev/null, </dev/null
export function cmd_quiet_out(c: ptr<ProcCmd>) {
    proc_stdout(c, PROC_NULL)
}

export function cmd_quiet_err(c: ptr<ProcCmd>) {
    proc_stderr(c, PROC_NULL)
}

export function cmd_quiet(c: ptr<ProcCmd>) {
    proc_stdout(c, PROC_NULL)
    proc_stderr(c, PROC_NULL)
}

export function cmd_no_stdin(c: ptr<ProcCmd>) {
    proc_stdin(c, PROC_NULL)
}

# 2>&1: stderr joins stdout.
export function cmd_merge_err(c: ptr<ProcCmd>) {
    proc_stderr(c, PROC_MERGE)
}

export function cmd_capture_out(c: ptr<ProcCmd>) {
    proc_stdout(c, PROC_CAPTURE)
}

export function cmd_capture_err(c: ptr<ProcCmd>) {
    proc_stderr(c, PROC_CAPTURE)
}

# The status a shell reports: the exit code, 128 + N for signal N, 127
# when the program could not be started (with the shell's message).
export function shell_status(c: ptr<ProcCmd>, r: ptr<ProcResult>) -> i32 {
    if s_len(r.error) > 0 {
        let prog: string = proc_strs_get(c.argv, 0)
        if s_contains(prog, "/") {
            errln("flow: " + prog + ": No such file or directory")
        } else {
            errln("flow: " + prog + ": command not found")
        }
        return 127
    }
    if r.exit_code < 0 {
        return 128 - r.exit_code
    }
    return r.exit_code
}

# Run and return the full result, with the shell's status in exit_code.
# Streams left as this program's follow an active redirection (sink_push).
export function run_result(c: ptr<ProcCmd>) -> ptr<ProcResult> {
    let om: i32 = sink_out_mode()
    let em: i32 = sink_err_mode()
    let mut cap_out: bool = false
    let mut cap_err: bool = false
    if c.out_mode == PROC_INHERIT {
        if om == SINK_BUF {
            c.out_mode = PROC_CAPTURE
            cap_out = true
        } elif om == SINK_NULL {
            c.out_mode = PROC_NULL
        }
    }
    if c.err_mode == PROC_INHERIT {
        if em == SINK_SAME {
            c.err_mode = PROC_MERGE
        } elif em == SINK_NULL {
            c.err_mode = PROC_NULL
        } elif em == SINK_BUF {
            c.err_mode = PROC_CAPTURE
            cap_err = true
        }
    }
    let r: ptr<ProcResult> = proc_run(c)
    r.exit_code = shell_status(c, r)
    if cap_out {
        write_out_raw(r.stdout)
        r.stdout = ""
    }
    if cap_err {
        errs(r.stderr)
        r.stderr = ""
    }
    return r
}

# Run; return the shell status.
export function run(c: ptr<ProcCmd>) -> i32 {
    let r: ptr<ProcResult> = run_result(c)
    return r.exit_code
}

export function run_argv(argv: ptr<ProcStrs>) -> i32 {
    return run(cmd(argv))
}

# Run with stdout (and stderr, when `merge`) captured into `path`, as
# `cmd > path` or `cmd > path 2>&1`.
# `cmd >&2`: the child's stdout goes to this program's stderr (collected,
# then written).
export function run_out_to_err(c: ptr<ProcCmd>) -> i32 {
    proc_stdout(c, PROC_CAPTURE)
    let r: ptr<ProcResult> = run_result(c)
    errs(r.stdout)
    return r.exit_code
}

export function run_to_file(c: ptr<ProcCmd>, path: string, merge: bool) -> i32 {
    proc_stdout(c, PROC_CAPTURE)
    if merge {
        proc_stderr(c, PROC_MERGE)
    }
    let r: ptr<ProcResult> = run_result(c)
    let _w: bool = write_text(path, r.stdout)
    return r.exit_code
}

# Run with stderr captured into `path` (`2> path`).
export function run_err_to_file(c: ptr<ProcCmd>, path: string) -> i32 {
    proc_stderr(c, PROC_CAPTURE)
    let r: ptr<ProcResult> = run_result(c)
    let _w: bool = write_text(path, r.stderr)
    return r.exit_code
}

# The status of the last capture.
let mut LAST_STATUS: i32 = 0

export function last_status() -> i32 {
    return LAST_STATUS
}

# "$(cmd)": stdout without trailing newlines; stderr passes through.
# The status is in last_status().
export function capture(c: ptr<ProcCmd>) -> string {
    proc_stdout(c, PROC_CAPTURE)
    let r: ptr<ProcResult> = run_result(c)
    LAST_STATUS = r.exit_code
    return s_chomp_all(r.stdout)
}

# stdout exactly as written (a pipe stage); status in last_status().
export function capture_raw(c: ptr<ProcCmd>) -> string {
    proc_stdout(c, PROC_CAPTURE)
    let r: ptr<ProcResult> = run_result(c)
    LAST_STATUS = r.exit_code
    return r.stdout
}

# "$(cmd 2>&1)"
export function capture_merged(c: ptr<ProcCmd>) -> string {
    proc_stdout(c, PROC_CAPTURE)
    proc_stderr(c, PROC_MERGE)
    let r: ptr<ProcResult> = run_result(c)
    LAST_STATUS = r.exit_code
    return s_chomp_all(r.stdout)
}

# `exec cmd`: replace this process. Returns only when exec fails, after
# printing why; the caller exits.
export function exec_argv(argv: ptr<ProcStrs>) -> i32 {
    let e: i32 = flow_cli_execvp(argv.items)
    let prog: string = proc_strs_get(argv, 0)
    errln("flow: " + prog + ": " + flow_cli_strerror(e))
    if e == 2 {
        return 127
    }
    return 126
}

# exec, then exit with the failure status when it could not.
export function exec_or_exit(argv: ptr<ProcStrs>) {
    cli_exit(exec_argv(argv))
}

export function pid() -> i32 {
    return proc_pid()
}
