# @module tools.flow_cli.tests
# @means  The test commands: `flow test` (the compiler tiers), test-runtime,
#         test-lang, test-mlir, test-scripts, test-interop, test-gpu,
#         test-matmul, test-all.

import "tools/flow_cli/sys.flow"
import "tools/flow_cli/toolchain.flow"
import "tools/flow_cli/build.flow"
import std.process { ProcCmd, ProcResult, ProcStrs, proc_arg }

# ---------------------------------------------------------------------------
# flow test: tier 1 (flowc) and tier 2 (clang -fsyntax-only)
# ---------------------------------------------------------------------------

# git-tracked .flow files of a suite, minus the directories their own gates
# check; `find` when this is not a git checkout.
function list_suite_flow_files(suite: string) -> ptr<ProcStrs> {
    let files: ptr<ProcStrs> = sl_new()
    let mut in_git: bool = false
    if have("git") {
        let g: ptr<ProcCmd> = cmd(sl_of3("git", "-C", root()))
        proc_arg2(g, "rev-parse", "--is-inside-work-tree")
        cmd_quiet(g)
        in_git = run(g) == 0
    }
    if in_git {
        let ls: ptr<ProcCmd> = cmd(sl_of3("git", "-C", root()))
        proc_arg2(ls, "ls-files", suite)
        cmd_quiet_err(ls)
        let lines: ptr<ProcStrs> = s_lines(capture(ls))
        let mut i: i32 = 0
        while i < sl_len(lines) {
            let rel: string = sl_get(lines, i)
            if suite_keeps(rel) {
                sl_push(files, root() + "/" + rel)
            }
            i = i + 1
        }
        return files
    }
    let f: ptr<ProcStrs> = sl_of3("find", root() + "/" + suite, "-name")
    sl_push(f, "*.flow")
    let excl: ptr<ProcStrs> = s_words("*/wip/* */fuzz/crashes/* */tests/tools/*/fixtures/* */tests/cgen/* */tests/c_to_hdr/* */tests/check/* */tests/dap/* */tests/doc_examples/* */tests/fir/* */tests/flow_run/* */tests/gpu/* */tests/pkg_commands/* */tests/project_test/* */tests/pywheel/* */tests/targets/* */examples/ecosystem/* */examples/demos/*")
    let mut k: i32 = 0
    while k < sl_len(excl) {
        sl_push2(f, "-not", "-path")
        sl_push(f, sl_get(excl, k))
        k = k + 1
    }
    let fc: ptr<ProcCmd> = cmd(f)
    cmd_quiet_err(fc)
    return s_lines(capture(fc))
}

function proc_arg2(c: ptr<ProcCmd>, a: string, b: string) {
    proc_arg(c, a)
    proc_arg(c, b)
}

# The grep chain over `git ls-files`.
function suite_keeps(rel: string) -> bool {
    if not s_ends(rel, ".flow") {
        return false
    }
    if s_contains(rel, "/wip/") {
        return false
    }
    if s_starts(rel, "examples/verify/") or s_starts(rel, "tests/fuzz/crashes/") {
        return false
    }
    if s_starts(rel, "tests/tools/") {
        let rest: string = s_from(rel, 12)
        let slash: i32 = s_find_byte(rest, 47, 0)
        if slash > 0 and s_starts(s_from(rest, slash), "/fixtures/") {
            return false
        }
    }
    let gated: ptr<ProcStrs> = s_words("cgen c_to_hdr check dap doc_examples fir flow_run gpu pkg_commands project_test pywheel targets")
    let mut i: i32 = 0
    while i < sl_len(gated) {
        if s_starts(rel, "tests/" + sl_get(gated, i) + "/") {
            return false
        }
        i = i + 1
    }
    if s_starts(rel, "examples/ecosystem/") or s_starts(rel, "examples/demos/") {
        return false
    }
    return true
}

export function run_tests(args: ptr<ProcStrs>) -> i32 {
    let mut strict_mode: string = "--lenient"
    let mut tier: string = "2"
    let n: i32 = sl_len(args)
    let mut i: i32 = 0
    while i < n {
        let a: string = sl_get(args, i)
        if s_eq(a, "--strict") {
            strict_mode = "--strict"
        } elif s_eq(a, "--lenient") {
            strict_mode = "--lenient"
        } elif s_eq(a, "--tier1") {
            tier = "1"
        } elif s_eq(a, "--tier2") {
            tier = "2"
        } elif s_eq(a, "--tier") {
            if s_len(sl_get(args, i + 1)) > 0 {
                tier = sl_get(args, i + 1)
                i = i + 1
            } else {
                tier = "2"
            }
        } elif s_starts(a, "--sanitize=") {
            env_set("FLOW_SANITIZE", s_from(a, 11))
        } elif s_eq(a, "--sanitize") {
            if s_len(sl_get(args, i + 1)) == 0 {
                error("--sanitize requires ub,asan,tsan (comma-separated)")
                cli_exit(1)
            }
            env_set("FLOW_SANITIZE", sl_get(args, i + 1))
            i = i + 1
        }
        i = i + 1
    }
    if s_eq(strict_mode, "--strict") {
        info("Running FLOW tests (STRICT MODE, Tier " + tier + ")...")
    } else {
        info("Running FLOW tests (Tier " + tier + ")...")
    }
    let tier_flowc: string = flow_resolve_flowc()
    if s_len(tier_flowc) == 0 {
        cli_exit(1)
    }
    let tier_n: i32 = s_atoi(tier, 0)
    outln("DEBUG: Starting tests, tier=" + tier + ", strict=" + strict_mode + ", flowc=" + tier_flowc)
    outln("DEBUG: SCRIPT_DIR=" + root())
    outln("DEBUG: Looking for tests in tests/ and examples/")
    let mut transpile_failed: i32 = 0
    let mut clang_failed: i32 = 0
    let mut total: i32 = 0
    let mut failed_files: string = ""
    let test_build_dir: string = mktemp_dir_default()
    outln("DEBUG: Created temp dir: " + test_build_dir)
    outln("DEBUG: About to loop through test suites...")
    let suites: ptr<ProcStrs> = sl_of2("tests", "examples")
    let mut si: i32 = 0
    while si < 2 {
        let suite: string = sl_get(suites, si)
        si = si + 1
        outln("DEBUG: Processing suite: " + suite)
        let dir: string = root() + "/" + suite
        if not is_dir(dir) {
            outln("DEBUG: Directory " + dir + " does not exist, skipping")
            continue
        }
        outln("DEBUG: Finding .flow files in " + dir + "...")
        let programs: ptr<ProcStrs> = list_suite_flow_files(suite)
        outln("DEBUG: Found " + s_itoa(sl_len(programs)) + " tracked .flow files in " + suite)
        let mut k: i32 = 0
        while k < sl_len(programs) {
            let program: string = sl_get(programs, k)
            k = k + 1
            if s_len(program) == 0 {
                outln("DEBUG: Empty program entry, skipping")
                continue
            }
            outln("DEBUG: Processing file: " + program)
            total = total + 1
            let rel_path: string = strip_root(program)
            let safe_name: string = s_replace(rel_path, "/", "-")
            let c_file: string = test_build_dir + "/" + safe_name + ".c"
            let head: string = head_lines(program, 3)
            if s_contains(head, "flow:flowc-only") {
                warning("~ " + rel_path + " (flowc-only, skipped on the Python host)")
                continue
            }
            let mut file_mode: string = strict_mode
            if s_eq(strict_mode, "--strict") and s_contains(head, "flow:lenient") {
                file_mode = "--lenient"
                warning("~ " + rel_path + " (marked flow:lenient)")
            }
            let tc: ptr<ProcCmd> = cmd(sl_of3(root() + "/compiler/scripts/flowc_emit.sh", file_mode, program))
            proc_arg(tc, c_file)
            cmd_env(tc, "FLOWC_BIN", tier_flowc)
            let transpile_output: string = capture_merged(tc)
            if last_status() != 0 {
                error("✗ " + rel_path + " (transpile failed)")
                outln("    Error output:")
                out(head_of(transpile_output + "\n", 10))
                transpile_failed = transpile_failed + 1
                failed_files = failed_files + "\n  - " + rel_path + " (transpile)"
                continue
            }
            if tier_n >= 2 and s_eq(suite, "tests") {
                let cl: ptr<ProcStrs> = sl_of3("clang", "-fsyntax-only", "-std=c11")
                sl_extend(cl, s_words("-D_DEFAULT_SOURCE -Wall -Wextra -Wno-unused-function -Wno-unused-variable -Wno-unused-parameter -Wno-error=implicit-function-declaration -Wno-error=int-conversion"))
                sl_push(cl, "-I" + path_dirname(program))
                sl_push(cl, c_file)
                let clang_output: string = capture_merged(cmd(cl))
                if last_status() != 0 {
                    error("✗ " + rel_path + " (clang failed)")
                    outln("    clang output:")
                    out(head_of(clang_output + "\n", 10))
                    clang_failed = clang_failed + 1
                    failed_files = failed_files + "\n  - " + rel_path + " (clang)"
                    continue
                }
            }
            success("✓ " + rel_path)
        }
    }
    rm_rf(test_build_dir)
    outln("----------------------------------------")
    outln("DEBUG: Total tests found: " + s_itoa(total))
    outln("DEBUG: Transpile failures: " + s_itoa(transpile_failed))
    outln("DEBUG: Clang failures: " + s_itoa(clang_failed))
    let total_failed: i32 = transpile_failed + clang_failed
    if total_failed == 0 {
        success("All " + s_itoa(total) + " tests passed! (Tier " + tier + ")")
        return 0
    }
    outln("")
    error("Test failures: " + s_itoa(total_failed) + "/" + s_itoa(total))
    if transpile_failed > 0 {
        error("  Transpile failures: " + s_itoa(transpile_failed))
    }
    if clang_failed > 0 {
        error("  Clang compile failures: " + s_itoa(clang_failed))
    }
    if s_len(failed_files) > 0 {
        outln("\nFailed files:" + failed_files)
    }
    cli_exit(1)
    return 1
}

# ${program#$SCRIPT_DIR/}
export function strip_root(p: string) -> string {
    let prefix: string = root() + "/"
    if s_starts(p, prefix) {
        return s_from(p, s_len(prefix))
    }
    return p
}

# ---------------------------------------------------------------------------
# Program lists for test-runtime and test-lang
# ---------------------------------------------------------------------------

# find DIR -name "*.flow" ! -path "*/wip/*", in find's order.
function find_flow(dir: string) -> ptr<ProcStrs> {
    let f: ptr<ProcStrs> = sl_of3("find", dir, "-name")
    sl_push(f, "*.flow")
    sl_push2(f, "!", "-path")
    sl_push(f, "*/wip/*")
    let c: ptr<ProcCmd> = cmd(f)
    cmd_quiet_err(c)
    return s_lines(capture(c))
}

function collect_programs(targets: ptr<ProcStrs>, default_dir: string) -> ptr<ProcStrs> {
    let progs: ptr<ProcStrs> = sl_new()
    if sl_len(targets) > 0 {
        let mut i: i32 = 0
        while i < sl_len(targets) {
            let t: string = sl_get(targets, i)
            if is_file(t) {
                sl_push(progs, t)
            } elif is_dir(t) {
                sl_extend(progs, find_flow(t))
            }
            i = i + 1
        }
    } else {
        sl_extend(progs, find_flow(default_dir))
    }
    return progs
}

# ---------------------------------------------------------------------------
# test-runtime
# ---------------------------------------------------------------------------

export function run_runtime_tests(args: ptr<ProcStrs>) -> i32 {
    info("Running FLOW runtime tests...")
    let runtime_dir: string = root() + "/tests/runtime"
    let build_dir: string = mktemp_dir_default()
    let mut verbose: bool = false
    let targets: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(args) {
        let a: string = sl_get(args, i)
        if s_eq(a, "--verbose") or s_eq(a, "-v") {
            verbose = true
        } else {
            sl_push(targets, a)
        }
        i = i + 1
    }
    if not is_dir(runtime_dir) {
        warning("No runtime tests directory found at " + runtime_dir)
        info("Creating runtime tests directory...")
        mkdir_p_or_exit(runtime_dir)
        info("Add .flow files to tests/runtime/ to run runtime tests.")
        return 0
    }
    let programs: ptr<ProcStrs> = collect_programs(targets, runtime_dir)
    if sl_len(programs) == 0 {
        error("No runtime test programs found under " + runtime_dir)
        cli_exit(1)
    }
    let mut total: i32 = 0
    let mut passed: i32 = 0
    let mut failed: i32 = 0
    let mut failed_files: string = ""
    let mut k: i32 = 0
    while k < sl_len(programs) {
        let program: string = sl_get(programs, k)
        k = k + 1
        if s_len(program) == 0 {
            continue
        }
        total = total + 1
        let rel_path: string = strip_root(program)
        let basename: string = path_stem(program, ".flow")
        let c_file: string = build_dir + "/" + basename + ".c"
        let exe_file: string = build_dir + "/" + basename
        sink_push(SINK_BUF, SINK_SAME)
        let ts: i32 = flowc_emit_to_c(program, c_file)
        let transpile_output: string = s_chomp_all(sink_pop())
        if ts != 0 or not is_file(c_file) {
            error("✗ " + rel_path + " (flowc failed)")
            if verbose and s_len(transpile_output) > 0 {
                outln(transpile_output)
            }
            failed = failed + 1
            failed_files = failed_files + "\n  - " + rel_path + " (flowc)"
            continue
        }
        sink_push(SINK_BUF, SINK_SAME)
        let cs: i32 = flowc_link_c(c_file, exe_file, program)
        let clang_output: string = s_chomp_all(sink_pop())
        if cs != 0 {
            error("✗ " + rel_path + " (clang compile failed)")
            if s_len(clang_output) > 0 {
                if verbose {
                    outln(clang_output)
                } else {
                    out(tail_of(clang_output + "\n", 12))
                }
            }
            failed = failed + 1
            failed_files = failed_files + "\n  - " + rel_path + " (clang)"
            continue
        }
        let run_output: string = capture_merged(cmd(sl_of1(exe_file)))
        let exit_code: i32 = last_status()
        let expected_file: string = s_slice(program, 0, s_len(program) - 5) + ".expected"
        if is_file(expected_file) {
            let expected_output: string = s_chomp_all(read_text(expected_file))
            if not s_eq(run_output, expected_output) {
                error("✗ " + rel_path + " (output mismatch)")
                failed = failed + 1
                failed_files = failed_files + "\n  - " + rel_path + " (output)"
                continue
            }
        }
        if exit_code == 0 {
            success("✓ " + rel_path)
            if verbose and s_len(run_output) > 0 {
                outln("---- output: " + rel_path + " ----")
                outln(run_output)
                outln("---------------------------")
            }
            passed = passed + 1
        } else {
            error("✗ " + rel_path + " (exit code " + s_itoa(exit_code) + ")")
            if verbose and s_len(run_output) > 0 {
                outln("---- output: " + rel_path + " ----")
                outln(run_output)
                outln("---------------------------")
            }
            failed = failed + 1
            failed_files = failed_files + "\n  - " + rel_path + " (exit=" + s_itoa(exit_code) + ")"
        }
    }
    rm_rf(build_dir)
    outln("----------------------------------------")
    if total == 0 {
        warning("No runtime tests found in " + runtime_dir)
        return 0
    }
    if failed == 0 {
        success("All " + s_itoa(total) + " runtime tests passed!")
        return 0
    }
    error("Runtime test failures: " + s_itoa(failed) + "/" + s_itoa(total))
    if s_len(failed_files) > 0 {
        outln("\nFailed files:" + failed_files)
    }
    cli_exit(1)
    return 1
}

# ---------------------------------------------------------------------------
# test-lang
# ---------------------------------------------------------------------------

# `import concurrent` in any spelling (#1038):
# grep -qE 'stdlib/concurrent\.flow|^import +(std\.|stdlib\.)?concurrent( |$)'
function imports_concurrent(path: string) -> bool {
    let text: string = read_text(path)
    if s_contains(text, "stdlib/concurrent.flow") {
        return true
    }
    let lines: ptr<ProcStrs> = s_lines(text)
    let mut i: i32 = 0
    while i < sl_len(lines) {
        let l: string = sl_get(lines, i)
        if s_starts(l, "import ") {
            let mut j: i32 = 6
            while j < s_len(l) and s_byte(l, j) == 32 {
                j = j + 1
            }
            let mut rest: string = s_from(l, j)
            if s_starts(rest, "std.") {
                rest = s_from(rest, 4)
            } elif s_starts(rest, "stdlib.") {
                rest = s_from(rest, 7)
            }
            if s_eq(rest, "concurrent") or s_starts(rest, "concurrent ") {
                return true
            }
        }
        i = i + 1
    }
    return false
}

# diff -u A B > DIFF: status (0 same, 1 differ).
function diff_u(a: string, b: string, out_file: string) -> i32 {
    let c: ptr<ProcCmd> = cmd(sl_of3("diff", "-u", a))
    proc_arg(c, b)
    return run_to_file(c, out_file, true)
}

export function run_lang_tests(args: ptr<ProcStrs>) -> i32 {
    info("Running FLOW language tests (tests/lang/, strict)...")
    let lang_dir: string = root() + "/tests/lang"
    let build_dir: string = mktemp_dir_default()
    let mut verbose: bool = false
    let targets: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(args) {
        let a: string = sl_get(args, i)
        if s_eq(a, "--verbose") or s_eq(a, "-v") {
            verbose = true
        } else {
            sl_push(targets, a)
        }
        i = i + 1
    }
    let _hm: string = flow_host_mode()
    let lang_flowc: string = flow_resolve_flowc()
    if s_len(lang_flowc) == 0 {
        cli_exit(1)
    }
    info("flowc: " + lang_flowc)
    if not is_dir(lang_dir) {
        error("No language tests directory found at " + lang_dir)
        cli_exit(1)
    }
    let programs: ptr<ProcStrs> = collect_programs(targets, lang_dir)
    if sl_len(programs) == 0 {
        error("No language test programs found under " + lang_dir)
        cli_exit(1)
    }
    let mut total: i32 = 0
    let mut passed: i32 = 0
    let mut failed: i32 = 0
    let mut failed_files: string = ""
    let mut k: i32 = 0
    while k < sl_len(programs) {
        let program: string = sl_get(programs, k)
        k = k + 1
        if s_len(program) == 0 {
            continue
        }
        total = total + 1
        let rel_path: string = strip_root(program)
        let basename: string = path_stem(program, ".flow")
        let c_file: string = build_dir + "/" + basename + ".c"
        let exe_file: string = build_dir + "/" + basename
        let abs_prog: string = abs_file(program)
        let tc: ptr<ProcCmd> = cmd(sl_of1(lang_flowc))
        cmd_cwd(tc, root())
        cmd_env(tc, "FLOWC_BUNDLE", "1")
        cmd_env(tc, "FLOWC_DIR", root())
        cmd_env(tc, "FLOWC_TYPECHECK", "1")
        cmd_env(tc, "FLOWC_CHECKS", env_or("FLOWC_CHECKS", "1"))
        cmd_env(tc, "FLOWC_IN", abs_prog)
        cmd_env(tc, "FLOWC_OUT", c_file)
        let saved_lenient: string = env("FLOWC_LENIENT")
        let had_lenient: bool = env_isset("FLOWC_LENIENT")
        env_unset("FLOWC_LENIENT")
        let transpile_output: string = capture_merged(tc)
        let ts: i32 = last_status()
        restore_env("FLOWC_LENIENT", had_lenient, saved_lenient)
        if ts != 0 or not is_file(c_file) {
            error("✗ " + rel_path + " (strict transpile failed)")
            if s_len(transpile_output) > 0 {
                out(tail_of(transpile_output + "\n", 12))
            }
            failed = failed + 1
            failed_files = failed_files + "\n  - " + rel_path + " (transpile)"
            continue
        }
        let conc_src: ptr<ProcStrs> = sl_new()
        let conc_cf: ptr<ProcStrs> = sl_new()
        let conc_ld: ptr<ProcStrs> = sl_new()
        if imports_concurrent(program) {
            concurrency_flags()
            let rtf: ptr<ProcStrs> = runtime_flow_sources()
            sl_extend(conc_src, conc_sources())
            sl_extend(conc_src, rtf)
            sl_extend(conc_cf, conc_cflags())
            sl_extend(conc_ld, conc_ldflags())
        }
        collect_cflags()
        let cl: ptr<ProcStrs> = sl_of1("clang")
        sl_extend(cl, collected_cflags())
        sl_push(cl, "-I" + lang_dir)
        sl_extend(cl, conc_cf)
        sl_push(cl, c_file)
        sl_extend(cl, conc_src)
        sl_extend(cl, conc_ld)
        sl_extend(cl, collected_ldflags())
        sl_push2(cl, "-o", exe_file)
        sl_push(cl, "-lm")
        let clang_output: string = capture_merged(cmd(cl))
        if last_status() != 0 {
            error("✗ " + rel_path + " (clang compile failed)")
            if s_len(clang_output) > 0 {
                if verbose {
                    outln(clang_output)
                } else {
                    out(tail_of(clang_output + "\n", 12))
                }
            }
            failed = failed + 1
            failed_files = failed_files + "\n  - " + rel_path + " (clang)"
            continue
        }
        let stdout_file: string = build_dir + "/" + basename + ".stdout"
        let stderr_file: string = build_dir + "/" + basename + ".stderr"
        let rc: ptr<ProcCmd> = cmd(sl_of1(exe_file))
        cmd_capture_out(rc)
        cmd_capture_err(rc)
        let rr: ptr<ProcResult> = run_result(rc)
        let exit_code: i32 = rr.exit_code
        let _w1: bool = write_text(stdout_file, rr.stdout)
        let _w2: bool = write_text(stderr_file, rr.stderr)
        let so: string = rr.stdout
        let se: string = rr.stderr
        let run_output: string = s_chomp_all(so + se)
        let stem: string = s_slice(program, 0, s_len(program) - 5)
        let exitcode_file: string = stem + ".exitcode"
        let mut want_exit: string = "0"
        if is_file(exitcode_file) {
            want_exit = s_strip_all_space(read_text(exitcode_file))
        }
        let want: i32 = s_atoi(want_exit, 0)
        let mut mismatch: bool = false
        let expected_file: string = stem + ".expected"
        if exit_code == want and is_file(expected_file) {
            let dfile: string = build_dir + "/" + basename + ".diff"
            if diff_u(expected_file, stdout_file, dfile) != 0 {
                error("✗ " + rel_path + " (stdout differs from " + strip_root(expected_file) + ")")
                out(read_text(dfile))
                mismatch = true
                failed_files = failed_files + "\n  - " + rel_path + " (stdout)"
            }
        }
        let expected_err: string = stem + ".expected-stderr"
        if not mismatch and exit_code == want and is_file(expected_err) {
            let efile: string = build_dir + "/" + basename + ".errdiff"
            if diff_u(expected_err, stderr_file, efile) != 0 {
                error("✗ " + rel_path + " (stderr differs from " + strip_root(expected_err) + ")")
                out(read_text(efile))
                mismatch = true
                failed_files = failed_files + "\n  - " + rel_path + " (stderr)"
            }
        }
        if mismatch {
            failed = failed + 1
            continue
        }
        if exit_code == want {
            success("✓ " + rel_path)
            if verbose and s_len(run_output) > 0 {
                outln("---- output: " + rel_path + " ----")
                outln(run_output)
                outln("---------------------------")
            }
            passed = passed + 1
        } else {
            error("✗ " + rel_path + " (exit code " + s_itoa(exit_code) + ", expected " + want_exit + ")")
            if s_len(run_output) > 0 {
                outln("---- output: " + rel_path + " ----")
                outln(run_output)
                outln("---------------------------")
            }
            failed = failed + 1
            failed_files = failed_files + "\n  - " + rel_path + " (exit=" + s_itoa(exit_code) + " want=" + want_exit + ")"
        }
    }
    rm_rf(build_dir)
    outln("----------------------------------------")
    if failed == 0 {
        success("All " + s_itoa(total) + " language tests passed!")
        return 0
    }
    error("Language test failures: " + s_itoa(failed) + "/" + s_itoa(total))
    if s_len(failed_files) > 0 {
        outln("\nFailed files:" + failed_files)
    }
    cli_exit(1)
    return 1
}

# ---------------------------------------------------------------------------
# test-mlir
# ---------------------------------------------------------------------------

export function run_mlir_tests() -> i32 {
    info("Running MLIR verification tests...")
    resolve_llvm_path()
    if not have(llvm_path() + "/mlir-opt") {
        warning("MLIR tools not found. Skipping MLIR verification tests.")
        info("Install with: brew install llvm")
        return 0
    }
    let mlir_test_dir: string = root() + "/tests/mlir"
    let build_dir: string = mktemp_dir_default()
    let test_files: ptr<ProcStrs> = sl_new()
    if is_dir(mlir_test_dir) {
        let f: ptr<ProcStrs> = sl_of3("find", mlir_test_dir, "-name")
        sl_push(f, "*.flow")
        let c: ptr<ProcCmd> = cmd(f)
        cmd_quiet_err(c)
        sl_extend(test_files, s_lines(capture(c)))
    }
    let core: ptr<ProcStrs> = sl_of3("tests/core/hello_world.flow", "tests/core/fibonacci.flow", "tests/core/loops.flow")
    let mut i: i32 = 0
    while i < 3 {
        if is_file(root() + "/" + sl_get(core, i)) {
            sl_push(test_files, root() + "/" + sl_get(core, i))
        }
        i = i + 1
    }
    if sl_len(test_files) == 0 {
        warning("No MLIR test files found.")
        rm_rf(build_dir)
        return 0
    }
    let mut total: i32 = 0
    let mut passed: i32 = 0
    let mut failed: i32 = 0
    let mut skipped: i32 = 0
    let mut k: i32 = 0
    while k < sl_len(test_files) {
        let program: string = sl_get(test_files, k)
        k = k + 1
        total = total + 1
        let rel_path: string = strip_root(program)
        let mlir_file: string = build_dir + "/" + path_stem(program, ".flow") + ".mlir"
        let _g: string = capture_merged(flow_emit_mlir_cmd(sl_of3("--lenient", program, mlir_file)))
        if last_status() != 0 {
            error("✗ " + rel_path + " (MLIR generation failed)")
            failed = failed + 1
            continue
        }
        let verify_output: string = capture_merged(cmd(sl_of3(llvm_path() + "/mlir-opt", mlir_file, "--verify-diagnostics")))
        if last_status() != 0 {
            if s_contains(verify_output, "unknown dialect") or s_contains(verify_output, "unregistered operation") {
                warning("⊘ " + rel_path + " (skipped: dialect not available)")
                skipped = skipped + 1
            } else {
                error("✗ " + rel_path + " (MLIR verification failed)")
                failed = failed + 1
            }
            continue
        }
        success("✓ " + rel_path)
        passed = passed + 1
    }
    rm_rf(build_dir)
    outln("----------------------------------------")
    info("MLIR tests: " + s_itoa(passed) + " passed, " + s_itoa(failed) + " failed, " + s_itoa(skipped) + " skipped (of " + s_itoa(total) + ")")
    if failed > 0 {
        return 1
    }
    return 0
}

# ---------------------------------------------------------------------------
# test-scripts, test-interop, test-gpu, test-matmul, test-all
# ---------------------------------------------------------------------------

export function run_script_tests(args: ptr<ProcStrs>) -> i32 {
    let argv: ptr<ProcStrs> = sl_of1(root() + "/tests/scripts/run.sh")
    sl_extend(argv, args)
    return run_argv(argv)
}

export function run_interop_tests() -> i32 {
    info("Running interop tests...")
    check_deps()
    return run_runtime_tests(sl_of1(root() + "/tests/runtime/interop"))
}

export function run_gpu_tests(args: ptr<ProcStrs>) -> i32 {
    info("Running GPU feature tests...")
    check_deps()
    let rt_args: ptr<ProcStrs> = sl_new()
    let mut i: i32 = 0
    while i < sl_len(args) {
        let a: string = sl_get(args, i)
        if s_eq(a, "--verbose") or s_eq(a, "-v") {
            sl_push(rt_args, "--verbose")
        }
        i = i + 1
    }
    sl_push(rt_args, root() + "/tests/runtime/gpu_features.flow")
    check(run_runtime_tests(rt_args))
    info("Running GPU codegen check (flow gpu, Metal)...")
    let mut gpu_status: i32 = 0
    let progs: ptr<ProcStrs> = sl_of3("examples/gpu/vector_add_gpu.flow:vector_add vector_scale vector_saxpy", "examples/gpu/flow_gpu_vector_add.flow:vec_add_gpu", "lib/stdlib/gpu_gradients.flow:gpu_mse_grad gpu_relu_grad gpu_sigmoid_grad")
    let mut k: i32 = 0
    while k < 3 {
        let spec: string = sl_get(progs, k)
        k = k + 1
        let colon: i32 = s_find_byte(spec, 58, 0)
        let prog: string = s_slice(spec, 0, colon)
        let want: ptr<ProcStrs> = s_words(s_from(spec, colon + 1))
        let mut j: i32 = 0
        while j < sl_len(want) {
            rm_f(root() + "/build/gpu/" + sl_get(want, j) + ".metal")
            j = j + 1
        }
        let c: ptr<ProcCmd> = cmd(sl_of3(root() + "/flow", "gpu", root() + "/" + prog))
        cmd_quiet(c)
        if run(c) != 0 {
            error("flow gpu failed: " + prog)
            gpu_status = 1
            continue
        }
        j = 0
        while j < sl_len(want) {
            if not is_file(root() + "/build/gpu/" + sl_get(want, j) + ".metal") {
                error("missing build/gpu/" + sl_get(want, j) + ".metal from " + prog)
                gpu_status = 1
            }
            j = j + 1
        }
    }
    if gpu_status == 0 {
        success("✅ GPU codegen test passed!")
        return 0
    }
    error("❌ GPU codegen test failed")
    cli_exit(1)
    return 1
}

export function run_matmul_tests(args: ptr<ProcStrs>) -> i32 {
    let program: string = root() + "/examples/bench/matmul_optimizations.flow"
    let mlir_program: string = root() + "/examples/bench/matmul_mlir.flow"
    let build_dir: string = build_root()
    let c_file: string = build_dir + "/matmul_optimizations.asm_args.c"
    let s_file: string = build_dir + "/matmul_optimizations.s"
    let mlir_file: string = build_dir + "/matmul_mlir.mlir"
    let mut print_asm: bool = true
    let mut print_mlir: bool = true
    let mut i: i32 = 0
    while i < sl_len(args) {
        if s_eq(sl_get(args, i), "--no-asm_args") {
            print_asm = false
        } elif s_eq(sl_get(args, i), "--no-mlir") {
            print_mlir = false
        }
        i = i + 1
    }
    info("Running matmul optimizations...")
    check(run_program(sl_of1(program)))
    info("Generating MLIR...")
    let mc: ptr<ProcCmd> = flow_emit_mlir_cmd(sl_of2(mlir_program, mlir_file))
    cmd_quiet(mc)
    if run(mc) != 0 {
        warning("MLIR generation failed")
    }
    info("Generating assembly...")
    sink_push(SINK_NULL, SINK_NULL)
    let ec: i32 = flowc_emit_to_c(program, c_file)
    let _s: string = sink_pop()
    if ec != 0 {
        error("C generation failed")
        cli_exit(1)
    }
    let asm_args: ptr<ProcStrs> = sl_of3("clang", "-O2", "-S")
    sl_push(asm_args, c_file)
    sl_push2(asm_args, "-o", s_file)
    let ac: ptr<ProcCmd> = cmd(asm_args)
    cmd_quiet_err(ac)
    if run(ac) != 0 {
        error("Assembly generation failed")
        cli_exit(1)
    }
    if print_asm {
        outln("----------------------------------------")
        outln("Assembly: " + s_file)
        outln("----------------------------------------")
        out(head_lines(s_file, 200))
        outln("----------------------------------------")
    }
    if print_mlir and is_file(mlir_file) {
        outln("MLIR: " + mlir_file)
        outln("----------------------------------------")
        out(head_lines(mlir_file, 120))
        outln("----------------------------------------")
    }
    return 0
}

export function run_all_tests() -> i32 {
    info("Running all tests...")
    outln("")
    info("Phase 1: FLOW language tests (Tier 2: transpile + clang)...")
    check(run_tests(sl_of1("--tier2")))
    outln("")
    info("Phase 2: FLOW runtime tests (compile + execute)...")
    check(run_runtime_tests(sl_new()))
    outln("")
    info("Phase 3: Python unit tests...")
    # run_python_tests was removed with the Python compiler; the driver
    # stopped here with bash's "command not found" (status 127).
    errln("flow: run_python_tests: command not found")
    cli_exit(127)
    return 127
}
