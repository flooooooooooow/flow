# @module tools.flow_cli
# @means  The `flow` command line. `./flow` is a short POSIX sh stub that
#         builds this program from the checked-in bootstrap C on first use
#         and execs it; every subcommand, flag and environment variable of
#         the bash driver it replaced (flow-driver) is handled here.
#
#   flow <command> [args...]      `flow help` lists the commands
#
# The stub passes the repository (or install) root in FLOW_CLI_ROOT.
# Commands that start a Flow tool (lsp, check, repl, dap, fir-g, gpu,
# analyze, pywheel, the package manager) build it with the Stage-A flowc on
# first use, as the driver did. External programs (cc, clang, mlir-opt,
# emcc, git, find) run through std.process with an argument vector; no
# shell is involved.
#
# Behaviour is pinned by tests/cli/run.flow, whose goldens were recorded from
# the bash driver.

import "tools/flow_cli/sys.flow"
import "tools/flow_cli/toolchain.flow"
import "tools/flow_cli/build.flow"
import "tools/flow_cli/tests.flow"
import "tools/flow_cli/commands.flow"
import "tools/flow_cli/help.flow"
import "tools/flow_cli/tool.flow"
import std.process { ProcCmd, ProcStrs, proc_args, proc_argv }

# The root: $FLOW_CLI_ROOT from the stub, else found by walking up from this
# binary to a directory holding compiler/bootstrap/flowc_stage_a.c.
function find_root() -> string {
    let from_env: string = env("FLOW_CLI_ROOT")
    if s_len(from_env) > 0 {
        return from_env
    }
    let mut dir: string = abs_dir_physical(path_dirname(proc_argv(0)))
    while s_len(dir) > 1 {
        if is_file(dir + "/compiler/bootstrap/flowc_stage_a.c") {
            return dir
        }
        dir = path_dirname(dir)
    }
    return cwd_physical()
}

function is(c: string, name: string) -> bool {
    return s_eq(c, name)
}

# `flow test`: project tests (tools/project_test) inside a project, the
# compiler's tier sweep at the root of the Flow repository or with
# --compiler. `--project` forces the project runner.
function cmd_test(args: ptr<ProcStrs>) -> i32 {
    let first: string = sl_get(args, 0)
    if s_eq(first, "--compiler") {
        return run_tests(sl_tail(args, 1))
    }
    let mut rest: ptr<ProcStrs> = args
    let mut project: bool = true
    if s_eq(first, "--project") {
        rest = sl_tail(args, 1)
    } elif is_file(root() + "/flow.toml") and s_eq(cwd_physical(), root()) {
        project = false
    }
    if not project {
        return run_tests(rest)
    }
    env_set("FLOW_TEST_DRIVER", root() + "/flow")
    env_set("FLOW_TEST_BUILD_DIR", root() + "/build")
    return cmd_project_test(rest)
}

# `flow run`: the driver's own runner, or the one-process runner
# (tools/run, #400) for --json, --keep, --extra-cflags, --predict and
# FLOW_RUN_DIRECT=1 (FLOW_RUN_PYTHON=1 is the old name).
function cmd_run(args: ptr<ProcStrs>) -> i32 {
    check_deps()
    let mut direct: string = env("FLOW_RUN_DIRECT")
    if s_len(direct) == 0 {
        direct = env_or("FLOW_RUN_PYTHON", "0")
    }
    let mut i: i32 = 0
    while i < sl_len(args) {
        let a: string = sl_get(args, i)
        if s_eq(a, "--json") or s_eq(a, "--keep") or s_starts(a, "--keep=") or s_eq(a, "--extra-cflags") or s_starts(a, "--extra-cflags=") or s_eq(a, "--predict") {
            direct = "1"
        }
        i = i + 1
    }
    if s_eq(direct, "1") {
        let rc: i32 = flow_sync_program(sl_get(args, 0))
        if rc != 0 {
            return rc
        }
        let bin: string = flow_native_tool("run")
        if s_len(bin) == 0 {
            return 1
        }
        env_set("FLOW_ROOT", root())
        let argv: ptr<ProcStrs> = sl_of1(bin)
        sl_extend(argv, args)
        return exec_argv(argv)
    }
    return run_program(args)
}

function cmd_show_flags(args: ptr<ProcStrs>) -> i32 {
    let n: i32 = sl_len(args)
    let mut i: i32 = 0
    while i < n {
        let a: string = sl_get(args, i)
        if s_starts(a, "--sanitize=") {
            env_set("FLOW_SANITIZE", s_from(a, 11))
        } elif s_eq(a, "--sanitize") {
            env_set("FLOW_SANITIZE", sl_get(args, i + 1))
            i = i + 1
        } elif s_starts(a, "--profile=") {
            env_set("FLOW_PROFILE", s_from(a, 10))
        } elif s_eq(a, "--profile") {
            env_set("FLOW_PROFILE", sl_get(args, i + 1))
            i = i + 1
        }
        i = i + 1
    }
    show_clang_flags()
    return 0
}

function cmd_version() -> i32 {
    outln(FLOW_VERSION_LINE)
    outln("host: " + flow_host_mode_sub())
    return 0
}

function cmd_demo(args: ptr<ProcStrs>) -> i32 {
    let name: string = sl_get(args, 0)
    if s_len(name) == 0 {
        error("Usage: flow demo <name> [variant]")
        return 1
    }
    let mut variant: string = sl_get(args, 1)
    if is(name, "vulkan") {
        if s_len(variant) == 0 {
            variant = "basic"
        }
        if is(variant, "basic") {
            return run_vulkan_demo()
        } elif is(variant, "advanced") {
            return run_vulkan_demo_advanced()
        }
        error("Unknown Vulkan demo variant: " + sl_get(args, 1) + " (use basic or advanced)")
        return 1
    }
    if is(name, "vulkan-flow") {
        if s_len(variant) == 0 {
            variant = "basic"
        }
        if is(variant, "basic") {
            return flow_demo_run_native("vulkan_flow_basic")
        } elif is(variant, "advanced") {
            return flow_demo_run_native("vulkan_flow_advanced")
        }
        let native: string = vulkan_flow_demo(variant)
        if s_len(native) > 0 {
            return flow_demo_run_native(native)
        }
        error("Unknown Vulkan Flow demo variant: " + sl_get(args, 1) + " (use basic, advanced, 2048, tetris, snake, pong, breakout, layout, or layout-dsl)")
        return 1
    }
    if is(name, "ui-layout") {
        return flow_demo_run_native("ui_layout_flow")
    }
    if is(name, "ui-layout-window") {
        return run_ui_layout_window()
    }
    error("Unknown demo: " + name)
    return 1
}

# The demos/ directory of a Vulkan Flow demo variant, or "".
function vulkan_flow_demo(variant: string) -> string {
    if is(variant, "2048") {
        return "vulkan_2048_flow"
    } elif is(variant, "tetris") {
        return "vulkan_tetris_flow"
    } elif is(variant, "snake") {
        return "vulkan_snake_flow"
    } elif is(variant, "pong") {
        return "vulkan_pong_flow"
    } elif is(variant, "breakout") {
        return "vulkan_breakout_flow"
    } elif is(variant, "layout") {
        return "vulkan_layout_flow"
    } elif is(variant, "layout-dsl") {
        return "vulkan_layout_dsl_flow"
    }
    return ""
}

function cmd_mlir_run(args: ptr<ProcStrs>) -> i32 {
    let program: string = sl_get(args, 0)
    if s_len(program) == 0 {
        error("Usage: flow mlir-run <program.flow>")
        return 1
    }
    require_flow_file(program)
    check_mlir_deps()
    check(generate_mlir(sl_of1(program)))
    let name: string = path_stem(program, ".flow")
    let b: string = build_root() + "/" + name
    if mlir_lower_and_link(b + ".mlir", b + "_mlir.o", b + "_mlir", "2") != 0 {
        return 1
    }
    info("Running...")
    outln("----------------------------------------")
    check(run_program_binary(sl_of1(b + "_mlir")))
    outln("----------------------------------------")
    success("Program finished with exit code: 0")
    return 0
}

# One optional entry file, taken literally (after --).
function pkg_with_entry(sub: string, args: ptr<ProcStrs>) -> i32 {
    if sl_len(args) > 0 and s_len(sl_get(args, 0)) > 0 {
        return flow_pkg_native(sl_of3(sub, "--", sl_get(args, 0)))
    }
    return flow_pkg_native(sl_of1(sub))
}

function prepend(first: string, rest: ptr<ProcStrs>) -> ptr<ProcStrs> {
    let l: ptr<ProcStrs> = sl_of1(first)
    sl_extend(l, rest)
    return l
}

# The command table. scripts/tools/doc_coverage reads the names from the
# `is(c, "...")` tests in this function.
function dispatch(c: string, args: ptr<ProcStrs>) -> i32 {
    if is(c, "version") or is(c, "--version") or is(c, "-V") {
        return cmd_version()
    } elif is(c, "check") {
        return cmd_check(args)
    } elif is(c, "run") {
        return cmd_run(args)
    } elif is(c, "sync") {
        return flow_pkg_native(prepend("sync", args))
    } elif is(c, "patch") {
        check_deps()
        return run_patch_smoke(args)
    } elif is(c, "audio") {
        check_deps()
        return run_audio_program(sl_get(args, 0), sl_get(args, 1))
    } elif is(c, "compile") {
        check_deps()
        return compile_program_cli(args)
    } elif is(c, "show-flags") {
        return cmd_show_flags(args)
    } elif is(c, "analyze") {
        return cmd_analyze(args)
    } elif is(c, "compile-audio") {
        check_deps()
        return compile_audio_program(sl_get(args, 0), sl_get(args, 1))
    } elif is(c, "lsp") {
        return cmd_lsp(args)
    } elif is(c, "__project-test") {
        return cmd_project_test(args)
    } elif is(c, "dap") {
        return cmd_dap(args)
    } elif is(c, "debug") {
        return debug_program(args)
    } elif is(c, "window") {
        return run_window_program(sl_get(args, 0))
    } elif is(c, "gfx") {
        return run_gfx_program(sl_get(args, 0))
    } elif is(c, "record") {
        return record_gfx_program(args)
    } elif is(c, "vulkan-demo") or is(c, "vulkan-demo-basic") {
        return run_vulkan_demo()
    } elif is(c, "vulkan-demo-advanced") {
        return run_vulkan_demo_advanced()
    } elif is(c, "vulkan-2048") or is(c, "vulkan-tetris") or is(c, "vulkan-snake") or is(c, "vulkan-pong") or is(c, "vulkan-breakout") or is(c, "vulkan-layout") or is(c, "vulkan-layout-dsl") {
        return flow_demo_run_native(vulkan_flow_demo(s_from(c, 7)))
    } elif is(c, "ui-layout") {
        return flow_demo_run_native("ui_layout_flow")
    } elif is(c, "ui-layout-window") {
        return run_ui_layout_window()
    } elif is(c, "demo") {
        return cmd_demo(args)
    } elif is(c, "mlir") {
        if s_len(sl_get(args, 0)) == 0 {
            error("Usage: flow mlir <program.flow>")
            return 1
        }
        require_flow_file(sl_get(args, 0))
        return generate_mlir(args)
    } elif is(c, "mlir-run") {
        return cmd_mlir_run(args)
    } elif is(c, "fir-g") or is(c, "firg") {
        return cmd_fir(args)
    } elif is(c, "shader") {
        if s_len(sl_get(args, 0)) == 0 {
            error("Usage: flow shader <program.flow> [--grid|--cycle] [--name SHADER] [--frames N] [--size WxH] [--emit-only]")
            return 1
        }
        require_flow_file(sl_get(args, 0))
        check_deps()
        return run_fill_shader(args)
    } elif is(c, "gpu") {
        return cmd_gpu(args)
    } elif is(c, "jit") {
        let program: string = sl_get(args, 0)
        if s_len(program) == 0 {
            error("Usage: flow jit <program.flow>")
            return 1
        }
        require_flow_file(program)
        check_deps()
        check_mlir_deps()
        info("JIT compiling " + program + "...")
        return run_flow_jit(program)
    } elif is(c, "ml") {
        return cmd_ml(args)
    } elif is(c, "transpile") {
        error("flow transpile (python -m flow.transpiler) is retired.")
        errln("  MLIR:     ./flow mlir <file.flow> [--optimize] [--llvm] [--mlir-gpu] [--emit-spirv] [-o OUT]")
        errln("  C:        ./flow compile <file.flow>, or ./flow tool compiler/scripts/flowc_emit.flow <in.flow> <out.c>")
        return 2
    } elif is(c, "explain") {
        return cmd_explain(args)
    } elif is(c, "fmt") {
        return cmd_fmt(args)
    } elif is(c, "test") {
        return cmd_test(args)
    } elif is(c, "test-strict") {
        return run_tests(sl_of1("--strict"))
    } elif is(c, "test-runtime") {
        check_deps()
        return run_runtime_tests(args)
    } elif is(c, "test-lang") {
        check_deps()
        return run_lang_tests(args)
    } elif is(c, "test-mlir") {
        check_deps()
        return run_mlir_tests()
    } elif is(c, "test-scripts") {
        return run_script_tests(args)
    } elif is(c, "test-interop") {
        return run_interop_tests()
    } elif is(c, "test-gpu") {
        return run_gpu_tests(args)
    } elif is(c, "test-matmul") {
        return run_matmul_tests(sl_new())
    } elif is(c, "test-all") {
        return run_all_tests()
    } elif is(c, "python") {
        return cmd_python(args)
    } elif is(c, "bpf") {
        return exec_argv(prepend(root() + "/scripts/bpf_target.sh", args))
    } elif is(c, "wasm32") {
        return exec_argv(prepend(root() + "/scripts/wasm32_target.sh", args))
    } elif is(c, "wasm") {
        return cmd_wasm(args)
    } elif is(c, "playground") {
        return cmd_playground(sl_get(args, 0))
    } elif is(c, "setup") or is(c, "install-tools") {
        return install_deps()
    } elif is(c, "install") {
        return cmd_install(sl_get(args, 0))
    } elif is(c, "pkg") {
        if s_len(sl_get(args, 0)) == 0 {
            error("Usage: flow pkg <install|add|search|info|publish|init|…>")
            return 1
        }
        return flow_pkg_native(args)
    } elif is(c, "search") {
        return flow_pkg_native(prepend("search", args))
    } elif is(c, "info") {
        if s_len(sl_get(args, 0)) == 0 {
            error("Usage: flow info <package>")
            return 1
        }
        return flow_pkg_native(prepend("info", args))
    } elif is(c, "publish") {
        return flow_pkg_native(prepend("publish", args))
    } elif is(c, "repl") {
        return cmd_repl()
    } elif is(c, "init") {
        return flow_pkg_native(prepend("init", args))
    } elif is(c, "add") {
        if sl_len(args) == 0 {
            error("Usage: flow add <package[@version]> | <git-url> | --git URL [--name NAME] [--subdir DIR] | --path DIR --name NAME")
            return 1
        }
        return flow_pkg_native(prepend("add", args))
    } elif is(c, "build") {
        return flow_pkg_native(sl_of1("build"))
    } elif is(c, "build-native") {
        return pkg_with_entry("build-native", args)
    } elif is(c, "run-native") {
        return pkg_with_entry("run-native", args)
    } elif is(c, "clean") {
        return flow_pkg_native(sl_of1("clean"))
    } elif is(c, "examples") {
        if s_eq(sl_get(args, 0), "run") {
            return run_project_example(sl_get(args, 1))
        }
        return list_examples()
    } elif is(c, "know") {
        return flow_know(args)
    } elif is(c, "doc") {
        return cmd_doc(args)
    } elif is(c, "tool") {
        return cmd_tool(args)
    } elif is(c, "help") {
        show_help()
        return 0
    }
    show_help()
    return 0
}

function main() -> i32 {
    toolchain_init(find_root())
    let argv: ptr<ProcStrs> = proc_args()
    let mut c: string = sl_get(argv, 0)
    if s_len(c) == 0 {
        c = "help"
    }
    let rc: i32 = dispatch(c, sl_tail(argv, 1))
    cli_exit(rc)
    return rc
}
