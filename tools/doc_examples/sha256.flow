# @module tools.doc_examples.sha256
# @means  SHA-256 of a string, as lowercase hex. The doc example ledger keys
#         each block by a prefix of the hash of its code, as hashlib did.

extern {
    function malloc(size: i64) -> ptr<void>
    function strlen(s: string) -> i64
}

const M32: i64 = 4294967295

function rotr(x: i64, n: i64) -> i64 {
    return ((x >> n) | (x << (32 - n))) & M32
}

function sha_table() -> ptr<i64> {
    let k: ptr<i64> = malloc(64 * 8) as ptr<i64>
    k[0] = 1116352408
    k[1] = 1899447441
    k[2] = 3049323471
    k[3] = 3921009573
    k[4] = 961987163
    k[5] = 1508970993
    k[6] = 2453635748
    k[7] = 2870763221
    k[8] = 3624381080
    k[9] = 310598401
    k[10] = 607225278
    k[11] = 1426881987
    k[12] = 1925078388
    k[13] = 2162078206
    k[14] = 2614888103
    k[15] = 3248222580
    k[16] = 3835390401
    k[17] = 4022224774
    k[18] = 264347078
    k[19] = 604807628
    k[20] = 770255983
    k[21] = 1249150122
    k[22] = 1555081692
    k[23] = 1996064986
    k[24] = 2554220882
    k[25] = 2821834349
    k[26] = 2952996808
    k[27] = 3210313671
    k[28] = 3336571891
    k[29] = 3584528711
    k[30] = 113926993
    k[31] = 338241895
    k[32] = 666307205
    k[33] = 773529912
    k[34] = 1294757372
    k[35] = 1396182291
    k[36] = 1695183700
    k[37] = 1986661051
    k[38] = 2177026350
    k[39] = 2456956037
    k[40] = 2730485921
    k[41] = 2820302411
    k[42] = 3259730800
    k[43] = 3345764771
    k[44] = 3516065817
    k[45] = 3600352804
    k[46] = 4094571909
    k[47] = 275423344
    k[48] = 430227734
    k[49] = 506948616
    k[50] = 659060556
    k[51] = 883997877
    k[52] = 958139571
    k[53] = 1322822218
    k[54] = 1537002063
    k[55] = 1747873779
    k[56] = 1955562222
    k[57] = 2024104815
    k[58] = 2227730452
    k[59] = 2361852424
    k[60] = 2428436474
    k[61] = 2756734187
    k[62] = 3204031479
    k[63] = 3329325298
    return k
}

export function sha256_hex(s: string) -> string {
    return sha256_hex_bytes(s as ptr<u8>, strlen(s))
}

# SHA-256 of `n` bytes at `src`, which may hold NUL bytes.
export function sha256_hex_bytes(src: ptr<u8>, n: i64) -> string {
    let kt: ptr<i64> = sha_table()
    # Padded message: data, 0x80, zeros, 64-bit big-endian bit length.
    let total: i64 = ((n + 9 + 63) / 64) * 64
    let msg: ptr<u8> = malloc(total) as ptr<u8>
    let mut i: i64 = 0
    while i < total {
        msg[i] = 0
        i = i + 1
    }
    i = 0
    while i < n {
        msg[i] = src[i]
        i = i + 1
    }
    msg[n] = 128
    let bits: i64 = n * 8
    let mut b: i64 = 0
    while b < 8 {
        msg[total - 1 - b] = ((bits >> (b * 8)) & 255) as u8
        b = b + 1
    }
    let h: ptr<i64> = malloc(8 * 8) as ptr<i64>
    h[0] = 1779033703
    h[1] = 3144134277
    h[2] = 1013904242
    h[3] = 2773480762
    h[4] = 1359893119
    h[5] = 2600822924
    h[6] = 528734635
    h[7] = 1541459225
    let w: ptr<i64> = malloc(64 * 8) as ptr<i64>
    let mut off: i64 = 0
    while off < total {
        let mut t: i32 = 0
        while t < 16 {
            let q: i64 = off + (t as i64) * 4
            w[t] = ((msg[q] as i64) << 24) | ((msg[q + 1] as i64) << 16) | ((msg[q + 2] as i64) << 8) | (msg[q + 3] as i64)
            t = t + 1
        }
        while t < 64 {
            let s0: i64 = rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ (w[t - 15] >> 3)
            let s1: i64 = rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ (w[t - 2] >> 10)
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & M32
            t = t + 1
        }
        let mut a: i64 = h[0]
        let mut bb: i64 = h[1]
        let mut c: i64 = h[2]
        let mut d: i64 = h[3]
        let mut e: i64 = h[4]
        let mut f: i64 = h[5]
        let mut g: i64 = h[6]
        let mut hh: i64 = h[7]
        t = 0
        while t < 64 {
            let S1: i64 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
            let ch: i64 = (e & f) ^ ((e ^ M32) & g)
            let temp1: i64 = (hh + S1 + ch + kt[t] + w[t]) & M32
            let S0: i64 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
            let maj: i64 = (a & bb) ^ (a & c) ^ (bb & c)
            let temp2: i64 = (S0 + maj) & M32
            hh = g
            g = f
            f = e
            e = (d + temp1) & M32
            d = c
            c = bb
            bb = a
            a = (temp1 + temp2) & M32
            t = t + 1
        }
        h[0] = (h[0] + a) & M32
        h[1] = (h[1] + bb) & M32
        h[2] = (h[2] + c) & M32
        h[3] = (h[3] + d) & M32
        h[4] = (h[4] + e) & M32
        h[5] = (h[5] + f) & M32
        h[6] = (h[6] + g) & M32
        h[7] = (h[7] + hh) & M32
        off = off + 64
    }
    let hex: ptr<u8> = "0123456789abcdef" as ptr<u8>
    let out: ptr<u8> = malloc(65) as ptr<u8>
    let mut j: i32 = 0
    while j < 8 {
        let mut k: i32 = 0
        while k < 8 {
            let nib: i64 = (h[j] >> ((7 - k) * 4) as i64) & 15
            out[j * 8 + k] = hex[nib as i32]
            k = k + 1
        }
        j = j + 1
    }
    out[64] = 0
    return out as string
}
