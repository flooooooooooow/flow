# @module tools.doc_examples.verify
# @means  Verify one documentation block: page context, from= drift,
#         preamble, the harness ladder, the front end and flowc.
#
# Every ```flow block goes through the front end a real build uses: the
# fill-shader, Field DSL, dynamics DSL and flow block expansions, the flowc
# parser, and flowc itself for the type check and the C. A block passes when
# it survives that as written, or inside a generated harness, or is tagged
# `expect-error` and is genuinely rejected, or carries `ignore="reason"`.
#
# Three checks are load-bearing, and each exists because leaving it out
# produced a checker that reported success on documentation that does not
# work: blocks go all the way to clang (in main.flow); a block that declares
# nothing does not count (vacuous); and a harness rung that turns prose into
# bare expression statements does not count (degenerate).
#
# The harness exists because most documented examples are fragments by
# design. The checker tries a short ladder of wrappers and records which rung
# each block needed:
#
#   standalone  the block is a complete compilation unit
#   stmt-wrap   the block is statements: wrap it in `function main`
#   split-wrap  leading declarations, then statements for a `main`

import "scripts/tools/lib/text.flow"
import "scripts/tools/lib/unicode.flow"
import "scripts/tools/lib/proc.flow"
import "stdlib/regex.flow"
import "tools/doc_examples/blocks.flow"
import "compiler/src/ast.flow"
import "compiler/src/token.flow"
import "compiler/src/lexer.flow"
import "compiler/src/parser.flow"
import "compiler/src/field_dsl.flow"
import "compiler/src/dynamics_dsl.flow"
import "compiler/src/flow_blocks.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function calloc(n: i64, size: i64) -> ptr<void>
    function memcpy(dst: ptr<void>, src: ptr<void>, n: i64) -> ptr<void>
    function strlen(s: string) -> i64
    function getenv(name: string) -> string
}

# Where things live. repo is the compiler checkout (flowc, runtime headers);
# docs is the tree whose markdown is checked (the same directory unless a
# test points --root elsewhere); work is a scratch directory.
export struct Env {
    repo: string,
    docs: string,
    work: string,
    flowc: string,
    serial: i32,
    # FLOW_DOC_DUMP: a directory that receives every harness rung of every
    # block, as d<n>.flow plus d<n>.key holding `<block key>@<mode>`
    # (compiler/scripts/parity_typecheck.sh reads them). Empty when unset.
    dump: string,
    # The `dump` command: write the rungs and compile nothing.
    dump_only: bool
}

export struct Res {
    blk: ptr<Blk>,
    status: string,
    mode: string,
    detail: string,
    stage: string,
    csource: string
}

export struct ResList {
    items: ptr<ptr<Res>>,
    len: i32,
    cap: i32
}

export function rl_new() -> ptr<ResList> {
    let l: ptr<ResList> = calloc(1, 24) as ptr<ResList>
    l.items = malloc(8 * 64) as ptr<ptr<Res>>
    l.len = 0
    l.cap = 64
    return l
}

export function rl_push(l: ptr<ResList>, r: ptr<Res>) {
    if l.len == l.cap {
        l.cap = l.cap * 2
        let bigger: ptr<ptr<Res>> = malloc((l.cap as i64) * 8) as ptr<ptr<Res>>
        memcpy(bigger as ptr<void>, l.items as ptr<void>, (l.len as i64) * 8)
        l.items = bigger
    }
    let items: ptr<ptr<Res>> = l.items
    items[l.len] = r
    l.len = l.len + 1
}

export function rl_get(l: ptr<ResList>, i: i32) -> ptr<Res> {
    let items: ptr<ptr<Res>> = l.items
    return items[i]
}

function res_new(b: ptr<Blk>, status: string, mode: string, detail: string, stage: string) -> ptr<Res> {
    let r: ptr<Res> = calloc(1, 64) as ptr<Res>
    r.blk = b
    r.status = status
    r.mode = mode
    r.detail = detail
    r.stage = stage
    r.csource = null
    return r
}

# ---------------------------------------------------------------------------
# Harness
# ---------------------------------------------------------------------------

function is_blank(s: string) -> bool {
    return ft_len(uc_strip(s)) == 0
}

function indent(code: string) -> string {
    let lines: ptr<StrList> = py_splitlines(code)
    let out: ptr<StrList> = ft_list_new()
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let l: string = ft_list_get(lines, i)
        if is_blank(l) {
            ft_list_push(out, l)
        } else {
            ft_list_push(out, "    " + l)
        }
        i = i + 1
    }
    return join_lines(out, 0, ft_list_len(out))
}

# Keywords that open a top-level declaration. Anything at brace depth zero
# that does not start with one of these is a statement.
function starts_decl(s: string) -> bool {
    return ft_starts(s, "function") or ft_starts(s, "export") or ft_starts(s, "struct") or ft_starts(s, "enum") or ft_starts(s, "trait") or ft_starts(s, "impl") or ft_starts(s, "effect") or ft_starts(s, "capability") or ft_starts(s, "const") or ft_starts(s, "type") or ft_starts(s, "distinct") or ft_starts(s, "unit") or ft_starts(s, "import") or ft_starts(s, "extern") or ft_starts(s, "module") or ft_starts(s, "flow") or ft_starts(s, "test") or ft_starts(s, "theorem") or ft_starts(s, "let mut") or ft_starts(s, "@")
}

function count_byte(s: string, c: i32) -> i32 {
    let p: ptr<u8> = s as ptr<u8>
    let mut n: i32 = 0
    let mut i: i32 = 0
    while p[i] != 0 {
        if (p[i] as i32) == c {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

# Partition a block into leading declarations and trailing statements.
# Documentation often declares a few things and then shows them used:
# `capability` is not legal inside a function and `handle` is not legal at
# top level, so neither rung fits that shape on its own.
function split_declarations(code: string, decls: ptr<StrList>, stmts: ptr<StrList>) {
    let lines: ptr<StrList> = py_splitlines(code)
    let n: i32 = ft_list_len(lines)
    let mut depth: i32 = 0
    let mut boundary: i32 = n
    let mut i: i32 = 0
    while i < n {
        let line: string = ft_list_get(lines, i)
        let stripped: string = uc_strip(line)
        if depth == 0 and ft_len(stripped) > 0 and ft_starts(stripped, "#") == false {
            if starts_decl(stripped) == false {
                boundary = i
                break
            }
        }
        depth = depth + count_byte(line, 123) - count_byte(line, 125)
        i = i + 1
    }
    ft_list_push(decls, join_lines(lines, 0, boundary))
    ft_list_push(stmts, join_lines(lines, boundary, n))
}

export function split_decls_text(code: string) -> string {
    let d: ptr<StrList> = ft_list_new()
    let s: ptr<StrList> = ft_list_new()
    split_declarations(code, d, s)
    return ft_list_get(d, 0)
}

export function split_stmts_text(code: string) -> string {
    let d: ptr<StrList> = ft_list_new()
    let s: ptr<StrList> = ft_list_new()
    split_declarations(code, d, s)
    return ft_list_get(s, 0)
}

# The source for one rung, or null when the rung has nothing to offer.
export function harness(code: string, mode: string) -> string {
    if ft_eq(mode, "standalone") {
        return code
    }
    if ft_eq(mode, "stmt-wrap") {
        return "function main() -> i32 {\n" + indent(code) + "\n    return 0\n}\n"
    }
    let decls: string = split_decls_text(code)
    let stmts: string = split_stmts_text(code)
    if is_blank(stmts) {
        return null as string
    }
    let body: string = "function main() -> i32 {\n" + indent(stmts) + "\n    return 0\n}\n"
    if is_blank(decls) {
        return body
    }
    return decls + "\n\n" + body
}

# ---------------------------------------------------------------------------
# Front end
# ---------------------------------------------------------------------------

struct Front {
    ok: bool,
    stage: string,
    detail: string,
    csource: string
}

function front_fail(stage: string, detail: string) -> ptr<Front> {
    let f: ptr<Front> = calloc(1, 32) as ptr<Front>
    f.ok = false
    f.stage = stage
    f.detail = detail
    f.csource = null
    return f
}

struct Tree {
    src: ptr<u8>,
    arena: AstArena,
    root: i32
}

function node(t: ptr<Tree>, id: i32) -> AstNode {
    return t.arena.nodes[id]
}

function tok_kind_name(kind: i32) -> string {
    if kind == TOK_EOF { return "end of file" }
    if kind == TOK_IDENT { return "identifier" }
    if kind == TOK_KEYWORD { return "keyword" }
    if kind == TOK_INT { return "integer" }
    if kind == TOK_FLOAT { return "float" }
    if kind == TOK_STRING { return "string" }
    return "token"
}

# Parse after the expansions flowc runs before parse. Returns null with the
# message in `msg[0]` on a parse error.
function parse_source(source: string, msg: ptr<string>) -> ptr<Tree> {
    let n: i32 = ft_len(source)
    let cap: i32 = n * 2 + 65536
    let buf: ptr<u8> = calloc((cap + 1) as i64, 1) as ptr<u8>
    memcpy(buf as ptr<void>, source as ptr<void>, n as i64)
    let mut m: i32 = flowc_field_expand_in_place(buf, n, cap)
    if m >= 0 {
        m = flowc_dynamics_expand_in_place(buf, m, cap)
    }
    if m >= 0 {
        m = flowc_flow_blocks_expand_in_place(buf, m, cap)
    }
    if m < 0 {
        msg[0] = "SyntaxError: the Field DSL, dynamics DSL or flow block expansion failed"
        return null
    }
    buf[m] = 0
    let mut p: Parser = flowc_parser_new(buf, m, m + 4096)
    let root: i32 = flowc_parse_program(&p)
    if root < 0 or p.err != 0 {
        let mut tk: Token = p.cur
        if p.err != 0 {
            tk = p.err_tok
        }
        let rule0: string = module_static_rule(buf, m, tk.start)
        if rule0 as ptr<u8> != null {
            msg[0] = "SyntaxError: " + rule0
            flowc_parser_free(p)
            return null
        }
        # flowc's own wording (flowc_parser_print_error): the token text is
        # cut at 32 bytes and at the first newline.
        let mut n: i32 = tk.end - tk.start
        if n > 32 {
            n = 32
        }
        let mut k: i32 = 0
        while k < n {
            if (buf[tk.start + k] as i32) == 10 {
                n = k
            }
            k = k + 1
        }
        msg[0] = "block.flow:" + ft_itoa(tk.line) + ":" + ft_itoa(tk.col) + ": parse error: unexpected " + tok_kind_name(tk.kind) + " '" + ft_slice(buf as string, tk.start, tk.start + n) + "' (byte " + ft_itoa(tk.start) + ")"
        flowc_parser_free(p)
        return null
    }
    let rule: string = module_static_rule(buf, m, m)
    if rule as ptr<u8> != null {
        msg[0] = "SyntaxError: " + rule
        flowc_parser_free(p)
        return null
    }
    let t: ptr<Tree> = calloc(1, 64) as ptr<Tree>
    t.src = buf
    t.arena = p.arena
    t.root = root
    return t
}

function is_kw(src: ptr<u8>, tk: Token, word: string) -> bool {
    return tk.kind == TOK_KEYWORD and ft_eq(ft_slice(src as string, tk.start, tk.end), word)
}

# A top-level `let` is a module static: it must be `let mut` and carry its
# type (docs/LANGUAGE_SPEC.md). The flowc parser accepts both forms and then
# emits C that does not compile, so the rule is applied here, in token order
# up to where parsing stopped, as a parser that enforces it would.
function module_static_rule(src: ptr<u8>, n: i32, stop: i32) -> string {
    let mut lex: Lexer = flowc_lexer_new(src, n)
    let mut depth: i32 = 0
    let mut tk: Token = flowc_lexer_next(&lex)
    while tk.kind != TOK_EOF and tk.start < stop {
        if tk.kind == TOK_LBRACE {
            depth = depth + 1
        } elif tk.kind == TOK_RBRACE {
            depth = depth - 1
        } elif depth == 0 and is_kw(src, tk, "let") {
            let line: string = ft_itoa(tk.line)
            let t2: Token = flowc_lexer_next(&lex)
            if is_kw(src, t2, "mut") == false {
                return "Top-level 'let' at line " + line + " must be 'let mut' (module static); use 'const' for immutable module-level values"
            }
            let t3: Token = flowc_lexer_next(&lex)
            if t3.kind != TOK_IDENT {
                return null as string
            }
            let t4: Token = flowc_lexer_next(&lex)
            if t4.kind != TOK_COLON {
                return "Module static '" + ft_slice(src as string, t3.start, t3.end) + "' at line " + line + " requires an explicit type annotation"
            }
        }
        tk = flowc_lexer_next(&lex)
    }
    return null as string
}

function first_item(t: ptr<Tree>) -> i32 {
    return t.arena.nodes[t.root].a
}

# The declaration an item stands for: `export function f` is function f.
function unwrap_export(t: ptr<Tree>, id: i32) -> i32 {
    if t.arena.nodes[id].kind == AST_EXPORT and t.arena.nodes[id].ival == 0 and t.arena.nodes[id].a != AST_NONE {
        return t.arena.nodes[id].a
    }
    return id
}

function name_of(t: ptr<Tree>, id: i32) -> string {
    return ft_slice(t.src as string, t.arena.nodes[id].name_start, t.arena.nodes[id].name_end)
}

function chain_len(t: ptr<Tree>, first: i32) -> i32 {
    let mut n: i32 = 0
    let mut c: i32 = first
    while c != AST_NONE {
        n = n + 1
        c = t.arena.nodes[c].next
    }
    return n
}

# Statements of a declaration's body, when it has one.
function body_block(t: ptr<Tree>, id: i32) -> i32 {
    let k: i32 = t.arena.nodes[id].kind
    if k == AST_FN {
        return t.arena.nodes[id].c
    }
    if k == AST_THEOREM {
        return t.arena.nodes[id].b
    }
    return AST_NONE
}

# Expression forms that do nothing standing alone as a statement. After
# wrapping they mean the text was never statements: `state angle` reads as
# two bare variables. The names are the ones the ledger has always used.
function noop_name(k: i32) -> string {
    if k == AST_IDENT { return "Variable" }
    if k == AST_INT or k == AST_FLOAT or k == AST_STRING or k == AST_BOOL { return "Literal" }
    if k == AST_CAST { return "CastExpression" }
    if k == AST_BINOP { return "BinaryOperation" }
    if k == AST_FIELD_ACCESS { return "FieldAccess" }
    if k == AST_INDEX { return "ArrayAccess" }
    if k == AST_UNARY { return "UnaryOperation" }
    return null as string
}

# First no-op statement at any depth of the block, or null.
function find_noop(t: ptr<Tree>, block: i32) -> string {
    if block == AST_NONE or t.arena.nodes[block].kind != AST_BLOCK {
        return null as string
    }
    let mut st: i32 = t.arena.nodes[block].a
    while st != AST_NONE {
        let k: i32 = t.arena.nodes[st].kind
        if k == AST_EXPR_STMT and t.arena.nodes[st].a != AST_NONE {
            let name: string = noop_name(t.arena.nodes[t.arena.nodes[st].a].kind)
            if name as ptr<u8> != null {
                return name
            }
        }
        let mut inner: string = null as string
        if k == AST_IF {
            inner = find_noop(t, t.arena.nodes[st].b)
            if inner as ptr<u8> == null {
                inner = find_noop(t, t.arena.nodes[st].c)
            }
        } elif k == AST_WHILE {
            inner = find_noop(t, t.arena.nodes[st].b)
        } elif k == AST_FOR {
            inner = find_noop(t, t.arena.nodes[st].c)
        } elif k == AST_BLOCK {
            inner = find_noop(t, st)
        } elif k == AST_HANDLE {
            inner = find_noop(t, t.arena.nodes[st].a)
        }
        if inner as ptr<u8> != null {
            return inner
        }
        st = t.arena.nodes[st].next
    }
    return null as string
}

function degenerate(t: ptr<Tree>) -> string {
    let mut it: i32 = first_item(t)
    while it != AST_NONE {
        let d: i32 = unwrap_export(t, it)
        if t.arena.nodes[d].kind == AST_FN and ft_eq(name_of(t, d), "main") {
            let kind: string = find_noop(t, t.arena.nodes[d].c)
            if kind as ptr<u8> != null {
                return "no-op " + kind + " statement; the text is not statements"
            }
        }
        it = t.arena.nodes[it].next
    }
    return null as string
}

# A module resolver rule the documentation states: an import path may not be
# absolute, start at `~` or climb out with `..`.
function unsafe_import(t: ptr<Tree>) -> string {
    let mut it: i32 = first_item(t)
    while it != AST_NONE {
        if t.arena.nodes[it].kind == AST_IMPORT and t.arena.nodes[it].ival == 2 {
            let raw: string = name_of(t, it)
            let path: string = ft_slice(raw, 1, ft_len(raw) - 1)
            if ft_starts(path, "/") or ft_starts(path, "~") or ft_eq(path, "..") or ft_starts(path, "../") or ft_contains(path, "/../") or ft_ends(path, "/..") {
                return path
            }
        }
        it = t.arena.nodes[it].next
    }
    return null as string
}

function has_import(t: ptr<Tree>) -> bool {
    let mut it: i32 = first_item(t)
    while it != AST_NONE {
        if t.arena.nodes[it].kind == AST_IMPORT {
            return true
        }
        it = t.arena.nodes[it].next
    }
    return false
}

# Top-level declarations that count as substance. Under a wrapping rung the
# synthesized `main` must hold more than the `return 0` the harness added.
function substantive(t: ptr<Tree>, mode: string) -> i32 {
    let mut n: i32 = 0
    let mut it: i32 = first_item(t)
    while it != AST_NONE {
        if ft_eq(mode, "standalone") {
            n = n + 1
        } else {
            let d: i32 = unwrap_export(t, it)
            let body: i32 = body_block(t, d)
            if body != AST_NONE and chain_len(t, t.arena.nodes[body].a) > 1 {
                n = n + 1
            }
        }
        it = t.arena.nodes[it].next
    }
    # The parser leaves out a function whose @only / @guard mode is off in
    # this build (#1029); its attribute nodes stay behind, detached. The
    # Python checker counted such a function, so a standalone block that
    # holds only one still declares something.
    if n == 0 and ft_eq(mode, "standalone") {
        let mut i: i32 = 0
        while i < t.arena.len {
            if t.arena.nodes[i].kind == AST_ATTR and t.arena.nodes[i].b == AST_NONE {
                return 1
            }
            i = i + 1
        }
    }
    return n
}

# ---------------------------------------------------------------------------
# flowc
# ---------------------------------------------------------------------------

function next_dir(env: ptr<Env>) -> string {
    env.serial = env.serial + 1
    let d: string = env.work + "/u" + ft_itoa(env.serial)
    let _m: bool = pr_mkdir_p(d)
    return d
}

# Lines of `text` (splitlines), each with `strip` removed and stripped,
# skipping blank ones.
function nonblank_lines(text: string, strip: string) -> ptr<StrList> {
    let out: ptr<StrList> = ft_list_new()
    let lines: ptr<StrList> = py_splitlines(text)
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let l: string = ft_list_get(lines, i)
        if is_blank(l) == false {
            ft_list_push(out, uc_strip(ft_replace(l, strip, "")))
        }
        i = i + 1
    }
    return out
}

function read_or_empty(path: string) -> string {
    let s: string = ft_read_file(path)
    if s as ptr<u8> == null {
        return ""
    }
    return s
}

# Compile one translation unit with flowc (compiler/scripts/flowc_emit.flow)
# under the strict type check, as the Python checker ran it. Sets
# f.csource; a type error fails at `types` with its message, anything else
# at codegen.
function flowc_c(env: ptr<Env>, source: string) -> ptr<Front> {
    let dir: string = next_dir(env)
    let src: string = dir + "/block.flow"
    let out: string = dir + "/block.c"
    let _w: bool = ft_write_file(src, source)
    let cmd: string = "cd " + pr_quote(env.repo) + " && ulimit -t 60; FLOWC_BIN=" + pr_quote(env.flowc) + " " + pr_quote(env.repo + "/flow") + " tool " + pr_quote(env.repo + "/compiler/scripts/flowc_emit.flow") + " --strict " + pr_quote(src) + " " + pr_quote(out) + " >" + pr_quote(dir + "/stdout") + " 2>" + pr_quote(dir + "/stderr")
    let rc: i32 = pr_run(cmd)
    if rc == 137 or rc == 152 {
        return front_fail("codegen", "flowc did not finish within 60s")
    }
    if rc != 0 or ft_exists(out) == false {
        let text: string = read_or_empty(dir + "/stderr") + read_or_empty(dir + "/stdout")
        if ft_contains(text, "typecheck failed") {
            let msg: string = first_type_error(text)
            if ft_len(msg) > 0 {
                return front_fail("types", msg)
            }
        }
        let lines: ptr<StrList> = nonblank_lines(text, dir + "/")
        let mut at: i32 = 0
        let mut i: i32 = 0
        while i < ft_list_len(lines) {
            if ft_contains(uc_lower_str(ft_list_get(lines, i)), "error") {
                at = i
                break
            }
            i = i + 1
        }
        let mut detail: string = "flowc exited " + ft_itoa(rc)
        if ft_list_len(lines) > 0 {
            detail = ft_list_get(lines, at)
            if ft_ends(detail, ":") and at + 1 < ft_list_len(lines) {
                detail = detail + " " + ft_list_get(lines, at + 1)
            }
        }
        return front_fail("codegen", "flowc: " + py_prefix(detail, 300))
    }
    let f: ptr<Front> = front_fail("codegen", "")
    f.ok = true
    f.csource = read_or_empty(out)
    return f
}

# `shader fill` heads: a fill-shader module is a different language with its
# own validator and no host translation unit to check.
# The message of the first `<file>:<line>:<col>: error: <message>` line.
function first_type_error(text: string) -> string {
    let lines: ptr<StrList> = py_splitlines(text)
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let l: string = ft_list_get(lines, i)
        let at: i32 = ft_find(l, ": error: ", 0)
        if at >= 0 {
            return ft_from(l, at + 9)
        }
        i = i + 1
    }
    return ""
}

function has_fill_shader(source: string) -> bool {
    let r: ptr<Regex> = rx_compile("^[ \\t]*shader\\s+fill\\s+[A-Za-z_]\\w*\\s*\\{", 8)
    return rx_test(r, source)
}

function shader_check(env: ptr<Env>, source: string) -> ptr<Front> {
    let dir: string = next_dir(env)
    let src: string = dir + "/block.flow"
    let _w: bool = ft_write_file(src, source)
    let cmd: string = "env -u FLOWC_BUNDLE -u FLOWC_OUT -u FLOWC_SHADER_NAME FLOWC_SHADER=list FLOWC_IN=" + pr_quote(src) + " " + pr_quote(env.flowc) + " >" + pr_quote(dir + "/stdout") + " 2>" + pr_quote(dir + "/stderr")
    let rc: i32 = pr_run(cmd)
    let out: string = read_or_empty(dir + "/stdout")
    if rc != 0 {
        let at: i32 = ft_find(out, "flowc shader: ", 0)
        if at >= 0 {
            let mut msg: string = ft_from(out, at + 14)
            while ft_ends(msg, "\n") {
                msg = ft_slice(msg, 0, ft_len(msg) - 1)
            }
            return front_fail("parse", "SyntaxError: " + msg)
        }
        return front_fail("parse", "SyntaxError: flowc shader failed: " + uc_strip(out + read_or_empty(dir + "/stderr")))
    }
    if ft_list_len(py_splitlines(out)) == 0 {
        return front_fail("parse", "no `shader fill` block in a shader module")
    }
    let f: ptr<Front> = front_fail("shader", "")
    f.ok = true
    f.csource = ""
    return f
}

# Front end plus codegen for one harnessed source.
function compile_source(env: ptr<Env>, source: string, guard_noop: bool, mode: string) -> ptr<Front> {
    if has_fill_shader(source) {
        return shader_check(env, source)
    }
    let msg: ptr<string> = malloc(8) as ptr<string>
    msg[0] = ""
    let t: ptr<Tree> = parse_source(source, msg)
    if t == null {
        return front_fail("parse", msg[0])
    }
    if guard_noop {
        let problem: string = degenerate(t)
        if problem as ptr<u8> != null {
            return front_fail("degenerate", problem)
        }
    }
    if has_import(t) {
        let bad: string = unsafe_import(t)
        if bad as ptr<u8> != null {
            return front_fail("imports", "FileNotFoundError: Unsafe import path: " + bad)
        }
    }
    if substantive(t, mode) == 0 {
        return front_fail("vacuous", "declares nothing; the block is only comments")
    }
    return flowc_c(env, source)
}

# ---------------------------------------------------------------------------
# Block context
# ---------------------------------------------------------------------------

# Page context: the ids declared by earlier blocks on the same page.
export struct PageCtx {
    ids: ptr<StrList>,
    codes: ptr<StrList>
}

export function ctx_new() -> ptr<PageCtx> {
    let c: ptr<PageCtx> = calloc(1, 16) as ptr<PageCtx>
    c.ids = ft_list_new()
    c.codes = ft_list_new()
    return c
}

export function ctx_put(c: ptr<PageCtx>, id: string, code: string) {
    ft_list_push(c.ids, id)
    ft_list_push(c.codes, code)
}

function ctx_get(c: ptr<PageCtx>, id: string) -> string {
    let mut i: i32 = ft_list_len(c.ids) - 1
    while i >= 0 {
        if ft_eq(ft_list_get(c.ids, i), id) {
            return ft_list_get(c.codes, i)
        }
        i = i - 1
    }
    return null as string
}

function uses_list(b: ptr<Blk>) -> ptr<StrList> {
    let out: ptr<StrList> = ft_list_new()
    let raw: string = blk_opt(b, "uses")
    if raw as ptr<u8> == null {
        return out
    }
    let p: ptr<u8> = raw as ptr<u8>
    let mut start: i32 = 0
    let mut i: i32 = 0
    let n: i32 = ft_len(raw)
    while i <= n {
        if i == n or (p[i] as i32) == 44 {
            let part: string = ft_slice(raw, start, i)
            if is_blank(part) == false {
                ft_list_push(out, part)
            }
            start = i + 1
        }
        i = i + 1
    }
    return out
}

# Earlier-page code this block names, or an error in err[0].
function page_context(b: ptr<Blk>, ctx: ptr<PageCtx>, err: ptr<string>) -> string {
    let uses: ptr<StrList> = uses_list(b)
    if ft_list_len(uses) == 0 {
        return ""
    }
    if ctx == null {
        err[0] = "uses= needs page context; call verify() through run()"
        return ""
    }
    let mut out: string = ""
    let mut i: i32 = 0
    while i < ft_list_len(uses) {
        let name: string = uc_strip(ft_list_get(uses, i))
        let body: string = ctx_get(ctx, name)
        if body as ptr<u8> == null {
            err[0] = "uses=" + ft_repr(name) + " names no earlier block on this page; add id=" + name + " to the block it depends on"
            return ""
        }
        if i > 0 {
            out = out + "\n\n"
        }
        out = out + py_rstrip(body)
        i = i + 1
    }
    return out + "\n\n"
}

function from_mismatch(env: ptr<Env>, b: ptr<Blk>) -> string {
    let rel: string = blk_opt(b, "from")
    if rel as ptr<u8> == null {
        return null as string
    }
    let text: string = ft_read_file(env.docs + "/" + rel)
    if text as ptr<u8> == null {
        return "from=" + ft_repr(rel) + " does not exist"
    }
    let body: string = uc_strip(b.code)
    if ft_len(body) > 0 and ft_contains(text, body) == false {
        return "block no longer appears in " + rel + "; the page and the file have drifted, so update whichever is wrong"
    }
    return null as string
}

function preamble_text(env: ptr<Env>, b: ptr<Blk>, err: ptr<string>) -> string {
    let rel: string = blk_opt(b, "preamble")
    if rel as ptr<u8> == null {
        return ""
    }
    let text: string = ft_read_file(env.docs + "/" + rel)
    if text as ptr<u8> == null {
        err[0] = "preamble " + ft_repr(rel) + " does not exist"
        return ""
    }
    return py_rstrip(text) + "\n\n"
}

# Earlier-page code in front, with every import hoisted to the top.
function join_with_context(page: string, code: string) -> string {
    if ft_len(page) == 0 {
        return code
    }
    let imports: ptr<StrList> = ft_list_new()
    let body: ptr<StrList> = ft_list_new()
    let lines: ptr<StrList> = py_splitlines(page + code)
    let mut i: i32 = 0
    while i < ft_list_len(lines) {
        let l: string = ft_list_get(lines, i)
        if ft_starts(l, "import ") {
            if ft_list_has(imports, l) == false {
                ft_list_push(imports, l)
            }
        } else {
            ft_list_push(body, l)
        }
        i = i + 1
    }
    if ft_list_len(imports) == 0 {
        return page + code
    }
    return join_lines(imports, 0, ft_list_len(imports)) + "\n\n" + strip_newlines(join_lines(body, 0, ft_list_len(body)))
}

# ---------------------------------------------------------------------------
# verify
# ---------------------------------------------------------------------------

function mode_name(i: i32) -> string {
    if i == 0 { return "standalone" }
    if i == 1 { return "stmt-wrap" }
    return "split-wrap"
}

function or_else(a: string, b: string) -> string {
    if a as ptr<u8> != null and ft_len(a) > 0 {
        return a
    }
    return b
}

# FLOW_DOC_DUMP: write every harness rung of the block, whatever flowc later
# makes of it, so the set of dumped sources does not depend on the compiler.
function dump_rungs(env: ptr<Env>, b: ptr<Blk>, pre: string, code: string, nmodes: i32) {
    if ft_len(env.dump) == 0 {
        return
    }
    let mut m: i32 = 0
    while m < nmodes {
        let wrapped: string = harness(code, mode_name(m))
        if wrapped as ptr<u8> != null {
            env.serial = env.serial + 1
            let base: string = env.dump + "/d" + ft_itoa(env.serial)
            let _d: bool = ft_write_file(base + ".flow", pre + wrapped)
            let _k: bool = ft_write_file(base + ".key", b.key + "@" + mode_name(m) + "\n")
        }
        m = m + 1
    }
}

export function verify(env: ptr<Env>, b: ptr<Blk>, ctx: ptr<PageCtx>) -> ptr<Res> {
    let ign: string = blk_opt(b, "ignore")
    if ign as ptr<u8> != null {
        return res_new(b, "ignored", null as string, ign, "")
    }
    let err: ptr<string> = malloc(8) as ptr<string>
    err[0] = ""
    let page: string = page_context(b, ctx, err)
    if ft_len(err[0]) > 0 {
        return res_new(b, "unverified", null as string, err[0], "uses")
    }
    let drifted: string = from_mismatch(env, b)
    if drifted as ptr<u8> != null {
        return res_new(b, "unverified", null as string, drifted, "from")
    }
    let pre: string = preamble_text(env, b, err)
    if ft_len(err[0]) > 0 {
        return res_new(b, "unverified", null as string, err[0], "preamble")
    }
    let code: string = join_with_context(page, b.code)
    let expects: bool = blk_flag(b, "expect-error")
    let mut nmodes: i32 = 3
    if blk_flag(b, "no-harness") {
        nmodes = 1
    }
    let mut first_stage: string = ""
    let mut first_detail: string = ""
    let mut have_first: bool = false
    let mut best_noop: string = ""
    let mut reached_meaning: bool = false
    let mut meaning_detail: string = ""
    dump_rungs(env, b, pre, code, nmodes)
    if env.dump_only {
        return res_new(b, "ignored", null as string, "dump", "")
    }
    let mut m: i32 = 0
    while m < nmodes {
        let mode: string = mode_name(m)
        let wrapped: string = harness(code, mode)
        if wrapped as ptr<u8> != null {
            let f: ptr<Front> = compile_source(env, pre + wrapped, m != 0, mode)
            let st: string = f.stage
            if ft_eq(st, "types") or ft_eq(st, "vacuous") or ft_eq(st, "codegen") or ft_eq(st, "degenerate") {
                reached_meaning = true
            }
            if (ft_eq(st, "types") or ft_eq(st, "codegen")) and ft_len(meaning_detail) == 0 {
                meaning_detail = f.detail
            }
            if ft_eq(st, "degenerate") and ft_len(best_noop) == 0 {
                best_noop = f.detail
            }
            if f.ok {
                if expects {
                    return res_new(b, "unverified", mode, "tagged expect-error but compiles under " + mode, "types")
                }
                let r: ptr<Res> = res_new(b, "verified", mode, "", st)
                r.csource = f.csource
                return r
            }
            if have_first == false {
                first_stage = st
                first_detail = f.detail
                have_first = true
            }
        }
        m = m + 1
    }
    if expects {
        let mut stage: string = "parse"
        if reached_meaning {
            stage = "types"
        }
        return res_new(b, "expected-error", null as string, or_else(meaning_detail, or_else(best_noop, first_detail)), stage)
    }
    if ft_len(meaning_detail) > 0 {
        return res_new(b, "unverified", null as string, meaning_detail, "types")
    }
    return res_new(b, "unverified", null as string, or_else(best_noop, first_detail), first_stage)
}
